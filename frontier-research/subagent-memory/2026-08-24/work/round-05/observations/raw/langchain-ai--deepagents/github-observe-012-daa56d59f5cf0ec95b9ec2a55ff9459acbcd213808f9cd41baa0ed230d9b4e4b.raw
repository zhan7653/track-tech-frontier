22:23:12Z"},"message":"style(code): simplify web search disabled toast notification (#4448)\n\nSimplified the \"Web search disabled\" toast to a single concise line.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/497028b9-6bbc-add3-e0fc-b69936c9177d)\n\n---------\n\nSigned-off-by: Mason Daugherty <github@mdrxy.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"04729c3c590e62d6e918f909ad4b21e5c7d5227b","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/04729c3c590e62d6e918f909ad4b21e5c7d5227b"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/20107eda2dafbcc427fb0d61c7944f881e95df4d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqRuTQCRC1aQ7uu5UhlAAAHOoQAKMKpJvWRBq1w2+UYf0ZXPpi\nH6PKdSgmVzl7p6lWrmuj1LrtU3yqXWB9jJWGIRuMIRhWMz+rECZYkCwMYN9HCU1q\njQrInfnH+ieUF9nnoqeXrscl4bW3dC84muouFYbv5HcS1/IuGPXiR9Lo90fRaxxj\nO3BNbsKJLh6zQ+tOqFKX/1Zs8r7uo8qQMFCJEJHa9V7UdKpqNb58UCY+1MQJfHen\n9V0Un5kJ8kEZXmz1P+bPCZdbVKVhWuHOBMjdGMlSIrhZZdEsn+9+x+WPWK4lpzeV\n16GVNyAUgTY8ZwQWZeaqcVAXiRNNknchn5Gjo5w2iS5dmPUaLUaZDBnVfOXTGXd7\n3wCUEEqU97B9sZOduNStt+HGDnb7DnUQouna4c7sqr2vhw/xIXVUW66iWfPP/iOA\nd8g4L7nDkwSFKLGROxQcMH4K0H6e+x82bbuJEx+wQgtaA84e5yYT/2Ukr5NKbDP1\nSTNWLGR+WFgEwhGZlTsVV5YJBqcqAjLE8CzKOAHfE8sBLFIsSoctsMCq+Lfzbn8V\n2aKqlcJTmhhVZEi+ZBW6UNJ+n/gw/CPvP9eNkCVNaQfApKWEoC0NIo9aP0bHbAiq\nStdeHJrFrWAe+zrc+2wJ610/KhszCDKGlzGkyGQ1DckfGfXo5rb3APRbDzWGfSOW\n8+Eaw8hxq0Nim/OYjL6f\n=2c2f\n-----END PGP SIGNATURE-----\n","payload":"tree 04729c3c590e62d6e918f909ad4b21e5c7d5227b\nparent 1e8ed81940a862dde44f704826b61650336367e0\nauthor Mason Daugherty <mason@langchain.dev> 1783030992 -0400\ncommitter GitHub <noreply@github.com> 1783030992 -0400\n\nstyle(code): simplify web search disabled toast notification (#4448)\n\nSimplified the \"Web search disabled\" toast to a single concise line.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/497028b9-6bbc-add3-e0fc-b69936c9177d)\n\n---------\n\nSigned-off-by: Mason Daugherty <github@mdrxy.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-07-02T22:23:13Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/20107eda2dafbcc427fb0d61c7944f881e95df4d","html_url":"https://github.com/langchain-ai/deepagents/commit/20107eda2dafbcc427fb0d61c7944f881e95df4d","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/20107eda2dafbcc427fb0d61c7944f881e95df4d/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"1e8ed81940a862dde44f704826b61650336367e0","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/1e8ed81940a862dde44f704826b61650336367e0","html_url":"https://github.com/langchain-ai/deepagents/commit/1e8ed81940a862dde44f704826b61650336367e0"}]},{"sha":"1e8ed81940a862dde44f704826b61650336367e0","node_id":"C_kwDOPTymldoAKDFlOGVkODE5NDBhODYyZGRlNDRmNzA0ODI2YjYxNjUwMzM2MzY3ZTA","commit":{"author":{"name":"Johannes du Plessis","email":"johannes@langchain.dev","date":"2026-07-02T19:00:59Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-02T19:00:59Z"},"message":"fix(code): route Anthropic effort through output config (#4446)\n\nFixes dcode `/effort` for Anthropic models by writing effort to\n`output_config` instead of the unsupported top-level kwarg.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/019f2412-222a-7370-9e96-fcc97867720c)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"1361e8d782e02d32d6f7cae89e2faf2be21a0876","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/1361e8d782e02d32d6f7cae89e2faf2be21a0876"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/1e8ed81940a862dde44f704826b61650336367e0","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqRrVsCRC1aQ7uu5UhlAAAOhwQAEv4VHEOQuf74wUJuk7SM0F8\nGC5tHFiMHp4Y3+ieukvhP/oC9Numv15Lbe/1pEgRsqRDXHGQW8TZo9H/7m06cND1\na+rrnUm3BvfVujwRH8U5veoRadc0Pa2lBLhGLBiXIriMhB5x4rKOSQXBSwsuQc/k\njqn/UMGyUjPKGNN037Jf26ZSxASTxkPBPFEcgyhQhlk7gT0E38a8PmaQl4fbdfOG\nhLwafegGixaFu0i6n0Xr7QOOFQ1GCzWzId9imyz98eiHzowdEb4cAGWNDN/z8hDn\ntSJrnYB5QPxtw72ORyU+u9nJnDStE6mbdhi+A70aHyPTPKy1mp7uTZ66VKKDECTF\nPFYHOL27S+6/w+sE489jS0hp7ISB1jhjgtozvJmHDzYuCgNWbg1b9pyiVc5XH+it\nPqv6UsFN462b/8/sqqHlAMns97ll+ZkDEXCZdNhvok/FDZdp8WFZRxjnI/DE9zkW\nZ66IaiOnoskxqhkbgt+4RBCfgCJLAW9JIukrpMZ/F5tJwuzzAWRTtGOX9aoIHyMx\nLTrVuueGlzp6ZVluhL1gq+0ixsIh3lUOpXYMgkRA2b5ao4hPepWpRJ0ayWZwBzi4\ntNNy7MtyHGPRq3PqhSUQiUeFeoK/n4s5bLCwDNzR7fO69YvYKOSCpwG4yBUS7JI/\nAs8bUhiAA0FNxICldsyo\n=FWcT\n-----END PGP SIGNATURE-----\n","payload":"tree 1361e8d782e02d32d6f7cae89e2faf2be21a0876\nparent ef591e7a86b13bbdcb0fdedd45a8f1fe33573839\nauthor Johannes du Plessis <johannes@langchain.dev> 1783018859 -0700\ncommitter GitHub <noreply@github.com> 1783018859 -0400\n\nfix(code): route Anthropic effort through output config (#4446)\n\nFixes dcode `/effort` for Anthropic models by writing effort to\n`output_config` instead of the unsupported top-level kwarg.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/019f2412-222a-7370-9e96-fcc97867720c)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-07-02T19:01:00Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/1e8ed81940a862dde44f704826b61650336367e0","html_url":"https://github.com/langchain-ai/deepagents/commit/1e8ed81940a862dde44f704826b61650336367e0","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/1e8ed81940a862dde44f704826b61650336367e0/comments","author":{"login":"johannes117","id":51395795,"node_id":"MDQ6VXNlcjUxMzk1Nzk1","avatar_url":"https://avatars.githubusercontent.com/u/51395795?v=4","gravatar_id":"","url":"https://api.github.com/users/johannes117","html_url":"https://github.com/johannes117","followers_url":"https://api.github.com/users/johannes117/followers","following_url":"https://api.github.com/users/johannes117/following{/other_user}","gists_url":"https://api.github.com/users/johannes117/gists{/gist_id}","starred_url":"https://api.github.com/users/johannes117/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/johannes117/subscriptions","organizations_url":"https://api.github.com/users/johannes117/orgs","repos_url":"https://api.github.com/users/johannes117/repos","events_url":"https://api.github.com/users/johannes117/events{/privacy}","received_events_url":"https://api.github.com/users/johannes117/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"ef591e7a86b13bbdcb0fdedd45a8f1fe33573839","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/ef591e7a86b13bbdcb0fdedd45a8f1fe33573839","html_url":"https://github.com/langchain-ai/deepagents/commit/ef591e7a86b13bbdcb0fdedd45a8f1fe33573839"}]},{"sha":"ef591e7a86b13bbdcb0fdedd45a8f1fe33573839","node_id":"C_kwDOPTymldoAKGVmNTkxZTdhODZiMTNiYmRjYjBmZGVkZDQ1YThmMWZlMzM1NzM4Mzk","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-02T18:59:06Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-02T18:59:06Z"},"message":"feat(sdk): bound grep/glob with partial results and a `truncated` flag (#4063)\n\nSupersedes #1935\n\n- `grep` and `glob` no longer hang or hard-error solely because a search\nover a huge or slow tree exceeds its backend time limit. They return the\nmatches found so far, flagged as incomplete, with guidance to narrow the\nquery.\n- `glob` patterns now support brace expansion, e.g. `*.{py,md}`.\n- Timed-out `grep`/`glob` calls with partial results are reported as\nsuccessful tool calls carrying an incompleteness note. Callers that\nbranch on tool-message status should treat those as valid partial\nresults, not failures.\n- `grep` errors with partial matches now preserve the partial-match\nsection even when the error text is very large.\n\n---\n\nFilesystem searches now have fixed time bounds and preserve useful work\nwhen they run out of time. Instead of hanging or discarding matches on\ntimeout, `grep` and `glob` return the matches found so far and mark the\nresult as incomplete so the agent can narrow its next search.\n\n### User-facing behavior changes\n\n- If your agent runs `grep` or `glob` over a huge, slow, or sparse tree\nand the backend reaches its search time limit after finding some\nmatches, the tool call now returns those matches immediately as a\nsuccessful partial result. The result includes a note saying the search\ndid not complete and should be narrowed.\n- If your application consumes backend results directly, `GrepResult`\nand `GlobResult` now include `truncated`. `truncated=True` means the\nreturned matches are valid but incomplete; `error` still means the\noperation failed.\n- If your application branches on `ToolMessage.status`, a timed-out\nsearch with partial results now appears as a successful `grep`/`glob`\ntool call. Hard backend failures still surface as errors, with `error`\ntaking precedence over `truncated`.\n- If `grep` fails after collecting partial matches, the tool still\nreports an error and now preserves the `Partial matches:` section even\nwhen the error message itself is very large.\n- Example: if `grep(\"TODO\", path=\"/workspace\")` finds matches in source\nfiles but also hits a generated or mounted directory that produces a\nvery long read-error summary, the tool message still reports the error\nwhile preserving the matched files under `Partial matches:` instead of\nletting the error text consume the whole output budget.\n- If you use `CompositeBackend`, merged `grep` and `glob` results now\npropagate `truncated=True` when any searched backend returns an\nincomplete result.\n- Example: if the default backend finishes normally but `/memories/`\nhits its time limit during a root-level `grep(..., path=\"/\")`, the\nmerged result contains matches from both backends and returns\n`truncated=True` so callers know the full search is incomplete.\n- If a routed backend fails during a merged `glob`, the error is now\nsurfaced instead of silently returning only the default backend's\nmatches.\n- Example: if `glob(\"*.md\", path=\"/\")` searches the default backend and\na routed `/sandbox/` backend, and `/sandbox/` is unreachable, callers\nnow see that `/sandbox/` error. Previously the merge could return only\ndefault-backend matches, making the overall search look complete even\nthough one route failed.\n- If your agent uses brace patterns such as `*.{py,md}`, `glob` now\nexpands them and matches both `.py` and `.md` files. Previously, `glob`\nused stdlib `Path.rglob` behavior and treated `{py,md}` literally, so\nthe same pattern usually matched nothing unless filenames actually\ncontained braces. This now matches the brace behavior `grep(...,\nglob=...)` already had.\n\n<details>\n<summary><b>How partial search results are reported</b></summary>\n\n`GrepResult` and `GlobResult` now distinguish incomplete success from\nfailure:\n\n- `truncated=True` means the search stopped before completing, usually\nbecause it hit a fixed time budget. Matches returned with that flag are\nvalid, but they are not the full result set.\n- `error` means the operation failed. If both an error and partial\nmatches exist, the middleware renders the tool call as an error and\nincludes both the error text and a `Partial matches:` section. The match\noutput is size-limited before being appended, and the error text is\nsize-limited separately so an oversized error cannot push the partial\nmatches out of the returned tool message.\n- The filesystem middleware appends this incomplete-search note after\nsize truncation so it remains visible even for a large partial result:\n\n```text\nNote: the search stopped early because it hit its time limit. The matches above are valid but incomplete. Narrow the search (a more specific pattern or a narrower path) to see the rest.\n```\n\nFor direct dataclass consumers, the new `truncated` field is appended\nlast with a default value to keep existing construction patterns\ncompatible.\n\n</details>\n\n<details>\n<summary><b>Backend-specific timeout behavior</b></summary>\n\n`FilesystemBackend.grep` keeps using ripgrep first when `rg` is\navailable. If ripgrep times out after writing JSON output, the backend\nparses that partial output and returns it with `truncated=True`; if\nripgrep times out before producing anything, the Python fallback still\ngets a chance to search.\n\nThe Python grep fallback now reports its own timeout as `truncated=True`\ninstead of returning a hard timeout error.\n\n`FilesystemBackend.glob` now walks entries with a wall-clock budget and\napplies a compiled matcher per entry. That matters for sparse searches:\na pattern with few or zero matches over a huge tree can still notice the\ndeadline, because the timeout check happens on every visited entry\nrather than only on matched paths.\n\n</details>\n\n<details>\n<summary><b>Composite backend behavior</b></summary>\n\n`CompositeBackend` now carries `truncated` through both routed searches\nand merged root searches:\n\n- A direct search inside a route returns the routed backend's\n`truncated` value with route-prefixed paths.\n- A merged search across the default backend and all routes\nOR-accumulates `truncated`, so one incomplete backend makes the merged\nresult incomplete.\n- Merged `glob` now mirrors `grep`'s error-first behavior. If any routed\nbackend reports an error, callers see that error instead of a misleading\ndefault-only success.\n\n</details>\n\n<details>\n<summary><b>Glob pattern behavior</b></summary>\n\nThe `glob` implementation now uses the same matcher family as the grep\ninclude-glob path. It preserves recursive `**` behavior and dotfile\nmatching while adding brace expansion.\n\nThe observable change is that patterns like `*.{py,md}` now match both\n`.py` and `.md` files. Invalid brace patterns are reported as glob\nerrors instead of raising through the tool boundary.\n\n</details>\n\n### Motivation\n\nLarge repositories, mounted sandboxes, generated trees, and slow\nfilesystems can make open-ended search calls look like a hung agent.\nReturning partial results gives the model enough context to continue\nwhile still making incompleteness explicit to application code.\n\nKeeping timeout values inside the backend also avoids exposing an\nLLM-controlled `timeout` parameter across the full `BackendProtocol`;\ncallers get bounded behavior without asking the model to choose\noperational limits.\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"2977042aea00a6c39591ed2e4a7a957c441cfd56","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/2977042aea00a6c39591ed2e4a7a957c441cfd56"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/ef591e7a86b13bbdcb0fdedd45a8f1fe33573839","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqRrT6CRC1aQ7uu5UhlAAAAP8QAF9PIdl+tRqCY+qfMGg7gm8z\neR/dy0VEFlu0o9eys1DBEshA2lApA0BeuYADKnGg1KMP0AO66AXU1fgsk5LcHIW2\nJPph91163AKhGopIh2zL/WbP5Cv/35rFSAFcJ40eNxFFkkllsR0BRin19+XQ4VIj\nt2iBJBVyZ7AeKPrWKuBZ8CTjhiqS9Dt7iQ+sQnX5hr5twBYOKas18wDnNVsy3IM3\nvBfDcdDvZP23T+balDIx3H0aeJgAor+oyj+5Tgya1ZbqtWnR3ItKEcrtB1/Zcloc\nHJNVSMTSyYu6KkGjofS7fKFsD3o9P3br6FxvWSLC9PZosvGFZyetBSzB3feq/LXD\nA46OWPhu1RAr0bMT9jX/AkmkoEQ488q9Q1hUwiWx89YZ7gv7cXl48y2a1lHx2Dk6\noIrNqMbg+LEhj8eBlrFQXFIUGsj869V6UWGseD6ojdrjtU/SRe4iCBEXzlpoUrID\nH7cSKyJ9GCy0CURKifjzcsv3QlDe898PsWff6ioaaty4jEFml1Z6Q9lFiFMqheB9\nzqaTJumVxnxjfiEN/nLeDw9HFHjEAukA712XTy8qSJBrLyQHK6/s5h8wveHM19Z0\nF758i1vMk9pvJ9d+Y99rf6Z6b59j2tt0/vZJUwSl1TFhhfIkDntQusJ+FfRzlYrh\nOk1yQXYMmV3ZR3d7ntcD\n=t1OD\n-----END PGP SIGNATURE-----\n","payload":"tree 2977042aea00a6c39591ed2e4a7a957c441cfd56\nparent d77496b969b9c59ce1c7c44e2085e5388e12c306\nauthor Mason Daugherty <mason@langchain.dev> 1783018746 -0400\ncommitter GitHub <noreply@github.com> 1783018746 -0400\n\nfeat(sdk): bound grep/glob with partial results and a `truncated` flag (#4063)\n\nSupersedes #1935\n\n- `grep` and `glob` no longer hang or hard-error solely because a search\nover a huge or slow tree exceeds its backend time limit. They return the\nmatches found so far, flagged as incomplete, with guidance to narrow the\nquery.\n- `glob` patterns now support brace expansion, e.g. `*.{py,md}`.\n- Timed-out `grep`/`glob` calls with partial results are reported as\nsuccessful tool calls carrying an incompleteness note. Callers that\nbranch on tool-message status should treat those as valid partial\nresults, not failures.\n- `grep` errors with partial matches now preserve the partial-match\nsection even when the error text is very large.\n\n---\n\nFilesystem searches now have fixed time bounds and preserve useful work\nwhen they run out of time. Instead of hanging or discarding matches on\ntimeout, `grep` and `glob` return the matches found so far and mark the\nresult as incomplete so the agent can narrow its next search.\n\n### User-facing behavior changes\n\n- If your agent runs `grep` or `glob` over a huge, slow, or sparse tree\nand the backend reaches its search time limit after finding some\nmatches, the tool call now returns those matches immediately as a\nsuccessful partial result. The result includes a note saying the search\ndid not complete and should be narrowed.\n- If your application consumes backend results directly, `GrepResult`\nand `GlobResult` now include `truncated`. `truncated=True` means the\nreturned matches are valid but incomplete; `error` still means the\noperation failed.\n- If your application branches on `ToolMessage.status`, a timed-out\nsearch with partial results now appears as a successful `grep`/`glob`\ntool call. Hard backend failures still surface as errors, with `error`\ntaking precedence over `truncated`.\n- If `grep` fails after collecting partial matches, the tool still\nreports an error and now preserves the `Partial matches:` section even\nwhen the error message itself is very large.\n- Example: if `grep(\"TODO\", path=\"/workspace\")` finds matches in source\nfiles but also hits a generated or mounted directory that produces a\nvery long read-error summary, the tool message still reports the error\nwhile preserving the matched files under `Partial matches:` instead of\nletting the error text consume the whole output budget.\n- If you use `CompositeBackend`, merged `grep` and `glob` results now\npropagate `truncated=True` when any searched backend returns an\nincomplete result.\n- Example: if the default backend finishes normally but `/memories/`\nhits its time limit during a root-level `grep(..., path=\"/\")`, the\nmerged result contains matches from both backends and returns\n`truncated=True` so callers know the full search is incomplete.\n- If a routed backend fails during a merged `glob`, the error is now\nsurfaced instead of silently returning only the default backend's\nmatches.\n- Example: if `glob(\"*.md\", path=\"/\")` searches the default backend and\na routed `/sandbox/` backend, and `/sandbox/` is unreachable, callers\nnow see that `/sandbox/` error. Previously the merge could return only\ndefault-backend matches, making the overall search look complete even\nthough one route failed.\n- If your agent uses brace patterns such as `*.{py,md}`, `glob` now\nexpands them and matches both `.py` and `.md` files. Previously, `glob`\nused stdlib `Path.rglob` behavior and treated `{py,md}` literally, so\nthe same pattern usually matched nothing unless filenames actually\ncontained braces. This now matches the brace behavior `grep(...,\nglob=...)` already had.\n\n<details>\n<summary><b>How partial search results are reported</b></summary>\n\n`GrepResult` and `GlobResult` now distinguish incomplete success from\nfailure:\n\n- `truncated=True` means the search stopped before completing, usually\nbecause it hit a fixed time budget. Matches returned with that flag are\nvalid, but they are not the full result set.\n- `error` means the operation failed. If both an error and partial\nmatches exist, the middleware renders the tool call as an error and\nincludes both the error text and a `Partial matches:` section. The match\noutput is size-limited before being appended, and the error text is\nsize-limited separately so an oversized error cannot push the partial\nmatches out of the returned tool message.\n- The filesystem middleware appends this incomplete-search note after\nsize truncation so it remains visible even for a large partial result:\n\n```text\nNote: the search stopped early because it hit its time limit. The matches above are valid but incomplete. Narrow the search (a more specific pattern or a narrower path) to see the rest.\n```\n\nFor direct dataclass consumers, the new `truncated` field is appended\nlast with a default value to keep existing construction patterns\ncompatible.\n\n</details>\n\n<details>\n<summary><b>Backend-specific timeout behavior</b></summary>\n\n`FilesystemBackend.grep` keeps using ripgrep first when `rg` is\navailable. If ripgrep times out after writing JSON output, the backend\nparses that partial output and returns it with `truncated=True`; if\nripgrep times out before producing anything, the Python fallback still\ngets a chance to search.\n\nThe Python grep fallback now reports its own timeout as `truncated=True`\ninstead of returning a hard timeout error.\n\n`FilesystemBackend.glob` now walks entries with a wall-clock budget and\napplies a compiled matcher per entry. That matters for sparse searches:\na pattern with few or zero matches over a huge tree can still notice the\ndeadline, because the timeout check happens on every visited entry\nrather than only on matched paths.\n\n</details>\n\n<details>\n<summary><b>Composite backend behavior</b></summary>\n\n`CompositeBackend` now carries `truncated` through both routed searches\nand merged root searches:\n\n- A direct search inside a route returns the routed backend's\n`truncated` value with route-prefixed paths.\n- A merged search across the default backend and all routes\nOR-accumulates `truncated`, so one incomplete backend makes the merged\nresult incomplete.\n- Merged `glob` now mirrors `grep`'s error-first behavior. If any routed\nbackend reports an error, callers see that error instead of a misleading\ndefault-only success.\n\n</details>\n\n<details>\n<summary><b>Glob pattern behavior</b></summary>\n\nThe `glob` implementation now uses the same matcher family as the grep\ninclude-glob path. It preserves recursive `**` behavior and dotfile\nmatching while adding brace expansion.\n\nThe observable change is that patterns like `*.{py,md}` now match both\n`.py` and `.md` files. Invalid brace patterns are reported as glob\nerrors instead of raising through the tool boundary.\n\n</details>\n\n### Motivation\n\nLarge repositories, mounted sandboxes, generated trees, and slow\nfilesystems can make open-ended search calls look like a hung agent.\nReturning partial results gives the model enough context to continue\nwhile still making incompleteness explicit to application code.\n\nKeeping timeout values inside the backend also avoids exposing an\nLLM-controlled `timeout` parameter across the full `BackendProtocol`;\ncallers get bounded behavior without asking the model to choose\noperational limits.\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-07-02T18:59:06Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/ef591e7a86b13bbdcb0fdedd45a8f1fe33573839","html_url":"https://github.com/langchain-ai/deepagents/commit/ef591e7a86b13bbdcb0fdedd45a8f1fe33573839","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/ef591e7a86b13bbdcb0fdedd45a8f1fe33573839/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"d77496b969b9c59ce1c7c44e2085e5388e12c306","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/d77496b969b9c59ce1c7c44e2085e5388e12c306","html_url":"https://github.com/langchain-ai/deepagents/commit/d77496b969b9c59ce1c7c44e2085e5388e12c306"}]},{"sha":"d77496b969b9c59ce1c7c44e2085e5388e12c306","node_id":"C_kwDOPTymldoAKGQ3NzQ5NmI5NjliOWM1OWNlMWM3YzQ0ZTIwODVlNTM4OGUxMmMzMDY","commit":{"author":{"name":"Nishitha M","email":"32355027+imnishitha@users.noreply.github.com","date":"2026-07-02T18:20:27Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-02T18:20:27Z"},"message":"fix(sdk): sandbox not-found contract and glob deny over-blocking on delete (#4321)\n\nAddresses two issues raised in review of the delete file/dir tool\naddition.\n\n`BaseSandbox.delete` - missing paths now return a not-found error\n\n`rm -rf exits 0` even when the path does not exist, so the previous\nimplementation returned a successful DeleteResult for paths that were\nnever present. This diverged from the contract established by\nFilesystemBackend and StateBackend, which return a not-found error in\nthat case. The fix runs test `-e` before `rm -rf`; a non-zero exit from\nthe existence check returns `Error: '<path>' not found`, matching the\nother backends.\n\n`_find_delete_deny_patterns` - glob deny rules no longer block unrelated\nsibling deletes\n\nThe permission check reduced every deny pattern to its non-wildcard\nanchor (e.g. `/work/*.log` → `/wor`k) and then used a subtree-overlap\ncheck, which incorrectly blocked deleting `/work/notes.txt`, a sibling\nthat can never match `*.log`. The fix distinguishes:\n\n- Literal patterns (no wildcards): keep the original subtree-overlap\ncheck so a deny on `/work/secrets` still blocks deleting the parent\n`/work`.\n- Wildcard patterns with a specific anchor: block only if the target\ndirectly matches the glob (wcglob.globmatch) or the anchor sits inside\nthe delete subtree (deleting target would recursively remove matching\ndescendants).\n- Wildcard patterns with a root anchor (`/**/secrets`): conservative\nblock preserved, the pattern can match anywhere.\n\n---------\n\nSigned-off-by: Nishitha M <32355027+imnishitha@users.noreply.github.com>\nCo-authored-by: open-swe[bot] <215916821+open-swe[bot]@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <61371264+mdrxy@users.noreply.github.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","tree":{"sha":"195b017f8e571e8e709220352419842621825433","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/195b017f8e571e8e709220352419842621825433"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/d77496b969b9c59ce1c7c44e2085e5388e12c306","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqRqvrCRC1aQ7uu5UhlAAA+v8QAK+JJvj9JUIqOHGt4778f4gd\nNI2AnoNJQxkMC7hsqHqM3KuT5DwGNomhK5xZJEYpzGZaEwiFZn//jnMs2nCw1265\ncpTP2C1y0PcT1jNtlj+ygmelxs1qUJBMrR2T6i3wiKQAPp8ADLmyZHx2tTO3Dd8h\nAGDqPRT7jd5Hoseps/5xPuCxm5CNEtYRXaUbLiH6eAJDZK5GIC4C+nMktcLSNbf2\n0zAHfhOIjlJRrRgnitjsjn/Fb/qnigl0Qlwx5fa0QzLjZWCI3P9uFyzSVzOjyeN+\n+Xp9jcVNLDM0IEJ3LOqaR2Dp5GyqL12Ab30QXPE7dEn+Iwol9nzsWWT6DNuGBJR0\nRnTE1F5AEk31DENjCNOjHIPDqM5rr6ygQjQr94FcJCcPPdBEPmW7paHfBzvmR/w5\ntq4suPSYoTNpmphmnDWKwx8djTDcco/vwakgK1VW6FvdhQhFvo2Fv/TgZ/tKGna3\nFhSJ8PyB9xT1Kum5pAEPCix61xccUE3Ufv7xz8kSZzpAmzvMHbYwb1lRo43By3EL\nUQ63YdkTKMxoWMc0qUsg7E/zcJoQSu4OlbOntEkn9SIoZV9PkmKZ8xnsdL/f8uPC\nOkTJKaikWu/IOzF/fgNPwK9EqCoTinnLKmyR7VyPRKUH+0+1H1jM9M0mKXj8TKno\nQTaZ27U1s1QHTSh1eHL0\n=kQq0\n-----END PGP SIGNATURE-----\n","payload":"tree 195b017f8e571e8e709220352419842621825433\nparent 704a70dddbd59b8c6abf658a4211c76bce1445f0\nauthor Nishitha M <32355027+imnishitha@users.noreply.github.com> 1783016427 -0400\ncommitter GitHub <noreply@github.com> 1783016427 -0400\n\nfix(sdk): sandbox not-found contract and glob deny over-blocking on delete (#4321)\n\nAddresses two issues raised in review of the delete file/dir tool\naddition.\n\n`BaseSandbox.delete` - missing paths now return a not-found error\n\n`rm -rf exits 0` even when the path does not exist, so the previous\nimplementation returned a successful DeleteResult for paths that were\nnever present. This diverged from the contract established by\nFilesystemBackend and StateBackend, which return a not-found error in\nthat case. The fix runs test `-e` before `rm -rf`; a non-zero exit from\nthe existence check returns `Error: '<path>' not found`, matching the\nother backends.\n\n`_find_delete_deny_patterns` - glob deny rules no longer block unrelated\nsibling deletes\n\nThe permission check reduced every deny pattern to its non-wildcard\nanchor (e.g. `/work/*.log` → `/wor`k) and then used a subtree-overlap\ncheck, which incorrectly blocked deleting `/work/notes.txt`, a sibling\nthat can never match `*.log`. The fix distinguishes:\n\n- Literal patterns (no wildcards): keep the original subtree-overlap\ncheck so a deny on `/work/secrets` still blocks deleting the parent\n`/work`.\n- Wildcard patterns with a specific anchor: block only if the target\ndirectly matches the glob (wcglob.globmatch) or the anchor sits inside\nthe delete subtree (deleting target would recursively remove matching\ndescendants).\n- Wildcard patterns with a root anchor (`/**/secrets`): conservative\nblock preserved, the pattern can match anywhere.\n\n---------\n\nSigned-off-by: Nishitha M <32355027+imnishitha@users.noreply.github.com>\nCo-authored-by: open-swe[bot] <215916821+open-swe[bot]@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <61371264+mdrxy@users.noreply.github.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","verified_at":"2026-07-02T18:20:27Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/d77496b969b9c59ce1c7c44e2085e5388e12c306","html_url":"https://github.com/langchain-ai/deepagents/commit/d77496b969b9c59ce1c7c44e2085e5388e12c306","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/d77496b969b9c59ce1c7c44e2085e5388e12c306/comments","author":{"login":"imnishitha","id":32355027,"node_id":"MDQ6VXNlcjMyMzU1MDI3","avatar_url":"https://avatars.githubusercontent.com/u/32355027?v=4","gravatar_id":"","url":"https://api.github.com/users/imnishitha","html_url":"https://github.com/imnishitha","followers_url":"https://api.github.com/users/imnishitha/followers","following_url":"https://api.github.com/users/imnishitha/following{/other_user}","gists_url":"https://api.github.com/users/imnishitha/gists{/gist_id}","starred_url":"https://api.github.com/users/imnishitha/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/imnishitha/subscriptions","organizations_url":"https://api.github.com/users/imnishitha/orgs","repos_url":"https://api.github.com/users/imnishitha/repos","events_url":"https://api.github.com/users/imnishitha/events{/privacy}","received_events_url":"https://api.github.com/users/imnishitha/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"704a70dddbd59b8c6abf658a4211c76bce1445f0","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/704a70dddbd59b8c6abf658a4211c76bce1445f0","html_url":"https://github.com/langchain-ai/deepagents/commit/704a70dddbd59b8c6abf658a4211c76bce1445f0"}]},{"sha":"704a70dddbd59b8c6abf658a4211c76bce1445f0","node_id":"C_kwDOPTymldoAKDcwNGE3MGRkZGJkNTliOGM2YWJmNjU4YTQyMTFjNzZiY2UxNDQ1ZjA","commit":{"author":{"name":"Nishitha M","email":"32355027+imnishitha@users.noreply.github.com","date":"2026-07-02T16:06:58Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-02T16:06:58Z"},"message":"feat(sdk):  add `enabled_tools` allowlist to `FilesystemMiddleware` (#4325)\n\n### Summary\n\n- Adds an `tools` allowlist to `FilesystemMiddleware`. The default keeps\nall tools enabled. Passing an explicit set restricts the model to only\nthose tools.\n- The system prompt dynamically reflects the tools that are actually\nvisible: if a tool is not in the `tools` it is omitted from the prompt\nentirely, so the model is never told about tools it cannot use.\n- Backend capability checks for execute and delete still apply on top of\nthe allowlist. Listing either in `tools` when the backend does not\nsupport them is a no-op, they are silently filtered out.\n- `tools` is threaded through create_deep_agent so the main agent and GP\nsubagent respect it automatically. Declarative subagents use their own\n`FilesystemMiddleware` spec independently.\n- `read_file` cannot be excluded: passing the `tools` without it raises\nValueError at construction time.\n- User-provided tools are never affected by the `tools` list.\n- When passing a custom `FilesystemMiddleware` instance via\n`middleware=`, all desired parameters must be specified explicitly. Any\nomitted parameter falls back to its constructor default.\n\n### Motivation\n\nGives callers explicit control over which filesystem tools are exposed.\nNew tools added to `FilesystemMiddleware` in the future are\nautomatically hidden from restricted agents without requiring config\nupdates.\n\n\nExample\n```Python\n# Read-only agent: write, edit, delete, and execute are never shown\nagent = create_deep_agent(\n    model=\"openai:gpt-5.5\",\n    middleware=[\n        FilesystemMiddleware(\n            backend=backend,\n            tools={\"read_file\", \"ls\", \"glob\", \"grep\"},\n        )\n    ],\n)\n```\n\n---------\n\nSigned-off-by: Nishitha M <32355027+imnishitha@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>\nCo-authored-by: ccurme <chester.curme@gmail.com>\nCo-authored-by: open-swe[bot] <215916821+open-swe[bot]@users.noreply.github.com>","tree":{"sha":"4efef1ac34abc44dffd56916df305a821be5ca53","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/4efef1ac34abc44dffd56916df305a821be5ca53"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/704a70dddbd59b8c6abf658a4211c76bce1445f0","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqRoyiCRC1aQ7uu5UhlAAAiIQQAAo0ibw1Wmxfk480wZ+YBoqr\nnpLkdDAw4xxNYH+9z/IOTnPlCZfoGxv9NgMAWW4iy4fuiepdUMlu+BRjb+wwftxX\nGjIugbG4IbkkAZGUwSTGRTDWJgWryyMJDN27H3EbgF2BkMdYOEJvvxHKUgnG93q3\nGKanK6txJwMZqist4UnwRGbbQ08MJ0Km+jJxEHcPvtoagrY12j1XMTRVMdGG9WDo\nkrz+Flr+qvqY3rqmkw8P1qlS/p4TM+b6BDmaAIGMk2bVxtykSIUP43t2JUrziMf/\n4Z0+C+5sLWFgdjLAIg54rHD4nVXfKMghSR6TAsShNfEG4Ss7RhjF6dkpyvO0ymnz\nNx9OX2ca+cpfn+FuzSpNynNKWKsFq8X8hYdKEepdV/8EmAWKMf+1lcnS98veVUrO\n/Mt16DXt/3gHQ4VdLZZyHNtRrxYtyBinjvYwpc2v7BMy6PNUkHH1Cf4WkeV3JHyd\n5T3jxyLH9L+ECZfTzz/F2mz7SSOz8GsciYPW4wClaua5NwMTUVnaMoMCUFKhnBkJ\nGPlWPuLmkQQLWrTsoBz6ZGWAOcP0IfwIElUMUJMrwJjuTLEbdTpqTpBGCpfPOrra\n5ug2vdbL6ApSZ+FxaGeIwMqcYoMimNL7WgYI8B/u6qkuxP/x+YPA7MJUTPsB3xSm\nSVO3Kq5L9g93FNdibKHL\n=FwP5\n-----END PGP SIGNATURE-----\n","payload":"tree 4efef1ac34abc44dffd56916df305a821be5ca53\nparent 9eb736b074a2698ea5c8be4d07aef5a7cf02107c\nauthor Nishitha M <32355027+imnishitha@users.noreply.github.com> 1783008418 -0400\ncommitter GitHub <noreply@github.com> 1783008418 -0400\n\nfeat(sdk):  add `enabled_tools` allowlist to `FilesystemMiddleware` (#4325)\n\n### Summary\n\n- Adds an `tools` allowlist to `FilesystemMiddleware`. The default keeps\nall tools enabled. Passing an explicit set restricts the model to only\nthose tools.\n- The system prompt dynamically reflects the tools that are actually\nvisible: if a tool is not in the `tools` it is omitted from the prompt\nentirely, so the model is never told about tools it cannot use.\n- Backend capability checks for execute and delete still apply on top of\nthe allowlist. Listing either in `tools` when the backend does not\nsupport them is a no-op, they are silently filtered out.\n- `tools` is threaded through create_deep_agent so the main agent and GP\nsubagent respect it automatically. Declarative subagents use their own\n`FilesystemMiddleware` spec independently.\n- `read_file` cannot be excluded: passing the `tools` without it raises\nValueError at construction time.\n- User-provided tools are never affected by the `tools` list.\n- When passing a custom `FilesystemMiddleware` instance via\n`middleware=`, all desired parameters must be specified explicitly. Any\nomitted parameter falls back to its constructor default.\n\n### Motivation\n\nGives callers explicit control over which filesystem tools are exposed.\nNew tools added to `FilesystemMiddleware` in the future are\nautomatically hidden from restricted agents without requiring config\nupdates.\n\n\nExample\n```Python\n# Read-only agent: write, edit, delete, and execute are never shown\nagent = create_deep_agent(\n    model=\"openai:gpt-5.5\",\n    middleware=[\n        FilesystemMiddleware(\n            backend=backend,\n            tools={\"read_file\", \"ls\", \"glob\", \"grep\"},\n        )\n    ],\n)\n```\n\n---------\n\nSigned-off-by: Nishitha M <32355027+imnishitha@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>\nCo-authored-by: ccurme <chester.curme@gmail.com>\nCo-authored-by: open-swe[bot] <215916821+open-swe[bot]@users.noreply.github.com>","verified_at":"2026-07-02T16:07:00Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/704a70dddbd59b8c6abf658a4211c76bce1445f0","html_url":"https://github.com/langchain-ai/deepagents/commit/704a70dddbd59b8c6abf658a4211c76bce1445f0","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/704a70dddbd59b8c6abf658a4211c76bce1445f0/comments","author":{"login":"imnishitha","id":32355027,"node_id":"MDQ6VXNlcjMyMzU1MDI3","avatar_url":"https://avatars.githubusercontent.com/u/32355027?v=4","gravatar_id":"","url":"https://api.github.com/users/imnishitha","html_url":"https://github.com/imnishitha","followers_url":"https://api.github.com/users/imnishitha/followers","following_url":"https://api.github.com/users/imnishitha/following{/other_user}","gists_url":"https://api.github.com/users/imnishitha/gists{/gist_id}","starred_url":"https://api.github.com/users/imnishitha/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/imnishitha/subscriptions","organizations_url":"https://api.github.com/users/imnishitha/orgs","repos_url":"https://api.github.com/users/imnishitha/repos","events_url":"https://api.github.com/users/imnishitha/events{/privacy}","received_events_url":"https://api.github.com/users/imnishitha/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"9eb736b074a2698ea5c8be4d07aef5a7cf02107c","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9eb736b074a2698ea5c8be4d07aef5a7cf02107c","html_url":"https://github.com/langchain-ai/deepagents/commit/9eb736b074a2698ea5c8be4d07aef5a7cf02107c"}]},{"sha":"9eb736b074a2698ea5c8be4d07aef5a7cf02107c","node_id":"C_kwDOPTymldoAKDllYjczNmIwNzRhMjY5OGVhNWM4YmU0ZDA3YWVmNWE3Y2YwMjEwN2M","commit":{"author":{"name":"ccurme","email":"chester.curme@gmail.com","date":"2026-07-02T14:29:44Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-02T14:29:44Z"},"message":"chore(code): add snapshot test for system message (#4435)","tree":{"sha":"910c2b9cd12c269d66f0921603e3f27a96a9508f","url":"https://api.github.com/repos/l