ub.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"ed3c499354467bc5e8476e5c7cdf0cd5f8b6aec1","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/ed3c499354467bc5e8476e5c7cdf0cd5f8b6aec1","html_url":"https://github.com/langchain-ai/deepagents/commit/ed3c499354467bc5e8476e5c7cdf0cd5f8b6aec1"}]},{"sha":"ed3c499354467bc5e8476e5c7cdf0cd5f8b6aec1","node_id":"C_kwDOPTymldoAKGVkM2M0OTkzNTQ0NjdiYzVlODQ3NmU1YzdjZGYwY2Q1ZjhiNmFlYzE","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-18T22:50:56Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-18T22:50:56Z"},"message":"fix(code): word-delete backspace parity in ask-user text area (#4079)\n\nFix `ctrl+backspace`/`alt+backspace` word deletion in the ask-user\nfree-text input.\n\n---\n\nThe ask-user free-text field didn't support\n`ctrl+backspace`/`alt+backspace` word deletion, unlike the main chat\ninput. This adds the same `delete_word_left` binding to\n`AskUserTextArea` for input parity.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/18d30e16-2f6b-0d6b-e96f-fdbefa421845)\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"393324c49a6081e0d0d0a19265ed2aa6ed7c4dc9","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/393324c49a6081e0d0d0a19265ed2aa6ed7c4dc9"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/ed3c499354467bc5e8476e5c7cdf0cd5f8b6aec1","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqNHZQCRC1aQ7uu5UhlAAALLIQAFUwomFL7FW/ycHiHZmrdpVr\n+XHxuHGElu6GuLMfmtQRrrJdUUd8SosmSAGjMOJj/NSWbKpq9UY0L1a8hRDsLV4u\nnWZKnpIGDDHoiBGtSTrpq4yuKWri4M4tQ+akGaJsEGdrgmNlWn3PtyXcQ1Lfcoum\nJFp1YQDdVBY7pHs36Q+2iIUyw1ZfN11X0dLYPjzMNxwsSw1S+YzHgMsPDJL+qcEK\nYBMupqQCkmB+UvcLse3OdyCo19xLoKfDM+r4nahsgYwCw9PHPtkNNMroaubuzYKQ\n9zZnHlMQ3uuow7LKYbT+5hoiYgJ7c4qaqUg/CRgWyLvfNXzvXfNlN4TZbNrcvcxw\nB76HsLGUIyHCfMT/osWHHFRWf2mRU5x24zS9eCc6twlzVq6egIjao6Yx99QDQIih\nXsOak0naIawHVNMl2CfoBvITJ8mJ3ysHvWc3HQW+MsNfj9j6Npk5Oyye2edd2ucO\nVMHyh8gIX8t4H4HBqA6T+hJ/98O6v3hGH0PG3N7wo/5spfnZ2sX/w/r5fTmaZU9O\nBal38FWbdNFaDKWv7w+/qdZnm0VclrgyXe1RdGDrCg4Vec/DCelggjXCB9TiRMsm\n8eXTsQ9uwF7unE/tC118sK2yWmCbF24OUzlQjlBk6Li7lGYPnED/agrGZq0mKp65\n4T6ioV9xewDga1JFM68Z\n=PDJt\n-----END PGP SIGNATURE-----\n","payload":"tree 393324c49a6081e0d0d0a19265ed2aa6ed7c4dc9\nparent debef9a11f58952360f5be91f69c16cd64cf0196\nauthor Mason Daugherty <mason@langchain.dev> 1781823056 -0400\ncommitter GitHub <noreply@github.com> 1781823056 -0400\n\nfix(code): word-delete backspace parity in ask-user text area (#4079)\n\nFix `ctrl+backspace`/`alt+backspace` word deletion in the ask-user\nfree-text input.\n\n---\n\nThe ask-user free-text field didn't support\n`ctrl+backspace`/`alt+backspace` word deletion, unlike the main chat\ninput. This adds the same `delete_word_left` binding to\n`AskUserTextArea` for input parity.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/18d30e16-2f6b-0d6b-e96f-fdbefa421845)\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-18T22:50:56Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/ed3c499354467bc5e8476e5c7cdf0cd5f8b6aec1","html_url":"https://github.com/langchain-ai/deepagents/commit/ed3c499354467bc5e8476e5c7cdf0cd5f8b6aec1","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/ed3c499354467bc5e8476e5c7cdf0cd5f8b6aec1/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"debef9a11f58952360f5be91f69c16cd64cf0196","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/debef9a11f58952360f5be91f69c16cd64cf0196","html_url":"https://github.com/langchain-ai/deepagents/commit/debef9a11f58952360f5be91f69c16cd64cf0196"}]},{"sha":"debef9a11f58952360f5be91f69c16cd64cf0196","node_id":"C_kwDOPTymldoAKGRlYmVmOWExMWY1ODk1MjM2MGY1YmU5MWY2OWMxNmNkNjRjZjAxOTY","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-18T22:47:52Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-18T22:47:52Z"},"message":"ci(infra): add Dependabot lockfile fixer (#4089)\n\nAdds a narrow `pull_request_target` workflow that repairs out-of-date\n`uv.lock` files on same-repository Dependabot uv PRs. The workflow\nchecks trusted base-branch code first, validates that the PR only\nchanged Dependabot-managed uv package `pyproject.toml`/`uv.lock` files,\nthen requests the App token and regenerates only the affected lockfiles\nusing the existing lockfile checker's package and Python-version logic.\n\nSecurity tradeoff: this still checks out a Dependabot PR head in a\nprivileged workflow so it can push a fix commit, but the token is\ngenerated only after Dependabot identity, same-repo branch,\nbranch-prefix, and changed-file guards pass. The workflow uses trusted\nbase-branch copies of the local uv setup action and lockfile script\ninstead of PR-controlled workflow code.\n\nThe existing `ORG_MEMBERSHIP_APP_ID` App currently has pull requests and\nissues read/write permissions. This workflow requests `contents: write`;\nthe App must be granted that repository permission before the fixer can\npush lockfile commits.\n\nVerified with `actionlint\n.github/workflows/dependabot_lockfile_fix.yml`, the repo pre-commit YAML\nhook, and a local check that the PR #4084 file list maps to `uv lock\n--directory libs/evals --python 3.12`.","tree":{"sha":"617ef476062cf5c94badaeb69be076d53b6a5075","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/617ef476062cf5c94badaeb69be076d53b6a5075"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/debef9a11f58952360f5be91f69c16cd64cf0196","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqNHWYCRC1aQ7uu5UhlAAAW7EQAH5W/DhzDNa7w/iXMfJdtwDt\nE00u5h7w9xQwvXvhJZ3fAkyCx+hcUE0THXMlH8VvYUnId6ddOqvOh1MmTBlVwbz/\n6Xlygl8kpUUTKrMin6ZlVJ0lTd3KyMmoBLX2H3SFNNNzKI3Ep/fc5eaFPZI+Z0+j\nmTYP/rIwvzqzj7SnaiNKJiANckUUkoT7gYZk1pipjGUcB+4Txz/utDklM1dzznZF\ndchQc0Tu3L51XsGzUMCtYi7Fj8sMEQl9LSrXVJI0FBeKKXOKeFQvAb4PjeTXL9P6\n8Jr6Pnm+jRWB9R/bgTkqtK8zeOAgBnjsyFR6OxKW1+hGB8XjbAfLXxWO7/2qi4jq\nalt70wU0ehvhofpA8+M5DvKteJoroBVfGrfKUyY09zWwQ+ie+SVXj3s8bVveYw7W\nm7ILL/4X7KHqY+RhsRlayTakDPx9h/wK+BnU4YhXAQy1YqQluGHYEpID4b9wfICP\nIAW9fa9cP5wgsD0aky8T/I3NV5uQ08YMCSxl2ux8XeWpuGSiH7w+1vvtiPNKZkop\nlelilhXsCHziPJs93KmY7IdMLwKVEpxvzTKMWGSAz5n/hdh87zf4kRAeWbwlqOfL\nNETpEDBSBSdLcaQK10RWS4a3ZH25eBr1mXtsu9NKWpszSdXMDR0IQ9OVSvq2u3cg\nt/5vNsc3XHZwKjYhSK1j\n=mpeO\n-----END PGP SIGNATURE-----\n","payload":"tree 617ef476062cf5c94badaeb69be076d53b6a5075\nparent 8cb116a661b9b3bdfccb5022d5fbd7a67d3e1d8a\nauthor Mason Daugherty <mason@langchain.dev> 1781822872 -0400\ncommitter GitHub <noreply@github.com> 1781822872 -0400\n\nci(infra): add Dependabot lockfile fixer (#4089)\n\nAdds a narrow `pull_request_target` workflow that repairs out-of-date\n`uv.lock` files on same-repository Dependabot uv PRs. The workflow\nchecks trusted base-branch code first, validates that the PR only\nchanged Dependabot-managed uv package `pyproject.toml`/`uv.lock` files,\nthen requests the App token and regenerates only the affected lockfiles\nusing the existing lockfile checker's package and Python-version logic.\n\nSecurity tradeoff: this still checks out a Dependabot PR head in a\nprivileged workflow so it can push a fix commit, but the token is\ngenerated only after Dependabot identity, same-repo branch,\nbranch-prefix, and changed-file guards pass. The workflow uses trusted\nbase-branch copies of the local uv setup action and lockfile script\ninstead of PR-controlled workflow code.\n\nThe existing `ORG_MEMBERSHIP_APP_ID` App currently has pull requests and\nissues read/write permissions. This workflow requests `contents: write`;\nthe App must be granted that repository permission before the fixer can\npush lockfile commits.\n\nVerified with `actionlint\n.github/workflows/dependabot_lockfile_fix.yml`, the repo pre-commit YAML\nhook, and a local check that the PR #4084 file list maps to `uv lock\n--directory libs/evals --python 3.12`.","verified_at":"2026-06-18T22:47:52Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/debef9a11f58952360f5be91f69c16cd64cf0196","html_url":"https://github.com/langchain-ai/deepagents/commit/debef9a11f58952360f5be91f69c16cd64cf0196","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/debef9a11f58952360f5be91f69c16cd64cf0196/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscript