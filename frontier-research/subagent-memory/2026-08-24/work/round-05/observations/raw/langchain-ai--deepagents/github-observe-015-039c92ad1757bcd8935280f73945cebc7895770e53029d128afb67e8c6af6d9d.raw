e_id":"MDQ6VXNlcjQwMTkxODA2","avatar_url":"https://avatars.githubusercontent.com/u/40191806?v=4","gravatar_id":"","url":"https://api.github.com/users/hntrl","html_url":"https://github.com/hntrl","followers_url":"https://api.github.com/users/hntrl/followers","following_url":"https://api.github.com/users/hntrl/following{/other_user}","gists_url":"https://api.github.com/users/hntrl/gists{/gist_id}","starred_url":"https://api.github.com/users/hntrl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hntrl/subscriptions","organizations_url":"https://api.github.com/users/hntrl/orgs","repos_url":"https://api.github.com/users/hntrl/repos","events_url":"https://api.github.com/users/hntrl/events{/privacy}","received_events_url":"https://api.github.com/users/hntrl/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b7eed01facbe1d66f69da974ae115d078ce42065","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/b7eed01facbe1d66f69da974ae115d078ce42065","html_url":"https://github.com/langchain-ai/deepagents/commit/b7eed01facbe1d66f69da974ae115d078ce42065"}]},{"sha":"b7eed01facbe1d66f69da974ae115d078ce42065","node_id":"C_kwDOPTymldoAKGI3ZWVkMDFmYWNiZTFkNjZmNjlkYTk3NGFlMTE1ZDA3OGNlNDIwNjU","commit":{"author":{"name":"github-actions[bot]","email":"41898282+github-actions[bot]@users.noreply.github.com","date":"2026-06-17T21:45:29Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-17T21:45:29Z"},"message":"release(deepagents-code): 0.1.20 (#4053)\n\n> [!CAUTION]\n> Merging this PR will automatically publish to **PyPI** and create a\n**GitHub release**.\n\nFor the full release process, see\n[`.github/RELEASING.md`](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md).\n\n---\n\n_Everything below this line will be the GitHub release body._\n\n---\n\n\n##\n[0.1.20](https://github.com/langchain-ai/deepagents/compare/deepagents-code==0.1.19...deepagents-code==0.1.20)\n(2026-06-17)\n\n### Features\n\n* Manage Tavily web-search API key in `/auth`\n([#4062](https://github.com/langchain-ai/deepagents/issues/4062))\n([90cc099](https://github.com/langchain-ai/deepagents/commit/90cc099b0998a9aa55df01e3bc12ad1597c65365))\n* Surface uninstalled known providers in `/auth` menu\n([#4059](https://github.com/langchain-ai/deepagents/issues/4059))\n([73db271](https://github.com/langchain-ai/deepagents/commit/73db2719bce5ad3c933ffee643df4a62cfd60e17))\n* Show provider in usage stats table\n([#4049](https://github.com/langchain-ai/deepagents/issues/4049))\n([309b054](https://github.com/langchain-ai/deepagents/commit/309b054fdd040adb5086408a3bcb2550ba73439e))\n* Quiet install script's full dependency list\n([#4058](https://github.com/langchain-ai/deepagents/issues/4058))\n([de2c9fd](https://github.com/langchain-ai/deepagents/commit/de2c9fd8c7437fdcdfe738599f83808c5423c55c))\n\n### Bug Fixes\n\n* Read `LANGSMITH_PROJECT` for `tracing.langsmith_project` + show\ndefault\n([#4054](https://github.com/langchain-ai/deepagents/issues/4054))\n([fec1551](https://github.com/langchain-ai/deepagents/commit/fec1551e901a4fe88bd74ee4833a91ef93b1e93f))\n* Surface recommended models missing from installed provider profiles\n([#4057](https://github.com/langchain-ai/deepagents/issues/4057))\n([56e0d31](https://github.com/langchain-ai/deepagents/commit/56e0d31b6c507d5a1e95c3f2058a8d3b9488a4db))\n* Clarify post-update restart semantics\n([#4046](https://github.com/langchain-ai/deepagents/issues/4046))\n([6318b81](https://github.com/langchain-ai/deepagents/commit/6318b817399f7dd2f2e6dc07987dca46f1da9886))\n* Hide `[SYSTEM]` interrupt notices from `/threads` prompt\n([#3988](https://github.com/langchain-ai/deepagents/issues/3988))\n([68fa0cb](https://github.com/langchain-ai/deepagents/commit/68fa0cb4d48ff3f3e552bbf16f8316433c7b6f34))\n* Keep install-required `/model` rows dimmed after navigation\n([#4048](https://github.com/langchain-ai/deepagents/issues/4048))\n([c499634](https://github.com/langchain-ai/deepagents/commit/c499634c530dcab9b18e3126b4573ff0d36c3efa))\n* Rescaffold server workspace on `/restart` when config is missing\n([#4050](https://github.com/langchain-ai/deepagents/issues/4050))\n([de51b0e](https://github.com/langchain-ai/deepagents/commit/de51b0e082293f5f795d96d3bf717c82efb9337e))\n* Remove transient `Restarting server...` message after restart\n([#4047](https://github.com/langchain-ai/deepagents/issues/4047))\n([87cc504](https://github.com/langchain-ai/deepagents/commit/87cc50428bc96ef11dfb11cee4020bff322a7216))\n* Suppress model-switch defer toast on bare reconnect\n([#4060](https://github.com/langchain-ai/deepagents/issues/4060))\n([60b1052](https://github.com/langchain-ai/deepagents/commit/60b10520d24c87b9c8c9d85b94cffae9e3c67c43))\n\n---\n\n_Everything above this line will be the GitHub release body._\n\n---\n\n> [!NOTE]\n> A **New Contributors** section is appended to the GitHub release notes\nautomatically at publish time (see [Release\nPipeline](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md#release-pipeline),\nstep 2).\n\n---------\n\nCo-authored-by: github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","tree":{"sha":"8e0f5d3d2f40627a5288f1be66c0e8a4a786aba9","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/8e0f5d3d2f40627a5288f1be66c0e8a4a786aba9"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/b7eed01facbe1d66f69da974ae115d078ce42065","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMxV5CRC1aQ7uu5UhlAAAERkQAHYCT5U5FSLaqpwSYpBlfCVH\njFQzKQlCfbmfVHXglHCAzw3u4VVfeVAJQiAuJvLLdldENj69XsztLKOP11PFWGhu\n2PBYC2i2mNaJJbUmOj1nqOOm324Evv7/7O6HKSvWJQ4XkXmNiDHC6vIbRcek03+e\nHheXHgJs6wU1q9GToch2eXAtN/C0jW3jG9EL8uXS/QgZbmAJmWB4+Vkv+M24UfsI\nPkSGe1DGMAQZFt08aO2pKlgzbW592cU1jnWsy/4M/dJpt4Lu7ljhI8z9CVmKFfYP\n2NTcTYv1evOzGHYPAgP0TfS7skT+sc+bhFIp2+YUgHvHJVe3KPDRhVrQ6M9McgJl\n+bI6a4vmxby/Epqff29IvJakQoa4Pa9xlSQJ417VTQdjLzjxLtjjvADFdq/Kb25s\nXdtxfu3A9uA3ks+SfZYzv5DApy0JZDdj+Y2SeSAuMmv2+juF4csVH5wF9cWqZoTx\nbFaWutA46hHxlV5oUrLdI4O9nAoDq37lZeCxhRqdAfKV8Gb0TLvxSpyyZhk4efkU\nxxmPQVbuhf7HaF4hc6EZZXXgFchZYFN4Sm300IfAkhJrSVVUGwyvott3PR+eLB75\nxo/fn0W/XPB/hNjxJ+GfD1sfaGiBHqxJtbs9rThZncZCE58BYf9VWid47n51RdTB\nQnIbgHX8g8eQiXeGV8dd\n=5EBB\n-----END PGP SIGNATURE-----\n","payload":"tree 8e0f5d3d2f40627a5288f1be66c0e8a4a786aba9\nparent 60b10520d24c87b9c8c9d85b94cffae9e3c67c43\nauthor github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com> 1781732729 -0400\ncommitter GitHub <noreply@github.com> 1781732729 -0400\n\nrelease(deepagents-code): 0.1.20 (#4053)\n\n> [!CAUTION]\n> Merging this PR will automatically publish to **PyPI** and create a\n**GitHub release**.\n\nFor the full release process, see\n[`.github/RELEASING.md`](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md).\n\n---\n\n_Everything below this line will be the GitHub release body._\n\n---\n\n\n##\n[0.1.20](https://github.com/langchain-ai/deepagents/compare/deepagents-code==0.1.19...deepagents-code==0.1.20)\n(2026-06-17)\n\n### Features\n\n* Manage Tavily web-search API key in `/auth`\n([#4062](https://github.com/langchain-ai/deepagents/issues/4062))\n([90cc099](https://github.com/langchain-ai/deepagents/commit/90cc099b0998a9aa55df01e3bc12ad1597c65365))\n* Surface uninstalled known providers in `/auth` menu\n([#4059](https://github.com/langchain-ai/deepagents/issues/4059))\n([73db271](https://github.com/langchain-ai/deepagents/commit/73db2719bce5ad3c933ffee643df4a62cfd60e17))\n* Show provider in usage stats table\n([#4049](https://github.com/langchain-ai/deepagents/issues/4049))\n([309b054](https://github.com/langchain-ai/deepagents/commit/309b054fdd040adb5086408a3bcb2550ba73439e))\n* Quiet install script's full dependency list\n([#4058](https://github.com/langchain-ai/deepagents/issues/4058))\n([de2c9fd](https://github.com/langchain-ai/deepagents/commit/de2c9fd8c7437fdcdfe738599f83808c5423c55c))\n\n### Bug Fixes\n\n* Read `LANGSMITH_PROJECT` for `tracing.langsmith_project` + show\ndefault\n([#4054](https://github.com/langchain-ai/deepagents/issues/4054))\n([fec1551](https://github.com/langchain-ai/deepagents/commit/fec1551e901a4fe88bd74ee4833a91ef93b1e93f))\n* Surface recommended models missing from installed provider profiles\n([#4057](https://github.com/langchain-ai/deepagents/issues/4057))\n([56e0d31](https://github.com/langchain-ai/deepagents/commit/56e0d31b6c507d5a1e95c3f2058a8d3b9488a4db))\n* Clarify post-update restart semantics\n([#4046](https://github.com/langchain-ai/deepagents/issues/4046))\n([6318b81](https://github.com/langchain-ai/deepagents/commit/6318b817399f7dd2f2e6dc07987dca46f1da9886))\n* Hide `[SYSTEM]` interrupt notices from `/threads` prompt\n([#3988](https://github.com/langchain-ai/deepagents/issues/3988))\n([68fa0cb](https://github.com/langchain-ai/deepagents/commit/68fa0cb4d48ff3f3e552bbf16f8316433c7b6f34))\n* Keep install-required `/model` rows dimmed after navigation\n([#4048](https://github.com/langchain-ai/deepagents/issues/4048))\n([c499634](https://github.com/langchain-ai/deepagents/commit/c499634c530dcab9b18e3126b4573ff0d36c3efa))\n* Rescaffold server workspace on `/restart` when config is missing\n([#4050](https://github.com/langchain-ai/deepagents/issues/4050))\n([de51b0e](https://github.com/langchain-ai/deepagents/commit/de51b0e082293f5f795d96d3bf717c82efb9337e))\n* Remove transient `Restarting server...` message after restart\n([#4047](https://github.com/langchain-ai/deepagents/issues/4047))\n([87cc504](https://github.com/langchain-ai/deepagents/commit/87cc50428bc96ef11dfb11cee4020bff322a7216))\n* Suppress model-switch defer toast on bare reconnect\n([#4060](https://github.com/langchain-ai/deepagents/issues/4060))\n([60b1052](https://github.com/langchain-ai/deepagents/commit/60b10520d24c87b9c8c9d85b94cffae9e3c67c43))\n\n---\n\n_Everything above this line will be the GitHub release body._\n\n---\n\n> [!NOTE]\n> A **New Contributors** section is appended to the GitHub release notes\nautomatically at publish time (see [Release\nPipeline](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md#release-pipeline),\nstep 2).\n\n---------\n\nCo-authored-by: github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","verified_at":"2026-06-17T21:45:30Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/b7eed01facbe1d66f69da974ae115d078ce42065","html_url":"https://github.com/langchain-ai/deepagents/commit/b7eed01facbe1d66f69da974ae115d078ce42065","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/b7eed01facbe1d66f69da974ae115d078ce42065/comments","author":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"60b10520d24c87b9c8c9d85b94cffae9e3c67c43","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/60b10520d24c87b9c8c9d85b94cffae9e3c67c43","html_url":"https://github.com/langchain-ai/deepagents/commit/60b10520d24c87b9c8c9d85b94cffae9e3c67c43"}]},{"sha":"60b10520d24c87b9c8c9d85b94cffae9e3c67c43","node_id":"C_kwDOPTymldoAKDYwYjEwNTIwZDI0Yzg3YjljOGM5ZDg1Yjk0Y2ZmYWU5ZTNjNjdjNDM","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-17T21:33:21Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-17T21:33:21Z"},"message":"fix(code): suppress model-switch defer toast on bare reconnect (#4060)\n\nModel switches that wait on a server reconnect (e.g. after installing a\nprovider extra) no longer show a misleading \"will switch after current\ntask completes\" toast.\n\n---\n\nWhen selecting a model whose provider extra needs installing, the\ninstall-then-switch flow restarts the server. `_respawn_server` flips\n`_connecting` on, posts `ServerReady`, and returns before that message\nis handled, so `_dispatch_model_switch` ran while `_connecting` was\nstill set. The busy guard then deferred the switch *and* fired the\n`\"Model will switch after current task completes.\"` toast — even though\nno real task was in flight. The deferred switch drains automatically\nonce the server is ready and is already confirmed by the following\n`\"Switched to ...\"` message, making the toast misleading noise.\n\nNow the deferral toast only appears for genuine in-flight user work\n(`_agent_running`/`_shell_running`). A switch deferred solely because of\na reconnect is still queued and drained as before — just silently.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/53e81464-0478-a28d-8367-3691f2e65d7a)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"653a3a132f0d02b2861f95eda1babea74ace5001","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/653a3a132f0d02b2861f95eda1babea74ace5001"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/60b10520d24c87b9c8c9d85b94cffae9e3c67c43","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMxKhCRC1aQ7uu5UhlAAAhH8QAH00KZXGcXC9g3Nvt25IX68k\nFxn5xxkiehOmaeI3GnfTz3Vt9rggQ+XVMvc1sBzD05B05mfbBqi6/2lYZfuNG5i7\nvnV9nJFVzvv4M0NR9JvbFdzISY4TQhZoaqhMnHPAcU+up0sHARr74XE5xV03VFZU\n5BPX9jB4b8D7MoimCmCdnynglMh7Vqjul5fmF2fUVihpFz6UfVVHkBC6dJySOv4/\nptAjZUO7uqkBkQIVCdLqtR6tU0Dq8376hz4oUSznC2GjX/Rq3x2R5AGUps09T/0Y\n1rtQOCnh+GrlW6AJEJrpRPV6ZkszqM7zYUpkQLZHgXeSwCsIKDlaRArzXPqI3Lrd\n2Su2bSp27N1FklRkNG1NIsuIvacxCtwRQNp2LHPstK6Ue0SLqli5cGGlvGusVdhG\nA0LbqPZ4d78ClCrY9bmfxO6ooix6vOT3VTSaQRjtGy064XiwgaSbK4TzUDPWEBs4\nCxzCwGKW8Rq+psopdGmw6dEd8m6LHEZypL1Rig0cKkxofWsSRqkHRdDcZhrCgJix\n3AwtSczsUR6S3vEm/4Xxu7DrHU9GMPqJoiDzrDox9GLo/JQkS7XpjsH3r291gZCZ\n8eA2gK0lUroygY6IkS/ZZ4FYstz6//7tV+lwLKFnEcXFf5WjFYgYmY0hE036Ox5+\nsz1oDgEYkqmswvyfT2+g\n=kama\n-----END PGP SIGNATURE-----\n","payload":"tree 653a3a132f0d02b2861f95eda1babea74ace5001\nparent 90cc099b0998a9aa55df01e3bc12ad1597c65365\nauthor Mason Daugherty <mason@langchain.dev> 1781732001 -0400\ncommitter GitHub <noreply@github.com> 1781732001 -0400\n\nfix(code): suppress model-switch defer toast on bare reconnect (#4060)\n\nModel switches that wait on a server reconnect (e.g. after installing a\nprovider extra) no longer show a misleading \"will switch after current\ntask completes\" toast.\n\n---\n\nWhen selecting a model whose provider extra needs installing, the\ninstall-then-switch flow restarts the server. `_respawn_server` flips\n`_connecting` on, posts `ServerReady`, and returns before that message\nis handled, so `_dispatch_model_switch` ran while `_connecting` was\nstill set. The busy guard then deferred the switch *and* fired the\n`\"Model will switch after current task completes.\"` toast — even though\nno real task was in flight. The deferred switch drains automatically\nonce the server is ready and is already confirmed by the following\n`\"Switched to ...\"` message, making the toast misleading noise.\n\nNow the deferral toast only appears for genuine in-flight user work\n(`_agent_running`/`_shell_running`). A switch deferred solely because of\na reconnect is still queued and drained as before — just silently.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/53e81464-0478-a28d-8367-3691f2e65d7a)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-17T21:33:22Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/60b10520d24c87b9c8c9d85b94cffae9e3c67c43","html_url":"https://github.com/langchain-ai/deepagents/commit/60b10520d24c87b9c8c9d85b94cffae9e3c67c43","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/60b10520d24c87b9c8c9d85b94cffae9e3c67c43/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"90cc099b0998a9aa55df01e3bc12ad1597c65365","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/90cc099b0998a9aa55df01e3bc12ad1597c65365","html_url":"https://github.com/langchain-ai/deepagents/commit/90cc099b0998a9aa55df01e3bc12ad1597c65365"}]},{"sha":"90cc099b0998a9aa55df01e3bc12ad1597c65365","node_id":"C_kwDOPTymldoAKDkwY2MwOTliMDk5OGE5YWE1NWRmMDFlM2JjMTJhZDE1OTdjNjUzNjU","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-17T21:33:12Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-17T21:33:12Z"},"message":"feat(code): manage Tavily web-search API key in `/auth` (#4062)\n\nTavily web-search API keys can now be entered and managed from the\n`/auth` Manage API keys screen instead of only via the `TAVILY_API_KEY`\nenvironment variable.\n\n---\n\nSetting up Tavily web search was a dead end: the only path was a\nnotification that pointed at `tavily.com`, with no way to enter a key\nthe way model-provider keys are entered. This surfaces non-model\nservices (starting with Tavily) in the `/auth` Manage API keys screen so\na key can be entered and stored on disk like any provider key.\n\n- A new `SERVICE_API_KEY_ENV` registry (currently just `tavily` →\n`TAVILY_API_KEY`) drives a service-aware `get_service_auth_status`, so\nTavily renders the same `[stored]` / `[env: …]` / `[missing]` badges and\nreuses the existing `AuthPromptScreen`.\n- `apply_stored_service_credentials` bridges a stored key onto its\ncanonical env var during bootstrap, so a key entered in the TUI\nactivates web search on the next launch without exporting anything.\n- The \"Web search disabled\" notification now offers a primary `Enter API\nkey` action that opens the prompt directly.\n\nNote: web search tools are wired at server start from\n`settings.has_tavily`, so a freshly entered key takes effect on the next\nlaunch/restart rather than mid-session — called out in the notification\ncopy.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/cbecdb67-7ab2-8ada-6cf3-8e619c734f59)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"745ff977ff43e7a6f9cf877c58741d5add9c05b8","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/745ff977ff43e7a6f9cf877c58741d5add9c05b8"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/90cc099b0998a9aa55df01e3bc12ad1597c65365","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMxKYCRC1aQ7uu5UhlAAANjcQAItoyo1rGcZGqH03BKFZHPw0\n6QfCzK8o3xanpewfFmDiNLNxszEDjzuJXqOYT22fVGXO/2CLRddC7nF1XeihFzcb\ns7mRJV9kYC6x9MO3oXCMTTrZOPuywJ66BLCotrwRF6/2neyyvTa3dw1SUV+QH+Dr\nUzEwTRA70Agma0FvHfopZpAT45nzxW5p5QRUZ0bGPPv5wiv78/s1R/l/RXVwrQKZ\nHvanQwt5tz3KWqDM8VE/ZPzLuhOSoqY8igSst5Je/j5wzJ1xdSjjc5TkBHpS58jP\nRyfUj7+88YJPeibrEqeAi7uLT487ul7lfl25e4ZIyV2cux4RdqgXzWNBNeoOctMS\nX/W3c4qWZLbWXSmMltlnfBWwAFP7eTkjZyyf+jPtvVwAL7mzUqK/YskNMUczIFw3\nQ8BUVHGDVwYQersZMVeu+rrTtbIB9+AvY2+KmPMuvqbb9fc6N5hUARZ2kuTVirLa\n5MO5L3XtwU0P5esqnn5YV49m7Zzr8EByB+qszUVwTfUNk81UCfLFMbrz5koAVdRK\nxyDRReWkfdU27t9plp9gh+OvnC281id9RTNBXweTPXRADyHmggEoDFMNqsUOtCEO\nWV6qofrJ9Acujk9XQbvpr6gSIgSYZg8TpAxW8okXFdugDCpQZnPTQ5nkEgaTFfJq\nLdxB+l2eBwF+T/vDVd2X\n=KqB/\n-----END PGP SIGNATURE-----\n","payload":"tree 745ff977ff43e7a6f9cf877c58741d5add9c05b8\nparent 73db2719bce5ad3c933ffee643df4a62cfd60e17\nauthor Mason Daugherty <mason@langchain.dev> 1781731992 -0400\ncommitter GitHub <noreply@github.com> 1781731992 -0400\n\nfeat(code): manage Tavily web-search API key in `/auth` (#4062)\n\nTavily web-search API keys can now be entered and managed from the\n`/auth` Manage API keys screen instead of only via the `TAVILY_API_KEY`\nenvironment variable.\n\n---\n\nSetting up Tavily web search was a dead end: the only path was a\nnotification that pointed at `tavily.com`, with no way to enter a key\nthe way model-provider keys are entered. This surfaces non-model\nservices (starting with Tavily) in the `/auth` Manage API keys screen so\na key can be entered and stored on disk like any provider key.\n\n- A new `SERVICE_API_KEY_ENV` registry (currently just `tavily` →\n`TAVILY_API_KEY`) drives a service-aware `get_service_auth_status`, so\nTavily renders the same `[stored]` / `[env: …]` / `[missing]` badges and\nreuses the existing `AuthPromptScreen`.\n- `apply_stored_service_credentials` bridges a stored key onto its\ncanonical env var during bootstrap, so a key entered in the TUI\nactivates web search on the next launch without exporting anything.\n- The \"Web search disabled\" notification now offers a primary `Enter API\nkey` action that opens the prompt directly.\n\nNote: web search tools are wired at server start from\n`settings.has_tavily`, so a freshly entered key takes effect on the next\nlaunch/restart rather than mid-session — called out in the notification\ncopy.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/cbecdb67-7ab2-8ada-6cf3-8e619c734f59)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-17T21:33:13Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/90cc099b0998a9aa55df01e3bc12ad1597c65365","html_url":"https://github.com/langchain-ai/deepagents/commit/90cc099b0998a9aa55df01e3bc12ad1597c65365","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/90cc099b0998a9aa55df01e3bc12ad1597c65365/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"73db2719bce5ad3c933ffee643df4a62cfd60e17","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/73db2719bce5ad3c933ffee643df4a62cfd60e17","html_url":"https://github.com/langchain-ai/deepagents/commit/73db2719bce5ad3c933ffee643df4a62cfd60e17"}]},{"sha":"73db2719bce5ad3c933ffee643df4a62cfd60e17","node_id":"C_kwDOPTymldoAKDczZGIyNzE5YmNlNWFkM2M5MzNmZmVlNjQzZGY0YTYyY2ZkNjBlMTc","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-17T20:28:16Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-17T20:28:16Z"},"message":"feat(code): surface uninstalled known providers in `/auth` menu (#4059)\n\nThe `/auth` menu now lists uninstalled first-party providers greyed-out\nand offers to install them on selection, making them more discoverable.\n\n---\n\nThe `/auth` manager previously only listed providers whose integration\npackage was already installed (plus stored/config providers), so a user\ncouldn't discover a first-party provider they hadn't installed yet. This\nsurfaces known first-party providers whose package is missing as\ngreyed-out `[not installed]` rows. Selecting one routes through the\nexisting `InstallProviderConfirmScreen` (the same install-on-select\npattern as the `/model` switcher); on confirm the screen records the\nextra and dismisses, and the app installs it then reopens the manager so\na key can be added.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/0d6e66b8-0e3d-8ee0-70f0-e37c28ccf22f)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"71676f7358dc97ea43958f24120d28037a4562ca","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/71676f7358dc97ea43958f24120d28037a4562ca"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/73db2719bce5ad3c933ffee643df4a62cfd60e17","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMwNgCRC1aQ7uu5UhlAAAXEQQAFwLnVZFdBOOyMw/6pdCfRWe\nW89DqzBZLUrEWKwZ1QCf1hnC92Q6gBxvO6rw8IF/qoBY3VG2jSgMmdHMoTEA3LMb\nq5biY2ZrM2+3YyOqAhi4958FvpGgb3sw9RPPV2rZLnzlqBI+gW9OeQyap27N5x6C\ngInKcGN2L4GrZhzOlfFjRFTOhuuBDUjXNQk6a7SruqywgvkoSt9QELBzslNiY6Ct\nDb0+Qf7soEkBbzIRpRIAdADjixytKzP5lwNJIR5omTDIqfjNd2oAj7sx2s29/QeB\nsJxXlbK07DXFjwY4xLH2p2b28hEnT06QvNPDmk79lZADMHdiwB6pxO8w5dK2hFpb\nIBVwKCcKKFt4SSa4ypAeg1pTTbSvUjiMz4E5GXQIRuC09cg8t5Xqo7gbym15uCFv\n1+iz/YNVt4b7Q/PDGPhR0dQg7wzHhfpZz3dnT0+IYgsxG36LfMOi52rVulz0LHCp\nW7jFHLve7cSZbv5so0ogE1w526gcsyzwFT15epB9pIYiLsqq0QfhD2Bl1bMnOvY6\nElIPbTxG1kAAMPPGanjOnqQ1xslVgP2go0cmhLYNfSO+1ZIb3hb68dhTF2REfmYt\ncjXRajPRDyO0Q+wKSzAvdgt+CIhvCKG2b0C1aKvL1qtFyMxtFvDyFQxi2aChVxLv\nEfGFPTBAHI2L9XHQIp6Q\n=zEC4\n-----END PGP SIGNATURE-----\n","payload":"tree 71676f7358dc97ea43958f24120d28037a4562ca\nparent 2be01d673feed8571bfdde8a0f6e72a97a03c905\nauthor Mason Daugherty <mason@langchain.dev> 1781728096 -0400\ncommitter GitHub <noreply@github.com> 1781728096 -0400\n\nfeat(code): surface uninstalled known providers in `/auth` menu (#4059)\n\nThe `/auth` menu now lists uninstalled first-party providers greyed-out\nand offers to install them on selection, making them more discoverable.\n\n---\n\nThe `/auth` manager previously only listed providers whose integration\npackage was already installed (plus stored/config providers), so a user\ncouldn't discover a first-party provider they hadn't installed yet. This\nsurfaces known first-party providers whose package is missing as\ngreyed-out `[not installed]` rows. Selecting one routes through the\nexisting `InstallProviderConfirmScreen` (the same install-on-select\npattern as the `/model` switcher); on confirm the screen records the\nextra and dismisses, and the app installs it then reopens the manager so\na key can be added.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/0d6e66b8-0e3d-8ee0-70f0-e37c28ccf22f)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-17T20:28:16Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/73db2719bce5ad3c933ffee643df4a62cfd60e17","html_url":"https://github.com/langchain-ai/deepagents/commit/73db2719bce5ad3c933ffee643df4a62cfd60e17","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/73db2719bce5ad3c933ffee643df4a62cfd60e17/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"2be01d673feed8571bfdde8a0f6e72a97a03c905","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/2be01d673feed8571bfdde8a0f6e72a97a03c905","html_url":"https://github.com/langchain-ai/deepagents/commit/2be01d673feed8571bfdde8a0f6e72a97a03c905"}]},{"sha":"2be01d673feed8571bfdde8a0f6e72a97a03c905","node_id":"C_kwDOPTymldoAKDJiZTAxZDY3M2ZlZWQ4NTcxYmZkZGU4YTBmNmU3MmE5N2EwM2M5MDU","commit":{"author":{"name":"Kavish Kartha","email":"33845687+kavishkartha05@users.noreply.github.com","date":"2026-06-17T19:35:50Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-17T19:35:50Z"},"message":"docs(sdk): add `permissions` and `response_format` to `subagents=` docstring (#4061)\n\nFixes #3970\n\n---\n\nThe `subagents=` parameter docstring listed `tools`, `model`,\n`middleware`, `interrupt_on`, and `skills` as overridable `SubAgent`\nfields but omitted `permissions` and `response_format`, both of which\nare fully supported. Updated the docstring to include them.\n\nDoc-only change. Ran make format and make lint — both passed clean.\n\n## Social handles (optional)\n<!-- If you'd like a shoutout on release, add your socials below -->\nTwitter: @kavishkarth31\nLinkedIn: https://linkedin.com/in/kavish-kartha","tree":{"sha":"55d4e11ee44d5f1d895ae0352256c8803907226d","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/55d4e11ee44d5f1d895ae0352256c8803907226d"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/2be01d673feed8571bfdde8a0f6e72a97a03c905","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMvcWCRC1aQ7uu5UhlAAAuqQQAA6WZPVd6ANXxOslg+ArC5Cr\nGv4XZWfrkckQENUPrPy7iv9H4KoJ0vaEIm196dDLi8AuZabLEHUXpTM0j4ybNanv\n6LfzhzgMNMUIdl0isWCsogGR3cjTLxfOFtsTjK3YvZOTuvsR0CDHtauxeO39YNeC\nkXuNZAmd/IuHrKDRTiEdoLk9J9/mgT5p3lhh3LpF0eLjhhE8OLMMF1cSNwOSF+wk\nCHYcBijkKx+L3MZXdb3RPq/ItAG07wf8ef3DgQf8jzCRPtldCYZTGjE8PPV29rYq\nqSzyFo78D8DojY+Ar7eZcPNoMcCKVTdLokN5DcrTq1LbW1mAtwMpBWbP2T5M2jw0\nd95mnIhFbaAiENiT9RovMKdsR7IhfPrsal6wxDosXdwyEAI+17c+52jFyfj9i5eh\n31qoTM1QO1SvsgGTWb1txTh0oM6lJD25zFwwF1Ud/t570bnCk6v+q4eTHklnLqCU\ncUiik1Jn4oSAZlI0lPldvkGaLJJYRxYJICJdSFu7IGhVtB2qodAi4PiMvfUH91vc\nFUcVRfXcBVZCwzUJueQwqbJDiRC3fSit4J4/9HbwBowmjcbq1yFNnteiFkoDn9hA\nVyBrDdgebfOW1efR46Pu+HeBk2kxX91K2llugD6oPOUiqcBZhIjjlJhRiZNPgOne\n8/oae3WZPiEBfNAVktIQ\n=g2fQ\n-----END PGP SIGNATURE-----\n","payload":"tree 55d4e11ee44d5f1d895ae0352256c8803907226d\nparent de2c9fd8c7437fdcdfe738599f83808c5423c55c\nauthor Kavish Kartha <33845687+kavishkartha05@users.noreply.github.com> 1781724950 -0700\ncommitter GitHub <noreply@github.com> 1781724950 -0400\n\ndocs(sdk): add `permissions` and `response_format` to `subagents=` docstring (#4061)\n\nFixes #3970\n\n---\n\nThe `subagents=` parameter docstring listed `tools`, `model`,\n`middleware`, `interrupt_on`, and `skills` as overridable `SubAgent`\nfields but omitted `permissions` and `response_format`, both of which\nare fully supported. Updated the docstring to include them.\n\nDoc-only change. Ran make format and make lint — both passed clean.\n\n## Social handles (optional)\n<!-- If you'd like a shoutout on release, add your socials below -->\nTwitter: @kavishkarth31\nLinkedIn: https://linkedin.com/in/kavish-kartha","verified_at":"2026-06-17T19:35:50Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/2be01d673feed8571bfdde8a0f6e72a97a03c905","html_url":"https://github.com/langchain-ai/deepagents/commit/2be01d673feed8571bfdde8a0f6e72a97a03c905","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/2be01d673feed8571bfdde8a0f6e72a97a03c905/comments","author":{"login":"kavishkartha05","id":33845687,"node_id":"MDQ6VXNlcjMzODQ1Njg3","avatar_url":"https://avatars.githubusercontent.com/u/33845687?v=4","gravatar_id":"","url":"https://api.github.com/users/kavishkartha05","html_url":"https://github.com/kavishkartha05","followers_url":"https://api.github.com/users/kavishkartha05/followers","following_url":"https://api.github.com/users/kavishkartha05/following{/other_user}","gists_url":"https://api.github.com/users/kavishkartha05/gists{/gist_id}","starred_url":"https://api.github.com/users/kavishkartha05/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kavishkartha05/subscriptions","organizations_url":"https://api.github.com/users/kavishkartha05/orgs","repos_url":"https://api.github.com/users/kavishkartha05/repos","events_url":"https://api.github.com/users/kavishkartha05/events{/privacy}","received_events_url":"https://api.github.com/users/kavishkartha05/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"de2c9fd8c7437fdcdfe738599f83808c5423c55c","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/de2c9fd8c7437fdcdfe738599f83808c5423c55c","html_url":"https://github.com/langchain-ai/deepagents/commit/de2c9fd8c7437fdcdfe738599f83808c5423c55c"}]},{"sha":"de2c9fd8c7437fdcdfe738599f83808c5423c55c","node_id":"C_kwDOPTymldoAKGRlMmM5ZmQ4Yzc0MzdmZGNkZmU3Mzg1OTlmODM4MDhjNTQyM2M1NWM","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-17T19:32:54Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-17T19:32:54Z"},"message":"feat(code): quiet install script's full dependency list (#4058)\n\nThe `dcode` install script printed every transitive dependency (~130\nlines) on a fresh install, which is noise for the common `curl | bash`\npath. The full list only ever appeared on fresh installs, since uv's\ndiff reports every package as newly added.\n\nNow a fresh install suppresses the per-package list entirely — the user\nstill sees the `Installing…` line and the final `✔ deepagents-code\n<version> installed.` / `Setup complete.` confirmation, just not the\nwall of transitive dependencies. The full list stays available behind\nthe existing `DEEPAGENTS_CODE_VERBOSE=1` env var.\n\nUpgrades are unaffected: they still show the compact changed-package\ndiff under `Updated packages:` (`→` for version bumps, `(new)` for added\npackages, `(removed)` for dropped ones), which is small and genuinely\nuseful.\n\nThe two cases are told apart by whether uv's diff contains any removals:\na fresh install — or a pure-addition re-run, e.g. adding an extra to an\nexisting env — has only added rows and is suppressed, while an upgrade\nmixes removed/added rows and is printed.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/b1a5995a-8994-73b4-9bc3-05755afa197e)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"6fd838ecfc98b7bedd04ecfb7c319194a2ddbc2c","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/6fd838ecfc98b7bedd04ecfb7c319194a2ddbc2c"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/de2c9fd8c7437fdcdfe738599f83808c5423c55c","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMvZmCRC1aQ7uu5UhlAAAtAAQAFweqK0IkRe9f3eH6L/LnQUh\nns775gpVi3Db7eXzXZJsOIkLazE4q8It2hL1JsHMProrKN1bSaiVPEFJqkSNB9lX\nmwyaCVF0PZLUomb59p5tIcAc2dQFvuBGBBSkCshPm4ooRG41Fk5rLCmYOTc19kZX\n4mNkFJNibCwVlDmr8186pwMCIpdEInOing8nlAfIkh+O2UkCrhWp98INRAImx8XY\n6gJnBUcg6FYolFYyZ53/PtM4qIHoEgP5HUXX3KRh6vu0n5/z4mFiZjIMrguu1uaf\nPgR1Ikg4KSqvEr23jUfD8YHdr/cqp6COnKoceuVS3St/bJOW/+1CyH2VenMt3Vgg\nLVtzhwd1KpDgycx6JMd6e8m3YLiK/ycpAX5xaTRwRaScsR/6mWuxRI4+Rn8zR7Ok\n3oqhgxORIko1968zgc8RFJdU+TfoAdrhgKZHSSkF3okNFWMZ/5LqPpsE6uTad+hX\nFrqrJD6w8vYXpLHt02HzXgJ3Garvn6FJDnAbWgrJxSwEw+ax1kq//44XyN4It79g\nmogHt082Zu5fLSaiCft6hcTACIwO2OGgGJSXYp2vXZwYFk2tbmO9y+irJxycJpiK\naMrMsfgV3lfrkPG+IzGuzWHjaNYCfYC53I2VpCcTSm+o6impNFsP9WOpP5Lux2UR\n58c05h3R20TbIGsCPvz2\n=RzN3\n-----END PGP SIGNATURE-----\n","payload":"tree 6fd838ecfc98b7bedd04ecfb7c319194a2ddbc2c\nparent 56e0d31b6c507d5a1e95c3f2058a8d3b9488a4db\nauthor Mason Daugherty <mason@langchain.dev> 1781724774 -0400\ncommitter GitHub <noreply@github.com> 1781724774 -0400\n\nfeat(code): quiet install script's full dependency list (#4058)\n\nThe `dcode` install script printed every transitive dependency (~130\nlines) on a fresh install, which is noise for the common `curl | bash`\npath. The full list only ever appeared on fresh installs, since uv's\ndiff reports every package as newly added.\n\nNow a fresh install suppresses the per-package list entirely — the user\nstill sees the `Installing…` line and the final `✔ deepagents-code\n<version> installed.` / `Setup complete.` confirmation, just not the\nwall of transitive dependencies. The full list stays available behind\nthe existing `DEEPAGENTS_CODE_VERBOSE=1` env var.\n\nUpgrades are unaffected: they still show the compact changed-package\ndiff under `Updated packages:` (`→` for version bumps, `(new)` for added\npackages, `(removed)` for dropped ones), which is small and genuinely\nuseful.\n\nThe two cases are told apart by whether uv's diff contains any removals:\na fresh install — or a pure-addition re-run, e.g. adding an extra to an\nexisting env — has only added rows and is suppressed, while an upgrade\nmixes removed/added rows and is printed.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/b1a5995a-8994-73b4-9bc3-05755afa197e)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-17T19:32:55Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/de2c9fd8c7437fdcdfe738599f83808c5423c55c","html_url":"https://github.com/langchain-ai/deepagents/commit/de2c9fd8c7437fdcdfe738599f83808c5423c55c","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/de2c9fd8c7437fdcdfe738599f83808c5423c55c/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"56e0d31b6c507d5a1e95c3f2058a8d3b9488a4db","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/56e0d31b6c507d5a1e95c3f2058a8d3b9488a4db","html_url":"https://github.com/langchain-ai/deepagents/commit/56e0d31b6c507d5a1e95c3f2058a8d3b9488a4db"}]},{"sha":"56e0d31b6c507d5a1e95c3f2058a8d3b9488a4db","node_id":"C_kwDOPTymldoAKDU2ZTBkMzFiNmM1MDdkNWExZTk1YzNmMjA1OGE4ZDNiOTQ4OGE0ZGI","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-17T19:30:31Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-17T19:30:31Z"},"message":"fix(code): surface recommended models missing from installed provider profiles (#4057)\n\nFix `/model` dropping recommended models (e.g. Fireworks Kimi K2.7 Code)\nafter their provider was installed when the provider's upstream profiles\ndidn't list them.\n\n---\n\nIn `/model`, a hardcoded `_RECOMMENDED_MODELS` entry vanished once its\nprovider was installed if the provider's upstream profile list\n(`data/_profiles.py`) didn't include that exact model — the\nrecommended-merge in `_load_model_data` skipped the whole provider via\n`if provider in available: continue`. Now we gate per-spec instead: when\nthe provider is installed/discoverable but the curated spec is missing,\nit's appended as a normal selectable row (the install-required grey-out\npath is unchanged for genuinely uninstalled providers). The detail\nfooter already degrades gracefully when no profile is available.\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"331bbc3e6ea60b5d2b2dc8eaaebf556859622bc9","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/331bbc3e6ea60b5d2b2dc8eaaebf556859622bc9"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/56e0d31b6c507d5a1e95c3f2058a8d3b9488a4db","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMvXXCRC1aQ7uu5UhlAAA90AQAGYNqDVZ9gMnJO7vfu87/Yjp\nKLI1ckDUKqm/lLsGDqqTvdM0lI7ymKwvwKjO4M43sn5GO99xXsu93skCWp5Y/X2g\nxUh/81BGdm8KwZllLyjHd2pt7KWXSXknRgok7sS82S81OZiQfGOLe6tVDRobS0x+\nunVD427LZKjeHGAMSnRW9wxfxxXpXx8S45Iy4Bl4oeDXKbPvZ5PbVe00qSHP1Cy5\ndacpGeS9lfpqQF1qv/mJWH726vsUy6lb8SyYdRkMuHLGV1K9Gd+nTceG5DV7gYQI\n/VZ7RgbGW9OSDPsGa3wD10rdDtPeOe5/pun74A5xnv9vuZN3cBAGFJrlbXnnkJHu\nqn+uGYRoxfZUTn9oVJZhEzoPAHgwbiTQOzq262zwRGwZkExCvnDc9/GXZh2/O+hO\nBz0YUPj+HyXNQtowZr3yPOBc93pnjzlFsdKVKgZPtEdA62nd1WIXrwRy2BIa/i7b\nGy1MbLCfQsbc9wrB9n/BLop7PXQ7SAShCUqeRjajopyEl+Da8b6X0tn1hbP+pqRl\nkjGqskDTqC7LyL1/rqBAwz69Ctt4EHKz7TDxwpIT7uA6o/49AvnbLQ6uUdtk3IHQ\nIgayvML8nOgDXWgrGRj5vh0JHZe4ckCmx4epwytnUzCh7Q6jXaesAwIf0wvbUZRU\n32i0t5i1CmepJZqTbQec\n=8ilM\n-----END PGP SIGNATURE-----\n","payload":"tree 331bbc3e6ea60b5d2b2dc8eaaebf556859622bc9\nparent cc2414d0fc24b3c915bbd0cdf82658269fa37bbe\nauthor Mason Daugherty <mason@langchain.dev> 1781724631 -0400\ncommitter GitHub <noreply@github.com> 1781724631 -0400\n\nfix(code): surface recommended models missing from installed provider profiles (#4057)\n\nFix `/model` dropping recommended models (e.g. Fireworks Kimi K2.7 Code)\nafter their provider was installed when the provider's upstream profiles\ndidn't list them.\n\n---\n\nIn `/model`, a hardcoded `_RECOMMENDED_MODELS` entry vanished once its\nprovider was installed if the provider's upstream profile list\n(`data/_profiles.py`) didn't include that exact model — the\nrecommended-merge in `_load_model_data` skipped the whole provider via\n`if provider in available: continue`. Now we gate per-spec instead: when\nthe provider is installed/discoverable but the curated spec is missing,\nit's appended as a normal selectable row (the install-required grey-out\npath is unchanged for genuinely uninstalled providers). The detail\nfooter already degrades gracefully when no profile is available.\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-17T19:30:32Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/56e0d31b6c507d5a1e95c3f2058a8d3b9488a4db","html_url":"https://github.com/langchain-ai/deepagents/commit/56e0d31b6c507d5a1e95c3f2058a8d3b9488a4db","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/56e0d31b6c507d5a1e95c3f2058a8d3b9488a4db/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"cc2414d0fc24b3c915bbd0cdf82658269fa37bbe","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/cc2414d0fc24b3c915bbd0cdf82658269fa37bbe","html_url":"https://github.com/langchain-ai/deepagents/commit/cc2414d0fc24b3c915bbd0cdf82658269fa37bbe"}]},{"sha":"cc2414d0fc24b3c915bbd0cdf82658269fa37bbe","node_id":"C_kwDOPTymldoAKGNjMjQxNGQwZmMyNGIzYzkxNWJiZDBjZGY4MjY1ODI2OWZhMzdiYmU","commit":{"author":{"name":"Nick Hollon","email":"nick.hollon@langchain.dev","date":"2026-06-17T19:06:16Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-17T19:06:16Z"},"message":"feat(evals): run Harbor with LangGraph agent (#3997)\n\nSwitches terminal-bench Harbor runs to Harbor's LangGraph agent using\nthe Deep Agents Code harness, wires the LangSmith plugin and runtime env\npropagation, removes the custom wrapper/backend, and points Harbor at\nthe integration fork for plugin validation.\n\n---------\n\nCo-authored-by: Mason Daugherty <mason@langchain.dev>","tree":{"sha":"70c1124c63d099dfa0f16075514f4352d02737fa","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/70c1124c63d099dfa0f16075514f4352d02737fa"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/cc2414d0fc24b3c915bbd0cdf82658269fa37bbe","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMvAoCRC1aQ7uu5UhlAAA8GEQAK9FC2zV3hm66HZgBIOMOIDd\nam7kc1wHQZEMJD+1Q1uDshmVjSXrAsxx0tZRRSCWML3/XHgjLJbo4vXplmWuNguU\nq/rBXBLJh/1no7QQY1fmI3r5vmki1u5yqQKwGcfruJvpMHe9RLTgz0H5SLZSy9BC\nir7KZlDfFZnGNwCI91LDaknxE2PXL8THQquFaLNzJJEPs38ewQ41rPjRRi49MFBc\nrXxdQms2gM5l687yP4H16y3Q4r+pn869vnyyIHPlEyNt95sMyj04w0MpXLUqbyFG\n+lDF2ZydcjRu5FGQZGGVFk5maD1PuAG9CaWG0xYiZmeZxIJgkaLFzoSOT5bLeTWF\nu9qWbetSsLcjlICuO71ZklTMFyfeqjK0SpNslWMD1w060TJiXsTqvdOQRJbxR3J5\nWT301bpvmb1SGzJ3+7lLy7/5teRyjxPRtaxx3NypZyWFDBwoABm8HrDZA9Cweivg\n3U4FVn5Y+GLhsNztjKvS/TvmG+HuMkYcrv+OptXmK340BFo7O494f7Gp9qfeUFX7\n6LXV/8tnsjdXRWUvikQ885sfA2fBiRN04f/LOrp5roivIXwpry7okpRDRUMUQv03\nnoROIQFAvIbMqfRkcRDkPi+Bwvc/qJX+tHtZSiy0ZPXyhBFVLYZPQtcidxlsy9Ol\nPxRAmbXC+Rm9XjF8rzZu\n=X3X+\n-----END PGP SIGNATURE-----\n","payload":"tree 70c1124c63d099dfa0f16075514f4352d02737fa\nparent c499634c530dcab9b18e3126b4573ff0d36c3efa\nauthor Nick Hollon <nick.hollon@langchain.dev> 1781723176 -0400\ncommitter GitHub <noreply@github.com> 1781723176 -0400\n\nfeat(evals): run Harbor with LangGraph agent (#3997)\n\nSwitches terminal-bench Harbor runs to Harbor's LangGraph agent using\nthe Deep Agents Code harness, wires the LangSmith plugin and runtime env\npropagation, removes the custom wrapper/backend, and points Harbor at\nthe integration fork for plugin validation.\n\n---------\n\nCo-authored-by: Mason Daugherty <mason@langchain.dev>","verified_at":"2026-06-17T19:06:17Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/cc2414d0fc24b3c915bbd0cdf82658269fa37bbe","html_url":"https://github.com/langchain-ai/deepagents/commit/cc2414d0fc24b3c915bbd0cdf82658269fa37bbe","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/cc2414d0fc24b3c915bbd0cdf82658269fa37bbe/comments","author":{"login":"nick-hollon-lc","id":274035459,"node_id":"U_kgDOEFVzAw","avatar_url":"https://avatars.githubusercontent.com/u/274035459?v=4","gravatar_id":"","url":"https://api.github.com/users/nick-hollon-lc","html_url":"https://github.com/nick-hollon-lc","followers_url":"https://api.github.com/users/nick-hollon-lc/followers","following_url":"https://api.github.com/users/nick-hollon-lc/following{/other_user}","gists_url":"https://api.github.com/users/nick-hollon-lc/gists{/gist_id}","starred_url":"https://api.github.com/users/nick-hollon-lc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nick-hollon-lc/subscriptions","organizations_url":"https://api.github.com/users/nick-hollon-lc/orgs","repos_url":"https://api.github.com/users/nick-hollon-lc/repos","events_url":"https://api.github.com/users/nick-hollon-lc/events{/privacy}","received_events_url":"https://api.github.com/users/nick-hollon-lc/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c499634c530dcab9b18e3126b4573ff0d36c3efa","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/c499634c530dcab9b18e3126b4573ff0d36c3efa","html_url":"https://github.com/langchain-ai/deepagents/commit/c499634c530dcab9b18e3126b4573ff0d36c3efa"}]},{"sha":"c499634c530dcab9b18e3126b4573ff0d36c3efa","node_id":"C_kwDOPTymldoAKGM0OTk2MzRjNTMwZGNhYjliMThlMzEyNmI0NTczZmYwZDM2YzNlZmE","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-17T18:32:50Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-17T18:32:50Z"},"message":"fix(code): keep install-required `/model` rows dimmed after navigation (#4048)\n\nFix `/model` selector so install-required models stay dimmed after the\ncursor moves over them.\n\n---\n\nIn the `/model` selector, install-required (greyed-out) models render\ndimmed, but `_move_selection` rebuilt the deselected row's label without\nthe `install_required` flag — so once the cursor passed over an\nuninstalled row it turned bright (its provider's warning color) and\nnever reverted, making the list inconsistent. The fix threads\n`install_required` through both label rebuilds in `_move_selection`.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/40830357-a2db-0a33-29c5-284f3af973eb)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"3fc6f852c47949ef597a29cfc78107b23cfb4532","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/3fc6f852c47949ef597a29cfc78107b23cfb4532"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/c499634c530dcab9b18e3126b4573ff0d36c3efa","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMuhSCRC1aQ7uu5UhlAAAKfMQAGfjO133ay5bYJi+laxkfGJe\nDjihx+Zv2F8S6FZucI2gwirHADAQupoD/SM5kdgIzI2ZSe55hNPn0RFI45bOUxNM\nfdpzK3CSntOHMPLuTwHZRlMqSDWztUZ69UTnh21Vk7zG7EhYaRlz59KPYXbTYVcd\n9BezotR2BMC+xqFxfrXxWJDuwNIGVY9g8EnmdUwq3aD5mwnXXk7afQLOD7ja9+rf\n/Jwb1XxwCfQ0q1Zg6K92SuHnvX51CoVjpqrubynkUsrgRorMlTbDHtPrckYbTzxw\n+gW5UaaBA348D19FadFL+aDRB9L9RsJ9M1SRYMyHhwN8IMHvEqrK3HCoKKdQsLUB\n+4/Xchw84I8zN1/jNNRqgqYuQ3yx4utSRhTQUqjilEsUjGgAUTVJLyiEwPaFUBi1\n/X6V5XXK0QksjajQiKqtkcIA5eGf5G4/pSDqIBKq6Vi2j8whKlHcu00RvUYiOBr6\n/IQ0kvuaShHjxvM6rtrSZKxVA11QnKjomY/3p0N5bzduw8yMwzFz96ZHbc3E5NmK\n9BB4AnqjAcugdjJXBFuLKTJjlrl/e/0Y4nhimO2FlGhiVAmiJe44MN+x7u6LAwsS\nhH7b8HeWlZYYAVY5zYrSFwKL7S0h7Xkg5/aF+4xp8dhXDIAzEBm0hDSFfhK3R047\nXnpTp3XHHVt4kYLF3ZOZ\n=206g\n-----END PGP SIGNATURE-----\n","payload":"tree 3fc6f852c47949ef597a29cfc78107b23cfb4532\nparent fec1551e901a4fe88bd74ee4833a91ef93b1e93f\nauthor Mason Daugherty <mason@langchain.dev> 1781721170 -0400\ncommitter GitHub <noreply@github.com> 1781721170 -0400\n\nfix(code): keep install-required `/model` rows dimmed after navigation (#4048)\n\nFix `/model` selector so install-required models stay dimmed after the\ncursor moves over them.\n\n---\n\nIn the `/model` selector, install-required (greyed-out) models render\ndimmed, but `_move_selection` rebuilt the deselected row's label without\nthe `install_required` flag — so once the cursor passed over an\nuninstalled row it turned bright (its provider's warning color) and\nnever reverted, making the list inconsistent. The fix threads\n`install_required` through both label rebuilds in `_move_selection`.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/40830357-a2db-0a33-29c5-284f3af973eb)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-17T18:32:51Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/c499634c530dcab9b18e3126b4573ff0d36c3efa","html_url":"https://github.com/langchain-ai/deepagents/commit/c499634c530dcab9b18e3126b4573ff0d36c3efa","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/c499634c530dcab9b18e3126b4573ff0d36c3efa/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"fec1551e901a4fe88bd74ee4833a91ef93b1e93f","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/fec1551e901a4fe88bd74ee4833a91ef93b1e93f","html_url":"https://github.com/langchain-ai/deepagents/commit/fec1551e901a4fe88bd74ee4833a91ef93b1e93f"}]},{"sha":"fec1551e901a4fe88bd74ee4833a91ef93b1e93f","node_id":"C_kwDOPTymldoAKGZlYzE1NTFlOTAxYTRmZTg4YmQ3NGVlNDgzM2E5MWVmOTNiMWU5M2Y","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-17T18:17:35Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-17T18:17:35Z"},"message":"fix(code): read `LANGSMITH_PROJECT` for `tracing.langsmith_project` + show default (#4054)\n\n`dcode config show`/`get`/`ls` now reflect a bare `LANGSMITH_PROJECT`\nand display the default `deepagents-code` project when unset.\n\n---\n\n`dcode config show`/`get`/`ls` resolved `tracing.langsmith_project` only\nfrom `DEEPAGENTS_CODE_LANGSMITH_PROJECT`, so a user relying on a bare\n`LANGSMITH_PROJECT` saw `(unset)` even though agent traces actually\nrouted there via `get_langsmith_project_name`. This adds a generic\n`fallback_env_vars` mechanism to `ConfigOption`/`resolve_scalar` (read\nliterally, after the prefixed primary) and wires `LANGSMITH_PROJECT` as\nthe fallback, plus gives the option its real default (`deepagents-code`)\nso it renders when unset. The default now lives in one shared constant\nused by both the manifest and `get_langsmith_project_name`.\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"6039a032249fd308e121f6a492c600c82d337e49","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/6039a032249fd308e121f6a492c600c82d337e49"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/fec1551e901a4fe88bd74ee4833a91ef93b1e93f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMuS/CRC1aQ7uu5UhlAAAIf0QADmxpVJvmdLHSyuwPsKK38gp\n4gHiw6rbSAF2j1RH7DY7K+7iNEz8udhvkKd0DUEJOgH6JPGxB4YpvqfmUt4CYEEY\nljaZNmyWQaoUUg9H2BvNFFHN/sToXtXiKPR1OBHIk9/m3swoZAXbiPv3BTkEWZIJ\nP6Div1r8Dd+QVLaAYo6PGbt+uu7Tvr0PMnWScXKSg96iGCOjz2w/jNH848dnjmxi\nqym4vmqYb+l0PtijZuTubX7NfppyzcYlG12bVvb8z2THzYl0DnNQtEMTnj1O+RM+\nRruxEOIxAv3H7M74CDgWbyHR9KC6ToH+DnXiyNqS3+npoXqLtbTyRLrJTpSI9pQa\n9I11PdVwok4qH+Io3Ovks376weJi71YskeGWtsPpwZOhdsH3S0JOyOHvn2DJCjnn\n9dS+9k0wQPg+hH6iVF2jcC1Un35y9HedSFYsAYl+k6v2q2qp1uJjCyuxk8x4HniO\nsqoBRnzgarhijJdNTDP6b1NLCl3PtOhXTTFWpVqJQGEZrEEUPPB0852z9kOlIi1K\ni+HYfV2QXTlkWVgU+cEnlyCRGzVEQdLCrUH9GYeXIu2WUYBMWOg4rJkTqhixc5ZR\nDxhtS+K1lmnpePMCKjrNtmDAuUc3P8oR7J5jj6Ttb2LgLeZD4Zf5zbZt6NGVuiGm\nXRg5tW9G3UGTs3wD6BFT\n=OAJ6\n-----END PGP SIGNATURE-----\n","payload":"tree 6039a032249fd308e121f6a492c600c82d337e49\nparent de51b0e082293f5f795d96d3bf717c82efb9337e\nauthor Mason Daugherty <mason@langchain.dev> 1781720255 -0400\ncommitter GitHub <noreply@github.com> 1781720255 -0400\n\nfix(code): read `LANGSMITH_PROJECT` for `tracing.langsmith_project` + show default (#4054)\n\n`dcode config show`/`get`/`ls` now reflect a bare `LANGSMITH_PROJECT`\nand display the default `deepagents-code` project when unset.\n\n---\n\n`dcode config show`/`get`/`ls` resolved `tracing.langsmith_project` only\nfrom `DEEPAGENTS_CODE_LANGSMITH_PROJECT`, so a user relying on a bare\n`LANGSMITH_PROJECT` saw `(unset)` even though agent traces actually\nrouted there via `get_langsmith_project_name`. This adds a generic\n`fallback_env_vars` mechanism to `ConfigOption`/`resolve_scalar` (read\nliterally, after the prefixed primary) and wires `LANGSMITH_PROJECT` as\nthe fallback, plus gives the option its real default (`deepagents-code`)\nso it renders when unset. The default now lives in one shared constant\nused by both the manifest and `get_langsmith_project_name`.\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-17T18:17:35Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/fec1551e901a4fe88bd74ee4833a91ef93b1e93f","html_url":"https://github.com/langchain-ai/deepagents/commit/fec1551e901a4fe88bd74ee4833a91ef93b1e93f","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/fec1551e901a4fe88bd74ee4833a91ef93b1e93f/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"de51b0e082293f5f795d96d3bf717c82efb9337e","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/de51b0e082293f5f795d96d3bf717c82efb9337e","html_url":"https://github.com/langchain-ai/deepagents/commit/de51b0e082293f5f795d96d3bf717c82efb9337e"}]},{"sha":"de51b0e082293f5f795d96d3bf717c82efb9337e","node_id":"C_kwDOPTymldoAKGRlNTFiMGUwODIyOTNmNWY3OTVkOTZkM2JmNzE3YzgyZWZiOTMzN2U","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-17T18:10:09Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-17T18:10:09Z"},"message":"fix(code): rescaffold server workspace on `/restart` when config is missing (#4050)\n\nFix `/restart` failing with \"langgraph.json not found\" when the server's\ntemp working directory was purged.\n\n---\n\nThe `langgraph dev` server runs from a temp work dir scaffolded at boot.\nIf that dir's `langgraph.json` vanishes before a later `/restart` (e.g.\nthe OS tmp reaper purging `$TMPDIR`), the restart failed with\n`RuntimeError: langgraph.json not found ... Call\ngenerate_langgraph_json() first` — exactly the error users hit after\n`/install <extra>` auto-restarts. `ServerProcess` now takes a scaffold\nhook and rebuilds the workspace when the config is missing instead of\nfailing.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/3bf48cdb-540d-2913-5fe1-8846646f7ab8)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"c53feab983244fb2ac90c5babbbb14a83ef0934e","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/c53feab983244fb2ac90c5babbbb14a83ef0934e"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/de51b0e082293f5f795d96d3bf717c82efb9337e","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMuMBCRC1aQ7uu5UhlAAAYIMQAJWZHYYxxkKS8/T9UFWnSypy\nBYGtRDbMQwaFJJREwwjbdTJ11dFw8mPFy/1b4k3TXboMIpWhVV8BUUS1h+doMW6f\nP/PG3DdOV7/QPwyZJyiNl0EvHOgy9W4WMVEzTyLFodSBgpOXi6wygKLcSVQwV3+I\n7QDlCsGpxeZ933OGWo+fP7nNqP4BunpHJ7msZTacTxml42QgwpcQ77KduogW5HDe\nha850FxLKZ1x3bFEUFsJAdZ8pE2hW8p8txholBDOrOWoimlps4EQUERFjYE701yZ\naRtFeDCC9xo5ctOfltrcp3LbJzEjXAJQjLmhCxhCItY0HYMjKFhMfCBnOLaEZz7O\n2Z1xfSjrgeUfOwK/9GKGgiEqgX2o7vT+lk3XzoOYw3Y/IKgy+yCL0BY+2d0fu9P4\npqnx5U+ADNUNFwC9rfN9NHpA80wXk5Ud43JqOIEKVguxscHoytUPAeTMNu20YDuf\nG4kWIwRXbmxFurlWZah2nIJ5Bd6n+wMLxzpiOMciLXHwwMm2PwzOffRgzgIAWJEN\nbqyU4wlGOFxLt5pWqu5XtfAP4vRtcbn00VcM41f6ZbTcP/s6LQTSE7Tiukfhyafo\n5DabYBcFvadmgsSXTTQ8Qw4LAe0juuPZPgmfDFADJrrQ1eV6IjEsTdnB8zsVbjse\nThpp8mN+jd2xAw53X6g5\n=KW+R\n-----END PGP SIGNATURE-----\n","payload":"tree c53feab983244fb2ac90c5babbbb14a83ef0934e\nparent 87cc50428bc96ef11dfb11cee4020bff322a7216\nauthor Mason Daugherty <mason@langchain.dev> 1781719809 -0400\ncommitter GitHub <noreply@github.com> 1781719809 -0400\n\nfix(code): rescaffold server workspace on `/restart` when config is missing (#4050)\n\nFix `/restart` failing with \"langgraph.json not found\" when the server's\ntemp working directory was purged.\n\n---\n\nThe `langgraph dev` server runs from a temp work dir scaffolded at boot.\nIf that dir's `langgraph.json` vanishes before a later `/restart` (e.g.\nthe OS tmp reaper purging `$TMPDIR`), the restart failed with\n`RuntimeError: langgraph.json not found ... Call\ngenerate_langgraph_json() first` — exactly the error users hit after\n`/install <extra>` auto-restarts. `ServerProcess` now takes a scaffold\nhook and rebuilds the workspace when the config is missing instead of\nfailing.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/3bf48cdb-540d-2913-5fe1-8846646f7ab8)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-17T18:10:10Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/de51b0e082293f5f795d96d3bf717c82efb9337e","html_url":"https://github.com/langchain-ai/deepagents/commit/de51b0e082293f5f795d96d3bf717c82efb9337e","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/de51b0e082293f5f795d96d3bf717c82efb9337e/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"87cc50428bc96ef11dfb11cee4020bff322a7216","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/87cc50428bc96ef11dfb11cee4020bff322a7216","html_url":"https://github.com/langchain-ai/deepagents/commit/87cc50428bc96ef11dfb11cee4020bff322a7216"}]},{"sha":"87cc50428bc96ef11dfb11cee4020bff322a7216","node_id":"C_kwDOPTymldoAKDg3Y2M1MDQyOGJjOTZlZjExZGZiMTFjZWU0MDIwYmZmMzIyYTcyMTY","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-17T17:57:37Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-17T17:57:37Z"},"message":"fix(code): remove transient `Restarting server...` message after restart (#4047)\n\nThe `Restarting server...` status message is now cleared after a\nsuccessful restart instead of lingering in the chat.\n\n---\n\nThe `Restarting server...` app message implies work is still in\nprogress, but it lingered in the chat history after the restart had\nalready finished. Both the `/restart` command and the post-`/install`\nauto-restart now mount it as a transient status message (not tracked by\nthe message store) and remove it once the restart succeeds, leaving only\nthe `Restart complete.` banner. On a failed restart it stays put as user\nfeedback.\n\nA small `_mount_transient_app_message` helper centralizes mounting\nstatus text that should disappear once its state resolves, mirroring the\nexisting retry-status widget pattern.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/bb73d33f-1896-a270-a2be-911f1e30ae95)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"42de335a46f46c48827be4c599f76a6dda677766","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/42de335a46f46c48827be4c599f76a6dda677766"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/87cc50428bc96ef11dfb11cee4020bff322a7216","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMuARCRC1aQ7uu5UhlAAAVV8QAInoYt/OPLh57zwlTm9vqjQy\n3ejlWmC6LcqB9x1s/v+7FyV+DUW3KgQV1AL6mp+ldi9iRvLYJj/lzSMwyezggijx\nj4O/BTFIRF6rKhLpWG6tJPHJw1Ty+DGd3AvrUbH1oB0tXkTAzSBI4jMqa0f6eGFK\n17ZtsJvWHjW+ffN+peOPoMdKUqJCHRrLBtm0WALT0vux5NImWr+sJFsaXb0h0mvD\n/ZJQC1tTqlQob3nZrwVgngvTfoi4x6dnss4zaJM8Wp34YIkLLiVRTk1BdVTBUbpv\nXnBwtYfHTMRD1QdREnSrWUeI83SuyKdis5eJFf91n/kLwpWO8qu9G1mj3oJlWbRk\nRxAcjlqhrRrvC73tL5xhf8VuGSWpbqdGsCkMGuxBniihl81V+9ZpLiXUHY7/k+R0\nVp+uaUhRxEZCLlU4vO2Fj3/vbcxnwey663IYSxidVNqCLO89tiMcZ4AdNopR7qvc\nVFS9rb88mM4qV80PiqkujgubiwEBXyg1Bpj2HH4SFD7XTD1F2dKeBOLYOh5ZEui0\ncTlaLea3lpNyojQQTeJl2jCsj5acQismiitq7ZgsnlipO7Hzrr+whrXVP+aHMHCP\nTToC8qfJxzbw4h12+gDN56TVcUKJUPbQSWVIWGenZGGL7If6WSqz/Xfs5u7qx0xY\nqUZcdMmr5QHMMjmzyCJl\n=bXmf\n-----END PGP SIGNATURE-----\n","payload":"tree 42de335a46f46c48827be4c599f76a6dda677766\nparent 6318b817399f7dd2f2e6dc07987dca46f1da9886\nauthor Mason Daugherty <mason@langchain.dev> 1781719057 -0400\ncommitter GitHub <noreply@github.com> 1781719057 -0400\n\nfix(code): remove transient `Restarting server...` message after restart (#4047)\n\nThe `Restarting server...` status message is now cleared after a\nsuccessful restart instead of lingering in the chat.\n\n---\n\nThe `Restarting server...` app message implies work is still in\nprogress, but it lingered in the chat history after the restart had\nalready finished. Both the `/restart` command and the post-`/install`\nauto-restart now mount it as a transient status message (not tracked by\nthe message store) and remove it once the restart succeeds, leaving only\nthe `Restart complete.` banner. On a failed restart it stays put as user\nfeedback.\n\nA small `_mount_transient_app_message` helper centralizes mounting\nstatus text that should disappear once its state resolves, mirroring the\nexisting retry-status widget pattern.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/bb73d33f-1896-a270-a2be-911f1e30ae95)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-17T17:57:37Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/87cc50428bc96ef11dfb11cee4020bff322a7216","html_url":"https://github.com/langchain-ai/deepagents/commit/87cc50428bc96ef11dfb11cee4020bff322a7216","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/87cc50428bc96ef11dfb11cee4020bff322a7216/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"6318b817399f7dd2f2e6dc07987dca46f1da9886","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/6318b817399f7dd2f2e6dc07987dca46f1da9886","html_url":"https://github.com/langchain-ai/deepagents/commit/6318b817399f7dd2f2e6dc07987dca46f1da9886"}]},{"sha":"6318b817399f7dd2f2e6dc07987dca46f1da9886","node_id":"C_kwDOPTymldoAKDYzMThiODE3Mzk5ZjdkZDJmMmU2ZGMwNzk4N2RjYTQ2ZjFkYTk4ODY","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-17T17:34:57Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-17T17:34:57Z"},"message":"fix(cli): clarify post-update restart semantics (#4046)\n\nUpdate messages now clearly tell users to quit and relaunch dcode (not\n`/restart`) to load a newly installed version.\n\n---\n\nThe post-update copy said \"Restart to use the new version,\" which users\nnaturally interpreted as the `/restart` slash command. But `/restart`\nonly respawns the server subprocess — it doesn't reload the running CLI,\nso the new version never took effect. Reworded the update\nsuccess/availability messages to instruct quitting and relaunching\n`dcode`, and clarified that `/restart` is server-only.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/f99c0bcd-6536-1db7-816f-0b4bae8fbb73)\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"569985344de889495c17b1b105aff98ff51c50ed","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/569985344de889495c17b1b105aff98ff51c50ed"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/6318b817399f7dd2f2e6dc07987dca46f1da9886","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMtrBCRC1aQ7uu5UhlAAA4LMQAJkjyxKAMbVUBuk8honm8EBh\njcRFBSisXLQtbKyjESBDjI4yzGLAe3pc9U71XrXMWlx0HbJ9tWCpeRrkoTZ8qD+g\nP1YPUF7VQAMMyX7Sx1WLu91+NwF8RplUQ4i8uEOKCI+qeYaHR964Hqlmx0kxsant\nNcwoEuW64X5YTJ2eEqgafMdwZuj15TTHL2/RcPvSEHBIubL8YjnHq/Vu/ADXsyqm\nY801uSlOMOcCJdV9e7ayeM9GXdruyH3h/D72kbDL7KMXL5KgbUwOPyvMDzXJBgSg\nZqHbJyfbQ02Z5EjFbjaYrTpNPwnnvhXAsitJOekojIok+OGDUd9/RixbJypR1JY3\nP7T1tIL9QMvmgl+5U4nihJHDzgNXqNb/cGypEbpo6pgXH1WtbmnNN/8DGlMYb4PI\nrdirz1codxpuXvdP+8G9EB0k+fmk86xt3nM9a7sxZud3N1NhgBJSlz+cBdo1S7Gx\nAPffDTEthK0yrNcX69uvt4qSq7B5Kc2xKC0q0uLNpL6zgasXMCaTtWLpx6PbFESO\nW812VMnmFuG13ARmua56n8wmRbgHPJ9+38TTVy6Watq6HSONrj5pn+jNxQoG0XXQ\n5VxvS14bl0Alr+lr3HT7FYbxPIHPN5UMuilfIutGA59Bt4PutUkLS0lOIVzvb3ey\nV3yjH6bWqdSt3cYWdZvK\n=zw1N\n-----END PGP SIGNATURE-----\n","payload":"tree 569985344de889495c17b1b105aff98ff51c50ed\nparent 68fa0cb4d48ff3f3e552bbf16f8316433c7b6f34\nauthor Mason Daugherty <mason@langchain.dev> 1781717697 -0400\ncommitter GitHub <noreply@github.com> 1781717697 -0400\n\nfix(cli): clarify post-update restart semantics (#4046)\n\nUpdate messages now clearly tell users to quit and relaunch dcode (not\n`/restart`) to load a newly installed version.\n\n---\n\nThe post-update copy said \"Restart to use the new version,\" which users\nnaturally interpreted as the `/restart` slash command. But `/restart`\nonly respawns the server subprocess — it doesn't reload the running CLI,\nso the new version never took effect. Reworded the update\nsuccess/availability messages to instruct quitting and relaunching\n`dcode`, and clarified that `/restart` is server-only.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/f99c0bcd-6536-1db7-816f-0b4bae8fbb73)\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-17T17:34:58Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/6318b817399f7dd2f2e6dc07987dca46f1da9886","html_url":"https://github.com/langchain-ai/deepagents/commit/6318b817399f7dd2f2e6dc07987dca46f1da9886","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/6318b817399f7dd2f2e6dc07987dca46f1da9886/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"68fa0cb4d48ff3f3e552bbf16f8316433c7b6f34","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/68fa0cb4d48ff3f3e552bbf16f8316433c7b6f34","html_url":"https://github.com/langchain-ai/deepagents/commit/68fa0cb4d48ff3f3e552bbf16f8316433c7b6f34"}]},{"sha":"68fa0cb4d48ff3f3e552bbf16f8316433c7b6f34","node_id":"C_kwDOPTymldoAKDY4ZmEwY2I0ZDQ4ZmYzZjNlNTUyYmJmMTZmODMxNjQzM2M3YjZmMzQ","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-17T17:15:18Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-17T17:15:18Z"},"message":"fix(code): hide `[SYSTEM]` interrupt notices from `/threads` prompt (#3988)\n\nWhen a task is interrupted, dcode persists a synthetic `[SYSTEM] Task\ninterrupted by user.` `HumanMessage` into the thread's `messages`\nchannel. Because `_initial_prompt_from_messages` returned the first\nhuman-typed message verbatim, this notice could surface as a thread's\nprompt in the `/threads` selector instead of the user's real request.\n\nThe parser now skips `[SYSTEM]`-prefixed human messages and falls\nthrough to the next genuine human message, mirroring the existing\n`[SYSTEM]` filtering already done when rendering a loaded thread's\nmessages.\n\nMade by [Open SWE](https://openswe.vercel.app)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"140f142c29984cb34898cb5006ec09adffa4c74e","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/140f142c29984cb34898cb5006ec09adffa4c74e"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/68fa0cb4d48ff3f3e552bbf16f8316433c7b6f34","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMtYmCRC1aQ7uu5UhlAAAdz8QAJGwOiXqS4FCnts6b4djDekk\nXMu8q6JblZ80ngqAQG468ZPsnS2dxFAcDqRcUp57I7UKNkOg/KLmTvUCObfCPaYX\nC8IoDRVHZ+xeOr6dMtWuQv9mM0aYdKil66uhUI5hEUcTzov+zHx1O9/ilGFk6IKW\n47KpFvWm/oFGh0tES8guMhAVdYy7VfhbxR+u2AvQ3vbf4g5wG3AlSM66+hx7IVoB\nM3xS1lGvhtZn3dWwcrdj3ZLhNqQSjEWZVeFq0teOiWMvhwnBMBnb32vbMjsvbM8w\n8mlMqHHkrS+KYnJrKJi9ky6EFdGjGXMCBgtcRgrtojCbc83Ls64n82DoDqItm+ca\nSvv+qF6x6F48Z5B3gHuMrLdTilpDpauE9ziN9xgiOIeqZDFHYC5fOaw4uC3r/n5A\nN/cxg4fHuQfcHIdVU1fGa7WgAZCMLaCk3VYVXLa87sv9sPtDJekv00eZxq8aTuZP\nuoKHSsJddgisNzqL+DBR0G1zI7DJGF64JBFioU3ncz30w+CeXuYUFEGL+MWe3T1l\nW1MbtBepAuEN/V0qmjv6gUSUAIbMUTWDGdz8z1IgTE+a8CV5INWcK1LXDmjQ2l5u\ndB9Be/WO/hzpzbOVNXGQlhhfU/YtR5PGmtZ0mE/aZYb3IzrBLR/YmIPIh1fpmqEc\n5nhMkF9p2xvPeqPDi6/P\n=ymQJ\n-----END PGP SIGNATURE-----\n","payload":"tree 140f142c29984cb34898cb5006ec09adffa4c74e\nparent 309b054fdd040adb5086408a3bcb2550ba73439e\nauthor Mason Daugherty <mason@langchain.dev> 1781716518 -0400\ncommitter GitHub <noreply@github.com> 1781716518 -0400\n\nfix(code): hide `[SYSTEM]` interrupt notices from `/threads` prompt (#3988)\n\nWhen a task is interrupted, dcode persists a synthetic `[SYSTEM] Task\ninterrupted by user.` `HumanMessage` into the thread's `messages`\nchannel. Because `_initial_prompt_from_messages` returned the first\nhuman-typed message verbatim, this notice could surface as a thread's\nprompt in the `/threads` selector instead of the user's real request.\n\nThe parser now skips `[SYSTEM]`-prefixed human messages and falls\nthrough to the next genuine human message, mirroring the existing\n`[SYSTEM]` filtering already done when rendering a loaded thread's\nmessages.\n\nMade by [Open SWE](https://openswe.vercel.app)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-17T17:15:19Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/68fa0cb4d48ff3f3e552bbf16f8316433c7b6f34","html_url":"https://github.com/langchain-ai/deepagents/commit/68fa0cb4d48ff3f3e552bbf16f8316433c7b6f34","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/68fa0cb4d48ff3f3e552bbf16f8316433c7b6f34/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"309b054fdd040adb5086408a3bcb2550ba73439e","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/309b054fdd040adb5086408a3bcb2550ba73439e","html_url":"https://github.com/langchain-ai/deepagents/commit/309b054fdd040adb5086408a3bcb2550ba73439e"}]},{"sha":"309b054fdd040adb5086408a3bcb2550ba73439e","node_id":"C_kwDOPTymldoAKDMwOWIwNTRmZGQwNDBhZGI1MDg2NDA4YTNiY2IyNTUwYmE3MzQzOWU","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-17T15:48:25Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-17T15:48:25Z"},"message":"feat(code): show provider in usage stats table (#4049)\n\n## Description\nThe session teardown usage stats table listed only the model name, so\nmulti-provider sessions were ambiguous. This adds the serving provider,\nsourced from `settings.model_provider` and threaded through\n`record_request` at both usage call sites (`non_interactive` and the\nTextual streaming loop).\n\nThe per-model breakdown is now keyed by the `(provider, model_name)`\npair rather than the model name alone, so the same model served by two\nproviders (e.g. `gpt-5.5` via `openai` vs `azure`) renders as separate\nrows instead of collapsing into one. A new `Provider` column displays\nthe value, with totals in a trailing row for multi-model sessions.\n\n## Release Note\nThe model usage stats table shown on exit now includes the provider name\nalongside the model name.\n\n## Tests\nCoverage is automated, so no manual verification is needed:\n- The recording API (`SessionStats.record_request` / `merge`) is\nunit-tested for provider capture and same-model/different-provider\nsplitting.\n- Call-site wiring is covered end-to-end — both `non_interactive` and\n`execute_task_textual` are exercised to confirm\n`settings.model_provider` actually reaches `record_request`, including\nthe `total_tokens`-only fallback path.\n- `print_usage_table` rendering asserts the `Provider` column and that\nsame-name models from different providers produce distinct rows with\ntheir own per-row token counts.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/98964857-39db-630c-b2b6-40b8fd726bc3)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"f8e3aeb3259e92f91b1137872441390ac95ab0d8","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/f8e3aeb3259e92f91b1137872441390ac95ab0d8"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/309b054fdd040adb5086408a3bcb2550ba73439e","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMsHJCRC1aQ7uu5UhlAAAeq4QAIu/HSjZyV8ZCIcH7G9BFNnn\nq7bJQtwDeloMqMe8XPBVG21ymjDjhd6f+yOMWmT1VTa8J4vxFZxf/gcJqLJJ3Uj2\ny1pohjOi7LO9xivjVGPFdQdBPnlalUuWnLQ/FOh8uyH0CfuUoJ7evuAE83u2fuhy\n8t2dx9+ZXdK46CYL06JFX7UbPfZ2Kq4NBtZZ7lTgMP4bQud2xCR2fJSU/4+boaO/\nOA8FwpNpGNcmJ5mzfg6HjmyFOF+odhW3YJzd+Lt0ZGqQIc5WzwGTOS/tu+zAIcoz\nzMaJlhG4PCRbhD/JPX7EJXCpV9xC/uv+lShpq499Mrlc4pdx3/2KKQA7zBO+P74A\nLULPRPm4P0sy7SFdxc+BGf/4jHunihlcm/xjQEauc4bymgxD8IxSR1OPRJ+l9qDB\nTQkQ642u/6+m5TrizdIdFwKUHwANQCdwFpdWgUIeXaHTbch0hAQA6QnDjTBHO/Zy\nhSuexIAQCaoGMrm2e1kbnIWJiXWgnwPBKsZQiqjAoppEnIxBAdIXfwK8ZMIRrtMr\nVWAYfkc0NDMu92TKygiyklAmAdE5PjTgjjJUikBiju66lDJCOujcDT+kQ8+mo0bS\nupGnLROBglqHRqe0gGyI2OVSlwC0sgxqYq60tEIx3wNqva8rou2CDmXWPOrgXjf4\n6xwR6GCgv4rEtpkH1qWf\n=ZBNa\n-----END PGP SIGNATURE-----\n","payload":"tree f8e3aeb3259e92f91b1137872441390ac95ab0d8\nparent 52dcf1a42cb00dd614b336038e4398472f78859d\nauthor Mason Daugherty <mason@langchain.dev> 1781711305 -0400\ncommitter GitHub <noreply@github.com> 1781711305 -0400\n\nfeat(code): show provider in usage stats table (#4049)\n\n## Description\nThe session teardown usage stats table listed only the model name, so\nmulti-provider sessions were ambiguous. This adds the serving provider,\nsourced from `settings.model_provider` and threaded through\n`record_request` at both usage call sites (`non_interactive` and the\nTextual streaming loop).\n\nThe per-model breakdown is now keyed by the `(provider, model_name)`\npair rather than the model name alone, so the same model served by two\nproviders (e.g. `gpt-5.5` via `openai` vs `azure`) renders as separate\nrows instead of collapsing into one. A new `Provider` column displays\nthe value, with totals in a trailing row for multi-model sessions.\n\n## Release Note\nThe model usage stats table shown on exit now includes the provider name\nalongside the model name.\n\n## Tests\nCoverage is automated, so no manual verification is needed:\n- The recording API (`SessionStats.record_request` / `merge`) is\nunit-tested for provider capture and same-model/different-provider\nsplitting.\n- Call-site wiring is covered end-to-end — both `non_interactive` and\n`execute_task_textual` are exercised to confirm\n`settings.model_provider` actually reaches `record_request`, including\nthe `total_tokens`-only fallback path.\n- `print_usage_table` rendering asserts the `Provider` column and that\nsame-name models from different providers produce distinct rows with\ntheir own per-row token counts.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/98964857-39db-630c-b2b6-40b8fd726bc3)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-17T15:48:26Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/309b054fdd040adb5086408a3bcb2550ba73439e","html_url":"https://github.com/langchain-ai/deepagents/commit/309b054fdd040adb5086408a3bcb2550ba73439e","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/309b054fdd040adb5086408a3bcb2550ba73439e/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"52dcf1a42cb00dd614b336038e4398472f78859d","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/52dcf1a42cb00dd614b336038e4398472f78859d","html_url":"https://github.com/langchain-ai/deepagents/commit/52dcf1a42cb00dd614b336038e4398472f78859d"}]},{"sha":"52dcf1a42cb00dd614b336038e4398472f78859d","node_id":"C_kwDOPTymldoAKDUyZGNmMWE0MmNiMDBkZDYxNGIzMzYwMzhlNDM5ODQ3MmY3ODg1OWQ","commit":{"author":{"name":"Nishitha M","email":"32355027+imnishitha@users.noreply.github.com","date":"2026-06-17T13:41:19Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-17T13:41:19Z"},"message":"fix(sdk): route `BaseSandbox async` helpers through aexecute (#3996)\n\nFixes #665\n\n## Problem\n\n`BaseSandbox`'s async helpers (`als`, `aread`, `agrep`, `aglob`,\n`awrite`, `aedit`) previously wrapped the corresponding sync methods in\n`asyncio.to_thread`, meaning overriding `aexecute` with a native async\nimplementation (e.g. wrapping an async SDK like Daytona's\n`AsyncSandbox`) had no effect on those helpers, they still ran the sync\npath in a thread pool. Subclasses were forced to override all 9\nfile-operation methods to get native async behavior.\n\n## Fix\n\nThis PR overrides all six async helpers in `BaseSandbox` to call\n`aexecute`/`aupload_files` directly. Subclasses now only need to\noverride those three core methods. To avoid duplicating command-building\nand output-parsing logic between sync and async paths, each method's\npure logic was factored into private helpers shared by both. Sync\nmethods and their behavior are completely unchanged.\n\n## Tests\n\nAdded a `NativeAsyncSandbox` test fixture where `exes `RuntimeError`, if\nany async helper falls backto the sync path, the test fails immediately.\nSeven new `@pytest.mark.asyncio` tests cover each overridden method\n(`als`, `aread`, `agrep`, `aglob`, `awrite`, inline `aedit`, and\nlarge-payload `aedit` via upload), asserting that\n`aexecute`/`aupload_files` are\ncalled the expected number of times and results are tests continue to\npass.\n\n---------\n\nSigned-off-by: Nishitha M <32355027+imnishitha@users.noreply.github.com>\nCo-authored-by: Eugene Yurtsev <eugene@langchain.dev>","tree":{"sha":"7ab09bbda03d13726ddbce862ce3f66212d8d2f2","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/7ab09bbda03d13726ddbce862ce3f66212d8d2f2"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/52dcf1a42cb00dd614b336038e4398472f78859d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMqP/CRC1aQ7uu5UhlAAAyTUQAKfkUwAJe9YLm5rQ0RO1aexo\nVMgWq4pwfiPcGanUmPqEYBWZiQpbZLW7f/MgcPzobJE5QF1kNuvWLOJLxWwSXKPZ\nWDXnOrXMyJ4F1vjSCExuxeRWWkA7JJg3YVIUyG2vXDurOmgi/new/P7td8aCOzSL\nUI97GDRgfkGz2t2XutUzx6MTr5iUfTUYty8YpPxBJ2Y+KT1xwIVANsnC6JKTQflN\nnzvsmSYGNX8L7MFK2bocnlSH5iL6ipNb0NBhBblxchyPcBsr5z3n80tRf6H8zmK5\n0oTiew9V8o2CW4RNb/jxNV5HihNTKZqH7YI6ain0WZA+GGv39d+ixGcYtKuQML0r\nw6B9QuruJb/lHKf5B5zoRa9vJGyKdfAJzk58qfiCA542jF6u1RMXrfQXtlrkLnUm\nTYJPgTx6ni30Zri2Rt/zayms5hQNSHV/5WhWdFww+QcSgP/+VfPHUt/kPx+m4PhO\nMnQTzp1yhGHedemYPWucO9oZXuYq1bZJrtpuGhDG8G+fh6PC/Yn5lRrmabTiFuRa\nSCWVgSEIf/vtKF+Qovm37HPAeFVs+dSUNszyu2dee5sHAce3ehGjtX32jkyrywqK\nuATzBpWmsbOpUTHcG+GNzP2aSMGHozzjyRSTxCF93I72yyAnkwDiuuH1hbw9ev55\n7WUhYpopyCBG3R/A3eSE\n=x8pP\n-----END PGP SIGNATURE-----\n","payload":"tree 7ab09bbda03d13726ddbce862ce3f66212d8d2f2\nparent 0412009c5441bef8d75a427e1da8909e33ab5b56\nauthor Nishitha M <32355027+imnishitha@users.noreply.github.com> 1781703679 -0400\ncommitter GitHub <noreply@github.com> 1781703679 -0400\n\nfix(sdk): route `BaseSandbox async` helpers through aexecute (#3996)\n\nFixes #665\n\n## Problem\n\n`BaseSandbox`'s async helpers (`als`, `aread`, `agrep`, `aglob`,\n`awrite`, `aedit`) previously wrapped the corresponding sync methods in\n`asyncio.to_thread`, meaning overriding `aexecute` with a native async\nimplementation (e.g. wrapping an async SDK like Daytona's\n`AsyncSandbox`) had no effect on those helpers, they still ran the sync\npath in a thread pool. Subclasses were forced to override all 9\nfile-operation methods to get native async behavior.\n\n## Fix\n\nThis PR overrides all six async helpers in `BaseSandbox` to call\n`aexecute`/`aupload_files` directly. Subclasses now only need to\noverride those three core methods. To avoid duplicating command-building\nand output-parsing logic between sync and async paths, each method's\npure logic was factored into private helpers shared by both. Sync\nmethods and their behavior are completely unchanged.\n\n## Tests\n\nAdded a `NativeAsyncSandbox` test fixture where `exes `RuntimeError`, if\nany async helper falls backto the sync path, the test fails immediately.\nSeven new `@pytest.mark.asyncio` tests cover each overridden method\n(`als`, `aread`, `agrep`, `aglob`, `awrite`, inline `aedit`, and\nlarge-payload `aedit` via upload), asserting that\n`aexecute`/`aupload_files` are\ncalled the expected number of times and results are tests continue to\npass.\n\n---------\n\nSigned-off-by: Nishitha M <32355027+imnishitha@users.noreply.github.com>\nCo-authored-by: Eugene Yurtsev <eugene@langchain.dev>","verified_at":"2026-06-17T13:41:20Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/52dcf1a42cb00dd614b336038e4398472f78859d","html_url":"https://github.com/langchain-ai/deepagents/commit/52dcf1a42cb00dd614b336038e4398472f78859d","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/52dcf1a42cb00dd614b336038e4398472f78859d/comments","author":{"login":"imnishitha","id":32355027,"node_id":"MDQ6VXNlcjMyMzU1MDI3","avatar_url":"https://avatars.githubusercontent.com/u/32355027?v=4","gravatar_id":"","url":"https://api.github.com/users/imnishitha","html_url":"https://github.com/imnishitha","followers_url":"https://api.github.com/users/imnishitha/followers","following_url":"https://api.github.com/users/imnishitha/following{/other_user}","gists_url":"https://api.github.com/users/imnishitha/gists{/gist_id}","starred_url":"https://api.github.com/users/imnishitha/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/imnishitha/subscriptions","organizations_url":"https://api.github.com/users/imnishitha/orgs","repos_url":"https://api.github.com/users/imnishitha/repos","events_url":"https://api.github.com/users/imnishitha/events{/privacy}","received_events_url":"https://api.github.com/users/imnishitha/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"0412009c5441bef8d75a427e1da8909e33ab5b56","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/0412009c5441bef8d75a427e1da8909e33ab5b56","html_url":"https://github.com/langchain-ai/deepagents/commit/0412009c5441bef8d75a427e1da8909e33ab5b56"}]},{"sha":"0412009c5441bef8d75a427e1da8909e33ab5b56","node_id":"C_kwDOPTymldoAKDA0MTIwMDljNTQ0MWJlZjhkNzVhNDI3ZTFkYTg5MDllMzNhYjViNTY","commit":{"author":{"name":"github-actions[bot]","email":"41898282+github-actions[bot]@users.noreply.github.com","date":"2026-06-17T03:55:15Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-17T03:55:15Z"},"message":"release(deepagents-code): 0.1.19 (#4042)\n\n> [!CAUTION]\n> Merging this PR will automatically publish to **PyPI** and create a\n**GitHub release**.\n\nFor the full release process, see\n[`.github/RELEASING.md`](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md).\n\n---\n\n_Everything below this line will be the GitHub release body._\n\n---\n\n\n##\n[0.1.19](https://github.com/langchain-ai/deepagents/compare/deepagents-code==0.1.18...deepagents-code==0.1.19)\n(2026-06-17)\n\n### Features\n\n* Add latest frontier models to recommended list\n([#4045](https://github.com/langchain-ai/deepagents/issues/4045))\n([1145356](https://github.com/langchain-ai/deepagents/commit/114535637eaee383c64eac5282bc9ac57007c83f))\n* Dual-write agent traces to extra LangSmith projects\n([#3998](https://github.com/langchain-ai/deepagents/issues/3998))\n([1b94cf3](https://github.com/langchain-ai/deepagents/commit/1b94cf322949e0cafd6f2bacf343fb0044ec5a8c))\n* Prompt to install provider when selecting an uninstalled model\n([#3981](https://github.com/langchain-ai/deepagents/issues/3981))\n([619207c](https://github.com/langchain-ai/deepagents/commit/619207c8d4d4308a9a3ab9d2d039506feeaf8a67))\n* Note minimum OpenAI key permissions in `/auth`\n([#4040](https://github.com/langchain-ai/deepagents/issues/4040))\n([14be63d](https://github.com/langchain-ai/deepagents/commit/14be63d476ed8dece75e20fff05016122c258be8))\n\n### Bug Fixes\n\n* Exclude prompt prefix from `UserMessage` selection\n([#4002](https://github.com/langchain-ai/deepagents/issues/4002))\n([8ee6ba6](https://github.com/langchain-ai/deepagents/commit/8ee6ba6e64895d3d36a5957627221ed7667bc1d4))\n\n---\n\n_Everything above this line will be the GitHub release body._\n\n---\n\n> [!NOTE]\n> A **New Contributors** section is appended to the GitHub release notes\nautomatically at publish time (see [Release\nPipeline](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md#release-pipeline),\nstep 2).\n\n---------\n\nCo-authored-by: github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","tree":{"sha":"1754ec81477679808d0cff188fb1c47f2f9f92ee","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/1754ec81477679808d0cff188fb1c47f2f9f92ee"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/0412009c5441bef8d75a427e1da8909e33ab5b56","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMhqjCRC1aQ7uu5UhlAAAagQQAEH7oDvjYBYPwKVS1N8M+iCX\nCqYtyU1lj7Yfob0ibaMwrY09mz8WF+3pP/WXZBcYRlAygX06jcvAF5ngoK8quhkZ\n2X+L7GbqAZFcS8dqGpseVTe4x8GlS9Hyg3M2gKA6uwbpu9SfewAS/hugRsGUIbTk\nMmi/P8iB6rf2z/rO3tvnyBI4Y0UjnWvIdeDZIpa/l6AuEw3YbdF2DKCwt29IqS03\nD5fbPY/8azvakT8BQe42RDa6inPFnCKd0ybVtTenMbM6X2B4rLPo4ssU7B58p3jL\nq1Pl11V3uCKjhLmKAveGNLoYhob80RpyBQzkDn42LNpuvdxd59t5eZPxHSxEavFQ\n+VLmmVZUXGmEuayeEC/3Aue5kA4PzlbnE1eB6x9UqC4dNMFqEeYvyjHjgqI6lCFP\nfPQOZskF8rOwbTqdd1EGlvPWRaF4ogs2MxDf7f8jRUYaCg/FofOnX9VT+6UQLTnU\nZwPFAN/4WtJ68jz15zrVYNoL0nRuS5Iei2zc1P0iJAy87C2hpkG2idwl0WbY4t1X\n4EH1dQ0v90efNNJFRwwF+L6omaEUDKz/JriAHYpTJcT9VwWq457eMgDvxZkgNOCz\n5OeKXiEbFnCpTDUA+zK8HQRBQbwUXif0FTRmP1xY3gWQl8jeQYjxol1uee8dNkdu\nF8r+Tjw0YKlc19VARHKe\n=TP6y\n-----END PGP SIGNATURE-----\n","payload":"tree 1754ec81477679808d0cff188fb1c47f2f9f92ee\nparent 619207c8d4d4308a9a3ab9d2d039506feeaf8a67\nauthor github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com> 1781668515 -0400\ncommitter GitHub <noreply@github.com> 1781668515 -0400\n\nrelease(deepagents-code): 0.1.19 (#4042)\n\n> [!CAUTION]\n> Merging this PR will automatically publish to **PyPI** and create a\n**GitHub release**.\n\nFor the full release process, see\n[`.github/RELEASING.md`](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md).\n\n---\n\n_Everything below this line will be the GitHub release body._\n\n---\n\n\n##\n[0.1.19](https://github.com/langchain-ai/deepagents/compare/deepagents-code==0.1.18...deepagents-code==0.1.19)\n(2026-06-17)\n\n### Features\n\n* Add latest frontier models to recommended list\n([#4045](https://github.com/langchain-ai/deepagents/issues/4045))\n([1145356](https://github.com/langchain-ai/deepagents/commit/114535637eaee383c64eac5282bc9ac57007c83f))\n* Dual-write agent traces to extra LangSmith projects\n([#3998](https://github.com/langchain-ai/deepagents/issues/3998))\n([1b94cf3](https://github.com/langchain-ai/deepagents/commit/1b94cf322949e0cafd6f2bacf343fb0044ec5a8c))\n* Prompt to install provider when selecting an uninstalled model\n([#3981](https://github.com/langchain-ai/deepagents/issues/3981))\n([619207c](https://github.com/langchain-ai/deepagents/commit/619207c8d4d4308a9a3ab9d2d039506feeaf8a67))\n* Note minimum OpenAI key permissions in `/auth`\n([#4040](https://github.com/langchain-ai/deepagents/issues/4040))\n([14be63d](https://github.com/langchain-ai/deepagents/commit/14be63d476ed8dece75e20fff05016122c258be8))\n\n### Bug Fixes\n\n* Exclude prompt prefix from `UserMessage` selection\n([#4002](https://github.com/langchain-ai/deepagents/issues/4002))\n([8ee6ba6](https://github.com/langchain-ai/deepagents/commit/8ee6ba6e64895d3d36a5957627221ed7667bc1d4))\n\n---\n\n_Everything above this line will be the GitHub release body._\n\n---\n\n> [!NOTE]\n> A **New Contributors** section is appended to the GitHub release notes\nautomatically at publish time (see [Release\nPipeline](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md#release-pipeline),\nstep 2).\n\n---------\n\nCo-authored-by: github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","verified_at":"2026-06-17T03:55:16Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/0412009c5441bef8d75a427e1da8909e33ab5b56","html_url":"https://github.com/langchain-ai/deepagents/commit/0412009c5441bef8d75a427e1da8909e33ab5b56","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/0412009c5441bef8d75a427e1da8909e33ab5b56/comments","author":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"619207c8d4d4308a9a3ab9d2d039506feeaf8a67","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/619207c8d4d4308a9a3ab9d2d039506feeaf8a67","html_url":"https://github.com/langchain-ai/deepagents/commit/619207c8d4d4308a9a3ab9d2d039506feeaf8a67"}]},{"sha":"619207c8d4d4308a9a3ab9d2d039506feeaf8a67","node_id":"C_kwDOPTymldoAKDYxOTIwN2M4ZDRkNDMwOGE5YTNhYjlkMmQwMzk1MDZmZWVhZjhhNjc","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-17T03:52:08Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-17T03:52:08Z"},"message":"feat(code): prompt to install provider when selecting an uninstalled model (#3981)\n\nThe `/model` picker now lists recommended models from uninstalled\nproviders and offers to install the provider automatically when you\nselect one.\n\n---\n\nThe `/model` selector only listed models from already-installed\nproviders, so common OSS providers (e.g. `baseten`) were invisible until\nthe user manually ran `/install`. This surfaces recommended models from\nnot-yet-installed providers in the selector and, when one is picked,\nopens a confirmation modal that installs the provider's extra (reusing\nthe existing `/install` flow + restart offer) before switching to the\nmodel. Installed models always rank above install-required ones in\nsearch so the common case is never displaced.\n\nMade by [Open SWE](https://openswe.vercel.app)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"f536983592fcce38799f575ac2a41b9445b3702c","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/f536983592fcce38799f575ac2a41b9445b3702c"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/619207c8d4d4308a9a3ab9d2d039506feeaf8a67","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMhnoCRC1aQ7uu5UhlAAA7+cQAE3ZDayKzegPQyu827yJUxo3\n4DPUelspBgaTSxMyOk0MNsi4o+xDrquIdL1B12XA+nEq88Ihenf/nvH4K2Md80cr\nRB2mDPORa/dNhcZv3jLIkOXj8Y1TvWpzDYI1EdBvN485/WF5QVtZnhMfJoTTg6+U\nDswXo9xgoStbINhW7OzGVFZHhTmYU1JhUwu7bBHaZDWSq2zMOPmVMswYHFNtTMeM\nXKmV3wIhUHsnRORSrmeFpDNiXejPk3zuHp/nmnzekbs2Tp5stcxrtSI12Nx3tBa6\n2dBlZhvbyfzGCikHOd0F241ma41KtWu2ZLN8M7QoVAmhYeyKguT7D6MApZiKSHyc\nUIYynBjtFSMKv/zUY5G9/y8cKwT0dxLSQlAHKiiyIuQpDQobDgLLYPQxHk0CT/w5\nkoVTS7cpoaVBG9q+Va1UgI+xot/bjQ0o0nODwnVsnMFsRjZSb50bfH1xTCxcDiS9\nssbEeofy2IyK4s/DlkmqaJxaMGDlkIEY5a4zzgpyKbzDtBhNsjsGxdG3PtQXWPxp\nFlx/XsRDapfMFIzNDfMRpPd2FeuPEPYpXrcUjXVyOWDGW/iBk8uvf/StrkLrBRTt\nn97ewNSNG0pNReB8CoIMvVOlwPfavNDxFdnJRisru+Ptiy+Tmk4nrWzL6ujCcG4F\nmDFYQa60EH3ahvZc6r+X\n=pqSx\n-----END PGP SIGNATURE-----\n","payload":"tree f536983592fcce38799f575ac2a41b9445b3702c\nparent 114535637eaee383c64eac5282bc9ac57007c83f\nauthor Mason Daugherty <mason@langchain.dev> 1781668328 -0400\ncommitter GitHub <noreply@github.com> 1781668328 -0400\n\nfeat(code): prompt to install provider when selecting an uninstalled model (#3981)\n\nThe `/model` picker now lists recommended models from uninstalled\nproviders and offers to install the provider automatically when you\nselect one.\n\n---\n\nThe `/model` selector only listed models from already-installed\nproviders, so common OSS providers (e.g. `baseten`) were invisible until\nthe user manually ran `/install`. This surfaces recommended models from\nnot-yet-installed providers in the selector and, when one is picked,\nopens a confirmation modal that installs the provider's extra (reusing\nthe existing `/install` flow + restart offer) before switching to the\nmodel. Installed models always rank above install-required ones in\nsearch so the common case is never displaced.\n\nMade by [Open SWE](https://openswe.vercel.app)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-17T03:52:09Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/619207c8d4d4308a9a3ab9d2d039506feeaf8a67","html_url":"https://github.com/langchain-ai/deepagents/commit/619207c8d4d4308a9a3ab9d2d039506feeaf8a67","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/619207c8d4d4308a9a3ab9d2d039506feeaf8a67/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.gith