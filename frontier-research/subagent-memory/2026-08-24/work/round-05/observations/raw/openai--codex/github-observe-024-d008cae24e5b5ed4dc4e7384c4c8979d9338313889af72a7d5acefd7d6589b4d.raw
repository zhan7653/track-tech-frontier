tzius@openai.com","date":"2026-06-18T19:13:31Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-18T19:13:31Z"},"message":"[codex] Make thread store turn filter optional (#28949)\n\nMake `ListItemsParams::turn_id` optional so callers can list persisted\nitems across an entire thread or narrow the result to one turn. This\naligns the thread-store API and documentation with thread-wide item\nlisting while preserving the optional turn-filter behavior for\nimplementations.","tree":{"sha":"6638cc73451d6044062d8f020eebe14980a19086","url":"https://api.github.com/repos/openai/codex/git/trees/6638cc73451d6044062d8f020eebe14980a19086"},"url":"https://api.github.com/repos/openai/codex/git/commits/01a2df29479e8e982a5b6a9097d21814ad24000f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqNENbCRC1aQ7uu5UhlAAAKeEQAEnbJThvaN4jjG23kVnzqUub\nOSBApZ9EXIpUvxB9WxxkqndHCKG0vFtKWSei85wJAN/Q7qJjj/Aw3S72MPkLmHSX\nblt2kcEpRs7l3kepU40WK3NPb+rJCsmQUzoe/vd/QLeNKhx6zC+OlUPIogtAFk/Z\nreMv7OADY3/JuFIyGF9gKwD0VDQAPfoRIJzhKamM0Er8Cy3DBr8k6kz3TtpnAkNp\nGLwlJ6sQNf0FcN/UVm8EvKZjOZoeNSywD6X+BxTS/9CZBrpeJMi6hedVhXN5QN7D\nlPwt2jU/T1LGsQD2QDv7WFUHXpSu5mAU2QFhtTwrymGloHTFHNmfZ0A51JSSBFfA\n+jLOsdFyIZ/eNLuulvrxnbA5NI1u7YBPxGwCx8XSUFDaomZzTak//Kf6kQmWY29R\n+BRSh+jI7Eu9G7E/UFGP9jsqdjUg20Nri5vaPbP/p0eXkyALDEAJUdrEo7jC/ZpP\n2NUE3OjOnfv/MyH6j1bZWylghjH9OQN5oVMDzND5t1nXjfdmoLNafKi7bcvuhsK/\nfVDGdB5QplCQBsOVlP5mQINNPmGR2NZBnqT0QbBEnJ0is4XgiefHOg1BHF0ZSqqF\n5WI9pCz1dtW4b4JXCSyfKaKM2v6Knu6MEWMcfP4yLUeVJD1ANF5+5sbyFRTFs3jM\neUShGhzLrI9aLqbpPeBO\n=wSPW\n-----END PGP SIGNATURE-----\n","payload":"tree 6638cc73451d6044062d8f020eebe14980a19086\nparent 21a599fa56472a7cea8132c5a47a4374d4d5aa17\nauthor Tom <wiltzius@openai.com> 1781810011 -0700\ncommitter GitHub <noreply@github.com> 1781810011 -0700\n\n[codex] Make thread store turn filter optional (#28949)\n\nMake `ListItemsParams::turn_id` optional so callers can list persisted\nitems across an entire thread or narrow the result to one turn. This\naligns the thread-store API and documentation with thread-wide item\nlisting while preserving the optional turn-filter behavior for\nimplementations.","verified_at":"2026-06-18T19:13:32Z"}},"url":"https://api.github.com/repos/openai/codex/commits/01a2df29479e8e982a5b6a9097d21814ad24000f","html_url":"https://github.com/openai/codex/commit/01a2df29479e8e982a5b6a9097d21814ad24000f","comments_url":"https://api.github.com/repos/openai/codex/commits/01a2df29479e8e982a5b6a9097d21814ad24000f/comments","author":{"login":"wiltzius-openai","id":176426546,"node_id":"U_kgDOCoQOMg","avatar_url":"https://avatars.githubusercontent.com/u/176426546?v=4","gravatar_id":"","url":"https://api.github.com/users/wiltzius-openai","html_url":"https://github.com/wiltzius-openai","followers_url":"https://api.github.com/users/wiltzius-openai/followers","following_url":"https://api.github.com/users/wiltzius-openai/following{/other_user}","gists_url":"https://api.github.com/users/wiltzius-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/wiltzius-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wiltzius-openai/subscriptions","organizations_url":"https://api.github.com/users/wiltzius-openai/orgs","repos_url":"https://api.github.com/users/wiltzius-openai/repos","events_url":"https://api.github.com/users/wiltzius-openai/events{/privacy}","received_events_url":"https://api.github.com/users/wiltzius-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gist