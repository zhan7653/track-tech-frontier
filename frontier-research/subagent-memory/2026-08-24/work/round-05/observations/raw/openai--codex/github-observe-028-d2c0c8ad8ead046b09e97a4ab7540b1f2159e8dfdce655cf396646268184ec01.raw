[{"sha":"42415443d036c374eb848caec69b5714e9681b35","node_id":"C_kwDOOYsS4doAKDQyNDE1NDQzZDAzNmMzNzRlYjg0OGNhZWM2OWI1NzE0ZTk2ODFiMzU","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-10T18:37:14Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T18:37:14Z"},"message":"[codex] Raise app-server recursion limit (#27421)\n\n## Summary\n\nUnblock Rust release builds after tracing instrumentation increased the\nasync future query depth beyond rustc's default limit.\n\nSet the `codex-app-server` crate recursion limit to 256. This changes\ncompilation only; runtime behavior is unchanged.\n\n## Validation\n\n- `just test -p codex-app-server`\n- `cargo build --release --bin codex-app-server`","tree":{"sha":"ef4a0d95003d140a31ae01b54d29300d6c96c170","url":"https://api.github.com/repos/openai/codex/git/trees/ef4a0d95003d140a31ae01b54d29300d6c96c170"},"url":"https://api.github.com/repos/openai/codex/git/commits/42415443d036c374eb848caec69b5714e9681b35","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKa7aCRC1aQ7uu5UhlAAA7SwQADuNIeUkejX5fef6E/pNOfZq\n5C0UKcm0LleYFjR8MZscAPub+ArKu9vbkZPqbcZo5Dq74+BlvApgrb60xbMIRQmp\nI95/ijsIOJAmrgj8Z9xIdX1sxI8aGyKEjaXPZLlU31AYjolB6bt3ShnDdd1f0bUA\ncZqvDNqzEtApiHrSR4swVlGiCf43MtYZHl+O/x8LyRWT5yvoNY6QnQuh0Z9Xt7bg\n4rm+Y8XNW47Mb7Y0MvA/t4RbwIpv7BXb4kbL3R9MT/OR54EhCoalSJFNNFYmIpxG\nEt6wHuKK0/wYqaVZ/BT1zuJfH7W+sqg02StcefVZfig8Du1UwQccJLFZaCV4K+WB\nPIhvklsWxuE/VszR6FROuJ8iH/Is3mruDcEssdQd3tkG+0lvF7oAbYhok8X0FAbf\ngMdmVELVnGFhV2ujZ55BK4Qty0pLYH0s7ui0i4/j5d/RVUeA/1nonnkqsxymKaoe\nU0xB5T5xyyllMoRwL5HkfzbRkkswF6q98a6iadKflmqnDl3uwc44BwyeQowmUfjW\n4RirmpFeAjMWUCqnYgQWV9DQHhjj3w1f9yPssLRK/KTBkcYpIVMVATiLJ2sWhVHI\nPf/3b+jr9bqnBa4uUoN0q27s5DfB08rGO3E96XOPVWIDrdxFHH3iWvB6rwowxDf/\nbYd2BD1ZtS3F2h7+t9YO\n=YysW\n-----END PGP SIGNATURE-----\n","payload":"tree ef4a0d95003d140a31ae01b54d29300d6c96c170\nparent 636cc11398b805a9ad89a4ce2b45ded2feb59567\nauthor Adam Perry @ OpenAI <anp@openai.com> 1781116634 -0700\ncommitter GitHub <noreply@github.com> 1781116634 -0700\n\n[codex] Raise app-server recursion limit (#27421)\n\n## Summary\n\nUnblock Rust release builds after tracing instrumentation increased the\nasync future query depth beyond rustc's default limit.\n\nSet the `codex-app-server` crate recursion limit to 256. This changes\ncompilation only; runtime behavior is unchanged.\n\n## Validation\n\n- `just test -p codex-app-server`\n- `cargo build --release --bin codex-app-server`","verified_at":"2026-06-10T18:37:15Z"}},"url":"https://api.github.com/repos/openai/codex/commits/42415443d036c374eb848caec69b5714e9681b35","html_url":"https://github.com/openai/codex/commit/42415443d036c374eb848caec69b5714e9681b35","comments_url":"https://api.github.com/repos/openai/codex/commits/42415443d036c374eb848caec69b5714e9681b35/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"636cc11398b805a9ad89a4ce2b45ded2feb59567","url":"https://api.github.com/repos/openai/codex/commits/636cc11398b805a9ad89a4ce2b45ded2feb59567","html_url":"https://github.com/openai/codex/commit/636cc11398b805a9ad89a4ce2b45ded2feb59567"}]},{"sha":"636cc11398b805a9ad89a4ce2b45ded2feb59567","node_id":"C_kwDOOYsS4doAKDYzNmNjMTEzOThiODA1YTlhZDg5YTRjZTJiNDVkZWQyZmViNTk1Njc","commit":{"author":{"name":"stefanstokic-oai","email":"stefanstokic@openai.com","date":"2026-06-10T18:25:04Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T18:25:04Z"},"message":"[codex] remove blocking external agent migration flow (#27064)\n\n## Why\n\nExternal-agent import should be initiated deliberately instead of\ninterrupting eligible TUI startups. This cleanup removes the blocking\nstartup flow before the replacement import experience is introduced\nlater in the stack.\n\n## What changed\n\n- remove the startup-blocking external-agent migration prompt\n- remove the now-unused external migration feature gate\n- remove the obsolete TUI app-server migration wrappers\n- retain the dormant picker behind a module-scoped dead-code allowance\nuntil the next stack item wires it back in\n- keep normal TUI startup focused on entering Codex immediately\n\n## Validation\n\n- `bazel build --config=clippy //codex-rs/tui:tui\n//codex-rs/tui:tui-unit-tests-bin`\n- `just test -p codex-tui external_agent_config_migration` (8 passed)\n- `just test -p codex-tui` (2,786 passed, 12 unrelated local\nenvironment-sensitive failures, 4 skipped)\n- `just fix -p codex-tui`\n- `just fmt`\n\n## Stack\n\n1. [#27064](https://github.com/openai/codex/pull/27064): remove the\nstartup migration flow\n2. [#27065](https://github.com/openai/codex/pull/27065): extract the\npicker renderer\n3. [#27070](https://github.com/openai/codex/pull/27070): add the\nexternal-agent import picker UX\n4. [#27071](https://github.com/openai/codex/pull/27071): expose the flow\nthrough `/import`\n\n**This PR is stack item 1.**","tree":{"sha":"f5b6329e87398299a81950943068ea7080ecc327","url":"https://api.github.com/repos/openai/codex/git/trees/f5b6329e87398299a81950943068ea7080ecc327"},"url":"https://api.github.com/repos/openai/codex/git/commits/636cc11398b805a9ad89a4ce2b45ded2feb59567","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKawACRC1aQ7uu5UhlAAAsRMQAJNePRWZSumEhkyOBRQlvHXd\nMwlFS/RihqqkrLA4TQTTzZKn2CZ9od59JO8541G4ApoFR8eKhK+7FuX6PdbrSAWE\n9p3RzcyKb/CxJfB/IsYSGEjUCoyvD+ADzO14CKY2pYJvxor0XB1G2ZsIwPaEbOWw\nPK0sEyZbgKx06i2DGvhG8SoDVHX9OiyGOR2ryYmflwx0DTjs3TfKWnpUZlCkBK36\n70USQeJ8LUUhF9N4XwjRhRabOzWrzM+ZxddcZ/LNf/3POvl365Q2yaA1hv67GCTM\n8AbLyxLWOvHAsmrJNk96waQdauak397WrvCu0DjQEVmko0HtbZKUdnXEr700d0KY\nRsW9bSFvKKK5aiQJ+GI1cxkS2eHLRmj1iR6I8ssW0cyRn5V39NOEVfK6z+AxLAPH\nMMqGQ45F9hCmz0i1+U9IYUJ3XQS02q0XChG4UzKDoARldXZE4SnXNkdlzcP4w9CI\nz138WrHfQW95LtwQSEBgiDbvotW1bbDLVCjmH05T3DJJ43bZwaNHxrlHZhJEdEWT\nFTU4rX3NyIbYBql1IMyAx1WHfGTJiz0RFAPQX0Rs+Lkz7KUKaQsj6jsiUmAQTmu+\nkYbOmj+khLZS06w+cTncTZ6iGudkP4u0UyirPmn51wld1hZzv/oMBipltyRS5OIV\nTLeoaT+mu/WaLYmAqDhp\n=5/ih\n-----END PGP SIGNATURE-----\n","payload":"tree f5b6329e87398299a81950943068ea7080ecc327\nparent 3691fe5b76ccfa84835936c63efffb053dc8e6c6\nauthor stefanstokic-oai <stefanstokic@openai.com> 1781115904 -0400\ncommitter GitHub <noreply@github.com> 1781115904 -0400\n\n[codex] remove blocking external agent migration flow (#27064)\n\n## Why\n\nExternal-agent import should be initiated deliberately instead of\ninterrupting eligible TUI startups. This cleanup removes the blocking\nstartup flow before the replacement import experience is introduced\nlater in the stack.\n\n## What changed\n\n- remove the startup-blocking external-agent migration prompt\n- remove the now-unused external migration feature gate\n- remove the obsolete TUI app-server migration wrappers\n- retain the dormant picker behind a module-scoped dead-code allowance\nuntil the next stack item wires it back in\n- keep normal TUI startup focused on entering Codex immediately\n\n## Validation\n\n- `bazel build --config=clippy //codex-rs/tui:tui\n//codex-rs/tui:tui-unit-tests-bin`\n- `just test -p codex-tui external_agent_config_migration` (8 passed)\n- `just test -p codex-tui` (2,786 passed, 12 unrelated local\nenvironment-sensitive failures, 4 skipped)\n- `just fix -p codex-tui`\n- `just fmt`\n\n## Stack\n\n1. [#27064](https://github.com/openai/codex/pull/27064): remove the\nstartup migration flow\n2. [#27065](https://github.com/openai/codex/pull/27065): extract the\npicker renderer\n3. [#27070](https://github.com/openai/codex/pull/27070): add the\nexternal-agent import picker UX\n4. [#27071](https://github.com/openai/codex/pull/27071): expose the flow\nthrough `/import`\n\n**This PR is stack item 1.**","verified_at":"2026-06-10T18:25:04Z"}},"url":"https://api.github.com/repos/openai/codex/commits/636cc11398b805a9ad89a4ce2b45ded2feb59567","html_url":"https://github.com/openai/codex/commit/636cc11398b805a9ad89a4ce2b45ded2feb59567","comments_url":"https://api.github.com/repos/openai/codex/commits/636cc11398b805a9ad89a4ce2b45ded2feb59567/comments","author":{"login":"stefanstokic-oai","id":278208182,"node_id":"U_kgDOEJUetg","avatar_url":"https://avatars.githubusercontent.com/u/278208182?v=4","gravatar_id":"","url":"https://api.github.com/users/stefanstokic-oai","html_url":"https://github.com/stefanstokic-oai","followers_url":"https://api.github.com/users/stefanstokic-oai/followers","following_url":"https://api.github.com/users/stefanstokic-oai/following{/other_user}","gists_url":"https://api.github.com/users/stefanstokic-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/stefanstokic-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stefanstokic-oai/subscriptions","organizations_url":"https://api.github.com/users/stefanstokic-oai/orgs","repos_url":"https://api.github.com/users/stefanstokic-oai/repos","events_url":"https://api.github.com/users/stefanstokic-oai/events{/privacy}","received_events_url":"https://api.github.com/users/stefanstokic-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"3691fe5b76ccfa84835936c63efffb053dc8e6c6","url":"https://api.github.com/repos/openai/codex/commits/3691fe5b76ccfa84835936c63efffb053dc8e6c6","html_url":"https://github.com/openai/codex/commit/3691fe5b76ccfa84835936c63efffb053dc8e6c6"}]},{"sha":"3691fe5b76ccfa84835936c63efffb053dc8e6c6","node_id":"C_kwDOOYsS4doAKDM2OTFmZTViNzZjY2ZhODQ4MzU5MzZjNjNlZmZmYjA1M2RjOGU2YzY","commit":{"author":{"name":"David de Regt","email":"ddr@openai.com","date":"2026-06-10T18:24:29Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T18:24:29Z"},"message":"fix: Auto-recover from corrupted sqlite databases (#26859)\n\nFurther investigation of the sqlite incidents showed that the problems\nare due to corruption from the older version of SQLite that we recently\nupgraded, and that the data is truly corrupted in the root database --\nrecovery of all data is not possible. Given that the data is\nreconstructable from the rollouts on disk, we should just auto-backup\nthe database and let codex rebuild the rollout info from the disk\nrollouts.\n\nThe new behavior is that appserver auto-backs-up and rebuilds (with logs\nreflecting that behavior). The CLI now pops a message letting you know\nthis happened and the paths of the backed-up corrupt db and the new\ndatabase. There is also context added so that the desktop app can read\nthe rebuild info from it and inform the user with it.","tree":{"sha":"45873636a3e5acad1f726cc9dee004b475e52d7f","url":"https://api.github.com/repos/openai/codex/git/trees/45873636a3e5acad1f726cc9dee004b475e52d7f"},"url":"https://api.github.com/repos/openai/codex/git/commits/3691fe5b76ccfa84835936c63efffb053dc8e6c6","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKavdCRC1aQ7uu5UhlAAAao4QADIfLMApp+rK0RCERmy6yleF\ncw1GsKIzis6HUMonOkadZQpDTnXnO1eKLZCxn0qPtyB4KT48M6ySDsrCuVjsUbRK\n8ILKVv2yG5YLPnRyoVHT0tsQNNWzRSpFAws0IzSdJ2xDiXFo62pB3c8wpVbZhVEJ\nAQN4M2rWx6UlYs9fkBQjY14Qdqxo8UWTdPxfMO/moUePZD5X3+9NtCwG9IfG7Unl\nTbmFih9+/+G9h9Tn4NP9nTDDoNEbNkT4TTyGsKCmi9dK8JV9wyCp5uiQUCfR7LLq\nK7m7wpQ+gO5eEfPG5zNRUT3zA101ahpsTqM5srzBbuXjYX5K6jt2kNzwILqOSEHu\nHnHShivNsL9vSs5wLMCQo9gbdAzc+y4Sko+/YE6z3e1spFxE7RVebamYf7flvAI9\ntTMoj65yPX+EPKjG981wAViTE3mpzdMhGY/dGS+bxGd6LvrgnL1hYorsvUqqXnRk\n1lX/fjfBribh0yN4kKVzNXNpEN8edXaxq4wu/9DjXhHa4XpKQcmDjCJFCGhCQag4\nJQg6tvhW2/jL4PylIrw9WIMKT1dsVV5dggNQt/L/ghnajaDS5QHk6Fh7J81GLT4b\nLT2oiFr2SyDwtZYuFuwusd3nEyHFYPikd+k+BpCp3prLhQdW4v7aVfZuSmtF3Kkq\nC+wcZjEQnv6eF/xcNpPv\n=Pa3p\n-----END PGP SIGNATURE-----\n","payload":"tree 45873636a3e5acad1f726cc9dee004b475e52d7f\nparent a19d43a40aee5f3308ce57eda604fa085fd9f356\nauthor David de Regt <ddr@openai.com> 1781115869 -0700\ncommitter GitHub <noreply@github.com> 1781115869 -0700\n\nfix: Auto-recover from corrupted sqlite databases (#26859)\n\nFurther investigation of the sqlite incidents showed that the problems\nare due to corruption from the older version of SQLite that we recently\nupgraded, and that the data is truly corrupted in the root database --\nrecovery of all data is not possible. Given that the data is\nreconstructable from the rollouts on disk, we should just auto-backup\nthe database and let codex rebuild the rollout info from the disk\nrollouts.\n\nThe new behavior is that appserver auto-backs-up and rebuilds (with logs\nreflecting that behavior). The CLI now pops a message letting you know\nthis happened and the paths of the backed-up corrupt db and the new\ndatabase. There is also context added so that the desktop app can read\nthe rebuild info from it and inform the user with it.","verified_at":"2026-06-10T18:24:29Z"}},"url":"https://api.github.com/repos/openai/codex/commits/3691fe5b76ccfa84835936c63efffb053dc8e6c6","html_url":"https://github.com/openai/codex/commit/3691fe5b76ccfa84835936c63efffb053dc8e6c6","comments_url":"https://api.github.com/repos/openai/codex/commits/3691fe5b76ccfa84835936c63efffb053dc8e6c6/comments","author":{"login":"ddr-oai","id":248761566,"node_id":"U_kgDODtPM3g","avatar_url":"https://avatars.githubusercontent.com/u/248761566?v=4","gravatar_id":"","url":"https://api.github.com/users/ddr-oai","html_url":"https://github.com/ddr-oai","followers_url":"https://api.github.com/users/ddr-oai/followers","following_url":"https://api.github.com/users/ddr-oai/following{/other_user}","gists_url":"https://api.github.com/users/ddr-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/ddr-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ddr-oai/subscriptions","organizations_url":"https://api.github.com/users/ddr-oai/orgs","repos_url":"https://api.github.com/users/ddr-oai/repos","events_url":"https://api.github.com/users/ddr-oai/events{/privacy}","received_events_url":"https://api.github.com/users/ddr-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a19d43a40aee5f3308ce57eda604fa085fd9f356","url":"https://api.github.com/repos/openai/codex/commits/a19d43a40aee5f3308ce57eda604fa085fd9f356","html_url":"https://github.com/openai/codex/commit/a19d43a40aee5f3308ce57eda604fa085fd9f356"}]},{"sha":"a19d43a40aee5f3308ce57eda604fa085fd9f356","node_id":"C_kwDOOYsS4doAKGExOWQ0M2E0MGFlZTVmMzMwOGNlNTdlZGE2MDRmYTA4NWZkOWYzNTY","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-06-10T18:22:12Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T18:22:12Z"},"message":"Add app-server `thread/delete` API (#25018)\n\n## Why\n\nClients can archive and unarchive threads today, but there is no\napp-server API for permanently removing a thread. Deletion also needs to\ncover the full session tree: deleting a main thread should remove\nspawned subagent threads and the related local metadata instead of\nleaving orphaned rollout files, goals, or subagent state behind.\n\n## What\n\n- Adds the v2 `thread/delete` request and `thread/deleted` notification,\nwith the response shape kept consistent with `thread/archive`.\n- Implements local hard delete for active and archived rollout files.\n- Deletes the requested thread's state DB row as the commit point, then\nbest-effort cleans associated state including spawned descendants,\ngoals, spawn edges, logs, dynamic tools, and agent job assignments.\n- Updates app-server API docs and generated protocol schema/TypeScript\nfixtures.","tree":{"sha":"af80615defb426870e2d40724e7f617af0648092","url":"https://api.github.com/repos/openai/codex/git/trees/af80615defb426870e2d40724e7f617af0648092"},"url":"https://api.github.com/repos/openai/codex/git/commits/a19d43a40aee5f3308ce57eda604fa085fd9f356","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKatUCRC1aQ7uu5UhlAAAVfwQACafBH1trDKCg2efp7I5JKxU\nboBrJEcSJEl0z7pW0fuAv0f0FPS7zceV/MjWBRzzCNJgrluw7TVqRMHFc3yWyfjh\nqznBoIAsqkIX410v9WnJ8l3uI7jvSIh1VvXxAzdZ/e2RpbSoacCf80yESBOlhYn5\nO+AIOXeYsIJDDOxXHgmAsuPUYY0el97TYdjD11JWOpANWuRKm+9rnCyi8HG2KCxN\nUs0IhSsHtcmsrQSvDjmOgB6gqmw1TFxaUXx/C51X6zAWgNBfldtQ+QEFM0aUGK3c\nW0EwdTpAYhtrFlynGGPaxNzTFh5Gn0x00ibwLiDbj4oZbBUKjtLxrv3CgSQHNwaL\na0mSzK+rT9BvgFrj3BLBQU9dcXXYZSO7XWj4MOrTwoEjWxeG87etpxFwsBWP5/Rq\nGfC664ozZDwlps/gXGUO74VPmTk3Hi/4UNTa1FdzNIDwWJZJzFRxoiz3iDjhF0XF\nTN539xubQj6CF2FYLAaEYrc+NNnyNfY3MRZ8MJkZigsRovv1Wh3mga2fNTL/qTXy\ng0xf48nPRFwsr2g7x6zIQexJDpThvrZFChQKIlW2rzs4ZCyg4k/ybjGXZGL/b4lD\na1NKegWZu2Swy+BzxNX8oSVxdDwmm9asLX13/3YXUHTHdv0ALDnw0wLnR7uRZO1L\nDwIgaWgewn3nmGyeMQqD\n=6qie\n-----END PGP SIGNATURE-----\n","payload":"tree af80615defb426870e2d40724e7f617af0648092\nparent a1a8807e9d67fad4b95f2730a9669eca5a9d27d0\nauthor Eric Traut <etraut@openai.com> 1781115732 -0700\ncommitter GitHub <noreply@github.com> 1781115732 -0700\n\nAdd app-server `thread/delete` API (#25018)\n\n## Why\n\nClients can archive and unarchive threads today, but there is no\napp-server API for permanently removing a thread. Deletion also needs to\ncover the full session tree: deleting a main thread should remove\nspawned subagent threads and the related local metadata instead of\nleaving orphaned rollout files, goals, or subagent state behind.\n\n## What\n\n- Adds the v2 `thread/delete` request and `thread/deleted` notification,\nwith the response shape kept consistent with `thread/archive`.\n- Implements local hard delete for active and archived rollout files.\n- Deletes the requested thread's state DB row as the commit point, then\nbest-effort cleans associated state including spawned descendants,\ngoals, spawn edges, logs, dynamic tools, and agent job assignments.\n- Updates app-server API docs and generated protocol schema/TypeScript\nfixtures.","verified_at":"2026-06-10T18:22:12Z"}},"url":"https://api.github.com/repos/openai/codex/commits/a19d43a40aee5f3308ce57eda604fa085fd9f356","html_url":"https://github.com/openai/codex/commit/a19d43a40aee5f3308ce57eda604fa085fd9f356","comments_url":"https://api.github.com/repos/openai/codex/commits/a19d43a40aee5f3308ce57eda604fa085fd9f356/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a1a8807e9d67fad4b95f2730a9669eca5a9d27d0","url":"https://api.github.com/repos/openai/codex/commits/a1a8807e9d67fad4b95f2730a9669eca5a9d27d0","html_url":"https://github.com/openai/codex/commit/a1a8807e9d67fad4b95f2730a9669eca5a9d27d0"}]},{"sha":"a1a8807e9d67fad4b95f2730a9669eca5a9d27d0","node_id":"C_kwDOOYsS4doAKGExYTg4MDdlOWQ2N2ZhZDRiOTVmMjczMGE5NjY5ZWNhNWE5ZDI3ZDA","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-06-10T18:18:09Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T18:18:09Z"},"message":"Add app-server background terminal process APIs (#26041)\n\n## Summary\n\nCodex Apps needs app-server as the source of truth for chat-started\nbackground terminals instead of guessing from local process trees.\n\nThis PR adds experimental v2 APIs to list and terminate background\nterminals for a loaded thread using app-server process ids, so clients\ncan manage background terminals without local PID discovery.\n\n## Changes\n\n- `thread/backgroundTerminals/list` returns paginated background\nterminal records with `itemId`, app-server `processId`, `command`,\n`cwd`, nullable `osPid`, nullable `cpuPercent`, and nullable `rssKb`.\n- `thread/backgroundTerminals/terminate` terminates one running\nbackground terminal by app-server `processId` and returns whether a\nprocess was terminated.\n- Background terminal list and terminate operations use unified-exec\nprocess manager state as their source of truth.","tree":{"sha":"048e67ee18672f38acc9a826029db4bdabbd4f13","url":"https://api.github.com/repos/openai/codex/git/trees/048e67ee18672f38acc9a826029db4bdabbd4f13"},"url":"https://api.github.com/repos/openai/codex/git/commits/a1a8807e9d67fad4b95f2730a9669eca5a9d27d0","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKaphCRC1aQ7uu5UhlAAAOJQQAChfbEcZ/dizPUnwIxAyfWDb\nlxW9hidl67mdlgO5Nht0J17lbk71km829BaWaOOA+A0aBMX6bjUc07O2dZkDN8iH\ndFwnU81hqK2wycKR4ijOYipG94T96HHqqQXJfrY1PXb+tXnf/mlVdLi7pChDzFgP\nVNgIGLJBKtU/cpO4J2l3PN3Y4lkn+Ok+Fc1cXm4cqYzlaJLqcoGp+di+souT+hsz\no+Ms/JyE9Bc0YRVnSWQGHJkzPga7azeQNaebc4xk/9yDS+CM7+1Dh63qGXTpFO4F\nGxv7tGajeBtBae9mRUQQkHLQY75ePMKK+ntWDkthYNm9rnWkJZ4+lD2fbovBdZmk\nXhx775Sskoe8o1sPapy2QKRhgwii/NDhkJEk+vHCexw7MKaMTpbhaSLpCo3GVxPS\n/+MNSsXCId3ip8yQy+VvD1GgbphXLNVRTvBv19V2YKxlZQzySlv0A1ntCYmvp6RM\n9d26zrSYxHO0f7lOIXrt7OcHx4rylw4n7xHwuKXU84uRArpGPJgUGDS80OF5Vk2K\ngFqO0JcGtXp5uUhUnCRItaUiu1YVY2AeorxFMnZJxX96lU4QJtnxVMXEs7ZbLRgD\n3U8IFZPdVoalT+Cg4DRV5NZk9W/a4SXwtgYwIXKWx1OSFQUtf5MIIFjWQ6wXZLRQ\nfvtGteO7gdDiuYXK0JNX\n=SX3b\n-----END PGP SIGNATURE-----\n","payload":"tree 048e67ee18672f38acc9a826029db4bdabbd4f13\nparent 2704ecea9a1d52ece2429da4ed5775000b59164d\nauthor Eric Traut <etraut@openai.com> 1781115489 -0700\ncommitter GitHub <noreply@github.com> 1781115489 -0700\n\nAdd app-server background terminal process APIs (#26041)\n\n## Summary\n\nCodex Apps needs app-server as the source of truth for chat-started\nbackground terminals instead of guessing from local process trees.\n\nThis PR adds experimental v2 APIs to list and terminate background\nterminals for a loaded thread using app-server process ids, so clients\ncan manage background terminals without local PID discovery.\n\n## Changes\n\n- `thread/backgroundTerminals/list` returns paginated background\nterminal records with `itemId`, app-server `processId`, `command`,\n`cwd`, nullable `osPid`, nullable `cpuPercent`, and nullable `rssKb`.\n- `thread/backgroundTerminals/terminate` terminates one running\nbackground terminal by app-server `processId` and returns whether a\nprocess was terminated.\n- Background terminal list and terminate operations use unified-exec\nprocess manager state as their source of truth.","verified_at":"2026-06-10T18:18:09Z"}},"url":"https://api.github.com/repos/openai/codex/commits/a1a8807e9d67fad4b95f2730a9669eca5a9d27d0","html_url":"https://github.com/openai/codex/commit/a1a8807e9d67fad4b95f2730a9669eca5a9d27d0","comments_url":"https://api.github.com/repos/openai/codex/commits/a1a8807e9d67fad4b95f2730a9669eca5a9d27d0/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"2704ecea9a1d52ece2429da4ed5775000b59164d","url":"https://api.github.com/repos/openai/codex/commits/2704ecea9a1d52ece2429da4ed5775000b59164d","html_url":"https://github.com/openai/codex/commit/2704ecea9a1d52ece2429da4ed5775000b59164d"}]},{"sha":"2704ecea9a1d52ece2429da4ed5775000b59164d","node_id":"C_kwDOOYsS4doAKDI3MDRlY2VhOWExZDUyZWNlMjQyOWRhNGVkNTc3NTAwMGI1OTE2NGQ","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-10T17:26:53Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T17:26:53Z"},"message":"[codex] Remove async_trait from ToolExecutor (#27304)\n\n## Why\n\nWe're now [discouraging use of\n`async_trait`](https://github.com/openai/codex/pull/20242).\n\nRemoving use of `async_trait` from `ToolExecutor` yields a `codex_core`\ndebug test build speedup of ~78% (from 227.5s to 50.3s) on my machine.\n\nStacked on #27299, this PR applies the trait change after the handler\nbodies have been outlined.\n\n## What\n\nChanged `ToolExecutor::handle` to return an explicit boxed\n`ToolExecutorFuture` instead of using `async_trait`.\n\nUpdated ToolExecutor implementors to return `Box::pin(...)`, reexported\nthe future alias through `codex-tools` and `codex-extension-api`, and\nremoved `codex-tools` direct `async-trait` dependency.","tree":{"sha":"adf821ce089a70b26b08d1d08e7c34f61242d51c","url":"https://api.github.com/repos/openai/codex/git/trees/adf821ce089a70b26b08d1d08e7c34f61242d51c"},"url":"https://api.github.com/repos/openai/codex/git/commits/2704ecea9a1d52ece2429da4ed5775000b59164d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKZ5dCRC1aQ7uu5UhlAAA/fAQABsJK45FQzCgJD0tN2PUbsVk\ncjoxGyHwj86AGHNFYY72Q5+XvBiyoyd1i8jQN0XCfD3GKi+E69oKH2D8nAxfjyEV\nnlP5vz8kt/9q/oNocVWwlEY66ynJvGpEtTPHUhb2eUSRnfvDpKcQr3/0FD092H6y\nXLDzgOEHUUsudUqZvUnAbQIKlhZq/GebzrWFYIM7t0iGskSqebIGfklHYKaaQS3e\ngmxMiRg5SXQ/5I1xSnVD7ncz5o3vE3D3DBSE/UCvYfKkT0CSnqxHLyaokV3IuV1C\nYBNH1KvcN68PVS7D7AN+V1vlmCrlB1r2Az0V0c6aZd5mQu6hflGqfQlKkvHgxgpE\nmQmCtT+8A83KnM/PjUJrTI4iV+Dw018QAEjCLb0b3SnNZHlYOZgWWzatPpZ9aHlt\n0uR/G6vRcGNuLvA5r1qwMAaX/FOLQDeE3UX3Si4F9hy15uXirvh/h7X7OliKwYvV\nni4OxW+5UJr+PqzitrhZswb0JVtwaQPtq0ltH6utblBb6H5mKp6KNmtheedxWWDw\nzlP6rRhEqx1iftvz52QrQaQZ7b4EWiXPU4Ar8n5dU4edohutJml4K10iNuqbiHMK\ni4GPKynhB+g7pCboaTsZNQLwdTtLb70a+1WoDBulIg0VsEHpg3VtFtsWwt56MdTN\nb/72EFIyZ9y6rpFe20r7\n=jigm\n-----END PGP SIGNATURE-----\n","payload":"tree adf821ce089a70b26b08d1d08e7c34f61242d51c\nparent d3abd8774ed2caa13db253ee232791e5a2d2d8c5\nauthor Adam Perry @ OpenAI <anp@openai.com> 1781112413 -0700\ncommitter GitHub <noreply@github.com> 1781112413 -0700\n\n[codex] Remove async_trait from ToolExecutor (#27304)\n\n## Why\n\nWe're now [discouraging use of\n`async_trait`](https://github.com/openai/codex/pull/20242).\n\nRemoving use of `async_trait` from `ToolExecutor` yields a `codex_core`\ndebug test build speedup of ~78% (from 227.5s to 50.3s) on my machine.\n\nStacked on #27299, this PR applies the trait change after the handler\nbodies have been outlined.\n\n## What\n\nChanged `ToolExecutor::handle` to return an explicit boxed\n`ToolExecutorFuture` instead of using `async_trait`.\n\nUpdated ToolExecutor implementors to return `Box::pin(...)`, reexported\nthe future alias through `codex-tools` and `codex-extension-api`, and\nremoved `codex-tools` direct `async-trait` dependency.","verified_at":"2026-06-10T17:26:54Z"}},"url":"https://api.github.com/repos/openai/codex/commits/2704ecea9a1d52ece2429da4ed5775000b59164d","html_url":"https://github.com/openai/codex/commit/2704ecea9a1d52ece2429da4ed5775000b59164d","comments_url":"https://api.github.com/repos/openai/codex/commits/2704ecea9a1d52ece2429da4ed5775000b59164d/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"d3abd8774ed2caa13db253ee232791e5a2d2d8c5","url":"https://api.github.com/repos/openai/codex/commits/d3abd8774ed2caa13db253ee232791e5a2d2d8c5","html_url":"https://github.com/openai/codex/commit/d3abd8774ed2caa13db253ee232791e5a2d2d8c5"}]},{"sha":"d3abd8774ed2caa13db253ee232791e5a2d2d8c5","node_id":"C_kwDOOYsS4doAKGQzYWJkODc3NGVkMmNhYTEzZGIyNTNlZTIzMjc5MWU1YTJkMmQ4YzU","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-10T17:23:42Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T17:23:42Z"},"message":"Fix compressed rollout search path matching (#27407)\n\n## Why\n\n`thread/search` found content inside compressed rollouts but could drop\nthe result when joining it with SQLite-backed thread metadata. Search\nreturned the physical `.jsonl.zst` path while SQLite retained the\nlogical `.jsonl` path, so exact path matching failed.\n\n## What changed\n\n- Key rollout search matches by their canonical logical `.jsonl` path,\nindependent of the on-disk representation.\n- Canonicalize thread-list paths before joining them with content-search\nmatches.\n- Update compressed-rollout coverage to assert the logical-path\ncontract.\n\n## Validation\n\n- Ran `just fmt`.\n- Ran `git diff --check`.\n- Tests and Clippy were intentionally left to CI.","tree":{"sha":"97809cacdea0a9bec1d04eb9c53236019f757c2b","url":"https://api.github.com/repos/openai/codex/git/trees/97809cacdea0a9bec1d04eb9c53236019f757c2b"},"url":"https://api.github.com/repos/openai/codex/git/commits/d3abd8774ed2caa13db253ee232791e5a2d2d8c5","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKZ2eCRC1aQ7uu5UhlAAAv3sQAFvm1eIn5yYm969JPB/9tZud\n0XW8V1TEcbjMKHxrpbXjmhrTFVojtQTBTOmu+lyCzcqg98NEzQSIcNes/Q269b3Y\ns11tCf9NIwnn+1Bx3ueu6PBVuMoKYShQYODd/Rjb+h0sU0dfZU7VLL7l6DMhyQxq\ns1qqYdHD4wjdf4+sd3UWHyP6kzwvArgLwnoRwvg1/KMTFQ/0yQ9sM/YROf59gZIT\nf0R3Oo/UT3apnB0r/xlT9Igm/TnlNxeTWuR/8uEL3pn9WiuXofZH1+41SSjr6DMg\nCrgSEUL2uYuXXkoi/qtdH/ZUz8N27V0xxzB8gzsPCsrow/396tOrAtxrINVWNaZ4\nwtgHhp6yO0qtlNGtd99eLnXC8euYTfRNpQarfWeFoNisZ/ZUpp0Pz7eALxl5mwMY\nqAl78C6dxKH0r1MEpdzOC0XhoPwTcvKed0e3ebyE6JHNSmTq2sKBnVP6X2bKaAgc\nzsQTmBzZJfOmqU6YaINOXpBHd1cGe1VL5HQ4m4u3qdFyoNNlRu1fvZAm/iVg01Hy\nVHOf9eoO0K5R2CBk6isZBM1ycv+cV/xjskEJLDz3nZsEEVNAwS73N//eIgGMDp4x\n03VJB6bpHdR8BY+qH1auNstQApWvz2oxa+saByd27bktZMyFsf7DCcw7UlJifxyY\nlCvqvqLq+eRcfAR0JPzk\n=0iwX\n-----END PGP SIGNATURE-----\n","payload":"tree 97809cacdea0a9bec1d04eb9c53236019f757c2b\nparent 2ef007dc1ad60f772a3e0ac6560d61f783783b9d\nauthor jif <jif@openai.com> 1781112222 +0100\ncommitter GitHub <noreply@github.com> 1781112222 +0200\n\nFix compressed rollout search path matching (#27407)\n\n## Why\n\n`thread/search` found content inside compressed rollouts but could drop\nthe result when joining it with SQLite-backed thread metadata. Search\nreturned the physical `.jsonl.zst` path while SQLite retained the\nlogical `.jsonl` path, so exact path matching failed.\n\n## What changed\n\n- Key rollout search matches by their canonical logical `.jsonl` path,\nindependent of the on-disk representation.\n- Canonicalize thread-list paths before joining them with content-search\nmatches.\n- Update compressed-rollout coverage to assert the logical-path\ncontract.\n\n## Validation\n\n- Ran `just fmt`.\n- Ran `git diff --check`.\n- Tests and Clippy were intentionally left to CI.","verified_at":"2026-06-10T17:23:43Z"}},"url":"https://api.github.com/repos/openai/codex/commits/d3abd8774ed2caa13db253ee232791e5a2d2d8c5","html_url":"https://github.com/openai/codex/commit/d3abd8774ed2caa13db253ee232791e5a2d2d8c5","comments_url":"https://api.github.com/repos/openai/codex/commits/d3abd8774ed2caa13db253ee232791e5a2d2d8c5/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"2ef007dc1ad60f772a3e0ac6560d61f783783b9d","url":"https://api.github.com/repos/openai/codex/commits/2ef007dc1ad60f772a3e0ac6560d61f783783b9d","html_url":"https://github.com/openai/codex/commit/2ef007dc1ad60f772a3e0ac6560d61f783783b9d"}]},{"sha":"2ef007dc1ad60f772a3e0ac6560d61f783783b9d","node_id":"C_kwDOOYsS4doAKDJlZjAwN2RjMWFkNjBmNzcyYTNlMGFjNjU2MGQ2MWY3ODM3ODNiOWQ","commit":{"author":{"name":"Zanie Blue","email":"zanie@openai.com","date":"2026-06-10T16:52:17Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T16:52:17Z"},"message":"Index visible thread list ordering (#27391)\n\n## Summary\n\n- add partial SQLite indexes for visible thread lists ordered by\ncreation or update time\n- match the `archived` and non-empty `preview` filters used by\n`thread/list`\n- add query-plan coverage for both supported sort orders\n\n## Query performance\n\nBenchmarked the production query shape on a snapshot of my database with\n~10k threads before and after applying these indexes. The query selected\nthe full thread projection with `archived = 0`, `preview <> ''`, the\n`openai` provider filter, and a page size of 201. Results are the mean\nof 30 runs after 5 warmups:\n\n| Query | Before | After | Speedup |\n| --- | ---: | ---: | ---: |\n| First page, `created_at_ms DESC` | 132.3 ms | 15.1 ms | 8.78x |\n| First page, `updated_at_ms DESC` | 123.6 ms | 15.5 ms | 7.99x |\n| Cursor page near row 4,000, `created_at_ms DESC` | 51.8 ms | 16.8 ms |\n3.07x |\n| Cursor page near row 4,000, `updated_at_ms DESC` | 52.4 ms | 17.1 ms |\n3.06x |\n\nBefore this change, SQLite used `idx_threads_archived`, filtered the\ncandidate rows, and built a temporary B-tree for the requested ordering.\nWith the partial indexes, SQLite reads matching visible rows directly in\ntimestamp order and stops at the page limit. `EXPLAIN QUERY PLAN` no\nlonger reports `USE TEMP B-TREE FOR ORDER BY`.\n\nThe result rows were identical before and after. The two partial indexes\noccupy approximately 168 KiB combined on this snapshot.\n\n## Performance under contention\n\nI noticed this issue on a database with high-contention and tried to use\nsimulated contention to validate the performance in that context.\n\nA synthetic SQLite benchmark ran five concurrent readers, matching the\nstate database pool size, and fetched 101 rows per query. Results are\nthe median of three runs on fresh copies of the same database snapshot:\n\n| Query | Before | After |\n| --- | ---: | ---: |\n| `created_at_ms` mean latency under saturation | 328 ms | 12 ms |\n| `created_at_ms` throughput | 16 queries/s | 412 queries/s |\n| `updated_at_ms` mean latency under saturation | 336 ms | 14 ms |\n| `updated_at_ms` throughput | 15 queries/s | 357 queries/s |\n\nFor a burst of 100 queries queued through five connections, p95\ncompletion time fell from 6.90 seconds to 226 ms for `created_at_ms`,\nand from 6.31 seconds to 473 ms for `updated_at_ms`.\n\n## Validation\n\n- `just test -p codex-state` (135 tests passed)\n- query-plan regression covers created-at and updated-at ordering,\nrequires the corresponding index, and rejects `TEMP B-TREE`\n- `just fmt`","tree":{"sha":"2b63326ceb3820a028ee301f7f710c03a105b151","url":"https://api.github.com/repos/openai/codex/git/trees/2b63326ceb3820a028ee301f7f710c03a105b151"},"url":"https://api.github.com/repos/openai/codex/git/commits/2ef007dc1ad60f772a3e0ac6560d61f783783b9d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKZZBCRC1aQ7uu5UhlAAA2v4QAKIB7vO8XIg7HrAB2/h/Qk74\n8f6rnfDi8Ba5Bf4cPUjzu7gi6LY+7pibdeQyoQx9KGm5N/Ycz9Ts3o9QMcgr+bv0\nsiHR3uZOzkICDzrnutuPgAS5WFv4DPUMF3E1OXYhXCCX86Anx9Xfhwg8iSFweazJ\n1U8zE1M+g9w703H6Cuss99/54h3QwKtbq7OM1twc8sacNwxZUPtzri6KgJtkcn9U\nzdSM6u9/IT50NRvfafrTOFX1AZ7abTCj04QTIy7y7SDvSwH+CUKpRFILYcv3rgv/\ntEaAyXUNZBpI5Jzg11JnTjToOnpyhVRQ1VWkWPQ4xD0iGOReXXysnDS1LYwtODoM\neIeLNeTutxS2domNy95gOlb+O1qCZUURlaMUBLvbrpmpKamDxm+QuDpRd2werm75\nRp1ZMRaX9l66aUIMXJPeFScX4fPLxciPza4Tme/Y4eeN5KrADP3FvwOaJxxBRnig\nxRFyqoL7j+LyfeswfgLtYU6I+ZmaWwlE5yVAbajsgziTAJ1kNUXtrKTwg9gJ5A3Q\nnOGfnXnpU8NU0ybhfQWBtA015HtoD1OSnlytARArYtT+U8ANofSzIeWOClvb8v3r\nhfBhc37r6DcZlNUoeLicjUVlFtVUSOWS/PdoGxnKkzDxNsSQgil3C8sjl8NYWlg0\nA8ql4CroJQoOVEAZn92n\n=1k5g\n-----END PGP SIGNATURE-----\n","payload":"tree 2b63326ceb3820a028ee301f7f710c03a105b151\nparent db531b4a6c07dd8a4cb624f25b8d6abbd28ccf96\nauthor Zanie Blue <zanie@openai.com> 1781110337 -0500\ncommitter GitHub <noreply@github.com> 1781110337 -0500\n\nIndex visible thread list ordering (#27391)\n\n## Summary\n\n- add partial SQLite indexes for visible thread lists ordered by\ncreation or update time\n- match the `archived` and non-empty `preview` filters used by\n`thread/list`\n- add query-plan coverage for both supported sort orders\n\n## Query performance\n\nBenchmarked the production query shape on a snapshot of my database with\n~10k threads before and after applying these indexes. The query selected\nthe full thread projection with `archived = 0`, `preview <> ''`, the\n`openai` provider filter, and a page size of 201. Results are the mean\nof 30 runs after 5 warmups:\n\n| Query | Before | After | Speedup |\n| --- | ---: | ---: | ---: |\n| First page, `created_at_ms DESC` | 132.3 ms | 15.1 ms | 8.78x |\n| First page, `updated_at_ms DESC` | 123.6 ms | 15.5 ms | 7.99x |\n| Cursor page near row 4,000, `created_at_ms DESC` | 51.8 ms | 16.8 ms |\n3.07x |\n| Cursor page near row 4,000, `updated_at_ms DESC` | 52.4 ms | 17.1 ms |\n3.06x |\n\nBefore this change, SQLite used `idx_threads_archived`, filtered the\ncandidate rows, and built a temporary B-tree for the requested ordering.\nWith the partial indexes, SQLite reads matching visible rows directly in\ntimestamp order and stops at the page limit. `EXPLAIN QUERY PLAN` no\nlonger reports `USE TEMP B-TREE FOR ORDER BY`.\n\nThe result rows were identical before and after. The two partial indexes\noccupy approximately 168 KiB combined on this snapshot.\n\n## Performance under contention\n\nI noticed this issue on a database with high-contention and tried to use\nsimulated contention to validate the performance in that context.\n\nA synthetic SQLite benchmark ran five concurrent readers, matching the\nstate database pool size, and fetched 101 rows per query. Results are\nthe median of three runs on fresh copies of the same database snapshot:\n\n| Query | Before | After |\n| --- | ---: | ---: |\n| `created_at_ms` mean latency under saturation | 328 ms | 12 ms |\n| `created_at_ms` throughput | 16 queries/s | 412 queries/s |\n| `updated_at_ms` mean latency under saturation | 336 ms | 14 ms |\n| `updated_at_ms` throughput | 15 queries/s | 357 queries/s |\n\nFor a burst of 100 queries queued through five connections, p95\ncompletion time fell from 6.90 seconds to 226 ms for `created_at_ms`,\nand from 6.31 seconds to 473 ms for `updated_at_ms`.\n\n## Validation\n\n- `just test -p codex-state` (135 tests passed)\n- query-plan regression covers created-at and updated-at ordering,\nrequires the corresponding index, and rejects `TEMP B-TREE`\n- `just fmt`","verified_at":"2026-06-10T16:52:17Z"}},"url":"https://api.github.com/repos/openai/codex/commits/2ef007dc1ad60f772a3e0ac6560d61f783783b9d","html_url":"https://github.com/openai/codex/commit/2ef007dc1ad60f772a3e0ac6560d61f783783b9d","comments_url":"https://api.github.com/repos/openai/codex/commits/2ef007dc1ad60f772a3e0ac6560d61f783783b9d/comments","author":{"login":"zanie-oai","id":282067757,"node_id":"U_kgDOENADLQ","avatar_url":"https://avatars.githubusercontent.com/u/282067757?v=4","gravatar_id":"","url":"https://api.github.com/users/zanie-oai","html_url":"https://github.com/zanie-oai","followers_url":"https://api.github.com/users/zanie-oai/followers","following_url":"https://api.github.com/users/zanie-oai/following{/other_user}","gists_url":"https://api.github.com/users/zanie-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/zanie-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zanie-oai/subscriptions","organizations_url":"https://api.github.com/users/zanie-oai/orgs","repos_url":"https://api.github.com/users/zanie-oai/repos","events_url":"https://api.github.com/users/zanie-oai/events{/privacy}","received_events_url":"https://api.github.com/users/zanie-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"db531b4a6c07dd8a4cb624f25b8d6abbd28ccf96","url":"https://api.github.com/repos/openai/codex/commits/db531b4a6c07dd8a4cb624f25b8d6abbd28ccf96","html_url":"https://github.com/openai/codex/commit/db531b4a6c07dd8a4cb624f25b8d6abbd28ccf96"}]},{"sha":"db531b4a6c07dd8a4cb624f25b8d6abbd28ccf96","node_id":"C_kwDOOYsS4doAKGRiNTMxYjRhNmMwN2RkOGE0Y2I2MjRmMjViOGQ2YWJiZDI4Y2NmOTY","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-10T16:40:41Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T16:40:41Z"},"message":"[codex] Outline ToolExecutor handler bodies (#27299)\n\n## Why\n\nWe're now [discouraging use of\n`async_trait`](https://github.com/openai/codex/pull/20242).\n\nRemoving use of `async_trait` from `ToolExecutor` yields a `codex_core`\ndebug test build speedup of ~78% (from 227.5s to 50.3s) on my machine.\n\nFor ease of reviewing, this is a prefactor to extract trait method\nimplementations to inherent methods. This will prevent changing\nindentation from creating a huge diff.\n\n## What\n\nOutlined existing `ToolExecutor::handle` bodies into inherent async\n`handle_call` methods across core and extension tool handlers.\n\nThe trait methods still use `async_trait` and now delegate to\n`self.handle_call(...).await`; handler behavior is unchanged.","tree":{"sha":"1cf567618df3727d6a4e4db8c60cfdb2538b7151","url":"https://api.github.com/repos/openai/codex/git/trees/1cf567618df3727d6a4e4db8c60cfdb2538b7151"},"url":"https://api.github.com/repos/openai/codex/git/commits/db531b4a6c07dd8a4cb624f25b8d6abbd28ccf96","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKZOJCRC1aQ7uu5UhlAAAlVcQACjuW4/ftCPaoXQTC5l/Bpqr\n8ML/WhGoj4zMEwSiwHbcrM0aJ9ZHvFvADW6lQWq7dRF2lERgjG87Lq5xa1vY2s+8\ngsUQPenLITSt9u8xbR75lcZ2KxC3+KrLuZUQkWsiNY9yzkKGzIYeJiy21hP0ZQJG\nDBnSuOma/lQVVu1QBudVjoqBG9VwoOx6iJZmfPwaRX4+IYKB/7iTTuIINcTztwpk\nddZvaA2wNvGT0fRscmEhOOFAcY2yaRS5YLtst2oxS5AtBtVnvPlRmgCmsCodRqdm\nbdIH/vxCt8p3M07wERCs1xiGyqpmgEAhuhlydYd3fyxgHDteJ8BvGwqrgJDOpMLx\nup/EjPXZvuhGSUmYdoGZ+cA5Xtc/FfImIGOb+FR2gWLUCwL2zrvE6dQcqi1YioGl\nNH0kZL6L5NmCXATeo36P5ieRUbbjl3YtwwHWykTF4gBJb5J9MWNQkKXV/OLJET/C\nUboN6ACAs4AoXQTtJgVviy6jdoE7IUPZb6t67FDIq0vZTP3AhuzAKIi74Y/rA/6M\nmmtBNlnHn2NOS5XFtjjakPrhY/RmXPukIdgvgoziFLM6urPYCbzs4i1yITD/BtPT\nTQfoBu03STIzhQBCZv7/C+yD1bXWUP+hJyyGk295rvoeHjbiLHx/WZYHPkuH6Mfa\nGeyWMA5SdZymqA/DRDAD\n=5wp1\n-----END PGP SIGNATURE-----\n","payload":"tree 1cf567618df3727d6a4e4db8c60cfdb2538b7151\nparent c365b8a4abfe0436ca85978fd186bd89d55a8807\nauthor Adam Perry @ OpenAI <anp@openai.com> 1781109641 -0700\ncommitter GitHub <noreply@github.com> 1781109641 -0700\n\n[codex] Outline ToolExecutor handler bodies (#27299)\n\n## Why\n\nWe're now [discouraging use of\n`async_trait`](https://github.com/openai/codex/pull/20242).\n\nRemoving use of `async_trait` from `ToolExecutor` yields a `codex_core`\ndebug test build speedup of ~78% (from 227.5s to 50.3s) on my machine.\n\nFor ease of reviewing, this is a prefactor to extract trait method\nimplementations to inherent methods. This will prevent changing\nindentation from creating a huge diff.\n\n## What\n\nOutlined existing `ToolExecutor::handle` bodies into inherent async\n`handle_call` methods across core and extension tool handlers.\n\nThe trait methods still use `async_trait` and now delegate to\n`self.handle_call(...).await`; handler behavior is unchanged.","verified_at":"2026-06-10T16:40:41Z"}},"url":"https://api.github.com/repos/openai/codex/commits/db531b4a6c07dd8a4cb624f25b8d6abbd28ccf96","html_url":"https://github.com/openai/codex/commit/db531b4a6c07dd8a4cb624f25b8d6abbd28ccf96","comments_url":"https://api.github.com/repos/openai/codex/commits/db531b4a6c07dd8a4cb624f25b8d6abbd28ccf96/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c365b8a4abfe0436ca85978fd186bd89d55a8807","url":"https://api.github.com/repos/openai/codex/commits/c365b8a4abfe0436ca85978fd186bd89d55a8807","html_url":"https://github.com/openai/codex/commit/c365b8a4abfe0436ca85978fd186bd89d55a8807"}]},{"sha":"c365b8a4abfe0436ca85978fd186bd89d55a8807","node_id":"C_kwDOOYsS4doAKGMzNjViOGE0YWJmZTA0MzZjYTg1OTc4ZmQxODZiZDg5ZDU1YTg4MDc","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-06-10T16:28:12Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T16:28:12Z"},"message":"Reduce archive rollout lookup CPU (#27276)\n\n## Why\n\nArchiving a thread can spike app-server CPU when the state DB does not\nhave a usable rollout path. The archive path falls back to locating the\nrollout by thread id; because rollout filenames already contain the\nUUID, the cheap fallback should find the file directly before invoking\nbroader file search.\n\n## What Changed\n\n- In `codex-rs/rollout/src/list.rs`, try the exact rollout filename\nlookup before `codex-file-search`.\n- Keep fuzzy search as the final legacy fallback when no filename match\nis found.\n- Preserve the legacy fallback when the filename scan hits a traversal\nerror, so an inaccessible stale subtree does not block lookup elsewhere.\n\n## Verification\n\n- `just test -p codex-rollout`\n- `just test -p codex-thread-store`\n- `just test -p codex-app-server thread_archive`","tree":{"sha":"ebb9cfdaa0d0d3da502b94cae82e891c69530813","url":"https://api.github.com/repos/openai/codex/git/trees/ebb9cfdaa0d0d3da502b94cae82e891c69530813"},"url":"https://api.github.com/repos/openai/codex/git/commits/c365b8a4abfe0436ca85978fd186bd89d55a8807","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKZCdCRC1aQ7uu5UhlAAAkCoQAAfO3cFSMpueSnkHFbeRegQK\n6bY5BhZNVa95YLiyP+yff2P8e8442sMLkt2B0JJKMyWB90ICUnFuEezjrNtCBVQ0\nMU6tgMeA1FsfK6fhanonLzmQZN49G9BGb4NC1daCQ1VD2+8ek1pk4xXHsuscesHv\nD9ICO3QeO5csO/vLhQcPWCAFqylcdBiabEWNU6Fc35LoeqsXOPsP/yg6kia36+BM\nOwID1uObzZiKb48/eAaqkU96rbpLB8uUzdIPzoemyj3EikkdOsNK534WGoeRdTIb\nFCUjXkOFoPwp/sqjErpKFZj568ZTUL878srsbDCF3xmz4zfvYhvb4A+7D8id2U+H\nn42TuHfHZ848+Yp6Hqp5Sv2zAYBbEWhu8QJw7E1NE+V//IYIDvXNmoz2HbdwBfM2\n7xCDWkdzua0CpTqnvX235Y82sQS0PnyrYDyn/ar1+oc/4c9O2e5nXV+1W2hcTSFm\nLhtuGAxBEmRa+o6VREa/+LrQEBtT/5TD+1uKnD24VAVW1HUxRfNx/M+GzrrAiMCH\ns2F7w5TF/2ag0PRmePXyJT1vdPULJnDX9L7N40ICsNpbwSaoCx/oB2SR1ms9oRU5\noRxUiAc7F/YCicjBpSV6LaYHRksbKcSINZ7i+EmuFjxS8MiWwcaSuWy0SCk6sg8n\nVzRiizHRLG2vBECs8GOt\n=Y0K4\n-----END PGP SIGNATURE-----\n","payload":"tree ebb9cfdaa0d0d3da502b94cae82e891c69530813\nparent 24aee3eb5ee90dd211ef183d65fec774dc7049c9\nauthor Eric Traut <etraut@openai.com> 1781108892 -0700\ncommitter GitHub <noreply@github.com> 1781108892 -0700\n\nReduce archive rollout lookup CPU (#27276)\n\n## Why\n\nArchiving a thread can spike app-server CPU when the state DB does not\nhave a usable rollout path. The archive path falls back to locating the\nrollout by thread id; because rollout filenames already contain the\nUUID, the cheap fallback should find the file directly before invoking\nbroader file search.\n\n## What Changed\n\n- In `codex-rs/rollout/src/list.rs`, try the exact rollout filename\nlookup before `codex-file-search`.\n- Keep fuzzy search as the final legacy fallback when no filename match\nis found.\n- Preserve the legacy fallback when the filename scan hits a traversal\nerror, so an inaccessible stale subtree does not block lookup elsewhere.\n\n## Verification\n\n- `just test -p codex-rollout`\n- `just test -p codex-thread-store`\n- `just test -p codex-app-server thread_archive`","verified_at":"2026-06-10T16:28:13Z"}},"url":"https://api.github.com/repos/openai/codex/commits/c365b8a4abfe0436ca85978fd186bd89d55a8807","html_url":"https://github.com/openai/codex/commit/c365b8a4abfe0436ca85978fd186bd89d55a8807","comments_url":"https://api.github.com/repos/openai/codex/commits/c365b8a4abfe0436ca85978fd186bd89d55a8807/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"24aee3eb5ee90dd211ef183d65fec774dc7049c9","url":"https://api.github.com/repos/openai/codex/commits/24aee3eb5ee90dd211ef183d65fec774dc7049c9","html_url":"https://github.com/openai/codex/commit/24aee3eb5ee90dd211ef183d65fec774dc7049c9"}]},{"sha":"24aee3eb5ee90dd211ef183d65fec774dc7049c9","node_id":"C_kwDOOYsS4doAKDI0YWVlM2ViNWVlOTBkZDIxMWVmMTgzZDY1ZmVjNzc0ZGM3MDQ5Yzk","commit":{"author":{"name":"Tamir Duberstein","email":"tamird@openai.com","date":"2026-06-10T16:18:19Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T16:18:19Z"},"message":"[codex] link Windows releases with LLD (#27315)\n\nWindows x64 release builds spend about 36.5 of 48 minutes in final\nLLVM code generation and MSVC linking. Use the existing target-aware\nMSVC\nsetup action to select LLD for release builds; the Windows ARM64 archive\npath already exercises the action and its LLD wrapper.\n\nIn https://github.com/openai/codex/actions/runs/27242495616, macOS\nbecomes\nthe critical path after roughly four minutes of Windows improvement, so\nthis is expected to reduce total workflow time by about four minutes.","tree":{"sha":"e9000db8872e30e76d75fba96faf2597b634067e","url":"https://api.github.com/repos/openai/codex/git/trees/e9000db8872e30e76d75fba96faf2597b634067e"},"url":"https://api.github.com/repos/openai/codex/git/commits/24aee3eb5ee90dd211ef183d65fec774dc7049c9","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKY5LCRC1aQ7uu5UhlAAAPE4QADSSnByLZ3zwRpVj2b/6YwDx\nqd+D6pq/ouMs/ivF8IBqdq0NsiBXjl1QwJv23C6RBQbfPz5TsmyMyDMtLz5gVRMn\nXAkuag9cj1JOFRyrp/jlB+SkrQV00o9BTgS0bwufeXOKii6/A4fZx02YRqzaTPEx\nG12g6Xo3bafimVjJsUR7h0MLwNUeHCcfMk+2em9hSgIc7Qiqso5yiFezAIMnIl49\nwJJ/s/uecGrCoOaY11QUK3HO8KE2TbGBu1UIKaearODuhfqINkAqA+Z6iuVs+7Wx\nY0IjdJ6bM3RhmdYT73sS0QpJ4QnJRLlJBJU9CrmY0f0aLh6fEYL9oXUkg8amXFGV\nLb1m36O6YVvxtjB0ARMx9NpItsbcr6g8z3HfB7zEPS0WrLTWpNhNUWlNCJcjaOCn\nmQlvbFyQWT7fN/0OHs8dWSmZaOcGw+Q/n5Ldg0CTKNJnQ918CJAa+gF+1UBxm+1L\nOzx5fD7sf1yr1jsGlhvU12TMHYx9JfZ2eGi3u/7IUdB6w6CBMgM3vpiUKqZ84ZCw\ntLZpCqaLFGZdZSZsDJVJKQYDqu2VhQW6TwpPbCebVR32Cl7azhuChwGPTm35RCnX\n/IsdBjDzjCKfRjSiNN7cNwodQxIWRRZ4n/GVVdn2HddV7I7USR/cGFss+FdJLEGL\nqk1vtetvqiYYg0K6VBis\n=brw+\n-----END PGP SIGNATURE-----\n","payload":"tree e9000db8872e30e76d75fba96faf2597b634067e\nparent 0428e20a0b8a1153453832c616dc96133aa4b127\nauthor Tamir Duberstein <tamird@openai.com> 1781108299 -0700\ncommitter GitHub <noreply@github.com> 1781108299 -0700\n\n[codex] link Windows releases with LLD (#27315)\n\nWindows x64 release builds spend about 36.5 of 48 minutes in final\nLLVM code generation and MSVC linking. Use the existing target-aware\nMSVC\nsetup action to select LLD for release builds; the Windows ARM64 archive\npath already exercises the action and its LLD wrapper.\n\nIn https://github.com/openai/codex/actions/runs/27242495616, macOS\nbecomes\nthe critical path after roughly four minutes of Windows improvement, so\nthis is expected to reduce total workflow time by about four minutes.","verified_at":"2026-06-10T16:18:20Z"}},"url":"https://api.github.com/repos/openai/codex/commits/24aee3eb5ee90dd211ef183d65fec774dc7049c9","html_url":"https://github.com/openai/codex/commit/24aee3eb5ee90dd211ef183d65fec774dc7049c9","comments_url":"https://api.github.com/repos/openai/codex/commits/24aee3eb5ee90dd211ef183d65fec774dc7049c9/comments","author":{"login":"tamird","id":1535036,"node_id":"MDQ6VXNlcjE1MzUwMzY=","avatar_url":"https://avatars.githubusercontent.com/u/1535036?v=4","gravatar_id":"","url":"https://api.github.com/users/tamird","html_url":"https://github.com/tamird","followers_url":"https://api.github.com/users/tamird/followers","following_url":"https://api.github.com/users/tamird/following{/other_user}","gists_url":"https://api.github.com/users/tamird/gists{/gist_id}","starred_url":"https://api.github.com/users/tamird/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tamird/subscriptions","organizations_url":"https://api.github.com/users/tamird/orgs","repos_url":"https://api.github.com/users/tamird/repos","events_url":"https://api.github.com/users/tamird/events{/privacy}","received_events_url":"https://api.github.com/users/tamird/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"0428e20a0b8a1153453832c616dc96133aa4b127","url":"https://api.github.com/repos/openai/codex/commits/0428e20a0b8a1153453832c616dc96133aa4b127","html_url":"https://github.com/openai/codex/commit/0428e20a0b8a1153453832c616dc96133aa4b127"}]},{"sha":"0428e20a0b8a1153453832c616dc96133aa4b127","node_id":"C_kwDOOYsS4doAKDA0MjhlMjBhMGI4YTExNTM0NTM4MzJjNjE2ZGM5NjEzM2FhNGIxMjc","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-10T15:51:17Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T15:51:17Z"},"message":"[codex] add io PathUri native conversion APIs (#27280)\n\n## Why\n\nDiscovered some rough edges in the API while making use of it more\nwidely within exec-server. It would be a lot more convenient for\nexisting users of `AbsolutePathBuf` if `PathUri` conversion methods\nreturned `std::io::Result`s.\n\n## What\n\n* `PathUri::to_native_path()` -> `PathUri::to_abs_path()`\n* `PathUri::from_file_path()` -> `PathUri::from_abs_path()`","tree":{"sha":"e5bd975903d14e931288d0182c6d965d462f9f0a","url":"https://api.github.com/repos/openai/codex/git/trees/e5bd975903d14e931288d0182c6d965d462f9f0a"},"url":"https://api.github.com/repos/openai/codex/git/commits/0428e20a0b8a1153453832c616dc96133aa4b127","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKYf1CRC1aQ7uu5UhlAAAvVMQAKtqhYR/52Z77QhOyL9/mZcS\nLES+FLOwFzI0cOacUnBt843jHXZtvhPeOdYfUVl0pwS7Al5EDoARVbrt503ASwv9\nmdek2THV2sTJn20d2KPjhe7q89BPFDYbetzHx+GWHEkSZBixfiyqLEArs+6VLd/I\nn0SJ4daG9+PUQGLZDH7eK9E7kovGM3QziTx5YSHg+xqLr3Wb/bqucVBn9bWNH7B8\npmjWl7as0XJ19pdWdxZRpbjRL4WBPeRbD3opgjLfOOj3KfPjOx8WxRwdQJ2TWNe6\n8gQGfJZxVqCsTSg8IdH4Nla5iq2BE7dZLH+YY75v7cng6ik81ipAjlfTwtWMolwz\nQZge1iYn64tHPef+Wk6GPOw9ABGOqWZmgGZyNvoPA+FKeoXiGAc95H+M+sdiEhis\nxl8tNFEKjH4JfQWo1CyqILMG9lgstPZ68p6C7HaDFf9U60mgZyjNMq+9J22uEE/5\n5FwGQZXCGAsqiCzhmJgbSopK8xKLdKxOxNYPUCiar4BJTfcFTTw/toeDrHuziapP\nRRAyQM3MLGW5tiP5n2ewtbrnMP5nCdXIequ9/1N+f2pZTccr61jX9mms43Nir/OT\na5pP5/0ktxzNjOIDdYkD3u4s4JupKHuXXzZUDuLM4upsKHDyzIxq8nNQokxHWrIS\nF4eX8C7GsGezo2v8uxjb\n=chQc\n-----END PGP SIGNATURE-----\n","payload":"tree e5bd975903d14e931288d0182c6d965d462f9f0a\nparent 30ddb3325e380d8e32d39324bd9acf931e5217bb\nauthor Adam Perry @ OpenAI <anp@openai.com> 1781106677 -0700\ncommitter GitHub <noreply@github.com> 1781106677 -0700\n\n[codex] add io PathUri native conversion APIs (#27280)\n\n## Why\n\nDiscovered some rough edges in the API while making use of it more\nwidely within exec-server. It would be a lot more convenient for\nexisting users of `AbsolutePathBuf` if `PathUri` conversion methods\nreturned `std::io::Result`s.\n\n## What\n\n* `PathUri::to_native_path()` -> `PathUri::to_abs_path()`\n* `PathUri::from_file_path()` -> `PathUri::from_abs_path()`","verified_at":"2026-06-10T15:51:18Z"}},"url":"https://api.github.com/repos/openai/codex/commits/0428e20a0b8a1153453832c616dc96133aa4b127","html_url":"https://github.com/openai/codex/commit/0428e20a0b8a1153453832c616dc96133aa4b127","comments_url":"https://api.github.com/repos/openai/codex/commits/0428e20a0b8a1153453832c616dc96133aa4b127/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"30ddb3325e380d8e32d39324bd9acf931e5217bb","url":"https://api.github.com/repos/openai/codex/commits/30ddb3325e380d8e32d39324bd9acf931e5217bb","html_url":"https://github.com/openai/codex/commit/30ddb3325e380d8e32d39324bd9acf931e5217bb"}]},{"sha":"30ddb3325e380d8e32d39324bd9acf931e5217bb","node_id":"C_kwDOOYsS4doAKDMwZGRiMzMyNWUzODBkOGUzMmQzOTMyNGJkOWFjZjkzMWU1MjE3YmI","commit":{"author":{"name":"pakrym-oai","email":"pakrym@openai.com","date":"2026-06-10T15:47:16Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T15:47:16Z"},"message":"[codex] Store compact window id in rollout (#27264)\n\n## Why\n\nCompaction window identity is part of session history, not model-client\ntransport state. Persisting it with the compacted rollout item lets\nresumed threads continue from the reconstructed window without keeping\nmutable window state on `ModelClient`.\n\n## What changed\n\n- Added `window_id` to `CompactedItem` and stamp it when\n`replace_compacted_history` installs compacted history.\n- Moved auto-compact window id ownership into `AutoCompactWindow` /\n`SessionState`; `ModelClient` now receives the request window id from\ncallers instead of storing it.\n- Returned `window_id` from rollout reconstruction for resume.\nReconstruction uses the newest surviving compacted item's stored\n`window_id` when present, and falls back to the legacy compacted-item\ncount when it is absent.\n- Kept fork startup at the fresh default window id and updated direct\nmodel-client tests to pass explicit test window ids.\n\n## Validation\n\n- `cargo check -p codex-core --tests`","tree":{"sha":"9a56c0a597a6c7945110138bd371a1f430dbf97e","url":"https://api.github.com/repos/openai/codex/git/trees/9a56c0a597a6c7945110138bd371a1f430dbf97e"},"url":"https://api.github.com/repos/openai/codex/git/commits/30ddb3325e380d8e32d39324bd9acf931e5217bb","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKYcECRC1aQ7uu5UhlAAAUiQQADO75sO6YBQS8lgNIW1bwbX+\nt5sPA4F+f1cvSsXp/jO1MLN6mfSLGLerKWyXqiu12z6UU1TcwH1+h3y3dC6vNzE9\nkd1/UisyNqYrB+PebpR5TqGhWtJjACtfKvJcxOBegmgL5eKQMOJcmX5u54BO2ySR\nXrNuOZVG+rco+0nZrAbNzqWVjA6Zc9Uv+kK+ISj0kYetPEI3Udaj34BqKkZmnN7R\nPMRGHUyNDGPTXHDoxCYsA8zlOsaurwMk5PjgOYrPmasK1bjDB6n1tobHevMkJK2Q\np//UGszgCL8Z91QtRjoec+odhYuiQa0jfD0Hk1zJrdCWQ5ZQSbae0Ok4ZHzZDysR\nhX7hAaBi8cncvAiBBYu/o8H9gPULKR4p8JIywlCBynoY0R9knLt1msqH3P5CTYgc\ntU27dCahpjtnqOdfaKu1s7oNyv4ZFjRRvmGwzakY04HKDYEzvMEQzlr1Kl/onXkJ\nv9vzrFTZkOdkJbSqarDcTktoLHQzMQCg9vyUr4hr1CRSymOgB1gsuw858ni5y4IM\nhxWLocc9kYyKgf0M3jDuGEfbl8bFh3QprWocTtoT+oliuNzVL+vIWovY+gyEwFF7\neMgOJOPuG0CWj9TTKtNO0yEi4lc4R6afCDdEiYs/VzFBzKRsvARwl/p6JHvdHwXx\ne+9BVNpkLPEkLBYT+ch9\n=bsvo\n-----END PGP SIGNATURE-----\n","payload":"tree 9a56c0a597a6c7945110138bd371a1f430dbf97e\nparent 41b4fabbb4fb2a5d9d956d12c706daee992a76e2\nauthor pakrym-oai <pakrym@openai.com> 1781106436 -0700\ncommitter GitHub <noreply@github.com> 1781106436 -0700\n\n[codex] Store compact window id in rollout (#27264)\n\n## Why\n\nCompaction window identity is part of session history, not model-client\ntransport state. Persisting it with the compacted rollout item lets\nresumed threads continue from the reconstructed window without keeping\nmutable window state on `ModelClient`.\n\n## What changed\n\n- Added `window_id` to `CompactedItem` and stamp it when\n`replace_compacted_history` installs compacted history.\n- Moved auto-compact window id ownership into `AutoCompactWindow` /\n`SessionState`; `ModelClient` now receives the request window id from\ncallers instead of storing it.\n- Returned `window_id` from rollout reconstruction for resume.\nReconstruction uses the newest surviving compacted item's stored\n`window_id` when present, and falls back to the legacy compacted-item\ncount when it is absent.\n- Kept fork startup at the fresh default window id and updated direct\nmodel-client tests to pass explicit test window ids.\n\n## Validation\n\n- `cargo check -p codex-core --tests`","verified_at":"2026-06-10T15:47:17Z"}},"url":"https://api.github.com/repos/openai/codex/commits/30ddb3325e380d8e32d39324bd9acf931e5217bb","html_url":"https://github.com/openai/codex/commit/30ddb3325e380d8e32d39324bd9acf931e5217bb","comments_url":"https://api.github.com/repos/openai/codex/commits/30ddb3325e380d8e32d39324bd9acf931e5217bb/comments","author":{"login":"pakrym-oai","id":204937752,"node_id":"U_kgDODDcaGA","avatar_url":"https://avatars.githubusercontent.com/u/204937752?v=4","gravatar_id":"","url":"https://api.github.com/users/pakrym-oai","html_url":"https://github.com/pakrym-oai","followers_url":"https://api.github.com/users/pakrym-oai/followers","following_url":"https://api.github.com/users/pakrym-oai/following{/other_user}","gists_url":"https://api.github.com/users/pakrym-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/pakrym-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pakrym-oai/subscriptions","organizations_url":"https://api.github.com/users/pakrym-oai/orgs","repos_url":"https://api.github.com/users/pakrym-oai/repos","events_url":"https://api.github.com/users/pakrym-oai/events{/privacy}","received_events_url":"https://api.github.com/users/pakrym-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"41b4fabbb4fb2a5d9d956d12c706daee992a76e2","url":"https://api.github.com/repos/openai/codex/commits/41b4fabbb4fb2a5d9d956d12c706daee992a76e2","html_url":"https://github.com/openai/codex/commit/41b4fabbb4fb2a5d9d956d12c706daee992a76e2"}]},{"sha":"41b4fabbb4fb2a5d9d956d12c706daee992a76e2","node_id":"C_kwDOOYsS4doAKDQxYjRmYWJiYjRmYjJhNWQ5ZDk1NmQxMmM3MDZkYWVlOTkyYTc2ZTI","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-06-10T15:33:21Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T15:33:21Z"},"message":"Use latest-wins MCP manager replacement (#27259)\n\n## Summary\n\nWe originally addressed startup prewarming holding the read side of\n`RwLock<McpConnectionManager>` by snapshotting tool-list state. Review\nfeedback identified the broader ownership problem: the outer\nsynchronization should only publish or retrieve the current manager,\nwhile MCP operations rely on the manager's internal synchronization. A\nfollow-up preserved operation retirement with a separate gate, but\nfurther review questioned whether that synchronization was actually\nrequired and whether we could support latest-wins replacement instead.\n\nThis PR now stores the current MCP manager in `ArcSwap`. Each operation\nuses `load_full()` to obtain an owned `Arc<McpConnectionManager>`, then\nperforms MCP I/O without retaining the publication mechanism. Refresh\ncancels obsolete startup work, constructs a replacement, and atomically\npublishes it. New operations see the latest manager, while operations\nthat already loaded the previous manager retain a valid handle. Refresh\nhappens at a turn boundary, so there should be no active user tool calls\nto drain.\n\nGit history supports dropping the outer `RwLock`. It was introduced in\n`03ffe4d595` on November 17, 2025 for non-blocking MCP startup: the\nsession published an empty manager, startup initialized that same object\nwhile holding the write lock, and readers waited for initialization.\n`7cd2e84026` on February 19, 2026 removed that two-phase initialization\nin favor of constructing a fresh manager and swapping it in, explicitly\nnoting that `Option` or `OnceCell` could replace the placeholder design.\nHot reload later reused the existing lock to publish a replacement, but\nI found no indication that the lock was introduced to guarantee\nin-flight tool calls finish before refresh or shutdown.\n\nTerminal shutdown remains separate from refresh: it aborts startup\nprewarming and active tasks before shutting down the current manager, so\ntool calls may be interrupted and no model WebSocket work continues\nafter shutdown. Focused regression coverage exercises pending tool-list\ncancellation, deferred refresh, and startup-prewarm shutdown.","tree":{"sha":"bc6aa80362a70cc2b7925612b6e2f6132fdcf1c3","url":"https://api.github.com/repos/openai/codex/git/trees/bc6aa80362a70cc2b7925612b6e2f6132fdcf1c3"},"url":"https://api.github.com/repos/openai/codex/git/commits/41b4fabbb4fb2a5d9d956d12c706daee992a76e2","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKYPBCRC1aQ7uu5UhlAAABeQQAKMPDcVJTxqFTrMhu1Zp/CVB\ntFJUVI/hwwTbIsy0wS9AQXXDkoRY5MKmWvVbuTazXlQlwpwJc+QcAG22n80MU6dF\n0L/Ia0yps/T0jD5Telo4Zgyf1LDYhvfVWUx4eZFvJicS8PrJZNi6hjTPVyVxOWO8\nJnoXUy5zZcH6mgQxEsKuF9kpKaeqxU2pyHwReqixXXV8Y5WpdkX5gbQzGeFzgkMN\n1gGnEnc8h+J2txM4LM0j0vXfGAp7oybwgDEwF/dE7L6iHdre2pCaHxAM1b+SZxCO\nV4B06eInPOnwOoZ0hOiAmwgjLL9OUuyZXhHwFv89LXA71+7pdzE7UaYyPSKpThpe\n7xL8EYFT/YbRT6ONPzOKDzHxcT0cbOL81Em6AZwRLZshZTh8IAqJ5KqIAU6AOQ/v\nyluVsN2PnXBulylt20v2Jz9G8VhLvBK70OZJrR3k5bogxn7eWgjPkjTEsUJHh5ap\nGoDjW/TpVy5MT7rQbAciXGny4MHrJqk+6GtEBjSCriTO77krDoBDjYI2n6AzD91I\nk/8wDtFGAyF0VYIdBVVPCOVqacnO0xcfgs8vaMuQsc2YNj9ZfnnuUj/QMQtkDPwz\nMh4zVSWUX5opkVZQfl5wDH9cVby06VQudGlOrYhTNbqS1vQcVIQUV4jlgaOkid1m\nAa8DeStngw/vL3sUSDu0\n=Ij1m\n-----END PGP SIGNATURE-----\n","payload":"tree bc6aa80362a70cc2b7925612b6e2f6132fdcf1c3\nparent d2f6d23c6cb07f72d18dfd0d8ca09c807870e677\nauthor Charlie Marsh <charliemarsh@openai.com> 1781105601 -0700\ncommitter GitHub <noreply@github.com> 1781105601 -0700\n\nUse latest-wins MCP manager replacement (#27259)\n\n## Summary\n\nWe originally addressed startup prewarming holding the read side of\n`RwLock<McpConnectionManager>` by snapshotting tool-list state. Review\nfeedback identified the broader ownership problem: the outer\nsynchronization should only publish or retrieve the current manager,\nwhile MCP operations rely on the manager's internal synchronization. A\nfollow-up preserved operation retirement with a separate gate, but\nfurther review questioned whether that synchronization was actually\nrequired and whether we could support latest-wins replacement instead.\n\nThis PR now stores the current MCP manager in `ArcSwap`. Each operation\nuses `load_full()` to obtain an owned `Arc<McpConnectionManager>`, then\nperforms MCP I/O without retaining the publication mechanism. Refresh\ncancels obsolete startup work, constructs a replacement, and atomically\npublishes it. New operations see the latest manager, while operations\nthat already loaded the previous manager retain a valid handle. Refresh\nhappens at a turn boundary, so there should be no active user tool calls\nto drain.\n\nGit history supports dropping the outer `RwLock`. It was introduced in\n`03ffe4d595` on November 17, 2025 for non-blocking MCP startup: the\nsession published an empty manager, startup initialized that same object\nwhile holding the write lock, and readers waited for initialization.\n`7cd2e84026` on February 19, 2026 removed that two-phase initialization\nin favor of constructing a fresh manager and swapping it in, explicitly\nnoting that `Option` or `OnceCell` could replace the placeholder design.\nHot reload later reused the existing lock to publish a replacement, but\nI found no indication that the lock was introduced to guarantee\nin-flight tool calls finish before refresh or shutdown.\n\nTerminal shutdown remains separate from refresh: it aborts startup\nprewarming and active tasks before shutting down the current manager, so\ntool calls may be interrupted and no model WebSocket work continues\nafter shutdown. Focused regression coverage exercises pending tool-list\ncancellation, deferred refresh, and startup-prewarm shutdown.","verified_at":"2026-06-10T15:33:22Z"}},"url":"https://api.github.com/repos/openai/codex/commits/41b4fabbb4fb2a5d9d956d12c706daee992a76e2","html_url":"https://github.com/openai/codex/commit/41b4fabbb4fb2a5d9d956d12c706daee992a76e2","comments_url":"https://api.github.com/repos/openai/codex/commits/41b4fabbb4fb2a5d9d956d12c706daee992a76e2/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"d2f6d23c6cb07f72d18dfd0d8ca09c807870e677","url":"https://api.github.com/repos/openai/codex/commits/d2f6d23c6cb07f72d18dfd0d8ca09c807870e677","html_url":"https://github.com/openai/codex/commit/d2f6d23c6cb07f72d18dfd0d8ca09c807870e677"}]},{"sha":"d2f6d23c6cb07f72d18dfd0d8ca09c807870e677","node_id":"C_kwDOOYsS4doAKGQyZjZkMjNjNmNiMDdmNzJkMThkZmQwZDhjYTA5YzgwNzg3MGU2Nzc","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-10T12:31:09Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T12:31:09Z"},"message":"Remove async-trait from extension contributors (#27383)\n\n## Why\n\nExtension contributors are registered behind `dyn Trait` objects, so\nnative `async fn`/RPITIT methods would make these traits\nnon-object-safe. Spell out the boxed, `Send` future contract directly so\n`extension-api` no longer needs `async-trait` while retaining the\nexisting runtime model.\n\n## What changed\n\n- add a shared `ExtensionFuture` alias and use it for asynchronous\ncontributor methods\n- migrate production and test implementations to return `Box::pin(async\nmove { ... })`\n- remove `async-trait` dependencies where they are no longer used,\nkeeping it dev-only where unrelated test executors still require it\n\n## Behavior\n\nNo behavior change is intended. Contributor futures remain boxed,\n`Send`, dynamically dispatched, and lazily executed; cancellation and\ncallback ordering stay unchanged.\n\n## Testing\n\n- `just test -p codex-extension-api` (11 passed)\n- affected extension crates (64 passed)\n- targeted `codex-core` contributor tests (14 passed)\n- `just fmt`\n- `just bazel-lock-update`\n- `just bazel-lock-check`\n\nA broad local `codex-core` run compiled successfully but encountered\nunrelated sandbox and missing test-binary fixture failures; CI will run\nthe full checks.","tree":{"sha":"1eb28b293e757384cd03773f5f06128e778c2f46","url":"https://api.github.com/repos/openai/codex/git/trees/1eb28b293e757384cd03773f5f06128e778c2f46"},"url":"https://api.github.com/repos/openai/codex/git/commits/d2f6d23c6cb07f72d18dfd0d8ca09c807870e677","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKVkNCRC1aQ7uu5UhlAAAna0QABv5C4b55KKlgI4ZwOeb0qA0\ncR3au9RefAvmRjmhrDih1A2wYjsnP44pY0a+IUb+HY3/uzib26Yxq3JrIgCDmAH+\n6AzIuQjn5ZsqW1BHVHEhHsvJcI/lXCJ6wH23FwJOAMh/+TW6D3ayKvxdbXJ8YIJq\nY930qQE0Qj4glG2PA9gsgIPomLJm7RXaLl/yghOiOX6Fp8+Bn3hG6CAXQ32QN/ka\ndwANMSaPU51H7bOOm0r2Wmu3bnIcK1zX27K+x/oWV4+h4qZaQ5nl+4rzZK/WDIBg\n37Ox8cs4l4RqDFL3aE/FNEpEV2QmjlSMkRQ72t1d4fh6eHsjMdJZmCli1oICXREy\nEo/r4KANmZtdMRociv97Hmk+ju4RbAvde49KXEweLRxPUsoXHBP97LjmuWSxOFl/\nyt6sUIueieDUgjd9+Lk2+p4PfHy+QAAGCbc84EFxoj/zFkMQeVu9K33Oaz8y5INA\nD+dYSSKyyktYya/HhQjj5LA/ZZY4wHRvIqLD30E9P6x5OV5YNVo+6O3I7MPj1c3K\npm6TJuzTDOubXJDIobwCHIjZGaCYFX3D/GviAIzu6vGpoNgiP7Q9I7tNFA+6YLLD\nIzjvcMbukhZ7EYAG2zDGQdLw7wn5lYvyVdY+++7l62HxHqH5xp3aGDvPUOPbhIa3\nmJP5tasm8ERl8fYWRVI1\n=14gs\n-----END PGP SIGNATURE-----\n","payload":"tree 1eb28b293e757384cd03773f5f06128e778c2f46\nparent ced1b8aa883f25b992f9ebe7d218f3709926f912\nauthor jif <jif@openai.com> 1781094669 +0100\ncommitter GitHub <noreply@github.com> 1781094669 +0200\n\nRemove async-trait from extension contributors (#27383)\n\n## Why\n\nExtension contributors are registered behind `dyn Trait` objects, so\nnative `async fn`/RPITIT methods would make these traits\nnon-object-safe. Spell out the boxed, `Send` future contract directly so\n`extension-api` no longer needs `async-trait` while retaining the\nexisting runtime model.\n\n## What changed\n\n- add a shared `ExtensionFuture` alias and use it for asynchronous\ncontributor methods\n- migrate production and test implementations to return `Box::pin(async\nmove { ... })`\n- remove `async-trait` dependencies where they are no longer used,\nkeeping it dev-only where unrelated test executors still require it\n\n## Behavior\n\nNo behavior change is intended. Contributor futures remain boxed,\n`Send`, dynamically dispatched, and lazily executed; cancellation and\ncallback ordering stay unchanged.\n\n## Testing\n\n- `just test -p codex-extension-api` (11 passed)\n- affected extension crates (64 passed)\n- targeted `codex-core` contributor tests (14 passed)\n- `just fmt`\n- `just bazel-lock-update`\n- `just bazel-lock-check`\n\nA broad local `codex-core` run compiled successfully but encountered\nunrelated sandbox and missing test-binary fixture failures; CI will run\nthe full checks.","verified_at":"2026-06-10T12:31:10Z"}},"url":"https://api.github.com/repos/openai/codex/commits/d2f6d23c6cb07f72d18dfd0d8ca09c807870e677","html_url":"https://github.com/openai/codex/commit/d2f6d23c6cb07f72d18dfd0d8ca09c807870e677","comments_url":"https://api.github.com/repos/openai/codex/commits/d2f6d23c6cb07f72d18dfd0d8ca09c807870e677/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"ced1b8aa883f25b992f9ebe7d218f3709926f912","url":"https://api.github.com/repos/openai/codex/commits/ced1b8aa883f25b992f9ebe7d218f3709926f912","html_url":"https://github.com/openai/codex/commit/ced1b8aa883f25b992f9ebe7d218f3709926f912"}]},{"sha":"ced1b8aa883f25b992f9ebe7d218f3709926f912","node_id":"C_kwDOOYsS4doAKGNlZDFiOGFhODgzZjI1Yjk5MmY5ZWJlN2QyMThmMzcwOTkyNmY5MTI","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-10T11:06:48Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T11:06:48Z"},"message":"[codex] Tag multi-agent spawn metrics with version (#27375)\n\n## Summary\n- tag legacy multi-agent spawn metrics with `version=v1`\n- tag multi-agent v2 spawn metrics with `version=v2`\n\n## Why\n`codex.multi_agent.spawn` is emitted by both runtimes, so the existing\nmetric cannot distinguish v2 adoption from aggregate multi-agent\nspawning. The bounded version tag makes that breakdown directly\nqueryable without changing the counter's success-only semantics.\n\n## Validation\n- `just fmt`\n- `git diff --check`\n- Tests and Clippy were intentionally left to CI.","tree":{"sha":"f349e12cc89d135bf0659528dc05d5ae3b78d949","url":"https://api.github.com/repos/openai/codex/git/trees/f349e12cc89d135bf0659528dc05d5ae3b78d949"},"url":"https://api.github.com/repos/openai/codex/git/commits/ced1b8aa883f25b992f9ebe7d218f3709926f912","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKUVICRC1aQ7uu5UhlAAArcEQALD05nXb1bkD4Syz5Gu9S3Bx\nojnoDd7L1Epe/Lu3dEnOJehUCgosyh8rsyqEea4HrOlZ4yj/rXxLLyn0bJWVBEZu\nnzxz8dAd9OMI/6/nOGlnUwoII81Mzi8c4SgzKN9avMeOZjgNRaTp0vXm29vTxvK5\nc0L3fILusb/mKaSo5cX2hzEbwz8mi6xdALRpGTip+1QBvPPdqFqaCRoLV2hyqrww\ndScgnPWojyRbVbWlYeXeR6cji48MSTUQv7DDPJJra/9N62pkztpt4d/QEpQB1auK\noFjOcUStRW5QAAY1cMo+Dd9Kc8OgKeQe6XiRPs8kEv6ZZcgDpCvk3B0IhVCoV+6+\nzjhVwvcEqWSU9e3O8+xkD0GgnzFzNjAcl2jnR3tDd4NZMTSTsfZcPbuZJTpnEm3b\n25EcyyYJ/6nWgWFq8tICWY59nLiQrMOBOfbgmm9vrD/sjnr+LZzqpEnD0aWJ0d13\n/7AujZGgZ/qONY0/TXLzCSzh8kBfMHaXmA8tgFxGSzxOaxX9h7I5CRIlqrGwDUXO\nE0axM6ryid+n+DRbkbTH38fk2L1oDvkGXi7txbUPYpmtxpGuO4Iv2kobnaOuQ1C/\nLyMl94jljkWd0o7CDht6b89jbnQhHaKR3rk2coiCh+1RWLs1cA6MklYV9H3QkwUa\nAG9AaWB+7UKeFyrh/W7X\n=PgDu\n-----END PGP SIGNATURE-----\n","payload":"tree f349e12cc89d135bf0659528dc05d5ae3b78d949\nparent 9cd11e9e62c48ea6127f8b9f6ae2e013e4e4ff00\nauthor jif <jif@openai.com> 1781089608 +0200\ncommitter GitHub <noreply@github.com> 1781089608 +0200\n\n[codex] Tag multi-agent spawn metrics with version (#27375)\n\n## Summary\n- tag legacy multi-agent spawn metrics with `version=v1`\n- tag multi-agent v2 spawn metrics with `version=v2`\n\n## Why\n`codex.multi_agent.spawn` is emitted by both runtimes, so the existing\nmetric cannot distinguish v2 adoption from aggregate multi-agent\nspawning. The bounded version tag makes that breakdown directly\nqueryable without changing the counter's success-only semantics.\n\n## Validation\n- `just fmt`\n- `git diff --check`\n- Tests and Clippy were intentionally left to CI.","verified_at":"2026-06-10T11:06:49Z"}},"url":"https://api.github.com/repos/openai/codex/commits/ced1b8aa883f25b992f9ebe7d218f3709926f912","html_url":"https://github.com/openai/codex/commit/ced1b8aa883f25b992f9ebe7d218f3709926f912","comments_url":"https://api.github.com/repos/openai/codex/commits/ced1b8aa883f25b992f9ebe7d218f3709926f912/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"9cd11e9e62c48ea6127f8b9f6ae2e013e4e4ff00","url":"https://api.github.com/repos/openai/codex/commits/9cd11e9e62c48ea6127f8b9f6ae2e013e4e4ff00","html_url":"https://github.com/openai/codex/commit/9cd11e9e62c48ea6127f8b9f6ae2e013e4e4ff00"}]},{"sha":"9cd11e9e62c48ea6127f8b9f6ae2e013e4e4ff00","node_id":"C_kwDOOYsS4doAKDljZDExZTllNjJjNDhlYTYxMjdmOGI5ZjZhZTJlMDEzZTRlNGZmMDA","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-10T10:54:21Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T10:54:21Z"},"message":"Use plugin-service MCP as the hosted plugin runtime (#27198)\n\n## Stack\n\n- Base: #27191\n- This PR is the third vertical and should be reviewed against\n`jif/external-plugins-2`, not `main`.\n\n## Why\n\n#27191 moves the host-owned Apps MCP registration behind an extension\ncontributor, but deliberately preserves the existing endpoint-selection\nfeature while that contribution contract lands. App-server can therefore\nresolve the server through extensions, yet the hosted plugin endpoint is\nstill selected through temporary `apps_mcp_path_override` plumbing.\n\nThat is not the long-term plugin model. A plugin can bundle skills,\nconnectors, MCP servers, and hooks, and those components do not all need\nthe same source or execution environment. In particular, an\nauthenticated HTTP MCP server can expose plugin capabilities directly\nfrom a backend without an executor or an orchestrator filesystem.\n\nThis PR completes that hosted vertical. App-server's MCP extension now\nowns the aggregate hosted plugin runtime at `/ps/mcp`. Connector actions\ncontinue to arrive as MCP tools, while backend-provided skills arrive as\nMCP resources and use Codex's existing resource list/read paths. No\nsecond backend client, skill filesystem, or generic plugin activation\nframework is introduced.\n\nThe backend route remains the hosted implementation. This change\nreplaces Codex's temporary endpoint-selection mechanism, not the service\nbehind the endpoint.\n\n## What changed\n\n### Hosted plugin runtime\n\nThe MCP extension now contributes `codex_apps` as the hosted plugin\nruntime rather than as a configurable Apps endpoint:\n\n- `https://chatgpt.com` resolves to\n`https://chatgpt.com/backend-api/ps/mcp`;\n- a bare custom ChatGPT base resolves to `/api/codex/ps/mcp`;\n- the existing product-SKU header and ChatGPT authentication behavior\nare preserved;\n- executor availability is never consulted for this streamable HTTP\ntransport.\n\nThe same MCP connection carries both component shapes supported by the\nhosted endpoint:\n\n- connector actions are discovered and invoked as MCP tools;\n- hosted skills are enumerated and read as MCP resources through the\nexisting `list_mcp_resources` and `read_mcp_resource` paths.\n\nThis keeps component access in the subsystem that already owns the\nprotocol instead of downloading backend skills into an orchestrator\nfilesystem or inventing a parallel hosted-skill client.\n\n### Explicit runtime ordering\n\n`McpManager` now resolves the reserved `codex_apps` entry in three\nordered phases:\n\n1. install the legacy Apps fallback for compatibility;\n2. apply ordered extension `Set` or `Remove` overlays;\n3. apply the final ChatGPT-auth gate without synthesizing the server\nagain.\n\nThis ordering is important:\n\n- an ordinary configured or plugin MCP server cannot claim the\nauth-bearing `codex_apps` name;\n- an extension-contributed hosted runtime wins over the fallback;\n- an extension `Remove` remains authoritative;\n- a host without the MCP extension retains the legacy Apps endpoint and\ncurrent local-only behavior.\n\nThe temporary `legacy_apps_mcp_loader_enabled` coordination flag is no\nlonger needed.\n\n### Remove the path override\n\nThe `apps_mcp_path_override` feature and its runtime plumbing are\nremoved, including:\n\n- the feature registry entry and structured feature config;\n- `Config` and `McpConfig` fields;\n- config schema output;\n- config-lock materialization;\n- URL override handling in `codex-mcp`.\n\nExisting boolean and structured forms still deserialize as ignored\ncompatibility input. They are omitted from new serialized config, and\nconfig-lock comparison normalizes the removed input so older locks\nremain replayable.\n\n### App-server coverage\n\nApp-server MCP fixtures now serve the hosted route at\n`/api/codex/ps/mcp`. Existing resource-read and tool/elicitation flows\ntherefore exercise the extension-owned endpoint rather than succeeding\nthrough the legacy fallback.\n\nThe stack also adds the missing `codex_chatgpt::connectors` re-export\nfor the manager-backed connector helper introduced in #27191.\n\n## Compatibility\n\n- App-server installs the extension and uses `/ps/mcp` for the hosted\nruntime.\n- CLI and other hosts that do not install the extension retain the\nlegacy Apps endpoint.\n- Apps disabled or non-ChatGPT authentication removes `codex_apps` from\nthe effective runtime view.\n- Existing local plugins, local skills, executor-selected skills,\nconfigured MCP servers, and MCP OAuth behavior are otherwise unchanged.\n- Backend plugin enablement remains account/workspace state owned by the\nhosted endpoint; this PR does not add thread-local backend plugin\nselection.\n\n## Architectural fit\n\nThe stack now proves two independent runtime shapes:\n\n1. #27184 resolves filesystem-backed skills through the executor that\nowns a selected root.\n2. #27191 and this PR resolve a backend-hosted HTTP MCP through an\nextension with no executor.\n\nTogether they preserve the intended separation:\n\n- selection identifies a plugin/root when explicit selection is needed;\n- each component's owning extension resolves its concrete access\nmechanism;\n- execution stays with the runtime required by that component;\n- existing skills, MCP, connector, and hook subsystems remain the\ndownstream consumers.\n\n## Planned follow-ups\n\n1. **Executor stdio MCP:** selecting an executor plugin registers a\nmanifest-declared stdio MCP server and executes it in the environment\nthat owns the plugin.\n2. **Optional backend selection:** only if CCA needs thread-local\nselection distinct from backend account/workspace enablement, add a\nconcrete backend-owned capability location and surface those selected\nskills through the skills catalog.\n3. **Connector metadata and hooks:** activate those plugin components\nthrough their existing owning subsystems, with executor hooks remaining\nenvironment-bound.\n4. **Propagation and persistence:** define explicit resume, fork,\nsubagent, refresh, and environment-removal semantics once selected roots\nhave multiple real consumers.\n5. **Local convergence:** migrate legacy local skill, MCP, connector,\nand hook paths behind their owning extensions one vertical at a time,\nthen remove duplicate core managers and compatibility plumbing after\nparity.\n\n## Verification\n\nCoverage in this change exercises:\n\n- extension-owned `/backend-api/ps/mcp` registration without an\nexecutor;\n- preservation of the legacy endpoint in hosts without the extension;\n- extension `Set` and `Remove` precedence over the legacy fallback;\n- ChatGPT-auth gating for the reserved server;\n- hosted MCP resource reads with and without an active thread;\n- connector tool invocation and MCP elicitation through the hosted\nroute;\n- ignored boolean and structured forms of the removed path override;\n- config-lock replay compatibility for the removed feature.\n\n`cargo check -p codex-features -p codex-mcp-extension -p\ncodex-app-server` passes. Tests and Clippy were not run locally under\nthe current development instruction; CI provides the full validation\npass.","tree":{"sha":"029c817f5e8c8f2779cf8a33990e97c827590826","url":"https://api.github.com/repos/openai/codex/git/trees/029c817f5e8c8f2779cf8a33990e97c827590826"},"url":"https://api.github.com/repos/openai/codex/git/commits/9cd11e9e62c48ea6127f8b9f6ae2e013e4e4ff00","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKUJdCRC1aQ7uu5UhlAAAZpYQABWx1rbQLrFPjtVum8Rw12hU\nFSqbwSsAe4l7QvJazkQ2o4cBbJKQiU+sui7ikVKeS13YINWzoQSmPIVZzrkuO0eq\nxOUGZ0PEGyoCRnQPLBqu70VFSTd2TXub90dJ+xBXs/AW9NutKO7zrJEHLNP+AGT2\n1CEOoEasoz+EHA161teh/oDFKOdwp7B0a52XnnSvT8nqp7p7LZLJhdZg0cyfKlN7\nmCP9zyoFxAGVLpd+Zn7YWx1tKqgTtSxJe9ddbJH6BN1vjv4/3xVRuSgKqqDko11a\nVEMkC8tHAh2v5TSm13xGmbSNBwFuu4qttovrbzX59Odkz8apHRosnF+NAc/b2QNd\nDMYjiNsakgO1cZyGtDrwls75P9WSVLwoObrScYyB+I6qVpl1WOwNhliQ3PNC1LDG\npSS/IxeO/Rt2wVrdDJjTp9l0gnBsZbD/NN1qfaqQZw9oV7gWqcOrnjEoWeQV3jo5\nqqqINb1w6HCrWJyABnLwFJ4cfrG6uUYvuvU+HFa90rZkny7IvOVQHZOo9wxxiqZQ\nQMeqOvKNAig52JWFyWwp0ZNVnKsOabHLr85alnNdI9q6YeosAZdzhSq168fuyxVY\nf28GML+te5E2phgy6/Zi38mdm3RvTsYqlpALDCtlTZ5YfVOJH8Ng2NR5P0wgKxD8\nWR0kxispZTrkZVVLnN7m\n=zFUi\n-----END PGP SIGNATURE-----\n","payload":"tree 029c817f5e8c8f2779cf8a33990e97c827590826\nparent 0ffcefaf3ddb3a61d8683ca0703f7d8b39ad6c1e\nauthor jif <jif@openai.com> 1781088861 +0200\ncommitter GitHub <noreply@github.com> 1781088861 +0200\n\nUse plugin-service MCP as the hosted plugin runtime (#27198)\n\n## Stack\n\n- Base: #27191\n- This PR is the third vertical and should be reviewed against\n`jif/external-plugins-2`, not `main`.\n\n## Why\n\n#27191 moves the host-owned Apps MCP registration behind an extension\ncontributor, but deliberately preserves the existing endpoint-selection\nfeature while that contribution contract lands. App-server can therefore\nresolve the server through extensions, yet the hosted plugin endpoint is\nstill selected through temporary `apps_mcp_path_override` plumbing.\n\nThat is not the long-term plugin model. A plugin can bundle skills,\nconnectors, MCP servers, and hooks, and those components do not all need\nthe same source or execution environment. In particular, an\nauthenticated HTTP MCP server can expose plugin capabilities directly\nfrom a backend without an executor or an orchestrator filesystem.\n\nThis PR completes that hosted vertical. App-server's MCP extension now\nowns the aggregate hosted plugin runtime at `/ps/mcp`. Connector actions\ncontinue to arrive as MCP tools, while backend-provided skills arrive as\nMCP resources and use Codex's existing resource list/read paths. No\nsecond backend client, skill filesystem, or generic plugin activation\nframework is introduced.\n\nThe backend route remains the hosted implementation. This change\nreplaces Codex's temporary endpoint-selection mechanism, not the service\nbehind the endpoint.\n\n## What changed\n\n### Hosted plugin runtime\n\nThe MCP extension now contributes `codex_apps` as the hosted plugin\nruntime rather than as a configurable Apps endpoint:\n\n- `https://chatgpt.com` resolves to\n`https://chatgpt.com/backend-api/ps/mcp`;\n- a bare custom ChatGPT base resolves to `/api/codex/ps/mcp`;\n- the existing product-SKU header and ChatGPT authentication behavior\nare preserved;\n- executor availability is never consulted for this streamable HTTP\ntransport.\n\nThe same MCP connection carries both component shapes supported by the\nhosted endpoint:\n\n- connector actions are discovered and invoked as MCP tools;\n- hosted skills are enumerated and read as MCP resources through the\nexisting `list_mcp_resources` and `read_mcp_resource` paths.\n\nThis keeps component access in the subsystem that already owns the\nprotocol instead of downloading backend skills into an orchestrator\nfilesystem or inventing a parallel hosted-skill client.\n\n### Explicit runtime ordering\n\n`McpManager` now resolves the reserved `codex_apps` entry in three\nordered phases:\n\n1. install the legacy Apps fallback for compatibility;\n2. apply ordered extension `Set` or `Remove` overlays;\n3. apply the final ChatGPT-auth gate without synthesizing the server\nagain.\n\nThis ordering is important:\n\n- an ordinary configured or plugin MCP server cannot claim the\nauth-bearing `codex_apps` name;\n- an extension-contributed hosted runtime wins over the fallback;\n- an extension `Remove` remains authoritative;\n- a host without the MCP extension retains the legacy Apps endpoint and\ncurrent local-only behavior.\n\nThe temporary `legacy_apps_mcp_loader_enabled` coordination flag is no\nlonger needed.\n\n### Remove the path override\n\nThe `apps_mcp_path_override` feature and its runtime plumbing are\nremoved, including:\n\n- the feature registry entry and structured feature config;\n- `Config` and `McpConfig` fields;\n- config schema output;\n- config-lock materialization;\n- URL override handling in `codex-mcp`.\n\nExisting boolean and structured forms still deserialize as ignored\ncompatibility input. They are omitted from new serialized config, and\nconfig-lock comparison normalizes the removed input so older locks\nremain replayable.\n\n### App-server coverage\n\nApp-server MCP fixtures now serve the hosted route at\n`/api/codex/ps/mcp`. Existing resource-read and tool/elicitation flows\ntherefore exercise the extension-owned endpoint rather than succeeding\nthrough the legacy fallback.\n\nThe stack also adds the missing `codex_chatgpt::connectors` re-export\nfor the manager-backed connector helper introduced in #27191.\n\n## Compatibility\n\n- App-server installs the extension and uses `/ps/mcp` for the hosted\nruntime.\n- CLI and other hosts that do not install the extension retain the\nlegacy Apps endpoint.\n- Apps disabled or non-ChatGPT authentication removes `codex_apps` from\nthe effective runtime view.\n- Existing local plugins, local skills, executor-selected skills,\nconfigured MCP servers, and MCP OAuth behavior are otherwise unchanged.\n- Backend plugin enablement remains account/workspace state owned by the\nhosted endpoint; this PR does not add thread-local backend plugin\nselection.\n\n## Architectural fit\n\nThe stack now proves two independent runtime shapes:\n\n1. #27184 resolves filesystem-backed skills through the executor that\nowns a selected root.\n2. #27191 and this PR resolve a backend-hosted HTTP MCP through an\nextension with no executor.\n\nTogether they preserve the intended separation:\n\n- selection identifies a plugin/root when explicit selection is needed;\n- each component's owning extension resolves its concrete access\nmechanism;\n- execution stays with the runtime required by that component;\n- existing skills, MCP, connector, and hook subsystems remain the\ndownstream consumers.\n\n## Planned follow-ups\n\n1. **Executor stdio MCP:** selecting an executor plugin registers a\nmanifest-declared stdio MCP server and executes it in the environment\nthat owns the plugin.\n2. **Optional backend selection:** only if CCA needs thread-local\nselection distinct from backend account/workspace enablement, add a\nconcrete backend-owned capability location and surface those selected\nskills through the skills catalog.\n3. **Connector metadata and hooks:** activate those plugin components\nthrough their existing owning subsystems, with executor hooks remaining\nenvironment-bound.\n4. **Propagation and persistence:** define explicit resume, fork,\nsubagent, refresh, and environment-removal semantics once selected roots\nhave multiple real consumers.\n5. **Local convergence:** migrate legacy local skill, MCP, connector,\nand hook paths behind their owning extensions one vertical at a time,\nthen remove duplicate core managers and compatibility plumbing after\nparity.\n\n## Verification\n\nCoverage in this change exercises:\n\n- extension-owned `/backend-api/ps/mcp` registration without an\nexecutor;\n- preservation of the legacy endpoint in hosts without the extension;\n- extension `Set` and `Remove` precedence over the legacy fallback;\n- ChatGPT-auth gating for the reserved server;\n- hosted MCP resource reads with and without an active thread;\n- connector tool invocation and MCP elicitation through the hosted\nroute;\n- ignored boolean and structured forms of the removed path override;\n- config-lock replay compatibility for the removed feature.\n\n`cargo check -p codex-features -p codex-mcp-extension -p\ncodex-app-server` passes. Tests and Clippy were not run locally under\nthe current development instruction; CI provides the full validation\npass.","verified_at":"2026-06-10T10:54:21Z"}},"url":"https://api.github.com/repos/openai/codex/commits/9cd11e9e62c48ea6127f8b9f6ae2e013e4e4ff00","html_url":"https://github.com/openai/codex/commit/9cd11e9e62c48ea6127f8b9f6ae2e013e4e4ff00","comments_url":"https://api.github.com/repos/openai/codex/commits/9cd11e9e62c48ea6127f8b9f6ae2e013e4e4ff00/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"0ffcefaf3ddb3a61d8683ca0703f7d8b39ad6c1e","url":"https://api.github.com/repos/openai/codex/commits/0ffcefaf3ddb3a61d8683ca0703f7d8b39ad6c1e","html_url":"https://github.com/openai/codex/commit/0ffcefaf3ddb3a61d8683ca0703f7d8b39ad6c1e"}]},{"sha":"0ffcefaf3ddb3a61d8683ca0703f7d8b39ad6c1e","node_id":"C_kwDOOYsS4doAKDBmZmNlZmFmM2RkYjNhNjFkODY4M2NhMDcwM2Y3ZDhiMzlhZDZjMWU","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-10T09:45:49Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T09:45:49Z"},"message":"feat: keep child MCP warnings out of parent transcript (#27174)\n\n## Why\n\nMCP startup status notifications are thread-owned, but `ChatWidget`\ntrusted upstream routing. If routing state delivered a tagged child\nnotification to the active parent widget, the child MCP failure could\nstill mutate the parent's startup state and transcript. Rejecting it\nonly inside the MCP handler was also too late because shared\nnotification handling could already restore and consume the parent's\nretry status.\n\n## What changed\n\n- Validate a tagged MCP status notification against the visible\n`ChatWidget` thread before shared notification handling mutates any\nparent state.\n- Cover child `Starting` and `Failed` notifications delivered to a\nretrying parent widget, asserting that they preserve its visible retry\nerror and saved status header while producing no history or MCP status\nmutation.\n\n## User impact\n\nSubagent MCP startup failures remain scoped to the child transcript\ninstead of appearing as duplicate warnings in the parent transcript.\n\n## Testing\n\n- `just test -p codex-tui mcp_startup_ignores_status_for_other_thread`\n- `just test -p codex-tui\nprimary_thread_ignores_child_mcp_startup_notifications`\n- `just fmt`","tree":{"sha":"1e55a9abe0b53db781b506a3301bb49ba4a07bd3","url":"https://api.github.com/repos/openai/codex/git/trees/1e55a9abe0b53db781b506a3301bb49ba4a07bd3"},"url":"https://api.github.com/repos/openai/codex/git/commits/0ffcefaf3ddb3a61d8683ca0703f7d8b39ad6c1e","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKTJNCRC1aQ7uu5UhlAAAKLcQAJdRm2NmUDc06nrnPJU2zZC7\npQkFXa+brcwxaKKfge2AJKCmN/xTGKges/fJK+oCQzS3np5A4G8yRB6L9MNDXlUd\nlscJwmgDaCXB67xiZ3rxba3DpnpTuEUz/bL2rYp/8iV30J25ihGzpDxRAdaXRfLr\np2kallmRJHJWDIVcnFA2OObgJP0fO1TfOok0BYzABm2kMFCIKjVVq/fztN0qo3qZ\npIxNZmPiIWNmrwrk3TBCTwwYboO5WDJJZ7PV8vG7Foi2Ac1Q2t/k9nZjCuCNsyvs\n0A1iPEzJhN/9sOTYhdg2kWjUItLXppdzAZooquL2WLxKkwYTYtEMRzxDEgZQtzMf\nPlIdnkDDYcqA+WY2sLdaa0xtCBUP/ndbeJE2jmcnb2GwLP5jT7qNTd2gB+BSo3i3\nEujnNu1NjAlBVrsxZoemt3JAwwgEdksWocBx4Q2nWEVFPIiOCO4YYXrmJl7rxUgg\nQ0jr5ah5L9dJ4OtDYplO8i+7vv3cL740liYXGJcylDm4/UiMbXevsTMDmFdG5oDY\nLm6hX8NsbaBSHGkyCrRwT9dhS/J6q7xXRUY1txXsmdEprloXnAr556JB8dGQxtVo\nhNBPjq5pI+TWgG4RQypMCwef2oDiJxa/Kcn533z2BRqY4ENrjCPXh6qvg6VO34Se\nAGEE5x13RpAcY83mt1xy\n=y09n\n-----END PGP SIGNATURE-----\n","payload":"tree 1e55a9abe0b53db781b506a3301bb49ba4a07bd3\nparent a7b6baecc63519fd1d7b7be4f779217fe6c82063\nauthor jif <jif@openai.com> 1781084749 +0200\ncommitter GitHub <noreply@github.com> 1781084749 +0200\n\nfeat: keep child MCP warnings out of parent transcript (#27174)\n\n## Why\n\nMCP startup status notifications are thread-owned, but `ChatWidget`\ntrusted upstream routing. If routing state delivered a tagged child\nnotification to the active parent widget, the child MCP failure could\nstill mutate the parent's startup state and transcript. Rejecting it\nonly inside the MCP handler was also too late because shared\nnotification handling could already restore and consume the parent's\nretry status.\n\n## What changed\n\n- Validate a tagged MCP status notification against the visible\n`ChatWidget` thread before shared notification handling mutates any\nparent state.\n- Cover child `Starting` and `Failed` notifications delivered to a\nretrying parent widget, asserting that they preserve its visible retry\nerror and saved status header while producing no history or MCP status\nmutation.\n\n## User impact\n\nSubagent MCP startup failures remain scoped to the child transcript\ninstead of appearing as duplicate warnings in the parent transcript.\n\n## Testing\n\n- `just test -p codex-tui mcp_startup_ignores_status_for_other_thread`\n- `just test -p codex-tui\nprimary_thread_ignores_child_mcp_startup_notifications`\n- `just fmt`","verified_at":"2026-06-10T09:45:50Z"}},"url":"https://api.github.com/repos/openai/codex/commits/0ffcefaf3ddb3a61d8683ca0703f7d8b39ad6c1e","html_url":"https://github.com/openai/codex/commit/0ffcefaf3ddb3a61d8683ca0703f7d8b39ad6c1e","comments_url":"https://api.github.com/repos/openai/codex/commits/0ffcefaf3ddb3a61d8683ca0703f7d8b39ad6c1e/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a7b6baecc63519fd1d7b7be4f779217fe6c82063","url":"https://api.github.com/repos/openai/codex/commits/a7b6baecc63519fd1d7b7be4f779217fe6c82063","html_url":"https://github.com/openai/codex/commit/a7b6baecc63519fd1d7b7be4f779217fe6c82063"}]},{"sha":"a7b6baecc63519fd1d7b7be4f779217fe6c82063","node_id":"C_kwDOOYsS4doAKGE3YjZiYWVjYzYzNTE5ZmQxZDdiN2JlNGY3NzkyMTdmZTZjODIwNjM","commit":{"author":{"name":"Ahmed Ibrahim","email":"aibrahim@openai.com","date":"2026-06-10T07:17:58Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T07:17:58Z"},"message":"[codex] Make MCP connection startup fallible (#27261)\n\n## Why\n\nRequired MCP server startup was enforced in `Session::new` after\n`McpConnectionManager` had already created the clients. That split let\nother manager construction paths bypass the same requirement and exposed\nmanager internals solely so the session could validate them. Keeping\nrequired-server readiness in the constructor gives every caller one\nconsistent startup contract.\n\n## What changed\n\n- make `McpConnectionManager::new` return `anyhow::Result<Self>` and\nfail when an enabled, required server cannot initialize\n- pass the startup cancellation token into the constructor so\nrequired-server waits remain cancellable\n- propagate constructor failures through resource reads, connector\ndiscovery, and MCP status collection\n- preserve the active manager and cancellation token when a refreshed\nreplacement fails\n- keep required-startup failure collection private and cover the\nconstructor error contract directly\n\n## Validation\n\n- updated the focused connection-manager test to assert the complete\nrequired-server startup error\n- local tests not run; relying on CI","tree":{"sha":"92f66b07d90fa50736e3c1f74dbbce8dfe74ee1a","url":"https://api.github.com/repos/openai/codex/git/trees/92f66b07d90fa50736e3c1f74dbbce8dfe74ee1a"},"url":"https://api.github.com/repos/openai/codex/git/commits/a7b6baecc63519fd1d7b7be4f779217fe6c82063","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKQ+mCRC1aQ7uu5UhlAAAbhgQACtUmgkE4sMqjdelc77EzrI5\nTzd2QgH6uIFDj4T+Tx5m0cYFPvBGJp4XALul2HnYho27h9GSylLKx3iUN30+p/gb\n9h852wRd2gkcu8Hu15eDeM9D3Sexi4xp3BElGVatpMA+jcePUk+rfdPzblv59f4L\n5h1PWNfYNPOwv4iptv7nvmk+1zL7a1kXihKhe0owLdpf6j0d2BUVCPCwKHn1PTUQ\nNISRqEO7Hs0NPqlWfGP6cXZGsxjfLHK+ZITudw35zMy/GrbGh5RUXEztxxTry0dS\nhpVGiI1T4q3TzcmO4DD7QDL9FzdutP9cfZSad4Nz7jjVFdHoqOCIjqoWXqDq1M/m\n0aKZobIFpDlHbel/zqjnd5lBY14jsV55MFUpJMIn/bGZtiyl+d9pwF9lw6qhlRZw\nllp1Kv7I3T8pxKrxzjzCCQfA+gVgF5vxXfzGWCxnBX/uFG2z4uHQ8/JN2mQZKwO3\nRpjiSMTyMSWSExw2OPf0LC4k1Ri72t0GmC8OWGmA6pBmxqM/8yk6SiYECcRCGuaE\nF0MkoTYbzp90kWLXPNU0LmpL2ot5pd3Ftiq6e7sP5MTm0OSnRIjAcS6b2uwIWm6B\n0RvXTFFimM7RhXy5m1kcLtGx7SGJDtXl1M48LnbWFChPD0YM8cL1h/diWstg3tSd\nDiOIdCHPz2uZrA4ibUC+\n=4XHk\n-----END PGP SIGNATURE-----\n","payload":"tree 92f66b07d90fa50736e3c1f74dbbce8dfe74ee1a\nparent 00a25e1e0c6eecf076dcb989f4065c578c262ae7\nauthor Ahmed Ibrahim <aibrahim@openai.com> 1781075878 -0700\ncommitter GitHub <noreply@github.com> 1781075878 -0700\n\n[codex] Make MCP connection startup fallible (#27261)\n\n## Why\n\nRequired MCP server startup was enforced in `Session::new` after\n`McpConnectionManager` had already created the clients. That split let\nother manager construction paths bypass the same requirement and exposed\nmanager internals solely so the session could validate them. Keeping\nrequired-server readiness in the constructor gives every caller one\nconsistent startup contract.\n\n## What changed\n\n- make `McpConnectionManager::new` return `anyhow::Result<Self>` and\nfail when an enabled, required server cannot initialize\n- pass the startup cancellation token into the constructor so\nrequired-server waits remain cancellable\n- propagate constructor failures through resource reads, connector\ndiscovery, and MCP status collection\n- preserve the active manager and cancellation token when a refreshed\nreplacement fails\n- keep required-startup failure collection private and cover the\nconstructor error contract directly\n\n## Validation\n\n- updated the focused connection-manager test to assert the complete\nrequired-server startup error\n- local tests not run; relying on CI","verified_at":"2026-06-10T07:17:59Z"}},"url":"https://api.github.com/repos/openai/codex/commits/a7b6baecc63519fd1d7b7be4f779217fe6c82063","html_url":"https://github.com/openai/codex/commit/a7b6baecc63519fd1d7b7be4f779217fe6c82063","comments_url":"https://api.github.com/repos/openai/codex/commits/a7b6baecc63519fd1d7b7be4f779217fe6c82063/comments","author":{"login":"aibrahim-oai","id":219906144,"node_id":"U_kgDODRuAYA","avatar_url":"https://avatars.githubusercontent.com/u/219906144?v=4","gravatar_id":"","url":"https://api.github.com/users/aibrahim-oai","html_url":"https://github.com/aibrahim-oai","followers_url":"https://api.github.com/users/aibrahim-oai/followers","following_url":"https://api.github.com/users/aibrahim-oai/following{/other_user}","gists_url":"https://api.github.com/users/aibrahim-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/aibrahim-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aibrahim-oai/subscriptions","organizations_url":"https://api.github.com/users/aibrahim-oai/orgs","repos_url":"https://api.github.com/users/aibrahim-oai/repos","events_url":"https://api.github.com/users/aibrahim-oai/events{/privacy}","received_events_url":"https://api.github.com/users/aibrahim-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"00a25e1e0c6eecf076dcb989f4065c578c262ae7","url":"https://api.github.com/repos/openai/codex/commits/00a25e1e0c6eecf076dcb989f4065c578c262ae7","html_url":"https://github.com/openai/codex/commit/00a25e1e0c6eecf076dcb989f4065c578c262ae7"}]},{"sha":"00a25e1e0c6eecf076dcb989f4065c578c262ae7","node_id":"C_kwDOOYsS4doAKDAwYTI1ZTFlMGM2ZWVjZjA3NmRjYjk4OWY0MDY1YzU3OGMyNjJhZTc","commit":{"author":{"name":"mchen-oai","email":"mchen@openai.com","date":"2026-06-10T04:41:06Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T04:41:06Z"},"message":"Add spans to run_turn (#27107)\n\n## Why\nCodex app-server latency traces do not granularly cover turn\norchestration, sampling-request preparation, and tool-loading work.\nThese spans help separate local coordination/setup costs from model\nstreaming and tool execution.\n\n## What changed\n- Add `run_turn.*` spans around sampling-request input preparation and\npost-sampling state collection\n- Add function-level trace spans around turn setup, hook execution,\ncompaction, prompt construction, and MCP tool exposure\n- Add `built_tools.*` spans around plugin loading and discoverable-tool\nloading\n\n## Verification\nTrigger Codex rollout and observe new spans are included","tree":{"sha":"513653d019a8c98be468e8e35cd97bfef9fcb44e","url":"https://api.github.com/repos/openai/codex/git/trees/513653d019a8c98be468e8e35cd97bfef9fcb44e"},"url":"https://api.github.com/repos/openai/codex/git/commits/00a25e1e0c6eecf076dcb989f4065c578c262ae7","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKOriCRC1aQ7uu5UhlAAAacUQABkexy1Kkm/6Bp4PKh40WuV8\nP5J9/DWgfoBiopv6+lVsnbykC8VXruRGnP4flAMubhE89ix5p/aZpdFBCVCPB7v7\nTXTQ+b971OyVPvSIXiE64o0RqWmsyjqYlWP/Dprx6DyF1F+tqf4GWhUqwkeYX8N2\n2VyyzdeNEi8nDuEAQc+5MV6PmFlvRZMxQPjWPQYaDcKJjzn3e7KshiCLO7gPUHTK\nA+m0Ud1gTWWkbvebJxgmk0BTr6BGgAss/5My2zc/RJ40w3mNP0vih7kqW1yUZf81\n2vBOJOe8dJVcEOaGgAnh9V6oNzhJ3sMvddtXnO8L85hIx8EoN7x7o6N9to3cn0xN\nP/LMJ4pemgfEnvVtE3fsJIMgKnLyxEoRcaWlpZ0UcKS0g2Jm8pKfvcAKwUM5rRTl\nRo7t3XvLMb8Ui8b4yNsuBgoVsm2RLr3z1PRXBUR1VEc1Cdk2getYz2lgbL04WkZC\nRASHhc3+bVm9GEjnV2KuO5qi5JHzUX3J6McE0B1xEClJg73QWV6W97tnSvjPguWV\nJnob37F/RdG+L9TRsNQaFYg+aOX0SLStQERxniiBp0JEIIP0p5WYvQAsolqFkem8\nwFCkhm2h+A8Z/kxVRbw6A+l6tyvmhHtvC8Zzlkaa+N9o4a4bke0J0cVbxp8Mr/nn\neBxa5EiZ5C27LW0SDrtY\n=AKSC\n-----END PGP SIGNATURE-----\n","payload":"tree 513653d019a8c98be468e8e35cd97bfef9fcb44e\nparent e0cb4ede4e44a371d595520b29d0c80336b8733e\nauthor mchen-oai <mchen@openai.com> 1781066466 -0700\ncommitter GitHub <noreply@github.com> 1781066466 +0000\n\nAdd spans to run_turn (#27107)\n\n## Why\nCodex app-server latency traces do not granularly cover turn\norchestration, sampling-request preparation, and tool-loading work.\nThese spans help separate local coordination/setup costs from model\nstreaming and tool execution.\n\n## What changed\n- Add `run_turn.*` spans around sampling-request input preparation and\npost-sampling state collection\n- Add function-level trace spans around turn setup, hook execution,\ncompaction, prompt construction, and MCP tool exposure\n- Add `built_tools.*` spans around plugin loading and discoverable-tool\nloading\n\n## Verification\nTrigger Codex rollout and observe new spans are included","verified_at":"2026-06-10T04:41:06Z"}},"url":"https://api.github.com/repos/openai/codex/commits/00a25e1e0c6eecf076dcb989f4065c578c262ae7","html_url":"https://github.com/openai/codex/commit/00a25e1e0c6eecf076dcb989f4065c578c262ae7","comments_url":"https://api.github.com/repos/openai/codex/commits/00a25e1e0c6eecf076dcb989f4065c578c262ae7/comments","author":{"login":"mchen-oai","id":250037145,"node_id":"U_kgDODudDmQ","avatar_url":"https://avatars.githubusercontent.com/u/250037145?v=4","gravatar_id":"","url":"https://api.github.com/users/mchen-oai","html_url":"https://github.com/mchen-oai","followers_url":"https://api.github.com/users/mchen-oai/followers","following_url":"https://api.github.com/users/mchen-oai/following{/other_user}","gists_url":"https://api.github.com/users/mchen-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/mchen-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mchen-oai/subscriptions","organizations_url":"https://api.github.com/users/mchen-oai/orgs","repos_url":"https://api.github.com/users/mchen-oai/repos","events_url":"https://api.github.com/users/mchen-oai/events{/privacy}","received_events_url":"https://api.github.com/users/mchen-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e0cb4ede4e44a371d595520b29d0c80336b8733e","url":"https://api.github.com/repos/openai/codex/commits/e0cb4ede4e44a371d595520b29d0c80336b8733e","html_url":"https://github.com/openai/codex/commit/e0cb4ede4e44a371d595520b29d0c80336b8733e"}]},{"sha":"e0cb4ede4e44a371d595520b29d0c80336b8733e","node_id":"C_kwDOOYsS4doAKGUwY2I0ZWRlNGU0NGEzNzFkNTk1NTIwYjI5ZDBjODAzMzZiODczM2U","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-10T03:52:09Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T03:52:09Z"},"message":"[codex] Fix post-merge analytics integration failures (#27285)\n\n## Why\n\nRecent merges left `main` with analytics integration build failures.\nLocal Cargo runs also made the trimmed-skills test depend on\ndeveloper-installed skills, while Bazel used an isolated home.\n\n## What changed\n\n- Clone `thread_metadata.thread_source` when constructing goal analytics\nevent parameters.\n- Group app-server thread extension inputs into\n`ThreadExtensionDependencies`.\n- Isolate the trimmed-skills test home so its exact fixture count is\nstable across Cargo and Bazel.\n\n## Validation\n\n- `cargo check -p codex-analytics`\n- `just test -p codex-analytics` (71 tests)\n- `just test -p codex-app-server` (837 tests; one unrelated zsh-fork\ntimeout passed on retry)","tree":{"sha":"5fc2665b94764841f0a57d224f548c9a80318e37","url":"https://api.github.com/repos/openai/codex/git/trees/5fc2665b94764841f0a57d224f548c9a80318e37"},"url":"https://api.github.com/repos/openai/codex/git/commits/e0cb4ede4e44a371d595520b29d0c80336b8733e","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKN9pCRC1aQ7uu5UhlAAAQ0gQAGsJ/oy/uz6ey2LzS1B9IIzn\nA9waK7lPobBdsOtpiWfJtpu02+O8OWGdl62w80HYZKc0df+3kuKpUmuDOZrY9li3\nuDFEVTCyKQdyr+0trjIJkk6ABf23P/OTcu+ATayrglfBGZHyDUNSA/fF0X70JSTh\nXKOWBc969FHqhn4CgW+yiM82nDtmMswGlLIlR5r6eSS4xnlUAtX4TjZgkDXcefNc\nP4FeRWbbf66NlUgurVS+IALj1SLzVOlxz4h/oFBZ2FxBdMCEi6m9JBSDVOB7/rls\n0nyXLFXp/WaprJLVpzSvVelGdMiFBK/Gf0WEtQu5qCBT55ObYoqpP3lBtx7tMYEQ\nf0MY/9joUxqN25n2GaXtdw43D3YhfQ270aqogh5weg5Gt9tuK1K9493Ji/tLrej1\nX9XWcXyC8Zs3skaKL/7FGyBWuY+8EsdWqi9ng4GXV985I5SAmRwBfmkWt27foVJq\nL+lR2VCMej5yzssW/QAs4xdfdtYtr+3mgOtQVkZQTq6ZNq125V711/jTAVcqCs4c\n2Zf2WjhHKz8w9wfSdFY87U5+ybg3MzCG46GYmRACmnOsnXtgE1OMtaEaaoho0N+K\nOWIvABkT1voEo59wu43fJsKgA6W/ONq28k7tuz7KH3pqHM2toAyKzk2Gf4OfiqUm\nRwwpUn8WV1mi8ufrgzWA\n=E56v\n-----END PGP SIGNATURE-----\n","payload":"tree 5fc2665b94764841f0a57d224f548c9a80318e37\nparent 608b8b1cc6ce91064e1fd12e0810e1772b5e4710\nauthor Adam Perry @ OpenAI <anp@openai.com> 1781063529 -0700\ncommitter GitHub <noreply@github.com> 1781063529 -0700\n\n[codex] Fix post-merge analytics integration failures (#27285)\n\n## Why\n\nRecent merges left `main` with analytics integration build failures.\nLocal Cargo runs also made the trimmed-skills test depend on\ndeveloper-installed skills, while Bazel used an isolated home.\n\n## What changed\n\n- Clone `thread_metadata.thread_source` when constructing goal analytics\nevent parameters.\n- Group app-server thread extension inputs into\n`ThreadExtensionDependencies`.\n- Isolate the trimmed-skills test home so its exact fixture count is\nstable across Cargo and Bazel.\n\n## Validation\n\n- `cargo check -p codex-analytics`\n- `just test -p codex-analytics` (71 tests)\n- `just test -p codex-app-server` (837 tests; one unrelated zsh-fork\ntimeout passed on retry)","verified_at":"2026-06-10T03:52:09Z"}},"url":"https://api.github.com/repos/openai/codex/commits/e0cb4ede4e44a371d595520b29d0c80336b8733e","html_url":"https://github.com/openai/codex/commit/e0cb4ede4e44a371d595520b29d0c80336b8733e","comments_url":"https://api.github.com/repos/openai/codex/commits/e0cb4ede4e44a371d595520b29d0c80336b8733e/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"608b8b1cc6ce91064e1fd12e0810e1772b5e4710","url":"https://api.github.com/repos/openai/codex/commits/608b8b1cc6ce91064e1fd12e0810e1772b5e4710","html_url":"https://github.com/openai/codex/commit/608b8b1cc6ce91064e1fd12e0810e1772b5e4710"}]},{"sha":"608b8b1cc6ce91064e1fd12e0810e1772b5e4710","node_id":"C_kwDOOYsS4doAKDYwOGI4YjFjYzZjZTkxMDY0ZTFmZDEyZTA4MTBlMTc3MmI1ZTQ3MTA","commit":{"author":{"name":"marksteinbrick-oai","email":"mark.steinbrick@openai.com","date":"2026-06-10T01:45:54Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T01:45:54Z"},"message":"[codex-analytics] emit goal lifecycle analytics (#27078)\n\n## Why\n- Currently, there is no analytics event for `/goal` behavior\n- Existing events cannot identify goal execution or its resulting\noutcome\n- The original update in\n[#26182](https://github.com/openai/codex/pull/26182) was implemented\nbefore `/goal` moved into `codex-goal-extension`.\n\n## What Changed\n- Adds `codex_goal_event` serialization and enrichment to\n`codex-analytics`\n- Emits goal events from the canonical `codex-goal-extension` mutation\nand accounting paths:\n  - `created` when a new logical goal is persisted\n  - `usage_accounted` when cumulative goal usage is persisted\n  - `status_changed` when the stored goal status changes\n  - `cleared` when the goal is deleted\n- Preserves causal `turn_id` for turn driven events and uses null\nattribution for external or idle lifecycle events\n- Changes goal deletion to return the deleted row so `cleared` retains\nthe stable goal ID\n\n## Event Details\n\nIncludes standard analytics metadata along with goal specific fields:\n- `goal_id`: Stable ID stored in the local SQLite goal row and shared\nacross the goal's events\n- `event_kind`: Observed operation (see the 4 lifecycle events cited in\nthe above bullet)\n- `goal_status`: Resulting or last stored status: `active`, `paused`,\n`blocked`, `usage_limited`, etc.\n  - `has_token_budget`: Indicates whether a token budget is configured\n  - `turn_id`: Causal turn ID, or null when no causal turn exists\n- `cumulative_tokens_accounted`: Cumulative tokens on `usage_accounted`\nevents; null otherwise\n- `cumulative_time_accounted_seconds`: Cumulative active time on\n`usage_accounted` events; null otherwise\n\n## Validation\n- `just test -p codex-analytics -p codex-state -p codex-goal-extension`\n- `just test -p codex-core -E 'test(/goal/)'`\n- `just test -p codex-app-server`\n- `cargo build -p codex-analytics -p codex-core -p codex-state -p\ncodex-app-server`","tree":{"sha":"eb61d1a8bd1b0d0436aaafb44da7b3162ef07e73","url":"https://api.github.com/repos/openai/codex/git/trees/eb61d1a8bd1b0d0436aaafb44da7b3162ef07e73"},"url":"https://api.github.com/repos/openai/codex/git/commits/608b8b1cc6ce91064e1fd12e0810e1772b5e4710","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKMHSCRC1aQ7uu5UhlAAAqa4QABXFaqCwts4UP7cVZmOLEOsM\neIIsMm0W+tZP4PldcjDW5/JVPa+68UshU+TnG8JidpyveD8QECALiGHouGToe0+X\nz0cGkfCgVoSwyIanquP0UaD9Bc+obvhBvD5QvUsXWJIYZgxmp2V17zF8IatHomYW\n0KDTALKs40m1nmpN7ErfHKzWakAaSydFDT7RYeUYdoMJ5xIncW33tMBz1pKjDYiR\nxBqOERGYvKjs2t2kWbv+6NyTCsx2g6QnwNSklGmT6zbzxdaOLJALe8ReSsSN03pH\n/G8+QvzVc+1Q57xrqsQe6UdwUctCwk2LTLH2hRoG103gLUHGraoaACggncYiYnX6\nyODl0TcRGTL3+imurFv+ZdjfgHW6Cbew5cxeUItfkUNF6/7trkNHBUm/0UTkv7wi\ne9521WMlIxS+6I19++IFXuhK5TOt0moAoMyaVzXbB8B0mJca6TVxtz+REKHBCXIX\nucIiQI2rwI6Yt5Vng6U5F9hyPkXDqXZ8duE22Iv6jjXjnuBWtdJblDIQxkiH1jh/\nQHbydbZmEOf74+QDiOCHA4k+yINC/OHMrLM8kPf+GDkeWGiQzgFInIfXm/je0ysx\n1k3kjz15xXrYc5zJEBBEHT8Hyr2ScNmau17io7/dwcdwhQHGPDEpsHTMmWAfYzeI\n5wkm4SlymcnlB0Zl8lPQ\n=9EyP\n-----END PGP SIGNATURE-----\n","payload":"tree eb61d1a8bd1b0d0436aaafb44da7b3162ef07e73\nparent 4a3eac214494a5cefebe53308dc48ebabf03201c\nauthor marksteinbrick-oai <mark.steinbrick@openai.com> 1781055954 -0700\ncommitter GitHub <noreply@github.com> 1781055954 -0700\n\n[codex-analytics] emit goal lifecycle analytics (#27078)\n\n## Why\n- Currently, there is no analytics event for `/goal` behavior\n- Existing events cannot identify goal execution or its resulting\noutcome\n- The original update in\n[#26182](https://github.com/openai/codex/pull/26182) was implemented\nbefore `/goal` moved into `codex-goal-extension`.\n\n## What Changed\n- Adds `codex_goal_event` serialization and enrichment to\n`codex-analytics`\n- Emits goal events from the canonical `codex-goal-extension` mutation\nand accounting paths:\n  - `created` when a new logical goal is persisted\n  - `usage_accounted` when cumulative goal usage is persisted\n  - `status_changed` when the stored goal status changes\n  - `cleared` when the goal is deleted\n- Preserves causal `turn_id` for turn driven events and uses null\nattribution for external or idle lifecycle events\n- Changes goal deletion to return the deleted row so `cleared` retains\nthe stable goal ID\n\n## Event Details\n\nIncludes standard analytics metadata along with goal specific fields:\n- `goal_id`: Stable ID stored in the local SQLite goal row and shared\nacross the goal's events\n- `event_kind`: Observed operation (see the 4 lifecycle events cited in\nthe above bullet)\n- `goal_status`: Resulting or last stored status: `active`, `paused`,\n`blocked`, `usage_limited`, etc.\n  - `has_token_budget`: Indicates whether a token budget is configured\n  - `turn_id`: Causal turn ID, or null when no causal turn exists\n- `cumulative_tokens_accounted`: Cumulative tokens on `usage_accounted`\nevents; null otherwise\n- `cumulative_time_accounted_seconds`: Cumulative active time on\n`usage_accounted` events; null otherwise\n\n## Validation\n- `just test -p codex-analytics -p codex-state -p codex-goal-extension`\n- `just test -p codex-core -E 'test(/goal/)'`\n- `just test -p codex-app-server`\n- `cargo build -p codex-analytics -p codex-core -p codex-state -p\ncodex-app-server`","verified_at":"2026-06-10T01:45:55Z"}},"url":"https://api.github.com/repos/openai/codex/commits/608b8b1cc6ce91064e1fd12e0810e1772b5e4710","html_url":"https://github.com/openai/codex/commit/608b8b1cc6ce91064e1fd12e0810e1772b5e4710","comments_url":"https://api.github.com/repos/openai/codex/commits/608b8b1cc6ce91064e1fd12e0810e1772b5e4710/comments","author":{"login":"marksteinbrick-oai","id":219906558,"node_id":"U_kgDODRuB_g","avatar_url":"https://avatars.githubusercontent.com/u/219906558?v=4","gravatar_id":"","url":"https://api.github.com/users/marksteinbrick-oai","html_url":"https://github.com/marksteinbrick-oai","followers_url":"https://api.github.com/users/marksteinbrick-oai/followers","following_url":"https://api.github.com/users/marksteinbrick-oai/following{/other_user}","gists_url":"https://api.github.com/users/marksteinbrick-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/marksteinbrick-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/marksteinbrick-oai/subscriptions","organizations_url":"https://api.github.com/users/marksteinbrick-oai/orgs","repos_url":"https://api.github.com/users/marksteinbrick-oai/repos","events_url":"https://api.github.com/users/marksteinbrick-oai/events{/privacy}","received_events_url":"https://api.github.com/users/marksteinbrick-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"4a3eac214494a5cefebe53308dc48ebabf03201c","url":"https://api.github.com/repos/openai/codex/commits/4a3eac214494a5cefebe53308dc48ebabf03201c","html_url":"https://github.com/openai/codex/commit/4a3eac214494a5cefebe53308dc48ebabf03201c"}]},{"sha":"4a3eac214494a5cefebe53308dc48ebabf03201c","node_id":"C_kwDOOYsS4doAKDRhM2VhYzIxNDQ5NGE1Y2VmZWJlNTMzMDhkYzQ4ZWJhYmYwMzIwMWM","commit":{"author":{"name":"guinness-oai","email":"guinness@openai.com","date":"2026-06-10T00:54:32Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T00:54:32Z"},"message":"Add per-session realtime model and version overrides (#24999)\n\n## Why\n\nClients need to select a realtime session configuration for an\nindividual start without rewriting persisted configuration or restarting\nthe app-server process.\n\n## What Changed\n\n- Add optional `model` and `version` fields to `thread/realtime/start`\n- Forward those optional values through the realtime start operation and\napply them only for that session\n- Preserve existing configured/default behavior when the new fields are\nomitted\n- Update generated protocol schema and app-server documentation\n\n## Validation\n\n- Added/updated protocol serialization coverage for the new optional\nrequest fields\n- Added focused core coverage for a session override taking precedence\nover configured realtime selection\n- Added focused app-server coverage that a request override reaches the\nrealtime WebSocket handshake","tree":{"sha":"1067094aab888a09e0e0547ad769a0f3b63dcf8d","url":"https://api.github.com/repos/openai/codex/git/trees/1067094aab888a09e0e0547ad769a0f3b63dcf8d"},"url":"https://api.github.com/repos/openai/codex/git/commits/4a3eac214494a5cefebe53308dc48ebabf03201c","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKLXICRC1aQ7uu5UhlAAAyoIQAG0NfR5DPuDLfzPCP++MumaJ\nZMMclPKUxTgh3fXz748A81WB0jF8LTK1T5SgA+vB06NRf+1ip3EhPygnUobfatHf\nBMDgp9uIJeBSaEbLlHFPfKQ/bBalT0trSAg3QPLRKZoHI866jE9WYlx27lyEdDQW\nzgFc0G991yk+4PpUAyk/s5zIBJGC2iapEYasRo2jfLQB3PC0FfSobVIve7mfAxox\nRg2EEdN2NPF2Es3MPtuU0wOgA0fGp57lXH93CysP7Xs0QSBTn25TGuxD9ZyjpTlj\n1sLX4okMxNv00/xysiWh38AuanGShPS8Cy3sg85Huu0fqVxVYrjqREh1e8PqhDA8\n4+LXmbIZl5wSbU/vY0KSEQ1xjoqXT5qOuyMQwE6T5+6TEDk4+mQ7BA+SJrrSSUCI\nNRze6X/4aXnAS89kgpdaaU7/mLRD8sxfAVWMZ21CqfeR8TkLPQe8mGAJC4ewxgvl\nZV9MvhtV+6C50Otnk5uxIfQH6qEJOZuneRrzjxEK3oPhjiJXfeyd9fCbXKI/CPOa\n0z2+cukSBaQ4NfewYGDLBiP7+LUlXHTsV78Lim4uyATVjeMnSK06xIr5htOfqZTr\nDKYqLCz93KT73sG9k9cEKtbwO6nh4wSgtpQhavgKprIk+zh6/6RAX7Vd77yXB+lI\n++ACWsVhGeqDZU5926PD\n=8Etw\n-----END PGP SIGNATURE-----\n","payload":"tree 1067094aab888a09e0e0547ad769a0f3b63dcf8d\nparent 5ac640ac49ae5c8b781d51bbaf0467c98cda2643\nauthor guinness-oai <guinness@openai.com> 1781052872 -0700\ncommitter GitHub <noreply@github.com> 1781052872 -0700\n\nAdd per-session realtime model and version overrides (#24999)\n\n## Why\n\nClients need to select a realtime session configuration for an\nindividual start without rewriting persisted configuration or restarting\nthe app-server process.\n\n## What Changed\n\n- Add optional `model` and `version` fields to `thread/realtime/start`\n- Forward those optional values through the realtime start operation and\napply them only for that session\n- Preserve existing configured/default behavior when the new fields are\nomitted\n- Update generated protocol schema and app-server documentation\n\n## Validation\n\n- Added/updated protocol serialization coverage for the new optional\nrequest fields\n- Added focused core coverage for a session override taking precedence\nover configured realtime selection\n- Added focused app-server coverage that a request override reaches the\nrealtime WebSocket handshake","verified_at":"2026-06-10T00:54:33Z"}},"url":"https://api.github.com/repos/openai/codex/commits/4a3eac214494a5cefebe53308dc48ebabf03201c","html_url":"https://github.com/openai/codex/commit/4a3eac214494a5cefebe53308dc48ebabf03201c","comments_url":"https://api.github.com/repos/openai/codex/commits/4a3eac214494a5cefebe53308dc48ebabf03201c/comments","author":{"login":"guinness-oai","id":254771997,"node_id":"U_kgDODy-DHQ","avatar_url":"https://avatars.githubusercontent.com/u/254771997?v=4","gravatar_id":"","url":"https://api.github.com/users/guinness-oai","html_url":"https://github.com/guinness-oai","followers_url":"https://api.github.com/users/guinness-oai/followers","following_url":"https://api.github.com/users/guinness-oai/following{/other_user}","gists_url":"https://api.github.com/users/guinness-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/guinness-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/guinness-oai/subscriptions","organizations_url":"https://api.github.com/users/guinness-oai/orgs","repos_url":"https://api.github.com/users/guinness-oai/repos","events_url":"https://api.github.com/users/guinness-oai/events{/privacy}","received_events_url":"https://api.github.com/users/guinness-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"5ac640ac49ae5c8b781d51bbaf0467c98cda2643","url":"https://api.github.com/repos/openai/codex/commits/5ac640ac49ae5c8b781d51bbaf0467c98cda2643","html_url":"https://github.com/openai/codex/commit/5ac640ac49ae5c8b781d51bbaf0467c98cda2643"}]},{"sha":"5ac640ac49ae5c8b781d51bbaf0467c98cda2643","node_id":"C_kwDOOYsS4doAKDVhYzY0MGFjNDlhZTVjOGI3ODFkNTFiYmFmMDQ2N2M5OGNkYTI2NDM","commit":{"author":{"name":"mchen-oai","email":"mchen@openai.com","date":"2026-06-10T00:49:59Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T00:49:59Z"},"message":"Add spans to build_tool_router (#27094)\n\n## Why\n- Local profiling shows `append_tool_search_executor` averages ~113ms\nper call. Adding a span lets us track this cost as we optimize in\nfollow-up PRs, either by reducing the work or avoiding repeated rebuilds\nwhen inputs have not changed.\n- While we're here, we can add spans to `build_tool_router` and other\nsub-calls which code analysis shows may have additional opportunities\nfor improvement.\n\n## What changed\nAdd function-level trace spans around `build_tool_router`,\n`build_tool_specs_and_registry`, `add_tool_sources`,\n`append_tool_search_executor`, and\n`build_model_visible_specs_and_registry`\n\n## Verification\nTrigger Codex rollout and observe new spans are included","tree":{"sha":"fd3bf1c23d0c62cefd2dba27f196e720d153d349","url":"https://api.github.com/repos/openai/codex/git/trees/fd3bf1c23d0c62cefd2dba27f196e720d153d349"},"url":"https://api.github.com/repos/openai/codex/git/commits/5ac640ac49ae5c8b781d51bbaf0467c98cda2643","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKLS3CRC1aQ7uu5UhlAAA4LsQAEwZDJWAYQfeAbewgJhN2SKM\nzp49OC+cFz37Y2GB5URfif+DtYyikSbUEISEZDWkP/Sdx8tlYC/7Dv0jd5TrraLb\nKGBHw4j8qK71Cyc9AO/8+bzz/WQ0baW4aRIDI9Ipb3MxJ/07ii0bFoqMFRk7MsDX\nEK+xrnYgztlmphcrNNcFQItUkqMZoSUkCleTUZ9v2OVH3jZC42OwmejawRQMbM7f\n1Wn/gCSBsKvfJWLasWW3Qt6j4s3xpNFgE6tDIPqtwHvbpkzqlZn0xb2UhouGm5tU\nKK2517oNJdGPCEnJ85ujM0g30HphOVaAerUv9yjGY4QWYdf+W9dzbwN1adVOAWRj\nXlpM8hm5Kh2WIPDPd8FIwsidGk554HI8ue/VcW1BAzSDF6/ocOzF8FVh16Nt5D+d\nJTzPBtDxKLEqoxlq6Or5BLBrYArtCeA+UQjNwVWZtE7OCnfAF6wJvLmKE+4DlWIM\nm0kHMPGXt2ikcYYJJ+3hHIeU7C3aqDdMlG3pEG3XVO4Ny7g2kmGzecOlNohBnSQe\nU1BVZk2pRaCXFFzgno7zwcm/xFWj7S/NlkVdz+1qheROmxNZxc+Ma+Wmzg+wgNqM\nIMRUISmQOZ+GDWf0xTJxnR4ckvnxyXbC5yxwURk1Qx22QlvsjjNQkw97lBI6d2Em\n4TMIUYhS3qzD50Ag0TYK\n=8577\n-----END PGP SIGNATURE-----\n","payload":"tree fd3bf1c23d0c62cefd2dba27f196e720d153d349\nparent 51fc4b0559c08d12caec6f4d7d2b6a35e84c7339\nauthor mchen-oai <mchen@openai.com> 1781052599 -0700\ncommitter GitHub <noreply@github.com> 1781052599 -0700\n\nAdd spans to build_tool_router (#27094)\n\n## Why\n- Local profiling shows `append_tool_search_executor` averages ~113ms\nper call. Adding a span lets us track this cost as we optimize in\nfollow-up PRs, either by reducing the work or avoiding repeated rebuilds\nwhen inputs have not changed.\n- While we're here, we can add spans to `build_tool_router` and other\nsub-calls which code analysis shows may have additional opportunities\nfor improvement.\n\n## What changed\nAdd function-level trace spans around `build_tool_router`,\n`build_tool_specs_and_registry`, `add_tool_sources`,\n`append_tool_search_executor`, and\n`build_model_visible_specs_and_registry`\n\n## Verification\nTrigger Codex rollout and observe new spans are included","verified_at":"2026-06-10T00:50:00Z"}},"url":"https://api.github.com/repos/openai/codex/commits/5ac640ac49ae5c8b781d51bbaf0467c98cda2643","html_url":"https://github.com/openai/codex/commit/5ac640ac49ae5c8b781d51bbaf0467c98cda2643","comments_url":"https://api.github.com/repos/openai/codex/commits/5ac640ac49ae5c8b781d51bbaf0467c98cda2643/comments","author":{"login":"mchen-oai","id":250037145,"node_id":"U_kgDODudDmQ","avatar_url":"https://avatars.githubusercontent.com/u/250037145?v=4","gravatar_id":"","url":"https://api.github.com/users/mchen-oai","html_url":"https://github.com/mchen-oai","followers_url":"https://api.github.com/users/mchen-oai/followers","following_url":"https://api.github.com/users/mchen-oai/following{/other_user}","gists_url":"https://api.github.com/users/mchen-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/mchen-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mchen-oai/subscriptions","organizations_url":"https://api.github.com/users/mchen-oai/orgs","repos_url":"https://api.github.com/users/mchen-oai/repos","events_url":"https://api.github.com/users/mchen-oai/events{/privacy}","received_events_url":"https://api.github.com/users/mchen-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"51fc4b0559c08d12caec6f4d7d2b6a35e84c7339","url":"https://api.github.com/repos/openai/codex/commits/51fc4b0559c08d12caec6f4d7d2b6a35e84c7339","html_url":"https://github.com/openai/codex/commit/51fc4b0559c08d12caec6f4d7d2b6a35e84c7339"}]},{"sha":"51fc4b0559c08d12caec6f4d7d2b6a35e84c7339","node_id":"C_kwDOOYsS4doAKDUxZmM0YjA1NTljMDhkMTJjYWVjNmY0ZDdkMmI2YTM1ZTg0YzczMzk","commit":{"author":{"name":"Celia Chen","email":"celia@openai.com","date":"2026-06-09T23:49:09Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-09T23:49:09Z"},"message":"feat: use provider defaults for memory models (#27129)\n\n## Why\n\nMemory startup used hardcoded OpenAI model slugs for extraction and\nconsolidation. That works for the default OpenAI-compatible path, but\nprovider-specific backends can require different model identifiers. In\nparticular, Amazon Bedrock should use its Bedrock model ID for these\nbackground memory requests instead of the OpenAI `gpt-5.4-mini` /\n`gpt-5.4` slugs.\n\n## What Changed\n\n- Added provider-owned preferred memory model methods alongside\n`approval_review_preferred_model`.\n- Updated memory extraction and consolidation to resolve their default\nmodel through the active `ModelProvider`.\n- Added Amazon Bedrock overrides so both memory stages use\n`openai.gpt-5.4` through Bedrock’s provider-specific model ID.\n- Kept explicit `memories.extract_model` and\n`memories.consolidation_model` config overrides taking precedence.\n- Added startup coverage for default OpenAI and Bedrock memory model\nselection.\n\n#closes #26288","tree":{"sha":"226031ca08d095313d6a656cb3cdd0205ed69ece","url":"https://api.github.com/repos/openai/codex/git/trees/226031ca08d095313d6a656cb3cdd0205ed69ece"},"url":"https://api.github.com/repos/openai/codex/git/commits/51fc4b0559c08d12caec6f4d7d2b6a35e84c7339","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKKZ1CRC1aQ7uu5UhlAAAHYgQAD6jhK6TL7YSgz5JFvLf9R4w\nXE11ybZabzHliqDOOJ0uoyRI3lD51saO89CLnmOOpHBWfkdK1ZkaMHlsojqIdG+4\nbrBm4cndeMlZvBn6Liggb1sWVqok8jl+Oih6APuleTikGqzrLKhfwhnSdWxuKqww\nhMm7LByNrXxjXspAAt4lxTeyQuhKQSz4ZkH9rARx67ZCAE3htiVtWJxQz0qtY59Z\n7SbRe46TOsVs8mbT4uWPBGgotoLNI/Zk7ZSvlPap5IVahKFodAEvnmn2EK3ou2z2\ntzxSAPNiauEFcwkmuk4ktDLqy6m6CWbV+4vdOtc+U/y6Iprkesyg//gAmS97sUA+\nc9SfpJJQ2etyEME3HoQ2KTCuIXUTzROLTZXSqUN7pS4QMSnQP+OTuIV2jatP104p\n37wS4TQBCWfUTprR1u+uxD0caEvVt78vbsEIE7p2Imp/++qCUbSaIj91ZYjEQqw2\nmVs0mzFtoyuIgEbtOj4Eji2PhGRl8iD/gWbdI7jdNGF7qWzDwSOOoQkRtgu29M+K\nBkO+hMkK68NJjBHHUmyVPZiMpAsHAKkGYBIXWK/Gp/1ZUqeWSPKHSN1TXQx0Poh7\n/evQjHKCEgSgB4TnNvJ5wdiKMBTkT94jx8pkh5mVt5JnoTYHPJUnWvDRJC2R1jfo\nlAeqNMwp8A+oJtaehNwX\n=mHA3\n-----END PGP SIGNATURE-----\n","payload":"tree 226031ca08d095313d6a656cb3cdd0205ed69ece\nparent fb8f1ea0d55bb0a6202961518440b40db37b3802\nauthor Celia Chen <celia@openai.com> 1781048949 -0700\ncommitter GitHub <noreply@github.com> 1781048949 +0000\n\nfeat: use provider defaults for memory models (#27129)\n\n## Why\n\nMemory startup used hardcoded OpenAI model slugs for extraction and\nconsolidation. That works for the default OpenAI-compatible path, but\nprovider-specific backends can require different model identifiers. In\nparticular, Amazon Bedrock should use its Bedrock model ID for these\nbackground memory requests instead of the OpenAI `gpt-5.4-mini` /\n`gpt-5.4` slugs.\n\n## What Changed\n\n- Added provider-owned preferred memory model methods alongside\n`approval_review_preferred_model`.\n- Updated memory extraction and consolidation to resolve their default\nmodel through the active `ModelProvider`.\n- Added Amazon Bedrock overrides so both memory stages use\n`openai.gpt-5.4` through Bedrock’s provider-specific model ID.\n- Kept explicit `memories.extract_model` and\n`memories.consolidation_model` config overrides taking precedence.\n- Added startup coverage for default OpenAI and Bedrock memory model\nselection.\n\n#closes #26288","verified_at":"2026-06-09T23:49:09Z"}},"url":"https://api.github.com/repos/openai/codex/commits/51fc4b0559c08d12caec6f4d7d2b6a35e84c7339","html_url":"https://github.com/openai/codex/commit/51fc4b0559c08d12caec6f4d7d2b6a35e84c7339","comments_url":"https://api.github.com/repos/openai/codex/commits/51fc4b0559c08d12caec6f4d7d2b6a35e84c7339/comments","author":{"login":"celia-oai","id":209693228,"node_id":"U_kgDODH-qLA","avatar_url":"https://avatars.githubusercontent.com/u/209693228?v=4","gravatar_id":"","url":"https://api.github.com/users/celia-oai","html_url":"https://github.com/celia-oai","followers_url":"https://api.github.com/users/celia-oai/followers","following_url":"https://api.github.com/users/celia-oai/following{/other_user}","gists_url":"https://api.github.com/users/celia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/celia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celia-oai/subscriptions","organizations_url":"https://api.github.com/users/celia-oai/orgs","repos_url":"https://api.github.com/users/celia-oai/repos","events_url":"https://api.github.com/users/celia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/celia-oai/received_e