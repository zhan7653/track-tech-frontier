yo-ku, Kyoto, Japan"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-0678-1103","authenticated-orcid":false,"given":"Akira","family":"Taniguchi","sequence":"additional","affiliation":[{"name":"Ritsumeikan University, Nojihigashi, Kusatsu, Shiga, Japan"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-5682-2076","authenticated-orcid":false,"given":"Tadahiro","family":"Taniguchi","sequence":"additional","affiliation":[{"name":"Ritsumeikan University, Nojihigashi, Kusatsu, Shiga, Japan"}],"role":[{"role":"author","vocabulary":"crossref"}]}],"URL":"https:\/\/doi.org\/10.1109\/access.2026.3666234","published-print":{"date-parts":[[2026]]},"issued":{"date-parts":[[2026]]},"container-title":["IEEE Access"]},{"DOI":"10.1109\/access.2026.3655024","title":["Sensorless Collaborative Impedance Control of Rehabilitation Robots via LQR and Model-Based Sliding Manifold"],"author":[{"ORCID":"https:\/\/orcid.org\/0000-0002-4486-0710","authenticated-orcid":false,"given":"Brahim","family":"Brahmi","sequence":"first","affiliation":[{"name":"Electrical Engineering Department, King Fahd University of Petroleum and Minerals, Dhahran, Saudi Arabia"}],"role":[{"role":"author","vocabulary":"crossref"}]}],"URL":"https:\/\/doi.org\/10.1109\/access.2026.3655024","published-print":{"date-parts":[[2026]]},"issued":{"date-parts":[[2026]]},"container-title":["IEEE Access"]},{"DOI":"10.2139\/ssrn.5204283","title":["Securing Ai Agents: Implementing Role-Based Access Control for Industrial Applications"],"author":[{"given":"Aadil  Gani","family":"Ganie","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.2139\/ssrn.5204283","issued":{"date-parts":[[2025]]}},{"DOI":"10.1109\/access.2025.3551883","title":["Online Learning Agents for Group Cooperative Control Systems"],"author":[{"ORCID":"https:\/\/orcid.org\/0009-0002-8546-2222","authenticated-orcid":false,"given":"Ping","family":"Wang","sequence":"first","affiliation":[{"name":"College of Mechanical and Electrical Engineering, Hefei Technology College, Hefei, China"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Min","family":"Gao","sequence":"additional","affiliation":[{"name":"College of Mechanical and Electrical Engineering, Hefei Technology College, Hefei, China"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-3057-0448","authenticated-orcid":false,"given":"Junyu","family":"Li","sequence":"additional","affiliation":[{"name":"College of Mechanical and Electrical Engineering, Hefei Technology College, Hefei, China"}],"role":[{"role":"author","vocabulary":"crossref"}]}],"URL":"https:\/\/doi.org\/10.1109\/access.2025.3551883","published-print":{"date-parts":[[2025]]},"issued":{"date-parts":[[2025]]},"container-title":["IEEE Access"]},{"DOI":"10.21203\/rs.3.rs-4413100\/v1","title":["Blockchain-based Access Control Protocol with collaborative authentication"],"author":[{"given":"Limian","family":"Ci","sequence":"first","affiliation":[{"name":"Curtin University"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Liyuan","family":"Zhang","sequence":"additional","affiliation":[{"name":"Curtin University"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Yonghong","family":"Wu","sequence":"additional","affiliation":[{"name":"Curtin University"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Benchawan","family":"Wiwatanapataphee","sequence":"additional","affiliation":[{"name":"Curtin University"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.21203\/rs.3.rs-4413100\/v1","issued":{"date-parts":[[2024,6,17]]},"abstract":"<title>Abstract<\/title>\n        <p>In a complex and globalized business environment, cross-organizational cooperation has become increasingly important for enterprises, due to the growing need for information sharing. However, traditional access control models have limitations in the scenarios of cross-organizational cooperation scenarios without central leadership. To address these challenges, this paper proposes a decentralized access control framework with identity verification based on the blockchain technology and zero-knowledge proof. The access control protocol in the proposed access control framework integrates the role-based access control with the attribute-based access control, enabling our model to achieve more granular access control while requiring low computing resources. We implement the proposed access control protocol using smart contracts and apply it in a supply chain scenario to verify its feasibility. In addition, we analyze and evaluate the proposed protocol in terms of cost, running time, security and flexibility. For the limitation of no administrator rights brought by complete decentralization, we propose to use governance protocols to achieve high flexibility and scalability while maintaining the complete decentralization of the proposed framework.<\/p>"},{"DOI":"10.1109\/access.2024.3409348","title":["A Markov Jump System-Based Mathematical Modeling Method for Collaborative Control of Unmanned Vehicles"],"author":[{"ORCID":"https:\/\/orcid.org\/0009-0005-0320-9875","authenticated-orcid":false,"given":"Hui","family":"Bian","sequence":"first","affiliation":[{"name":"Basic Teaching Department, Henan Institute of Foreign Economic Relations and Trade, Kaifeng, Henan, China"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Ping","family":"Hao","sequence":"additional","affiliation":[{"name":"College of Mechanical and Electrical Engineering, Henan Vocational College of Applied Technology, Zhengzhou, Henan, China"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/access.2024.3409348","published-print":{"date-parts":[[2024]]},"issued":{"date-parts":[[2024]]},"container-title":["IEEE Access"]},{"DOI":"10.1109\/access.2023.3312021","title":["A Collaborative Control Scheme for Smart Vehicles Based on Multi-Agent Deep Reinforcement Learning"],"author":[{"ORCID":"https:\/\/orcid.org\/0009-0000-9254-1223","authenticated-orcid":false,"given":"Liyan","family":"Shi","sequence":"first","affiliation":[{"name":"School of Information Engineering and Artificial Intelligence, The Open University of Henan, Zhengzhou, China"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Hairui","family":"Chen","sequence":"additional","affiliation":[{"name":"Zhongyuan-Petersburg Aviation College, Zhongyuan University of Technology, Zhengzhou, China"}],"role":[{"role":"author","vocabulary":"crossref"}]}],"URL":"https:\/\/doi.org\/10.1109\/access.2023.3312021","published-print":{"date-parts":[[2023]]},"issued":{"date-parts":[[2023]]},"container-title":["IEEE Access"]},{"DOI":"10.1109\/access.2025.3645897","title":["Collaborative Control of Robot Joints With PAM-Motor Dual-Source Coupled Actuation"],"author":[{"ORCID":"https:\/\/orcid.org\/0009-0001-9432-5986","authenticated-orcid":false,"given":"Huilan","family":"Li","sequence":"first","affiliation":[{"name":"College of Traffic and Transportation, Chongqing Jiaotong University, Chongqing, China"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Xiaolan","family":"Yu","sequence":"additional","affiliation":[{"name":"Chongqing City Vocational College, College of New Energy Vehicle Engineering, Chongqing, China"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Xiangyang","family":"Xu","sequence":"additional","affiliation":[{"name":"College of Traffic and Transportation, Chongqing Jiaotong University, Chongqing, China"}],"role":[{"role":"author","vocabulary":"crossref"}]}],"URL":"https:\/\/doi.org\/10.1109\/access.2025.3645897","published-print":{"date-parts":[[2025]]},"issued":{"date-parts":[[2025]]},"container-title":["IEEE Access"]},{"DOI":"10.1109\/access.2026.3713401","title":["Self-Evolving AI Agents With Dual Memory for Automated Software Testing and Bug Localization"],"author":[{"ORCID":"https:\/\/orcid.org\/0009-0002-5524-6078","authenticated-orcid":false,"given":"Tianjun","family":"Mo","sequence":"first","affiliation":[{"name":"Duke University","place":["Durham, NC, USA"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0009-0001-5820-6234","authenticated-orcid":false,"given":"Changhao","family":"Zhang","sequence":"additional","affiliation":[{"name":"The University of Chicago","place":["Chicago, IL, USA"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Jitong","family":"Zou","sequence":"additional","affiliation":[{"name":"Case Western Reserve University","place":["Cleveland, OH, USA"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0009-0008-2463-5330","authenticated-orcid":false,"given":"Zixuan","family":"Guo","sequence":"additional","affiliation":[{"name":"New York University","place":["New York, NY, USA"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0009-0006-7583-7819","authenticated-orcid":false,"given":"Minjae","family":"Rhee","sequence":"additional","affiliation":[{"name":"University of Illinois Urbana\u2013Champaign","place":["Champaign, IL, USA"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/access.2026.3713401","published-print":{"date-parts":[[2026]]},"issued":{"date-parts":[[2026]]},"container-title":["IEEE Access"]},{"DOI":"10.36227\/techrxiv.177075184.43798334\/v1","title":["The Synergistic Integration of Access Control Management and Large Language Model Agents: A Survey"],"author":[{"ORCID":"https:\/\/orcid.org\/0000-0001-8388-2317","authenticated-orcid":false,"given":"Francesco","family":"Periti","sequence":"first","affiliation":[{"name":"KU Leuven -Flanders Make"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Soumadeep","family":"Saha","sequence":"additional","affiliation":[{"name":"IRIT"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.36227\/techrxiv.177075184.43798334\/v1","issued":{"date-parts":[[2026,2,10]]},"abstract":"<jats:p>Access Control Management (ACM) is a fundamental security measure of information systems, governing which resources a user can access and under what conditions. Typically, effective ACM requires significant manual effort for policy specification, enforcement, and maintenance. To alleviate this burden, prior research has explored automating ACM by integrating machine learning solutions. However, the emergence of Large Language Models (LLMs) and, more recently, LLM agents has opened up many new challenges and opportunities for information systems. Although a plethora of studies currently focus on LLM security, they primarily address adversarial threats, leaving the specific implications for ACM largely underexplored. In this article, we address this gap by surveying the synergistic integration of ACM and LLM agents from a twofold perspective: agents for ACM, where agents assist security administrators in automating the management of access control; and ACM for agents, where access control principles are applied to regulate the behavior, permissions, and security boundaries of the agents themselves. Through these two lenses, we disentangle and define three core ACM tasks, which are receiving increasing attention but are not yet clearly defined in the literature: access control policy generation, decision-making, and enforcement. Furthermore, we conceptualize agents as three core components of standard access-control models: agents as Subjects, Objects, and Actions. To survey existing solutions, we formalize the interaction flow between users and agents and categorize four restriction mechanisms for ACM: user authentication, agent customization, LLM customization, and tools. Building on these mechanisms, we provide a critical analysis of the state-of-the-art, and finally outline open challenges and future research directions to foster stronger cohesion between ACM and LLM agents.<\/jats:p>"},{"DOI":"10.1109\/access.2025.3532172","title":["Virtual Agents-Based Attack-Resilient Distributed Control for Islanded AC Microgrid"],"author":[{"ORCID":"https:\/\/orcid.org\/0009-0006-0646-3761","authenticated-orcid":false,"given":"Jun","family":"Zhang","sequence":"first","affiliation":[{"name":"McComish Department of Electrical Engineering and Computer Science, South Dakota State University, Brookings, SD, USA"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-0815-3928","authenticated-orcid":false,"given":"Sheik M.","family":"Mohiuddin","sequence":"additional","affiliation":[{"name":"Energy and Environment Directorate, Pacific Northwest National Laboratory, Richland, WA, USA"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-4043-9427","authenticated-orcid":false,"given":"Junjian","family":"Qi","sequence":"additional","affiliation":[{"name":"McComish Department of Electrical Engineering and Computer Science, South Dakota State University, Brookings, SD, USA"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/access.2025.3532172","published-print":{"date-parts":[[2025]]},"issued":{"date-parts":[[2025]]},"container-title":["IEEE Access"]},{"DOI":"10.1109\/access.2023.3268752","title":["Collaborative Optimization Control of Torque Unloading and Loading for a Dual-Motor Coupling Drive System"],"author":[{"ORCID":"https:\/\/orcid.org\/0009-0004-4724-6013","authenticated-orcid":false,"given":"Ruhui","family":"Zhang","sequence":"first","affiliation":[{"name":"National Engineering Laboratory for Electric Vehicle, Beijing Institute of Technology, Beijing, China"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Jiang","family":"Yi","sequence":"additional","affiliation":[{"name":"National Engineering Laboratory for Electric Vehicle, Beijing Institute of Technology, Beijing, China"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-7306-1512","authenticated-orcid":false,"given":"Cheng","family":"Lin","sequence":"additional","affiliation":[{"name":"National Engineering Laboratory for Electric Vehicle, Beijing Institute of Technology, Beijing, China"}],"role":[{"role":"author","vocabulary":"crossref"}]}],"URL":"https:\/\/doi.org\/10.1109\/access.2023.3268752","published-print":{"date-parts":[[2023]]},"issued":{"date-parts":[[2023]]},"container-title":["IEEE Access"]},{"DOI":"10.2139\/ssrn.7305358","title":["Identity and Access Control for Autonomous AI Agents: Dual-Principal Authorization in Enterprise Settings"],"author":[{"ORCID":"https:\/\/orcid.org\/0009-0008-0670-5614","authenticated-orcid":true,"given":"Leela Sai Krishna","family":"Udiga","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.2139\/ssrn.7305358","issued":{"date-parts":[[2026]]},"abstract":"<jats:p>Autonomous and semi-autonomous software agents now call tools, change records, and coordinate with other agents at machine speed. Identity and access management (IAM) in most enterprises still treats those agents as either human users with a session or as long-lived machine accounts with a shared secret. Neither treatment answers the questions that matter after an incident: which agent instance acted, on whose authority, for what task, and how that authority can be withdrawn without disabling the human. This working paper examines that gap as a problem of authorization design rather than of model safety alone. Drawing on existing protocol families (OAuth and OpenID Connect, SPIFFE, SCIM) and on recent industry and consortium writing on agent identity, I argue that privileged agent action should satisfy two principals at once: the agent as actor and the human or system as subject. Grants should also be bound to a declared purpose, a specific audience, and a short lifetime. I then set out a six-part control-plane reading of the same problem (identity, delegation, policy, enforcement, evidence, and lifecycle) and discuss how the combination behaves in common enterprise patterns, including user-delegated copilots, headless workers, tool gateways, and multi-agent chains. The paper is conceptual. It does not report a controlled experiment. Its contribution is a compact authorization rule, a mapping onto standards that organizations already run, and a statement of limits: identity controls cannot correct a purpose that was written too widely. \n&lt;br&gt;\n&lt;br&gt;&lt;span&gt;AI disclosure: Generative writing tools were used for language editing, section organization, and typesetting of this working paper. The author reviewed the text, is responsible for the argument, and does not list any tool as a co-author.&lt;\/span&gt;<\/jats:p>"},{"DOI":"10.1109\/asp-dac58780.2024.10473837","title":["Collaborative Coalescing of Redundant Memory Access for GPU System"],"author":[{"given":"Fan","family":"Jiang","sequence":"first","affiliation":[{"name":"The Hong Kong University of Science and Technology,Department of Electronic and Computer Engineering"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Chengeng","family":"Li","sequence":"additional","affiliation":[{"name":"The Hong Kong University of Science and Technology,Department of Electronic and Computer Engineering"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Wei","family":"Zhang","sequence":"additional","affiliation":[{"name":"The Hong Kong University of Science and Technology,Department of Electronic and Computer Engineering"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Jiang","family":"Xu","sequence":"additional","affiliation":[{"name":"The Hong Kong University of Science and Technology,Department of Electronic and Computer Engineering"}],"role":[{"role":"author","vocabulary":"crossref"}]}],"URL":"https:\/\/doi.org\/10.1109\/asp-dac58780.2024.10473837","published-print":{"date-parts":[[2024,1,22]]},"issued":{"date-parts":[[2024,1,22]]},"container-title":["2024 29th Asia and South Pacific Design Automation Conference (ASP-DAC)"]},{"DOI":"10.1109\/access.2024.3475584","title":["Distributed Control for Collaborative Robotic Systems Using 5G Edge Computing"],"author":[{"ORCID":"https:\/\/orcid.org\/0000-0002-1591-5196","authenticated-orcid":false,"given":"Dominik","family":"Urbaniak","sequence":"first","affiliation":[{"name":"Institute of Industrial and Control Engineering, Universitat Polit&#x00E8;cnica de Catalunya, Barcelona, Spain"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-0078-8673","authenticated-orcid":false,"given":"Sebastian","family":"Bro Damsgaard","sequence":"additional","affiliation":[{"name":"Department of Electronic Systems, Aalborg University, Aalborg, Denmark"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-5368-005X","authenticated-orcid":false,"given":"Weifan","family":"Zhang","sequence":"additional","affiliation":[{"name":"Department of Electronic Systems, Aalborg University, Aalborg, Denmark"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-4854-2370","authenticated-orcid":false,"given":"Jan","family":"Rosell","sequence":"additional","affiliation":[{"name":"Institute of Industrial and Control Engineering, Universitat Polit&#x00E8;cnica de Catalunya, Barcelona, Spain"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-3853-7095","authenticated-orcid":false,"given":"Ra\u00fal","family":"Su\u00e1rez","sequence":"additional","affiliation":[{"name":"Institute of Industrial and Control Engineering, Universitat Polit&#x00E8;cnica de Catalunya, Barcelona, Spain"}],"role":[{"vocabulary":"crossref","role":"author"}]},{