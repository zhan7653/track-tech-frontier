.com/openai/openai-agents-python/commit/69276223319ebb8e5cd3234683bc49b5ce4f6092","comments_url":"https://api.github.com/repos/openai/openai-agents-python/commits/69276223319ebb8e5cd3234683bc49b5ce4f6092/comments","author":{"login":"mshsheikh","id":160324527,"node_id":"U_kgDOCY5brw","avatar_url":"https://avatars.githubusercontent.com/u/160324527?v=4","gravatar_id":"","url":"https://api.github.com/users/mshsheikh","html_url":"https://github.com/mshsheikh","followers_url":"https://api.github.com/users/mshsheikh/followers","following_url":"https://api.github.com/users/mshsheikh/following{/other_user}","gists_url":"https://api.github.com/users/mshsheikh/gists{/gist_id}","starred_url":"https://api.github.com/users/mshsheikh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mshsheikh/subscriptions","organizations_url":"https://api.github.com/users/mshsheikh/orgs","repos_url":"https://api.github.com/users/mshsheikh/repos","events_url":"https://api.github.com/users/mshsheikh/events{/privacy}","received_events_url":"https://api.github.com/users/mshsheikh/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"8eaa4b98722882421b6ea13f20fbc06bbb7149e1","url":"https://api.github.com/repos/openai/openai-agents-python/commits/8eaa4b98722882421b6ea13f20fbc06bbb7149e1","html_url":"https://github.com/openai/openai-agents-python/commit/8eaa4b98722882421b6ea13f20fbc06bbb7149e1"}]},{"sha":"8eaa4b98722882421b6ea13f20fbc06bbb7149e1","node_id":"C_kwDOOGidp9oAKDhlYWE0Yjk4NzIyODgyNDIxYjZlYTEzZjIwZmJjMDZiYmI3MTQ5ZTE","commit":{"author":{"name":"qiyaoq-oai","email":"qiyaoq@openai.com","date":"2026-06-05T17:53:06Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-05T17:53:06Z"},"message":"fix: expose sandbox error retryability (#3581)\n\nContext: https://github.com/temporalio/sdk-python/issues/1548\n\nThis pull request adds provider-neutral retryability metadata for\nsandbox failures.\n\n- Adds `SandboxError.retryable` with `True`, `False`, and `None` for\nunknown classification.\n- Propagates retryability through wrapped sandbox errors.\n- Emits retryability in sandbox finish events and trace error payloads.\n- Classifies clear terminal/transient cases across sandbox providers\nwithout exposing provider internals to integrations.\n- Adds focused tests for core error behavior, provider classifiers, and\nobservability.","tree":{"sha":"bd83448ccb0352f9593388e88b383eeafd4aacb7","url":"https://api.github.com/repos/openai/openai-agents-python/git/trees/bd83448ccb0352f9593388e88b383eeafd4aacb7"},"url":"https://api.github.com/repos/openai/openai-agents-python/git/commits/8eaa4b98722882421b6ea13f20fbc06bbb7149e1","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqIw0CCRC1aQ7uu5UhlAAA+hMQAK03iWxwhVNyhyNluix6L/UX\nLXuT2/aGWUQFTrO9jcxAjswgUZNwIw/Hl3ViImKMpxMFGiUzl8PLnaqMJWwo1AB5\ncSHgm+VuKPVk+/GJYrb71xXRYO15n9au/fdEgUJeERYCKnCJlCQlfV3P2mEodnd4\neybi0XkN/7BSMVkCwcFL57LyJXs2PjhkGbt/DR5uH6herCCoZwnirepJKQ5exFAH\nFrtov12Y3KdC3hFPizeOOahWMOMBT1a/+QkleFbDRQHHk1Ofn1gqzO8roNbwlSdF\neAhuAOONFLnFxHS7JYkhSczF0zbbSn6vYAUWq3+tKR/Xws8s07QclTA91WDOAiyQ\nBQMrR1J0tFa20B/puTnGAeEzqxQ7XFHQ4h9fBQojZ3T1PjsgEQLA7B8+Y8pKKgGb\n0dYZFa/MIGemqZIFE169E/MBoDqFEBx0tnu0rDSnvrzkgXnYMF57AcTgm6FcmsiF\nU2nUmRGZUnbrKpsCS1OoauMsnjnrm1mM5PAHaNsyUKGKTumbBlKTUPQLcgev2juD\nqAGUCLlyQFAT/wwGGr2olefTyGZbsSXhSG35FqrRAV7494Q5zC++N8Z6hJzvoe64\nc4xeq3fRapPNfSPvVL1zsuBG8qnypNPZHlBPhkCvvBaTUPqByzZWmZqETawQaH8Z\nFCzaOyOErOKX9iBQY9Qj\n=AcSS\n-----END PGP SIGNATURE-----\n","payload":"tree bd83448ccb0352f9593388e88b383eeafd4aacb7\nparent 5121f302a5d43fa20c9f78966e4db6f08f724622\nauthor qiyaoq-oai <qiyaoq@openai.com> 1780681986 -0700\ncommitter GitHub <noreply@github.com> 1780681986 -0700\n\nfix: expose sandbox error retryability (#3581)\n\nContext: https://github.com/temporalio/sdk-python/issues/1548\n\nThis pull request adds provider-neutral retryability metadata for\nsandbox failures.\n\n- Adds `SandboxError.retryable` with `True`, `False`, and `None` for\nunknown classification.\n- Propagates retryability through wrapped sandbox errors.\n- Emits retryability in sandbox finish events and trace error payloads.\n- Classifies clear terminal/transient cases across sandbox providers\nwithout exposing provider internals to integrations.\n- Adds focused tests for core error behavior, provider classifiers, and\nobservability.","verified_at":"2026-06-05T17:53:06Z"}},"url":"https://api.github.com/repos/openai/openai-agents-python/commits/8eaa4b98722882421b6ea13f20fbc06bbb7149e1","html_url":"https://github.com/openai/openai-agents-python/commit/8eaa4b98722882421b6ea13f20fbc06bbb7149e1","comments_url":"https://api.github.com/repos/openai/openai-agents-python/commits/8eaa4b98722882421b6ea13f20fbc06bbb7149e1/comments","author":{"login":"qiyaoq-oai","id":250022312,"node_id":"U_kgDODucJqA","avatar_url":"https://avatars.githubusercontent.com/u/250022312?v=4","gravatar_id":"","url":"https://api.github.