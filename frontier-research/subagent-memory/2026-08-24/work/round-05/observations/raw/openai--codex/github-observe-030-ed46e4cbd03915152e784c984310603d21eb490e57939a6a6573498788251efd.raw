er}","gists_url":"https://api.github.com/users/vivi/gists{/gist_id}","starred_url":"https://api.github.com/users/vivi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vivi/subscriptions","organizations_url":"https://api.github.com/users/vivi/orgs","repos_url":"https://api.github.com/users/vivi/repos","events_url":"https://api.github.com/users/vivi/events{/privacy}","received_events_url":"https://api.github.com/users/vivi/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"8b759b9c18f10b3842b8be4d371ce1c8414959eb","url":"https://api.github.com/repos/openai/codex/commits/8b759b9c18f10b3842b8be4d371ce1c8414959eb","html_url":"https://github.com/openai/codex/commit/8b759b9c18f10b3842b8be4d371ce1c8414959eb"}]},{"sha":"8b759b9c18f10b3842b8be4d371ce1c8414959eb","node_id":"C_kwDOOYsS4doAKDhiNzU5YjljMThmMTBiMzg0MmI4YmU0ZDM3MWNlMWM4NDE0OTU5ZWI","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-06-01T16:49:55Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-01T16:49:55Z"},"message":"Disable SQLite intrinsics for Windows x64 releases (#25490)\n\n## Why\n\nCodex 0.135.0 started shipping bundled SQLite 3.51.x via SQLx 0.9.0 to\navoid the older WAL corruption bug fixed by #24728. On Windows x64,\n#25367 reports an immediate `STATUS_ILLEGAL_INSTRUCTION` crash on a\nHaswell CPU when starting normal Codex paths.\n\nRather than downgrading SQLite, this keeps the newer bundled SQLite\nsource and removes SQLite compiler-intrinsic code paths from the Windows\nx64 release build.\n\n## What changed\n\nFor `x86_64-pc-windows-msvc` release builds, export\n`LIBSQLITE3_FLAGS=SQLITE_DISABLE_INTRINSIC` before `cargo build` in:\n\n- `.github/workflows/rust-release.yml`\n- `.github/workflows/rust-release-windows.yml`\n\nOther targets keep their current SQLite build flags.\n\n## Verification\n\n- `git diff --check`","tree":{"sha":"c823e7d90624c4313cb996f8a3d786a0d475d247","url":"https://api.github.com/repos/openai/codex/git/trees/c823e7d90624c4313cb996f8a3d786a0d475d247"},"url":"https://api.github.com/repos/openai/codex/git/commits/8b759b9c18f10b3842b8be4d371ce1c8414959eb","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqHbgzCRC1aQ7uu5UhlAAA3BAQAGC2gm2PaXNZBISM+cMl6tla\nshBFlUJI8YtOItKLXi8CqYEUZjGEJ0d1RU7pqUfxGILtL4YgF+X9P5Ka2FGWv4aH\nqjjmtw+Lpg3p6y94VVgZw+f3UhEWKaEPOLcVZdbr+wLprdOAABkDr3p8aAJQegfa\nWVFCeyCOAegfPtBoGs+8VwuQaNBKmHNsDqRH2w0YZbG4ovkVxkR8Xj4xbQ/6n53b\nUsW9oZtmAVNr01sD6nlkf26p42kWEt7wsM/+AaP1aPEXqH8xo+NYkWG7i1ec+HJh\nfWSGWaMlKEHi/fVqiHV+Q73Km0hC6QDVhBQXOZKgfrYEuxAvL1yAM9e2Y/S0HOL1\nHu8BsF+S42HCsWG0H51LaeDz8vhAQyMrw+ywHQTwBdY5eHkd7XVUEbJQMEcBx0l3\nY+CV/aI0QXvjhPQrWpKYaFUIwFytNOPqAkIrKiyxuyD/kRimF9/TRwmxeChpzAIt\n/2WqUucvMb/dB28MhKHMaV7coptt+Ndyg6QEXXAuuEf2+KDW9vzfsgk4y2xz2PeK\nG84z3dW+LLDpdmB0R1U03s84ChXArJHqhAPhtPurMqjQU4QTC2/fnWmAuXSHL4Mb\nNxfYgkteT/Vf7msvj2EF4haiIe7ApTJxbeTSyoYMYYB75BRH+5Motml8SBMNA+BQ\nrFt63AZq3EaMirpbXcBK\n=Lu2Y\n-----END PGP SIGNATURE-----\n","payload":"tree c823e7d90624c4313cb996f8a3d786a0d475d247\nparent 01cb97851b1634d33b9bbb8e184111611c39b7b5\nauthor Eric Traut <etraut@openai.com> 1780332595 -0700\ncommitter GitHub <noreply@github.com> 1780332595 -0700\n\nDisable SQLite intrinsics for Windows x64 releases (#25490)\n\n## Why\n\nCodex 0.135.0 started shipping bundled SQLite 3.51.x via SQLx 0.9.0 to\navoid the older WAL corruption bug fixed by #24728. On Windows x64,\n#25367 reports an immediate `STATUS_ILLEGAL_INSTRUCTION` crash on a\nHaswell CPU when starting normal Codex paths.\n\nRather than downgrading SQLite, this keeps the newer bundled SQLite\nsource and removes SQLite compiler-intrinsic code paths from the Windows\nx64 release build.\n\n## What changed\n\nFor `x86_64-pc-windows-msvc` release builds, export\n`LIBSQLITE3_FLAGS=SQLITE_DISABLE_INTRINSIC` before `cargo build` in:\n\n- `.github/workflows/rust-release.yml`\n- `.github/workflows/rust-release-windows.yml`\n\nOther targets keep their current SQLite build flags.\n\n## Verification\n\n- `git diff --check`","verified_at":"2026-06-01T16:49:55Z"}},"url":"https://api.github.com/repos/openai/codex/commits/8b759b9c18f10b3842b8be4d371ce1c8414959eb","html_url":"https://github.com/openai/codex/commit/8b759b9c18f10b3842b8be4d371ce1c8414959eb","comments_url":"https://api.github.com/repos/openai/codex/commits/8b759b9c18f10b3842b8be4d371ce1c8414959eb/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"01cb97851b1634d33b9bbb8e184111611c39b7b5","url":"https://api.github.com/repos/openai/codex/commits/01cb97851b1634d33b9bbb8e184111611c39b7b5","html_url":"https://github.com/openai/codex/commit/01cb97851b1634d33b9bbb8e184111611c39b7b5"}]},{"sha":"01cb97851b1634d33b9bbb8e184111611c39b7b5","node_id":"C_kwDOOYsS4doAKDAxY2I5Nzg1MWIxNjM0ZDMzYjliYmI4ZTE4NDExMTYxMWMzOWI3YjU","commit":{"author":{"name":"jif-oai","email":"jif@openai.com","date":"2026-06-01T16:35:58Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-01T16:35:58Z"},"message":"Compress cold local rollouts (#25089)\n\n## Rollout compression stack\n\nThis stack splits #24941 into reviewable steps for local rollout\ncompression. The design is intentionally staged:\n\n1. Teach readers, listing, search, and lookup to understand compressed\nrollouts.\n2. Make append and resume paths materialize compressed rollouts back to\nplain JSONL before writing.\n3. Add a disabled-by-default worker that can compress cold archived\nrollouts behind `local_thread_store_compression`.\n\nThe key invariant is that writers append to plain `.jsonl`. A\n`.jsonl.zst` file is a cold/read representation; if a write is needed,\nthe compressed file is materialized back to plain JSONL first. Readers\nprefer plain `.jsonl` when both forms exist and can fall back to the\ncompressed sibling during transitions.\n\nThe worker is deliberately the last PR and remains behind an\nunder-development feature flag. It currently scans only\n`archived_sessions`, not active `sessions`, because active sessions have\nthe highest resume/append race risk. That means this stack does not yet\ncompress most unarchived local history.\n\n## Known race / follow-up\n\nThe remaining unresolved design question is writer/compressor\ncoordination. Even for archived rollouts, a resume or metadata update\ncan append while the worker is replacing the plain file with\n`.jsonl.zst`; the current double-stat checks narrow but do not fully\neliminate the window where a writer has opened the plain file before\nunlink. Do not treat the worker PR as production-ready until we either:\n\n- prevent append/resume paths from racing archived compression, or\n- introduce a shared representation/append lock or equivalent\ncoordination.\n\nThe first two PRs are useful independently: they make compressed\nrollouts readable and make append paths safely recover back to plain\nJSONL. The third PR isolates the worker behavior so that coordination\nissue is reviewable separately.\n\n## Validation\n\nFocused local validation for the stack includes:\n\n- `just test -p codex-rollout`\n- `just test -p codex-thread-store` where thread-store paths were\ntouched\n- `just test -p codex-features` for the feature flag slice\n- `just bazel-lock-check` after dependency graph changes\n- scoped `just fix -p ...` passes for changed crates\n\nCI is still the source of truth for the full platform matrix.\n\n## This PR in the stack\n\nThis is PR 3/3, based on #25088. It adds the under-development feature\nflag and starts the best-effort background worker when enabled. The\nworker currently compresses only cold archived rollouts, skips active\nsessions, verifies compressed output, preserves mtime and permissions,\nkeeps a store-level lock heartbeat, and cleans stale temp files.\n\nStack order:\n\n1. #25087: read compressed local rollouts.\n2. #25088: materialize compressed rollouts before append.\n3. This PR: add the disabled local compression worker.","tree":{"sha":"efdfa8d5ac53255d56c95cf73197372ce6a38353","url":"https://api.github.com/repos/openai/codex/git/trees/efdfa8d5ac53255d56c95cf73197372ce6a38353"},"url":"https://api.github.com/repos/openai/codex/git/commits/01cb97851b1634d33b9bbb8e184111611c39b7b5","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqHbTuCRC1aQ7uu5UhlAAAxTgQADcAl9Op8sw9+8dd4w1i+EZ+\n084lKGEsVug9c6DG0kkYuIpNj6V/BFcEGjulrc0rYpnSxbw2gCPg0mDCjx/8mPoq\nbfIj5pXDH8k3G0hkR7/0C76+alijpPn6bdUemI5dUpK7mLbxfg1tzeAvzZszq23e\nbn/oX2wb5WwqLPhrUSG8Gxm8IsBct5MdEJhTzlHdseRxU2NTVIfF9XEaO4G+gQZu\nX25kCs428Q5gcBFYEjncGeC5VKhaVXROPMVcMTObdNAzA5MYnPfMNT4VjiOpeyQu\n8FRtarP72wdaIFALYkAF2lKBeLrSvyQXrCWIGINvgT2yoOTD+a4Y+5hhw2LodZ68\nJplXJFnTjQ3vD+HH5w4u2h45a7dou/xeqComIV8WldXQ6YT/Qr127ckI4ZhAd8EH\nZBouLUxudOZwL2TQOtXjlCt+B77wky0jCBHtbrlkwj+POaInvDza+n8Lui2yDQIo\ni7SYjW+6e9Usk1hpOhXVSxuAyE4dUquQCVPTIMqtxNLHxnrccYzK1L2F0NABBuAS\nAjz4d40A8bEGZOAET1+w9O0IDH9qEzgGxkikKKNWRdIYv4fzE2WC/bfoE1CqOmOK\naxQEq3QE9SbAcsE2yRGY/BuT3C++JQh0q6RmFMJw9PIyskJmb0XzNik76GCBwl8t\nSwhTOaQmBZa2aoh1gEfL\n=L1a2\n-----END PGP SIGNATURE-----\n","payload":"tree efdfa8d5ac53255d56c95cf73197372ce6a38353\nparent 3cdce5286591fc96e4336d130f71eda11da17382\nauthor jif-oai <jif@openai.com> 1780331758 +0200\ncommitter GitHub <noreply@github.com> 1780331758 +0200\n\nCompress cold local rollouts (#25089)\n\n## Rollout compression stack\n\nThis stack splits #24941 into reviewable steps for local rollout\ncompression. The design is intentionally staged:\n\n1. Teach readers, listing, search, and lookup to understand compressed\nrollouts.\n2. Make append and resume paths materialize compressed rollouts back to\nplain JSONL before writing.\n3. Add a disabled-by-default worker that can compress cold archived\nrollouts behind `local_thread_store_compression`.\n\nThe key invariant is that writers append to plain `.jsonl`. A\n`.jsonl.zst` file is a cold/read representation; if a write is needed,\nthe compressed file is materialized back to plain JSONL first. Readers\nprefer plain `.jsonl` when both forms exist and can fall back to the\ncompressed sibling during transitions.\n\nThe worker is deliberately the last PR and remains behind an\nunder-development feature flag. It currently scans only\n`archived_sessions`, not active `sessions`, because active sessions have\nthe highest resume/append race risk. That means this stack does not yet\ncompress most unarchived local history.\n\n## Known race / follow-up\n\nThe remaining unresolved design question is writer/compressor\ncoordination. Even for archived rollouts, a resume or metadata update\ncan append while the worker is replacing the plain file with\n`.jsonl.zst`; the current double-stat checks narrow but do not fully\neliminate the window where a writer has opened the plain file before\nunlink. Do not treat the worker PR as production-ready until we either:\n\n- prevent append/resume paths from racing archived compression, or\n- introduce a shared representation/append lock or equivalent\ncoordination.\n\nThe first two PRs are useful independently: they make compressed\nrollouts readable and make append paths safely recover back to plain\nJSONL. The third PR isolates the worker behavior so that coordination\nissue is reviewable separately.\n\n## Validation\n\nFocused local validation for the stack includes:\n\n- `just test -p codex-rollout`\n- `just test -p codex-thread-store` where thread-store paths were\ntouched\n- `just test -p codex-features` for the feature flag slice\n- `just bazel-lock-check` after dependency graph changes\n- scoped `just fix -p ...` passes for changed crates\n\nCI is still the source of truth for the full platform matrix.\n\n## This PR in the stack\n\nThis is PR 3/3, based on #25088. It adds the under-development feature\nflag and starts the best-effort background worker when enabled. The\nworker currently compresses only cold archived rollouts, skips active\nsessions, verifies compressed output, preserves mtime and permissions,\nkeeps a store-level lock heartbeat, and cleans stale temp files.\n\nStack order:\n\n1. #25087: read compressed local rollouts.\n2. #25088: materialize compressed rollouts before append.\n3. This PR: add the disabled local compression worker.","verified_at":"2026-06-01T16:35:59Z"}},"url":"https://api.github.com/repos/openai/codex/commits/01cb97851b1634d33b9bbb8e184111611c39b7b5","html_url":"https://github.com/openai/codex/commit/01cb97851b1634d33b9bbb8e184111611c39b7b5","comments_url":"https://api.github.com/repos/openai/codex/commits/01cb97851b1634d33b9bbb8e184111611c39b7b5/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"3cdce5286591fc96e4336d130f71eda11da17382","url":"https://api.github.com/repos/openai/codex/commits/3cdce5286591fc96e4336d130f71eda11da17382","html_url":"https://github.com/openai/codex/commit/3cdce5286591fc96e4336d130f71eda11da17382"}]},{"sha":"3cdce5286591fc96e4336d130f71eda11da17382","node_id":"C_kwDOOYsS4doAKDNjZGNlNTI4NjU5MWZjOTZlNDMzNmQxMzBmNzFlZGExMWRhMTczODI","commit":{"author":{"name":"jif-oai","email":"jif@openai.com","date":"2026-06-01T16:33:05Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-01T16:33:05Z"},"message":"Preserve renamed thread titles during reconciliation (#25624)\n\n## Summary\n- preserve existing explicit SQLite thread titles during rollout\nreconciliation/backfill when the incoming rollout title is only\nfirst-message-derived\n- keep stale inferred-title repair behavior while avoiding session-index\nscans during startup backfill\n- add a regression test for renamed titles surviving reconcile\n\n## Testing\n- just fmt\n- just test -p codex-rollout\n- just test -p codex-state","tree":{"sha":"6b79872d3fd80e58dccd517dcf57712016611e74","url":"https://api.github.com/repos/openai/codex/git/trees/6b79872d3fd80e58dccd517dcf57712016611e74"},"url":"https://api.github.com/repos/openai/codex/git/commits/3cdce5286591fc96e4336d130f71eda11da17382","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqHbRBCRC1aQ7uu5UhlAAAfnwQABGSvVoPKWr5OTZEdH7jzx1p\nJCYJeRjM5fmTcpDYTugZEBpH8+3PxX60zYtbKWEBMZ4x3zToWA8zhPu8K9DkBdCM\n6YZw3z5SXgnbaQaJNY472sEjDrdaDOG3yekVBBsNIzpISQQDfpsTXgjbBuH0LWaK\nfiw+KZTiHEFKBEvDDwNlmblixYfEjD7QeZXJj0zw207MNfUQERULU4hkPzPC8+pI\ni1aheOBhbKggWuXA3uw0vOOij8H9pRADYzpg497TmeL9UiVIZ1QZFaBB2GR1kD+k\nn8EUjBUG4NRcrE/xtgyjA7UB2FlSZlF8DlRLE7sHLJh85qPe6aW78Srto7BWNpzh\nEhwqvtKKiiM0Tb/54viHGJjQVfwlqNEYjAIdFACp4w2mfT6D1lA16ihYInoMKp1X\nm0DL8EP+bwJNcrrri6RIN4IzVEPBkJSVwcJN2b6lE6IumUXPwqEmTpf0HR4QSIab\noDxj9MrzAexriONcbuMfW1gZwwdTdUaX/NbtiwPCUkUrYa2bBn500MH4+JGD/lt3\nx16XUjUCNeEchJRJ6i2RjxzifnMZ2lt8dNlBte1XU0ZAdWJ3gN0gBEHp38kf3aL6\n14+Q5qMfAUzbrGvSqDBKQsXs0MZk+6uF9Y19rtFddjRhSa/edfv+xPuwLPqJlVZ/\nBuHyjfGsEywf1OZ42dPK\n=o3Pi\n-----END PGP SIGNATURE-----\n","payload":"tree 6b79872d3fd80e58dccd517dcf57712016611e74\nparent f1d029cf75e04246c4b30bf93e47d036ba394fb5\nauthor jif-oai <jif@openai.com> 1780331585 +0200\ncommitter GitHub <noreply@github.com> 1780331585 +0200\n\nPreserve renamed thread titles during reconciliation (#25624)\n\n## Summary\n- preserve existing explicit SQLite thread titles during rollout\nreconciliation/backfill when the incoming rollout title is only\nfirst-message-derived\n- keep stale inferred-title repair behavior while avoiding session-index\nscans during startup backfill\n- add a regression test for renamed titles surviving reconcile\n\n## Testing\n- just fmt\n- just test -p codex-rollout\n- just test -p codex-state","verified_at":"2026-06-01T16:33:06Z"}},"url":"https://api.github.com/repos/openai/codex/commits/3cdce5286591fc96e4336d130f71eda11da17382","html_url":"https://github.com/openai/codex/commit/3cdce5286591fc96e4336d130f71eda11da17382","comments_url":"https://api.github.com/repos/openai/codex/commits/3cdce5286591fc96e4336d130f71eda11da17382/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f1d029cf75e04246c4b30bf93e47d036ba394fb5","url":"https://api.github.com/repos/openai/codex/commits/f1d029cf75e04246c4b30bf93e47d036ba394fb5","html_url":"https://github.com/openai/codex/commit/f1d029cf75e04246c4b30bf93e47d036ba394fb5"}]},{"sha":"f1d029cf75e04246c4b30bf93e47d036ba394fb5","node_id":"C_kwDOOYsS4doAKGYxZDAyOWNmNzVlMDQyNDZjNGIzMGJmOTNlNDdkMDM2YmEzOTRmYjU","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-06-01T16:30:20Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-01T16:30:20Z"},"message":"Add reasoning-only status surface item (#25504)\n\nCloses #24886.\n\n## Why\nUsers can configure the TUI status line and terminal title with\n`model-with-reasoning`, but issue #24886 asks for a compact\nreasoning-only item. That lets a setup show just `default`, `low`,\n`medium`, `high`, or `xhigh` without repeating the model name.\n\n## What changed\n- Added a `reasoning` item for `/statusline` and `/title` setup flows.\n- Rendered the item from the effective reasoning effort, including\ncollaboration-mode overrides.\n- Registered `reasoning` with `codex doctor` so Codex-generated\nterminal-title config is not reported as invalid.\n- Updated TUI setup snapshots so the picker previews include the new\nitem.","tree":{"sha":"e351457ee16ed2a65e1193a039f60432b1cafb63","url":"https://api.github.com/repos/openai/codex/git/trees/e351457ee16ed2a65e1193a039f60432b1cafb63"},"url":"https://api.github.com/repos/openai/codex/git/commits/f1d029cf75e04246c4b30bf93e47d036ba394fb5","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqHbOcCRC1aQ7uu5UhlAAAxJQQAGual0JwMUgSu4U0Q3XDqT3c\nsGCHV56CWXbd2z5byg/Q8s7/i/RnIkllHocL7I6JiarByPwi2kOKPuAJsz067Owm\nTLCo155HwhmscVsOfnBG9YXIEyYCo3eWcJkqu4MlwFXcaPeV3LPRFmmRWfj6Prvf\nrFLHj29KoqOTKgl5UI3agJyymSHJdMLQB1YOXwWDmUt2b6pzWV3OCIB1ERV8srZd\nK/6Bx96usbRchAU9qdp9s/zgUfeycCJEWK3nOrFC5tSeUshY1xVOOHwH1tfLiB2B\ne7868Tmji9AgQfluh7OrUqEvxI3gPNxHqKnEl0hWOQ1VuplvOhxa2ZWYokVr4Mrj\nSJ5rR8sjPKyGBvqeGSNthrUGpXCoYsWkHpah8vNh/LrjqARoglHViFG86DZ2vafw\nPXp3eK8FfmLx7MCeew7+1Dy2ii0EakZfo/7pl5erJfNM3j5XRxVGb5Vu1fI/S7lw\nLD3x3ENdArIaga3kBFz7b5H2GHkUs59QRvO9A1kT1nI5U7Z82hGAJojtummSKpaS\n/mj0Tn/im/t9nnIp0KU9ZTxydtN11V/2EjSKPMDCKqYf6QzmiN/RF9pPy/DJfi+h\nHE33/oyD9jIMl7gkG9a8TRkARNQSxD/pjBcFhp3J43Mpp1CGKod9oeKA/BRhQz7z\ndBaO6OQzEmzc/z1K2G0N\n=RfzI\n-----END PGP SIGNATURE-----\n","payload":"tree e351457ee16ed2a65e1193a039f60432b1cafb63\nparent 66814464779ee531ac3be8c40bb6f5fe7d38fb38\nauthor Eric Traut <etraut@openai.com> 1780331420 -0700\ncommitter GitHub <noreply@github.com> 1780331420 -0700\n\nAdd reasoning-only status surface item (#25504)\n\nCloses #24886.\n\n## Why\nUsers can configure the TUI status line and terminal title with\n`model-with-reasoning`, but issue #24886 asks for a compact\nreasoning-only item. That lets a setup show just `default`, `low`,\n`medium`, `high`, or `xhigh` without repeating the model name.\n\n## What changed\n- Added a `reasoning` item for `/statusline` and `/title` setup flows.\n- Rendered the item from the effective reasoning effort, including\ncollaboration-mode overrides.\n- Registered `reasoning` with `codex doctor` so Codex-generated\nterminal-title config is not reported as invalid.\n- Updated TUI setup snapshots so the picker previews include the new\nitem.","verified_at":"2026-06-01T16:30:21Z"}},"url":"https://api.github.com/repos/openai/codex/commits/f1d029cf75e04246c4b30bf93e47d036ba394fb5","html_url":"https://github.com/openai/codex/commit/f1d029cf75e04246c4b30bf93e47d036ba394fb5","comments_url":"https://api.github.com/repos/openai/codex/commits/f1d029cf75e04246c4b30bf93e47d036ba394fb5/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"66814464779ee531ac3be8c40bb6f5fe7d38fb38","url":"https://api.github.com/repos/openai/codex/commits/66814464779ee531ac3be8c40bb6f5fe7d38fb38","html_url":"https://github.com/openai/codex/commit/66814464779ee531ac3be8c40bb6f5fe7d38fb38"}]},{"sha":"66814464779ee531ac3be8c40bb6f5fe7d38fb38","node_id":"C_kwDOOYsS4doAKDY2ODE0NDY0Nzc5ZWU1MzFhYzNiZThjNDBiYjZmNWZlN2QzOGZiMzg","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-06-01T16:17:19Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-01T16:17:19Z"},"message":"Reset slash popup selection when filter changes (#25492)\n\n## Summary\n\nFixes #25295.\n\nThe slash-command popup reused its previous `ScrollState` when the\ncomposer filter token changed. After scrolling the full `/` command\nlist, typing a narrower filter such as `/st` could clamp the stale\nselection into the filtered results and highlight the wrong command.\n\nThis resets the popup selection and viewport only when the parsed filter\ntoken changes, so normal arrow navigation is preserved while new filters\nstart at the first match.","tree":{"sha":"524d57aa599e866e46d89a4f4427b588567659fe","url":"https://api.github.com/repos/openai/codex/git/trees/524d57aa599e866e46d89a4f4427b588567659fe"},"url":"https://api.github.com/repos/openai/codex/git/commits/66814464779ee531ac3be8c40bb6f5fe7d38fb38","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqHbCPCRC1aQ7uu5UhlAAALDQQAGd26/w4buqfXALOV4gaQhVO\n+z2EeEzRf07idUbC4HHqsQqzQ8ELV4C0kvRCwETuNNOa/tEjA2h6/GUdIYiNBqgB\n59hEKLxtpnSsLfNHgE0AbegNmUVl/FXjjJv0wnKCREPoqYdC6rb0/5rx/bx1s8V+\n6GJUL10IIWjaTX+4mMRLc//O7JjxJVz00C4+s8JmNntckYr9dCi9Rzhx2PDS8219\nMU1SiHGJWiM+3nGGJPKPnqhpcvgyEEpUGIVtzRbI3ktMgojTteumlCd2iBrpU1jj\nYmLDN9vyomdLyEk6n/dMKnauwlt55wbR9vHTJ6dykfMR8WvO1K12uZvN9Qn2vJ5i\nDnJ3CCRoXWp+J7gYwSC+Si9ASLe0PwZkGUJMg3VV4n/mA3N71nuZgj+QqSbHFale\neM+EVy+9zHb5g0qyTUc+Q3IXeTSC1CKJfgayqchyxxVucRuDuBUmoH0to8inWIhz\neMwnYj4wU+3cgh6XDMf72j/H1TdvIgB1oPQm0D65FyBF9gHw2JI4DMq2yoL0F2FK\nEol/+LPKYNqXjeHdDkFeVn0tO8e3RHdJRFBcvrC5AJ0SjA0mlHU1AT7qUBxUcwFP\nTRUXzrr/0zUI2+Rn/MG8a9fuHGniWAyqHrF2OUqWhlDfN+5tvkO//w77szGn/ODx\nitVnGg2xo4+hOfx7W73f\n=GiIr\n-----END PGP SIGNATURE-----\n","payload":"tree 524d57aa599e866e46d89a4f4427b588567659fe\nparent f94c49cf465b7403f22894f2db1432dee66fd64e\nauthor Eric Traut <etraut@openai.com> 1780330639 -0700\ncommitter GitHub <noreply@github.com> 1780330639 -0700\n\nReset slash popup selection when filter changes (#25492)\n\n## Summary\n\nFixes #25295.\n\nThe slash-command popup reused its previous `ScrollState` when the\ncomposer filter token changed. After scrolling the full `/` command\nlist, typing a narrower filter such as `/st` could clamp the stale\nselection into the filtered results and highlight the wrong command.\n\nThis resets the popup selection and viewport only when the parsed filter\ntoken changes, so normal arrow navigation is preserved while new filters\nstart at the first match.","verified_at":"2026-06-01T16:17:19Z"}},"url":"https://api.github.com/repos/openai/codex/commits/66814464779ee531ac3be8c40bb6f5fe7d38fb38","html_url":"https://github.com/openai/codex/commit/66814464779ee531ac3be8c40bb6f5fe7d38fb38","comments_url":"https://api.github.com/repos/openai/codex/commits/66814464779ee531ac3be8c40bb6f5fe7d38fb38/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f94c49cf465b7403f22894f2db1432dee66fd64e","url":"https://api.github.com/repos/openai/codex/commits/f94c49cf465b7403f22894f2db1432dee66fd64e","html_url":"https://github.com/openai/codex/commit/f94c49cf465b7403f22894f2db1432dee66fd64e"}]},{"sha":"f94c49cf465b7403f22894f2db1432dee66fd64e","node_id":"C_kwDOOYsS4doAKGY5NGM0OWNmNDY1Yjc0MDNmMjI4OTRmMmRiMTQzMmRlZTY2ZmQ2NGU","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-06-01T16:17:08Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-01T16:17:08Z"},"message":"Use deep links for macOS codex app paths (#25485)\n\n## Why\n\n`codex app [PATH]` is the documented CLI entry point for opening Codex\nDesktop on a workspace. Recent desktop builds can focus the app while\nfailing to honor paths passed as macOS document-open arguments via `open\n-a Codex.app <workspace>`, which broke `codex app .` for users. See\n#25333; related report: #25166.\n\nThe desktop app still supports the explicit\n`codex://threads/new?path=...` route, so the CLI should use that\napp-owned launch surface instead of depending on folder-open event\ndelivery.\n\n## What Changed\n\n- Build a `codex://threads/new?path=<workspace>` URL in the macOS app\nlauncher.\n- Pass that URL to `open -a <Codex.app>` instead of passing the\nworkspace path as a document argument.\n- Add coverage that workspace paths needing escaping round-trip through\nURL query encoding.\n\n## Verification\n\n- `just test -p codex-cli codex_new_thread_url_encodes_workspace_path`","tree":{"sha":"ad38ba0969781ec045a1419f9a32dc56af9ccbee","url":"https://api.github.com/repos/openai/codex/git/trees/ad38ba0969781ec045a1419f9a32dc56af9ccbee"},"url":"https://api.github.com/repos/openai/codex/git/commits/f94c49cf465b7403f22894f2db1432dee66fd64e","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqHbCECRC1aQ7uu5UhlAAALxQQAFl39YriWZhXPas4N8Dy09IF\ngKbXrSIs/f0RyYeXv7vvtBkOY9wsiCH8QmFMbRtfA+9nJUB2aN4YXx8OgbDbcyis\n4ZPydX67FFyIlcqqxrfWjYDnGIblxRp77NddE+/ai9HBmjK3TVUvTJr/mtiy0NB8\nrGjp8dLOYnEhlzOxVN7FsEt3sLwWHBWOqIAeOnNiAslOQXh/VQDddLlFOvRBW5Aq\nMPFdoydIBh/E98885MpUVrZJwdt/wmi9NGw4JDPNtvxcKTNIrGwcyvwwujZ+yp9C\nz94qN3YlTmI/BvEhdYoOCpRzXmQwoM0BmEJDZsn1gPjvVAy0FTICwkLkKh3QQrig\natiKevo8BAXbx5qr+dKxUPyl371f0ZFfkN/z9A8chSSDjxPnkbnbnt/HITBMVWo4\n+2TgBMlbS7Esc/NigbbXfBjnNJxSmKHPqdsruIgocdje6EPu/MpBKZwykV7Tc5S4\nrhvF8sh3pLn67A1qhMrurxleNUittkVtG5z/DHzZAq6bD3zgCSpfMw2F4mp/EuSo\nVqTAkGKGKP5N/B2cQEckMprk/GfpLBw8fzHF+ygLk4F2/3zYohUiNn1u0sBUwpoa\n/5mZaIbu4WSZ3c93CsqAZ45oeijjsRC2oFLMsDXwlcioEgffTWPXxo8MystU6G2M\nU7Ga/kkRwMFcxqan8rxf\n=jad8\n-----END PGP SIGNATURE-----\n","payload":"tree ad38ba0969781ec045a1419f9a32dc56af9ccbee\nparent 12c37a6b5cdb3fff2c03a355ca9948866bf1df07\nauthor Eric Traut <etraut@openai.com> 1780330628 -0700\ncommitter GitHub <noreply@github.com> 1780330628 -0700\n\nUse deep links for macOS codex app paths (#25485)\n\n## Why\n\n`codex app [PATH]` is the documented CLI entry point for opening Codex\nDesktop on a workspace. Recent desktop builds can focus the app while\nfailing to honor paths passed as macOS document-open arguments via `open\n-a Codex.app <workspace>`, which broke `codex app .` for users. See\n#25333; related report: #25166.\n\nThe desktop app still supports the explicit\n`codex://threads/new?path=...` route, so the CLI should use that\napp-owned launch surface instead of depending on folder-open event\ndelivery.\n\n## What Changed\n\n- Build a `codex://threads/new?path=<workspace>` URL in the macOS app\nlauncher.\n- Pass that URL to `open -a <Codex.app>` instead of passing the\nworkspace path as a document argument.\n- Add coverage that workspace paths needing escaping round-trip through\nURL query encoding.\n\n## Verification\n\n- `just test -p codex-cli codex_new_thread_url_encodes_workspace_path`","verified_at":"2026-06-01T16:17:09Z"}},"url":"https://api.github.com/repos/openai/codex/commits/f94c49cf465b7403f22894f2db1432dee66fd64e","html_url":"https://github.com/openai/codex/commit/f94c49cf465b7403f22894f2db1432dee66fd64e","comments_url":"https://api.github.com/repos/openai/codex/commits/f94c49cf465b7403f22894f2db1432dee66fd64e/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"12c37a6b5cdb3fff2c03a355ca9948866bf1df07","url":"https://api.github.com/repos/openai/codex/commits/12c37a6b5cdb3fff2c03a355ca9948866bf1df07","html_url":"https://github.com/openai/codex/commit/12c37a6b5cdb3fff2c03a355ca9948866bf1df07"}]},{"sha":"12c37a6b5cdb3fff2c03a355ca9948866bf1df07","node_id":"C_kwDOOYsS4doAKDEyYzM3YTZiNWNkYjNmZmYyYzAzYTM1NWNhOTk0ODg2NmJmMWRmMDc","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-06-01T16:01:52Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-01T16:01:52Z"},"message":"Allow paste in searchable selection menus (#25400)\n\n## Summary\n\nI frequently want to be able to paste into the searchable menu -- the\nmost common use-case here is when specifying an upstream for a\n`/review`, where I copy the upstream from an open terminal.","tree":{"sha":"eece0ba053cbc08816462e2035c8b76b9aadee27","url":"https://api.github.com/repos/openai/codex/git/trees/eece0ba053cbc08816462e2035c8b76b9aadee27"},"url":"https://api.github.com/repos/openai/codex/git/commits/12c37a6b5cdb3fff2c03a355ca9948866bf1df07","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqHazwCRC1aQ7uu5UhlAAAsnQQAJXBS9NbtpNJ21TYK4cMu5hw\n0lnld2/ofcrZhZIGnEGU7XBpnFiH4U3OfJeZbpwPo5ACQ9ZS+8I3AEtoUIWPeFp8\nCV4rcS6yUr85okAsOyp2UomfpMiTQXs0UhFWYLerwUe6UdpmRHzf3sY4APx8bNmA\nHmiExFbAnfEbqLae1ocY/jXPFTOf4XpCLFF5C/QyOHFNLXTrdmZrZBkkKktFC9zq\n5BRkmokZiiYjyhDvaVlTNFzI9csKfep5VtYzLxRavfkIFuRUagt/dUkJUpj2aH0V\nRMqsQYO3n0MfSDu44h81JI6Hfh/1GG/W9ZTj+6qeSKa5Wnq7p3afNg9RGridoCGd\nQVNM7gcgLNWPCeEBgs54iv3YDstYx8sPNY97rTG/ILEj/pFw+7yZJTLb05qySKit\nqXiAR4eLgaghIvZ+9MMc5aYsoFCM0vz5fpNJGlSN4C/5f4TsnRNgSxdLQA4w1x5F\nRMub2UqTJGz282/2e0zTULQDZZzvHHJodciMg3DWFk+sXHpLVtF68+6t4R05HHon\nvNzgKn0kZyg6jW6HLBJgetBxruq64CZ1OzpTWmaDkjL/+8ZHRy+C9JLhy4sN0Wfz\n/F0N3f+YQKDzUUrGbvCZZnpbfBYWP9hAtzRKUiiSJ1f0wutBD2TxlJ8b+vzQFSmO\n8nOTe4PyAgxUtF9Z+Ii3\n=EXbu\n-----END PGP SIGNATURE-----\n","payload":"tree eece0ba053cbc08816462e2035c8b76b9aadee27\nparent 13edafb6edff2be9bf57f38524638da4c23155d9\nauthor Charlie Marsh <charliemarsh@openai.com> 1780329712 +0200\ncommitter GitHub <noreply@github.com> 1780329712 +0200\n\nAllow paste in searchable selection menus (#25400)\n\n## Summary\n\nI frequently want to be able to paste into the searchable menu -- the\nmost common use-case here is when specifying an upstream for a\n`/review`, where I copy the upstream from an open terminal.","verified_at":"2026-06-01T16:01:59Z"}},"url":"https://api.github.com/repos/openai/codex/commits/12c37a6b5cdb3fff2c03a355ca9948866bf1df07","html_url":"https://github.com/openai/codex/commit/12c37a6b5cdb3fff2c03a355ca9948866bf1df07","comments_url":"https://api.github.com/repos/openai/codex/commits/12c37a6b5cdb3fff2c03a355ca9948866bf1df07/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"13edafb6edff2be9bf57f38524638da4c23155d9","url":"https://api.github.com/repos/openai/codex/commits/13edafb6edff2be9bf57f38524638da4c23155d9","html_url":"https://github.com/openai/codex/commit/13edafb6edff2be9bf57f38524638da4c23155d9"}]},{"sha":"13edafb6edff2be9bf57f38524638da4c23155d9","node_id":"C_kwDOOYsS4doAKDEzZWRhZmI2ZWRmZjJiZTliZjU3ZjM4NTI0NjM4ZGE0YzIzMTU1ZDk","commit":{"author":{"name":"Won Park","email":"won@openai.com","date":"2026-06-01T15:53:25Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-01T15:53:25Z"},"message":"Preserve auto-review approval policy in codex exec (#23763)\n\n## Why\n\n`codex exec` was forcing headless runs to `approval_policy = \"never\"`\neven when the resolved reviewer was `auto_review`. That prevented\nunattended exec workflows from reaching the reviewed MCP write path they\nwere configured to use.\n\n## What changed\n\n- Keep the existing headless `never` default for ordinary exec runs.\n- Re-resolve exec config without that synthetic override when the final\nreviewer resolves to `AutoReview`, so configured or requirements-driven\napproval policy is preserved.\n- Add regression coverage for:\n  - `auto_review` plus `on-request` from user config\n- requirements-driven `AutoReview`, asserting exec’s final approval\npolicy matches the no-override control config exactly\n\n## Validation\n\n- `just fmt`\n- `cargo test -p codex-exec`","tree":{"sha":"709b322920399633d57406c167f086cec511338d","url":"https://api.github.com/repos/openai/codex/git/trees/709b322920399633d57406c167f086cec511338d"},"url":"https://api.github.com/repos/openai/codex/git/commits/13edafb6edff2be9bf57f38524638da4c23155d9","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqHar1CRC1aQ7uu5UhlAAA9WAQAK6UN8jaYqHLbkVR0ezEaX0p\n5mqF+kHcKfg440M82ddNpKWtXIfAWeviUimxUe8OprUBy+7JyHPkHHXd4yxE8JJ0\ndzgs+H2UkefWmwCxICijf/ljl/9HOrNLcSw9GLBGPv6rtxRWDhO/84RW4PoRh2vx\nLMefjq0GpMXqPleOylWv88DS1YUlOVHOT+KeKV81oMXWTMHSqLpHj7cMzw0zxjE1\nBwMdkCq4EFR5J0t43M0Uh46wt6jD4Ay6PHCzcMCmye+DAF8fp4VMugn4n2ElDGHw\nkwc+Limu8HFhbpEt5VXh7wS/FNLzstf/speXPmPTYPZYC87h7WzShAY8cAH9WUy6\n3TS5yfzvTOGZyTsygZnB9p5rgp54BFYZ8bD8cpElZkXjHpAYeUUDactJO4cklQbG\ntb10Vm2jemyGRbzos9kwU4dPsFLB2az/pKgAbezKeKrEF8T4N9Hjs3bGisJIgm6f\ndsmVfneeckeuo1X/aO9039tHAyQXar9NNKJKhwcFfHWu3TT9ag+0xOjM5cSXO+um\nyXGD+dkFqkvMxkxV3v0ypglj32vXnE+BVWA/FniFgd9O6lboUPtUOPpVgunp/6vI\nqxo/dTiBBWF8JIhe61tqXwZpNz4m66U1Eujecr0ZYsNmY0ySj5Ncj01mC/EGGJMk\nEpMHWnSLWDpq1R1vk58B\n=Duj3\n-----END PGP SIGNATURE-----\n","payload":"tree 709b322920399633d57406c167f086cec511338d\nparent c0ea566bb52908915fecb2569869bbe380f22468\nauthor Won Park <won@openai.com> 1780329205 -0700\ncommitter GitHub <noreply@github.com> 1780329205 -0700\n\nPreserve auto-review approval policy in codex exec (#23763)\n\n## Why\n\n`codex exec` was forcing headless runs to `approval_policy = \"never\"`\neven when the resolved reviewer was `auto_review`. That prevented\nunattended exec workflows from reaching the reviewed MCP write path they\nwere configured to use.\n\n## What changed\n\n- Keep the existing headless `never` default for ordinary exec runs.\n- Re-resolve exec config without that synthetic override when the final\nreviewer resolves to `AutoReview`, so configured or requirements-driven\napproval policy is preserved.\n- Add regression coverage for:\n  - `auto_review` plus `on-request` from user config\n- requirements-driven `AutoReview`, asserting exec’s final approval\npolicy matches the no-override control config exactly\n\n## Validation\n\n- `just fmt`\n- `cargo test -p codex-exec`","verified_at":"2026-06-01T15:53:32Z"}},"url":"https://api.github.com/repos/openai/codex/commits/13edafb6edff2be9bf57f38524638da4c23155d9","html_url":"https://github.com/openai/codex/commit/13edafb6edff2be9bf57f38524638da4c23155d9","comments_url":"https://api.github.com/repos/openai/codex/commits/13edafb6edff2be9bf57f38524638da4c23155d9/comments","author":{"login":"won-openai","id":262224683,"node_id":"U_kgDOD6E7Kw","avatar_url":"https://avatars.githubusercontent.com/u/262224683?v=4","gravatar_id":"","url":"https://api.github.com/users/won-openai","html_url":"https://github.com/won-openai","followers_url":"https://api.github.com/users/won-openai/followers","following_url":"https://api.github.com/users/won-openai/following{/other_user}","gists_url":"https://api.github.com/users/won-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/won-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/won-openai/subscriptions","organizations_url":"https://api.github.com/users/won-openai/orgs","repos_url":"https://api.github.com/users/won-openai/repos","events_url":"https://api.github.com/users/won-openai/events{/privacy}","received_events_url":"https://api.github.com/users/won-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c0ea566bb52908915fecb2569869bbe380f22468","url":"https://api.github.com/repos/openai/codex/commits/c0ea566bb52908915fecb2569869bbe380f22468","html_url":"https://github.com/openai/codex/commit/c0ea566bb52908915fecb2569869bbe380f22468"}]},{"sha":"c0ea566bb52908915fecb2569869bbe380f22468","node_id":"C_kwDOOYsS4doAKGMwZWE1NjZiYjUyOTA4OTE1ZmVjYjI1Njk4NjliYmUzODBmMjI0Njg","commit":{"author":{"name":"Felipe Coury","email":"felipe.coury@openai.com","date":"2026-06-01T14:49:14Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-01T14:49:14Z"},"message":"feat(tui): restore output-free cancelled prompts (#25316)\n\n## TL;DR\n\nWhen you press Esc or Ctrl+C after sending a prompt but before any\noutput was rendering, it restores the last composer and the message.\n\n## Summary\n\nCancelling a prompt immediately after submission should behave like\nreturning to edit that prompt, not like discarding the user's draft.\nToday, pressing `Esc` or `Ctrl+C` before Codex responds leaves the\nsubmitted prompt in the transcript and returns an empty composer,\nforcing the user to recall or retype it.\n\nWhen an interrupted turn has not produced substantive visible output,\nrestore its submitted prompt directly into the composer and roll back\nthat latest turn. This also covers the first prompt in a fresh thread,\nbefore the TUI has retained a local user-history cell. The restored\ndraft keeps its text, image attachments, and active collaboration mode\nso it can be edited and resubmitted in place.\n\nRestoration is intentionally suppressed once the turn has produced\nuser-visible activity such as assistant output, tool work, hooks, or\npatches. A transient thinking status does not make the prompt\nineligible. Rollback also rebuilds terminal scrollback from the retained\ntranscript cells so repeated cancellations and terminal resizes do not\nduplicate history.\n\n## How to Test\n\n1. Start the TUI with `cargo run -p codex-cli --bin codex`.\n2. In a fresh thread, submit the first prompt and press `Esc` before\nCodex emits substantive output. Confirm that the prompt returns to the\ncomposer for editing and its submitted transcript row is removed.\n3. Repeat with `Ctrl+C`, then repeat after at least one completed turn.\nConfirm the same behavior.\n4. Submit a prompt, wait for assistant output or tool activity, then\ncancel. Confirm that the transcript remains intact and the prompt is not\nrestored into the composer.\n5. Cancel several output-free prompts and resize the terminal between\nattempts. Confirm that the startup banner, tip, and transcript history\ndo not duplicate in scrollback.\n\nTargeted tests:\n- `just test -p codex-tui cancelled_turn_edit_restores_prompt`\n- `just test -p codex-tui\noutput_free_interrupted_turn_requests_prompt_restore`\n- `just test -p codex-tui\nvisible_output_prevents_cancelled_turn_prompt_restore`\n- `just test -p codex-tui\nthinking_status_keeps_cancelled_turn_prompt_restore_eligible`\n- `just test -p codex-tui\npatch_activity_prevents_cancelled_turn_prompt_restore`\n\nThe full `just test -p codex-tui` run completed with `2746` passing\ntests and two unrelated existing guardian feature-flag failures. `just\nargument-comment-lint` remains blocked locally by the existing Bazel\nLLVM `compiler-rt` sanitizer-header glob failure; the touched Rust diff\nwas manually audited for positional literal comments.","tree":{"sha":"23227ee495607f9786404a1ba23b4340326bb953","url":"https://api.github.com/repos/openai/codex/git/trees/23227ee495607f9786404a1ba23b4340326bb953"},"url":"https://api.github.com/repos/openai/codex/git/commits/c0ea566bb52908915fecb2569869bbe380f22468","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqHZvqCRC1aQ7uu5UhlAAAmkEQAKou4lWng5KlSY+GkMxbikyf\nl5mwI4uHmAohuQ+XviRsEZWDfXlcNtWmXsM2PGAYP0stPAoHyM1OnPuawzpDicum\npKw/NHpJJ4WtE3wBduEVKztYNvYr5vLo3/o1IfbB3i4xuGFkrqAkLKBd7rXi+Wv3\n/8OVLTv8scdFwd7Cd8+1gh2wVQLGz2cAXVKHTmlXmiFFYue1G6feLoM/VdCVIVus\nXSYW1hJ94JrcYZO34u6vT9/7Qp71PeI6e+8bYZBa0gh19aGNdhjIPd+T2GYOfLXm\nRhZP2Y9BpW1fbnGOwrY3AXqvbVA9tRqI+5+C39923mSZ51k0Hbu1rz37fB8ROykT\neCan5TT0zz0FiISfv1ssZNXUMOT6mHalQ4iBa2CfKHjiUn9LFlsRi+2F6j1VTuuw\nq9TaE/gzLV1+eNKe+d1/Q8wrX79A9PXBZmUia1Atyr85o/tALYLC7lZJKJniuu3v\nzwYqIqBmz+YnsUdUw2cbu+HV7NW6h713XPMNwO1UNwkGUyidem6Zx7KzndSuer/6\nfHYq1L04wEfzv0eKeutNcf8Joh/1pEKgoWRA3he2Dn8oUsk6Bkk0owc1IUei4JiX\ngUOkt/LxS/67BjNZpwFGNq2OCxDnrk8NmPVVyZywYtLdNJhGwBfsOhjW2RphGyAP\n7fUXDMWcQzzXp6X3RkwY\n=ndpQ\n-----END PGP SIGNATURE-----\n","payload":"tree 23227ee495607f9786404a1ba23b4340326bb953\nparent 4eded02f527b90e663764cb5c194f881c4dfd1bc\nauthor Felipe Coury <felipe.coury@openai.com> 1780325354 -0300\ncommitter GitHub <noreply@github.com> 1780325354 -0300\n\nfeat(tui): restore output-free cancelled prompts (#25316)\n\n## TL;DR\n\nWhen you press Esc or Ctrl+C after sending a prompt but before any\noutput was rendering, it restores the last composer and the message.\n\n## Summary\n\nCancelling a prompt immediately after submission should behave like\nreturning to edit that prompt, not like discarding the user's draft.\nToday, pressing `Esc` or `Ctrl+C` before Codex responds leaves the\nsubmitted prompt in the transcript and returns an empty composer,\nforcing the user to recall or retype it.\n\nWhen an interrupted turn has not produced substantive visible output,\nrestore its submitted prompt directly into the composer and roll back\nthat latest turn. This also covers the first prompt in a fresh thread,\nbefore the TUI has retained a local user-history cell. The restored\ndraft keeps its text, image attachments, and active collaboration mode\nso it can be edited and resubmitted in place.\n\nRestoration is intentionally suppressed once the turn has produced\nuser-visible activity such as assistant output, tool work, hooks, or\npatches. A transient thinking status does not make the prompt\nineligible. Rollback also rebuilds terminal scrollback from the retained\ntranscript cells so repeated cancellations and terminal resizes do not\nduplicate history.\n\n## How to Test\n\n1. Start the TUI with `cargo run -p codex-cli --bin codex`.\n2. In a fresh thread, submit the first prompt and press `Esc` before\nCodex emits substantive output. Confirm that the prompt returns to the\ncomposer for editing and its submitted transcript row is removed.\n3. Repeat with `Ctrl+C`, then repeat after at least one completed turn.\nConfirm the same behavior.\n4. Submit a prompt, wait for assistant output or tool activity, then\ncancel. Confirm that the transcript remains intact and the prompt is not\nrestored into the composer.\n5. Cancel several output-free prompts and resize the terminal between\nattempts. Confirm that the startup banner, tip, and transcript history\ndo not duplicate in scrollback.\n\nTargeted tests:\n- `just test -p codex-tui cancelled_turn_edit_restores_prompt`\n- `just test -p codex-tui\noutput_free_interrupted_turn_requests_prompt_restore`\n- `just test -p codex-tui\nvisible_output_prevents_cancelled_turn_prompt_restore`\n- `just test -p codex-tui\nthinking_status_keeps_cancelled_turn_prompt_restore_eligible`\n- `just test -p codex-tui\npatch_activity_prevents_cancelled_turn_prompt_restore`\n\nThe full `just test -p codex-tui` run completed with `2746` passing\ntests and two unrelated existing guardian feature-flag failures. `just\nargument-comment-lint` remains blocked locally by the existing Bazel\nLLVM `compiler-rt` sanitizer-header glob failure; the touched Rust diff\nwas manually audited for positional literal comments.","verified_at":"2026-06-01T14:49:22Z"}},"url":"https://api.github.com/repos/openai/codex/commits/c0ea566bb52908915fecb2569869bbe380f22468","html_url":"https://github.com/openai/codex/commit/c0ea566bb52908915fecb2569869bbe380f22468","comments_url":"https://api.github.com/repos/openai/codex/commits/c0ea566bb52908915fecb2569869bbe380f22468/comments","author":{"login":"fcoury-oai","id":272635208,"node_id":"U_kgDOEEAVSA","avatar_url":"https://avatars.githubusercontent.com/u/272635208?v=4","gravatar_id":"","url":"https://api.github.com/users/fcoury-oai","html_url":"https://github.com/fcoury-oai","followers_url":"https://api.github.com/users/fcoury-oai/followers","following_url":"https://api.github.com/users/fcoury-oai/following{/other_user}","gists_url":"https://api.github.com/users/fcoury-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/fcoury-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fcoury-oai/subscriptions","organizations_url":"https://api.github.com/users/fcoury-oai/orgs","repos_url":"https://api.github.com/users/fcoury-oai/repos","events_url":"https://api.github.com/users/fcoury-oai/events{/privacy}","received_events_url":"https://api.github.com/users/fcoury-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"4eded02f527b90e663764cb5c194f881c4dfd1bc","url":"https://api.github.com/repos/openai/codex/commits/4eded02f527b90e663764cb5c194f881c4dfd1bc","html_url":"https://github.com/openai/codex/commit/4eded02f527b90e663764cb5c194f881c4dfd1bc"}]}]