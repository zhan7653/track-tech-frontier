 Technology, Illinois State University, Normal, IL, USA"}],"role":[{"role":"author","vocabulary":"crossref"}]}],"URL":"https:\/\/doi.org\/10.1109\/access.2022.3232275","published-print":{"date-parts":[[2023]]},"issued":{"date-parts":[[2023]]},"container-title":["IEEE Access"]},{"DOI":"10.32920\/25536163.v1","title":["Data processing with time-based memory access"],"author":[{"given":"Nagi","family":"Mekhiel","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"URL":"https:\/\/doi.org\/10.32920\/25536163.v1","issued":{"date-parts":[[2024,4,3]]},"abstract":"<jats:p>&lt;p&gt;Memory access in data processing is provided using a time-based technique in which memory locations are mapped to respectively corresponding periods of time during which they are made available for access.&lt;\/p&gt;<\/jats:p>"},{"DOI":"10.32920\/25536163","title":["Data processing with time-based memory access"],"author":[{"given":"Nagi","family":"Mekhiel","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"URL":"https:\/\/doi.org\/10.32920\/25536163","issued":{"date-parts":[[2024,4,3]]},"abstract":"<jats:p>&lt;p&gt;Memory access in data processing is provided using a time-based technique in which memory locations are mapped to respectively corresponding periods of time during which they are made available for access.&lt;\/p&gt;<\/jats:p>"},{"DOI":"10.2172\/1971122","title":["COLLABORATIVE DEVELOPMENT PROJECTS - PHOTONIC MEMORY CONTROLLER MODULE (P-MCM)"],"author":[{"given":"Michael","family":"Schumacher","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"name":"Columbia University","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"URL":"https:\/\/doi.org\/10.2172\/1971122","published-print":{"date-parts":[[2023,4,24]]},"issued":{"date-parts":[[2023,4,24]]}},{"DOI":"10.1145\/3750555.3815161","title":["The Memory Substrate of Tomorrow: Resilient D