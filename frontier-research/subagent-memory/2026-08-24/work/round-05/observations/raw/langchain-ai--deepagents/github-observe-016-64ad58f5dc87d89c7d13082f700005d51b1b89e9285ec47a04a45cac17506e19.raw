04728db7ea4f97a506d506782\nparent 4f3aeab16713adb4a5cf8ead8d7a60163818543a\nauthor Hunter Lovell <40191806+hntrl@users.noreply.github.com> 1781132836 -0700\ncommitter GitHub <noreply@github.com> 1781132836 -0400\n\nchore(sdk): expose `create_sub_agent` (#3846)\n\nThere's been a couple of instances where we've wanted to reuse the inner\nsubagent factory outside of the middleware (e.g. using it as the single\nsource of truth for defining subagents in quickjs). This PR exposes that","verified_at":"2026-06-10T23:07:16Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/3577aa9ea45ef4488cbfbbcc07290ccf82bcc635","html_url":"https://github.com/langchain-ai/deepagents/commit/3577aa9ea45ef4488cbfbbcc07290ccf82bcc635","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/3577aa9ea45ef4488cbfbbcc07290ccf82bcc635/comments","author":{"login":"hntrl","id":40191806,"node_id":"MDQ6VXNlcjQwMTkxODA2","avatar_url":"https://avatars.githubusercontent.com/u/40191806?v=4","gravatar_id":"","url":"https://api.github.com/users/hntrl","html_url":"https://github.com/hntrl","followers_url":"https://api.github.com/users/hntrl/followers","following_url":"https://api.github.com/users/hntrl/following{/other_user}","gists_url":"https://api.github.com/users/hntrl/gists{/gist_id}","starred_url":"https://api.github.com/users/hntrl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hntrl/subscriptions","organizations_url":"https://api.github.com/users/hntrl/orgs","repos_url":"https://api.github.com/users/hntrl/repos","events_url":"https://api.github.com/users/hntrl/events{/privacy}","received_events_url":"https://api.github.com/users/hntrl/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"4f3aeab16713adb4a5cf8ead8d7a60163818543a","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4f3aeab16713adb4a5cf8ead8d7a60163818543a","html_url":"https://github.com/langchain-ai/deepagents/commit/4f3aeab16713adb4a5cf8ead8d7a60163818543a"}]},{"sha":"4f3aeab16713adb4a5cf8ead8d7a60163818543a","node_id":"C_kwDOPTymldoAKDRmM2FlYWIxNjcxM2FkYjRhNWNmOGVhZDhkN2E2MDE2MzgxODU0M2E","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-10T22:14:59Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-10T22:14:59Z"},"message":"test(evals): clarify summarization history recovery eval (#3853)\n\nThe summarization eval now focuses on the model-dependent behavior it is\nmeant to measure: whether the agent can use the summary's\n`conversation_history` reference to recover older context after\ncompaction. Deterministic filesystem checks are left to unit/e2e\ncoverage, keeping the eval thinner and easier to interpret.","tree":{"sha":"b1f5c4afdbcfc84d533600f1897db67779738467","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/b1f5c4afdbcfc84d533600f1897db67779738467"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/4f3aeab16713adb4a5cf8ead8d7a60163818543a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKeHjCRC1aQ7uu5UhlAAARjoQAAslMImhq6UWMXs8U9ZF5qo3\n/fMN6klGQNn+DqJUfYW09jybs8tbDPZNZZai2mRqjQhIRz+NMFCqTu8FESKVuZoY\ns3WOXfPmaa6Q3BPHZmPbSvrrW1kpZ5g1LvE21ch8kd/zH0YdepHs5oRIdW1bA1FG\nAF53qIaPNBXRVwHPyRaarYSnwnH8PHnciR0qHtdlkfN0MUUZzJvJM1FSlljTWije\n/1freh4dS+IVHOKPhR0vQpG55INKw9XQxNBrDLgJifRlT3HK33CsWijO8XQrb9YN\n9s+cxazlq2tkcDXwPhBo+dXT2n16sGpJr8a1wQcq+RD9QauLgWYYiiZXuoW86DXo\nOoZ5oA6iqJc9mlTQkhqT7xt/h7FmpjpuzCXrIjBEArCKZ7SHlTbfhf4d5sJQnuEv\nzcYvvmh/MKyasqiIiGOYrHVOGjh0aWu6bXGcx2jsE50if2jw9QJ3c9k3lDf6aD1/\nRaZV2bWi3lt2ejS0sq64s1sz8nzRjdSDYuQYqBfOhZ+NC/4rOKW3zgDaxNRvFJye\nRETHcST1PbyYgpl4k6/DVFZaYQiQkfKsc1ZezFh0W+r1GDRphXCJrd+KjZUqf0kb\n7OUuXlpwbuOcNCBddmgiXSbZxQlfKdvO5IrrIwZGWNxvq2I5lnlAckxrtGfyZ8L4\nsphDi5IAE6aimib97ZP9\n=T/je\n-----END PGP SIGNATURE-----\n","payload":"tree b1f5c4afdbcfc84d533600f1897db67779738467\nparent 1159e504abaeec4f81d5e777ecde6a6cee641edb\nauthor Mason Daugherty <mason@langchain.dev> 1781129699 -0400\ncommitter GitHub <noreply@github.com> 1781129699 -0400\n\ntest(evals): clarify summarization history recovery eval (#3853)\n\nThe summarization eval now focuses on the model-dependent behavior it is\nmeant to measure: whether the agent can use the summary's\n`conversation_history` reference to recover older context after\ncompaction. Deterministic filesystem checks are left to unit/e2e\ncoverage, keeping the eval thinner and easier to interpret.","verified_at":"2026-06-10T22:14:59Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4f3aeab16713adb4a5cf8ead8d7a60163818543a","html_url":"https://github.com/langchain-ai/deepagents/commit/4f3aeab16713adb4a5cf8ead8d7a60163818543a","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4f3aeab16713adb4a5cf8ead8d7a60163818543a/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"