ci(infra): clarify release guard annotations (#5577)\n\nRelease guard annotations now use descriptive titles and plain-English\nwait/defer messages, making in-flight publish status easier to scan in\nActions.\n\n---\n\nThe prior messages compressed timing, state, and the next action into\none jargon-heavy line. The revised annotations separate the title from\nthe explanation, spell out minutes, and clearly identify pending\npublishes without changing release behavior.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/55231642-5eba-0c26-43f3-db13b6a92d46)\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"3804ac6d415e6969fe1cba23301063823cc92f39","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/3804ac6d415e6969fe1cba23301063823cc92f39"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/257e0350f5a738f9ab9cc53344545c6b915ef8fe","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqhGimCRC1aQ7uu5UhlAAAgnMQABz6Lew80zO7bHHAHKrUC9CA\nMoDtaF1xV8dwTIUMdrJIbMjlcHzavAzaWavwa4ZY07VK0WZZkk8jw+CjjGIdZF2h\ns5mvwuE0s5/YmVt7aHFgPxyTcsbb6PNBAyf6WEC4yoPJxbHm8l/g0XlgL1Y50MGl\nzUAS58lJkNSdDT8HBups82cYMXBaav4IA4xiUYz1O6V0ktk0uvt9xUXl4YeSVLlz\n/9clo9rqM3AcTeNPBmxXhiqOPhuzv8rrtsfMw07hfCya8vxLJqeR/pLSUUg4qTLC\nATVxL7hLdtxdGzmgTBJI4NZRnCh5dRwWN20ojuwUQ/LiYTYP1dKpGBObijw48+bS\nFkLOP6e+SMo4LlT4XcvV3aHaPnfjlZL2EEAWAkUe5B5TNcRware2WPXpqdpgYKrT\nDfEJiVSVuWVDk49zS6CylAW9Cqrhrnqr8brttq5JABQBM6yb/zm0KB7ZiCmMnATR\npglIQQBBsmb27WzRG5oD5Ek1fbfDyNLnoQRFnswDabRjd/dIhcK4/9GmduNJPC6h\nUH3TgLHkn5iMrXw2tQ26KN2Z8kTIpYcsZ+0XkZ6AQ/TB9azoUY0BAi26RDxzJPaR\ntYs21CVhiYd1booEvS9hChPQaYZJmixm9d2HV7u2hEdicciTezkR8L0ufSsQqlPG\n+ZlghbzPzs4LtdU+/ic5\n=Jz+t\n-----END PGP SIGNATURE-----\n","payload":"tree 3804ac6d415e6969fe1cba23301063823cc92f39\nparent 57e15ea63a5c6c77ffde82dba0497e70cda52387\nauthor Mason Daugherty <mason@langchain.dev> 1787062438 -0400\ncommitter GitHub <noreply@github.com> 1787062438 -0400\n\nci(infra): clarify release guard annotations (#5577)\n\nRelease guard annotations now use descriptive titles and plain-English\nwait/defer messages, making in-flight publish status easier to scan in\nActions.\n\n---\n\nThe prior messages compressed timing, state, and the next action into\none jargon-heavy line. The revised annotations separate the title from\nthe explanation, spell out minutes, and clearly identify pending\npublishes without changing release behavior.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/55231642-5eba-0c26-43f3-db13b6a92d46)\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-08-18T14:13:58Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/257e0350f5a738f9ab9cc53344545c6b915ef8fe","html_url":"https://github.com/langchain-ai/deepagents/commit/257e0350f5a738f9ab9cc53344545c6b915ef8fe","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/257e0350f5a738f9ab9cc53344545c6b915ef8fe/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"57e15ea63a5c6c77ffde82dba0497e70cda52387","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/57e15ea63a5c6c77ffde82dba0497e70cda52387","html_url":"https://github.com/langchain-ai/deepagents/commit/57e15ea63a5c6c77ffde82dba0497e70cda52387"}]}]