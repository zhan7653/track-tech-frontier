ubusercontent.com/u/184293535?v=4","gravatar_id":"","url":"https://api.github.com/users/xl-openai","html_url":"https://github.com/xl-openai","followers_url":"https://api.github.com/users/xl-openai/followers","following_url":"https://api.github.com/users/xl-openai/following{/other_user}","gists_url":"https://api.github.com/users/xl-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/xl-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/xl-openai/subscriptions","organizations_url":"https://api.github.com/users/xl-openai/orgs","repos_url":"https://api.github.com/users/xl-openai/repos","events_url":"https://api.github.com/users/xl-openai/events{/privacy}","received_events_url":"https://api.github.com/users/xl-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"8ed38fe38eb99dd51a0eef33366a45a392733b82","url":"https://api.github.com/repos/openai/codex/commits/8ed38fe38eb99dd51a0eef33366a45a392733b82","html_url":"https://github.com/openai/codex/commit/8ed38fe38eb99dd51a0eef33366a45a392733b82"}]},{"sha":"8ed38fe38eb99dd51a0eef33366a45a392733b82","node_id":"C_kwDOOYsS4doAKDhlZDM4ZmUzOGViOTlkZDUxYTBlZWYzMzM2NmE0NWEzOTI3MzNiODI","commit":{"author":{"name":"efrazer-oai","email":"efrazer@openai.com","date":"2026-05-27T05:09:54Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T05:09:54Z"},"message":"fix: add noninteractive install script mode (#21567)\n\n# Summary\n\nThe Codex standalone installers can pause after installation to ask\nabout an older managed install or launching Codex. That makes unattended\nbootstrap and update flows hard to complete reliably.\n\nThis PR adds noninteractive installer control on macOS/Linux and Windows\nthrough `CODEX_NON_INTERACTIVE=1`. Noninteractive operation is\nenvironment-only, which gives automated callers one stable way to\nsuppress prompts. When a noninteractive install leaves an older npm,\nbun, or brew-managed Codex installed, the standalone bin is configured\nahead of that command on `PATH` so the newly installed Codex is the one\nfuture launches select. It also supports `CODEX_RELEASE` for callers\nthat select a release through environment variables while retaining the\nexisting explicit release inputs. Release selection accepts `latest`,\nstable `x.y.z` versions, and Codex prereleases written as\n`rust-v0.134.0-alpha.3`, `v0.134.0-alpha.3`, or `0.134.0-alpha.3`; it\nvalidates that shape before constructing release requests.\n\n# Stack\n\n1. [#21567](https://github.com/openai/codex/pull/21567) - Adds release\nand noninteractive environment controls to the installers. (current)\n2. [#24637](https://github.com/openai/codex/pull/24637) - Runs\nstandalone updater installs with `CODEX_NON_INTERACTIVE=1`.\n3. [#24639](https://github.com/openai/codex/pull/24639) - Removes\nexplicit release argument inputs in favor of `CODEX_RELEASE`.\n\n# Evidence\n\n| Before | After |\n| --- | --- |\n| ![Interactive install\nprompts](https://github.com/user-attachments/assets/feecb45a-7087-4681-8775-ba57b07e97fa)\n| ![Noninteractive install completes without\nprompts](https://github.com/user-attachments/assets/53dcc791-383a-46e2-9a95-3b37b80ae053)\n|\n\nEnvironment-controlled macOS install with an existing npm-managed Codex\non `PATH`:\n\n\nhttps://github.com/user-attachments/assets/442e0b5b-4a32-4bf5-996b-68784777380d\n\n# Design decisions\n\nWindows installs using the older standalone bin layout still require an\ninteractive migration confirmation. Noninteractive mode does not\nauto-migrate that existing directory because replacing it is a\ndestructive transition for an early, limited-use layout; unattended\ninstalls on that layout fail with an instruction to rerun interactively.\n\n# Testing\n\nTests: installer syntax validation, release-selector acceptance and\nrejection coverage including PowerShell `Latest` compatibility, macOS\nlive-terminal installer smoke testing with environment-controlled stable\nand prerelease installation and competing PATH precedence, shell\nrejection of the omitted noninteractive flag, and Windows ARM64\nPowerShell smoke testing with environment-only noninteractive behavior,\nretained release input, and competing PATH precedence through Parallels.","tree":{"sha":"2068afb7617f1e164fec0a64086044951ead3253","url":"https://api.github.com/repos/openai/codex/git/trees/2068afb7617f1e164fec0a64086044951ead3253"},"url":"https://api.github.com/repos/openai/codex/git/commits/8ed38fe38eb99dd51a0eef33366a45a392733b82","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqFnyiCRC1aQ7uu5UhlAAAGesQACmdlRLcIOfjT7uXiIrXbi+x\ngG+dhVNlmrExV7a/Y8lJNbQ61hrpDOcgfu4VpXZv3nX4F7LvRAmdwdzZVSaHMQJP\nUrLYzssf+xPfPdobHquxuwdUAI8Fr2KA/e+sPMEKkycI6iR+2u68FyV0V0b8Ysr0\n4cnQm/pEq008Bqu9x6w+ztLpSqPjyLS5GICEAaKKOIyqdjFMqJihXR0iI4dsO7CC\nWBXgin8EJpqYRsXjRgXDJqcmklVMIjYbWfG2PAVelFPeNDSHX9PrmQZFZRzvweVd\nqOnjEtWkM0kjKmD3sW+/YYO/Q45mqvGOiL4AFLOh30WxcGRTFndDJCFs5oRHldf4\ngKC8i9zg7z3PQN2WGEW6J/zAXUVSCH4BiYZ9+nveB8X+ivgUt90C1Gj8O2Wb7PO+\neppgFNffWkQFRf8rPJdiIgxeJGdyJzPProoeQO4VI3RHRrASnuF1enfdIrUgOrm1\nmwdTs+kHgwsWT6UldC2xxY7CkwTnoVFbhghryN73klDna5vz8MKyZlS5X6F6cF8b\nZ8GTOB5KVoMh5asGd3sK8WwAUZK4Czxp1LmuvkjHrUY/m4r7/nEbMcsBUuX+wMLB\nU4aL8T0HZLBV/DyAGQ9KgmjJBrkVVT/VZHjDFWfjsvNQcSB63WzPCq/pxmonD3zi\neGSgfrd63qSjSFKm1fGq\n=tyka\n-----END PGP SIGNATURE-----\n","payload":"tree 2068afb7617f1e164fec0a64086044951ead3253\nparent cca1e0ba1d3ea925d297dcbaca2f77c658fcf1bc\nauthor efrazer-oai <efrazer@openai.com> 1779858594 -0700\ncommitter GitHub <noreply@github.com> 1779858594 -0700\n\nfix: add noninteractive install script mode (#21567)\n\n# Summary\n\nThe Codex standalone installers can pause after installation to ask\nabout an older managed install or launching Codex. That makes unattended\nbootstrap and update flows hard to complete reliably.\n\nThis PR adds noninteractive installer control on macOS/Linux and Windows\nthrough `CODEX_NON_INTERACTIVE=1`. Noninteractive operation is\nenvironment-only, which gives automated callers one stable way to\nsuppress prompts. When a noninteractive install leaves an older npm,\nbun, or brew-managed Codex installed, the standalone bin is configured\nahead of that command on `PATH` so the newly installed Codex is the one\nfuture launches select. It also supports `CODEX_RELEASE` for callers\nthat select a release through environment variables while retaining the\nexisting explicit release inputs. Release selection accepts `latest`,\nstable `x.y.z` versions, and Codex prereleases written as\n`rust-v0.134.0-alpha.3`, `v0.134.0-alpha.3`, or `0.134.0-alpha.3`; it\nvalidates that shape before constructing release requests.\n\n# Stack\n\n1. [#21567](https://github.com/openai/codex/pull/21567) - Adds release\nand noninteractive environment controls to the installers. (current)\n2. [#24637](https://github.com/openai/codex/pull/24637) - Runs\nstandalone updater installs with `CODEX_NON_INTERACTIVE=1`.\n3. [#24639](https://github.com/openai/codex/pull/24639) - Removes\nexplicit release argument inputs in favor of `CODEX_RELEASE`.\n\n# Evidence\n\n| Before | After |\n| --- | --- |\n| ![Interactive install\nprompts](https://github.com/user-attachments/assets/feecb45a-7087-4681-8775-ba57b07e97fa)\n| ![Noninteractive install completes without\nprompts](https://github.com/user-attachments/assets/53dcc791-383a-46e2-9a95-3b37b80ae053)\n|\n\nEnvironment-controlled macOS install with an existing npm-managed Codex\non `PATH`:\n\n\nhttps://github.com/user-attachments/assets/442e0b5b-4a32-4bf5-996b-68784777380d\n\n# Design decisions\n\nWindows installs using the older standalone bin layout still require an\ninteractive migration confirmation. Noninteractive mode does not\nauto-migrate that existing directory because replacing it is a\ndestructive transition for an early, limited-use layout; unattended\ninstalls on that layout fail with an instruction to rerun interactively.\n\n# Testing\n\nTests: installer syntax validation, release-selector acceptance and\nrejection coverage including PowerShell `Latest` compatibility, macOS\nlive-terminal installer smoke testing with environment-controlled stable\nand prerelease installation and competing PATH precedence, shell\nrejection of the omitted noninteractive flag, and Windows ARM64\nPowerShell smoke testing with environment-only noninteractive behavior,\nretained release input, and competing PATH precedence through Parallels.","verified_at":"2026-05-27T05:09:55Z"}},"url":"https://api.github.com/repos/openai/codex/commits/8ed38fe38eb99dd51a0eef33366a45a392733b82","html_url":"https://github.com/openai/codex/commit/8ed38fe38eb99dd51a0eef33366a45a392733b82","comments_url":"https://api.github.com/repos/openai/codex/commits/8ed38fe38eb99dd51a0eef33366a45a392733b82/comments","author":{"login":"efrazer-oai","id":263771262,"node_id":"U_kgDOD7jUfg","avatar_url":"https://avatars.githubusercontent.com/u/263771262?v=4","gravatar_id":"","url":"https://api.github.com/users/efrazer-oai","html_url":"https://github.com/efrazer-oai","followers_url":"https://api.github.com/users/efrazer-oai/followers","following_url":"https://api.github.com/users/efrazer-oai/following{/other_user}","gists_url":"https://api.github.com/users/efrazer-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/efrazer-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/efrazer-oai/subscriptions","organizations_url":"https://api.github.com/users/efrazer-oai/orgs","repos_url":"https://api.github.com/users/efrazer-oai/repos","events_url":"https://api.github.com/users/efrazer-oai/events{/privacy}","received_events_url":"https://api.github.com/users/efrazer-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"cca1e0ba1d3ea925d297dcbaca2f77c658fcf1bc","url":"https://api.github.com/repos/openai/codex/commits/cca1e0ba1d3ea925d297dcbaca2f77c658fcf1bc","html_url":"https://github.com/openai/codex/commit/cca1e0ba1d3ea925d297dcbaca2f77c658fcf1bc"}]},{"sha":"cca1e0ba1d3ea925d297dcbaca2f77c658fcf1bc","node_id":"C_kwDOOYsS4doAKGNjYTFlMGJhMWQzZWE5MjVkMjk3ZGNiYWNhMmY3N2M2NThmY2YxYmM","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-05-27T03:59:47Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T03:59:47Z"},"message":"Uprev Rust toolchain pins to 1.95.0 (#24684)\n\n## Summary\n- Bump the workspace Rust toolchain from `1.93.0` to `1.95.0` across\nCargo, Bazel, CI, release workflows, devcontainers, and the Codex\nenvironment config.\n- Refresh `MODULE.bazel.lock` so the Bazel Rust toolchain artifacts\nmatch the new version.\n- Leave purpose-specific toolchains unchanged, including the\n`argument-comment-lint` nightly and the upstream `rusty_v8` `1.91.0`\nbuild pin.\n- Includes fixes for new lints from `just fix` and a few codex-authored\nfixes for lints without a suggestion.","tree":{"sha":"bc9c94435798c689406525f47ad2ba75fd275eff","url":"https://api.github.com/repos/openai/codex/git/trees/bc9c94435798c689406525f47ad2ba75fd275eff"},"url":"https://api.github.com/repos/openai/codex/git/commits/cca1e0ba1d3ea925d297dcbaca2f77c658fcf1bc","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqFmwzCRC1aQ7uu5UhlAAAjNkQAHucrBT7iMrJPW7bHtHsvI/a\n4bGGm48B/x3ZkYZzUrAY4YvFgsF82OGHKu8Wy1o7L4fzbqtNnH5nsesBQXY5rZRz\ndu44cfDf9ESfFiXb0oRPDT6bODe3KdvifuJobtd43y53ax4iZKxMO/jUc/uPI27q\nZqwgKItK8MBR2GkDmAAM3oGTI8GCjjB8T1sxo184XdNBvby7Sztse5BpdVbjDc31\nTgPZPJcCClc+zN2bEN/PIn+dyZTonKS6Tf5AQlZkAbsshNrf7IweVkC5AThOdCrS\n4Jf+aH0ivCauix7cGT5cjpeVkK61/qHJv+SABkBrYLg0apuaHS0W5OyWu4rUeOmc\nbk15i/7MwonOhYOszfMXRQ2IBbV3XE0wh4TzmRfnb5CpfPOl+MTBEQzdB17AVw18\nFP9Biiv1tUH8kzXTbVBF9veoL2D6y8yXxTyGdO/GS6YTxfFrmE3r7RJXhVRSrgw1\nDJHBab106zMt+mI6lKrdx/i9SmYLVeqWx+MGTqCTl/eJtrNx+1mQbfBjbozDtUiZ\noAuJHxr1+9bXmzMXIs88SpqLtU03jxoBp9zUP3n9+k5yX5UPE4/nspWa8SPc8MYP\nt1SMT8NE34ZqQZ8VZnOa3T1cfBGHrD3a0czIRcurZYFNCXNllPB/9I0wG7bTJDpr\ndTkQ3xLEhK7xjdiDWcLU\n=/0Mo\n-----END PGP SIGNATURE-----\n","payload":"tree bc9c94435798c689406525f47ad2ba75fd275eff\nparent 64e340ad2809a4da61ec12535a056bcf58f5d6ef\nauthor Adam Perry @ OpenAI <anp@openai.com> 1779854387 -0700\ncommitter GitHub <noreply@github.com> 1779854387 -0700\n\nUprev Rust toolchain pins to 1.95.0 (#24684)\n\n## Summary\n- Bump the workspace Rust toolchain from `1.93.0` to `1.95.0` across\nCargo, Bazel, CI, release workflows, devcontainers, and the Codex\nenvironment config.\n- Refresh `MODULE.bazel.lock` so the Bazel Rust toolchain artifacts\nmatch the new version.\n- Leave purpose-specific toolchains unchanged, including the\n`argument-comment-lint` nightly and the upstream `rusty_v8` `1.91.0`\nbuild pin.\n- Includes fixes for new lints from `just fix` and a few codex-authored\nfixes for lints without a suggestion.","verified_at":"2026-05-27T03:59:48Z"}},"url":"https://api.github.com/repos/openai/codex/commits/cca1e0ba1d3ea925d297dcbaca2f77c658fcf1bc","html_url":"https://github.com/openai/codex/commit/cca1e0ba1d3ea925d297dcbaca2f77c658fcf1bc","comments_url":"https://api.github.com/repos/openai/codex/commits/cca1e0ba1d3ea925d297dcbaca2f77c658fcf1bc/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"64e340ad2809a4da61ec12535a056bcf58f5d6ef","url":"https://api.github.com/repos/openai/codex/commits/64e340ad2809a4da61ec12535a056bcf58f5d6ef","html_url":"https://github.com/openai/codex/commit/64e340ad2809a4da61ec12535a056bcf58f5d6ef"}]},{"sha":"64e340ad2809a4da61ec12535a056bcf58f5d6ef","node_id":"C_kwDOOYsS4doAKDY0ZTM0MGFkMjgwOWE0ZGE2MWVjMTI1MzVhMDU2YmNmNThmNWQ2ZWY","commit":{"author":{"name":"Anton Panasenko","email":"apanasenko@openai.com","date":"2026-05-27T02:00:40Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T02:00:40Z"},"message":"fix(core): instrument stalled tool-listing handoff (#24667)\n\n## Why\n\nWhen a turn needs a follow-up request after tool output is recorded,\nCodex can still appear stuck in `Thinking` before the next `/responses`\nrequest is opened. The existing local trace showed the last completed\nresponse and the absence of a new backend request, but it did not show\nwhether the stall was in tool-router preparation or later request setup.\n\nIssue: N/A (internal incident investigation)\n\n## What Changed\n\nAdded trace spans around the pre-stream tool-router handoff in\n`core/src/session/turn.rs`, including the `built_tools` phase and the\nMCP manager read lock.\n\nAdded per-server MCP tool-listing spans and trace breadcrumbs in\n`codex-mcp/src/connection_manager.rs` with startup snapshot /\nstartup-complete state so a pending MCP client is visible in feedback\nlogs instead of looking like a silent hang.\n\n## Verification\n\n- `just fmt`\n- `just test -p codex-mcp`\n- `just test -p codex-core` (prior full rerun fails in this workspace on\nunrelated integration tests: code-mode output length expectations, one\nshell timeout formatting assertion, and shell snapshot timeouts; latest\nreview-fix rerun compiled and passed 1160 tests before I stopped the\nabnormally slow unrelated suite)","tree":{"sha":"06322e5134ec85e9b801aecca0287c43ca2891d8","url":"https://api.github.com/repos/openai/codex/git/trees/06322e5134ec85e9b801aecca0287c43ca2891d8"},"url":"https://api.github.com/repos/openai/codex/git/commits/64e340ad2809a4da61ec12535a056bcf58f5d6ef","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqFlBICRC1aQ7uu5UhlAAAKXEQAGQ25+7kHvmaK4MlmifYIZCc\nAjQW7rnf7WB+JpfifK+P5Gz9CyXL404zc6OwgHuJWKlohUkQvtAlmHk15raiwVs4\n6heYcgyBlw0FNRtVc+p/KiTYM0y1sJPQgDwKdXtkKEoWip2nxs08QHxUyjJohafk\n2aFO6J4JerQc3wLDmvBd3uqX6ax0T9PoCzVwxa3nnbMAYu70Ge20aS1LELFOvzJE\nX0iLwA5dTXUQGywIaZptnkgLO7Lb7UQkACh4/HUrRFjcM47ZGpHfz7HGvz+Npz29\nRPZH+JFSn9WXSPlHatmquurrqWq74WKfreECQCI48RnKD7KVqdhqUtlpljKCEyZM\n/c9Tc6jkYLA4i0hWXK38shHzYCI5C59O2JPy77btSIiRxx6Y1MRi0x5sMZ0cipfV\n75vRLKKxTAbfUS08J3xpPxpRg4pajhfht7LzSpmeBd/oZvUCyl8vzxGbtk0bjdE8\nUZkh3MbBio3EMilcZssSrKLgJ0d1bx1rva7RaFVs9U12+kcWTXAhZB4aGfuhfxpi\nsdGhbamTc4owz15b2iRReRFy0J9YuYottjrTbPyBsm2y+0S7O9RxJf9x/OU4NBNv\nullva076C0Odg0zOCmdce9GIzNy2YwbKtKeQwoMS2H5fngFbYq9+8vsR+7i/kmMi\npxEbHc+vuWkwzjypctQA\n=6MUk\n-----END PGP SIGNATURE-----\n","payload":"tree 06322e5134ec85e9b801aecca0287c43ca2891d8\nparent 9fe55d68e6e1d850642cd2fc5039ae76d1213dad\nauthor Anton Panasenko <apanasenko@openai.com> 1779847240 -0700\ncommitter GitHub <noreply@github.com> 1779847240 +0000\n\nfix(core): instrument stalled tool-listing handoff (#24667)\n\n## Why\n\nWhen a turn needs a follow-up request after tool output is recorded,\nCodex can still appear stuck in `Thinking` before the next `/responses`\nrequest is opened. The existing local trace showed the last completed\nresponse and the absence of a new backend request, but it did not show\nwhether the stall was in tool-router preparation or later request setup.\n\nIssue: N/A (internal incident investigation)\n\n## What Changed\n\nAdded trace spans around the pre-stream tool-router handoff in\n`core/src/session/turn.rs`, including the `built_tools` phase and the\nMCP manager read lock.\n\nAdded per-server MCP tool-listing spans and trace breadcrumbs in\n`codex-mcp/src/connection_manager.rs` with startup snapshot /\nstartup-complete state so a pending MCP client is visible in feedback\nlogs instead of looking like a silent hang.\n\n## Verification\n\n- `just fmt`\n- `just test -p codex-mcp`\n- `just test -p codex-core` (prior full rerun fails in this workspace on\nunrelated integration tests: code-mode output length expectations, one\nshell timeout formatting assertion, and shell snapshot timeouts; latest\nreview-fix rerun compiled and passed 1160 tests before I stopped the\nabnormally slow unrelated suite)","verified_at":"2026-05-27T02:00:41Z"}},"url":"https://api.github.com/repos/openai/codex/commits/64e340ad2809a4da61ec12535a056bcf58f5d6ef","html_url":"https://github.com/openai/codex/commit/64e340ad2809a4da61ec12535a056bcf58f5d6ef","comments_url":"https://api.github.com/repos/openai/codex/commits/64e340ad2809a4da61ec12535a056bcf58f5d6ef/comments","author":{"login":"apanasenko-oai","id":228802911,"node_id":"U_kgDODaNBXw","avatar_url":"https://avatars.githubusercontent.com/u/228802911?v=4","gravatar_id":"","url":"https://api.github.com/users/apanasenko-oai","html_url":"https://github.com/apanasenko-oai","followers_url":"https://api.github.com/users/apanasenko-oai/followers","following_url":"https://api.github.com/users/apanasenko-oai/following{/other_user}","gists_url":"https://api.github.com/users/apanasenko-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/apanasenko-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/apanasenko-oai/subscriptions","organizations_url":"https://api.github.com/users/apanasenko-oai/orgs","repos_url":"https://api.github.com/users/apanasenko-oai/repos","events_url":"https://api.github.com/users/apanasenko-oai/events{/privacy}","received_events_url":"https://api.github.com/users/apanasenko-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"9fe55d68e6e1d850642cd2fc5039ae76d1213dad","url":"https://api.github.com/repos/openai/codex/commits/9fe55d68e6e1d850642cd2fc5039ae76d1213dad","html_url":"https://github.com/openai/codex/commit/9fe55d68e6e1d850642cd2fc5039ae76d1213dad"}]},{"sha":"9fe55d68e6e1d850642cd2fc5039ae76d1213dad","node_id":"C_kwDOOYsS4doAKDlmZTU1ZDY4ZTZlMWQ4NTA2NDJjZDJmYzUwMzlhZTc2ZDEyMTNkYWQ","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-05-27T01:05:19Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T01:05:19Z"},"message":"fix: dont compact standalone websearch schema (#24660)\n\nadd new `parse_tool_input_schema_without_compaction` to bypass the\nexisting compaction/trimming of client-provided tool schemas that are\nover 4k bytes.\n\nwe want this for standalone web search to keep field guidance/metadata\non certain fields; this keeps us closer to parity with existing hosted\ntool schema (which didnt go through this 4k byte filter).","tree":{"sha":"de01013bec28e18351eba4276938ec21c16ca410","url":"https://api.github.com/repos/openai/codex/git/trees/de01013bec28e18351eba4276938ec21c16ca410"},"url":"https://api.github.com/repos/openai/codex/git/commits/9fe55d68e6e1d850642cd2fc5039ae76d1213dad","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqFkNPCRC1aQ7uu5UhlAAAQnsQAJuXEkKfq2e7UaK1+OgZ7kyd\n4wCSyLfxfeE9Dq/BMIF0WGii3OoZ6Kx7Uek86EMCVhIQ8vDYd2lKkCm2p2cCQ3Dt\nMpalTe5Fcd9MUk94bpVNsW9aDobGm+cPgmnRDrfnxGCmdkudlStvDE2bbb0ULhF7\nonYN79YI1Lype/k6ztNXvaPJXg/sz0I/rYvyyY9Qgbay+FSqbmbdpxLESHdhbx9X\nZLSoqeQPAvpKzMAZdcZDBVW+3LP6HDngPQ4Kgwkw4UcrBkisrw4yHXJ8Pptug3Na\nWZohfogXssvaeffJcz69iShTddJhIWkMVG9/663BxLlHvHVKU4cosLDlkGTfaaxx\nQUVmWhzjOdxQt0wAYjIr8EBVRzcR5Zle7UUWRo7wOrrtRSu+ZVg+xsnioyh3s9mH\nkoZkwY7SW/lqF+qjKhM9h1rJYHxitAgzDarYoH4M3KqVSDj3SX2f4WAH1ZnAFSN9\nKTo7Je+5UgT19Y89Kw2M3MBgrJ2ArWY/Ukf8X0o+ujxK22Y+CwXrSv+RHYhLmKqz\nSLG8Yt9VRRR4VSaOQQw9uVS4KuOZUqVMC6sf4HuSxWk9BMb2KXh8nUFseYbfogze\n5hNs+3Mw8IUWyzsb2fSBvEVzFif2+whANIZkjeSu6x7Crj4sRpNmEudVLtVrpPuz\nGiY0oREGHWqLWsk76zmA\n=PXn2\n-----END PGP SIGNATURE-----\n","payload":"tree de01013bec28e18351eba4276938ec21c16ca410\nparent 0d37db4b2b10b56991566b3512b0677754733835\nauthor sayan-oai <sayan@openai.com> 1779843919 -0700\ncommitter GitHub <noreply@github.com> 1779843919 +0000\n\nfix: dont compact standalone websearch schema (#24660)\n\nadd new `parse_tool_input_schema_without_compaction` to bypass the\nexisting compaction/trimming of client-provided tool schemas that are\nover 4k bytes.\n\nwe want this for standalone web search to keep field guidance/metadata\non certain fields; this keeps us closer to parity with existing hosted\ntool schema (which didnt go through this 4k byte filter).","verified_at":"2026-05-27T01:05:19Z"}},"url":"https://api.github.com/repos/openai/codex/commits/9fe55d68e6e1d850642cd2fc5039ae76d1213dad","html_url":"https://github.com/openai/codex/commit/9fe55d68e6e1d850642cd2fc5039ae76d1213dad","comments_url":"https://api.github.com/repos/openai/codex/commits/9fe55d68e6e1d850642cd2fc5039ae76d1213dad/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"0d37db4b2b10b56991566b3512b0677754733835","url":"https://api.github.com/repos/openai/codex/commits/0d37db4b2b10b56991566b3512b0677754733835","html_url":"https://github.com/openai/codex/commit/0d37db4b2b10b56991566b3512b0677754733835"}]},{"sha":"0d37db4b2b10b56991566b3512b0677754733835","node_id":"C_kwDOOYsS4doAKDBkMzdkYjRiMmIxMGI1Njk5MTU2NmIzNTEyYjA2Nzc3NTQ3MzM4MzU","commit":{"author":{"name":"pakrym-oai","email":"pakrym@openai.com","date":"2026-05-27T00:19:02Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T00:19:02Z"},"message":"[codex] Remove obsolete goal continuation turn marker (#24658)\n\n## Why\n\n`continuation_turn_id` was introduced to distinguish synthetic goal\ncontinuation turns for the no-tool continuation suppression heuristic.\n#20523 removed that heuristic, but left the marker behind. It is still\nwritten and cleared without affecting any runtime decision.\n\n## What Changed\n\n- Remove `GoalRuntimeState::continuation_turn_id`.\n- Remove the marker setter/clearer and their now-no-op start, finish,\nand abort call sites.\n\n## Testing\n\n- Not run yet (deferred at request).","tree":{"sha":"52c747809affc8d22c8c146e73b10654ea287fdc","url":"https://api.github.com/repos/openai/codex/git/trees/52c747809affc8d22c8c146e73b10654ea287fdc"},"url":"https://api.github.com/repos/openai/codex/git/commits/0d37db4b2b10b56991566b3512b0677754733835","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqFjh2CRC1aQ7uu5UhlAAAKPwQAAaBOatTKcrl4b0cR6YXXY55\n4CcNooKf/q69kAEjFhHRvyQQA/s19O1eVGP8aYM8V0nuIlT33eKALj/OgOMCc4z4\nHMBfAapXMyC3wYCGZJpS4Ee/1eLVptNSfF/7lNYE5Pi1FUVs58zjKnUxMFFo3Zd4\nlGizvLNszgqSRxT0vvgfRlzWpW5CGL3hjbgSY8zL/hb0k59pUKfO8JbXKJcxe4U+\nwTgywYF8zWVo8Nv1wIBguEWFqnQfuxoU/q/nl3kwVC2LKn7O4d6ZRO6xU/06NukV\ngm/UP6K7vcJdrXtjryYH9plnCOKw1rxtv/wKY3tNox/inelHPj58F3dPHpnV3oqu\nBIhHVO1Cr2bKw71HDM/l9sT1sX9/JCEqHIjxKx6AHFCMyPepWqOlFdzD9r8ZehtQ\nUxq1WpeAvMegSr2kMt8887xyBYFO8EyW1rqNCXdc7A5X4KkzsRBcTMx8vkG3Rk4i\nZ2SXsjQLQv5sfaqJwEn+Fr83b3IFuPY0nR3UpAARcJdMcEhvZz8gOSEontOH4+Iq\npZrHMRNJMKoNkXXVLfdLRL/VkTBE4oZ1LxZRq1YqG4sESVMS4KPWyoFtITnjrTxA\npr1LEPfK0uliypO8rHbDzRrBtk2HUVDuh7dPseBYp9Un0XVR/SJVHrDJkuoswztH\n4kEtCDbQyJJX3DlsHdDZ\n=YWRK\n-----END PGP SIGNATURE-----\n","payload":"tree 52c747809affc8d22c8c146e73b10654ea287fdc\nparent 487521733bea0a0a37559cffb519a1f6fb6bb444\nauthor pakrym-oai <pakrym@openai.com> 1779841142 -0700\ncommitter GitHub <noreply@github.com> 1779841142 -0700\n\n[codex] Remove obsolete goal continuation turn marker (#24658)\n\n## Why\n\n`continuation_turn_id` was introduced to distinguish synthetic goal\ncontinuation turns for the no-tool continuation suppression heuristic.\n#20523 removed that heuristic, but left the marker behind. It is still\nwritten and cleared without affecting any runtime decision.\n\n## What Changed\n\n- Remove `GoalRuntimeState::continuation_turn_id`.\n- Remove the marker setter/clearer and their now-no-op start, finish,\nand abort call sites.\n\n## Testing\n\n- Not run yet (deferred at request).","verified_at":"2026-05-27T00:19:02Z"}},"url":"https://api.github.com/repos/openai/codex/commits/0d37db4b2b10b56991566b3512b0677754733835","html_url":"https://github.com/openai/codex/commit/0d37db4b2b10b56991566b3512b0677754733835","comments_url":"https://api.github.com/repos/openai/codex/commits/0d37db4b2b10b56991566b3512b0677754733835/comments","author":{"login":"pakrym-oai","id":204937752,"node_id":"U_kgDODDcaGA","avatar_url":"https://avatars.githubusercontent.com/u/204937752?v=4","gravatar_id":"","url":"https://api.github.com/users/pakrym-oai","html_url":"https://github.com/pakrym-oai","followers_url":"https://api.github.com/users/pakrym-oai/followers","following_url":"https://api.github.com/users/pakrym-oai/following{/other_user}","gists_url":"https://api.github.com/users/pakrym-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/pakrym-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pakrym-oai/subscriptions","organizations_url":"https://api.github.com/users/pakrym-oai/orgs","repos_url":"https://api.github.com/users/pakrym-oai/repos","events_url":"https://api.github.com/users/pakrym-oai/events{/privacy}","received_events_url":"https://api.github.com/users/pakrym-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.g