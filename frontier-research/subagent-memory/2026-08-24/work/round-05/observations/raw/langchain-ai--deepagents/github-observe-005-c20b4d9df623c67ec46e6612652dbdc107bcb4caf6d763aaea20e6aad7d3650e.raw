c3221aab5e0c0300cc5f5bec519","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a78d7b1744050c3221aab5e0c0300cc5f5bec519","html_url":"https://github.com/langchain-ai/deepagents/commit/a78d7b1744050c3221aab5e0c0300cc5f5bec519"}]},{"sha":"a78d7b1744050c3221aab5e0c0300cc5f5bec519","node_id":"C_kwDOPTymldoAKGE3OGQ3YjE3NDQwNTBjMzIyMWFhYjVlMGMwMzAwY2M1ZjViZWM1MTk","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-08-12T05:45:34Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-12T05:45:34Z"},"message":"fix(code): indent wrapped ask-user choices and add selection styling (#5442)\n\nWrapped ask-user choice labels now align continuation lines with the\nlabel text instead of the selection cursor, and the selected choice is\nhighlighted in the theme primary color with bullet markers on all\noptions for visual separation.\n\n---\n\n`InlinePromptOption` now reserves a fixed cursor gutter and wraps labels\nin a separate column. The narrow-width widget test covers the hanging\nindent.\n\nThe selected option's label renders in the theme primary color via a new\ndefault `selected_class`. Unselected options show a bullet (`•`) in the\ncursor gutter (overridable via `_unselected_marker`) so the start of\neach option is visually distinct from wrapped continuation lines.\nGoal-review options are unaffected — they keep their existing blank\ngutter and explicit `selected_class`.\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"4123b7c7d1a4ad6f8ba8783b02a85b5c9bc889df","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/4123b7c7d1a4ad6f8ba8783b02a85b5c9bc889df"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/a78d7b1744050c3221aab5e0c0300cc5f5bec519","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqfAh+CRC1aQ7uu5UhlAAAl74QAIzbP2fxS4mItVbFtri29Hv7\nShwjWV1+nyk0GfBwuzdl9vBj9B2amvlF6HXSi3mILkXyXFhoKxMZiBwrsmB8F1Vu\nwz2Zrdc9TUOxBgFELXZkw1VLBVjJdsyv76HfX5q/er3dzg+UGXD99hHryp1JoDr6\nedXe/MuyCQqpU/7IkRQ9kDndPZhLFCOtazhRrL4ai6uALsQo5GjLcRvDQG+Rl/Ed\nN119+ybqMTAeeWMOyXV46lQYFB9gLLKaR2qBzdPiVqDwnaFbdQXLbaKsIJl0QfgY\nJbMLsrFhpFdmQ2GQaSw0/7EE4MYbQkiWSPJBL/YwKuFGWMlx6ddaRnkDVBdApVY0\ngBv/EDQoacTDgKFCXJI3a+7WZZfn6iCysjXieNwl1nV+0VM1a2ypuHv8jHW+bzOH\nijO5svx486i7eNNG2fKaUI9aLKkFYsOJpdSANKrwoh3Arw1yYgKJCfwcZIhzDMW3\nwt9w6kkyX2uLQvTiOa7bAqzZaP9CCr1a3hXGKa6rCPvXY3oew9u7P+OB92KK14+r\nwmQvwim438wX96WKSMGFVuy4jELpRNA0OwJ5Am2rXmyiK1e3y04cKh4OQ82yB5fl\neWsxsgIv/P4lwr6+SoTbtb6PES/sfyyIxZTigmhQlZmFnMS6rT9x9tWRXedmhygK\nN6g09VC20iG4YsZNmjv+\n=Jp6q\n-----END PGP SIGNATURE-----\n","payload":"tree 4123b7c7d1a4ad6f8ba8783b02a85b5c9bc889df\nparent 4b8085992f6425e1718811c35b3811e720560373\nauthor Mason Daugherty <mason@langchain.dev> 1786513534 -0700\ncommitter GitHub <noreply@github.com> 1786513534 -0700\n\nfix(code): indent wrapped ask-user choices and add selection styling (#5442)\n\nWrapped ask-user choice labels now align continuation lines with the\nlabel text instead of the selection cursor, and the selected choice is\nhighlighted in the theme primary color with bullet markers on all\noptions for visual separation.\n\n---\n\n`InlinePromptOption` now reserves a fixed cursor gutter and wraps labels\nin a separate column. The narrow-width widget test covers the hanging\nindent.\n\nThe selected option's label renders in the theme primary color via a new\ndefault `selected_class`. Unselected options show a bullet (`•`) in the\ncursor gutter (overridable via `_unselected_marker`) so the start of\neach option is visually distinct from wrapped continuation lines.\nGoal-review options are unaffected — they keep their existing blank\ngutter and explicit `selected_class`.\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-08-12T05:45:37Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a78d7b1744050c3221aab5e0c0300cc5f5bec519","html_url":"https://github.com/langchain-ai/deepagents/commit/a78d7b1744050c3221aab5e0c0300cc5f5bec519","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a78d7b1744050c3221aab5e0c0300cc5f5bec519/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"4b8085992f6425e1718811c35b3811e720560373","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4b8085992f6425e1718811c35b3811e720560373","html_url":"https://github.com/langchain-ai/deepagents/commit/4b8085992f6425e1718811c35b3811e720560373"}]},{"sha":"4b8085992f6425e1718811c35b3811e720560373","node_id":"C_kwDOPTymldoAKDRiODA4NTk5MmY2NDI1ZTE3MTg4MTFjMzViMzgxMWU3MjA1NjAzNzM","commit":{"author":{"name":"Hunter Lovell","email":"40191806+hntrl@users.noreply.github.com","date":"2026-08-12T05:24:33Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-12T05:24:33Z"},"message":"chore(infra): adopt stale action for issue/pr cleanup (#5435)\n\nAutomatically closes issues and PRs awaiting an author response ten days\nafter they are labeled `needs-response`, while clearing the label when\nthe original author explicitly replies.\n\n---\n\nThe `needs_response.yml` workflow runs every six hours and only\nprocesses items that maintainers explicitly label. It never applies\n`needs-response` itself, skips draft PRs and items labeled\n`do-not-close`, and measures the timeout from the label's most recent\napplication. Unrelated activity therefore does not restart the wait\nperiod, and maintainers can ask their question before or after applying\nthe label.\n\nAuthor responses clear the label from issue and PR conversation\ncomments, review-thread replies, and submitted reviews. The scheduled\njob verifies this before closing as a fallback. Pushing commits does not\nclear the label, so a maintainer decides whether the change addressed\ntheir question. Keeping those paths in the same workflow makes\n`remove_waiting_on_author.yml` redundant, so it is removed.\n\nThis also upgrades `setup-uv` to v9 while retaining cache pruning,\ndisables caching in lockfile-only jobs where no cache directory is\ncreated, and routes release-please through the shared pinned uv setup\ninstead of resolving the latest uv release at runtime.\n\n---------\n\nCo-authored-by: Mason Daugherty <github@mdrxy.com>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>","tree":{"sha":"83d253afc59346a0536a55d6a8d7505dc5d08e10","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/83d253afc59346a0536a55d6a8d7505dc5d08e10"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/4b8085992f6425e1718811c35b3811e720560373","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqfAORCRC1aQ7uu5UhlAAAfqcQAGLcgc536CSZmYqa72HVrC+S\nLEGN5C88ICghCMXffjEfRLHvWardnwWTKPNX0pTr3e8dvkpyo1XNj/aH8fbj8Z9H\n1zr2pEXJonvFc3HEhKE0B/AOZRgumEqHK64nwg12PbR/KRJW2JPSZPwmCNRM6WXz\nhUpkEdW3g1O0n9RlTU2D3bL6xjgd6Xl/l94rgQMFHBPyy0zMwIr8ofCaPAP8Prz4\nQ/2MwdNXdH5oyU7qFPyeXSHWZ6v3Jya575sU0xcO2vcgMcALbbcbkjgUYjT6batq\nOG6bBHlSQ+o1+AvdFXS4un6wITMWSR0Xp+4bFaol32G8ZXDxJJ+GoXp5h4N0rEY+\nVyfsHS73pLdxe/3NU+oSn3RSNJ2ILCHKDyUuGX0d/x4A3haZ2+ayYdEwDzRCPIT+\nzzJwEw9LB6aJ5y/sOv1lXFj/5xazT0uOpgWXnnJKYltziRczzuRhqISDo+8tnc4a\nmCrM9bIdkp6sRjLEuoE2P8URavIrDT29Whme2VZXV0XERoM0Izx5gQPcoka0ctAu\nxSs8W0AfY4mQUPUHyUqmhi9cDs3adG5YDkgfKyhs09W4Ih/kts5sQFisC1HCeTRK\nag2HR2iPcwI1OIKSRttyN5IBw0PAFHezHxGGFjiaZn6DzytC9kKNPcS0dekdiMdJ\n/CdRo92paaVtbAFzX3No\n=LqLi\n-----END PGP SIGNATURE-----\n","payload":"tree 83d253afc59346a0536a55d6a8d7505dc5d08e10\nparent 4411a6c9a8870373cc876e2deb17a1810f14c44b\nauthor Hunter Lovell <40191806+hntrl@users.noreply.github.com> 1786512273 -0700\ncommitter GitHub <noreply@github.com> 1786512273 -0700\n\nchore(infra): adopt stale action for issue/pr cleanup (#5435)\n\nAutomatically closes issues and PRs awaiting an author response ten days\nafter they are labeled `needs-response`, while clearing the label when\nthe original author explicitly replies.\n\n---\n\nThe `needs_response.yml` workflow runs every six hours and only\nprocesses items that maintainers explicitly label. It never applies\n`needs-response` itself, skips draft PRs and items labeled\n`do-not-close`, and measures the timeout from the label's most recent\napplication. Unrelated activity therefore does not restart the wait\nperiod, and maintainers can ask their question before or after applying\nthe label.\n\nAuthor responses clear the label from issue and PR conversation\ncomments, review-thread replies, and submitted reviews. The scheduled\njob verifies this before closing as a fallback. Pushing commits does not\nclear the label, so a maintainer decides whether the change addressed\ntheir question. Keeping those paths in the same workflow makes\n`remove_waiting_on_author.yml` redundant, so it is removed.\n\nThis also upgrades `setup-uv` to v9 while retaining cache pruning,\ndisables caching in lockfile-only jobs where no cache directory is\ncreated, and routes release-please through the shared pinned uv setup\ninstead of resolving the latest uv release at runtime.\n\n---------\n\nCo-authored-by: Mason Daugherty <github@mdrxy.com>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>","verified_at":"2026-08-12T05:24:36Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4b8085992f6425e1718811c35b3811e720560373","html_url":"https://github.com/langchain-ai/deepagents/commit/4b8085992f6425e1718811c35b3811e720560373","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4b8085992f6425e1718811c35b3811e720560373/comments","author":{"login":"hntrl","id":40191806,"node_id":"MDQ6VXNlcjQwMTkxODA2","avatar_url":"https://avatars.githubusercontent.com/u/40191806?v=4","gravatar_id":"","url":"https://api.github.com/users/hntrl","html_url":"https://github.com/hntrl","followers_url":"https://api.github.com/users/hntrl/followers","following_url":"https://api.github.com/users/hntrl/following{/other_user}","gists_url":"https://api.github.com/users/hntrl/gists{/gist_id}","starred_url":"https://api.github.com/users/hntrl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hntrl/subscriptions","organizations_url":"https://api.github.com/users/hntrl/orgs","repos_url":"https://api.github.com/users/hntrl/repos","events_url":"https://api.github.com/users/hntrl/events{/privacy}","received_events_url":"https://api.github.com/users/hntrl/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"4411a6c9a8870373cc876e2deb17a1810f14c44b","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4411a6c9a8870373cc876e2deb17a1810f14c44b","html_url":"https://github.com/langchain-ai/deepagents/commit/4411a6c9a8870373cc876e2deb17a1810f14c44b"}]},{"sha":"4411a6c9a8870373cc876e2deb17a1810f14c44b","node_id":"C_kwDOPTymldoAKDQ0MTFhNmM5YTg4NzAzNzNjYzg3NmUyZGViMTdhMTgxMGYxNGM0NGI","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-08-12T04:13:58Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-12T04:13:58Z"},"message":"test(code): restore leaked model settings in `apply_to_settings` test (#5440)\n\nStatus bar tests could fail depending on which order tests ran in,\nbecause one config test changed the app's model settings and never\nchanged them back. That test now restores the settings it touches, and\nthe status bar's \"unknown context limit\" display gets its own test\ninstead of being covered only as a side effect of a cost test.","tree":{"sha":"68a977444204dcff8de112364ee12d236ce1f885","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/68a977444204dcff8de112364ee12d236ce1f885"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/4411a6c9a8870373cc876e2deb17a1810f14c44b","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqe/MGCRC1aQ7uu5UhlAAA1G8QALHzV4sgAEoVbEP/S4syXaFE\nkRKtapyNZAR0RcMQtLzgC8ZlGjvV3xySVarqQlM/gWUcY3oHofAvATTQvhrp38I9\nihkwmGehnZwmyIc51e9ur6A680QNiUXYRNDsnKg1OHLVcs+EOKKR6mpCRVWJpjOG\nn8hzZ74oQc6LqX6qt9NavpiaTdai1dJiLZ9BH7q/QBu11gsYhy/QYICn49z6TaaA\nt8jZ78JlshGZBycVckTiAw56zFcSkabvtJtG20/gl9jPxFk0tQvSo0CM6DnM2Sp/\nmlmGu9do7lrz4sMdXuaQxSuy3o52nYmNzcdQ2rxya9Ht4aD3dWBRzQafIjZfl1ty\niF6ktsSzmLD4WVrF9NOkONptV1gC3qMeJj9ijGaMH+Px8rc8ILEzY0VeqrDENNRH\n2n5J/QIp2X7XZt4pqBO7DSLwmQvceNWHKQbE+vCSem8yXnnF1TuvKtdpjh00qZJk\npujjGEnw110GWMg5Cu6F0Xu48kp9q9jsR1kWWX7KhZPNZqRB3Iduxydr0RtwUXwx\neuvQyr6j+B1pd0QPi5hbGT+f2ScfcB1cVFkFn1d5IHyLfBXXliEgWfcnvGFolMsm\nYTsS2Z2cwXuUfzyHjsBzoZckWEYBO0F/VZK86EnGVbwyYTRyuMibwscg9+UryWjy\nvVv/YroUE7FizH9wmS46\n=eICQ\n-----END PGP SIGNATURE-----\n","payload":"tree 68a977444204dcff8de112364ee12d236ce1f885\nparent 4cd21b61592ef0239f59cf4e3f27a2a70d226737\nauthor Mason Daugherty <mason@langchain.dev> 1786508038 -0700\ncommitter GitHub <noreply@github.com> 1786508038 -0700\n\ntest(code): restore leaked model settings in `apply_to_settings` test (#5440)\n\nStatus bar tests could fail depending on which order tests ran in,\nbecause one config test changed the app's model settings and never\nchanged them back. That test now restores the settings it touches, and\nthe status bar's \"unknown context limit\" display gets its own test\ninstead of being covered only as a side effect of a cost test.","verified_at":"2026-08-12T04:14:01Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4411a6c9a8870373cc876e2deb17a1810f14c44b","html_url":"https://github.com/langchain-ai/deepagents/commit/4411a6c9a8870373cc876e2deb17a1810f14c44b","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4411a6c9a8870373cc876e2deb17a1810f14c44b/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"4cd21b61592ef0239f59cf4e3f27a2a70d226737","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4cd21b61592ef0239f59cf4e3f27a2a70d226737","html_url":"https://github.com/langchain-ai/deepagents/commit/4cd21b61592ef0239f59cf4e3f27a2a70d226737"}]},{"sha":"4cd21b61592ef0239f59cf4e3f27a2a70d226737","node_id":"C_kwDOPTymldoAKDRjZDIxYjYxNTkyZWYwMjM5ZjU5Y2Y0ZTNmMjdhMmE3MGQyMjY3Mzc","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-08-12T00:06:38Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-12T00:06:38Z"},"message":"feat(code): toggle diff line numbers (#5427)\n\nDiff hunk line numbers can now be configured: they remain on by default,\nand can be disabled with `[ui].show_diff_line_numbers = false` or\ntoggled in-session with `/line-numbers`.\n\n---\n\nThe preference applies consistently to transcript and approval diffs.\nLive `edit_file` diffs — computed from the full before/after file\ncontents — show file-relative line numbers when enabled. Resumed-thread\n`edit_file` diffs, rebuilt from `old_string`/`new_string` fragments,\nkeep the safeguard that suppresses their fragment-relative numbers.\n\n`/line-numbers` mirrors `/timestamps`: it flips the preference, persists\nit to config, and reports the new state with a toast that notes the\nchange applies to new diffs. Already-mounted diffs keep the numbers they\nwere rendered with; the toggle affects diffs rendered after it.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/99b5f330-6148-5e03-568e-853ee121ea4c)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"cd00fb222c75689af8cbd54cce0c4b79cafa0334","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/cd00fb222c75689af8cbd54cce0c4b79cafa0334"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/4cd21b61592ef0239f59cf4e3f27a2a70d226737","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqe7kOCRC1aQ7uu5UhlAAAmQgQAIHzboDj48AWBHfuk138gJ3M\n4RSmYFHHdYQEHlldiMesdYZR6LHZUQacHiQwb7buSBSYtpzAQAUjK56g+jcRE108\n4yncGXla+asJd/4wiXHoXllLGWCLxpugAt4qvZVNdJeTdLnb3FY6qsVpSEBWSAnM\n9rkijXrk+N0OKeAfGllPodkcTdPoeLP4ARDhSNZuQ7QhuJPQun8zD6PeJcYNBH6B\nZEFxwqUXWKqvkuPURj+q3Td1UEWBluTlf9k202mW7D95F3ZtVV41OlNS571J98me\nDwziNJUGg14AW15mj0CW/Y5XRlzWpqYFqaI728rgzB7c69u059PKJtIUa2e+WZ0F\nmZQHC1+RMGL4Ud9TOjfQ/DdqqbLwH5ygPcR70FPbtP1ovVAAzlQgtNCYbRMV3Tak\nplel3jN1lVIQr1paLKHeoOuMTbKaoJ3I5ZAsOTjx2TmQGsNDDzOBvh+8SX+vGRT6\nuBr2SGXp5SSwnimVBCItOoJ7lUvvbkJxSlH3gtxs1XrD4z+IHR2GSlVCFzm+9IWl\nFJ3JW+xHMR8zlTQAapuyYPLfPejXMm2+r24XmhSQF6raOCmA+eBu36MMYTEjX+D6\nu2mSXyeUqBbgsPoVEfveD31csM4V3Hgl/AmUce0ZajidP/BFjuzDvHjZZgcka8Gd\nwL4eCa42F/I7K7EncUgR\n=p0ay\n-----END PGP SIGNATURE-----\n","payload":"tree cd00fb222c75689af8cbd54cce0c4b79cafa0334\nparent 2b3edf9ba4f3b43911f118b8e942374091602854\nauthor Mason Daugherty <mason@langchain.dev> 1786493198 -0700\ncommitter GitHub <noreply@github.com> 1786493198 -0700\n\nfeat(code): toggle diff line numbers (#5427)\n\nDiff hunk line numbers can now be configured: they remain on by default,\nand can be disabled with `[ui].show_diff_line_numbers = false` or\ntoggled in-session with `/line-numbers`.\n\n---\n\nThe preference applies consistently to transcript and approval diffs.\nLive `edit_file` diffs — computed from the full before/after file\ncontents — show file-relative line numbers when enabled. Resumed-thread\n`edit_file` diffs, rebuilt from `old_string`/`new_string` fragments,\nkeep the safeguard that suppresses their fragment-relative numbers.\n\n`/line-numbers` mirrors `/timestamps`: it flips the preference, persists\nit to config, and reports the new state with a toast that notes the\nchange applies to new diffs. Already-mounted diffs keep the numbers they\nwere rendered with; the toggle affects diffs rendered after it.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/99b5f330-6148-5e03-568e-853ee121ea4c)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-08-12T00:06:41Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4cd21b61592ef0239f59cf4e3f27a2a70d226737","html_url":"https://github.com/langchain-ai/deepagents/commit/4cd21b61592ef0239f59cf4e3f27a2a70d226737","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4cd21b61592ef0239f59cf4e3f27a2a70d226737/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","