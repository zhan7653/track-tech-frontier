.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"922b285598be3b2ca6b3ec01e7362e31ad2014b2","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/922b285598be3b2ca6b3ec01e7362e31ad2014b2","html_url":"https://github.com/langchain-ai/deepagents/commit/922b285598be3b2ca6b3ec01e7362e31ad2014b2"}]},{"sha":"922b285598be3b2ca6b3ec01e7362e31ad2014b2","node_id":"C_kwDOPTymldoAKDkyMmIyODU1OThiZTNiMmNhNmIzZWMwMWU3MzYyZTMxYWQyMDE0YjI","commit":{"author":{"name":"Alexander Olsen","email":"aolsenjazz@gmail.com","date":"2026-08-07T14:46:49Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-07T14:46:49Z"},"message":"feat(code): add Meta `muse-spark-1.2` to model switcher (#5389)\n\nMuse Spark 1.2 now appears as a recommended model in the `/model`\npicker, under the Meta provider as `meta:muse-spark-1.2`.\n\n---\n\nThe Meta provider (`langchain-meta`, `MODEL_API_KEY`) is already wired\nthrough the switcher, credential manager, and model discovery — the only\nchange needed is the curated entry in `_RECOMMENDED_MODELS` (with its\ndisplay-name fallback), which also feeds the onboarding picker and the\n\"Recommended only\" toggle. A parametrized display-name test entry pins\nthe fallback.\n\nMuse Spark 1.1 stays listed; users on the older revision can keep\nselecting it.","tree":{"sha":"de100de5b2b796b4d3baaa2397951fae20c2d559","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/de100de5b2b796b4d3baaa2397951fae20c2d559"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/922b285598be3b2ca6b3ec01e7362e31ad2014b2","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqde/ZCRC1aQ7uu5UhlAAAwuwQAAEumH8enwT24pWLxUSSRHrL\nB+POdf79O4+0o38RNMUaGh8CWADmy4E9egV+rWj/0Kj9EjFvY5r57ClbVczwB96y\nSmu6p6yh/BbP/NAcCjMhIeND05jg6aw/ysq7OQFW7TnR1cKScUPIJpHvuWeGgj6J\npJ/JvQyrcz3+sAEw+DAYrbstNyguPB+qxfa/1zV6eFUWiujeK8FxnKlQt4EK5DDN\n3ekk4Qs18GCymHWGc3aDo6q+JVCQsQhFUa5v9I+Ob5r97Gf27oOpQQohZcLDnBYX\nK1cIfkCNLSCDcX5mbCQl0b/sHJzxYtaeXKuJLjFCCA4EGqGFOGYCJJ7zhAyOLIzv\noOgwzXhT8n+ebW8mxcy8wCvN1+Uw/75hf89B1Um8K+IPxaWMVWlX/1fVrjD0TSfC\n1W2DuJFz5Ln7qbqLU1YTgJ/QyVMII1qQ+tvsCjdK2s9Tk1Q9IM1Q+JWu3UZowaPR\nTMJ9hEn0okLzdL3N99FQhIg9deo8Yqu1Gx6F/L+sdV+ETWxBTJm230klS2efzfel\nGaHdRWiIpONei22bdwvJBpmFGFA814tKlSVEYvrVx59VOdTLAfh3uon3/1Ez7zcv\nD0c39Inlj2Qj5xAqy9VV5IO0sT/6nTLfB0avVW70qXZep8OVZaF2HiTAggQsRYaX\nWATjFcB+ykYcjTB/fdP+\n=30Jw\n-----END PGP SIGNATURE-----\n","payload":"tree de100de5b2b796b4d3baaa2397951fae20c2d559\nparent d37b54f6bfb03f41fc7ff6b05436ad49db688d19\nauthor Alexander Olsen <aolsenjazz@gmail.com> 1786114009 -0400\ncommitter GitHub <noreply@github.com> 1786114009 -0400\n\nfeat(code): add Meta `muse-spark-1.2` to model switcher (#5389)\n\nMuse Spark 1.2 now appears as a recommended model in the `/model`\npicker, under the Meta provider as `meta:muse-spark-1.2`.\n\n---\n\nThe Meta provider (`langchain-meta`, `MODEL_API_KEY`) is already wired\nthrough the switcher, credential manager, and model discovery — the only\nchange needed is the curated entry in `_RECOMMENDED_MODELS` (with its\ndisplay-name fallback), which also feeds the onboarding picker and the\n\"Recommended only\" toggle. A parametrized display-name test entry pins\nthe fallback.\n\nMuse Spark 1.1 stays listed; users on the older revision can keep\nselecting it.","verified_at":"2026-08-07T14:46:53Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/922b285598be3b2ca6b3ec01e7362e31ad2014b2","html_url":"https://github.com/langchain-ai/deepagents/commit/922b285598be3b2ca6b3ec01e7362e31ad2014b2","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/922b285598be3b2ca6b3ec01e7362e31ad2014b2/comments","author":{"login":"aolsenjazz","id":13665641,"node_id":"MDQ6VXNlcjEzNjY1NjQx","avatar_url":"https://avatars.githubusercontent.com/u/13665641?v=4","gravatar_id":"","url":"https://api.github.com/users/aolsenjazz","html_url":"https://github.com/aolsenjazz","followers_url":"https://api.github.com/users/aolsenjazz/followers","following_url":"https://api.github.com/users/aolsenjazz/following{/other_user}","gists_url":"https://api.github.com/users/aolsenjazz/gists{/gist_id}","starred_url":"https://api.github.com/users/aolsenjazz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aolsenjazz/subscriptions","organizations_url":"https://api.github.com/users/aolsenjazz/orgs","repos_url":"https://api.github.com/users/aolsenjazz/repos","events_url":"https://api.github.com/users/aolsenjazz/events{/privacy}","received_events_url":"https://api.github.com/users/aolsenjazz/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"d37b54f6bfb03f41fc7ff6b05436ad49db688d19","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/d37b54f6bfb03f41fc7ff6b05436ad49db688d19","html_url":"https://github.com/langchain-ai/deepagents/commit/d37b54f6bfb03f41fc7ff6b05436ad49db688d19"}]},{"sha":"d37b54f6bfb03f41fc7ff6b05436ad49db688d19","node_id":"C_kwDOPTymldoAKGQzN2I1NGY2YmZiMDNmNDFmYzdmZjZiMDU0MzZhZDQ5ZGI2ODhkMTk","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-08-07T14:16:26Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-07T14:16:26Z"},"message":"fix(code): prevent post-tool hook replay (#5376)\n\nPost-execution hooks no longer replay tools when resumed, preventing\nduplicate side effects in all Hooks v2 sessions.\n\n---\n\n`PostToolUse`, `PostToolUseFailure`, and `SubagentStop` previously\ninterrupted inside the tools node after execution but before its result\ncommitted. This moves those interrupts to a checkpoint-safe post-tools\nboundary while preserving duration reporting and result feedback/context\nrewriting through private state. Hooks v2 has loaded by default since\n#5307, so the fix applies regardless of `DEEPAGENTS_CODE_EXPERIMENTAL`.\n\n<details>\n<summary>Test plan</summary>\n\n- `make lint`\n- `uv run --group test pytest -q tests/unit_tests/hooks` (220 passed)\n\n</details>\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/d820d546-4257-bc9f-82ee-3a038ddc0005)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>\nCo-authored-by: Alexander <aolsenjazz@gmail.com>","tree":{"sha":"f77a385e8f20b209abfc66327dd032166347955d","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/f77a385e8f20b209abfc66327dd032166347955d"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/d37b54f6bfb03f41fc7ff6b05436ad49db688d19","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqdei6CRC1aQ7uu5UhlAAAPZ8QAIF8e1KMc619xQLexaoslJB4\n83yIHiYYjpXDJuzGlw7OloAnqNXGNDjxffczHkYcmztrWfSTLEAiK9qJ8KaHOoNL\nuJsaxpZn1xCW9lN6+BDxOQ3iz2K8dmIHx2t9vG+vQWPAhbXz+Qk3h+y1k1Hews1+\nDuYnGO53+z8qx3+edfIwd5IbWlkMYaLD8dy7QIrSRCRyMy5+bBVkc84HaP4hOoj3\nFajclJKKo83HhyvtCClM/tFuB201Co3Qoiy3Wz6yU1u6RbzyK9nIx6uuusq1Vk18\nrX/YtdHsm5DHU+lk2d8uMXwmfHC78mJelUOplRzePeyJ3PpzjH/mA3fNpI3N3LV6\nR3jK8Q7o9NWvCEPUkFJoWjZEB6FqS6W+kisXIABymXTKhs/8bKvKgJdFntXOjSZP\n64hGgoE8YiZz5oNWWScZ2vW1LkgSrf71xTkvQg5SnGj4M0IqYQe5jY6/XIXU70ex\n6YwKGm24ZuL2b240opmRHo3xDk6EnESOwefyGuF6Jh3h+Jwx14kwA9ihdQfJtx1V\nTgQyMklp1UMdIjVt9Mq5wethalZ+4W+J1xlPTYLJx6Rlq70XiB1P/FqR012OL0By\nkwkfQk9BC4zFaqc+H8LeT8hC9AbUxwU/wyL+c6gt+bh0kp7o+KPHYwewUqGuj/mW\nEVZ0te3j2YUek6tRDbyk\n=pgdO\n-----END PGP SIGNATURE-----\n","payload":"tree f77a385e8f20b209abfc66327dd032166347955d\nparent 529f7e8a16c7441873a305a9fa36c2721fa7a5b7\nauthor Mason Daugherty <mason@langchain.dev> 1786112186 -0700\ncommitter GitHub <noreply@github.com> 1786112186 -0400\n\nfix(code): prevent post-tool hook replay (#5376)\n\nPost-execution hooks no longer replay tools when resumed, preventing\nduplicate side effects in all Hooks v2 sessions.\n\n---\n\n`PostToolUse`, `PostToolUseFailure`, and `SubagentStop` previously\ninterrupted inside the tools node after execution but before its result\ncommitted. This moves those interrupts to a checkpoint-safe post-tools\nboundary while preserving duration reporting and result feedback/context\nrewriting through private state. Hooks v2 has loaded by default since\n#5307, so the fix applies regardless of `DEEPAGENTS_CODE_EXPERIMENTAL`.\n\n<details>\n<summary>Test plan</summary>\n\n- `make lint`\n- `uv run --group test pytest -q tests/unit_tests/hooks` (220 passed)\n\n</details>\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/d820d546-4257-bc9f-82ee-3a038ddc0005)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>\nCo-authored-by: Alexander <aolsenjazz@gmail.com>","verified_at":"2026-08-07T14:16:30Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/d37b54f6bfb03f41fc7ff6b05436ad49db688d19","html_url":"https://github.com/langchain-ai/deepagents/commit/d37b54f6bfb03f41fc7ff6b05436ad49db688d19","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/d37b54f6bfb03f41fc7ff6b05436ad49db688d19/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"529f7e8a16c7441873a305a9fa36c2721fa7a5b7","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/529f7e8a16c7441873a305a9fa36c2721fa7a5b7","html_url":"https://github.com/langchain-ai/deepagents/commit/529f7e8a16c7441873a305a9fa36c2721fa7a5b7"}]},{"sha":"529f7e8a16c7441873a305a9fa36c2721fa7a5b7","node_id":"C_kwDOPTymldoAKDUyOWY3ZThhMTZjNzQ0MTg3M2EzMDVhOWZhMzZjMjcyMWZhN2E1Yjc","commit":{"author":{"name":"Johannes du Plessis","email":"johannes@langchain.dev","date":"2026-08-07T06:42:14Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-07T06:42:14Z"},"message":"feat(code): quieter diff hunks with word-level highlights (#5106)\n\nIn-chat file diffs are easier to read: changed rows get a soft tint\ninstead of a saturated block, only the words that actually changed are\nhighlighted, and each diff is introduced by a single `Edited <path> +N\n-M` line instead of a bordered box.\n\n---\n\nNew Diff Hunk UI\n\n## Screenshots:\n<img width=\"754\" height=\"1534\" alt=\"Screenshot 2026-07-30 at 4 43 28 PM\"\nsrc=\"https://github.com/user-attachments/assets/c0ff66a1-ea92-4544-bb99-d040cda82316\"\n/>\n\n\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/019fa61c-ebef-71b5-9515-c026e0ed76b0)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","tree":{"sha":"714212beabb6f3010a185124fae5cdfbf22ce64f","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/714212beabb6f3010a185124fae5cdfbf22ce64f"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/529f7e8a16c7441873a305a9fa36c2721fa7a5b7","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqdX5GCRC1aQ7uu5UhlAAACRQQAB1ufMp7/qW6cAxNcOCY6zqa\nJMytsquKZowwTTRaDw58zkzVtdusq3eXHCN6P9Ii/GaRarLFPNOJuMLLxe82s+AR\n+o783F1mG/g80EjTQ+4QQep0HWFpnHzCnNPOU3ivnsmitjvHRO0yC+4/xnqQG+yD\nh0pIfTkEY5OzwDKTWrDQRMzQNzsGJVdE3xPL6GUOLRDBmFdsHQ3kkarmOU0M8iAq\nSJQKUHza3qfF+AUwpiBBERRxbeB9UvTQ5cy7U5LO1bDHLWdseAE73zpR91RJE7wj\n4BBdFCagu+/KeGD1+1c8V2jwlGOckLBrP8LuESsacgjiScjQg3Dh0vjVjawCr+iL\nz46M4XHT/+SSy42mFslqgfqRCohcW4sYlvl9/Ego6lQHfGFlsVnz0W0cZMnT5f/M\nLYQpAUQWFEmv414EzvBh1crl7L9T+iY2EB+boWfOfEn0ogoQjQR3xru+vJo/2fa1\nuFgH1zOZME/0b7g71L9CRE4+ZQ7eIjl7oPWtmxGejcW3X8NSTUTp2/QwUALKMt6C\nF5lHlG7P+A/ajdbcgM07rLR8w58qoIT3sVZ64MBj3/hdg7yo3SFHCw8z4JQnhv6S\n5BlRbrqob5YBprekqVb1QELZcvWjRtUNp+72xxAoJH3tt2+3nDbSgmi3wmXTAAJa\n0OspLCavOKLg/pax080H\n=q+PB\n-----END PGP SIGNATURE-----\n","payload":"tree 714212beabb6f3010a185124fae5cdfbf22ce64f\nparent 280e24eda9db718408d458154791d0ae84bb845a\nauthor Johannes du Plessis <johannes@langchain.dev> 1786084934 -0700\ncommitter GitHub <noreply@github.com> 1786084934 -0700\n\nfeat(code): quieter diff hunks with word-level highlights (#5106)\n\nIn-chat file diffs are easier to read: changed rows get a soft tint\ninstead of a saturated block, only the words that actually changed are\nhighlighted, and each diff is introduced by a single `Edited <path> +N\n-M` line instead of a bordered box.\n\n---\n\nNew Diff Hunk UI\n\n## Screenshots:\n<img width=\"754\" height=\"1534\" alt=\"Screenshot 2026-07-30 at 4 43 28 PM\"\nsrc=\"https://github.com/user-attachments/assets/c0ff66a1-ea92-4544-bb99-d040cda82316\"\n/>\n\n\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/019fa61c-ebef-71b5-9515-c026e0ed76b0)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","verified_at":"2026-08-07T06:42:19Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/529f7e8a16c7441873a305a9fa36c2721fa7a5b7","html_url":"https://github.com/langchain-ai/deepagents/commit/529f7e8a16c7441873a305a9fa36c2721fa7a5b7","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/529f7e8a16c7441873a305a9fa36c2721fa7a5b7/comments","author":{"login":"johannes117","id":51395795,"node_id":"MDQ6VXNlcjUxMzk1Nzk1","avatar_url":"https://avatars.githubusercontent.com/u/51395795?v=4","gravatar_id":"","url":"https://api.github.com/users/johannes117","html_url":"https://github.com/johannes117","followers_url":"https://api.github.com/users/johannes117/followers","following_url":"https://api.github.com/users/johannes117/following{/other_user}","gists_url":"https://api.github.com/users/johannes117/gists{/gist_id}","starred_url":"https://api.github.com/users/johannes117/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/johannes117/subscriptions","organizations_url":"https://api.github.com/users/johannes117/orgs","repos_url":"https://api.github.com/users/johannes117/repos","events_url":"https://api.github.com/users/johannes117/events{/privacy}","received_events_url":"https://api.github.com/users/johannes117/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"280e24eda9db718408d458154791d0ae84bb845a","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/280e24eda9db718408d458154791d0ae84bb845a","html_url":"https://github.com/langchain-ai/deepagents/commit/280e24eda9db718408d458154791d0ae84bb845a"}]},{"sha":"280e24eda9db718408d458154791d0ae84bb845a","node_id":"C_kwDOPTymldoAKDI4MGUyNGVkYTlkYjcxODQwOGQ0NTgxNTQ3OTFkMGFlODRiYjg0NWE","commit":{"author":{"name":"dependabot[bot]","email":"49699333+dependabot[bot]@users.noreply.github.com","date":"2026-08-07T05:10:54Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-07T05:10:54Z"},"message":"chore(deps): bump h2 from 4.3.0 to 4.4.1 in /libs/code (#5383)\n\nBumps [h2](https://github.com/python-hyper/h2) from 4.3.0 to 4.4.1.\n<details>\n<summary>Changelog</summary>\n<p><em>Sourced from <a\nhref=\"https://github.com/python-hyper/h2/blob/master/CHANGELOG.rst\">h2's\nchangelog</a>.</em></p>\n<blockquote>\n<h2>4.4.1 (2026-08-03)</h2>\n<p><strong>Bugfixes</strong></p>\n<ul>\n<li>Performance improvement: remove consumed frames in-place from data\nbuffer.</li>\n<li>Reject duplicate Host headers in request headers. Thanks to Sunand\nMohan for the report.</li>\n</ul>\n<h2>4.4.0 (2026-07-23)</h2>\n<p><strong>API Changes (Backward Incompatible)</strong></p>\n<ul>\n<li>Support for Python 3.9 has been removed.</li>\n<li>Support for PyPy 3.9 has been removed.</li>\n<li><code>Stream.end_stream()</code> now raises\n<code>NoSuchStreamError</code> or <code>StreamClosedError</code>\nexceptions, instead of a generic <code>KeyError</code>.</li>\n<li>Duplicate <code>content-length</code> headers with different values\nnow raise <code>ProtocolError</code>.\nPreviously, the first <code>content-length</code> header was accepted\nand later conflicting values were ignored. Thanks to Harshal Parekh for\nthe report.</li>\n<li>Parse <code>content-length</code> headers according to RFC9110\ngrammar for numbers (1*DIGIT). Thanks to Arkadiusz Marta for the\nreport.</li>\n<li><strong>backfill from v4.3.0</strong> Convert emitted events into\nPython <code>dataclass</code>, which introduces new constructors with\nrequired arguments.\nInstantiating these events without arguments, as previously commonly\nused API pattern, will no longer work.</li>\n</ul>\n<p><strong>API Changes (Backward Compatible)</strong></p>\n<ul>\n<li>Support for Python 3.14 has been added.</li>\n<li><code>H2Connection.receive_data</code> now accepts any byte-like\nobject that\nimplements the buffer protocol, such as <code>bytes</code>,\n<code>bytearray</code>, and\n<code>memoryview</code>. Existing <code>bytes</code> callers are\nunaffected.</li>\n<li>Align CONNECT pseudo-header validation with RFC 9113 s8.3 and RFC\n8441 s4.\nOrdinary CONNECT now requires <code>:method=CONNECT</code> and\n<code>:authority</code>, and\nforbids <code>:scheme</code>/<code>:path</code>. Extended CONNECT (e.g.,\nWebSocket) requires\n<code>:scheme</code>, <code>:path</code>, <code>:authority</code> plus\n<code>:protocol</code>. (PR <a\nhref=\"https://redirect.github.com/python-hyper/h2/issues/1309\">#1309</a>)</li>\n<li>Fix incorrect substring matching of secure header in\n<code>cookie</code> and <code>:method</code>.</li>\n</ul>\n<p><strong>Bugfixes</strong></p>\n<ul>\n<li>Fix to allow sending 0 bytes on a stream even if the flow control\nwindow is negative.</li>\n<li>Reject non-zero <code>SETTINGS_ENABLE_PUSH</code> values received\nfrom servers.</li>\n</ul>\n</blockquote>\n</details>\n<details>\n<summary>Commits</summary>\n<ul>\n<li><a\nhref=\"https://github.com/python-hyper/h2/commit/bc239af1d1b85bc70482804f30a0e0e587d90a08\"><code>bc239af</code></a>\nv4.4.1</li>\n<li><a\nhref=\"https://github.com/python-hyper/h2/commit/92b925ed1b1817c82db32893503f74f47fcf4452\"><code>92b925e</code></a>\nadd test for duplicate host headers</li>\n<li><a\nhref=\"https://github.com/python-hyper/h2/commit/292a40829feefda98c8509dcdbbb4a57af9bd6a6\"><code>292a408</code></a>\nreject duplicate Host headers in request headers</li>\n<li><a\nhref=\"https://github.com/python-hyper/h2/commit/04d3b87cbc1db020d28c7cfb44fe194558efbdde\"><code>04d3b87</code></a>\nupdate changelog</li>\n<li><a\nhref=\"https://github.com/python-hyper/h2/commit/439b970d0fa19891fa81068907de97dfa3a07c3a\"><code>439b970</code></a>\nprepare for next release cycle</li>\n<li><a\nhref=\"https://github.com/python-hyper/h2/commit/9a7ff7430df669fa8e90b6121f3cc1ed64d1115a\"><code>9a7ff74</code></a>\nperformance: remove consumed frames in place from data buffer (<a\nhref=\"https://redirect.github.com/python-hyper/h2/issues/1321\">#1321</a>)</li>\n<li><a\nhref=\"https://github.com/python-hyper/h2/commit/6cce763997eca5b826f3e435a611b7a7fc73f633\"><code>6cce763</code></a>\nv4.4.0</li>\n<li><a\nhref=\"https://github.com/python-hyper/h2/commit/dfafda3b0cd96455b45d1785ef1ebc6968bba5cf\"><code>dfafda3</code></a>\nBump pytest from 8.4.2 to 9.0.3 (<a\nhref=\"https://redirect.github.com/python-hyper/h2/issues/1320\">#1320</a>)</li>\n<li><a\nhref=\"https://github.com/python-hyper/h2/commit/b45207cedf9fabe2c77bb3c1c10f403a610599a0\"><code>b45207c</code></a>\ndependencies and packaging++</li>\n<li><a\nhref=\"https://github.com/python-hyper/h2/commit/c40145f69c5473850849fe96301ac0416b1afea6\"><code>c40145f</code></a>\nparse <code>content-length</code> headers according to RFC9110 grammar\nfor numbers (1*DI...</li>\n<li>Additional commits viewable in <a\nhref=\"https://github.com/python-hyper/h2/compare/v4.3.0...v4.4.1\">compare\nview</a></li>\n</ul>\n</details>\n<br />\n\n\n[![Dependabot compatibility\nscore](https://dependabot-badges.githubapp.com/badges/compatibility_score?dependency-name=h2&package-manager=uv&previous-version=4.3.0&new-version=4.4.1)](https://docs.github.com/en/github/managing-security-vulnerabilities/about-dependabot-security-updates#about-compatibility-scores)\n\nDependabot will resolve any conflicts with this PR as long as you don't\nalter it yourself. You can also trigger a rebase manually by commenting\n`@dependabot rebase`.\n\n[//]: # (dependabot-automerge-start)\n[//]: # (dependabot-automerge-end)\n\n---\n\n<details>\n<summary>Dependabot commands and options</summary>\n<br />\n\nYou can trigger Dependabot actions by commenting on this PR:\n- `@dependabot rebase` will rebase this PR\n- `@dependabot recreate` will recreate this PR, overwriting any edits\nthat have been made to it\n- `@dependabot show <dependency name> ignore conditions` will show all\nof the ignore conditions of the specified dependency\n- `@dependabot ignore this major version` will close this PR and stop\nDependabot creating any more for this major version (unless you reopen\nthe PR or upgrade to it yourself)\n- `@dependabot ignore this minor version` will close this PR and stop\nDependabot creating any more for this minor version (unless you reopen\nthe PR or upgrade to it yourself)\n- `@dependabot ignore this dependency` will close this PR and stop\nDependabot creating any more for this dependency (unless you reopen the\nPR or upgrade to it yourself)\nYou can disable automated security fix PRs for this repo from the\n[Security Alerts\npage](https://github.com/langchain-ai/deepagents/network/alerts).\n\n</details>\n\nSigned-off-by: dependabot[bot] <support@github.com>\nCo-authored-by: dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>","tree":{"sha":"134491e257c6e9f5fc5ac54d8af48b46695e2223","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/134491e257c6e9f5fc5ac54d8af48b46695e2223"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/280e24eda9db718408d458154791d0ae84bb845a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqdWjeCRC1aQ7uu5UhlAAA9lIQAAWRq/RPfDicxSb1g2FbP8sM\nm2XCawthDJgi9QP71InDPqIvbTqk2vxW7EbeMATOe08idzL5PKg3lQx6sHqkY119\nfhQRs3zJm+cHVHlO+QwWrQbmj5R69T8TVZbgedmO91vQhQzfL3veqKMQ7soiTzzr\nJiYNFjioabMZGVOS/2Pda1iuJgcGR5H1muLTeetPphBFbN2bz5lDC8ra9jEBeilA\ndxt1mcNeEYLr4uaLTiV+1vcRvHjOXRFi5Js6syZScWjIWkW4EU/D2YEBFqI2JqEV\nh9buYawF0Ekpl9YH/5llZnKWD3drwKLShR2TgdJ83FhbFmw/It+QUtfb6H4swj6U\nbyNs+E2uoCC5n0sjyfKxwbxrzPc8WPolNjEiIw+upEwkXH8yIBDja/K9CSEIvUjz\naNIEE1KloH1BQIHfRLeeRO+4uz8W9TyFEEOAXChse5mlgJmLkQyCzb646zo8cFXr\nli4XxSjusLx5BS5+L4RDzxCWTj+54LSK7Io1ppYcKKVWH7GPE+me+8GCNztu2jEe\n4GA4LQFFIPZ6t2DCnWal3PzbqoPk9J1k1n5x7Yo6f2mcNSh0BB1V1friyClZ79Jc\n9PT3wncNKXD60TFIfKoVMMKLwF6xXmbKml3LyhhQ5odWxaqO6rcAgyMpKSl/A/Wt\nD3WF+Awkw9LQ0hxK1PHH\n=wO5P\n-----END PGP SIGNATURE-----\n","payload":"tree 134491e257c6e9f5fc5ac54d8af48b46695e2223\nparent fae605cfd09b595c88544aed283193c467da25a8\nauthor dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com> 1786079454 -0700\ncommitter GitHub <noreply@github.com> 1786079454 -0700\n\nchore(deps): bump h2 from 4.3.0 to 4.4.1 in /libs/code (#5383)\n\nBumps [h2](https://github.com/python-hyper/h2) from 4.3.0 to 4.4.1.\n<details>\n<summary>Changelog</summary>\n<p><em>Sourced from <a\nhref=\"https://github.com/python-hyper/h2/blob/master/CHANGELOG.rst\">h2's\nchangelog</a>.</em></p>\n<blockquote>\n<h2>4.4.1 (2026-08-03)</h2>\n<p><strong>Bugfixes</strong></p>\n<ul>\n<li>Performance improvement: remove consumed frames in-place from data\nbuffer.</li>\n<li>Reject duplicate Host headers in request headers. Thanks to Sunand\nMohan for the report.</li>\n</ul>\n<h2>4.4.0 (2026-07-23)</h2>\n<p><strong>API Changes (Backward Incompatible)</strong></p>\n<ul>\n<li>Support for Python 3.9 has been removed.</li>\n<li>Support for PyPy 3.9 has been removed.</li>\n<li><code>Stream.end_stream()</code> now raises\n<code>NoSuchStreamError</code> or <code>StreamClosedError</code>\nexceptions, instead of a generic <code>KeyError</code>.</li>\n<li>Duplicate <code>content-length</code> headers with different values\nnow raise <code>ProtocolError</code>.\nPreviously, the first <code>content-length</code> header was accepted\nand later conflicting values were ignored. Thanks to Harshal Parekh for\nthe report.</li>\n<li>Parse <code>content-length</code> headers according to RFC9110\ngrammar for numbers (1*DIGIT). Thanks to Arkadiusz Marta for the\nreport.</li>\n<li><strong>backfill from v4.3.0</strong> Convert emitted events into\nPython <code>dataclass</code>, which introduces new constructors with\nrequired arguments.\nInstantiating these events without arguments, as previously commonly\nused API pattern, will no longer work.</li>\n</ul>\n<p><strong>API Changes (Backward Compatible)</strong></p>\n<ul>\n<li>Support for Python 3.14 has been added.</li>\n<li><code>H2Connection.receive_data</code> now accepts any byte-like\nobject that\nimplements the buffer protocol, such as <code>bytes</code>,\n<code>bytearray</code>, and\n<code>memoryview</code>. Existing <code>bytes</code> callers are\nunaffected.</li>\n<li>Align CONNECT pseudo-header validation with RFC 9113 s8.3 and RFC\n8441 s4.\nOrdinary CONNECT now requires <code>:method=CONNECT</code> and\n<code>:authority</code>, and\nforbids <code>:scheme</code>/<code>:path</code>. Extended CONNECT (e.g.,\nWebSocket) requires\n<code>:scheme</code>, <code>:path</code>, <code>:authority</code> plus\n<code>:protocol</code>. (PR <a\nhref=\"https://redirect.github.com/python-hyper/h2/issues/1309\">#1309</a>)</li>\n<li>Fix incorrect substring matching of secure header in\n<code>cookie</code> and <code>:method</code>.</li>\n</ul>\n<p><strong>Bugfixes</strong></p>\n<ul>\n<li>Fix to allow sending 0 bytes on a stream even if the flow control\nwindow is negative.</li>\n<li>Reject non-zero <code>SETTINGS_ENABLE_PUSH</code> values received\nfrom servers.</li>\n</ul>\n</blockquote>\n</details>\n<details>\n<summary>Commits</summary>\n<ul>\n<li><a\nhref=\"https://github.com/python-hyper/h2/commit/bc239af1d1b85bc70482804f30a0e0e587d90a08\"><code>bc239af</code></a>\nv4.4.1</li>\n<li><a\nhref=\"https://github.com/python-hyper/h2/commit/92b925ed1b1817c82db32893503f74f47fcf4452\"><code>92b925e</code></a>\nadd test for duplicate host headers</li>\n<li><a\nhref=\"https://github.com/python-hyper/h2/commit/292a40829feefda98c8509dcdbbb4a57af9bd6a6\"><code>292a408</code></a>\nreject duplicate Host headers in request headers</li>\n<li><a\nhref=\"https://github.com/python-hyper/h2/commit/04d3b87cbc1db020d28c7cfb44fe194558efbdde\"><code>04d3b87</code></a>\nupdate changelog</li>\n<li><a\nhref=\"https://github.com/python-hyper/h2/commit/439b970d0fa19891fa81068907de97dfa3a07c3a\"><code>439b970</code></a>\nprepare for next release cycle</li>\n<li><a\nhref=\"https://github.com/python-hyper/h2/commit/9a7ff7430df669fa8e90b6121f3cc1ed64d1115a\"><code>9a7ff74</code></a>\nperformance: remove consumed frames in place from data buffer (<a\nhref=\"https://redirect.github.com/python-hyper/h2/issues/1321\">#1321</a>)</li>\n<li><a\nhref=\"https://github.com/python-hyper/h2/commit/6cce763997eca5b826f3e435a611b7a7fc73f633\"><code>6cce763</code></a>\nv4.4.0</li>\n<li><a\nhref=\"https://github.com/python-hyper/h2/commit/dfafda3b0cd96455b45d1785ef1ebc6968bba5cf\"><code>dfafda3</code></a>\nBump pytest from 8.4.2 to 9.0.3 (<a\nhref=\"https://redirect.github.com/python-hyper/h2/issues/1320\">#1320</a>)</li>\n<li><a\nhref=\"https://github.com/python-hyper/h2/commit/b45207cedf9fabe2c77bb3c1c10f403a610599a0\"><code>b45207c</code></a>\ndependencies and packaging++</li>\n<li><a\nhref=\"https://github.com/python-hyper/h2/commit/c40145f69c5473850849fe96301ac0416b1afea6\"><code>c40145f</code></a>\nparse <code>content-length</code> headers according to RFC9110 grammar\nfor numbers (1*DI...</li>\n<li>Additional commits viewable in <a\nhref=\"https://github.com/python-hyper/h2/compare/v4.3.0...v4.4.1\">compare\nview</a></li>\n</ul>\n</details>\n<br />\n\n\n[![Dependabot compatibility\nscore](http