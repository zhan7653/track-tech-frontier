78f2ab23dba252b20a5763ee3764","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/smaramwbc/statewave-multi-agent-memory/commits/816d319dd32a78f2ab23dba252b20a5763ee3764","html_url":"https://github.com/smaramwbc/statewave-multi-agent-memory/commit/816d319dd32a78f2ab23dba252b20a5763ee3764","comments_url":"https://api.github.com/repos/smaramwbc/statewave-multi-agent-memory/commits/816d319dd32a78f2ab23dba252b20a5763ee3764/comments","author":{"login":"smaramwbc","id":145447586,"node_id":"U_kgDOCKtaog","avatar_url":"https://avatars.githubusercontent.com/u/145447586?v=4","gravatar_id":"","url":"https://api.github.com/users/smaramwbc","html_url":"https://github.com/smaramwbc","followers_url":"https://api.github.com/users/smaramwbc/followers","following_url":"https://api.github.com/users/smaramwbc/following{/other_user}","gists_url":"https://api.github.com/users/smaramwbc/gists{/gist_id}","starred_url":"https://api.github.com/users/smaramwbc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smaramwbc/subscriptions","organizations_url":"https://api.github.com/users/smaramwbc/orgs","repos_url":"https://api.github.com/users/smaramwbc/repos","events_url":"https://api.github.com/users/smaramwbc/events{/privacy}","received_events_url":"https://api.github.com/users/smaramwbc/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"smaramwbc","id":145447586,"node_id":"U_kgDOCKtaog","avatar_url":"https://avatars.githubusercontent.com/u/145447586?v=4","gravatar_id":"","url":"https://api.github.com/users/smaramwbc","html_url":"https://github.com/smaramwbc","followers_url":"https://api.github.com/users/smaramwbc/followers","following_url":"https://api.github.com/users/smaramwbc/following{/other_user}","gists_url":"https://api.github.com/users/smaramwbc/gists{/gist_id}","starred_url":"https://api.github.com/users/smaramwbc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smaramwbc/subscriptions","organizations_url":"https://api.github.com/users/smaramwbc/orgs","repos_url":"https://api.github.com/users/smaramwbc/repos","events_url":"https://api.github.com/users/smaramwbc/events{/privacy}","received_events_url":"https://api.github.com/users/smaramwbc/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"0486ba3d9d31e16b5efd17251297be64ebbff9c8","url":"https://api.github.com/repos/smaramwbc/statewave-multi-agent-memory/commits/0486ba3d9d31e16b5efd17251297be64ebbff9c8","html_url":"https://github.com/smaramwbc/statewave-multi-agent-memory/commit/0486ba3d9d31e16b5efd17251297be64ebbff9c8"}]},{"sha":"0486ba3d9d31e16b5efd17251297be64ebbff9c8","node_id":"C_kwDOS1J6QtoAKDA0ODZiYTNkOWQzMWUxNmI1ZWZkMTcyNTEyOTdiZTY0ZWJiZmY5Yzg","commit":{"author":{"name":"smaramwbc","email":"145447586+smaramwbc@users.noreply.github.com","date":"2026-06-11T14:41:46Z"},"committer":{"name":"Statewave","email":"145447586+smaramwbc@users.noreply.github.com","date":"2026-06-11T17:22:10Z"},"message":"feat: deterministic structured memory candidates for the Stripe contradiction\n\nSupply Statewave with structured memory candidates so the real\nBloomberg→TechCrunch Stripe pricing contradiction actually resolves, while the\nindependent Bloomberg facts survive that supersession.\n\n- sources/*.json: add a machine-readable v2 `claim` block to the Stripe entry\n  (pricing.processing_rate, entity_key organization:stripe, card/standard/USD/\n  transaction qualifiers, value in basis-points + minor-units). Bloomberg 350/35,\n  TechCrunch + earnings 290/30.\n- agents/candidates.py: build_competitor_candidates() turns one competitor into\n  separate atomic candidates (pricing / positioning / differentiators); the\n  pricing candidate carries the source's claim verbatim. Authoritative fields\n  (entity, key, qualifiers, cardinality, normalized numeric value, dates) are\n  taken from the source — never invented by an LLM.\n- agents/analyst.py + server.py: agents post structured-candidate episodes\n  deterministically (no LLM extraction; the seed too). The LLM still writes the\n  human-readable synthesis. A shared asyncio.Lock serializes each agent's\n  post→compile→diff so concurrent agents never double-compile the same episode.\n  Bloomberg keeps skipping the pre-seeded Stripe (no bloomberg→bloomberg dup).\n\nResult (real Docker run, authoritative DB/API evidence): stale 3.5%+35c (350bp)\nsuperseded exactly once by the current 2.9%+30c (290bp); independent Stripe\npositioning/differentiators stay active; the stale rate is absent from active\ncontext, synthesis input, and the final answer; two clean runs are semantically\nidentical.","tree":{"sha":"af3c8b82c565a37356ae9e1b7206c8730455bb2c","url":"https://api.github.com/repos/smaramwbc/statewave-multi-agent-memory/git/trees/af3c8b82c565a37356ae9e1b7206c8730455bb2c"},"url":"https://api.github.com/repos/smaramwbc/statewave-multi-agent-memory/git/commits/0486ba3d9d31e16b5efd17251297be64ebbff9c8","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/smaramwbc/statewave-multi-agent-memory/commits/0486ba3d9d31e16b5efd17251297be64ebbff9c8","html_url":"https://github.com/smaramwbc/statewave-multi-agent-memory/commit/0486ba3d9d31e16b5efd17251297be64ebbff9c8","comments_url":"https://api.github.com/repos/smaramwbc/statewave-multi-agent-memory/commits/0486ba3d9d31e16b5efd17251297be64ebbff9c8/comments","author":{"login":"smaramwbc","id":145447586,"node_id":"U_kgDOCKtaog","avatar_url":"https://avatars.githubusercontent.com/u/145447586?v=4","gravatar_id":"","url":"https://api.github.com/users/smaramwbc","html_url":"https://github.com/smaramwbc","followers_url":"https://api.github.com/users/smaramwbc/followers","following_url":"https://api.github.com/users/smaramwbc/following{/other_user}","gists_url":"https://api.github.com/users/smaramwbc/gists{/gist_id}","starred_url":"https://api.github.com/users/smaramwbc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smaramwbc/subscriptions","organizations_url":"https://api.github.com/users/smaramwbc/orgs","repos_url":"https://api.github.com/users/smaramwbc/repos","events_url":"https://api.github.com/users/smaramwbc/events{/privacy}","received_events_url":"https://api.github.com/users/smaramwbc/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"smaramwbc","id":145447586,"node_id":"U_kgDOCKtaog","avatar_url":"https://avatars.githubusercontent.com/u/145447586?v=4","gravatar_id":"","url":"https://api.github.com/users/smaramwbc","html_url":"https://github.com/smaramwbc","followers_url":"https://api.github.com/users/smaramwbc/followers","following_url":"https://api.github.com/users/smaramwbc/following{/other_user}","gists_url":"https://api.github.com/users/smaramwbc/gists{/gist_id}","starred_url":"https://api.github.com/users/smaramwbc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smaramwbc/subscriptions","organizations_url":"https://api.github.com/users/smaramwbc/orgs","repos_url":"https://api.github.com/users/smaramwbc/repos","events_url":"https://api.github.com/users/smaramwbc/events{/privacy}","received_events_url":"https://api.github.com/users/smaramwbc/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"60570e4b311acdacfb7b942c8d170d5d055303f2","url":"https://api.github.com/repos/smaramwbc/statewave-multi-agent-memory/commits/60570e4b311acdacfb7b942c8d170d5d055303f2","html_url":"https://github.com/smaramwbc/statewave-multi-agent-memory/commit/60570e4b311acdacfb7b942c8d170d5d055303f2"}]},{"sha":"60570e4b311acdacfb7b942c8d170d5d055303f2","node_id":"C_kwDOS1J6QtoAKDYwNTcwZTRiMzExYWNkYWNmYjdiOTQyYzhkMTcwZDVkMDU1MzAzZjI","commit":{"author":{"name":"smaramwbc","email":"145447586+smaramwbc@users.noreply.github.com","date":"2026-06-10T19:56:47Z"},"committer":{"name":"Statewave","email":"145447586+smaramwbc@users.noreply.github.com","date":"2026-06-11T17:22:10Z"},"message":"fix: make skip_competitors actually take effect; README image fixes\n\nThe bloomberg agent's skip_competitors filter only reassigned a local\n`competitors` list that never reached the LLM prompt (built from the full\n`source_data`), and the commit loop had no guard. So the pre-seeded Stripe\nfact could still be re-extracted and committed from bloomberg, producing a\nbloomberg->bloomberg supersession and a non-deterministic \"conflict resolved\"\ncount.\n\n- analyst.py: mirror the filter into source_data so skipped competitors never\n  reach the model, and guard the commit loop as defense-in-depth.\n- README.md: drop the root-relative leading slash on the how-it-works image\n  (broke rendering on GitHub); rename the misspelled architecture diagram file.","tree":{"sha":"44fbb4ada36dcd40d856f9aece4eed318970d59a","url":"https://api.github.com/repos/smaramwbc/statewave-multi-agent-memory/git/trees/44fbb4ada36dcd40d856f9aece4eed318970d59a"},"url":"https://api.github.com/repos/smaramwbc/statewave-multi-agent-memory/git/commits/60570e4b311acdacfb7b942c8d170d5d055303f2","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/smaramwbc/statewave-multi-agent-memory/commits/60570e4b311acdacfb7b942c8d170d5d055303f2","html_url":"https://github.com/smaramwbc/statewave-multi-agent-memory/commit/60570e4b311acdacfb7b942c8d170d5d055303f2","comments_url":"https://api.github.com/repos/smaramwbc/statewave-multi-agent-memory/commits/60570e4b311acdacfb7b942c8d170d5d055303f2/comments","author":{"login":"smaramwbc","id":145447586,"node_id":"U_kgDOCKtaog","avatar_url":"https://avatars.githubusercontent.com/u/145447586?v=4","gravatar_id":"","url":"https://api.github.com/users/smaramwbc",