cess control across execution environments"],"author":[{"ORCID":"https:\/\/orcid.org\/0000-0002-5227-1254","authenticated-orcid":false,"given":"Darius","family":"Suciu","sequence":"first","affiliation":[{"name":"Stony Brook University, Stony Brook, New York, USA"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-3182-4849","authenticated-orcid":false,"given":"Sandeep Kiran","family":"Pinjala","sequence":"additional","affiliation":[{"name":"Stony Brook University, Stony Brook, New York, USA"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0009-0007-8424-8159","authenticated-orcid":false,"given":"Bin","family":"Sun","sequence":"additional","affiliation":[{"name":"Stony Brook University, Stony Brook, New York, USA"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-1237-8276","authenticated-orcid":false,"given":"Radu","family":"Sion","sequence":"additional","affiliation":[{"name":"Stony Brook University, Stony Brook, New York, USA"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1145\/3779208.3807496","published-print":{"date-parts":[[2026,6]]},"published-online":{"date-parts":[[2026,6,4]]},"issued":{"date-parts":[[2026,6]]},"container-title":["Proceedings of the ACM Asia Conference on Computer and Communications Security"]},{"DOI":"10.1109\/jiot.2021.3134366","title":["Smart Collaborative Contract for Endogenous Access Control in Massive Machine Communications"],"author":[{"given":"Fei","family":"Song","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Letian","family":"Li","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"family":"Yikun","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"family":"Li","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabula