/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e323d0c7d91f3b11e03a016c14cf52008dc66b55","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/e323d0c7d91f3b11e03a016c14cf52008dc66b55","html_url":"https://github.com/langchain-ai/deepagents/commit/e323d0c7d91f3b11e03a016c14cf52008dc66b55"}]},{"sha":"e323d0c7d91f3b11e03a016c14cf52008dc66b55","node_id":"C_kwDOPTymldoAKGUzMjNkMGM3ZDkxZjNiMTFlMDNhMDE2YzE0Y2Y1MjAwOGRjNjZiNTU","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T17:52:27Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T17:52:27Z"},"message":"fix(code): `dcode doctor` shows `not configured` for unset tracing (#4318)\n\n`dcode doctor` now distinguishes unconfigured LangSmith tracing (`not\nconfigured`) from an explicit opt-out (`disabled`), and reports\ncredentials as `not set`.\n\n---\n\n`dcode doctor` previously rendered the Tracing line as `disabled`\nwhenever a tracing flag wasn't truthy, conflating \"no LangSmith tracing\nflag set\" with a deliberate opt-out. It now reports `not configured`\nwhen no flag is set and `disabled` only when a flag is explicitly set to\na recognized falsy token (`0`/`false`/`no`/`off`). The Credentials line\nnow reads `not set` instead of `not configured`.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/3f92fdb3-3d1d-a985-9b9e-4ad1c8406400)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"09522510f571bb061f05cd86e2bb0779a8e902c2","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/09522510f571bb061f05cd86e2bb0779a8e902c2"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/e323d0c7d91f3b11e03a016c14cf52008dc66b55","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPrxbCRC1aQ7uu5UhlAAAF9gQAGOp55ITy64YGjJBYNOceo+Y\nnbGWRH4yQdgvFmYoVvuM9yyTnsehQaC6K/byseAPo+1QmVjDouiBm+yuvweXuTfJ\ncVd8fSTTTq1aBTQQGSXXe9sF2Z4t7eZSu1DNNUjx4hinUezpa4Iu2E4oPIxvwd31\nLD5rICoLtjtLPEyA5xoK7Yht9KSCfVOdY4R4NuQhGB3/960Fyu6NYQL6vPipd7ra\n6459xf5hprhziIv9ivlkh0aYQ20YNEAaxMPkfmplnWMgDtTS2T1AuQiSEfRlpSNn\njDYF92uuKcZOmWN8BN3q4VzoVNiWMqolITMkoH7HW685AvxxS8CmfKdJYNY/Dz+o\ntAYzGAffS9GLrlRcBLiWNLHVpv5twUpOPk1uXbM+eIAZBI7nDxJ1hdpKPtnh02lm\nQatZJfLZFLnK77SjzhIzT2j8E+tdmglgboFZPiZBTdOxpiZO+XpT6BAGtayPYT8e\nzXlHR/M47hf+5/tLBXWXFUXOIXBEaDmfOqzxBMJrgtaRhDUx7YlExp09s8njYePI\njCi1V0pn1vc/sd06K408lsq7u433AoIhXfgkOIboiWj1E2fPO10bLJPrfMD6qZO4\nCguC+NRdQ+TJADqW2kFjtBElsUtLDNgB1ml1t1Gwrmlz99qDPR6hwRNcCuAJ//X8\nZKXDVwYUJfOYMKtvf2q9\n=dbgx\n-----END PGP SIGNATURE-----\n","payload":"tree 09522510f571bb061f05cd86e2bb0779a8e902c2\nparent e0e4dea4e6917eda55bf94c2962e6a20d009b043\nauthor Mason Daugherty <mason@langchain.dev> 1782496347 -0400\ncommitter GitHub <noreply@github.com> 1782496347 -0400\n\nfix(code): `dcode doctor` shows `not configured` for unset tracing (#4318)\n\n`dcode doctor` now distinguishes unconfigured LangSmith tracing (`not\nconfigured`) from an explicit opt-out (`disabled`), and reports\ncredentials as `not set`.\n\n---\n\n`dcode doctor` previously rendered the Tracing line as `disabled`\nwhenever a tracing flag wasn't truthy, conflating \"no LangSmith tracing\nflag set\" with a deliberate opt-out. It now reports `not configured`\nwhen no flag is set and `disabled` only when a flag is explicitly set to\na recognized falsy token (`0`/`false`/`no`/`off`). The Credentials line\nnow reads `not set` instead of `not configured`.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/3f92fdb3-3d1d-a985-9b9e-4ad1c8406400)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-26T17:52:27Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/e323d0c7d91f3b11e03a016c14cf52008dc66b55","html_url":"https://github.com/langchain-ai/deepagents/commit/e323d0c7d91f3b11e03a016c14cf52008dc66b55","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/e323d0c7d91f3b11e03a016c14cf52008dc66b55/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_adm