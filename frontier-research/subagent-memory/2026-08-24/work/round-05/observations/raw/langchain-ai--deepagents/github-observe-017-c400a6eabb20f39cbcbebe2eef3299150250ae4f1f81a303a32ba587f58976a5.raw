wner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7ff9553fc057a682ba503ebfe9a870adb51ab848","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7ff9553fc057a682ba503ebfe9a870adb51ab848","html_url":"https://github.com/langchain-ai/deepagents/commit/7ff9553fc057a682ba503ebfe9a870adb51ab848"}]},{"sha":"7ff9553fc057a682ba503ebfe9a870adb51ab848","node_id":"C_kwDOPTymldoAKDdmZjk1NTNmYzA1N2E2ODJiYTUwM2ViZmU5YTg3MGFkYjUxYWI4NDg","commit":{"author":{"name":"Hunter Lovell","email":"40191806+hntrl@users.noreply.github.com","date":"2026-06-03T20:08:36Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-03T20:08:36Z"},"message":"fix(sdk): keep private state out of subagent propagation (#3542)\n\nThis change makes Deep Agents derive private state keys directly from\nmiddleware state schemas and filters them out when state is copied into\nsubagents.\n\nIt fixes two leak paths:\n- parent state fields marked with `PrivateStateAttr` no longer propagate\ninto child agents\n- private fields written by one sibling subagent no longer leak into\nanother sibling through shared runtime state\n\nThe test coverage now exercises the declarative `SubAgent` path with\nfake chat models and verifies both parent-to-child and\nsibling-to-sibling isolation.\n\n---------\n\nCo-authored-by: Mason Daugherty <mason@langchain.dev>\nCo-authored-by: Sydney Runkle <sydneymarierunkle@gmail.com>","tree":{"sha":"fba26324a81a1aab1af7fe89b257c8a568ed84c9","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/fba26324a81a1aab1af7fe89b257c8a568ed84c9"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/7ff9553fc057a682ba503ebfe9a870adb51ab848","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqIInECRC1aQ7uu5UhlAAAIh8QAC+1j/iVj1eUhOvC/rOSxht7\nQAanFejCOf2nwDT4yk8wsN5OTxlylQJnRYKIMt0mtBO29Z7SbrccvJhOx9b2GEjR\nAwTWE9EGdq/jzG1ZJzwgcUZYKcV4T8/PeGHQH1BD6brdQlSpJRbPmvb+6yTojKUM\nzmpCUQzRGdKXRHKfjDQIKf3b2PCNMHBYrX0kLiHJQ1+9YOraDAKUf10VE1Q5ZNCk\nlEO0DzHu+ErVB6nxEa4XnlkXE3zUB+xWtUM5QpxcgN5/gloXTcGoMlgH4ElfiPMj\nKEW3s1Zdz0zvZJ5/Nk/SFh0dBOIA3Bse1Q65oCl9PKWRcrFrYSS/wWxC8UsjVTI5\neelm0jn0cTW6lYM/+/L4uI5FzRMKsrhfv7iZcPB3VwEiZ04b5qXeZrMHKWUr8Ycz\nPekABYzc9hNtkaO+pDKcvbex781mCl6MzwY0OdNcvgghglzKug6ycUOhJH6/ROVf\noTM0ACT0nXQ/dBLxDra9tTrJNCCOksEi11Q3Ymp0nKgGHXT9JhD62OVUk46orZ5T\nrv924wwB/75HizuLHmlN2EmaD3JJcy3tMmF2RxkBEk4X9CZEHfT8UBXJv1Ez/dL/\nDUtpTvY3WPmoxHPZzOU1X2/HBPGNcbNwhFHRwqtffDEY30bOL2ka2k3Hn/zzEMON\nURsh92EDe8Hiu/OTQ1+4\n=LHMP\n-----END PGP SIGNATURE-----\n","payload":"tree fba26324a81a1aab1af7fe89b257c8a568ed84c9\nparent a97f2fd394e6b0b943225a0195b0901188bd368c\nauthor Hunter Lovell <40191806+hntrl@users.noreply.github.com> 1780517316 -0700\ncommitter GitHub <noreply@github.com> 1780517316 -0400\n\nfix(sdk): keep private state out of subagent propagation (#3542)\n\nThis change makes Deep Agents derive private state keys directly from\nmiddleware state schemas and filters them out when state is copied into\nsubagents.\n\nIt fixes two leak paths:\n- parent state fields marked with `PrivateStateAttr` no longer propagate\ninto child agents\n- private fields written by one sibling subagent no longer leak into\nanother sibling through shared runtime state\n\nThe test coverage now exercises the declarative `SubAgent` path with\nfake chat models and verifies both parent-to-child and\nsibling-to-sibling isolation.\n\n---------\n\nCo-authored-by: Mason Daugherty <mason@langchain.dev>\nCo-authored-by: Sydney Runkle <sydneymarierunkle@gmail.com>","verified_at":"2026-06-03T20:08:36Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7ff9553fc057a682ba503ebfe9a870adb51ab848","html_url":"https://github.com/langchain-ai/deepagents/commit/7ff9553fc057a682ba503ebfe9a870adb51ab848","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7ff9553fc057a682ba503ebfe9a870adb51ab848/comments","author":{"login":"hntrl","id":40191806,"node_id":"MDQ6VXNlcjQwMTkxODA2","avatar_url":"https://avatars.githubusercontent.com/u/40191806?v=4","gravatar_id":"","url":"https://api.github.com/users/hntrl","html_url":"https://github.com/hntrl","followers_url":"https://api.github.com/users/hntrl/followers","following_url":"https://api.github.com/users/hntrl/following{/other_user}","gists_url":"https://api.github.com/users/hntrl/gists{/gist_id}","starred_url":"https://api.github.com/users/hntrl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hntrl/subscriptions","organizations_url":"https://api.github.com/users/hntrl/orgs","repos_url":"https://api.github.com/users/hntrl/repos","events_url":"https://api.github.com/users/hntrl/events{/privacy}","received_events_url":"https://api.github.com/users/hntrl/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a97f2fd394e6b0b943225a0195b0901188bd368c","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a97f2fd394e6b0b943225a0195b0901188bd368c","html_url":"https://github.com/langchain-ai/deepagents/commit/a97f2fd394e6b0b943225a0195b0901188bd368c"}]},{"sha":"a97f2fd394e6b0b943225a0195b0901188bd368c","node_id":"C_kwDOPTymldoAKGE5N2YyZmQzOTRlNmIwYjk0MzIyNWEwMTk1YjA5MDExODhiZDM2OGM","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-03T19:04:13Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-03T19:04:13Z"},"message":"fix(code): move MCP trust state out of user config (#3742)\n\n[Docs](https://github.com/langchain-ai/docs/pull/4291)\n\nMove project MCP trust fingerprints out of the hand-editable user config\nand into the app-managed state directory.\n\nMCP trust entries are bookkeeping data keyed by project root and config\nfingerprint, not user configuration. Storing them in `config.toml` made\nunrelated config writes more fragile and mixed internal state with\nsettings users may edit directly. This change stores trust data in a\nversioned JSON file under the Deep Agents state directory instead.\n\nThis is an intentional breaking storage/API change:\n- existing `[mcp_trust.projects]` entries in `config.toml` are not\nmigrated\n- trust helpers now use `store_path` for the JSON trust store rather\nthan `config_path`\n- users with previously trusted project MCP configs may be prompted to\napprove them again\n\nAlso warn when an approval succeeds for the current session but cannot\nbe persisted, so users understand why they will be prompted again later.","tree":{"sha":"24d46c7c149a2ecdd650a1adc816458955e8e107","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/24d46c7c149a2ecdd650a1adc816458955e8e107"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/a97f2fd394e6b0b943225a0195b0901188bd368c","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqIHqtCRC1aQ7uu5UhlAAAa8kQAACqGkyvbrX9loH7gIpt8mW9\nytoOGpykYAuxNefWSouWvDEBHoHzgxStc9zmVx7wdYpkQQsVhV3754MStgUHgVu6\nNl7/sRlWZZjVoolJNaGX6XqXQi8SivokFjbbxXQGpYLHIGfmF2WazyR+OzOQGUL0\n0l/WwCebTtzB/Al8Tic5mvbMJFLWwxd7Aj2Fh4GkQme4oGrmrwUBRKr/a03ge40u\nhQ+yqQkY6hUhYbeXeEZ67INeBnBLtY1tzgtKfLQ0Ynd8V4yv9QYkFx1OUDf/T8wX\nv8EWLjMSQpgCj4OCW0R2xlkrPlaOEVNc5N6z2tYDhbeMRiDtX5Cw4YO+tPX8FpNO\n8Yilr22QZB6UahZTyd015RUrMq5PHaH1EMwXypx7t4oDtzuXhmYq+FvvS2KVFCzX\nIDFFwtDjbMA4xqXuL6MzgMOiQNEe3dKfqhWrTU69c/MOK5334Q7Dk62ePMRCnMbF\nc7PdO6eYAL8ZjdPZ7GHJkXmhx0plS8ySQukxEsULoEptkwj8spgc04YeRLaSiz6L\nWa7reMfgrAiY7rQyDwTOigEpPmHibVpb7U/ocmJ2qXQK4DmhTDbJg6tnmWRf47Kf\nBknk9UNVwUsp3Zc7i6k6s79eXIZGQzsq3TjeJZjxPV5gn2/BqmBGIdhRM+XYOfjS\nSv3STPjWBldwjpBuNRIk\n=p82o\n-----END PGP SIGNATURE-----\n","payload":"tree 24d46c7c149a2ecdd650a1adc816458955e8e107\nparent 4bb4286a26c9c9bc69a36f2714d9eb0e3e5e4d40\nauthor Mason Daugherty <mason@langchain.dev> 1780513453 -0400\ncommitter GitHub <noreply@github.com> 1780513453 -0400\n\nfix(code): move MCP trust state out of user config (#3742)\n\n[Docs](https://github.com/langchain-ai/docs/pull/4291)\n\nMove project MCP trust fingerprints out of the hand-editable user config\nand into the app-managed state directory.\n\nMCP trust entries are bookkeeping data keyed by project root and config\nfingerprint, not user configuration. Storing them in `config.toml` made\nunrelated config writes more fragile and mixed internal state with\nsettings users may edit directly. This change stores trust data in a\nversioned JSON file under the Deep Agents state directory instead.\n\nThis is an intentional breaking storage/API change:\n- existing `[mcp_trust.projects]` entries in `config.toml` are not\nmigrated\n- trust helpers now use `store_path` for the JSON trust store rather\nthan `config_path`\n- users with previously trusted project MCP configs may be prompted to\napprove them again\n\nAlso warn when an approval succeeds for the current session but cannot\nbe persisted, so users understand why they will be prompted again later.","verified_at":"2026-06-03T19:04:14Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a97f2fd394e6b0b943225a0195b0901188bd368c","html_url":"https://github.com/langchain-ai/deepagents/commit/a97f2fd394e6b0b943225a0195b0901188bd368c","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a97f2fd394e6b0b943225a0195b0901188bd368c/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"4bb4286a26c9c9bc69a36f2714d9eb0e3e5e4d40","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4bb4286a26c9c9bc69a36f2714d9eb0e3e5e4d40","html_url":"https://github.com/langchain-ai/deepagents/commit/4bb4286a26c9c9bc69a36f2714d9eb0e3e5e4d40"}]},{"sha":"4bb4286a26c9c9bc69a36f2714d9eb0e3e5e4d40","node_id":"C_kwDOPTymldoAKDRiYjQyODZhMjZjOWM5YmM2OWEzNmYyNzE0ZDllYjBlM2U1ZTRkNDA","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-03T18:55:19Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-03T18:55:19Z"},"message":"feat(code): word-level double-click selection (#3740)\n\nDouble-click selection in the Textual app now targets word boundaries\ninstead of selecting an entire widget. Clipboard copying is deferred\nuntil Textual finishes click-chain selection updates, so copied text\nreflects the final double- or triple-click selection.","tree":{"sha":"9628ccd83b4c0f8b92c30797090a1d39650b4a65","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/9628ccd83b4c0f8b92c30797090a1d39650b4a65"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/4bb4286a26c9c9bc69a36f2714d9eb0e3e5e4d40","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqIHiXCRC1aQ7uu5UhlAAAX8cQAGhWHzL4mhrSqM0pGaEn9PXc\nMtmgpnG2kGKpeRLMEQ4JKhjyrowaiFXhlgTDEa+bK1rMqL/WQjqPnUahgB8FCMfX\npc3rTYIs21ay6183j5vw9U7mN+lS2Blo6wiDcGZhdjJJU4I6Ni1xVmtnkrdhJnze\nkLadIIoHzXKSFgmRY2BKGcQTSpcLZ2ICPwyI0m1GrAniJciMdmmmFJY3UVejFJxb\nl3TLZtyQkUsUCi9GM4+7HowNQCyJVUyYuLWl6Ek1ubP/8HooAnKsHUd8necOoMp+\nPwE0gEWgougjkBh6vADXachKLQ+iYZh+eEU7CsgRaJizl8iwWbhtsljt+3WYDOs1\nYXFcqopdQjqrDoA1ZohQrXzOBcVT4PcES44hH4rVNOJRPLzOfbiVEyyXPz5FJcGe\nR1yHk6nRu1Ydw4QYuDZ5SH6JGsGLyaWmExWWze983UJ15MSmZbKbGYhgyhsBjLuo\nkEF+Dc1lPSzFVMB2slPWScNtZi88eZOXi2f7UPieU90tShpPhM04pkDTAkaQMssE\nwIMn3Rrp0x1pNSu4Ss1u7GzIMCTpCLXIrZ556QIO5WaW525pXIjYVdcvE7R/t308\nAYsicSIAFFot+Ry9rjTycLZdXsZLG5gxd6PupYDIMlih4g01lxQuwGbZqiksQBwj\nHF4mVRI+QyjZArNEWc2x\n=7lDP\n-----END PGP SIGNATURE-----\n","payload":"tree 9628ccd83b4c0f8b92c30797090a1d39650b4a65\nparent 32ab8a6c58cb6729d963fa8b19cf5e425a6fd9a5\nauthor Mason Daugherty <mason@langchain.dev> 1780512919 -0400\ncommitter GitHub <noreply@github.com> 1780512919 -0400\n\nfeat(code): word-level double-click selection (#3740)\n\nDouble-click selection in the Textual app now targets word boundaries\ninstead of selecting an entire widget. Clipboard copying is deferred\nuntil Textual finishes click-chain selection updates, so copied text\nreflects the final double- or triple-click selection.","verified_at":"2026-06-03T18:55:19Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4bb4286a26c9c9bc69a36f2714d9eb0e3e5e4d40","html_url":"https://github.com/langchain-ai/deepagents/commit/4bb4286a26c9c9bc69a36f2714d9eb0e3e5e4d40","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4bb4286a26c9c9bc69a36f2714d9eb0e3e5e4d40/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"32ab8a6c58cb6729d963fa8b19cf5e425a6fd9a5","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/32ab8a6c58cb6729d963fa8b19cf5e425a6fd9a5","html_url":"https://github.com/langchain-ai/deepagents/commit/32ab8a6c58cb6729d963fa8b19cf5e425a6fd9a5"}]},{"sha":"32ab8a6c58cb6729d963fa8b19cf5e425a6fd9a5","node_id":"C_kwDOPTymldoAKDMyYWI4YTZjNThjYjY3MjlkOTYzZmE4YjE5Y2Y1ZTQyNWE2ZmQ5YTU","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-03T18:32:12Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-03T18:32:12Z"},"message":"fix(ci): avoid blocking release dispatch during pending publishes (#3738)\n\nRelease automation now waits for in-flight publishes before\nrecalculating release PRs, avoiding half-updated release state where\nmanifests are bumped but tags are not created yet.\n\nRelease commits take a separate fast path: they are detected before the\npending-release wait and dispatch package publish workflows directly.\nThis keeps merged release PRs from getting queued behind normal push\nmaintenance while another package is publishing.\n\n## Changes\n- Split release commit detection into a short `detect-release-commit`\njob before pending-release wait logic.\n- Replaced the previous skip guard with bounded polling for\n`autorelease: pending` labels.\n- Moved `release-please` concurrency to the mutating release-please job\ninstead of the whole workflow.\n- Rewired `trigger-releases` to use `detect-release-commit` outputs\ndirectly.\n- Documented why merged release PRs skip release-please PR maintenance\nfor that push.","tree":{"sha":"fb406ce2ac8697ad0314a46276c16980c9d8742c","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/fb406ce2ac8697ad0314a46276c16980c9d8742c"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/32ab8a6c58cb6729d963fa8b19cf5e425a6fd9a5","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqIHMsCRC1aQ7uu5UhlAAAMjAQAE1o9j/qMw7uAdYOpw8PL39E\nbRYFQdCziELlpUnCb3h9AfvBcgoSIp4GBDGQov7QTyQC3xwMojdzCNeXXkhQ5QJL\njGRaOvCQcsCz+w/9slsoiHHlNG2AjvQXNNXvAFTai1REvnQ50laWDXwUN+QKdwDA\nB/iC3MXLX8zV1VYLnjHZyvBSWvDqbkiV/yjZJm19D5t+fSGqiKmUEZkWJvbu5OpG\nclf5fios9fWJMIrcfy3ec906EW1qt/uH45TmDlyMscK7oPvI0P8aVatiEFjW8Y0I\nWLcbqHe3+OTyvkAb8cqLXHErg9aYAbQ7JyTH3oPtsDJUSFXq7EQSj7Mdn1G7oOnr\nABN+YYtIVNVM8bTZupX07Melyqsyml5MLYuRXCBuSKnr07MYyDzC30a1rxE4CAK2\n/sIexs0scf3zPhLpkhr76GcX7Yc+AxjP21qebNw3SbYehnpE3oP6TP51NAgH5DHF\n+vXeZYhhdbG+8YyC6kTsEdIhveT/r77myRc2Nfl0EPRL7ad2atKazVYs4IaLBRjM\n530q4+oghvK0Mqx6cYgIKkhnUp0bvps8qjPEz2CS2kkRw0KggwEQ1ghn3+eX7F5G\nasBbZ1Gu+tZ5LSjP+KI/rzCMPuWsc1aatfgVd9rtslBW0jDuc/dSf1FfJkm5ZHsl\njJeMIEktyyqjS97ej+o2\n=MBhG\n-----END PGP SIGNATURE-----\n","payload":"tree fb406ce2ac8697ad0314a46276c16980c9d8742c\nparent 5c5fd035b470325059a58cd979eba70f21cf6e92\nauthor Mason Daugherty <mason@langchain.dev> 1780511532 -0400\ncommitter GitHub <noreply@github.com> 1780511532 -0400\n\nfix(ci): avoid blocking release dispatch during pending publishes (#3738)\n\nRelease automation now waits for in-flight publishes before\nrecalculating release PRs, avoiding half-updated release state where\nmanifests are bumped but tags are not created yet.\n\nRelease commits take a separate fast path: they are detected before the\npending-release wait and dispatch package publish workflows directly.\nThis keeps merged release PRs from getting queued behind normal push\nmaintenance while another package is publishing.\n\n## Changes\n- Split release commit detection into a short `detect-release-commit`\njob before pending-release wait logic.\n- Replaced the previous skip guard with bounded polling for\n`autorelease: pending` labels.\n- Moved `release-please` concurrency to the mutating release-please job\ninstead of the whole workflow.\n- Rewired `trigger-releases` to use `detect-release-commit` outputs\ndirectly.\n- Documented why merged release PRs skip release-please PR maintenance\nfor that push.","verified_at":"2026-06-03T18:32:13Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/32ab8a6c58cb6729d963fa8b19cf5e425a6fd9a5","html_url":"https://github.com/langchain-ai/deepagents/commit/32ab8a6c58cb6729d963fa8b19cf5e425a6fd9a5","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/32ab8a6c58cb6729d963fa8b19cf5e425a6fd9a5/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/1986