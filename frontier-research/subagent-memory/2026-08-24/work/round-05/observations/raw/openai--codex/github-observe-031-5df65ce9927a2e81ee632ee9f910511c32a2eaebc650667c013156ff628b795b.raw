46b7c18d8b2c5000812cd9\nparent 2264fdd4a2bb517c1173ee2a5936337661d54536\nauthor Gabriel Peal <gpeal@users.noreply.github.com> 1779989043 -0700\ncommitter GitHub <noreply@github.com> 1779989043 -0700\n\n[codex] Support ui visibility meta for tools (#24700)\n\n## Summary\n\nAdds support for the same ui.visibility metadata as resources\n\n[spec](https://github.com/modelcontextprotocol/ext-apps/blob/main/specification/draft/apps.mdx#resource-discovery)","verified_at":"2026-05-28T17:24:04Z"}},"url":"https://api.github.com/repos/openai/codex/commits/577ec03bf82fb52e7041fb6b684e694b1e53451a","html_url":"https://github.com/openai/codex/commit/577ec03bf82fb52e7041fb6b684e694b1e53451a","comments_url":"https://api.github.com/repos/openai/codex/commits/577ec03bf82fb52e7041fb6b684e694b1e53451a/comments","author":{"login":"gpeal","id":1307745,"node_id":"MDQ6VXNlcjEzMDc3NDU=","avatar_url":"https://avatars.githubusercontent.com/u/1307745?v=4","gravatar_id":"","url":"https://api.github.com/users/gpeal","html_url":"https://github.com/gpeal","followers_url":"https://api.github.com/users/gpeal/followers","following_url":"https://api.github.com/users/gpeal/following{/other_user}","gists_url":"https://api.github.com/users/gpeal/gists{/gist_id}","starred_url":"https://api.github.com/users/gpeal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gpeal/subscriptions","organizations_url":"https://api.github.com/users/gpeal/orgs","repos_url":"https://api.github.com/users/gpeal/repos","events_url":"https://api.github.com/users/gpeal/events{/privacy}","received_events_url":"https://api.github.com/users/gpeal/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"2264fdd4a2bb517c1173ee2a5936337661d54536","url":"https://api.github.com/repos/openai/codex/commits/2264fdd4a2bb517c1173ee2a5936337661d54536","html_url":"https://github.com/openai/codex/commit/2264fdd4a2bb517c1173ee2a5936337661d54536"}]},{"sha":"2264fdd4a2bb517c1173ee2a5936337661d54536","node_id":"C_kwDOOYsS4doAKDIyNjRmZGQ0YTJiYjUxN2MxMTczZWUyYTU5MzYzMzc2NjFkNTQ1MzY","commit":{"author":{"name":"Michael Bolin","email":"mbolin@openai.com","date":"2026-05-28T16:59:34Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-28T16:59:34Z"},"message":"Fix extension turn item emitter test event ordering (#24936)\n\n## Why\n\nPR #24813 added extension `TurnItemEmitter` coverage and introduced a\ntest that records a conversation history item before asserting\nextension-emitted turn item events.\n\n`record_conversation_items()` also emits a `RawResponseItem` event to\nobservers. The test was reading from the same event receiver and\nexpected the next event to be `ItemStarted`, so the test failed reliably\nonce the setup history item was present.\n\n## What Changed\n\nUpdate\n`passes_turn_fields_and_scoped_turn_item_emitter_to_extension_call` to\nconsume and assert the expected setup `RawResponseItem` before checking\nthe extension `ItemStarted`, `WebSearchBegin`, `ItemCompleted`, and\n`WebSearchEnd` events.\n\nThis is test-only and does not change extension runtime behavior.\n\n## Verification\n\n- `cargo nextest run --no-fail-fast -p codex-core\ntools::handlers::extension_tools::tests::passes_turn_fields_and_scoped_turn_item_emitter_to_extension_call`","tree":{"sha":"91e0eda4159d302f140c384ec5fd8a69c9294489","url":"https://api.github.com/repos/openai/codex/git/trees/91e0eda4159d302f140c384ec5fd8a69c9294489"},"url":"https://api.github.com/repos/openai/codex/git/commits/2264fdd4a2bb517c1173ee2a5936337661d54536","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqGHR2CRC1aQ7uu5UhlAAAlWkQAC2haxQHU3omgunDa+Mi29lN\nM4cIpr07hl4OpgDMxzKV2mp7r8HqUVci5UgVlf6tCnAFKn4vrsqmv8ovwiNZ1mqk\nx/UavypiWhkoGZANrq6vdqIwcyiigo6Ap4tgmR6IJtKvh1ix0cNasT9z55SGgnox\nKofdOu/joXnRzTty04rqno1VxpwQgGXDk1MspMzXjAr9pz0/EocL4B+Kt5QmV2uc\nKrjRxnof7L4vxDBX2su/86YrPECbzB6xtwpx/vrh7ty3S9p2ASTCOMsRgTc8e/ze\n7zb46+4hRyuRoZVwoaor+k5aP4YwlkdzAQKPHJqiB2QPSnGPxRRSNHsMVcnlb/1K\nUJhm5KoZKRunR3Xu1k3ZI1tj93D7r0uKfaaZeny8tc0vpierUUzTeRaT/5SZQNKD\nKALQwqhAizPsaAcsW3rz3VO/5V9w3wjJAPK1pnG/M2beU3C1MxCAvN5liYNg+N3l\nZVvnyLAhKJb5MEVVMFRFZoVh6C1G1lJIFEWAUVwEM8Dq6BQ1RFlbYyhfAJLiAEzb\nfyWyfPPv4CeesLizhTM0tzLZY176c1DtdZuOy1e0rIAmJdTyNIDDioglMtmTbJFv\nESpLEHHn0yQFW5RXpaopgSWjArfnS0fDyPVCd5RP7PF8j6SXlcZzo61xuJNEKHYz\n0NZUtwxnOBfK2XVyuUOM\n=mqs0\n-----END PGP SIGNATURE-----\n","payload":"tree 91e0eda4159d302f140c384ec5fd8a69c9294489\nparent e2551a5e362eb1538e21a47c8f7babf124f6d029\nauthor Michael Bolin <mbolin@openai.com> 1779987574 -0700\ncommitter GitHub <noreply@github.com> 1779987574 -0700\n\nFix extension turn item emitter test event ordering (#24936)\n\n## Why\n\nPR #24813 added extension `TurnItemEmitter` coverage and introduced a\ntest that records a conversation history item before asserting\nextension-emitted turn item events.\n\n`record_conversation_items()` also emits a `RawResponseItem` event to\nobservers. The test was reading from the same event receiver and\nexpected the next event to be `ItemStarted`, so the test failed reliably\nonce the setup history item was present.\n\n## What Changed\n\nUpdate\n`passes_turn_fields_and_scoped_turn_item_emitter_to_extension_call` to\nconsume and assert the expected setup `RawResponseItem` before checking\nthe extension `ItemStarted`, `WebSearchBegin`, `ItemCompleted`, and\n`WebSearchEnd` events.\n\nThis is test-only and does not change extension runtime behavior.\n\n## Verification\n\n- `cargo nextest run --no-fail-fast -p codex-core\ntools::handlers::extension_tools::tests::passes_turn_fields_and_scoped_turn_item_emitter_to_extension_call`","verified_at":"2026-05-28T16:59:35Z"}},"url":"https://api.github.com/repos/openai/codex/commits/2264fdd4a2bb517c1173ee2a5936337661d54536","html_url":"https://github.com/openai/codex/commit/2264fdd4a2bb517c1173ee2a5936337661d54536","comments_url":"https://api.github.com/repos/openai/codex/commits/2264fdd4a2bb517c1173ee2a5936337661d54536/comments","author":{"login":"bolinfest","id":655869,"node_id":"MDQ6VXNlcjY1NTg2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/655869?v=4","gravatar_id":"","url":"https://api.github.com/users/bolinfest","html_url":"https://github.com/bolinfest","followers_url":"https://api.github.com/users/bolinfest/followers","following_url":"https://api.github.com/users/bolinfest/following{/other_user}","gists_url":"https://api.github.com/users/bolinfest/gists{/gist_id}","starred_url":"https://api.github.com/users/bolinfest/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bolinfest/subscriptions","organizations_url":"https://api.github.com/users/bolinfest/orgs","repos_url":"https://api.github.com/users/bolinfest/repos","events_url":"https://api.github.com/users/bolinfest/events{/privacy}","received_events_url":"https://api.github.com/users/bolinfest/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e2551a5e362eb1538e21a47c8f7babf124f6d029","url":"https://api.github.com/repos/openai/codex/commits/e2551a5e362eb1538e21a47c8f7babf124f6d029","html_url":"https://github.com/openai/codex/commit/e2551a5e362eb1538e21a47c8f7babf124f6d029"}]},{"sha":"e2551a5e362eb1538e21a47c8f7babf124f6d029","node_id":"C_kwDOOYsS4doAKGUyNTUxYTVlMzYyZWIxNTM4ZTIxYTQ3YzhmN2JhYmYxMjRmNmQwMjk","commit":{"author":{"name":"jif-oai","email":"jif@openai.com","date":"2026-05-28T16:48:43Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-28T16:48:43Z"},"message":"Reap stale multi-agent slots (#24903)\n\n## Summary\n\n- Let `close_agent` clean up an agent that is still registered in\n`AgentRegistry` even when its underlying thread is already missing.\n- Preserve the explicit-close boundary: for known stale thread-spawn\nagents, mark the persisted spawn edge `Closed`, then treat\n`ThreadNotFound` / `InternalAgentDied` as a successful close so the\nregistry slot can be released.\n- Add a regression for MultiAgentV2 task-name targets where\n`close_agent(\"worker\")` succeeds after the worker thread has already\ndisappeared.\n\n## Motivation\n\nA worker can disappear from `ThreadManager` while its metadata still\nexists in the root `AgentRegistry`. Before this change, the close tool\nfailed while trying to subscribe to the missing thread status, so it\nnever reached the cleanup path that releases the registered agent slot.\nWith `agents.max_threads = 1`, an explicit close of that stale task-name\nagent could fail and leave the session unable to spawn a replacement.\n\n## Scope\n\nThis PR intentionally does not add automatic stale-agent reaping to\n`spawn_agent`, `resume_agent`, or `list_agents`. A thread being missing\nfrom `ThreadManager` is not the same as an explicit close: persisted\nopen spawn edges are still the durable source of truth for resume and\ntask-name ownership until `close_agent` is called.\n\n## Validation\n\n- `just test -p codex-core -E\n'test(multi_agent_v2_close_agent_reaps_stale_task_name_target) |\ntest(resume_agent_from_rollout_reopens_open_descendants_after_manager_shutdown)'`\n- `just fix -p codex-core`","tree":{"sha":"dca57c36a94414f77704bf0099718905857d33a5","url":"https://api.github.com/repos/openai/codex/git/trees/dca57c36a94414f77704bf0099718905857d33a5"},"url":"https://api.github.com/repos/openai/codex/git/commits/e2551a5e362eb1538e21a47c8f7babf124f6d029","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqGHHrCRC1aQ7uu5UhlAAAg1MQAH4kKe74qVtXkgXNk/kBtj1N\n5CQLuudqUJzo/mb15qPu/asGgUeNgCdGxW8OSIuiXEzSfYhKHjthclyoRAujgnCF\nSpcYeQIzBnnemXOrar3F0aSj0aVncSBHbNbcHmXnngfUgQulbzBaFowmo7ASYZ3y\nJmxiWfhA1LsXwYdjK59D2eLiYoeHLULU3ndpbF7ixfEExnUyyQZuJ2vWUCnUapN5\nmmWE/TVNrzfk8jsd+ohPOJQ3UttN/PbBW5IwaPuf9yptjP1dgDub7FkUf39i1YFS\nwRPxmb3EzM3NSqqgKeguF9taSdogls4rCxi7EH+iUcsUg7FI/x76IfnKVaVOVpOm\nVz83xLTcSH8lHyzeoyqM4QaTdclIH8A9pTdEcgkguifFyBfvLtRBBmN9u8Bmun+a\nUu5Ouo+RawIsgaq41eK+LOsyIeMQ3LEZhjC7CNk5wXhqqmaBJ8XCs3OrguMvkUAE\nTcAKzkMAVDV5XYg3ZYAyo3cejvPVQzpO6p9/1HMCLn0CGyxA0n5zK8IgMCOpCcGd\nC9xLLCzbo8ItVYL+fTaTHCixXtfwgMMDQcHa4uyOBmF9v39xO3cki7VMID7WYlah\nkxBa6qesII3if+pC+HNMP2Iwpxd33yLSHvfZzRxCl7bCP0Yyyj6jdlL5dj28j5Bm\nHe477NyiSMJh2acXJYRN\n=DCUL\n-----END PGP SIGNATURE-----\n","payload":"tree dca57c36a94414f77704bf0099718905857d33a5\nparent 8a827d6426e354aa2da5f6f32154131fdcc58c67\nauthor jif-oai <jif@openai.com> 1779986923 +0200\ncommitter GitHub <noreply@github.com> 1779986923 +0200\n\nReap stale multi-agent slots (#24903)\n\n## Summary\n\n- Let `close_agent` clean up an agent that is still registered in\n`AgentRegistry` even when its underlying thread is already missing.\n- Preserve the explicit-close boundary: for known stale thread-spawn\nagents, mark the persisted spawn edge `Closed`, then treat\n`ThreadNotFound` / `InternalAgentDied` as a successful close so the\nregistry slot can be released.\n- Add a regression for MultiAgentV2 task-name targets where\n`close_agent(\"worker\")` succeeds after the worker thread has already\ndisappeared.\n\n## Motivation\n\nA worker can disappear from `ThreadManager` while its metadata still\nexists in the root `AgentRegistry`. Before this change, the close tool\nfailed while trying to subscribe to the missing thread status, so it\nnever reached the cleanup path that releases the registered agent slot.\nWith `agents.max_threads = 1`, an explicit close of that stale task-name\nagent could fail and leave the session unable to spawn a replacement.\n\n## Scope\n\nThis PR intentionally does not add automatic stale-agent reaping to\n`spawn_agent`, `resume_agent`, or `list_agents`. A thread being missing\nfrom `ThreadManager` is not the same as an explicit close: persisted\nopen spawn edges are still the durable source of truth for resume and\ntask-name ownership until `close_agent` is called.\n\n## Validation\n\n- `just test -p codex-core -E\n'test(multi_agent_v2_close_agent_reaps_stale_task_name_target) |\ntest(resume_agent_from_rollout_reopens_open_descendants_after_manager_shutdown)'`\n- `just fix -p codex-core`","verified_at":"2026-05-28T16:48:44Z"}},"url":"https://api.github.com/repos/openai/codex/commits/e2551a5e362eb1538e21a47c8f7babf124f6d029","html_url":"https://github.com/openai/codex/commit/e2551a5e362eb1538e21a47c8f7babf124f6d029","comments_url":"https://api.github.com/repos/openai/codex/commits/e2551a5e362eb1538e21a47c8f7babf124f6d029/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"8a827d6426e354aa2da5f6f32154131fdcc58c67","url":"https://api.github.com/repos/openai/codex/commits/8a827d6426e354aa2da5f6f32154131fdcc58c67","html_url":"https://github.com/openai/codex/commit/8a827d6426e354aa2da5f6f32154131fdcc58c67"}]},{"sha":"8a827d6426e354aa2da5f6f32154131fdcc58c67","node_id":"C_kwDOOYsS4doAKDhhODI3ZDY0MjZlMzU0YWEyZGE1ZjZmMzIxNTQxMzFmZGNjNThjNjc","commit":{"author":{"name":"Gabriel Peal","email":"gpeal@users.noreply.github.com","date":"2026-05-28T16:38:34Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-28T16:38:34Z"},"message":"Expose MCP server info as part of server status (#24698)\n\n# Summary\n\nExpose MCP server info via App Server (when available) so apps can\nrender a richer MCP experience","tree":{"sha":"a943fdfb283a746d5663b834172370efe275218f","url":"https://api.github.com/repos/openai/codex/git/trees/a943fdfb283a746d5663b834172370efe275218f"},"url":"https://api.github.com/repos/openai/codex/git/commits/8a827d6426e354aa2da5f6f32154131fdcc58c67","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqGG+KCRC1aQ7uu5UhlAAATtkQAAXE5nLnHmFMMXsV87d2b75w\n5LnSZnyoQAo5f/Z3mG39iBlXT06L6GC1TrzRQwUBGHBXhewkfW5t7/xDsL0dJ+v+\nKNA4Ke11A4tee4UQi0zC5ci2PqFRr97WPz0MteN3yxdDePb9wnVm4FRbXOeurLJK\ngx4Mws2UGI+QaqSVYOYYc7QajAB6xMxXqXC1NhaZDDkayybCTsn71mWU/VXM4W9F\n90L5CF69H7sSeDor0PsZWvY7vJOS8eYd2zRLsP8xXFT33kiQdIEFRPoE9/G02GJA\nzHw5OgyJq59J0+YaIUBN4mgFNbwAs4gf7uhXAaXTdUkQgQh/Y3v184nAF7OGcXCM\nQKReuiBnxpco4DoLlg0Wegf4w+FL9wwt6frfowls8nhTXLLVDUNiuA827ubBqRGo\nQar+5mUjpfRYycwdmeanrg8i667FXFhEwmaFoYCqqY5cI//kLYC6hZbsPDHKWSf4\nC7iz74CR5FLVYw4KOPWEzj8s3DZiIL1yRol8lkeRir+i95bav