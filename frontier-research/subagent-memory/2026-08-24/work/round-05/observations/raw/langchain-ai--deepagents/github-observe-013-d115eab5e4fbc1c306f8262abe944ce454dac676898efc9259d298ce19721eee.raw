5a53a9d8dec268e5f0851aa6d4ca54dc9444b8","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/eb5a53a9d8dec268e5f0851aa6d4ca54dc9444b8","html_url":"https://github.com/langchain-ai/deepagents/commit/eb5a53a9d8dec268e5f0851aa6d4ca54dc9444b8"}]},{"sha":"eb5a53a9d8dec268e5f0851aa6d4ca54dc9444b8","node_id":"C_kwDOPTymldoAKGViNWE1M2E5ZDhkZWMyNjhlNWYwODUxYWE2ZDRjYTU0ZGM5NDQ0Yjg","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-25T18:03:28Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-25T18:03:28Z"},"message":"test(code): disable unit-test update checks by default (#4262)\n\nMost unit tests now opt out of the startup PyPI update check through the\nsame environment variable production code already respects. That keeps\nsubprocess-based tests from triggering background DNS under\n`--disable-socket`, while leaving the update-check gate tests free to\nexercise the real env behavior.","tree":{"sha":"646c1ea8e248a1383e3c215c8a52945020fd5a29","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/646c1ea8e248a1383e3c215c8a52945020fd5a29"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/eb5a53a9d8dec268e5f0851aa6d4ca54dc9444b8","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPW1wCRC1aQ7uu5UhlAAAWuMQAKRZRnGpnBxizHAjHSAlWcvD\n+LPBKL7VZim0Il7SDl6jVAaXRgADpp/wgsYzu94rf1Bgr56EOAc/VvfIn32z3EgY\nKVb7LjyoNHQRWiX5966/ItoR+O+j6Yh6F3FYNqDZddBGw3mxtOtz+2T2cK64eaN4\nE2g5nYO7SUdhIEda/jJ7oex/giukkhFdMpqjT6hK4256fnzhcC9umiGuBil2EtVQ\nmbyvhQ7D4AgtUbdLhicDINM4/mCJYR86piqxm4cwNjBWkKXAIqpqkuX4b2dtt4KU\nyZWGrT/SBS8T2QtGQXbDYhlUIkE+g/AAyJrLvSNJZM1KHPxg0aKpVTP9k2SxUw7i\n35wMBkhsECFYoGdx5ezR3Yli7FWl2e5/q9B384nep+NlTEZmLaCoPRXTjX0Cczrx\npRzvdj2HXyMG6Ck4hRmo667bSt+IC6SwsV8+SP//ntFBoH/X/VAQ05Xzfs9pzETy\n0kJFmeKi5zrnLOOShUEw1Okl2PAGrCRDNOeG//+B9NkSnEAgaIu3dLoNvEt9eJGH\nzx4a/ojYGI8LL9DAmQRnb6DsjjHkDIEL2SgAFzhcn+/iX6VvdDUJjW2vI9Gs1yT5\nstz8c5edqX4g1pQPxsMOzxIT+Jh3XseXYG7GD/AV9x+FMVYg3Nvrtww1RFzrzLao\nK2l8WnWk/ypag1W4nSHp\n=g9Ot\n-----END PGP SIGNATURE-----\n","payload":"tree 646c1ea8e248a1383e3c215c8a52945020fd5a29\nparent d25969b1b6dbbc3cded59d6d8589f1600ee1b671\nauthor Mason Daugherty <mason@langchain.dev> 1782410608 -0400\ncommitter GitHub <noreply@github.com> 1782410608 -0400\n\ntest(code): disable unit-test update checks by default (#4262)\n\nMost unit tests now opt out of the startup PyPI update check through the\nsame environment variable production code already respects. That keeps\nsubprocess-based tests from triggering background DNS under\n`--disable-socket`, while leaving the update-check gate tests free to\nexercise the real env behavior.","verified_at":"2026-06-25T18:03:29Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/eb5a53a9d8dec268e5f0851aa6d4ca54dc9444b8","html_url":"https://github.com/langchain-ai/deepagents/commit/eb5a53a9d8dec268e5f0851aa6d4ca54dc9444b8","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/eb5a53a9d8dec268e5f0851aa6d4ca54dc9444b8/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User