xy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e61156d2b29f1f25a80aa8e2c10b479444accb6b","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/e61156d2b29f1f25a80aa8e2c10b479444accb6b","html_url":"https://github.com/langchain-ai/deepagents/commit/e61156d2b29f1f25a80aa8e2c10b479444accb6b"}]},{"sha":"e61156d2b29f1f25a80aa8e2c10b479444accb6b","node_id":"C_kwDOPTymldoAKGU2MTE1NmQyYjI5ZjFmMjVhODBhYThlMmMxMGI0Nzk0NDRhY2NiNmI","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-14T07:45:58Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-14T07:45:58Z"},"message":"test(sdk): handle expected middleware warnings (#4717)\n\nExpected beta warnings from `RubricMiddleware` and Pregel v3 streaming\ncurrently flood unit-test output, while media-offload failure warnings\nare emitted without being asserted.\n\nThis scopes exact-message warning filters to the tests that\nintentionally exercise those beta APIs and captures the media-offload\nwarnings with `pytest.warns`. Unrelated warnings remain visible.","tree":{"sha":"b84d7513b8d108791e97211ba4d77742aa3ee01a","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/b84d7513b8d108791e97211ba4d77742aa3ee01a"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/e61156d2b29f1f25a80aa8e2c10b479444accb6b","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqVek2CRC1aQ7uu5UhlAAAepUQACRKtCb477/sC1khmB1TPKLP\n9CQ6azV5OQ40BRBbZ4leA1PHnxsj+aFdh8O3w73kc2v+/DJFHyxDVjM06vdTaYPd\nfsay/aK/Ss/aJUkwKxcC99jxgshoHfXRwyfIJPot25X+0RF7t2WZEpk0+REw3Y6D\nw6pUicpXn1Hn/4k013MEqHBuOjF86DTtmL/6GDijlyaAW5uQFgiNRSmerTpmu0fB\n02U2RQYQMrTRDIMZvDxIm0HiEeDsbf5cIPKGAjUPO5PiTdQBaB23dm2ujTo8ut5q\neuI8XVrbQgjfR2GiJr1HT5vBTrgtFKOo3R9KlyynEdwfp6h7+G18zje2zWoL270F\nMBNrhTrltMGSbP4hY0+Sx3zo45YPKvq6pY/n6VFMUALtRjOT94hwP8S9G96/TRBo\n/WXQmWMkLF5JyjcfebBICt1LmR4DDsA7YrttclkaIUrQ3+QVBDrzlSAxh+MdYF0s\nvx2JR7CJTtWn9/oDaoMk15xLlg43t6TmVBofErnpkcgx7zLTYsxoqixs4wx0DbRg\nhP9WAUQOGpy6k1H2QU4SE3PMyk91wWVkZW+AL3Q0A4/EiC/Q4Y/d6uxli91LWrTw\nUii5N6/gy6MW8PSXTyVfoCknjQD2NE4uJ/90KGfzvJbp9uFu5SiEi+XyAS3kxM0d\nsFUOrCmjWI1BrmqeC8ra\n=nDyN\n-----END PGP SIGNATURE-----\n","payload":"tree b84d7513b8d108791e97211ba4d77742aa3ee01a\nparent c633f108429301c621e7ac9852dd0a4b9ee9aecb\nauthor Mason Daugherty <mason@langchain.dev> 1784015158 -0400\ncommitter GitHub <noreply@github.com> 1784015158 -0400\n\ntest(sdk): handle expected middleware warnings (#4717)\n\nExpected beta warnings from `RubricMiddleware` and Pregel v3 streaming\ncurrently flood unit-test output, while media-offload failure warnings\nare emitted without being asserted.\n\nThis scopes exact-message warning filters to the tests that\nintentionally exercise those beta APIs and captures the media-offload\nwarnings with `pytest.warns`. Unrelated warnings remain visible.","verified_at":"2026-07-14T07:45:59Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/e61156d2b29f1f25a80aa8e2c10b479444accb6b","html_url":"https://github.com/langchain-ai/deepagents/commit/e61156d2b29f1f25a80aa8e2c10b479444accb6b","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/e61156d2b29f1f25a80aa8e2c10b479444accb6b/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c633f108429301c621e7ac9852dd0a4b9ee9aecb","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/c633f108429301c621e7ac9852dd0a4b9ee9aecb","html_url":"https://github.com/langchain-ai/deepagents/commit/c633f108429301c621e7ac9852dd0a4b9ee9aecb"}]},{"sha":"c633f108429301c621e7ac9852dd0a4b9ee9aecb","node_id":"C_kwDOPTymldoAKGM2MzNmMTA4NDI5MzAxYzYyMWU3YWM5ODUyZGQwYTRiOWVlOWFlY2I","commit":{"author":{"name":"John Kennedy","email":"65985482+jkennedyvz@users.noreply.github.com","date":"2026-07-14T07:38:32Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-14T07:38:32Z"},"message":"fix(evals): bump aiohttp to 3.14.1 (#4716)\n\nUpdates the evals lockfile transitive `aiohttp` dependency from 3.13.5\nto 3.14.1, the minimum patched version that resolves all active\n`aiohttp` Dependabot alerts.\n\nResolves Dependabot alerts #453, #533–#540, #626, and #627.\n\nValidated with `uv lock --check` and the evals unit-test suite (260\npassed).\n\nCo-authored-by: Deep Agent <agent@deepagents.dev>","tree":{"sha":"06b324a55cb717aad585efb282deaef13a228897","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/06b324a55cb717aad585efb282deaef13a228897"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/c633f108429301c621e7ac9852dd0a4b9ee9aecb","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqVed4CRC1aQ7uu5UhlAAAp6gQAGiKCbBX9+EcQIxuSMv+NLcH\nUERbriYuy9YZaf7d4GKliWQTIpE272/y8q0JoLa+wj83G+qzAM4nDMVVXZizURA3\nRkKVIY3K0Z0XTDE8uUyM92DrNs7dE1jRGvSlOCMrXSJ3GBiJuz/m6yQbNBPX1jYk\nFHhFgZUszpVCxYT87rZVah56PHi3yCMIZw8d3KrGFYosLUDhSn82gYHJTIQuYNNM\nt8P4/EAKo0PEI+ZPPj/MR+ydPhCG76W+VnICl/ZiLcAZwytWCVJbVb4xmOP1tHu8\n791Nol10JFJQPYNiw+p5pt8ZVbGZFb3cZ4un5f33u3TRWccgQ8Sl0Tm2NWIkheis\nCuTfP9haINtBV81qv4ANneQaW9nuZOXsxHVprQt5trsGOE7HN+Hpr07S1oyb+U20\ntraTYunHmHh8oaViR0jCBCtuSsMnCtlClojVXdCzpCtWLj0SxELDNDDcatbTbJ4s\nlfGcZzKCAuD9rwv1DE+01e9ViXT+4L8+Wucxhx4FSzUxfmdZhDNKUO389Svn8+/v\nKbiWhTDZ3aNzxZJQgkDRsXIzJGO3JCWNxoD27g+CtQxZchmz1Zl9316rL8Kq+/bC\nSiWE87daAODFB/qp/GbZ4q8KMEVRGM0KZSE+E3gYZkekQOcsU8i5QNl1vTaIshqY\nIJ+WozTJl2TJLq8Pyhrn\n=F/u8\n-----END PGP SIGNATURE-----\n","payload":"tree 06b324a55cb717aad585efb282deaef13a228897\nparent 73bd9735697b95c664727657128708022fbe04cf\nauthor John Kennedy <65985482+jkennedyvz@users.noreply.github.com> 1784014712 -0700\ncommitter GitHub <noreply@github.com> 1784014712 -0700\n\nfix(evals): bump aiohttp to 3.14.1 (#4716)\n\nUpdates the evals lockfile transitive `aiohttp` dependency from 3.13.5\nto 3.14.1, the minimum patched version that resolves all active\n`aiohttp` Dependabot alerts.\n\nResolves Dependabot alerts #453, #533–#540, #626, and #627.\n\nValidated with `uv lock --check` and the evals unit-test suite (260\npassed).\n\nCo-authored-by: Deep Agent <agent@deepagents.dev>","verified_at":"2026-07-14T07:38:32Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/c633f108429301c621e7ac9852dd0a4b9ee9aecb","html_url":"https://github.com/langchain-ai/deepagents/commit/c633f108429301c621e7ac9852dd0a4b9ee9aecb","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/c633f108429301c621e7ac9852dd0a4b9ee9aecb/comments","author":{"login":"jkennedyvz","id":65985482,"node_id":"MDQ6VXNlcjY1OTg1NDgy","avatar_url":"https://avatars.githubusercontent.com/u/65985482?v=4","gravatar_id":"","url":"https://api.github.com/users/jkennedyvz","html_url":"https://github.com/jkennedyvz","followers_url":"https://api.github.com/users/jkennedyvz/followers","following_url":"https://api.github.com/users/jkennedyvz/following{/other_user}","gists_url":"https://api.github.com/users/jkennedyvz/gists{/gist_id}","starred_url":"https://api.github.com/users/jkennedyvz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jkennedyvz/subscriptions","organizations_url":"https://api.github.com/users/jkennedyvz/orgs","repos_url":"https://api.github.com/users/jkennedyvz/repos","events_url":"https://api.github.com/users/jkennedyvz/events{/privacy}","received_events_url":"https://api.github.com/users/jkennedyvz/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"73bd9735697b95c664727657128708022fbe04cf","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/73bd9735697b95c664727657128708022fbe04cf","html_url":"https://github.com/langchain-ai/deepagents/commit/73bd9735697b95c664727657128708022fbe04cf"}]},{"sha":"73bd9735697b95c664727657128708022fbe04cf","node_id":"C_kwDOPTymldoAKDczYmQ5NzM1Njk3Yjk1YzY2NDcyNzY1NzEyODcwODAyMmZiZTA0Y2Y","commit":{"author":{"name":"github-actions[bot]","email":"41898282+github-actions[bot]@users.noreply.github.com","date":"2026-07-14T07:36:56Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-14T07:36:56Z"},"message":"release(deepagents-code): 0.1.38 (#4703)\n\n> [!CAUTION]\n> Merging this PR will automatically publish to **PyPI** and create a\n**GitHub release**.\n\nFor the full release process, see\n[`.github/RELEASING.md`](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md).\n\n---\n\n_Release notes preview: keep this section in sync with the package\n`CHANGELOG.md`. The published GitHub release body is extracted from the\nmerged `CHANGELOG.md` by `release.yml`, not from this PR description._\n\n---\n\n\n##\n[0.1.38](https://github.com/langchain-ai/deepagents/compare/deepagents-code==0.1.37...deepagents-code==0.1.38)\n(2026-07-14)\n\n### Features\n\n* Improve `/goal` criteria UX\n([#4694](https://github.com/langchain-ai/deepagents/issues/4694))\n([06f46ff](https://github.com/langchain-ai/deepagents/commit/06f46fffe36efa9f3adcb331b07df283d8bed874))\n* Add interactive goal management\n([#4693](https://github.com/langchain-ai/deepagents/issues/4693))\n([64205e2](https://github.com/langchain-ai/deepagents/commit/64205e238c280ae05b2bf9253ac40c6f85ffb49c))\n* Conditionally drop `TodoListMiddleware`\n([#4685](https://github.com/langchain-ai/deepagents/issues/4685))\n([d3a3077](https://github.com/langchain-ai/deepagents/commit/d3a3077e8536696dcf4a9dcd8555e9c871562e74))\n* Add `memory.auto_save` config flag\n([#4700](https://github.com/langchain-ai/deepagents/issues/4700))\n([55b60ca](https://github.com/langchain-ai/deepagents/commit/55b60ca08da4eef294ac3c162610b2a151584ea5))\n* Trace experimental mode in metadata\n([#4705](https://github.com/langchain-ai/deepagents/issues/4705))\n([22d5045](https://github.com/langchain-ai/deepagents/commit/22d50456324e9b8c0121a3a06787e19c1b88e1aa))\n\n### Bug Fixes\n\n* Align context diff rows with changed rows\n([#4714](https://github.com/langchain-ai/deepagents/issues/4714))\n([f9915db](https://github.com/langchain-ai/deepagents/commit/f9915db4206ef2d794ad07fdccbdd4ee58963142))\n* Hydrate virtualized transcript on scroll offset changes\n([#4646](https://github.com/langchain-ai/deepagents/issues/4646))\n([f77eeb0](https://github.com/langchain-ai/deepagents/commit/f77eeb0a036281f84bf7d0b05ea60e02630f55c1))\n* Keep TODO and edit tools expanded\n([#4704](https://github.com/langchain-ai/deepagents/issues/4704))\n([1d549d3](https://github.com/langchain-ai/deepagents/commit/1d549d3f3c9bb60c3ce39d4a0c913bcefe9610d5))\n* Make `/goal` completion and grading reliable\n([#4691](https://github.com/langchain-ai/deepagents/issues/4691))\n([9da63c6](https://github.com/langchain-ai/deepagents/commit/9da63c64a59503e3366e9bc7224cb1251af476be))\n* Preflight Ollama host reachability before discovery probe\n([#4702](https://github.com/langchain-ai/deepagents/issues/4702))\n([96fe71a](https://github.com/langchain-ai/deepagents/commit/96fe71a3815e1020edeb3be1af70b0cadb85931c))\n* Quiet expected non-repo `git ls-files` logging\n([#4701](https://github.com/langchain-ai/deepagents/issues/4701))\n([3d499db](https://github.com/langchain-ai/deepagents/commit/3d499db8a6c76743810a8983107d7c7d7bdb35e6))\n* Rename `ls_agent_kind` to `ls_agent_purpose`\n([#4708](https://github.com/langchain-ai/deepagents/issues/4708))\n([2678b16](https://github.com/langchain-ai/deepagents/commit/2678b1680d8928e72e8efae00632a694c9b2737a))\n* Run MCP login during a run, queue the restart\n([#4643](https://github.com/langchain-ai/deepagents/issues/4643))\n([65e1ee8](https://github.com/langchain-ai/deepagents/commit/65e1ee802e2f69762a6d8e6c7c6d37060161ea5a))\n* Show \"Took &lt;duration&gt;\" when `task` tool completes\n([#4638](https://github.com/langchain-ai/deepagents/issues/4638))\n([19538e0](https://github.com/langchain-ai/deepagents/commit/19538e0a46a5c2c050412b79fd45608a63cdde52))\n* Support unambiguous `read_file` gutters\n([#4711](https://github.com/langchain-ai/deepagents/issues/4711))\n([2089b54](https://github.com/langchain-ai/deepagents/commit/2089b54e2a674ede313e790b59febf9dc6f22571))\n\n---\n\n_End release notes preview._\n\n---\n\n> [!NOTE]\n> A **New Contributors** section is appended to the GitHub release notes\nautomatically at publish time (see [Release\nPipeline](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md#release-pipeline),\nstep 2).\n\n---------\n\nCo-authored-by: github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","tree":{"sha":"3090da8f77a5a9b9573b47d85aff7cbe8562566f","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/3090da8f77a5a9b9573b47d85aff7cbe8562566f"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/73bd9735697b95c664727657128708022fbe04cf","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqVecYCRC1aQ7uu5UhlAAAD5EQAGvii18EA18SnZXeJixILusF\nzi/XujQlQ6V08CKAYHe4IN2xCDbLJbrp0AEauT3mfooyTnfEvY+a9iPf5ZgWUrTt\nXOMJ1QJAoUmmBG+nYHkYvvvvs/FKJci1PziTz/LfZsvYd9U/xDTWq96MMR/joDQ4\nOIdv80Mosaex3OdFzuYXZb4eiwx4RbB4VRBeD4ZIZQjqzbyrjCQCTTH1NewpIJcp\nsU0OHsgp2ER7aaFQi9wKuW90ArzXBTTW6BIwcrHBiPSf/0Iw6VTLa88ybjE5bTZi\nycbb0JUV2lD+m0Cr56kWn1GYxZ5VhYDW7bcudJH7o47sNI5QsrbIznxGyrYR79XD\nJ/0VrTRa9PLnD9ut4J8iZag/N4S/N6eipwCg3fAOyY5qqe8R9WwKEwIHftpFnSkR\ndFdsL+zkPUD4/SYwowmVBeqBLE5MF3XIUY0QrOdqD8m43AY/EN5eYFDrLQ+3NKtI\nPZm0xuIpcRqKayRpJZZwt4+bGjcs72dZW2y0Hjb6TGnSkiB85eJ0MjrR/my3oSqH\nRllaJpyS9rtjzbK6/k+4niOwJlpgHnj1usY0+3BWduxNEybr+eV0nfW/h7q2KHqB\ny890bub1met4/mCpBOLHRe2QxhsTQywgsjocb88xQKFLmCgcOwk8S0iKraA49/s4\nA8xA/039FWrVbkdNe5Z5\n=zRVZ\n-----END PGP SIGNATURE-----\n","payload":"tree 3090da8f77a5a9b9573b47d85aff7cbe8562566f\nparent 06f46fffe36efa9f3adcb331b07df283d8bed874\nauthor github-actions[bot] <41898282+gith