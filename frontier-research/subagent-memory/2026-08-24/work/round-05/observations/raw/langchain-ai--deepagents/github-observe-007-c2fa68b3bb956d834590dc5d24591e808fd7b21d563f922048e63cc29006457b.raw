it/a80355abd9d4579eee483f654faa5f2b373590a0"}]},{"sha":"a80355abd9d4579eee483f654faa5f2b373590a0","node_id":"C_kwDOPTymldoAKGE4MDM1NWFiZDlkNDU3OWVlZTQ4M2Y2NTRmYWE1ZjJiMzczNTkwYTA","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-27T21:47:15Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-27T21:47:15Z"},"message":"feat(code): toast when submitting empty required `ask_user` answer (#5095)\n\n`ask_user` now shows a warning toast when you press Enter on a required\nquestion without an answer.\n\n---\n\nPressing Enter on a required `ask_user` question with an empty answer\npreviously did nothing and gave no feedback. This surfaces a warning\ntoast prompting the user to type an answer before continuing, so the\nblocked submit is no longer silent.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/0137f4f3-a001-2eb9-5cac-2616cfa197df)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"8c2acb3eadb7bb3159cdf7776e692c95ce6ca875","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/8c2acb3eadb7bb3159cdf7776e692c95ce6ca875"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/a80355abd9d4579eee483f654faa5f2b373590a0","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqZ9HjCRC1aQ7uu5UhlAAAYb8QAK/yXfhQFfi78cvSqrNkd2sn\nmaywi94rzAV0i9BauNylLog4nnnwlZ3e76BjP00phY2yIM6lSBAayw6eHYFn9/OD\nch3VNOcvk9rw/4sxdVCklTHFI3CvLGtV1qBBI43e8w2Ix6quuh2kUuSrj8Y+8Xr/\nLAP5mCMGXccAvpVoVZNEMyEiIumcrfdSd3gKmir85qakPMCug0g/F+Wq7GPFzF83\nBacP4r3gjVxdhjxhnRf2p7HPth8aPcqFo7J9VwhdMCtWjooJepL4s1V+EuAQENoj\n0bQj3PFcloSWKs4dghy3D30BJ+y3COFWz5jdV29VAAUhzEn87PmvANld1zGNvTQD\n4aW4cu8imEdpdTLxSagPLSnNx8lo6PInYeuhXqERdk6jk94VwLiBammLrw6nLKkL\nsvbFk9swMkCVzKt+MxF+icQXBqOAGJUXAvjUCiUgbI+OVmGhzU6YxMfReGrVzm2z\ni0GWz1heGZX67498LZIFxMj714a13s97+BGIyGsizLxguzKyO71OAmozPLm1eHOu\nSVVIbTiOWZocgGBVGU5L5PTwwI7AoxHZPlOYJeZRBuG2Mgapsj5eB0lU1vtbgMNZ\nfqtOq/pCIJUYfJfR1OwyEld3Acvm3XE2/g5DKJxAnUB9k86Ocl+4dxWnYwe87mJx\nSfAnGyY8Hu1VeHzJk9Ll\n=Cqxf\n-----END PGP SIGNATURE-----\n","payload":"tree 8c2acb3eadb7bb3159cdf7776e692c95ce6ca875\nparent 641b408e621a92cbc537d724a87e4021d4992288\nauthor Mason Daugherty <mason@langchain.dev> 1785188835 -0400\ncommitter GitHub <noreply@github.com> 1785188835 -0400\n\nfeat(code): toast when submitting empty required `ask_user` answer (#5095)\n\n`ask_user` now shows a warning toast when you press Enter on a required\nquestion without an answer.\n\n---\n\nPressing Enter on a required `ask_user` question with an empty answer\npreviously did nothing and gave no feedback. This surfaces a warning\ntoast prompting the user to type an answer before continuing, so the\nblocked submit is no longer silent.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/0137f4f3-a001-2eb9-5cac-2616cfa197df)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-07-27T21:47:16Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a80355abd9d4579eee483f654faa5f2b373590a0","html_url":"https://github.com/langchain-ai/deepagents/commit/a80355abd9d4579eee483f654faa5f2b373590a0","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a80355abd9d4579eee483f654faa5f2b373590a0/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organ