ub.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"cac3fd377ba42fb0c7abaadc4c91499640762344","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/cac3fd377ba42fb0c7abaadc4c91499640762344","html_url":"https://github.com/langchain-ai/deepagents/commit/cac3fd377ba42fb0c7abaadc4c91499640762344"}]},{"sha":"cac3fd377ba42fb0c7abaadc4c91499640762344","node_id":"C_kwDOPTymldoAKGNhYzNmZDM3N2JhNDJmYjBjN2FiYWFkYzRjOTE0OTk2NDA3NjIzNDQ","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-23T19:22:18Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-23T19:22:18Z"},"message":"chore(code): add `make check`/`make bootstrap` for local CI parity (#3966)\n\nReduces the \"green-local / red-CI\" friction for `libs/code`\ncontributors. Adds a single `make bootstrap` (sync deps + install git\nhooks) and `make check` (run the CI gauntlet locally: lint, types,\nimports, tests, plus the cross-cutting repo gates). Also closes two\npre-commit gaps where the `extras-sync` hook only covered `libs/cli` and\nthe `deepagents` SDK pin had no local check at all (the new check is\nadvisory, matching the existing workflow's nature).\n\nMade by [Open SWE](https://openswe.vercel.app)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"9985d41f7aa6e52ca310e429562ee12837ee6e64","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/9985d41f7aa6e52ca310e429562ee12837ee6e64"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/cac3fd377ba42fb0c7abaadc4c91499640762344","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqOtzqCRC1aQ7uu5UhlAAA9MkQADCjXMyYgU89ODnoKzHV9Xz1\nwLxblx2pHB6B0SZEiofc7E8wByaLXve6QM1kKrbdpoUMz/jp/VjBrgwftiymu7sm\n4p/sVoArCBMMg2nBH8chjxXJbbiNaR5VwPMZQKaq99bFXBlyGHB+yxw/gMoFAYAp\n2G7Fi1BjM71taS15VJfYkrNw7ybVSD3LJ+SR6ZXY1Q4FkMnL7oeebXIRBqHzKHIR\nZxnAu6laHONZc7jR9KeNeC5lvqGSV8Sth/NsprmDg9MQQz00verXTLoUSiNE+mvb\nSk0qOc2Z/KBgBZRGWb8le8ksPGeEgYTUfM4dj4DDEs16aAm8tp97rI4tmKDisKpV\nkRA85iu/Zo6s13RK/NK5CxMMkT+ZIVqS4oyUgw27MLnnZeEbg2K2wWppfVAGxDNW\nQs45YIm492Em6AqK7Hq4ioVYyEZAS1/aCyjARVmqlmOfcK6ADYaU4guQjzkD3Iqr\nZOQTsUKMIiRsBH/uUpzmxunCbs939P5WvHF5hKFQ1ya/6871Z4bz5D488EmZ29Rw\nTZOrzEBE41Wdvc4JVQUkVPb1JWE1/mQwELL8kyTMcSihRG2BNuiQVKs8YlcoaRMf\nLKwVKkydXilxivinhEMOqgxsHxjnN17JMTvxBCQZIQ1tjfjMSmswQuLB4jLLYnXi\nLkNmgM5MC9bmBW8rUixo\n=ryQF\n-----END PGP SIGNATURE-----\n","payload":"tree 9985d41f7aa6e52ca310e429562ee12837ee6e64\nparent bfec11ab4ce87add1721e691b00dac1da80d87ba\nauthor Mason Daugherty <mason@langchain.dev> 1782242538 -0400\ncommitter GitHub <noreply@github.com> 1782242538 -0400\n\nchore(code): add `make check`/`make bootstrap` for local CI parity (#3966)\n\nReduces the \"green-local / red-CI\" friction for `libs/code`\ncontributors. Adds a single `make bootstrap` (sync deps + install git\nhooks) and `make check` (run the CI gauntlet locally: lint, types,\nimports, tests, plus the cross-cutting repo gates). Also closes two\npre-commit gaps where the `extras-sync` hook only covered `libs/cli` and\nthe `deepagents` SDK pin had no local check at all (the new check is\nadvisory, matching the existing workflow's nature).\n\nMade by [Open SWE](https://openswe.vercel.app)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-23T19:22:19Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/cac3fd377ba42fb0c7abaadc4c91499640762344","html_url":"https://github.com/langchain-ai/deepagents/commit/cac3fd377ba42fb0c7abaadc4c91499640762344","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/cac3fd377ba42fb0c7abaadc4c91499640762344/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"bfec11ab4ce87add1721e691b00dac1da80d87ba","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/bfec11ab4ce87add1721e691b00dac1da80d87ba","html_url":"https://github.com/langchain-ai/deepagents/commit/bfec11ab4ce87add1721e691b00dac1da80d87ba"}]},{"sha":"bfec11ab4ce87add1721e691b00dac1da80d87ba","node_id":"C_kwDOPTymldoAKGJmZWMxMWFiNGNlODdhZGQxNzIxZTY5MWIwMGRhYzFkYTgwZDg3YmE","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-23T18:26:12Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-23T18:26:12Z"},"message":"fix(ci): surface absent-detector desync and document scope-check trust model (#4177)\n\nFollow-up hardening for the two scope-check merge gates\n(`release_please_scope_check.yml`, `pr_scope_file_check.yml`), applying\nreview findings from the trusted-base work in #4175 / #4171.\n\n- **Make a silently-disabled gate visible.** The detector-absent branch\n(bootstrapping PR or a branch cut before the gate existed) is a\ndeliberate fail-open. If the detector is ever renamed or moved on `base`\nwithout updating the hard-coded path, that same branch would silently\nstop enforcing. Escalating its `::notice::` to `::warning::` surfaces\nthe desync in the Checks UI instead of only the fold-out log. The gate's\npass/fail logic is unchanged.\n- **Scope the trust-model comment.** The base checkout closes only the\ndetector/config edit vector; under `pull_request` the workflow file\nitself comes from the PR head, so integrity also depends on branch\nprotection plus review of `.github/workflows/` edits. The comment now\nsays so rather than implying the gate is un-bypassable.\n- **Document the base-config staleness tradeoff.** Running the detector\nand config from `base` means a PR that itself adds a new package (or\nlabeler rule) is not checked against it until it lands on base. Reading\nhead config would reopen the bypass the base checkout closes, so this is\nintentional, not a regression.\n- **Better diagnostics on swallowed errors.** The three `core.warning`\nfallbacks now include `[status=…]`, matching the already-merged\n`release_please_initial_baseline_check.yml`.\n- **Lock the wire contract.** Added a test asserting the detector prints\nexactly `[]` on a clean PR — the contract the workflow's fail-closed\nJSON parse and the detector-absent sentinel both rely on.","tree":{"sha":"baa3c6c1f580ccb554fff66f03d4fa2d08ccae8a","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/baa3c6c1f580ccb554fff66f03d4fa2d08ccae8a"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/bfec11ab4ce87add1721e691b00dac1da80d87ba","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqOs/ECRC1aQ7uu5UhlAAAEzoQADCh16hgSAm29jh5yGH3pGRk\nBfyh652RmGv4Yh8tQN5HkgQy8tzu07QKTwzFM/AXMTpJYFLELhR914+z1XyWm04z\nnHUl+wx+ekRQ7FOE+nyfn8K/XW6Jam+OCgpFHWmRmfb40CnwkLguFQ+LlS6PrLiA\nfTtugJF1sdIKyc2H+o0ngFUkO8qQpyd2zhd5o3gM/fgWP3DVB+sxd/HvXqBjG8YH\n0aAttUTwoIPGanblGqVqCXSjLRL3Jq+WvYIxrtaq+nEh+5mn/oMG78V7jhbphpw6\n0U9GuakcgFa7QdEDNS+TCEP+BlPPDxBTM/e3CgDGsfPMNTnhmqVdiASFsygC4zVQ\nPc9GTTaOtHyiWirNj62ibl7N8IKzmO9RyDO16Nq58oWj0UMLoGdGCAG10siQ0nSJ\n9jGB7Gs+b81zrI+KAUclIGkIdYnEdOPJsDT+acy7rQGLxeVbcUoPYTJK1218xn1z\nvU+BUPNyAuYYA7aLy81xTr+7XOBUh81UYfh0QrSBaIshs5seGE0EjscElr2tlqU/\nkD4SqYnuesIR9M6oAeN7vUjvMSzzOlMWC/A4t5pHsHHQFpitFw0PgC4hIwb70pi9\ncSBYLAkyAM06IL5B6ZbxDiEYvmwT3PmIU7Lqy0/bDUERW+ODjptdsnrHXy4EirVK\nEdQk2vCgy1HoRD/ZMdDv\n=mMCX\n-----END PGP SIGNATURE-----\n","payload":"tree baa3c6c1f580ccb554fff66f03d4fa2d08ccae8a\nparent 80739b656d27723cd7bd0fa8b4d37ed285b304b7\nauthor Mason Daugherty <mason@langchain.dev> 1782239172 -0400\ncommitter GitHub <noreply@github.com> 1782239172 -0400\n\nfix(ci): surface absent-detector desync and document scope-check trust model (#4177)\n\nFollow-up hardening for the two scope-check merge gates\n(`release_please_scope_check.yml`, `pr_scope_file_check.yml`), applying\nreview findings from the trusted-base work in #4175 / #4171.\n\n- **Make a silently-disabled gate visible.** The detector-absent branch\n(bootstrapping PR or a branch cut before the gate existed) is a\ndeliberate fail-open. If the detector is ever renamed or moved on `base`\nwithout updating the hard-coded path, that same branch would silently\nstop enforcing. Escalating its `::notice::` to `::warning::` surfaces\nthe desync in the Checks UI instead of only the fold-out log. The gate's\npass/fail logic is unchanged.\n- **Scope the trust-model comment.** The base checkout closes only the\ndetector/config edit vector; under `pull_request` the workflow file\nitself comes from the PR head, so integrity also depends on branch\nprotection plus review of `.github/workflows/` edits. The comment now\nsays so rather than implying the gate is un-bypassable.\n- **Document the base-config staleness tradeoff.** Running the detector\nand config from `base` means a PR that itself adds a new package (or\nlabeler rule) is not checked against it until it lands on base. Reading\nhead config would reopen the bypass the base checkout closes, so this is\nintentional, not a regression.\n- **Better diagnostics on swallowed errors.** The three `core.warning`\nfallbacks now include `[status=…]`, matching the already-merged\n`release_please_initial_baseline_check.yml`.\n- **Lock the wire contract.** Added a test asserting the detector prints\nexactly `[]` on a clean PR — the contract the workflow's fail-closed\nJSON parse and the detector-absent sentinel both rely on.","verified_at":"2026-06-23T18:26:12Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/bfec11ab4ce87add1721e691b00dac1da80d87ba","html_url":"https://github.com/langchain-ai/deepagents/commit/bfec11ab4ce87add1721e691b00dac1da80d87ba","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/bfec11ab4ce87add1721e691b00dac1da80d87ba/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"80739b656d27723cd7bd0fa8b4d37ed285b304b7","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/80739b656d27723cd7bd0fa8b4d37ed285b304b7","html_url":"https://github.com/langchain-ai/deepagents/commit/80739b656d27723cd7bd0fa8b4d37ed285b304b7"}]},{"sha":"80739b656d27723cd7bd0fa8b4d37ed285b304b7","node_id":"C_kwDOPTymldoAKDgwNzM5YjY1NmQyNzcyM2NkN2JkMGZhOGI0ZDM3ZWQyODViMzA0Yjc","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-23T16:36:37Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-23T16:36:37Z"},"message":"feat(ci): block package scope file mismatches (#4171)\n\nAdds a pre-merge CI check that compares the package scopes declared by a\nPR title with the package directories touched by the PR. The check uses\nthe existing PR labeler config as its source of truth, so scope aliases\nlike `code`/`deepagents-code` and directory mappings like `libs/code/`\nstay aligned with the rest of the repo automation.\n\nWhen a PR declares one package scope but touches a different package\ndirectory, the workflow posts a sticky warning comment and fails. If the\nmismatch is intentional, maintainers can apply `allow-scope-mismatch` to\ndowngrade the block to an informational note while keeping the mismatch\nvisible.\n\nThe detector is covered by unit tests for matching scope/file pairs, the\n`fix(cli)` + `libs/code/**` mismatch, multi-scope titles, unscoped\nscopes/paths, and config-read fail-closed behavior.","tree":{"sha":"52eb32e6004ae4144bff0afc63f842382c2f8cac","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/52eb32e6004ae4144bff0afc63f842382c2f8cac"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/80739b656d27723cd7bd0fa8b4d37ed285b304b7","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqOrYVCRC1aQ7uu5UhlAAANwEQAHpEH8rWBMvpkiF7CveJZ2yw\nMmSYAJIw2qmfxIhtw18uUv2hSuSeQvIuBlMxB2iIjiFOc+qdIjopG1qyfjX+e68h\nFjYq5C6GlBR6MVuqUmTxTt8DzLQJUlrldwJRiqVRqYSvJCgZkWDjw3w0n62CUp2Q\ntRW+qciy10bFa6Vdvh2/SYJbC4vL0TWHo0yRgEyJN7cbmapZgpZseAXvpCyoZlkJ\nal3FlpiUtQyEsK2WENaz6QHNSNl0tR+PqZ6yd0hKK7a5Np9TokHQwJIbexR0a5AE\nXUaJgtiij6sgzyVWfUb8j0SVArFlZ4UsehoOV4KHoOK4hcyo0wtuBrOn/XmrH3Qf\nlwRu8hUVcYEx3ZF1HMCmRVRGO2pN+fEoc9mM5clu6YB6YH/lhU1K9Qhjxte8mHJn\nxzpvI5QL99ikKPWBjDhh/YBS+pVj9QT0yiL6AQWmzhtkpeqUSm98RdvDF7oKD6eu\n4YY2ViTwOUcCiGTw/njErww/e5aT0wfbRcP3CYq9vUZyZujD+DnxaWKAbUTqTi5V\n9TsrHyyllBhJ5jfdFcUKssFE2bkNIV2M1yGUjt3W36nd5kQ6dWpNOxbi/n7VFy8L\niMClr3xVm/er3g/3galWiB9QpDQJG9g0SCOWMzeCZx8GZss4RhC19WZjOTaL7ucl\nO23AX6yzjJU7nFwlQpVa\n=3pIx\n-----END PGP SIGNATURE-----\n","payload":"tree 52eb32e6004ae4144bff0afc63f842382c2f8cac\nparent 2477f8ae79781cbb10bf80ecf868c277ab223142\nauthor Mason Daugherty <mason@langchain.dev> 1782232597 -0400\ncommitter GitHub <noreply@github.com> 1782232597 -0400\n\nfeat(ci): block package scope file mismatches (#4171)\n\nAdds a pre-merge CI check that compares the package scopes declared by a\nPR title with the package directories touched by the PR. The check uses\nthe existing PR labeler config as its source of truth, so scope aliases\nlike `code`/`deepagents-code` and directory mappings like `libs/code/`\nstay aligned with the rest of the repo automation.\n\nWhen a PR declares one package scope but touches a different package\ndirectory, the workflow posts a sticky warning comment and fails. If the\nmismatch is intentional, maintainers can apply `allow-scope-mismatch` to\ndowngrade the block to an informational note while keeping the mismatch\nvisible.\n\nThe detector is covered by unit tests for matching scope/file pairs, the\n`fix(cli)` + `libs/code/**` mismatch, multi-scope titles, unscoped\nscopes/paths, and config-read fail-closed behavior.","verified_at":"2026-06-23T16:36:37Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/80739b656d27723cd7bd0fa8b4d37ed285b304b7","html_url":"https://github.com/langchain-ai/deepagents/commit/80739b656d27723cd7bd0fa8b4d37ed285b304b7","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/80739b656d27723cd7bd0fa8b4d37ed285b304b7/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"2477f8ae79781cbb10bf80ecf868c277ab223142","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/2477f8ae79781cbb10bf80ecf868c277ab223142","html_url":"https://github.com/langchain-ai/deepagents/commit/2477f8ae79781cbb10bf80ecf868c277ab223142"}]},{"sha":"2477f8ae79781cbb10bf80ecf868c277ab223142","node_id":"C_kwDOPTymldoAKDI0NzdmOGFlNzk3ODFjYmIxMGJmODBlY2Y4NjhjMjc3YWIyMjMxNDI","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-23T16:35:05Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-23T16:35:05Z"},"message":"fix(ci): run release-please scope check from trusted base revision (#4175)\n\nThe `release-please` scope check (`release_please_scope_check.yml`) is a\npre-merge gate that blocks lockfile-only release fan-out. It ran its\ndetector (`check_lockfile_release_scope.py`) and\n`release-please-config.json` from the **PR head** checkout while the job\nheld `pull-requests: write`. That created two problems:\n\n- **Self-bypass:** a PR could edit the detector or the config to print\n`[]`, passing the very gate meant to block it — defeating the check for\nexactly the PRs it should catch.\n- **Token exposure:** the default `persist-credentials: true` writes the\njob token into the checkout's git config, where PR-author-controlled\ncode could read it.\n\nThis checks out the PR **base** revision instead of the head, so the\ndetector and config are trusted; sets `persist-credentials: false`; and\nadds a bootstrap guard so a base revision that predates the detector is\ntreated as clean rather than erroring (a PR cannot make `base` lack the\nfile, so this is not a bypass). It also fails closed when\n`changed_files` is non-numeric instead of silently skipping the\ntruncation guard.\n\nThe approach mirrors the trusted-base pattern already used by\n`release_please_initial_baseline_check.yml`, and matches the same\nhardening applied to `pr_scope_file_check.yml` in #4171, where this\nclass of issue was first flagged in review.","tree":{"sha":"e31afe278a8c186c7213eb728819b1702c42122d","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/e31afe278a8c186c7213eb728819b1702c42122d"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/2477f8ae79781cbb10bf80ecf868c277ab223142","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqOrW5CRC1aQ7uu5UhlAAAknYQAI6gVjJTsvRKg1MEkbTVG/4h\nF4MOF0Xbq8OP1F5nqmPjL/zJnFNyR5I9+zZAubXhrTVCE8AHMve62tKbDfa+8tJn\nw4Do7U7J+VW1drJ3+TNsCcdIuDpZKoVqL+1MORTRyPhj/dKYxSLhXB8fJ1vftZQs\nyGXWSSXq/FJmzzfL1W4hL7xMQm9C1nvLNyExOMxZWMKHedqmUvzUz3h35NoL0VG7\n1G8RJlQHHYfTP+2x42x5AN0WyUuKlgK1lX9yhVD1ZOpAT+moPdZ/Nl5NULgZZB93\nuc25zVqhWp1rzEQqttswUWlLJEt5QmoOoHrIxCBP24YXdr5c1APTc24/VgURm45v\nb+t2FBENXy0GjkbEp2WBpZ0WwaadAgrTb6LVL3UiyG5u0lg5jOI2pcEyntHOAHrr\nnT94UOmeYmE1imywUPj9KVERPUfMnU2v/HZOiHduXGv6hCMf7ZSToHVVSXXtI6bV\nWsird+8hVeIVuIHTr2YlgyLrcmU3UvYRSHFlmeKYNIUX36lfZ0Epj0yjVWF2kO2W\nyUNMiuX4iJdyJUSZKhTdkHNYBOnrwVdQpF/j6fS/UXPz4aNyVkZrtyFDYeBS+MyT\nhOWYHRPGhTqqZQrIl2tLZU17AHbltXK/uNFUWA0f/FR2UgCQQJTXo2f7+p3CFiQw\nEZGU4yhekEwd+zSuedEP\n=hrkx\n-----END PGP SIGNATURE-----\n","payload":"tree e31afe278a8c186c7213eb728819b1702c42122d\nparent 83e7957bc5ef8b0dc3e933cb75896326a7ee2d98\nauthor Mason Daugherty <mason@langchain.dev> 1782232505 -0400\ncommitter GitHub <noreply@github.com> 1782232505 -0400\n\nfix(ci): run release-please scope check from trusted base revision (#4175)\n\nThe `release-please` scope check (`release_please_scope_check.yml`) is a\npre-merge gate that blocks lockfile-only release fan-out. It ran its\ndetector (`check_lockfile_release_scope.py`) and\n`release-please-config.json` from the **PR head** checkout while the job\nheld `pull-requests: write`. That created two problems:\n\n- **Self-bypass:** a PR could edit the detector or the config to print\n`[]`, passing the very gate meant to block it — defeating the check for\nexactly the PRs it should catch.\n- **Token exposure:** the default `persist-credentials: true` writes the\njob token into the checkout's git config, where PR-author-controlled\ncode could read it.\n\nThis checks out the PR **base** revision instead of the head, so the\ndetector and config are trusted; sets `persist-credentials: false`; and\nadds a bootstrap guard so a base revision that predates the detector is\ntreated as clean rather than erroring (a PR cannot make `base` lack the\nfile, so this is not a bypass). It also fails closed when\n`changed_files` is non-numeric instead of silently skipping the\ntruncation guard.\n\nThe approach mirrors the trusted-base pattern already used by\n`release_please_initial_baseline_check.yml`, and matches the same\nhardening applied to `pr_scope_file_check.yml` in #4171, where this\nclass of issue was first flagged in review.","verified_at":"2026-06-23T16:35:06Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/2477f8ae79781cbb10bf80ecf868c277ab223142","html_url":"https://github.com/langchain-ai/deepagents/commit/2477f8ae79781cbb10bf80ecf868c277ab223142","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/2477f8ae79781cbb10bf80ecf868c277ab223142/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"83e7957bc5ef8b0dc3e933cb75896326a7ee2d98","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/83e7957bc5ef8b0dc3e933cb75896326a7ee2d98","html_url":"https://github.com/langchain-ai/deepagents/commit/83e7957bc5ef8b0dc3e933cb75896326a7ee2d98"}]},{"sha":"83e7957bc5ef8b0dc3e933cb75896326a7ee2d98","node_id":"C_kwDOPTymldoAKDgzZTc5NTdiYzVlZjhiMGRjM2U5MzNjYjc1ODk2MzI2YTdlZTJkOTg","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-23T15:01:44Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-23T15:01:44Z"},"message":"test(code): clean up unit test warnings (#4169)\n\n`make test` in `libs/code` had started reporting warning noise from a\nfew dependency and test-helper paths, which made it harder to notice new\nwarnings in the unit suite.\n\nThis keeps the production `LocalShellBackend` construction explicit\nabout `virtual_mode=False`, and localizes expected dependency warnings\nin the tests that intentionally instantiate beta or experimental\nclasses. It also avoids socket-guard warnings from test-only setup paths\nby disabling unrelated MCP metadata preload in non-interactive tests and\npassing explicit empty socket options when constructing the Codex model\nunder the socket guard.","tree":{"sha":"2feb2865fe4200fbe721799634f50ea591108aca","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/2feb2865fe4200fbe721799634f50ea591108aca"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/83e7957bc5ef8b0dc3e933cb75896326a7ee2d98","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqOp/YCRC1aQ7uu5UhlAAA2JsQAH2qX2TTnEnWiUt59S8gd0mA\nlkpb2oPiXG9hUlq5Kx2EdorfYsOAMye1VLROgaxcZiVKH4w30ARZbLLpk6P2dvKc\n1I7ayrw0OfHzEOqAbXZgsf1ODNsGllbAr2HYaZgVgqfIr4hADY+uCZuuut0UKqA+\nxsVRop8f8sWX+5lePi2dlHRe4GPW5YorHlgLeYWEbyxHNa0CSNCFiV4Lh8N/R8A6\nJUmnzz5WnKCQ8Yrrs1KpKNk0QScsC9Lyne4Tnf3rfp1bMrBOrYCvzYxh9EKzVTtd\nEUraYMHAIkYZZZDXMAaqVjx5ZxBXziaWLyn9cqhf+wPxVm7rC+1HbB/ifPkV2npc\nfd0NZhCGJ57tb6pNKs4nObkniwMbK4BHMy0rqvBvuKMh1a8Iddi8nS+sJL2TCZGG\nvwB/khl2o3Rs/cfI23wFkd/UTyQKhbJDu5vr/FI+h3j++xKR0jYn062ciFmpuOns\nBv8bf+c5Dl6Jby7TQyO8Y6FOu581jFlDTKSvLJ3OOCvs86XRAHmaEvr5OMOX2Sd0\nuHhjf1m2M1cR8ek1kWDv+AUhsFIA8t61bx3t44gwjrnPDFpKKWEHc8AzQrQy/jT+\nCHC3w8GuoNbq7akVfzYcsBrbHhbLPQM7xQeNHY9jYCWAN243ZW33KyJO38z6TJN/\nyYgAxpUK/1bBcygpYvB2\n=q0B7\n-----END PGP SIGNATURE-----\n","payload":"tree 2feb2865fe4200fbe721799634f50ea591108aca\nparent 31a2dc2db0f1585be6fd74e6fc2822b5dae5bc9a\nauthor Mason Daugherty <mason@langchain.dev> 1782226904 -0400\ncommitter GitHub <noreply@github.com> 1782226904 -0400\n\ntest(code): clean up unit test warnings (#4169)\n\n`make test` in `libs/code` had started reporting warning noise from a\nfew dependency and test-helper paths, which made it harder to notice new\nwarnings in the unit suite.\n\nThis keeps the production `LocalShellBackend` construction explicit\nabout `virtual_mode=False`, and localizes expected dependency warnings\nin the tests that intentionally instantiate beta or experimental\nclasses. It also avoids socket-guard warnings from test-only setup paths\nby disabling unrelated MCP metadata preload in non-interactive tests and\npassing explicit empty socket options when constructing the Codex model\nunder the socket guard.","verified_at":"2026-06-23T15:01:45Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/83e7957bc5ef8b0dc3e933cb75896326a7ee2d98","html_url":"https://github.com/langchain-ai/deepagents/commit/83e7957bc5ef8b0dc3e933cb75896326a7ee2d98","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/83e7957bc5ef8b0dc3e933cb75896326a7ee2d98/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","