[{"sha":"b6e153c9853702424a7d1179b0f635c60c15aef4","node_id":"C_kwDOOYsS4doAKGI2ZTE1M2M5ODUzNzAyNDI0YTdkMTE3OWIwZjYzNWM2MGMxNWFlZjQ","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-17T19:19:20Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T19:59:22Z"},"message":"Render only visible rows in the transcript pager (#39063)\n\n## Why\n\nScrolling the transcript pager previously rendered a scratch buffer containing\nall rows through the visible viewport, including hidden content above it. This\nmade rendering work and buffer size grow with the scroll offset.\n\n## What changed\n\n- Add viewport-aware rendering for committed transcript cells and the live tail.\n- Forward scrolled rendering through cached and inset renderables while keeping\n  the full-height fallback for renderables that do not support it.\n- Keep hyperlink metadata aligned with scrolled text.\n\n## Testing\n\nAdd coverage comparing viewport-aware output with the full-height fallback\nacross wrapping widths, offsets, insets, styles, hyperlinks, and live tails.\n\nGitOrigin-RevId: 630c30c4a61969a50f2b34701ca1dd87788a4298","tree":{"sha":"2c780d79061aa9d6cf27e6c05aedc09ba957dbac","url":"https://api.github.com/repos/openai/codex/git/trees/2c780d79061aa9d6cf27e6c05aedc09ba957dbac"},"url":"https://api.github.com/repos/openai/codex/git/commits/b6e153c9853702424a7d1179b0f635c60c15aef4","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/b6e153c9853702424a7d1179b0f635c60c15aef4","html_url":"https://github.com/openai/codex/commit/b6e153c9853702424a7d1179b0f635c60c15aef4","comments_url":"https://api.github.com/repos/openai/codex/commits/b6e153c9853702424a7d1179b0f635c60c15aef4/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"386a7b629c4fa4b5c9d5d4df60f156dbd7bf7b1d","url":"https://api.github.com/repos/openai/codex/commits/386a7b629c4fa4b5c9d5d4df60f156dbd7bf7b1d","html_url":"https://github.com/openai/codex/commit/386a7b629c4fa4b5c9d5d4df60f156dbd7bf7b1d"}]},{"sha":"386a7b629c4fa4b5c9d5d4df60f156dbd7bf7b1d","node_id":"C_kwDOOYsS4doAKDM4NmE3YjYyOWM0ZmE0YjVjOWQ1ZDRkZjYwZjE1NmRiZDdiZjdiMWQ","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-17T19:19:03Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T19:49:47Z"},"message":"Avoid rerendering streamed code fences (#39061)\n\n## Why\n\nThe streaming TUI rerendered the entire mutable Markdown block whenever a\nnewline-bearing delta arrived. For long fenced code blocks, this repeatedly\nparsed and syntax-highlighted the growing fence.\n\n## What changed\n\n- Detect open, top-level, language-tagged code fences and append newly\n  completed lines directly to the existing render.\n- Preserve Syntect parser state across appended lines so multiline syntax and\n  the active theme remain consistent.\n- Fall back to the canonical Markdown renderer for ambiguous fence syntax,\n  theme changes, incomplete lines, and highlighting limit transitions.\n\n## Testing\n\nAdded coverage that compares streamed output with full renders across syntax\nstyles, Unicode, links, blank lines, fence variants, theme changes, and\nhighlighting limits. A long-fence test also verifies that the rendered prefix\nis retained as new lines arrive.\n\nGitOrigin-RevId: 036db2b7bc93607083b8001f8b4fa3cbb58c713e","tree":{"sha":"4d8460a4998f9daf2d2cbe00a4d6f7f9b4284882","url":"https://api.github.com/repos/openai/codex/git/trees/4d8460a4998f9daf2d2cbe00a4d6f7f9b4284882"},"url":"https://api.github.com/repos/openai/codex/git/commits/386a7b629c4fa4b5c9d5d4df60f156dbd7bf7b1d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/386a7b629c4fa4b5c9d5d4df60f156dbd7bf7b1d","html_url":"https://github.com/openai/codex/commit/386a7b629c4fa4b5c9d5d4df60f156dbd7bf7b1d","comments_url":"https://api.github.com/repos/openai/codex/commits/386a7b629c4fa4b5c9d5d4df60f156dbd7bf7b1d/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"80e925c28b7f6752b83ea42e7856a1b7e36d7a1e","url":"https://api.github.com/repos/openai/codex/commits/80e925c28b7f6752b83ea42e7856a1b7e36d7a1e","html_url":"https://github.com/openai/codex/commit/80e925c28b7f6752b83ea42e7856a1b7e36d7a1e"}]},{"sha":"80e925c28b7f6752b83ea42e7856a1b7e36d7a1e","node_id":"C_kwDOOYsS4doAKDgwZTkyNWMyOGI3ZjY3NTJiODNlYTQyZTc4NTZhMWI3ZTM2ZDdhMWU","commit":{"author":{"name":"chess","email":"chess@openai.com","date":"2026-08-17T19:15:41Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T19:43:09Z"},"message":"Add desktop app diagnostics to `codex doctor` (#39060)\n\n## What changed\n\n- Detect installed Codex desktop apps on macOS and Windows and report their version, running state, and redacted log location.\n- Inspect bounded log data for the active desktop session and report the latest local app-server handshake outcome without exposing other log fields.\n- Add a dedicated Desktop App section to human-readable doctor reports.\n\n## Testing\n\n- Cover local versus remote handshakes, failed handshakes with sensitive fields, bounded log reads, and stopped desktop sessions.\n\nGitOrigin-RevId: ecfb4bd7af3589263624771ec9413b51953280eb","tree":{"sha":"2a1f11266b7b633ada894549f784d7fd0df1d6fc","url":"https://api.github.com/repos/openai/codex/git/trees/2a1f11266b7b633ada894549f784d7fd0df1d6fc"},"url":"https://api.github.com/repos/openai/codex/git/commits/80e925c28b7f6752b83ea42e7856a1b7e36d7a1e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/80e925c28b7f6752b83ea42e7856a1b7e36d7a1e","html_url":"https://github.com/openai/codex/commit/80e925c28b7f6752b83ea42e7856a1b7e36d7a1e","comments_url":"https://api.github.com/repos/openai/codex/commits/80e925c28b7f6752b83ea42e7856a1b7e36d7a1e/comments","author":{"login":"chess-oai","id":289791516,"node_id":"U_kgDOEUXeHA","avatar_url":"https://avatars.githubusercontent.com/u/289791516?v=4","gravatar_id":"","url":"https://api.github.com/users/chess-oai","html_url":"https://github.com/chess-oai","followers_url":"https://api.github.com/users/chess-oai/followers","following_url":"https://api.github.com/users/chess-oai/following{/other_user}","gists_url":"https://api.github.com/users/chess-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/chess-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chess-oai/subscriptions","organizations_url":"https://api.github.com/users/chess-oai/orgs","repos_url":"https://api.github.com/users/chess-oai/repos","events_url":"https://api.github.com/users/chess-oai/events{/privacy}","received_events_url":"https://api.github.com/users/chess-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"14973840e0d46799d893b55c8035c6dec492674c","url":"https://api.github.com/repos/openai/codex/commits/14973840e0d46799d893b55c8035c6dec492674c","html_url":"https://github.com/openai/codex/commit/14973840e0d46799d893b55c8035c6dec492674c"}]},{"sha":"14973840e0d46799d893b55c8035c6dec492674c","node_id":"C_kwDOOYsS4doAKDE0OTczODQwZTBkNDY3OTlkODkzYjU1YzgwMzVjNmRlYzQ5MjY3NGM","commit":{"author":{"name":"thomas","email":"tsarlandie@openai.com","date":"2026-08-17T19:13:09Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T19:38:18Z"},"message":"Tag Codex Apps protocol discovery metrics (#39058)\n\n## What changed\n\nAdd `server_kind=openai_codex_apps` to the\n`codex.mcp.protocol_discovery` counter and its duration metric when protocol\ndiscovery runs for the Codex Apps MCP server. Other MCP servers retain the\nexisting `mode` and `outcome` tags.\n\nGitOrigin-RevId: aadbdc54642f2c103a9f1bab39308e962c115f75","tree":{"sha":"87138d0c9b18df1f2785d7e2c246d772035b49a6","url":"https://api.github.com/repos/openai/codex/git/trees/87138d0c9b18df1f2785d7e2c246d772035b49a6"},"url":"https://api.github.com/repos/openai/codex/git/commits/14973840e0d46799d893b55c8035c6dec492674c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/14973840e0d46799d893b55c8035c6dec492674c","html_url":"https://github.com/openai/codex/commit/14973840e0d46799d893b55c8035c6dec492674c","comments_url":"https://api.github.com/repos/openai/codex/commits/14973840e0d46799d893b55c8035c6dec492674c/comments","author":{"login":"tsarlandie-oai","id":291887306,"node_id":"U_kgDOEWXYyg","avatar_url":"https://avatars.githubusercontent.com/u/291887306?v=4","gravatar_id":"","url":"https://api.github.com/users/tsarlandie-oai","html_url":"https://github.com/tsarlandie-oai","followers_url":"https://api.github.com/users/tsarlandie-oai/followers","following_url":"https://api.github.com/users/tsarlandie-oai/following{/other_user}","gists_url":"https://api.github.com/users/tsarlandie-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/tsarlandie-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tsarlandie-oai/subscriptions","organizations_url":"https://api.github.com/users/tsarlandie-oai/orgs","repos_url":"https://api.github.com/users/tsarlandie-oai/repos","events_url":"https://api.github.com/users/tsarlandie-oai/events{/privacy}","received_events_url":"https://api.github.com/users/tsarlandie-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"796325f1e584e6171abb7b282b62a37777bc51e4","url":"https://api.github.com/repos/openai/codex/commits/796325f1e584e6171abb7b282b62a37777bc51e4","html_url":"https://github.com/openai/codex/commit/796325f1e584e6171abb7b282b62a37777bc51e4"}]},{"sha":"796325f1e584e6171abb7b282b62a37777bc51e4","node_id":"C_kwDOOYsS4doAKDc5NjMyNWYxZTU4NGU2MTcxYWJiN2IyODJiNjJhMzc3NzdiYzUxZTQ","commit":{"author":{"name":"Tamir Duberstein","email":"tamird@openai.com","date":"2026-08-17T19:00:43Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T19:34:05Z"},"message":"Rate-limit TUI frames from their actual emission time (#39057)\n\n## Why\n\nRecording a late frame's requested deadline as its emission time can leave the\nrate limiter with a stale timestamp, allowing the next frame to be emitted\nimmediately in a redraw burst.\n\n## What changed\n\nRecord the current time when the frame scheduler sends a draw notification so\nthe 120 FPS limit is measured from the actual emission.\n\n## Testing\n\nAdd a paused-time regression test that submits an overdue draw and verifies the\nnext frame waits for `MIN_FRAME_INTERVAL`.\n\nGitOrigin-RevId: 8c9a5ac0bf858b2ad87838f6d7c67c9470fdfc61","tree":{"sha":"152992c014db31b0d145a3b0d008b07d25c6dcd1","url":"https://api.github.com/repos/openai/codex/git/trees/152992c014db31b0d145a3b0d008b07d25c6dcd1"},"url":"https://api.github.com/repos/openai/codex/git/commits/796325f1e584e6171abb7b282b62a37777bc51e4","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/796325f1e584e6171abb7b282b62a37777bc51e4","html_url":"https://github.com/openai/codex/commit/796325f1e584e6171abb7b282b62a37777bc51e4","comments_url":"https://api.github.com/repos/openai/codex/commits/796325f1e584e6171abb7b282b62a37777bc51e4/comments","author":{"login":"tamird","id":1535036,"node_id":"MDQ6VXNlcjE1MzUwMzY=","avatar_url":"https://avatars.githubusercontent.com/u/1535036?v=4","gravatar_id":"","url":"https://api.github.com/users/tamird","html_url":"https://github.com/tamird","followers_url":"https://api.github.com/users/tamird/followers","following_url":"https://api.github.com/users/tamird/following{/other_user}","gists_url":"https://api.github.com/users/tamird/gists{/gist_id}","starred_url":"https://api.github.com/users/tamird/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tamird/subscriptions","organizations_url":"https://api.github.com/users/tamird/orgs","repos_url":"https://api.github.com/users/tamird/repos","events_url":"https://api.github.com/users/tamird/events{/privacy}","received_events_url":"https://api.github.com/users/tamird/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"afb1b3c98435d228f516f4ed7c79cd04e8c493c5","url":"https://api.github.com/repos/openai/codex/commits/afb1b3c98435d228f516f4ed7c79cd04e8c493c5","html_url":"https://github.com/openai/codex/commit/afb1b3c98435d228f516f4ed7c79cd04e8c493c5"}]},{"sha":"afb1b3c98435d228f516f4ed7c79cd04e8c493c5","node_id":"C_kwDOOYsS4doAKGFmYjFiM2M5ODQzNWQyMjhmNTE2ZjRlZDdjNzljZDA0ZThjNDkzYzU","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-17T18:58:03Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T19:30:38Z"},"message":"Verify the pinned zsh manifest in release builds (#39056)\n\n## Why\n\nRelease jobs download the `codex-zsh` manifest before packaging or signing its\nbundled binaries. Verify that download against a pinned digest so an unexpected\nmanifest cannot enter release artifacts.\n\n## What changed\n\n- Pin the SHA-256 digest for the `codex-zsh-v0.1.0` manifest.\n- Add a portable verification script that uses `sha256sum` or macOS `shasum`.\n- Run verification in both the package archive and macOS helper signing flows.\n\nGitOrigin-RevId: a404bb897c8cc0bf3c0ff38e8a6e1cce059d7fab","tree":{"sha":"cfe427d658eea975b8b6b0e8003b5c939a7aeae4","url":"https://api.github.com/repos/openai/codex/git/trees/cfe427d658eea975b8b6b0e8003b5c939a7aeae4"},"url":"https://api.github.com/repos/openai/codex/git/commits/afb1b3c98435d228f516f4ed7c79cd04e8c493c5","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/afb1b3c98435d228f516f4ed7c79cd04e8c493c5","html_url":"https://github.com/openai/codex/commit/afb1b3c98435d228f516f4ed7c79cd04e8c493c5","comments_url":"https://api.github.com/repos/openai/codex/commits/afb1b3c98435d228f516f4ed7c79cd04e8c493c5/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4a7b51c560aaef0a89298272d3fff1aefe3dd666","url":"https://api.github.com/repos/openai/codex/commits/4a7b51c560aaef0a89298272d3fff1aefe3dd666","html_url":"https://github.com/openai/codex/commit/4a7b51c560aaef0a89298272d3fff1aefe3dd666"}]},{"sha":"4a7b51c560aaef0a89298272d3fff1aefe3dd666","node_id":"C_kwDOOYsS4doAKDRhN2I1MWM1NjBhYWVmMGE4OTI5ODI3MmQzZmZmMWFlZmUzZGQ2NjY","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-08-17T18:57:32Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T19:22:45Z"},"message":"Add network policy metadata to environment configuration (#39055)\n\n## What changed\n\n- Add `EnvironmentNetworkPolicy` as a serializable view of portable domain,\n  Unix-socket, upstream-proxy, and local-binding restrictions without exposing\n  controller-owned proxy runtime settings.\n- Add an optional `network_policy` field to `EnvironmentConfig` and re-export\n  the policy and related permission types through the core APIs.\n- Reject owner-provided network policies during environment preview and\n  readiness until runtime enforcement is implemented, while preserving the\n  existing controller policy when the field is absent.\n\n## Testing\n\n- Cover rejection through both environment preview and readiness, including\n  preservation of the existing environment selection.\n\nGitOrigin-RevId: 80ad4cf4d4a45632daa7a823e6cf568eb0e8bb80","tree":{"sha":"fa12e473db10ea6d5ee39999ea1c7ba6684536cb","url":"https://api.github.com/repos/openai/codex/git/trees/fa12e473db10ea6d5ee39999ea1c7ba6684536cb"},"url":"https://api.github.com/repos/openai/codex/git/commits/4a7b51c560aaef0a89298272d3fff1aefe3dd666","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4a7b51c560aaef0a89298272d3fff1aefe3dd666","html_url":"https://github.com/openai/codex/commit/4a7b51c560aaef0a89298272d3fff1aefe3dd666","comments_url":"https://api.github.com/repos/openai/codex/commits/4a7b51c560aaef0a89298272d3fff1aefe3dd666/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fe5889928c24f98b32ca1fd8c7a2ebe275da60bf","url":"https://api.github.com/repos/openai/codex/commits/fe5889928c24f98b32ca1fd8c7a2ebe275da60bf","html_url":"https://github.com/openai/codex/commit/fe5889928c24f98b32ca1fd8c7a2ebe275da60bf"}]},{"sha":"fe5889928c24f98b32ca1fd8c7a2ebe275da60bf","node_id":"C_kwDOOYsS4doAKGZlNTg4OTkyOGMyNGY5OGIzMmNhMWZkOGM3YTJlYmUyNzVkYTYwYmY","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-17T18:57:15Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T19:11:34Z"},"message":"Use installed callable apps for TUI mentions (#39051)\n\n## Why\n\nThe app directory is a discovery catalog and can include apps that are not\ncallable in the active thread. Using it for `$` suggestions can therefore\noffer mentions that cannot be used.\n\n## What changed\n\n- Load mention candidates from `app/installed`, enrich callable apps through\n  bounded `app/read` batches, and retain compatibility with app servers that\n  do not support `app/installed`.\n- Keep the mention catalog separate from the `/apps` directory cache and scope\n  results to the current thread, workspace, and account.\n- Refresh mentions after app notifications, enablement changes, configuration\n  updates, and apps MCP readiness, while immediately removing disabled apps.\n\n## Testing\n\nAdd coverage for batching and fallback behavior, stale scoped results,\nnotification refreshes, enablement changes, MCP startup races, and filtering\nnon-callable apps from mentions.\n\nGitOrigin-RevId: 4d9e20794aed30cc97120170792fb555b86fe1e7","tree":{"sha":"95e8d838b411fc94814e4973666150f9c94fcde7","url":"https://api.github.com/repos/openai/codex/git/trees/95e8d838b411fc94814e4973666150f9c94fcde7"},"url":"https://api.github.com/repos/openai/codex/git/commits/fe5889928c24f98b32ca1fd8c7a2ebe275da60bf","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fe5889928c24f98b32ca1fd8c7a2ebe275da60bf","html_url":"https://github.com/openai/codex/commit/fe5889928c24f98b32ca1fd8c7a2ebe275da60bf","comments_url":"https://api.github.com/repos/openai/codex/commits/fe5889928c24f98b32ca1fd8c7a2ebe275da60bf/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"d7d526b81db92eb0ee6a47dfed9cee9f92b1935f","url":"https://api.github.com/repos/openai/codex/commits/d7d526b81db92eb0ee6a47dfed9cee9f92b1935f","html_url":"https://github.com/openai/codex/commit/d7d526b81db92eb0ee6a47dfed9cee9f92b1935f"}]},{"sha":"d7d526b81db92eb0ee6a47dfed9cee9f92b1935f","node_id":"C_kwDOOYsS4doAKGQ3ZDUyNmI4MWRiOTJlYjBlZTZhNDdkZmVkOWNlZTlmOTJiMTkzNWY","commit":{"author":{"name":"Felipe Coury","email":"felipe.coury@openai.com","date":"2026-08-17T18:57:02Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T19:06:53Z"},"message":"Prepare the telemetry shutdown worker during initialization (#39050)\n\n## Why\n\nCreating the telemetry shutdown thread during shutdown can fail under resource\npressure, including when the native thread guard page cannot be allocated.\n\n## What changed\n\n- Start and verify a dedicated shutdown worker when `OtelProvider` is created.\n- Send the provider to the prepared worker for bounded shutdown, while preserving\n  timeout behavior and avoiding a potentially blocking destructor if worker\n  preparation failed.\n- Rename the fallible provider constructor to `try_new`.\n\n## Testing\n\nAdd Unix regression coverage that injects guard-page allocation failures, plus\ncoverage for worker preparation failure, successful shutdown, and timeouts.\n\nGitOrigin-RevId: 3656298078a800a7fa392437c2ee4a68753092e3","tree":{"sha":"94340392b4cb7fc08cf083619d0c1d43ec9c4373","url":"https://api.github.com/repos/openai/codex/git/trees/94340392b4cb7fc08cf083619d0c1d43ec9c4373"},"url":"https://api.github.com/repos/openai/codex/git/commits/d7d526b81db92eb0ee6a47dfed9cee9f92b1935f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/d7d526b81db92eb0ee6a47dfed9cee9f92b1935f","html_url":"https://github.com/openai/codex/commit/d7d526b81db92eb0ee6a47dfed9cee9f92b1935f","comments_url":"https://api.github.com/repos/openai/codex/commits/d7d526b81db92eb0ee6a47dfed9cee9f92b1935f/comments","author":{"login":"fcoury-oai","id":272635208,"node_id":"U_kgDOEEAVSA","avatar_url":"https://avatars.githubusercontent.com/u/272635208?v=4","gravatar_id":"","url":"https://api.github.com/users/fcoury-oai","html_url":"https://github.com/fcoury-oai","followers_url":"https://api.github.com/users/fcoury-oai/followers","following_url":"https://api.github.com/users/fcoury-oai/following{/other_user}","gists_url":"https://api.github.com/users/fcoury-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/fcoury-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fcoury-oai/subscriptions","organizations_url":"https://api.github.com/users/fcoury-oai/orgs","repos_url":"https://api.github.com/users/fcoury-oai/repos","events_url":"https://api.github.com/users/fcoury-oai/events{/privacy}","received_events_url":"https://api.github.com/users/fcoury-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"1a8bac9405a2b37e907e59d0207a2900999dedc9","url":"https://api.github.com/repos/openai/codex/commits/1a8bac9405a2b37e907e59d0207a2900999dedc9","html_url":"https://github.com/openai/codex/commit/1a8bac9405a2b37e907e59d0207a2900999dedc9"}]},{"sha":"1a8bac9405a2b37e907e59d0207a2900999dedc9","node_id":"C_kwDOOYsS4doAKDFhOGJhYzk0MDVhMmIzN2U5MDdlNTlkMDIwN2EyOTAwOTk5ZGVkYzk","commit":{"author":{"name":"Benjamin Carlsson","email":"bc@openai.com","date":"2026-08-17T18:56:00Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T19:02:05Z"},"message":"Avoid rendering sub-agent activity twice in the TUI (#39049)\n\n## Why\n\nThe app server sends sub-agent activity in both item-started and item-completed\nnotifications, causing the TUI to add the same activity to history twice.\n\n## What changed\n\nRender live sub-agent activity when the item completes instead of also rendering\nit when the item starts. Preserve the existing replay behavior.\n\n## Testing\n\nAdd a regression test that sends matching started and completed notifications\nand verifies that the activity produces one history cell.\n\nGitOrigin-RevId: 76a66f3657fe297f37067ed672ab9642997b4499","tree":{"sha":"bc7fbdcae945f3a1c2c56a0e37c0a83193396c14","url":"https://api.github.com/repos/openai/codex/git/trees/bc7fbdcae945f3a1c2c56a0e37c0a83193396c14"},"url":"https://api.github.com/repos/openai/codex/git/commits/1a8bac9405a2b37e907e59d0207a2900999dedc9","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/1a8bac9405a2b37e907e59d0207a2900999dedc9","html_url":"https://github.com/openai/codex/commit/1a8bac9405a2b37e907e59d0207a2900999dedc9","comments_url":"https://api.github.com/repos/openai/codex/commits/1a8bac9405a2b37e907e59d0207a2900999dedc9/comments","author":{"login":"bc-openai","id":185964850,"node_id":"U_kgDOCxWZMg","avatar_url":"https://avatars.githubusercontent.com/u/185964850?v=4","gravatar_id":"","url":"https://api.github.com/users/bc-openai","html_url":"https://github.com/bc-openai","followers_url":"https://api.github.com/users/bc-openai/followers","following_url":"https://api.github.com/users/bc-openai/following{/other_user}","gists_url":"https://api.github.com/users/bc-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/bc-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bc-openai/subscriptions","organizations_url":"https://api.github.com/users/bc-openai/orgs","repos_url":"https://api.github.com/users/bc-openai/repos","events_url":"https://api.github.com/users/bc-openai/events{/privacy}","received_events_url":"https://api.github.com/users/bc-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"0c901fd141875f92c306ae699798946e516a5970","url":"https://api.github.com/repos/openai/codex/commits/0c901fd141875f92c306ae699798946e516a5970","html_url":"https://github.com/openai/codex/commit/0c901fd141875f92c306ae699798946e516a5970"}]},{"sha":"0c901fd141875f92c306ae699798946e516a5970","node_id":"C_kwDOOYsS4doAKDBjOTAxZmQxNDE4NzVmOTJjMzA2YWU2OTk3OTg5NDZlNTE2YTU5NzA","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-17T18:48:34Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T18:54:49Z"},"message":"Skip plugin hook loading when hooks are disabled (#39047)\n\n## What changed\n\nGate plugin hook resolution in `hooks/list` on both the hooks and plugins\nfeature flags. When hooks are disabled, return the default empty plugin hook\noutcome without loading plugin hook sources or warnings.\n\nGitOrigin-RevId: 166070576effaba248b790c4f2a47e6e9a7b1112","tree":{"sha":"90a4073e56673cca203aae2168c814f0fc4c4f42","url":"https://api.github.com/repos/openai/codex/git/trees/90a4073e56673cca203aae2168c814f0fc4c4f42"},"url":"https://api.github.com/repos/openai/codex/git/commits/0c901fd141875f92c306ae699798946e516a5970","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/0c901fd141875f92c306ae699798946e516a5970","html_url":"https://github.com/openai/codex/commit/0c901fd141875f92c306ae699798946e516a5970","comments_url":"https://api.github.com/repos/openai/codex/commits/0c901fd141875f92c306ae699798946e516a5970/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"ff770113ca37160a9e3906c511ecc9ff59dd9925","url":"https://api.github.com/repos/openai/codex/commits/ff770113ca37160a9e3906c511ecc9ff59dd9925","html_url":"https://github.com/openai/codex/commit/ff770113ca37160a9e3906c511ecc9ff59dd9925"}]},{"sha":"ff770113ca37160a9e3906c511ecc9ff59dd9925","node_id":"C_kwDOOYsS4doAKGZmNzcwMTEzY2EzNzE2MGE5ZTM5MDZjNTExZWNjOWZmNTlkZDk5MjU","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-17T18:38:07Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T18:46:12Z"},"message":"Restrict MCP HTTP redirects to the configured origin (#39046)\n\n## Why\n\nMCP requests can contain sensitive headers and tool-call bodies. Following a\ncross-origin redirect could disclose them to another server.\n\n## What changed\n\n- Follow redirects only when every hop remains on the configured server's\n  origin, and require HTTPS for redirects on non-loopback hostnames.\n- Preserve standard redirect method and body handling while sharing the\n  original timeout and enforcing a 10-hop limit.\n- Avoid replaying plaintext proxy credentials across redirects, while leaving\n  OAuth requests that stop at redirects unchanged.\n\n## Testing\n\nAdd coverage for same-origin and cross-origin redirects, redirect methods,\nheaders and bodies, proxy credentials, timeouts, hop limits, and legacy MCP\ntool calls.\n\nGitOrigin-RevId: 3e267911a1665ad8c2fc63825099a758770f4d68","tree":{"sha":"89d1f7f48d03b5d76870345124c23e1b037c073e","url":"https://api.github.com/repos/openai/codex/git/trees/89d1f7f48d03b5d76870345124c23e1b037c073e"},"url":"https://api.github.com/repos/openai/codex/git/commits/ff770113ca37160a9e3906c511ecc9ff59dd9925","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/ff770113ca37160a9e3906c511ecc9ff59dd9925","html_url":"https://github.com/openai/codex/commit/ff770113ca37160a9e3906c511ecc9ff59dd9925","comments_url":"https://api.github.com/repos/openai/codex/commits/ff770113ca37160a9e3906c511ecc9ff59dd9925/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"06418909a0357f2248b5e35d82ec8d9138e99bb8","url":"https://api.github.com/repos/openai/codex/commits/06418909a0357f2248b5e35d82ec8d9138e99bb8","html_url":"https://github.com/openai/codex/commit/06418909a0357f2248b5e35d82ec8d9138e99bb8"}]},{"sha":"06418909a0357f2248b5e35d82ec8d9138e99bb8","node_id":"C_kwDOOYsS4doAKDA2NDE4OTA5YTAzNTdmMjI0OGI1ZTM1ZDgyZWM4ZDkxMzhlOTliYjg","commit":{"author":{"name":"Shijie Rao","email":"shijie.rao@openai.com","date":"2026-08-17T18:34:02Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T18:41:50Z"},"message":"Add managed gates for in-app chat and dictation (#39045)\n\n## What changed\n\n- Register `in_app_chat` and `in_app_dictation` as stable, default-enabled feature gates for desktop apps.\n- Allow requirements to disable either capability and expose both keys in the generated configuration schema.\n\n## Testing\n\n- Add configuration tests that verify enterprise requirements can disable each gate.\n\nGitOrigin-RevId: 5bba35d710fb0b6924aa55df98b2e013fa288f6d","tree":{"sha":"b6c1905b32185c5aac940e12ab442a9832fb4d0b","url":"https://api.github.com/repos/openai/codex/git/trees/b6c1905b32185c5aac940e12ab442a9832fb4d0b"},"url":"https://api.github.com/repos/openai/codex/git/commits/06418909a0357f2248b5e35d82ec8d9138e99bb8","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/06418909a0357f2248b5e35d82ec8d9138e99bb8","html_url":"https://github.com/openai/codex/commit/06418909a0357f2248b5e35d82ec8d9138e99bb8","comments_url":"https://api.github.com/repos/openai/codex/commits/06418909a0357f2248b5e35d82ec8d9138e99bb8/comments","author":{"login":"shijie-oai","id":235382242,"node_id":"U_kgDODgel4g","avatar_url":"https://avatars.githubusercontent.com/u/235382242?v=4","gravatar_id":"","url":"https://api.github.com/users/shijie-oai","html_url":"https://github.com/shijie-oai","followers_url":"https://api.github.com/users/shijie-oai/followers","following_url":"https://api.github.com/users/shijie-oai/following{/other_user}","gists_url":"https://api.github.com/users/shijie-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/shijie-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shijie-oai/subscriptions","organizations_url":"https://api.github.com/users/shijie-oai/orgs","repos_url":"https://api.github.com/users/shijie-oai/repos","events_url":"https://api.github.com/users/shijie-oai/events{/privacy}","received_events_url":"https://api.github.com/users/shijie-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"0f21cb3413ea2cc6623804a3c5e9493a30500199","url":"https://api.github.com/repos/openai/codex/commits/0f21cb3413ea2cc6623804a3c5e9493a30500199","html_url":"https://github.com/openai/codex/commit/0f21cb3413ea2cc6623804a3c5e9493a30500199"}]},{"sha":"0f21cb3413ea2cc6623804a3c5e9493a30500199","node_id":"C_kwDOOYsS4doAKDBmMjFjYjM0MTNlYTJjYzY2MjM4MDRhM2M1ZTk0OTNhMzA1MDAxOTk","commit":{"author":{"name":"Abhinav","email":"abhinav@openai.com","date":"2026-08-17T18:26:36Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T18:35:54Z"},"message":"Enforce managed authentication backend settings (#39043)\n\n## What changed\n\n- Add `cli_auth_credentials_store` and `chatgpt_base_url` as exact managed requirements loaded from local requirements configuration.\n- Apply these requirements to runtime and bootstrap authentication configuration, overriding user-configured values.\n- Expose the managed values through `configRequirements/read` and reject attempts to change them through config write APIs.\n- Ignore these local-only authentication requirements in cloud-managed requirement layers.\n\n## Testing\n\n- Cover requirement loading and composition, runtime and bootstrap overrides, app-server responses, and read-only config writes.\n\nGitOrigin-RevId: 8ea9c096386072036ca5441f3d48af8707988a65","tree":{"sha":"a9522cffc5b6397f47cd3c15ec9f2917f8b81431","url":"https://api.github.com/repos/openai/codex/git/trees/a9522cffc5b6397f47cd3c15ec9f2917f8b81431"},"url":"https://api.github.com/repos/openai/codex/git/commits/0f21cb3413ea2cc6623804a3c5e9493a30500199","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/0f21cb3413ea2cc6623804a3c5e9493a30500199","html_url":"https://github.com/openai/codex/commit/0f21cb3413ea2cc6623804a3c5e9493a30500199","comments_url":"https://api.github.com/repos/openai/codex/commits/0f21cb3413ea2cc6623804a3c5e9493a30500199/comments","author":{"login":"abhinav-oai","id":274334565,"node_id":"U_kgDOEFoDZQ","avatar_url":"https://avatars.githubusercontent.com/u/274334565?v=4","gravatar_id":"","url":"https://api.github.com/users/abhinav-oai","html_url":"https://github.com/abhinav-oai","followers_url":"https://api.github.com/users/abhinav-oai/followers","following_url":"https://api.github.com/users/abhinav-oai/following{/other_user}","gists_url":"https://api.github.com/users/abhinav-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/abhinav-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abhinav-oai/subscriptions","organizations_url":"https://api.github.com/users/abhinav-oai/orgs","repos_url":"https://api.github.com/users/abhinav-oai/repos","events_url":"https://api.github.com/users/abhinav-oai/events{/privacy}","received_events_url":"https://api.github.com/users/abhinav-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"d0fd4e830a2fe04577ae3098e2738edfd5750133","url":"https://api.github.com/repos/openai/codex/commits/d0fd4e830a2fe04577ae3098e2738edfd5750133","html_url":"https://github.com/openai/codex/commit/d0fd4e830a2fe04577ae3098e2738edfd5750133"}]},{"sha":"d0fd4e830a2fe04577ae3098e2738edfd5750133","node_id":"C_kwDOOYsS4doAKGQwZmQ0ZTgzMGEyZmUwNDU3N2FlMzA5OGUyNzM4ZWRmZDU3NTAxMzM","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-08-17T18:10:35Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T18:15:56Z"},"message":"Preserve foreign paths in managed network approvals (#39040)\n\n## Why\n\nUnified exec could drop network approval registration when a selected environment used a Windows working directory on a non-Windows host because the trigger path could not be converted to a host absolute path.\n\n## What changed\n\n- Keep network approval trigger working directories as `PathUri` values and render them with their inferred native path syntax for Guardian requests.\n- Fall back to the selected turn environment only when a trigger path can be converted to a host absolute path.\n- Reject selected environment working directories larger than 8 KiB at the thread-manager validation boundary.\n\n## Testing\n\n- Cover managed-network approval registration for a foreign Windows working directory.\n- Verify that oversized working directories are rejected as invalid `thread/start` requests.\n\nGitOrigin-RevId: 646fbf12115a35a7e5cb04b511464797bee6647b","tree":{"sha":"eea44eedb00103e9afd1338149ca616d7a953190","url":"https://api.github.com/repos/openai/codex/git/trees/eea44eedb00103e9afd1338149ca616d7a953190"},"url":"https://api.github.com/repos/openai/codex/git/commits/d0fd4e830a2fe04577ae3098e2738edfd5750133","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/d0fd4e830a2fe04577ae3098e2738edfd5750133","html_url":"https://github.com/openai/codex/commit/d0fd4e830a2fe04577ae3098e2738edfd5750133","comments_url":"https://api.github.com/repos/openai/codex/commits/d0fd4e830a2fe04577ae3098e2738edfd5750133/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"9dd3d6a13ef146cdcb60376f94a85d41918d16e3","url":"https://api.github.com/repos/openai/codex/commits/9dd3d6a13ef146cdcb60376f94a85d41918d16e3","html_url":"https://github.com/openai/codex/commit/9dd3d6a13ef146cdcb60376f94a85d41918d16e3"}]},{"sha":"9dd3d6a13ef146cdcb60376f94a85d41918d16e3","node_id":"C_kwDOOYsS4doAKDlkZDNkNmExM2VmMTQ2Y2RjYjYwMzc2Zjk0YTg1ZDQxOTE4ZDE2ZTM","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-17T17:17:59Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T17:33:30Z"},"message":"Restore Guardian risk scores across thread lifecycles (#39038)\n\n## Why\n\nResumed and forked threads need their persisted Guardian risk state available when routing later approval requests.\n\n## What changed\n\n- Initialize a session's `SecurityRiskScore` from the latest score in its rollout history when no score was supplied explicitly.\n- Preserve the inherited score when resuming or forking a thread so low-risk actions can skip redundant Guardian reviews.\n\n## Testing\n\n- Add app-server coverage for inheriting the latest Guardian score when resuming and forking threads.\n\nGitOrigin-RevId: 95a6c803f8dae75516d1da9d66a722379a0a7ef2","tree":{"sha":"ba68acaca3adac5331a96fad6a45aa34c16bdf2d","url":"https://api.github.com/repos/openai/codex/git/trees/ba68acaca3adac5331a96fad6a45aa34c16bdf2d"},"url":"https://api.github.com/repos/openai/codex/git/commits/9dd3d6a13ef146cdcb60376f94a85d41918d16e3","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/9dd3d6a13ef146cdcb60376f94a85d41918d16e3","html_url":"https://github.com/openai/codex/commit/9dd3d6a13ef146cdcb60376f94a85d41918d16e3","comments_url":"https://api.github.com/repos/openai/codex/commits/9dd3d6a13ef146cdcb60376f94a85d41918d16e3/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"1d928cad2f4ea831f1f30a659347c5a9459db206","url":"https://api.github.com/repos/openai/codex/commits/1d928cad2f4ea831f1f30a659347c5a9459db206","html_url":"https://github.com/openai/codex/commit/1d928cad2f4ea831f1f30a659347c5a9459db206"}]},{"sha":"1d928cad2f4ea831f1f30a659347c5a9459db206","node_id":"C_kwDOOYsS4doAKDFkOTI4Y2FkMmY0ZWE4MzFmMWYzMGE2NTkzNDdjNWE5NDU5ZGIyMDY","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-17T17:08:01Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T17:28:37Z"},"message":"Allow config reads to join active app-server read batches (#39036)\n\n## Why\n\nConfig reads arriving while a long-running shared read was active waited for that\nrequest to finish, even though they could safely run concurrently.\n\n## What changed\n\n- Admit newly queued shared reads into the active batch until an exclusive write\n  is queued, preserving the write as a fairness barrier.\n- Treat `hooks/list` and `configRequirements/read` as shared config reads.\n- Cover concurrent reads, read/write ordering, and config reads completing\n  alongside a `skills/list` request.\n\nGitOrigin-RevId: 8194301c2ba60be0fc71b8915923af9accc745dc","tree":{"sha":"2ec41eae5ebfc59d9cf2af46c476fa92fdbc72db","url":"https://api.github.com/repos/openai/codex/git/trees/2ec41eae5ebfc59d9cf2af46c476fa92fdbc72db"},"url":"https://api.github.com/repos/openai/codex/git/commits/1d928cad2f4ea831f1f30a659347c5a9459db206","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/1d928cad2f4ea831f1f30a659347c5a9459db206","html_url":"https://github.com/openai/codex/commit/1d928cad2f4ea831f1f30a659347c5a9459db206","comments_url":"https://api.github.com/repos/openai/codex/commits/1d928cad2f4ea831f1f30a659347c5a9459db206/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"71e5e1ec50775bc3abf8a12edfffe5eb803971d6","url":"https://api.github.com/repos/openai/codex/commits/71e5e1ec50775bc3abf8a12edfffe5eb803971d6","html_url":"https://github.com/openai/codex/commit/71e5e1ec50775bc3abf8a12edfffe5eb803971d6"}]},{"sha":"71e5e1ec50775bc3abf8a12edfffe5eb803971d6","node_id":"C_kwDOOYsS4doAKDcxZTVlMWVjNTA3NzViYzNhYmY4YTEyZWRmZmZlNWViODAzOTcxZDY","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-17T16:58:14Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T17:24:06Z"},"message":"Add app-server coverage for Guardian V2 approval routing (#39035)\n\n## What changed\n\n- Add end-to-end app-server tests for MCP tool approvals with Guardian V2 and automatic review enabled.\n- Verify that sampling receives the thread context, uses a thread-scoped prompt cache key, and persists the resulting action risk score.\n- Cover both routing outcomes: low-risk actions skip later Guardian reviews, while high-risk actions continue through full review.\n\nGitOrigin-RevId: 78ba2b0560caf701ad333785c4dda4f7d2be4f2c","tree":{"sha":"7d8ed2f0da28c81686820a0b8d8938387b61eccc","url":"https://api.github.com/repos/openai/codex/git/trees/7d8ed2f0da28c81686820a0b8d8938387b61eccc"},"url":"https://api.github.com/repos/openai/codex/git/commits/71e5e1ec50775bc3abf8a12edfffe5eb803971d6","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/71e5e1ec50775bc3abf8a12edfffe5eb803971d6","html_url":"https://github.com/openai/codex/commit/71e5e1ec50775bc3abf8a12edfffe5eb803971d6","comments_url":"https://api.github.com/repos/openai/codex/commits/71e5e1ec50775bc3abf8a12edfffe5eb803971d6/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"eeb82a156d1b3944dca4234c3043296529ec5837","url":"https://api.github.com/repos/openai/codex/commits/eeb82a156d1b3944dca4234c3043296529ec5837","html_url":"https://github.com/openai/codex/commit/eeb82a156d1b3944dca4234c3043296529ec5837"}]},{"sha":"eeb82a156d1b3944dca4234c3043296529ec5837","node_id":"C_kwDOOYsS4doAKGVlYjgyYTE1NmQxYjM5NDRkY2E0MjM0YzMwNDMyOTY1MjllYzU4Mzc","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-17T16:40:04Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T17:19:46Z"},"message":"Dispatch queued messages written by other processes (#39034)\n\n## Why\n\nDurable thread queues can be updated through another SQLite connection, but loaded idle threads need to notice those updates before they can dispatch the new messages.\n\n## What changed\n\n- Track a durable revision for each thread queue, including backfilling existing queues and updating revisions on inserts, updates, and deletes.\n- Poll SQLite's data version and query revisions to find changed queues for loaded threads.\n- Wake idle threads with pending external messages, discover queued work when threads are loaded or resumed, and retry each thread independently so one blocked queue does not stall others.\n\n## Testing\n\n- Cover cross-runtime queue writes, edits, independent dispatch, wake retries, and resumed threads.\n- Cover migration backfills and revision tracking for queue updates and deletes.\n\nGitOrigin-RevId: 906d902bbf6a760be206a1b2c08fd71427b63c46","tree":{"sha":"719a2e5d4c36d4cde2b52d58d2e6bf287e4c2306","url":"https://api.github.com/repos/openai/codex/git/trees/719a2e5d4c36d4cde2b52d58d2e6bf287e4c2306"},"url":"https://api.github.com/repos/openai/codex/git/commits/eeb82a156d1b3944dca4234c3043296529ec5837","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/eeb82a156d1b3944dca4234c3043296529ec5837","html_url":"https://github.com/openai/codex/commit/eeb82a156d1b3944dca4234c3043296529ec5837","comments_url":"https://api.github.com/repos/openai/codex/commits/eeb82a156d1b3944dca4234c3043296529ec5837/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a8525b139c3578acf5e8cf2db9319ff8cbc6e8c5","url":"https://api.github.com/repos/openai/codex/commits/a8525b139c3578acf5e8cf2db9319ff8cbc6e8c5","html_url":"https://github.com/openai/codex/commit/a8525b139c3578acf5e8cf2db9319ff8cbc6e8c5"}]},{"sha":"a8525b139c3578acf5e8cf2db9319ff8cbc6e8c5","node_id":"C_kwDOOYsS4doAKGE4NTI1YjEzOWMzNTc4YWNmNWU4Y2YyZGI5MzE5ZmY4Y2JjNmU4YzU","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-17T16:37:41Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T17:14:46Z"},"message":"Bound legacy resume preview scans (#39033)\n\n## Why\n\nBuilding a resume-picker preview for a legacy session should not require loading its full thread history.\n\n## What changed\n\n- Read up to six preview lines by scanning at most 1 MiB from the end of a local legacy rollout.\n- Fall back to the existing history hydration path when the local file is unavailable, the bounded scan is incomplete, or the tail contains a rollback.\n- Keep the initial `thread/read` request turn-free while loading the preview.\n\n## Testing\n\nAdded coverage for compaction, rollbacks, oversized records, exhausted scan budgets, and app-server request parameters.\n\nGitOrigin-RevId: a8950f03d8b56323f268fd3355c6a38a16cb9833","tree":{"sha":"83321f01b197b87bec710ed93ac51f41119e2f23","url":"https://api.github.com/repos/openai/codex/git/trees/83321f01b197b87bec710ed93ac51f41119e2f23"},"url":"https://api.github.com/repos/openai/codex/git/commits/a8525b139c3578acf5e8cf2db9319ff8cbc6e8c5","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a8525b139c3578acf5e8cf2db9319ff8cbc6e8c5","html_url":"https://github.com/openai/codex/commit/a8525b139c3578acf5e8cf2db9319ff8cbc6e8c5","comments_url":"https://api.github.com/repos/openai/codex/commits/a8525b139c3578acf5e8cf2db9319ff8cbc6e8c5/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"dc473903ab703987a0eaab02071c7535631c5459","url":"https://api.github.com/repos/openai/codex/commits/dc473903ab703987a0eaab02071c7535631c5459","html_url":"https://github.com/openai/codex/commit/dc473903ab703987a0eaab02071c7535631c5459"}]},{"sha":"dc473903ab703987a0eaab02071c7535631c5459","node_id":"C_kwDOOYsS4doAKGRjNDczOTAzYWI3MDM5ODdhMGVhYWIwMjA3MWM3NTM1NjMxYzU0NTk","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-17T16:36:37Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T17:10:16Z"},"message":"Encapsulate TUI shimmer under the motion module (#39032)\n\n## Why\n\nDirect access to shimmer primitives can bypass the reduced-motion handling\nintroduced in https://github.com/openai/codex/pull/20564.\n\n## What changed\n\n- Make `shimmer` a private child of `motion` and restrict `shimmer_spans` to\n  its parent module, so Rust visibility enforces the animation boundary.\n- Remove the source-scanning regression test that previously checked this\n  boundary with regular expressions.\n\nGitOrigin-RevId: 1f4cccacaa907992c636cd1e9cd2829b7653f811","tree":{"sha":"3ff7ddf9682cf8380be21a21da6fa6c366660a45","url":"https://api.github.com/repos/openai/codex/git/trees/3ff7ddf9682cf8380be21a21da6fa6c366660a45"},"url":"https://api.github.com/repos/openai/codex/git/commits/dc473903ab703987a0eaab02071c7535631c5459","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/dc473903ab703987a0eaab02071c7535631c5459","html_url":"https://github.com/openai/codex/commit/dc473903ab703987a0eaab02071c7535631c5459","comments_url":"https://api.github.com/repos/openai/codex/commits/dc473903ab703987a0eaab02071c7535631c5459/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"8892aa8fa0248a157c8f6ad408e70011da12d665","url":"https://api.github.com/repos/openai/codex/commits/8892aa8fa0248a157c8f6ad408e70011da12d665","html_url":"https://github.com/openai/codex/commit/8892aa8fa0248a157c8f6ad408e70011da12d665"}]},{"sha":"8892aa8fa0248a157c8f6ad408e70011da12d665","node_id":"C_kwDOOYsS4doAKDg4OTJhYThmYTAyNDhhMTU3YzhmNmFkNDA4ZTcwMDExZGExMmQ2NjU","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-17T16:27:48Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T17:04:09Z"},"message":"Speed up the in-app resume cwd test (#39030)\n\n## What changed\n\n- Reuse shared directory fixtures and local and remote app-server instances across the resume cwd case matrix.\n- Seed the runtime working-directory override directly so each case focuses on resume behavior without starting and replacing an extra thread.\n- Run the test on a four-thread Tokio runtime and shut down each shared server after all cases complete.\n\nGitOrigin-RevId: 4bc4978abc546882f26bcb5e3591ff9673758b4a","tree":{"sha":"203db1b78f509f544a5a8aeda1b9be33685013da","url":"https://api.github.com/repos/openai/codex/git/trees/203db1b78f509f544a5a8aeda1b9be33685013da"},"url":"https://api.github.com/repos/openai/codex/git/commits/8892aa8fa0248a157c8f6ad408e70011da12d665","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/8892aa8fa0248a157c8f6ad408e70011da12d665","html_url":"https://github.com/openai/codex/commit/8892aa8fa0248a157c8f6ad408e70011da12d665","comments_url":"https://api.github.com/repos/openai/codex/commits/8892aa8fa0248a157c8f6ad408e70011da12d665/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"10fbb618384ec4c214fced0feed3adf1d72c4cb6","url":"https://api.github.com/repos/openai/codex/commits/10fbb618384ec4c214fced0feed3adf1d72c4cb6","html_url":"https://github.com/openai/codex/commit/10fbb618384ec4c214fced0feed3adf1d72c4cb6"}]},{"sha":"10fbb618384ec4c214fced0feed3adf1d72c4cb6","node_id":"C_kwDOOYsS4doAKDEwZmJiNjE4Mzg0ZWM0YzIxNGZjZWQwZmVlZDNhZGYxZDcyYzRjYjY","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-17T16:27:40Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T16:58:24Z"},"message":"Cache the test pet spritesheet encoding (#39028)\n\n## Why\n\nPet tests reuse the same blank WebP spritesheet fixture, so encoding a new image\nfor every temporary path does unnecessary repeated work.\n\n## What changed\n\nEncode the test spritesheet once with `LazyLock`, then write the cached WebP bytes\nto each requested fixture path.\n\nGitOrigin-RevId: 26d75bb1bac448717ca63aeb82eb4e500c86fad8","tree":{"sha":"4a81aa377c36476542e6303ebdceedfb971b7bbb","url":"https://api.github.com/repos/openai/codex/git/trees/4a81aa377c36476542e6303ebdceedfb971b7bbb"},"url":"https://api.github.com/repos/openai/codex/git/commits/10fbb618384ec4c214fced0feed3adf1d72c4cb6","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/10fbb618384ec4c214fced0feed3adf1d72c4cb6","html_url":"https://github.com/openai/codex/commit/10fbb618384ec4c214fced0feed3adf1d72c4cb6","comments_url":"https://api.github.com/repos/openai/codex/commits/10fbb618384ec4c214fced0feed3adf1d72c4cb6/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"171ae66d7411759d384de8147f5ce9c3a6ae988f","url":"https://api.github.com/repos/openai/codex/commits/171ae66d7411759d384de8147f5ce9c3a6ae988f","html_url":"https://github.com/openai/codex/commit/171ae66d7411759d384de8147f5ce9c3a6ae988f"}]},{"sha":"171ae66d7411759d384de8147f5ce9c3a6ae988f","node_id":"C_kwDOOYsS4doAKDE3MWFlNjZkNzQxMTc1OWQzODRkZTgxNDdmNWNlOWMzYTZhZTk4OGY","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-17T16:27:29Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T16:54:49Z"},"message":"Use simulated time in the long typing test (#39026)\n\n## Why\n\nThe 1,000-character human-like typing test waited on the wall clock after\nevery keypress, making the test unnecessarily slow.\n\n## What changed\n\nAdvance an injected timestamp by the recommended paste flush delay and flush\nthe paste-burst detector explicitly after each character. This preserves the\ncoverage that slow typing appears directly without creating a paste\nplaceholder, without sleeping between keypresses.\n\nGitOrigin-RevId: 0c1beb40283f7d73a381cd221725ab4227c8e233","tree":{"sha":"a728ab81988075a0960afb1a5a5cfc9def4ee966","url":"https://api.github.com/repos/openai/codex/git/trees/a728ab81988075a0960afb1a5a5cfc9def4ee966"},"url":"https://api.github.com/repos/openai/codex/git/commits/171ae66d7411759d384de8147f5ce9c3a6ae988f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/171ae66d7411759d384de8147f5ce9c3a6ae988f","html_url":"https://github.com/openai/codex/commit/171ae66d7411759d384de8147f5ce9c3a6ae988f","comments_url":"https://api.github.com/repos/openai/codex/commits/171ae66d7411759d384de8147f5ce9c3a6ae988f/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c6ba7b7f8e884fb89c6811a3c6ab4748430d4ba5","url":"https://api.github.com/repos/openai/codex/commits/c6ba7b7f8e884fb89c6811a3c6ab4748430d4ba5","html_url":"https://github.com/openai/codex/commit/c6ba7b7f8e884fb89c6811a3c6ab4748430d4ba5"}]},{"sha":"c6ba7b7f8e884fb89c6811a3c6ab4748430d4ba5","node_id":"C_kwDOOYsS4doAKGM2YmE3YjdmOGU4ODRmYjg5YzY4MTFhM2M2YWI0NzQ4NDMwZDRiYTU","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-17T16:27:20Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T16:50:47Z"},"message":"Speed up the large diff highlighting test (#39025)\n\n## What changed\n\nConstruct the oversized unified diff fixture directly instead of generating it\nfrom two large input strings. Keep the fixture just above\n`MAX_HIGHLIGHT_LINES` so the test continues to verify that syntax highlighting\nis skipped for large updates.\n\nGitOrigin-RevId: 8f8853e03a50ff9f53e77b2ba0956cf85ee17c07","tree":{"sha":"1c49384e765ed901e78e2cd4d96757d103203f50","url":"https://api.github.com/repos/openai/codex/git/trees/1c49384e765ed901e78e2cd4d96757d103203f50"},"url":"https://api.github.com/repos/openai/codex/git/commits/c6ba7b7f8e884fb89c6811a3c6ab4748430d4ba5","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c6ba7b7f8e884fb89c6811a3c6ab4748430d4ba5","html_url":"https://github.com/openai/codex/commit/c6ba7b7f8e884fb89c6811a3c6ab4748430d4ba5","comments_url":"https://api.github.com/repos/openai/codex/commits/c6ba7b7f8e884fb89c6811a3c6ab4748430d4ba5/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"f0904922f6f679699fa11d144ab29f08dd5cc770","url":"https://api.github.com/repos/openai/codex/commits/f0904922f6f679699fa11d144ab29f08dd5cc770","html_url":"https://github.com/openai/codex/commit/f0904922f6f679699fa11d144ab29f08dd5cc770"}]},{"sha":"f0904922f6f679699fa11d144ab29f08dd5cc770","node_id":"C_kwDOOYsS4doAKGYwOTA0OTIyZjZmNjc5Njk5ZmExMWQxNDRhYjI5ZjA4ZGQ1Y2M3NzA","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-17T16:27:03Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T16:46:26Z"},"message":"Reduce retained MCP result data in TUI history (#39023)\n\n## Why\n\nMCP tool results can contain multi-megabyte image, audio, or resource bodies,\neven though TUI history renders only summaries for those content types.\n\n## What changed\n\n- Project completed MCP results into width-independent display data, dropping\n  media and resource bodies that history does not render.\n- Preserve text output, JSON fallbacks, error state, Node REPL rendering, and\n  the fully decoded image-output marker.\n- Add tests covering width-dependent rendering, image validation, and Node REPL\n  text fields on non-text and unknown content blocks.\n\nGitOrigin-RevId: 2cfddf0864093e6837a4431e541f7a9cab544a68","tree":{"sha":"d10fe366f6915aab887c71ae8b47e3fea5f90af9","url":"https://api.github.com/repos/openai/codex/git/trees/d10fe366f6915aab887c71ae8b47e3fea5f90af9"},"url":"https://api.github.com/repos/openai/codex/git/commits/f0904922f6f679699fa11d144ab29f08dd5cc770","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/f0904922f6f679699fa11d144ab29f08dd5cc770","html_url":"https://github.com/openai/codex/commit/f0904922f6f679699fa11d144ab29f08dd5cc770","comments_url":"https://api.github.com/repos/openai/codex/commits/f0904922f6f679699fa11d144ab29f08dd5cc770/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"0841d9bba5e53104caa86eda39c9974afe63a639","url":"https://api.github.com/repos/openai/codex/commits/0841d9bba5e53104caa86eda39c9974afe63a639","html_url":"https://github.com/openai/codex/commit/0841d9bba5e53104caa86eda39c9974afe63a639"}]},{"sha":"0841d9bba5e53104caa86eda39c9974afe63a639","node_id":"C_kwDOOYsS4doAKDA4NDFkOWJiYTVlNTMxMDRjYWE4NmVkYTM5Yzk5NzRhZmU2M2E2Mzk","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-17T16:26:56Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T16:39:37Z"},"message":"Hang soft-break whitespace in the TUI composer (#39022)\n\n## Why\n\nKeeping overflowing separators with the following word can add whitespace-only\nrows and make composer wrapping differ from the queued-input preview.\n\n## What changed\n\n- Hang breakable whitespace from the preceding visual row at soft word breaks\n  while preserving the underlying editable text.\n- Keep indentation, trailing whitespace, mandatory breaks, and nonbreaking spaces\n  visible and editable according to their existing semantics.\n- Align cursor placement, scrolling, vertical navigation, masked rendering, and\n  styled overlays with the visible wrapped content, including after resizes.\n\n## Testing\n\nAdd focused wrapping, rendering, cursor, editing, scrolling, navigation, Unicode\nseparator, long whitespace-run, and resize coverage.\n\nGitOrigin-RevId: 7fbdb0a4bf33cfee20c4c19dca5aee74df4f892c","tree":{"sha":"8b9d88ffe3de74b7060e2c9c5768d09544ca7d36","url":"https://api.github.com/repos/openai/codex/git/trees/8b9d88ffe3de74b7060e2c9c5768d09544ca7d36"},"url":"https://api.github.com/repos/openai/codex/git/commits/0841d9bba5e53104caa86eda39c9974afe63a639","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/0841d9bba5e53104caa86eda39c9974afe63a639","html_url":"https://github.com/openai/codex/commit/0841d9bba5e53104caa86eda39c9974afe63a639","comments_url":"https://api.github.com/repos/openai/codex/commits/0841d9bba5e53104caa86eda39c9974afe63a639/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"09bc28f348774aa180ac58f667ac244aa0c94774","url":"https://api.github.com/repos/openai/codex/commits/09bc28f348774aa180ac58f667ac244aa0c94774","html_url":"https://github.com/openai/codex/commit/09bc28f348774aa180ac58f667ac244aa0c94774"}]},{"sha":"09bc28f348774aa180ac58f667ac244aa0c94774","node_id":"C_kwDOOYsS4doAKDA5YmMyOGYzNDg3NzRhYTE4MGFjNThmNjY3YWMyNDRhYTBjOTQ3NzQ","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-17T16:24:44Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T16:34:21Z"},"message":"Restrict Windows IDE pipe client impersonation (#39020)\n\n## Why\n\nWindows named pipe servers can impersonate connected clients. IDE context\nconnections only require the server to identify the client, so they should not\ngrant broader impersonation rights.\n\n## What changed\n\nOpen Windows IDE context pipes with `SECURITY_SQOS_PRESENT` and\n`SECURITY_IDENTIFICATION`, limiting the server's impersonation token to the\nidentification level.\n\n## Testing\n\nAdd a Windows regression test that connects to a named pipe, asks the server to\nimpersonate the client, and verifies that the resulting token has the\n`SecurityIdentification` level.\n\nGitOrigin-RevId: 51ef080f3367857987e03b0113a476040ea40e56","tree":{"sha":"ab8ef35fe3858386e7eac320d7641665e2c607c3","url":"https://api.github.com/repos/openai/codex/git/trees/ab8ef35fe3858386e7eac320d7641665e2c607c3"},"url":"https://api.github.com/repos/openai/codex/git/commits/09bc28f348774aa180ac58f667ac244aa0c94774","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/09bc28f348774aa180ac58f667ac244aa0c94774","html_url":"https://github.com/openai/codex/commit/09bc28f348774aa180ac58f667ac244aa0c94774","comments_url":"https://api.github.com/repos/openai/codex/commits/09bc28f348774aa180ac58f667ac244aa0c94774/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"02360b48d1cfe1ffe1a74f18da4df7ee96d95e49","url":"https://api.github.com/repos/openai/codex/commits/02360b48d1cfe1ffe1a74f18da4df7ee96d95e49","html_url":"https://github.com/openai/codex/commit/02360b48d1cfe1ffe1a74f18da4df7ee96d95e49"}]},{"sha":"02360b48d1cfe1ffe1a74f18da4df7ee96d95e49","node_id":"C_kwDOOYsS4doAKDAyMzYwYjQ4ZDFjZmUxZmZlMWE3NGYxOGRhNGRmN2VlOTZkOTVlNDk","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-17T16:23:52Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T16:29:47Z"},"message":"Isolate MCP resource headers during OAuth requests (#39019)\n\n## Why\n\nHeaders configured for an MCP resource can contain credentials and must not be\nforwarded to a different origin during OAuth discovery, registration, or token\nexchange.\n\n## What changed\n\n- Apply configured resource headers only to OAuth requests on the MCP resource\n  origin, while allowing OAuth-generated headers to take precedence.\n- Follow credentialed OAuth redirects only when each destination remains on the\n  resource origin. Preserve redirect method semantics, the overall timeout, the\n  response size limit, and a maximum of 10 redirects.\n- Use the Codex MCP user agent for requests to authorization-server origins.\n\n## Testing\n\nAdd coverage for cross-origin header isolation, same-origin dynamic client\nregistration redirects, OAuth header precedence, token refresh, timeout\naccounting, and response size limits.\n\nGitOrigin-RevId: 609d06e2b065e4aa9ca5382b4ae60455f9e26db9","tree":{"sha":"20564e7d93f3dd4ae5b6f5f4efc604d47c6892ef","url":"https://api.github.com/repos/openai/codex/git/trees/20564e7d93f3dd4ae5b6f5f4efc604d47c6892ef"},"url":"https://api.github.com/repos/openai/codex/git/commits/02360b48d1cfe1ffe1a74f18da4df7ee96d95e49","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/02360b48d1cfe1ffe1a74f18da4df7ee96d95e49","html_url":"https://github.com/openai/codex/commit/02360b48d1cfe1ffe1a74f18da4df7ee96d95e49","comments_url":"https://api.github.com/repos/openai/codex/commits/02360b48d1cfe1ffe1a74f18da4df7ee96d95e49/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"32a383c0ba5ed42a1adc3f2084014895bfe7738c","url":"https://api.github.com/repos/openai/codex/commits/32a383c0ba5ed42a1adc3f2084014895bfe7738c","html_url":"https://github.com/openai/codex/commit/32a383c0ba5ed42a1adc3f2084014895bfe7738c"}]},{"sha":"32a383c0ba5ed42a1adc3f2084014895bfe7738c","node_id":"C_kwDOOYsS4doAKDMyYTM4M2MwYmE1ZWQ0MmExYWRjM2YyMDg0MDE0ODk1YmZlNzczOGM","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-08-17T16:07:26Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T16:20:52Z"},"message":"Move MCP policy types into `codex-protocol` (#39017)\n\n## What changed\n\n- Define MCP server identities, matchers, requirements, and per-plugin MCP requirements in the new `codex_protocol::mcp_policy` module.\n- Keep requirement validation and matching against `McpServerConfig` in `codex-config`.\n- Re-export the moved types from `codex-config` to preserve existing consumers.\n\nGitOrigin-RevId: ad8a107e3085191241a5766f061dd004103e21e6","tree":{"sha":"50f24fe8a31c6bd2ad963d43ad686a085af43cac","url":"https://api.github.com/repos/openai/codex/git/trees/50f24fe8a31c6bd2ad963d43ad686a085af43cac"},"url":"https://api.github.com/repos/openai/codex/git/commits/32a383c0ba5ed42a1adc3f2084014895bfe7738c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/32a383c0ba5ed42a1adc3f2084014895bfe7738c","html_url":"https://github.com/openai/codex/commit/32a383c0ba5ed42a1adc3f2084014895bfe7738c","comments_url":"https://api.github.com/repos/openai/codex/commits/32a383c0ba5ed42a1adc3f2084014895bfe7738c/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"21cfd369efca2df70c904c580b2e7e2e3eddb3c3","url":"https://api.github.com/repos/openai/codex/commits/21cfd369efca2df70c904c580b2e7e2e3eddb3c3","html_url":"https://github.com/openai/codex/commit/21cfd369efca2df70c904c580b2e7e2e3eddb3c3"}]},{"sha":"21cfd369efca2df70c904c580b2e7e2e3eddb3c3","node_id":"C_kwDOOYsS4doAKDIxY2ZkMzY5ZWZjYTJkZjcwYzkwNGM1ODBiMmU3ZTJlM2VkZGIzYzM","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-17T13:23:26Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T13:29:57Z"},"message":"Add task context to shadow skill selection (#39008)\n\n## Why\n\nShort continuation prompts such as `continue` do not contain enough context for\nskill selection on their own.\n\n## What changed\n\n- Add the `task_context_fusion_v1` shadow selector, combining the current request\n  with up to two prior substantive requests and recently relevant skills.\n- Record explicit skill intent and successful skill invocations for future turns,\n  while excluding same-turn observations from predictions.\n- Bound retained requests, augmented queries, and skill history, including safe\n  truncation at UTF-8 character boundaries.\n\n## Testing\n\nAdd unit and extension tests for continuation prompts, explicit intent, turn\nisolation, cold thread state, bounded history, and unchanged control selectors.\n\nGitOrigin-RevId: 72eca3f0d64620a0d24e95d5675f126ac982f8c7","tree":{"sha":"94e649a6bd7204625520f6d11289db1be752a325","url":"https://api.github.com/repos/openai/codex/git/trees/94e649a6bd7204625520f6d11289db1be752a325"},"url":"https://api.github.com/repos/openai/codex/git/commits/21cfd369efca2df70c904c580b2e7e2e3eddb3c3","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/21cfd369efca2df70c904c580b2e7e2e3eddb3c3","html_url":"https://github.com/openai/codex/commit/21cfd369efca2df70c904c580b2e7e2e3eddb3c3","comments_url":"https://api.github.com/repos/openai/codex/commits/21cfd369efca2df70c904c580b2e7e2e3eddb3c3/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"def7ed55725052ac4119c759ff8b5952a5f955ee","url":"https://api.github.com/repos/openai/codex/commits/def7ed55725052ac4119c759ff8b5952a5f955ee","html_url":"https://github.com/openai/codex/commit/def7ed55725052ac4119c759ff8b5952a5f955ee"}]},{"sha":"def7ed55725052ac4119c759ff8b5952a5f955ee","node_id":"C_kwDOOYsS4doAKGRlZjdlZDU1NzI1MDUyYWM0MTE5Yzc1OWZmOGI1OTUyYTVmOTU1ZWU","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-17T13:18:00Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T13:26:19Z"},"message":"Wait for Guardian score progress in approval tests (#39007)\n\n## Why\n\nGuardian stores a `SecurityRiskScore` before advancing its scored-tool-call\ncounter. Waiting only for the score can therefore let the test continue while\nthe asynchronous sampler is still updating its progress state.\n\n## What changed\n\nWait for `latest_scored_tool_call` to advance before exercising Guardian v2\napproval decisions, and reuse the same progress tracker for the subsequent\nassertions.\n\nGitOrigin-RevId: 3d92c9a3ccf52f4f43a2454aac60d2479258c1c8","tree":{"sha":"b845dc821a36c6920878dcab6cf91a9c057b86cb","url":"https://api.github.com/repos/openai/codex/git/trees/b845dc821a36c6920878dcab6cf91a9c057b86cb"},"url":"https://api.github.com/repos/openai/codex/git/commits/def7ed55725052ac4119c759ff8b5952a5f955ee","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/def7ed55725052ac4119c759ff8b5952a5f955ee","html_url":"https://github.com/openai/codex/commit/def7ed55725052ac4119c759ff8b5952a5f955ee","comments_url":"https://api.github.com/repos/openai/codex/commits/def7ed55725052ac4119c759ff8b5952a5f955ee/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"04caa22c8220c24b1428dbeaebcb744bf3875771","url":"https://api.github.com/repos/openai/codex/commits/04caa22c8220c24b1428dbeaebcb744bf3875771","html_url":"https://github.com/openai/codex/commit/04caa22c8220c24b1428dbeaebcb744bf3875771"}]},{"sha":"04caa22c8220c24b1428dbeaebcb744bf3875771","node_id":"C_kwDOOYsS4doAKDA0Y2FhMjJjODIyMGMyNGIxNDI4ZGJlYWViY2I3NDRiZjM4NzU3NzE","commit":{"author":{"name":"xli-oai","email":"xli@openai.com","date":"2026-08-17T13:15:31Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T13:20:58Z"},"message":"Emit API-key turn cost telemetry from app-server (#39006)\n\n## What changed\n\n- Track app-server turn lifecycle events for OpenAI API-key sessions when OTLP telemetry export is enabled.\n- Query the turn-cost endpoint after completed or aborted turns and emit `codex.turn_cost` with the estimated USD cost, interruption state, model, speed, and reasoning effort.\n- Preserve provider organization and project headers, wait for all observed responses to be priced, and retry pending or transiently failed queries with bounded tracking.\n- Re-probe availability after authentication changes and shut the worker down with other app-server background tasks.\n\n## Testing\n\n- Cover late API-key login, transient probe failures, telemetry after thread removal, and turns with multiple responses.\n- Verify turn-cost requests use API-key authentication and provider scope headers and deserialize priced response data.\n\nGitOrigin-RevId: a303162a54798b554fcb2e9e2b372e1cf9f49f39","tree":{"sha":"424d155aa2ef002aec432a2503c5bc54d85fff5f","url":"https://api.github.com/repos/openai/codex/git/trees/424d155aa2ef002aec432a2503c5bc54d85fff5f"},"url":"https://api.github.com/repos/openai/codex/git/commits/04caa22c8220c24b1428dbeaebcb744bf3875771","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/04caa22c8220c24b1428dbeaebcb744bf3875771","html_url":"https://github.com/openai/codex/commit/04caa22c8220c24b1428dbeaebcb744bf3875771","comments_url":"https://api.github.com/repos/openai/codex/commits/04caa22c8220c24b1428dbeaebcb744bf3875771/comments","author":{"login":"xli-oai","id":270779301,"node_id":"U_kgDOECPDpQ","avatar_url":"https://avatars.githubusercontent.com/u/270779301?v=4","gravatar_id":"","url":"https://api.github.com/users/xli-oai","html_url":"https://github.com/xli-oai","followers_url":"https://api.github.com/users/xli-oai/followers","following_url":"https://api.github.com/users/xli-oai/following{/other_user}","gists_url":"https://api.github.com/users/xli-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/xli-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/xli-oai/subscriptions","organizations_url":"https://api.github.com/users/xli-oai/orgs","repos_url":"https://api.github.com/users/xli-oai/repos","events_url":"https://api.github.com/users/xli-oai/events{/privacy}","received_events_url":"https://api.github.com/users/xli-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"02e9bfaac7577a3ab77a40de6b0c3cc37b934576","url":"https://api.github.com/repos/openai/codex/commits/02e9bfaac7577a3ab77a40de6b0c3cc37b934576","html_url":"https://github.com/openai/codex/commit/02e9bfaac7577a3ab77a40de6b0c3cc37b934576"}]},{"sha":"02e9bfaac7577a3ab77a40de6b0c3cc37b934576","node_id":"C_kwDOOYsS4doAKDAyZTliZmFhYzc1NzdhM2FiNzdhNDBkZTZiMGMzY2MzN2I5MzQ1NzY","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-17T13:10:50Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T13:16:05Z"},"message":"Disable Guardian V2 for managed automatic reviewers (#39005)\n\n## Why\n\nGuardian V2 should not override a managed approval-reviewer policy that excludes\nthe user reviewer.\n\n## What changed\n\n- Force `features.guardianv2` off when `allowed_approvals_reviewers` does not\n  include `user`, for both local requirements and cloud config bundles.\n- Preserve Guardian V2 when the user reviewer remains allowed or when only\n  legacy Guardian feature settings are present.\n- Return the effective disabled value through `config/read`.\n\n## Testing\n\nAdded coverage for cloud requirements and the app-server config RPC.\n\nGitOrigin-RevId: 82b6d0aaf47fbaa58ae349d4e56777cd442f5807","tree":{"sha":"1e19415f434c0108d72ceb13ea5563b8f26fc8ce","url":"https://api.github.com/repos/openai/codex/git/trees/1e19415f434c0108d72ceb13ea5563b8f26fc8ce"},"url":"https://api.github.com/repos/openai/codex/git/commits/02e9bfaac7577a3ab77a40de6b0c3cc37b934576","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/02e9bfaac7577a3ab77a40de6b0c3cc37b934576","html_url":"https://github.com/openai/codex/commit/02e9bfaac7577a3ab77a40de6b0c3cc37b934576","comments_url":"https://api.github.com/repos/openai/codex/commits/02e9bfaac7577a3ab77a40de6b0c3cc37b934576/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"8e89e98cf6d4d79f7add5c04ddd4bbd76b1594a1","url":"https://api.github.com/repos/openai/codex/commits/8e89e98cf6d4d79f7add5c04ddd4bbd76b1594a1","html_url":"https://github.com/openai/codex/commit/8e89e98cf6d4d79f7add5c04ddd4bbd76b1594a1"}]},{"sha":"8e89e98cf6d4d79f7add5c04ddd4bbd76b1594a1","node_id":"C_kwDOOYsS4doAKDhlODllOThjZjZkNGQ3OWY3YWRkNWMwNGRkZDRiYmQ3NmIxNTk0YTE","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-17T13:01:16Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T13:06:15Z"},"message":"Ignore stale Guardian tool risk scores (#39001)\n\n## What changed\n\n- Track the latest tool call and latest scored tool call for each Guardian v2 thread.\n- Skip approval review when the score lags by more than `max_tool_call_lag` tool calls.\n- Add `max_tool_call_lag` to the Guardian v2 configuration and schema, with a default of three.\n\n## Testing\n\n- Cover approval review at, above, and after recovering from the configured lag limit.\n- Cover deserialization of `max_tool_call_lag`.\n\nGitOrigin-RevId: fd870e143d95ee76491180e2aed742717248ff78","tree":{"sha":"a649147890215cb08c0d71c852f80a3781a74a40","url":"https://api.github.com/repos/openai/codex/git/trees/a649147890215cb08c0d71c852f80a3781a74a40"},"url":"https://api.github.com/repos/openai/codex/git/commits/8e89e98cf6d4d79f7add5c04ddd4bbd76b1594a1","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/8e89e98cf6d4d79f7add5c04ddd4bbd76b1594a1","html_url":"https://github.com/openai/codex/commit/8e89e98cf6d4d79f7add5c04ddd4bbd76b1594a1","comments_url":"https://api.github.com/repos/openai/codex/commits/8e89e98cf6d4d79f7add5c04ddd4bbd76b1594a1/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4885eb6c52c4d9915698671395aaa327072afca9","url":"https://api.github.com/repos/openai/codex/commits/4885eb6c52c4d9915698671395aaa327072afca9","html_url":"https://github.com/openai/codex/commit/4885eb6c52c4d9915698671395aaa327072afca9"}]},{"sha":"4885eb6c52c4d9915698671395aaa327072afca9","node_id":"C_kwDOOYsS4doAKDQ4ODVlYjZjNTJjNGQ5OTE1Njk4NjcxMzk1YWFhMzI3MDcyYWZjYTk","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-17T12:33:24Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T12:45:50Z"},"message":"Retry transient Guardian sampling failures (#38997)\n\n## Why\n\nGuardian sampling can encounter temporary connection or service failures while\nopening a WebSocket, starting a request, or consuming its response stream.\n\n## What changed\n\n- Retry transient transport, streaming, rate-limit, and server failures up to\n  two times across the full sampling flow.\n- Recover from unauthorized responses through the configured auth manager and\n  discard pooled connections that may contain stale credentials.\n- Allow sampler initialization to continue when its initial WebSocket prewarm\n  fails, so the first sample can establish a fresh connection.\n\n## Testing\n\nAdded coverage for recovery after prewarm failures and `503` responses, and for\nstopping once the transient retry budget is exhausted.\n\nGitOrigin-RevId: af74c2df95c4241184ca641ef4418db6aa4ab695","tree":{"sha":"ba6c315fa04ba99b6d8c0ac8382ee66d2d6dacfc","url":"https://api.github.com/repos/openai/codex/git/trees/ba6c315fa04ba99b6d8c0ac8382ee66d2d6dacfc"},"url":"https://api.github.com/repos/openai/codex/git/commits/4885eb6c52c4d9915698671395aaa327072afca9","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4885eb6c52c4d9915698671395aaa327072afca9","html_url":"https://github.com/openai/codex/commit/4885eb6c52c4d9915698671395aaa327072afca9","comments_url":"https://api.github.com/repos/openai/codex/commits/4885eb6c52c4d9915698671395aaa327072afca9/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"3666a46ea3265442c3e374f7c5f18df650b17005","url":"https://api.github.com/repos/openai/codex/commits/3666a46ea3265442c3e374f7c5f18df650b17005","html_url":"https://github.com/openai/codex/commit/3666a46ea3265442c3e374f7c5f18df650b17005"}]},{"sha":"3666a46ea3265442c3e374f7c5f18df650b17005","node_id":"C_kwDOOYsS4doAKDM2NjZhNDZlYTMyNjU0NDJjM2UzNzRmN2M1ZjE4ZGY2NTBiMTcwMDU","commit":{"author":{"name":"Alex Zamoshchin","email":"alexz@openai.com","date":"2026-08-17T12:21:37Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T12:26:59Z"},"message":"Remove the workspace settings gate for apps and plugins (#38994)\n\n## What changed\n\n- Stop fetching the ChatGPT workspace `enable_plugins` setting.\n- Let the effective Codex feature configuration control app and plugin APIs,\n  plugin-provided skills and hooks, and experimental feature reporting.\n\nGitOrigin-RevId: 46aebf0f07cd47e093e48663e41207cdf9a38c9f","tree":{"sha":"4b3d23be6921498e3ea4e4d665b026170de89b92","url":"https://api.github.com/repos/openai/codex/git/trees/4b3d23be6921498e3ea4e4d665b026170de89b92"},"url":"https://api.github.com/repos/openai/codex/git/commits/3666a46ea3265442c3e374f7c5f18df650b17005","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/3666a46ea3265442c3e374f7c5f18df650b17005","html_url":"https://github.com/openai/codex/commit/3666a46ea3265442c3e374f7c5f18df650b17005","comments_url":"https://api.github.com/repos/openai/codex/commits/3666a46ea3265442c3e374f7c5f18df650b17005/comments","author":{"login":"zamoshchin-openai","id":185120305,"node_id":"U_kgDOCwi2MQ","avatar_url":"https://avatars.githubusercontent.com/u/185120305?v=4","gravatar_id":"","url":"https://api.github.com/users/zamoshchin-openai","html_url":"https://github.com/zamoshchin-openai","followers_url":"https://api.github.com/users/zamoshchin-openai/followers","following_url":"https://api.github.com/users/zamoshchin-openai/following{/other_user}","gists_url":"https://api.github.com/users/zamoshchin-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/zamoshchin-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zamoshchin-openai/subscriptions","organizations_url":"https://api.github.com/users/zamoshchin-openai/orgs","repos_url":"https://api.github.com/users/zamoshchin-openai/repos","events_url":"https://api.github.com/users/zamoshchin-openai/events{/privacy}","received_events_url":"https://api.github.com/users/zamoshchin-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"ea10ae7d0fe6a2fb0614a32adb5e095853319355","url":"https://api.github.com/repos/openai/codex/commits/ea10ae7d0fe6a2fb0614a32adb5e095853319355","html_url":"https://github.com/openai/codex/commit/ea10ae7d0fe6a2fb0614a32adb5e095853319355"}]},{"sha":"ea10ae7d0fe6a2fb0614a32adb5e095853319355","node_id":"C_kwDOOYsS4doAKGVhMTBhZTdkMGZlNmEyZmIwNjE0YTMyYWRiNWUwOTU4NTMzMTkzNTU","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-17T12:08:22Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T12:13:20Z"},"message":"Evaluate recent and character-routed skill selection (#38993)\n\n## What changed\n\n- Add shadow selectors that fuse recently invoked skills with character routing-card matches using reciprocal rank fusion.\n- Add a second variant that also incorporates weighted lexical matches.\n- Record both variants in the existing shadow-selection experiment, capped at 50 candidates.\n\n## Testing\n\n- Cover cold starts, duplicate removal, short exact matches, deterministic ranking, result limits, and truncation metadata.\n- Extend the skills integration test to verify both selectors recover a skill invoked on an earlier turn.\n\nGitOrigin-RevId: 4ff9e91da8cb49ecbce54ab8e760820616e1a1d3","tree":{"sha":"d7f60f837257027adab1dbad001e44cf7860607a","url":"https://api.github.com/repos/openai/codex/git/trees/d7f60f837257027adab1dbad001e44cf7860607a"},"url":"https://api.github.com/repos/openai/codex/git/commits/ea10ae7d0fe6a2fb0614a32adb5e095853319355","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/ea10ae7d0fe6a2fb0614a32adb5e095853319355","html_url":"https://github.com/openai/codex/commit/ea10ae7d0fe6a2fb0614a32adb5e095853319355","comments_url":"https://api.github.com/repos/openai/codex/commits/ea10ae7d0fe6a2fb0614a32adb5e095853319355/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"8bf50439f2ebbcd98785c858e22174f919451cf7","url":"https://api.github.com/repos/openai/codex/commits/8bf50439f2ebbcd98785c858e22174f919451cf7","html_url":"https://github.com/openai/codex/commit/8bf50439f2ebbcd98785c858e22174f919451cf7"}]},{"sha":"8bf50439f2ebbcd98785c858e22174f919451cf7","node_id":"C_kwDOOYsS4doAKDhiZjUwNDM5ZjJlYmJjZDk4Nzg1Yzg1OGUyMjE3NGY5MTk0NTFjZjc","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-17T11:18:50Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T11:44:56Z"},"message":"Source Guardian v2 defaults from the model catalog (#38990)\n\n## What changed\n\n- Add optional `guardian_v2` model-message defaults for classifier instructions,\n  review thresholds, reasoning effort, transcript selection and limits, and\n  action and compaction token limits.\n- Apply those defaults when Guardian v2 samples a tool call, while preserving\n  explicit `[features.guardianv2]` settings over catalog values.\n- Preserve the new catalog configuration when applying model overrides.\n\n## Testing\n\n- Cover model-catalog serialization and model override behavior.\n- Verify that sampling uses catalog defaults while retaining local overrides.\n\nGitOrigin-RevId: 4ae9ec235c647acbca05a20b7c4b87a4e1331161","tree":{"sha":"60a7a7c439e39fc3b1192215b0bceb2944b24e45","url":"https://api.github.com/repos/openai/codex/git/trees/60a7a7c439e39fc3b1192215b0bceb2944b24e45"},"url":"https://api.github.com/repos/openai/codex/git/commits/8bf50439f2ebbcd98785c858e22174f919451cf7","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/8bf50439f2ebbcd98785c858e22174f919451cf7","html_url":"https://github.com/openai/codex/commit/8bf50439f2ebbcd98785c858e22174f919451cf7","comments_url":"https://api.github.com/repos/openai/codex/commits/8bf50439f2ebbcd98785c858e22174f919451cf7/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"37cf6c84c086229ed78d69e726b965c0252e9b3e","url":"https://api.github.com/repos/openai/codex/commits/37cf6c84c086229ed78d69e726b965c0252e9b3e","html_url":"https://github.com/openai/codex/commit/37cf6c84c086229ed78d69e726b965c0252e9b3e"}]},{"sha":"37cf6c84c086229ed78d69e726b965c0252e9b3e","node_id":"C_kwDOOYsS4doAKDM3Y2Y2Yzg0YzA4NjIyOWVkNzhkNjllNzI2Yjk2NWMwMjUyZTliM2U","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-17T10:51:04Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T10:56:13Z"},"message":"Include images in Guardian v2 transcripts (#38987)\n\n## What changed\n\n- Add the `features.guardianv2.transcript.include_images` opt-in setting.\n- Include recent images from user and assistant messages and configured tool outputs in Guardian v2 sampling requests.\n- Bound image context to the four most recent images and 8 MiB total, and omit image detail hints when constructing the sampling request.\n\n## Testing\n\n- Cover configuration parsing and image forwarding from messages and tool outputs.\n\nGitOrigin-RevId: b0ae6b6182535fd084ea103ed01dc3c803d7d1f7","tree":{"sha":"d7c9ae571bb034b0e45e73178dc98511aec65c3c","url":"https://api.github.com/repos/openai/codex/git/trees/d7c9ae571bb034b0e45e73178dc98511aec65c3c"},"url":"https://api.github.com/repos/openai/codex/git/commits/37cf6c84c086229ed78d69e726b965c0252e9b3e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/37cf6c84c086229ed78d69e726b965c0252e9b3e","html_url":"https://github.com/openai/codex/commit/37cf6c84c086229ed78d69e726b965c0252e9b3e","comments_url":"https://api.github.com/repos/openai/codex/commits/37cf6c84c086229ed78d69e726b965c0252e9b3e/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"53aa7bb1aac2f7451a11b7f8cad5fda36a2aebc4","url":"https://api.github.com/repos/openai/codex/commits/53aa7bb1aac2f7451a11b7f8cad5fda36a2aebc4","html_url":"https://github.com/openai/codex/commit/53aa7bb1aac2f7451a11b7f8cad5fda36a2aebc4"}]},{"sha":"53aa7bb1aac2f7451a11b7f8cad5fda36a2aebc4","node_id":"C_kwDOOYsS4doAKDUzYWE3YmIxYWFjMmY3NDUxYTExYjdmOGNhZDVmZGEzNmEyYWViYzQ","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-17T10:08:46Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T10:18:24Z"},"message":"Bound Guardian v2 parent compaction context (#38980)\n\n## What changed\n\n- Add `max_parent_compaction_tokens`, defaulting to 25,000 tokens, to the Guardian v2 feature configuration.\n- Reuse the latest encrypted parent compaction only when its complete serialized item fits within the configured limit.\n- Fail closed with the maximum action-risk score when the latest encrypted compaction is oversized, instead of sampling with older context.\n\n## Testing\n\n- Cover exact-boundary and oversized compaction items, including oversized passthrough metadata.\n- Verify that an oversized latest compaction bypasses sampling and prevents approval.\n\nGitOrigin-RevId: 0b308e7bec0f41d46433dfdf656948cee5cba667","tree":{"sha":"18be5db4649e291e035e9fd46c7ff3ddb3d719fc","url":"https://api.github.com/repos/openai/codex/git/trees/18be5db4649e291e035e9fd46c7ff3ddb3d719fc"},"url":"https://api.github.com/repos/openai/codex/git/commits/53aa7bb1aac2f7451a11b7f8cad5fda36a2aebc4","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/53aa7bb1aac2f7451a11b7f8cad5fda36a2aebc4","html_url":"https://github.com/openai/codex/commit/53aa7bb1aac2f7451a11b7f8cad5fda36a2aebc4","comments_url":"https://api.github.com/repos/openai/codex/commits/53aa7bb1aac2f7451a11b7f8cad5fda36a2aebc4/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"632e35ce8d5dec43b75dbf99f9e6fa52bed47c3d","url":"https://api.github.com/repos/openai/codex/commits/632e35ce8d5dec43b75dbf99f9e6fa52bed47c3d","html_url":"https://github.com/openai/codex/commit/632e35ce8d5dec43b75dbf99f9e6fa52bed47c3d"}]},{"sha":"632e35ce8d5dec43b75dbf99f9e6fa52bed47c3d","node_id":"C_kwDOOYsS4doAKDYzMmUzNWNlOGQ1ZGVjNDNiNzVkYmY5OWY5ZTZmYTUyYmVkNDdjM2Q","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-17T09:51:09Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T10:01:59Z"},"message":"Add a configurable skill catalog token budget (#38978)\n\n## What changed\n\n- Add `[skills].max_context_tokens` to override the token budget used to render the available-skills catalog.\n- Require a positive value and cap configured budgets at 10,000 tokens.\n- Preserve the existing default of 2% of the model context window when the option is unset.\n\n## Testing\n\n- Cover configuration parsing, override behavior, the 10,000-token cap, and catalog rendering within the configured budget.\n\nGitOrigin-RevId: f29ddcb57fc2d800c0006d03e1c33cbe3ab6272d","tree":{"sha":"079b7ba1694d801a5493033c9cf1710c9f2c40cd","url":"https://api.github.com/repos/openai/codex/git/trees/079b7ba1694d801a5493033c9cf1710c9f2c40cd"},"url":"https://api.github.com/repos/openai/codex/git/commits/632e35ce8d5dec43b75dbf99f9e6fa52bed47c3d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/632e35ce8d5dec43b75dbf99f9e6fa52bed47c3d","html_url":"https://github.com/openai/codex/commit/632e35ce8d5dec43b75dbf99f9e6fa52bed47c3d","comments_url":"https://api.github.com/repos/openai/codex/commits/632e35ce8d5dec43b75dbf99f9e6fa52bed47c3d/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c6058ccaa91ab17159cf805bf4d6d4edd87fe5fc","url":"https://api.github.com/repos/openai/codex/commits/c6058ccaa91ab17159cf805bf4d6d4edd87fe5fc","html_url":"https://github.com/openai/codex/commit/c6058ccaa91ab17159cf805bf4d6d4edd87fe5fc"}]},{"sha":"c6058ccaa91ab17159cf805bf4d6d4edd87fe5fc","node_id":"C_kwDOOYsS4doAKGM2MDU4Y2NhYTkxYWIxNzE1OWNmODA1YmY0ZDZkNGVkZDg3ZmU1ZmM","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-08-17T05:44:20Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T05:52:32Z"},"message":"Stop loading legacy managed config on Windows (#38947)\n\n## What changed\n\n- Ignore the default `CODEX_HOME/managed_config.toml` on Windows and exclude it\n  from local managed-configuration detection.\n- Emit a startup warning when the deprecated file exists, directing users to\n  `%ProgramData%\\OpenAI\\Codex\\requirements.toml` for enforced settings or\n  `config.toml` for defaults.\n- Preserve explicit managed-config path overrides and Unix legacy-file support.\n\n## Testing\n\n- Add Windows tests covering ignored legacy settings, the startup warning, and\n  managed-configuration detection through `requirements.toml`.\n\nGitOrigin-RevId: a61d9d9912b13817ba82807a486c9ed92e49c7bc","tree":{"sha":"1417a1f9b692b69c99d22dab9bb88c73fe0b750c","url":"https://api.github.com/repos/openai/codex/git/trees/1417a1f9b692b69c99d22dab9bb88c73fe0b750c"},"url":"https://api.github.com/repos/openai/codex/git/commits/c6058ccaa91ab17159cf805bf4d6d4edd87fe5fc","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c6058ccaa91ab17159cf805bf4d6d4edd87fe5fc","html_url":"https://github.com/openai/codex/commit/c6058ccaa91ab17159cf805bf4d6d4edd87fe5fc","comments_url":"https://api.github.com/repos/openai/codex/commits/c6058ccaa91ab17159cf805bf4d6d4edd87fe5fc/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"e38290846c11424567c9c8226f2be8a2886c5929","url":"https://api.github.com/repos/openai/codex/commits/e38290846c11424567c9c8226f2be8a2886c5929","html_url":"https://github.com/openai/codex/commit/e38290846c11424567c9c8226f2be8a2886c5929"}]},{"sha":"e38290846c11424567c9c8226f2be8a2886c5929","node_id":"C_kwDOOYsS4doAKGUzODI5MDg0NmMxMTQyNDU2N2M5YzgyMjZmMmJlOGEyODg2YzU5Mjk","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-08-17T04:32:03Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T04:37:50Z"},"message":"Enforce environment-specific command policies (#38942)\n\n## What changed\n\n- Add an optional restrictive execution policy to `EnvironmentConfig` and merge it over the active command policy for shell execution and approval decisions.\n- Reject environment policies that contain allow rules, so environment configuration can only tighten command access.\n- Include the environment policy fingerprint in cached approval keys so policy changes require fresh session approvals.\n\n## Testing\n\n- Cover restrictions overriding saved prefix approvals, policy changes invalidating session approvals, and environment overlays remaining effective when model-specific prefix filtering is active.\n\nGitOrigin-RevId: e94f877549ed5e0f577b8cb52f3c1872c58f029d","tree":{"sha":"01b8fac98ffc2ac04d0350d28fd6dbe38d18fd42","url":"https://api.github.com/repos/openai/codex/git/trees/01b8fac98ffc2ac04d0350d28fd6dbe38d18fd42"},"url":"https://api.github.com/repos/openai/codex/git/commits/e38290846c11424567c9c8226f2be8a2886c5929","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/e38290846c11424567c9c8226f2be8a2886c5929","html_url":"https://github.com/openai/codex/commit/e38290846c11424567c9c8226f2be8a2886c5929","comments_url":"https://api.github.com/repos/openai/codex/commits/e38290846c11424567c9c8226f2be8a2886c5929/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"89e297729ebc1a8c243cef73c7ab64cd842ecd5a","url":"https://api.github.com/repos/openai/codex/commits/89e297729ebc1a8c243cef73c7ab64cd842ecd5a","html_url":"https://github.com/openai/codex/commit/89e297729ebc1a8c243cef73c7ab64cd842ecd5a"}]},{"sha":"89e297729ebc1a8c243cef73c7ab64cd842ecd5a","node_id":"C_kwDOOYsS4doAKDg5ZTI5NzcyOWViYzFhOGMyNDNjZWY3M2M3YWI2NGNkODQyZWNkNWE","commit":{"author":{"name":"Anton Panasenko","email":"apanasenko@openai.com","date":"2026-08-17T04:12:47Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T04:17:45Z"},"message":"Prevent Noise auth tokens from reaching child processes (#38941)\n\n## Why\n\n`CODEX_EXEC_SERVER_NOISE_AUTH_TOKEN` is an execution-server credential and\nmust not be exposed to model-reachable commands or command hooks, including\nwhen shell environment policy explicitly sets a case variant of the name.\n\n## What changed\n\n- Add `CODEX_EXEC_SERVER_NOISE_AUTH_TOKEN` to the shared list of\n  non-inheritable environment variables.\n- Keep the environment variable constant in `codex-protocol` so the exec\n  server and environment scrubber use the same definition.\n- Verify case-insensitive removal after policy overrides for shell commands\n  and command hooks.\n\nGitOrigin-RevId: 759b224b6a7fb4f56f7b1a6d94ffbb0b188c658f","tree":{"sha":"4d95e6633c093f79f1abbb66e5bb2ab7530352e6","url":"https://api.github.com/repos/openai/codex/git/trees/4d95e6633c093f79f1abbb66e5bb2ab7530352e6"},"url":"https://api.github.com/repos/openai/codex/git/commits/89e297729ebc1a8c243cef73c7ab64cd842ecd5a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/89e297729ebc1a8c243cef73c7ab64cd842ecd5a","html_url":"https://github.com/openai/codex/commit/89e297729ebc1a8c243cef73c7ab64cd842ecd5a","comments_url":"https://api.github.com/repos/openai/codex/commits/89e297729ebc1a8c243cef73c7ab64cd842ecd5a/comments","author":{"login":"apanasenko-oai","id":228802911,"node_id":"U_kgDODaNBXw","avatar_url":"https://avatars.githubusercontent.com/u/228802911?v=4","gravatar_id":"","url":"https://api.github.com/users/apanasenko-oai","html_url":"https://github.com/apanasenko-oai","followers_url":"https://api.github.com/users/apanasenko-oai/followers","following_url":"https://api.github.com/users/apanasenko-oai/following{/other_user}","gists_url":"https://api.github.com/users/apanasenko-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/apanasenko-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/apanasenko-oai/subscriptions","organizations_url":"https://api.github.com/users/apanasenko-oai/orgs","repos_url":"https://api.github.com/users/apanasenko-oai/repos","events_url":"https://api.github.com/users/apanasenko-oai/events{/privacy}","received_events_url":"https://api.github.com/users/apanasenko-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"3b4569a920f6442a23ad724a922810ac5ed1dd2a","url":"https://api.github.com/repos/openai/codex/commits/3b4569a920f6442a23ad724a922810ac5ed1dd2a","html_url":"https://github.com/openai/codex/commit/3b4569a920f6442a23ad724a922810ac5ed1dd2a"}]},{"sha":"3b4569a920f6442a23ad724a922810ac5ed1dd2a","node_id":"C_kwDOOYsS4doAKDNiNDU2OWE5MjBmNjQ0MmEyM2FkNzI0YTkyMjgxMGFjNWVkMWRkMmE","commit":{"author":{"name":"Anton Panasenko","email":"apanasenko@openai.com","date":"2026-08-17T03:53:15Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T04:01:37Z"},"message":"Add experimental app-server project APIs (#38940)\n\n## What changed\n\n- Add SQLite-backed `project/list`, `project/read`, `project/create`,\n  `project/import`, `project/update`, `project/move`, and `project/delete`\n  endpoints with ordered roots, metadata, manual positioning, pagination, and\n  idempotent creation.\n- Add project assignment to thread start, metadata updates, list filtering,\n  and fork inheritance. Project deletion clears assignments without deleting\n  threads.\n- Emit `project/changed` and `thread/project/updated` notifications after\n  committed changes, and export the new protocol schemas and TypeScript types.\n\n## Testing\n\n- Cover project lifecycle and ordering, idempotency, atomic imports, cursor and\n  filter validation, thread assignment, deletion, and fork inheritance.\n\nGitOrigin-RevId: 47ae621be01ab8ef70a74a629fb29a5c5709ea33","tree":{"sha":"7880913bc2d60b5275206eea6c38931e84d2ae24","url":"https://api.github.com/repos/openai/codex/git/trees/7880913bc2d60b5275206eea6c38931e84d2ae24"},"url":"https://api.github.com/repos/openai/codex/git/commits/3b4569a920f6442a23ad724a922810ac5ed1dd2a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/3b4569a920f6442a23ad724a922810ac5ed1dd2a","html_url":"https://github.com/openai/codex/commit/3b4569a920f6442a23ad724a922810ac5ed1dd2a","comments_url":"https://api.github.com/repos/openai/codex/commits/3b4569a920f6442a23ad724a922810ac5ed1dd2a/comments","author":{"login":"apanasenko-oai","id":228802911,"node_id":"U_kgDODaNBXw","avatar_url":"https://avatars.githubusercontent.com/u/228802911?v=4","gravatar_id":"","url":"https://api.github.com/users/apanasenko-oai","html_url":"https://github.com/apanasenko-oai","followers_url":"https://api.github.com/users/apanasenko-oai/followers","following_url":"https://api.github.com/users/apanasenko-oai/following{/other_user}","gists_url":"https://api.github.com/users/apanasenko-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/apanasenko-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/apanasenko-oai/subscriptions","organizations_url":"https://api.github.com/users/apanasenko-oai/orgs","repos_url":"https://api.github.com/users/apanasenko-oai/repos","events_url":"https://api.github.com/users/apanasenko-oai/events{/privacy}","received_events_url":"https://api.github.com/users/apanasenko-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"1f41cc5d92722748e45cae9cecc6d883a4e7cbb1","url":"https://api.github.com/repos/openai/codex/commits/1f41cc5d92722748e45cae9cecc6d883a4e7cbb1","html_url":"https://github.com/openai/codex/commit/1f41cc5d92722748e45cae9cecc6d883a4e7cbb1"}]},{"sha":"1f41cc5d92722748e45cae9cecc6d883a4e7cbb1","node_id":"C_kwDOOYsS4doAKDFmNDFjYzVkOTI3MjI3NDhlNDVjYWU5Y2VjYzZkODgzYTRlN2NiYjE","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-17T00:27:09Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T00:32:09Z"},"message":"Compact successful command activity in the TUI (#38921)\n\n## What changed\n\n- Group consecutive successful agent and unified-exec startup commands into a compact `Ran N commands` entry while preserving their full transcript.\n- Flush command groups at interaction boundaries, after failures, and after 32 completed commands. Keep manual shell commands and failed or declined commands visible.\n- Apply the same grouping rules when replaying thread history without duplicating command starts or disturbing unrelated active commands.\n\n## Testing\n\n- Add TUI coverage for live and replayed grouping, transcript preservation, failures, overlapping commands, group limits, and interaction boundaries.\n\nGitOrigin-RevId: d6602a20201644012fcff3d6cecf4690024383a9","tree":{"sha":"d25c3854c14850309b9958b9c1cc84252131ae12","url":"https://api.github.com/repos/openai/codex/git/trees/d25c3854c14850309b9958b9c1cc84252131ae12"},"url":"https://api.github.com/repos/openai/codex/git/commits/1f41cc5d92722748e45cae9cecc6d883a4e7cbb1","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/1f41cc5d92722748e45cae9cecc6d883a4e7cbb1","html_url":"https://github.com/openai/codex/commit/1f41cc5d92722748e45cae9cecc6d883a4e7cbb1","comments_url":"https://api.github.com/repos/openai/codex/commits/1f41cc5d92722748e45cae9cecc6d883a4e7cbb1/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"935b1c4e3d25ec0c04bccde0144125f46314180b","url":"https://api.github.com/repos/openai/codex/commits/935b1c4e3d25ec0c04bccde0144125f46314180b","html_url":"https://github.com/openai/codex/commit/935b1c4e3d25ec0c04bccde0144125f46314180b"}]},{"sha":"935b1c4e3d25ec0c04bccde0144125f46314180b","node_id":"C_kwDOOYsS4doAKDkzNWIxYzRlM2QyNWVjMGMwNGJjY2RlMDE0NDEyNWY0NjMxNDE4MGI","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-08-17T00:20:02Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T00:25:19Z"},"message":"Reject obsolete app-server permission profile fields (#38919)\n\n## Why\n\nApp-server request deserialization otherwise ignores unknown fields, so clients using the removed `permissionProfile` field could have their requested permission settings silently ignored.\n\n## What changed\n\n- Reject `permissionProfile` with an invalid-params error on `thread/start`, `thread/resume`, `thread/fork`, and `turn/start`.\n- Direct clients to select a named profile through `permissions` instead.\n- Continue accepting unrelated unknown fields for forward compatibility.\n\n## Testing\n\n- Cover rejection of the obsolete field on all four affected methods and verify that the connection remains usable.\n- Cover successful `thread/start` requests that combine named `permissions` with an unknown field.\n\nGitOrigin-RevId: a63764fb899bc5f212d60617dc32e911bde8073e","tree":{"sha":"c2e89d3140b0fc48c41d8528da260279d8e51f39","url":"https://api.github.com/repos/openai/codex/git/trees/c2e89d3140b0fc48c41d8528da260279d8e51f39"},"url":"https://api.github.com/repos/openai/codex/git/commits/935b1c4e3d25ec0c04bccde0144125f46314180b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/935b1c4e3d25ec0c04bccde0144125f46314180b","html_url":"https://github.com/openai/codex/commit/935b1c4e3d25ec0c04bccde0144125f46314180b","comments_url":"https://api.github.com/repos/openai/codex/commits/935b1c4e3d25ec0c04bccde0144125f46314180b/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c8ddb210d2429cacacf86593e157114b00634f13","url":"https://api.github.com/repos/openai/codex/commits/c8ddb210d2429cacacf86593e157114b00634f13","html_url":"https://github.com/openai/codex/commit/c8ddb210d2429cacacf86593e157114b00634f13"}]},{"sha":"c8ddb210d2429cacacf86593e157114b00634f13","node_id":"C_kwDOOYsS4doAKGM4ZGRiMjEwZDI0MjljYWNhY2Y4NjU5M2UxNTcxMTRiMDA2MzRmMTM","commit":{"author":{"name":"chess","email":"chess@openai.com","date":"2026-08-16T23:57:42Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T00:09:44Z"},"message":"Improve `codex doctor` network diagnostics (#38918)\n\n## What changed\n\n- Probe the configured Responses inference endpoint with Codex's route-aware HTTP client, including configured proxy and custom CA behavior.\n- Classify TLS, proxy authentication, proxy configuration, resolution, and timeout failures into actionable diagnostics.\n- Report privacy-safe macOS system proxy state and suggest enabling `respect_system_proxy` when a configured proxy is otherwise unused.\n- Preserve system-root fallback when a custom CA is invalid, and account for provider-specific API key configuration when selecting the probe route.\n\n## Testing\n\n- Cover inference endpoint selection, invalid custom CA fallback, proxy authentication failures, TLS classification, and macOS proxy reporting.\n\nGitOrigin-RevId: c30a3ca5a332119e2b2f8c65341ef9b2251a28a2","tree":{"sha":"a60fe0e19af75754c2a1806788c6ef5ef727b9d2","url":"https://api.github.com/repos/openai/codex/git/trees/a60fe0e19af75754c2a1806788c6ef5ef727b9d2"},"url":"https://api.github.com/repos/openai/codex/git/commits/c8ddb210d2429cacacf86593e157114b00634f13","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c8ddb210d2429cacacf86593e157114b00634f13","html_url":"https://github.com/openai/codex/commit/c8ddb210d2429cacacf86593e157114b00634f13","comments_url":"https://api.github.com/repos/openai/codex/commits/c8ddb210d2429cacacf86593e157114b00634f13/comments","author":{"login":"chess-oai","id":289791516,"node_id":"U_kgDOEUXeHA","avatar_url":"https://avatars.githubusercontent.com/u/289791516?v=4","gravatar_id":"","url":"https://api.github.com/users/chess-oai","html_url":"https://github.com/chess-oai","followers_url":"https://api.github.com/users/chess-oai/followers","following_url":"https://api.github.com/users/chess-oai/following{/other_user}","gists_url":"https://api.github.com/users/chess-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/chess-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chess-oai/subscriptions","organizations_url":"https://api.github.com/users/chess-oai/orgs","repos_url":"https://api.github.com/users/chess-oai/repos","events_url":"https://api.github.com/users/chess-oai/events{/privacy}","received_events_url":"https://api.github.com/users/chess-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"772e88c8ae987445b81d932ea0f38fa0cc8fb5dc","url":"https://api.github.com/repos/openai/codex/commits/772e88c8ae987445b81d932ea0f38fa0cc8fb5dc","html_url":"https://github.com/openai/codex/commit/772e88c8ae987445b81d932ea0f38fa0cc8fb5dc"}]},{"sha":"772e88c8ae987445b81d932ea0f38fa0cc8fb5dc","node_id":"C_kwDOOYsS4doAKDc3MmU4OGM4YWU5ODc0NDViODFkOTMyZWEwZjM4ZmEwY2M4ZmI1ZGM","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-08-16T23:52:30Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T00:05:54Z"},"message":"Honor legacy `:project_roots` permission entries (#38916)\n\n## Why\n\nPermission profiles written before the rename to `:workspace_roots` can still\ncontain `:project_roots`. Treating that token as unknown ignores its entries and\ncan drop filesystem restrictions.\n\n## What changed\n\n- Parse `:project_roots` as an alias for `:workspace_roots`.\n- Cover deny rules and read-only subpath carveouts in legacy profiles.\n\nGitOrigin-RevId: 10aafc9e15372d1a8bcc2dbcf3ad7cc987f4e67e","tree":{"sha":"7a837c93e22f5ebb6937dda1623ebb0ea114db57","url":"https://api.github.com/repos/openai/codex/git/trees/7a837c93e22f5ebb6937dda1623ebb0ea114db57"},"url":"https://api.github.com/repos/openai/codex/git/commits/772e88c8ae987445b81d932ea0f38fa0cc8fb5dc","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/772e88c8ae987445b81d932ea0f38fa0cc8fb5dc","html_url":"https://github.com/openai/codex/commit/772e88c8ae987445b81d932ea0f38fa0cc8fb5dc","comments_url":"https://api.github.com/repos/openai/codex/commits/772e88c8ae987445b81d932ea0f38fa0cc8fb5dc/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"cd8dc1e9b6dd24d335f4fcb26546f36d045fd59a","url":"https://api.github.com/repos/openai/codex/commits/cd8dc1e9b6dd24d335f4fcb26546f36d045fd59a","html_url":"https://github.com/openai/codex/commit/cd8dc1e9b6dd24d335f4fcb26546f36d045fd59a"}]},{"sha":"cd8dc1e9b6dd24d335f4fcb26546f36d045fd59a","node_id":"C_kwDOOYsS4doAKGNkOGRjMWU5YjZkZDI0ZDMzNWY0ZmNiMjY1NDZmMzZkMDQ1ZmQ1OWE","commit":{"author":{"name":"Benjamin Carlsson","email":"bc@openai.com","date":"2026-08-16T22:53:19Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-16T23:05:11Z"},"message":"Stop rendering columns after filling their area (#38913)\n\n## What changed\n\nStop visiting remaining `ColumnRenderable` children once the render position\nreaches the bottom of the available area.\n\nGitOrigin-RevId: 5b7f2c657f65879119b1b840e82f47b1c5f9e3db","tree":{"sha":"65be07afa2a3fea148c3a43b6cc7741e9c18f5d5","url":"https://api.github.com/repos/openai/codex/git/trees/65be07afa2a3fea148c3a43b6cc7741e9c18f5d5"},"url":"https://api.github.com/repos/openai/codex/git/commits/cd8dc1e9b6dd24d335f4fcb26546f36d045fd59a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/cd8dc1e9b6dd24d335f4fcb26546f36d045fd59a","html_url":"https://github.com/openai/codex/commit/cd8dc1e9b6dd24d335f4fcb26546f36d045fd59a","comments_url":"https://api.github.com/repos/openai/codex/commits/cd8dc1e9b6dd24d335f4fcb26546f36d045fd59a/comments","author":{"login":"bc-openai","id":185964850,"node_id":"U_kgDOCxWZMg","avatar_url":"https://avatars.githubusercontent.com/u/185964850?v=4","gravatar_id":"","url":"https://api.github.com/users/bc-openai","html_url":"https://github.com/bc-openai","followers_url":"https://api.github.com/users/bc-openai/followers","following_url":"https://api.github.com/users/bc-openai/following{/other_user}","gists_url":"https://api.github.com/users/bc-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/bc-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bc-openai/subscriptions","organizations_url":"https://api.github.com/users/bc-openai/orgs","repos_url":"https://api.github.com/users/bc-openai/repos","events_url":"https://api.github.com/users/bc-openai/events{/privacy}","received_events_url":"https://api.github.com/users/bc-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"2bc43d516e8688ed5549e6b5ee7cb54b52781bd1","url":"https://api.github.com/repos/openai/codex/commits/2bc43d516e8688ed5549e6b5ee7cb54b52781bd1","html_url":"https://github.com/openai/codex/commit/2bc43d516e8688ed5549e6b5ee7cb54b52781bd1"}]},{"sha":"2bc43d516e8688ed5549e6b5ee7cb54b52781bd1","node_id":"C_kwDOOYsS4doAKDJiYzQzZDUxNmU4Njg4ZWQ1NTQ5ZTZiNWVlN2NiNTRiNTI3ODFiZDE","commit":{"author":{"name":"Benjamin Carlsson","email":"bc@openai.com","date":"2026-08-16T21:43:53Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-16T21:48:41Z"},"message":"Edit queued messages with Vim history-up (#38907)\n\n## What changed\n\n- When the composer is empty in Vim normal mode, make the configured history-up binding restore the latest queued follow-up for editing.\n- Remove the restored message from the queue so submitting the edited version replaces it instead of creating a duplicate.\n- Preserve normal history navigation when the composer has text or a popup is active, and honor remapped Vim bindings.\n\n## Testing\n\n- Add TUI tests covering repeated edit-and-requeue cycles and a remapped history-up binding.\n\nGitOrigin-RevId: 0b04dd964d3fc6fdcd10712aa4d5fd81cbbd2255","tree":{"sha":"756066432aad8f254d3c179e23e73ad488c711b9","url":"https://api.github.com/repos/openai/codex/git/trees/756066432aad8f254d3c179e23e73ad488c711b9"},"url":"https://api.github.com/repos/openai/codex/git/commits/2bc43d516e8688ed5549e6b5ee7cb54b52781bd1","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/2bc43d516e8688ed5549e6b5ee7cb54b52781bd1","html_url":"https://github.com/openai/codex/commit/2bc43d516e8688ed5549e6b5ee7cb54b52781bd1","comments_url":"https://api.github.com/repos/openai/codex/commits/2bc43d516e8688ed5549e6b5ee7cb54b52781bd1/comments","author":{"login":"bc-openai","id":185964850,"node_id":"U_kgDOCxWZMg","avatar_url":"https://avatars.githubusercontent.com/u/185964850?v=4","gravatar_id":"","url":"https://api.github.com/users/bc-openai","html_url":"https://github.com/bc-openai","followers_url":"https://api.github.com/users/bc-openai/followers","following_url":"https://api.github.com/users/bc-openai/following{/other_user}","gists_url":"https://api.github.com/users/bc-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/bc-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bc-openai/subscriptions","organizations_url":"https://api.github.com/users/bc-openai/orgs","repos_url":"https://api.github.com/users/bc-openai/repos","events_url":"https://api.github.com/users/bc-openai/events{/privacy}","received_events_url":"https://api.github.com/users/bc-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"6c108912eeacabfc82723bf44f8a23f6e2f86585","url":"https://api.github.com/repos/openai/codex/commits/6c108912eeacabfc82723bf44f8a23f6e2f86585","html_url":"https://github.com/openai/codex/commit/6c108912eeacabfc82723bf44f8a23f6e2f86585"}]},{"sha":"6c108912eeacabfc82723bf44f8a23f6e2f86585","node_id":"C_kwDOOYsS4doAKDZjMTA4OTEyZWVhY2FiZmM4MjcyM2JmNDRmOGEyM2Y2ZTJmODY1ODU","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-08-16T20:26:25Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-16T20:35:05Z"},"message":"Honor per-environment shell variable policies (#38902)\n\n## What changed\n\n- Carry `ShellEnvironmentPolicy` in each resolved `EnvironmentConfig` and use\n  the selected turn environment's policy for shell commands, user shell tasks,\n  and unified exec.\n- Infer the policy from the thread configuration when an environment does not\n  provide its own resolved configuration.\n- Redact the policy from `EnvironmentConfig` debug output because it can contain\n  explicit environment variable values.\n\n## Testing\n\n- Verify shell handlers and unified exec filter inherited variables according\n  to the selected environment while preserving its explicit overrides.\n\nGitOrigin-RevId: 9f6a52aa4af60e5f17251a0e1b11e1926b779055","tree":{"sha":"9465f27fee5234705ffc4773a468131bc9fb1eea","url":"https://api.github.com/repos/openai/codex/git/trees/9465f27fee5234705ffc4773a468131bc9fb1eea"},"url":"https://api.github.com/repos/openai/codex/git/commits/6c108912eeacabfc82723bf44f8a23f6e2f86585","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/6c108912eeacabfc82723bf44f8a23f6e2f86585","html_url":"https://github.com/openai/codex/commit/6c108912eeacabfc82723bf44f8a23f6e2f86585","comments_url":"https://api.github.com/repos/openai/codex/commits/6c108912eeacabfc82723bf44f8a23f6e2f86585/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"f85e81d30be6a57705bbd957e287de000a4870d2","url":"https://api.github.com/repos/openai/codex/commits/f85e81d30be6a57705bbd957e287de000a4870d2","html_url":"https://github.com/openai/codex/commit/f85e81d30be6a57705bbd957e287de000a4870d2"}]},{"sha":"f85e81d30be6a57705bbd957e287de000a4870d2","node_id":"C_kwDOOYsS4doAKGY4NWU4MWQzMGJlNmE1NzcwNWJiZDk1N2UyODdkZTAwMGE0ODcwZDI","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-08-16T20:22:06Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-16T20:27:05Z"},"message":"Move requirements policy ownership to execpolicy (#38899)\n\n## What changed\n\n- Define and export `RequirementsExecPolicy` from `codex-execpolicy`, alongside the\n  underlying `Policy` type.\n- Re-export the type from `codex-config` so existing config consumers retain the\n  same API.\n- Preserve its order-independent equality and `AsRef<Policy>` behavior.\n\nGitOrigin-RevId: e94c56b36824d07f2bc7ba14ce40bdb770d4ab46","tree":{"sha":"c293f71b285e127c8700cd24f3513c14aa71587c","url":"https://api.github.com/repos/openai/codex/git/trees/c293f71b285e127c8700cd24f3513c14aa71587c"},"url":"https://api.github.com/repos/openai/codex/git/commits/f85e81d30be6a57705bbd957e287de000a4870d2","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/f85e81d30be6a57705bbd957e287de000a4870d2","html_url":"https://github.com/openai/codex/commit/f85e81d30be6a57705bbd957e287de000a4870d2","comments_url":"https://api.github.com/repos/openai/codex/commits/f85e81d30be6a57705bbd957e287de000a4870d2/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"ed32158e90ef872c5eef96baf2f14feac70aee6e","url":"https://api.github.com/repos/openai/codex/commits/ed32158e90ef872c5eef96baf2f14feac70aee6e","html_url":"https://github.com/openai/codex/commit/ed32158e90ef872c5eef96baf2f14feac70aee6e"}]},{"sha":"ed32158e90ef872c5eef96baf2f14feac70aee6e","node_id":"C_kwDOOYsS4doAKGVkMzIxNThlOTBlZjg3MmM1ZWVmOTZiYWYyZjE0ZmVhYzcwYWVlNmU","commit":{"author":{"name":"Benjamin Carlsson","email":"bc@openai.com","date":"2026-08-16T19:42:56Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-16T19:48:07Z"},"message":"Add working-directory commands to the TUI (#38894)\n\n## What changed\n\n- Add `/cd [path]` for changing an idle local session's working directory while preserving conversation history. Relative paths resolve from the current directory, and omitting the path selects `~`.\n- Reload project configuration, instructions, permissions, keybindings, file search, and hooks for the destination before replacing the active session.\n- Reject unsafe transitions, including active or queued work, background terminals, remote environments, untrusted destinations, and incompatible permission profiles.\n- Add `/pwd` and its `/cwd` alias to display the current working directory, and discard asynchronous results left over from the previous directory.\n\n## Testing\n\n- Cover command parsing, aliases, default paths, session eligibility, transition failures, history preservation, destination policy loading, hooks, and stale events.\n\nGitOrigin-RevId: 1a987c029f157a087ba02c0f26e022260409132b","tree":{"sha":"aa456cdeab503e69280993a142699ea4dad09653","url":"https://api.github.com/repos/openai/codex/git/trees/aa456cdeab503e69280993a142699ea4dad09653"},"url":"https://api.github.com/repos/openai/codex/git/commits/ed32158e90ef872c5eef96baf2f14feac70aee6e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/ed32158e90ef872c5eef96baf2f14feac70aee6e","html_url":"https://github.com/openai/codex/commit/ed32158e90ef872c5eef96baf2f14feac70aee6e","comments_url":"https://api.github.com/repos/openai/codex/commits/ed32158e90ef872c5eef96baf2f14feac70aee6e/comments","author":{"login":"bc-openai","id":185964850,"node_id":"U_kgDOCxWZMg","avatar_url":"https://avatars.githubusercontent.com/u/185964850?v=4","gravatar_id":"","url":"https://api.github.com/users/bc-openai","html_url":"https://github.com/bc-openai","followers_url":"https://api.github.com/users/bc-openai/followers","following_url":"https://api.github.com/users/bc-openai/following{/other_user}","gists_url":"https://api.github.com/users/bc-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/bc-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bc-openai/subscriptions","organizations_url":"https://api.github.com/users/bc-openai/orgs","repos_url":"https://api.github.com/users/bc-openai/repos","events_url":"https://api.github.com/users/bc-openai/events{/privacy}","received_events_url":"https://api.github.com/users/bc-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"375996d3f5b9130edf12f4af8073703df2724570","url":"https://api.github.com/repos/openai/codex/commits/375996d3f5b9130edf12f4af8073703df2724570","html_url":"https://github.com/openai/codex/commit/375996d3f5b9130edf12f4af8073703df2724570"}]},{"sha":"375996d3f5b9130edf12f4af8073703df2724570","node_id":"C_kwDOOYsS4doAKDM3NTk5NmQzZjViOTEzMGVkZjEyZjRhZjgwNzM3MDNkZjI3MjQ1NzA","commit":{"author":{"name":"Benjamin Carlsson","email":"bc@openai.com","date":"2026-08-16T19:32:55Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-16T19:37:39Z"},"message":"Restore thread timestamp maxima independently (#38893)\n\n## What changed\n\nLoad the persisted maxima for `updated_at_ms` and `recency_at_ms` with separate\nscalar subqueries during state initialization. This restores each timestamp\ncounter independently when the maxima belong to different threads.\n\n## Testing\n\nAdd a regression test that reopens the state database and verifies both\nindependent maxima are restored.\n\nGitOrigin-RevId: aeb9cc005d52c4a02dc7a220a817e6d40c0e01d4","tree":{"sha":"f8cba08315bd39550807b31aaa0be9f28f49bbe7","url":"https://api.github.com/repos/openai/codex/git/trees/f8cba08315bd39550807b31aaa0be9f28f49bbe7"},"url":"https://api.github.com/repos/openai/codex/git/commits/375996d3f5b9130edf12f4af8073703df2724570","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/375996d3f5b9130edf12f4af8073703df2724570","html_url":"https://github.com/openai/codex/commit/375996d3f5b9130edf12f4af8073703df2724570","comments_url":"https://api.github.com/repos/openai/codex/commits/375996d3f5b9130edf12f4af8073703df2724570/comments","author":{"login":"bc-openai","id":185964850,"node_id":"U_kgDOCxWZMg","avatar_url":"https://avatars.githubusercontent.com/u/185964850?v=4","gravatar_id":"","url":"https://api.github.com/users/bc-openai","html_url":"https://github.com/bc-openai","followers_url":"https://api.github.com/users/bc-openai/followers","following_url":"https://api.github.com/users/bc-openai/following{/other_user}","gists_url":"https://api.github.com/users/bc-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/bc-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bc-openai/subscriptions","organizations_url":"https://api.github.com/users/bc-openai/orgs","repos_url":"https://api.github.com/users/bc-openai/repos","events_url":"https://api.github.com/users/bc-openai/events{/privacy}","received_events_url":"https://api.github.com/users/bc-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"9ded177ce7c1c0bd2047f902936c177612ab3434","url":"https://api.github.com/repos/openai/codex/commits/9ded177ce7c1c0bd2047f902936c177612ab3434","html_url":"https://github.com/openai/codex/commit/9ded177ce7c1c0bd2047f902936c177612ab3434"}]},{"sha":"9ded177ce7c1c0bd2047f902936c177612ab3434","node_id":"C_kwDOOYsS4doAKDlkZWQxNzdjZTdjMWMwYmQyMDQ3ZjkwMjkzNmMxNzc2MTJhYjM0MzQ","commit":{"author":{"name":"Tin Kadoic","email":"blackduke@openai.com","date":"2026-08-16T06:26:34Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-16T06:48:59Z"},"message":"Identify Mac mini hosts in remote control handshakes (#38840)\n\n## What changed\n\n- On macOS, inspect the hardware profile before opening a remote-control WebSocket and send `x-codex-host-device-kind: mac_mini` when the machine name is exactly `Mac mini`.\n- Cache successful detection results, bound the profile lookup to two seconds, and omit the header on other platforms or when detection fails.\n\n## Testing\n\n- Add parser coverage for Mac mini, other machine names, empty profiles, and malformed profile data.\n\nGitOrigin-RevId: d2a4589bec0c879957f14ab4a195fd54747cc122","tree":{"sha":"80af093a595d2e4a0b45dd666f5390e9dbad5d98","url":"https://api.github.com/repos/openai/codex/git/trees/80af093a595d2e4a0b45dd666f5390e9dbad5d98"},"url":"https://api.github.com/repos/openai/codex/git/commits/9ded177ce7c1c0bd2047f902936c177612ab3434","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/9ded177ce7c1c0bd2047f902936c177612ab3434","html_url":"https://github.com/openai/codex/commit/9ded177ce7c1c0bd2047f902936c177612ab3434","comments_url":"https://api.github.com/repos/openai/codex/commits/9ded177ce7c1c0bd2047f902936c177612ab3434/comments","author":{"login":"blackduke-open","id":263774086,"node_id":"U_kgDOD7jfhg","avatar_url":"https://avatars.githubusercontent.com/u/263774086?v=4","gravatar_id":"","url":"https://api.github.com/users/blackduke-open","html_url":"https://github.com/blackduke-open","followers_url":"https://api.github.com/users/blackduke-open/followers","following_url":"https://api.github.com/users/blackduke-open/following{/other_user}","gists_url":"https://api.github.com/users/blackduke-open/gists{/gist_id}","starred_url":"https://api.github.com/users/blackduke-open/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blackduke-open/subscriptions","organizations_url":"https://api.github.com/users/blackduke-open/orgs","repos_url":"https://api.github.com/users/blackduke-open/repos","events_url":"https://api.github.com/users/blackduke-open/events{/privacy}","received_events_url":"https://api.github.com/users/blackduke-open/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"9bfaf7a076523ad6bbf75b2b62893543749991c7","url":"https://api.github.com/repos/openai/codex/commits/9bfaf7a076523ad6bbf75b2b62893543749991c7","html_url":"https://github.com/openai/codex/commit/9bfaf7a076523ad6bbf75b2b62893543749991c7"}]},{"sha":"9bfaf7a076523ad6bbf75b2b62893543749991c7","node_id":"C_kwDOOYsS4doAKDliZmFmN2EwNzY1MjNhZDZiYmY3NWIyYjYyODkzNTQzNzQ5OTkxYzc","commit":{"author":{"name":"Benjamin Carlsson","email":"bc@openai.com","date":"2026-08-16T05:54:37Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-16T05:59:34Z"},"message":"Share editor keymaps across TUI composer components (#38837)\n\n## What changed\n\n- Store the editor portion of `RuntimeKeymap` in an `Arc` so the chat composer\n  and its embedded textarea use the same keymap snapshot.\n- Initialize the textarea from the composer's default runtime keymap and keep\n  custom binding updates shared between both components.\n- Use copy-on-write when tests and binding resolution need to mutate editor\n  bindings.\n\n## Testing\n\n- Verify that applying custom editor bindings shares the same keymap allocation\n  with the composer and textarea.\n\nGitOrigin-RevId: 7f3b0afd6cc784e23deee8819e5c2c37a3709c68","tree":{"sha":"cf874cf186a3b75a065600a74ff28cf3b635b089","url":"https://api.github.com/repos/openai/codex/git/trees/cf874cf186a3b75a065600a74ff28cf3b635b089"},"url":"https://api.github.com/repos/openai/codex/git/commits/9bfaf7a076523ad6bbf75b2b62893543749991c7","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/9bfaf7a076523ad6bbf75b2b62893543749991c7","html_url":"https://github.com/openai/codex/commit/9bfaf7a076523ad6bbf75b2b62893543749991c7","comments_url":"https://api.github.com/repos/openai/codex/commits/9bfaf7a076523ad6bbf75b2b62893543749991c7/comments","author":{"login":"bc-openai","id":185964850,"node_id":"U_kgDOCxWZMg","avatar_url":"https://avatars.githubusercontent.com/u/185964850?v=4","gravatar_id":"","url":"https://api.github.com/users/bc-openai","html_url":"https://github.com/bc-openai","followers_url":"https://api.github.com/users/bc-openai/followers","following_url":"https://api.github.com/users/bc-openai/following{/other_user}","gists_url":"https://api.github.com/users/bc-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/bc-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bc-openai/subscriptions","organizations_url":"https://api.github.com/users/bc-openai/orgs","repos_url":"https://api.github.com/users/bc-openai/repos","events_url":"https://api.github.com/users/bc-openai/events{/privacy}","received_events_url":"https://api.github.com/users/bc-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"73abda8bfef6bd42eb11351be53980a027fd1feb","url":"https://api.github.com/repos/openai/codex/commits/73abda8bfef6bd42eb11351be53980a027fd1feb","html_url":"https://github.com/openai/codex/commit/73abda8bfef6bd42eb11351be53980a027fd1feb"}]},{"sha":"73abda8bfef6bd42eb11351be53980a027fd1feb","node_id":"C_kwDOOYsS4doAKDczYWJkYThiZmVmNmJkNDJlYjExMzUxYmU1Mzk4MGEwMjdmZDFmZWI","commit":{"author":{"name":"viyatb-oai","email":"viyatb@openai.com","date":"2026-08-16T03:09:15Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-16T03:14:17Z"},"message":"Isolate external editor buffers from sandbox-writable paths (#38830)\n\n## Why\n\nExternal editor buffers can contain the current composer text and should not be\nplaced in directories exposed as writable by a restricted filesystem policy.\n\n## What changed\n\n- Create editor buffer files under a protected `editor` directory, trying the\n  configured Codex home, the default Codex home, and a workspace fallback.\n- Reject candidates that overlap writable roots or resolve through symbolic\n  links, while preserving external editor support for full-disk-write policies.\n- Surface an editor error when no protected directory is available.\n\n## Testing\n\nAdd coverage for writable roots, aliases, symbolic links, fallback selection,\ntemporary-directory grants, full-disk-write policies, and editor invocation.\n\nGitOrigin-RevId: df1029d81b327678991ab84ffd1077f0e5855631","tree":{"sha":"76313e8c0ea2e40c71c789e187263c82782c814e","url":"https://api.github.com/repos/openai/codex/git/trees/76313e8c0ea2e40c71c789e187263c82782c814e"},"url":"https://api.github.com/repos/openai/codex/git/commits/73abda8bfef6bd42eb11351be53980a027fd1feb","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/73abda8bfef6bd42eb11351be53980a027fd1feb","html_url":"https://github.com/openai/codex/commit/73abda8bfef6bd42eb11351be53980a027fd1feb","comments_url":"https://api.github.com/repos/openai/codex/commits/73abda8bfef6bd42eb11351be53980a027fd1feb/comments","author":{"login":"viyatb-oai","id":234056686,"node_id":"U_kgDODfNr7g","avatar_url":"https://avatars.githubusercontent.com/u/234056686?v=4","gravatar_id":"","url":"https://api.github.com/users/viyatb-oai","html_url":"https://github.com/viyatb-oai","followers_url":"https://api.github.com/users/viyatb-oai/followers","following_url":"https://api.github.com/users/viyatb-oai/following{/other_user}","gists_url":"https://api.github.com/users/viyatb-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/viyatb-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/viyatb-oai/subscriptions","organizations_url":"https://api.github.com/users/viyatb-oai/orgs","repos_url":"https://api.github.com/users/viyatb-oai/repos","events_url":"https://api.github.com/users/viyatb-oai/events{/privacy}","received_events_url":"https://api.github.com/users/viyatb-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c7a95f84b389d64bce0cc6dbd2d893fd5a0577c3","url":"https://api.github.com/repos/openai/codex/commits/c7a95f84b389d64bce0cc6dbd2d893fd5a0577c3","html_url":"https://github.com/openai/codex/commit/c7a95f84b389d64bce0cc6dbd2d893fd5a0577c3"}]},{"sha":"c7a95f84b389d64bce0cc6dbd2d893fd5a0577c3","node_id":"C_kwDOOYsS4doAKGM3YTk1Zjg0YjM4OWQ2NGJjZTBjYzZkYmQyZDg5M2ZkNWEwNTc3YzM","commit":{"author":{"name":"chess","email":"chess@openai.com","date":"2026-08-16T02:30:32Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-16T02:35:50Z"},"message":"Add endpoint protection checks to `codex doctor` (#38827)\n\n## Why\n\nEndpoint protection products can interfere with Codex, but existing doctor reports do not identify them or explain which Codex exclusions need verification.\n\n## What changed\n\n- Detect supported endpoint protection products on macOS and Windows and add the results to the doctor environment report.\n- Warn when detected products have unverified Codex exclusions, with product-specific remediation for CrowdStrike Falcon, BeyondTrust Privilege Management, Microsoft Defender, SentinelOne, and Jamf Protect.\n- Distinguish complete, partial, and unavailable inspection results without requiring remediation when no product is detected.\n\n## Testing\n\n- Cover empty, unavailable, partial, single-product, and multi-product inspection results.\n- Verify the structured JSON contract and human-readable report output.\n\nGitOrigin-RevId: 684c69684ed73235d92d398f5294cc1b274278df","tree":{"sha":"fae11e2c5017de65cabd68ee035d2218bfc8a291","url":"https://api.github.com/repos/openai/codex/git/trees/fae11e2c5017de65cabd68ee035d2218bfc8a291"},"url":"https://api.github.com/repos/openai/codex/git/commits/c7a95f84b389d64bce0cc6dbd2d893fd5a0577c3","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c7a95f84b389d64bce0cc6dbd2d893fd5a0577c3","html_url":"https://github.com/openai/codex/commit/c7a95f84b389d64bce0cc6dbd2d893fd5a0577c3","comments_url":"https://api.github.com/repos/openai/codex/commits/c7a95f84b389d64bce0cc6dbd2d893fd5a0577c3/comments","author":{"login":"chess-oai","id":289791516,"node_id":"U_kgDOEUXeHA","avatar_url":"https://avatars.githubusercontent.com/u/289791516?v=4","gravatar_id":"","url":"https://api.github.com/users/chess-oai","html_url":"https://github.com/chess-oai","followers_url":"https://api.github.com/users/chess-oai/followers","following_url":"https://api.github.com/users/chess-oai/following{/other_user}","gists_url":"https://api.github.com/users/chess-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/chess-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chess-oai/subscriptions","organizations_url":"https://api.github.com/users/chess-oai/orgs","repos_url":"https://api.github.com/users/chess-oai/repos","events_url":"https://api.github.com/users/chess-oai/events{/privacy}","received_events_url":"https://api.github.com/users/chess-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"49db349ffdd888f5e3c91abf9b7519d8631e6e9a","url":"https://api.github.com/repos/openai/codex/commits/49db349ffdd888f5e3c91abf9b7519d8631e6e9a","html_url":"https://github.com/openai/codex/commit/49db349ffdd888f5e3c91abf9b7519d8631e6e9a"}]},{"sha":"49db349ffdd888f5e3c91abf9b7519d8631e6e9a","node_id":"C_kwDOOYsS4doAKDQ5ZGIzNDlmZmRkODg4ZjVlM2M5MWFiZjliNzUxOWQ4NjMxZTZlOWE","commit":{"author":{"name":"Benjamin Carlsson","email":"bc@openai.com","date":"2026-08-16T01:22:00Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-16T01:34:51Z"},"message":"Avoid allocating per character when decorating hyperlinks (#38823)\n\nEncode each character into a stack buffer before appending it to the\ndecorated span, avoiding a temporary `String` allocation for every character.\n\nGitOrigin-RevId: 72ec1ad5363391dffee089f04073d827d8c459bf","tree":{"sha":"35268951835a1dfcf75b826b724d10bf87d94da7","url":"https://api.github.com/repos/openai/codex/git/trees/35268951835a1dfcf75b826b724d10bf87d94da7"},"url":"https://api.github.com/repos/openai/codex/git/commits/49db349ffdd888f5e3c91abf9b7519d8631e6e9a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/49db349ffdd888f5e3c91abf9b7519d8631e6e9a","html_url":"https://github.com/openai/codex/commit/49db349ffdd888f5e3c91abf9b7519d8631e6e9a","comments_url":"https://api.github.com/repos/openai/codex/commits/49db349ffdd888f5e3c91abf9b7519d8631e6e9a/comments","author":{"login":"bc-openai","id":185964850,"node_id":"U_kgDOCxWZMg","avatar_url":"https://avatars.githubusercontent.com/u/185964850?v=4","gravatar_id":"","url":"https://api.github.com/users/bc-openai","html_url":"https://github.com/bc-openai","followers_url":"https://api.github.com/users/bc-openai/followers","following_url":"https://api.github.com/users/bc-openai/following{/other_user}","gists_url":"https://api.github.com/users/bc-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/bc-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bc-openai/subscriptions","organizations_url":"https://api.github.com/users/bc-openai/orgs","repos_url":"https://api.github.com/users/bc-openai/repos","events_url":"https://api.github.com/users/bc-openai/events{/privacy}","received_events_url":"https://api.github.com/users/bc-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"1ba9ce89101d2bd1efb981e0a94a61a955d42702","url":"https://api.github.com/repos/openai/codex/commits/1ba9ce89101d2bd1efb981e0a94a61a955d42702","html_url":"https://github.com/openai/codex/commit/1ba9ce89101d2bd1efb981e0a94a61a955d42702"}]},{"sha":"1ba9ce89101d2bd1efb981e0a94a61a955d42702","node_id":"C_kwDOOYsS4doAKDFiYTljZTg5MTAxZDJiZDFlZmI5ODFlMGE5NGE2MWE5NTVkNDI3MDI","commit":{"author":{"name":"Benjamin Carlsson","email":"bc@openai.com","date":"2026-08-16T01:21:25Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-16T01:31:22Z"},"message":"Avoid cloning TUI history span content (#38822)\n\nGitOrigin-RevId: f189b7afa5c585c4456a2f4ee795827ec4d79907","tree":{"sha":"958a9adfcc3f7361f7c6b52a9763dc16d41cda27","url":"https://api.github.com/repos/openai/codex/git/trees/958a9adfcc3f7361f7c6b52a9763dc16d41cda27"},"url":"https://api.github.com/repos/openai/codex/git/commits/1ba9ce89101d2bd1efb981e0a94a61a955d42702","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/1ba9ce89101d2bd1efb981e0a94a61a955d42702","html_url":"https://github.com/openai/codex/commit/1ba9ce89101d2bd1efb981e0a94a61a955d42702","comments_url":"https://api.github.com/repos/openai/codex/commits/1ba9ce89101d2bd1efb981e0a94a61a955d42702/comments","author":{"login":"bc-openai","id":185964850,"node_id":"U_kgDOCxWZMg","avatar_url":"https://avatars.githubusercontent.com/u/185964850?v=4","gravatar_id":"","url":"https://api.github.com/users/bc-openai","html_url":"https://github.com/bc-openai","followers_url":"https://api.github.com/users/bc-openai/followers","following_url":"https://api.github.com/users/bc-openai/following{/other_user}","gists_url":"https://api.github.com/users/bc-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/bc-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bc-openai/subscriptions","organizations_url":"https://api.github.com/users/bc-openai/orgs","repos_url":"https://api.github.com/users/bc-openai/repos","events_url":"https://api.github.com/users/bc-openai/events{/privacy}","received_events_url":"https://api.github.com/users/bc-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fcdae21073bac8613b3418047fc3e2a3e15cb6f0","url":"https://api.github.com/repos/openai/codex/commits/fcdae21073bac8613b3418047fc3e2a3e15cb6f0","html_url":"https://github.com/openai/codex/commit/fcdae21073bac8613b3418047fc3e2a3e15cb6f0"}]},{"sha":"fcdae21073bac8613b3418047fc3e2a3e15cb6f0","node_id":"C_kwDOOYsS4doAKGZjZGFlMjEwNzNiYWM4NjEzYjM0MTgwNDdmYzNlMmEzZTE1Y2I2ZjA","commit":{"author":{"name":"Anton Panasenko","email":"apanasenko@openai.com","date":"2026-08-16T00:52:36Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-16T00:57:28Z"},"message":"Support metadata staging for reserved thread IDs (#38819)\n\n## Why\n\nCallers need to associate host-owned state with a thread before Core starts it.\n\n## What changed\n\n- Add `ThreadManager::reserve_thread_id` and allow new threads to start with the reserved ID. Reject reserved IDs when resuming an existing thread.\n- Let thread stores stage metadata for a reserved ID. The local store merges staged values into the first successful metadata update and then removes them.\n- Clear staged metadata when an unmaterialized thread shuts down or is discarded, and require the state database for staging.\n\n## Testing\n\n- Cover reserved ID generation and resume validation.\n- Cover metadata persistence, merging, rollout-compatible updates, cleanup, and invalid staging requests.\n\nGitOrigin-RevId: 3f9bc48f0f7764011cc90ea01349e497dda0a9e3","tree":{"sha":"bae95599af0e698cdf9700c3c5ffa519d0ad36c6","url":"https://api.github.com/repos/openai/codex/git/trees/bae95599af0e698cdf9700c3c5ffa519d0ad36c6"},"url":"https://api.github.com/repos/openai/codex/git/commits/fcdae21073bac8613b3418047fc3e2a3e15cb6f0","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fcdae21073bac8613b3418047fc3e2a3e15cb6f0","html_url":"https://github.com/openai/codex/commit/fcdae21073bac8613b3418047fc3e2a3e15cb6f0","comments_url":"https://api.github.com/repos/openai/codex/commits/fcdae21073bac8613b3418047fc3e2a3e15cb6f0/comments","author":{"login":"apanasenko-oai","id":228802911,"node_id":"U_kgDODaNBXw","avatar_url":"https://avatars.githubusercontent.com/u/228802911?v=4","gravatar_id":"","url":"https://api.github.com/users/apanasenko-oai","html_url":"https://github.com/apanasenko-oai","followers_url":"https://api.github.com/users/apanasenko-oai/followers","following_url":"https://api.github.com/users/apanasenko-oai/following{/other_user}","gists_url":"https://api.github.com/users/apanasenko-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/apanasenko-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/apanasenko-oai/subscriptions","organizations_url":"https://api.github.com/users/apanasenko-oai/orgs","repos_url":"https://api.github.com/users/apanasenko-oai/repos","events_url":"https://api.github.com/users/apanasenko-oai/events{/privacy}","received_events_url":"https://api.github.com/users/apanasenko-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"5ba12929f8870400695292eb805af440c25ec5ae","url":"https://api.github.com/repos/openai/codex/commits/5ba12929f8870400695292eb805af440c25ec5ae","html_url":"https://github.com/openai/codex/commit/5ba12929f8870400695292eb805af440c25ec5ae"}]},{"sha":"5ba12929f8870400695292eb805af440c25ec5ae","node_id":"C_kwDOOYsS4doAKDViYTEyOTI5Zjg4NzA0MDA2OTUyOTJlYjgwNWFmNDQwYzI1ZWM1YWU","commit":{"author":{"name":"Dane Schneider","email":"daneschneider@openai.com","date":"2026-08-16T00:26:22Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-16T00:31:54Z"},"message":"Add raw config overrides to the TypeScript SDK (#38817)\n\n## Why\n\nSome TOML configuration, such as permission maps with literal path keys, cannot be represented safely through the SDK's structured dotted-key configuration.\n\n## What changed\n\n- Add `CodexOptions.configOverrides` for passing ordered `--config key=value` arguments to the Codex CLI unchanged.\n- Apply raw overrides after structured `config` values, while preserving precedence for SDK-managed and thread-specific settings.\n- Document raw permission-map configuration and cover literal keys, duplicate overrides, ordering, and resume behavior.\n\nGitOrigin-RevId: 3b0f5824ba8cb77d0eecb11ed6f32ead8fc674f6","tree":{"sha":"28697464d9d218e06f3d8e8931301451b1c0eada","url":"https://api.github.com/repos/openai/codex/git/trees/28697464d9d218e06f3d8e8931301451b1c0eada"},"url":"https://api.github.com/repos/openai/codex/git/commits/5ba12929f8870400695292eb805af440c25ec5ae","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/5ba12929f8870400695292eb805af440c25ec5ae","html_url":"https://github.com/openai/codex/commit/5ba12929f8870400695292eb805af440c25ec5ae","comments_url":"https://api.github.com/repos/openai/codex/commits/5ba12929f8870400695292eb805af440c25ec5ae/comments","author":{"login":"daneschneider-oai","id":269480009,"node_id":"U_kgDOEA_wSQ","avatar_url":"https://avatars.githubusercontent.com/u/269480009?v=4","gravatar_id":"","url":"https://api.github.com/users/daneschneider-oai","html_url":"https://github.com/daneschneider-oai","followers_url":"https://api.github.com/users/daneschneider-oai/followers","following_url":"https://api.github.com/users/daneschneider-oai/following{/other_user}","gists_url":"https://api.github.com/users/daneschneider-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/daneschneider-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/daneschneider-oai/subscriptions","organizations_url":"https://api.github.com/users/daneschneider-oai/orgs","repos_url":"https://api.github.com/users/daneschneider-oai/repos","events_url":"https://api.github.com/users/daneschneider-oai/events{/privacy}","received_events_url":"https://api.github.com/users/daneschneider-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"b3cc21737803549679e2009193c04205f7d8d19c","url":"https://api.github.com/repos/openai/codex/commits/b3cc21737803549679e2009193c04205f7d8d19c","html_url":"https://github.com/openai/codex/commit/b3cc21737803549679e2009193c04205f7d8d19c"}]},{"sha":"b3cc21737803549679e2009193c04205f7d8d19c","node_id":"C_kwDOOYsS4doAKGIzY2MyMTczNzgwMzU0OTY3OWUyMDA5MTkzYzA0MjA1ZjdkOGQxOWM","commit":{"author":{"name":"Channing Conger","email":"cconger@openai.com","date":"2026-08-15T21:21:48Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-15T21:26:28Z"},"message":"Add a health endpoint to the code-mode gRPC listener (#38806)\n\n## What changed\n\n- Serve `GET /healthz` with a `200 OK` response over HTTP/1.1 and HTTP/2.\n- Continue requiring HTTP/2 for all other requests so gRPC methods are not exposed over HTTP/1.1.\n\n## Testing\n\n- Add TCP listener integration coverage for HTTP/1.1 and HTTP/2 health checks and rejection of HTTP/1.1 gRPC requests.\n\nGitOrigin-RevId: ae7bbf56323fbc76769375a6d8e90653e8adc860","tree":{"sha":"b01a7876c485dba38a171d2e9eea4d7b80c5e2ed","url":"https://api.github.com/repos/openai/codex/git/trees/b01a7876c485dba38a171d2e9eea4d7b80c5e2ed"},"url":"https://api.github.com/repos/openai/codex/git/commits/b3cc21737803549679e2009193c04205f7d8d19c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/b3cc21737803549679e2009193c04205f7d8d19c","html_url":"https://github.com/openai/codex/commit/b3cc21737803549679e2009193c04205f7d8d19c","comments_url":"https://api.github.com/repos/openai/codex/commits/b3cc21737803549679e2009193c04205f7d8d19c/comments","author":{"login":"cconger","id":200563,"node_id":"MDQ6VXNlcjIwMDU2Mw==","avatar_url":"https://avatars.githubusercontent.com/u/200563?v=4","gravatar_id":"","url":"https://api.github.com/users/cconger","html_url":"https://github.com/cconger","followers_url":"https://api.github.com/users/cconger/followers","following_url":"https://api.github.com/users/cconger/following{/other_user}","gists_url":"https://api.github.com/users/cconger/gists{/gist_id}","starred_url":"https://api.github.com/users/cconger/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cconger/subscriptions","organizations_url":"https://api.github.com/users/cconger/orgs","repos_url":"https://api.github.com/users/cconger/repos","events_url":"https://api.github.com/users/cconger/events{/privacy}","received_events_url":"https://api.github.com/users/cconger/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"899d1715c87a504ce4c9ec85c2fd7753e33a7be4","url":"https://api.github.com/repos/openai/codex/commits/899d1715c87a504ce4c9ec85c2fd7753e33a7be4","html_url":"https://github.com/openai/codex/commit/899d1715c87a504ce4c9ec85c2fd7753e33a7be4"}]},{"sha":"899d1715c87a504ce4c9ec85c2fd7753e33a7be4","node_id":"C_kwDOOYsS4doAKDg5OWQxNzE1Yzg3YTUwNGNlNGM5ZWM4NWMyZmQ3NzUzZTMzYTdiZTQ","commit":{"author":{"name":"viyatb-oai","email":"viyatb@openai.com","date":"2026-08-15T19:29:39Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-15T19:34:50Z"},"message":"Route executor policy audits through log-only telemetry (#38800)\n\n## Why\n\nForwarded network policy decisions are audit telemetry and should not be\nwritten to the persistent state log.\n\n## What changed\n\n- Emit forwarded `codex.network_proxy.policy_decision` events on the\n  `codex_otel.log_only` target, keeping them available to OTEL log export while\n  excluding them from persistent logs.\n- Assert the log-only target in the existing trusted-metadata audit test.\n\nGitOrigin-RevId: 16d07c8f390245036e4fa092a876012ef2b2fdba","tree":{"sha":"a56ba3a1233716358dbd4409ab7fdef4578f9d4a","url":"https://api.github.com/repos/openai/codex/git/trees/a56ba3a1233716358dbd4409ab7fdef4578f9d4a"},"url":"https://api.github.com/repos/openai/codex/git/commits/899d1715c87a504ce4c9ec85c2fd7753e33a7be4","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/899d1715c87a504ce4c9ec85c2fd7753e33a7be4","html_url":"https://github.com/openai/codex/commit/899d1715c87a504ce4c9ec85c2fd7753e33a7be4","comments_url":"https://api.github.com/repos/openai/codex/commits/899d1715c87a504ce4c9ec85c2fd7753e33a7be4/comments","author":{"login":"viyatb-oai","id":234056686,"node_id":"U_kgDODfNr7g","avatar_url":"https://avatars.githubusercontent.com/u/234056686?v=4","gravatar_id":"","url":"https://api.github.com/users/viyatb-oai","html_url":"https://github.com/viyatb-oai","followers_url":"https://api.github.com/users/viyatb-oai/followers","following_url":"https://api.github.com/users/viyatb-oai/following{/other_user}","gists_url":"https://api.github.com/users/viyatb-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/viyatb-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/viyatb-oai/subscriptions","organizations_url":"https://api.github.com/users/viyatb-oai/orgs","repos_url":"https://api.github.com/users/viyatb-oai/repos","events_url":"https://api.github.com/users/viyatb-oai/events{/privacy}","received_events_url":"https://api.github.com/users/viyatb-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"6efcdad4c3c167741ac3791766152c15b03e3653","url":"https://api.github.com/repos/openai/codex/commits/6efcdad4c3c167741ac3791766152c15b03e3653","html_url":"https://github.com/openai/codex/commit/6efcdad4c3c167741ac3791766152c15b03e3653"}]},{"sha":"6efcdad4c3c167741ac3791766152c15b03e3653","node_id":"C_kwDOOYsS4doAKDZlZmNkYWQ0YzNjMTY3NzQxYWMzNzkxNzY2MTUyYzE1YjAzZTM2NTM","commit":{"author":{"name":"chess","email":"chess@openai.com","date":"2026-08-15T18:42:16Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-15T18:47:25Z"},"message":"Add storage diagnostics to `codex doctor` (#38795)\n\n## What changed\n\n- Report available space for `CODEX_HOME` and the active worktree, warning below 5 GiB and failing below 1 GiB.\n- On Windows, report whether the active Git worktree is on a trusted Dev Drive and provide remediation when it is not.\n- Run attached doctor reports against the conversation workspace, including workspaces recovered from persisted thread metadata, while keeping the subprocess anchored in `CODEX_HOME` so deleted workspaces do not prevent it from starting.\n\n## Testing\n\n- Cover disk thresholds, measurement failures, missing paths, conversation workspace selection, command construction, Windows volume detection, and human-readable output.\n\nGitOrigin-RevId: 0a99f9d278717e7d19936ffc504984b3a0958c25","tree":{"sha":"16ecc79a7026e0829e3830477409f721baac4f5d","url":"https://api.github.com/repos/openai/codex/git/trees/16ecc79a7026e0829e3830477409f721baac4f5d"},"url":"https://api.github.com/repos/openai/codex/git/commits/6efcdad4c3c167741ac3791766152c15b03e3653","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/6efcdad4c3c167741ac3791766152c15b03e3653","html_url":"https://github.com/openai/codex/commit/6efcdad4c3c167741ac3791766152c15b03e3653","comments_url":"https://api.github.com/repos/openai/codex/commits/6efcdad4c3c167741ac3791766152c15b03e3653/comments","author":{"login":"chess-oai","id":289791516,"node_id":"U_kgDOEUXeHA","avatar_url":"https://avatars.githubusercontent.com/u/289791516?v=4","gravatar_id":"","url":"https://api.github.com/users/chess-oai","html_url":"https://github.com/chess-oai","followers_url":"https://api.github.com/users/chess-oai/followers","following_url":"https://api.github.com/users/chess-oai/following{/other_user}","gists_url":"https://api.github.com/users/chess-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/chess-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chess-oai/subscriptions","organizations_url":"https://api.github.com/users/chess-oai/orgs","repos_url":"https://api.github.com/users/chess-oai/repos","events_url":"https://api.github.com/users/chess-oai/events{/privacy}","received_events_url":"https://api.github.com/users/chess-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a95a6fe333c276623ef172f9f7825ac2790be184","url":"https://api.github.com/repos/openai/codex/commits/a95a6fe333c276623ef172f9f7825ac2790be184","html_url":"https://github.com/openai/codex/commit/a95a6fe333c276623ef172f9f7825ac2790be184"}]},{"sha":"a95a6fe333c276623ef172f9f7825ac2790be184","node_id":"C_kwDOOYsS4doAKGE5NWE2ZmUzMzNjMjc2NjIzZWYxNzJmOWY3ODI1YWMyNzkwYmUxODQ","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-15T17:22:38Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-15T17:30:13Z"},"message":"Show resume and fork status during TUI startup (#38788)\n\n## What changed\n\n- Display a dimmed `Resuming session…` or `Forking session…` status above the provisional composer based on the requested session action.\n- Update or clear the status after session selection resolves, while preserving the composer height and any startup draft text.\n\n## Testing\n\n- Add snapshot coverage for resume and fork loading states and transitions back to a fresh session.\n\nGitOrigin-RevId: 9d37b2d0e390d28dee310dd7a5b9fa992db2c25c","tree":{"sha":"f613db726cc94e55563284b52eae6289b02c97b9","url":"https://api.github.com/repos/openai/codex/git/trees/f613db726cc94e55563284b52eae6289b02c97b9"},"url":"https://api.github.com/repos/openai/codex/git/commits/a95a6fe333c276623ef172f9f7825ac2790be184","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a95a6fe333c276623ef172f9f7825ac2790be184","html_url":"https://github.com/openai/codex/commit/a95a6fe333c276623ef172f9f7825ac2790be184","comments_url":"https://api.github.com/repos/openai/codex/commits/a95a6fe333c276623ef172f9f7825ac2790be184/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"00f6a8a60e5c5e93d185c7fe67fd596b7e62240f","url":"https://api.github.com/repos/openai/codex/commits/00f6a8a60e5c5e93d185c7fe67fd596b7e62240f","html_url":"https://github.com/openai/codex/commit/00f6a8a60e5c5e93d185c7fe67fd596b7e62240f"}]},{"sha":"00f6a8a60e5c5e93d185c7fe67fd596b7e62240f","node_id":"C_kwDOOYsS4doAKDAwZjZhOGE2MGU1YzVlOTNkMTg1YzdmZTY3ZmQ1OTZiN2U2MjI0MGY","commit":{"author":{"name":"joeflorencio-openai","email":"joeflorencio@openai.com","date":"2026-08-15T16:52:49Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-15T16:58:08Z"},"message":"Keep active-turn model settings stable across updates (#38785)\n\n## Why\n\nThread settings can change while a turn is still active, including between sampling requests. Those updates should apply to the next turn instead of changing the model configuration partway through the current turn.\n\n## What changed\n\n- Snapshot the model, reasoning settings, service tier, approval settings, and model-attributed telemetry in `StepContext`.\n- Build prompts, model requests, world state, tracing, and startup prewarms from that step-scoped snapshot.\n- Share immutable model metadata between turn and step contexts.\n\n## Testing\n\nAdded an integration test that pauses an active turn, updates its thread settings, and verifies that all requests in the active turn retain the original settings while the next turn uses the updates.\n\nGitOrigin-RevId: c51352218e463dcc9b7338566d16742292c49fbf","tree":{"sha":"40e822ba43cb22c27ea2c0b25d400f392a360500","url":"https://api.github.com/repos/openai/codex/git/trees/40e822ba43cb22c27ea2c0b25d400f392a360500"},"url":"https://api.github.com/repos/openai/codex/git/commits/00f6a8a60e5c5e93d185c7fe67fd596b7e62240f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/00f6a8a60e5c5e93d185c7fe67fd596b7e62240f","html_url":"https://github.com/openai/codex/commit/00f6a8a60e5c5e93d185c7fe67fd596b7e62240f","comments_url":"https://api.github.com/repos/openai/codex/commits/00f6a8a60e5c5e93d185c7fe67fd596b7e62240f/comments","author":{"login":"joeflorencio-openai","id":195963627,"node_id":"U_kgDOC64q6w","avatar_url":"https://avatars.githubusercontent.com/u/195963627?v=4","gravatar_id":"","url":"https://api.github.com/users/joeflorencio-openai","html_url":"https://github.com/joeflorencio-openai","followers_url":"https://api.github.com/users/joeflorencio-openai/followers","following_url":"https://api.github.com/users/joeflorencio-openai/following{/other_user}","gists_url":"https://api.github.com/users/joeflorencio-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/joeflorencio-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/joeflorencio-openai/subscriptions","organizations_url":"https://api.github.com/users/joeflorencio-openai/orgs","repos_url":"https://api.github.com/users/joeflorencio-openai/repos","events_url":"https://api.github.com/users/joeflorencio-openai/events{/privacy}","received_events_url":"https://api.github.com/users/joeflorencio-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c4941302c73c6322b153bba13ac0a9f4396301d6","url":"https://api.github.com/repos/openai/codex/commits/c4941302c73c6322b153bba13ac0a9f4396301d6","html_url":"https://github.com/openai/codex/commit/c4941302c73c6322b153bba13ac0a9f4396301d6"}]},{"sha":"c4941302c73c6322b153bba13ac0a9f4396301d6","node_id":"C_kwDOOYsS4doAKGM0OTQxMzAyYzczYzYzMjJiMTUzYmJhMTNhYzBhOWY0Mzk2MzAxZDY","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-15T15:19:27Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-15T15:24:30Z"},"message":"Use paginated history for persistent exec threads (#38774)\n\n## What changed\n\n- Request paginated history when `codex exec` starts a persistent thread.\n- Keep ephemeral threads unchanged and retry with legacy history when the configured thread store does not support pagination.\n- Exercise paginated resume and fork persistence, including resumed history and fork ancestry without copying the source transcript.\n\n## Testing\n\n- Extend unit coverage for persistent and ephemeral thread start parameters.\n- Add an integration test for the legacy-history fallback.\n\nGitOrigin-RevId: 610a2db14524b127551e75b7aef541d44368f28a","tree":{"sha":"d67ff5e31ff25a69d01b3cc67fedcdaae2ebfd20","url":"https://api.github.com/repos/openai/codex/git/trees/d67ff5e31ff25a69d01b3cc67fedcdaae2ebfd20"},"url":"https://api.github.com/repos/openai/codex/git/commits/c4941302c73c6322b153bba13ac0a9f4396301d6","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c4941302c73c6322b153bba13ac0a9f4396301d6","html_url":"https://github.com/openai/codex/commit/c4941302c73c6322b153bba13ac0a9f4396301d6","comments_url":"https://api.github.com/repos/openai/codex/commits/c4941302c73c6322b153bba13ac0a9f4396301d6/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"12933b69551394328319dcdd1bcee7907326dc85","url":"https://api.github.com/repos/openai/codex/commits/12933b69551394328319dcdd1bcee7907326dc85","html_url":"https://github.com/openai/codex/commit/12933b69551394328319dcdd1bcee7907326dc85"}]},{"sha":"12933b69551394328319dcdd1bcee7907326dc85","node_id":"C_kwDOOYsS4doAKDEyOTMzYjY5NTUxMzk0MzI4MzE5ZGNkZDFiY2VlNzkwNzMyNmRjODU","commit":{"author":{"name":"cooper-oai","email":"cooper@openai.com","date":"2026-08-15T14:25:48Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-15T14:31:04Z"},"message":"Forward workload identity context during token exchange (#38767)\n\n## What changed\n\n- Read optional workload identity context from `OPENAI_WORKLOAD_IDENTITY_CONTEXT` and forward it unchanged as the `workload_identity_context` token exchange field.\n- Treat the context as sensitive by redacting it from session configuration debug output and removing it from model-reachable child environments.\n- Include the context in workload identity session fingerprints so sessions with different values cannot share an exchange.\n\n## Testing\n\n- Cover request forwarding, debug redaction, session compatibility, and child-environment scrubbing.\n\nGitOrigin-RevId: fb50700478cf54d9d604944a4ed3e77acc928a0f","tree":{"sha":"7b7eb1d5dcf6401bf9d0eccd94cd23e6083ac670","url":"https://api.github.com/repos/openai/codex/git/trees/7b7eb1d5dcf6401bf9d0eccd94cd23e6083ac670"},"url":"https://api.github.com/repos/openai/codex/git/commits/12933b69551394328319dcdd1bcee7907326dc85","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/12933b69551394328319dcdd1bcee7907326dc85","html_url":"https://github.com/openai/codex/commit/12933b69551394328319dcdd1bcee7907326dc85","comments_url":"https://api.github.com/repos/openai/codex/commits/12933b69551394328319dcdd1bcee7907326dc85/comments","author":{"login":"cooper-oai","id":242064477,"node_id":"U_kgDODm2cXQ","avatar_url":"https://avatars.githubusercontent.com/u/242064477?v=4","gravatar_id":"","url":"https://api.github.com/users/cooper-oai","html_url":"https://github.com/cooper-oai","followers_url":"https://api.github.com/users/cooper-oai/followers","following_url":"https://api.github.com/users/cooper-oai/following{/other_user}","gists_url":"https://api.github.com/users/cooper-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/cooper-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cooper-oai/subscriptions","organizations_url":"https://api.github.com/users/cooper-oai/orgs","repos_url":"https://api.github.com/users/cooper-oai/repos","events_url":"https://api.github.com/users/cooper-oai/events{/privacy}","received_events_url":"https://api.github.com/users/cooper-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a7edf37cb46b5fc4d50bd03df8e5999a86f602eb","url":"https://api.github.com/repos/openai/codex/commits/a7edf37cb46b5fc4d50bd03df8e5999a86f602eb","html_url":"https://github.com/openai/codex/commit/a7edf37cb46b5fc4d50bd03df8e5999a86f602eb"}]},{"sha":"a7edf37cb46b5fc4d50bd03df8e5999a86f602eb","node_id":"C_kwDOOYsS4doAKGE3ZWRmMzdjYjQ2YjVmYzRkNTBiZDAzZGY4ZTU5OTlhODZmNjAyZWI","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-15T10:52:52Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-15T11:01:30Z"},"message":"Remove the TUI test dependency on `codex-cli` (#38746)\n\n## What changed\n\nRemove the unused `codex-cli` dev-dependency and the no-op import that kept it\nvisible to `cargo-shear`. TUI tests continue to locate spawned binaries through\n`codex-utils-cargo-bin`.\n\nGitOrigin-RevId: ba5855590c6f0300845170f15f39d77c0611a60a","tree":{"sha":"a7962dd7cac7bd0dfa0ebf27c59a409374a0e7fc","url":"https://api.github.com/repos/openai/codex/git/trees/a7962dd7cac7bd0dfa0ebf27c59a409374a0e7fc"},"url":"https://api.github.com/repos/openai/codex/git/commits/a7edf37cb46b5fc4d50bd03df8e5999a86f602eb","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a7edf37cb46b5fc4d50bd03df8e5999a86f602eb","html_url":"https://github.com/openai/codex/commit/a7edf37cb46b5fc4d50bd03df8e5999a86f602eb","comments_url":"https://api.github.com/repos/openai/codex/commits/a7edf37cb46b5fc4d50bd03df8e5999a86f602eb/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"3c7ae4a81204cbee45084b4fb43b3630c79550c9","url":"https://api.github.com/repos/openai/codex/commits/3c7ae4a81204cbee45084b4fb43b3630c79550c9","html_url":"https://github.com/openai/codex/commit/3c7ae4a81204cbee45084b4fb43b3630c79550c9"}]},{"sha":"3c7ae4a81204cbee45084b4fb43b3630c79550c9","node_id":"C_kwDOOYsS4doAKDNjN2FlNGE4MTIwNGNiZWU0NTA4NGI0ZmI0M2IzNjMwYzc5NTUwYzk","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-15T10:52:25Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-15T10:57:15Z"},"message":"Scope TUI app directory state to the active context (#38743)\n\n## Why\n\nApp directory data and in-flight requests can outlive the account, workspace, or thread that produced them, allowing stale apps to appear in the current TUI context.\n\n## What changed\n\n- Invalidate cached app data, dismiss the app picker, and start a fresh fetch when the account, workspace, or thread changes.\n- Tag app directory fetches with their originating thread, workspace, and scope generation, and ignore queued requests or results that no longer match.\n- Treat `AppListUpdated` notifications as revalidation signals instead of directly adopting their unscoped contents, with deduplication and a bounded error retry.\n\n## Testing\n\nAdded coverage for stale request and result rejection, context invalidation, picker dismissal, and notification revalidation.\n\nGitOrigin-RevId: f20930a0598a6abbdfb3c7826ec955346fe2da7a","tree":{"sha":"22a00494e9caeba46bb7e34bb2b0d690410cb229","url":"https://api.github.com/repos/openai/codex/git/trees/22a00494e9caeba46bb7e34bb2b0d690410cb229"},"url":"https://api.github.com/repos/openai/codex/git/commits/3c7ae4a81204cbee45084b4fb43b3630c79550c9","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/3c7ae4a81204cbee45084b4fb43b3630c79550c9","html_url":"https://github.com/openai/codex/commit/3c7ae4a81204cbee45084b4fb43b3630c79550c9","comments_url":"https://api.github.com/repos/openai/codex/commits/3c7ae4a81204cbee45084b4fb43b3630c79550c9/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"85fc4def358b7df21883e72ae8dda43a0f572f32","url":"https://api.github.com/repos/openai/codex/commits/85fc4def358b7df21883e72ae8dda43a0f572f32","html_url":"https://github.com/openai/codex/commit/85fc4def358b7df21883e72ae8dda43a0f572f32"}]},{"sha":"85fc4def358b7df21883e72ae8dda43a0f572f32","node_id":"C_kwDOOYsS4doAKDg1ZmM0ZGVmMzU4YjdkZjIxODgzZTcyYWU4ZGRhNDNhMGY1NzJmMzI","commit":{"author":{"name":"Abhinav","email":"abhinav@openai.com","date":"2026-08-15T05:47:18Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-15T05:53:54Z"},"message":"Add MCP tool handler support to the hooks engine (#38705)\n\n## What changed\n\n- Discover synchronous `mcp_tool` hook handlers and invoke their configured MCP server and tool through a supplied executor.\n- Expand nested hook-event placeholders in MCP tool inputs while preserving JSON types, and process tool output through the existing hook output contract.\n- Represent hook details as handler-specific metadata in `hooks/list`, including MCP server and tool fields, and show those details in the TUI hooks browser.\n- Skip unsupported `SessionEnd` MCP hooks and runtimes without MCP invocation support with startup warnings.\n\n## Testing\n\n- Cover argument expansion, missing placeholders, MCP invocation and hook decisions, discovery warnings, `hooks/list` metadata, and TUI rendering.\n\nGitOrigin-RevId: 295b845471fe92bd7ad7cd272fbcd2c3713912e0","tree":{"sha":"9bcd234517f1459962e77bda67f850e4a47e3af2","url":"https://api.github.com/repos/openai/codex/git/trees/9bcd234517f1459962e77bda67f850e4a47e3af2"},"url":"https://api.github.com/repos/openai/codex/git/commits/85fc4def358b7df21883e72ae8dda43a0f572f32","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/85fc4def358b7df21883e72ae8dda43a0f572f32","html_url":"https://github.com/openai/codex/commit/85fc4def358b7df21883e72ae8dda43a0f572f32","comments_url":"https://api.github.com/repos/openai/codex/commits/85fc4def358b7df21883e72ae8dda43a0f572f32/comments","author":{"login":"abhinav-oai","id":274334565,"node_id":"U_kgDOEFoDZQ","avatar_url":"https://avatars.githubusercontent.com/u/274334565?v=4","gravatar_id":"","url":"https://api.github.com/users/abhinav-oai","html_url":"https://github.com/abhinav-oai","followers_url":"https://api.github.com/users/abhinav-oai/followers","following_url":"https://api.github.com/users/abhinav-oai/following{/other_user}","gists_url":"https://api.github.com/users/abhinav-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/abhinav-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abhinav-oai/subscriptions","organizations_url":"https://api.github.com/users/abhinav-oai/orgs","repos_url":"https://api.github.com/users/abhinav-oai/repos","events_url":"https://api.github.com/users/abhinav-oai/events{/privacy}","received_events_url":"https://api.github.com/users/abhinav-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"3685a61dadefebb66690f8c0f945df044fc11b25","url":"https://api.github.com/repos/openai/codex/commits/3685a61dadefebb66690f8c0f945df044fc11b25","html_url":"https://github.com/openai/codex/commit/3685a61dadefebb66690f8c0f945df044fc11b25"}]},{"sha":"3685a61dadefebb66690f8c0f945df044fc11b25","node_id":"C_kwDOOYsS4doAKDM2ODVhNjFkYWRlZmViYjY2NjkwZjhjMGY5NDVkZjA0NGZjMTFiMjU","commit":{"author":{"name":"kevinlin-openai","email":"kevinlin@openai.com","date":"2026-08-15T05:38:37Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-15T05:43:44Z"},"message":"Normalize CRLF line endings in pasted text (#38704)\n\n## Why\n\nReplacing every carriage return with a line feed turns each CRLF pair into two\nline breaks when text is pasted into the TUI composer.\n\n## What changed\n\nNormalize CRLF pairs before converting remaining bare carriage returns, so each\npasted line ending becomes a single line feed while existing line feeds remain\nunchanged.\n\n## Testing\n\nAdd a regression test covering mixed CRLF, bare CR, and LF line endings.\n\nGitOrigin-RevId: 86c66d2a52fae52c9ae58c2f24a49eed685b60be","tree":{"sha":"114bc91aeda115edfb7bbfd05ef039436c501af8","url":"https://api.github.com/repos/openai/codex/git/trees/114bc91aeda115edfb7bbfd05ef039436c501af8"},"url":"https://api.github.com/repos/openai/codex/git/commits/3685a61dadefebb66690f8c0f945df044fc11b25","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/3685a61dadefebb66690f8c0f945df044fc11b25","html_url":"https://github.com/openai/codex/commit/3685a61dadefebb66690f8c0f945df044fc11b25","comments_url":"https://api.github.com/repos/openai/codex/commits/3685a61dadefebb66690f8c0f945df044fc11b25/comments","author":{"login":"kevinlin-openai","id":177054202,"node_id":"U_kgDOCo2h-g","avatar_url":"https://avatars.githubusercontent.com/u/177054202?v=4","gravatar_id":"","url":"https://api.github.com/users/kevinlin-openai","html_url":"https://github.com/kevinlin-openai","followers_url":"https://api.github.com/users/kevinlin-openai/followers","following_url":"https://api.github.com/users/kevinlin-openai/following{/other_user}","gists_url":"https://api.github.com/users/kevinlin-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/kevinlin-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kevinlin-openai/subscriptions","organizations_url":"https://api.github.com/users/kevinlin-openai/orgs","repos_url":"https://api.github.com/users/kevinlin-openai/repos","events_url":"https://api.github.com/users/kevinlin-openai/events{/privacy}","received_events_url":"https://api.github.com/users/kevinlin-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"e5470f1bce099442d73e491ce63d189d355b061e","url":"https://api.github.com/repos/openai/codex/commits/e5470f1bce099442d73e491ce63d189d355b061e","html_url":"https://github.com/openai/codex/commit/e5470f1bce099442d73e491ce63d189d355b061e"}]},{"sha":"e5470f1bce099442d73e491ce63d189d355b061e","node_id":"C_kwDOOYsS4doAKGU1NDcwZjFiY2UwOTk0NDJkNzNlNDkxY2U2M2QxODlkMzU1YjA2MWU","commit":{"author":{"name":"Abhinav","email":"abhinav@openai.com","date":"2026-08-15T05:19:21Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-15T05:28:53Z"},"message":"Refresh hook runtimes after plugin changes (#38703)\n\n## What changed\n\n- Rebuild hook runtimes for loaded sessions when effective plugins change or a marketplace upgrade installs new plugin content.\n- Refresh plugin-related caches and MCP runtimes alongside hooks after plugin mutations.\n- Preserve each loaded session's current configuration while rebuilding its hooks.\n\n## Testing\n\n- Cover direct plugin upgrades, including subsequent turn and session-end hooks.\n- Cover automatic marketplace upgrades for an already loaded session.\n\nGitOrigin-RevId: fef64c68d652f300c7f3d88e81c5017459aa9a18","tree":{"sha":"cbc55ab0991f7076e7f9dfaa53f28616af055d5c","url":"https://api.github.com/repos/openai/codex/git/trees/cbc55ab0991f7076e7f9dfaa53f28616af055d5c"},"url":"https://api.github.com/repos/openai/codex/git/commits/e5470f1bce099442d73e491ce63d189d355b061e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/e5470f1bce099442d73e491ce63d189d355b061e","html_url":"https://github.com/openai/codex/commit/e5470f1bce099442d73e491ce63d189d355b061e","comments_url":"https://api.github.com/repos/openai/codex/commits/e5470f1bce099442d73e491ce63d189d355b061e/comments","author":{"login":"abhinav-oai","id":274334565,"node_id":"U_kgDOEFoDZQ","avatar_url":"https://avatars.githubusercontent.com/u/274334565?v=4","gravatar_id":"","url":"https://api.github.com/users/abhinav-oai","html_url":"https://github.com/abhinav-oai","followers_url":"https://api.github.com/users/abhinav-oai/followers","following_url":"https://api.github.com/users/abhinav-oai/following{/other_user}","gists_url":"https://api.github.com/users/abhinav-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/abhinav-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abhinav-oai/subscriptions","organizations_url":"https://api.github.com/users/abhinav-oai/orgs","repos_url":"https://api.github.com/users/abhinav-oai/repos","events_url":"https://api.github.com/users/abhinav-oai/events{/privacy}","received_events_url":"https://api.github.com/users/abhinav-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"53f3fa749659498fa24c81da8fde5440fa7bba7f","url":"https://api.github.com/repos/openai/codex/commits/53f3fa749659498fa24c81da8fde5440fa7bba7f","html_url":"https://github.com/openai/codex/commit/53f3fa749659498fa24c81da8fde5440fa7bba7f"}]},{"sha":"53f3fa749659498fa24c81da8fde5440fa7bba7f","node_id":"C_kwDOOYsS4doAKDUzZjNmYTc0OTY1OTQ5OGZhMjRjODFkYThmZGU1NDQwZmE3YmJhN2Y","commit":{"author":{"name":"Dylan Hurd","email":"dylan.hurd@openai.com","date":"2026-08-15T05:04:11Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-15T05:09:19Z"},"message":"Route permission requests through shared Guardian approvals (#38701)\n\n## What changed\n\n- Represent `request_permissions` calls as shared approval actions and convert them into Guardian permission requests through the common approval path.\n- Preserve turn cancellation while an automatic permission review is pending.\n- Cover Guardian allow and deny decisions, cancellation without a user-approval fallback, and clean follow-up turns.\n\nGitOrigin-RevId: 95d0df0288e232f32b162756aa7d64a30df7efa5","tree":{"sha":"46e440ce16ec424e12b1a7073bc064b59e1aa180","url":"https://api.github.com/repos/openai/codex/git/trees/46e440ce16ec424e12b1a7073bc064b59e1aa180"},"url":"https://api.github.com/repos/openai/codex/git/commits/53f3fa749659498fa24c81da8fde5440fa7bba7f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/53f3fa749659498fa24c81da8fde5440fa7bba7f","html_url":"https://github.com/openai/codex/commit/53f3fa749659498fa24c81da8fde5440fa7bba7f","comments_url":"https://api.github.com/repos/openai/codex/commits/53f3fa749659498fa24c81da8fde5440fa7bba7f/comments","author":{"login":"dylan-hurd-oai","id":220976066,"node_id":"U_kgDODSvTwg","avatar_url":"https://avatars.githubusercontent.com/u/220976066?v=4","gravatar_id":"","url":"https://api.github.com/users/dylan-hurd-oai","html_url":"https://github.com/dylan-hurd-oai","followers_url":"https://api.github.com/users/dylan-hurd-oai/followers","following_url":"https://api.github.com/users/dylan-hurd-oai/following{/other_user}","gists_url":"https://api.github.com/users/dylan-hurd-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/dylan-hurd-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dylan-hurd-oai/subscriptions","organizations_url":"https://api.github.com/users/dylan-hurd-oai/orgs","repos_url":"https://api.github.com/users/dylan-hurd-oai/repos","events_url":"https://api.github.com/users/dylan-hurd-oai/events{/privacy}","received_events_url":"https://api.github.com/users/dylan-hurd-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4861236f06d0df397436531b4aa3d7fa6975959c","url":"https://api.github.com/repos/openai/codex/commits/4861236f06d0df397436531b4aa3d7fa6975959c","html_url":"https://github.com/openai/codex/commit/4861236f06d0df397436531b4aa3d7fa6975959c"}]},{"sha":"4861236f06d0df397436531b4aa3d7fa6975959c","node_id":"C_kwDOOYsS4doAKDQ4NjEyMzZmMDZkMGRmMzk3NDM2NTMxYjRhYTNkN2ZhNjk3NTk1OWM","commit":{"author":{"name":"Ben Romano","email":"bromano@openai.com","date":"2026-08-15T02:55:43Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-15T03:00:35Z"},"message":"Propagate request trace context through exec-server relays (#38690)\n\n## What changed\n\n- Add optional W3C `traceparent` and `tracestate` fields to relay frames.\n- Copy trace context from JSON-RPC requests onto relay data frames.\n- For encrypted requests split across multiple Noise records, attach the context only to the first record while keeping the request payload encrypted.\n\n## Testing\n\n- Cover trace propagation for both Noise relay paths, including fragmented encrypted requests.\n\nGitOrigin-RevId: a61bbbefef31e2e7e93a43f439c5f296700feb7b","tree":{"sha":"42b28770bd02326875263427e7daf8d701ebe59b","url":"https://api.github.com/repos/openai/codex/git/trees/42b28770bd02326875263427e7daf8d701ebe59b"},"url":"https://api.github.com/repos/openai/codex/git/commits/4861236f06d0df397436531b4aa3d7fa6975959c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4861236f06d0df397436531b4aa3d7fa6975959c","html_url":"https://github.com/openai/codex/commit/4861236f06d0df397436531b4aa3d7fa6975959c","comments_url":"https://api.github.com/repos/openai/codex/commits/4861236f06d0df397436531b4aa3d7fa6975959c/comments","author":{"login":"bromano-oai","id":238086823,"node_id":"U_kgDODjDqpw","avatar_url":"https://avatars.githubusercontent.com/u/238086823?v=4","gravatar_id":"","url":"https://api.github.com/users/bromano-oai","html_url":"https://github.com/bromano-oai","followers_url":"https://api.github.com/users/bromano-oai/followers","following_url":"https://api.github.com/users/bromano-oai/following{/other_user}","gists_url":"https://api.github.com/users/bromano-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/bromano-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bromano-oai/subscriptions","organizations_url":"https://api.github.com/users/bromano-oai/orgs","repos_url":"https://api.github.com/users/bromano-oai/repos","events_url":"https://api.github.com/users/bromano-oai/events{/privacy}","received_events_url":"https://api.github.com/users/bromano-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"2ca575026cef066a58c70f6bdee4feafa6e63d3a","url":"https://api.github.com/repos/openai/codex/commits/2ca575026cef066a58c70f6bdee4feafa6e63d3a","html_url":"https://github.com/openai/codex/commit/2ca575026cef066a58c70f6bdee4feafa6e63d3a"}]},{"sha":"2ca575026cef066a58c70f6bdee4feafa6e63d3a","node_id":"C_kwDOOYsS4doAKDJjYTU3NTAyNmNlZjA2NmE1OGM3MGY2YmRlZTRmZWFmYTZlNjNkM2E","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-08-15T01:31:03Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-15T01:39:04Z"},"message":"Support pending environment attachment configuration (#38684)\n\n## Why\n\nAn environment connection can be available before its owner has supplied the\nconfiguration for a particular thread attachment. Threads need to start without\nblocking while ensuring turns do not use that attachment prematurely.\n\n## What changed\n\n- Accept `Pending` environment configuration and resolve each attachment only\n  after both its shared executor connection and owner configuration are ready.\n- Add a `Failed` configuration state and `environment_failed` callback so an\n  owner can fail one thread's attachment without affecting other threads.\n- Keep pending and failed attachments out of capability-root inspection and turn\n  environments, and allow failed attachments to recover through a ready update.\n- Apply owner configuration before waking a waiting turn so its permission\n  profile, login-shell policy, capability roots, and tools are immediately\n  consistent.\n\n## Testing\n\nAdd an integration test covering non-blocking thread startup, independent ready\nand failed callbacks, waiting-turn resumption, installed capability and tool\nconfiguration, and recovery from failure.\n\nGitOrigin-RevId: d587e2025d584c867d782d470b18bf5a1a27b76c","tree":{"sha":"4ea1e9aa5fa582c99d353ecc4f8878ae3235f580","url":"https://api.github.com/repos/openai/codex/git/trees/4ea1e9aa5fa582c99d353ecc4f8878ae3235f580"},"url":"https://api.github.com/repos/openai/codex/git/commits/2ca575026cef066a58c70f6bdee4feafa6e63d3a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/2ca575026cef066a58c70f6bdee4feafa6e63d3a","html_url":"https://github.com/openai/codex/commit/2ca575026cef066a58c70f6bdee4feafa6e63d3a","comments_url":"https://api.github.com/repos/openai/codex/commits/2ca575026cef066a58c70f6bdee4feafa6e63d3a/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"eb147c0db364d1e642439f33e3078f8712ef9aa5","url":"https://api.github.com/repos/openai/codex/commits/eb147c0db364d1e642439f33e3078f8712ef9aa5","html_url":"https://github.com/openai/codex/commit/eb147c0db364d1e642439f33e3078f8712ef9aa5"}]},{"sha":"eb147c0db364d1e642439f33e3078f8712ef9aa5","node_id":"C_kwDOOYsS4doAKGViMTQ3YzBkYjM2NGQxZTY0MjQzOWYzM2UzMDc4Zjg3MTJlZjlhYTU","commit":{"author":{"name":"Francis Chalissery","email":"fc@openai.com","date":"2026-08-15T01:29:46Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-15T01:34:33Z"},"message":"Surface misalignment policy violations as typed errors (#38682)\n\n## What changed\n\n- Recognize `misalignment_policy_violation` errors from response streams and HTTP 400 or 403 responses.\n- Preserve the upstream message, use a fallback for blank messages, and treat the error as non-retryable.\n- Expose `misalignmentPolicyViolation` through the app-server protocol and generated schemas so turns fail with a typed terminal error.\n\n## Testing\n\n- Cover streamed and HTTP policy violations, fallback messages, retry behavior, and app-server turn completion.\n\nGitOrigin-RevId: fd3485bf0be7bfe3d51c078bbc36a081692fd57f","tree":{"sha":"cce1ab29800c78d25bb0dea11088d648eff96624","url":"https://api.github.com/repos/openai/codex/git/trees/cce1ab29800c78d25bb0dea11088d648eff96624"},"url":"https://api.github.com/repos/openai/codex/git/commits/eb147c0db364d1e642439f33e3078f8712ef9aa5","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/eb147c0db364d1e642439f33e3078f8712ef9aa5","html_url":"https://github.com/openai/codex/commit/eb147c0db364d1e642439f33e3078f8712ef9aa5","comments_url":"https://api.github.com/repos/openai/codex/commits/eb147c0db364d1e642439f33e3078f8712ef9aa5/comments","author":{"login":"fc-oai","id":269039706,"node_id":"U_kgDOEAk4Wg","avatar_url":"https://avatars.githubusercontent.com/u/269039706?v=4","gravatar_id":"","url":"https://api.github.com/users/fc-oai","html_url":"https://github.com/fc-oai","followers_url":"https://api.github.com/users/fc-oai/followers","following_url":"https://api.github.com/users/fc-oai/following{/other_user}","gists_url":"https://api.github.com/users/fc-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/fc-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fc-oai/subscriptions","organizations_url":"https://api.github.com/users/fc-oai/orgs","repos_url":"https://api.github.com/users/fc-oai/repos","events_url":"https://api.github.com/users/fc-oai/events{/privacy}","received_events_url":"https://api.github.com/users/fc-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4e9a1a907385fa04d0b6b30dc2afd152eba2de90","url":"https://api.github.com/repos/openai/codex/commits/4e9a1a907385fa04d0b6b30dc2afd152eba2de90","html_url":"https://github.com/openai/codex/commit/4e9a1a907385fa04d0b6b30dc2afd152eba2de90"}]},{"sha":"4e9a1a907385fa04d0b6b30dc2afd152eba2de90","node_id":"C_kwDOOYsS4doAKDRlOWExYTkwNzM4NWZhMDRkMGI2YjMwZGMyYWZkMTUyZWJhMmRlOTA","commit":{"author":{"name":"Dylan Hurd","email":"dylan.hurd@openai.com","date":"2026-08-15T01:19:37Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-15T01:24:46Z"},"message":"Preserve HTTP fallback for delegated sessions (#38681)\n\n## Why\n\nResponses WebSocket fallback is session-scoped. A delegated session created\nafter its parent switched to HTTP could otherwise make another WebSocket\nconnection attempt.\n\n## What changed\n\nDisable WebSocket support for a delegated session when the parent session has\nalready fallen back to HTTP.\n\n## Testing\n\nAdd a guardian review regression test that verifies only the parent's initial\nWebSocket attempt occurs and the guardian request uses the HTTP response path.\n\nGitOrigin-RevId: 1345f8fe739f55975aef432045348eae5a9278d6","tree":{"sha":"dcb1b1c0df6937d3e1b256af20f3d3bae98d66be","url":"https://api.github.com/repos/openai/codex/git/trees/dcb1b1c0df6937d3e1b256af20f3d3bae98d66be"},"url":"https://api.github.com/repos/openai/codex/git/commits/4e9a1a907385fa04d0b6b30dc2afd152eba2de90","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4e9a1a907385fa04d0b6b30dc2afd152eba2de90","html_url":"https://github.com/openai/codex/commit/4e9a1a907385fa04d0b6b30dc2afd152eba2de90","comments_url":"https://api.github.com/repos/openai/codex/commits/4e9a1a907385fa04d0b6b30dc2afd152eba2de90/comments","author":{"login":"dylan-hurd-oai","id":220976066,"node_id":"U_kgDODSvTwg","avatar_url":"https://avatars.githubusercontent.com/u/220976066?v=4","gravatar_id":"","url":"https://api.github.com/users/dylan-hurd-oai","html_url":"https://github.com/dylan-hurd-oai","followers_url":"https://api.github.com/users/dylan-hurd-oai/followers","following_url":"https://api.github.com/users/dylan-hurd-oai/following{/other_user}","gists_url":"https://api.github.com/users/dylan-hurd-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/dylan-hurd-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dylan-hurd-oai/subscriptions","organizations_url":"https://api.github.com/users/dylan-hurd-oai/orgs","repos_url":"https://api.github.com/users/dylan-hurd-oai/repos","events_url":"https://api.github.com/users/dylan-hurd-oai/events{/privacy}","received_events_url":"https://api.github.com/users/dylan-hurd-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"22bf16a37ed45006c0226541874abd7449c29911","url":"https://api.github.com/repos/openai/codex/commits/22bf16a37ed45006c0226541874abd7449c29911","html_url":"https://github.com/openai/codex/commit/22bf16a37ed45006c0226541874abd7449c29911"}]},{"sha":"22bf16a37ed45006c0226541874abd7449c29911","node_id":"C_kwDOOYsS4doAKDIyYmYxNmEzN2VkNDUwMDZjMDIyNjU0MTg3NGFiZDc0NDljMjk5MTE","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-08-15T00:38:21Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-15T00:43:44Z"},"message":"Preserve environment configuration ownership (#38678)\n\n## Why\n\nEnvironment attachments can either inherit configuration from their thread or\nprovide their own. Later thread setting updates must refresh inherited\nconfiguration without overwriting attachment-owned permissions and capability\nroots.\n\n## What changed\n\n- Resolve each attachment's configuration when it is selected and retain\n  whether it came from the thread or the attachment owner.\n- Apply subsequent thread configuration updates only to thread-owned\n  attachments, while preserving ownership across snapshots and child threads.\n- Keep the resolved configuration with the environment selection so runtime\n  consumers use a single canonical value.\n\n## Testing\n\n- Extend remote-environment coverage to verify that thread-owned permissions\n  follow thread updates while owner-provided read-only permissions remain in\n  effect.\n- Cover configuration inheritance, attachment replacement, and owner-configured\n  capability roots.\n\nGitOrigin-RevId: fe70c4be5f151432b69bf4b141e316faa89036ae","tree":{"sha":"8103910a0f21ee4cd551a54e6690c1131f0c796e","url":"https://api.github.com/repos/openai/codex/git/trees/8103910a0f21ee4cd551a54e6690c1131f0c796e"},"url":"https://api.github.com/repos/openai/codex/git/commits/22bf16a37ed45006c0226541874abd7449c29911","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/22bf16a37ed45006c0226541874abd7449c29911","html_url":"https://github.com/openai/codex/commit/22bf16a37ed45006c0226541874abd7449c29911","comments_url":"https://api.github.com/repos/openai/codex/commits/22bf16a37ed45006c0226541874abd7449c29911/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"233739e76ab6f63877df8abea720da14afb1825d","url":"https://api.github.com/repos/openai/codex/commits/233739e76ab6f63877df8abea720da14afb1825d","html_url":"https://github.com/openai/codex/commit/233739e76ab6f63877df8abea720da14afb1825d"}]},{"sha":"233739e76ab6f63877df8abea720da14afb1825d","node_id":"C_kwDOOYsS4doAKDIzMzczOWU3NmFiNmY2Mzg3N2RmOGFiZWE3MjBkYTE0YWZiMTgyNWQ","commit":{"author":{"name":"Darius Karel","email":"darius@openai.com","date":"2026-08-15T00:26:33Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-15T00:32:58Z"},"message":"Exclude shortcut-modified input from TUI paste bursts (#38675)\n\n## What changed\n\n- Treat plain, Shift-modified, and Windows AltGr character events as text-producing input for paste-burst detection.\n- Exclude Super, Hyper, and Meta character events from paste bursts, flushing any pending text before handling them as shortcuts.\n\n## Testing\n\n- Add coverage for plain and Shift-modified spaces, shortcut-modified spaces, pending burst flushes, and platform-specific AltGr input.\n\nGitOrigin-RevId: 3c43224966307fd014eb1586dce0c53ee56c75aa","tree":{"sha":"e62243314574cefe8063c453a2083e727e7adcfa","url":"https://api.github.com/repos/openai/codex/git/trees/e62243314574cefe8063c453a2083e727e7adcfa"},"url":"https://api.github.com/repos/openai/codex/git/commits/233739e76ab6f63877df8abea720da14afb1825d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/233739e76ab6f63877df8abea720da14afb1825d","html_url":"https://github.com/openai/codex/commit/233739e76ab6f63877df8abea720da14afb1825d","comments_url":"https://api.github.com/repos/openai/codex/commits/233739e76ab6f63877df8abea720da14afb1825d/comments","author":{"login":"darius-oai","id":248761034,"node_id":"U_kgDODtPKyg","avatar_url":"https://avatars.githubusercontent.com/u/248761034?v=4","gravatar_id":"","url":"https://api.github.com/users/darius-oai","html_url":"https://github.com/darius-oai","followers_url":"https://api.github.com/users/darius-oai/followers","following_url":"https://api.github.com/users/darius-oai/following{/other_user}","gists_url":"https://api.github.com/users/darius-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/darius-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/darius-oai/subscriptions","organizations_url":"https://api.github.com/users/darius-oai/orgs","repos_url":"https://api.github.com/users/darius-oai/repos","events_url":"https://api.github.com/users/darius-oai/events{/privacy}","received_events_url":"https://api.github.com/users/darius-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"1873e947f804074d99d9537a418b5e4ffde6901f","url":"https://api.github.com/repos/openai/codex/commits/1873e947f804074d99d9537a418b5e4ffde6901f","html_url":"https://github.com/openai/codex/commit/1873e947f804074d99d9537a418b5e4ffde6901f"}]},{"sha":"1873e947f804074d99d9537a418b5e4ffde6901f","node_id":"C_kwDOOYsS4doAKDE4NzNlOTQ3ZjgwNDA3NGQ5OWQ5NTM3YTQxOGI1ZTRmZmRlNjkwMWY","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-08-15T00:19:11Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-15T00:24:25Z"},"message":"Honor per-environment permission profiles (#38673)\n\n## What changed\n\n- Add a resolved `permission_profile` to each `EnvironmentConfig` and use the\n  complete attachment config for execution and capability-root selection.\n- Let `Ready` environment configurations override thread permissions while\n  `FromThread` selections continue to inherit them.\n- Restrict inherited Guardian environment profiles to read-only permissions.\n\n## Testing\n\n- Add coverage proving that a read-only environment blocks writes even when\n  the thread permits workspace writes.\n- Update environment inheritance, Guardian review, and capability-root tests\n  for the resolved attachment configuration.\n\nGitOrigin-RevId: 1a313b9e4892b1a579a0e880e322a782b4f6c0a7","tree":{"sha":"dbc73ca922bdb6c962fe5f61db85770d4a9f5746","url":"https://api.github.com/repos/openai/codex/git/trees/dbc73ca922bdb6c962fe5f61db85770d4a9f5746"},"url":"https://api.github.com/repos/openai/codex/git/commits/1873e947f804074d99d9537a418b5e4ffde6901f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/1873e947f804074d99d9537a418b5e4ffde6901f","html_url":"https://github.com/openai/codex/commit/1873e947f804074d99d9537a418b5e4ffde6901f","comments_url":"https://api.github.com/repos/openai/codex/commits/1873e947f804074d99d9537a418b5e4ffde6901f/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"15fde8c1f2d48812c1ad3b5d2fb7a1e7da4053fa","url":"https://api.github.com/repos/openai/codex/commits/15fde8c1f2d48812c1ad3b5d2fb7a1e7da4053fa","html_url":"https://github.com/openai/codex/commit/15fde8c1f2d48812c1ad3b5d2fb7a1e7da4053fa"}]},{"sha":"15fde8c1f2d48812c1ad3b5d2fb7a1e7da4053fa","node_id":"C_kwDOOYsS4doAKDE1ZmRlOGMxZjJkNDg4MTJjMWFkM2I1ZDJmYjdhMWU3ZGE0MDUzZmE","commit":{"author":{"name":"viyatb-oai","email":"viyatb@openai.com","date":"2026-08-14T23:36:23Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T23:42:40Z"},"message":"Forward executor network policy decisions for auditing (#38670)\n\n## What changed\n\n- Add a best-effort `network/policyDecision` notification for final domain and non-domain policy decisions made by executor-local proxies.\n- Validate notifications against the active process on the controller and emit audit events with controller-trusted session and execution metadata.\n- Reserve outbound RPC capacity so audit notifications cannot block control messages, and expose valid `chatgpt-account-id` header values for audit attribution.\n\n## Testing\n\n- Cover notification serialization, proxy decision capture, executor-to-controller delivery, trusted metadata handling, and reserved RPC capacity.\n\nGitOrigin-RevId: a39f96a6b3d9401c03d54eaef5b9a6d3fe0da78b","tree":{"sha":"6072d269139e113e7524521bd03fc90a7781d673","url":"https://api.github.com/repos/openai/codex/git/trees/6072d269139e113e7524521bd03fc90a7781d673"},"url":"https://api.github.com/repos/openai/codex/git/commits/15fde8c1f2d48812c1ad3b5d2fb7a1e7da4053fa","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/15fde8c1f2d48812c1ad3b5d2fb7a1e7da4053fa","html_url":"https://github.com/openai/codex/commit/15fde8c1f2d48812c1ad3b5d2fb7a1e7da4053fa","comments_url":"https://api.github.com/repos/openai/codex/commits/15fde8c1f2d48812c1ad3b5d2fb7a1e7da4053fa/comments","author":{"login":"viyatb-oai","id":234056686,"node_id":"U_kgDODfNr7g","avatar_url":"https://avatars.githubusercontent.com/u/234056686?v=4","gravatar_id":"","url":"https://api.github.com/users/viyatb-oai","html_url":"https://github.com/viyatb-oai","followers_url":"https://api.github.com/users/viyatb-oai/followers","following_url":"https://api.github.com/users/viyatb-oai/following{/other_user}","gists_url":"https://api.github.com/users/viyatb-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/viyatb-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/viyatb-oai/subscriptions","organizations_url":"https://api.github.com/users/viyatb-oai/orgs","repos_url":"https://api.github.com/users/viyatb-oai/repos","events_url":"https://api.github.com/users/viyatb-oai/events{/privacy}","received_events_url":"https://api.github.com/users/viyatb-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a186f5484dc8b89f103859a7c9bd632881fba54b","url":"https://api.github.com/repos/openai/codex/commits/a186f5484dc8b89f103859a7c9bd632881fba54b","html_url":"https://github.com/openai/codex/commit/a186f5484dc8b89f103859a7c9bd632881fba54b"}]},{"sha":"a186f5484dc8b89f103859a7c9bd632881fba54b","node_id":"C_kwDOOYsS4doAKGExODZmNTQ4NGRjOGI4OWYxMDM4NTlhN2M5YmQ2MzI4ODFmYmE1NGI","commit":{"author":{"name":"aphonpra-oai","email":"aphonpra@openai.com","date":"2026-08-14T22:35:16Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T22:40:19Z"},"message":"Resolve local JSON Schema refs in Code Mode types (#38664)\n\n## Why\n\nCode Mode rendered document-local `$ref` values as `unknown`, hiding referenced\ninput and structured-output shapes from generated TypeScript declarations.\n\n## What changed\n\n- Resolve fragment-only JSON Pointer references against the root schema,\n  including escaped and percent-encoded pointer segments.\n- Preserve `$ref` siblings as intersections and parenthesize unions used in\n  `allOf` intersections.\n- Bound recursive and repeated expansion, intermediate rendering work, and\n  final output size, falling back to `unknown` when a limit is reached or a\n  reference cannot be resolved safely.\n\n## Testing\n\nAdd unit coverage for recursive, escaped, nested-resource, dangling, and\noversized references, plus integration coverage for generated Code Mode tool\ndescriptions and MCP structured output types.\n\nGitOrigin-RevId: 95c6aa32e25325b5be9359dfac3b3328e5e7a499","tree":{"sha":"54bdf4309a602557f23953de68c0e8a3e188f5a1","url":"https://api.github.com/repos/openai/codex/git/trees/54bdf4309a602557f23953de68c0e8a3e188f5a1"},"url":"https://api.github.com/repos/openai/codex/git/commits/a186f5484dc8b89f103859a7c9bd632881fba54b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a186f5484dc8b89f103859a7c9bd632881fba54b","html_url":"https://github.com/openai/codex/commit/a186f5484dc8b89f103859a7c9bd632881fba54b","comments_url":"https://api.github.com/repos/openai/codex/commits/a186f5484dc8b89f103859a7c9bd632881fba54b/comments","author":{"login":"aphonpra-oai","id":288162820,"node_id":"U_kgDOES0EBA","avatar_url":"https://avatars.githubusercontent.com/u/288162820?v=4","gravatar_id":"","url":"https://api.github.com/users/aphonpra-oai","html_url":"https://github.com/aphonpra-oai","followers_url":"https://api.github.com/users/aphonpra-oai/followers","following_url":"https://api.github.com/users/aphonpra-oai/following{/other_user}","gists_url":"https://api.github.com/users/aphonpra-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/aphonpra-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aphonpra-oai/subscriptions","organizations_url":"https://api.github.com/users/aphonpra-oai/orgs","repos_url":"https://api.github.com/users/aphonpra-oai/repos","events_url":"https://api.github.com/users/aphonpra-oai/events{/privacy}","received_events_url":"https://api.github.com/users/aphonpra-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"274727d37fa69f113d28be4e0654deddcdef4318","url":"https://api.github.com/repos/openai/codex/commits/274727d37fa69f113d28be4e0654deddcdef4318","html_url":"https://github.com/openai/codex/commit/274727d37fa69f113d28be4e0654deddcdef4318"}]},{"sha":"274727d37fa69f113d28be4e0654deddcdef4318","node_id":"C_kwDOOYsS4doAKDI3NDcyN2QzN2ZhNjlmMTEzZDI4YmU0ZTA2NTRkZWRkY2RlZjQzMTg","commit":{"author":{"name":"kevinlin-openai","email":"kevinlin@openai.com","date":"2026-08-14T22:30:19Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T22:35:23Z"},"message":"Delete Thai combining marks one at a time in the composer (#38662)\n\n## Why\n\nBackspace should let users remove Thai vowel and tone marks without deleting the\nentire grapheme cluster.\n\n## What changed\n\n- Treat Thai nonspacing marks as individual backward-deletion boundaries.\n- Keep embedded text elements atomic and preserve the existing behavior for\n  other grapheme clusters, including decomposed Latin text and joined emoji.\n\n## Testing\n\nAdd coverage for successive deletion of Thai marks, cursor rendering after\ndeletion, unchanged non-Thai grapheme handling, and atomic Thai text elements.\n\nGitOrigin-RevId: f4834183909d93f4b4dd92f5d93e89235dc2b621","tree":{"sha":"efec66d1e14ca85aaced3177aff82cff7fa6df17","url":"https://api.github.com/repos/openai/codex/git/trees/efec66d1e14ca85aaced3177aff82cff7fa6df17"},"url":"https://api.github.com/repos/openai/codex/git/commits/274727d37fa69f113d28be4e0654deddcdef4318","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/274727d37fa69f113d28be4e0654deddcdef4318","html_url":"https://github.com/openai/codex/commit/274727d37fa69f113d28be4e0654deddcdef4318","comments_url":"https://api.github.com/repos/openai/codex/commits/274727d37fa69f113d28be4e0654deddcdef4318/comments","author":{"login":"kevinlin-openai","id":177054202,"node_id":"U_kgDOCo2h-g","avatar_url":"https://avatars.githubusercontent.com/u/177054202?v=4","gravatar_id":"","url":"https://api.github.com/users/kevinlin-openai","html_url":"https://github.com/kevinlin-openai","followers_url":"https://api.github.com/users/kevinlin-openai/followers","following_url":"https://api.github.com/users/kevinlin-openai/following{/other_user}","gists_url":"https://api.github.com/users/kevinlin-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/kevinlin-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kevinlin-openai/subscriptions","organizations_url":"https://api.github.com/users/kevinlin-openai/orgs","repos_url":"https://api.github.com/users/kevinlin-openai/repos","events_url":"https://api.github.com/users/kevinlin-openai/events{/privacy}","received_events_url":"https://api.github.com/users/kevinlin-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"848cbad7f458a442a3a84099650f13c5c68bd48f","url":"https://api.github.com/repos/openai/codex/commits/848cbad7f458a442a3a84099650f13c5c68bd48f","html_url":"https://github.com/openai/codex/commit/848cbad7f458a442a3a84099650f13c5c68bd48f"}]},{"sha":"848cbad7f458a442a3a84099650f13c5c68bd48f","node_id":"C_kwDOOYsS4doAKDg0OGNiYWQ3ZjQ1OGE0NDJhM2E4NDA5OTY1MGYxM2M1YzY4YmQ0OGY","commit":{"author":{"name":"johnl-oai","email":"johnl@openai.com","date":"2026-08-14T22:11:17Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T22:28:33Z"},"message":"Enforce managed deny-read rules in the Windows sandbox (#38660)\n\n## Why\n\nWindows sandbox requests must preserve managed filesystem deny rules across every execution path and setup refresh. Unsupported policies should fail closed instead of allowing a command to run without the requested protection.\n\n## What changed\n\n- Resolve Windows filesystem overrides while constructing each sandbox execution request so both `shell_command` and `exec_command` enforce exact-path and glob deny-read entries.\n- Carry resolved deny-read paths into Windows sandbox setup refreshes, including workspace-relative entries.\n- Reject unelevated restricted-token requests that cannot enforce deny-read rules.\n- Reject recursive globs rooted at a filesystem root unless `glob_scan_max_depth` bounds their expansion.\n\n## Testing\n\nAdded coverage for deny-read enforcement through both command runtimes, setup refresh resolution, restricted-token failure, and bounded root-level glob scans.\n\nGitOrigin-RevId: 33dfa4d1a45b14850cbf58f9173717e3e707d9bf","tree":{"sha":"6e05d7db3f1f7d1e149515b17e6f733bb5178e8d","url":"https://api.github.com/repos/openai/codex/git/trees/6e05d7db3f1f7d1e149515b17e6f733bb5178e8d"},"url":"https://api.github.com/repos/openai/codex/git/commits/848cbad7f458a442a3a84099650f13c5c68bd48f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/848cbad7f458a442a3a84099650f13c5c68bd48f","html_url":"https://github.com/openai/codex/commit/848cbad7f458a442a3a84099650f13c5c68bd48f","comments_url":"https://api.github.com/repos/openai/codex/commits/848cbad7f458a442a3a84099650f13c5c68bd48f/comments","author":{"login":"johnl-oai","id":256203048,"node_id":"U_kgDOD0VZKA","avatar_url":"https://avatars.githubusercontent.com/u/256203048?v=4","gravatar_id":"","url":"https://api.github.com/users/johnl-oai","html_url":"https://github.com/johnl-oai","followers_url":"https://api.github.com/users/johnl-oai/followers","following_url":"https://api.github.com/users/johnl-oai/following{/other_user}","gists_url":"https://api.github.com/users/johnl-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/johnl-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/johnl-oai/subscriptions","organizations_url":"https://api.github.com/users/johnl-oai/orgs","repos_url":"https://api.github.com/users/johnl-oai/repos","events_url":"https://api.github.com/users/johnl-oai/events{/privacy}","received_events_url":"https://api.github.com/users/johnl-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"5186e2ccc305ab54a2bb1239fda3656d8b4ab950","url":"https://api.github.com/repos/openai/codex/commits/5186e2ccc305ab54a2bb1239fda3656d8b4ab950","html_url":"https://github.com/openai/codex/commit/5186e2ccc305ab54a2bb1239fda3656d8b4ab950"}]},{"sha":"5186e2ccc305ab54a2bb1239fda3656d8b4ab950","node_id":"C_kwDOOYsS4doAKDUxODZlMmNjYzMwNWFiNTRhMmJiMTIzOWZkYTM2NTZkOGI0YWI5NTA","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-14T21:47:15Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T21:54:14Z"},"message":"Skip terminal hyperlink layout when no links are present (#38657)\n\n## What changed\n\nReturn early from `mark_buffer_hyperlinks` when none of the supplied lines\ncontain hyperlink metadata, avoiding unnecessary paragraph layout work.\n\nGitOrigin-RevId: bdd6727f3dab7cef87646f97ac955e848cfcfee2","tree":{"sha":"27804ee3cc6c54d1c06531d2662c570f3900cf20","url":"https://api.github.com/repos/openai/codex/git/trees/27804ee3cc6c54d1c06531d2662c570f3900cf20"},"url":"https://api.github.com/repos/openai/codex/git/commits/5186e2ccc305ab54a2bb1239fda3656d8b4ab950","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/5186e2ccc305ab54a2bb1239fda3656d8b4ab950","html_url":"https://github.com/openai/codex/commit/5186e2ccc305ab54a2bb1239fda3656d8b4ab950","comments_url":"https://api.github.com/repos/openai/codex/commits/5186e2ccc305ab54a2bb1239fda3656d8b4ab950/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c530bcd4cd46f2a26a839f7bb90c306a27c50d95","url":"https://api.github.com/repos/openai/codex/commits/c530bcd4cd46f2a26a839f7bb90c306a27c50d95","html_url":"https://github.com/openai/codex/commit/c530bcd4cd46f2a26a839f7bb90c306a27c50d95"}]},{"sha":"c530bcd4cd46f2a26a839f7bb90c306a27c50d95","node_id":"C_kwDOOYsS4doAKGM1MzBiY2Q0Y2Q0NmYyYTI2YTgzOWY3YmI5MGMzMDZhMjdjNTBkOTU","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-08-14T21:12:32Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T21:17:29Z"},"message":"Move permission profile snapshots into the protocol (#38651)\n\n## What changed\n\n- Define `PermissionProfileSnapshot` as a protocol model and re-export it from\n  `core-api`.\n- Store snapshots directly in core permission state while continuing to apply\n  constraints to their concrete `PermissionProfile`.\n- Preserve active profile identity and profile-declared workspace roots without\n  the core-only resolved profile variants.\n\nGitOrigin-RevId: cc5e03908e62054cde5de691faa47e471f2e1af5","tree":{"sha":"b87a3ea3d5062c24e6f4c9839bad69394d496652","url":"https://api.github.com/repos/openai/codex/git/trees/b87a3ea3d5062c24e6f4c9839bad69394d496652"},"url":"https://api.github.com/repos/openai/codex/git/commits/c530bcd4cd46f2a26a839f7bb90c306a27c50d95","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c530bcd4cd46f2a26a839f7bb90c306a27c50d95","html_url":"https://github.com/openai/codex/commit/c530bcd4cd46f2a26a839f7bb90c306a27c50d95","comments_url":"https://api.github.com/repos/openai/codex/commits/c530bcd4cd46f2a26a839f7bb90c306a27c50d95/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"ff6e7c77a3f4c6bfa39fd780e8fe02e3004f404b","url":"https://api.github.com/repos/openai/codex/commits/ff6e7c77a3f4c6bfa39fd780e8fe02e3004f404b","html_url":"https://github.com/openai/codex/commit/ff6e7c77a3f4c6bfa39fd780e8fe02e3004f404b"}]},{"sha":"ff6e7c77a3f4c6bfa39fd780e8fe02e3004f404b","node_id":"C_kwDOOYsS4doAKGZmNmU3Yzc3YTNmNGM2YmZhMzlmZDc4MGU4ZmUwMmUzMDA0ZjQwNGI","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-08-14T20:45:51Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T21:03:00Z"},"message":"Canonicalize default namespaces in gRPC subscription filters (#38650)\n\n## What changed\n\n- Normalize both tool invocations and subscription filters before matching them.\n- Treat missing and empty namespaces as aliases for the `functions` namespace while preserving the namespace reported with each invocation.\n\n## Testing\n\n- Add a gRPC service test covering missing, empty, and explicit default namespaces on both sides of a filtered subscription.\n\nGitOrigin-RevId: 409326f8ee6b3ab9a6ff5ceca0693558bc9c364d","tree":{"sha":"5c520ea570003812e6bf57269e2ef4a36a2b4cd4","url":"https://api.github.com/repos/openai/codex/git/trees/5c520ea570003812e6bf57269e2ef4a36a2b4cd4"},"url":"https://api.github.com/repos/openai/codex/git/commits/ff6e7c77a3f4c6bfa39fd780e8fe02e3004f404b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/ff6e7c77a3f4c6bfa39fd780e8fe02e3004f404b","html_url":"https://github.com/openai/codex/commit/ff6e7c77a3f4c6bfa39fd780e8fe02e3004f404b","comments_url":"https://api.github.com/repos/openai/codex/commits/ff6e7c77a3f4c6bfa39fd780e8fe02e3004f404b/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"aa1b81e46fa3e5325421fe833ac391043b704fb8","url":"https://api.github.com/repos/openai/codex/commits/aa1b81e46fa3e5325421fe833ac391043b704fb8","html_url":"https://github.com/openai/codex/commit/aa1b81e46fa3e5325421fe833ac391043b704fb8"}]},{"sha":"aa1b81e46fa3e5325421fe833ac391043b704fb8","node_id":"C_kwDOOYsS4doAKGFhMWI4MWU0NmZhM2U1MzI1NDIxZmU4MzNhYzM5MTA0M2I3MDRmYjg","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-14T20:37:41Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T20:59:34Z"},"message":"Reuse the TUI startup account response during bootstrap (#38649)\n\n## Why\n\nThe TUI reads the account to determine login status, then bootstrap reads the\nsame account again during startup.\n\n## What changed\n\n- Preserve the login-status account response and pass it to app-server\n  bootstrap, avoiding the second account request.\n- Discard the prefetched response when onboarding or a resume-directory prompt\n  allows authentication to change, when a picker replaces the app-server\n  session, or when the model provider changes.\n\n## Testing\n\n- Verify bootstrap reuses a prefetched account without issuing another account\n  request and retains its account metadata.\n- Verify normal bootstrap still reads the account when none was prefetched.\n- Verify matching resume directories skip the interactive prompt.\n\nGitOrigin-RevId: 8da1b9104b9e7f048c4254399b126116798d641a","tree":{"sha":"e664676f7718a5e22b723244817ec7c0a4fca2e4","url":"https://api.github.com/repos/openai/codex/git/trees/e664676f7718a5e22b723244817ec7c0a4fca2e4"},"url":"https://api.github.com/repos/openai/codex/git/commits/aa1b81e46fa3e5325421fe833ac391043b704fb8","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/aa1b81e46fa3e5325421fe833ac391043b704fb8","html_url":"https://github.com/openai/codex/commit/aa1b81e46fa3e5325421fe833ac391043b704fb8","comments_url":"https://api.github.com/repos/openai/codex/commits/aa1b81e46fa3e5325421fe833ac391043b704fb8/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"b8aa9e9a01e4ab11c15eb6ed935e1927ca64d243","url":"https://api.github.com/repos/openai/codex/commits/b8aa9e9a01e4ab11c15eb6ed935e1927ca64d243","html_url":"https://github.com/openai/codex/commit/b8aa9e9a01e4ab11c15eb6ed935e1927ca64d243"}]},{"sha":"b8aa9e9a01e4ab11c15eb6ed935e1927ca64d243","node_id":"C_kwDOOYsS4doAKGI4YWE5ZTlhMDFlNGFiMTFjMTVlYjZlZDkzNWUxOTI3Y2E2NGQyNDM","commit":{"author":{"name":"Michael Zeng","email":"miz@openai.com","date":"2026-08-14T20:32:59Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T20:53:22Z"},"message":"Add an override to skip project configuration (#38647)\n\n## What changed\n\n- Add `LoaderOverrides::ignore_project_config` to bypass project-root discovery and all project configuration layers.\n- Keep other configuration sources, including session overrides and cloud configuration, active when the override is set.\n\n## Testing\n\n- Add a config loader test that verifies project configuration is not loaded or parsed while session and cloud values remain effective.\n\nGitOrigin-RevId: b9aa44de526354fad6b900d6ae8d9b5fb8f700bb","tree":{"sha":"d4a99a703862112b2f0132ca8ecccd193faf463f","url":"https://api.github.com/repos/openai/codex/git/trees/d4a99a703862112b2f0132ca8ecccd193faf463f"},"url":"https://api.github.com/repos/openai/codex/git/commits/b8aa9e9a01e4ab11c15eb6ed935e1927ca64d243","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/b8aa9e9a01e4ab11c15eb6ed935e1927ca64d243","html_url":"https://github.com/openai/codex/commit/b8aa9e9a01e4ab11c15eb6ed935e1927ca64d243","comments_url":"https://api.github.com/repos/openai/codex/commits/b8aa9e9a01e4ab11c15eb6ed935e1927ca64d243/comments","author":{"login":"miz-openai","id":156837104,"node_id":"U_kgDOCVkk8A","avatar_url":"https://avatars.githubusercontent.com/u/156837104?v=4","gravatar_id":"","url":"https://api.github.com/users/miz-openai","html_url":"https://github.com/miz-openai","followers_url":"https://api.github.com/users/miz-openai/followers","following_url":"https://api.github.com/users/miz-openai/following{/other_user}","gists_url":"https://api.github.com/users/miz-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/miz-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/miz-openai/subscriptions","organizations_url":"https://api.github.com/users/miz-openai/orgs","repos_url":"https://api.github.com/users/miz-openai/repos","events_url":"https://api.github.com/users/miz-openai/events{/privacy}","received_events_url":"https://api.github.com/users/miz-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"cce33123a11449771504e9cbc4bf533f64721e1d","url":"https://api.github.com/repos/openai/codex/commits/cce33123a11449771504e9cbc4bf533f64721e1d","html_url":"https://github.com/openai/codex/commit/cce33123a11449771504e9cbc4bf533f64721e1d"}]},{"sha":"cce33123a11449771504e9cbc4bf533f64721e1d","node_id":"C_kwDOOYsS4doAKGNjZTMzMTIzYTExNDQ5NzcxNTA0ZTljYmM0YmY1MzNmNjQ3MjFlMWQ","commit":{"author":{"name":"Eric Burke","email":"163169620+eburke-openai@users.noreply.github.com","date":"2026-08-14T20:21:43Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T20:49:15Z"},"message":"Read Apple notarization issuer ID from Key Vault (#38646)\n\n## What changed\n\n- Load the Apple issuer ID from the notarization key's `apple-issuer-id`\n  tag alongside its key ID and pinned version.\n- Require the tag to contain a valid UUID before creating the notarization JWT.\n- Remove the separate `APPLE_NOTARIZATION_ISSUER_ID` environment variable and\n  release workflow secret wiring.\n\n## Testing\n\n- Cover valid, missing, empty, and malformed issuer ID tags in the macOS\n  notarization tests.\n\nGitOrigin-RevId: c42da96a36293cf39312d8238f958f6898247f19","tree":{"sha":"e855396149ce31212aed868b73495efbcd2b2175","url":"https://api.github.com/repos/openai/codex/git/trees/e855396149ce31212aed868b73495efbcd2b2175"},"url":"https://api.github.com/repos/openai/codex/git/commits/cce33123a11449771504e9cbc4bf533f64721e1d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/cce33123a11449771504e9cbc4bf533f64721e1d","html_url":"https://github.com/openai/codex/commit/cce33123a11449771504e9cbc4bf533f64721e1d","comments_url":"https://api.github.com/repos/openai/codex/commits/cce33123a11449771504e9cbc4bf533f64721e1d/comments","author":{"login":"eburke-openai","id":163169620,"node_id":"U_kgDOCbnFVA","avatar_url":"https://avatars.githubusercontent.com/u/163169620?v=4","gravatar_id":"","url":"https://api.github.com/users/eburke-openai","html_url":"https://github.com/eburke-openai","followers_url":"https://api.github.com/users/eburke-openai/followers","following_url":"https://api.github.com/users/eburke-openai/following{/other_user}","gists_url":"https://api.github.com/users/eburke-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/eburke-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/eburke-openai/subscriptions","organizations_url":"https://api.github.com/users/eburke-openai/orgs","repos_url":"https://api.github.com/users/eburke-openai/repos","events_url":"https://api.github.com/users/eburke-openai/events{/privacy}","received_events_url":"https://api.github.com/users/eburke-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fe556c4b6cbce64f508037f8ea2b9b071b0172bd","url":"https://api.github.com/repos/openai/codex/commits/fe556c4b6cbce64f508037f8ea2b9b071b0172bd","html_url":"https://github.com/openai/codex/commit/fe556c4b6cbce64f508037f8ea2b9b071b0172bd"}]},{"sha":"fe556c4b6cbce64f508037f8ea2b9b071b0172bd","node_id":"C_kwDOOYsS4doAKGZlNTU2YzRiNmNiY2U2NGY1MDgwMzdmOGVhMmI5YjA3MWIwMTcyYmQ","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-08-14T20:19:16Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T20:42:35Z"},"message":"Deliver gRPC code-mode notifications without truncation (#38645)\n\n## What changed\n\n- Forward notification text to the session delegate without applying the previous 1,024-byte limit or appending a truncation suffix.\n- Update the gRPC host integration test to verify that oversized multibyte notification text is delivered unchanged.\n\nGitOrigin-RevId: 9a9e24b359a07540f70ec4e98b28524db3f7a4a0","tree":{"sha":"63703a2d407e318776fe772f9854064f7f12f758","url":"https://api.github.com/repos/openai/codex/git/trees/63703a2d407e318776fe772f9854064f7f12f758"},"url":"https://api.github.com/repos/openai/codex/git/commits/fe556c4b6cbce64f508037f8ea2b9b071b0172bd","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fe556c4b6cbce64f508037f8ea2b9b071b0172bd","html_url":"https://github.com/openai/codex/commit/fe556c4b6cbce64f508037f8ea2b9b071b0172bd","comments_url":"https://api.github.com/repos/openai/codex/commits/fe556c4b6cbce64f508037f8ea2b9b071b0172bd/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"efa97f9bc6814d6549fca8997678a10ef0111a04","url":"https://api.github.com/repos/openai/codex/commits/efa97f9bc6814d6549fca8997678a10ef0111a04","html_url":"https://github.com/openai/codex/commit/efa97f9bc6814d6549fca8997678a10ef0111a04"}]},{"sha":"efa97f9bc6814d6549fca8997678a10ef0111a04","node_id":"C_kwDOOYsS4doAKGVmYTk3ZjliYzY4MTRkNjU0OWZjYTg5OTc2NzhhMTBlZjAxMTFhMDQ","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-14T20:08:49Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T20:38:52Z"},"message":"Show onboarding when Codex home lacks authentication state (#38644)\n\n## Why\n\nRoutine state such as history, logs, sessions, or temporary files does not mean\nthat the default account can authenticate. Treating any non-pristine Codex home\nas configured can show the composer before onboarding is complete.\n\n## What changed\n\n- Base the startup decision on authentication-relevant state instead of requiring\n  an empty Codex home. Existing credentials, configuration, workload identity,\n  managed configuration, or a running local daemon continue to keep the composer\n  visible.\n- Treat an unreadable or ambiguous home conservatively and keep the composer\n  visible.\n- Allow onboarding when the legacy `--search` flag is the only configuration\n  override.\n\n## Testing\n\nExpanded startup preflight and draft tests to cover existing home state,\ncredential sources, workload identity markers, daemon state, ambiguous paths,\nand search-only overrides.\n\nGitOrigin-RevId: 76837e3fd6aa714f2a7f72d191088a3faae23515","tree":{"sha":"4b2de782fae9704b0cdea6a489f5876182e4ab32","url":"https://api.github.com/repos/openai/codex/git/trees/4b2de782fae9704b0cdea6a489f5876182e4ab32"},"url":"https://api.github.com/repos/openai/codex/git/commits/efa97f9bc6814d6549fca8997678a10ef0111a04","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/efa97f9bc6814d6549fca8997678a10ef0111a04","html_url":"https://github.com/openai/codex/commit/efa97f9bc6814d6549fca8997678a10ef0111a04","comments_url":"https://api.github.com/repos/openai/codex/commits/efa97f9bc6814d6549fca8997678a10ef0111a04/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"6d97d4c10230ee5af00ce323af26a489228743ba","url":"https://api.github.com/repos/openai/codex/commits/6d97d4c10230ee5af00ce323af26a489228743ba","html_url":"https://github.com/openai/codex/commit/6d97d4c10230ee5af00ce323af26a489228743ba"}]},{"sha":"6d97d4c10230ee5af00ce323af26a489228743ba","node_id":"C_kwDOOYsS4doAKDZkOTdkNGMxMDIzMGVlNWFmMDBjZTMyM2FmMjZhNDg5MjI4NzQzYmE","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-14T20:08:49Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T20:35:11Z"},"message":"Delay the startup composer until first-login onboarding (#38643)\n\n## Why\n\nOn a pristine default installation, the provisional composer can appear before\nfirst-login onboarding takes over the terminal.\n\n## What changed\n\n- Detect pristine local installations conservatively, accounting for existing\n  Codex state, custom homes, access tokens, system configuration, and managed\n  configuration sources, including macOS managed preferences.\n- Keep the composer hidden and ignore draft input until onboarding completes,\n  while still allowing startup cancellation with `Ctrl-C` or `Ctrl-D`.\n- Reveal the configured composer after onboarding for normal new-session\n  launches; resume and fork pickers retain their existing startup flow.\n\n## Testing\n\n- Cover pristine and existing home layouts, environment credentials, system and\n  managed configuration, inaccessible state, onboarding input suppression,\n  cancellation, and the transition to the composer.\n\nGitOrigin-RevId: c1a47ea3ba7c1ff1dd229895c0362b6dd9bfd713","tree":{"sha":"31a15bd4bd96e627efe7ca638ff42d3cee86ae31","url":"https://api.github.com/repos/openai/codex/git/trees/31a15bd4bd96e627efe7ca638ff42d3cee86ae31"},"url":"https://api.github.com/repos/openai/codex/git/commits/6d97d4c10230ee5af00ce323af26a489228743ba","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/6d97d4c10230ee5af00ce323af26a489228743ba","html_url":"https://github.com/openai/codex/commit/6d97d4c10230ee5af00ce323af26a489228743ba","comments_url":"https://api.github.com/repos/openai/codex/commits/6d97d4c10230ee5af00ce323af26a489228743ba/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a0bed4be2112683b3001ba2c0dd16326ab83c1ba","url":"https://api.github.com/repos/openai/codex/commits/a0bed4be2112683b3001ba2c0dd16326ab83c1ba","html_url":"https://github.com/openai/codex/commit/a0bed4be2112683b3001ba2c0dd16326ab83c1ba"}]},{"sha":"a0bed4be2112683b3001ba2c0dd16326ab83c1ba","node_id":"C_kwDOOYsS4doAKGEwYmVkNGJlMjExMjY4M2IzMDAxYmEyYzBkZDE2MzI2YWI4M2MxYmE","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-14T20:08:49Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T20:30:30Z"},"message":"Keep the composer editable during TUI startup (#38642)\n\n## Why\n\nConfiguration and app-server initialization can take time before the main TUI is ready, leaving users unable to begin drafting a prompt.\n\n## What changed\n\n- Show a provisional composer while startup work runs and carry its text, cursor position, paste state, and attachments into the initialized chat.\n- Limit the provisional composer to safe editing and cancellation, and quarantine input around session pickers, approvals, and other actionable startup screens.\n- Preserve configuration validation before terminal checks and recover terminal state cleanly from startup failures and caught panics.\n\n## Testing\n\n- Cover startup editing, multiline and large pastes, keymaps, cancellation, session-picker handoff, approval boundaries, and draft restoration.\n- Verify non-interactive launches report configuration errors before terminal errors.\n\nGitOrigin-RevId: fe04a85cfbbcff21ff87fa81fd17474827858575","tree":{"sha":"a8d3c651663ea73dc0d1fcd29712bbe2e8366755","url":"https://api.github.com/repos/openai/codex/git/trees/a8d3c651663ea73dc0d1fcd29712bbe2e8366755"},"url":"https://api.github.com/repos/openai/codex/git/commits/a0bed4be2112683b3001ba2c0dd16326ab83c1ba","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a0bed4be2112683b3001ba2c0dd16326ab83c1ba","html_url":"https://github.com/openai/codex/commit/a0bed4be2112683b3001ba2c0dd16326ab83c1ba","comments_url":"https://api.github.com/repos/openai/codex/commits/a0bed4be2112683b3001ba2c0dd16326ab83c1ba/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"58d2daba45dd6d37b8c151ca0c57a54a5b8ce297","url":"https://api.github.com/repos/openai/codex/commits/58d2daba45dd6d37b8c151ca0c57a54a5b8ce297","html_url":"https://github.com/openai/codex/commit/58d2daba45dd6d37b8c151ca0c57a54a5b8ce297"}]},{"sha":"58d2daba45dd6d37b8c151ca0c57a54a5b8ce297","node_id":"C_kwDOOYsS4doAKDU4ZDJkYWJhNDVkZDZkMzdiOGMxNTFjYTBjNTdhNTRhNWI4Y2UyOTc","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-14T20:08:48Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T20:23:49Z"},"message":"Harden TUI startup input handling (#38641)\n\n## Why\n\nTerminal probes and other bootstrap work can leave keys or partial control\nsequences buffered before an interactive startup screen is visible. Those\ninputs must not accidentally select or confirm an action, while typeahead\nintended for the composer should survive terminal initialization.\n\n## What changed\n\n- Replay user input consumed by Unix startup probes through Crossterm while\n  filtering completed terminal color replies, and avoid consuming the Windows\n  console input queue when detecting default colors.\n- Drain decoded and unread input after rendering actionable startup screens,\n  including onboarding trust, migration, update, provider, resume, and hooks\n  prompts. Keep incomplete control sequences quarantined and fail closed when\n  an input boundary cannot be resolved.\n- Restore terminal modes if initialization exits early and bound terminal probe\n  reads by time and byte limits.\n\n## Testing\n\nAdd parser, boundary, onboarding, and PTY coverage for preserved typeahead,\nsplit escape sequences, bracketed paste, delayed input, and fresh input after\nan interactive screen becomes ready.\n\nGitOrigin-RevId: 321198996cdd88fe9b43c4a762e750bff450482c","tree":{"sha":"14dffe78b4df59cda1f07aaa6121b299805eb22b","url":"https://api.github.com/repos/openai/codex/git/trees/14dffe78b4df59cda1f07aaa6121b299805eb22b"},"url":"https://api.github.com/repos/openai/codex/git/commits/58d2daba45dd6d37b8c151ca0c57a54a5b8ce297","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/58d2daba45dd6d37b8c151ca0c57a54a5b8ce297","html_url":"https://github.com/openai/codex/commit/58d2daba45dd6d37b8c151ca0c57a54a5b8ce297","comments_url":"https://api.github.com/repos/openai/codex/commits/58d2daba45dd6d37b8c151ca0c57a54a5b8ce297/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"7e65e4f3303881ee8b042128996f159fa5b3f128","url":"https://api.github.com/repos/openai/codex/commits/7e65e4f3303881ee8b042128996f159fa5b3f128","html_url":"https://github.com/openai/codex/commit/7e65e4f3303881ee8b042128996f159fa5b3f128"}]},{"sha":"7e65e4f3303881ee8b042128996f159fa5b3f128","node_id":"C_kwDOOYsS4doAKDdlNjVlNGYzMzAzODgxZWU4YjA0MjEyODk5NmYxNTlmYTViM2YxMjg","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-14T20:08:48Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T20:19:42Z"},"message":"Render the initial TUI session header before input (#38639)\n\n## What changed\n\n- Drain queued app events until the initial session header is installed before\n  handling terminal input.\n- Render the active session header without a leading separator so it starts at\n  the top of the viewport.\n\n## Testing\n\n- Add a rendering snapshot that verifies the initial header begins on the first\n  viewport row.\n\nGitOrigin-RevId: 070417776b629c681b3f94e93ba619dfefe764b1","tree":{"sha":"561485b796c1c7f41d67d0d6752a795b04ccdd9e","url":"https://api.github.com/repos/openai/codex/git/trees/561485b796c1c7f41d67d0d6752a795b04ccdd9e"},"url":"https://api.github.com/repos/openai/codex/git/commits/7e65e4f3303881ee8b042128996f159fa5b3f128","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/7e65e4f3303881ee8b042128996f159fa5b3f128","html_url":"https://github.com/openai/codex/commit/7e65e4f3303881ee8b042128996f159fa5b3f128","comments_url":"https://api.github.com/repos/openai/codex/commits/7e65e4f3303881ee8b042128996f159fa5b3f128/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"ccee70f81379374028265be41f95f15d9d254ce9","url":"https://api.github.com/repos/openai/codex/commits/ccee70f81379374028265be41f95f15d9d254ce9","html_url":"https://github.com/openai/codex/commit/ccee70f81379374028265be41f95f15d9d254ce9"}]}]