t-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"3e51b46eba036364a735f450c2bb4d7c35d48d2b","url":"https://api.github.com/repos/openai/codex/commits/3e51b46eba036364a735f450c2bb4d7c35d48d2b","html_url":"https://github.com/openai/codex/commit/3e51b46eba036364a735f450c2bb4d7c35d48d2b"}]},{"sha":"3e51b46eba036364a735f450c2bb4d7c35d48d2b","node_id":"C_kwDOOYsS4doAKDNlNTFiNDZlYmEwMzYzNjRhNzM1ZjQ1MGMyYmI0ZDdjMzVkNDhkMmI","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-06-25T02:26:55Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-25T02:26:55Z"},"message":"[1/3] core: make world state snapshots serializable (#29833)\n\n## Why\n\n`WorldState` currently keeps its diff baseline as live Rust objects\nkeyed by process-local `TypeId`. That baseline cannot be written to a\nrollout or restored after resume, so Codex reconstructs an approximation\nfrom `TurnContextItem`.\n\nThis is the first change in the WorldState persistence stack. It gives\nevery section a stable persisted identity and a compact serializable\ncomparison snapshot without changing rollout behavior yet.\n\n## What changed\n\n- Require each `WorldStateSection` to define a stable ID and\nserializable snapshot type.\n- Reject duplicate section IDs when constructing `WorldState`.\n- Persist a dedicated environment comparison snapshot using\nmodel-visible strings instead of runtime path types.\n- Store only `WorldStateSnapshot` in `ContextManager`, removing the\nparallel live-object baseline.\n- Render diffs by restoring each section's typed snapshot; invalid\nsnapshots fall back to a full section render.\n- Omit null object fields for future RFC 7386 patches while preserving\nnull values inside arrays.\n\nFollow-up PRs will record full snapshots and merge patches, then restore\nthe baseline during resume, fork, and rollback.\n\n## Test plan\n\n- WorldState snapshot tests cover stable IDs, duplicate rejection, null\nomission, and array preservation.\n- Environment tests cover persistence-safe snapshot values and existing\ndiff rendering.\n- ContextManager baseline deduplication and session context-update\npersistence tests.\n\nRelated: #29249","tree":{"sha":"3d857fa612fafa5b238dd4b2019b1f4b30a4198c","url":"https://api.github.com/repos/openai/codex/git/trees/3d857fa612fafa5b238dd4b2019b1f4b30a4198c"},"url":"https://api.github.com/repos/openai/codex/git/commits/3e51b46eba036364a735f450c2bb4d7c35d48d2b","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPJHvCRC1aQ7uu5UhlAAAP90QAAxvMeS/7dtahchL1VtrgO0v\nmbT2x6RdK0LCyd3aVWehzxgTTzDqJU6F092noJ2ObG/M2IeEbGVwej0UyP9ugPx2\ncdMMbk8n5qsW+herHxMoePycHbuUczsCz6GZySXXNkpI9drGtn92lbdSZdfgUowF\nVV3riHQtzVEV2gDPPTa1Xa+1kS2+59veAyKIKEiiqTH3LP7z5lZFu9+erPvOQnIF\nUkK1Ot/3iahBYEbARs2UEq/YgUgjmgBRaPQs1Es1m0eoHMk5dZstbgI9zI+PK4o3\npy93qFfAWwkQfm4BwYr36ExbuJWXL33tgVwaJfOf6IJAAR/mNWF6ouQ12Wy3Y9IL\nWZKqrZpZoiqDQgGEBwTFpqdVYfyNxaJ9OPiwCOj82E9K/6R+WQ47Pzeol0aGTDlv\nPwfbv8TXh2usgBLXMcvXtt/CyTn7KpJ10RY4YAJTvfSWY84RSCOmHmrXAmFbLCEY\n44gyqgkAdvyrJFqGvABHnGZOuWGFyVEjjRN/KsMidkztJnR5S4gCWGSNATLivrcu\nqbasFVvIj7fy/9PhQJtCRTyQvoIDo1+Ino+Ezh+A4so4qc6b9mywBiBoDbqy0k71\nZkKe21raHskTvSckpxndVpczSMIyp6z0Qo2KcBGUn3d6oyKGg2dlI+AVi9wC7/8I\n3lteol871dOE0hFxC/bZ\n=FuJE\n-----END PGP SIGNATURE-----\n","payload":"tree 3d857fa612fafa5b238dd4b2019b1f4b30a4198c\nparent 4c0706e24a290f89c40d99b92912367c63fe273d\nauthor sayan-oai <sayan@openai.com> 1782354415 -0700\ncommitter GitHub <noreply@github.com> 1782354415 -0700\n\n[1/3] core: make world state snapshots serializable (#29833)\n\n## Why\n\n`WorldState` currently keeps its diff baseline as live Rust objects\nkeyed by process-local `TypeId`. That baseline cannot be written to a\nrollout or restored after resume, so Codex reconstructs an approximation\nfrom `TurnContextItem`.\n\nThis is the first change in the WorldState persistence stack. It gives\nevery section a stable persisted identity and a compact serializable\ncomparison snapshot without changing rollout behavior yet.\n\n## What changed\n\n- Require each `WorldStateSection` to define a stable ID and\nserializable snapshot type.\n- Reject duplicate section IDs when constructing `WorldState`.\n- Persist a dedicated environment comparison snapshot using\nmodel-visible strings instead of runtime path types.\n- Store only `WorldStateSnapshot` in `ContextManager`, removing the\nparallel live-object baseline.\n- Render diffs by restoring each section's typed snapshot; invalid\nsnapshots fall back to a full section render.\n- Omit null object fields for future RFC 7386 patches while preserving\nnull values inside arrays.\n\nFollow-up PRs will record full snapshots and merge patches, then restore\nthe baseline during resume, fork, and rollback.\n\n## Test plan\n\n- WorldState snapshot tests cover stable IDs, duplicate rejection, null\nomission, and array preservation.\n- Environment tests cover persistence-safe snapshot values and existing\ndiff rendering.\n- ContextManager baseline deduplication and session context-update\npersistence tests.\n\nRelated: #29249","verified_at":"2026-06-25T02:26:55Z"}},"url":"https://api.github.com/repos/openai/codex/commits/3e51b46eba036364a735f450c2bb4d7c35d48d2b","html_url":"https://github.com/openai/codex/commit/3e51b46eba036364a735f450c2bb4d7c35d48d2b","comments_url":"https://api.github.com/repos/openai/codex/commits/3e51b46eba036364a735f450c2bb4d7c35d48d2b/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"4c0706e24a290f89c40d99b92912367c63fe273d","url":"https://api.github.com/repos/openai/codex/commits/4c0706e24a290f89c40d99b92912367c63fe273d","html_url":"https://github.com/openai/codex/commit/4c0706e24a290f89c40d99b92912367c63fe273d"}]},{"sha":"4c0706e24a290f89c40d99b92912367c63fe273d","node_id":"C_kwDOOYsS4doAKDRjMDcwNmUyNGEyOTBmODljNDBkOTliOTI5MTIzNjdjNjNmZTI3M2Q","commit":{"author":{"name":"Ahmed Ibrahim","email":"aibrahim@openai.com","date":"2026-06-25T02:21:28Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-25T02:21:28Z"},"message":"Allow ChatGPT-hosted MCP servers to use session auth (#29733)\n\n## Why\n\nChatGPT session authentication was inferred from the reserved Codex Apps\nserver name. That couples credential routing to Codex Apps-specific\nbehavior and prevents other MCP endpoints hosted by ChatGPT from\nexplicitly using the current session.\n\nThe opt-in also needs a clear security boundary: an arbitrary MCP\nconfiguration must not be able to redirect ChatGPT credentials to\nanother origin.\n\n## What changed\n\n- Add `use_chatgpt_auth` to HTTP MCP server configuration, defaulting to\n`false`.\n- Honor the setting only when the parsed server URL has the same HTTP(S)\norigin as the configured `chatgpt_base_url`; otherwise remove the\ncapability before startup.\n- Resolve bearer tokens and static or environment-backed authorization\nheaders before selecting authentication, with configured authorization\ntaking precedence over ChatGPT session auth.\n- Enable the setting for the built-in Codex Apps and hosted plugin\nruntime endpoints while keeping Codex Apps caching and tool\nnormalization scoped to the reserved server.\n- Persist the setting through MCP config rewrite paths and expose it in\nthe generated config schema.\n- Load the current login state for `codex mcp list` so reported auth\nstatus matches runtime behavior.\n\n## Verification\n\nCore integration coverage exercises the complete streamable HTTP MCP\nstartup path and verifies that:\n\n- a same-origin opted-in server receives the current ChatGPT access\ntoken;\n- an explicitly configured authorization header takes precedence;\n- a different-origin server completes MCP initialization and tool\nlisting without receiving any ChatGPT authorization header.","tree":{"sha":"bd7bb73645c03ec29e58ceb4062129855c1722d9","url":"https://api.github.com/repos/openai/codex/git/trees/bd7bb73645c03ec29e58ceb4062129855c1722d9"},"url":"https://api.github.com/repos/openai/codex/git/commits/4c0706e24a290f89c40d99b92912367c63fe273d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPJCoCRC1aQ7uu5UhlAAAP/gQAKghPGfGiROo6whe71vEPrwA\nCncoBHia1Ntq+bgV+iyhB/Fb7zPTIg18zrxDTGsjITjhkdVC9DknqeqcDR5grSw8\n2CW1oFh1q7Pldm82q/CZon3jzlx06UWbCtqNRm1ZvA//1aMgc8jLaDEpPWZlVFlR\ngGNFg6q1RnSBfLQZYCliZ8+7wB083Vu910wYFabtQKX/qhSxB3r0DGKQ5X0Ghbpx\n6NBhIC6osHBiRMLpknqdNbyJR7MZf6xXOMuc3Ta/HfSLs7OU7IoczQf6t1mL86BY\nJ0BqTkm8ge6uiq5T5+T4piHfpz36UgUgMsxJS+3mx8P5fGAMXUp4dKpzLvQPUwiH\n3ft9Hk0zntUT6zzt6OBEMd7jIPe6/BbNywtJn9cDn13qpeIPuBJre1KbNSEMPjpL\nT4wY/ZIyy1iUDfkIRpn0cnxdctEmAHWbFh09mxHlrQLdX1pttgn9hJvrmCvP9h0X\nqzd8Qnk8rEfcSBcUIbKXgNyWhdSKBkwQU4iFH+DygfAIOY/0MITHe5HCUgHfJLc0\nPrCxRdCWiw0wKK+y1nokxJax1aAFjuru5QxTyAuHR+8W1revGRmfBMgLM6P8LE2i\nSqIdwnjDHNoiEzPVp6V4jEryY18kCmc6VA19lHkTrWyDRthpJvrJ2KxdWsVGuVkP\n9EVXaxgDPQyvRIXEmJlH\n=zaAd\n-----END PGP SIGNATURE-----\n","payload":"tree bd7bb73645c03ec29e58ceb4062129855c1722d9\nparent a0d5fd772e5dbc1be57c5a689cc4db1eabe5035d\nauthor Ahmed Ibrahim <aibrahim@openai.com> 1782354088 -0700\ncommitter GitHub <noreply@github.com> 1782354088 -0700\n\nAllow ChatGPT-hosted MCP servers to use session auth (#29733)\n\n## Why\n\nChatGPT session authentication was inferred from the reserved Codex Apps\nserver name. That couples credential routing to Codex Apps-specific\nbehavior and prevents other MCP endpoints hosted by ChatGPT from\nexplicitly using the current session.\n\nThe opt-in also needs a clear security boundary: an arbitrary MCP\nconfiguration must not be able to redirect ChatGPT credentials to\nanother origin.\n\n## What changed\n\n- Add `use_chatgpt_auth` to HTTP MCP server configuration, defaulting to\n`false`.\n- Honor the setting only when the parsed server URL has the same HTTP(S)\norigin as the configured `chatgpt_base_url`; otherwise remove the\ncapability before startup.\n- Resolve bearer tokens and static or environment-backed authorization\nheaders before selecting authentication, with configured authorization\ntaking precedence over ChatGPT session auth.\n- Enable the setting for the built-in Codex Apps and hosted plugin\nruntime endpoints while keeping Codex Apps caching and tool\nnormalization scoped to the reserved server.\n- Persist the setting through MCP config rewrite paths and expose it in\nthe generated config schema.\n- Load the current login state for `codex mcp list` so reported auth\nstatus matches runtime behavior.\n\n## Verification\n\nCore integration coverage exercises the complete streamable HTTP MCP\nstartup path and verifies that:\n\n- a same-origin opted-in server receives the current ChatGPT access\ntoken;\n- an explicitly configured authorization header takes precedence;\n- a different-origin server completes MCP initialization and tool\nlisting without receiving any ChatGPT authorization header.","verified_at":"2026-06-25T02:21:28Z"}},"url":"https://api.github.com/repos/openai/codex/commits/4c0706e24a290f89c40d99b92912367c63fe273d","html_url":"https://github.com/openai/codex/commit/4c0706e24a290f89c40d99b92912367c63fe273d","comments_url":"https://api.github.com/repos/openai/codex/commits/4c0706e24a290f89c40d99b92912367c63fe273d/comments","author":{"login":"aibrahim-oai","id":219906144,"node_id":"U_kgDODRuAYA","avatar_url":"https://avatars.githubusercontent.com/u/219906144?v=4","gravatar_id":"","url":"https://api.github.com/users/aibrahim-oai","html_url":"https://github.com/aibrahim-oai","followers_url":"https://api.github.com/users/aibrahim-oai/followers","following_url":"https://api.github.com/users/aibrahim-oai/following{/other_user}","gists_url":"https://api.github.com/users/aibrahim-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/aibrahim-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aibrahim-oai/subscriptions","organizations_url":"https://api.github.com/users/aibrahim-oai/orgs","repos_url":"https://api.github.com/users/aibrahim-oai/repos","events_url":"https://api.github.com/users/aibrahim-oai/events{/privacy}","received_events_url":"https://api.github.com/users/aibrahim-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a0d5fd772e5dbc1be57c5a689cc4db1eabe5035d","url":"https://api.github.com/repos/openai/codex/commits/a0d5fd772e5dbc1be57c5a689cc4db1eabe5035d","html_url":"https://github.com/openai/codex/commit/a0d5fd772e5dbc1be57c5a689cc4db1eabe5035d"}]},{"sha":"a0d5fd772e5dbc1be57c5a689cc4db1eabe5035d","node_id":"C_kwDOOYsS4doAKGEwZDVmZDc3MmU1ZGJjMWJlNTdjNWE2ODljYzRkYjFlYWJlNTAzNWQ","commit":{"author":{"name":"canvrno-oai","email":"kbond@openai.com","date":"2026-06-25T01:48:11Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-25T01:48:11Z"},"message":"TUI Plugin Sharing 5 - polish remote plugin catalog rows (#26705)\n\nThis is the final plugin sharing PR in the 5-PR stack. It applies the\nremaining TUI polish for remote plugin catalog rows and tabs:\nadmin-disabled plugins now read as blocked/view-only instead of looking\ntoggleable, admin-installed/default-installed plugins count and sort\nlike installed plugins, plugin search matches richer metadata, and an\nempty successful `Shared with me` section stays hidden.\n\n- Admin-disabled rows use a blocked marker, show `Disabled`, and keep\nEnter-only detail behavior without a toggle hint.\n- Admin-installed/default-installed plugins show as installed in counts,\nordering, tabs, and detail copy.\n- Plugin search now matches descriptions and keywords in addition to\nexisting row metadata.\n- Successful-empty `Shared with me` tabs are hidden, while loading,\nerror, workspace-empty, and real shared-plugin states remain visible.\n- Updates coverage in\n`plugins_popup_snapshot_shows_all_marketplaces_and_sorts_installed_then_name`,\n`plugins_popup_admin_disabled_installed_plugin_has_no_toggle_hint`,\n`plugins_popup_search_matches_plugin_descriptions`, and\n`plugins_popup_remote_section_fallback_states_snapshot`.\n- Updates snapshots `plugins_popup_curated_marketplace` and\n`plugins_popup_empty_shared_section_hidden`.\n\n\n<img width=\"2034\" height=\"106\" alt=\"image\"\nsrc=\"https://github.com/user-attachments/assets/3f9a57e1-edd8-4e6c-b0b0-9f632a3c9529\"\n/>\n<img width=\"2038\" height=\"380\" alt=\"image\"\nsrc=\"https://github.com/user-attachments/assets/45a47491-3381-4846-a13d-496bc0051d42\"\n/>","tree":{"sha":"9ce758d209361e4ae1a823f7b4f82ff066b7bba2","url":"https://api.github.com/repos/openai/codex/git/trees/9ce758d209361e4ae1a823f7b4f82ff066b7bba2"},"url":"https://api.github.com/repos/openai/codex/git/commits/a0d5fd772e5dbc1be57c5a689cc4db1eabe5035d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPIjcCRC1aQ7uu5UhlAAABugQAHYf6JmA1WIlq5rdPAU4/92r\nW8VTZu/KtHrb/Jt3+NPu4YLTeQ9JZZNbitmtecx9vVldUzCFTP507z1YuF9DwNcu\n0FDjFgqOJ1351Qj9Ch3NasTUeprEwic28XuDSxwumQFTuRpxqNdzXvMrRWRWYD8q\nS9Oxr6CMEDlxyHIHVK+NV19d4k5Jte96RZjLaA/yO7z5j5c1Bc273BE8rGiDarQ5\nvqY1FxBMSNexnX97HyrJyoS+kp0Dm/it/kvjTnRPXwX8zjLOJAk4AlfUSEzbYfXo\n3jemo7/vvsc52liZ2TGyURDStfOtkEieJxTF2j9kwC25nDj+TJEsZ4aBlBgs2+Cz\nsa6kET+SSXY3RCz89X5orUnZKhjnP95DJDpEKtdQMzTnZBEpwB/7vslCIeE/q50K\nbDYdGelDGFLqqIDyCO1XU4MrO+Ec+QfwFzoil79jL63Vf6N/mmi/4RENnMAfnRlG\nH1DOcPXM9Lo8sCeevuXWwyEYGcJ3N+1y3I/OrhGYWZdrhIEpRq0YJlK8fQqWb3Og\nGmSydDpd/vrt/IUBWkc2DEbwTVfl/sUPtsX6g36LpT2n+c0zLMSwroSTMrdBvzy+\n8kRorWGaRqaWvQ5xtbuhxk8TOHXX6IVhBsN6Qrg2ibQYVyRNbTphoZv9QNzQ+jug\nwygcF3g4/lE31k9qaxa8\n=/lY9\n-----END PGP SIGNATURE-----\n","payload":"tree 9ce758d209361e4ae1a823f7b4f82ff066b7bba2\nparent f15df624a607b6c8d19b9425795df3057471eff3\nauthor canvrno-oai <kbond@openai.com> 1782352091 -0700\ncommitter GitHub <noreply@github.com> 1782352091 -0700\n\nTUI Plugin Sharing 5 - polish remote plugin catalog rows (#26705)\n\nThis is the final plugin sharing PR in the 5-PR stack. It applies the\nremaining TUI polish for remote plugin catalog rows and tabs:\nadmin-disabled plugins now read as blocked/view-only instead of looking\ntoggleable, admin-installed/default-installed plugins count and sort\nlike installed plugins, plugin search matches richer metadata, and an\nempty successful `Shared with me` section stays hidden.\n\n- Admin-disabled rows use a blocked marker, show `Disabled`, and keep\nEnter-only detail behavior without a toggle hint.\n- Admin-installed/default-installed plugins show as installed in counts,\nordering, tabs, and detail copy.\n- Plugin search now matches descriptions and keywords in addition to\nexisting row metadata.\n- Successful-empty `Shared with me` tabs are hidden, while loading,\nerror, workspace-empty, and real shared-plugin states remain visible.\n- Updates coverage in\n`plugins_popup_snapshot_shows_all_marketplaces_and_sorts_installed_then_name`,\n`plugins_popup_admin_disabled_installed_plugin_has_no_toggle_hint`,\n`plugins_popup_search_matches_plugin_descriptions`, and\n`plugins_popup_remote_section_fallback_states_snapshot`.\n- Updates snapshots `plugins_popup_curated_marketplace` and\n`plugins_popup_empty_shared_section_hidden`.\n\n\n<img width=\"2034\" height=\"106\" alt=\"image\"\nsrc=\"https://github.com/user-attachments/assets/3f9a57e1-edd8-4e6c-b0b0-9f632a3c9529\"\n/>\n<img width=\"2038\" height=\"380\" alt=\"image\"\nsrc=\"https://github.com/user-attachments/assets/45a47491-3381-4846-a13d-496bc0051d42\"\n/>","verified_at":"2026-06-25T01:48:12Z"}},"url":"https://api.github.com/repos/openai/codex/commits/a0d5fd772e5dbc1be57c5a689cc4db1eabe5035d","html_url":"https://github.com/openai/codex/commit/a0d5fd772e5dbc1be57c5a689cc4db1eabe5035d","comments_url":"https://api.github.com/repos/openai/codex/commits/a0d5fd772e5dbc1be57c5a689cc4db1eabe5035d/comments","author":{"login":"canvrno-oai","id":257630656,"node_id":"U_kgDOD1shwA","avatar_url":"https://avatars.githubusercontent.com/u/257630656?v=4","gravatar_id":"","url":"https://api.github.com/users/canvrno-oai","html_url":"https://github.com/canvrno-oai","followers_url":"https://api.github.com/users/canvrno-oai/followers","following_url":"https://api.github.com/users/canvrno-oai/following{/other_user}","gists_url":"https://api.github.com/users/canvrno-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/canvrno-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/canvrno-oai/subscriptions","organizations_url":"https://api.github.com/users/canvrno-oai/orgs","repos_url":"https://api.github.com/users/canvrno-oai/repos","events_url":"https://api.github.com/users/canvrno-oai/events{/privacy}","received_events_url":"https://api.github.com/users/canvrno-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f15df624a607b6c8d19b9425795df3057471eff3","url":"https://api.github.com/repos/openai/codex/commits/f15df624a607b6c8d19b9425795df3057471eff3","html_url":"https://github.com/openai/codex/commit/f15df624a607b6c8d19b9425795df3057471eff3"}]},{"sha":"f15df624a607b6c8d19b9425795df3057471eff3","node_id":"C_kwDOOYsS4doAKGYxNWRmNjI0YTYwN2I2YzhkMTliOTQyNTc5NWRmMzA1NzQ3MWVmZjM","commit":{"author":{"name":"Michael Bolin","email":"mbolin@openai.com","date":"2026-06-25T01:03:44Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-25T01:03:44Z"},"message":"core: add configurable <context_window_guidance> message (#29936)\n\n## Why\n\nThis PR adds a configurable `<context_window_guidance>` developer\nsection immediately after `<context_window>`. Harness integrations need\nthis section to give the model deployment-specific instructions for\npreparing for context-window transitions.\n\n## What changed\n\n- Add an optional `features.token_budget.guidance_message` config with a\n1,000-byte runtime cap and generated schema support.\n- Render configured guidance as a developer `ContextualUserFragment`\nwrapped in `<context_window_guidance>` immediately after\n`<context_window>`.\n- Omit the section when guidance is unset, empty, or whitespace-only.\n- Preserve the resolved value in config locks and classify persisted\nguidance as contextual developer content.\n- Add integration coverage for rendered content and ordering.","tree":{"sha":"24d6fa8117d870f3999e4d45d79347dbd29ef6f1","url":"https://api.github.com/repos/openai/codex/git/trees/24d6fa8117d870f3999e4d45d79347dbd29ef6f1"},"url":"https://api.github.com/repos/openai/codex/git/commits/f15df624a607b6c8d19b9425795df3057471eff3","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPH5wCRC1aQ7uu5UhlAAAeqAQACIx2UHXi0+3bqlr008ib1MR\nrE6aS25XOXadZDcsxvmbLx6qsYnlxE4701c9RxstdVcriBX5QsrdaurwSrUA42kb\n7XRhVEE4CmvKJrEVBfVpCDh3GX0lgW9HaQxFiiB6S7D0FY5RhRQ8K/6UY1P9PgwB\nkKB+n+YmoP8DbaGm8m7rNnR/qtqets2QNt+OPDjEohBIiCzWfbqPMrX+VIoDPTIm\ngebmrvzf9ODbdUyvjWyk+n6947zbAWaF/BpU/gfmgVVqqdgJrEjnzbQoxg7jHxSf\n1dZ1yvZvZUBgeEYuEleKOfYiJroD5WkgSp6hOzXRWKqIAXW4OSSLijd6j7VeKoeQ\nXP6haHmCYSpY3ecaJagr9VXNAt9kFf9EGduoZB5THP0FHfw0ftY9UprS02rdvBp1\nb8pg8XZeRzEu+i3kfjXp8A1jsC81oMAS6rkv5I9oELOlH7UiexGmTQ3j0YV6gQjw\nboViDUzDzZKJfafguxhz5nrAHH3vQjM3wV3hmC7wewaxKp+r2oTgo1c9ROuvWwvd\nM8dRDVhzKPfebi1+O60x8eGtOqogcHyEFr9+wc3g6nQhiSgh5WPhkki3tOCJEB3H\njhwYY3ZXihH5mf5eP9Uejq69VSkBdGD3+i38y60GgLB3uWdF5YQABQrnVOklvCBv\nkF4Nl9yfgG8WQskfMEes\n=ID6M\n-----END PGP SIGNATURE-----\n","payload":"tree 24d6fa8117d870f3999e4d45d79347dbd29ef6f1\nparent f4e6aa70e55426b39e560e043228c665be092e23\nauthor Michael Bolin <mbolin@openai.com> 1782349424 -0700\ncommitter GitHub <noreply@github.com> 1782349424 -0700\n\ncore: add configurable <context_window_guidance> message (#29936)\n\n## Why\n\nThis PR adds a configurable `<context_window_guidance>` developer\nsection immediately after `<context_window>`. Harness integrations need\nthis section to give the model deployment-specific instructions for\npreparing for context-window transitions.\n\n## What changed\n\n- Add an optional `features.token_budget.guidance_message` config with a\n1,000-byte runtime cap and generated schema support.\n- Render configured guidance as a developer `ContextualUserFragment`\nwrapped in `<context_window_guidance>` immediately after\n`<context_window>`.\n- Omit the section when guidance is unset, empty, or whitespace-only.\n- Preserve the resolved value in config locks and classify persisted\nguidance as contextual developer content.\n- Add integration coverage for rendered content and ordering.","verified_at":"2026-06-25T01:03:45Z"}},"url":"https://api.github.com/repos/openai/codex/commits/f15df624a607b6c8d19b9425795df3057471eff3","html_url":"https://github.com/openai/codex/commit/f15df624a607b6c8d19b9425795df3057471eff3","comments_url":"https://api.github.com/repos/openai/codex/commits/f15df624a607b6c8d19b9425795df3057471eff3/comments","author":{"login":"bolinfest","id":655869,"node_id":"MDQ6VXNlcjY1NTg2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/655869?v=4","gravatar_id":"","url":"https://api.github.com/users/bolinfest","html_url":"https://github.com/bolinfest","followers_url":"https://api.github.com/users/bolinfest/followers","following_url":"https://api.github.com/users/bolinfest/following{/other_user}","gists_url":"https://api.github.com/users/bolinfest/gists{/gist_id}","starred_url":"https://api.github.com/users/bolinfest/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bolinfest/subscriptions","organizations_url":"https://api.github.com/users/bolinfest/orgs","repos_url":"https://api.github.com/users/bolinfest/repos","events_url":"https://api.github.com/users/bolinfest/events{/privacy}","received_events_url":"https://api.github.com/users/bolinfest/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f4e6aa70e55426b39e560e043228c665be092e23","url":"https://api.github.com/repos/openai/codex/commits/f4e6aa70e55426b39e560e043228c665be092e23","html_url":"https://github.com/openai/codex/commit/f4e6aa70e55426b39e560e043228c665be092e23"}]},{"sha":"f4e6aa70e55426b39e560e043228c665be092e23","node_id":"C_kwDOOYsS4doAKGY0ZTZhYTcwZTU1NDI2YjM5ZTU2MGUwNDMyMjhjNjY1YmUwOTJlMjM","commit":{"author":{"name":"Anton Panasenko","email":"apanasenko@openai.com","date":"2026-06-25T01:00:06Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-25T01:00:06Z"},"message":"feat(remote-control): add daemon pairing command (#29913)\n\n## Why\n\nUsers who run Codex remote control through daemon mode can keep the\ndaemon running, but they do not have a CLI path to mint the short-lived\nmanual pairing code needed to connect another device. Without this\ncommand, they need to speak app-server JSON-RPC directly.\n\nRelated: #25675\n\n## What Changed\n\n- Added `codex remote-control pair`, which connects to the existing\ndaemon control socket and calls `remoteControl/pairing/start` with\n`manualCode: true`.\n- Kept the command non-lifecycle-mutating: it does not start, enable, or\nrestart the daemon.\n- Human output labels the manual code as `Pairing code: ...`; `--json`\npreserves the full pairing response.\n- Added daemon socket-client, CLI formatting, and parser coverage.\n\n## Verification\n\n- `remote_control_client::tests::start_pairing_requests_manual_code`\nverifies the daemon client sends `{ \"manualCode\": true }` and parses the\ncomplete response.\n-\n`remote_control_cmd::tests::remote_control_pairing_human_output_labels_the_manual_code`\nverifies the human-facing output.","tree":{"sha":"c3395959bf197e6fcc4ab7c52128ec54d7b4309d","url":"https://api.github.com/repos/openai/codex/git/trees/c3395959bf197e6fcc4ab7c52128ec54d7b4309d"},"url":"https://api.github.com/repos/openai/codex/git/commits/f4e6aa70e55426b39e560e043228c665be092e23","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPH2WCRC1aQ7uu5UhlAAAOeAQAHY8/KX65rt1HgAbVR9TdKM6\nRpaozkOwhggZ8mXqZ9tenc0Zp1AGzmxR+TKi/X6o0FkmT3u2sWxgVq4U6CzFK3w+\nPW9iLhLsLbcJqXZRG0eXBHoW6GVeOgG3bokir56CDYkTIJiOc4IzKxZ+bAbbPJiM\nGRny6aTpMVL1UP7e6KY3IbU8NwGvRgSUtir1ahMYYdDiOwScNla7gG4plkyOKzaN\n5UDpMVkTxGeNAHIk2Hz+s3R57uAvI8HNyV0KAl6QXStznLUlbWAvJ7W+eWafWdGm\nLODqoLvCJUfSkPW9V1WQjg1nkzeDjoeyFscKDPVVAOHRWOPruSs1avqtThXVCPlx\nUsAULwl8zULlF3lnXUpIOTqEIRPE7OVTKyicxbXjLU/WcrRlfUTJ8lRGZPGG2Yp7\nAe9DAgkvYdALnlk/wEoR2E8Xt33Pu79OIsbq4cznE0Eum+pkEcClVqAPJIrQes9z\nJBSwN5OwjnfxW0O5LCu85PCi9XvewNFghI+hLMiqtUF6S6DFTDe0DrX5g/DSY5Do\nf12ybw9b203gN+X0vK1L8qGN1NSKG04PXUIk0dDE6YsaJbosvNqCRuVe4hgiv4yH\nAtOclI0q0DLhz+eP1RXLZLazy2Vifw+QSzjMMfBqQKGqce6ZZU9Lc8ZN2BXyA5C3\ndIoSRDFOKX+Mq668TrPh\n=nakE\n-----END PGP SIGNATURE-----\n","payload":"tree c3395959bf197e6fcc4ab7c52128ec54d7b4309d\nparent 35f5d02464ade52d2341dd7a40fd65aae439adfa\nauthor Anton Panasenko <apanasenko@openai.com> 1782349206 -0700\ncommitter GitHub <noreply@github.com> 1782349206 -0700\n\nfeat(remote-control): add daemon pairing command (#29913)\n\n## Why\n\nUsers who run Codex remote control through daemon mode can keep the\ndaemon running, but they do not have a CLI path to mint the short-lived\nmanual pairing code needed to connect another device. Without this\ncommand, they need to speak app-server JSON-RPC directly.\n\nRelated: #25675\n\n## What Changed\n\n- Added `codex remote-control pair`, which connects to the existing\ndaemon control socket and calls `remoteControl/pairing/start` with\n`manualCode: true`.\n- Kept the command non-lifecycle-mutating: it does not start, enable, or\nrestart the daemon.\n- Human output labels the manual code as `Pairing code: ...`; `--json`\npreserves the full pairing response.\n- Added daemon socket-client, CLI formatting, and parser coverage.\n\n## Verification\n\n- `remote_control_client::tests::start_pairing_requests_manual_code`\nverifies the daemon client sends `{ \"manualCode\": true }` and parses the\ncomplete response.\n-\n`remote_control_cmd::tests::remote_control_pairing_human_output_labels_the_manual_code`\nverifies the human-facing output.","verified_at":"2026-06-25T01:00:07Z"}},"url":"https://api.github.com/repos/openai/codex/commits/f4e6aa70e55426b39e560e043228c665be092e23","html_url":"https://github.com/openai/codex/commit/f4e6aa70e55426b39e560e043228c665be092e23","comments_url":"https://api.github.com/repos/openai/codex/commits/f4e6aa70e55426b39e560e043228c665be092e23/comments","author":{"login":"apanasenko-oai","id":228802911,"node_id":"U_kgDODaNBXw","avatar_url":"https://avatars.githubusercontent.com/u/228802911?v=4","gravatar_id":"","url":"https://api.github.com/users/apanasenko-oai","html_url":"https://github.com/apanasenko-oai","followers_url":"https://api.github.com/users/apanasenko-oai/followers","following_url":"https://api.github.com/users/apanasenko-oai/following{/other_user}","gists_url":"https://api.github.com/users/apanasenko-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/apanasenko-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/apanasenko-oai/subscriptions","organizations_url":"https://api.github.com/users/apanasenko-oai/orgs","repos_url":"https://api.github.com/users/apanasenko-oai/repos","events_url":"https://api.github.com/users/apanasenko-oai/events{/privacy}","received_events_url":"https://api.github.com/users/apanasenko-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"35f5d02464ade52d2341dd7a40fd65aae439adfa","url":"https://api.github.com/repos/openai/codex/commits/35f5d02464ade52d2341dd7a40fd65aae439adfa","html_url":"https://github.com/openai/codex/commit/35f5d02464ade52d2341dd7a40fd65aae439adfa"}]},{"sha":"35f5d02464ade52d2341dd7a40fd65aae439adfa","node_id":"C_kwDOOYsS4doAKDM1ZjVkMDI0NjRhZGU1MmQyMzQxZGQ3YTQwZmQ2NWFhZTQzOWFkZmE","commit":{"author":{"name":"rka-oai","email":"rka@openai.com","date":"2026-06-25T00:49:00Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-25T00:49:00Z"},"message":"[codex] nest sleep config under current time reminder (#29910)\n\n## Summary\n\n- move sleep tool enablement from top-level `[features].sleep_tool` to\n`[features.current_time_reminder].sleep_tool`\n- remove the standalone `Feature::SleepTool` flag and gate `clock.sleep`\nfrom resolved current-time configuration\n- update config schema, config-lock materialization, and existing sleep\ncoverage\n\nStacked on #29907.","tree":{"sha":"87267333f391051befda4730353a9cccaded9985","url":"https://api.github.com/repos/openai/codex/git/trees/87267333f391051befda4730353a9cccaded9985"},"url":"https://api.github.com/repos/openai/codex/git/commits/35f5d02464ade52d2341dd7a40fd65aae439adfa","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPHr8CRC1aQ7uu5UhlAAA9bsQAHgF16Dw1zXi39GO15N2dzB4\nbcdFIM/tCsYwVI+cugc9rQb9rQXPDFDIq7+pooy5sggrCsRyDOcKdM1d5b4/8c/G\nRh6FZJEywZ0+FPNG7PM7cjKIl7h8M+o6BZTCflN1jVlKN1PJKu5WdCY5sPgyBZn2\na4qeP1alKTCmnVziKWrNI2f1SiTrBzBh8Lj0EaXS20l5PmOnOM9iTn8No9Xvn3jJ\njVcTSWx5j9msJ9QpaOU6KnOksjl3qFCBLytnktk/gZKTg0YUWnCFzgV7H1YY7Eib\nkb6QQ+FE1Z7bsuZwkDTovV5Txv6PqLRDZz8gHVtd3vOrnq5WGWnxVFFPY7RMtNC9\nMQUlaHWa1RkPOdAUq2h0tyqdDG7Hy7uBuUqFiErVD57wg9B0Gdk2sfygvCgl6Iv5\nwrn4FYcd/qGPVvWO8X0vSd5DiCislYlIiv3Rhyg24k2AGZi8xNTS2rhwiPqqcQa/\n63E7/8/NgV3Sfyd7OiDZTEsimwf1ocS71UfR7DLzMleMLO/Y7dIz9UvtJsmnmd0k\nm2dj/Wi0BbXTHR9JXWM1+Z8d/QUnEMZbkaKPO4rvudVoHJ1Ny+rE9UazXl+U4K8e\niyImO5SE9GPz5TcuLDYTIhSwfxrGC/VXMfP4EE2bZeOgGKA0AmWDZwSNoFj9Tv1A\nQkmyzPJ0YBjsHcaxSoXc\n=LtJf\n-----END PGP SIGNATURE-----\n","payload":"tree 87267333f391051befda4730353a9cccaded9985\nparent 800529218a4356c06b6e1e97f8dd16c42e75aa78\nauthor rka-oai <rka@openai.com> 1782348540 -0700\ncommitter GitHub <noreply@github.com> 1782348540 -0700\n\n[codex] nest sleep config under current time reminder (#29910)\n\n## Summary\n\n- move sleep tool enablement from top-level `[features].sleep_tool` to\n`[features.current_time_reminder].sleep_tool`\n- remove the standalone `Feature::SleepTool` flag and gate `clock.sleep`\nfrom resolved current-time configuration\n- update config schema, config-lock materialization, and existing sleep\ncoverage\n\nStacked on #29907.","verified_at":"2026-06-25T00:49:01Z"}},"url":"https://api.github.com/repos/openai/codex/commits/35f5d02464ade52d2341dd7a40fd65aae439adfa","html_url":"https://github.com/openai/codex/commit/35f5d02464ade52d2341dd7a40fd65aae439adfa","comments_url":"https://api.github.com/repos/openai/codex/commits/35f5d02464ade52d2341dd7a40fd65aae439adfa/comments","author":{"login":"rka-oai","id":240799229,"node_id":"U_kgDODlpN_Q","avatar_url":"https://avatars.githubusercontent.com/u/240799229?v=4","gravatar_id":"","url":"https://api.github.com/users/rka-oai","html_url":"https://github.com/rka-oai","followers_url":"https://api.github.com/users/rka-oai/followers","following_url":"https://api.github.com/users/rka-oai/following{/other_user}","gists_url":"https://api.github.com/users/rka-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rka-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rka-oai/subscriptions","organizations_url":"https://api.github.com/users/rka-oai/orgs","repos_url":"https://api.github.com/users/rka-oai/repos","events_url":"https://api.github.com/users/rka-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rka-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"800529218a4356c06b6e1e97f8dd16c42e75aa78","url":"https://api.github.com/repos/openai/codex/commits/800529218a4356c06b6e1e97f8dd16c42e75aa78","html_url":"https://github.com/openai/codex/commit/800529218a4356c06b6e1e97f8dd16c42e75aa78"}]},{"sha":"800529218a4356c06b6e1e97f8dd16c42e75aa78","node_id":"C_kwDOOYsS4doAKDgwMDUyOTIxOGE0MzU2YzA2YjZlMWU5N2Y4ZGQxNmM0MmU3NWFhNzg","commit":{"author":{"name":"rka-oai","email":"rka@openai.com","date":"2026-06-25T00:17:28Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-25T00:17:28Z"},"message":"[codex] namespace sleep under clock (#29907)\n\n## Summary\n\n- expose the interruptible sleep tool as `clock.sleep` instead of\ntop-level `sleep`\n- keep `clock.curr_time` and `clock.sleep` in the same model-visible\nnamespace when both features are enabled\n- update existing core and app-server integration coverage to issue\nnamespaced sleep calls\n\n## Why\n\nSleep is a clock operation. Grouping it with `clock.curr_time` gives the\nmodel a more coherent tool surface without changing the sleep feature\ngate or runtime behavior.\n\n## Validation\n\n- `just test -p codex-core sleep_tool_follows_feature_gate`\n- `just test -p codex-core any_new_input_interrupts_sleep`\n- `just test -p codex-app-server\nsleep_emits_started_and_completed_items`","tree":{"sha":"02a46b7fb21b45cd66968219a9bd811b0a1c73e0","url":"https://api.github.com/repos/openai/codex/git/trees/02a46b7fb21b45cd66968219a9bd811b0a1c73e0"},"url":"https://api.github.com/repos/openai/codex/git/commits/800529218a4356c06b6e1e97f8dd16c42e75aa78","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPHOYCRC1aQ7uu5UhlAAAsRQQAG+/YxQE7uLjfFHF1O3C4v+z\nNLmZuu++uiUOgpwKNJnVW77g/PcWZvdPuzMm10+0u2jfbzjiHpx7ljPs9pUuwU9B\n/yScyAuzj8c2I+ghsxDWFqu1Z1S8nC+9iyjdQU8mwWlC03w5x3b3MqadTQUPMX8Q\nlkrEp5lkznnDgtmY+8798gga/eoTYKKSQpbAUtgDF1doybNJZV6AR6Tm5ogjWMwP\n3/LXWn/eUwYL/zEHMWC4ngB92o/pdvuVWFAKO/Drm3n5mAOAsHRbeHv0S8lel/xS\nTMOSSknJTQoWuDu4pMgvJ3nTagmPTM3Tk0Kjbye7vELEbT7LSZakRBHYHY8P+H9u\nh6CNDzFuUgPjoP7qdE6kcOLWkfTJox8/8yJpstOE4Tl9/cr9GJ12/TF7KiDSwOx+\nnBDnTzePde5PKmmFca5IKnkG2XyS0/gbXHeRiMQ2/Q7C4/+7L7AJTgm9OlN879fx\ndwID+6b8udTCKg4SgPqL77oO5SnZrNK7o8H9mU8slosy36R5a1C4jM0SsyzG4EPI\nFLeZgAcQuxzhrBpH6Z5xsKOLvgA3tzzpio+U9/sa7EPfoU+kzMMPU5bNeefwv/kJ\nv2l1So9pbitOaiSlacCjmwPrl1UmwwZM/VPthb/Gj5xvgGsmzCAYFbJLNRD/eTDs\nCX378T/hO9a0eki/fxyo\n=eYL7\n-----END PGP SIGNATURE-----\n","payload":"tree 02a46b7fb21b45cd66968219a9bd811b0a1c73e0\nparent 134646eff0dfaa32d736d49dc550cde82728ea9a\nauthor rka-oai <rka@openai.com> 1782346648 -0700\ncommitter GitHub <noreply@github.com> 1782346648 -0700\n\n[codex] namespace sleep under clock (#29907)\n\n## Summary\n\n- expose the interruptible sleep tool as `clock.sleep` instead of\ntop-level `sleep`\n- keep `clock.curr_time` and `clock.sleep` in the same model-visible\nnamespace when both features are enabled\n- update existing core and app-server integration coverage to issue\nnamespaced sleep calls\n\n## Why\n\nSleep is a clock operation. Grouping it with `clock.curr_time` gives the\nmodel a more coherent tool surface without changing the sleep feature\ngate or runtime behavior.\n\n## Validation\n\n- `just test -p codex-core sleep_tool_follows_feature_gate`\n- `just test -p codex-core any_new_input_interrupts_sleep`\n- `just test -p codex-app-server\nsleep_emits_started_and_completed_items`","verified_at":"2026-06-25T00:17:29Z"}},"url":"https://api.github.com/repos/openai/codex/commits/800529218a4356c06b6e1e97f8dd16c42e75aa78","html_url":"https://github.com/openai/codex/commit/800529218a4356c06b6e1e97f8dd16c42e75aa78","comments_url":"https://api.github.com/repos/openai/codex/commits/800529218a4356c06b6e1e97f8dd16c42e75aa78/comments","author":{"login":"rka-oai","id":240799229,"node_id":"U_kgDODlpN_Q","avatar_url":"https://avatars.githubusercontent.com/u/240799229?v=4","gravatar_id":"","url":"https://api.github.com/users/rka-oai","html_url":"https://github.com/rka-oai","followers_url":"https://api.github.com/users/rka-oai/followers","following_url":"https://api.github.com/users/rka-oai/following{/other_user}","gists_url":"https://api.github.com/users/rka-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rka-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rka-oai/subscriptions","organizations_url":"https://api.github.com/users/rka-oai/orgs","repos_url":"https://api.github.com/users/rka-oai/repos","events_url":"https://api.github.com/users/rka-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rka-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"134646eff0dfaa32d736d49dc550cde82728ea9a","url":"https://api.github.com/repos/openai/codex/commits/134646eff0dfaa32d736d49dc550cde82728ea9a","html_url":"https://github.com/openai/codex/commit/134646eff0dfaa32d736d49dc550cde82728ea9a"}]},{"sha":"134646eff0dfaa32d736d49dc550cde82728ea9a","node_id":"C_kwDOOYsS4doAKDEzNDY0NmVmZjBkZmFhMzJkNzM2ZDQ5ZGM1NTBjZGU4MjcyOGVhOWE","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-06-24T23:04:51Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-24T23:04:51Z"},"message":"Isolate curated plugin sync Git environment (#29785)\n\n## Why\n\nSeveral users have reported data loss from this bug, including tracked\nfiles being deleted or replaced and branches appearing to be reset to\nthe curated plugins repository. This can happen during startup, before\nthe model chooses to edit anything.\n\nAmbient repository variables such as `GIT_DIR` and `GIT_WORK_TREE` can\noverride the repository selected by `git -C`, redirecting startup sync's\n`git reset --hard` and `git clean -fdx` into the user's active\nworkspace.\n\n## What\n\nRoute every startup-sync Git invocation through a shared command builder\nthat removes repository-local environment variables before execution.\nAdd regression coverage to keep those variables isolated.\n\nFixes #27416","tree":{"sha":"7bdd3b4c85b49c5d22eea5e53d40917fe2fc8a0e","url":"https://api.github.com/repos/openai/codex/git/trees/7bdd3b4c85b49c5d22eea5e53d40917fe2fc8a0e"},"url":"https://api.github.com/repos/openai/codex/git/commits/134646eff0dfaa32d736d49dc550cde82728ea9a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPGKTCRC1aQ7uu5UhlAAATskQAEA2X6Xj3Ksw3tpmY3Z/X7XM\nhdiArxakneOiOFyN59RXtQBbNUQ1ZYrcpZiQDy9Ebe4u9jH55UNW0Bx2NMtxvIV+\nXuBM2PFBR7M1LpExwMh0gu416MgUthPsUhJLM72UxQKINLSZnDmyDIcz73HBw8Mu\nm5NRjd6Y7x0w2SN09B1q3UFiPlT9KvoZn7f9omOuf/7jlGssz7whV3OkiWXkdRTr\ngo68xK6Z2OH11H6wO+mNZvF9H8aWMRKS+jj6heQ1EWBeYc3hneusKMim4xZjF3pR\n8W8N3dsige788TeifmIkrIqRKfwsNn/bhUsBjTTps7MWQYhGTCiKPAi15rr0lCnj\nwdu2EQZEZtxNhMd6qvgG/f8Lw40ZuAHHdTPyl4cvkhXEXTPapckRP7Uj+j6Naqm6\nGBlVNEdh/WHR3YzD4Ho/oL+NvnoCFsTT14lwkKEw4jWxGw18C5OAeK7wrrn4mbB9\n7WD6EvJ/0yMb2wlbyD7AkWS2afOsgxHkG+KsrLQml/zmQesF169JFyurFTFQUZvN\n4Av5aZKk010i/1paySRESlj2kgDZjkV5PdZBhu2PDB1uC1drMuKjEI1UlXaiLvTD\n/yFyxZWFoMMzRVQS8a4zELO6f0TCRIQRYX4ssSyOK66bmVICNFwqR+KDElj/VVkv\nA5oYUJ/i/hZ9gq2v/YKm\n=SSSh\n-----END PGP SIGNATURE-----\n","payload":"tree 7bdd3b4c85b49c5d22eea5e53d40917fe2fc8a0e\nparent 9ff8068880ce920bc149cdfccc59f158fc77fa39\nauthor Eric Traut <etraut@openai.com> 1782342291 -0700\ncommitter GitHub <noreply@github.com> 1782342291 -0700\n\nIsolate curated plugin sync Git environment (#29785)\n\n## Why\n\nSeveral users have reported data loss from this bug, including tracked\nfiles being deleted or replaced and branches appearing to be reset to\nthe curated plugins repository. This can happen during startup, before\nthe model chooses to edit anything.\n\nAmbient repository variables such as `GIT_DIR` and `GIT_WORK_TREE` can\noverride the repository selected by `git -C`, redirecting startup sync's\n`git reset --hard` and `git clean -fdx` into the user's active\nworkspace.\n\n## What\n\nRoute every startup-sync Git invocation through a shared command builder\nthat removes repository-local environment variables before execution.\nAdd regression coverage to keep those variables isolated.\n\nFixes #27416","verified_at":"2026-06-24T23:04:52Z"}},"url":"https://api.github.com/repos/openai/codex/commits/134646eff0dfaa32d736d49dc550cde82728ea9a","html_url":"https://github.com/openai/codex/commit/134646eff0dfaa32d736d49dc550cde82728ea9a","comments_url":"https://api.github.com/repos/openai/codex/commits/134646eff0dfaa32d736d49dc550cde82728ea9a/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"9ff8068880ce920bc149cdfccc59f158fc77fa39","url":"https://api.github.com/repos/openai/codex/commits/9ff8068880ce920bc149cdfccc59f158fc77fa39","html_url":"https://github.com/openai/codex/commit/9ff8068880ce920bc149cdfccc59f158fc77fa39"}]},{"sha":"9ff8068880ce920bc149cdfccc59f158fc77fa39","node_id":"C_kwDOOYsS4doAKDlmZjgwNjg4ODBjZTkyMGJjMTQ5Y2RmY2NjNTlmMTU4ZmM3N2ZhMzk","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-24T22:56:50Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-24T22:56:50Z"},"message":"Read connector declarations from executor plugins (#29852)\n\n## Why\n\nSelected capability roots can live on a different executor and operating\nsystem from app-server. Their connector declarations must therefore be\nread through the executor that owns the package, without converting\nexecutor URIs into host paths.\n\nThis PR adds that authority-bound reader without activating connectors\nor changing thread startup.\n\n## What changed\n\n- Add a small `codex-connectors-extension` crate for executor-owned\nconnector I/O.\n- Read only the app configuration explicitly declared by the resolved\nplugin manifest.\n- Read through the `ExecutorFileSystem` retained by\n`ResolvedExecutorPlugin`; there is no host-filesystem fallback or\ndefault-file probe.\n- Keep `PathUri` values intact so Windows, Unix, and remote executor\npaths work from any orchestrator OS.\n- Return full `AppDeclaration` values so the caller retains declaration\nnames and categories for routing.\n- Preserve the selected plugin ID and exact executor URI in read and\nparse errors.\n\nThe contract is intentionally narrow: selected packages are trusted,\nvalid packages and packages that provide connectors explicitly declare\ntheir app configuration.\n\n## Stack scope\n\nThis PR is stacked on #29851. It only provides the executor-backed\nreader. #29856 resolves selected roots at thread start, freezes their\nconnector snapshot, and contains the remote-capable end-to-end authority\ntest for the complete path.","tree":{"sha":"5335d127efded8425454d403860792e15e7e7e81","url":"https://api.github.com/repos/openai/codex/git/trees/5335d127efded8425454d403860792e15e7e7e81"},"url":"https://api.github.com/repos/openai/codex/git/commits/9ff8068880ce920bc149cdfccc59f158fc77fa39","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPGCyCRC1aQ7uu5UhlAAApeYQAFfzpAfaaW/azG6qos047M/X\no4GgEyrlifZwecLcCdC6qOXnrXdTjxlk9a0WOKvOddHh0ItjgKaf+nH/jSkDxtXe\n7X+pF8HW2Dfm3eDucRZVS3vQTJpx02viYebculdZwNLvHYfqJMv+u2NkIRaj91NE\nQa+rdmsCrOKn0UZh+kZCiJW90oTSELMS4Ys0WudDR5P4PLepsyxmGHB4/m9biUW+\nSf/BWsMiNX8f7lvgAGGgM+E1zhCGGEIJ364u2Uc2LAcLYTnYUmwx5+C2TuBOVoSi\ns/kBKSQlVkkTnNoCLrt2uVUNHzYH6JC2gwEwpTomuechg0pFBEYrvH1EVihlBZRn\nmAlqtBAelae0zqv2NojLs2LcYw6FKF6S53PYc4bKBiGJ1dowQGZ6bPg8etY4MMXm\nTCrrjCZ9GT1EvOUm75DsrJYov/RDWowMe6n+kHqsD6P2iGJcMJd2ayYRW0idNQof\n8rniXWqBqaxEad5UThsdRu+8hEtXeVwmUvVivow1eGUIJ+zXbk2opDPcpjFGC7vz\npxMtCFE2PIDqrWjHJ7lkro+cRzDhE/KGvnoaA8aJ/TUbuqqRP80Wc2UUKc97H0Z0\nAbTb7v8eJ8qzpXfWixgsQAGb5zlXQWO6fzNKcWb6IHvz/WlplWktdGVs2BU2GC4Q\noOE0OO1NN6un9Tu2Tvus\n=tG8B\n-----END PGP SIGNATURE-----\n","payload":"tree 5335d127efded8425454d403860792e15e7e7e81\nparent 81f340436c6ecd7cf7ed2fdc5199c5e3597f5cf9\nauthor jif <jif@openai.com> 1782341810 +0100\ncommitter GitHub <noreply@github.com> 1782341810 +0100\n\nRead connector declarations from executor plugins (#29852)\n\n## Why\n\nSelected capability roots can live on a different executor and operating\nsystem from app-server. Their connector declarations must therefore be\nread through the executor that owns the package, without converting\nexecutor URIs into host paths.\n\nThis PR adds that authority-bound reader without activating connectors\nor changing thread startup.\n\n## What changed\n\n- Add a small `codex-connectors-extension` crate for executor-owned\nconnector I/O.\n- Read only the app configuration explicitly declared by the resolved\nplugin manifest.\n- Read through the `ExecutorFileSystem` retained by\n`ResolvedExecutorPlugin`; there is no host-filesystem fallback or\ndefault-file probe.\n- Keep `PathUri` values intact so Windows, Unix, and remote executor\npaths work from any orchestrator OS.\n- Return full `AppDeclaration` values so the caller retains declaration\nnames and categories for routing.\n- Preserve the selected plugin ID and exact executor URI in read and\nparse errors.\n\nThe contract is intentionally narrow: selected packages are trusted,\nvalid packages and packages that provide connectors explicitly declare\ntheir app configuration.\n\n## Stack scope\n\nThis PR is stacked on #29851. It only provides the executor-backed\nreader. #29856 resolves selected roots at thread start, freezes their\nconnector snapshot, and contains the remote-capable end-to-end authority\ntest for the complete path.","verified_at":"2026-06-24T22:56:50Z"}},"url":"https://api.github.com/repos/openai/codex/commits/9ff8068880ce920bc149cdfccc59f158fc77fa39","html_url":"https://github.com/openai/codex/commit/9ff8068880ce920bc149cdfccc59f158fc77fa39","comments_url":"https://api.github.com/repos/openai/codex/commits/9ff8068880ce920bc149cdfccc59f158fc77fa39/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"81f340436c6ecd7cf7ed2fdc5199c5e3597f5cf9","url":"https://api.github.com/repos/openai/codex/commits/81f340436c6ecd7cf7ed2fdc5199c5e3597f5cf9","html_url":"https://github.com/openai/codex/commit/81f340436c6ecd7cf7ed2fdc5199c5e3597f5cf9"}]},{"sha":"81f340436c6ecd7cf7ed2fdc5199c5e3597f5cf9","node_id":"C_kwDOOYsS4doAKDgxZjM0MDQzNmM2ZWNkN2NmN2VkMmZkYzUxOTljNWUzNTk3ZjVjZjk","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-24T22:33:18Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-24T22:33:18Z"},"message":"path-uri: normalize parent segments in absolute joins (#29903)\n\n## Why\n\n`PathUri::join` normalized `..` for relative paths, but its\nabsolute-path branch rebuilt URIs through `url::PathSegmentsMut::push`,\nwhich skips dot segments. `/tmp/a/../b` therefore resolved to `/tmp/a/b`\ninstead of `/tmp/b`.\n\n## What changed\n\nNormalize absolute native path segments before constructing the file\nURI. Parent traversal now clamps at POSIX roots, Windows drive roots,\nand UNC share roots, including paths with repeated separators.\n\nAdd platform-independent coverage for POSIX, drive, UNC, root-clamping,\nand repeated-separator cases.\n\n## Manual validation\n\n- `just test -p codex-utils-path-uri`","tree":{"sha":"3cf9fa2b08cd1dacb5b1afca6ef50194b3f40dca","url":"https://api.github.com/repos/openai/codex/git/trees/3cf9fa2b08cd1dacb5b1afca6ef50194b3f40dca"},"url":"https://api.github.com/repos/openai/codex/git/commits/81f340436c6ecd7cf7ed2fdc5199c5e3597f5cf9","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPFsuCRC1aQ7uu5UhlAAAIdQQAH0efBCQfiz90h3p2Y1VHPUf\nwnQhVQsObz4KO7wv3AsTULTxIJiXnE3k6EyoSrIb4YJZ40pVJSGdMnx97eIIX48J\nOdFjE0Z63zEk5qXV4DeqTFA/P/2iNViWW4o31iahRAss9cm/Pz2/9kaDYP+9yoIB\ntmHMoyiamEMgPRm6AsuPGDbnl1Llu6QDGGRWx3ax30oSvAu9xQzTj88xs+wi0XsH\najiVMQo1uV+xEcTXwBRCpon0R2SDc0YsF373aL+IwwNPASCSMGX/UtrOhYIgt15q\ne9+7veEQhwguU+WKFMUkGm63aw8j15qqeRW3cQLHLbUJ4nPbrzQOFSNkiWUojjus\ntpdQDQsFFacPCusJZv1ooQ+zorRbYKdxhuUCJsmxs06VhgK6cLLKF5cnXbdU+6lz\npJ+kekR5Gw3y0iO7jsWxfZLWVpASrMf2WYAfxFFmF2tjXgRXjmjP8ihKaT2ordco\n4Gqz0LS3auJK2z8tLYMn1VDrSxFWOlmmR5GTpLAQT6CNRDTXP++mzjHknu+ZTEkt\nXXItBWdhiAbEYw+fZyb6i7R57v7dj8JHCPkRubSwZJzsPmx5Vkumug8ynAQn3fla\nWMcSx1+MSBXWMY4jVO4mK+9Ixu7ftTDSnHCK9De4963U5YETO/9Ezxl58LUw2RBC\nWw+LacC5ZdZO/Dgn2zxt\n=4B0U\n-----END PGP SIGNATURE-----\n","payload":"tree 3cf9fa2b08cd1dacb5b1afca6ef50194b3f40dca\nparent 4e0f863df3ac73e868b754ae2fe5e66a11be3586\nauthor Adam Perry @ OpenAI <anp@openai.com> 1782340398 -0700\ncommitter GitHub <noreply@github.com> 1782340398 +0000\n\npath-uri: normalize parent segments in absolute joins (#29903)\n\n## Why\n\n`PathUri::join` normalized `..` for relative paths, but its\nabsolute-path branch rebuilt URIs through `url::PathSegmentsMut::push`,\nwhich skips dot segments. `/tmp/a/../b` therefore resolved to `/tmp/a/b`\ninstead of `/tmp/b`.\n\n## What changed\n\nNormalize absolute native path segments before constructing the file\nURI. Parent traversal now clamps at POSIX roots, Windows drive roots,\nand UNC share roots, including paths with repeated separators.\n\nAdd platform-independent coverage for POSIX, drive, UNC, root-clamping,\nand repeated-separator cases.\n\n## Manual validation\n\n- `just test -p codex-utils-path-uri`","verified_at":"2026-06-24T22:33:19Z"}},"url":"https://api.github.com/repos/openai/codex/commits/81f340436c6ecd7cf7ed2fdc5199c5e3597f5cf9","html_url":"https://github.com/openai/codex/commit/81f340436c6ecd7cf7ed2fdc5199c5e3597f5cf9","comments_url":"https://api.github.com/repos/openai/codex/commits/81f340436c6ecd7cf7ed2fdc5199c5e3597f5cf9/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"4e0f863df3ac73e868b754ae2fe5e66a11be3586","url":"https://api.github.com/repos/openai/codex/commits/4e0f863df3ac73e868b754ae2fe5e66a11be3586","html_url":"https://github.com/openai/codex/commit/4e0f863df3ac73e868b754ae2fe5e66a11be3586"}]},{"sha":"4e0f863df3ac73e868b754ae2fe5e66a11be3586","node_id":"C_kwDOOYsS4doAKDRlMGY4NjNkZjNhYzczZTg2OGI3NTRhZTJmZTVlNjZhMTFiZTM1ODY","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-24T22:24:01Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-24T22:24:01Z"},"message":"Add a connector declaration snapshot (#29851)\n\n## Why\n\nConnector declarations currently enter Codex through broad plugin\ncapability summaries, then MCP setup, turn tooling, and `app/list` each\nreconstruct the same information. That makes executor-selected\nconnectors difficult to add without coupling connector behavior to the\nhost plugin loader.\n\nThis PR introduces a small connector-owned value that later stack layers\ncan populate before thread startup.\n\n## What changed\n\n- Move the pure app-declaration parser into `codex-connectors`,\npreserving declaration order and category cleanup while leaving\nhost-side validation and deduplication unchanged.\n- Add an immutable `ConnectorSnapshot` with ordered connector IDs and\nplugin display-name provenance.\n- Adapt the existing local-plugin capability summaries into that\nsnapshot at current consumer boundaries.\n- Use the snapshot for MCP tool provenance, turn connector inventory,\nand `app/list`.\n- Keep the crate API narrow: no test-only snapshot accessors are\nexposed.\n\nThe externally visible behavior is unchanged. Connector tools still come\nfrom the orchestrator-owned `/ps/mcp` server, and local plugin\nenablement remains owned by the existing plugin loader.\n\n## Stack scope\n\nThis is the foundation only. It does not read selected executor packages\nor change thread startup. #29852 adds the executor-backed declaration\nreader, and #29856 composes selected declarations into a thread\nsnapshot.","tree":{"sha":"fce9a02c569a681628723b41e4e59e91fca5c131","url":"https://api.github.com/repos/openai/codex/git/trees/fce9a02c569a681628723b41e4e59e91fca5c131"},"url":"https://api.github.com/repos/openai/codex/git/commits/4e0f863df3ac73e868b754ae2fe5e66a11be3586","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPFkBCRC1aQ7uu5UhlAAA6YAQAJohNrL8+mmyzUmudZQvWumL\n1a6AiG/w6lHhzG19A8jqi0eRuHyaxAEcquFHIcgmsrqPwSi+UlEuoToKa47+96+t\nFqnMySWUv0wXtBonpGHt6NRf/N4JRc7u91F5BxNXcOZuzR7U7+IJ5l4RkjpfXDg2\nHES9CE+ulXEDLKqNDkj5YoBYgTftf+lxoypCVH4yoafvQRZMeKDFxi1fOOjLTslu\n10dYgFINVrBj7oMMTBWUL38gLpgGotIab1aFsgLvE2YV6h35SgXZFPIebhwGizFr\nudYTVsnGRHmsMQ2k5NqpCM0UQpkH1s/AI+KG8XsLdzZguS0yWquDN0DhetvqC25d\n++fh4t7Y+8WexlfEdEDyQ41N2q7GUZAjq1V9xzsQwMy08IikPZciGnDmK8eYO485\nSjOYKoAYSwGNqfCZOBBHc0/R8BELLtjnEgrM6bZbVvw+NMHW1MTXv5tqZjOU8c4B\nsAwFJqRwV/FaBG2p2QfFJyEthNuJ7cy4iskgXX/fuF3CMlSlLT20nzfYyWoQ3ql7\nfzVo6NRTFYjnX/MYatb9xzoAxXEkMSsTuqVosSB8Klvon3GgcPvZsmIIWZ6Hqpfl\ntaj8nFEraSLRfAJCkJtmmllOs2WfIUTNxPh9mvG/GjgYy9/Gcbeh/FZds30O3pWB\nVJP+SzQp1PULEZimrVzK\n=/7MQ\n-----END PGP SIGNATURE-----\n","payload":"tree fce9a02c569a681628723b41e4e59e91fca5c131\nparent bb05c1f30fb22fe8457ce242880cbcab29cf0f24\nauthor jif <jif@openai.com> 1782339841 +0100\ncommitter GitHub <noreply@github.com> 1782339841 +0100\n\nAdd a connector declaration snapshot (#29851)\n\n## Why\n\nConnector declarations currently enter Codex through broad plugin\ncapability summaries, then MCP setup, turn tooling, and `app/list` each\nreconstruct the same information. That makes executor-selected\nconnectors difficult to add without coupling connector behavior to the\nhost plugin loader.\n\nThis PR introduces a small connector-owned value that later stack layers\ncan populate before thread startup.\n\n## What changed\n\n- Move the pure app-declaration parser into `codex-connectors`,\npreserving declaration order and category cleanup while leaving\nhost-side validation and deduplication unchanged.\n- Add an immutable `ConnectorSnapshot` with ordered connector IDs and\nplugin display-name provenance.\n- Adapt the existing local-plugin capability summaries into that\nsnapshot at current consumer boundaries.\n- Use the snapshot for MCP tool provenance, turn connector inventory,\nand `app/list`.\n- Keep the crate API narrow: no test-only snapshot accessors are\nexposed.\n\nThe externally visible behavior is unchanged. Connector tools still come\nfrom the orchestrator-owned `/ps/mcp` server, and local plugin\nenablement remains owned by the existing plugin loader.\n\n## Stack scope\n\nThis is the foundation only. It does not read selected executor packages\nor change thread startup. #29852 adds the executor-backed declaration\nreader, and #29856 composes selected declarations into a thread\nsnapshot.","verified_at":"2026-06-24T22:24:01Z"}},"url":"https://api.github.com/repos/openai/codex/commits/4e0f863df3ac73e868b754ae2fe5e66a11be3586","html_url":"https://github.com/openai/codex/commit/4e0f863df3ac73e868b754ae2fe5e66a11be3586","comments_url":"https://api.github.com/repos/openai/codex/commits/4e0f863df3ac73e868b754ae2fe5e66a11be3586/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"bb05c1f30fb22fe8457ce242880cbcab29cf0f24","url":"https://api.github.com/repos/openai/codex/commits/bb05c1f30fb22fe8457ce242880cbcab29cf0f24","html_url":"https://github.com/openai/codex/commit/bb05c1f30fb22fe8457ce242880cbcab29cf0f24"}]},{"sha":"bb05c1f30fb22fe8457ce242880cbcab29cf0f24","node_id":"C_kwDOOYsS4doAKGJiMDVjMWYzMGZiMjJmZTg0NTdjZTI0Mjg4MGNiY2FiMjljZjBmMjQ","commit":{"author":{"name":"Shuo","email":"shuo@openai.com","date":"2026-06-24T22:06:53Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-24T22:06:53Z"},"message":"[codex] dedupe remote control account header (#29893)\n\n## Why\n\nRemote-control HTTP requests applied the authentication headers and then\nappended `ChatGPT-Account-ID` again with\n`reqwest::RequestBuilder::header`. Since reqwest appends, the wire\nrequest could contain the same header twice. Intermediaries may coalesce\nduplicate values into `uuid,uuid`, which is not a valid account ID.\n\n## What changed\n\n- Build remote-control request authentication headers in one place.\n- Apply provider headers first, then use `HeaderMap::insert` for the\nexplicit account ID. This preserves the current account-ID precedence\nand all other authentication headers while ensuring exactly one account\nheader is sent.\n- Preserve duplicate HTTP headers in the test harness and assert exactly\none account header for enroll, refresh, list, and revoke requests.\n\n## Validation\n\nAdded focused coverage for:\n\n- Adding the explicit account header when the auth provider omits it.\n- Replacing multiple provider-supplied account values, including a\ndifferently cased header name.\n- Preserving authorization and routing headers while replacing only the\naccount header.\n- Rejecting invalid account header values before sending a request.\n- Emitting exactly one account header for enroll, refresh, list, and\nrevoke requests.\n- Maintaining header uniqueness across unauthorized recovery, retry, and\nerror-response paths.\n- Emitting exactly one installation header for enroll and refresh\nrequests.\n\nChecks run:\n\n- `just test -p codex-app-server-transport request_headers`: 3 passed\n- `just test -p codex-app-server-transport remote_control_http_mode`: 6\npassed\n- `just test -p codex-app-server-transport clients_tests`: 6 passed\n- `just test -p codex-app-server-transport`: 123 passed\n- `cargo test -p codex-app-server-transport`: 123 passed\n- `just clippy -p codex-app-server-transport`\n- `just fmt-check`\n- `bazel test\n//codex-rs/app-server-transport:app-server-transport-unit-tests`","tree":{"sha":"4539d5d09ca740175522c4a14ce2fdee44841f66","url":"https://api.github.com/repos/openai/codex/git/trees/4539d5d09ca740175522c4a14ce2fdee44841f66"},"url":"https://api.github.com/repos/openai/codex/git/commits/bb05c1f30fb22fe8457ce242880cbcab29cf0f24","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPFT9CRC1aQ7uu5UhlAAA0PAQAJrnwQ3hvSJBl3Tq5ejlKLtd\nN8Dt9BWaUfgzB1Jn2iH7lMGnqcfvcToE/lzobIann6QovqssjJnuNgA9ElCmVqeK\nKUjE7MCb57UFqDluoVeQXUgDZE0ZUHEJ9Ni2au56aRxTWg506eGHdhNJcybkW9BN\nXQtw2o7G6e+Y6hw0o/d3KT/7BPX4IaVOhWWnDTHkx9SFYR2Ebbzqvqy1AVB1UU3J\nQFl5cSmn4KH8Sfe5S6xPj6xd0S6G5sqLoMeTxuxrgR3HI3MmeoyLxemQ0AtE/mEc\nRtRipF8zXIYVGe8KmGvS306xdFM/2eODlYsALSHaOTybTcnPOlupK9oObPsYGo4X\nruCdojDGVOpAXdXW9m8nM0pMEwgDqKSUKvJYz19Udh9ISj7Y2H3cnWrpgs0yp32Z\nh/Rgi9GsmFvToN3yaJkP8NopoLp+eVhEtpY5tMpP6tv0eJYMtIrdELpOURP3bpbi\nAt+TBxtMPdOc2Pv+KIeN7dsfel3/4VMtFXICtATTv013gj7mvbFuKH54U68kcx60\nFstyqSkQR4wVeNJzl0IL0KDgZZO+dc/+hR6GtSzE1MxF5FTa5i8/Dgek9XNybDx4\nn0OhKIqX+cpXPybpx+kKYljV9pOKCbrY7W7j6dvZ6ZrTEgUuiE2FJdHZdj4a/SFl\nmOQFNPLr2bHweZ7kDSoJ\n=x/It\n-----END PGP SIGNATURE-----\n","payload":"tree 4539d5d09ca740175522c4a14ce2fdee44841f66\nparent 39aab9fc45cc639d1caa5a2a999ce7f7260d7c34\nauthor Shuo <shuo@openai.com> 1782338813 -0700\ncommitter GitHub <noreply@github.com> 1782338813 -0700\n\n[codex] dedupe remote control account header (#29893)\n\n## Why\n\nRemote-control HTTP requests applied the authentication headers and then\nappended `ChatGPT-Account-ID` again with\n`reqwest::RequestBuilder::header`. Since reqwest appends, the wire\nrequest could contain the same header twice. Intermediaries may coalesce\nduplicate values into `uuid,uuid`, which is not a valid account ID.\n\n## What changed\n\n- Build remote-control request authentication headers in one place.\n- Apply provider headers first, then use `HeaderMap::insert` for the\nexplicit account ID. This preserves the current account-ID precedence\nand all other authentication headers while ensuring exactly one account\nheader is sent.\n- Preserve duplicate HTTP headers in the test harness and assert exactly\none account header for enroll, refresh, list, and revoke requests.\n\n## Validation\n\nAdded focused coverage for:\n\n- Adding the explicit account header when the auth provider omits it.\n- Replacing multiple provider-supplied account values, including a\ndifferently cased header name.\n- Preserving authorization and routing headers while replacing only the\naccount header.\n- Rejecting invalid account header values before sending a request.\n- Emitting exactly one account header for enroll, refresh, list, and\nrevoke requests.\n- Maintaining header uniqueness across unauthorized recovery, retry, and\nerror-response paths.\n- Emitting exactly one installation header for enroll and refresh\nrequests.\n\nChecks run:\n\n- `just test -p codex-app-server-transport request_headers`: 3 passed\n- `just test -p codex-app-server-transport remote_control_http_mode`: 6\npassed\n- `just test -p codex-app-server-transport clients_tests`: 6 passed\n- `just test -p codex-app-server-transport`: 123 passed\n- `cargo test -p codex-app-server-transport`: 123 passed\n- `just clippy -p codex-app-server-transport`\n- `just fmt-check`\n- `bazel test\n//codex-rs/app-server-transport:app-server-transport-unit-tests`","verified_at":"2026-06-24T22:06:54Z"}},"url":"https://api.github.com/repos/openai/codex/commits/bb05c1f30fb22fe8457ce242880cbcab29cf0f24","html_url":"https://github.com/openai/codex/commit/bb05c1f30fb22fe8457ce242880cbcab29cf0f24","comments_url":"https://api.github.com/repos/openai/codex/commits/bb05c1f30fb22fe8457ce242880cbcab29cf0f24/comments","author":{"login":"shuo-openai","id":254771540,"node_id":"U_kgDODy-BVA","avatar_url":"https://avatars.githubusercontent.com/u/254771540?v=4","gravatar_id":"","url":"https://api.github.com/users/shuo-openai","html_url":"https://github.com/shuo-openai","followers_url":"https://api.github.com/users/shuo-openai/followers","following_url":"https://api.github.com/users/shuo-openai/following{/other_user}","gists_url":"https://api.github.com/users/shuo-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/shuo-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shuo-openai/subscriptions","organizations_url":"https://api.github.com/users/shuo-openai/orgs","repos_url":"https://api.github.com/users/shuo-openai/repos","events_url":"https://api.github.com/users/shuo-openai/events{/privacy}","received_events_url":"https://api.github.com/users/shuo-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"39aab9fc45cc639d1caa5a2a999ce7f7260d7c34","url":"https://api.github.com/repos/openai/codex/commits/39aab9fc45cc639d1caa5a2a999ce7f7260d7c34","html_url":"https://github.com/openai/codex/commit/39aab9fc45cc639d1caa5a2a999ce7f7260d7c34"}]},{"sha":"39aab9fc45cc639d1caa5a2a999ce7f7260d7c34","node_id":"C_kwDOOYsS4doAKDM5YWFiOWZjNDVjYzYzOWQxY2FhNWEyYTk5OWNlN2Y3MjYwZDdjMzQ","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-24T21:58:34Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-24T21:58:34Z"},"message":"Pipeline bounded AGENTS.md and Git root probes (#29870)\n\n## Why\n\nWhen Codex uses a remote `ExecutorFileSystem`, every `get_metadata` call\nis an exec-server round trip. Upward discovery currently pays those\nround trips serially in two latency-sensitive places:\n\n- session startup, while locating the configured project root before\nloading `AGENTS.md`; and\n- Git-root discovery, which runs before per-turn Git diff enrichment.\n\nThe goal is to remove the serial ancestor dependency without adding a\nnew filesystem RPC, JSON-RPC batch method, Git executable dependency, or\ncache.\n\n## Example\n\nAssume this layout, with `.git` as the configured project-root marker:\n\n```text\n/workspace/repo/.git\n/workspace/repo/AGENTS.md\n/workspace/repo/crates/core/    <- cwd\n```\n\nThe marker probes have this required precedence:\n\n```text\n1. /workspace/repo/crates/core/.git\n2. /workspace/repo/crates/.git\n3. /workspace/repo/.git\n4. /workspace/.git\n5. /.git\n```\n\nPreviously, probe 2 was not sent until probe 1 returned, and probe 3 was\nnot sent until probe 2 returned. With this change, the client lazily\nkeeps up to eight ordinary `fs/getMetadata` requests in flight, but\nconsumes their results in the order above. Codex must still learn that\nprobes 1 and 2 are absent before accepting probe 3, so the nearest root\nalways wins. Once probe 3 succeeds, the client has its answer and stops\nawaiting probes 4 and 5. Requests that were already sent may still\nfinish on the worker.\n\nFor the marker phase alone, with a 50 ms client-to-worker round trip and\nfast local metadata calls, finding the root at probe 3 changes from\nroughly three serialized round trips (150 ms) to one round trip plus\nworker processing. The later `AGENTS.md` candidate phase remains\nseparate and ordered.\n\nOnly after `/workspace/repo` is selected does `AGENTS.md` discovery\ncheck instruction candidates, in root-to-cwd order:\n\n```text\n/workspace/repo/AGENTS.override.md\n/workspace/repo/AGENTS.md\n/workspace/repo/crates/AGENTS.override.md\n/workspace/repo/crates/AGENTS.md\n/workspace/repo/crates/core/AGENTS.override.md\n/workspace/repo/crates/core/AGENTS.md\n```\n\nThe first configured candidate found in each directory wins. These\nchecks remain ordered and no instruction candidate above\n`/workspace/repo` is issued. Git-root discovery uses the same bounded\nlookup with only `.git` as the marker.\n\n## What changed\n\n- Added a client-side find-up helper that generates `ancestor x marker`\nprobes lazily, nearest directory first and configured marker order\nwithin each directory.\n- Uses an ordered concurrency window of eight scalar metadata requests.\nThis bounds executor load while preserving nearest-root and marker\nprecedence.\n- Reuses the helper for both configured project-root discovery and\nremote Git-root discovery.\n- Keeps Git ancestor and marker construction in `AbsolutePathBuf`,\nconverting only each complete `.git` probe to `PathUri`. This preserves\nnative paths that require an opaque URI fallback, such as Windows\nnamespace paths.\n- Preserves existing error behavior: `AGENTS.md` discovery propagates\nnon-`NotFound` metadata errors, while Git discovery treats a failed\nmarker probe as absent and continues upward.\n- Reads each discovered `AGENTS.md` directly instead of statting it a\nsecond time.\n\nNo filesystem trait or exec-server protocol method is added. An empty\n`project_root_markers` list performs no ancestor-marker I/O and checks\ninstruction candidates only in `cwd`. This change also deliberately does\nnot cache roots across turns.\n\n## Symlinks\n\nUpward traversal remains **lexical**. The helper does not canonicalize\n`cwd`; it appends marker names to the supplied path and walks that\npath's textual parents. The filesystem performs the actual metadata/read\noperation, and the current local and exec-server implementations follow\nlive symlink targets.\n\nFor example:\n\n```text\n/tmp/pkg -> /workspace/repo/packages/pkg\ncwd = /tmp/pkg/src\nactual Git marker = /workspace/repo/.git\n```\n\nThe lexical probes are `/tmp/pkg/src/.git`, `/tmp/pkg/.git`,\n`/tmp/.git`, and `/.git`. They do not jump from `/tmp/pkg` to the\ntarget's parent `/workspace/repo`, so this spelling of `cwd` does not\ndiscover `/workspace/repo/.git`. That is the existing behavior and is\nunchanged by this PR.\n\nConversely, if `/tmp/repo -> /workspace/repo`, then probing\n`/tmp/repo/.git` follows the directory symlink and finds\n`/workspace/repo/.git`; the reported root remains the lexical path\n`/tmp/repo`. A live symlink used directly as `.git`, another configured\nmarker, or `AGENTS.md` is also followed. A symlinked `AGENTS.md` is\nloaded when its target is a regular file, while a broken symlink behaves\nas `NotFound`.","tree":{"sha":"1784075c71e380790763b219b86580be27cd0599","url":"https://api.github.com/repos/openai/codex/git/trees/1784075c71e380790763b219b86580be27cd0599"},"url":"https://api.github.com/repos/openai/codex/git/commits/39aab9fc45cc639d1caa5a2a999ce7f7260d7c34","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPFMKCRC1aQ7uu5UhlAAAk80QAIsmKNecWu6sn86tiKdixq7A\nsn+U650EMZF5QYPvHiLVzex9Zg7Twwnjp/Y/x2EtiMOdQV2fzuCAlxRenRcqsx8i\nZ4+szfX4wWcv+084td86Uykxq/vvSrTaK0yFKl5TwOVAoSsd97XzLMU9lP7D+cx/\nArmwE7gazng2blXrb9/yR2hti9degQ6r46NxRjcLvlM9Xs3JJZxH3kREWCkgXUR0\n5qk+XXc8n89EhvgKY6i+BbVV0mwniiJKynHme/bTT+WLcAuHFvobetkUtJ6wvE1p\n5t0jhixlIGtxrWMG5ugzkqY0nJVKnePFQCUlBfYSCztfrpJA/Xg9ttun3GXUmZtF\nsFNx9dX9gX/YomIoku3pZouh1aUpj7cVhMWvEBJBQMiRL1rjk3oR5ayuQ4ppjbcy\nTMVwwIAs7DFn2p6KsHTM4EAD/0VsLIntr3KEp7CRYwnLBOWup36YQXe1PWenVfb1\nVUh2CbcY8gJb4KFE7fOB/FfgLHlg/0376lYkTpO2hhY1zp+vKfYzsyCbDf4Quyx7\nF8eM/dcm4rE0vdGFHzOVzskw+BAHToq64kEeaCLD1RA9W8O2Uw+QsGv69Y40a0PM\nAqDgcESoMH8zsgmyZgszeDCTYI6iaFAXRSAbR/tSvufUUALCNDfODhxRx+wwvoqc\nGR3KjFIQS2tmI6dXe6+E\n=d9sf\n-----END PGP SIGNATURE-----\n","payload":"tree 1784075c71e380790763b219b86580be27cd0599\nparent 24423f57124ceba1e1ae50d808caaf991c99b479\nauthor jif <jif@openai.com> 1782338314 +0100\ncommitter GitHub <noreply@github.com> 1782338314 +0100\n\nPipeline bounded AGENTS.md and Git root probes (#29870)\n\n## Why\n\nWhen Codex uses a remote `ExecutorFileSystem`, every `get_metadata` call\nis an exec-server round trip. Upward discovery currently pays those\nround trips serially in two latency-sensitive places:\n\n- session startup, while locating the configured project root before\nloading `AGENTS.md`; and\n- Git-root discovery, which runs before per-turn Git diff enrichment.\n\nThe goal is to remove the serial ancestor dependency without adding a\nnew filesystem RPC, JSON-RPC batch method, Git executable dependency, or\ncache.\n\n## Example\n\nAssume this layout, with `.git` as the configured project-root marker:\n\n```text\n/workspace/repo/.git\n/workspace/repo/AGENTS.md\n/workspace/repo/crates/core/    <- cwd\n```\n\nThe marker probes have this required precedence:\n\n```text\n1. /workspace/repo/crates/core/.git\n2. /workspace/repo/crates/.git\n3. /workspace/repo/.git\n4. /workspace/.git\n5. /.git\n```\n\nPreviously, probe 2 was not sent until probe 1 returned, and probe 3 was\nnot sent until probe 2 returned. With this change, the client lazily\nkeeps up to eight ordinary `fs/getMetadata` requests in flight, but\nconsumes their results in the order above. Codex must still learn that\nprobes 1 and 2 are absent before accepting probe 3, so the nearest root\nalways wins. Once probe 3 succeeds, the client has its answer and stops\nawaiting probes 4 and 5. Requests that were already sent may still\nfinish on the worker.\n\nFor the marker phase alone, with a 50 ms client-to-worker round trip and\nfast local metadata calls, finding the root at probe 3 changes from\nroughly three serialized round trips (150 ms) to one round trip plus\nworker processing. The later `AGENTS.md` candidate phase remains\nseparate and ordered.\n\nOnly after `/workspace/repo` is selected does `AGENTS.md` discovery\ncheck instruction candidates, in root-to-cwd order:\n\n```text\n/workspace/repo/AGENTS.override.md\n/workspace/repo/AGENTS.md\n/workspace/repo/crates/AGENTS.override.md\n/workspace/repo/crates/AGENTS.md\n/workspace/repo/crates/core/AGENTS.override.md\n/workspace/repo/crates/core/AGENTS.md\n```\n\nThe first configured candidate found in each directory wins. These\nchecks remain ordered and no instruction candidate above\n`/workspace/repo` is issued. Git-root discovery uses the same bounded\nlookup with only `.git` as the marker.\n\n## What changed\n\n- Added a client-side find-up helper that generates `ancestor x marker`\nprobes lazily, nearest directory first and configured marker order\nwithin each directory.\n- Uses an ordered concurrency window of eight scalar metadata requests.\nThis bounds executor load while preserving nearest-root and marker\nprecedence.\n- Reuses the helper for both configured project-root discovery and\nremote Git-root discovery.\n- Keeps Git ancestor and marker construction in `AbsolutePathBuf`,\nconverting only each complete `.git` probe to `PathUri`. This preserves\nnative paths that require an opaque URI fallback, such as Windows\nnamespace paths.\n- Preserves existing error behavior: `AGENTS.md` discovery propagates\nnon-`NotFound` metadata errors, while Git discovery treats a failed\nmarker probe as absent and continues upward.\n- Reads each discovered `AGENTS.md` directly instead of statting it a\nsecond time.\n\nNo filesystem trait or exec-server protocol method is added. An empty\n`project_root_markers` list performs no ancestor-marker I/O and checks\ninstruction candidates only in `cwd`. This change also deliberately does\nnot cache roots across turns.\n\n## Symlinks\n\nUpward traversal remains **lexical**. The helper does not canonicalize\n`cwd`; it appends marker names to the supplied path and walks that\npath's textual parents. The filesystem performs the actual metadata/read\noperation, and the current local and exec-server implementations follow\nlive symlink targets.\n\nFor example:\n\n```text\n/tmp/pkg -> /workspace/repo/packages/pkg\ncwd = /tmp/pkg/src\nactual Git marker = /workspace/repo/.git\n```\n\nThe lexical probes are `/tmp/pkg/src/.git`, `/tmp/pkg/.git`,\n`/tmp/.git`, and `/.git`. They do not jump from `/tmp/pkg` to the\ntarget's parent `/workspace/repo`, so this spelling of `cwd` does not\ndiscover `/workspace/repo/.git`. That is the existing behavior and is\nunchanged by this PR.\n\nConversely, if `/tmp/repo -> /workspace/repo`, then probing\n`/tmp/repo/.git` follows the directory symlink and finds\n`/workspace/repo/.git`; the reported root remains the lexical path\n`/tmp/repo`. A live symlink used directly as `.git`, another configured\nmarker, or `AGENTS.md` is also followed. A symlinked `AGENTS.md` is\nloaded when its target is a regular file, while a broken symlink behaves\nas `NotFound`.","verified_at":"2026-06-24T21:58:35Z"}},"url":"https://api.github.com/repos/openai/codex/commits/39aab9fc45cc639d1caa5a2a999ce7f7260d7c34","html_url":"https://github.com/openai/codex/commit/39aab9fc45cc639d1caa5a2a999ce7f7260d7c34","comments_url":"https://api.github.com/repos/openai/codex/commits/39aab9fc45cc639d1caa5a2a999ce7f7260d7c34/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"24423f57124ceba1e1ae50d808caaf991c99b479","url":"https://api.github.com/repos/openai/codex/commits/24423f57124ceba1e1ae50d808caaf991c99b479","html_url":"https://github.com/openai/codex/commit/24423f57124ceba1e1ae50d808caaf991c99b479"}]},{"sha":"24423f57124ceba1e1ae50d808caaf991c99b479","node_id":"C_kwDOOYsS4doAKDI0NDIzZjU3MTI0Y2ViYTFlMWFlNTBkODA4Y2FhZjk5MWM5OWI0Nzk","commit":{"author":{"name":"Alex Daley","email":"adaley@openai.com","date":"2026-06-24T21:29:11Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-24T21:29:11Z"},"message":"[plugins] Track plugin install requests by ID (#29684)\n\nSummary\n- Emit `codex_plugin_install_requested` when a validated plugin install\nrequest is made, before the user accepts or declines the elicitation.\n- Record the exact model-visible plugin ID, remote plugin ID, required\nconnector IDs, stable suggestion ID, and `endpoint_recommendation` vs\n`legacy_discovery` source.\n- Keep `suggest_reason` out of telemetry and leave connector-only\ninstall requests unchanged.\n\nRollout\n- Backend/schema dependency:\nhttps://github.com/openai/openai/pull/1065270\n- Land the backend PR before this producer starts sending the event.\n\nValidation\n- `just test -p codex-analytics` (83 passed)\n- `just test -p codex-core request_plugin_install` (17 passed)\n- `just fix -p codex-analytics`\n- `just fix -p codex-core`\n- `just fmt`\n- `git diff --check`","tree":{"sha":"3f0a0c78b49f2080eae24f71bfaf29fb09e9dbfc","url":"https://api.github.com/repos/openai/codex/git/trees/3f0a0c78b49f2080eae24f71bfaf29fb09e9dbfc"},"url":"https://api.github.com/repos/openai/codex/git/commits/24423f57124ceba1e1ae50d808caaf991c99b479","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPEwnCRC1aQ7uu5UhlAAAH8EQAIMg31WuFgU3zaViZ9vTolPe\nbmBfOERnMR3vHy/wNCPiyfFmRVdCzXJmb2+dxFFjGiZxOsCq9i0bmRJhOgBeHoLw\nUW6TIfojp/Wb8ORs5AmmbkShxYKcCsokpjeRu5DZ3fRckLC2LHL9kJEufjXreRZN\ncnC68vsNvcp5eyfv6vKia//xrR0YovK14fhR70MEVUmtWvUmFMdd5Vmq05GpyMc8\naoz4r3pLwZCfEKUfkJbCs0zZZcGdY2XL7/8ymMQjYU3RbyLKWTKZtK9J+fSrRstp\nADhOfQcPuoSxwX+V8EPuWwPLjklUSpAQg/02opH1UrafKTu6G2lbbxzacsvDKiU8\nesK9IXOpL9lpbDTz17r6BOmETN42JzmDokcucmlRhGmQ/7JV6rvtgfvtHdqUhSIm\nXJheIPa2apnw+bIpMA5UHarwokHo/LkSwajPHA4xoFebR3iFReI+9SLfCmxb7Foi\nw8Z9pxs7ZDqNHrUjg7VVxZWkrEfBDHAP52AFvXV0MEUs4n5wyguvxv5O3R8YuiMB\nU5nvYMbvnwLJPmAGjYf6cTSVbRqL1GEZSrvdhDggB9qJg9v2YmHw6tQ9C57ajJrd\nbU1h8D425aEtQYFpSIsq+nHYWVGYHnIOy2iKQGi1trSn6Czmlwt1F4wtPHzCK6OL\n9mhsPOAujdf9z0yrCTRq\n=ZAnt\n-----END PGP SIGNATURE-----\n","payload":"tree 3f0a0c78b49f2080eae24f71bfaf29fb09e9dbfc\nparent df1ee09ec50453da3976d239da6cb035403ff28f\nauthor Alex Daley <adaley@openai.com> 1782336551 -0400\ncommitter GitHub <noreply@github.com> 1782336551 +0000\n\n[plugins] Track plugin install requests by ID (#29684)\n\nSummary\n- Emit `codex_plugin_install_requested` when a validated plugin install\nrequest is made, before the user accepts or declines the elicitation.\n- Record the exact model-visible plugin ID, remote plugin ID, required\nconnector IDs, stable suggestion ID, and `endpoint_recommendation` vs\n`legacy_discovery` source.\n- Keep `suggest_reason` out of telemetry and leave connector-only\ninstall requests unchanged.\n\nRollout\n- Backend/schema dependency:\nhttps://github.com/openai/openai/pull/1065270\n- Land the backend PR before this producer starts sending the event.\n\nValidation\n- `just test -p codex-analytics` (83 passed)\n- `just test -p codex-core request_plugin_install` (17 passed)\n- `just fix -p codex-analytics`\n- `just fix -p codex-core`\n- `just fmt`\n- `git diff --check`","verified_at":"2026-06-24T21:29:12Z"}},"url":"https://api.github.com/repos/openai/codex/commits/24423f57124ceba1e1ae50d808caaf991c99b479","html_url":"https://github.com/openai/codex/commit/24423f57124ceba1e1ae50d808caaf991c99b479","comments_url":"https://api.github.com/repos/openai/codex/commits/24423f57124ceba1e1ae50d808caaf991c99b479/comments","author":{"login":"adaley-openai","id":192042180,"node_id":"U_kgDOC3JUxA","avatar_url":"https://avatars.githubusercontent.com/u/192042180?v=4","gravatar_id":"","url":"https://api.github.com/users/adaley-openai","html_url":"https://github.com/adaley-openai","followers_url":"https://api.github.com/users/adaley-openai/followers","following_url":"https://api.github.com/users/adaley-openai/following{/other_user}","gists_url":"https://api.github.com/users/adaley-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/adaley-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/adaley-openai/subscriptions","organizations_url":"https://api.github.com/users/adaley-openai/orgs","repos_url":"https://api.github.com/users/adaley-openai/repos","events_url":"https://api.github.com/users/adaley-openai/events{/privacy}","received_events_url":"https://api.github.com/users/adaley-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"df1ee09ec50453da3976d239da6cb035403ff28f","url":"https://api.github.com/repos/openai/codex/commits/df1ee09ec50453da3976d239da6cb035403ff28f","html_url":"https://github.com/openai/codex/commit/df1ee09ec50453da3976d239da6cb035403ff28f"}]},{"sha":"df1ee09ec50453da3976d239da6cb035403ff28f","node_id":"C_kwDOOYsS4doAKGRmMWVlMDllYzUwNDUzZGEzOTc2ZDIzOWRhNmNiMDM1NDAzZmYyOGY","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-24T20:53:27Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-24T20:53:27Z"},"message":"mcp: keep elicitation requests below app wire types (#29724)\n\n## Why\n\nCore and tools need to request MCP elicitation without constructing\napp-server wire payloads. The request should remain a neutral protocol\nconcept until app-server serializes it for a client.\n\n## What changed\n\n- Switched core and tools to\n`codex_protocol::approvals::ElicitationRequest`.\n- Derived turn and server context inside core instead of carrying\napp-server request types through lower layers.\n- Kept the app-server payload unchanged through an explicit boundary\nconversion.\n- Removed the remaining production app-server-protocol dependency from\ntools.\n\n## Stack\n\nThis is PR 5 of 6, stacked on [PR\n#29723](https://github.com/openai/codex/pull/29723). Review only the\ndelta from `codex/split-connector-metadata-types`. Next: [PR\n#29725](https://github.com/openai/codex/pull/29725).\n\n## Validation\n\n- `codex-core` MCP coverage passed: 87 tests.\n- Tools elicitation and app-server round-trip coverage passed.","tree":{"sha":"79c3ea1a20449f7c6f309c996473663a6353b40d","url":"https://api.github.com/repos/openai/codex/git/trees/79c3ea1a20449f7c6f309c996473663a6353b40d"},"url":"https://api.github.com/repos/openai/codex/git/commits/df1ee09ec50453da3976d239da6cb035403ff28f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPEPHCRC1aQ7uu5UhlAAAqQMQACZdh+UVS8xZWTbVOEGMVlxU\n8IiD444QcWYqp/41qx9/kFaV1eu4HLSEk4k4ghSRXRDgc6bmVBRjpxRmAKKKaIzf\nnYBIkq2m/whZBUvTdKcsFV5oIL6LOk96hkTlwfvF/8jM5vFL8W1iv2kSKOSZGVaH\n6rNy807ysRbBZWz/IeMxdC+T8mQDhpsg6aewMkHF/d5c/8ZBo9m9PyCqR2TS7K/d\nQb9/n1s37iasDnSiMmf0W7Kic8ZV2cTmn/BPLvJilsV1RqrYg1JtNIozvkqY2uET\nBOTZqaO0R6XzpdGPe4gyQeg/0wZOUkuns/KtD5i6RHDzZeufBi0YNeNzfqAcUXTa\nLzRPNIpf+kiHst7FJx1eBN8sslKwqch0yY/xaaV7jQmIj3Bcwy1wYgzUGLS1B7Lo\nZBOd1w/G2O3EJe5/0St1T4hzROQFGDXbhOl6emfq3Q+2BDwhrqP1HXsIXU+4jD+G\nx22KkJOQI96DfbAcfcZqfdlqzt0CKMR7DKTSTw3H0nlpIpYd+C/VW06JnVdbfC8n\nGopa2VqKF0B5D0osFhVYBiDLbT1oGQWQGzZm7pR2370En+rDaE2oW83GPcnICbiW\nj1mTQGBxZKWZ7WKKj8Az1lDgNYzyssQCbVspbUPETVIXIJseazqPp/svFD4yYMFR\n8vycsCosNDxIKRJHotl6\n=MPeL\n-----END PGP SIGNATURE-----\n","payload":"tree 79c3ea1a20449f7c6f309c996473663a6353b40d\nparent a33ad93996522315d1d774b9a029d5a1cc8532fa\nauthor Adam Perry @ OpenAI <anp@openai.com> 1782334407 -0700\ncommitter GitHub <noreply@github.com> 1782334407 +0000\n\nmcp: keep elicitation requests below app wire types (#29724)\n\n## Why\n\nCore and tools need to request MCP elicitation without constructing\napp-server wire payloads. The request should remain a neutral protocol\nconcept until app-server serializes it for a client.\n\n## What changed\n\n- Switched core and tools to\n`codex_protocol::approvals::ElicitationRequest`.\n- Derived turn and server context inside core instead of carrying\napp-server request types through lower layers.\n- Kept the app-server payload unchanged through an explicit boundary\nconversion.\n- Removed the remaining production app-server-protocol dependency from\ntools.\n\n## Stack\n\nThis is PR 5 of 6, stacked on [PR\n#29723](https://github.com/openai/codex/pull/29723). Review only the\ndelta from `codex/split-connector-metadata-types`. Next: [PR\n#29725](https://github.com/openai/codex/pull/29725).\n\n## Validation\n\n- `codex-core` MCP coverage passed: 87 tests.\n- Tools elicitation and app-server round-trip coverage passed.","verified_at":"2026-06-24T20:53:27Z"}},"url":"https://api.github.com/repos/openai/codex/commits/df1ee09ec50453da3976d239da6cb035403ff28f","html_url":"https://github.com/openai/codex/commit/df1ee09ec50453da3976d239da6cb035403ff28f","comments_url":"https://api.github.com/repos/openai/codex/commits/df1ee09ec50453da3976d239da6cb035403ff28f/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a33ad93996522315d1d774b9a029d5a1cc8532fa","url":"https://api.github.com/repos/openai/codex/commits/a33ad93996522315d1d774b9a029d5a1cc8532fa","html_url":"https://github.com/openai/codex/commit/a33ad93996522315d1d774b9a029d5a1cc8532fa"}]},{"sha":"a33ad93996522315d1d774b9a029d5a1cc8532fa","node_id":"C_kwDOOYsS4doAKGEzM2FkOTM5OTY1MjIzMTVkMWQ3NzRiOWEwMjlkNWExY2M4NTMyZmE","commit":{"author":{"name":"Drew","email":"drewschuster@openai.com","date":"2026-06-24T20:25:44Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-24T20:25:44Z"},"message":"[apps] Thread structured icon assets through app list (#29889)\n\n## Summary\n\n- Add `iconAssets` and `iconDarkAssets` to the app-list protocol.\n- Preserve structured icons through directory merging and the connector,\napp-\n  server, and TUI boundaries.\n- Keep legacy logo URLs unchanged as compatibility fallbacks.\n- Update generated protocol schemas and TypeScript types.","tree":{"sha":"f1350c7de7441098ad7dfbd4f6d0961b038cacd7","url":"https://api.github.com/repos/openai/codex/git/trees/f1350c7de7441098ad7dfbd4f6d0961b038cacd7"},"url":"https://api.github.com/repos/openai/codex/git/commits/a33ad93996522315d1d774b9a029d5a1cc8532fa","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPD1ICRC1aQ7uu5UhlAAAn9wQAH00HROdLvnplotscYvRDWv5\nupk9tRDtyAWGaqiyOns+i1fBYukVkBmTpslHUBAMDze5LkyNeGmx8UbPvpnW19Oz\nlsfp96Vp1x+ITzDnxS78KTHSSLW4yudT3i7MLtBfzeum10Ez7XlAriOiSA33Ck2j\nuzo2k4SnW7bSHy+aDmKvdXyvHmF8rWqkFUr23xA7y5ZVuLHERfFdCeDwV6FZEAas\n5whMu7BabZi2qF37rTPDx12N8XKYsapv5PDEt+DoYO0d56mjp+jAvCa2Re0p3mGU\nEDrf0m5/NdEzInm6lbTN2BEHLvSDy+ZqYPaeCFeELgTgcT9X26yjRYtCrV3HxE+M\nd85QlwJD68EtS6+KzT944JexlGS1Ggls1A1yggCZbOiTK7xTOJD+qjbli6g1MFuL\nfbOJiX+4++pJzEXDIwLHlMxFF6loQC6w2mWnP+yDJr1sBGDdeCNeYspz9gMu/nyC\ntWW+Q8gQdqJ4JCdmWnCPli7rxqgYojb3IHRY2WmmDPaEKTVNPiOivlXdKofUmeYA\n+AFpPD4F2soAPRIPctd0mkhHAu0+P7/zvHWK8WBQ158xwKObp7X1llw9kLuQf+7y\nOFYtlWZRcxN6D7XpDLPFkH/wGuat5KMUnqY+grhPwnvXA0T+b/0MOazCJgOAdF3r\nt3AdhkOyGos505h+C6YM\n=T0Gr\n-----END PGP SIGNATURE-----\n","payload":"tree f1350c7de7441098ad7dfbd4f6d0961b038cacd7\nparent ece1dfece07650458f84f3d2b35ffbde29ae48b7\nauthor Drew <drewschuster@openai.com> 1782332744 -0700\ncommitter GitHub <noreply@github.com> 1782332744 -0700\n\n[apps] Thread structured icon assets through app list (#29889)\n\n## Summary\n\n- Add `iconAssets` and `iconDarkAssets` to the app-list protocol.\n- Preserve structured icons through directory merging and the connector,\napp-\n  server, and TUI boundaries.\n- Keep legacy logo URLs unchanged as compatibility fallbacks.\n- Update generated protocol schemas and TypeScript types.","verified_at":"2026-06-24T20:25:45Z"}},"url":"https://api.github.com/repos/openai/codex/commits/a33ad93996522315d1d774b9a029d5a1cc8532fa","html_url":"https://github.com/openai/codex/commit/a33ad93996522315d1d774b9a029d5a1cc8532fa","comments_url":"https://api.github.com/repos/openai/codex/commits/a33ad93996522315d1d774b9a029d5a1cc8532fa/comments","author":{"login":"drewschuster-openai","id":181145906,"node_id":"U_kgDOCswRMg","avatar_url":"https://avatars.githubusercontent.com/u/181145906?v=4","gravatar_id":"","url":"https://api.github.com/users/drewschuster-openai","html_url":"https://github.com/drewschuster-openai","followers_url":"https://api.github.com/users/drewschuster-openai/followers","following_url":"https://api.github.com/users/drewschuster-openai/following{/other_user}","gists_url":"https://api.github.com/users/drewschuster-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/drewschuster-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/drewschuster-openai/subscriptions","organizations_url":"https://api.github.com/users/drewschuster-openai/orgs","repos_url":"https://api.github.com/users/drewschuster-openai/repos","events_url":"https://api.github.com/users/drewschuster-openai/events{/privacy}","received_events_url":"https://api.github.com/users/drewschuster-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"ece1dfece07650458f84f3d2b35ffbde29ae48b7","url":"https://api.github.com/repos/openai/codex/commits/ece1dfece07650458f84f3d2b35ffbde29ae48b7","html_url":"https://github.com/openai/codex/commit/ece1dfece07650458f84f3d2b35ffbde29ae48b7"}]},{"sha":"ece1dfece07650458f84f3d2b35ffbde29ae48b7","node_id":"C_kwDOOYsS4doAKGVjZTFkZmVjZTA3NjUwNDU4Zjg0ZjNkMmIzNWZmYmRlMjlhZTQ4Yjc","commit":{"author":{"name":"Tom","email":"wiltzius@openai.com","date":"2026-06-24T20:24:10Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-24T20:24:10Z"},"message":"[codex] Inject agent graph store into ThreadManager (#29736)\n\nPick up the AgentGraphStore migration.\n\n- Inject an explicit optional agent graph store into `ThreadManager` \n- Move all calls to spawn, close, recursive resume, and\nsubtree/archive/delete/feedback traversal through it\n- Keep using  `LocalAgentGraphStore` when SQLite is available\n\nThis required some changes to the interface to deal with futures:\n\n- The interface now matches `ThreadStore`'s object-safe pattern by\nreturning a boxed `AgentGraphStoreFuture` directly, allowing\n`ThreadManager` to hold `Arc<dyn AgentGraphStore>`\n\n*Slight behavior change!* Unfiltered subtree enumeration now performs a\nsingle all-status breadth-first traversal, so a closed grandchild\nbeneath an open edge is included; the previous Open-then-Closed\ntraversals could not cross mixed-status paths and silently omitted it.","tree":{"sha":"68b7c68961c2557284c6031919c59aba65adc02b","url":"https://api.github.com/repos/openai/codex/git/trees/68b7c68961c2557284c6031919c59aba65adc02b"},"url":"https://api.github.com/repos/openai/codex/git/commits/ece1dfece07650458f84f3d2b35ffbde29ae48b7","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPDzqCRC1aQ7uu5UhlAAAXX0QAIXD0E7HC0pQcf3Hg1+w2Yx9\nTdaPzK2VQDGYvFp1PPr5473nr7K/PQ+sl9aKXNlafkbd1HVsDCIMC8JDCtFha8Ny\nKhkl1sCk4EXWLHazfL0o4RVJf+DzphekC4BCKNKcBSyfygQpvD6H2rDsxFe5+4ck\nRfmoX9KwOGItmBDEmE55QPgVu7QBqsocQGc+nrivWtKvcC5jbxKov+dxf1eMl9IS\nri4qTOdqs1Jc52yhLdrztCtyirkSr6mMJhmrRawT0qT4h5Nzev3kyxN8ks8p/0en\nZyXBVp9nvOT9UHzI/9MVAWRJkoVqBUlrL2tZsepZ93L+SuaYwsZV99oY4EBiWnb9\n7hB2IxqL+QNuJPznDfqqVyo/shQIj5MsRrs74YdK0oO/5egxaNhNLWc+ADgua7jT\nA8paDgZTq8VAqVWuLrm7cv6r9S52HFFf8DDrUvm8MNjc25YPdRdRWYqTu6F5gOPQ\ngyA3yF/FZ2L4+RO335iqgGQFAIVvT2oDcuWnj/l8NSerHeT8tLPR/0dS+ALZvSYq\nhmbXXQ5emn4xosIVX//YMXhlzLqGGovtzYK8yBq8TTjoUQaXeJgZlhqHfkScKHIL\nIPunlzzRWDxGabActUPHroK/O8HDDGoJOPgYZbvow3/T2sg2ZNrBKpDk1+v9cdV8\nSdkDz35iv4PKAPeAoe6u\n=Xra/\n-----END PGP SIGNATURE-----\n","payload":"tree 68b7c68961c2557284c6031919c59aba65adc02b\nparent 989f55defa0450e33cdee636ac889c6898a325f6\nauthor Tom <wiltzius@openai.com> 1782332650 -0700\ncommitter GitHub <noreply@github.com> 1782332650 -0700\n\n[codex] Inject agent graph store into ThreadManager (#29736)\n\nPick up the AgentGraphStore migration.\n\n- Inject an explicit optional agent graph store into `ThreadManager` \n- Move all calls to spawn, close, recursive resume, and\nsubtree/archive/delete/feedback traversal through it\n- Keep using  `LocalAgentGraphStore` when SQLite is available\n\nThis required some changes to the interface to deal with futures:\n\n- The interface now matches `ThreadStore`'s object-safe pattern by\nreturning a boxed `AgentGraphStoreFuture` directly, allowing\n`ThreadManager` to hold `Arc<dyn AgentGraphStore>`\n\n*Slight behavior change!* Unfiltered subtree enumeration now performs a\nsingle all-status breadth-first traversal, so a closed grandchild\nbeneath an open edge is included; the previous Open-then-Closed\ntraversals could not cross mixed-status paths and silently omitted it.","verified_at":"2026-06-24T20:24:11Z"}},"url":"https://api.github.com/repos/openai/codex/commits/ece1dfece07650458f84f3d2b35ffbde29ae48b7","html_url":"https://github.com/openai/codex/commit/ece1dfece07650458f84f3d2b35ffbde29ae48b7","comments_url":"https://api.github.com/repos/openai/codex/commits/ece1dfece07650458f84f3d2b35ffbde29ae48b7/comments","author":{"login":"wiltzius-openai","id":176426546,"node_id":"U_kgDOCoQOMg","avatar_url":"https://avatars.githubusercontent.com/u/176426546?v=4","gravatar_id":"","url":"https://api.github.com/users/wiltzius-openai","html_url":"https://github.com/wiltzius-openai","followers_url":"https://api.github.com/users/wiltzius-openai/followers","following_url":"https://api.github.com/users/wiltzius-openai/following{/other_user}","gists_url":"https://api.github.com/users/wiltzius-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/wiltzius-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wiltzius-openai/subscriptions","organizations_url":"https://api.github.com/users/wiltzius-openai/orgs","repos_url":"https://api.github.com/users/wiltzius-openai/repos","events_url":"https://api.github.com/users/wiltzius-openai/events{/privacy}","received_events_url":"https://api.github.com/users/wiltzius-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"989f55defa0450e33cdee636ac889c6898a325f6","url":"https://api.github.com/repos/openai/codex/commits/989f55defa0450e33cdee636ac889c6898a325f6","html_url":"https://github.com/openai/codex/commit/989f55defa0450e33cdee636ac889c6898a325f6"}]},{"sha":"989f55defa0450e33cdee636ac889c6898a325f6","node_id":"C_kwDOOYsS4doAKDk4OWY1NWRlZmEwNDUwZTMzY2RlZTYzNmFjODg5YzY4OThhMzI1ZjY","commit":{"author":{"name":"Winston Howes","email":"winston@openai.com","date":"2026-06-24T20:21:16Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-24T20:21:16Z"},"message":"feat(network-proxy): experimental local credential broker (#28034)\n\n## Why\n\nCodex child processes can inherit injectable local credentials directly,\nwhich lets commands read and exfiltrate the real values. This\nexperimental slice keeps supported workflows working while moving those\ncredentials behind the managed network proxy.\n\nThis PR contains only the proxy-owned broker implementation. The Codex\nconfig and runtime integration is stacked separately in #29752.\n\n## What changed\n\n- discover supported credentials during child setup, retain real values\nonly in the in-memory proxy broker, and replace them with shaped dummy\nvalues\n- require a presented dummy to select a stored credential and preserve\nunrelated explicit authorization headers\n- bind GitHub cloud, GitHub Enterprise, and OpenAI credentials to their\nintended hosts\n- inject credentials only into TLS traffic by default; plaintext\ninjection requires the explicit dangerous opt-in\n- use TLS ClientHello routing for CONNECT so non-TLS protocols remain\nopaque tunnels\n- expose a pure API that identifies environment keys still holding\nbroker-generated dummies without mutating the caller's environment\n\n## Scope\n\n- supported credentials: `GH_TOKEN`, `GITHUB_TOKEN`,\n`GH_ENTERPRISE_TOKEN`, `GITHUB_ENTERPRISE_TOKEN`, and `OPENAI_API_KEY`\n- GitHub cloud credentials match `github.com`, `api.github.com`, and\n`*.ghe.com`\n- GitHub Enterprise credentials match only the normalized non-cloud\n`GH_HOST`\n- OpenAI API keys match only `api.openai.com`\n- this does not cover SSH agents, kube client certificates, filesystem\nsecret discovery, or context-injected secret scrubbing\n\n## Validation\n\n- `just test -p codex-network-proxy` (191 passed)\n- focused opaque CONNECT, plaintext opt-in, dummy-selection, and\nchild-isolation regressions passed\n- scoped Clippy check for `codex-network-proxy` passed\n\n---------\n\nCo-authored-by: viyatb-oai <viyatb@openai.com>\nCo-authored-by: Codex <noreply@openai.com>","tree":{"sha":"0e288a0c9491124db8ac77f3dd64ee9c3e88f58b","url":"https://api.github.com/repos/openai/codex/git/trees/0e288a0c9491124db8ac77f3dd64ee9c3e88f58b"},"url":"https://api.github.com/repos/openai/codex/git/commits/989f55defa0450e33cdee636ac889c6898a325f6","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPDw8CRC1aQ7uu5UhlAAABtoQADP9hLTqLR6vDxWPNq+NsVpn\nXxqeY9779BcJCju93XhDkFU+1sDCZxoYjV63swslVt6gmLjEcE6N8lgAlfIE4lQK\no7OY7pM7YWHI6BbVrsfriMT2OL2Djr3BUVVUzzvzLPVGVqgm2WyXv9XQWwPj0cz5\nL4GArK/fbRB3dNI9xs119M3odK7JrF8fWLz+4ZpPv9rgD2f/pG0GM6TFD4oXG8pF\ng84HZ61918teKw3JSjRyemrLeJC+r9i/v8RV8bDvRkkN1V5LF4/eXz5SUZSeJB6O\nXHU/Uz8/gF/+jdng6D79H3ir2q/IaRo9zieJMauTm3Ir+vgeEGjAIgoSSrcHU8pC\nkhwwZIQzcKAVZd/xqHuvm8D/kMkc//EFiksBiAHtqEQVpbX11q5c3B0rlwPgxVD1\nPA1BBy9xt7YqPFuO176zAiDRrqWpRQs3ChvOEFU8rtBGpXW9aV77Zk3Uc6Kful1v\ntVcr9kcPgIGcBiHBAXmxtU2HAXM4V8BeHp7YfHdeJRjhjpdzmhnj+t1oYLwlgO3F\nM5NrIAvwpz0SNF6sEHfygnL2vsTJ3H/w6f5EJz6qFjYKU9PBFL6bAlobI7RvcMQG\nUCw5xswrwKHosphx13VasoE/R1a1OfC+53JwIcEfgPSrawCqsBztQVjjYToJti7x\nW/vLWBb+Bj6mQe6tw6Yl\n=3YWt\n-----END PGP SIGNATURE-----\n","payload":"tree 0e288a0c9491124db8ac77f3dd64ee9c3e88f58b\nparent 8057603d0c70930fe096302227f582b5b94496d8\nauthor Winston Howes <winston@openai.com> 1782332476 -0700\ncommitter GitHub <noreply@github.com> 1782332476 -0700\n\nfeat(network-proxy): experimental local credential broker (#28034)\n\n## Why\n\nCodex child processes can inherit injectable local credentials directly,\nwhich lets commands read and exfiltrate the real values. This\nexperimental slice keeps supported workflows working while moving those\ncredentials behind the managed network proxy.\n\nThis PR contains only the proxy-owned broker implementation. The Codex\nconfig and runtime integration is stacked separately in #29752.\n\n## What changed\n\n- discover supported credentials during child setup, retain real values\nonly in the in-memory proxy broker, and replace them with shaped dummy\nvalues\n- require a presented dummy to select a stored credential and preserve\nunrelated explicit authorization headers\n- bind GitHub cloud, GitHub Enterprise, and OpenAI credentials to their\nintended hosts\n- inject credentials only into TLS traffic by default; plaintext\ninjection requires the explicit dangerous opt-in\n- use TLS ClientHello routing for CONNECT so non-TLS protocols remain\nopaque tunnels\n- expose a pure API that identifies environment keys still holding\nbroker-generated dummies without mutating the caller's environment\n\n## Scope\n\n- supported credentials: `GH_TOKEN`, `GITHUB_TOKEN`,\n`GH_ENTERPRISE_TOKEN`, `GITHUB_ENTERPRISE_TOKEN`, and `OPENAI_API_KEY`\n- GitHub cloud credentials match `github.com`, `api.github.com`, and\n`*.ghe.com`\n- GitHub Enterprise credentials match only the normalized non-cloud\n`GH_HOST`\n- OpenAI API keys match only `api.openai.com`\n- this does not cover SSH agents, kube client certificates, filesystem\nsecret discovery, or context-injected secret scrubbing\n\n## Validation\n\n- `just test -p codex-network-proxy` (191 passed)\n- focused opaque CONNECT, plaintext opt-in, dummy-selection, and\nchild-isolation regressions passed\n- scoped Clippy check for `codex-network-proxy` passed\n\n---------\n\nCo-authored-by: viyatb-oai <viyatb@openai.com>\nCo-authored-by: Codex <noreply@openai.com>","verified_at":"2026-06-24T20:21:16Z"}},"url":"https://api.github.com/repos/openai/codex/commits/989f55defa0450e33cdee636ac889c6898a325f6","html_url":"https://github.com/openai/codex/commit/989f55defa0450e33cdee636ac889c6898a325f6","comments_url":"https://api.github.com/repos/openai/codex/commits/989f55defa0450e33cdee636ac889c6898a325f6/comments","author":{"login":"winston-openai","id":177672674,"node_id":"U_kgDOCpcR4g","avatar_url":"https://avatars.githubusercontent.com/u/177672674?v=4","gravatar_id":"","url":"https://api.github.com/users/winston-openai","html_url":"https://github.com/winston-openai","followers_url":"https://api.github.com/users/winston-openai/followers","following_url":"https://api.github.com/users/winston-openai/following{/other_user}","gists_url":"https://api.github.com/users/winston-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/winston-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/winston-openai/subscriptions","organizations_url":"https://api.github.com/users/winston-openai/orgs","repos_url":"https://api.github.com/users/winston-openai/repos","events_url":"https://api.github.com/users/winston-openai/events{/privacy}","received_events_url":"https://api.github.com/users/winston-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"8057603d0c70930fe096302227f582b5b94496d8","url":"https://api.github.com/repos/openai/codex/commits/8057603d0c70930fe096302227f582b5b94496d8","html_url":"https://github.com/openai/codex/commit/8057603d0c70930fe096302227f582b5b94496d8"}]},{"sha":"8057603d0c70930fe096302227f582b5b94496d8","node_id":"C_kwDOOYsS4doAKDgwNTc2MDNkMGM3MDkzMGZlMDk2MzAyMjI3ZjU4MmI1Yjk0NDk2ZDg","commit":{"author":{"name":"Brent Traut","email":"btraut@openai.com","date":"2026-06-24T20:08:14Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-24T20:08:14Z"},"message":"feat(app-server): list descendant threads by ancestor (#29591)\n\n## Why\n\n`thread/list` can filter direct children with `parentThreadId`, but\nclients cannot request an entire spawned subtree. Discovering every\ndescendant requires repeated client-side requests and gives up the\ndatabase's existing filtering and pagination path.\n\n## What changed\n\nExperimental clients can use `ancestorThreadId` to return strict\ndescendants at any depth while `parentThreadId` retains its direct-child\nmeaning. The filters are mutually exclusive, the ancestor is excluded,\nand every result preserves its immediate `parentThreadId` so callers can\nreconstruct the tree.\n\n## How it works\n\n- **Explicit relationship:** Internal list parameters distinguish direct\nchildren from transitive descendants without changing the meaning of\n`parentThreadId`.\n- **Existing graph:** Persisted parent-child spawn edges remain the\nsource of truth, so descendant lookup needs no schema migration or\nancestry cache.\n- **Indexed traversal:** A recursive SQLite query starts from the\nparent-edge index, walks each generation, and applies thread filters,\nsorting, and cursor pagination in the same database request.\n- **Reconstructable results:** The response stays flat and normally\nordered while carrying each descendant's immediate parent.\n\n## Verification\n\nRan 550 tests across the protocol, state, rollout, and thread-store\ncrates, then reran the four focused state, store, and app-server\ndescendant-listing tests after the final diff reduction. Scoped Clippy\nand formatting checks passed. Stable and experimental schema generation\nwas checked; the stable fixtures remain unchanged while the experimental\nschema includes the new field.","tree":{"sha":"ca363055511bee4df54ba7103561c7e78faf7e2d","url":"https://api.github.com/repos/openai/codex/git/trees/ca363055511bee4df54ba7103561c7e78faf7e2d"},"url":"https://api.github.com/repos/openai/codex/git/commits/8057603d0c70930fe096302227f582b5b94496d8","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPDkuCRC1aQ7uu5UhlAAA3pMQAKV+M1fs6DpxUnA8y4ytv+JE\nB3c5itpiReOFtDlEDxHZvgaK6tT+Qs86Hr/t53bVelhVL0Y6opVAc6JMz4LfQ2J3\nVi2rBAGozFxZMcuOzKxoQ32iLndM2YL+aFbFQPEFnyt1k5ucAIQAkiSZOIbUFyyt\nTYSYmdDM7khWPYjJJh1+iHZiK8tGrkWuNb2fCZQ47ofCurfduigs+Z6mIERgsWlI\nQVyiSZ9W24LCG2QHFgyG/+Cj3YrHy7B8l0Rsrim8KxZvyO8jWdUOP4EwqYztOpgF\nMKrVDVFrcRojGgFTt8XByu0y4Y1axY5OkgpKbquoAmrWDojCme1/S+aVYsbdHy1a\nIYBxLR5P6D0EPIN934lb/EB27brenBVYnHHAyTwqwV5GPKX+/0o9XYSKse/VR0TD\ndhCMei54fSqkliJUYQVaZRjASKeCe+s1+9bbkl5aE/HjmwOJk+Bew19yol4VVjXp\nFR0Mx3s+UnmGDlLF36zCBpPwiYMVjCX+b3Ef+WKaNV2g4k6Wm+GcS0zBsUS/iSwb\nYCeuL9YRrU2btp0P4uDNH5TVCOkpMOV2WswHDpAAKHGLQr9pdwtK00mB8h0TMEn+\nd4cBrQcSjUfXdblyzGLNoo0sm+e9dcBjxVUshQmB6RH/cWpm0p5zUoWOZZY8tps5\nH0ehw773buqgdI3kv8pJ\n=mwSn\n-----END PGP SIGNATURE-----\n","payload":"tree ca363055511bee4df54ba7103561c7e78faf7e2d\nparent 3ccef20ef4e01875762ccfe4fbe0ee34f86a4a9e\nauthor Brent Traut <btraut@openai.com> 1782331694 -0700\ncommitter GitHub <noreply@github.com> 1782331694 -0700\n\nfeat(app-server): list descendant threads by ancestor (#29591)\n\n## Why\n\n`thread/list` can filter direct children with `parentThreadId`, but\nclients cannot request an entire spawned subtree. Discovering every\ndescendant requires repeated client-side requests and gives up the\ndatabase's existing filtering and pagination path.\n\n## What changed\n\nExperimental clients can use `ancestorThreadId` to return strict\ndescendants at any depth while `parentThreadId` retains its direct-child\nmeaning. The filters are mutually exclusive, the ancestor is excluded,\nand every result preserves its immediate `parentThreadId` so callers can\nreconstruct the tree.\n\n## How it works\n\n- **Explicit relationship:** Internal list parameters distinguish direct\nchildren from transitive descendants without changing the meaning of\n`parentThreadId`.\n- **Existing graph:** Persisted parent-child spawn edges remain the\nsource of truth, so descendant lookup needs no schema migration or\nancestry cache.\n- **Indexed traversal:** A recursive SQLite query starts from the\nparent-edge index, walks each generation, and applies thread filters,\nsorting, and cursor pagination in the same database request.\n- **Reconstructable results:** The response stays flat and normally\nordered while carrying each descendant's immediate parent.\n\n## Verification\n\nRan 550 tests across the protocol, state, rollout, and thread-store\ncrates, then reran the four focused state, store, and app-server\ndescendant-listing tests after the final diff reduction. Scoped Clippy\nand formatting checks passed. Stable and experimental schema generation\nwas checked; the stable fixtures remain unchanged while the experimental\nschema includes the new field.","verified_at":"2026-06-24T20:08:14Z"}},"url":"https://api.github.com/repos/openai/codex/commits/8057603d0c70930fe096302227f582b5b94496d8","html_url":"https://github.com/openai/codex/commit/8057603d0c70930fe096302227f582b5b94496d8","comments_url":"https://api.github.com/repos/openai/codex/commits/8057603d0c70930fe096302227f582b5b94496d8/comments","author":{"login":"btraut-openai","id":284131405,"node_id":"U_kgDOEO-ATQ","avatar_url":"https://avatars.githubusercontent.com/u/284131405?v=4","gravatar_id":"","url":"https://api.github.com/users/btraut-openai","html_url":"https://github.com/btraut-openai","followers_url":"https://api.github.com/users/btraut-openai/followers","following_url":"https://api.github.com/users/btraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/btraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/btraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/btraut-openai/subscriptions","organizations_url":"https://api.github.com/users/btraut-openai/orgs","repos_url":"https://api.github.com/users/btraut-openai/repos","events_url":"https://api.github.com/users/btraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/btraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"3ccef20ef4e01875762ccfe4fbe0ee34f86a4a9e","url":"https://api.github.com/repos/openai/codex/commits/3ccef20ef4e01875762ccfe4fbe0ee34f86a4a9e","html_url":"https://github.com/openai/codex/commit/3ccef20ef4e01875762ccfe4fbe0ee34f86a4a9e"}]},{"sha":"3ccef20ef4e01875762ccfe4fbe0ee34f86a4a9e","node_id":"C_kwDOOYsS4doAKDNjY2VmMjBlZjRlMDE4NzU3NjJjY2ZlNGZiZTBlZTM0Zjg2YTRhOWU","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-24T19:59:53Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-24T19:59:53Z"},"message":"Skip credential refresh for WindowsApps launch failures (#29637)\n\n## Summary\n\n- keep the child error 1312 credential retry for normal executables\n- return WindowsApps/AppX launch errors directly instead of rotating\nsandbox credentials and retrying the same command\n\n## Why\n\nWindows AppX activation can return `ERROR_NO_SUCH_LOGON_SESSION` (1312)\neven when the sandbox token is healthy. For executables under\n`WindowsApps`, refreshing the sandbox account password cannot fix that\nactivation failure; it only triggers elevated setup before the same\ncommand fails again.\n\nThis is a focused follow-up to #29624.","tree":{"sha":"9b54cd013fdc40e20235fdd412ad59231be50d48","url":"https://api.github.com/repos/openai/codex/git/trees/9b54cd013fdc40e20235fdd412ad59231be50d48"},"url":"https://api.github.com/repos/openai/codex/git/commits/3ccef20ef4e01875762ccfe4fbe0ee34f86a4a9e","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPDc5CRC1aQ7uu5UhlAAALgoQAFrHwwwyadnjvsGVC7D20iEQ\nC0jbYvoRoxPN96UGpHVbl1MmV3Jt+8wRRSXLFoSi/ecDIoh2LQyo3RiXdfUJCnrO\nCg7ezM7S2+ZSbyDp3GUw0h66M+i8QTO1wYeGvijyzC3M/118aemE159XvgaY8uYO\nYtbtYhRdzyx2u7I9OIiNhuI1t6+UMqFBcHDfgAn2nU8o+SMaNmKEuRUwCNw3WrJA\nwRZNelkKiKtsWunZ9sQ25WtLxCoMyJVj2TQMaib4PWsBUKYA5mS77qR/lVFMAQde\n+KjGFiwUXLr8nfzgrmGzpHtpQM7YKLLn10YJCCe1TYR9uze3Luj80X0MESN/UwAd\n+3DF3PRe4OmYIioRCtLwVbkBY0vJ58rijg12vVAmOGGTE5gblu1X3kPWA9voEAhB\n4MwVYle/GksxwLSnj0DaQYgpRFDVTUDIt82Djm535o0cTeWVANWYLSHNdPp2TIXi\n3c5o9kWIoeZ9PeIsEwMYNHz4AFkWi3Faog5QL3lePWwD6io69hltAkjmuXJfdOcd\nMiorvmAQ+LRYqMyLvSV0FteU2b27xn5qTJ4C0iAiSoDpNOEJ5eMQ9V+PrdMGmP8S\nhuhrr3VlWpdBJdUtyqagEAOnyBJmaLDHhuSj7xsOD1Yca5jNS34bpcx3gRtX+T39\nB8kFnz6qZDLx84uheAq8\n=OyHp\n-----END PGP SIGNATURE-----\n","payload":"tree 9b54cd013fdc40e20235fdd412ad59231be50d48\nparent 96d8e34712e31ad4051577f777b3235bd1ad6424\nauthor jif <jif@openai.com> 1782331193 +0100\ncommitter GitHub <noreply@github.com> 1782331193 +0100\n\nSkip credential refresh for WindowsApps launch failures (#29637)\n\n## Summary\n\n- keep the child error 1312 credential retry for normal executables\n- return WindowsApps/AppX launch errors directly instead of rotating\nsandbox credentials and retrying the same command\n\n## Why\n\nWindows AppX activation can return `ERROR_NO_SUCH_LOGON_SESSION` (1312)\neven when the sandbox token is healthy. For executables under\n`WindowsApps`, refreshing the sandbox account password cannot fix that\nactivation failure; it only triggers elevated setup before the same\ncommand fails again.\n\nThis is a focused follow-up to #29624.","verified_at":"2026-06-24T19:59:53Z"}},"url":"https://api.github.com/repos/openai/codex/commits/3ccef20ef4e01875762ccfe4fbe0ee34f86a4a9e","html_url":"https://github.com/openai/codex/commit/3ccef20ef4e01875762ccfe4fbe0ee34f86a4a9e","comments_url":"https://api.github.com/repos/openai/codex/commits/3ccef20ef4e01875762ccfe4fbe0ee34f86a4a9e/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"96d8e34712e31ad4051577f777b3235bd1ad6424","url":"https://api.github.com/repos/openai/codex/commits/96d8e34712e31ad4051577f777b3235bd1ad6424","html_url":"https://github.com/openai/codex/commit/96d8e34712e31ad4051577f777b3235bd1ad6424"}]},{"sha":"96d8e34712e31ad4051577f777b3235bd1ad6424","node_id":"C_kwDOOYsS4doAKDk2ZDhlMzQ3MTJlMzFhZDQwNTE1NzdmNzc3YjMyMzViZDFhZDY0MjQ","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-24T19:52:36Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-24T19:52:36Z"},"message":"Follow directory symlinks in filesystem walks (#29844)\n\nStack 3 of 3. Stacked on #29842.\n\n## What changes\n\nAdds an opt-in `followDirectorySymlinks` setting to `fs/walk`.\n\nWhen enabled, the walk follows directory symlinks but continues to\nignore symlinked files. Canonical directory identities prevent symlink\ncycles, while normal paths keep their existing spelling.\n\nEnvironment skill discovery enables the setting so symlinked skill\ndirectories continue to work with the new single-RPC scan.","tree":{"sha":"03142adf6ef653d8505207ade25db2b6d320e158","url":"https://api.github.com/repos/openai/codex/git/trees/03142adf6ef653d8505207ade25db2b6d320e158"},"url":"https://api.github.com/repos/openai/codex/git/commits/96d8e34712e31ad4051577f777b3235bd1ad6424","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPDWECRC1aQ7uu5UhlAAAte4QALFcf2Syi2DqNQTP5sc9nsO1\n4qBSXwThCBphEiBRz1CFOnOaN18sCxuypDg+y8vQaFfZXeu++oBb+PNsszvCV74w\nNd3jDaHkm5NnN1pUp0Dy0jG8qFew5DNIqPzmaFiHfn1zeEhpAYpNNGwvSjP+mbQC\njr6pSzBWiX7QM0IuXJYah9q9k8rusNKKP6upSJSgOQTabhrlQCZP5AbJo1l2+4nd\nOAOyr6LYJjRSDSv/QLEa4PjSSruupIObS6XvovGFEroEBJkT2tPH+0KhhW7mvILN\noBgFQ0HYZlOK5Ua6+MV8/59Lt5u8fX+jA3nDWpf6GGofLDOShosJ03f7sOIRux7h\nri7xweHV/glr/M/9TG8VAZQAnMxpRAaQhpjN38rYRqkT1/5tejPahkO1a5cG3T1D\nps0MImu7fuYvV4DpqkecT5ebvxz8IhC1GdgyVA+cwYNDxd4W36eTx7HyX6bAmfvM\nDllJcNH1wi7sNzG8qhGQ+XkpoaTa74JfUQ/c+j24oKW7Ju6laxdjorfroyeUdpw+\nYTV8PiI0s+IMIBq6P5+orIlL+CL7PsieIxfx6zT7mUdcZIYiaWQHKYCMDDAmzWUi\nJG2qYl66ukj24x9VQbvNE40f7jC4jGZVoKgOUMO8z6fs7/Z8UeoKmkyyoqFbO/2y\nUJ6DMvf6hCSqP8VJFHQ4\n=QBy0\n-----END PGP SIGNATURE-----\n","payload":"tree 03142adf6ef653d8505207ade25db2b6d320e158\nparent 74dcce594db0d8e3823c3e866b77493150f7a640\nauthor jif <jif@openai.com> 1782330756 +0100\ncommitter GitHub <noreply@github.com> 1782330756 +0100\n\nFollow directory symlinks in filesystem walks (#29844)\n\nStack 3 of 3. Stacked on #29842.\n\n## What changes\n\nAdds an opt-in `followDirectorySymlinks` setting to `fs/walk`.\n\nWhen enabled, the walk follows directory symlinks but continues to\nignore symlinked files. Canonical directory identities prevent symlink\ncycles, while normal paths keep their existing spelling.\n\nEnvironment skill discovery enables the setting so symlinked skill\ndirectories continue to work with the new single-RPC scan.","verified_at":"2026-06-24T19:52:37Z"}},"url":"https://api.github.com/repos/openai/codex/commits/96d8e34712e31ad4051577f777b3235bd1ad6424","html_url":"https://github.com/openai/codex/commit/96d8e34712e31ad4051577f777b3235bd1ad6424","comments_url":"https://api.github.com/repos/openai/codex/commits/96d8e34712e31ad4051577f777b3235bd1ad6424/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"74dcce594db0d8e3823c3e866b77493150f7a640","url":"https://api.github.com/repos/openai/codex/commits/74dcce594db0d8e3823c3e866b77493150f7a640","html_url":"https://github.com/openai/codex/commit/74dcce594db0d8e3823c3e866b77493150f7a640"}]},{"sha":"74dcce594db0d8e3823c3e866b77493150f7a640","node_id":"C_kwDOOYsS4doAKDc0ZGNjZTU5NGRiMGQ4ZTM4MjNjM2U4NjZiNzc0OTMxNTBmN2E2NDA","commit":{"author":{"name":"richardopenai","email":"richardlee@openai.com","date":"2026-06-24T19:50:18Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-24T19:50:18Z"},"message":"[codex] Trace exec-server JSON-RPC requests (#27466)\n\n## Why\n\nExec-server JSON-RPC calls can cross local and remote transports, but\ntrace context stopped at the RPC boundary. That made client and server\nwork difficult to correlate when diagnosing latency or failures.\n\n## What changed\n\n- Propagate the current W3C trace context on outbound JSON-RPC requests.\n- Parent inbound request spans from received trace context.\n- Record the received JSON-RPC method on server spans and keep each span\nopen through response enqueue.\n- Add only the OTEL dependencies required by the exec-server crate.\n\n## Stack\n\nReview and land this stack in order:\n\n1. #27466 — trace exec-server JSON-RPC requests **(this PR)**\n2. #27467 — record bounded connection, request, and process lifecycle\nmetrics\n3. #27470 — observe remote registration and Noise rendezvous lifecycle\n\n## Validation\n\n- `just test -p codex-exec-server --lib` (153 passed)\n- `just bazel-lock-check`\n- `just fix -p codex-exec-server`","tree":{"sha":"61721f88b0365fdd3a8c6a0ea8f105d71e93ad25","url":"https://api.github.com/repos/openai/codex/git/trees/61721f88b0365fdd3a8c6a0ea8f105d71e93ad25"},"url":"https://api.github.com/repos/openai/codex/git/commits/74dcce594db0d8e3823c3e866b77493150f7a640","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPDT6CRC1aQ7uu5UhlAAA5y0QAIRZLJhpE+6P2J1yPuKytr08\nqEVySm86qzSM5znouiiAhpuwWUkwZ+BIxh32m+I3aTwx/IVOZyegRQhFreNZcTL7\nI2DoaIdgwt77t4aUq1GkfkvrWlbNfuGUBKKXfI4iIlMM0WPZOUcFWuH0q7kwkko5\nesaawFAcPAEG/6xBZ/CDC8i3g/TcgVV5KOUX7JsoF3styIfeQJ/7EhjxZHQxR+00\nQUoPDhRKMXkKAe22NxAT9IQh0o7FHsve4fploV1z2ycUg1oKKuM9mPkTukKO/Gqe\nqjF7heN4zHmlrKclG/3qJtDaRTA1RfAHVafjmMWSZxQbq/GFE0FUHaxCtnrceCiT\nRN56JmGfgq2vICQ7aM/IFl4yCERKE9QoBvbZcfnbYXjCkavTgeZJOpU7h997TXB3\nnsK3FQTggSDP8FeonUkXh7A1B3wrsoF7r3iXXewudcPvkPADIY6S5OykCdnFAx8N\nWOnVII5dVBCoB3F8QBZfljNVpbR4YwD4PSNvHBps+L6lOmVyQ9SKYexc6dnFZFC2\ntgFOAWTkrOGZmlbDplv6TRQ24jzaNa/4qUzeUlwVYnN7Pkf3q4cEzn9jcJNugBB3\nfubCe6XLu4irOflaJEE77NXTFeTD0W15qesFwzvdH6l6PLbncoIns4GFN8PLxdlv\ndEx6XFccEZAjJopkUJn5\n=8Nrr\n-----END PGP SIGNATURE-----\n","payload":"tree 61721f88b0365fdd3a8c6a0ea8f105d71e93ad25\nparent 4907f0c2c33bb6b4e543960eb12962f7073ce697\nauthor richardopenai <richardlee@openai.com> 1782330618 -0700\ncommitter GitHub <noreply@github.com> 1782330618 -0700\n\n[codex] Trace exec-server JSON-RPC requests (#27466)\n\n## Why\n\nExec-server JSON-RPC calls can cross local and remote transports, but\ntrace context stopped at the RPC boundary. That made client and server\nwork difficult to correlate when diagnosing latency or failures.\n\n## What changed\n\n- Propagate the current W3C trace context on outbound JSON-RPC requests.\n- Parent inbound request spans from received trace context.\n- Record the received JSON-RPC method on server spans and keep each span\nopen through response enqueue.\n- Add only the OTEL dependencies required by the exec-server crate.\n\n## Stack\n\nReview and land this stack in order:\n\n1. #27466 — trace exec-server JSON-RPC requests **(this PR)**\n2. #27467 — record bounded connection, request, and process lifecycle\nmetrics\n3. #27470 — observe remote registration and Noise rendezvous lifecycle\n\n## Validation\n\n- `just test -p codex-exec-server --lib` (153 passed)\n- `just bazel-lock-check`\n- `just fix -p codex-exec-server`","verified_at":"2026-06-24T19:50:19Z"}},"url":"https://api.github.com/repos/openai/codex/commits/74dcce594db0d8e3823c3e866b77493150f7a640","html_url":"https://github.com/openai/codex/commit/74dcce594db0d8e3823c3e866b77493150f7a640","comments_url":"https://api.github.com/repos/openai/codex/commits/74dcce594db0d8e3823c3e866b77493150f7a640/comments","author":{"login":"richardopenai","id":272641442,"node_id":"U_kgDOEEAtog","avatar_url":"https://avatars.githubusercontent.com/u/272641442?v=4","gravatar_id":"","url":"https://api.github.com/users/richardopenai","html_url":"https://github.com/richardopenai","followers_url":"https://api.github.com/users/richardopenai/followers","following_url":"https://api.github.com/users/richardopenai/following{/other_user}","gists_url":"https://api.github.com/users/richardopenai/gists{/gist_id}","starred_url":"https://api.github.com/users/richardopenai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/richardopenai/subscriptions","organizations_url":"https://api.github.com/users/richardopenai/orgs","repos_url":"https://api.github.com/users/richardopenai/repos","events_url":"https://api.github.com/users/richardopenai/events{/privacy}","received_events_url":"https://api.github.com/users/richardopenai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"4907f0c2c33bb6b4e543960eb12962f7073ce697","url":"https://api.github.com/repos/openai/codex/commits/4907f0c2c33bb6b4e543960eb12962f7073ce697","html_url":"https://github.com/openai/codex/commit/4907f0c2c33bb6b4e543960eb12962f7073ce697"}]},{"sha":"4907f0c2c33bb6b4e543960eb12962f7073ce697","node_id":"C_kwDOOYsS4doAKDQ5MDdmMGMyYzMzYmI2YjRlNTQzOTYwZWIxMjk2MmY3MDczY2U2OTc","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-24T19:20:52Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-24T19:20:52Z"},"message":"Preserve Windows sandbox identity during credential retry (#29624)\n\n## Summary\n\n- recognize stale Windows sandbox credentials from both runner logon and\nchild startup failures\n- refresh credentials once without changing the original command,\npermissions, file rules, desktop mode, or managed-network identity\n- add a Windows regression test that forces error 1312 and inspects the\nreal retry arguments\n\n## Why\n\nElevated unified exec starts commands in two steps:\n\n```text\nCodex -> sandbox command runner -> requested command\n```\n\nEither process start can fail when Windows invalidates the sandbox logon\nsession. The child-side failure was previously returned as text, so the\nparent could not reliably recognize Windows error 1312.\n\nThe existing retry also refreshed credentials with `proxy_enforced =\nfalse`, even when the original request used managed networking. That\ncould change the selected Windows sandbox identity from offline to\nonline during the retry.\n\n## How\n\n- carry the failure stage and numeric Windows error code through the\ncommand-runner IPC protocol\n- preserve native `CreateProcessAsUserW` error codes instead of parsing\nerror messages\n- keep every retry-sensitive field in one request and use it for both\nattempts\n- retry exactly once after refreshing credentials, then return the\nsecond failure\n- share the retry rule with the elevated capture path\n\nThe Windows test injects error 1312 on both attempts and verifies:\n\n- two spawn attempts and one credential refresh\n- stale credentials are replaced by refreshed credentials\n- both attempts receive the same command, environment, cwd, permissions,\nroots, deny paths, TTY settings, and private-desktop mode\n- credential refresh receives the original `proxy_enforced` value\n\n## Tests\n\n- `just test -p codex-windows-sandbox`\n- the new Windows-only regression test is included in the Windows\nnextest CI archive","tree":{"sha":"87aaa67b680d483905622b6295f40547a4b25cc6","url":"https://api.github.com/repos/openai/codex/git/trees/87aaa67b680d483905622b6295f40547a4b25cc6"},"url":"https://api.github.com/repos/openai/codex/git/commits/4907f0c2c33bb6b4e543960eb12962f7073ce697","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPC4UCRC1aQ7uu5UhlAAA58QQAGLzFBLYyDjT+44zFzLDlLDH\nP0w59GKycZSLM8QxN1ZKfAwdPVYO3xhRNPzhpXskZ2GWu5MdZYuV0ydoL4SIKcXZ\nAy+9aXc7nMzFYSSTACiYA0gFVrlMg8Hy7kmF+BldFgbj8qnJ/jQam42Au6F/4v7t\n8Kx3IVGgBkfRxXVaQQXxTfcTHldFN8AANvKtc7TvfvfgeMtSYDlAVlgmqTtvjmRo\nM/EZFXKwk09ONfvmpUpJSlKi2GqTGLuAgDtpWTR7N44daLACeyH98+KQ4+Xilkvh\nuDXStIRtIoOublaCTKgTYu/JnR7ubLXRRNTIKk/Q4S+TPJkz2EGUktq1SHB+cXFC\nP3mYKW4uyDtmxgg/9/LDpzYM7gLx8Y/HMcsCfHHTD9U7cdtgmfoS4vjEYyDCr1Ho\nCWfwBztl6GYC37gXOmM/Axk+IktLI5lU0a0vggY3Sn8tHEWiy4K7lRlzDU8sqOgW\n6KhEDTGDGDXCbKRmY73/cDVaxDeV2x6m4losrrjjTslbFbU4UcJujHNKYtJQ6Mmu\npLLHMvqrYy+eysV7M7npYWlIjLwlqop0X4lRAFkFHK186KPASv0NvyP2WxFi+vA/\nPqyR/9yM8cAo38DkAwgzr84hDjlt1EweZk+MFejUzS7u1gmDtBfwgwZSjlW6YYT/\nb6ttvO6i4oak7vtCQUpE\n=c8Av\n-----END PGP SIGNATURE-----\n","payload":"tree 87aaa67b680d483905622b6295f40547a4b25cc6\nparent 5013d108248baad05b897b65aa6e3ca2626d7293\nauthor jif <jif@openai.com> 1782328852 +0100\ncommitter GitHub <noreply@github.com> 1782328852 +0100\n\nPreserve Windows sandbox identity during credential retry (#29624)\n\n## Summary\n\n- recognize stale Windows sandbox credentials from both runner logon and\nchild startup failures\n- refresh credentials once without changing the original command,\npermissions, file rules, desktop mode, or managed-network identity\n- add a Windows regression test that forces error 1312 and inspects the\nreal retry arguments\n\n## Why\n\nElevated unified exec starts commands in two steps:\n\n```text\nCodex -> sandbox command runner -> requested command\n```\n\nEither process start can fail when Windows invalidates the sandbox logon\nsession. The child-side failure was previously returned as text, so the\nparent could not reliably recognize Windows error 1312.\n\nThe existing retry also refreshed credentials with `proxy_enforced =\nfalse`, even when the original request used managed networking. That\ncould change the selected Windows sandbox identity from offline to\nonline during the retry.\n\n## How\n\n- carry the failure stage and numeric Windows error code through the\ncommand-runner IPC protocol\n- preserve native `CreateProcessAsUserW` error codes instead of parsing\nerror messages\n- keep every retry-sensitive field in one request and use it for both\nattempts\n- retry exactly once after refreshing credentials, then return the\nsecond failure\n- share the retry rule with the elevated capture path\n\nThe Windows test injects error 1312 on both attempts and verifies:\n\n- two spawn attempts and one credential refresh\n- stale credentials are replaced by refreshed credentials\n- both attempts receive the same command, environment, cwd, permissions,\nroots, deny paths, TTY settings, and private-desktop mode\n- credential refresh receives the original `proxy_enforced` value\n\n## Tests\n\n- `just test -p codex-windows-sandbox`\n- the new Windows-only regression test is included in the Windows\nnextest CI archive","verified_at":"2026-06-24T19:20:53Z"}},"url":"https://api.github.com/repos/openai/codex/commits/4907f0c2c33bb6b4e543960eb12962f7073ce697","html_url":"https://github.com/openai/codex/commit/4907f0c2c33bb6b4e543960eb12962f7073ce697","comments_url":"https://api.github.com/repos/openai/codex/commits/4907f0c2c33bb6b4e543960eb12962f7073ce697/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"5013d108248baad05b897b65aa6e3ca2626d7293","url":"https://api.github.com/repos/openai/codex/commits/5013d108248baad05b897b65aa6e3ca2626d7293","html_url":"https://github.com/openai/codex/commit/5013d108248baad05b897b65aa6e3ca2626d7293"}]},{"sha":"5013d108248baad05b897b65aa6e3ca2626d7293","node_id":"C_kwDOOYsS4doAKDUwMTNkMTA4MjQ4YmFhZDA1Yjg5N2I2NWFhNmUzY2EyNjI2ZDcyOTM","commit":{"author":{"name":"Brooks","email":"brooks@openai.com","date":"2026-06-24T18:43:17Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-24T18:43:17Z"},"message":"[codex] suppress low usage remaining warnings when credits are available (#28593)\n\n## Why\n\nThe TUI computed proactive `Heads up, you have less than ...` warnings\nbefore considering workspace credits. As a result, users could see\nincluded-limit warnings even when they could continue using Codex with\nworkspace credits.\n\n`has_credits` alone is not sufficient to determine whether finite\ncredits are usable: a spend-control hard limit can cap the reported\nbalance to zero while `has_credits` still reflects the workspace's raw\nbalance. Unlimited credits are the opposite case: they are usable even\nthough no numeric balance is reported.\n\n## What changed\n\n- suppress proactive TUI rate-limit usage warnings and the lower-cost\nmodel nudge when usable workspace credits are available\n- treat credits as usable when `has_credits` is true and either\n`unlimited` is true or the parsed balance is positive\n- continue showing warnings when the usable balance is zero, including\nwhen a spend-control limit has capped otherwise available workspace\ncredits\n- add regression coverage for zero-balance, positive-balance, and\nunlimited workspace-credit snapshots\n\n## Validation\n\n- `just test -p codex-tui rate_limit_usage_warnings_`","tree":{"sha":"2845f42f8b4ee0013da701d1a073580d0e19af5e","url":"https://api.github.com/repos/openai/codex/git/trees/2845f42f8b4ee0013da701d1a073580d0e19af5e"},"url":"https://api.github.com/repos/openai/codex/git/commits/5013d108248baad05b897b65aa6e3ca2626d7293","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPCVFCRC1aQ7uu5UhlAAAJ9oQADbyE0a02keLrdQ+P8wjYY0I\n3pFXPguODfx4mkSm2R4C20tCQ+kankRQmXnzBbcDjTPFYS5WbkSgop6tjyQZ4mv9\nUxajNzRaPPBImAhxD0KMkL2ge1E5VsXUTOt8Kx3cfxai+T6m1TbziA93KJoYrB/p\nTclTxP/v99Xgi4l4Ko/UWGEfCTmZ5xkn3d+Qlb1GvSUJCfagEfUEHEQietOyAtHh\nrfpzE42/M2GUA9S1F33NvLZidQJXkOMioZMkHtehWydGAdgPnnUmaGqIEFEg2bPz\n3odcSBFwgtNtTIFjLxZMlimTOIX04tzWA9vNMvdehm44OP+hZb/XWD1uw3tiTAzn\nO3MBss8k6iOmOmc+6EQgnKF1MW9028btsD9xDeWy0M96j6nZMpHggfrjOKvLHFK+\nb2NL5qBL1xGypERKBJEZ9wFkKBlBqAAAY+5Qx+YtCgDqC+xqPdoWUugZ2LpnXHrb\n+pfclgMxR9gHjX5zkCSDfvgv20zyhY8eUmcgrXL3I41wKW3SaQnjgfZRlBW084uU\nOx3MDW6WaCY3ZB2vMP/FUvMfBdEEAc7l6tAFMyaGYnO1uoDcQvSmPC2JDM+Tbx12\nlMGTYdmg8yhPEF3YYpyZVRNgIpncAJEBOjGffUhDZqCrx2mHefbVbzVQVvVsE9Xh\n+syee7owxEnOugpdFfZM\n=HayG\n-----END PGP SIGNATURE-----\n","payload":"tree 2845f42f8b4ee0013da701d1a073580d0e19af5e\nparent a781761eda225ba85c2b3b64ba2b74c0c54fbecf\nauthor Brooks <brooks@openai.com> 1782326597 -0400\ncommitter GitHub <noreply@github.com> 1782326597 +0000\n\n[codex] suppress low usage remaining warnings when credits are available (#28593)\n\n## Why\n\nThe TUI computed proactive `Heads up, you have less than ...` warnings\nbefore considering workspace credits. As a result, users could see\nincluded-limit warnings even when they could continue using Codex with\nworkspace credits.\n\n`has_credits` alone is not sufficient to determine whether finite\ncredits are usable: a spend-control hard limit can cap the reported\nbalance to zero while `has_credits` still reflects the workspace's raw\nbalance. Unlimited credits are the opposite case: they are usable even\nthough no numeric balance is reported.\n\n## What changed\n\n- suppress proactive TUI rate-limit usage warnings and the lower-cost\nmodel nudge when usable workspace credits are available\n- treat credits as usable when `has_credits` is true and either\n`unlimited` is true or the parsed balance is positive\n- continue showing warnings when the usable balance is zero, including\nwhen a spend-control limit has capped otherwise available workspace\ncredits\n- add regression coverage for zero-balance, positive-balance, and\nunlimited workspace-credit snapshots\n\n## Validation\n\n- `just test -p codex-tui rate_limit_usage_warnings_`","verified_at":"2026-06-24T18:43:18Z"}},"url":"https://api.github.com/repos/openai/codex/commits/5013d108248baad05b897b65aa6e3ca2626d7293","html_url":"https://github.com/openai/codex/commit/5013d108248baad05b897b65aa6e3ca2626d7293","comments_url":"https://api.github.com/repos/openai/codex/commits/5013d108248baad05b897b65aa6e3ca2626d7293/comments","author":{"login":"brooks-oai","id":248761967,"node_id":"U_kgDODtPObw","avatar_url":"https://avatars.githubusercontent.com/u/248761967?v=4","gravatar_id":"","url":"https://api.github.com/users/brooks-oai","html_url":"https://github.com/brooks-oai","followers_url":"https://api.github.com/users/brooks-oai/followers","following_url":"https://api.github.com/users/brooks-oai/following{/other_user}","gists_url":"https://api.github.com/users/brooks-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/brooks-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/brooks-oai/subscriptions","organizations_url":"https://api.github.com/users/brooks-oai/orgs","repos_url":"https://api.github.com/users/brooks-oai/repos","events_url":"https://api.github.com/users/brooks-oai/events{/privacy}","received_events_url":"https://api.github.com/users/brooks-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a781761eda225ba85c2b3b64ba2b74c0c54fbecf","url":"https://api.github.com/repos/openai/codex/commits/a781761eda225ba85c2b3b64ba2b74c0c54fbecf","html_url":"https://github.com/openai/codex/commit/a781761eda225ba85c2b3b64ba2b74c0c54fbecf"}]}]