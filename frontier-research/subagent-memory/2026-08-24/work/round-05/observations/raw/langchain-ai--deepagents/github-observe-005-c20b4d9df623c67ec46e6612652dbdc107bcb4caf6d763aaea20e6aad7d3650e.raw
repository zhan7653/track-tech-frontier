url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"30f4845af1313d6f67d3468cd6bde5c0b921a80d","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/30f4845af1313d6f67d3468cd6bde5c0b921a80d","html_url":"https://github.com/langchain-ai/deepagents/commit/30f4845af1313d6f67d3468cd6bde5c0b921a80d"}]},{"sha":"30f4845af1313d6f67d3468cd6bde5c0b921a80d","node_id":"C_kwDOPTymldoAKDMwZjQ4NDVhZjEzMTNkNmY2N2QzNDY4Y2Q2YmRlNWMwYjkyMWE4MGQ","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-08-13T19:30:46Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-13T19:30:46Z"},"message":"chore(ci): collapse draft instructions into a details toggle (#5490)\n\nThe maintainer-instructions echo that `@release-bot draft` appends to\nits draft comment now renders inside a collapsed `<details>` block, with\na 📝 emoji and bold summary line. This keeps the draft comment cleaner\nwhile still making the steering text auditable on the PR.\n\n---\n\nThe draft comment previously ended with a plain `Drafted with maintainer\ninstructions: ...` line, which could be long and visually noisy.\nWrapping it in a toggle preserves the audit trail without cluttering the\ncomment body.","tree":{"sha":"60baa1b0f68333c749d724125796629f8cf13ff6","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/60baa1b0f68333c749d724125796629f8cf13ff6"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/30f4845af1313d6f67d3468cd6bde5c0b921a80d","comment_count":0,"verification":{"verifie