ndabot%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dependabot%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/dependabot%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/dependabot%5Bbot%5D/repos","events_url":"https://api.github.com/users/dependabot%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/dependabot%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"9f1e40bfeea28dee2155b4a57f5babd0a53534cf","url":"https://api.github.com/repos/langchain-ai/langgraph/commits/9f1e40bfeea28dee2155b4a57f5babd0a53534cf","html_url":"https://github.com/langchain-ai/langgraph/commit/9f1e40bfeea28dee2155b4a57f5babd0a53534cf"}]},{"sha":"9f1e40bfeea28dee2155b4a57f5babd0a53534cf","node_id":"C_kwDOKFU0ldoAKDlmMWU0MGJmZWVhMjhkZWUyMTU1YjRhNTdmNWJhYmQwYTUzNTM0Y2Y","commit":{"author":{"name":"dependabot[bot]","email":"49699333+dependabot[bot]@users.noreply.github.com","date":"2026-07-25T07:33:43Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-25T07:33:43Z"},"message":"chore(deps): bump setuptools from 80.9.0 to 83.0.0 in /libs/langgraph (#8435)\n\nBumps [setuptools](https://github.com/pypa/setuptools) from 80.9.0 to\n83.0.0.\n<details>\n<summary>Changelog</summary>\n<p><em>Sourced from <a\nhref=\"https://github.com/pypa/setuptools/blob/main/NEWS.rst\">setuptools's\nchangelog</a>.</em></p>\n<blockquote>\n<h1>v83.0.0</h1>\n<h2>Features</h2>\n<ul>\n<li>Require Python 3.10 or later.</li>\n</ul>\n<h2>Bugfixes</h2>\n<ul>\n<li><code>MANIFEST.in</code> matching (via <code>FileList</code>) is now\ninsensitive to Unicode\nnormalization form. A pattern authored in one form (e.g. NFC, as\ntypically\nsaved by editors) now matches a file whose name is stored on disk in\nanother\n(e.g. NFD, as produced by macOS APFS/HFS+). Previously an\n<code>exclude</code>,\n<code>global-exclude</code>, <code>recursive-exclude</code>, or\n<code>prune</code> rule could silently\nfail to drop a non-ASCII-named file from the source distribution,\npublishing\nit despite the exclusion -- see GHSA-h35f-9h28-mq5c.</li>\n</ul>\n<h2>Deprecations and Removals</h2>\n<ul>\n<li><code>pypa/distutils#334</code></li>\n</ul>\n<h1>v82.0.1</h1>\n<h2>Bugfixes</h2>\n<ul>\n<li>Fix the loading of <code>launcher manifest.xml</code> file. (<a\nhref=\"https://redirect.github.com/pypa/setuptools/issues/5047\">#5047</a>)</li>\n<li>Replaced deprecated <code>json.__version__</code> with fixture in\ntests. (<a\nhref=\"https://redirect.github.com/pypa/setuptools/issues/5186\">#5186</a>)</li>\n</ul>\n<h2>Improved Documentation</h2>\n<ul>\n<li>Add advice about how to improve predictability when installing\nsdists. (<a\nhref=\"https://redirect.github.com/pypa/setuptools/issues/5168\">#5168</a>)</li>\n</ul>\n<h2>Misc</h2>\n<ul>\n<li><a\nhref=\"https://redirect.github.com/pypa/setuptools/issues/4941\">#4941</a>,\n<a\nhref=\"https://redirect.github.com/pypa/setuptools/issues/5157\">#5157</a>,\n<a\nhref=\"https://redirect.github.com/pypa/setuptools/issues/5169\">#5169</a>,\n<a\nhref=\"https://redirect.github.com/pypa/setuptools/issues/5175\">#5175</a></li>\n</ul>\n<p>v82.0.0</p>\n<!-- raw HTML omitted -->\n</blockquote>\n<p>... (truncated)</p>\n</details>\n<details>\n<summary>Commits</summary>\n<ul>\n<li><a\nhref=\"https://github.com/pypa/setuptools/commit/6519f728c6f23c992df81a5691ef7655184a20eb\"><code>6519f72</code></a>\nBump version: 82.0.1 → 83.0.0</li>\n<li><a\nhref=\"https://github.com/pypa/setuptools/commit/d1151b125b29a6ee1c7db860f7ee6c365d525b5f\"><code>d1151b1</code></a>\nMerge pull request <a\nhref=\"https://redirect.github.com/pypa/setuptools/issues/5250\">#5250</a>\nfrom pypa/feature/distutils-d7633fbed</li>\n<li><a\nhref=\"https://github.com/pypa/setuptools/commit/a2df31e6a741b0fe775969618fe6a3a3d032e900\"><code>a2df31e</code></a>\nCapture removal of dry_run parameter in changelog.</li>\n<li><a\nhref=\"https://github.com/pypa/setuptools/commit/00144dc3fb6d023fd81cdc26c380a012b084df9b\"><code>00144dc</code></a>\nMoved newsfragment to the release where it occurred.</li>\n<li><a\nhref=\"https://github.com/pypa/setuptools/commit/a4a5a2b160357be77626aa077ddd1d8ee53be50f\"><code>a4a5a2b</code></a>\nAdd news fragment.</li>\n<li><a\nhref=\"https://github.com/pypa/setuptools/commit/77470c23c35031c9e37d7512694ac5ca52bfcaac\"><code>77470c2</code></a>\nMerge <a\nhref=\"https://github.com/pypa/distutils\">https://github.com/pypa/distutils</a>\ninto feature/distutils-d7633fbed</li>\n<li><a\nhref=\"https://github.com/pypa/setuptools/commit/3c43897420f25a1be1afe6eaa905d056009cc736\"><code>3c43897</code></a>\nMerge pull request <a\nhref=\"https://redirect.github.com/pypa/setuptools/issues/5247\">#5247</a>\nfrom pypa/copilot/fix-pypy-version-issue</li>\n<li><a\nhref=\"https://github.com/pypa/setuptools/commit/bb6ea66b4bd01cb35d7c68a1bc61b96d59190269\"><code>bb6ea66</code></a>\nBump PyPy from 3.10 to 3.11 in CI workflow</li>\n<li><a\nhref=\"https://github.com/pypa/setuptools/commit/a2bc3aca2f55eb9b93ea633e58ba68170ce14451\"><code>a2bc3ac</code></a>\nFix broken intersphinx reference to build's installation docs</li>\n<li><a\nhref=\"https://github.com/pypa/setuptools/commit/2d6a739c64cfedc65e1f635af7b52340aac8d99b\"><code>2d6a739</code></a>\nUse stacked parametrize decorators instead of itertools.product</li>\n<li>Additional commits viewable in <a\nhref=\"https://github.com/pypa/setuptools/compare/v80.9.0...v83.0.0\">compare\nview</a></li>\n</ul>\n</details>\n<br />\n\n\n[![Dependabot compatibility\nscore](https://dependabot-badges.githubapp.com/badges/compatibility_score?dependency-name=setuptools&package-manager=uv&previous-version=80.9.0&new-version=83.0.0)](https://docs.github.com/en/github/managing-security-vulnerabilities/about-dependabot-security-updates#about-compatibility-scores)\n\nDependabot will resolve any conflicts with this PR as long as you don't\nalter it yourself. You can also trigger a rebase manually by commenting\n`@dependabot rebase`.\n\n[//]: # (dependabot-automerge-start)\n[//]: # (dependabot-automerge-end)\n\n---\n\n<details>\n<summary>Dependabot commands and options</summary>\n<br />\n\nYou can trigger Dependabot actions by commenting on this PR:\n- `@dependabot rebase` will rebase this PR\n- `@dependabot recreate` will recreate this PR, overwriting any edits\nthat have been made to it\n- `@dependabot show <dependency name> ignore conditions` will show all\nof the ignore conditions of the specified dependency\n- `@dependabot ignore this major version` will close this PR and stop\nDependabot creating any more for this major version (unless you reopen\nthe PR or upgrade to it yourself)\n- `@dependabot ignore this minor version` will close this PR and stop\nDependabot creating any more for this minor version (unless you reopen\nthe PR or upgrade to it yourself)\n- `@dependabot ignore this dependency` will close this PR and stop\nDependabot creating any more for this dependency (unless you reopen the\nPR or upgrade to it yourself)\nYou can disable automated security fix PRs for this repo from the\n[Security Alerts\npage](https://github.com/langchain-ai/langgraph/network/alerts).\n\n</details>\n\nSigned-off-by: dependabot[bot] <support@github.com>\nCo-authored-by: dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com>","tree":{"sha":"5dcd6f0a84e992369e6fa50d6c2c13085614460e","url":"https://api.github.com/repos/langchain-ai/langgraph/git/trees/5dcd6f0a84e992369e6fa50d6c2c13085614460e"},"url":"https://api.github.com/repos/langchain-ai/langgraph/git/commits/9f1e40bfeea28dee2155b4a57f5babd0a53534cf","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqZGbXCRC1aQ7uu5UhlAAASDUQAHjiP1YqIyRiAqtPPQZ86csD\nZJX6JzvaXpjBEMDFT9s1AVpSbueAXSPbG57FJbzaFlBflWTnHJYGalSSm84HslXw\nMMGS9IFczEA467d+NS8bz9W0K7M8QZzdVStr1235OfIAAQEkAr9vQR3YsHsGUVM1\nVYQX07bOUNbfDuB9wpnhlDvUfP3NB3s20xbqblqVHMkO5dCZCvV+Z26KRtp5F/tK\ndCmdLOk7bSm4J90UDAlKcB+sgro3o0I6fKFyZ2nwEc3gLRHi1u9FGtFBPDirftNq\n1Fqek9wwoq/AktxquBnYXTL61Oc/DY3ZNHva8ZSmF+j6Nt0KlHubqOpuQx0PNDMk\n/KrLL2efaY8d7j2MOv/lRy1q0fqnjT0Hw5NnRot/T+OkNwRe/UF60FJyBjBgtFI6\n7WdTFfBqQEkD/uacf94tCseOolK1wR0s70cdAWInyur+o+kKhySun+tsw3hARnF8\nraREDHQ9/Jdc0z1+FkgDQs3TvsHPHUmjqMuIUplMAXWQ4rX0RSUv7ohAAH+m5xz+\nIVnapUmbZuJzC4SmHvENecas0g4who5WB0Z9JZpRi/bJtpsZYqZkgDBDy5hd4XVK\nb0g8H0MHgowKWxHin2B4ZMkFUZnvmDX1OxbX8Nty6x4BLmvqxZGTu/v6Cu02hgXM\nIzyr5zIs8qyFxeU5OJCp\n=NTtC\n-----END PGP SIGNATURE-----\n","payload":"tree 5dcd6f0a84e992369e6fa50d6c2c13085614460e\nparent 1e1ca88dad9c7e708263257fa9fc27a3fbdfff68\nauthor dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com> 1784964823 -0700\ncommitter GitHub <noreply@github.com> 1784964823 -0700\n\nchore(deps): bump setuptools from 80.9.0 to 83.0.0 in /libs/langgraph (#8435)\n\nBumps [setuptools](https://github.com/pypa/setuptools) from 80.9.0 to\n83.0.0.\n<details>\n<summary>Changelog</summary>\n<p><em>Sourced from <a\nhref=\"https://github.com/pypa/setuptools/blob/main/NEWS.rst\">setuptools's\nchangelog</a>.</em></p>\n<blockquote>\n<h1>v83.0.0</h1>\n<h2>Features</h2>\n<ul>\n<li>Require Python 3.10 or later.</li>\n</ul>\n<h2>Bugfixes</h2>\n<ul>\n<li><code>MANIFEST.in</code> matching (via <code>FileList</code>) is now\ninsensitive to Unicode\nnormalization form. A pattern authored in one form (e.g. NFC, as\ntypically\nsaved by editors) now matches a file whose name is stored on disk in\nanother\n(e.g. NFD, as produced by macOS APFS/HFS+). Previously an\n<code>exclude</code>,\n<code>global-exclude</code>, <code>recursive-exclude</code>, or\n<code>prune</code> rule could silently\nfail to drop a non-ASCII-named file from the source distribution,\npublishing\nit despite the exclusion -- see GHSA-h35f-9h28-mq5c.</li>\n</ul>\n<h2>Deprecations and Removals</h2>\n<ul>\n<li><code>pypa/distutils#334</code></li>\n</ul>\n<h1>v82.0.1</h1>\n<h2>Bugfixes</h2>\n<ul>\n<li>Fix the loading of <code>launcher manifest.xml</code> file. (<a\nhref=\"https://redirect.github.com/pypa/setuptools/issues/5047\">#5047</a>)</li>\n<li>Replaced deprecated <code>json.__version__</code> with fixture in\ntests. (<a\nhref=\"https://redirect.github.com/pypa/setuptools/issues/5186\">#5186</a>)</li>\n</ul>\n<h2>Improved Documentation</h2>\n<ul>\n<li>Add advice about how to improve predictability when installing\nsdists. (<a\nhref=\"https://redirect.github.com/pypa/setuptools/issues/5168\">#5168</a>)</li>\n</ul>\n<h2>Misc</h2>\n<ul>\n<li><a\nhref=\"https://redirect.github.com/pypa/setuptools/issues/4941\">#4941</a>,\n<a\nhref=\"https://redirect.github.com/pypa/setuptools/issues/5157\">#5157</a>,\n<a\nhref=\"https://redirect.github.com/pypa/setuptools/issues/5169\">#5169</a>,\n<a\nhref=\"https://redirect.github.com/pypa/setuptools/issues/5175\">#5175</a></li>\n</ul>\n<p>v82.0.0</p>\n<!-- raw HTML omitted -->\n</blockquote>\n<p>... (truncated)</p>\n</details>\n<details>\n<summary>Commits</summary>\n<ul>\n<li><a\nhref=\"https://github.c