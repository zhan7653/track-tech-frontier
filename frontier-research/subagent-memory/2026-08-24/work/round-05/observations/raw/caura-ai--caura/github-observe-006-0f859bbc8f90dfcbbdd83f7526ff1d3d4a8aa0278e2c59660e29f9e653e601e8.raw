0)","verified_at":"2026-07-17T12:07:28Z"}},"url":"https://api.github.com/repos/caura-ai/caura/commits/730fc19459381a8b5898df35490d589598592f61","html_url":"https://github.com/caura-ai/caura/commit/730fc19459381a8b5898df35490d589598592f61","comments_url":"https://api.github.com/repos/caura-ai/caura/commits/730fc19459381a8b5898df35490d589598592f61/comments","author":{"login":"Eldad-Caura","id":250841599,"node_id":"U_kgDODvOJ_w","avatar_url":"https://avatars.githubusercontent.com/u/250841599?v=4","gravatar_id":"","url":"https://api.github.com/users/Eldad-Caura","html_url":"https://github.com/Eldad-Caura","followers_url":"https://api.github.com/users/Eldad-Caura/followers","following_url":"https://api.github.com/users/Eldad-Caura/following{/other_user}","gists_url":"https://api.github.com/users/Eldad-Caura/gists{/gist_id}","starred_url":"https://api.github.com/users/Eldad-Caura/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Eldad-Caura/subscriptions","organizations_url":"https://api.github.com/users/Eldad-Caura/orgs","repos_url":"https://api.github.com/users/Eldad-Caura/repos","events_url":"https://api.github.com/users/Eldad-Caura/events{/privacy}","received_events_url":"https://api.github.com/users/Eldad-Caura/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"ca82758a72ba5fea0fdacdd8603a668cee2d97a9","url":"https://api.github.com/repos/caura-ai/caura/commits/ca82758a72ba5fea0fdacdd8603a668cee2d97a9","html_url":"https://github.com/caura-ai/caura/commit/ca82758a72ba5fea0fdacdd8603a668cee2d97a9"}]},{"sha":"ca82758a72ba5fea0fdacdd8603a668cee2d97a9","node_id":"C_kwDOSOAAX9oAKGNhODI3NThhNzJiYTVmZWEwZmRhY2RkODYwM2E2NjhjZWUyZDk3YTk","commit":{"author":{"name":"ran-taig","email":"ran@caura.ai","date":"2026-07-17T06:46:54Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-17T06:46:54Z"},"message":"feat(interview): Interviewer Phase 1 — server side (submit endpoint, worker, scheduler) (#558)\n\n## Summary\n\nServer half of **the Interviewer** — a third ingestion mode\n(pull/reflective): on a per-tenant cadence, a node's buffered activity\nwindow is synthesized into a structured report and ingested as typed\nmemories. Full design + fork resolutions:\n`docs/plans/interviewer-phase1-decisions.md` (committed here); parent\ndesign docs live in the MemClaw doc store\n(`design_docs/interviewer-feature-plan`,\n`design_docs/interviewer-phase1-spec`).\n\n**Dark by default** — everything is gated on the new per-tenant\n`interviewer.enabled` setting (default `false`, `skills_factory`\nposture): the scheduler queues nothing for disabled tenants and the\nendpoint refuses them (defense in depth). Merging this changes zero\nbehavior for existing tenants.\n\n### What's in\n\n- **`POST /api/v1/interview/submit`** (`routes/interview.py`) — receives\none node's event window (C2 shape, ≤500 events), validates cursors/seq\nordering, 207 partial semantics, 502 on total failure (plugin must not\nprune).\n- **Interview worker** (`services/interview_service.py`):\n- **Mask before the LLM** — deterministic `common.governance.scan/mask`\non every event **on receipt**, because the write-pipeline governance\ngate only protects persistence and this worker runs the LLM\npre-persistence (bulk re-runs the gate → defense in depth).\n- **Chunked map-reduce** (~24k-token chunks) → fixed-JSON report →\nmapped onto the 14-type enum (`worked_on→episode`, `decisions→decision`,\n`outcomes→outcome`, `blockers→task`, `open_questions→fact`,\n`preferences_learned→preference`), section label kept in\n`metadata.category`, **source event time → `ts_valid_start`** so\nbatching doesn't corrupt freshness ranking.\n- **Effectively-once:** server-derived attempt id\n`sha1(node:cursor_from:cursor_to)` through the existing `/memories/bulk`\nidempotency; **forward-only per-node watermark** (`interview_watermarks`\ndoc) advances only after the bulk commits.\n- Attribution: memory `agent_id` = the worker (subject);\n`metadata.written_by = \"interviewer\"`.\n- **Scheduler** — hourly wall-clock-aligned core-operations tick → `POST\n/admin/interview/schedule/run` → per opted-in tenant, per **live\nnon-sentinel** node: at most one pending `interview_request` on the\nexisting `/fleet/commands` rail, dueness = watermark `last_interview_at`\nvs tenant `period_hours`, resumes at `last_seq + 1` (submit-cap backlog\ndrains across ticks). Payload echoes the fleet-node UUID so the plugin\nsubmits under the watermark's key.\n- **Settings** — `interviewer.{enabled, period_hours, template_id}` +\nleaf types + bounds; new zero-cost `tenants/interviewer-enabled` storage\nquery (agent-digest pattern).\n- Commands are queued **unsigned** in OSS — plugin default is\npermissive; enterprise signing gateways sign in transit\n(`MEMCLAW_REQUIRE_SIGNED_COMMANDS` opts into fail-closed).\n\n### Not in this PR (PR-2, plugin side)\n\nOn-disk interview buffer + `interview_request` command handler in the\nOpenClaw plugin (tasks tracked; contract frozen by this PR: payload\n`{node_id, since_seq, template_id, period_hours}` → submit `{node_id,\nagent_id, cursor_from/to, events[]}`).\n\n## Test plan\n\n- `tests/test_api_interview.py` (14): settings gate, cursor/seq\nvalidation, happy path asserting typed memories + provenance via the\nreal list endpoint, **idempotent retry** (resubmit → 0 written),\n**forward-only watermark**, full schedule loop (queue → no stacking\nwhile pending → ack+submit → not due), **window resume** (`since_seq ==\nwatermark+1`), plus unit tests for masking (email+card actually\nstripped), chunking (nothing dropped), report merge dedup/caps, type\nmapping.\n- core-operations suite (41) green incl. the wall-clock-alignment\ninvariant (new `seconds_until_next_utc_top_of_hour`); adjacent suites\n(settings/idempotency/keystones/forge-cron, 58) green; ruff clean.\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\n\n---------\n\nSigned-off-by: Ran Taig <ran@caura.ai>\nCo-authored-by: Claude Opus 4.8 <noreply@anthropic.com>","tree":{"sha":"3f45ff43768cc97978bdb271c5053fd9eb7f3328","url":"https://api.github.com/repos/caura-ai/caura/git/trees/3f45ff43768cc97978bdb271c5053fd9eb7f3328"},"url":"https://api.github.com/repos/caura-ai/caura/git/commits/ca82758a72ba5fea0fdacdd8603a668cee2d97a9","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqWc/eCRC1aQ7uu5UhlAAAKR8QAJt/wsAET7f55Vx7TnECwtIW\nMZHJP8+SDGfrCFMePw0zrZk+/h5nSshnZLH1X7RFe1Ab3Y/O3LpAPjXtYCPXrHiu\nZwGXBMdZFJ5a+WikHD9Mz7Opx106N/gHvBlw//htvCulGVciNsWFLxfSSq86lOb0\nWzZ3OzyC2feEfxzHJl5pPT2E+mRoms3GomVUSsT36RbFfrV2qPGW3mgOAOsEeCBR\nRdHVNx6N7Kd2z/SYvPSRoN+GbY6Zo74R8Ms1Q2b/nE7DpdyNqt4gzUhl2VbXL3tC\npuukj0Apf7xMHW/mdBst3tV5J9XRCm9S7zpWvQ4uHRTyX14GMWJRP54obo0RtXI/\ne2SuBDYC0P3SMhS3IQ6ZbSFZpNAafA4flSv/HOlC9gtBwDIQSRZxR+eESvmlr5Ad\nSE0O9JgZ1ODhWRj1L9exbX+4ZfymNcED5fZfnQpu56x6PqQmsTW7d4T+/mcmkS20\nmKX/rYF9/EaPE+dRGJxxmxZ1oxpxnRmb1x+LhYXDvQIprH7VG8NRfaJLy9zzv0ef\ncFRjwrUZMu5cimzoyts5mGZitr5Rp3I/1X8f23PvsFYJFzmWwN2hTwdwslEhyptD\np0vj/rsnLZR8e7gmv2KBN1co8Tarv/HNDYS6Lk3EidNjV0dWDkXu53yQfwbQ3hIo\ntIBiV6DJkBp16WKOlZws\n=C8/q\n-----END PGP SIGNATURE-----\n","payload":"tree 3f45ff43768cc97978bdb271c5053fd9eb7f3328\nparent 809bb2b2e03dc41102dd891248b3fb6867765ad1\nauthor ran-taig <ran@caura.ai> 1784270814 +0300\ncommitter GitHub <noreply@github.com> 1784270814 +0300\n\nfeat(interview): Interviewer Phase 1 — server side (submit endpoint, worker, scheduler) (#558)\n\n## Summary\n\nServer half of **the Interviewer** — a third ingestion mode\n(pull/reflective): on a per-tenant cadence, a node's buffered activity\nwindow is synthesized into a structured report and ingested as typed\nmemories. Full design + fork resolutions:\n`docs/plans/interviewer-phase1-decisions.md` (committed here); parent\ndesign docs live in the MemClaw doc store\n(`design_docs/interviewer-feature-plan`,\n`design_docs/interviewer-phase1-spec`).\n\n**Dark by default** — everything is gated on the new per-tenant\n`interviewer.enabled` setting (default `false`, `skills_factory`\nposture): the scheduler queues nothing for disabled tenants and the\nendpoint refuses them (defense in depth). Merging this changes zero\nbehavior for existing tenants.\n\n### What's in\n\n- **`POST /api/v1/interview/submit`** (`routes/interview.py`) — receives\none node's event window (C2 shape, ≤500 events), validates cursors/seq\nordering, 207 partial semantics, 502 on total failure (plugin must not\nprune).\n- **Interview worker** (`services/interview_service.py`):\n- **Mask before the LLM** — deterministic `common.governance.scan/mask`\non every event **on receipt**, because the write-pipeline governance\ngate only protects persistence and this worker runs the LLM\npre-persistence (bulk re-runs the gate → defense in depth).\n- **Chunked map-reduce** (~24k-token chunks) → fixed-JSON report →\nmapped onto the 14-type enum (`worked_on→episode`, `decisions→decision`,\n`outcomes→outcome`, `blockers→task`, `open_questions→fact`,\n`preferences_learned→preference`), section label kept in\n`metadata.category`, **source event time → `ts_valid_start`** so\nbatching doesn't corrupt freshness ranking.\n- **Effectively-once:** server-derived attempt id\n`sha1(node:cursor_from:cursor_to)` through the existing `/memories/bulk`\nidempotency; **forward-only per-node watermark** (`interview_watermarks`\ndoc) advances only after the bulk commits.\n- Attribution: memory `agent_id` = the worker (subject);\n`metadata.written_by = \"interviewer\"`.\n- **Scheduler** — hourly wall-clock-aligned core-operations tick → `POST\n/admin/interview/schedule/run` → per opted-in tenant, per **live\nnon-sentinel** node: at most one pending `interview_request` on the\nexisting `/fleet/commands` rail, dueness = watermark `last_interview_at`\nvs tenant `period_hours`, resumes at `last_seq + 1` (submit-cap backlog\ndrains across ticks). Payload echoes the fleet-node UUID so the plugin\nsubmits under the watermark's key.\n- **Settings** — `interviewer.{enabled, period_hours, template_id}` +\nleaf types + bounds; new zero-cost `tenants/interviewer-enabled` storage\nquery (agent-digest pattern).\n- Commands are queued **unsigned** in OSS — plugin default is\npermissive; enterprise signing gateways sign in transit\n(`MEMCLAW_REQUIRE_SIGNED_COMMANDS` opts into fail-closed).\n\n### Not in this PR (PR-2, plugin side)\n\nOn-disk interview buffer + `interview_request` command handler in the\nOpenClaw plugin (tasks tracked; contract frozen by this PR: payload\n`{node_id, since_seq, template_id, period_hours}` → submit `{node_id,\nagent_id, cursor_from/to, events[]}`).\n\n## Test plan\n\n- `tests/test_api_interview.py` (14): settings gate, cursor/seq\nvalidation, happy path asserting typed memories + provenance via the\nreal list endpoint, **idempotent retry** (resubmit → 0 written),\n**forward-only watermark**, full schedule loop (queue → no stacking\nwhile pending → ack+submit → not due), **window resume** (`since_seq ==\nwatermark+1`), plus unit tests for masking (email+card actually\nstripped), chunking (nothing dropped), report merge dedup/caps, type\nmapping.\n- core-operations suite (41) green incl. the wall-clock-alignment\ninvariant (new `seconds_until_next_utc_top_of_hour`); adjacent suites\n(settings/idempotency/keystones/forge-cron, 58) green; ruff clean.\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\n\n---------\n\nSigned-off-by: Ran Taig <ran@caura.ai>\nCo-authored-by: Claude Opus 4.8 <noreply@anthropic.com>","verified_at":"2026-07-17T06:46:54Z"}},"url":"https://api.github.com/repos/caura-ai/caura/commits/ca82758a72ba5fea0fdacdd8603a668cee2d97a9","html_url":"https://github.com/caura-ai/caura/commit/ca82758a72ba5fea0fdacdd8603a668cee2d97a9","comments_url":"https://api.github.com/repos/caura-ai/caura/commits/ca82758a72ba5fea0fdacdd8603a668cee2d97a9/comments","author":{"login":"ran-taig","id":254242316,"node_id":"U_kgDODyduDA","avatar_url":"https://avatars.githubusercontent.com/u/254242316?v=4","gravatar_id":"","url":"https://api.github.com/users/ran-taig","html_url":"https://github.com/ran-taig","followers_url":"https://api.github.com/users/ran-taig/followers","following_url":"https://api.github.com/users/ran-taig/following{/other_user}","gists_url":"https://api.github.com/users/ran-taig/gists{/gist_id}","starred_url":"https://api.github.com/users/ran-taig/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ran-taig/subscriptions","organizations_url":"https://api.github.com/users/ran-taig/orgs","repos_url":"https://api.github.com/users/ran-taig/repos","events_url":"https://api.github.com/users/ran-taig/events{/privacy}","received_events_url":"https://api.github.com/users/ran-taig/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"809bb2b2e03dc41102dd891248b3fb6867765ad1","url":"https://api.github.com/repos/caura-ai/caura/commits/809bb2b2e03dc41102dd891248b3fb6867765ad1","html_url":"https://github.com/caura-ai/caura/commit/809bb2b2e03dc41102dd891248b3fb6867765ad1"}]},{"sha":"809bb2b2e03dc41102dd891248b3fb6867765ad1","node_id":"C_kwDOSOAAX9oAKDgwOWJiMmIyZTAzZGM0MTEwMmRkODkxMjQ4YjNmYjY4Njc3NjVhZDE","commit":{"author":{"name":"Eldad Dahan","email":"eldad@caura.ai","date":"2026-07-16T20:41:39Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-16T20:41:39Z"},"message":"feat(memories): surface agent display_name on memory responses (#559)","tree":{"sha":"7caba0993eee04df2e765121526b95293df38a41","url":"https://api.github.com/repos/caura-ai/caura/git/trees/7caba0993eee04df2e765121526b95293df38a41"},"url":"https://api.github.com/repos/caura-ai/caura/git/commits/809bb2b2e03dc41102dd891248b3fb6867765ad1","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqWUIECRC1aQ7uu5UhlAAA6KUQAHXy0nWNVVXRgWCRxw1eNSDq\nqb8IR/ZmTxidmy7EQoA18ujTKN5H/KppipssubyxW+rgx8AX3HLq7GmZYNbGgRvY\nnWbhZFmxdWlRgfIhzCV446VXZTIyUpXhLGup3uU/g+SqZkz44FyF2kXb