[{"sha":"94427aaf46fadfe4228fbcffdc85b94fe7ef6341","node_id":"C_kwDOOYsS4doAKDk0NDI3YWFmNDZmYWRmZTQyMjhmYmNmZmRjODViOTRmZTdlZjYzNDE","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-06-12T17:21:00Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T17:21:00Z"},"message":"Use uv as Python SDK build backend (#27901)\n\n## Summary\n\nReplace Hatchling with uv's build backend for the Python SDK. The\nbackend infers the `src/openai_codex` module from the normalized project\nname and standard source layout, so no uv-specific package configuration\nis required.\n\nThis keeps Python packaging within the uv toolchain already used for\ndependency management and release builds. A controlled before-and-after\nPEP 517 comparison produced identical wheel package paths, bytes,\npermissions, and semantic metadata. The sdist retains the SDK package\ntree, root README, and project metadata while dropping the unrelated\nexamples README that Hatch included through its broad include matching.","tree":{"sha":"8ea1e0a6281df2cc4c20456dc6fea1302b386580","url":"https://api.github.com/repos/openai/codex/git/trees/8ea1e0a6281df2cc4c20456dc6fea1302b386580"},"url":"https://api.github.com/repos/openai/codex/git/commits/94427aaf46fadfe4228fbcffdc85b94fe7ef6341","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLD/8CRC1aQ7uu5UhlAAA4F0QAC9HzZVjDKcsTdQDR2wQWkIa\nPUL5mUtE39TdtfDx/LyDyRpPu9Y5XSKE40vAvJWuz0BJocDVxaGHB07/F2/0O+xJ\nw7plqu1xtt+rWnfuEB9h3M2im6T8apFdzJ9hPwtixTlxgo3r86n3PG8NboeXX1EN\noS3InYLaW9QYNYmUaG87w56o2GPkcRo6RqffYe/ghrEXkPU9CWkvMsH1nXNZ3upj\nb4zXK/hUW3T7LC73rYgyVAXuX9yuEJnoz/JGrtY1JDkSMjT2Z+CgsDk8JVL3dTIA\nsg//9cr5vTufaIlTeuR4D1wLJ2Ny0IpD1LM4K/8s7WTbid/k29wlCDofb0Sxk5AF\ndjVq/YZXCs+uX+/a2/hxGN1Rhg1BYB7cNv8dsKn6Yo/fdognfcjnqXBnzleSUewN\ni5h85ZUh8hj9xDg5NYGk+otIudU3NtcQmO4zWjz0EXbCIQMotN07bGAapmgRZhwx\nA6L8axUi6VI2X+IpmVVQtqHFGL3GiyQhQ+D7hUODQ1WiBg938yXevBIt5+qPeR9F\nXiH13qfshnr4KcRRWsWzOCW8PlopLb6umyeNiwQ/B5yAG07V2bfe6BL8G9yNLHvC\nkgvmDXcyFnqwaN9igt6VQsFT80tFaItfEKph5TESzsj2U+BcBiQ2gTw4GhinmJLT\nd3/yQBtJbLYgwPOJ6uAj\n=j/Eo\n-----END PGP SIGNATURE-----\n","payload":"tree 8ea1e0a6281df2cc4c20456dc6fea1302b386580\nparent d735ef162f538d8e571778182a51ad5e9f795dfb\nauthor Charlie Marsh <charliemarsh@openai.com> 1781284860 -0400\ncommitter GitHub <noreply@github.com> 1781284860 +0000\n\nUse uv as Python SDK build backend (#27901)\n\n## Summary\n\nReplace Hatchling with uv's build backend for the Python SDK. The\nbackend infers the `src/openai_codex` module from the normalized project\nname and standard source layout, so no uv-specific package configuration\nis required.\n\nThis keeps Python packaging within the uv toolchain already used for\ndependency management and release builds. A controlled before-and-after\nPEP 517 comparison produced identical wheel package paths, bytes,\npermissions, and semantic metadata. The sdist retains the SDK package\ntree, root README, and project metadata while dropping the unrelated\nexamples README that Hatch included through its broad include matching.","verified_at":"2026-06-12T17:21:00Z"}},"url":"https://api.github.com/repos/openai/codex/commits/94427aaf46fadfe4228fbcffdc85b94fe7ef6341","html_url":"https://github.com/openai/codex/commit/94427aaf46fadfe4228fbcffdc85b94fe7ef6341","comments_url":"https://api.github.com/repos/openai/codex/commits/94427aaf46fadfe4228fbcffdc85b94fe7ef6341/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"d735ef162f538d8e571778182a51ad5e9f795dfb","url":"https://api.github.com/repos/openai/codex/commits/d735ef162f538d8e571778182a51ad5e9f795dfb","html_url":"https://github.com/openai/codex/commit/d735ef162f538d8e571778182a51ad5e9f795dfb"}]},{"sha":"d735ef162f538d8e571778182a51ad5e9f795dfb","node_id":"C_kwDOOYsS4doAKGQ3MzVlZjE2MmY1MzhkOGU1NzE3NzgxODJhNTFhZDVlOWY3OTVkZmI","commit":{"author":{"name":"Brent Traut","email":"btraut@openai.com","date":"2026-06-12T16:30:25Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T16:30:25Z"},"message":"tui: Allow extra o's in /goal command (#27814)\n\n## Why\n\nThe TUI rejected playful `/goal` spellings such as `/goooooooooooal`,\neven though Codex Apps accepts them for the World Cup promotion. This\nkeeps the TUI behavior consistent without changing how the canonical\ncommand is presented.\n\n## How it works\n\nBuilt-in command lookup recognizes lowercase `go+al` as the existing\n`goal` command after normal exact-name parsing fails. The command\ncatalog remains unchanged, so autocomplete continues to advertise\n`/goal` normally.\n\n## Verification\n\nAdded lookup-level and end-to-end TUI coverage for the flexible\nspelling. The focused tests, scoped Clippy checks, and formatting pass.\nThe full `codex-tui` suite passed 2,833 of 2,835 tests; the two failing\nguardian feature-flag tests reproduce unchanged on fresh `origin/main`.","tree":{"sha":"38d82efd0428349b0b0b8c76fc74ca2d484a3ff7","url":"https://api.github.com/repos/openai/codex/git/trees/38d82efd0428349b0b0b8c76fc74ca2d484a3ff7"},"url":"https://api.github.com/repos/openai/codex/git/commits/d735ef162f538d8e571778182a51ad5e9f795dfb","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLDQhCRC1aQ7uu5UhlAAAEHQQAHggB8zlIPe9VKdQfdoN80UT\nJHsDV/a7kSYYFyQELHFemCjVQ2kniT786oH1vBbzP4/xuxzRR54YhteQC2Jprjft\nWVkajH/WYsv0vxroEnBXf30KHPacDUykjUiny05A93/o711B+obpJPW6HTdRBaa7\nRXpxXTFH7VunPWkCvYgqAlz+4Fw5p47u1MGnKZGaHNvt+SzkGp+n+PtppuAgIase\ndyBTiWI/oSDxKX7VySftfqjHvlbsHu+tQE0Vf5kKalMrD3fKUSGwZakT3GkiCr3s\nyMvhlYCBJDiE8iu6EGWz8+CGIjtgtuocDoOj+OOlK8Y23kcJ5e6qKcYnsaKbPAeH\nGi8RVPeuLtwHnIqHnzMElpomCe3auOUi91rx8xLwmokUPHvZDEUkJ1cRhVPu9d0z\nsQDqFFqe9qKNEgjxqnp4xmWt7L86THjv903QAprzq2Ug8YB0QfS561YA35q29gQm\neY67W6tPyCLuQS012zpJOHKu+m5nqGUKTGrjZiye6pT93Ya7a3QrCNpWKh3b+f0C\nEc9uUsJ0Wa46BIkFNAIWeybufP3jD82Y1+SijO1FUHpNug+OtV7j0d4bNzpD3lbT\nYphKyLbgRtfg/naMMq75ItplaoBMd/hi1UyJS0UCM6GWvh0fd4lKEOdpuktjF2MV\nSr4gx4NhswqP2MlqhSqS\n=cLTJ\n-----END PGP SIGNATURE-----\n","payload":"tree 38d82efd0428349b0b0b8c76fc74ca2d484a3ff7\nparent 096e5e76a2aea174ec7e30e14adaa4963840fb37\nauthor Brent Traut <btraut@openai.com> 1781281825 -0700\ncommitter GitHub <noreply@github.com> 1781281825 -0700\n\ntui: Allow extra o's in /goal command (#27814)\n\n## Why\n\nThe TUI rejected playful `/goal` spellings such as `/goooooooooooal`,\neven though Codex Apps accepts them for the World Cup promotion. This\nkeeps the TUI behavior consistent without changing how the canonical\ncommand is presented.\n\n## How it works\n\nBuilt-in command lookup recognizes lowercase `go+al` as the existing\n`goal` command after normal exact-name parsing fails. The command\ncatalog remains unchanged, so autocomplete continues to advertise\n`/goal` normally.\n\n## Verification\n\nAdded lookup-level and end-to-end TUI coverage for the flexible\nspelling. The focused tests, scoped Clippy checks, and formatting pass.\nThe full `codex-tui` suite passed 2,833 of 2,835 tests; the two failing\nguardian feature-flag tests reproduce unchanged on fresh `origin/main`.","verified_at":"2026-06-12T16:30:25Z"}},"url":"https://api.github.com/repos/openai/codex/commits/d735ef162f538d8e571778182a51ad5e9f795dfb","html_url":"https://github.com/openai/codex/commit/d735ef162f538d8e571778182a51ad5e9f795dfb","comments_url":"https://api.github.com/repos/openai/codex/commits/d735ef162f538d8e571778182a51ad5e9f795dfb/comments","author":{"login":"btraut-openai","id":284131405,"node_id":"U_kgDOEO-ATQ","avatar_url":"https://avatars.githubusercontent.com/u/284131405?v=4","gravatar_id":"","url":"https://api.github.com/users/btraut-openai","html_url":"https://github.com/btraut-openai","followers_url":"https://api.github.com/users/btraut-openai/followers","following_url":"https://api.github.com/users/btraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/btraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/btraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/btraut-openai/subscriptions","organizations_url":"https://api.github.com/users/btraut-openai/orgs","repos_url":"https://api.github.com/users/btraut-openai/repos","events_url":"https://api.github.com/users/btraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/btraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"096e5e76a2aea174ec7e30e14adaa4963840fb37","url":"https://api.github.com/repos/openai/codex/commits/096e5e76a2aea174ec7e30e14adaa4963840fb37","html_url":"https://github.com/openai/codex/commit/096e5e76a2aea174ec7e30e14adaa4963840fb37"}]},{"sha":"096e5e76a2aea174ec7e30e14adaa4963840fb37","node_id":"C_kwDOOYsS4doAKDA5NmU1ZTc2YTJhZWExNzRlYzdlMzBlMTRhZGFhNDk2Mzg0MGZiMzc","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-06-12T16:26:08Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T16:26:08Z"},"message":"Persist update dismissal without cache (#27783)\n\n## Summary\n\nChoosing “Don’t remind me” can silently fail when `version.json`\ndisappears before dismissal because `dismiss_version` returns success\nwithout writing anything. The same update can then reappear on the next\nlaunch.\n\nInitialize a minimal `VersionInfo` from the selected version when the\ncache cannot be read, then persist the dismissal through the existing\nwrite path.\n\nFixes #27147","tree":{"sha":"523a07643dcee0c962c933275ed4cb135e746af1","url":"https://api.github.com/repos/openai/codex/git/trees/523a07643dcee0c962c933275ed4cb135e746af1"},"url":"https://api.github.com/repos/openai/codex/git/commits/096e5e76a2aea174ec7e30e14adaa4963840fb37","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLDMgCRC1aQ7uu5UhlAAAR/YQAFfzO63NV7WsyNOBfrFz8m05\n6xSAFfNTlAcg7pG/d5408S0ZxM1A6M/IR6cKt6CnV55yE9VG283UGZC03DTFycYo\nKH0/U6IOoExPO3oKn7TeRxHMxETG6GMdVK6SnpwylcU477Eldqqm2BO3LtT8B/Dj\nOyy/Mu9R9az/QrFA1jPTJ4pP/HA2f51PnY8wbojtNOyQWjcGco46PV0J3db2aoeD\nMMz+NTHGdVB7f13dGqHKt0l4CGzCvoG9ABvjxi+3o98DYpzwPY6hGclIG6mK0yX7\ngFkdyliyEv2GR5XWXh19olLrgavZcbMCkbyzZnRPhRPfPgaDLEuDXzF/RIeerEsa\nbS8OCTtd+yl5ElWF4/vWxm3KG/plu4GFdytsT9ETQZ+fYWqYaqY2d992nPvlOY4D\nNTYVPFFhS16nLtPgaex8y9SR17ttEn+qaOR4iUOoopQKTk+4FAiX4MaNMbrcerNv\nBeHec5HzX7HmilfFhTcnGnt4EdKOPCH7zNpBfnv8cGuRodvgI+8chXAqBtM3SMFf\nZJc/0iEYbBkTmoMPattT2sypkWbG6P+1WVEO+u2SNFBItUQ16XGHg5lXvOLkrwEg\naLF5RIc6tVyfojrdssXWdFiNmHRnzp6WnLu4HvRX9JPWHKwp+s2/E7SGw6qVDA4T\n0cCzTQs3yPJFBuhi2v1q\n=tq3y\n-----END PGP SIGNATURE-----\n","payload":"tree 523a07643dcee0c962c933275ed4cb135e746af1\nparent c375deaf66618bb4c9cf29166e23dfc41a665826\nauthor Eric Traut <etraut@openai.com> 1781281568 -0700\ncommitter GitHub <noreply@github.com> 1781281568 -0700\n\nPersist update dismissal without cache (#27783)\n\n## Summary\n\nChoosing “Don’t remind me” can silently fail when `version.json`\ndisappears before dismissal because `dismiss_version` returns success\nwithout writing anything. The same update can then reappear on the next\nlaunch.\n\nInitialize a minimal `VersionInfo` from the selected version when the\ncache cannot be read, then persist the dismissal through the existing\nwrite path.\n\nFixes #27147","verified_at":"2026-06-12T16:26:08Z"}},"url":"https://api.github.com/repos/openai/codex/commits/096e5e76a2aea174ec7e30e14adaa4963840fb37","html_url":"https://github.com/openai/codex/commit/096e5e76a2aea174ec7e30e14adaa4963840fb37","comments_url":"https://api.github.com/repos/openai/codex/commits/096e5e76a2aea174ec7e30e14adaa4963840fb37/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c375deaf66618bb4c9cf29166e23dfc41a665826","url":"https://api.github.com/repos/openai/codex/commits/c375deaf66618bb4c9cf29166e23dfc41a665826","html_url":"https://github.com/openai/codex/commit/c375deaf66618bb4c9cf29166e23dfc41a665826"}]},{"sha":"c375deaf66618bb4c9cf29166e23dfc41a665826","node_id":"C_kwDOOYsS4doAKGMzNzVkZWFmNjY2MThiYjRjOWNmMjkxNjZlMjNkZmM0MWE2NjU4MjY","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-06-12T16:10:07Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T16:10:07Z"},"message":"Use dependency groups for Python SDK tooling (#27538)\n\n## Summary\n\n`just fmt` previously used `uv run --with ruff` to make Ruff available.\nBecause `--with` creates an ephemeral overlay outside the project\nlockfile, uv periodically re-resolved Ruff (by default every 10 minutes)\ninstead of using the version recorded in `uv.lock`.\n\nMove the Python SDK tooling dependencies from the published `dev` extra\ninto `format`, `test`, and composed `dev` dependency groups. The\nformatter now selects only the locked `format` group, contributor and CI\nsetup explicitly sync the `dev` group, and CI and release commands reuse\nthat environment with `--frozen --no-sync`. The scripts formatter also\nuses its project's locked Ruff dependency instead of an ephemeral\noverlay.\n\nValidated the Python 3.12 SDK suite (119 passed, 38 skipped) and the\nrepository formatter.","tree":{"sha":"02f3898644f82e241f12f62d0581c53aa3053d93","url":"https://api.github.com/repos/openai/codex/git/trees/02f3898644f82e241f12f62d0581c53aa3053d93"},"url":"https://api.github.com/repos/openai/codex/git/commits/c375deaf66618bb4c9cf29166e23dfc41a665826","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLC9fCRC1aQ7uu5UhlAAALaAQADs0c2MmrEgsxKp2KiHP/RDZ\nh7BS9l7dswED5AkjubRlfeRTXBMG6ru3DMXIQ2lvDYPvGa56t/OtdVWPJh6efJhW\nfgtVe2h8X/NYiyYXN+4vtMG9uBIfVohqN9wwEamNjNkaA5CaHlLUjCIFPkiKGNI/\nKX3B4SckZ9HOFwqh1BDXmFBkkJETebGzMH/nWhfxI/oHXMZuTwgNDPrs2k/NMGY4\nT8xKtEyK2QFrmCFoFB7SBzFUwtpl6cLQ+JUNj+xPhYSCvLfxlwjjGLO/7Ezg5Mv7\nIOkaDXmSwMO7sWRKlMdU9yQgQPPhEHR5G0YfBD6uNzBoFgr7vBw5DK/XqsyeewCm\nlpC2vZP2Ink3uefn9sVPmcSSXrOQbopIcUTnxqjU015B6i62aj0tyQGD3MnTQnng\nYoIks5f6ZyREDJKtIv5V1sqBs9FEf8lrFZqR88/wgNa02myuJg/tCHo2zVu309YO\nTbWWZDebYhFnSdMEswdM2UglYuqqrsYxguleNl7B1kuR+eKn1r0qSo3PvJDw3RqW\n0XWmLE2XkxPVw/f8bblZB6Y7YM/aBD4mpmtALEEgI1kJqNx9kVJQ5//AC3P18MA6\n04oGUZTST4XOK0kmba8gracQDzd59yfqzrAwLvKrSzBtmGRhfS2bQFGKz98MXuJt\nD7falvSJF+mnfYHeniBZ\n=4GvG\n-----END PGP SIGNATURE-----\n","payload":"tree 02f3898644f82e241f12f62d0581c53aa3053d93\nparent 3cac2e0d3fdb8bbfe3e75ceb23b5b84fc5f38676\nauthor Charlie Marsh <charliemarsh@openai.com> 1781280607 -0400\ncommitter GitHub <noreply@github.com> 1781280607 +0000\n\nUse dependency groups for Python SDK tooling (#27538)\n\n## Summary\n\n`just fmt` previously used `uv run --with ruff` to make Ruff available.\nBecause `--with` creates an ephemeral overlay outside the project\nlockfile, uv periodically re-resolved Ruff (by default every 10 minutes)\ninstead of using the version recorded in `uv.lock`.\n\nMove the Python SDK tooling dependencies from the published `dev` extra\ninto `format`, `test`, and composed `dev` dependency groups. The\nformatter now selects only the locked `format` group, contributor and CI\nsetup explicitly sync the `dev` group, and CI and release commands reuse\nthat environment with `--frozen --no-sync`. The scripts formatter also\nuses its project's locked Ruff dependency instead of an ephemeral\noverlay.\n\nValidated the Python 3.12 SDK suite (119 passed, 38 skipped) and the\nrepository formatter.","verified_at":"2026-06-12T16:10:07Z"}},"url":"https://api.github.com/repos/openai/codex/commits/c375deaf66618bb4c9cf29166e23dfc41a665826","html_url":"https://github.com/openai/codex/commit/c375deaf66618bb4c9cf29166e23dfc41a665826","comments_url":"https://api.github.com/repos/openai/codex/commits/c375deaf66618bb4c9cf29166e23dfc41a665826/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"3cac2e0d3fdb8bbfe3e75ceb23b5b84fc5f38676","url":"https://api.github.com/repos/openai/codex/commits/3cac2e0d3fdb8bbfe3e75ceb23b5b84fc5f38676","html_url":"https://github.com/openai/codex/commit/3cac2e0d3fdb8bbfe3e75ceb23b5b84fc5f38676"}]},{"sha":"3cac2e0d3fdb8bbfe3e75ceb23b5b84fc5f38676","node_id":"C_kwDOOYsS4doAKDNjYWMyZTBkM2ZkYjhiYmZlM2U3NWNlYjIzYjViODRmYzVmMzg2NzY","commit":{"author":{"name":"Alex Zamoshchin","email":"alexz@openai.com","date":"2026-06-12T16:06:58Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T16:06:58Z"},"message":"[ez][codex-rs] Support approvals reviewer in app defaults (#27075)\n\n[from codex]\n\n## Summary\n\n- add `approvals_reviewer` support to `[apps._default]`\n- resolve connected-app reviewers in per-app, app-default, then global\norder\n- expose the setting through the v2 config API and regenerate schema\nfixtures\n\n## Context\n\nPR #25167 added `apps.<connector_id>.approvals_reviewer`, but the shared\napp defaults table could not specify the reviewer. This extends the same\nbehavior to `[apps._default]` while preserving per-app overrides.\n\nManaged `allowed_approvals_reviewers` requirements still constrain both\ndefault and per-app values. A disallowed app value falls back to the\nglobal reviewer, and non-app MCP servers continue using the global\nreviewer.\n\n## Testing\n\n- `just write-config-schema`\n- `just write-app-server-schema`\n- `just fmt`\n- `just test -p codex-config`\n- `just test -p codex-core app_approvals_reviewer`\n- `just test -p codex-app-server-protocol`\n- `just test -p codex-app-server config_read_includes_apps`","tree":{"sha":"b86f348eb276b6cd02fd9176c5ae0beef12ad064","url":"https://api.github.com/repos/openai/codex/git/trees/b86f348eb276b6cd02fd9176c5ae0beef12ad064"},"url":"https://api.github.com/repos/openai/codex/git/commits/3cac2e0d3fdb8bbfe3e75ceb23b5b84fc5f38676","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLC6iCRC1aQ7uu5UhlAAA4AsQAIsmBPEivNPdkZ+pdu6yDdSC\nsQp5RFHNHD6HTm1Fb7wUMw5DhNKiIwaKk+/d+nV9ig0CCpFsxccE9MJDTA+IV4ak\n4eHJMxytw7DO9ArP3G41v0bj5EIDxWVtNiWm359Fn5txeakEmnzfSQJkqXWhEbx0\n1oflINELPeuUM3LNZKXU5iQSnvo+7DcWtITmptjnFzGCqIx9DhmfSEtSAytCXNrw\n8dJcfctNl/4vNowH74JkpDTZzUQwUPJyaKYv8Vpqr076sCQuVwXVelzhn8E2fgFA\n9UDUKjEiqkiO+NSXaB2aZ0sMKLQyfV+TM1JR+MmKNVqJscKb1oF1pJiMoBsuI6VW\nxQAHIflFeFEfF7dMcDTOvgwJ4umF9nj82xC5MXr535mzFIf/fK/VAdgMKoxmYw2V\nq2+FmPmo1BSKjd/ZK1T+dNAmc6DcGh+MdcyAvLJZ0pKthhXLYNt6dBYUetgrm+uB\noqGSG2wxS/qAUGNhqLD2ORzUM7lCIrfrr14CiIA+gFhRE93qc2VAXX/OjVJ+wLxx\n3viFq90hXXLtVWAj4ZrPG84GnVS6phx5fVKOwA4BLSqffZuhFNENVXX9KfCtWjNU\nSsH1/myUE707JEYkiix0qwaWdF8DvbRPvWXXAPuLdA2DuZSU+90CzUDRVAURDTCI\nLPHBHi2bwIAtK6YvonTC\n=uUJw\n-----END PGP SIGNATURE-----\n","payload":"tree b86f348eb276b6cd02fd9176c5ae0beef12ad064\nparent 5b8e3c6d4017ea24087a8755017b3a7ecf495f07\nauthor Alex Zamoshchin <alexz@openai.com> 1781280418 -0700\ncommitter GitHub <noreply@github.com> 1781280418 -0700\n\n[ez][codex-rs] Support approvals reviewer in app defaults (#27075)\n\n[from codex]\n\n## Summary\n\n- add `approvals_reviewer` support to `[apps._default]`\n- resolve connected-app reviewers in per-app, app-default, then global\norder\n- expose the setting through the v2 config API and regenerate schema\nfixtures\n\n## Context\n\nPR #25167 added `apps.<connector_id>.approvals_reviewer`, but the shared\napp defaults table could not specify the reviewer. This extends the same\nbehavior to `[apps._default]` while preserving per-app overrides.\n\nManaged `allowed_approvals_reviewers` requirements still constrain both\ndefault and per-app values. A disallowed app value falls back to the\nglobal reviewer, and non-app MCP servers continue using the global\nreviewer.\n\n## Testing\n\n- `just write-config-schema`\n- `just write-app-server-schema`\n- `just fmt`\n- `just test -p codex-config`\n- `just test -p codex-core app_approvals_reviewer`\n- `just test -p codex-app-server-protocol`\n- `just test -p codex-app-server config_read_includes_apps`","verified_at":"2026-06-12T16:06:59Z"}},"url":"https://api.github.com/repos/openai/codex/commits/3cac2e0d3fdb8bbfe3e75ceb23b5b84fc5f38676","html_url":"https://github.com/openai/codex/commit/3cac2e0d3fdb8bbfe3e75ceb23b5b84fc5f38676","comments_url":"https://api.github.com/repos/openai/codex/commits/3cac2e0d3fdb8bbfe3e75ceb23b5b84fc5f38676/comments","author":{"login":"zamoshchin-openai","id":185120305,"node_id":"U_kgDOCwi2MQ","avatar_url":"https://avatars.githubusercontent.com/u/185120305?v=4","gravatar_id":"","url":"https://api.github.com/users/zamoshchin-openai","html_url":"https://github.com/zamoshchin-openai","followers_url":"https://api.github.com/users/zamoshchin-openai/followers","following_url":"https://api.github.com/users/zamoshchin-openai/following{/other_user}","gists_url":"https://api.github.com/users/zamoshchin-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/zamoshchin-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zamoshchin-openai/subscriptions","organizations_url":"https://api.github.com/users/zamoshchin-openai/orgs","repos_url":"https://api.github.com/users/zamoshchin-openai/repos","events_url":"https://api.github.com/users/zamoshchin-openai/events{/privacy}","received_events_url":"https://api.github.com/users/zamoshchin-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"5b8e3c6d4017ea24087a8755017b3a7ecf495f07","url":"https://api.github.com/repos/openai/codex/commits/5b8e3c6d4017ea24087a8755017b3a7ecf495f07","html_url":"https://github.com/openai/codex/commit/5b8e3c6d4017ea24087a8755017b3a7ecf495f07"}]},{"sha":"5b8e3c6d4017ea24087a8755017b3a7ecf495f07","node_id":"C_kwDOOYsS4doAKDViOGUzYzZkNDAxN2VhMjQwODdhODc1NTAxN2IzYTdlY2Y0OTVmMDc","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-06-12T15:58:08Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T15:58:08Z"},"message":"Reject transcript backtrack in side conversations (#27791)\n\n## Why\n\nFixes #27735.\n\nSide conversations are ephemeral forks, and thread rollback currently\nrequires persisted thread history. The normal backtrack path already\nrejected editing previous prompts in side conversations, but\ntranscript-mode backtrack could still call the rollback path and surface\nthe core `thread/rollback` failure as a TUI error.\n\n## What changed\n\n- Moved the existing side-conversation edit rejection message into\n`app_backtrack.rs` so backtrack rollback code can reuse it.\n- Added a side-conversation guard in `apply_backtrack_rollback` so\ntranscript-mode confirmation is rejected before submitting\n`thread/rollback`.\n\n## Verification\n\n- `just test -p codex-tui\napp::tests::side_backtrack_rejection_reports_unavailable_message_snapshot`","tree":{"sha":"a61ddbe37dab05ad49d1931bfc4488cb4d677eea","url":"https://api.github.com/repos/openai/codex/git/trees/a61ddbe37dab05ad49d1931bfc4488cb4d677eea"},"url":"https://api.github.com/repos/openai/codex/git/commits/5b8e3c6d4017ea24087a8755017b3a7ecf495f07","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLCyQCRC1aQ7uu5UhlAAAKtUQAFcKonfAAX7SttDgQ8m0c8QB\nWWcw3XKwGuZBpuWfw4I4ViDBkSfP9ZQpdrfQaWY7v3T3RpmSa0bABHnHMx+HNMjx\n5iYY75gioXUruv8bz7VH64paVSDHQNv5ZMlzoluUv7PaQBTG6R5iVvCRBBS+Tjr2\njFK29f3oUnL86Eq4tWvMXTbg9D84RLpJcq9hzngHexFN8YLOjZvOfqaJmicWdYHw\nFpNPh4OQ34XI09mYDg0otVOBo7wpkWMspKnDuBrH8Epdn2H5i0zYvfmrIfTkHuQn\nW70+eFg6fXeNW3Qm5uPMbdlyiFDEBc/JagYP9JUiksdbC9zHWPY7vO2XFKQf5303\nnqR9rjJWVGdDeP9tXMe8YRh1/L0/Ka+TbJTTZzjY1OcjIUKgOvzFFnJ5DgCDWHg7\n8o1tgIPFTVJhL5mcH1AJ6alW1paHDHXwdZ2DWEYMz13gbU5djiux5DnOpqaP2L9A\nA0obg+2hX3RQHV5ZVLQPcTNhlImXYf1A7EPBKptKiV5VhxqUp8K8q5dq6EIO8ObN\nIxtspzWJ6yoX+qMTIj1yhKDPiDd2UYEJhiD0VP/2l4csXewxtM5jvkhkW7Pv5tn1\n4gcSoILU/6XJHd11DzUsNsGn0g4g1OZK6sb1oIlWQyF9gQc65CRrzR+YjV4kl/gB\njiA13xtqkuglRVoaHCQ/\n=dKYk\n-----END PGP SIGNATURE-----\n","payload":"tree a61ddbe37dab05ad49d1931bfc4488cb4d677eea\nparent b65fe3d8976d6fcc44ee6c6cf988654af5fc4d2d\nauthor Eric Traut <etraut@openai.com> 1781279888 -0700\ncommitter GitHub <noreply@github.com> 1781279888 -0700\n\nReject transcript backtrack in side conversations (#27791)\n\n## Why\n\nFixes #27735.\n\nSide conversations are ephemeral forks, and thread rollback currently\nrequires persisted thread history. The normal backtrack path already\nrejected editing previous prompts in side conversations, but\ntranscript-mode backtrack could still call the rollback path and surface\nthe core `thread/rollback` failure as a TUI error.\n\n## What changed\n\n- Moved the existing side-conversation edit rejection message into\n`app_backtrack.rs` so backtrack rollback code can reuse it.\n- Added a side-conversation guard in `apply_backtrack_rollback` so\ntranscript-mode confirmation is rejected before submitting\n`thread/rollback`.\n\n## Verification\n\n- `just test -p codex-tui\napp::tests::side_backtrack_rejection_reports_unavailable_message_snapshot`","verified_at":"2026-06-12T15:58:09Z"}},"url":"https://api.github.com/repos/openai/codex/commits/5b8e3c6d4017ea24087a8755017b3a7ecf495f07","html_url":"https://github.com/openai/codex/commit/5b8e3c6d4017ea24087a8755017b3a7ecf495f07","comments_url":"https://api.github.com/repos/openai/codex/commits/5b8e3c6d4017ea24087a8755017b3a7ecf495f07/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b65fe3d8976d6fcc44ee6c6cf988654af5fc4d2d","url":"https://api.github.com/repos/openai/codex/commits/b65fe3d8976d6fcc44ee6c6cf988654af5fc4d2d","html_url":"https://github.com/openai/codex/commit/b65fe3d8976d6fcc44ee6c6cf988654af5fc4d2d"}]},{"sha":"b65fe3d8976d6fcc44ee6c6cf988654af5fc4d2d","node_id":"C_kwDOOYsS4doAKGI2NWZlM2Q4OTc2ZDZmY2M0NGVlNmM2Y2Y5ODg2NTRhZjVmYzRkMmQ","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-12T14:24:08Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T14:24:08Z"},"message":"fix: serialize auth environment tests (#27879)\n\n## Summary\n- serialize the remaining login tests that mutate or read the\nprocess-global auth environment\n- include Bedrock auth-manager tests in the existing `codex_auth_env`\nserial group\n\n## Root cause\nThe login unit-test binary runs tests concurrently. One test removed\n`CODEX_ACCESS_TOKEN` without joining the existing serial group, while\nseveral Bedrock tests constructed `AuthManager` and read that same\nprocess-global environment outside the group. An interleaving could\nrestore a stale personal access token while another test was loading\nfile-backed auth, causing the observed mismatched `/whoami` request\ncount and related auth-state flakes.\n\n## Verification\n- `just fmt`\n- `git diff --check`\n- `bazel test //codex-rs/login:login-unit-tests --nocache_test_results\n--runs_per_test=20 --test_output=errors` (20/20 passed)\n- `just test -p codex-login` (135/135 passed)","tree":{"sha":"38cd601374ef85fb70eb1cad5b25070f8719248f","url":"https://api.github.com/repos/openai/codex/git/trees/38cd601374ef85fb70eb1cad5b25070f8719248f"},"url":"https://api.github.com/repos/openai/codex/git/commits/b65fe3d8976d6fcc44ee6c6cf988654af5fc4d2d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLBaICRC1aQ7uu5UhlAAAbFgQAAMYBgC6dMqo7d0uT5Kzl/Mk\n/b4Kjqn1CDeBjEnF2yWLLek13hgEdTC+dAeQWqaD/p9XkkocH+bTXt2C4OdoL4aR\nqRGY4VouhObHz96htgcQbnMXRpfyELbvmw4gvWlPUtefM4vqVf4MyYameHubbkqy\nED/hvtXSjUUE+vmC/jo7E1lV5Txkl0Pt+nYtZaEiyu8IkNUU8XUHHESZbcq6J7Hk\niZU6eDUAzvYd587HCZMj8DiM1+z+i7s+sc4CNrSByfg8WCHUHJjknMSSoguFOPlz\nvWrVIERVpjdpG2mXBrwPwVMbzahtNkdQeKwIEuOT8E1NEo6e6UKwOsHu1flTyy7p\nytTaP7PJYBuA5zJexweyW8dA62/nwHrkY9Eoi/V1DOOi2iEtc92xdN+YmZumg85f\nBKhKgbplAwOGbQ4+Gy7UrQvJ4QxyM9+qOC0aCzcyoNEwN2qAh/avCNmx0VYkVgsh\nttRCaJIBKRrY3w742V/eR5e4k2PzZjx9Va6/348tD5J5RXY55vSZ48wQ40zT6kCv\nkzVS9Rp9mOPgqWrsOWCJCgk1p0IEp7V9LuoXeJRDUlhPSFWwuzbVeVmN5bB6D2yF\nRACbb30+rbmmmJg9cTtAhofX4Ni0K2otLMWOJz7DBAP5xfe74wOqmoV29tq9PGI2\nB2ix6yLCX7wXyJxgExXL\n=c1am\n-----END PGP SIGNATURE-----\n","payload":"tree 38cd601374ef85fb70eb1cad5b25070f8719248f\nparent 743a4147d96f19d1e15e124a303f018870015ad8\nauthor jif <jif@openai.com> 1781274248 +0100\ncommitter GitHub <noreply@github.com> 1781274248 +0200\n\nfix: serialize auth environment tests (#27879)\n\n## Summary\n- serialize the remaining login tests that mutate or read the\nprocess-global auth environment\n- include Bedrock auth-manager tests in the existing `codex_auth_env`\nserial group\n\n## Root cause\nThe login unit-test binary runs tests concurrently. One test removed\n`CODEX_ACCESS_TOKEN` without joining the existing serial group, while\nseveral Bedrock tests constructed `AuthManager` and read that same\nprocess-global environment outside the group. An interleaving could\nrestore a stale personal access token while another test was loading\nfile-backed auth, causing the observed mismatched `/whoami` request\ncount and related auth-state flakes.\n\n## Verification\n- `just fmt`\n- `git diff --check`\n- `bazel test //codex-rs/login:login-unit-tests --nocache_test_results\n--runs_per_test=20 --test_output=errors` (20/20 passed)\n- `just test -p codex-login` (135/135 passed)","verified_at":"2026-06-12T14:24:09Z"}},"url":"https://api.github.com/repos/openai/codex/commits/b65fe3d8976d6fcc44ee6c6cf988654af5fc4d2d","html_url":"https://github.com/openai/codex/commit/b65fe3d8976d6fcc44ee6c6cf988654af5fc4d2d","comments_url":"https://api.github.com/repos/openai/codex/commits/b65fe3d8976d6fcc44ee6c6cf988654af5fc4d2d/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"743a4147d96f19d1e15e124a303f018870015ad8","url":"https://api.github.com/repos/openai/codex/commits/743a4147d96f19d1e15e124a303f018870015ad8","html_url":"https://github.com/openai/codex/commit/743a4147d96f19d1e15e124a303f018870015ad8"}]},{"sha":"743a4147d96f19d1e15e124a303f018870015ad8","node_id":"C_kwDOOYsS4doAKDc0M2E0MTQ3ZDk2ZjE5ZDFlMTVlMTI0YTMwM2YwMTg4NzAwMTVhZDg","commit":{"author":{"name":"stefanstokic-oai","email":"stefanstokic@openai.com","date":"2026-06-12T14:19:17Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T14:19:17Z"},"message":"[codex] restore source-specific import copy (#27703)\n\n## Summary\n\n- restore source-specific wording across the `/import` picker, lifecycle\nmessages, diagnostics, and help text\n- update the matching Unix and Windows snapshots\n- leave import behavior unchanged\n\n## Why\n\nThe import path currently supports one source, so the UI should identify\nthat source directly instead of presenting the flow as\nprovider-agnostic.\n\n## Validation\n\n- `just test -p codex-tui external_agent_config_migration` (12 passed)\n- `just fix -p codex-tui`\n- `just fmt`","tree":{"sha":"3a24a4b3c525c93f90b885b3a8d69faa8afb7049","url":"https://api.github.com/repos/openai/codex/git/trees/3a24a4b3c525c93f90b885b3a8d69faa8afb7049"},"url":"https://api.github.com/repos/openai/codex/git/commits/743a4147d96f19d1e15e124a303f018870015ad8","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLBVlCRC1aQ7uu5UhlAAAX6cQAFBpbh6qzWRqUOL6WivZl6B+\ntk7kmjuolMU7R4W3dn5Hjb7nol97w9+/fRijhKw18TbuQzAAWd0+uVmPTwpVFjF4\nbLl35Bw51FH6Z7hu2K4O+tKWO6PkFf3q/UUctOqHgsgK3hPUo7xlA19ZSPXExbWt\nHOl9R60cGEuJP4pfrKvkjxyCUD3n5Qef1EeN285JLbyI9Mdtc7gHqd9hoVsnhgWH\nFqK7SZU72bSZ/5pHUUT10G0bLNFMnq4DvD6kkA5vX171miLn+aHQwFghaWopL0kw\nV9wuTZyrwsFl0Ur9fSa6X25TzC8lS/5BnB7/RAXORu7fyaDzb2qeAJwbEi/tI3To\n738H+1Vo3ZzTgedLzew8K41+9YvCLc14S4hMTtV6VFVFXoHvlYP4yItOlynYb0xP\nJMd8og3PbwIb42m1UO+HFm6xluOec+GEPinyaucgNRlXOuDPLwFwqYZZdjBlc1Qu\n67vI7XM4k20G4Fs6mNh1KmoxBLODisf0FxpN2I/5LEwk168H6C1kpwAAFhAldYgO\n/nFjUnaJlvHP9vOLdrAKa8/+6BnhOT70Hqp2VhOzNjQv0Zhq1gJNIf3OG1EKIqfX\nYsIVfhn3DHg+lZouzlFlQhoV0cB3u7Fvl2GlVeBIQB5T3IFC3RPgXv/l4i7Nrhqx\nce2ehoDm36WVQYWDRrtA\n=8Id9\n-----END PGP SIGNATURE-----\n","payload":"tree 3a24a4b3c525c93f90b885b3a8d69faa8afb7049\nparent 17b9f4843e8616af91493ca56ec37c499db564d4\nauthor stefanstokic-oai <stefanstokic@openai.com> 1781273957 -0400\ncommitter GitHub <noreply@github.com> 1781273957 -0400\n\n[codex] restore source-specific import copy (#27703)\n\n## Summary\n\n- restore source-specific wording across the `/import` picker, lifecycle\nmessages, diagnostics, and help text\n- update the matching Unix and Windows snapshots\n- leave import behavior unchanged\n\n## Why\n\nThe import path currently supports one source, so the UI should identify\nthat source directly instead of presenting the flow as\nprovider-agnostic.\n\n## Validation\n\n- `just test -p codex-tui external_agent_config_migration` (12 passed)\n- `just fix -p codex-tui`\n- `just fmt`","verified_at":"2026-06-12T14:19:18Z"}},"url":"https://api.github.com/repos/openai/codex/commits/743a4147d96f19d1e15e124a303f018870015ad8","html_url":"https://github.com/openai/codex/commit/743a4147d96f19d1e15e124a303f018870015ad8","comments_url":"https://api.github.com/repos/openai/codex/commits/743a4147d96f19d1e15e124a303f018870015ad8/comments","author":{"login":"stefanstokic-oai","id":278208182,"node_id":"U_kgDOEJUetg","avatar_url":"https://avatars.githubusercontent.com/u/278208182?v=4","gravatar_id":"","url":"https://api.github.com/users/stefanstokic-oai","html_url":"https://github.com/stefanstokic-oai","followers_url":"https://api.github.com/users/stefanstokic-oai/followers","following_url":"https://api.github.com/users/stefanstokic-oai/following{/other_user}","gists_url":"https://api.github.com/users/stefanstokic-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/stefanstokic-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stefanstokic-oai/subscriptions","organizations_url":"https://api.github.com/users/stefanstokic-oai/orgs","repos_url":"https://api.github.com/users/stefanstokic-oai/repos","events_url":"https://api.github.com/users/stefanstokic-oai/events{/privacy}","received_events_url":"https://api.github.com/users/stefanstokic-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"17b9f4843e8616af91493ca56ec37c499db564d4","url":"https://api.github.com/repos/openai/codex/commits/17b9f4843e8616af91493ca56ec37c499db564d4","html_url":"https://github.com/openai/codex/commit/17b9f4843e8616af91493ca56ec37c499db564d4"}]},{"sha":"17b9f4843e8616af91493ca56ec37c499db564d4","node_id":"C_kwDOOYsS4doAKDE3YjlmNDg0M2U4NjE2YWY5MTQ5M2NhNTZlYzM3YzQ5OWRiNTY0ZDQ","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-12T13:10:05Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T13:10:05Z"},"message":"Extract shared plugin MCP config parsing (#27863)\n\n## Why\n\nWe want a thread-selected plugin to eventually expose stdio MCP servers\nthat run on the executor owning that plugin.\n\nThe existing plugin MCP parser lived inside `core-plugins` and was\ncoupled to the host filesystem loader. Reusing it from an executor\nprovider would either duplicate MCP normalization or make the plugin\npackage layer own MCP runtime semantics. This PR creates the shared\nMCP-owned boundary first.\n\nIn simple terms:\n\n```text\nplugin .mcp.json\n        |\n        v\nshared parser in codex-mcp\n        |\n        +-- Declared placement: preserve current local-plugin behavior\n        |\n        +-- Environment placement: produce config bound to one executor\n```\n\nThis builds on the authority-bound plugin descriptors from #27692. It\nintentionally does not discover, register, or launch executor MCP\nservers yet.\n\n## What changed\n\n- Moved plugin MCP file parsing and normalization from `core-plugins`\ninto `codex-mcp`.\n- Kept support for both existing file shapes: a top-level server map and\nan object containing `mcpServers`.\n- Kept per-server failure isolation: one invalid server does not discard\nvalid siblings, while malformed top-level JSON still fails the whole\nfile.\n- Updated the existing local plugin loader to use `Declared` placement,\npreserving its current transport, OAuth, relative `cwd`, and error\nbehavior.\n- Added `Environment` placement for the next stacked PR:\n- the selected environment ID overrides anything declared by the plugin;\n  - missing stdio `cwd` defaults to the plugin root;\n- relative `cwd` is resolved beneath the plugin root and cannot traverse\noutside it;\n- bare or source-less environment-variable references resolve on a\nnon-local executor;\n- explicit orchestrator environment-variable forwarding is rejected for\nexecutor-owned plugins.\n\n## User impact\n\nNone in this PR. Existing local plugin MCP loading follows the same\nbehavior through the shared parser. The executor placement mode is not\nconnected to thread startup until the follow-up registration PR.\n\n## Assumptions\n\n- A selected capability root's environment is authoritative. A plugin\ncannot redirect its stdio process to the orchestrator or another\nexecutor.\n- Relative working directories belong under the plugin package root.\nExplicit absolute working directories remain valid within the owning\nenvironment.\n- For a non-local executor, unqualified environment-variable names refer\nto that executor. Reading an orchestrator variable requires an explicit\ncontract and is rejected for now.\n- Parsing only produces normalized `McpServerConfig` values. Process\nstartup remains owned by the existing MCP runtime and connection\nmanager.\n\n## Follow-ups\n\n1. Add the executor MCP provider and catalog registration: read the\nselected plugin's MCP config through the same executor filesystem,\nsupport stdio only, freeze the result per active thread, apply managed\npolicy, and resolve name collisions as discovered plugin < selected\nplugin < explicit config.\n2. Install that provider in app-server and add an end-to-end test\nproving `thread/start.selectedCapabilityRoots` launches and calls the\nMCP tool on the selected executor, preserves the frozen registration\nacross refresh, and does not expose it to an unselected thread.\n3. After the initial executor-stdio vertical, define\nresume/fork/environment-replacement semantics, executor HTTP placement,\nwarning delivery, common MCP tool-context bounds, and move remaining MCP\nsource composition above core.\n\n## Verification\n\n- `cargo check -p codex-mcp -p codex-core-plugins --tests`\n- `just bazel-lock-check`\n- Added focused parser coverage for legacy local normalization, executor\nauthority, working-directory handling, and environment-variable\nsourcing.","tree":{"sha":"0c67c3a40f247fec3150796bd7b0f5cb13bcf101","url":"https://api.github.com/repos/openai/codex/git/trees/0c67c3a40f247fec3150796bd7b0f5cb13bcf101"},"url":"https://api.github.com/repos/openai/codex/git/commits/17b9f4843e8616af91493ca56ec37c499db564d4","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLAUtCRC1aQ7uu5UhlAAAPlMQADQDdV3VYCwhpgv94woHSvRk\n1WaA4C6hc6ET4uf1htLoAMNjII7HSpKVd6XfHpc8KYNSz8afAzDEg2hsIvdop+rj\nMeVniIFFBKGQWrmlYB82iu2kAUEes2rvcYTJK5UE/SAJoVM6wANNU9D3//ExjHmB\nxB3uc864VLL9tQUgkA1v63pn8F1oBp1/4TlyNlFB6BxqckTGXXwddBr55zC67NlX\nzfLq5nm2uIZ/pn/T3QGm+YWsrY/wv5k0oUVEZsXsSCzpcIk/dyqJpumUK//c4gSa\n7QanFOaeLU0RmbXLHzTqXOy0ogor1OIvHNuSLkf87UopU4Z7FHfrnQ/JCpVD0xHt\nmYarQav0vMG/7Ktr3qL1UkIq7zI0BBjFSWoVieYDBSZbqBnHzzNpLlMQyF6p5jTb\nwocpguCnWXnZK62ZreRpM77E8cpMMGaIzJ5sXlFr9qVjSxEzHVImVLfBCYR2nGxJ\n66tTOXNd6x3Tq2/iInVxHfaCu/oJieu55SNBnwH4Kh7PvGr5s5O7JqTcrIAO90VH\n6fvvPUyo04h2JaBoqFu1kGaTr7MexL7TDZXhwmGEKsH+MrC9H9JWiAMN+cLiKvSN\ny4SM+2kLwKnhaFzMuJnjhMTaK26W13GSnPXPbHj+Lv1qvuw3QfL/a+8elZPw4QZS\nFj9ZYHmqp/YLrSw9eFB+\n=iY4e\n-----END PGP SIGNATURE-----\n","payload":"tree 0c67c3a40f247fec3150796bd7b0f5cb13bcf101\nparent 267eacfca2de761b2c1aa79b51b6b2bbdad4fab0\nauthor jif <jif@openai.com> 1781269805 +0100\ncommitter GitHub <noreply@github.com> 1781269805 +0200\n\nExtract shared plugin MCP config parsing (#27863)\n\n## Why\n\nWe want a thread-selected plugin to eventually expose stdio MCP servers\nthat run on the executor owning that plugin.\n\nThe existing plugin MCP parser lived inside `core-plugins` and was\ncoupled to the host filesystem loader. Reusing it from an executor\nprovider would either duplicate MCP normalization or make the plugin\npackage layer own MCP runtime semantics. This PR creates the shared\nMCP-owned boundary first.\n\nIn simple terms:\n\n```text\nplugin .mcp.json\n        |\n        v\nshared parser in codex-mcp\n        |\n        +-- Declared placement: preserve current local-plugin behavior\n        |\n        +-- Environment placement: produce config bound to one executor\n```\n\nThis builds on the authority-bound plugin descriptors from #27692. It\nintentionally does not discover, register, or launch executor MCP\nservers yet.\n\n## What changed\n\n- Moved plugin MCP file parsing and normalization from `core-plugins`\ninto `codex-mcp`.\n- Kept support for both existing file shapes: a top-level server map and\nan object containing `mcpServers`.\n- Kept per-server failure isolation: one invalid server does not discard\nvalid siblings, while malformed top-level JSON still fails the whole\nfile.\n- Updated the existing local plugin loader to use `Declared` placement,\npreserving its current transport, OAuth, relative `cwd`, and error\nbehavior.\n- Added `Environment` placement for the next stacked PR:\n- the selected environment ID overrides anything declared by the plugin;\n  - missing stdio `cwd` defaults to the plugin root;\n- relative `cwd` is resolved beneath the plugin root and cannot traverse\noutside it;\n- bare or source-less environment-variable references resolve on a\nnon-local executor;\n- explicit orchestrator environment-variable forwarding is rejected for\nexecutor-owned plugins.\n\n## User impact\n\nNone in this PR. Existing local plugin MCP loading follows the same\nbehavior through the shared parser. The executor placement mode is not\nconnected to thread startup until the follow-up registration PR.\n\n## Assumptions\n\n- A selected capability root's environment is authoritative. A plugin\ncannot redirect its stdio process to the orchestrator or another\nexecutor.\n- Relative working directories belong under the plugin package root.\nExplicit absolute working directories remain valid within the owning\nenvironment.\n- For a non-local executor, unqualified environment-variable names refer\nto that executor. Reading an orchestrator variable requires an explicit\ncontract and is rejected for now.\n- Parsing only produces normalized `McpServerConfig` values. Process\nstartup remains owned by the existing MCP runtime and connection\nmanager.\n\n## Follow-ups\n\n1. Add the executor MCP provider and catalog registration: read the\nselected plugin's MCP config through the same executor filesystem,\nsupport stdio only, freeze the result per active thread, apply managed\npolicy, and resolve name collisions as discovered plugin < selected\nplugin < explicit config.\n2. Install that provider in app-server and add an end-to-end test\nproving `thread/start.selectedCapabilityRoots` launches and calls the\nMCP tool on the selected executor, preserves the frozen registration\nacross refresh, and does not expose it to an unselected thread.\n3. After the initial executor-stdio vertical, define\nresume/fork/environment-replacement semantics, executor HTTP placement,\nwarning delivery, common MCP tool-context bounds, and move remaining MCP\nsource composition above core.\n\n## Verification\n\n- `cargo check -p codex-mcp -p codex-core-plugins --tests`\n- `just bazel-lock-check`\n- Added focused parser coverage for legacy local normalization, executor\nauthority, working-directory handling, and environment-variable\nsourcing.","verified_at":"2026-06-12T13:10:06Z"}},"url":"https://api.github.com/repos/openai/codex/commits/17b9f4843e8616af91493ca56ec37c499db564d4","html_url":"https://github.com/openai/codex/commit/17b9f4843e8616af91493ca56ec37c499db564d4","comments_url":"https://api.github.com/repos/openai/codex/commits/17b9f4843e8616af91493ca56ec37c499db564d4/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"267eacfca2de761b2c1aa79b51b6b2bbdad4fab0","url":"https://api.github.com/repos/openai/codex/commits/267eacfca2de761b2c1aa79b51b6b2bbdad4fab0","html_url":"https://github.com/openai/codex/commit/267eacfca2de761b2c1aa79b51b6b2bbdad4fab0"}]},{"sha":"267eacfca2de761b2c1aa79b51b6b2bbdad4fab0","node_id":"C_kwDOOYsS4doAKDI2N2VhY2ZjYTJkZTc2MWIyYzFhYTc5YjUxYjZiMmJiZGFkNGZhYjA","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-12T11:37:33Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T11:37:33Z"},"message":"Add executor-owned plugin resolution (#27692)\n\n## Why\n\nCCA can select a capability root that lives in an executor environment,\nbut\nCodex only had a host-filesystem plugin loader. Before selected executor\nplugins can contribute MCP servers, we need a small package boundary\nthat can\nanswer:\n\n> Does this selected root contain a plugin, and if so, what does its\nmanifest\n> declare?\n\nThe answer must come from the selected environment's filesystem. A\nfailed\nexecutor lookup must never fall back to the orchestrator filesystem.\n\n## What this changes\n\nThis PR introduces:\n\n```rust\nPluginProvider::resolve(root)\n    -> Result<Option<ResolvedPlugin>, Error>\n```\n\n`ExecutorPluginProvider` resolves one `SelectedCapabilityRoot` through\nits\nexact `environment_id`. It checks the recognized manifest locations,\nreads the\nmanifest through that environment's `ExecutorFileSystem`, and returns an\ninert\n`ResolvedPlugin` containing:\n\n- the opaque selected-root ID;\n- the environment-bound plugin root;\n- the authority-bound manifest resource;\n- parsed metadata and authority-bound component locators.\n\nDescriptor construction rejects manifest or component paths outside the\nselected package root, so consumers cannot accidentally lose the package\nboundary when they receive a resolved plugin.\n\nIf the root has no plugin manifest, resolution returns `None`, allowing\nthe\ncaller to treat it as a standalone capability such as a skill.\n\n```text\nselected root: repo -> env-1:/workspace/repo\n                         |\n                         | env-1 filesystem only\n                         v\n             .codex-plugin/plugin.json\n                         |\n                         v\n        ResolvedPlugin { authority, root, manifest }\n```\n\nThe existing host loader and the new executor provider now share the\nsame\nmanifest parser. Existing `codex-core-plugins::manifest` type paths\nremain\navailable through re-exports, so host behavior and callers are\nunchanged.\n\n## Scope\n\nThis is intentionally a non-user-visible package-resolution PR. It does\nnot:\n\n- parse or register plugin MCP server configurations;\n- activate skills, connectors, hooks, or MCP servers;\n- change app-server wiring;\n- introduce host fallback, caching, or lifecycle behavior.\n\n#27670 has merged, and this PR is now based directly on `main`. Together\nwith\nthe resolved MCP catalog from #27634, it establishes the inputs needed\nfor the\nexecutor stdio MCP vertical without changing the existing MCP runtime.\n\n## Follow-up\n\nThe next PR will consume `ResolvedPlugin`, read its declared/default MCP\nconfig\nthrough the same executor filesystem, bind supported stdio servers to\nthat\nenvironment, and feed those registrations into the resolved MCP catalog.\nAn\napp-server E2E will prove that selecting an executor plugin exposes and\ninvokes\nits tool on the owning executor.\n\nResume/fork semantics, dynamic environment replacement, and non-stdio\nplacement remain separate lifecycle decisions.\n\n## Validation\n\n- `just fmt`\n- `cargo check --tests -p codex-plugin -p codex-core-plugins`\n- `just bazel-lock-check`\n- `git diff --check`\n\nTest targets were compiled but not executed locally; CI will run the\ntest and\nClippy suites.","tree":{"sha":"c2fa01a1da7b93128cd9a71a71a3c26b3e17b57e","url":"https://api.github.com/repos/openai/codex/git/trees/c2fa01a1da7b93128cd9a71a71a3c26b3e17b57e"},"url":"https://api.github.com/repos/openai/codex/git/commits/267eacfca2de761b2c1aa79b51b6b2bbdad4fab0","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK+99CRC1aQ7uu5UhlAAAPT8QAKdPnusQzyihUy/I/F9GdMpg\nVBSuBMAEeASE2NJcmndCESzfSeQn3agpjHhrpJdokn0V4CfEFGOe5BQh0VGL4O47\nSnxNQfW6JOXY4o7IZE2D01rM+TyxuAmWSFHFekMeL1SEIn+GV7zbbchwIsJ/kZ9m\nPfYsdotAM9s9e5Ggw1bukWA9Rvb5MHX8s1W7r5qTzqx5jJenA62xXF+VG1KlBHhI\n2p7FW6qXcKlrirHGPYU4Fmrlh10Cp8xgAS3tfuYEizzxSNRSbAX+U30IzosF8Mbr\n7m+9jsmu8wUi1G0B15o1XBlDINeTShBw1eVCsN9iYHDYSz5z8oRkj1HHoyBOMfM0\nSsqJjRt+1LOlHXFbqBxpGxtk7g4yv1kuNg6T2XVxl1CAsDZCxYTz0RArjbx7fz2f\nGs0KEY98XSRBtn8x4ubRu/cwtBYyAx+enoSdoNygtb4uYM7u/9ljkMo9jEACZYY9\nJdtydSEVfQTuUJd5R5P6WAvtKEaEfvlo3uif1nRYVgE3zbRKoAHhPaYatViPhOlN\nDMM33O7xJCGVLkPswwQ48Us9Pf60yurgY452hvlcPGdAB4TsG1W1tMFi/V+QU/cz\nuEFCMvsFBTIjGa32nIK8TgDJJwTPb4Bi7V+y4wIUgzS2T5xox9/VC252488Kv2O0\n5+pyAsbu2aaBVokCRsyO\n=trSx\n-----END PGP SIGNATURE-----\n","payload":"tree c2fa01a1da7b93128cd9a71a71a3c26b3e17b57e\nparent c09df9e35319e46baa11791d92adabab45d9202a\nauthor jif <jif@openai.com> 1781264253 +0100\ncommitter GitHub <noreply@github.com> 1781264253 +0200\n\nAdd executor-owned plugin resolution (#27692)\n\n## Why\n\nCCA can select a capability root that lives in an executor environment,\nbut\nCodex only had a host-filesystem plugin loader. Before selected executor\nplugins can contribute MCP servers, we need a small package boundary\nthat can\nanswer:\n\n> Does this selected root contain a plugin, and if so, what does its\nmanifest\n> declare?\n\nThe answer must come from the selected environment's filesystem. A\nfailed\nexecutor lookup must never fall back to the orchestrator filesystem.\n\n## What this changes\n\nThis PR introduces:\n\n```rust\nPluginProvider::resolve(root)\n    -> Result<Option<ResolvedPlugin>, Error>\n```\n\n`ExecutorPluginProvider` resolves one `SelectedCapabilityRoot` through\nits\nexact `environment_id`. It checks the recognized manifest locations,\nreads the\nmanifest through that environment's `ExecutorFileSystem`, and returns an\ninert\n`ResolvedPlugin` containing:\n\n- the opaque selected-root ID;\n- the environment-bound plugin root;\n- the authority-bound manifest resource;\n- parsed metadata and authority-bound component locators.\n\nDescriptor construction rejects manifest or component paths outside the\nselected package root, so consumers cannot accidentally lose the package\nboundary when they receive a resolved plugin.\n\nIf the root has no plugin manifest, resolution returns `None`, allowing\nthe\ncaller to treat it as a standalone capability such as a skill.\n\n```text\nselected root: repo -> env-1:/workspace/repo\n                         |\n                         | env-1 filesystem only\n                         v\n             .codex-plugin/plugin.json\n                         |\n                         v\n        ResolvedPlugin { authority, root, manifest }\n```\n\nThe existing host loader and the new executor provider now share the\nsame\nmanifest parser. Existing `codex-core-plugins::manifest` type paths\nremain\navailable through re-exports, so host behavior and callers are\nunchanged.\n\n## Scope\n\nThis is intentionally a non-user-visible package-resolution PR. It does\nnot:\n\n- parse or register plugin MCP server configurations;\n- activate skills, connectors, hooks, or MCP servers;\n- change app-server wiring;\n- introduce host fallback, caching, or lifecycle behavior.\n\n#27670 has merged, and this PR is now based directly on `main`. Together\nwith\nthe resolved MCP catalog from #27634, it establishes the inputs needed\nfor the\nexecutor stdio MCP vertical without changing the existing MCP runtime.\n\n## Follow-up\n\nThe next PR will consume `ResolvedPlugin`, read its declared/default MCP\nconfig\nthrough the same executor filesystem, bind supported stdio servers to\nthat\nenvironment, and feed those registrations into the resolved MCP catalog.\nAn\napp-server E2E will prove that selecting an executor plugin exposes and\ninvokes\nits tool on the owning executor.\n\nResume/fork semantics, dynamic environment replacement, and non-stdio\nplacement remain separate lifecycle decisions.\n\n## Validation\n\n- `just fmt`\n- `cargo check --tests -p codex-plugin -p codex-core-plugins`\n- `just bazel-lock-check`\n- `git diff --check`\n\nTest targets were compiled but not executed locally; CI will run the\ntest and\nClippy suites.","verified_at":"2026-06-12T11:37:34Z"}},"url":"https://api.github.com/repos/openai/codex/commits/267eacfca2de761b2c1aa79b51b6b2bbdad4fab0","html_url":"https://github.com/openai/codex/commit/267eacfca2de761b2c1aa79b51b6b2bbdad4fab0","comments_url":"https://api.github.com/repos/openai/codex/commits/267eacfca2de761b2c1aa79b51b6b2bbdad4fab0/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c09df9e35319e46baa11791d92adabab45d9202a","url":"https://api.github.com/repos/openai/codex/commits/c09df9e35319e46baa11791d92adabab45d9202a","html_url":"https://github.com/openai/codex/commit/c09df9e35319e46baa11791d92adabab45d9202a"}]},{"sha":"c09df9e35319e46baa11791d92adabab45d9202a","node_id":"C_kwDOOYsS4doAKGMwOWRmOWUzNTMxOWU0NmJhYTExNzkxZDkyYWRhYmFiNDVkOTIwMmE","commit":{"author":{"name":"rka-oai","email":"rka@openai.com","date":"2026-06-12T09:49:17Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T09:49:17Z"},"message":"[code-mode] Reject remote image URLs from output helpers (#27732)\n\n## Summary\n\n- reject HTTP(S) image URLs from the shared code-mode output-image\nnormalization path\n- return a concise model-visible tool error so the model can recover on\nits next turn\n- apply the targeted rejection to both `image()` and `generatedImage()`\n- leave other non-empty image URL values to existing downstream handling\n\nThe returned error is:\n\n> Tool call failed: remote image URLs are not supported in tool outputs.\nPass a base64 data URI instead\n\n## Why\n\nResponses Lite cannot lower a remote image URL emitted from a structured\ntool output. Rejecting HTTP(S) values in the Codex harness preserves the\ntool-call metadata and gives the model a recoverable next turn instead\nof invalidating the sample.\n\n## Test coverage\n\nThe regression is covered primarily by a `test_codex()` agent\nintegration test that simulates the Responses API exchange and asserts\nthe failed model-visible exec output. A supplemental runtime test covers\nboth `http://` and `https://` inputs across both image output helpers.\n\n## Test plan\n\n- `cd codex-rs && just test -p codex-code-mode`\n- `cd codex-rs && just test -p codex-code-mode-protocol`\n- `cd codex-rs && just test -p codex-core\ncode_mode_image_helper_rejects_remote_url`\n- `cd codex-rs && just fmt`\n- `git diff --check origin/main...HEAD`\n\nRelated context: https://github.com/openai/openai/pull/1022346","tree":{"sha":"98a6922323bf114450f468771a2925e55a1e4edd","url":"https://api.github.com/repos/openai/codex/git/trees/98a6922323bf114450f468771a2925e55a1e4edd"},"url":"https://api.github.com/repos/openai/codex/git/commits/c09df9e35319e46baa11791d92adabab45d9202a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK9YdCRC1aQ7uu5UhlAAAePIQAGv81GSh3nHZ1o4OpVZamn9O\n3qcD2M4Zqw4W8OwnVkQme03jFaW0KOsqfuTqutbTSGLLn8uEh4v5ksNm9X2DEBwv\nzFxoK/Av1kWYVxhox9A4MTZdPTWYiT0wUAgArqDQCHn4gg6Kcr/TBrlUF1spPK+4\nkPpv4uVeKcXpbfZwHuPXITtKRs1Sg1euuRQ2SmoQAheHyZUXk0MSY/9sPkrNQsf4\npL5EiBdnOQdiDcG2VJq5Fey4EJ+Jns/YDdPjCOR96NoNDH4nKtrGGnjUAFjH1EAd\nnmp5EaJ934NVD94VS9nanIFZc19jZyHObDZeSpR6DJybeJtffAyV5a8oYX3Qo4cp\nDdTRujc51Q2qW5UlpP+AQyfSGJQTmiI/GRdvgBWT4ucqHQbIwwUL5vElf3w/1tUu\nBFo2ipQMWA+ZWi0UB5DGsYb/b0lL/djBSmYT+H+jbQ0LRRSeJ1OwrQSrxv7ms0/y\n6AtCR0ku7q1ZUf3XMI/5EQs3KakH3F4J18poCnRA2NAaZptPBat46AkHqYrNY4r4\nypTqs99x4RK+hAouJt4oZK1AAPSzjWwOolfiBsNuFy8s4VrNfxGAAmzxGW/wG+fr\nTEgEJu3+mn6eYWA49vCVEJnl4lN14AjMV+Yc9VaIq/Q7XOQGkHfNtzJIZJ/D4UKT\nDK8gliaThTPkiYKIKuxD\n=gKvl\n-----END PGP SIGNATURE-----\n","payload":"tree 98a6922323bf114450f468771a2925e55a1e4edd\nparent 693082f3c4ca3b17d18989a8c5136f6258f54ac0\nauthor rka-oai <rka@openai.com> 1781257757 -0700\ncommitter GitHub <noreply@github.com> 1781257757 -0700\n\n[code-mode] Reject remote image URLs from output helpers (#27732)\n\n## Summary\n\n- reject HTTP(S) image URLs from the shared code-mode output-image\nnormalization path\n- return a concise model-visible tool error so the model can recover on\nits next turn\n- apply the targeted rejection to both `image()` and `generatedImage()`\n- leave other non-empty image URL values to existing downstream handling\n\nThe returned error is:\n\n> Tool call failed: remote image URLs are not supported in tool outputs.\nPass a base64 data URI instead\n\n## Why\n\nResponses Lite cannot lower a remote image URL emitted from a structured\ntool output. Rejecting HTTP(S) values in the Codex harness preserves the\ntool-call metadata and gives the model a recoverable next turn instead\nof invalidating the sample.\n\n## Test coverage\n\nThe regression is covered primarily by a `test_codex()` agent\nintegration test that simulates the Responses API exchange and asserts\nthe failed model-visible exec output. A supplemental runtime test covers\nboth `http://` and `https://` inputs across both image output helpers.\n\n## Test plan\n\n- `cd codex-rs && just test -p codex-code-mode`\n- `cd codex-rs && just test -p codex-code-mode-protocol`\n- `cd codex-rs && just test -p codex-core\ncode_mode_image_helper_rejects_remote_url`\n- `cd codex-rs && just fmt`\n- `git diff --check origin/main...HEAD`\n\nRelated context: https://github.com/openai/openai/pull/1022346","verified_at":"2026-06-12T09:49:17Z"}},"url":"https://api.github.com/repos/openai/codex/commits/c09df9e35319e46baa11791d92adabab45d9202a","html_url":"https://github.com/openai/codex/commit/c09df9e35319e46baa11791d92adabab45d9202a","comments_url":"https://api.github.com/repos/openai/codex/commits/c09df9e35319e46baa11791d92adabab45d9202a/comments","author":{"login":"rka-oai","id":240799229,"node_id":"U_kgDODlpN_Q","avatar_url":"https://avatars.githubusercontent.com/u/240799229?v=4","gravatar_id":"","url":"https://api.github.com/users/rka-oai","html_url":"https://github.com/rka-oai","followers_url":"https://api.github.com/users/rka-oai/followers","following_url":"https://api.github.com/users/rka-oai/following{/other_user}","gists_url":"https://api.github.com/users/rka-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rka-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rka-oai/subscriptions","organizations_url":"https://api.github.com/users/rka-oai/orgs","repos_url":"https://api.github.com/users/rka-oai/repos","events_url":"https://api.github.com/users/rka-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rka-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"693082f3c4ca3b17d18989a8c5136f6258f54ac0","url":"https://api.github.com/repos/openai/codex/commits/693082f3c4ca3b17d18989a8c5136f6258f54ac0","html_url":"https://github.com/openai/codex/commit/693082f3c4ca3b17d18989a8c5136f6258f54ac0"}]},{"sha":"693082f3c4ca3b17d18989a8c5136f6258f54ac0","node_id":"C_kwDOOYsS4doAKDY5MzA4MmYzYzRjYTNiMTdkMTg5ODlhOGM1MTM2ZjYyNThmNTRhYzA","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-12T09:20:34Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T09:20:34Z"},"message":"Make MCP server contributions thread-scoped (#27670)\n\n## Why\n\n`selectedCapabilityRoots` belongs to one thread, but MCP contributors\npreviously received only the global Codex config. That left no clean way\nfor a selected executor capability to contribute MCP servers to its own\nthread.\n\n## What this PR does\n\n- Gives MCP contributors a small context containing the config and, for\na running thread, its frozen host-seeded inputs.\n- Uses the same thread inputs during startup, status queries, refreshes,\nand skill dependency checks.\n- Keeps threadless MCP operations and the existing hosted Apps behavior\nunchanged.\n- Adds coverage showing that two threads resolve independent\nregistrations and that later lifecycle mutations do not change the\nfrozen MCP inputs.\n\nThis PR does not discover plugin manifests, add MCP servers, or launch\nanything new. It only establishes the thread-scoped registration\nboundary.\n\n## Follow-ups\n\n- Resolve selected executor plugin roots through their owning\nenvironment filesystem.\n- Convert their stdio MCP declarations into environment-bound\nregistrations and add an executor MCP end-to-end test.\n\n## Verification\n\n- `just fmt`\n- `cargo check --tests -p codex-protocol -p codex-extension-api -p\ncodex-mcp-extension -p codex-core -p codex-app-server`\n\nTests and Clippy were not run.","tree":{"sha":"d2c952d900beadc16d91a6a6f0e78baf420e2e1d","url":"https://api.github.com/repos/openai/codex/git/trees/d2c952d900beadc16d91a6a6f0e78baf420e2e1d"},"url":"https://api.github.com/repos/openai/codex/git/commits/693082f3c4ca3b17d18989a8c5136f6258f54ac0","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK89iCRC1aQ7uu5UhlAAApScQADEEfFRkgq6rJi8H9452IoYS\nxb/rOS9oy/ZIdmrcTnnNuuqocOqbJ/0rpQPtzyGOFsZcXKbViqhY6FaL/2W9t/YX\na1PJIcVQjc9MWmjvsnSBtZt+G8efv59boVTF9fINK+BvldMhdWp+bwCJPN25G73/\ng8LoUj8qireOFcxGaCenJpztvuR5m/VcL4PNPtLh5gLxbgrAnIhL8YzPTH/lww99\nyqoyoaaeRl0gVI568YszQQ2O89kJblXZMW4VvR0cnpyvPExzpQ0hlawy+CCEeAWc\ndxmDQLszHr4Mzxq+MODptTd2ZSZCu/gc2I25qC5R16JA2X+mGWhUdX2emmj6Izjd\ngeavvICWczCgJOi7J+4eShmZJj5opAGUerR0Iae12F1lxlbwKSJ0lXqkG84nZTKa\nhCGf6HPgNgecKBOSHMMxHEK2pALEy4ON9xS3Mi/kP+UcCEaw363joXLo3DDBewYB\n9rsykV1ZY+q5HBu4u5vKQudKT93b86BiMbU5agE5eyNGHjWq/KKXzSXspkfQ08Dl\n686z3LtLNX1uDd3b4r4cZ9S6OjriLVVD8gAVWbWCZ76MJULcNyUzshaYDKrGYTdv\n/ES5mbZS9x8yTVvrpAWENrHDzwjtJL+5DYw3n8gW1bdyS97cU4/wnNhP8nQPikmP\naQvDAFov1SSIBxC7Ygyi\n=FLjk\n-----END PGP SIGNATURE-----\n","payload":"tree d2c952d900beadc16d91a6a6f0e78baf420e2e1d\nparent bf667c7003d258c7ef79d969a8414c99cb33b6d9\nauthor jif <jif@openai.com> 1781256034 +0100\ncommitter GitHub <noreply@github.com> 1781256034 +0200\n\nMake MCP server contributions thread-scoped (#27670)\n\n## Why\n\n`selectedCapabilityRoots` belongs to one thread, but MCP contributors\npreviously received only the global Codex config. That left no clean way\nfor a selected executor capability to contribute MCP servers to its own\nthread.\n\n## What this PR does\n\n- Gives MCP contributors a small context containing the config and, for\na running thread, its frozen host-seeded inputs.\n- Uses the same thread inputs during startup, status queries, refreshes,\nand skill dependency checks.\n- Keeps threadless MCP operations and the existing hosted Apps behavior\nunchanged.\n- Adds coverage showing that two threads resolve independent\nregistrations and that later lifecycle mutations do not change the\nfrozen MCP inputs.\n\nThis PR does not discover plugin manifests, add MCP servers, or launch\nanything new. It only establishes the thread-scoped registration\nboundary.\n\n## Follow-ups\n\n- Resolve selected executor plugin roots through their owning\nenvironment filesystem.\n- Convert their stdio MCP declarations into environment-bound\nregistrations and add an executor MCP end-to-end test.\n\n## Verification\n\n- `just fmt`\n- `cargo check --tests -p codex-protocol -p codex-extension-api -p\ncodex-mcp-extension -p codex-core -p codex-app-server`\n\nTests and Clippy were not run.","verified_at":"2026-06-12T09:20:35Z"}},"url":"https://api.github.com/repos/openai/codex/commits/693082f3c4ca3b17d18989a8c5136f6258f54ac0","html_url":"https://github.com/openai/codex/commit/693082f3c4ca3b17d18989a8c5136f6258f54ac0","comments_url":"https://api.github.com/repos/openai/codex/commits/693082f3c4ca3b17d18989a8c5136f6258f54ac0/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"bf667c7003d258c7ef79d969a8414c99cb33b6d9","url":"https://api.github.com/repos/openai/codex/commits/bf667c7003d258c7ef79d969a8414c99cb33b6d9","html_url":"https://github.com/openai/codex/commit/bf667c7003d258c7ef79d969a8414c99cb33b6d9"}]},{"sha":"bf667c7003d258c7ef79d969a8414c99cb33b6d9","node_id":"C_kwDOOYsS4doAKGJmNjY3YzcwMDNkMjU4YzdlZjc5ZDk2OWE4NDE0Yzk5Y2IzM2I2ZDk","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-12T07:10:06Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T07:10:06Z"},"message":"[codex] Load AGENTS.md from all bound environments (#27696)\n\n## Why\n\nWe already have the machinery to support multiple environments on a\nsingle thread, but we only show the model the contents of `AGENTS.md`\nfiles in the primary environment.\n\nWe should show the model all of the relevant project instructions when\nwe know there's more than one environment.\n\n## Known Gaps\n\nAs discussed in the RFC, this implementation:\n\n1. doesn't handle environments being added/removed to/from the thread\nafter its creation\n2. it doesn't enforce an aggregate context budget across environments,\nand instead applies the configured project maximum independently to each\nenvironment\n\n## Implementation\n\n- Discover project instructions in environment order with an independent\nbyte budget per environment and preserve source provenance/order.\n- Keep the legacy fragment byte-for-byte when exactly one environment\ncontributes project instructions; use environment-labeled sections when\ntwo or more environments contribute.\n- Freeze the complete rendered fragment in `LoadedAgentsMd`, insert it\ndirectly into requests, and recognize both layouts in contextual and\nmemory filtering.\n- Add exact rendering, independent-budget, source-order,\ncreation-snapshot, and consumer coverage without changing app-server\nschemas.","tree":{"sha":"1b4f43400d03b28474ac4da529b2b5c6dc065642","url":"https://api.github.com/repos/openai/codex/git/trees/1b4f43400d03b28474ac4da529b2b5c6dc065642"},"url":"https://api.github.com/repos/openai/codex/git/commits/bf667c7003d258c7ef79d969a8414c99cb33b6d9","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK7DOCRC1aQ7uu5UhlAAAZl4QAJNOmV0By0VA2EPXrkHMI+nv\nhBrvjG59/iB3hUzasuvhsghxO9abyVwb8hf4AVgh8Eq+N0XfSIq/CrQSQeVrEj+0\nMP66bv4QhNBKF5+NiogCUGKn5pBFVJArE3TyJRh9ABCHCmx5TsuH1UqTuxKnlCxv\nvc8NzamxVntC/OAVlkyf44ywIz8sRuslQ8kJC0JEa924D1a6/mPGoWzM3UGUc7tr\nA5jn6QrJfLKVnveMzIpXcJ/STxG84LJCMAc37CK7mSOsI59P2OSaMz7q6TVqvPGJ\ne4ka286V1lLuMYmSoFPI1m1LhtlhvW4bk+NaLU6Uocsf9W0eIvocPXTeEyYLB/3S\nrS4HkzvI/AiFBN0S0zjim3przO6Oqi/PB0C4dnSTn08nAueeNcxnswrd4oAvwB2r\n4sCfFZHR8BoU2LnBRSu8Nonrblc0TmuNWOJf9KeqkHNIJvbWfmKCaoNsljVl4DDP\nn5Ipalv0KOnI6ZvDuWKPx19Ub9yabQ2fIbJAe5WLHGGh9b0FWaKIRSRQCI446WyR\nDEKfk1AgoWk6kobU4q4xnyJ+XgtkbIoG0UugEgsN/HABmYb40VuD6Zi/7ds4bxW5\nRrexohg2EW0uMBpJjbxbPjlqqn2Dyu9YAedKy34K5kKfjcOy/cJ5IuUuK+K5OAmS\nCQIa2it9XiJyWtmCDLtE\n=J3ab\n-----END PGP SIGNATURE-----\n","payload":"tree 1b4f43400d03b28474ac4da529b2b5c6dc065642\nparent 7a19b14229b9ce70a734884ea73425d2c67ddd25\nauthor Adam Perry @ OpenAI <anp@openai.com> 1781248206 -0700\ncommitter GitHub <noreply@github.com> 1781248206 -0700\n\n[codex] Load AGENTS.md from all bound environments (#27696)\n\n## Why\n\nWe already have the machinery to support multiple environments on a\nsingle thread, but we only show the model the contents of `AGENTS.md`\nfiles in the primary environment.\n\nWe should show the model all of the relevant project instructions when\nwe know there's more than one environment.\n\n## Known Gaps\n\nAs discussed in the RFC, this implementation:\n\n1. doesn't handle environments being added/removed to/from the thread\nafter its creation\n2. it doesn't enforce an aggregate context budget across environments,\nand instead applies the configured project maximum independently to each\nenvironment\n\n## Implementation\n\n- Discover project instructions in environment order with an independent\nbyte budget per environment and preserve source provenance/order.\n- Keep the legacy fragment byte-for-byte when exactly one environment\ncontributes project instructions; use environment-labeled sections when\ntwo or more environments contribute.\n- Freeze the complete rendered fragment in `LoadedAgentsMd`, insert it\ndirectly into requests, and recognize both layouts in contextual and\nmemory filtering.\n- Add exact rendering, independent-budget, source-order,\ncreation-snapshot, and consumer coverage without changing app-server\nschemas.","verified_at":"2026-06-12T07:10:06Z"}},"url":"https://api.github.com/repos/openai/codex/commits/bf667c7003d258c7ef79d969a8414c99cb33b6d9","html_url":"https://github.com/openai/codex/commit/bf667c7003d258c7ef79d969a8414c99cb33b6d9","comments_url":"https://api.github.com/repos/openai/codex/commits/bf667c7003d258c7ef79d969a8414c99cb33b6d9/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7a19b14229b9ce70a734884ea73425d2c67ddd25","url":"https://api.github.com/repos/openai/codex/commits/7a19b14229b9ce70a734884ea73425d2c67ddd25","html_url":"https://github.com/openai/codex/commit/7a19b14229b9ce70a734884ea73425d2c67ddd25"}]},{"sha":"7a19b14229b9ce70a734884ea73425d2c67ddd25","node_id":"C_kwDOOYsS4doAKDdhMTliMTQyMjliOWNlNzBhNzM0ODg0ZWE3MzQyNWQyYzY3ZGRkMjU","commit":{"author":{"name":"Shijie Rao","email":"shijie.rao@openai.com","date":"2026-06-12T06:23:44Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T06:23:44Z"},"message":"Keep request_user_input direct-model only (#27316)\n\n## Why\n\n`request_user_input` has direct blocking semantics when invoked by the\nmodel. When it is exposed as a nested code-mode tool, the call has to\nflow through code-mode waiting and continuation behavior instead, which\nis not the behavior we want for this user-input request surface.\n\n## What changed\n\n- Mark `request_user_input` with `ToolExposure::DirectModelOnly` when\nregistering the core utility tool.\n- Keep `request_user_input` direct-model visible, including in\ncode-mode-only planning.\n- Add focused `spec_plan_tests` coverage that verifies\n`request_user_input` remains visible and registered as\ndirect-model-only, while it is omitted from the nested code-mode tool\ndescription.\n\nNo active goal suppression or runtime unavailability behavior is\nincluded in this PR.\n\n## Validation\n\n- No new build/test run for this housekeeping pass, per maintainer\nrequest.\n- Earlier targeted run, confirmed from session context: `just test -p\ncodex-core request_user_input` passed.","tree":{"sha":"afbbc934fa12f711ee0ab9211e746e78da541b0c","url":"https://api.github.com/repos/openai/codex/git/trees/afbbc934fa12f711ee0ab9211e746e78da541b0c"},"url":"https://api.github.com/repos/openai/codex/git/commits/7a19b14229b9ce70a734884ea73425d2c67ddd25","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK6XwCRC1aQ7uu5UhlAAAUOoQABzNF+/Pzp/o3nxhBrn2Yhl+\nULWcSP0Ld+QDotaBabM6O4V4FrnDpggEfNJRFjCM2x8VcAMn26d8cnk2R+E1Gsc2\nYgtcoq6H2kR18O7P66uupS0W+lBQKYyBg5lxf2uHRY15g4mG3ipomqpX6rOOh7As\n6Il0+Q7uXyOApucue4F/Lz13qnP5INT8ANEyly2IP4+5MHx/oj8gp8PmzIiSuKyP\nxitUjJXL7vPs5DDSrMiY/z8Hp1hnpTFO77po367I7CAVoMgi45+aGAmoM7r2vgOY\nq/x3UTC9VIVnB/LqKUvCGlhdppvfQ7k6UTHEsjwAHoIBBvxegiM0NxVNDY+QuCtE\nGXLWVTqrdAQWeTLwgE8XP5nEF/I0W2QOSmYk2n+27paE0EDU6+AUCVGXnnYoHkpE\nIRPAR3ekRArOuIr/ZRuYE2lW4h5K7QT17MxdRSiDlu6R4RmeK1BQGrxs0T9CKCte\nQaD5aBx8ZpyXXg1kB/RKza8S/ZWHII8B5LyiJNf2/ggRCZoqpwCcReS+A9Q59VYg\negokit5RH3s/oC4AoEIHdhZzGcjpxKCZN3X1uM/7YpgCZhCqdxKJGQ2BiGQsyknW\n2cMQwOd/IllMS4OqCtlVftT64+KVtEyyLk9ennY9ZuuSu73LRo8J2upYA0HiTFCr\nICSTeiypzq3HEcEARDPI\n=Wl7C\n-----END PGP SIGNATURE-----\n","payload":"tree afbbc934fa12f711ee0ab9211e746e78da541b0c\nparent a94deb5fa744c2906ed429bfeed0749c5d1e6886\nauthor Shijie Rao <shijie.rao@openai.com> 1781245424 -0700\ncommitter GitHub <noreply@github.com> 1781245424 -0700\n\nKeep request_user_input direct-model only (#27316)\n\n## Why\n\n`request_user_input` has direct blocking semantics when invoked by the\nmodel. When it is exposed as a nested code-mode tool, the call has to\nflow through code-mode waiting and continuation behavior instead, which\nis not the behavior we want for this user-input request surface.\n\n## What changed\n\n- Mark `request_user_input` with `ToolExposure::DirectModelOnly` when\nregistering the core utility tool.\n- Keep `request_user_input` direct-model visible, including in\ncode-mode-only planning.\n- Add focused `spec_plan_tests` coverage that verifies\n`request_user_input` remains visible and registered as\ndirect-model-only, while it is omitted from the nested code-mode tool\ndescription.\n\nNo active goal suppression or runtime unavailability behavior is\nincluded in this PR.\n\n## Validation\n\n- No new build/test run for this housekeeping pass, per maintainer\nrequest.\n- Earlier targeted run, confirmed from session context: `just test -p\ncodex-core request_user_input` passed.","verified_at":"2026-06-12T06:23:44Z"}},"url":"https://api.github.com/repos/openai/codex/commits/7a19b14229b9ce70a734884ea73425d2c67ddd25","html_url":"https://github.com/openai/codex/commit/7a19b14229b9ce70a734884ea73425d2c67ddd25","comments_url":"https://api.github.com/repos/openai/codex/commits/7a19b14229b9ce70a734884ea73425d2c67ddd25/comments","author":{"login":"shijie-oai","id":235382242,"node_id":"U_kgDODgel4g","avatar_url":"https://avatars.githubusercontent.com/u/235382242?v=4","gravatar_id":"","url":"https://api.github.com/users/shijie-oai","html_url":"https://github.com/shijie-oai","followers_url":"https://api.github.com/users/shijie-oai/followers","following_url":"https://api.github.com/users/shijie-oai/following{/other_user}","gists_url":"https://api.github.com/users/shijie-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/shijie-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shijie-oai/subscriptions","organizations_url":"https://api.github.com/users/shijie-oai/orgs","repos_url":"https://api.github.com/users/shijie-oai/repos","events_url":"https://api.github.com/users/shijie-oai/events{/privacy}","received_events_url":"https://api.github.com/users/shijie-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a94deb5fa744c2906ed429bfeed0749c5d1e6886","url":"https://api.github.com/repos/openai/codex/commits/a94deb5fa744c2906ed429bfeed0749c5d1e6886","html_url":"https://github.com/openai/codex/commit/a94deb5fa744c2906ed429bfeed0749c5d1e6886"}]},{"sha":"a94deb5fa744c2906ed429bfeed0749c5d1e6886","node_id":"C_kwDOOYsS4doAKGE5NGRlYjVmYTc0NGMyOTA2ZWQ0MjliZmVlZDA3NDljNWQxZTY4ODY","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-06-12T06:20:36Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T06:20:36Z"},"message":"Translate non-English issues (#27778)\n\nIssues written in languages other than English, such as #26979, require\nmanual translation before the development team can triage them.\n\nThis adds an `Issue Translator` workflow that uses Codex when an issue\nis opened. For non-English reports, it replaces the title with an\nEnglish translation, preserves the original body, and posts the\ntranslated body as an idempotent issue comment.\n\nThe translation scripts were run manually against non-English issue\ncontent and produced the expected English title and comment output.","tree":{"sha":"36f8b78fded9e667ad1bffc141635ca7676c9804","url":"https://api.github.com/repos/openai/codex/git/trees/36f8b78fded9e667ad1bffc141635ca7676c9804"},"url":"https://api.github.com/repos/openai/codex/git/commits/a94deb5fa744c2906ed429bfeed0749c5d1e6886","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK6U0CRC1aQ7uu5UhlAAAZNAQAEvKbmipQ9SmgoBeRawWKn0A\nMxbep9jodDEpYBXpchx6PwuE5bdLv/Q+peFRo8RmMCuIPpCWPeTiZpVjWBaQ8vqT\nb7Y0nNNmCiCdYG3iazSvA93CEaHcOtLPbWVRAQZyAiIrT3CUF8ruUgd0jOHqagNZ\nHrUObMQK9J6paIzJgGP/W12QBWvZPdGoJIsBhsLM4qsq/IPH2SOyPzqeM3BvcRDF\nIeCKLB2K6jndY9K8RdDz5nvYEqntradKK486AnGQ+6I6kbTEYduph+AVEO1sGMkP\nISCxSyvxqxvz8gw9eWaan37whWR4WZLDzx55asL4A1KyAOoBrfTHiTfbd/12x8yw\nyOfsxKzCGK7bGgLCB1dowBDstU5Y26ibNEsFW9H7Te7u2GAd4GOAa0ahtriy3pAo\nLvp09UujfrHao/Qp7W071bFIj873j2w5bLhiqr00jV+bfxo/8pLXKqEXih22Op6y\nhfKfHA4J6StQnttCsbbWiTWMsSe2N7tiOiCZP46zRVjAz6UVp428YFivBBtXga/E\nUnPJa+Ugd6ZDJ0HiIQ5RqvMBo98yyZR69NjSlJTSJv8Mw/1zzn9f20jrI0sWebZT\nfXYsmTs7TeUGTGaravjNisNs6MTXXZGf7AFpCPgV09GwpuPOJk4V+el+JqveC3wp\n4Uo+NL/Y84lpx6DSPnNm\n=h0h4\n-----END PGP SIGNATURE-----\n","payload":"tree 36f8b78fded9e667ad1bffc141635ca7676c9804\nparent aa46f2debf54f07d1f0e8c0d0f727eaacd5c0704\nauthor Eric Traut <etraut@openai.com> 1781245236 -0700\ncommitter GitHub <noreply@github.com> 1781245236 -0700\n\nTranslate non-English issues (#27778)\n\nIssues written in languages other than English, such as #26979, require\nmanual translation before the development team can triage them.\n\nThis adds an `Issue Translator` workflow that uses Codex when an issue\nis opened. For non-English reports, it replaces the title with an\nEnglish translation, preserves the original body, and posts the\ntranslated body as an idempotent issue comment.\n\nThe translation scripts were run manually against non-English issue\ncontent and produced the expected English title and comment output.","verified_at":"2026-06-12T06:20:37Z"}},"url":"https://api.github.com/repos/openai/codex/commits/a94deb5fa744c2906ed429bfeed0749c5d1e6886","html_url":"https://github.com/openai/codex/commit/a94deb5fa744c2906ed429bfeed0749c5d1e6886","comments_url":"https://api.github.com/repos/openai/codex/commits/a94deb5fa744c2906ed429bfeed0749c5d1e6886/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"aa46f2debf54f07d1f0e8c0d0f727eaacd5c0704","url":"https://api.github.com/repos/openai/codex/commits/aa46f2debf54f07d1f0e8c0d0f727eaacd5c0704","html_url":"https://github.com/openai/codex/commit/aa46f2debf54f07d1f0e8c0d0f727eaacd5c0704"}]},{"sha":"aa46f2debf54f07d1f0e8c0d0f727eaacd5c0704","node_id":"C_kwDOOYsS4doAKGFhNDZmMmRlYmY1NGYwN2QxZjBlOGMwZDBmNzI3ZWFhY2Q1YzA3MDQ","commit":{"author":{"name":"Channing Conger","email":"cconger@openai.com","date":"2026-06-12T05:37:26Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T05:37:26Z"},"message":"code-mode standalone: extract protocol and add host crate (#27724)\n\nThis is phase 1 of a 4 phase stack:\n1. **Add protocol and host crates for new IPC code mode implementation**\n2. Create the new standalone binary\n3. Create a new IPC `CodeModeSessionProvider` to use new binary\n4. Remove v8 from core and only use IPC provider\n\n\n## Add protocol and host crates for new IPC code mode implementation\nEstablish a clean process boundary without changing the existing\nin-process behavior.\n\n- Add the codex-code-mode-protocol crate for shared session, runtime,\nresponse, and tool-definition types.\n- Move protocol-facing code out of the V8-backed implementation.\n- Add a buildable codex-code-mode-host crate as the foundation for the\nstandalone process.\n- Keep the existing in-process runtime as the active implementation.","tree":{"sha":"2c0687e47c09375cfb95599c2a55c8578a87f042","url":"https://api.github.com/repos/openai/codex/git/trees/2c0687e47c09375cfb95599c2a55c8578a87f042"},"url":"https://api.github.com/repos/openai/codex/git/commits/aa46f2debf54f07d1f0e8c0d0f727eaacd5c0704","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK5sWCRC1aQ7uu5UhlAAA2bQQAEWHT0lCkfSWCc2gwomGUKBY\ngAwxCMfVrNkhmqp3XPGMFDoN0h4m9kEaaOGSqiHpoz7nww8e2uXSrrNHyW053ccz\nTqUIOiBSq0YFV0EFyaHOTuwy7QRyy0o21ZjEzdkFZh5UlGdzBdQ83HO+Ogw2pqq/\n5wSKJYBu4kx4sMxd7cc/yCDNEkFUnbgwSfuoIanF1R86B6GHAlJ2LyIy4o7ZAWbV\nk2oqzDPfBSkCm/00L8C2oDDenoK4xxy4QfXjA1mYpmnOepkXZN20rt43vMvgy1/V\n0ZLDRjkikoLa8mk/2C+SWEyVGNPbpW/MChgA6NGlUsorHjPGPCQnE7oMDZg+cvVL\nJIWkIeeljErEzaemuAbCPAuoABF9X1fAWIAG01iuEbm3Z8mZZGPUQCOA4J5eK8ij\n8Uj2eN3NSoOumfMvZ0IEexL0wD2TkVH4P14ukF4HhSVsAUhkPMB2xfMh7tXX2LR8\nkJXAw+JdAxEAf+E/+F5oDFGs7JYwn+jeN1Z1sA2plY4FVPDZ1bu0H5sUlWYDmWTR\nnj7VsyXrlaqbXHMcPpDfr8zvOuH1d14QkH5DNR8iH+YyHtmN4cCm1+lIcYi0GERh\nXzA6jg05xAWnjNrOKtNOLL2XwWfdGdLzju8LAhVD/QU4qx5sp7/cD1fz0zRL7Ekk\n9+PBn+V8zsnO9efUrK7i\n=6V3K\n-----END PGP SIGNATURE-----\n","payload":"tree 2c0687e47c09375cfb95599c2a55c8578a87f042\nparent 216ce03031ccedb9d022e911cd802a0ab79b7d87\nauthor Channing Conger <cconger@openai.com> 1781242646 -0700\ncommitter GitHub <noreply@github.com> 1781242646 -0700\n\ncode-mode standalone: extract protocol and add host crate (#27724)\n\nThis is phase 1 of a 4 phase stack:\n1. **Add protocol and host crates for new IPC code mode implementation**\n2. Create the new standalone binary\n3. Create a new IPC `CodeModeSessionProvider` to use new binary\n4. Remove v8 from core and only use IPC provider\n\n\n## Add protocol and host crates for new IPC code mode implementation\nEstablish a clean process boundary without changing the existing\nin-process behavior.\n\n- Add the codex-code-mode-protocol crate for shared session, runtime,\nresponse, and tool-definition types.\n- Move protocol-facing code out of the V8-backed implementation.\n- Add a buildable codex-code-mode-host crate as the foundation for the\nstandalone process.\n- Keep the existing in-process runtime as the active implementation.","verified_at":"2026-06-12T05:37:27Z"}},"url":"https://api.github.com/repos/openai/codex/commits/aa46f2debf54f07d1f0e8c0d0f727eaacd5c0704","html_url":"https://github.com/openai/codex/commit/aa46f2debf54f07d1f0e8c0d0f727eaacd5c0704","comments_url":"https://api.github.com/repos/openai/codex/commits/aa46f2debf54f07d1f0e8c0d0f727eaacd5c0704/comments","author":{"login":"cconger","id":200563,"node_id":"MDQ6VXNlcjIwMDU2Mw==","avatar_url":"https://avatars.githubusercontent.com/u/200563?v=4","gravatar_id":"","url":"https://api.github.com/users/cconger","html_url":"https://github.com/cconger","followers_url":"https://api.github.com/users/cconger/followers","following_url":"https://api.github.com/users/cconger/following{/other_user}","gists_url":"https://api.github.com/users/cconger/gists{/gist_id}","starred_url":"https://api.github.com/users/cconger/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cconger/subscriptions","organizations_url":"https://api.github.com/users/cconger/orgs","repos_url":"https://api.github.com/users/cconger/repos","events_url":"https://api.github.com/users/cconger/events{/privacy}","received_events_url":"https://api.github.com/users/cconger/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"216ce03031ccedb9d022e911cd802a0ab79b7d87","url":"https://api.github.com/repos/openai/codex/commits/216ce03031ccedb9d022e911cd802a0ab79b7d87","html_url":"https://github.com/openai/codex/commit/216ce03031ccedb9d022e911cd802a0ab79b7d87"}]},{"sha":"216ce03031ccedb9d022e911cd802a0ab79b7d87","node_id":"C_kwDOOYsS4doAKDIxNmNlMDMwMzFjY2VkYjlkMDIyZTkxMWNkODAyYTBhYjc5YjdkODc","commit":{"author":{"name":"Shijie Rao","email":"shijie.rao@openai.com","date":"2026-06-12T05:30:41Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T05:30:41Z"},"message":"Add request_user_input auto-resolution window contract (#27256)\n\n## Why\n\n`request_user_input` is moving beyond its original plan-mode-only\nworkflow, and future default/goal-mode usage needs a way for the model\nto ask helpful but non-blocking questions without forcing the turn to\nwait forever. This PR adds an explicit `autoResolutionMs` contract so a\nlater client/runtime change can auto-resolve unanswered prompts after a\nbounded window while leaving truly blocking questions unchanged.\n\nThis is contract plumbing only; it does not implement the client-side\ntimer or auto-selection behavior, and the model-facing description\ntreats the field as reserved unless the current runtime explicitly\nsupports auto-resolution.\n\n## What Changed\n\n- Added optional `autoResolutionMs` to the model-facing\n`request_user_input` args and core `RequestUserInputEvent`.\n- Added model-facing schema text for `autoResolutionMs` while marking it\nreserved for runtimes that explicitly support auto-resolution.\n- Bounds `autoResolutionMs` to `60_000..=240_000` ms during argument\nnormalization by clamping out-of-range model-provided values.\n- Propagated the field through app-server v2\n`ToolRequestUserInputParams`, app-server request forwarding, generated\nTypeScript, and JSON schema fixtures.\n- Updated app-server, core, protocol, and TUI call sites/tests so\nomitted values preserve existing `None`/`null` behavior and coverage\nverifies a `Some(60_000)` round trip.\n\n## Verification\n\n- `just test -p codex-app-server-protocol`\n- `just test -p codex-core request_user_input`\n- `just test -p codex-app-server request_user_input_round_trip`\n- `just test -p codex-tui request_user_input`\n- `just test -p codex-protocol`","tree":{"sha":"980a13ec4e00401a1c27f56964a25494f9713430","url":"https://api.github.com/repos/openai/codex/git/trees/980a13ec4e00401a1c27f56964a25494f9713430"},"url":"https://api.github.com/repos/openai/codex/git/commits/216ce03031ccedb9d022e911cd802a0ab79b7d87","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK5mBCRC1aQ7uu5UhlAAAqmUQAIjBdL8HPFGa5wNbF6bzmUIT\nQu2yJblv2eWP1HpU42f3ECbWj/J+G/6h+1BnTI8XfOgxQwtt3A0Y7+6xNC4ZwwfM\n0f2LG0/CpZOycvsMvmkvNjFmqzDK3E2RnaqBG0W1J8v2UAn32g5Cahu2akHcAP3C\nABWYZJ2UbjBsZjN0T/SI2tO+P1EB6cMToaBkeAjQ7V4gQYx+5CalL9XDhhD19nnW\nTrn12C7E8AwRcqViGaytA5NvsTb597CxWwc4Fauf/crd+gfWvfoKZY97xklczjZo\nkSKeZ2VPh9IRIK+EMiMhKJTn+ujmFWNv3l3onhigJio2Lt+Si/G5abWTSIkfjC0V\nqv0W7SL2xjGmd1MN7bNTDL7i6pIwogT6qlSHcwKxNnnIHKSOcadZL1ErnDaDjmN4\nSMEEeIg0zwWLvNOsILN9gALOzLU4TzNOH8pJx8T4lur19ZK08xsrBfwoG2fsppEz\nrtKD43M4RKC+esVo+sLaxpQoTQfZPRGfOVu/m5SG1Ary+YQkQzBz0U38j4y90Dzy\nS6KOGveAlgDmYGmLZBT0FnY0bedrS3JAdE4vgUygNkh+ukiNEwOlsQP4B+5D8IW7\nYieFJNvTcil0U57bn9y74Zxc2Ow8PeVImA+B5fHqKrwlHbQqamCyoQOBPqH/s1z1\nGEWlhaIsKolwDEPZ4TUf\n=L1OR\n-----END PGP SIGNATURE-----\n","payload":"tree 980a13ec4e00401a1c27f56964a25494f9713430\nparent 78bab041160f4c20e502e835c2e8a49dfdc01ca1\nauthor Shijie Rao <shijie.rao@openai.com> 1781242241 -0700\ncommitter GitHub <noreply@github.com> 1781242241 -0700\n\nAdd request_user_input auto-resolution window contract (#27256)\n\n## Why\n\n`request_user_input` is moving beyond its original plan-mode-only\nworkflow, and future default/goal-mode usage needs a way for the model\nto ask helpful but non-blocking questions without forcing the turn to\nwait forever. This PR adds an explicit `autoResolutionMs` contract so a\nlater client/runtime change can auto-resolve unanswered prompts after a\nbounded window while leaving truly blocking questions unchanged.\n\nThis is contract plumbing only; it does not implement the client-side\ntimer or auto-selection behavior, and the model-facing description\ntreats the field as reserved unless the current runtime explicitly\nsupports auto-resolution.\n\n## What Changed\n\n- Added optional `autoResolutionMs` to the model-facing\n`request_user_input` args and core `RequestUserInputEvent`.\n- Added model-facing schema text for `autoResolutionMs` while marking it\nreserved for runtimes that explicitly support auto-resolution.\n- Bounds `autoResolutionMs` to `60_000..=240_000` ms during argument\nnormalization by clamping out-of-range model-provided values.\n- Propagated the field through app-server v2\n`ToolRequestUserInputParams`, app-server request forwarding, generated\nTypeScript, and JSON schema fixtures.\n- Updated app-server, core, protocol, and TUI call sites/tests so\nomitted values preserve existing `None`/`null` behavior and coverage\nverifies a `Some(60_000)` round trip.\n\n## Verification\n\n- `just test -p codex-app-server-protocol`\n- `just test -p codex-core request_user_input`\n- `just test -p codex-app-server request_user_input_round_trip`\n- `just test -p codex-tui request_user_input`\n- `just test -p codex-protocol`","verified_at":"2026-06-12T05:30:41Z"}},"url":"https://api.github.com/repos/openai/codex/commits/216ce03031ccedb9d022e911cd802a0ab79b7d87","html_url":"https://github.com/openai/codex/commit/216ce03031ccedb9d022e911cd802a0ab79b7d87","comments_url":"https://api.github.com/repos/openai/codex/commits/216ce03031ccedb9d022e911cd802a0ab79b7d87/comments","author":{"login":"shijie-oai","id":235382242,"node_id":"U_kgDODgel4g","avatar_url":"https://avatars.githubusercontent.com/u/235382242?v=4","gravatar_id":"","url":"https://api.github.com/users/shijie-oai","html_url":"https://github.com/shijie-oai","followers_url":"https://api.github.com/users/shijie-oai/followers","following_url":"https://api.github.com/users/shijie-oai/following{/other_user}","gists_url":"https://api.github.com/users/shijie-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/shijie-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shijie-oai/subscriptions","organizations_url":"https://api.github.com/users/shijie-oai/orgs","repos_url":"https://api.github.com/users/shijie-oai/repos","events_url":"https://api.github.com/users/shijie-oai/events{/privacy}","received_events_url":"https://api.github.com/users/shijie-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"78bab041160f4c20e502e835c2e8a49dfdc01ca1","url":"https://api.github.com/repos/openai/codex/commits/78bab041160f4c20e502e835c2e8a49dfdc01ca1","html_url":"https://github.com/openai/codex/commit/78bab041160f4c20e502e835c2e8a49dfdc01ca1"}]},{"sha":"78bab041160f4c20e502e835c2e8a49dfdc01ca1","node_id":"C_kwDOOYsS4doAKDc4YmFiMDQxMTYwZjRjMjBlNTAyZTgzNWMyZThhNDlkZmRjMDFjYTE","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-06-12T05:26:31Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T05:26:31Z"},"message":"[1 of 3] Support long raw TUI goal objectives (#27508)\n\n## Stack\n\n1. **[1 of 3] Support long raw TUI goal objectives** - this PR\n2. [2 of 3] Support long pasted text in TUI goals - #27509\n3. [3 of 3] Support images in TUI goals - #27510\n\n## Why\n\n`thread/goal/set` limits persisted objective text to 4000 characters.\nThe TUI used to reject raw `/goal` objectives above that limit, even\nthough the client can make them usable by writing the long text to a\nfile and storing a short objective that points at that file.\n\nThis also needs to work for remote app-server sessions: filesystem API\ncalls must create files on the app-server host, and the stored path must\nbe meaningful to the agent on that host.\n\n## What Changed\n\n- Adds an app-server-host path helper so TUI code can build paths that\nare resolved on the app-server host rather than the TUI host.\n- Adds TUI app-server session helpers for `fs/createDirectory`,\n`fs/writeFile`, `fs/readFile`, and `fs/remove` that work for embedded\nand remote app-server sessions without changing the app-server protocol.\n- Materializes oversized raw `/goal` objectives into\n`$CODEX_HOME/attachments/<uuid>/goal-objective.md` through the\napp-server filesystem APIs, then stores a short, readable objective that\ndirects the agent to that file.\n- Reads managed objective files back for `/goal edit`. Other goal UI\nrenders the readable stored objective normally, without\nmanaged-file-specific presentation logic.\n- Recognizes managed references only when they name the expected\ngenerated file under the app server's reported `$CODEX_HOME`, and cleans\nup newly materialized files when goal replacement or setting does not\ncomplete.\n\n## Verification\n\n- Added/updated TUI tests for raw oversized `/goal` submission, large\ninline-paste expansion, queued oversized goals, app-facing\nmaterialization before `thread/goal/set`, managed-path validation,\nediting, and cleanup.\n- Added/updated app-server-client remote coverage for initialized remote\nCodex home handling.\n\n## Manual Testing\n\n- Ran the real TUI against a Unix-socket app server with different local\nand server `$CODEX_HOME` directories. Oversized goals wrote only under\nthe server home, and persisted references used the server-canonical path\nrather than the TUI path.\n- Exercised 3,999-, 4,000-, and 4,001-character raw objectives. The\nfirst two stayed inline without new files; the 4,001-character objective\nbecame a managed objective file.\n- Submitted a larger 8,275-character objective, verified its full\ncontents on the app-server host, and observed the goal continuation open\nthe referenced server-side file.\n- Opened `/goal edit` for a managed objective and verified the full text\nwas restored through remote `fs/readFile`.\n- Submitted an oversized replacement while a goal was active, verified\nno file was written before confirmation, then canceled and confirmed\nthat the existing goal and attachment count were unchanged.","tree":{"sha":"0da6dd400ab93b1225608abc3d1867ca2ab0576e","url":"https://api.github.com/repos/openai/codex/git/trees/0da6dd400ab93b1225608abc3d1867ca2ab0576e"},"url":"https://api.github.com/repos/openai/codex/git/commits/78bab041160f4c20e502e835c2e8a49dfdc01ca1","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK5iHCRC1aQ7uu5UhlAAAFJwQAG5xzW+CQh+mM5gJ9RJqMtJh\ngtLJiM1Qg6V+301DAH3TVFOdfJ1rV0Cx5WOVYcUj9DxKotaHq3Q5bbbeqj03txaF\nMF6stkIJ10GpYuFgheFPWqO6AahNhKvGPzwGdfWpMnpoYzzRolXdyjNLe9hl9Ik8\naVt15qAMpkCM7/Nq6F9im2rcP6FBVpDMXNyHzZ8G6K3ZgMmT7DVfMnNR6i17+4Ho\nNncW48Fb4IJmaB41k9beY+o6PbYDc355MSYa2+zq+ZY9M6xRYwiefs6IPb4WZj+A\n9ZsY4TVOLkg0yUY6hHUuScHYL/1sNOb8f1a6k4LhukDs4Awz2CWsLp20F3Wp5huZ\nMbukTAfEXVMt3WmqsigsZ80y0C76m2PPX4iueZlKwW3Ku9ib5nIN56FAp8VMV2ae\nnLFT/KsUtUiXMbqxmOl2TZ1KbN5EoRRo32Mo77zCpkVGhjrUC/2d/QFIbkFT/+kz\nUIQwdkpq9vS0emvVnk7uPMFOy0lcGjlxMFkbVOTqHr1g6FrSRuQNPK4Ga0C6q6nH\ndCwc5se4ix7B0j4ql8V7DTAaEMpUp1CcIbIuANLYHddQgFPQSSus6JGByGHFhqgU\n1tLlmuTkuQDOKeh6E/dTuHdWWTYLjJktclqeYnqvPit4K1d465VILm6Tkq5ITZlM\nweWEGPQ62ItR968F9Iko\n=yN8E\n-----END PGP SIGNATURE-----\n","payload":"tree 0da6dd400ab93b1225608abc3d1867ca2ab0576e\nparent d61dfeb23a13be748c2d58409ca5e16d281267b4\nauthor Eric Traut <etraut@openai.com> 1781241991 -0700\ncommitter GitHub <noreply@github.com> 1781241991 -0700\n\n[1 of 3] Support long raw TUI goal objectives (#27508)\n\n## Stack\n\n1. **[1 of 3] Support long raw TUI goal objectives** - this PR\n2. [2 of 3] Support long pasted text in TUI goals - #27509\n3. [3 of 3] Support images in TUI goals - #27510\n\n## Why\n\n`thread/goal/set` limits persisted objective text to 4000 characters.\nThe TUI used to reject raw `/goal` objectives above that limit, even\nthough the client can make them usable by writing the long text to a\nfile and storing a short objective that points at that file.\n\nThis also needs to work for remote app-server sessions: filesystem API\ncalls must create files on the app-server host, and the stored path must\nbe meaningful to the agent on that host.\n\n## What Changed\n\n- Adds an app-server-host path helper so TUI code can build paths that\nare resolved on the app-server host rather than the TUI host.\n- Adds TUI app-server session helpers for `fs/createDirectory`,\n`fs/writeFile`, `fs/readFile`, and `fs/remove` that work for embedded\nand remote app-server sessions without changing the app-server protocol.\n- Materializes oversized raw `/goal` objectives into\n`$CODEX_HOME/attachments/<uuid>/goal-objective.md` through the\napp-server filesystem APIs, then stores a short, readable objective that\ndirects the agent to that file.\n- Reads managed objective files back for `/goal edit`. Other goal UI\nrenders the readable stored objective normally, without\nmanaged-file-specific presentation logic.\n- Recognizes managed references only when they name the expected\ngenerated file under the app server's reported `$CODEX_HOME`, and cleans\nup newly materialized files when goal replacement or setting does not\ncomplete.\n\n## Verification\n\n- Added/updated TUI tests for raw oversized `/goal` submission, large\ninline-paste expansion, queued oversized goals, app-facing\nmaterialization before `thread/goal/set`, managed-path validation,\nediting, and cleanup.\n- Added/updated app-server-client remote coverage for initialized remote\nCodex home handling.\n\n## Manual Testing\n\n- Ran the real TUI against a Unix-socket app server with different local\nand server `$CODEX_HOME` directories. Oversized goals wrote only under\nthe server home, and persisted references used the server-canonical path\nrather than the TUI path.\n- Exercised 3,999-, 4,000-, and 4,001-character raw objectives. The\nfirst two stayed inline without new files; the 4,001-character objective\nbecame a managed objective file.\n- Submitted a larger 8,275-character objective, verified its full\ncontents on the app-server host, and observed the goal continuation open\nthe referenced server-side file.\n- Opened `/goal edit` for a managed objective and verified the full text\nwas restored through remote `fs/readFile`.\n- Submitted an oversized replacement while a goal was active, verified\nno file was written before confirmation, then canceled and confirmed\nthat the existing goal and attachment count were unchanged.","verified_at":"2026-06-12T05:26:31Z"}},"url":"https://api.github.com/repos/openai/codex/commits/78bab041160f4c20e502e835c2e8a49dfdc01ca1","html_url":"https://github.com/openai/codex/commit/78bab041160f4c20e502e835c2e8a49dfdc01ca1","comments_url":"https://api.github.com/repos/openai/codex/commits/78bab041160f4c20e502e835c2e8a49dfdc01ca1/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"d61dfeb23a13be748c2d58409ca5e16d281267b4","url":"https://api.github.com/repos/openai/codex/commits/d61dfeb23a13be748c2d58409ca5e16d281267b4","html_url":"https://github.com/openai/codex/commit/d61dfeb23a13be748c2d58409ca5e16d281267b4"}]},{"sha":"d61dfeb23a13be748c2d58409ca5e16d281267b4","node_id":"C_kwDOOYsS4doAKGQ2MWRmZWIyM2ExM2JlNzQ4YzJkNTg0MDljYTVlMTZkMjgxMjY3YjQ","commit":{"author":{"name":"Anton Panasenko","email":"apanasenko@openai.com","date":"2026-06-12T04:28:52Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T04:28:52Z"},"message":"feat(app-server): persist remote-control desired state (#27445)\n\n## Why\n\nRemote-control runtime enablement and persisted enrollment preference\nwere represented by separate flags. That made startup rehydration, RPC\npersistence, and new-enrollment seeding race with one another, and it\ndid not cleanly distinguish runtime-only CLI or daemon starts from\ndurable app-server RPC changes.\n\n## What Changed\n\n- Replace the parallel enablement, seed, and rehydration flags with one\ntransport-owned `RemoteControlDesiredState`.\n- Add nullable enrollment-scoped persistence and preserve existing\npreferences during enrollment upserts.\n- Rehydrate plain startup only after auth and client scope resolve,\nwithout overwriting a concurrent RPC transition.\n- Make ordinary `remoteControl/enable` and `remoteControl/disable`\ndurable while retaining `ephemeral: true` for runtime-only callers.\n- Have the daemon explicitly request ephemeral enablement and regenerate\nthe app-server schemas.\n\n## Verification\n\n- Covered migration and `NULL`/`0`/`1` persistence round trips.\n- Covered plain-start rehydration and runtime-only versus durable\nenrollment seeding.\n- Covered durable enable, durable disable, and ephemeral enable through\napp-server RPC.\n- Covered the daemon's exact `{ \"ephemeral\": true }` request payload.\n\nRelated issue: N/A (internal remote-control persistence architecture\nchange).","tree":{"sha":"644941aaa215ee2b703fcf993a26cce6e7d292b7","url":"https://api.github.com/repos/openai/codex/git/trees/644941aaa215ee2b703fcf993a26cce6e7d292b7"},"url":"https://api.github.com/repos/openai/codex/git/commits/d61dfeb23a13be748c2d58409ca5e16d281267b4","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK4sECRC1aQ7uu5UhlAAA9hgQAKeSXwCqAQsg1MiN3oPSmb31\nedPYz3hbL+m2VjTd2f+zJus3BOC0Et9SNjfqnNAWG+3MO1JpPI21pVvI9/e7FFer\n2J8Gq121/tyGrfb52PO0WtGG5cAYrshDcrlfZpnqM67kjZwl8WXjpOmpakg5nl8b\nSaioHG8osZNcVH040Hm8FzMzVPn1xbxFvlL1RLrgf3Dr8DOGZiBLztqXWXIrIuXo\n17H/EtnjObOEq1IE/qzNlGdpolqsEMXpLAh5I5/5xdP+w82/Nw0yTELS0e6THICR\nHF7ZiHN7Oekf8kSI7BLAM/R68mEO/QDxpd5fMmVc/gijQbgK9Zc38O2RFFO0Engg\nDBQ164z+9t2EMpgbc9MG3AlJam7Cgso2UQKRhXDeVY6F7Cn2L2/jZAa1kPOuMM8l\nYc9WxyNYa1WudtGw4ZgYVzQBW80cu4c+XWi0i5RXzMm5IrnLhWQ6MyE3NNk4fFng\nFT+DcfDSqdn04v46mlvemNSlOW9T25zNbmHFA4Ezmi96cpwAEO8XxspSfH4pshqh\n8ouQ14uxjvPjXzU8RNOZBnNAwXZPwqntsJyRzzSLdiFtKRXO/pm7sUwgXtRluXD6\nWC9I3x6+tplsiNVY8YtqcZgkgmfCy+d8lo5k9R9vnZgCxFZxKN4F65NbMOzzSOJh\nkcuc7N4pdkAMNJU80Pqb\n=wVr/\n-----END PGP SIGNATURE-----\n","payload":"tree 644941aaa215ee2b703fcf993a26cce6e7d292b7\nparent be338ee9a28ce5a1c75455343e9712aded82c70f\nauthor Anton Panasenko <apanasenko@openai.com> 1781238532 -0700\ncommitter GitHub <noreply@github.com> 1781238532 -0700\n\nfeat(app-server): persist remote-control desired state (#27445)\n\n## Why\n\nRemote-control runtime enablement and persisted enrollment preference\nwere represented by separate flags. That made startup rehydration, RPC\npersistence, and new-enrollment seeding race with one another, and it\ndid not cleanly distinguish runtime-only CLI or daemon starts from\ndurable app-server RPC changes.\n\n## What Changed\n\n- Replace the parallel enablement, seed, and rehydration flags with one\ntransport-owned `RemoteControlDesiredState`.\n- Add nullable enrollment-scoped persistence and preserve existing\npreferences during enrollment upserts.\n- Rehydrate plain startup only after auth and client scope resolve,\nwithout overwriting a concurrent RPC transition.\n- Make ordinary `remoteControl/enable` and `remoteControl/disable`\ndurable while retaining `ephemeral: true` for runtime-only callers.\n- Have the daemon explicitly request ephemeral enablement and regenerate\nthe app-server schemas.\n\n## Verification\n\n- Covered migration and `NULL`/`0`/`1` persistence round trips.\n- Covered plain-start rehydration and runtime-only versus durable\nenrollment seeding.\n- Covered durable enable, durable disable, and ephemeral enable through\napp-server RPC.\n- Covered the daemon's exact `{ \"ephemeral\": true }` request payload.\n\nRelated issue: N/A (internal remote-control persistence architecture\nchange).","verified_at":"2026-06-12T04:28:53Z"}},"url":"https://api.github.com/repos/openai/codex/commits/d61dfeb23a13be748c2d58409ca5e16d281267b4","html_url":"https://github.com/openai/codex/commit/d61dfeb23a13be748c2d58409ca5e16d281267b4","comments_url":"https://api.github.com/repos/openai/codex/commits/d61dfeb23a13be748c2d58409ca5e16d281267b4/comments","author":{"login":"apanasenko-oai","id":228802911,"node_id":"U_kgDODaNBXw","avatar_url":"https://avatars.githubusercontent.com/u/228802911?v=4","gravatar_id":"","url":"https://api.github.com/users/apanasenko-oai","html_url":"https://github.com/apanasenko-oai","followers_url":"https://api.github.com/users/apanasenko-oai/followers","following_url":"https://api.github.com/users/apanasenko-oai/following{/other_user}","gists_url":"https://api.github.com/users/apanasenko-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/apanasenko-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/apanasenko-oai/subscriptions","organizations_url":"https://api.github.com/users/apanasenko-oai/orgs","repos_url":"https://api.github.com/users/apanasenko-oai/repos","events_url":"https://api.github.com/users/apanasenko-oai/events{/privacy}","received_events_url":"https://api.github.com/users/apanasenko-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"be338ee9a28ce5a1c75455343e9712aded82c70f","url":"https://api.github.com/repos/openai/codex/commits/be338ee9a28ce5a1c75455343e9712aded82c70f","html_url":"https://github.com/openai/codex/commit/be338ee9a28ce5a1c75455343e9712aded82c70f"}]},{"sha":"be338ee9a28ce5a1c75455343e9712aded82c70f","node_id":"C_kwDOOYsS4doAKGJlMzM4ZWU5YTI4Y2U1YTFjNzU0NTUzNDNlOTcxMmFkZWQ4MmM3MGY","commit":{"author":{"name":"pakrym-oai","email":"pakrym@openai.com","date":"2026-06-12T03:35:28Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T03:35:28Z"},"message":"[codex] resolve environment shell metadata eagerly (#27709)\n\n## Why\n\nTurn construction passed resolved environments through several layers\nwhile leaving the environment shell unresolved. As a result,\nmodel-visible environment context could fall back to the session shell\ninstead of reporting the selected remote environment's shell.\n\nResolve environment metadata at the turn-context boundary so each turn\ncarries the shell that belongs to its selected environment. Keep request\nvalidation in app-server, where invalid selections can be returned as\nstraightforward JSON-RPC errors without coupling core turn construction\nto that policy.\n\n## What changed\n\n- resolve environment selections eagerly in\n`new_turn_context_from_configuration`\n- store the full resolved `Shell` on each `TurnEnvironment`\n- simplify the now-redundant resolved-environment constructor plumbing\n- keep duplicate and unknown-environment validation as a small\napp-server preflight\n- add a remote-environment integration test that runs a full\n`test_codex` turn and verifies the model-visible environment message\nreports `bash`\n\n## Testing\n\n- `cargo check -p codex-core --test all -p codex-app-server`\n- `remote_test_env_exposes_bash_shell_to_model` on the Linux\nremote-executor harness","tree":{"sha":"7100492e134fca0974c6657d098ba8e35f77070d","url":"https://api.github.com/repos/openai/codex/git/trees/7100492e134fca0974c6657d098ba8e35f77070d"},"url":"https://api.github.com/repos/openai/codex/git/commits/be338ee9a28ce5a1c75455343e9712aded82c70f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK36ACRC1aQ7uu5UhlAAA+IIQAA7cU4UnuEpNqEzDUWqqvKM4\nPQlajPJ87vix89dd5YFWQ9Hy4kGVh2Oa7bT56ZZ/v4S0boKr2EIsfeutgLK//3bq\nldeerQ15XhR291Lg2M+CUI8N6NkwdCWHli42saey1HH6WjQ9HXMUCgbrtXss9ewn\nv23aAfZo9z2CbxHhxw6xyXlOAdIscg0Ipib8qXpEWJgmrpGkGBUjqXosqcfyPQ7o\nM8n6K+tXHXBk2ACf6nsxDj517EWk6VvLItlZAu5PUyzXNeRTgkzEzJsOysQERbnz\no9qqQWEW4Lfofij2psAhg0PUZiuobKNs0DgZ0oijRWFMGIShd6E/rSFEcG2S3wp+\nCULpvL6ov4K+J7Syg3pQAnheoca1igGPcG4hivfN4zzTUxk/Y3SgNH3/69NwyvYu\nJlZA/CfnY8rXtRyqK3kOQ5GrCEmYboRoqqYTrQzFnusoC4dg0DCaVZRYun1mHRJv\nLynPtVYkavpBEN1sxLHWItlO4OuV9qiYZIR1p2PeuGPmlP4jpnpbBK3nObmTAjKm\ngnb5l5qM7638CSjNAwAi0MM+WgstbcSuaNoGs9ejEMbJOHMPDpwPfFMbs3vvoB3H\nZYBU7Y4Nb+tG2/whlPs+wU0Q6TwLouzCBAeitgKeLq3NQZ/5sVSCtIfgTK2fV2QA\nA7rjEAwLM1mlg5xCIpci\n=OooQ\n-----END PGP SIGNATURE-----\n","payload":"tree 7100492e134fca0974c6657d098ba8e35f77070d\nparent e23d4df4ff5e284cafee734e5dba6b99abec239a\nauthor pakrym-oai <pakrym@openai.com> 1781235328 -0700\ncommitter GitHub <noreply@github.com> 1781235328 -0700\n\n[codex] resolve environment shell metadata eagerly (#27709)\n\n## Why\n\nTurn construction passed resolved environments through several layers\nwhile leaving the environment shell unresolved. As a result,\nmodel-visible environment context could fall back to the session shell\ninstead of reporting the selected remote environment's shell.\n\nResolve environment metadata at the turn-context boundary so each turn\ncarries the shell that belongs to its selected environment. Keep request\nvalidation in app-server, where invalid selections can be returned as\nstraightforward JSON-RPC errors without coupling core turn construction\nto that policy.\n\n## What changed\n\n- resolve environment selections eagerly in\n`new_turn_context_from_configuration`\n- store the full resolved `Shell` on each `TurnEnvironment`\n- simplify the now-redundant resolved-environment constructor plumbing\n- keep duplicate and unknown-environment validation as a small\napp-server preflight\n- add a remote-environment integration test that runs a full\n`test_codex` turn and verifies the model-visible environment message\nreports `bash`\n\n## Testing\n\n- `cargo check -p codex-core --test all -p codex-app-server`\n- `remote_test_env_exposes_bash_shell_to_model` on the Linux\nremote-executor harness","verified_at":"2026-06-12T03:35:28Z"}},"url":"https://api.github.com/repos/openai/codex/commits/be338ee9a28ce5a1c75455343e9712aded82c70f","html_url":"https://github.com/openai/codex/commit/be338ee9a28ce5a1c75455343e9712aded82c70f","comments_url":"https://api.github.com/repos/openai/codex/commits/be338ee9a28ce5a1c75455343e9712aded82c70f/comments","author":{"login":"pakrym-oai","id":204937752,"node_id":"U_kgDODDcaGA","avatar_url":"https://avatars.githubusercontent.com/u/204937752?v=4","gravatar_id":"","url":"https://api.github.com/users/pakrym-oai","html_url":"https://github.com/pakrym-oai","followers_url":"https://api.github.com/users/pakrym-oai/followers","following_url":"https://api.github.com/users/pakrym-oai/following{/other_user}","gists_url":"https://api.github.com/users/pakrym-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/pakrym-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pakrym-oai/subscriptions","organizations_url":"https://api.github.com/users/pakrym-oai/orgs","repos_url":"https://api.github.com/users/pakrym-oai/repos","events_url":"https://api.github.com/users/pakrym-oai/events{/privacy}","received_events_url":"https://api.github.com/users/pakrym-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e23d4df4ff5e284cafee734e5dba6b99abec239a","url":"https://api.github.com/repos/openai/codex/commits/e23d4df4ff5e284cafee734e5dba6b99abec239a","html_url":"https://github.com/openai/codex/commit/e23d4df4ff5e284cafee734e5dba6b99abec239a"}]},{"sha":"e23d4df4ff5e284cafee734e5dba6b99abec239a","node_id":"C_kwDOOYsS4doAKGUyM2Q0ZGY0ZmY1ZTI4NGNhZmVlNzM0ZTVkYmE2Yjk5YWJlYzIzOWE","commit":{"author":{"name":"Tamir Duberstein","email":"tamird@openai.com","date":"2026-06-12T02:44:36Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T02:44:36Z"},"message":"[codex] parallelize release code generation (#27702)\n\nThe release profile still uses one codegen unit, which serializes LLVM\ncode generation within each crate. That setting was selected alongside\nfat LTO for optimization quality and binary size, but releases now use\nThinLTO and code generation dominates the critical-path build.\n\nUse four codegen units. On an Apple M4 Max with 16 cores and 128 GiB\nRAM, using rustc 1.96.0, four and eight units took 507.486 and 505.325\nseconds respectively. Four therefore keeps the build-time gain while\nlimiting the stripped `codex` increase to 14.7%, compared with 21.5% at\neight units. The gzip-compressed binary grows 7.8% at four units.\n\nThe one-unit build from an empty target directory took 981.150 seconds.\nThat comparison also populated dependency and native build caches, so it\nis directional rather than controlled. It agrees with the earlier clean\nmatrix where eight units reduced 671 seconds to 303 seconds:\nhttps://gist.github.com/anp/4b88393a0acd35783d9f42156f3243d5\n\nAt the local 48% reduction, the current release's 55m22s critical-path\nmacOS Cargo step would save about 26 minutes from the 71m28s workflow:\nhttps://github.com/openai/codex/actions/runs/27367405663\n\nThe prompt-image medians ranged from 3.9% faster to 0.9% slower. CLI\nstartup shifted by 1-2 ms while user and system CPU time were unchanged.\n\nThis is a draft because the release-latency improvement may not justify\nthe binary-size increase.","tree":{"sha":"68f1d8daab83987757f1ad4ce42f9ec8da96d848","url":"https://api.github.com/repos/openai/codex/git/trees/68f1d8daab83987757f1ad4ce42f9ec8da96d848"},"url":"https://api.github.com/repos/openai/codex/git/commits/e23d4df4ff5e284cafee734e5dba6b99abec239a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK3KUCRC1aQ7uu5UhlAAA0aAQADd4DpoFCHVMAzFTEKOoI90w\nAER3bY5/IWAumWj0unqIHJxoxaEOy/4BrLcaYC+QZDBRBJ6Lh8GIRm0Wr0UB7PNF\n1AEdzw1S+rVQkesj9Ga/0EchfCQ9iTKzgu06SYItMoHbQv9FeYN275h0viGLHJK6\nP1GVa6VY5apPVOcf5M6rKF5X2MS6iZRGXPxMxhjfHAEyygq1sB5dtI3n8IQIWEPk\naRxEn6L7lFqnAXKL+RH+Idb2Sjq2gLpe2k5OPt70kN1MsRCuJSFIcWzjWctFg1RE\nD0kjDBgonOoNQ+waBlqNCXxCumMVOfqPaYLDxVNHiGxQFhmoOazU0W2SgOOMxBvG\nSu/jslVp/OzaDtPznNJd/cgSuiyHLJcfx80XseXrpAOvpnDDeu9QML/smQuFF7tC\nIN2fx61+jjCcZ0hQkxL2CZXGG2mGnOc6HgSQ686tqzGPAxOB7xnAcIlCeJMS7TLz\nZGaMzITscRRC1IIvVqj1LBiJGVnHFWAGlsNDWTcqDuyA58cuZ0WDNlEZcFMGq+pd\n8fwvxAb+vf9QjIzVyjZHv27zgIGz2S2gIKeerN2CLXIvFi4IEoY36FFtEU3p7Tpb\nAezoW6eJmX9wriyzQrCiyXmA3N1apbunpb1mKznimUnD0MwVns9/SgGFaYa3Dosc\nUBhhtJZH/BROI7Txgbp1\n=j+Av\n-----END PGP SIGNATURE-----\n","payload":"tree 68f1d8daab83987757f1ad4ce42f9ec8da96d848\nparent 16c7c79540c26e648b1d0ee09b7c6f4f916258a0\nauthor Tamir Duberstein <tamird@openai.com> 1781232276 -0700\ncommitter GitHub <noreply@github.com> 1781232276 -0700\n\n[codex] parallelize release code generation (#27702)\n\nThe release profile still uses one codegen unit, which serializes LLVM\ncode generation within each crate. That setting was selected alongside\nfat LTO for optimization quality and binary size, but releases now use\nThinLTO and code generation dominates the critical-path build.\n\nUse four codegen units. On an Apple M4 Max with 16 cores and 128 GiB\nRAM, using rustc 1.96.0, four and eight units took 507.486 and 505.325\nseconds respectively. Four therefore keeps the build-time gain while\nlimiting the stripped `codex` increase to 14.7%, compared with 21.5% at\neight units. The gzip-compressed binary grows 7.8% at four units.\n\nThe one-unit build from an empty target directory took 981.150 seconds.\nThat comparison also populated dependency and native build caches, so it\nis directional rather than controlled. It agrees with the earlier clean\nmatrix where eight units reduced 671 seconds to 303 seconds:\nhttps://gist.github.com/anp/4b88393a0acd35783d9f42156f3243d5\n\nAt the local 48% reduction, the current release's 55m22s critical-path\nmacOS Cargo step would save about 26 minutes from the 71m28s workflow:\nhttps://github.com/openai/codex/actions/runs/27367405663\n\nThe prompt-image medians ranged from 3.9% faster to 0.9% slower. CLI\nstartup shifted by 1-2 ms while user and system CPU time were unchanged.\n\nThis is a draft because the release-latency improvement may not justify\nthe binary-size increase.","verified_at":"2026-06-12T02:44:36Z"}},"url":"https://api.github.com/repos/openai/codex/commits/e23d4df4ff5e284cafee734e5dba6b99abec239a","html_url":"https://github.com/openai/codex/commit/e23d4df4ff5e284cafee734e5dba6b99abec239a","comments_url":"https://api.github.com/repos/openai/codex/commits/e23d4df4ff5e284cafee734e5dba6b99abec239a/comments","author":{"login":"tamird","id":1535036,"node_id":"MDQ6VXNlcjE1MzUwMzY=","avatar_url":"https://avatars.githubusercontent.com/u/1535036?v=4","gravatar_id":"","url":"https://api.github.com/users/tamird","html_url":"https://github.com/tamird","followers_url":"https://api.github.com/users/tamird/followers","following_url":"https://api.github.com/users/tamird/following{/other_user}","gists_url":"https://api.github.com/users/tamird/gists{/gist_id}","starred_url":"https://api.github.com/users/tamird/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tamird/subscriptions","organizations_url":"https://api.github.com/users/tamird/orgs","repos_url":"https://api.github.com/users/tamird/repos","events_url":"https://api.github.com/users/tamird/events{/privacy}","received_events_url":"https://api.github.com/users/tamird/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"16c7c79540c26e648b1d0ee09b7c6f4f916258a0","url":"https://api.github.com/repos/openai/codex/commits/16c7c79540c26e648b1d0ee09b7c6f4f916258a0","html_url":"https://github.com/openai/codex/commit/16c7c79540c26e648b1d0ee09b7c6f4f916258a0"}]},{"sha":"16c7c79540c26e648b1d0ee09b7c6f4f916258a0","node_id":"C_kwDOOYsS4doAKDE2YzdjNzk1NDBjMjZlNjQ4YjFkMGVlMDliN2M2ZjRmOTE2MjU4YTA","commit":{"author":{"name":"Channing Conger","email":"cconger@openai.com","date":"2026-06-12T01:44:42Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T01:44:42Z"},"message":"ci(v8): gate Windows source builds on relevant changes (#27715)\n\nAvoid rebuilding sandboxed Windows MSVC V8 artifacts for unrelated\nchanges to `codex-rs/Cargo.toml`.\n\nThe V8 canary now compares the resolved V8 version between the base and\nhead commits and only runs the Windows source-build matrix when:\n\n- the resolved V8 crate version changes;\n- Windows artifact-production scripts or workflows change; or\n- the workflow is manually dispatched.\n\nThe existing Bazel V8 matrix is unchanged.\n\n## Why\n\nThe Windows MSVC source builds take roughly two to three hours and\ncurrently run whenever any entry in the broad `v8-canary` path filter\nchanges.","tree":{"sha":"87d67041d01259181e316cdc987bca237e1b6b0b","url":"https://api.github.com/repos/openai/codex/git/trees/87d67041d01259181e316cdc987bca237e1b6b0b"},"url":"https://api.github.com/repos/openai/codex/git/commits/16c7c79540c26e648b1d0ee09b7c6f4f916258a0","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK2SKCRC1aQ7uu5UhlAAAMQwQAC+Yn9sprpA4VTP0TfpoNVmn\n9SdB4ess/YRJQ04+h16/LjdVh5EJIllnyvWn8qqr5yHXQJqhuInaMkJ/VUQXd8B9\nUCPysAP0YylhSn3Nf65QCqFxnOTWegVX3kmaSHN+8Hyp6/fnDO98gVFEo1M5GzIC\nMBql1d9+apDkY9Y/W05XiUsV3z3zrP8YFsKjmGryLTE2ZaxC1Tcg40QSQ4dwRikl\nzWPVeTAJIdBaFXyjCLrcaEObOsvFok/1IvHKLYiewAGyim5CQvzxJS1pU3uiyxD0\nQMVSfJVhNxzLKiWvw2+9ro8NAOL3iIROQEf7EewACtz9IajFmD0K0t3r6P5t/EMc\nR83e1wMej/amOuqlWBqpoT7O7AbpYcs/IYHTosoQILevSLVZcWlMaSh85dRYyDCf\nDFyRiZTmBH6/ayX/TgtgzRXXvy9UVft+UDaMrMDI421iiXMZfEiE6HKxX681cv3v\neKQCAGtmkxoElXKD6jNTozmlaEKAr/xLV5Gk8SJqvsnFGcpGRj/ruLH23Qv491jD\nMk3B2qEjaRKv+0ExAo7TJLGQbdyB1U18245V6tvq0Tgg2bEA5mwSgc8UNxTjUpf+\n/ixCuGFwvx2aIC5zdX6ZgopSi6QFAy2QvEyPXiPTG5z1uAMnq4QPn9NOAgmHfcEa\nt9od96IRAUV4FXt804wQ\n=IWSk\n-----END PGP SIGNATURE-----\n","payload":"tree 87d67041d01259181e316cdc987bca237e1b6b0b\nparent 69b0f52b2a728d71f4800793c6c069956a91a2f8\nauthor Channing Conger <cconger@openai.com> 1781228682 -0700\ncommitter GitHub <noreply@github.com> 1781228682 -0700\n\nci(v8): gate Windows source builds on relevant changes (#27715)\n\nAvoid rebuilding sandboxed Windows MSVC V8 artifacts for unrelated\nchanges to `codex-rs/Cargo.toml`.\n\nThe V8 canary now compares the resolved V8 version between the base and\nhead commits and only runs the Windows source-build matrix when:\n\n- the resolved V8 crate version changes;\n- Windows artifact-production scripts or workflows change; or\n- the workflow is manually dispatched.\n\nThe existing Bazel V8 matrix is unchanged.\n\n## Why\n\nThe Windows MSVC source builds take roughly two to three hours and\ncurrently run whenever any entry in the broad `v8-canary` path filter\nchanges.","verified_at":"2026-06-12T01:44:42Z"}},"url":"https://api.github.com/repos/openai/codex/commits/16c7c79540c26e648b1d0ee09b7c6f4f916258a0","html_url":"https://github.com/openai/codex/commit/16c7c79540c26e648b1d0ee09b7c6f4f916258a0","comments_url":"https://api.github.com/repos/openai/codex/commits/16c7c79540c26e648b1d0ee09b7c6f4f916258a0/comments","author":{"login":"cconger","id":200563,"node_id":"MDQ6VXNlcjIwMDU2Mw==","avatar_url":"https://avatars.githubusercontent.com/u/200563?v=4","gravatar_id":"","url":"https://api.github.com/users/cconger","html_url":"https://github.com/cconger","followers_url":"https://api.github.com/users/cconger/followers","following_url":"https://api.github.com/users/cconger/following{/other_user}","gists_url":"https://api.github.com/users/cconger/gists{/gist_id}","starred_url":"https://api.github.com/users/cconger/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cconger/subscriptions","organizations_url":"https://api.github.com/users/cconger/orgs","repos_url":"https://api.github.com/users/cconger/repos","events_url":"https://api.github.com/users/cconger/events{/privacy}","received_events_url":"https://api.github.com/users/cconger/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","re