_id":"C_kwDOPTymldoAKGQ3NDA5MGZhZDFiYjVlZjZiNDk1ODZhZmJiYmI3NjJhZGQ0Nzg2MDk","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-02T02:58:42Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-02T02:58:42Z"},"message":"chore(deps): require fixed NVIDIA endpoints package (#4421)\n\nThis raises the `deepagents-code[nvidia]` extra to\n`langchain-nvidia-ai-endpoints>=1.4.3`, the first ai-endpoints release\nwhose aiohttp range allows fixed 3.14.x releases. It keeps downstream\n`deepagents-code[nvidia]` installs from resolving through `aiohttp\n3.13.5` while preserving the existing `<2.0.0` upper bound.","tree":{"sha":"cea61bd1beb3bef3bdd5ad6f568d6713aca5f2c8","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/cea61bd1beb3bef3bdd5ad6f568d6713aca5f2c8"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/d74090fad1bb5ef6b49586afbbbb762add478609","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqRdPiCRC1aQ7uu5UhlAAAKLAQAB8VLw8jjd7klVTNEJUvyeVV\nZLdWynvdAEI6D6pU5KdIfRKlV8FlEzKk3nGkuECK1iUEEUBTqZRMOEgBSlGcQTjs\nUgY3jMT26+kc0OIZM+IzGypNVD2lhefu54fQCzGAu+DF8Lf06qNLghUycFJib5I9\nbPCUF7iUiBuV2G03Th/Fh+bLJ9dy/FR5XbYCGbHSaSyfrut010LwpqwRuE+haqCJ\nxojAFQTtVirHr982dUU6zESTtrwVlqDsoEigdHG16xA2VFJndeDL8CB2KP5+ww/u\nSUEWVNzcezaQZcAKrwgVFUJgUKVfEyO9Cp8qZ3WzH+oc66cREgZ+Xhy8B6fEtYh/\n4RqFCrD3Z0ZZOKuph3VnmpW9wF6ekl3lznP9G3KMi5R9J5vdBJ3MeRp3ts4qgrwI\n51JZtjzsE21OSerRe/bRjAreJAOS/JAe1Cl3OCXUCSmLWfSW1Fc1ThFDpjP17Es+\nOoSe574V3qo89iTI5eSZwsV2YNdUz+YaBQXN3LKvrFLVIoSfpi+izng89ewFAIFa\nroJ+uQonpUGBkGwYDBZeRA2erJFjTyahyIlmjleyo/w9UIqmWWaDG9iKmnzVNLCH\ncFncjlBtcS0AVWnC4WPBfFheOhFCULHPLMYVq6fb3Hi3w+CcQTdG8A0deMc5xax+\nAfIAfZMV1bLnuIg35Qs0\n=7FK8\n-----END PGP SIGNATURE-----\n","payload":"tree cea61bd1beb3bef3bdd5ad6f568d6713aca5f2c8\nparent 3735829a0c14fb1537daf930140c66b647c8222c\nauthor Mason Daugherty <mason@langchain.dev> 1782961122 -0400\ncommitter GitHub <noreply@github.com> 1782961122 -0400\n\nchore(deps): require fixed NVIDIA endpoints package (#4421)\n\nThis raises the `deepagents-code[nvidia]` extra to\n`langchain-nvidia-ai-endpoints>=1.4.3`, the first ai-endpoints release\nwhose aiohttp range allows fixed 3.14.x releases. It keeps downstream\n`deepagents-code[nvidia]` installs from resolving through `aiohttp\n3.13.5` while preserving the existing `<2.0.0` upper bound.","verified_at":"2026-07-02T02:58:43Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/d74090fad1bb5ef6b49586afbbbb762add478609","html_url":"https://github.com/langchain-ai/deepagents/commit/d74090fad1bb5ef6b49586afbbbb762add478609","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/d74090fad1bb5ef6b49586afbbbb762add478609/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"3735829a0c14fb1537daf930140c66b647c8222c","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/3735829a0c14fb1537daf930140c66b647c8222c","html_url":"https://github.com/langchain-ai/deepagents/commit/3735829a0c14fb1537daf930140c66b647c8222c"}]},{"sha":"3735829a0c14fb1537daf930140c66b647c8222c","node_id":"C_kwDOPTymldoAKDM3MzU4MjlhMGMxNGZiMTUzN2RhZjkzMDE0MGM2NmI2NDdjODIyMmM","commit":{"author":{"name":"Johannes du Plessis","email":"johannes@langchain.dev","date":"2026-07-02T01:44:52Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-02T01:44:52Z"},"message":"feat(code): collapse completed tool calls into group summaries (#4373)\n\nCollapses each assistant step's tool calls into a single collapsible\nline in the code TUI — live progress while running, past tense when the\nstep finishes, click or Ctrl+O to expand. Errored, rejected, and skipped\ntools stay visible.\n\nThe Thinking spinner now remains pinned as a stable turn-level indicator\nwhile tool rows mount above it, and tool-group updates are coalesced to\navoid transcript flicker during streaming.\n\n## Video\n\n\nhttps://github.com/user-attachments/assets/8e69e331-77d7-46ed-bdc9-a8b33db9ba75\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","tree":{"sha":"451cb823cda5c505be1612f6b8205b05233ef47d","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/451cb823cda5c505be1612f6b8205b05233ef47d"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/3735829a0c14fb1537daf930140c66b647c8222c","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqRcKUCRC1aQ7uu5UhlAAAFBcQALBPkUMhqPe33EHIArBNw3Co\ncD5zmBaaBQUyZIfWtw2hlfGdcZyvlFxfYNctjzalEMilWEW5xlnsVSs99jz22r1m\n74Gy/MMjGaPhfpkPwGsgbCPlHeWoqsiBP8MUrYjQMJGuo8MLgqtlPDmetow02quO\n9wMX9ITj6yRnXKfp5rOFXtAtWrL9By8we6NBhHBHviGT/h8Br3bhtzHITassOYCl\nFS9mtK/gVCCG8M0RRH4VjeKkZd6UyCe8xT7f5+gCR3oOdkGOMFiXZMmGFH4FrEq+\nopSLvgpWFGKa5d0ziSKLnToEA3JCOY5aJZpUqwyjJmxWx9oNREBaTIBa5BSgsaX6\n5X8/RiLSin4rfRvnVV4VA4TBzKk4xoF3AWgs5uk5GpzCxzTWSPqFg+OzwCuJMEZj\njExdf1ff6lefqJkwfWtWqAq//jrY0JIgrolZQ7rDGZX+/XBPkbREYwC3sHB8BkOM\nplV3qH0YcRVL00ycqmMHZLtrh5haS667vi/jVuwZwfkiOl+OLvwNORy0f8FPM57w\ndqg+6xRz0aZhCoHJVrPrxTq7qcgHnNJN3izwqu4p/98fZZdMW5wuHeCnKBMaHc15\noFoHFq1c5Xuqd8veAiusiY3MrvTv1W0PxTD6lPz098j2ywtTfE5hrKZnU06rIZYe\nH9hox+LSnI7a0o/n61rI\n=WvmU\n-----END PGP SIGNATURE-----\n","payload":"tree 451cb823cda5c505be1612f6b8205b05233ef47d\nparent a4abdd89df3be884d26b5f7af5c012264089cf14\nauthor Johannes du Plessis <johannes@langchain.dev> 1782956692 -0700\ncommitter GitHub <noreply@github.com> 1782956692 -0400\n\nfeat(code): collapse completed tool calls into group summaries (#4373)\n\nCollapses each assistant step's tool calls into a single collapsible\nline in the code TUI — live progress while running, past tense when the\nstep finishes, click or Ctrl+O to expand. Errored, rejected, and skipped\ntools stay visible.\n\nThe Thinking spinner now remains pinned as a stable turn-level indicator\nwhile tool rows mount above it, and tool-group updates are coalesced to\navoid transcript flicker during streaming.\n\n## Video\n\n\nhttps://github.com/user-attachments/assets/8e69e331-77d7-46ed-bdc9-a8b33db9ba75\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","verified_at":"2026-07-02T01:44:52Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/3735829a0c14fb1537daf930140c66b647c8222c","html_url":"https://github.com/langchain-ai/deepagents/commit/3735829a0c14fb1537daf930140c66b647c8222c","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/3735829a0c14fb1537daf930140c66b647c8222c/comments","author":{"login":"johannes117","id":51395795,"node_id":"MDQ6VXNlcjUxMzk1Nzk1","avatar_url":"https://avatars.githubusercontent.com/u/51395795?v=4","gravatar_id":"","url":"https://api.github.com/users/johannes117","html_url":"https://github.com/johannes117","followers_url":"https://api.github.com/users/johannes117/followers","following_url":"https://api.github.com/users/johannes117/following{/other_user}","gists_url":"https://api.github.com/users/johannes117/gists{/gist_id}","starred_url":"https://api.github.com/users/johannes117/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/johannes117/subscriptions","organizations_url":"https://api.github.com/users/johannes117/orgs","repos_url":"https://api.github.com/users/johannes117/repos","events_url":"https://api.github.com/users/johannes117/events{/privacy}","received_events_url":"https://api.github.com/users/johannes117/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a4abdd89df3be884d26b5f7af5c012264089cf14","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a4abdd89df3be884d26b5f7af5c012264089cf14","html_url":"https://github.com/langchain-ai/deepagents/commit/a4abdd89df3be884d26b5f7af5c012264089cf14"}]},{"sha":"a4abdd89df3be884d26b5f7af5c012264089cf14","node_id":"C_kwDOPTymldoAKGE0YWJkZDg5ZGYzYmU4ODRkMjZiNWY3YWY1YzAxMjI2NDA4OWNmMTQ","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-02T01:08:05Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-02T01:08:05Z"},"message":"style(code): collapse `grep`/`glob` output preview by default (#4416)\n\n`grep` and `glob` tool calls now collapse their output preview by\ndefault in the TUI; expand with click or Ctrl+O to view the results.\n\n---\n\nPorts the `read_file` collapse-by-default TUI behavior (#4362) to `grep`\nand `glob`. The search pattern is already shown in the tool header, so\nechoing the matches inline is redundant noise. Output collapses entirely\nwith an expand affordance, staying viewable via click/Ctrl+O.\n\nEmpty serialized result sets (`[]`) still render nothing and do not show\na bogus expand affordance. Human-readable no-result messages from the\nactive tools (`No matches found` / `No files found`) remain visible\ninline and are not expandable.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/769857e2-ebd8-193a-d249-cc7b6c60dcdd)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"e45190f3172b5baa39fce5c620c90efaffc7ae1e","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/e45190f3172b5baa39fce5c620c90efaffc7ae1e"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/a4abdd89df3be884d26b5f7af5c012264089cf14","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqRbn1CRC1aQ7uu5UhlAAA83cQAEAl3S1ssC825QbqoEk41itm\ntyRmTVAHUV7yjiJ5BPgUIS17fWECMRkfNkpzgCaa2YWJ53n078/grO3j1wNM9SiO\ne1RW5YA1HrUotLgp6VzuwfOlCtLL4LUIiAUvMk4+/9Wg0HRQoF6d3lyWsVQ67bGt\nxDnLOrRnvDzX5KGNWTaZVMW4Ob97GtcJU7na0zREL7kkVE4/FTcu//CUKMsHRIrS\nlNi8Fo6+8nvKAx1BaSdGDes5IGwHB5iQAPA8Rha67YbpWhovtpUWigGjNIcFRvgw\n0eK+UTwA3NswemjU6G6wUqGsfY0WbgnLZ2J8j0xmh6QKZB2oFqwcjto55+g4tijK\nuylSZdv4aCQUxDI0ExbrTn6G/FztBjk7Cm9YJ4yuMkfF54f2JLLhl90p1C1g2EA0\n0hkZZ1NrCUt0HQxqFJb40U7vcqKx4QdrAU/sy20DEggm5IkjZLkAZXe7xESeSMR0\nbtz0tiwZ77vSYsMEATd63m6cmScGlk+AVR1QG3ybXGVBHWlRa42eGNMuITHVWI28\n9IH/MAJFiY5XCXWdEnB1Kz7TYusk/1Ivq1Uc/D7zrS0+zTMSDvvLL/1xngdl8/rX\nBL3lj/lyvh1pQExn4GvdGoIZACJ83iSQ9iSOr7M96NOuvHVtJI+II06eQ7wL1MBn\n+CCsedFBOYfGI3g9OugY\n=rfIQ\n-----END PGP SIGNATURE-----\n","payload":"tree e45190f3172b5baa39fce5c620c90efaffc7ae1e\nparent 5605a681c9fec888d8c6dfbde2decd4692c8cef0\nauthor Mason Daugherty <mason@langchain.dev> 1782954485 -0400\ncommitter GitHub <noreply@github.com> 1782954485 -0400\n\nstyle(code): collapse `grep`/`glob` output preview by default (#4416)\n\n`grep` and `glob` tool calls now collapse their output preview by\ndefault in the TUI; expand with click or Ctrl+O to view the results.\n\n---\n\nPorts the `read_file` collapse-by-default TUI behavior (#4362) to `grep`\nand `glob`. The search pattern is already shown in the tool header, so\nechoing the matches inline is redundant noise. Output collapses entirely\nwith an expand affordance, staying viewable via click/Ctrl+O.\n\nEmpty serialized result sets (`[]`) still render nothing and do not show\na bogus expand affordance. Human-readable no-result messages from the\nactive tools (`No matches found` / `No files found`) remain visible\ninline and are not expandable.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/769857e2-ebd8-193a-d249-cc7b6c60dcdd)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-07-02T01:08:05Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a4abdd89df3be884d26b5f7af5c012264089cf14","html_url":"https://github.com/langchain-ai/deepagents/commit/a4abdd89df3be884d26b5f7af5c012264089cf14","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a4abdd89df3be884d26b5f7af5c012264089cf14/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"5605a681c9fec888d8c6dfbde2decd4692c8cef0","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/5605a681c9fec888d8c6dfbde2decd4692c8cef0","html_url":"https://github.com/langchain-ai/deepagents/commit/5605a681c9fec888d8c6dfbde2decd4692c8cef0"}]},{"sha":"5605a681c9fec888d8c6dfbde2decd4692c8cef0","node_id":"C_kwDOPTymldoAKDU2MDVhNjgxYzlmZWM4ODhkOGM2ZGZiZGUyZGVjZDQ2OTJjOGNlZjA","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-02T01:03:30Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-02T01:03:30Z"},"message":"fix(code): persist rubric model after server restart (#4419)\n\nRubric grader model changes made through `dcode` now survive later\nowned-server restarts after a successful respawn.\n\n---\n\nChanging the rubric grader model while `dcode` owns the server now\npersists the selected override only after the server respawns\nsuccessfully. Failed respawns still roll the staged environment back,\nwhile clearing the model persists an empty override so a previously\nselected grader cannot reappear on a later restart.\n\n## Changes\n\n- Persist `DEEPAGENTS_CODE_SERVER_RUBRIC_MODEL` after successful\nowned-server respawns in `DeepAgentsApp._set_rubric_model`.\n- Keep failed respawns rollback-only by restoring the staged environment\nwithout persisting the failed override.\n- Cover setting, clearing, success ordering, and failed-respawn rollback\nbehavior for rubric model changes.","tree":{"sha":"da883c9afd4ec28666b6306cc2a47d1daf395318","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/da883c9afd4ec28666b6306cc2a47d1daf395318"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/5605a681c9fec888d8c6dfbde2decd4692c8cef0","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqRbjiCRC1aQ7uu5UhlAAA4mYQALEDRGwUXFyANMamvXoa34gu\ntP4REershZdPWXTN9rRVyOpcZPEkwT7F+QMHPDwzbTrJWBmaStFG1QdHWMnbTiL/\nV0+EiuFA2o5vxAilNhrJDXAkhmFQHTkdOfJVuZ5KhIy1RVvHD/pCKyVbyFeQB//c\nWsCCPhe52VYvRvjnXSUVV+HVm0HA6/I3HGcPnEtA9JwYmmlRmQ/L3Ps2FnGjMrcM\nUiZJGafnYdOTzgEkZWL56qqs16v++MiHZJbxfkwraZruaihURGjOibeAabHERLck\nRwVk9fiYh2g3/tveZheo6/BsCUcV7X3maZvkhN+48nfw+hJw7HwWZr9euWnCWElg\nBkfP4WWyUJkdV2oA0PC5gtbzikgbpgS+XC3fs/wNYM4lnL4VCqhiQlKO46R1VICF\nCUwTUft3pEZAuIV+DWK6BX2dwg/vWCZyX2ZT+zFp93ZJiW6iq9voTv4nF4T8yOdH\n9P7eEuUhSEoswvH4sNmAAiCzIUZrSMYDC9YC1uQlrNFJR3SQai5gadlTuOYz9iPO\n1DqgsjHWzl0mMtPx/9ffkYiP0VwPk1w9Gndp0D5K4wJ8uL6nb3aS52M3b3t8Ednr\ng2TC/ERwxoKJl30XZkevdlOZyz4oxlfwK3U61bbH609tp82hpfRH3SvwYZn3W0ov\nAFXXK2/tVjiILxgh98vB\n=FxNF\n-----END PGP SIGNATURE-----\n","payload":"tree da883c9afd4ec28666b6306cc2a47d1daf395318\nparent 5df9c83b58f2529561848ae9f1364961e1c80641\nauthor Mason Daugherty <mason@langchain.dev> 1782954210 -0400\ncommitter GitHub <noreply@github.com> 1782954210 -0400\n\nfix(code): persist rubric model after server restart (#4419)\n\nRubric grader model changes made through `dcode` now survive later\nowned-server restarts after a successful respawn.\n\n---\n\nChanging the rubric grader model while `dcode` owns the server now\npersists the selected override only after the server respawns\nsuccessfully. Failed respawns still roll the staged environment back,\nwhile clearing the model persists an empty override so a previously\nselected grader cannot reappear on a later restart.\n\n## Changes\n\n- Persist `DEEPAGENTS_CODE_SERVER_RUBRIC_MODEL` after successful\nowned-server respawns in `DeepAgentsApp._set_rubric_model`.\n- Keep failed respawns rollback-only by restoring the staged environment\nwithout persisting the failed override.\n- Cover setting, clearing, success ordering, and failed-respawn rollback\nbehavior for rubric model changes.","verified_at":"2026-07-02T01:03:31Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/5605a681c9fec888d8c6dfbde2decd4692c8cef0","html_url":"https://github.com/langchain-ai/deepagents/commit/5605a681c9fec888d8c6dfbde2decd4692c8cef0","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/5605a681c9fec888d8c6dfbde2decd4692c8cef0/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"5df9c83b58f2529561848ae9f1364961e1c80641","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/5df9c83b58f2529561848ae9f1364961e1c80641","html_url":"https://github.com/langchain-ai/deepagents/commit/5df9c83b58f2529561848ae9f1364961e1c80641"}]},{"sha":"5df9c83b58f2529561848ae9f1364961e1c80641","node_id":"C_kwDOPTymldoAKDVkZjljODNiNThmMjUyOTU2MTg0OGFlOWYxMzY0OTYxZTFjODA2NDE","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-02T00:39:07Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-02T00:39:07Z"},"message":"fix(code): allow `/remember` with args when no conversation history (#4418)\n\n`/remember` now proceeds when context is provided as an argument, even\nwith no prior conversation history. Bare `/remember` with no history\nstill shows the existing \"Nothing to remember yet\" prompt.\n\n---\n\nBare `/remember` with no conversation history shows an early-return\n\"Nothing to remember yet\" message. That guard also blocked `/remember i\nlike blue` — even though the user supplied context to save, the command\nnever reached the skill.\n\nMove argument extraction above the no-messages guard so the guard only\ntriggers when `/remember` is bare (no args) **and** there are no\nconversation messages. With args, the command delegates to\n`/skill:remember <args>` regardless of conversation state.","tree":{"sha":"3c16ccca7e7a9bdb162a7542e6e0d090aa5a0950","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/3c16ccca7e7a9bdb162a7542e6e0d090aa5a0950"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/5df9c83b58f2529561848ae9f1364961e1c80641","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqRbMrCRC1aQ7uu5UhlAAANoQQAJMNb8XnerFNom2nXf334yVa\nemDVA81BROf+c5h6Cejsrt7T7jC+wkctVuBzWZ6WRnA0c5bJY03Qfgbn0VnMG4gM\ndmGz7eTGPs0p6m9Ja2ns32gUSm6yk9yWGW+1VDTar+wlLp/5AxDxF6hh4cZCnR87\nwNUiyNMSWDRoV1egcJ4DQ2YyYMSvLFNKwFfPn8voNnpGqirtm+2GkctNo11SrbBV\nGofpDWfnvoO7kU306VMGt3Yfq1F+ZS/y9Om/zndKB7tUcwMi4fzrkwg4XeK7a5uH\nRQZa6XYbbvBEahQrjGsl3Ca8vsrgOEJ7erw/RX8XkI1am4KAHIn5U+9qV/K1cbPw\nBtPD9yG+9tNCuIrNLI1YUW+xI5ne5NER9aZd9wmOGd4DoZeOHWV7C99XjC4EshWR\nPFQ0qpmBWFEocib5YiBo1Z9hFJcWwxbMHlWCKiGzPEOlRbI3diEhv9iPr85YOCPj\nXD3nGZ5fu5Dtl3gp78CHKW0mrC0WTTFoNXrOu+3B1okz2xVnCXixSug4TBxd7CyJ\nSUF2/SyeA6Ki2k8oixzxiPOX3wl8d1awWj5qDKErO84zmJ9FDJx1/Xm6CJuIF1jQ\nNAIzvVe0SpTn5+f+jkpHxoMAzZDN/Gd/rLy9u78SgpObRHIqCOe1YSc7YII/vEFr\noAayyrS17Sm/sMkfseI7\n=IegC\n-----END PGP SIGNATURE-----\n","payload":"tree 3c16ccca7e7a9bdb162a7542e6e0d090aa5a0950\nparent a52c18d3ef8fe462d1289dca8798c51450e0368a\nauthor Mason Daugherty <mason@langchain.dev> 1782952747 -0400\ncommitter GitHub <noreply@github.com> 1782952747 -0400\n\nfix(code): allow `/remember` with args when no conversation history (#4418)\n\n`/remember` now proceeds when context is provided as an argument, even\nwith no prior conversation history. Bare `/remember` with no history\nstill shows the existing \"Nothing to remember yet\" prompt.\n\n---\n\nBare `/remember` with no conversation history shows an early-return\n\"Nothing to remember yet\" message. That guard also blocked `/remember i\nlike blue` — even though the user supplied context to save, the command\nnever reached the skill.\n\nMove argument extraction above the no-messages guard so the guard only\ntriggers when `/remember` is bare (no args) **and** there are no\nconversation messages. With args, the command delegates to\n`/skill:remember <args>` regardless of conversation state.","verified_at":"2026-07-02T00:39:08Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/5df9c83b58f2529561848ae9f1364961e1c80641","html_url":"https://github.com/langchain-ai/deepagents/commit/5df9c83b58f2529561848ae9f1364961e1c80641","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/5df9c83b58f2529561848ae9f1364961e1c80641/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a52c18d3ef8fe462d1289dca8798c51450e0368a","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a52c18d3ef8fe462d1289dca8798c51450e0368a","html_url":"https://github.com/langchain-ai/deepagents/commit/a52c18d3ef8fe462d1289dca8798c51450e0368a"}]},{"sha":"a52c18d3ef8fe462d1289dca8798c51450e0368a","node_id":"C_kwDOPTymldoAKGE1MmMxOGQzZWY4ZmU0NjJkMTI4OWRjYTg3OThjNTE0NTBlMDM2OGE","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-02T00:20:51Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-02T00:20:51Z"},"message":"fix(code): quiet routine ripgrep installer output (#4417)\n\n`dcode` install no longer prints routine ripgrep setup messages unless\nverbose mode is enabled or ripgrep setup fails.\n\n---\n\nRoutine ripgrep provisioning is an implementation detail of `dcode`\ninstallation, so successful managed setup no longer adds extra status\nlines to default installer output. Verbose installs and failure paths\nstill expose the setup command output for debugging.","tree":{"sha":"8b38cc90f0b59d95e880b8638f8dd7fd62fdb164","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/8b38cc90f0b59d95e880b8638f8dd7fd62fdb164"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/a52c18d3ef8fe462d1289dca8798c51450e0368a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqRa7jCRC1aQ7uu5UhlAAAv2IQAKe4TFvDuZabr4cgLygOzl4b\n9oXFXS8ntKd3EJLZScrK0AU7KpWlVrv+nmS4NQFaVb08UEp14WknCBDHVrF0uN5F\nq+PperdpasXtr7eaQk0N+rh8n+DVyJkdKMAtTboVBp+aigD98h/T8+mNzXdFGu7N\n9NLbthqFysMA75CFBJI+4riqdpyUE0pJAqvsA82nnonufqZBmRxoKF4lxLXE4UtC\ngoikRkpL7pm2WZLsEy/fgkkSaaiTlKreRTrnD3Ksmivfs0wE6FGOUt4ta/26Xk9Z\nLKxSPEZp1B1+6MU6gaiaXYTStVuiydGC62FrNrnmJBhsdoWs2eZxqd7mJhzZkGhQ\n/60tiNvDNaYCsVznfxO3qPr4em/pE58/omv1aCHY69/YpdywL/Zc6WU3dyfJFL4f\nDHsGc8kSCQbR0bxoiyEfsOGwVU1LiK7xUnaK3H1JUlag42b4uhgyU370YJ/ImBz8\nhBANgVp03Hn6BquYq7oGqzTqlgWkLZUN2rsyOhktzSe4IiM5GKgPjKSOY/3nevCl\naQMNK3V3SZaGKczCI2ODRKED6MR+O/ltBWQD9MewINeAIpTyI+SPD3Q6anib22yr\nLsV7uqj4Mms0K931ywhJWtFp/ZEknNn65gVj5ETvR+Ohh7GkNkM0j3EgsTQLTPZm\nZrYq3tYyMcLx09r+6DNd\n=vSwt\n-----END PGP SIGNATURE-----\n","payload":"tree 8b38cc90f0b59d95e880b8638f8dd7fd62fdb164\nparent 9763ffceab8800526ae9fe10decdb2f32d8e4707\nauthor Mason Daugherty <mason@langchain.dev> 1782951651 -0400\ncommitter GitHub <noreply@github.com> 1782951651 -0400\n\nfix(code): quiet routine ripgrep installer output (#4417)\n\n`dcode` install no longer prints routine ripgrep setup messages unless\nverbose mode is enabled or ripgrep setup fails.\n\n---\n\nRoutine ripgrep provisioning is an implementation detail of `dcode`\ninstallation, so successful managed setup no longer adds extra status\nlines to default installer output. Verbose installs and failure paths\nstill expose the setup command output for debugging.","verified_at":"2026-07-02T00:20:51Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a52c18d3ef8fe462d1289dca8798c51450e0368a","html_url":"https://github.com/langchain-ai/deepagents/commit/a52c18d3ef8fe462d1289dca8798c51450e0368a","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a52c18d3ef8fe462d1289dca8798c51450e0368a/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"9763ffceab8800526ae9fe10decdb2f32d8e4707","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9763ffceab8800526ae9fe10decdb2f32d8e4707","html_url":"https://github.com/langchain-ai/deepagents/commit/9763ffceab8800526ae9fe10decdb2f32d8e4707"}]},{"sha":"9763ffceab8800526ae9fe10decdb2f32d8e4707","node_id":"C_kwDOPTymldoAKDk3NjNmZmNlYWI4ODAwNTI2YWU5ZmUxMGRlY2RiMmYzMmQ4ZTQ3MDc","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-01T23:59:34Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-01T23:59:34Z"},"message":"feat(code): auto-detect MCP OAuth from 401 challenge (#4364)\n\nMCP servers that require OAuth are now auto-detected from their 401\nchallenge, so `dcode mcp login <server>` works without manually setting\n`auth: oauth`.\n\n---\n\nPreviously a remote MCP server only triggered OAuth if the config\nexplicitly set `auth: oauth`; otherwise an auth-requiring server failed\nwith an opaque `error`. This detects the spec-compliant OAuth challenge\n(HTTP 401 + `WWW-Authenticate`, RFC 9728) during tool discovery and\nmarks the server `unauthenticated` so the user is prompted to `/mcp\nlogin`. Stored tokens now attach the OAuth provider regardless of the\n`auth` field, unless the server config already provides a static\n`Authorization` header, and `login` works for any http/sse server. We\ndeliberately do not infer OAuth from the URL.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/9e33d490-9aba-d37d-d465-b198856cd367)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"0b1811518d9ad8eb2aa8c95e93fa94eb734919c1","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/0b1811518d9ad8eb2aa8c95e93fa94eb734919c1"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/9763ffceab8800526ae9fe10decdb2f32d8e4707","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqRanmCRC1aQ7uu5UhlAAAGO4QABOXQQdi9Rmk1XV9xMzdLQb7\nf4y5a7DsfrEXoF0MEHmn1gF0A/sq9nWlUNlF4LuFg7qVaiNNYNnB6ZC5EY0hOYS7\nz7lXCOXybIweP7C+dfp6I73dOw0Vmv0cL7Q22I+6oQtG11QRMPhkMfAT/owC4JpZ\nx7lnfdCnQXEc77i6LWC1KtzbzYjl+vZeZxGJ5UpTZlFJgcEjj0t0oYluMbgrCH1e\nGvW7ibuRYY3z6HFarB9PAXZP+cAGskJf0JDKthtsX0xnHej42jboahQISl9Nc+Zf\nOumOWuEU4GyNUDPbU3BElXN55lSrm4DyFMnr/qF9jRP5XEEMbO3xVmJjFpLevX6F\nO/3AC17C/pARFBdXyplKThGVk81HQRE3h20ruFlUiRy3iPDaz/XN1tvCl1jNRNpe\n8y4hbZxSOdf4hb32WHKtfebTpYdxYLbNdBTSRnl3XYslPUu7qzfJXyJCYZFkcBLz\nIbJisdJzLwp5bKca//sEbUxFwrs1E8ZEMKzlKT0mpVLaHX/afsw+syNDdMmTd6qc\nF7hWJ2XIDTJ2kjdgEJhYaNfsbw4Hv+A1+af2edwGSyzGhQ98CKVzbKqY8YI5EbCt\nt3eYx1s3qJR1M/JSkqaoYSLGBwIdm/KE2wn/nY2LUWaALLM8xBCFRWtKXOEuCx16\nZwBGgJibMAX3tJSWD19N\n=cRKR\n-----END PGP SIGNATURE-----\n","payload":"tree 0b1811518d9ad8eb2aa8c95e93fa94eb734919c1\nparent 6d081690117df631b18b3b9daeb581faa3d80703\nauthor Mason Daugherty <mason@langchain.dev> 1782950374 -0400\ncommitter GitHub <noreply@github.com> 1782950374 -0400\n\nfeat(code): auto-detect MCP OAuth from 401 challenge (#4364)\n\nMCP servers that require OAuth are now auto-detected from their 401\nchallenge, so `dcode mcp login <server>` works without manually setting\n`auth: oauth`.\n\n---\n\nPreviously a remote MCP server only triggered OAuth if the config\nexplicitly set `auth: oauth`; otherwise an auth-requiring server failed\nwith an opaque `error`. This detects the spec-compliant OAuth challenge\n(HTTP 401 + `WWW-Authenticate`, RFC 9728) during tool discovery and\nmarks the server `unauthenticated` so the user is prompted to `/mcp\nlogin`. Stored tokens now attach the OAuth provider regardless of the\n`auth` field, unless the server config already provides a static\n`Authorization` header, and `login` works for any http/sse server. We\ndeliberately do not infer OAuth from the URL.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/9e33d490-9aba-d37d-d465-b198856cd367)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-07-01T23:59:35Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9763ffceab8800526ae9fe10decdb2f32d8e4707","html_url":"https://github.com/langchain-ai/deepagents/commit/9763ffceab8800526ae9fe10decdb2f32d8e4707","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9763ffceab8800526ae9fe10decdb2f32d8e4707/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"6d081690117df631b18b3b9daeb581faa3d80703","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/6d081690117df631b18b3b9daeb581faa3d80703","html_url":"https://github.com/langchain-ai/deepagents/commit/6d081690117df631b18b3b9daeb581faa3d80703"}]},{"sha":"6d081690117df631b18b3b9daeb581faa3d80703","node_id":"C_kwDOPTymldoAKDZkMDgxNjkwMTE3ZGY2MzFiMThiM2I5ZGFlYjU4MWZhYTNkODA3MDM","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-01T23:46:58Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-01T23:46:58Z"},"message":"style(code): hide `edit_file` result output on success (#4363)\n\nThe `deepagents-code` TUI keeps successful `edit_file` rows compact\nwithout making the original tool result irrecoverable. A successful edit\nstill shows the `✓ Success!` status instead of the redundant result\nline, but clicking the row now expands to the original `edit_file`\noutput.\n\n---\n\nTwo related polish changes to the `deepagents-code` tool widget for\n`edit_file`:\n\n1. On a successful `edit_file`, the collapsed view hides the redundant\nresult line (\"Successfully replaced N instance(s) ...\") because the diff\nand status already convey the outcome.\n2. Successful `edit_file` calls remain expandable, and the full view\nrenders the original tool output so users can recover the exact message\nwhen they want it. Errors still surface immediately.\n3. Successful tool calls with no visible collapsed output show a `✓\nSuccess!` status marker instead of hiding the status entirely; tools\nwhose output speaks for itself stay unchanged.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/65a9fbf8-684e-d967-c8ad-2e89189a50fa)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"126031704899380295cd06a75ddb74021120ce53","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/126031704899380295cd06a75ddb74021120ce53"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/6d081690117df631b18b3b9daeb581faa3d80703","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqRabyCRC1aQ7uu5UhlAAAs9gQAA2jfs0lOTg3BTbF01a9udSn\nR7+f94szY0BNHjaOeOLAv9euEoHxgSRUQ2eTNfc0bF0rURk+VbFB107cFFiGn3eK\nS/aq9vf0hZPDLfLSzcB3DDcNDisJWT0HcL0PNDSf178BHkEHtsZ9pSiTwu8whxh0\nqOyPgbMyuvZwO9C3s3cj7taqbBr0K6Z9Te6GqiYFEfmQr5iOzqbNTbPLbiTXHWYX\n5akAFQ6tHeM+XIRcs0GrWwoSPnHMrw3HAF8q1JJeqGbjtUEZF7gOBDfaMhcX/nuA\nbzbPczg2TSvz7aDjA7FFAWkqgLsTJgYSuFgEmxulUo9sQ/u02+qQzoIXkulmtfOy\nIlxYmPZGBsRvV8v4hTOX+01ZzgQTfsuuUkaK82/vZlgV6v6zhl7y2pkx+qNndpP3\nv4KneLAVmnaoKB/weSU33yZY/mV6kA5eKjS3yUzppAoa15VVcyRoYIEZ/BGRLDxF\nuw5sovzdI1Rpo7Y7LXQVmoi8fPwDF5lKjmL1Cvp46D4TK9Vzdweg+tNQp9ovHIg9\nEcTY2uYR5Y+CVuJeKyCiTKKHeI8Lh1CNV4e8pvWJlRe36aw4EWJFJSPEckCiOFAR\nVgAFpC2A//BhTP25a6Aw6qcQoCwnMNfwsRRTDfQDzcjegw4r5XLMer/Eow/XYtYw\nsWJsm4buosRe78Ekfj/2\n=xGxW\n-----END PGP SIGNATURE-----\n","payload":"tree 126031704899380295cd06a75ddb74021120ce53\nparent ac386488033303f0657c295d82c7722be78948cc\nauthor Mason Daugherty <mason@langchain.dev> 1782949618 -0400\ncommitter GitHub <noreply@github.com> 1782949618 -0400\n\nstyle(code): hide `edit_file` result output on success (#4363)\n\nThe `deepagents-code` TUI keeps successful `edit_file` rows compact\nwithout making the original tool result irrecoverable. A successful edit\nstill shows the `✓ Success!` status instead of the redundant result\nline, but clicking the row now expands to the original `edit_file`\noutput.\n\n---\n\nTwo related polish changes to the `deepagents-code` tool widget for\n`edit_file`:\n\n1. On a successful `edit_file`, the collapsed view hides the redundant\nresult line (\"Successfully replaced N instance(s) ...\") because the diff\nand status already convey the outcome.\n2. Successful `edit_file` calls remain expandable, and the full view\nrenders the original tool output so users can recover the exact message\nwhen they want it. Errors still surface immediately.\n3. Successful tool calls with no visible collapsed output show a `✓\nSuccess!` status marker instead of hiding the status entirely; tools\nwhose output speaks for itself stay unchanged.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/65a9fbf8-684e-d967-c8ad-2e89189a50fa)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-07-01T23:46:58Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/6d081690117df631b18b3b9daeb581faa3d80703","html_url":"https://github.com/langchain-ai/deepagents/commit/6d081690117df631b18b3b9daeb581faa3d80703","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/6d081690117df631b18b3b9daeb581faa3d80703/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/w