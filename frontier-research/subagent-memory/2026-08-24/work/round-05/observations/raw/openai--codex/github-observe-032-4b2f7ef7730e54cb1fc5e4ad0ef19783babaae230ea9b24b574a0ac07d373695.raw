ODQ3NGVjNTNlMzU","commit":{"author":{"name":"Ahmed Ibrahim","email":"aibrahim@openai.com","date":"2026-05-28T06:09:34Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-28T06:09:34Z"},"message":"[codex] Remove Python SDK language classifiers (#24868)\n\n## Summary\n- Remove the Python language classifiers from the Python SDK package\nmetadata.\n- Keep `requires-python = \">=3.10\"` as the package's interpreter\ncompatibility constraint.\n- Avoid presenting a curated version-support list in PyPI metadata.\n\n## Validation\n- Not run locally; relying on online CI for this metadata-only change.\n\n## Release\n- Land this change before publishing the next Python SDK beta.","tree":{"sha":"54378bc7313cb96576be058185544c2403403513","url":"https://api.github.com/repos/openai/codex/git/trees/54378bc7313cb96576be058185544c2403403513"},"url":"https://api.github.com/repos/openai/codex/git/commits/4a53b09eb78904a51394895e7a8448474ec53e35","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqF9weCRC1aQ7uu5UhlAAAXn8QAKGs5B5xXjwMTh9HBi32Ewxm\n5FXW0hdK1v3qptlhniUrL4o5ul8gzvuzOWFgTY+I3npLoTz0QT+QWES5USDj+fb7\nYEPnC+PgfxX+gOf5YvL3u9inHT1MHz6rKEj/4AxiXAkj2pqZpG0vDMgk1+YWxaYb\nSm4r9KEDVMryAxXRoKTVkVJ+WBEjvKhHzejcql420MIevglnbIXJ8S+Sy+LTq4+e\n7mgPWAxyO3xug3zRM6N8h4Wm7wk/CPFvCMZj6kUvDTbUTT0KpZzP5sj8WCbTVI28\n6NgrR7PSZWRC67OSXXvxjr0BpBhBwRg6jJNM4SJt+aFCMuk5GNaZjakewfPyqJYm\na9ZMWEkKAa0ZcArBOSHBOpLU+y+N/PwqYr6+AfrGKNM45vEhJM9491dPWHthPILB\nnxwMJJWPX05WKOz9HbnHsHmBnhheHoGgfBYRImA9FyDxyQjriK6W3bVQf/mmhHlf\nWs+HVJ4tic6bbSGk1U+eTQrjm/7jnGKqS+qX1CRDVv/Pw4PxVNqVXy9y+Ew2W06l\nZ2w0AaRxpa0dngMhKRnb0ySToKY4mOKBaUfUWX2YQrJKRiibsh1PvnT7MBtNWZ5K\nZhqmYciQNUZWBUoFIl3vgL8Kk3eNjW/z6/msXuIVj0hxvWUl0aRqC+pkCzouT6/b\nAMLzPR9mTik8NX+jjsi6\n=ccoS\n-----END PGP SIGNATURE-----\n","payload":"tree 54378bc7313cb96576be058185544c2403403513\nparent d0663f8004bf35107abdc1f34526670411edc22c\nauthor Ahmed Ibrahim <aibrahim@openai.com> 1779948574 -0700\ncommitter GitHub <noreply@github.com> 1779948574 -0700\n\n[codex] Remove Python SDK language classifiers (#24868)\n\n## Summary\n- Remove the Python language classifiers from the Python SDK package\nmetadata.\n- Keep `requires-python = \">=3.10\"` as the package's interpreter\ncompatibility constraint.\n- Avoid presenting a curated version-support list in PyPI metadata.\n\n## Validation\n- Not run locally; relying on online CI for this metadata-only change.\n\n## Release\n- Land this change before publishing the next Python SDK beta.","verified_at":"2026-05-28T06:09:35Z"}},"url":"https://api.github.com/repos/openai/codex/commits/4a53b09eb78904a51394895e7a8448474ec53e35","html_url":"https://github.com/openai/codex/commit/4a53b09eb78904a51394895e7a8448474ec53e35","comments_url":"https://api.github.com/repos/openai/codex/commits/4a53b09eb78904a51394895e7a8448474ec53e35/comments","author":{"login":"aibrahim-oai","id":219906144,"node_id":"U_kgDODRuAYA","avatar_url":"https://avatars.githubusercontent.com/u/219906144?v=4","gravatar_id":"","url":"https://api.github.com/users/aibrahim-oai","html_url":"https://github.com/aibrahim-oai","followers_url":"https://api.github.com/users/aibrahim-oai/followers","following_url":"https://api.github.com/users/aibrahim-oai/following{/other_user}","gists_url":"https://api.github.com/users/aibrahim-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/aibrahim-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aibrahim-oai/subscriptions","organizations_url":"https://api.github.com/users/aibrahim-oai/orgs","repos_url":"https://api.github.com/users/aibrahim-oai/repos","events_url":"https://api.github.com/users/aibrahim-oai/events{/privacy}","received_events_url":"https://api.github.com/users/aibrahim-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"