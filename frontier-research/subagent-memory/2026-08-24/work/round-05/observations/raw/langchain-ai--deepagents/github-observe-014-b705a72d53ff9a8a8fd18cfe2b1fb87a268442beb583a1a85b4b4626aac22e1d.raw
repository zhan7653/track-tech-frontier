sers/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"581e6e8b431f3a2c9683ce95bb04b593679eeeeb","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/581e6e8b431f3a2c9683ce95bb04b593679eeeeb","html_url":"https://github.com/langchain-ai/deepagents/commit/581e6e8b431f3a2c9683ce95bb04b593679eeeeb"}]},{"sha":"581e6e8b431f3a2c9683ce95bb04b593679eeeeb","node_id":"C_kwDOPTymldoAKDU4MWU2ZThiNDMxZjNhMmM5NjgzY2U5NWJiMDRiNTkzNjc5ZWVlZWI","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-24T18:34:24Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-24T18:34:24Z"},"message":"docs(infra): clarify staging branch rebase workflow (#4220)\n\nClarifies the staging-branch release guidance after the `v0.7` branch\nmaintenance flow exposed two valid ways to stay current with `main`.\n\nThe docs now keep merge-sync PRs as the default for shared staging\nbranches, while explicitly allowing a version-line DRI to rebase and\nforce-push with lease when they intentionally own the branch rewrite. It\nalso adds the concrete sanity checks to confirm that the final\n`main..vX.Y` range contains only the intended version-line commits\nbefore cutover, so release-please parses the expected commits.","tree":{"sha":"327973ea19b3d33245d631f2ac6b2cafed9974df","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/327973ea19b3d33245d631f2ac6b2cafed9974df"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/581e6e8b431f3a2c9683ce95bb04b593679eeeeb","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPCMwCRC1aQ7uu5UhlAAAZGUQAFNDOKywsg/9ffR+zOtr0OIc\n2H3b7fXbAJczLvuSiR190x7WMhV+CnByG9mJzEcInWkVeAPqvHRO8gm5zpcEQNrc\ngBNmQ3cYBTwLFyZbfo+fLwxLW/m2zrVxNgwkDwEUa9xW7gFf2SKBd645zmEzANRJ\nINLt3WYqSTFvhhuNU5arvjSg09A0GPsMgbfAKethJmdCa95xsLbn+BtsD0oEOWoP\nsABE4onOCaxVgMWFoEMbuFXt72qLOYZOkFTzBxqTbOqql2BKxeqR2gyIJ8/atRyX\n0LH9/rOAzc7EFxE/t8MIYAGskGgaj+RggaDEDr80UJ9M7JPKTUBGDKzX9G6XpGw9\nTdSr8uiAkbv9Bav36ge9vDIgbg5oYNyjiL5zhsP6HPu4BuO2fGD/dHVSqDUyqgce\n8P5MEigC+Md7vJUCm9mtBlalgmqQoT9TbrXTcc6DJWG3ApILAnOuxccwKNk5PLkV\nG7jKoYgHmwBzzhScC7oSQcar+CReqI+i3d7W3UtQ081NOTkFpOqKQS8F3KdiIfg2\nVvLDBSW/U23W3kIRfu3RDZzBakFFznYHkuaxrr/Xm3WOIe9q1OwVs9RdYI3+aAPF\nyYfCrVbO4j1fleI9CfGKff0gfrsvTG7mio8eX51YTPft1ZcFWlcjx/Fb2eai0w0A\nai4Jx5llOpWNCGHCHQge\n=mEE/\n-----END PGP SIGNATURE-----\n","payload":"tree 327973ea19b3d33245d631f2ac6b2cafed9974df\nparent c3fa4b817654aa95bd8001465b53d36ed4b41dcf\nauthor Mason Daugherty <mason@langchain.dev> 1782326064 -0400\ncommitter GitHub <noreply@github.com> 1782326064 -0400\n\ndocs(infra): clarify staging branch rebase workflow (#4220)\n\nClarifies the staging-branch release guidance after the `v0.7` branch\nmaintenance flow exposed two valid ways to stay current with `main`.\n\nThe docs now keep merge-sync PRs as the default for shared staging\nbranches, while explicitly allowing a version-line DRI to rebase and\nforce-push with lease when they intentionally own the branch rewrite. It\nalso adds the concrete sanity checks to confirm that the final\n`main..vX.Y` range contains only the intended version-line commits\nbefore cutover, so release-please parses the expected commits.","verified_at":"2026-06-24T18:34:24Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/581e6e8b431f3a2c9683ce95bb04b593679eeeeb","html_url":"https://github.com/langchain-ai/deepagents/commit/581e6e8b431f3a2c9683ce95bb04b593679eeeeb","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/581e6e8b431f3a2c9683ce95bb04b593679eeeeb/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":