sers/ccurme/repos","events_url":"https://api.github.com/users/ccurme/events{/privacy}","received_events_url":"https://api.github.com/users/ccurme/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"9026650a57a44efc252b7bc5ec8618a1e0ba7a5a","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9026650a57a44efc252b7bc5ec8618a1e0ba7a5a","html_url":"https://github.com/langchain-ai/deepagents/commit/9026650a57a44efc252b7bc5ec8618a1e0ba7a5a"}]},{"sha":"9026650a57a44efc252b7bc5ec8618a1e0ba7a5a","node_id":"C_kwDOPTymldoAKDkwMjY2NTBhNTdhNDRlZmMyNTJiN2JjNWVjODYxOGExZTBiYTdhNWE","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T22:02:20Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T22:02:20Z"},"message":"style(code): wrap `/model` selector help footer to two rows (#4218)\n\nFix the `/model` switcher footer clipping its `Ctrl+R recommended` hint\nby allowing the help line to wrap.\n\n---\n\nThe standard `/model` selector footer is wider than the modal's inner\nwidth, but the help `Static` was clamped to `height: 1`. With centered\nalignment the overflow was clipped on both ends, hiding the trailing\n`Ctrl+R recommended` hint (and the leading `↑/↓ navigate`). Switching to\n`height: auto` lets the line wrap to two rows instead of being\ntruncated; curated/onboarding mode (shorter line) still renders on a\nsingle row.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/ce9f0bea-2f31-a17d-2f53-b857f9b08d5c)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"c342770a44e7f43e8796842b7261faba147234e8","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/c342770a44e7f43e8796842b7261faba147234e8"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/9026650a57a44efc252b7bc5ec8618a1e0ba7a5a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPvbsCRC1aQ7uu5UhlAAAj94QAAbjgJcUfQhPJuWOvx2pbQCk\nlmkLt/NaYFZX4OlYr8JNcCpxijXjC65pawfbyiwu2XLylC7I+fr+Zgba779uptYe\nTRsbUf81DzQbDkvcF4+H92FiM+NOWdhe4rjmGdI5ivZvDhck4xkfT0A0Z0eAq1Oc\nr4/xBz/dFi2SbckNCFIg5cyrRq5TGcCPEpxEcuKYlvSzlEHQfo8YP8gq5nnfbDHK\n0Jq3YIxrzCnNkd/hywUzJ7c5R3t1iFhrBOvIWu9AUy1d5vxiq/q0nJk9jOd0S4Mm\n7clKF2qSeecfr3oIcaflHJq3q6nZSU3nGUcFOX+FPOmu/WuxjSqVgPOjTAfZTWJC\nHeLF8CJdGsJEiKwsMNwq8fpBQkgSmRf1ifWsOuH3E4DXik73NZInRz2k6dr6Cnmf\nY15pscnBm4zuW9yccFrybFGEJgv6lh9QplhEGLJYpITDzZEYQImlq4pijV2pmzhn\nZx9uFuxhQEU8E64sa8MG8SwZ3kUdEcGjbXSYm3zIdol+SaZXi5Uo6xuAuoZer+3O\n/+uxEnOS0DTTNoVvCKsUmnEaUlQ6QKGhPlbo53LE22gW2TAcyr71ehyQQ70/WSlA\nOxMTg5SqgHBFHH+W2CuScbEh6OKmjIwiqppOo4JhvlyFasc84H8xRMP4Jt6hABfK\nf4xicuZBgelud/bcJvwu\n=o2Wp\n-----END PGP SIGNATURE-----\n","payload":"tree c342770a44e7f43e8796842b7261faba147234e8\nparent badb18136e94bd059e309821ece68f9c499a4e26\nauthor Mason Daugherty <mason@langchain.dev> 1782511340 -0400\ncommitter GitHub <noreply@github.com> 1782511340 -0400\n\nstyle(code): wrap `/model` selector help footer to two rows (#4218)\n\nFix the `/model` switcher footer clipping its `Ctrl+R recommended` hint\nby allowing the help line to wrap.\n\n---\n\nThe standard `/model` selector footer is wider than the modal's inner\nwidth, but the help `Static` was clamped to `height: 1`. With centered\nalignment the overflow was clipped on both ends, hiding the trailing\n`Ctrl+R recommended` hint (and the leading `↑/↓ navigate`). Switching to\n`height: auto` lets the line wrap to two rows instead of being\ntruncated; curated/onboarding mode (shorter line) still renders on a\nsingle row.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/ce9f0bea-2f31-a17d-2f53-b857f9b08d5c)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-26T22:02:20Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9026650a57a44efc252b7bc5ec8618a1e0ba7a5a","html_url":"https://github.com/langchain-ai/deepagents/commit/9026650a57a44efc252b7bc5ec8618a1e0ba7a5a","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9026650a57a44efc252b7bc5ec8618a1e0ba7a5a/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"badb18136e94bd059e309821ece68f9c499a4e26","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/badb18136e94bd059e309821ece68f9c499a4e26","html_url":"https://github.com/langchain-ai/deepagents/commit/badb18136e94bd059e309821ece68f9c499a4e26"}]},{"sha":"badb18136e94bd059e309821ece68f9c499a4e26","node_id":"C_kwDOPTymldoAKGJhZGIxODEzNmU5NGJkMDU5ZTMwOTgyMWVjZTY4ZjljNDk5YTRlMjY","commit":{"author":{"name":"John Kennedy","email":"65985482+jkennedyvz@users.noreply.github.com","date":"2026-06-26T21:54:53Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T21:54:53Z"},"message":"fix(talon): copy quickjs partner libs into image (#4339)\n\nThe Talon Docker image syncs `libs/talon` with the checked-in lockfile,\nwhich resolves `langchain-quickjs` as an editable source at\n`../partners/quickjs`. The image context already copied the Deep Agents\nSDK, code package, and Talon package, but not the QuickJS partner\npackage, so the editable source path was missing during image setup.\n\nThis adds `libs/partners/quickjs` to the Docker build context at the\npath expected by the lockfile.\n\nVerified with `docker build --check -f examples/talon/Dockerfile .`.\n\nCo-authored-by: Deep Agent <agent@deepagents.dev>","tree":{"sha":"3a6159c44f2b5e8fd2b5a93a1c57ded38dd6b342","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/3a6159c44f2b5e8fd2b5a93a1c57ded38dd6b342"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/badb18136e94bd059e309821ece68f9c499a4e26","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPvUtCRC1aQ7uu5UhlAAA4BsQACpJFVyom9mV8ULHxbca+fCi\nVYntU5SIhxrYZ/hX/FN7gVxC9ulE5NfzuNNS/JWGTYCN1lkbcka8zARVmbvX3i9/\nhuWr8OnUnh787OF5xSToTjdH1RxTh4v8lOvSOVi8cg4Wscl5petNp2/rws8FUir2\nd4r6UkLnkjPs1r5z1OXNbmuKElysOQ5q3Ow7dcqSHcC92/S1VnfPGF2wLjydU/oX\n31jh1yUC48ZS5VLfgkUK5Ng2MAzTW7iQdcyNcCW3HHMapn/471ZjWU7oBQrG8I4G\nEV8sdb+Sjh81piUdf1anjNjpTtIGHdLSuuZGuyLbQIcosD5/8n72GZ5/z6Qc/f2q\nkexQXfaL3CQ5mfFnVMCWwDV9fFHKAK14+hicP56TvslYljJH+BEB5s2jhIofcv8z\nKbEok5M+ClW4PioyxgUGrw3unanKwNaWmYcvFHOiMFoqnYvDQndHOvnzBf95a0CE\ntpHVnsLgwKXsJzoczavVSleJsj6aX51wSAlQQPDhkqlyvW8mXOoszW35ekIcGsBm\nuaxsjhoKoS3IS3eJ5tepkvMOHwF9+zQjz5pLzXCTgIgcRZFu5kwQmWQanNkpFT3D\nelDnrv+dCa644Xa7WvjsAGPZ2XIkYaz8mTIBDIL7A2Gnzd21iEqWPMd6SYRViqOu\nnlp6WGYsYgVZ/LwAEhwv\n=PbgY\n-----END PGP SIGNATURE-----\n","payload":"tree 3a6159c44f2b5e8fd2b5a93a1c57ded38dd6b342\nparent 85e47b532b5caf92a52f1a070a95bdb39bee6d3d\nauthor John Kennedy <65985482+jkennedyvz@users.noreply.github.com> 1782510893 -0700\ncommitter GitHub <noreply@github.com> 1782510893 -0700\n\nfix(talon): copy quickjs partner libs into image (#4339)\n\nThe Talon Docker image syncs `libs/talon` with the checked-in lockfile,\nwhich resolves `langchain-quickjs` as an editable source at\n`../partners/quickjs`. The image context already copied the Deep Agents\nSDK, code package, and Talon package, but not the QuickJS partner\npackage, so the editable source path was missing during image setup.\n\nThis adds `libs/partners/quickjs` to the Docker build context at the\npath expected by the lockfile.\n\nVerified with `docker build --check -f examples/talon/Dockerfile .`.\n\nCo-authored-by: Deep Agent <agent@deepagents.dev>","verified_at":"2026-06-26T21:54:54Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/badb18136e94bd059e309821ece68f9c499a4e26","html_url":"https://github.com/langchain-ai/deepagents/commit/badb18136e94bd059e309821ece68f9c499a4e26","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/badb18136e94bd059e309821ece68f9c499a4e26/comments","author":{"login":"jkennedyvz","id":65985482,"node_id":"MDQ6VXNlcjY1OTg1NDgy","avatar_url":"https://avatars.githubusercontent.com/u/65985482?v=4","gravatar_id":"","url":"https://api.github.com/users/jkennedyvz","html_url":"https://github.com/jkennedyvz","followers_url":"https://api.github.com/users/jkennedyvz/followers","following_url":"https://api.github.com/users/jkennedyvz/following{/other_user}","gists_url":"https://api.github.com/users/jkennedyvz/gists{/gist_id}","starred_url":"https://api.github.com/users/jkennedyvz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jkennedyvz/subscriptions","organizations_url":"https://api.github.com/users/jkennedyvz/orgs","repos_url":"https://api.github.com/users/jkennedyvz/repos","events_url":"https://api.github.com/users/jkennedyvz/events{/privacy}","received_events_url":"https://api.github.com/users/jkennedyvz/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.githu