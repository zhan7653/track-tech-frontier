ercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"8ee2d6affeaf861c80fa89b2c5c643f10c5a8d4a","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/8ee2d6affeaf861c80fa89b2c5c643f10c5a8d4a","html_url":"https://github.com/langchain-ai/deepagents/commit/8ee2d6affeaf861c80fa89b2c5c643f10c5a8d4a"}]},{"sha":"8ee2d6affeaf861c80fa89b2c5c643f10c5a8d4a","node_id":"C_kwDOPTymldoAKDhlZTJkNmFmZmVhZjg2MWM4MGZhODliMmM1YzY0M2YxMGM1YThkNGE","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-06T21:05:58Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-06T21:05:58Z"},"message":"refactor(code): move Textual adapter into tui package (#4532)\n\nContinues the dcode package restructure by giving the Textual execution\nadapter a canonical home under `deepagents_code.tui`. Shared session\nstats formatting now lives outside the TUI layer so headless and client\npaths do not need to import Textual-facing code.\n\n## Changes\n- Moves `TextualUIAdapter` and `execute_task_textual` under the TUI\npackage and updates app, integration, benchmark, and unit-test imports\nto use the new canonical path.\n- Keeps `client/non_interactive` and shared command logic independent of\n`deepagents_code.tui` by moving `print_usage_table` alongside\n`SessionStats` and `format_token_count`.\n- Relocates adapter-specific tests under the matching\n`tests/unit_tests/tui` layout and moves shared session-stat coverage to\nthe existing `_session_stats` test module.\n- Refreshes threat-model and inline references that described the old\nflat adapter location.","tree":{"sha":"99e2cd5a2e024454426d048ef338c41bb5c960d8","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/99e2cd5a2e024454426d048ef338c41bb5c960d8"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/8ee2d6affeaf861c80fa89b2c5c643f10c5a8d4a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTBi2CRC1aQ7uu5UhlAAAxrUQAFsk1QShWobeB2p7dMFaxTwf\nNE3LgQVxpdkzZLDQtHRU51IUvPg6Cddmt/Rm1bJodJRXziMGEuFuTSad+dqCq1Uu\nVWCEEIZBuHK9h+/l1N/Es9xH4WZ80spCW3OQCc8Obr+BvB/KMvRc/GXFDf/I/L/c\nzooSeDk61WPYWuRKkKJlYBn3NoIFwNPiq5mHqkpEpJI4NtMIvZFQDJVh9g+w3Mgj\njT69detQuudAentcvUs0kw7f45npDIomVgpz82gkwRXnboS+HBhnEkPKPT8VtYxX\nf3VsR0x6D9Mw6c9IT9bdeTORrVqHX62MB5rAcCZqV6j7Z5VWjqeGA5E8nHgxp4oC\n3euex2werQtKf6Wz8YO0gD5MrgSNoo4mX3ILYIUp1CjbCWrNvptUA+wCeqcEej/6\nbb2zkrdODRSE+qaWsRJU3Slm6N3BaJqmJmelqvTbV+JsnpSZx35JtR7g6o5nXout\nEngIPJaao+Ama5LozC84Sp99K83JJhKuLIapJ19ZrCSVJ+q/ou48HnBiOJvdxR9g\nAtHiRUvUFJewTsWBM/htoPciJ7fgcQehSXLQcyEfOwv7h1Z+eXSEQ7y77I91Twu7\n9QoMGhTa1Vc29OGi6Qz13CgAC3UvLxAErEJasjG9iCkwdl+iJwoczHye9R5IRkxi\nqqeIkfTb9BIZBNsKLaBB\n=W1E8\n-----END PGP SIGNATURE-----\n","payload":"tree 99e2cd5a2e024454426d048ef338c41bb5c960d8\nparent 5f4820d292e747a134f193764c5490037516ecb1\nauthor Mason Daugherty <mason@langchain.dev> 1783371958 -0400\ncommitter GitHub <noreply@github.com> 1783371958 -0400\n\nrefactor(code): move Textual adapter into tui package (#4532)\n\nContinues the dcode package restructure by giving the Textual execution\nadapter a canonical home under `deepagents_code.tui`. Shared session\nstats formatting now lives outside the TUI layer so headless and client\npaths do not need to import Textual-facing code.\n\n## Changes\n- Moves `TextualUIAdapter` and `execute_task_textual` under the TUI\npackage and updates app, integration, benchmark, and unit-test imports\nto use the new canonical path.\n- Keeps `client/non_interactive` and shared command logic independent of\n`deepagents_code.tui` by moving `print_usage_table` alongside\n`SessionStats` and `format_token_count`.\n- Relocates adapter-specific tests under the matching\n`tests/unit_tests/tui` layout and moves shared session-stat coverage to\nthe existing `_session_stats` test module.\n- Refreshes threat-model and inline references that described the old\nflat adapter location.","verified_at":"2026-07-06T21:05:59Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/8ee2d6affeaf861c80fa89b2c5c643f10c5a8d4a","html_url":"https://github.com/langchain-ai/deepagents/commit/8ee2d6affeaf861c80fa89b2c5c643f10c5a8d4a","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/8ee2d6affeaf861c80fa89b2c5c643f10c5a8d4a/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"5f4820d292e747a134f193764c5490037516ecb1","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/5f4820d292e747a134f193764c5490037516ecb1","html_url":"https://github.com/langchain-ai/deepagents/commit/5f4820d292e747a134f193764c5490037516ecb1"}]},{"sha":"5f4820d292e747a134f193764c5490037516ecb1","node_id":"C_kwDOPTymldoAKDVmNDgyMGQyOTJlNzQ3YTEzNGYxOTM3NjRjNTQ5MDAzNzUxNmVjYjE","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-06T20:29:36Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-06T20:29:36Z"},"message":"refactor(code): move Textual widgets into tui package (#4527)\n\nContinues the dcode package restructure by giving Textual-only widgets a\ncanonical home under `deepagents_code.tui`. The move keeps the UI layer\ngrouped separately from the client runtime package without adding\nold-path compatibility shims.\n\n## Changes\n- Moves the full Textual widget package under\n`deepagents_code.tui.widgets`, including message rendering, modal\nscreens, selectors, status UI, and tool display widgets.\n- Updates `DeepAgentsApp`, `TextualUIAdapter`, and widget internals to\nimport from the new canonical TUI package.\n- Relocates widget-focused unit tests under the matching\n`tests/unit_tests/tui/widgets` layout and updates remaining test\npatch/import targets.\n- Refreshes local package guidance so contributor docs point at the new\nwidget paths.","tree":{"sha":"fb8f21345a0465b546a616039e8d076010df79df","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/fb8f21345a0465b546a616039e8d076010df79df"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/5f4820d292e747a134f193764c5490037516ecb1","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTBAwCRC1aQ7uu5UhlAAAFLwQAHHn2ehZsG0t3BIaXDBiTzj6\nLkIaMq0Lbqj9mF3o6c8srdsAA1S83ph4YBTPRYg7iFHh/BCwjk0/r8QHsTnu7Lff\ntIyHiZyI3bZs46lNJOup2UdkVw9p3g7EO4pgbjWvFwPQySNtLQRyq36s9Pi9cI0k\nCKGGZWuKhqcr/zbWRkn+zKjjE+GY73qWP1mfANlF6bkKEMsoLI2nHdjF37FXdkYJ\nu092VbROJV2TlgS84LYNnbAamlb9qgAqpgc3ahj72Uf6poiWNQiroWX9hxRqy5Bz\nOHf2f/fRSmmegacotAmHdcI8joK96iFNqYHrWQaBSfZdbprZZGj418FWh8uTHHpa\nrH/mVku7S+iniE281Smzgnm8RHMG2e71ByWWsPzZrBjbOobS4pdQVVyEIz0IwPab\ndnHLyVmfMiE3IzDytRlHf40m7t/sxxo53QGHA35Zb4lJHZ0DGOnYQG55fYBxlkcm\nxD7mEdjWY+QxVflkTjs4XCr2D4c1im/ehYwJfcgmAMapMmTh6+u1AhAhW/OAeDZb\nvSWPCUy1OfAVdeXwKj690uBo2wP7cjwbugKIPucdxa2grQ8LwveRTEuq7UsmYYTy\na5kbHAqe7m7zV/NRohAThZyt/lSXpZJifC2KJUpgohZ0e6LLDOP3ANZAF8xVALcK\nSYltaTlIz50yc+FbVSNW\n=ki5P\n-----END PGP SIGNATURE-----\n","payload":"tree fb8f21345a0465b546a616039e8d076010df79df\nparent 21e72bec1b206eb1292d92c0677f1a25910c3aed\nauthor Mason Daugherty <mason@langchain.dev> 1783369776 -0400\ncommitter GitHub <noreply@github.com> 1783369776 -0400\n\nrefactor(code): move Textual widgets into tui package (#4527)\n\nContinues the dcode package restructure by giving Textual-only widgets a\ncanonical home under `deepagents_code.tui`. The move keeps the UI layer\ngrouped separately from the client runtime package without adding\nold-path compatibility shims.\n\n## Changes\n- Moves the full Textual widget package under\n`deepagents_code.tui.widgets`, including message rendering, modal\nscreens, selectors, status UI, and tool display widgets.\n- Updates `DeepAgentsApp`, `TextualUIAdapter`, and widget internals to\nimport from the new canonical TUI package.\n- Relocates widget-focused unit tests under the matching\n`tests/unit_tests/tui/widgets` layout and updates remaining test\npatch/import targets.\n- Refreshes local package guidance so contributor docs point at the new\nwidget paths.","verified_at":"2026-07-06T20:29:36Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/5f4820d292e747a134f193764c5490037516ecb1","html_url":"https://github.com/langchain-ai/deepagents/commit/5f4820d292e747a134f193764c5490037516ecb1","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/5f4820d292e747a134f193764c5490037516ecb1/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"21e72bec1b206eb1292d92c0677f1a25910c3aed","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/21e72bec1b206eb1292d92c0677f1a25910c3aed","html_url":"https://github.com/langchain-ai/deepagents/commit/21e72bec1b206eb1292d92c0677f1a25910c3aed"}]},{"sha":"21e72bec1b206eb1292d92c0677f1a25910c3aed","node_id":"C_kwDOPTymldoAKDIxZTcyYmVjMWIyMDZlYjEyOTJkOTJjMDY3N2YxYTI1OTEwYzNhZWQ","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-06T19:38:13Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-06T19:38:13Z"},"message":"docs(code): clarify /offload command summarizes messages (#4526)\n\nNew users were confused that `/offload` (alias `/compact`) only\n\"offloads\" context, when it actually runs an LLM summarization of older\nmessages before writing the originals to a recovery file. This updates\nthe slash-command description to mention summarization, staying under 60\ncharacters (\"Summarize and offload older messages to free context\", 52\nchars), and regenerates the `COMMANDS.md` catalog to match.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/d78e6bda-ad23-13f1-e566-a01f25a05364)\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"01c6ac274473e371a8695f3072bbf196875dd083","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/01c6ac274473e371a8695f3072bbf196875dd083"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/21e72bec1b206eb1292d92c0677f1a25910c3aed","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTAQlCRC1aQ7uu5UhlAAAtYcQAB8yIZKP05aUre9hSViAWTIu\ny6CowDTM454ftMMCMiYh7YjHaQ3b4r7IshMKFsHjV39IS5Ol8FdUBkXFL5ms81Au\nJAtmYq5wo9tJ60kTm9DMEIQYoDNowLqqr3Gv2DRDbYW34GR7rhAIWVvnXetY7dqE\nsl1JsbZSVm0k8mCUQlJ0sFGn1/h8pFahrzsDlZ1CGB5xe71ihTyY8m8PyA9EF5eh\n7uOxEPQ/Uc3tip3GDKkywdtkEFM0ROJTesytXIVAg+pGunAuIz5KyqZGoihF332M\nIofiRKeqv60tfrE+JQZgF9cLrZM9PVEWiv2kWQBCoJCnLfMOlzZ7vvU6LufuUiyv\nz990Xlrz9yBx71GLlL8FW+S/hfRi0paoJkMW75uBrKM02wOvpAEm5xzoGshC55S0\nwKdroI//xRKXusOCvDeGkJWY+6TbCPTtvuU7gyeMVrl5oEpgGgu+U1TUfPkUW57Y\nvldm9Tm087VBQ9sGHBn0FBVhmtbwdSe7KndAN6bn82gtpoFcxzJ7JkMi4aEdIg1a\ncWQmZskky/55BtXb+/A3t/ViKBSSXdAM/sCo9VuLYTO9HRG8l6ZO6HDlPHJqA84U\nacgNZtGcJpyfYFPsvjajo1ruzzAQ7l8nVpgGXAvDE0Q4i3FrZWCyYhXi4XG8PX6k\n5Wt2/QiIPFd4rABZinhL\n=OO/o\n-----END PGP SIGNATURE-----\n","payload":"tree 01c6ac274473e371a8695f3072bbf196875dd083\nparent 8fc4dee4f92285d80aa7646acd701a7d222f6347\nauthor Mason Daugherty <mason@langchain.dev> 1783366693 -0400\ncommitter GitHub <noreply@github.com> 1783366693 -0400\n\ndocs(code): clarify /offload command summarizes messages (#4526)\n\nNew users were confused that `/offload` (alias `/compact`) only\n\"offloads\" context, when it actually runs an LLM summarization of older\nmessages before writing the originals to a recovery file. This updates\nthe slash-command description to mention summarization, staying under 60\ncharacters (\"Summarize and offload older messages to free context\", 52\nchars), and regenerates the `COMMANDS.md` catalog to match.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/d78e6bda-ad23-13f1-e566-a01f25a05364)\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-07-06T19:38:13Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/21e72bec1b206eb1292d92c0677f1a25910c3aed","html_url":"https://github.com/langchain-ai/deepagents/commit/21e72bec1b206eb1292d92c0677f1a25910c3aed","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/21e72bec1b206eb1292d92c0677f1a25910c3aed/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"8fc4dee4f92285d80aa7646acd701a7d222f6347","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/8fc4dee4f92285d80aa7646acd701a7d222f6347","html_url":"https://github.com/langchain-ai/deepagents/commit/8fc4dee4f92285d80aa7646acd701a7d222f6347"}]},{"sha":"8fc4dee4f92285d80aa7646acd701a7d222f6347","node_id":"C_kwDOPTymldoAKDhmYzRkZWU0ZjkyMjg1ZDgwYWE3NjQ2YWNkNzAxYTdkMjIyZjYzNDc","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-06T19:35:19Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-06T19:35:19Z"},"message":"refactor(code,talon): move CLI commands into client package (#4525)\n\nClient-facing CLI command groups now have a canonical home under\n`deepagents_code.client.commands`, matching the client/runtime package\nlayout started by the previous restructure slice. The top-level CLI\ndispatch and Talon MCP bridge now import those command handlers from the\nnew package instead of the old flat module paths.\n\n## Changes\n- Moved the `auth`, `config`, `mcp`, and `tools` command implementations\nunder `deepagents_code.client.commands`.\n- Updated `parse_args()` and `cli_main()` to register and dispatch\ncommand groups from the new client command package.\n- Updated Talon’s dynamic `mcp login` import to resolve `run_mcp_login`\nfrom the new canonical MCP command module.\n- Moved command-specific unit tests under\n`tests/unit_tests/client/commands` and updated patch/import targets,\nincluding the Ruff ignore path for MCP command test helpers.","tree":{"sha":"5058e9368f9704d5759e27701d7d2ce0e2faed81","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/5058e9368f9704d5759e27701d7d2ce0e2faed81"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/8fc4dee4f92285d80aa7646acd701a7d222f6347","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTAN3CRC1aQ7uu5UhlAAAxwEQAHibA9uPLcVA1t/q/VjeTOTr\nDK10u5at/AZ4AATvmpmmEHaeVi7GWBV1N6ZOAFidEX6FS05+ZeIupLETHbF5r2ql\nxcG9O/Guv79kGgC56b/4TZDBjPt90IlVZYC6wJZP8qPSAUHG19YXzh7/FRYrANAi\nINIe4a9c5jlQI48jyXC6/+ln6BSJEnf+8+JnSWeSbX4+bbW/EZIoEam/G4h0tphq\nGT0NkR8lmWO/YJrbYOVFUmcQ2fAa2UirhYYrhi5BIE7Hg0TNhwa+v7xZbq3WFICn\n0GjadoMjob4P747hO2xx7GvtBvoc5vRTGNBf43/FEtwUuWqXLTjqbQ612uIZtAuz\nx73CfAj0s6IDEfkYVKl8WYK0BtNNsrIIohWhF8uTEo6ZEksxoBz0Jee6+rk35uF5\n/1P96jpIqZcG2ms/bDmiPvya/52igqUJ5fOTO/EACnMs8mV+fBPyblzvmCGnG/WH\nv/79c4+jHGgnzPTbvNMVNKXN9QG10Y5VZhD7d8FqN+c2uFO+6SlOqNtw8or/eOFX\n5nV4OqzIf9w5uthSLEHI8iISfCxAhZ6LiK8/GNs7T4MbszkccHI/YrID0iySDlC0\n2+ETpQWebAVTFp+swafS/A6Le0KreajZ1ZXZhRM5O3X/bHH+YbD9p4fEQ8pxT2i3\nudbWCS23plwajj4OVwlO\n=2nnz\n-----END PGP SIGNATURE-----\n","payload":"tree 5058e9368f9704d5759e27701d7d2ce0e2faed81\nparent 49bffe21454886301c6d4397ed742646ef08ae36\nauthor Mason Daugherty <mason@langchain.dev> 1783366519 -0400\ncommitter GitHub <noreply@github.com> 1783366519 -0400\n\nrefactor(code,talon): move CLI commands into client package (#4525)\n\nClient-facing CLI command groups now have a canonical home under\n`deepagents_code.client.commands`, matching the client/runtime package\nlayout started by the previous restructure slice. The top-level CLI\ndispatch and Talon MCP bridge now import those command handlers from the\nnew package instead of the old flat module paths.\n\n## Changes\n- Moved the `auth`, `config`, `mcp`, and `tools` command implementations\nunder `deepagents_code.client.commands`.\n- Updated `parse_args()` and `cli_main()` to register and dispatch\ncommand groups from the new client command package.\n- Updated Talon’s dynamic `mcp login` import to resolve `run_mcp_login`\nfrom the new canonical MCP command module.\n- Moved command-specific unit tests under\n`tests/unit_tests/client/commands` and updated patch/import targets,\nincluding the Ruff ignore path for MCP command test helpers.","verified_at":"2026-07-06T19:35:20Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/8fc4dee4f92285d80aa7646acd701a7d222f6347","html_url":"https://github.com/langchain-ai/deepagents/commit/8fc4dee4f92285d80aa7646acd701a7d222f6347","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/8fc4dee4f92285d80aa7646acd701a7d222f6347/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"49bffe21454886301c6d4397ed742646ef08ae36","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/49bffe21454886301c6d4397ed742646ef08ae36","html_url":"https://github.com/langchain-ai/deepagents/commit/49bffe21454886301c6d4397ed742646ef08ae36"}]},{"sha":"49bffe21454886301c6d4397ed742646ef08ae36","node_id":"C_kwDOPTymldoAKDQ5YmZmZTIxNDU0ODg2MzAxYzZkNDM5N2VkNzQyNjQ2ZWYwOGFlMzY","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-06T18:34:55Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-06T18:34:55Z"},"message":"refactor(code): move client runtime modules into package (#4523)\n\nStarts the dcode package restructure by giving client-facing runtime\ncode a canonical home under `deepagents_code.client`.\n\n- Moves the local LangGraph server helpers under `client.launch` and\nmoves `RemoteAgent` plus headless `run_non_interactive` under `client`.\n- Updates app, CLI, and tests to import the new canonical paths directly\nwithout compatibility alias modules.\n- Changes runtime workspace scaffolding to load\n`deepagents_code.server_graph:make_graph` from the package instead of\ncopying `server_graph.py` into the temp workspace.\n- Resolves the generated runtime package dependency from the top-level\npackage location so editable checkouts keep pointing at the working tree\nafter the module move.\n- Refreshes the threat model references for the moved client/server\ncomponents.","tree":{"sha":"d345f02d8fbabe8c58d8706b66c48408b5c6b181","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/d345f02d8fbabe8c58d8706b66c48408b5c6b181"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/49bffe21454886301c6d4397ed742646ef08ae36","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqS/VPCRC1aQ7uu5UhlAAANHwQAHwLFQdoE4TvSenpeusigZJ6\n34WA287OFkricuz/nGQ7sDK7Ox+HDC8M28ArCRTJbPXVRhX9aGfcuymtPlRC4BJk\nFAttT0x2TCnh+9vvIyNeH37Zu8fQ68qMOvudyw0lDheXSSXZoUjf73bzskiwYidp\ndg3r8/JC0sMWxXpyZWtnunqdxZR//rW7VfrveHQF9bK+qtcT97wldDNxUSbeGSaM\nmd03bjeeGtacjnSHWrjWLizh6+1p9TADfI5S+ULtzM0US/vojQySRjGplzV+jsJJ\nCpaQtuuqkG5YM4X8tkCVFEa9BOxZ9rchuTpgqGtMq6POE3vZMyQTzt4fWc9gUA8W\nGXF0+ay097bkgi+jDjZEwi1aWyYoyXPKyjoEzmvYm54PFNJMJafOtkXRJ+0NxFyW\nOQ0f4a4OnQmmhCDZs3fm/7ktmXc6mmJfqHAYYAymgRdCystirCB3Z81Q6nZg74rw\nj9RodmvOvVnXIePM6qCQt48HhHcHIS2T/rU4NWIsLND2bLMV37F4dnG7FW5HT1qV\n9km/B4fl17oTBYbYdD0AdOKbvfw7wQBxouaj1hp75Pf+3u6rYdtgKaITX03P9o5P\nVHGpoyYnxrB1I/YRuu/LEu3vl/z5X25TRUsmAyY9G/g9nN795UgOqnSbh+m0yNe5\no4DGfVz8CYHWkoV0yYYD\n=ct1l\n-----END PGP SIGNATURE-----\n","payload":"tree d345f02d8fbabe8c58d8706b66c48408b5c6b181\nparent 019900734024a7665fd65bd75235c6307d5da003\nauthor Mason Daugherty <mason@langchain.dev> 1783362895 -0400\ncommitter GitHub <noreply@github.com> 1783362895 -0400\n\nrefactor(code): move client runtime modules into package (#4523)\n\nStarts the dcode package restructure by giving client-facing runtime\ncode a canonical home under `deepagents_code.client`.\n\n- Moves the local LangGraph server helpers under `client.launch` and\nmoves `RemoteAgent` plus headless `run_non_interactive` under `client`.\n- Updates app, CLI, and tests to import the new canonical paths directly\nwithout compatibility alias modules.\n- Changes runtime workspace scaffolding to load\n`deepagents_code.server_graph:make_graph` from the package instead of\ncopying `server_graph.py` into the temp workspace.\n- Resolves the generated runtime package dependency from the top-level\npackage location so editable checkouts keep pointing at the working tree\nafter the module move.\n- Refreshes the threat model references for the moved client/server\ncomponents.","verified_at":"2026-07-06T18:34:56Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/49bffe21454886301c6d4397ed742646ef08ae36","html_url":"https://github.com/langchain-ai/deepagents/commit/49bffe21454886301c6d4397ed742646ef08ae36","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/49bffe21454886301c6d4397ed742646ef08ae36/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"019900734024a7665fd65bd75235c6307d5da003","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/019900734024a7665fd65bd75235c6307d5da003","html_url":"https://github.com/langchain-ai/deepagents/commit/019900734024a7665fd65bd75235c6307d5da003"}]},{"sha":"019900734024a7665fd65bd75235c6307d5da003","node_id":"C_kwDOPTymldoAKDAxOTkwMDczNDAyNGE3NjY1ZmQ2NWJkNzUyMzVjNjMwN2Q1ZGEwMDM","commit":{"author":{"name":"github-actions[bot]","email":"41898282+github-actions[bot]@users.noreply.github.com","date":"2026-07-06T17:03:19Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-06T17:03:19Z"},"message":"release(deepagents-code): 0.1.33 (#4513)\n\n> [!CAUTION]\n> Merging this PR will automatically publish to **PyPI** and create a\n**GitHub release**.\n\nFor the full release process, see\n[`.github/RELEASING.md`](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md).\n\n---\n\n_Everything below this line will be the GitHub release body._\n\n---\n\n\n##\n[0.1.33](https://github.com/langchain-ai/deepagents/compare/deepagents-code==0.1.32...deepagents-code==0.1.33)\n(2026-07-06)\n\n### Features\n\n* In-the-moment trust prompt for symlinked skills\n([#4200](https://github.com/langchain-ai/deepagents/issues/4200))\n([a4431e4](https://github.com/langchain-ai/deepagents/commit/a4431e4339348431e91533cb2b177259ab94b083))\n* Selective per-server project MCP trust\n([#4507](https://github.com/langchain-ai/deepagents/issues/4507))\n([aaa22a9](https://github.com/langchain-ai/deepagents/commit/aaa22a9340cb3d2c8e9ce1a921957d0a9121da20))\n* Add `dcode tools list` command\n([#4461](https://github.com/langchain-ai/deepagents/issues/4461))\n([1402d0e](https://github.com/langchain-ai/deepagents/commit/1402d0e735a1580503f240457c77db76fcd779d7))\n\n### Bug Fixes\n\n* Strip media placeholders from model-facing message text\n([#4462](https://github.com/langchain-ai/deepagents/issues/4462))\n([aa0ae36](https://github.com/langchain-ai/deepagents/commit/aa0ae36b00df6411a9200610a9075ef2dc28b1af))\n* Re-apply theme preference on `/reload`\n([#4514](https://github.com/langchain-ai/deepagents/issues/4514))\n([5d1c392](https://github.com/langchain-ai/deepagents/commit/5d1c3928f7ca0ea97f28fd4d34ae1a4ee885e888))\n\n---\n\n_Everything above this line will be the GitHub release body._\n\n---\n\n> [!NOTE]\n> A **New Contributors** section is appended to the GitHub release notes\nautomatically at publish time (see [Release\nPipeline](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md#release-pipeline),\nstep 2).\n\n---------\n\nCo-authored-by: github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","tree":{"sha":"4d38578727f413ebdf66aee53d2034e9ef416517","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/4d38578727f413ebdf66aee53d2034e9ef416517"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/019900734024a7665fd65bd75235c6307d5da003","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqS9/XCRC1aQ7uu5UhlAAA7GUQAJZCvq9fWj/emddCNrALb6+X\nDAkGe+AnsqAOKHtuJalySonUz1qAXB0O8gzSCWvchegJ8WpTsN5rFaQ7rnOcDm7F\nMDw