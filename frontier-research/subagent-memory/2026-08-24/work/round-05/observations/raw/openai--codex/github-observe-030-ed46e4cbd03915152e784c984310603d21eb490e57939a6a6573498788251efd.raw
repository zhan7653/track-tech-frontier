[{"sha":"c9ae0f48a13022191285d998bf10234ccf20313a","node_id":"C_kwDOOYsS4doAKGM5YWUwZjQ4YTEzMDIyMTkxMjg1ZDk5OGJmMTAyMzRjY2YyMDMxM2E","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-03T13:38:30Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-03T13:38:30Z"},"message":"chore: mechanical rename (#26156)\n\nRename `Session::conversation_id` to `Session::thread_id` with an auto\nrefactor in RustRover","tree":{"sha":"a293da38e05cf3634892424af73d40eb4b40282f","url":"https://api.github.com/repos/openai/codex/git/trees/a293da38e05cf3634892424af73d40eb4b40282f"},"url":"https://api.github.com/repos/openai/codex/git/commits/c9ae0f48a13022191285d998bf10234ccf20313a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqIC5WCRC1aQ7uu5UhlAAAnhUQABNES49KCyBN4xixf5g9T2MT\nbWFC9kBoKS3XY3nrd/jLV7pk4XSj93mc4Jg+pVMY9+u+N1Bd0yOq+Z6C87c//IUy\nnTZBczi2uHvv5XP0mYT68XRUIenR1CL/zEjirU5nXEz3vveNr0pbHZMl0HaVekwy\nq8LYBMG+3uCsGDcdTL0Lu3plbQ1dLv7dM6xzxYFTLNk4jWSZ54VSrJZ+3eCSwN4L\nga8OgBXCG4ahmaQlZVR7pg4MBdMfcgpLTm1iEhJVTXbg8vyRXod76pMIqvdbEdD8\nUNuL3IXRjnUyopCajnso8IeE98vu9cvzyr7T7oqoxcSzj49Ba142TTWqac5LmmLX\nsQ0sbqvgMpNS4bAm8EUbjKCNGqQ3K/wNzg15Ce3W8/SNuedXY+AR/JNZB31IICZQ\n61djUSu3pOnkxPKf6kiV+elK985/op06xc27w9SLsvHG9WF6zPCjv5yWDWZF3zoj\n+btp8KYtWrLeIQW6sStBjLoOVJ/DBSSZ6epkcq1qZSTScphRKBJNJh/kfDCo1NAw\nmc+GTJOSL8mq0CI3ApkKPTnbvZyMVu1o/jT1R59i8vFGwoehXoSTwr7A3fiRDQH1\n0ERpl+zS/JqSOndgGVBt8ESrsbFY3+OTsn4p+CzayPgSZIVyiYeOqNmYL2BH/ulv\nDDmDdakGjpRpkLjmtunb\n=+79Q\n-----END PGP SIGNATURE-----\n","payload":"tree a293da38e05cf3634892424af73d40eb4b40282f\nparent 7db18c8241cfe40eee31539c086bb3f600d359c7\nauthor jif <jif@openai.com> 1780493910 +0200\ncommitter GitHub <noreply@github.com> 1780493910 +0200\n\nchore: mechanical rename (#26156)\n\nRename `Session::conversation_id` to `Session::thread_id` with an auto\nrefactor in RustRover","verified_at":"2026-06-03T13:38:31Z"}},"url":"https://api.github.com/repos/openai/codex/commits/c9ae0f48a13022191285d998bf10234ccf20313a","html_url":"https://github.com/openai/codex/commit/c9ae0f48a13022191285d998bf10234ccf20313a","comments_url":"https://api.github.com/repos/openai/codex/commits/c9ae0f48a13022191285d998bf10234ccf20313a/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7db18c8241cfe40eee31539c086bb3f600d359c7","url":"https://api.github.com/repos/openai/codex/commits/7db18c8241cfe40eee31539c086bb3f600d359c7","html_url":"https://github.com/openai/codex/commit/7db18c8241cfe40eee31539c086bb3f600d359c7"}]},{"sha":"7db18c8241cfe40eee31539c086bb3f600d359c7","node_id":"C_kwDOOYsS4doAKDdkYjE4YzgyNDFjZmU0MGVlZTMxNTM5YzA4NmJiM2Y2MDBkMzU5Yzc","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-03T13:10:16Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-03T13:10:16Z"},"message":"fix: serialize goal progress accounting (#26155)\n\n## Why\n\nGoal progress accounting can be reached from multiple completion paths\nfor the same thread. Each path takes a progress snapshot, writes the\nusage delta, and then marks that snapshot as accounted. When two\ntool-completion hooks run at the same time, they can both observe the\nsame unaccounted delta and charge it twice.\n\n## What changed\n\n- Added a per-thread progress-accounting permit to\n`GoalAccountingState`.\n- Held that permit across the snapshot/write/mark-accounted critical\nsection for active-turn, idle, and tool-finish accounting.\n- Added regression coverage for parallel tool-finish hooks so a shared\ntoken delta is charged once and only one progress event is emitted.\n\n## Testing\n\n- Not run locally.\n- Added `parallel_tool_finish_accounts_active_goal_progress_once`.","tree":{"sha":"281dc2d829f59df3f557c98208a6668067ec2cda","url":"https://api.github.com/repos/openai/codex/git/trees/281dc2d829f59df3f557c98208a6668067ec2cda"},"url":"https://api.github.com/repos/openai/codex/git/commits/7db18c8241cfe40eee31539c086bb3f600d359c7","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqICe4CRC1aQ7uu5UhlAAAViAQAJljkzoymLy3eBTOXGZEmXDT\n6Mbus9V/ovvGPcZRbcqqh2eSKa3LanKy3pFUf6lh5edd+Cv1t02CoqAZ660/hbje\nxNQIwrrU//QWSuPmSy9tIwcBo/BCQ4i6HEJlZc+JvMn5n763+Do2BBWKgmY4faX/\nhuOePe5GNgmLFzlT/gPO8Tuchtjmyunkf8sNMStawdDeCf1G3NCqPAn2IT1Cgpgv\nHF5SeRaj24a23KoumTSr9reNTsXy+NR5EAxxH33WSo7T7qghkK77hCv2sibItBLD\nxcT4e9XFXJ8+pbRzb6qoLcTXjL5BOLkdIE7OKa228x93Ooq35v0HrPrWlXjApJvg\nSdXY39uJ4t7oe1UoMPwUqKElz2qxJ5b4fL0jrSjCQ3MtHBqmA+AcAn9ch6x1GZKi\ncUFwKKPVFRB2Af+rM5Td6MRdaMOu38qc8bYARKMn3AsIf+PnvBqakXpovX+8lKuL\n9RXLrsmVFyJvt6hHB1GwlMWAEZLkPSYfQ81O/qGelKOGCys7giHu1WCR+dVXqtxW\nZZs+zlsmxCMMQKf8MQVhIvoAj6dP8RX/8qbkq7EBPnTmwM6/x7O9cX38gqvlBA8N\n5aYHnhvjPdgSp6D4JNsR5mmstMnCfo/t/y/PWJOCQBlrhm+O1qQmixB+16YU/RBn\neiFmEILONycy0+kyZ591\n=X+0d\n-----END PGP SIGNATURE-----\n","payload":"tree 281dc2d829f59df3f557c98208a6668067ec2cda\nparent 3389fa554e953d07a12a34f5681aae46f17958f8\nauthor jif <jif@openai.com> 1780492216 +0200\ncommitter GitHub <noreply@github.com> 1780492216 +0200\n\nfix: serialize goal progress accounting (#26155)\n\n## Why\n\nGoal progress accounting can be reached from multiple completion paths\nfor the same thread. Each path takes a progress snapshot, writes the\nusage delta, and then marks that snapshot as accounted. When two\ntool-completion hooks run at the same time, they can both observe the\nsame unaccounted delta and charge it twice.\n\n## What changed\n\n- Added a per-thread progress-accounting permit to\n`GoalAccountingState`.\n- Held that permit across the snapshot/write/mark-accounted critical\nsection for active-turn, idle, and tool-finish accounting.\n- Added regression coverage for parallel tool-finish hooks so a shared\ntoken delta is charged once and only one progress event is emitted.\n\n## Testing\n\n- Not run locally.\n- Added `parallel_tool_finish_accounts_active_goal_progress_once`.","verified_at":"2026-06-03T13:10:17Z"}},"url":"https://api.github.com/repos/openai/codex/commits/7db18c8241cfe40eee31539c086bb3f600d359c7","html_url":"https://github.com/openai/codex/commit/7db18c8241cfe40eee31539c086bb3f600d359c7","comments_url":"https://api.github.com/repos/openai/codex/commits/7db18c8241cfe40eee31539c086bb3f600d359c7/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"3389fa554e953d07a12a34f5681aae46f17958f8","url":"https://api.github.com/repos/openai/codex/commits/3389fa554e953d07a12a34f5681aae46f17958f8","html_url":"https://github.com/openai/codex/commit/3389fa554e953d07a12a34f5681aae46f17958f8"}]},{"sha":"3389fa554e953d07a12a34f5681aae46f17958f8","node_id":"C_kwDOOYsS4doAKDMzODlmYTU1NGU5NTNkMDdhMTJhMzRmNTY4MWFhZTQ2ZjE3OTU4Zjg","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-03T11:32:55Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-03T11:32:55Z"},"message":"skills: resolve per-turn catalogs from turn input context (#26106)\n\n## Why\n\nThe skills extension needs the resolved turn environments to build a\nreal per-turn `SkillListQuery`. The previous `TurnLifecycleContributor`\nhook only had a turn id, so it could only seed a placeholder query and\nnever carry the executor authorities that executor-scoped skill routing\nwill need.\n\nMoving catalog resolution onto `TurnInputContributor` puts the skills\nextension on the same turn-preparation path that already has the\nenvironment ids and working directories for the submitted turn, while\nkeeping the actual prompt injection work for follow-up changes.\n\n## What changed\n\n- switch `ext/skills` from `TurnLifecycleContributor` to\n`TurnInputContributor`\n- build `executor_authorities` from `TurnInputContext.environments` and\npass them through `SkillListQuery`\n- keep storing the resolved catalog in `SkillsTurnState`, but drop the\nplaceholder query helper that no longer matches the real data flow\n- update the extension TODOs to reflect that per-turn catalog resolution\nnow happens in the turn-input contributor, and that prompt/context\ninjection still needs to move later\n\n## Testing\n\n- Not run locally.","tree":{"sha":"8e9dc12da371c441834ab5f55ab0b683d9408dfb","url":"https://api.github.com/repos/openai/codex/git/trees/8e9dc12da371c441834ab5f55ab0b683d9408dfb"},"url":"https://api.github.com/repos/openai/codex/git/commits/3389fa554e953d07a12a34f5681aae46f17958f8","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqIBDnCRC1aQ7uu5UhlAAAT8IQAIL40uK6UaTd8V8TtycR7wl4\nrF5IszzDUS85Lp76SK5m+zVzIk59iqg5wrDYScYeAMhrY/ra8Y+EiNdzZpSbN58k\nMiPG7YIQdmID7x2TigXPANR+F/5Eb5xUsNClAjE4AAVre3KCRQMhyxOEhGxwsOGf\nqA2SKXfXTcwbx08zAwX/G35yakIx9aCjxBW17aV9um3whZYEfZdb1gjK1CJdmbeJ\nZ6F0eyXpi3d46WkmzwwnCdadAma43LnbJcekP3hk1Ak54tt8GNLqjviKnAvOVYQG\njp4ENUG9jmFWHV/6HKdK9Sc4cjOuvpYDcrYWS7ypBWK+Vu+V2TYwN1AzHjFR68Rt\njXIiTe1f0somvxTEG3HMf2kE5787JfCpfs7O/KZ2YOFSgQ+1Bnd9TqGeT20Qtv1d\ndNi9LXK8k9nVCnKVInVhXZxUxYBi5YmPkrLmUJSoT6ODJ0VLG2VjJiWqYmXpGHx0\nWMOj2Qb4UcYoM2zi2hWTojSyxv557qHNA8LGN6Hobubc+TdOKHMjPeYsGVSdTRJI\nmXL4U8gRxx8WpHAd5gZDHPB3L6nD5tXnQyB4vJ22EAU0aj/iCVmAgTw/HNYrAYaS\nMvyyMR+FU0xd8DvWE+MuvApeZIbRrZEZCLVL98PSB/0KfhWuQaIHnffPJWJ8MSCv\nKdF2RvjhJwU7YKPlxlTd\n=3E/j\n-----END PGP SIGNATURE-----\n","payload":"tree 8e9dc12da371c441834ab5f55ab0b683d9408dfb\nparent 51493157cd1fda08343e521ef47ee002009b8a40\nauthor jif <jif@openai.com> 1780486375 +0200\ncommitter GitHub <noreply@github.com> 1780486375 +0200\n\nskills: resolve per-turn catalogs from turn input context (#26106)\n\n## Why\n\nThe skills extension needs the resolved turn environments to build a\nreal per-turn `SkillListQuery`. The previous `TurnLifecycleContributor`\nhook only had a turn id, so it could only seed a placeholder query and\nnever carry the executor authorities that executor-scoped skill routing\nwill need.\n\nMoving catalog resolution onto `TurnInputContributor` puts the skills\nextension on the same turn-preparation path that already has the\nenvironment ids and working directories for the submitted turn, while\nkeeping the actual prompt injection work for follow-up changes.\n\n## What changed\n\n- switch `ext/skills` from `TurnLifecycleContributor` to\n`TurnInputContributor`\n- build `executor_authorities` from `TurnInputContext.environments` and\npass them through `SkillListQuery`\n- keep storing the resolved catalog in `SkillsTurnState`, but drop the\nplaceholder query helper that no longer matches the real data flow\n- update the extension TODOs to reflect that per-turn catalog resolution\nnow happens in the turn-input contributor, and that prompt/context\ninjection still needs to move later\n\n## Testing\n\n- Not run locally.","verified_at":"2026-06-03T11:32:56Z"}},"url":"https://api.github.com/repos/openai/codex/commits/3389fa554e953d07a12a34f5681aae46f17958f8","html_url":"https://github.com/openai/codex/commit/3389fa554e953d07a12a34f5681aae46f17958f8","comments_url":"https://api.github.com/repos/openai/codex/commits/3389fa554e953d07a12a34f5681aae46f17958f8/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"51493157cd1fda08343e521ef47ee002009b8a40","url":"https://api.github.com/repos/openai/codex/commits/51493157cd1fda08343e521ef47ee002009b8a40","html_url":"https://github.com/openai/codex/commit/51493157cd1fda08343e521ef47ee002009b8a40"}]},{"sha":"51493157cd1fda08343e521ef47ee002009b8a40","node_id":"C_kwDOOYsS4doAKDUxNDkzMTU3Y2QxZmRhMDgzNDNlNTIxZWY0N2VlMDAyMDA5YjhhNDA","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-03T11:30:04Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-03T11:30:04Z"},"message":"Reject MAv2 close_agent self-targets (#26144)\n\n## Why\n\n`close_agent` is a parent-owned coordination tool: a worker should\nreturn its result, then let its parent decide when to close it. Before\nthis change, if an MAv2 worker targeted itself, the resolved target\ncould flow through the normal close path and ask the agent control layer\nto close the current conversation.\n\n## What changed\n\n- Reject `close_agent` when the resolved target is the current session's\n`conversation_id`, returning a model-visible error that tells the worker\nto return its result instead.\n- Keep the guard after target resolution so it covers both thread-id\ntargets and task-path targets.\n- Add coverage for self-targeting by thread id and by task name in\n`multi_agents_tests.rs`.\n\nRelevant code:\n\n-\n[`handle_close_agent`](https://github.com/openai/codex/blob/7c24e6641b693a3eed933dd376ce8f424ab6ea5f/codex-rs/core/src/tools/handlers/multi_agents_v2/close_agent.rs#L39-L57)\n- [`multi_agent_v2_close_agent_rejects_self_target_by_id` /\n`multi_agent_v2_close_agent_rejects_self_target_by_task_name`](https://github.com/openai/codex/blob/7c24e6641b693a3eed933dd376ce8f424ab6ea5f/codex-rs/core/src/tools/handlers/multi_agents_tests.rs#L3936-L4070)\n\n## Testing\n\nNot run locally.","tree":{"sha":"3488e318fb39aca69ce68b314520dd29bfdec1da","url":"https://api.github.com/repos/openai/codex/git/trees/3488e318fb39aca69ce68b314520dd29bfdec1da"},"url":"https://api.github.com/repos/openai/codex/git/commits/51493157cd1fda08343e521ef47ee002009b8a40","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqIBA8CRC1aQ7uu5UhlAAAaNIQAKwZgN2N5JUzke/n563C5wso\n6mfDHPtQ4GExia2AI4shNZpgTqT56UAz1PlTPgf+o8s0HeHf8XTxacTapoiLEVgz\ndh+lENWEqm+CuPytC9QfRNxjKNCTp7zt/w1qB7y0DMaXnN8neldjc4b/I3AU+Z/I\nkGN1soc/haVmD8bUOIU390QX48mEXf+7FbPnubXfFfOf1PAPouzJzZSVWzWByo1b\nXPX6aUkVrUwxd4t37WU1ERL4ne0ls6qa3V7vg23GxteVIV/OqHEVzI/PsLLqoWIv\n7mWJGy7ERafJsyF6ZaES/x45JO6srJqu2tPudhr/TgilPpGog/861BOte6DSKXzh\n3ZnBJpU2ZZvEhG3wxUOuyTL2kUIsHxG2Q2neunEhO3yE0M5zxv6MzjdFGaQZULxb\n6xc12ZSxRGxwrUZsR9FJ7LljBfXiKP1BNs39ryjcI5n4aQQe1DUchX8eLY9sxj/S\nVSlVXdZi0s35wv5MF7HjyOqK0D2ryR0wJiSLjFE5whvJS5NctL7X07jbQhnzbOiM\nWyQT1qlewvB3KUh8ov1NMj/psZM71GMQgxcSByh7pxvNqmwCepPrVhelfDUyTBnM\ne5mMHD0x1WW9uyBZy2id/EorbB6q/OMkGlHnyxGgGi4GyRUhhrM4oOAA5rSkIWeA\n9sTJ4tczHZbWksSZAzS+\n=2sWs\n-----END PGP SIGNATURE-----\n","payload":"tree 3488e318fb39aca69ce68b314520dd29bfdec1da\nparent ac67905fc44b2e4ebd1c295dfe73f87033c50826\nauthor jif <jif@openai.com> 1780486204 +0200\ncommitter GitHub <noreply@github.com> 1780486204 +0200\n\nReject MAv2 close_agent self-targets (#26144)\n\n## Why\n\n`close_agent` is a parent-owned coordination tool: a worker should\nreturn its result, then let its parent decide when to close it. Before\nthis change, if an MAv2 worker targeted itself, the resolved target\ncould flow through the normal close path and ask the agent control layer\nto close the current conversation.\n\n## What changed\n\n- Reject `close_agent` when the resolved target is the current session's\n`conversation_id`, returning a model-visible error that tells the worker\nto return its result instead.\n- Keep the guard after target resolution so it covers both thread-id\ntargets and task-path targets.\n- Add coverage for self-targeting by thread id and by task name in\n`multi_agents_tests.rs`.\n\nRelevant code:\n\n-\n[`handle_close_agent`](https://github.com/openai/codex/blob/7c24e6641b693a3eed933dd376ce8f424ab6ea5f/codex-rs/core/src/tools/handlers/multi_agents_v2/close_agent.rs#L39-L57)\n- [`multi_agent_v2_close_agent_rejects_self_target_by_id` /\n`multi_agent_v2_close_agent_rejects_self_target_by_task_name`](https://github.com/openai/codex/blob/7c24e6641b693a3eed933dd376ce8f424ab6ea5f/codex-rs/core/src/tools/handlers/multi_agents_tests.rs#L3936-L4070)\n\n## Testing\n\nNot run locally.","verified_at":"2026-06-03T11:30:05Z"}},"url":"https://api.github.com/repos/openai/codex/commits/51493157cd1fda08343e521ef47ee002009b8a40","html_url":"https://github.com/openai/codex/commit/51493157cd1fda08343e521ef47ee002009b8a40","comments_url":"https://api.github.com/repos/openai/codex/commits/51493157cd1fda08343e521ef47ee002009b8a40/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"ac67905fc44b2e4ebd1c295dfe73f87033c50826","url":"https://api.github.com/repos/openai/codex/commits/ac67905fc44b2e4ebd1c295dfe73f87033c50826","html_url":"https://github.com/openai/codex/commit/ac67905fc44b2e4ebd1c295dfe73f87033c50826"}]},{"sha":"ac67905fc44b2e4ebd1c295dfe73f87033c50826","node_id":"C_kwDOOYsS4doAKGFjNjc5MDVmYzQ0YjJlNGViZDFjMjk1ZGZlNzNmODcwMzNjNTA4MjY","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-03T10:25:21Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-03T10:25:21Z"},"message":"chore: extract context fragments into dedicated crate (#26122)\n\n## Why\n\n`codex-core` currently owns the generic contextual-fragment trait and\nseveral reusable fragment implementations. That makes it harder for\nother crates to share the same host-owned model-input abstraction\nwithout depending on all of `codex-core`.\n\nThis change extracts the reusable fragment machinery into a small\n`codex-context-fragments` crate so future extension and skills work can\ndepend on the fragment abstraction directly.\n\n## What Changed\n\n- Added the `codex-context-fragments` crate with:\n  - `ContextualUserFragment`\n  - `FragmentRegistration` / `FragmentRegistrationProxy`\n  - additional-context fragment types\n- Moved `SkillInstructions` into `codex-core-skills`, since\nskill-specific rendering belongs with skills rather than generic core\ncontext machinery.\n- Kept `codex-core` re-exporting the fragment types it still uses\ninternally, so existing call sites keep the same shape.\n- Updated Cargo and Bazel workspace metadata for the new crate.\n\n## Verification\n\n- `cargo metadata --locked --format-version 1 --no-deps`\n- `just bazel-lock-update`\n- `just bazel-lock-check`","tree":{"sha":"d3e308f837bc3d1426626b198d847a7cdf73f1ba","url":"https://api.github.com/repos/openai/codex/git/trees/d3e308f837bc3d1426626b198d847a7cdf73f1ba"},"url":"https://api.github.com/repos/openai/codex/git/commits/ac67905fc44b2e4ebd1c295dfe73f87033c50826","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqIAERCRC1aQ7uu5UhlAAA0GcQAKqE1vL3htUqq2iiCjqDcmGP\nlgz+FrPwZit+DjxqLvKdpu9v4HW4rkSCelCDceo6f8q0sNAXNSBfE38RSeZpAvaV\n92+cWX0kprjWbPuPJX2phwDHrCaxPi+OW9Xni87QgIU/3v49qIYBVh6ypddzl4bK\nm4M38Bp6aDYm+kcURe1jkqnFQaWCNQaW7vDzOouRGU7l50GNXCRGawT9tsdHzxH9\nzusfJ2a0sx0gPx3qp0JDzrKwlXP7vGx0yR/dW+Tenf7D0IKWpJv+WkENFCzcQf+V\nMSbY2kVsbpopleT0Thp+19M3muySg/25NhPwclV2U7aXPaNyGBdJl5DzLYTaiUdq\n6Y//cveDWyOT6PYSDZAclJ0daxxRrlg1FNG8H6eoW6EmDOEvFhyy/ElKeFUxjXqc\njvSfI6exxuft0vz191d3+xxwJS/XL2zkyOPWue2RXOb7mWA49ykAVhNjxI6fcwyO\nddXL5JZhnD/SgusXH5rpOCKbVDkfO/gMQvgt6yEG/fm6pOoSN+6xduk27WMKAbDJ\n82CsiCtLEIV8QeSMwhQTDoGKrAftFlY+wbuT6hz/iv2T0MjKB8UKMzLhD14+EoRW\n+AEWAWBV/mbew188/TRJzQpkD0pERsXfgtKNJTecAeiTvGUlexVRrBe4DH/VWLPh\nlwCmxe1vKPDRAGAf+fKg\n=7+e7\n-----END PGP SIGNATURE-----\n","payload":"tree d3e308f837bc3d1426626b198d847a7cdf73f1ba\nparent 668703c23f8a6cde07c317f687d9b95606293752\nauthor jif <jif@openai.com> 1780482321 +0200\ncommitter GitHub <noreply@github.com> 1780482321 +0200\n\nchore: extract context fragments into dedicated crate (#26122)\n\n## Why\n\n`codex-core` currently owns the generic contextual-fragment trait and\nseveral reusable fragment implementations. That makes it harder for\nother crates to share the same host-owned model-input abstraction\nwithout depending on all of `codex-core`.\n\nThis change extracts the reusable fragment machinery into a small\n`codex-context-fragments` crate so future extension and skills work can\ndepend on the fragment abstraction directly.\n\n## What Changed\n\n- Added the `codex-context-fragments` crate with:\n  - `ContextualUserFragment`\n  - `FragmentRegistration` / `FragmentRegistrationProxy`\n  - additional-context fragment types\n- Moved `SkillInstructions` into `codex-core-skills`, since\nskill-specific rendering belongs with skills rather than generic core\ncontext machinery.\n- Kept `codex-core` re-exporting the fragment types it still uses\ninternally, so existing call sites keep the same shape.\n- Updated Cargo and Bazel workspace metadata for the new crate.\n\n## Verification\n\n- `cargo metadata --locked --format-version 1 --no-deps`\n- `just bazel-lock-update`\n- `just bazel-lock-check`","verified_at":"2026-06-03T10:25:22Z"}},"url":"https://api.github.com/repos/openai/codex/commits/ac67905fc44b2e4ebd1c295dfe73f87033c50826","html_url":"https://github.com/openai/codex/commit/ac67905fc44b2e4ebd1c295dfe73f87033c50826","comments_url":"https://api.github.com/repos/openai/codex/commits/ac67905fc44b2e4ebd1c295dfe73f87033c50826/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"668703c23f8a6cde07c317f687d9b95606293752",