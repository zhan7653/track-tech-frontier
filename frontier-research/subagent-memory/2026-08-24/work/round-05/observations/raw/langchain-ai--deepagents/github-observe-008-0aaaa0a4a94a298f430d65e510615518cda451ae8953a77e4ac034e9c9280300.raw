d}","starred_url":"https://api.github.com/users/hntrl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hntrl/subscriptions","organizations_url":"https://api.github.com/users/hntrl/orgs","repos_url":"https://api.github.com/users/hntrl/repos","events_url":"https://api.github.com/users/hntrl/events{/privacy}","received_events_url":"https://api.github.com/users/hntrl/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a58212f1e2e47732ab8d637c3721c28063f5103a","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a58212f1e2e47732ab8d637c3721c28063f5103a","html_url":"https://github.com/langchain-ai/deepagents/commit/a58212f1e2e47732ab8d637c3721c28063f5103a"}]},{"sha":"a58212f1e2e47732ab8d637c3721c28063f5103a","node_id":"C_kwDOPTymldoAKGE1ODIxMmYxZTJlNDc3MzJhYjhkNjM3YzM3MjFjMjgwNjNmNTEwM2E","commit":{"author":{"name":"Shrikar Seshadri","email":"146694785+davibinboi@users.noreply.github.com","date":"2026-07-24T18:42:48Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-24T18:42:48Z"},"message":"feat(evals): add timeout and retry controls (#4893)\n\nDepends on #4872\n\nUnified evals can configure agent timeout scaling and retry incomplete\nHarbor trials.\n\n---\n## Changes Made to Harbor\n\n- Branch: `ss/langgraph/managed-python-bootstrap`, Commit: `d2e20423`\n- Added an optional reward-gated retry via a new\n`--retry-if-reward-below <float>` CLI flag (backed by\n`RetryConfig.retry_if_reward_below`, default `None`).\n- Behavior:\n- When set, an errored trial is retried only if its primary reward is\nbelow the threshold.\n  - A missing reward always qualifies for retry.\n- Layers on top of the existing exception include/exclude policy -\n`AgentTimeoutError` and other default-excluded exceptions stay\nnon-retryable.\n- When unset, retry behavior is unchanged (trial is retried if it\nrecorded an exception, regardless of reward)\n- Files changed:\n- `models/job/config.py` — new `RetryConfig.retry_if_reward_below`\nfield.\n- `models/trial/result.py` — new `TrialResult.primary_reward()` helper.\n- `trial/queue.py` — reward gate wired into the retry decision, after\nthe exception check.\n  - `cli/jobs.py` — `--retry-if-reward-below` option → `config.retry`.\n- `upload/uploader.py` — reused the new helper (removed duplicated\nreward extraction).\n\n\n\n## What this PR Does:\n\n- Adds cost-safe n_retries=0 and agent_timeout_multiplier=1.0 dispatch\ninputs.\n- Validates both inputs during unified prep before any eval matrix jobs\nlaunch.\n- Uses Harbor retry classification plus --retry-if-reward-below 1.0 when\nretries are enabled\n- Reports configured controls and actual Harbor retry counts in workflow\nsummaries.\n- Keeps comparator identities and metrics unchanged.\n\n## Tests\n- All 622 GitHub helper-script tests pass; focused Ruff checks and\nworkflow YAML parsing pass.\n- One-task immutable-Harbor Docker run 29860384397 passed end to end\nwith n_retries=1 and agent_timeout_multiplier=1.5. The task scored 0\nwithout an exception and correctly recorded 0 actual retries.\n\n\n## Eval Run with Changes:\nhttps://github.com/langchain-ai/deepagents/actions/runs/29868334615\n\n## Harbor + Harbor LangSmith Override to Use for Evals:\n\n`-f 'harbor_package_override=harbor @\ngit+https://github.com/nick-hollon-lc/harbor.git@ss/langgraph/managed-python-bootstrap\nharbor-langsmith @\ngit+https://github.com/nick-hollon-lc/harbor.git@ss/langgraph/managed-python-bootstrap#subdirectory=packages/harbor-langsmith'`","tree":{"sha":"3e76f947ee11e30658657f8150d1bc5d6d0e4743","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/3e76f947ee11e30658657f8150d1bc5d6d0e4743"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/a58212f1e2e47732ab8d637c3721c28063f5103a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqY7IoCRC1aQ7uu5UhlAAAY5QQAJ4Xt44WEJF3/c0rET53WlSa\n/zUW/+lbzPS3m+ZWnPl02NHhzq8TDFPSu9KLrog7MhTqffCGQ0x5VsoRZ+q7MEHV\nueYDJxt12AIyPs3XrSub58AaWHcYA0uPSIrukHxJ1kSicbC8LYGVj1Ju+RsFBtjF\nY02MzgkVykAHelVj7rJAfawRIUvbVKs39Om6TuVJHTnEwOxNFV5b5NQ5iqtGHDhb\nLXATbzWbgWy1fgYi4YFxai+Z+MTpOQxM3/kNH3rhOLoFQ7ZkVT9Cnqu5PE5kmPTY\nnmU1ZBe2SreIsDJ4Gy7n5kgXOjfpel3JSE+Wqg8GKFa0onfZhpYwaQeGGQhwvOIu\n0oyTshbY+JsRhq9arTL+66lpbkq5eqQCE+BD5TvUIKoWdprqNK8lSmF33A0PBgBs\nadn9as3boAAnMfYvDqlzgTej1QnvHE34v2ywYPbL137OsQ9LTRv15v05E438xg5X\n0wewhAQIANz+zVjh7zXbDqXKE42gdGZ7z72WMIZKQDOuQSoVC/8KOO/d4zych5Cp\nhDnlhjQzFOuvJxhKZZjiCROUYfjTa10YnsS2wQ1cwugLV/7PD2374iwH24EyQYUu\nrNQgMMFQK7hGdfT9mekjvbCeuaBhzFHhczd9Z/vLOoSQJ1QvOjdgBESNHQkd9qsl\nWkVoHk6IZelQ2dfrGy2M\n=NRKS\n-----END PGP SIGNATURE-----\n","payload":"tree 3e76f947ee11e30658657f8150d1bc5d6d0e4743\nparent fdb585c87b054979b8440bdc6ac97fc8ae628134\nauthor Shrikar Seshadri <146694785+davibinboi@users.noreply.github.com> 1784918568 -0700\ncommitter GitHub <noreply@github.com> 1784918568 -0700\n\nfeat(evals): add timeout and retry controls (#4893)\n\nDepends on #4872\n\nUnified evals can configure agent timeout scaling and retry incomplete\nHarbor trials.\n\n---\n## Changes Made to Harbor\n\n- Branch: `ss/langgraph/managed-python-bootstrap`, Commit: `d2e20423`\n- Added an optional reward-gated retry via a new\n`--retry-if-reward-below <float>` CLI flag (backed by\n`RetryConfig.retry_if_reward_below`, default `None`).\n- Behavior:\n- When set, an errored trial is retried only if its primary reward is\nbelow the threshold.\n  - A missing reward always qualifies for retry.\n- Layers on top of the existing exception include/exclude policy -\n`AgentTimeoutError` and other default-excluded exceptions stay\nnon-retryable.\n- When unset, retry behavior is unchanged (trial is retried if it\nrecorded an exception, regardless of reward)\n- Files changed:\n- `models/job/config.py` — new `RetryConfig.retry_if_reward_below`\nfield.\n- `models/trial/result.py` — new `TrialResult.primary_reward()` helper.\n- `trial/queue.py` — reward gate wired into the retry decision, after\nthe exception check.\n  - `cli/jobs.py` — `--retry-if-reward-below` option → `config.retry`.\n- `upload/uploader.py` — reused the new helper (removed duplicated\nreward extraction).\n\n\n\n## What this PR Does:\n\n- Adds cost-safe n_retries=0 and agent_timeout_multiplier=1.0 dispatch\ninputs.\n- Validates both inputs during unified prep before any eval matrix jobs\nlaunch.\n- Uses Harbor retry classification plus --retry-if-reward-below 1.0 when\nretries are enabled\n- Reports configured controls and actual Harbor retry counts in workflow\nsummaries.\n- Keeps comparator identities and metrics unchanged.\n\n## Tests\n- All 622 GitHub helper-script tests pass; focused Ruff checks and\nworkflow YAML parsing pass.\n- One-task immutable-Harbor Docker run 29860384397 passed end to end\nwith n_retries=1 and agent_timeout_multiplier=1.5. The task scored 0\nwithout an exception and correctly recorded 0 actual retries.\n\n\n## Eval Run with Changes:\nhttps://github.com/langchain-ai/deepagents/actions/runs/29868334615\n\n## Harbor + Harbor LangSmith Override to Use for Evals:\n\n`-f 'harbor_package_override=harbor @\ngit+https://github.com/nick-hollon-lc/harbor.git@ss/langgraph/managed-python-bootstrap\nharbor-langsmith @\ngit+https://github.com/nick-hollon-lc/harbor.git@ss/langgraph/managed-python-bootstrap#subdirectory=packages/harbor-langsmith'`","verified_at":"2026-07-24T18:42:48Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a58212f1e2e47732ab8d637c3721c28063f5103a","html_url":"https://github.com/langchain-ai/deepagents/commit/a58212f1e2e47732ab8d637c3721c28063f5103a","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a58212f1e2e47732ab8d637c3721c28063f5103a/comments","author":{"login":"davibinboi","id":146694785,"node_id":"U_kgDOCL5igQ","avatar_url":"https://avatars.githubusercontent.com/u/146694785?v=4","gravatar_id":"","url":"https://api.github.com/users/davibinboi","html_url":"https://github.com/davibinboi","followers_url":"https://api.github.com/users/davibinboi/followers","following_url":"https://api.github.com/users/davibinboi/following{/other_user}","gists_url":"https://api.github.com/users/davibinboi/gists{/gist_id}","starred_url":"https://api.github.com/users/davibinboi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/davibinboi/subscriptions","organizations_url":"https://api.github.com/users/davibinboi/orgs","repos_url":"https://api.github.com/users/davibinboi/repos","events_url":"https://api.github.com/users/davibinboi/events{/privacy}","received_events_url":"https://api.github.com/users/davibinboi/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"fdb585c87b054979b8440bdc6ac97fc8ae628134","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/fdb585c87b054979b8440bdc6ac97fc8ae628134","html_url":"https://github.com/langchain-ai/deepagents/commit/fdb585c87b054979b8440bdc6ac97fc8ae628134"}]},{"sha":"fdb585c87b054979b8440bdc6ac97fc8ae628134","node_id":"C_kwDOPTymldoAKGZkYjU4NWM4N2IwNTQ5NzliODQ0MGJkYzZhYzk3ZmM4YWU2MjgxMzQ","commit":{"author":{"name":"Johannes du Plessis","email":"johannes@langchain.dev","date":"2026-07-24T15:01:58Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-24T15:01:58Z"},"message":"feat(code): migrate legacy hooks to v2 events (#4971)\n\nDepends on #4918\n\nLegacy hooks with prompt, compaction, turn-completion, notification, and\nsession-end subscriptions now migrate into typed Hooks v2 events while\nretaining their side-effect-only behavior.\n\n---\n\nThis adds typed `UserPromptSubmit` and `PreCompact` domain, wire,\ncapability, projection, matching, and reduction support. The migration\nconsolidates legacy aliases, preserves the five-second timeout, and\nneutralizes stdout and exit status so observational legacy commands\ncannot unexpectedly block Hooks v2 lifecycle actions.\n\nLegacy tool and permission events remain unmapped because their\nfire-and-forget, batched, and failure semantics are not equivalent to\nthe current Hooks v2 lifecycle events.\n\n<!-- branch-stack-start -->\n\n-------------------------\n- main\n  - https://github.com/langchain-ai/deepagents/pull/4917\n    - https://github.com/langchain-ai/deepagents/pull/4918\n      - **feat(code): migrate legacy hooks to v2 events** :point_left:\n\n<sup>[Stack](https://www.git-town.com/how-to/proposal-breadcrumb.html)\ngenerated by [Git Town](https://github.com/git-town/git-town)</sup>\n\n<!-- branch-stack-end -->\n\n---------\n\nCo-authored-by: Cursor <cursoragent@cursor.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"8549bae41184259800f454b854af557ee2023152","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/8549bae41184259800f454b854af557ee2023152"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/fdb585c87b054979b8440bdc6ac97fc8ae628134","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqY35mCRC1aQ7uu5UhlAAAFu0QAItFojbuiY3Qg06wx5UKu0PC\nR5L0jyfn8xoQrLSXGfc3frzLAs2zKkZQz6WFc1gj5pupf8EXsV83RP+5csl3MomT\n4X4fHAYcLIZAw/ST+AiqIz3vojzPd6RgtRnICtwllJ14dAXM+Jm+pCamZVQoOgPF\n7oGVsnzERANjAEQYokYUWEWIPCg8ev8a/+C2QusXo0oH28dyy8lruZ36XPEoKL6n\ny0/uncHscSj+fqEuWZ4WY0vGvROHyVVNSBlLff/ZQOWsHi55Efd7veUnggkoh7z1\n4LHjAtHqmV9FUA6fzD1INRGSbtVBi+7v3iv6q4NgqijX60VFtJhMaX5kgRj5+QYd\nHH3vt0AZtnqWGnilwvHWVAKWMLIhNyaIWf8gqqsAmjooPua38KlEELwP810ebpdz\naX37z1uvNPFpJnhDK/GscbJMkVgZ6HybuLL/OKsh5pvGIRKPu2nEENs8sRLhrRGF\noiovJmxIIekgLWn2EUYOv9YUJ4jqKcYdErWNoU3fg8cFFP+MegVyGt4SgvGqqN7n\nH7JVFjoSZpR01e6sb4toaOECZIzUKIormxfmdwZZdrYLPNnZnjYDId/PWmnEm5eM\nk2zL0RYSvVZgu5j5LQQGxDDveNivX0EMLfd6S67poyrc91hhlZzu9Ie2Fy02HK5j\nV5jnTT64hTrmjv5af3Gy\n=9DB7\n-----END PGP SIGNATURE-----\n","payload":"tree 8549bae41184259800f454b854af557ee2023152\nparent 8aa29ddc28332fb13c5dcfa7f2f732130e497c7d\nauthor Johannes du Plessis <johannes@langchain.dev> 1784905318 -0700\ncommitter GitHub <noreply@github.com> 1784905318 -0700\n\nfeat(code): migrate legacy hooks to v2 events (#4971)\n\nDepends on #4918\n\nLegacy hooks with prompt, compaction, turn-completion, notification, and\nsession-end subscriptions now migrate into typed Hooks v2 events while\nretaining their side-effect-only behavior.\n\n---\n\nThis adds typed `UserPromptSubmit` and `PreCompact` domain, wire,\ncapability, projection, matching, and reduction support. The migration\nconsolidates legacy aliases, preserves the five-second timeout, and\nneutralizes stdout and exit status so observational legacy commands\ncannot unexpectedly block Hooks v2 lifecycle actions.\n\nLegacy tool and permission events remain unmapped because their\nfire-and-forget, batched, and failure semantics are not equivalent to\nthe current Hooks v2 lifecycle events.\n\n<!-- branch-stack-start -->\n\n-------------------------\n- main\n  - https://github.com/langchain-ai/deepagents/pull/4917\n    - https://github.com/langchain-ai/deepagents/pull/4918\n      - **feat(code): migrate legacy hooks to v2 events** :point_left:\n\n<sup>[Stack](https://www.git-town.com/how-to/proposal-breadcrumb.html)\ngenerated by [Git Town](https://github.com/git-town/git-town)</sup>\n\n<!-- branch-stack-end -->\n\n---------\n\nCo-authored-by: Cursor <cursoragent@cursor.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-07-24T15:01:59Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/fdb585c87b054979b8440bdc6ac97fc8ae628134","html_url":"https://github.com/langchain-ai/deepagents/commit/fdb585c87b054979b8440bdc6ac97fc8ae628134","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/fdb585c87b054979b8440bdc6ac97fc8ae628134/comments","author":{"login":"johannes117","id":51395795,"node_id":"MDQ6VXNlcjUxMzk1Nzk1","avatar_url":"https://avatars.githubusercontent.com/u/51395795?v=4","gravatar_id":"","url":"https://api.github.com/users/johannes1