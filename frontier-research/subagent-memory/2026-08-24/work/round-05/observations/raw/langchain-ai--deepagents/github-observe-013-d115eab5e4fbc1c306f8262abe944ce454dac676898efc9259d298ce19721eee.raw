s/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"965cbd566b019a9ff2e39a35a5dce387660a77db","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/965cbd566b019a9ff2e39a35a5dce387660a77db","html_url":"https://github.com/langchain-ai/deepagents/commit/965cbd566b019a9ff2e39a35a5dce387660a77db"}]},{"sha":"965cbd566b019a9ff2e39a35a5dce387660a77db","node_id":"C_kwDOPTymldoAKDk2NWNiZDU2NmIwMTlhOWZmMmUzOWEzNWE1ZGNlMzg3NjYwYTc3ZGI","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-25T19:02:44Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-25T19:02:44Z"},"message":"chore(repo): cut over v0.7 to main (#4280)\n\nThis PR represents the `v0.7` cutover onto `main`.\n\n`v0.7` has been rewritten so its history is clean and contains only the\nintended version-line commits on top of `main`:\n\n- `fix(sdk): return sentinel for empty file lists (#3709)`\n- `feat(sdk): add recursive filesystem delete support`\n- `feat(sdk): allow write_file to overwrite existing files`\n\nImportant: do **not** squash-merge this PR. The cutover must preserve\nthe individual commits so release-please can generate the correct\nchangelog. Use an admin `git merge --no-ff origin/v0.7` into `main`\nafter CI is green, per `.github/RELEASING.md`.\n\n---------\n\nCo-authored-by: open-swe[bot] <215916821+open-swe[bot]@users.noreply.github.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"4f88dd18d041df7240cff1e238c0b711f6f86680","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/4f88dd18d041df7240cff1e238c0b711f6f86680"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/965cbd566b019a9ff2e39a35a5dce387660a77db","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPXtUCRC1aQ7uu5UhlAAAQ78QABSnPB7JL0BXtjIYce9eIOwS\nLDlhyr5ueDgZvM4LxT1hduLo2iVvNh09r9C7LDDyiooINgyvOa2wmiI2+JOgqx56\nsYU5ujb9DQ29BCGlwCVS2pbgjy7N/6WOPQPcpXH8sLmsYwSovkwPXYfNMHWERVIW\nzyhwvPHa0hmxC8afZrvlkMciwKe+aCDfbbfsMKuE4hJc9YVYby+TntZKmzouEkAE\nZS1Z+73xjBXYmqdfxEraqWUn7SdhU+92gjzeSVr/yFn23L6EgkXeHgVCkySwPXAZ\nPGSCY0S69zCeYO0+NepezodSY1C4W4gfk/IsiatZBnGOT3gI6ehqdLNroumt4RND\nugmvDOlHdiZgmPw8YmRoGKkmgXwqQXAwafvD95Pxdjer07FnejGny05gugEDplJ+\nBIjM1K/t8RG9HvbO7k34xhTYROuWxp1GhNZtqaorj1i/7zUxSiPfB+Tn7o9HTlZL\n+lk459DvkKtFvuKFs5jNbCUjC4fq2drEDqI7Q9kXftHv9ncycUt35FmaoqlpBF/j\njYlPqIekgT5oOWC68vcAi2zpu8oNLxCHiaA87DyGyDu78kkztfkS/VNDMldae0nU\nQXED/ava7uKcBXK+ZIYtGXaFOplN+3Y6YJp4a6FuVHvS2ZTBDL0vycux1XQ2/sIF\noYm4Fxu1jd/u/qen110C\n=tIX+\n-----END PGP SIGNATURE-----\n","payload":"tree 4f88dd18d041df7240cff1e238c0b711f6f86680\nparent e26869c40a932861bb9f824783adaf7b363a40ea\nauthor Mason Daugherty <mason@langchain.dev> 1782414164 -0400\ncommitter GitHub <noreply@github.com> 1782414164 -0400\n\nchore(repo): cut over v0.7 to main (#4280)\n\nThis PR represents the `v0.7` cutover onto `main`.\n\n`v0.7` has been rewritten so its history is clean and contains only the\nintended version-line commits on top of `main`:\n\n- `fix(sdk): return sentinel for empty file lists (#3709)`\n- `feat(sdk): add recursive filesystem delete support`\n- `feat(sdk): allow write_file to overwrite existing files`\n\nImportant: do **not** squash-merge this PR. The cutover must preserve\nthe individual commits so release-please can generate the correct\nchangelog. Use an admin `git merge --no-ff origin/v0.7` into `main`\nafter CI is green, per `.github/RELEASING.md`.\n\n---------\n\nCo-authored-by: open-swe[bot] <215916821+open-swe[bot]@users.noreply.github.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-25T19:02:45Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/965cbd566b019a9ff2e39a35a5dce387660a77db","html_url":"https://github.com/langchain-ai/deepagents/commit/965cbd566b019a9ff2e39a35a5dce387660a77db","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/965cbd566b019a9ff2e39a35a5dce387660a77db/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e26869c40a932861bb9f824783adaf7b363a40ea","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/e26869c40a932861bb9f824783adaf7b363a40ea","html_url":"https://github.com/langchain-ai/deepagents/commit/e26869c40a932861bb9f824783adaf7b363a40ea"}]},{"sha":"e26869c40a932861bb9f824783adaf7b363a40ea","node_id":"C_kwDOPTymldoAKGUyNjg2OWM0MGE5MzI4NjFiYjlmODI0NzgzYWRhZjdiMzYzYTQwZWE","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-25T18:41:19Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-25T18:41:19Z"},"message":"ci(quickjs): run prompt smoke tests on SDK changes (#4266)\n\nQuickJS prompt snapshots can drift when the SDK changes without touching\nthe quickjs partner, because the partner test suite is path-gated. A\ndedicated pull-request CI job now runs the prompt smoke test against the\neditable local SDK in that gap, while avoiding redundant runs when the\nfull quickjs suite already covers it.","tree":{"sha":"0cfa71095c6b4ae96d0b81cfcc0b2e5d8211ea31","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/0cfa71095c6b4ae96d0b81cfcc0b2e5d8211ea31"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/e26869c40a932861bb9f824783adaf7b363a40ea","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPXZPCRC1aQ7uu5UhlAAAZk4QACAWVEqxQgZn/pCkru1309Wc\nAXQRNFY/kBMkiotkSA75XlddXGqDg/hFmqazzYjzWx4cqkc0VLs375w35GlnSWo4\neS2XhDIYpi8r090KsBxi1Err8cq85Gz2m3bUktFp2VlM0nfN6Zr4ShKbmzzCJs03\ny5OoeNJAaCuAyqkYwJAQEzX47xnUTcPFdBbXGHtagTsfrUEiD2cFXKfxjhc5gkjn\nd9Z+ZAHl25DoLhh90uOMgZK2DhaRy8FWSlRQHj2nqrJX20DXa3QpyUXTjtEV+2jF\n/+gnwYX4CZFACMDWk+6SVbtkiygu5N6h96XhdHmIt9LJJX/2F/+OsYWiWKsn0kw/\nr2rnoTEXX1vw5JKnXcvbMKPmHkJDs/bU0gTUWnCIuLt64lX9N5KM3U7u/+r93zr8\n0YoaLdz1IIj6q5/5OeeC9j7eA0sLHwIW2yemjmwc28ZC+c59/LVUzuypzMGPXx2A\nlbjvfkeEoqpGYmDVJQJc8Kk15OfPDHYS6UFwYgc+wT06NoXFn4ebEiT+sH1mVLVP\nJ6E+zPbD1iUJ+NxUdSkInFr6sRlY/OAaQBBJtxkm3/spWvVlc5YQnYb0LfQ1Q0uB\nGF7woo/an0EjTEC9hwez8WW2O8VRskbKf7DQc55P2EUiclOvKOfuUUOReWv5l5nQ\n3QZqzhwa+HchP0F2Te0L\n=eOVF\n-----END PGP SIGNATURE-----\n","payload":"tree 0cfa71095c6b4ae96d0b81cfcc0b2e5d8211ea31\nparent eb5a53a9d8dec268e5f0851aa6d4ca54dc9444b8\nauthor Mason Daugherty <mason@langchain.dev> 1782412879 -0400\ncommitter GitHub <noreply@github.com> 1782412879 -0400\n\nci(quickjs): run prompt smoke tests on SDK changes (#4266)\n\nQuickJS prompt snapshots can drift when the SDK changes without touching\nthe quickjs partner, because the partner test suite is path-gated. A\ndedicated pull-request CI job now runs the prompt smoke test against the\neditable local SDK in that gap, while avoiding redundant runs when the\nfull quickjs suite already covers it.","verified_at":"2026-06-25T18:41:19Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/e26869c40a932861bb9f824783adaf7b363a40ea","html_url":"https://github.com/langchain-ai/deepagents/commit/e26869c40a932861bb9f824783adaf7b363a40ea","c