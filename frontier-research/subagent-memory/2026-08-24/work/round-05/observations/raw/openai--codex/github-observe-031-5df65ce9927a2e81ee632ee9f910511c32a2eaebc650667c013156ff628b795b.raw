site_admin":false},"parents":[{"sha":"6c1215dac66494fea326b2f1d472b5ff676a28a3","url":"https://api.github.com/repos/openai/codex/commits/6c1215dac66494fea326b2f1d472b5ff676a28a3","html_url":"https://github.com/openai/codex/commit/6c1215dac66494fea326b2f1d472b5ff676a28a3"}]},{"sha":"6c1215dac66494fea326b2f1d472b5ff676a28a3","node_id":"C_kwDOOYsS4doAKDZjMTIxNWRhYzY2NDk0ZmVhMzI2YjJmMWQ0NzJiNWZmNjc2YTI4YTM","commit":{"author":{"name":"canvrno-oai","email":"kbond@openai.com","date":"2026-05-28T17:30:15Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-28T17:30:15Z"},"message":"TUI: Unified mentions tweaks + polish mentions rendering (#23363)\n\nThis change keeps unified @mentions behind the mentions_v2 gate, moves\nthe flag to under-development, and polishes mention rendering/history\nbehavior.\n\nIt also adds a few small improvements to the mentions feature around\nmention rendering and history round-tripping for plugin/tool mentions in\nmessage edit scenarios. Plugin selections now insert `@` mentions with\nbetter casing, and saved history preserves the visible sigil so recalled\nmessages look the same as what the user typed.\n\n- Preserves `@` sigils when encoding/decoding mention history for\ntool/plugin paths.\n- Improves plugin mention insertion so display names/casing are\nreflected more cleanly in the composer.\n- Update composer to render user-entered plugin mentions in the same\ncolor as the mentions menu. ALso applies to recalled/edited messages.\n- Left/right arrows no longer switch unified-mention search modes after\nan @mention has already been accepted (Ex: arrowing left through a\ncomposed message that contains @mentions).\n- Keeps bound mentions stable around punctuation, so accepted `@`\nmentions do not reopen the popup and punctuated `$` mentions still\npersist to cross-session history.\n\n**Steps to test**\n- Ensure mentions_v2 is enabled through configuration or `--enable\nmentions_v2`\n- Type `@` in the TUI composer and verify filesystem/plugin/skill\nresults are displayed in the unified mentions menu.\n- Select a plugin mention from the `@` popup and confirm the inserted\ntext is an `@...` mention with casing, then recall/edit the message and\nconfirm it still renders as `@...`.\n- Mention a skill and verify that skills still insert as `$skill`\nmentions rather than `@` mentions.\n- Verify punctuated mentions such as `@plugin.` and `($skill)` keep\ntheir bound mention behavior across editing and history recall.","tree":{"sha":"34793a2f82f4611da295ea1cce4a35de44546cde","url":"https://api.github.com/repos/openai/codex/git/trees/34793a2f82f4611da295ea1cce4a35de44546cde"},"url":"https://api.github.com/repos/openai/codex/git/commits/6c1215dac66494fea326b2f1d472b5ff676a28a3","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqGHunCRC1aQ7uu5UhlAAA0OEQABqpXk6UzuS9g9hp0qg59ZQ6\nvqiHNcDLKXUB9OHMTf1pWKxA+GrpUgNkY9WMmCKtB1S92idcstTVQxvLPb3khNNC\nT0LkgvoKQ+GRvG3Pldvp40aMsbruoF0cvAiPxNWVaT0biSd97mKxTf0YPRR3E9VE\nEeuSI3qeyyZnL2okg6ngJqd4HH2zMZgXwErvOAQ7/0x98uuwMgJwTEmIW3QsPcZm\n0zYvAg0mJXBxWUY0zihw+B2PRsER0++C3/uTMevUhuutVbFmEhAdoUy6xvKAhAhf\n+MSCwbIsMOG0NA3QzdH/t4b73dZL2s6tS9aOjMtoesG19r0wuC8pg4pAFAeCxV2z\nHbv4xJvQkm3GhBKs3dMZhddG4Xwgssxn7WJTvkOTPEo9zW/5Qqhd0Iqcf52P7mDh\noXeo5YJzS/Sn0X/2wXj/s2ZMt7WLNXkvExNETxXGKmwS+C/1xe41hiOmwOR8Biho\nBFsYTkCNqu+/Bhs2FzP+sfUg8ZuxHGG52ubYtoTSXYeS7w2/dcYE7SSNhjWaxZ5w\nc9BnqtnAn5PGKQKw8Pq1seG1xhpE4+rwuUBzdlbkeDHSgB2wp2NGuH+hgaw6QMkM\n3cPgWv94Ns1BDhnyQCccvX+UI6SEQQFrUnIfGMQ0F9MTA/Y4W/Llmyepuxj/wSaW\nO11yRGlb0JwS1ZcTxJOo\n=C7Z8\n-----END PGP SIGNATURE-----\n","payload":"tree 34793a2f82f4611da295ea1cce4a35de44546cde\nparent 489bf386580409891b1792331eff4dd92afd4404\nauthor canvrno-oai <kbond@openai.com> 1779989415 -0700\ncommitter GitHub <noreply@github.com> 1779989415 -0700\n\nTUI: Unified mentions tweaks + polish mentions rendering (#23363)\n\nThis change keeps unified @mentions behind the mentions_v2 gate, moves\nthe flag to under-development, and polishes mention rendering/history\nbehavior.\n\nIt also adds a few small improvements to the mentions feature around\nmention rendering and history round-tripping for plugin/tool mentions in\nmessage edit scenarios. Plugin selections now insert `@` mentions with\nbetter casing, and saved history preserves the visible sigil so recalled\nmessages look the same as what the user typed.\n\n- Preserves `@` sigils when encoding/decoding mention history for\ntool/plugin paths.\n- Improves plugin mention insertion so display names/casing are\nreflected more cleanly in the composer.\n- Update composer to render user-entered plugin mentions in the same\ncolor as the mentions menu. ALso applies to recalled/edited messages.\n- Left/right arrows no longer switch unified-mention search modes after\nan @mention has already been accepted (Ex: arrowing left through a\ncomposed message that contains @mentions).\n- Keeps bound mentions stable around punctuation, so accepted `@`\nmentions do not reopen the popup and punctuated `$` mentions still\npersist to cross-session history.\n\n**Steps to test**\n- Ensure mentions_v2 is enabled through configuration or `--enable\nmentions_v2`\n- Type `@` in the TUI composer and verify filesystem/plugin/skill\nresults are displayed in the unified mentions menu.\n- Select a plugin mention from the `@` popup and confirm the inserted\ntext is an `@...` mention with casing, then recall/edit the message and\nconfirm it still renders as `@...`.\n- Mention a skill and verify that skills still insert as `$skill`\nmentions rather than `@` mentions.\n- Verify punctuated mentions such as `@plugin.` and `($skill)` keep\ntheir bound mention behavior across editing and history recall.","verified_at":"2026-05-28T17:30:16Z"}},"url":"https://api.github.com/repos/openai/codex/commits/6c1215dac66494fea326b2f1d472b5ff676a28a3","html_url":"https://github.com/openai/codex/commit/6c1215dac66494fea326b2f1d472b5ff676a28a3","comments_url":"https://api.github.com/repos/openai/codex/commits/6c1215dac66494fea326b2f1d472b5ff676a28a3/comments","author":{"login":"canvrno-oai","id":257630656,"node_id":"U_kgDOD1shwA","avatar_url":"https://avatars.githubusercontent.com/u/257630656?v=4","gravatar_id":"","url":"https://api.github.com/users/canvrno-oai","html_url":"https://github.com/canvrno-oai","followers_url":"https://api.github.com/users/canvrno-oai/followers","following_url":"https://api.github.com/users/canvrno-oai/following{/other_user}","gists_url":"https://api.github.com/users/canvrno-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/canvrno-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/canvrno-oai/subscriptions","organizations_url":"https://api.github.com/users/canvrno-oai/orgs","repos_url":"https://api.github.com/users/canvrno-oai/repos","events_url":"https://api.github.com/users/canvrno-oai/events{/privacy}","received_events_url":"https://api.github.com/users/canvrno-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"489bf386580409891b1792331eff4dd92afd4404","url":"https://api.github.com/repos/openai/codex/commits/489bf386580409891b1792331eff4dd92afd4404","html_url":"https://github.com/openai/codex/commit/489bf386580409891b1792331eff4dd92afd4404"}]},{"sha":"489bf386580409891b1792331eff4dd92afd4404","node_id":"C_kwDOOYsS4doAKDQ4OWJmMzg2NTgwNDA5ODkxYjE3OTIzMzFlZmY0ZGQ5MmFmZDQ0MDQ","commit":{"author":{"name":"Celia Chen","email":"celia@openai.com","date":"2026-05-28T17:29:06Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-28T17:29:06Z"},"message":"chore: add GPT-5.5 to the Amazon Bedrock catalog (#24701)\n\n## Summary\n\nAmazon Bedrock should expose GPT-5.5 alongside GPT-5.4, and the Bedrock\nGPT entries should stay aligned with the canonical bundled OpenAI model\nmetadata instead of carrying a separate hand-written copy that can drift\nover time. This change will be merged when the model is online.\n\nThis change:\n\n- Adds the Bedrock Mantle model id for `openai.gpt-5.5`.\n- Builds the Bedrock GPT-5.5 and GPT-5.4 catalog entries from the\nbundled OpenAI model catalog, then overrides the Bedrock-facing slug,\nexplicit priority, and Bedrock-specific context windows.\n- Hardcodes both `context_window` and `max_context_window` to `272000`\nfor Bedrock GPT-5.5 and GPT-5.4.\n- Keeps `openai.gpt-5.5` as the default Bedrock model ahead of\n`openai.gpt-5.4` and the Bedrock OSS models.","tree":{"sha":"6212c81847d915f6a02d719140d8fe3ac793f744","url":"https://api.github.com/repos/openai/codex/git/trees/6212c81847d915f6a02d719140d8fe3ac793f744"},"url":"https://api.github.com/repos/openai/codex/git/commits/489bf386580409891b1792331eff4dd92afd4404","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqGHtiCRC1aQ7uu5UhlAAAz/AQAFOYwnv14yURp3JLs4vcj63+\nZ5PhS7/zYkFRLNScHdUPf8gvEv4jPNHYoIELmKakmIEjAueXmv+imQRhVXmLh3Yu\nE/B+vShWFpv2cs1q+Mt2gJKOR3Gw/r+50e4GNx0J+FJwugOOgc4sPFgBf3JVBAHM\np9b76fU5DscfSKpIfs75QZaK5Asoivm2acpKygIa8Sb+i7i4y+CLlHWRRBHVRZ/2\nXSKX6SvUgbkuwYKgD2BIDTVaA9kOi0O9bNjklsGGR36dkkYYMa5ikSHftdKFSi2E\nEQ2IyDQvKd30vROFT5iusSrMCry7Gsohf9PLtedlaq6MWgBiUubu+DtS/vJkggzV\nlGksPyICphRq2Pljre26ltD5dDtxW2zabCay/4v9ymv6/YBCQgF4ramPwNctDTO9\nMGSEC4PhjnW+p7soLUv6/rgU/oGdH7d9MzyA7LczRrCh/eOLb7WUTaDaOobsTdT4\nVWAl9cB11yWQEzxXMl1bO+105u6CbXBgdRA2t7yWyTfpgxzlxRXOqI4QCkkPVM7h\n7MpFtNuQWgWLBewXeYWv1fsFCyA9++k1zjY8O456XncgOb4CmDXu9PGwLNzctRQ/\nn45BgWyurSifIOXpYGAa2uy1VVeUwfnpna3yOOw+F13MFOCcLAv39/R8MNPYAHwG\nAtEu/k4HPynhMXCbo6H6\n=ZP1p\n-----END PGP SIGNATURE-----\n","payload":"tree 6212c81847d915f6a02d719140d8fe3ac793f744\nparent 577ec03bf82fb52e7041fb6b684e694b1e53451a\nauthor Celia Chen <celia@openai.com> 1779989346 -0700\ncommitter GitHub <noreply@github.com> 1779989346 -0700\n\nchore: add GPT-5.5 to the Amazon Bedrock catalog (#24701)\n\n## Summary\n\nAmazon Bedrock should expose GPT-5.5 alongside GPT-5.4, and the Bedrock\nGPT entries should stay aligned with the canonical bundled OpenAI model\nmetadata instead of carrying a separate hand-written copy that can drift\nover time. This change will be merged when the model is online.\n\nThis change:\n\n- Adds the Bedrock Mantle model id for `openai.gpt-5.5`.\n- Builds the Bedrock GPT-5.5 and GPT-5.4 catalog entries from the\nbundled OpenAI model catalog, then overrides the Bedrock-facing slug,\nexplicit priority, and Bedrock-specific context windows.\n- Hardcodes both `context_window` and `max_context_window` to `272000`\nfor Bedrock GPT-5.5 and GPT-5.4.\n- Keeps `openai.gpt-5.5` as the default Bedrock model ahead of\n`openai.gpt-5.4` and the Bedrock OSS models.","verified_at":"2026-05-28T17:29:07Z"}},"url":"https://api.github.com/repos/openai/codex/commits/489bf386580409891b1792331eff4dd92afd4404","html_url":"https://github.com/openai/codex/commit/489bf386580409891b1792331eff4dd92afd4404","comments_url":"https://api.github.com/repos/openai/codex/commits/489bf386580409891b1792331eff4dd92afd4404/comments","author":{"login":"celia-oai","id":209693228,"node_id":"U_kgDODH-qLA","avatar_url":"https://avatars.githubusercontent.com/u/209693228?v=4","gravatar_id":"","url":"https://api.github.com/users/celia-oai","html_url":"https://github.com/celia-oai","followers_url":"https://api.github.com/users/celia-oai/followers","following_url":"https://api.github.com/users/celia-oai/following{/other_user}","gists_url":"https://api.github.com/users/celia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/celia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celia-oai/subscriptions","organizations_url":"https://api.github.com/users/celia-oai/orgs","repos_url":"https://api.github.com/users/celia-oai/repos","events_url":"https://api.github.com/users/celia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/celia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"577ec03bf82fb52e7041fb6b684e69