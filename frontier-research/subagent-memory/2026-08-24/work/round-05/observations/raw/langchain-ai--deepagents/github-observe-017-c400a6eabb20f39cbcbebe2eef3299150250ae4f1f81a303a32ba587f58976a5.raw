le\nprogress or success feedback. This surfaces explicit restarting and\ncompletion messages while preserving existing failure handling.\n\nMade by [Open SWE](https://openswe.vercel.app)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"7c82a9fe9483ea5089906662a7195edf499869a3","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/7c82a9fe9483ea5089906662a7195edf499869a3"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/c40bef9b2aaace3909593503b28e8b548bc20014","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKGgkCRC1aQ7uu5UhlAAARWoQAAHijQ+1hlxGiE7iCNcxIsqq\nO5oaA+LM5r7teifMUQsUYfEiVQYrgABdUSRFh9uk+02w88LzbJPX2RpPgpc3Cwm7\nvBKPt8GJyxb7mwyoF03KMqCVvykxb/B4g5Nj3EuarOnGTrSkh/Q+5OVX3898eeeG\ngvjzyQ5L+E08tdjRYIDjztDnBFRtlEPZgF4qlTrUg5Q6UXUwyHVQIcYXvX3YG4T3\nHaQT+g2QHmlTJA2tbUxzub179r44k/wsk2+lJfK1AKD4qkwzAQtMxhpcKqScXiYR\nzMrGq2qPjCVQzhOKYOzLxNwx7Jly6NXLxqmSFwCKmTPsW/iOeT4xD9YfFCEVM9Ue\nhN7DJk19uEqjx5ZseME+4HhzkYVoxbPOVS7IGOjYrwQd9Gw5jMYSCVwOW0tqhbf4\n4z4Q9lmWqkwW2V+cNgMCg0uDfEjxl7SHzkL62xUophoKI3rSXM5Lv5Q0Gd0n7YrY\n9TYbrrcWcsVosPXqdgelwKvk3DKhMSlsuOYFyIQ/b9ry98C7HpNVeCJ2xCFS3wGT\nAKH05dp9DB8AddXs83sMDaDSv+KgPDyAIywwPD6Q9tFmnlJdEmOP/SpIdrnZvFkV\nwWzdP6dBnNpkg2GuGsw8kqPj2n/T47CalAIMHK7sdujXlKa9zFkKAk0ZX/J/Wifn\nYJNVinY8PvwrMGzeevM5\n=oPnH\n-----END PGP SIGNATURE-----\n","payload":"tree 7c82a9fe9483ea5089906662a7195edf499869a3\nparent 12e00e1a78e2d6be106147a0aa95a518be66849f\nauthor Mason Daugherty <mason@langchain.dev> 1781032996 -0400\ncommitter GitHub <noreply@github.com> 1781032996 -0400\n\nfix(code): show `/restart` feedback (#3808)\n\n`/restart` previously echoed the command but did not add visible\nprogress or success feedback. This surfaces explicit restarting and\ncompletion messages while preserving existing failure handling.\n\nMade by [Open SWE](https://openswe.vercel.app)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-09T19:23:17Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/c40bef9b2aaace3909593503b28e8b548bc20014","html_url":"https://github.com/langchain-ai/deepagents/commit/c40bef9b2aaace3909593503b28e8b548bc20014","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/c40bef9b2aaace3909593503b28e8b548bc20014/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"12e00e1a78e2d6be106147a0aa95a518be66849f","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/12e00e1a78e2d6be106147a0aa95a518be66849f","html_url":"https://github.com/langchain-ai/deepagents/commit/12e00e1a78e2d6be106147a0aa95a518be66849f"}]},{"sha":"12e00e1a78e2d6be106147a0aa95a518be66849f","node_id":"C_kwDOPTymldoAKDEyZTAwZTFhNzhlMmQ2YmUxMDYxNDdhMGFhOTVhNTE4YmU2Njg0OWY","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-09T19:10:34Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-09T19:10:34Z"},"message":"fix(code): unblock `/remember` in server mode (#3812)\n\n`/remember` was wrongly blocked with \"Nothing to remember yet\" even\nafter a real conversation when running in server mode.\n\n`RemoteGraph.aget_state` returns messages as raw JSON dicts, so\n`_has_conversation_messages`' `isinstance(m, HumanMessage)` check never\nmatched. This now detects both object and dict (`{\"type\": \"human\"}`)\nforms, and routes through `_get_thread_state_values` so the thread is\nregistered (`aensure_thread`) before reading state.\n\nMade by [Open SWE](https://openswe.vercel.app)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"1371220d3c519d88501afdc745e36945d0eca5f8","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/1371220d3c519d88501afdc745e36945d0eca5f8"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/12e00e1a78e2d6be106147a0aa95a518be66849f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKGUqCRC1aQ7uu5UhlAAAg5AQAF4aDnkiAzx3m66UiZVOHkjh\n0nqUWksZWmwDdskNrx5/KFdzH9vOuH6zz4W7SGJ8Nsn2DfzsM7m6mIOQKr4Irp0T\nvvXT2wBADkfvt1sWGRzfBdGLdtAy2rY6JSa9nG4yvfpO81WZJ50ju4WT2h91fZlh\nkyk4Y5BxVAU+RBZ9P0R+0gc3Nd+TyFKR43LdFH6s451jVi2cg9fJ87HJsdPfrzvN\n9xE1pAUTx+KnCZ+UL3OV3zEmZbpUvwz+9mqIkP4MM14XpbqXNYof826c0VzcXoG+\n8B34NYaU2wlbkq8tlBOVHbyfHAlvAV8uTZuHLDookRyMiNfjdbrsIeeAV3FEAuzO\n4I43nekKOWME6d+z948DBB84KCT+R6KheEqxGBXG9Q5OeHRPVzpKclzuLlwIgiyf\n50zt5SCddiyNJYwBwAAhv65Viilih4JLmretTEtl80SSdWQ0r5yJERcKB2AYc9PT\nAV0rn92Fe/dAZctYRk0xm59pjAQL3abuz1Q3kJS0x9iNft01lHgxOJ/5ypaq7d4i\n4VRlX8gfcvFKLXbIXYL9D+Bn6cVRCUq7hb+ITVSzK5wOGYQaGF0vsapBDpB3Arhb\npJ8JMuC5wCGl0kH6quDKLEkvxkEt5N4L6f/f7Ek6vEYPb+Nb7IX9X2qK3xKWSBz7\nzbFuV+ZiDhslLjPD1r/6\n=w7Rn\n-----END PGP SIGNATURE-----\n","payload":"tree 1371220d3c519d88501afdc745e36945d0eca5f8\nparent 64505b848868b80213b6da87113cd63890c3d520\nauthor Mason Daugherty <mason@langchain.dev> 1781032234 -0400\ncommitter GitHub <noreply@github.com> 1781032234 -0400\n\nfix(code): unblock `/remember` in server mode (#3812)\n\n`/remember` was wrongly blocked with \"Nothing to remember yet\" even\nafter a real conversation when running in server mode.\n\n`RemoteGraph.aget_state` returns messages as raw JSON dicts, so\n`_has_conversation_messages`' `isinstance(m, HumanMessage)` check never\nmatched. This now detects both object and dict (`{\"type\": \"human\"}`)\nforms, and routes through `_get_thread_state_values` so the thread is\nregistered (`aensure_thread`) before reading state.\n\nMade by [Open SWE](https://openswe.vercel.app)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-09T19:10:35Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/12e00e1a78e2d6be106147a0aa95a518be66849f","html_url":"https://github.com/langchain-ai/deepagents/commit/12e00e1a78e2d6be106147a0aa95a518be66849f","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/12e00e1a78e2d6be106147a0aa95a518be66849f/