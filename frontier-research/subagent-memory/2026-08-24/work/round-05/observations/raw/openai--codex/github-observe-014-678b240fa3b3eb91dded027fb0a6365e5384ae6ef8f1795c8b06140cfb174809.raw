[{"sha":"1ae2b9880e8af5d465161a58f24a127aaa4b0040","node_id":"C_kwDOOYsS4doAKDFhZTJiOTg4MGU4YWY1ZDQ2NTE2MWE1OGYyNGExMjdhYWE0YjAwNDA","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-07-29T15:35:22Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-29T15:41:39Z"},"message":"Avoid cloning rollout history when truncating forks (#35982)\n\n## What changed\n\n- Consume owned rollout vectors when truncating fork and subagent history, reusing their allocations instead of copying slices.\n- Project ephemeral fork responses and token-usage ownership before moving the source history into the new thread.\n- Preserve canonical `beforeTurnId` validation for rolled-back and synthetic legacy turns.\n\n## Testing\n\n- Add truncation tests covering rolled-back and synthetic legacy `beforeTurnId` values.\n\nGitOrigin-RevId: 5785d004b74d7e057b82379a172676b023bcfb4f","tree":{"sha":"dfab3d0a13cd687cbd688a07464902dd23a93750","url":"https://api.github.com/repos/openai/codex/git/trees/dfab3d0a13cd687cbd688a07464902dd23a93750"},"url":"https://api.github.com/repos/openai/codex/git/commits/1ae2b9880e8af5d465161a58f24a127aaa4b0040","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/1ae2b9880e8af5d465161a58f24a127aaa4b0040","html_url":"https://github.com/openai/codex/commit/1ae2b9880e8af5d465161a58f24a127aaa4b0040","comments_url":"https://api.github.com/repos/openai/codex/commits/1ae2b9880e8af5d465161a58f24a127aaa4b0040/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"3725f02cf38d856bc82bb46dd68ab61bb96ec6fc","url":"https://api.github.com/repos/openai/codex/commits/3725f02cf38d856bc82bb46dd68ab61bb96ec6fc","html_url":"https://github.com/openai/codex/commit/3725f02cf38d856bc82bb46dd68ab61bb96ec6fc"}]},{"sha":"3725f02cf38d856bc82bb46dd68ab61bb96ec6fc","node_id":"C_kwDOOYsS4doAKDM3MjVmMDJjZjM4ZDg1NmJjODJiYjQ2ZGQ2OGFiNjFiYjk2ZWM2ZmM","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-07-29T13:46:52Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-29T14:01:31Z"},"message":"Fix TUI layout for halfwidth Japanese sound marks (#35962)\n\n## What changed\n\n- Use Ratatui-compatible terminal widths throughout TUI layout, preserving\n  full-width counters for long lines.\n- Wrap and truncate on grapheme boundaries so halfwidth kana sound marks and\n  emoji sequences stay intact.\n- Apply the corrected sizing to text input, selection popups, status and\n  history cells, Markdown, hyperlinks, and scrollable cloud diffs.\n\n## Testing\n\n- Add focused unit and snapshot coverage for wrapping, truncation, cursor and\n  mask alignment, popup columns, status output, session headers, Markdown\n  tables, process output, and scrollable diffs.\n\nGitOrigin-RevId: 294ec0bcff743c6bb16d55ec26308524ce741879","tree":{"sha":"8a60cd11927a6dbcc8da2a74f60d583a97befa13","url":"https://api.github.com/repos/openai/codex/git/trees/8a60cd11927a6dbcc8da2a74f60d583a97befa13"},"url":"https://api.github.com/repos/openai/codex/git/commits/3725f02cf38d856bc82bb46dd68ab61bb96ec6fc","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/3725f02cf38d856bc82bb46dd68ab61bb96ec6fc","html_url":"https://github.com/openai/codex/commit/3725f02cf38d856bc82bb46dd68ab61bb96ec6fc","comments_url":"https://api.github.com/repos/openai/codex/commits/3725f02cf38d856bc82bb46dd68ab61bb96ec6fc/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"cef3910ea4d09617e50a94e40bf25a6cb2e4e765","url":"https://api.github.com/repos/openai/codex/commits/cef3910ea4d09617e50a94e40bf25a6cb2e4e765","html_url":"https://github.com/openai/codex/commit/cef3910ea4d09617e50a94e40bf25a6cb2e4e765"}]},{"sha":"cef3910ea4d09617e50a94e40bf25a6cb2e4e765","node_id":"C_kwDOOYsS4doAKGNlZjM5MTBlYTRkMDk2MTdlNTBhOTRlNDBiZjI1YTZjYjJlNGU3NjU","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-07-29T13:46:52Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-29T13:57:46Z"},"message":"Preserve hyperlink cell widths during terminal diffing (#35960)\n\n## What changed\n\n- Mark OSC 8 hyperlink cells with their visible width so Ratatui's buffer diff handles wide and halfwidth characters correctly.\n- Use Ratatui's diff iterator while explicitly clearing styled trailing cells when a forced-width cell replaces a wider cell.\n\n## Testing\n\n- Add coverage for forced-width hyperlink rendering, always-update cells, and styled trailing-cell cleanup.\n\nGitOrigin-RevId: 041128f43beb1e09d40179a3ac16dca1fbdcbc44","tree":{"sha":"2abc5ab76ed68122bb758de5ad91edd9ed63c2c1","url":"https://api.github.com/repos/openai/codex/git/trees/2abc5ab76ed68122bb758de5ad91edd9ed63c2c1"},"url":"https://api.github.com/repos/openai/codex/git/commits/cef3910ea4d09617e50a94e40bf25a6cb2e4e765","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/cef3910ea4d09617e50a94e40bf25a6cb2e4e765","html_url":"https://github.com/openai/codex/commit/cef3910ea4d09617e50a94e40bf25a6cb2e4e765","comments_url":"https://api.github.com/repos/openai/codex/commits/cef3910ea4d09617e50a94e40bf25a6cb2e4e765/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"00cb5c465b1ea9efaf9018f853482c42f6948fe5","url":"https://api.github.com/repos/openai/codex/commits/00cb5c465b1ea9efaf9018f853482c42f6948fe5","html_url":"https://github.com/openai/codex/commit/00cb5c465b1ea9efaf9018f853482c42f6948fe5"}]},{"sha":"00cb5c465b1ea9efaf9018f853482c42f6948fe5","node_id":"C_kwDOOYsS4doAKDAwY2I1YzQ2NWIxZWE5ZWZhZjkwMThmODUzNDgyYzQyZjY5NDhmZTU","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-07-29T13:46:51Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-29T13:53:15Z"},"message":"Upgrade Ratatui to 0.30.2 (#35959)\n\n## What changed\n\n- Upgrade `ratatui`, `ratatui-macros`, `crossterm`, and `ansi-to-tui`, and adapt the TUI to their updated rendering, backend, color-conversion, and cell APIs.\n- Use Ratatui's cell-width and continuation-cell metadata when mapping OSC 8 hyperlinks so links remain aligned across wrapped wide glyphs and halfwidth characters with dakuten.\n- Preserve explicit hyperlinks in the sign-in success screen and empty MCP state without embedding escape sequences in the text passed to Ratatui.\n\n## Testing\n\n- Add regression coverage for hyperlink placement across wide glyphs and halfwidth dakuten, hyperlink preservation in onboarding and MCP output, and display-width handling.\n\nGitOrigin-RevId: 8460873e5a266923acd0417bc46264845eab0134","tree":{"sha":"e424ba83365563fb4b0ce1b0bafac3b7732c2c5c","url":"https://api.github.com/repos/openai/codex/git/trees/e424ba83365563fb4b0ce1b0bafac3b7732c2c5c"},"url":"https://api.github.com/repos/openai/codex/git/commits/00cb5c465b1ea9efaf9018f853482c42f6948fe5","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/00cb5c465b1ea9efaf9018f853482c42f6948fe5","html_url":"https://github.com/openai/codex/commit/00cb5c465b1ea9efaf9018f853482c42f6948fe5","comments_url":"https://api.github.com/repos/openai/codex/commits/00cb5c465b1ea9efaf9018f853482c42f6948fe5/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"e1895710addb863acf335ef18b4c43b128439567","url":"https://api.github.com/repos/openai/codex/commits/e1895710addb863acf335ef18b4c43b128439567","html_url":"https://github.com/openai/codex/commit/e1895710addb863acf335ef18b4c43b128439567"}]},{"sha":"e1895710addb863acf335ef18b4c43b128439567","node_id":"C_kwDOOYsS4doAKGUxODk1NzEwYWRkYjg2M2FjZjMzNWVmMThiNGM0M2IxMjg0Mzk1Njc","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-29T13:40:54Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-29T13:45:58Z"},"message":"Fix TUI input queue handling during MCP startup (#35957)\n\n## Why\n\nPending MCP server startup can outlive an agent turn. Treating its shared\nrunning indicator as an active user turn prevents queued follow-ups and slash\ncommands from advancing after the turn completes.\n\n## What changed\n\n- Allow the input queue to drain while only MCP startup remains active.\n- Keep queued input blocked while a review, foreground shell command, or\n  compaction is pending or running.\n- Resume queue draining after session-selection flows close.\n\n## Testing\n\nAdd TUI tests covering queued follow-ups, slash commands, reviews, shell\ncommands, and compaction while MCP startup is pending.\n\nGitOrigin-RevId: f5684f61c32e3728ff71cf222f0486df637dc3a5","tree":{"sha":"ffb8aa475a95983908b9e44e8459351e796689d5","url":"https://api.github.com/repos/openai/codex/git/trees/ffb8aa475a95983908b9e44e8459351e796689d5"},"url":"https://api.github.com/repos/openai/codex/git/commits/e1895710addb863acf335ef18b4c43b128439567","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/e1895710addb863acf335ef18b4c43b128439567","html_url":"https://github.com/openai/codex/commit/e1895710addb863acf335ef18b4c43b128439567","comments_url":"https://api.github.com/repos/openai/codex/commits/e1895710addb863acf335ef18b4c43b128439567/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"9a6668f674d74b35418fa534b3b6285a315d0765","url":"https://api.github.com/repos/openai/codex/commits/9a6668f674d74b35418fa534b3b6285a315d0765","html_url":"https://github.com/openai/codex/commit/9a6668f674d74b35418fa534b3b6285a315d0765"}]},{"sha":"9a6668f674d74b35418fa534b3b6285a315d0765","node_id":"C_kwDOOYsS4doAKDlhNjY2OGY2NzRkNzRiMzU0MThmYTUzNGIzYjYyODVhMzE1ZDA3NjU","commit":{"author":{"name":"Tamir Duberstein","email":"tamird@openai.com","date":"2026-07-29T12:07:49Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-29T12:13:14Z"},"message":"Report direct input capability for listed subagents (#35944)\n\n## What changed\n\n- Enrich `thread/list` and `thread/search` results for loaded spawned threads with live status and `canAcceptDirectInput`.\n- Report `true` for V1 agents that accept direct input and `false` for parent-owned V2 agents, while leaving the capability `null` when it is unavailable or inapplicable.\n- Distinguish untracked threads from threads known to have shut down when resolving loaded status.\n\n## Testing\n\n- Cover list, search, ancestor-filtered list, and rejected V2 direct-input behavior.\n\nGitOrigin-RevId: d5faf2fc379a236661ff9167391541473ce5c1eb","tree":{"sha":"e052ebec5045c7ab36b06e4d3c50c66e8450a456","url":"https://api.github.com/repos/openai/codex/git/trees/e052ebec5045c7ab36b06e4d3c50c66e8450a456"},"url":"https://api.github.com/repos/openai/codex/git/commits/9a6668f674d74b35418fa534b3b6285a315d0765","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/9a6668f674d74b35418fa534b3b6285a315d0765","html_url":"https://github.com/openai/codex/commit/9a6668f674d74b35418fa534b3b6285a315d0765","comments_url":"https://api.github.com/repos/openai/codex/commits/9a6668f674d74b35418fa534b3b6285a315d0765/comments","author":{"login":"tamird","id":1535036,"node_id":"MDQ6VXNlcjE1MzUwMzY=","avatar_url":"https://avatars.githubusercontent.com/u/1535036?v=4","gravatar_id":"","url":"https://api.github.com/users/tamird","html_url":"https://github.com/tamird","followers_url":"https://api.github.com/users/tamird/followers","following_url":"https://api.github.com/users/tamird/following{/other_user}","gists_url":"https://api.github.com/users/tamird/gists{/gist_id}","starred_url":"https://api.github.com/users/tamird/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tamird/subscriptions","organizations_url":"https://api.github.com/users/tamird/orgs","repos_url":"https://api.github.com/users/tamird/repos","events_url":"https://api.github.com/users/tamird/events{/privacy}","received_events_url":"https://api.github.com/users/tamird/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a4d2f3102249a94835e96910a3649a830182813e","url":"https://api.github.com/repos/openai/codex/commits/a4d2f3102249a94835e96910a3649a830182813e","html_url":"https://github.com/openai/codex/commit/a4d2f3102249a94835e96910a3649a830182813e"}]},{"sha":"a4d2f3102249a94835e96910a3649a830182813e","node_id":"C_kwDOOYsS4doAKGE0ZDJmMzEwMjI0OWE5NDgzNWU5NjkxMGEzNjQ5YTgzMDE4MjgxM2U","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-29T11:56:35Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-29T12:01:38Z"},"message":"Update tests for current tool call and app-server event types (#35942)\n\n## What changed\n\n- Set `encrypted_function_args` when constructing the router test's local tool call.\n- Box the TUI test's app-server request payload to match `AppServerEvent::ServerRequest`.\n\nGitOrigin-RevId: 45195f362bc912d202d95ea67271bcb102bf1e2a","tree":{"sha":"df47a9fef4038a9579e95e5a6f59653c5caea0b5","url":"https://api.github.com/repos/openai/codex/git/trees/df47a9fef4038a9579e95e5a6f59653c5caea0b5"},"url":"https://api.github.com/repos/openai/codex/git/commits/a4d2f3102249a94835e96910a3649a830182813e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a4d2f3102249a94835e96910a3649a830182813e","html_url":"https://github.com/openai/codex/commit/a4d2f3102249a94835e96910a3649a830182813e","comments_url":"https://api.github.com/repos/openai/codex/commits/a4d2f3102249a94835e96910a3649a830182813e/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"ddf33ea802f787f800e2a3691cc6e7379e6bb695","url":"https://api.github.com/repos/openai/codex/commits/ddf33ea802f787f800e2a3691cc6e7379e6bb695","html_url":"https://github.com/openai/codex/commit/ddf33ea802f787f800e2a3691cc6e7379e6bb695"}]},{"sha":"ddf33ea802f787f800e2a3691cc6e7379e6bb695","node_id":"C_kwDOOYsS4doAKGRkZjMzZWE4MDJmNzg3ZjgwMGUyYTM2OTFjYzZlNzM3OWU2YmI2OTU","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-29T11:44:59Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-29T11:49:47Z"},"message":"Bound MCP namespace descriptions (#35941)\n\n## What changed\n\n- Limit model-facing MCP namespace descriptions to 1,000 bytes without splitting UTF-8 characters or mutating the stored server metadata.\n- Cap the aggregate source-description list in `tool_search` at 4 KiB while retaining source names and discovery instructions.\n- Cover direct and deferred MCP tool exposure, including multibyte descriptions and tool visibility.\n\nGitOrigin-RevId: 92736ec39475a1d6b3b03f5e3063e28225d8a5f6","tree":{"sha":"4c85291c6de0ad7cd33d364b1eb034dabe6adfd9","url":"https://api.github.com/repos/openai/codex/git/trees/4c85291c6de0ad7cd33d364b1eb034dabe6adfd9"},"url":"https://api.github.com/repos/openai/codex/git/commits/ddf33ea802f787f800e2a3691cc6e7379e6bb695","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/ddf33ea802f787f800e2a3691cc6e7379e6bb695","html_url":"https://github.com/openai/codex/commit/ddf33ea802f787f800e2a3691cc6e7379e6bb695","comments_url":"https://api.github.com/repos/openai/codex/commits/ddf33ea802f787f800e2a3691cc6e7379e6bb695/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fbf666fa9875d0157816be3b7a20c63161d77ec5","url":"https://api.github.com/repos/openai/codex/commits/fbf666fa9875d0157816be3b7a20c63161d77ec5","html_url":"https://github.com/openai/codex/commit/fbf666fa9875d0157816be3b7a20c63161d77ec5"}]},{"sha":"fbf666fa9875d0157816be3b7a20c63161d77ec5","node_id":"C_kwDOOYsS4doAKGZiZjY2NmZhOTg3NWQwMTU3ODE2YmUzYjdhMjBjNjMxNjFkNzdlYzU","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-29T11:08:49Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-29T11:14:16Z"},"message":"Let unrelated tools run while MCP servers start (#35937)\n\n## Why\n\nCached MCP definitions can make a tool callable before its server has finished\nstarting. Waiting for that server while holding the tool execution gate blocks\nunrelated calls in the same response.\n\n## What changed\n\n- Expose the owning MCP server through tool runtime metadata, including tools\n  with exposure overrides.\n- Refresh MCP state and wait for that specific server before entering the\n  parallel execution gate.\n\n## Testing\n\nExtend the cached MCP tool regression test to verify that an unrelated plan\nupdate completes while MCP startup remains pending.\n\nGitOrigin-RevId: 884d154bc403dfc1d347d265da3d6a887948e7b6","tree":{"sha":"3bbc303238b02073972da89f8dc68a0ae8395710","url":"https://api.github.com/repos/openai/codex/git/trees/3bbc303238b02073972da89f8dc68a0ae8395710"},"url":"https://api.github.com/repos/openai/codex/git/commits/fbf666fa9875d0157816be3b7a20c63161d77ec5","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fbf666fa9875d0157816be3b7a20c63161d77ec5","html_url":"https://github.com/openai/codex/commit/fbf666fa9875d0157816be3b7a20c63161d77ec5","comments_url":"https://api.github.com/repos/openai/codex/commits/fbf666fa9875d0157816be3b7a20c63161d77ec5/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fe01054a28fa4bd04716d9ceadb410f2443a50ce","url":"https://api.github.com/repos/openai/codex/commits/fe01054a28fa4bd04716d9ceadb410f2443a50ce","html_url":"https://github.com/openai/codex/commit/fe01054a28fa4bd04716d9ceadb410f2443a50ce"}]},{"sha":"fe01054a28fa4bd04716d9ceadb410f2443a50ce","node_id":"C_kwDOOYsS4doAKGZlMDEwNTRhMjhmYTRiZDA0NzE2ZDljZWFkYjQxMGYyNDQzYTUwY2U","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-07-29T05:30:53Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-29T05:41:37Z"},"message":"Inherit ready step environments when spawning agents (#35895)\n\n## Why\n\nWith deferred execution, an environment can become ready before a later step\nspawns a sub-agent. The child must inherit the environment selections available\nto that step.\n\n## What changed\n\n- Use the current step context's environment selections when spawning agents in\n  both multi-agent implementations.\n- Add coverage that waits for a remote environment to become ready, spawns an\n  agent, and verifies that the child receives both remote and local selections.\n\nGitOrigin-RevId: 97c37d541342bbefc9217bf341a19ebdfead2c76","tree":{"sha":"b5caf956f90cc41cdb56d93be4a541c3a7cf02f0","url":"https://api.github.com/repos/openai/codex/git/trees/b5caf956f90cc41cdb56d93be4a541c3a7cf02f0"},"url":"https://api.github.com/repos/openai/codex/git/commits/fe01054a28fa4bd04716d9ceadb410f2443a50ce","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fe01054a28fa4bd04716d9ceadb410f2443a50ce","html_url":"https://github.com/openai/codex/commit/fe01054a28fa4bd04716d9ceadb410f2443a50ce","comments_url":"https://api.github.com/repos/openai/codex/commits/fe01054a28fa4bd04716d9ceadb410f2443a50ce/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"d06c7ac055920c7cb140c25ebda3f3db20197b45","url":"https://api.github.com/repos/openai/codex/commits/d06c7ac055920c7cb140c25ebda3f3db20197b45","html_url":"https://github.com/openai/codex/commit/d06c7ac055920c7cb140c25ebda3f3db20197b45"}]},{"sha":"d06c7ac055920c7cb140c25ebda3f3db20197b45","node_id":"C_kwDOOYsS4doAKGQwNmM3YWMwNTU5MjBjN2NiMTQwYzI1ZWJkYTNmM2RiMjAxOTdiNDU","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-07-29T03:44:51Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-29T03:54:05Z"},"message":"Clean up side conversations in the background (#35887)\n\n## Why\n\nSwitching away from a side conversation should not wait for its interrupt and\nunsubscribe requests to finish.\n\n## What changed\n\n- Remove a side conversation from local TUI state immediately when switching\n  threads, then interrupt and unsubscribe it in a background task.\n- Retry interruption with the active turn ID when the original turn races with\n  cleanup.\n- Ignore late notifications and reject server requests for abandoned side\n  conversations.\n\n## Testing\n\n- Added coverage that background cleanup removes local state and ignores late\n  events and approval requests.\n\nGitOrigin-RevId: 7a1d1c34f16ab023d1d1e235451b55404731190c","tree":{"sha":"aeba7e81c2009f6502f77879e1c0e2a8030d4eae","url":"https://api.github.com/repos/openai/codex/git/trees/aeba7e81c2009f6502f77879e1c0e2a8030d4eae"},"url":"https://api.github.com/repos/openai/codex/git/commits/d06c7ac055920c7cb140c25ebda3f3db20197b45","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/d06c7ac055920c7cb140c25ebda3f3db20197b45","html_url":"https://github.com/openai/codex/commit/d06c7ac055920c7cb140c25ebda3f3db20197b45","comments_url":"https://api.github.com/repos/openai/codex/commits/d06c7ac055920c7cb140c25ebda3f3db20197b45/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"b96ebfb31286187e950a4e2a60da941b5fed2afa","url":"https://api.github.com/repos/openai/codex/commits/b96ebfb31286187e950a4e2a60da941b5fed2afa","html_url":"https://github.com/openai/codex/commit/b96ebfb31286187e950a4e2a60da941b5fed2afa"}]},{"sha":"b96ebfb31286187e950a4e2a60da941b5fed2afa","node_id":"C_kwDOOYsS4doAKGI5NmViZmIzMTI4NjE4N2U5NTBhNGUyYTYwZGE5NDFiNWZlZDJhZmE","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-07-29T03:43:20Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-29T03:50:00Z"},"message":"Show blocked goals as stalled in the TUI (#35886)\n\n## What changed\n\n- Display `Blocked` goal statuses as “stalled” in the goal menu and goal status footer.\n- Update the goal menu snapshot and footer formatting test expectations.\n\nGitOrigin-RevId: f3d8212d939f0d76354048231346328972226274","tree":{"sha":"4b48eaa03b1031b2f519e05c4cbfe72fc5a1c85f","url":"https://api.github.com/repos/openai/codex/git/trees/4b48eaa03b1031b2f519e05c4cbfe72fc5a1c85f"},"url":"https://api.github.com/repos/openai/codex/git/commits/b96ebfb31286187e950a4e2a60da941b5fed2afa","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/b96ebfb31286187e950a4e2a60da941b5fed2afa","html_url":"https://github.com/openai/codex/commit/b96ebfb31286187e950a4e2a60da941b5fed2afa","comments_url":"https://api.github.com/repos/openai/codex/commits/b96ebfb31286187e950a4e2a60da941b5fed2afa/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"250de82bfb51a210325e88bfe1f7c30b0fa514f0","url":"https://api.github.com/repos/openai/codex/commits/250de82bfb51a210325e88bfe1f7c30b0fa514f0","html_url":"https://github.com/openai/codex/commit/250de82bfb51a210325e88bfe1f7c30b0fa514f0"}]},{"sha":"250de82bfb51a210325e88bfe1f7c30b0fa514f0","node_id":"C_kwDOOYsS4doAKDI1MGRlODJiZmI1MWEyMTAzMjVlODhiZmUxZjdjMzBiMGZhNTE0ZjA","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-07-29T03:06:36Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-29T03:11:28Z"},"message":"Use step environments for MCP file uploads (#35878)\n\n## Why\n\nAn MCP tool call can run after its selected environment becomes ready, while the\nturn context still contains the earlier starting-state snapshot. File argument\nrewriting must use the environment available to the current step so it can\nresolve and upload local files in that case.\n\n## What changed\n\n- Pass `StepContext` through MCP file argument rewriting.\n- Resolve the primary environment from the step snapshot while retaining\n  turn-scoped configuration and metadata.\n- Add coverage for an environment that transitions from starting to ready\n  during a turn.\n\nGitOrigin-RevId: 935bea18ee425aabeacf4505eaff90565f9751e9","tree":{"sha":"b7707e665959749c12c66d48314323395bdbb385","url":"https://api.github.com/repos/openai/codex/git/trees/b7707e665959749c12c66d48314323395bdbb385"},"url":"https://api.github.com/repos/openai/codex/git/commits/250de82bfb51a210325e88bfe1f7c30b0fa514f0","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/250de82bfb51a210325e88bfe1f7c30b0fa514f0","html_url":"https://github.com/openai/codex/commit/250de82bfb51a210325e88bfe1f7c30b0fa514f0","comments_url":"https://api.github.com/repos/openai/codex/commits/250de82bfb51a210325e88bfe1f7c30b0fa514f0/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"6c13b113a3d28b16ce6d00cdbd18ede5bbc1f283","url":"https://api.github.com/repos/openai/codex/commits/6c13b113a3d28b16ce6d00cdbd18ede5bbc1f283","html_url":"https://github.com/openai/codex/commit/6c13b113a3d28b16ce6d00cdbd18ede5bbc1f283"}]},{"sha":"6c13b113a3d28b16ce6d00cdbd18ede5bbc1f283","node_id":"C_kwDOOYsS4doAKDZjMTNiMTEzYTNkMjhiMTZjZTZkMDBjZGJkMThlZGU1YmJjMWYyODM","commit":{"author":{"name":"TAFOYA-OAI","email":"TAFOYA@openai.com","date":"2026-07-29T02:57:25Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-29T03:07:13Z"},"message":"Allow environment readiness updates in place (#35875)\n\n## What changed\n\n- Add `EnvironmentManager::publish_ready_info` to update the selected capability\n  roots for an existing environment without replacing it.\n- Store readiness as an atomically replaceable snapshot so repeated publications\n  expose the latest roots while deferred completion still controls connection\n  readiness.\n- Validate published roots and reject updates for missing environments.\n\n## Testing\n\n- Cover publication, replacement, repeated and invalid updates, and interaction\n  with deferred environment completion.\n\nGitOrigin-RevId: 1477f60e1319f840e6b33703ef2af052713779fd","tree":{"sha":"90a6fbb6c6f274768b8d2ae409f2f55f4e772384","url":"https://api.github.com/repos/openai/codex/git/trees/90a6fbb6c6f274768b8d2ae409f2f55f4e772384"},"url":"https://api.github.com/repos/openai/codex/git/commits/6c13b113a3d28b16ce6d00cdbd18ede5bbc1f283","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/6c13b113a3d28b16ce6d00cdbd18ede5bbc1f283","html_url":"https://github.com/openai/codex/commit/6c13b113a3d28b16ce6d00cdbd18ede5bbc1f283","comments_url":"https://api.github.com/repos/openai/codex/commits/6c13b113a3d28b16ce6d00cdbd18ede5bbc1f283/comments","author":{"login":"TAFOYA-OAI","id":295987026,"node_id":"U_kgDOEaRnUg","avatar_url":"https://avatars.githubusercontent.com/u/295987026?v=4","gravatar_id":"","url":"https://api.github.com/users/TAFOYA-OAI","html_url":"https://github.com/TAFOYA-OAI","followers_url":"https://api.github.com/users/TAFOYA-OAI/followers","following_url":"https://api.github.com/users/TAFOYA-OAI/following{/other_user}","gists_url":"https://api.github.com/users/TAFOYA-OAI/gists{/gist_id}","starred_url":"https://api.github.com/users/TAFOYA-OAI/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TAFOYA-OAI/subscriptions","organizations_url":"https://api.github.com/users/TAFOYA-OAI/orgs","repos_url":"https://api.github.com/users/TAFOYA-OAI/repos","events_url":"https://api.github.com/users/TAFOYA-OAI/events{/privacy}","received_events_url":"https://api.github.com/users/TAFOYA-OAI/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"0a6616f4cf30d94e3198b90e980f141d10e19f80","url":"https://api.github.com/repos/openai/codex/commits/0a6616f4cf30d94e3198b90e980f141d10e19f80","html_url":"https://github.com/openai/codex/commit/0a6616f4cf30d94e3198b90e980f141d10e19f80"}]},{"sha":"0a6616f4cf30d94e3198b90e980f141d10e19f80","node_id":"C_kwDOOYsS4doAKDBhNjYxNmY0Y2YzMGQ5NGUzMTk4YjkwZTk4MGYxNDFkMTBlMTlmODA","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-07-29T02:54:11Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-29T03:02:32Z"},"message":"Mark the primary environment in model context (#35874)\n\n## Why\n\nWhen a turn uses multiple environments, the environment context lists each one but did not identify which environment is primary.\n\n## What changed\n\n- Add a `primary` attribute to each environment in multi-environment model context.\n- Persist primary selection in world-state snapshots and emit updates when the primary environment changes.\n- Restate environments when transitioning between single- and multi-environment context, while preserving the existing single-environment format.\n\n## Testing\n\n- Cover primary-environment changes, single/multi-environment transitions, legacy snapshot compatibility, and deferred-executor promotion after environment startup.\n\nGitOrigin-RevId: 73a1d794a227edef6e9b7844e7f947b7f598dc80","tree":{"sha":"87519c482fca1ad2331e27128157a7a500d6c3e0","url":"https://api.github.com/repos/openai/codex/git/trees/87519c482fca1ad2331e27128157a7a500d6c3e0"},"url":"https://api.github.com/repos/openai/codex/git/commits/0a6616f4cf30d94e3198b90e980f141d10e19f80","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/0a6616f4cf30d94e3198b90e980f141d10e19f80","html_url":"https://github.com/openai/codex/commit/0a6616f4cf30d94e3198b90e980f141d10e19f80","comments_url":"https://api.github.com/repos/openai/codex/commits/0a6616f4cf30d94e3198b90e980f141d10e19f80/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"9f23e9779757b41ae38e3ff23a6d8b05513baf42","url":"https://api.github.com/repos/openai/codex/commits/9f23e9779757b41ae38e3ff23a6d8b05513baf42","html_url":"https://github.com/openai/codex/commit/9f23e9779757b41ae38e3ff23a6d8b05513baf42"}]},{"sha":"9f23e9779757b41ae38e3ff23a6d8b05513baf42","node_id":"C_kwDOOYsS4doAKDlmMjNlOTc3OTc1N2I0MWFlMzhlM2ZmMjNhNmQ4YjA1NTEzYmFmNDI","commit":{"author":{"name":"charlesgong-openai","email":"charlesgong@openai.com","date":"2026-07-29T02:40:36Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-29T02:45:55Z"},"message":"Include session titles in external agent import history (#35870)\n\n## What changed\n\n- Preserve the original title when importing an external-agent session and return it with successful session entries from `externalAgentConfig/import/readHistories`.\n- Add dedicated history-record success types so externally completed imports can optionally supply a session title without changing the live import result type.\n\n## Testing\n\n- Verify imported session titles are returned by the app server and persisted when session import ledger entries are created or refreshed.\n\nGitOrigin-RevId: e896688a5763c238f1e1dc8b4672a7aa7bc1ed4c","tree":{"sha":"01c28e849a30fe6c3fc9f15862de0ef9baaf8b1d","url":"https://api.github.com/repos/openai/codex/git/trees/01c28e849a30fe6c3fc9f15862de0ef9baaf8b1d"},"url":"https://api.github.com/repos/openai/codex/git/commits/9f23e9779757b41ae38e3ff23a6d8b05513baf42","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/9f23e9779757b41ae38e3ff23a6d8b05513baf42","html_url":"https://github.com/openai/codex/commit/9f23e9779757b41ae38e3ff23a6d8b05513baf42","comments_url":"https://api.github.com/repos/openai/codex/commits/9f23e9779757b41ae38e3ff23a6d8b05513baf42/comments","author":{"login":"charlesgong-openai","id":200841148,"node_id":"U_kgDOC_iXvA","avatar_url":"https://avatars.githubusercontent.com/u/200841148?v=4","gravatar_id":"","url":"https://api.github.com/users/charlesgong-openai","html_url":"https://github.com/charlesgong-openai","followers_url":"https://api.github.com/users/charlesgong-openai/followers","following_url":"https://api.github.com/users/charlesgong-openai/following{/other_user}","gists_url":"https://api.github.com/users/charlesgong-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/charlesgong-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charlesgong-openai/subscriptions","organizations_url":"https://api.github.com/users/charlesgong-openai/orgs","repos_url":"https://api.github.com/users/charlesgong-openai/repos","events_url":"https://api.github.com/users/charlesgong-openai/events{/privacy}","received_events_url":"https://api.github.com/users/charlesgong-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"28f3f1f9ef4e9578a5f023f6b6eba018914a5342","url":"https://api.github.com/repos/openai/codex/commits/28f3f1f9ef4e9578a5f023f6b6eba018914a5342","html_url":"https://github.com/openai/codex/commit/28f3f1f9ef4e9578a5f023f6b6eba018914a5342"}]},{"sha":"28f3f1f9ef4e9578a5f023f6b6eba018914a5342","node_id":"C_kwDOOYsS4doAKDI4ZjNmMWY5ZWY0ZTk1NzhhNWYwMjNmNmI2ZWJhMDE4OTE0YTUzNDI","commit":{"author":{"name":"Eric Ning","email":"ericning@openai.com","date":"2026-07-29T01:11:19Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-29T01:16:29Z"},"message":"Expose plugin installation timestamps in app-server summaries (#35859)\n\n## What changed\n\n- Add nullable `installedAt` metadata to `PluginSummary` and its generated schemas, expressed as a Unix timestamp in seconds.\n- Preserve the backend installation time for remote plugins across plugin list, installed, read, and share-list responses. Return `null` when the timestamp is unavailable, including for local or uninstalled plugins and older backend responses.\n\n## Testing\n\n- Cover timestamp conversion in the remote plugin list integration test and the field's serialization and backward-compatible default in protocol tests.\n\nGitOrigin-RevId: 8a1640320adb298874e1074e9891d1017ad06937","tree":{"sha":"883126865b7f3b85028dbdaf585204f25d57273d","url":"https://api.github.com/repos/openai/codex/git/trees/883126865b7f3b85028dbdaf585204f25d57273d"},"url":"https://api.github.com/repos/openai/codex/git/commits/28f3f1f9ef4e9578a5f023f6b6eba018914a5342","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/28f3f1f9ef4e9578a5f023f6b6eba018914a5342","html_url":"https://github.com/openai/codex/commit/28f3f1f9ef4e9578a5f023f6b6eba018914a5342","comments_url":"https://api.github.com/repos/openai/codex/commits/28f3f1f9ef4e9578a5f023f6b6eba018914a5342/comments","author":{"login":"ericning-o","id":182030612,"node_id":"U_kgDOCtmRFA","avatar_url":"https://avatars.githubusercontent.com/u/182030612?v=4","gravatar_id":"","url":"https://api.github.com/users/ericning-o","html_url":"https://github.com/ericning-o","followers_url":"https://api.github.com/users/ericning-o/followers","following_url":"https://api.github.com/users/ericning-o/following{/other_user}","gists_url":"https://api.github.com/users/ericning-o/gists{/gist_id}","starred_url":"https://api.github.com/users/ericning-o/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ericning-o/subscriptions","organizations_url":"https://api.github.com/users/ericning-o/orgs","repos_url":"https://api.github.com/users/ericning-o/repos","events_url":"https://api.github.com/users/ericning-o/events{/privacy}","received_events_url":"https://api.github.com/users/ericning-o/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"b9b7c21821025b0c3835e2ff703eba25e29bde4d","url":"https://api.github.com/repos/openai/codex/commits/b9b7c21821025b0c3835e2ff703eba25e29bde4d","html_url":"https://github.com/openai/codex/commit/b9b7c21821025b0c3835e2ff703eba25e29bde4d"}]},{"sha":"b9b7c21821025b0c3835e2ff703eba25e29bde4d","node_id":"C_kwDOOYsS4doAKGI5YjdjMjE4MjEwMjViMGMzODM1ZTJmZjcwM2ViYTI1ZTI5YmRlNGQ","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-07-29T00:55:22Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-29T01:00:12Z"},"message":"Add Bazel unit test targets for Rust binaries (#35857)\n\n## Why\n\n`codex_rust_crate` generated unit test targets for libraries but not for the\nbinary targets declared by a crate.\n\n## What changed\n\n- Generate a `<binary>-bin-unit-tests` target for every Rust binary.\n- Run binary unit tests through the repository-root wrapper so test arguments,\n  timeouts, sharding, retries, environment, data, and tags match library unit\n  tests.\n- Add `binary_test_target_compatible_with` for constraining generated binary\n  unit test targets to supported platforms.\n\nGitOrigin-RevId: 7f3c5bff0162c82d19eff80d5d668c9e91b2fe97","tree":{"sha":"80268bd1fc14266a9e5881256739f69db0ff91f4","url":"https://api.github.com/repos/openai/codex/git/trees/80268bd1fc14266a9e5881256739f69db0ff91f4"},"url":"https://api.github.com/repos/openai/codex/git/commits/b9b7c21821025b0c3835e2ff703eba25e29bde4d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/b9b7c21821025b0c3835e2ff703eba25e29bde4d","html_url":"https://github.com/openai/codex/commit/b9b7c21821025b0c3835e2ff703eba25e29bde4d","comments_url":"https://api.github.com/repos/openai/codex/commits/b9b7c21821025b0c3835e2ff703eba25e29bde4d/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fcd2273de7d1dc593a9696c935502851ca954d8a","url":"https://api.github.com/repos/openai/codex/commits/fcd2273de7d1dc593a9696c935502851ca954d8a","html_url":"https://github.com/openai/codex/commit/fcd2273de7d1dc593a9696c935502851ca954d8a"}]},{"sha":"fcd2273de7d1dc593a9696c935502851ca954d8a","node_id":"C_kwDOOYsS4doAKGZjZDIyNzNkZTdkMWRjNTkzYTk2OTZjOTM1NTAyODUxY2E5NTRkOGE","commit":{"author":{"name":"charlesgong-openai","email":"charlesgong@openai.com","date":"2026-07-29T00:46:01Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-29T00:51:17Z"},"message":"Resolve imported connectors by MCP server name (#35856)\n\n## Why\n\nImported session attribution can identify an MCP server by its configured name\ninstead of the UUID stored in the session manifest.\n\n## What changed\n\nMatch attributed MCP servers against normalized manifest names without regard to\ncase, while retaining UUID matching.\n\n## Testing\n\nAdd focused coverage for both name- and UUID-based attribution.\n\nGitOrigin-RevId: 827443f9e7f14028e17b5c5775ca372bfe2e217e","tree":{"sha":"1a95c43c50c85a635e29a83b3efcc233fe915143","url":"https://api.github.com/repos/openai/codex/git/trees/1a95c43c50c85a635e29a83b3efcc233fe915143"},"url":"https://api.github.com/repos/openai/codex/git/commits/fcd2273de7d1dc593a9696c935502851ca954d8a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fcd2273de7d1dc593a9696c935502851ca954d8a","html_url":"https://github.com/openai/codex/commit/fcd2273de7d1dc593a9696c935502851ca954d8a","comments_url":"https://api.github.com/repos/openai/codex/commits/fcd2273de7d1dc593a9696c935502851ca954d8a/comments","author":{"login":"charlesgong-openai","id":200841148,"node_id":"U_kgDOC_iXvA","avatar_url":"https://avatars.githubusercontent.com/u/200841148?v=4","gravatar_id":"","url":"https://api.github.com/users/charlesgong-openai","html_url":"https://github.com/charlesgong-openai","followers_url":"https://api.github.com/users/charlesgong-openai/followers","following_url":"https://api.github.com/users/charlesgong-openai/following{/other_user}","gists_url":"https://api.github.com/users/charlesgong-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/charlesgong-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charlesgong-openai/subscriptions","organizations_url":"https://api.github.com/users/charlesgong-openai/orgs","repos_url":"https://api.github.com/users/charlesgong-openai/repos","events_url":"https://api.github.com/users/charlesgong-openai/events{/privacy}","received_events_url":"https://api.github.com/users/charlesgong-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"07490c75234ed3c63291a8eb7629f04f647038fa","url":"https://api.github.com/repos/openai/codex/commits/07490c75234ed3c63291a8eb7629f04f647038fa","html_url":"https://github.com/openai/codex/commit/07490c75234ed3c63291a8eb7629f04f647038fa"}]},{"sha":"07490c75234ed3c63291a8eb7629f04f647038fa","node_id":"C_kwDOOYsS4doAKDA3NDkwYzc1MjM0ZWQzYzYzMjkxYThlYjc2MjlmMDRmNjQ3MDM4ZmE","commit":{"author":{"name":"joeytrasatti-openai","email":"joey.trasatti@openai.com","date":"2026-07-29T00:25:03Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-29T00:30:11Z"},"message":"Box app-server event payloads (#35854)\n\n## What changed\n\n- Store `ServerNotification` and `ServerRequest` payloads behind `Box` in\n  `AppServerEvent`, `InProcessServerEvent`, and TUI `ThreadBufferedEvent` values.\n- Update app-server delivery, TUI routing and replay, exec, onboarding, and tests\n  to borrow or consume the boxed payloads as appropriate.\n\nGitOrigin-RevId: 7d0dab9aba47487114128ce55c914af5bb46c5b5","tree":{"sha":"50f2f4c36b61aa549e14df75b73adf3634c40111","url":"https://api.github.com/repos/openai/codex/git/trees/50f2f4c36b61aa549e14df75b73adf3634c40111"},"url":"https://api.github.com/repos/openai/codex/git/commits/07490c75234ed3c63291a8eb7629f04f647038fa","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/07490c75234ed3c63291a8eb7629f04f647038fa","html_url":"https://github.com/openai/codex/commit/07490c75234ed3c63291a8eb7629f04f647038fa","comments_url":"https://api.github.com/repos/openai/codex/commits/07490c75234ed3c63291a8eb7629f04f647038fa/comments","author":{"login":"joeytrasatti-openai","id":187452053,"node_id":"U_kgDOCyxKlQ","avatar_url":"https://avatars.githubusercontent.com/u/187452053?v=4","gravatar_id":"","url":"https://api.github.com/users/joeytrasatti-openai","html_url":"https://github.com/joeytrasatti-openai","followers_url":"https://api.github.com/users/joeytrasatti-openai/followers","following_url":"https://api.github.com/users/joeytrasatti-openai/following{/other_user}","gists_url":"https://api.github.com/users/joeytrasatti-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/joeytrasatti-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/joeytrasatti-openai/subscriptions","organizations_url":"https://api.github.com/users/joeytrasatti-openai/orgs","repos_url":"https://api.github.com/users/joeytrasatti-openai/repos","events_url":"https://api.github.com/users/joeytrasatti-openai/events{/privacy}","received_events_url":"https://api.github.com/users/joeytrasatti-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"8707a35113501a9988f06162ca5c2b27d4f90a58","url":"https://api.github.com/repos/openai/codex/commits/8707a35113501a9988f06162ca5c2b27d4f90a58","html_url":"https://github.com/openai/codex/commit/8707a35113501a9988f06162ca5c2b27d4f90a58"}]},{"sha":"8707a35113501a9988f06162ca5c2b27d4f90a58","node_id":"C_kwDOOYsS4doAKDg3MDdhMzUxMTM1MDFhOTk4OGYwNjE2MmNhNWMyYjI3ZDRmOTBhNTg","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-07-29T00:01:19Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-29T00:13:06Z"},"message":"Normalize Windows namespace paths in path URIs (#35851)\n\n## What changed\n\n- Convert Windows device-namespace drive paths such as `\\\\?\\D:\\reports` and\n  `\\\\.\\D:\\reports` to canonical drive-based `file:` URIs.\n- Convert device-namespace UNC paths to canonical hosted `file:` URIs.\n- Preserve unsupported or ambiguous namespace paths as opaque path URIs instead\n  of interpreting them as filesystem paths.\n\n## Testing\n\nAdd coverage for namespace path conversion and joining, including malformed UNC\npaths, reserved device names, and volume identifiers.\n\nGitOrigin-RevId: 234f69bc2787e5d318bc0320b94e7392abfb5602","tree":{"sha":"5354b408798141ba0c49aa77157a5ae5dcd30071","url":"https://api.github.com/repos/openai/codex/git/trees/5354b408798141ba0c49aa77157a5ae5dcd30071"},"url":"https://api.github.com/repos/openai/codex/git/commits/8707a35113501a9988f06162ca5c2b27d4f90a58","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/8707a35113501a9988f06162ca5c2b27d4f90a58","html_url":"https://github.com/openai/codex/commit/8707a35113501a9988f06162ca5c2b27d4f90a58","comments_url":"https://api.github.com/repos/openai/codex/commits/8707a35113501a9988f06162ca5c2b27d4f90a58/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"101d6b8cb214ecc04d45c3bcd2ca380116d07193","url":"https://api.github.com/repos/openai/codex/commits/101d6b8cb214ecc04d45c3bcd2ca380116d07193","html_url":"https://github.com/openai/codex/commit/101d6b8cb214ecc04d45c3bcd2ca380116d07193"}]},{"sha":"101d6b8cb214ecc04d45c3bcd2ca380116d07193","node_id":"C_kwDOOYsS4doAKDEwMWQ2YjhjYjIxNGVjYzA0ZDQ1YzNiY2QyY2EzODAxMTZkMDcxOTM","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-07-29T00:01:10Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-29T00:09:15Z"},"message":"Preserve foreign paths in background terminal listings (#35850)\n\n## Why\n\nBackground terminal working directories can use a path convention from a\ndifferent platform than the app-server host. Converting them to host-native\nabsolute paths can reject otherwise valid terminal entries and fail the list\nrequest.\n\n## What changed\n\n- Represent `ThreadBackgroundTerminal.cwd` with `LegacyAppPathString` at the\n  protocol boundary.\n- Convert terminal `PathUri` values directly to their inferred native path\n  strings instead of validating them against the host platform.\n\n## Testing\n\nAdd protocol round-trip coverage for POSIX, Windows drive, and Windows UNC\nworking directories.\n\nGitOrigin-RevId: d766d54bdc191e75955fb419bec6e60c65f52298","tree":{"sha":"177c533a84cf0178662c8962e504739a818fb043","url":"https://api.github.com/repos/openai/codex/git/trees/177c533a84cf0178662c8962e504739a818fb043"},"url":"https://api.github.com/repos/openai/codex/git/commits/101d6b8cb214ecc04d45c3bcd2ca380116d07193","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/101d6b8cb214ecc04d45c3bcd2ca380116d07193","html_url":"https://github.com/openai/codex/commit/101d6b8cb214ecc04d45c3bcd2ca380116d07193","comments_url":"https://api.github.com/repos/openai/codex/commits/101d6b8cb214ecc04d45c3bcd2ca380116d07193/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"03edf16f0bce2c454fc9a8ddb382e9c23c114f7f","url":"https://api.github.com/repos/openai/codex/commits/03edf16f0bce2c454fc9a8ddb382e9c23c114f7f","html_url":"https://github.com/openai/codex/commit/03edf16f0bce2c454fc9a8ddb382e9c23c114f7f"}]},{"sha":"03edf16f0bce2c454fc9a8ddb382e9c23c114f7f","node_id":"C_kwDOOYsS4doAKDAzZWRmMTZmMGJjZTJjNDU0ZmM5YThkZGIzODJlOWMyM2MxMTRmN2Y","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-28T23:44:41Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T23:49:37Z"},"message":"Support plaintext collaboration tool messages (#35845)\n\n## What changed\n\n- Preserve `encrypted_function_args` on function calls so an empty list can mark plaintext collaboration arguments across request replay.\n- Deliver `spawn_agent`, `send_message`, and `followup_task` payloads as structured plaintext agent messages when that marker is present; retain encrypted delivery otherwise.\n- Redact plaintext collaboration arguments from tool and communication logs, and omit the metadata when sending requests to non-OpenAI providers.\n\n## Testing\n\n- Cover serialization of empty encrypted-argument metadata and plaintext versus encrypted subagent message delivery.\n- Verify plaintext tool arguments are redacted and provider-specific metadata is removed from non-OpenAI requests.\n\nGitOrigin-RevId: 64db98ff0b61a3af2f04ed609292363f2e2362a8","tree":{"sha":"f326b109c2704a81fb07544fa91e15cf417e34be","url":"https://api.github.com/repos/openai/codex/git/trees/f326b109c2704a81fb07544fa91e15cf417e34be"},"url":"https://api.github.com/repos/openai/codex/git/commits/03edf16f0bce2c454fc9a8ddb382e9c23c114f7f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/03edf16f0bce2c454fc9a8ddb382e9c23c114f7f","html_url":"https://github.com/openai/codex/commit/03edf16f0bce2c454fc9a8ddb382e9c23c114f7f","comments_url":"https://api.github.com/repos/openai/codex/commits/03edf16f0bce2c454fc9a8ddb382e9c23c114f7f/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"166658a34a0ef2ad02c30ad272fa40018e787a33","url":"https://api.github.com/repos/openai/codex/commits/166658a34a0ef2ad02c30ad272fa40018e787a33","html_url":"https://github.com/openai/codex/commit/166658a34a0ef2ad02c30ad272fa40018e787a33"}]},{"sha":"166658a34a0ef2ad02c30ad272fa40018e787a33","node_id":"C_kwDOOYsS4doAKDE2NjY1OGEzNGEwZWYyYWQwMmMzMGFkMjcyZmE0MDAxOGU3ODdhMzM","commit":{"author":{"name":"Alexi Christakis","email":"167903946+alexi-openai@users.noreply.github.com","date":"2026-07-28T23:19:21Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T23:27:46Z"},"message":"Tie remote exec servers to their parent stdin (#35843)\n\n## What changed\n\n- Add `--exit-on-stdin-close` and the `CODEX_EXEC_SERVER_EXIT_ON_STDIN_CLOSE` environment variable as opt-in controls for remote exec servers.\n- Gracefully drain active sessions and processes when the parent closes stdin, then flush telemetry before exiting.\n- Remove the parent-lifetime environment variable from child process environments.\n\n## Testing\n\n- Cover parent disconnects after signal-listener failures.\n- Exercise remote shutdown end to end, including child termination and final telemetry metrics.\n- Verify that explicitly disabling the environment variable preserves local exec-server behavior.\n\nGitOrigin-RevId: 63063bc097b54684c370bd545cd32d17c4e55d90","tree":{"sha":"5185966b4cf5c94e71a380f00864710c9a111f76","url":"https://api.github.com/repos/openai/codex/git/trees/5185966b4cf5c94e71a380f00864710c9a111f76"},"url":"https://api.github.com/repos/openai/codex/git/commits/166658a34a0ef2ad02c30ad272fa40018e787a33","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/166658a34a0ef2ad02c30ad272fa40018e787a33","html_url":"https://github.com/openai/codex/commit/166658a34a0ef2ad02c30ad272fa40018e787a33","comments_url":"https://api.github.com/repos/openai/codex/commits/166658a34a0ef2ad02c30ad272fa40018e787a33/comments","author":{"login":"alexi-openai","id":167903946,"node_id":"U_kgDOCgICyg","avatar_url":"https://avatars.githubusercontent.com/u/167903946?v=4","gravatar_id":"","url":"https://api.github.com/users/alexi-openai","html_url":"https://github.com/alexi-openai","followers_url":"https://api.github.com/users/alexi-openai/followers","following_url":"https://api.github.com/users/alexi-openai/following{/other_user}","gists_url":"https://api.github.com/users/alexi-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/alexi-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alexi-openai/subscriptions","organizations_url":"https://api.github.com/users/alexi-openai/orgs","repos_url":"https://api.github.com/users/alexi-openai/repos","events_url":"https://api.github.com/users/alexi-openai/events{/privacy}","received_events_url":"https://api.github.com/users/alexi-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"9f4c20aadc062dbc6a14843802a25eb0fbb8c004","url":"https://api.github.com/repos/openai/codex/commits/9f4c20aadc062dbc6a14843802a25eb0fbb8c004","html_url":"https://github.com/openai/codex/commit/9f4c20aadc062dbc6a14843802a25eb0fbb8c004"}]},{"sha":"9f4c20aadc062dbc6a14843802a25eb0fbb8c004","node_id":"C_kwDOOYsS4doAKDlmNGMyMGFhZGMwNjJkYmM2YTE0ODQzODAyYTI1ZWIwZmJiOGMwMDQ","commit":{"author":{"name":"thomas","email":"tsarlandie@openai.com","date":"2026-07-28T22:47:37Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T22:57:09Z"},"message":"Handle legacy MCP discovery prevalidation errors (#35840)\n\n## Why\n\nSome legacy MCP servers reject `server/discover` before creating a session and\nreturn a null-ID JSON-RPC error with a non-JSON content type or without echoing\nthe rejected protocol version. These responses prevented the client from\nfalling back to legacy initialization.\n\n## What changed\n\n- Parse HTTP 400 discovery errors without a session ID regardless of their\n  declared content type.\n- Fall back to `initialize` when error code `-32000` reports a missing session\n  or advertises only known legacy protocol versions, including supported\n  versions other than `2025-06-18`.\n- Continue rejecting unrelated error codes, correlated responses, non-400\n  statuses, malformed version lists, and lists containing modern or unknown\n  versions.\n\n## Testing\n\nAdded MCP discovery coverage for legacy error variants, server-selected legacy\nprotocol versions, non-JSON content types, and non-legacy rejection cases.\n\nGitOrigin-RevId: 4d3ee2d7d852ce0d0ab3f486da23cb653a7ff5ca","tree":{"sha":"acc094126714e458a7d1fcdc1ab235d4e5bad662","url":"https://api.github.com/repos/openai/codex/git/trees/acc094126714e458a7d1fcdc1ab235d4e5bad662"},"url":"https://api.github.com/repos/openai/codex/git/commits/9f4c20aadc062dbc6a14843802a25eb0fbb8c004","comment_count":1,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/9f4c20aadc062dbc6a14843802a25eb0fbb8c004","html_url":"https://github.com/openai/codex/commit/9f4c20aadc062dbc6a14843802a25eb0fbb8c004","comments_url":"https://api.github.com/repos/openai/codex/commits/9f4c20aadc062dbc6a14843802a25eb0fbb8c004/comments","author":{"login":"tsarlandie-oai","id":291887306,"node_id":"U_kgDOEWXYyg","avatar_url":"https://avatars.githubusercontent.com/u/291887306?v=4","gravatar_id":"","url":"https://api.github.com/users/tsarlandie-oai","html_url":"https://github.com/tsarlandie-oai","followers_url":"https://api.github.com/users/tsarlandie-oai/followers","following_url":"https://api.github.com/users/tsarlandie-oai/following{/other_user}","gists_url":"https://api.github.com/users/tsarlandie-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/tsarlandie-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tsarlandie-oai/subscriptions","organizations_url":"https://api.github.com/users/tsarlandie-oai/orgs","repos_url":"https://api.github.com/users/tsarlandie-oai/repos","events_url":"https://api.github.com/users/tsarlandie-oai/events{/privacy}","received_events_url":"https://api.github.com/users/tsarlandie-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"3a797496f1fd56308a73c1d1a068e71d44f34a32","url":"https://api.github.com/repos/openai/codex/commits/3a797496f1fd56308a73c1d1a068e71d44f34a32","html_url":"https://github.com/openai/codex/commit/3a797496f1fd56308a73c1d1a068e71d44f34a32"}]},{"sha":"3a797496f1fd56308a73c1d1a068e71d44f34a32","node_id":"C_kwDOOYsS4doAKDNhNzk3NDk2ZjFmZDU2MzA4YTczYzFkMWEwNjhlNzFkNDRmMzRhMzI","commit":{"author":{"name":"Alex Daley","email":"adaley@openai.com","date":"2026-07-28T22:47:15Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T22:53:33Z"},"message":"Decouple recommended plugins from tool suggestions (#35839)\n\n## What changed\n\n- Add the stable, disabled-by-default `recommended_plugins` feature flag.\n- Load recommended plugin candidates when apps and plugins are enabled and\n  either `tool_suggest` or `recommended_plugins` is active.\n- Keep the `request_plugin_install` tool gated by `tool_suggest`.\n\n## Testing\n\n- Cover the first turn after external login with `tool_suggest` both enabled\n  and disabled, including the expected install-tool availability.\n\nGitOrigin-RevId: 06d9a1c2e8dd2498a47796d833eb6d25ba528351","tree":{"sha":"968afe4cd47c13764d63c3e3c01831e0695f5e37","url":"https://api.github.com/repos/openai/codex/git/trees/968afe4cd47c13764d63c3e3c01831e0695f5e37"},"url":"https://api.github.com/repos/openai/codex/git/commits/3a797496f1fd56308a73c1d1a068e71d44f34a32","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/3a797496f1fd56308a73c1d1a068e71d44f34a32","html_url":"https://github.com/openai/codex/commit/3a797496f1fd56308a73c1d1a068e71d44f34a32","comments_url":"https://api.github.com/repos/openai/codex/commits/3a797496f1fd56308a73c1d1a068e71d44f34a32/comments","author":{"login":"adaley-openai","id":192042180,"node_id":"U_kgDOC3JUxA","avatar_url":"https://avatars.githubusercontent.com/u/192042180?v=4","gravatar_id":"","url":"https://api.github.com/users/adaley-openai","html_url":"https://github.com/adaley-openai","followers_url":"https://api.github.com/users/adaley-openai/followers","following_url":"https://api.github.com/users/adaley-openai/following{/other_user}","gists_url":"https://api.github.com/users/adaley-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/adaley-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/adaley-openai/subscriptions","organizations_url":"https://api.github.com/users/adaley-openai/orgs","repos_url":"https://api.github.com/users/adaley-openai/repos","events_url":"https://api.github.com/users/adaley-openai/events{/privacy}","received_events_url":"https://api.github.com/users/adaley-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"12b961d4c545f4871efba3a9fd4ea1c1f747eaf4","url":"https://api.github.com/repos/openai/codex/commits/12b961d4c545f4871efba3a9fd4ea1c1f747eaf4","html_url":"https://github.com/openai/codex/commit/12b961d4c545f4871efba3a9fd4ea1c1f747eaf4"}]},{"sha":"12b961d4c545f4871efba3a9fd4ea1c1f747eaf4","node_id":"C_kwDOOYsS4doAKDEyYjk2MWQ0YzU0NWY0ODcxZWZiYTNhOWZkNGVhMWMxZjc0N2VhZjQ","commit":{"author":{"name":"Eric Ning","email":"ericning@openai.com","date":"2026-07-28T22:23:30Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T22:28:08Z"},"message":"Expose plugin eligibility metadata in app-server summaries (#35837)\n\n## What changed\n\n- Add nullable `disabledReason` and `eligiblePlanTypes` fields to v2\n  `PluginSummary` responses and generated schemas.\n- Preserve the remote catalog values across discovered, installed, and cached\n  plugin summary paths while returning `null` for local plugins and older\n  remote responses.\n- Treat unrecognized disabled reasons as `unknown` for forward compatibility.\n\n## Testing\n\n- Cover protocol round trips, remote summary propagation, unknown disabled\n  reasons, and app-server responses for admin-disabled and plan-ineligible\n  plugins.\n\nGitOrigin-RevId: 657a7ea6f838a6ff8bd1769ebcca0f3432684437","tree":{"sha":"762515d9a166883c068dab4bb456517b94ee30bf","url":"https://api.github.com/repos/openai/codex/git/trees/762515d9a166883c068dab4bb456517b94ee30bf"},"url":"https://api.github.com/repos/openai/codex/git/commits/12b961d4c545f4871efba3a9fd4ea1c1f747eaf4","comment_count":11,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/12b961d4c545f4871efba3a9fd4ea1c1f747eaf4","html_url":"https://github.com/openai/codex/commit/12b961d4c545f4871efba3a9fd4ea1c1f747eaf4","comments_url":"https://api.github.com/repos/openai/codex/commits/12b961d4c545f4871efba3a9fd4ea1c1f747eaf4/comments","author":{"login":"ericning-o","id":182030612,"node_id":"U_kgDOCtmRFA","avatar_url":"https://avatars.githubusercontent.com/u/182030612?v=4","gravatar_id":"","url":"https://api.github.com/users/ericning-o","html_url":"https://github.com/ericning-o","followers_url":"https://api.github.com/users/ericning-o/followers","following_url":"https://api.github.com/users/ericning-o/following{/other_user}","gists_url":"https://api.github.com/users/ericning-o/gists{/gist_id}","starred_url":"https://api.github.com/users/ericning-o/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ericning-o/subscriptions","organizations_url":"https://api.github.com/users/ericning-o/orgs","repos_url":"https://api.github.com/users/ericning-o/repos","events_url":"https://api.github.com/users/ericning-o/events{/privacy}","received_events_url":"https://api.github.com/users/ericning-o/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c550cb3e01c921e8d7cd02768a187298ad22ddee","url":"https://api.github.com/repos/openai/codex/commits/c550cb3e01c921e8d7cd02768a187298ad22ddee","html_url":"https://github.com/openai/codex/commit/c550cb3e01c921e8d7cd02768a187298ad22ddee"}]},{"sha":"c550cb3e01c921e8d7cd02768a187298ad22ddee","node_id":"C_kwDOOYsS4doAKGM1NTBjYjNlMDFjOTIxZThkN2NkMDI3NjhhMTg3Mjk4YWQyMmRkZWU","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-28T22:12:09Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T22:16:42Z"},"message":"Clean up cancelled MCP elicitation requests (#35836)\n\n## Why\n\nCancelling an in-flight MCP elicitation could leave its response handler registered in the shared router.\n\n## What changed\n\n- Remove an elicitation from the router when its pending request future is dropped.\n- Keep cleanup scoped to the cancelled request so other pending elicitations remain routable.\n\n## Testing\n\nAdded a test that cancels one of two pending elicitations, verifies the cancelled request can no longer be resolved, and confirms the other request still completes.\n\nGitOrigin-RevId: 9a10360459f0b39552d9d29a6e1b867c1f09e97d","tree":{"sha":"cc230fd77259343b26181876e606f42448f4cba4","url":"https://api.github.com/repos/openai/codex/git/trees/cc230fd77259343b26181876e606f42448f4cba4"},"url":"https://api.github.com/repos/openai/codex/git/commits/c550cb3e01c921e8d7cd02768a187298ad22ddee","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c550cb3e01c921e8d7cd02768a187298ad22ddee","html_url":"https://github.com/openai/codex/commit/c550cb3e01c921e8d7cd02768a187298ad22ddee","comments_url":"https://api.github.com/repos/openai/codex/commits/c550cb3e01c921e8d7cd02768a187298ad22ddee/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"1def0a8925cd9df462cbd7cec355458198015473","url":"https://api.github.com/repos/openai/codex/commits/1def0a8925cd9df462cbd7cec355458198015473","html_url":"https://github.com/openai/codex/commit/1def0a8925cd9df462cbd7cec355458198015473"}]},{"sha":"1def0a8925cd9df462cbd7cec355458198015473","node_id":"C_kwDOOYsS4doAKDFkZWYwYTg5MjVjZDlkZjQ2MmNiZDdjZWMzNTU0NTgxOTgwMTU0NzM","commit":{"author":{"name":"Eddie Chen","email":"173840017+eddie-openai@users.noreply.github.com","date":"2026-07-28T21:53:34Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T21:58:33Z"},"message":"Track parent turns for nested Codex requests (#35835)\n\n## What changed\n\n- Propagate the initiating turn ID through agent spawns, follow-up tasks, reviews, and delegated Codex sessions.\n- Add `parent_turn_id` to Responses client and turn metadata while keeping it out of external MCP metadata.\n- Preserve parent-turn provenance across queued agent messages when their triggering parent is unambiguous.\n\n## Testing\n\n- Cover spawned, resumed, nested, reviewed, delegated, and WebSocket request metadata.\n- Verify queued messages do not claim ambiguous or queue-only parent turns.\n\nGitOrigin-RevId: 481fdebbe7df2031880fe259509273cce50b20a8","tree":{"sha":"37a91eabbb48f909110e541b2af315bd1ca50567","url":"https://api.github.com/repos/openai/codex/git/trees/37a91eabbb48f909110e541b2af315bd1ca50567"},"url":"https://api.github.com/repos/openai/codex/git/commits/1def0a8925cd9df462cbd7cec355458198015473","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/1def0a8925cd9df462cbd7cec355458198015473","html_url":"https://github.com/openai/codex/commit/1def0a8925cd9df462cbd7cec355458198015473","comments_url":"https://api.github.com/repos/openai/codex/commits/1def0a8925cd9df462cbd7cec355458198015473/comments","author":{"login":"eddie-openai","id":173840017,"node_id":"U_kgDOClyWkQ","avatar_url":"https://avatars.githubusercontent.com/u/173840017?v=4","gravatar_id":"","url":"https://api.github.com/users/eddie-openai","html_url":"https://github.com/eddie-openai","followers_url":"https://api.github.com/users/eddie-openai/followers","following_url":"https://api.github.com/users/eddie-openai/following{/other_user}","gists_url":"https://api.github.com/users/eddie-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/eddie-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/eddie-openai/subscriptions","organizations_url":"https://api.github.com/users/eddie-openai/orgs","repos_url":"https://api.github.com/users/eddie-openai/repos","events_url":"https://api.github.com/users/eddie-openai/events{/privacy}","received_events_url":"https://api.github.com/users/eddie-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"12b3e88028b983051913fb6bb95d7a11218bdceb","url":"https://api.github.com/repos/openai/codex/commits/12b3e88028b983051913fb6bb95d7a11218bdceb","html_url":"https://github.com/openai/codex/commit/12b3e88028b983051913fb6bb95d7a11218bdceb"}]},{"sha":"12b3e88028b983051913fb6bb95d7a11218bdceb","node_id":"C_kwDOOYsS4doAKDEyYjNlODgwMjhiOTgzMDUxOTEzZmI2YmI5NWQ3YTExMjE4YmRjZWI","commit":{"author":{"name":"seanh-oai","email":"seanh@openai.com","date":"2026-07-28T21:12:46Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T21:21:45Z"},"message":"Update rusty_v8 to 150.4.0 (#35831)\n\n## What changed\n\n- Upgrade the Rust `v8` crate to `150.4.0` and the Bazel V8 source to\n  `15.0.245.2`.\n- Refresh the prebuilt archives, checksums, LLVM source revisions, Bazel targets,\n  and downstream V8 patches for the new release.\n- Expose the pinned llvm-libc headers under V8's expected include path for\n  source builds.\n\nGitOrigin-RevId: 91c953b2fb707b221fdd772f9ca88fb71606f70f","tree":{"sha":"5016f558a82c8c521077c133c6506c937e09c62a","url":"https://api.github.com/repos/openai/codex/git/trees/5016f558a82c8c521077c133c6506c937e09c62a"},"url":"https://api.github.com/repos/openai/codex/git/commits/12b3e88028b983051913fb6bb95d7a11218bdceb","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/12b3e88028b983051913fb6bb95d7a11218bdceb","html_url":"https://github.com/openai/codex/commit/12b3e88028b983051913fb6bb95d7a11218bdceb","comments_url":"https://api.github.com/repos/openai/codex/commits/12b3e88028b983051913fb6bb95d7a11218bdceb/comments","author":{"login":"seanh-oai","id":309889850,"node_id":"U_kgDOEniLOg","avatar_url":"https://avatars.githubusercontent.com/u/309889850?v=4","gravatar_id":"","url":"https://api.github.com/users/seanh-oai","html_url":"https://github.com/seanh-oai","followers_url":"https://api.github.com/users/seanh-oai/followers","following_url":"https://api.github.com/users/seanh-oai/following{/other_user}","gists_url":"https://api.github.com/users/seanh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/seanh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/seanh-oai/subscriptions","organizations_url":"https://api.github.com/users/seanh-oai/orgs","repos_url":"https://api.github.com/users/seanh-oai/repos","events_url":"https://api.github.com/users/seanh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/seanh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"438c9e98db71273e4f0b63dc4a86c2db58c44706","url":"https://api.github.com/repos/openai/codex/commits/438c9e98db71273e4f0b63dc4a86c2db58c44706","html_url":"https://github.com/openai/codex/commit/438c9e98db71273e4f0b63dc4a86c2db58c44706"}]},{"sha":"438c9e98db71273e4f0b63dc4a86c2db58c44706","node_id":"C_kwDOOYsS4doAKDQzOGM5ZTk4ZGI3MTI3M2U0ZjBiNjNkYzRhODZjMmRiNThjNDQ3MDY","commit":{"author":{"name":"Peter Bakkum","email":"pbakkum@openai.com","date":"2026-07-28T21:09:11Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T21:16:06Z"},"message":"Route WebRTC sideband joins to the Realtime API (#35830)\n\n## What changed\n\n- Use `https://api.openai.com/v1` for WebRTC sideband websocket joins instead of deriving the URL from the model provider.\n- Keep `experimental_realtime_ws_base_url` as an explicit sideband override for local development and tests.\n- Exclude provider query parameters when building sideband URLs.\n\n## Testing\n\n- Add coverage that a frameless sideband join uses `wss://api.openai.com/v1/live/rtc_test` even when the provider points at the ChatGPT backend.\n- Update the sideband retry end-to-end test to inject its mock server URL through the new override.\n\nGitOrigin-RevId: 5d3d2cd69905ba04143010ced36a22712825b563","tree":{"sha":"ba7d33901d25ee93dfa602c0b74fcfe298fc5ca3","url":"https://api.github.com/repos/openai/codex/git/trees/ba7d33901d25ee93dfa602c0b74fcfe298fc5ca3"},"url":"https://api.github.com/repos/openai/codex/git/commits/438c9e98db71273e4f0b63dc4a86c2db58c44706","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/438c9e98db71273e4f0b63dc4a86c2db58c44706","html_url":"https://github.com/openai/codex/commit/438c9e98db71273e4f0b63dc4a86c2db58c44706","comments_url":"https://api.github.com/repos/openai/codex/commits/438c9e98db71273e4f0b63dc4a86c2db58c44706/comments","author":{"login":"bakks","id":1172710,"node_id":"MDQ6VXNlcjExNzI3MTA=","avatar_url":"https://avatars.githubusercontent.com/u/1172710?v=4","gravatar_id":"","url":"https://api.github.com/users/bakks","html_url":"https://github.com/bakks","followers_url":"https://api.github.com/users/bakks/followers","following_url":"https://api.github.com/users/bakks/following{/other_user}","gists_url":"https://api.github.com/users/bakks/gists{/gist_id}","starred_url":"https://api.github.com/users/bakks/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bakks/subscriptions","organizations_url":"https://api.github.com/users/bakks/orgs","repos_url":"https://api.github.com/users/bakks/repos","events_url":"https://api.github.com/users/bakks/events{/privacy}","received_events_url":"https://api.github.com/users/bakks/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"50a7328f50faab7d3a4be125580dc1bf7ae070d7","url":"https://api.github.com/repos/openai/codex/commits/50a7328f50faab7d3a4be125580dc1bf7ae070d7","html_url":"https://github.com/openai/codex/commit/50a7328f50faab7d3a4be125580dc1bf7ae070d7"}]},{"sha":"50a7328f50faab7d3a4be125580dc1bf7ae070d7","node_id":"C_kwDOOYsS4doAKDUwYTczMjhmNTBmYWFiN2QzYTRiZTEyNTU4MGRjMWJmN2FlMDcwZDc","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-07-28T20:43:55Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T20:49:22Z"},"message":"Enforce centralized SQLite connection creation (#35828)\n\n## Why\n\nDirect SQLx constructors can bypass the shared SQLite configuration in\n`codex-state`.\n\n## What changed\n\n- Deny SQLx pool, connection, and database creation methods through the\n  workspace Clippy configuration for both Cargo and Bazel builds.\n- Exempt `codex-rs/state/src/sqlite.rs`, the centralized connection shim, from\n  the lint.\n- Document that the deny list must be audited when upgrading SQLx.\n\nGitOrigin-RevId: e20d7e83095727ac446347157782175062a100fc","tree":{"sha":"daa49f9d837f24405df3b9f5d1a7186116d7e97b","url":"https://api.github.com/repos/openai/codex/git/trees/daa49f9d837f24405df3b9f5d1a7186116d7e97b"},"url":"https://api.github.com/repos/openai/codex/git/commits/50a7328f50faab7d3a4be125580dc1bf7ae070d7","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/50a7328f50faab7d3a4be125580dc1bf7ae070d7","html_url":"https://github.com/openai/codex/commit/50a7328f50faab7d3a4be125580dc1bf7ae070d7","comments_url":"https://api.github.com/repos/openai/codex/commits/50a7328f50faab7d3a4be125580dc1bf7ae070d7/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"155c3e299c3ad6a033eba8837e7b3b57901271f8","url":"https://api.github.com/repos/openai/codex/commits/155c3e299c3ad6a033eba8837e7b3b57901271f8","html_url":"https://github.com/openai/codex/commit/155c3e299c3ad6a033eba8837e7b3b57901271f8"}]},{"sha":"155c3e299c3ad6a033eba8837e7b3b57901271f8","node_id":"C_kwDOOYsS4doAKDE1NWMzZTI5OWMzYWQ2YTAzM2ViYTg4MzdlN2IzYjU3OTAxMjcxZjg","commit":{"author":{"name":"Celia Chen","email":"celia@openai.com","date":"2026-07-28T20:04:40Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T20:12:13Z"},"message":"Use the shared HTTP client for announcement tips (#35825)\n\n## Why\n\nAnnouncement prewarming disabled proxy discovery to avoid the macOS sandbox\npanic fixed by https://github.com/openai/codex/pull/16670.\n\n## What changed\n\n- Fetch announcement tips asynchronously with `RouteAwareClientPool` instead\n  of a blocking `reqwest` client.\n- Pass the configured `HttpClientFactory` into prewarming so announcement\n  requests honor the configured outbound proxy policy.\n\nGitOrigin-RevId: 535158d95a99c6f515bd30ea6e3bcb2ac6bb6d7e","tree":{"sha":"46421dcd9486e8db23e21acedc7f020e85f9f969","url":"https://api.github.com/repos/openai/codex/git/trees/46421dcd9486e8db23e21acedc7f020e85f9f969"},"url":"https://api.github.com/repos/openai/codex/git/commits/155c3e299c3ad6a033eba8837e7b3b57901271f8","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/155c3e299c3ad6a033eba8837e7b3b57901271f8","html_url":"https://github.com/openai/codex/commit/155c3e299c3ad6a033eba8837e7b3b57901271f8","comments_url":"https://api.github.com/repos/openai/codex/commits/155c3e299c3ad6a033eba8837e7b3b57901271f8/comments","author":{"login":"celia-oai","id":209693228,"node_id":"U_kgDODH-qLA","avatar_url":"https://avatars.githubusercontent.com/u/209693228?v=4","gravatar_id":"","url":"https://api.github.com/users/celia-oai","html_url":"https://github.com/celia-oai","followers_url":"https://api.github.com/users/celia-oai/followers","following_url":"https://api.github.com/users/celia-oai/following{/other_user}","gists_url":"https://api.github.com/users/celia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/celia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celia-oai/subscriptions","organizations_url":"https://api.github.com/users/celia-oai/orgs","repos_url":"https://api.github.com/users/celia-oai/repos","events_url":"https://api.github.com/users/celia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/celia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"8bbdf6c8f9ecf4833479c64a4794c9ed6c2dab9b","url":"https://api.github.com/repos/openai/codex/commits/8bbdf6c8f9ecf4833479c64a4794c9ed6c2dab9b","html_url":"https://github.com/openai/codex/commit/8bbdf6c8f9ecf4833479c64a4794c9ed6c2dab9b"}]},{"sha":"8bbdf6c8f9ecf4833479c64a4794c9ed6c2dab9b","node_id":"C_kwDOOYsS4doAKDhiYmRmNmM4ZjllY2Y0ODMzNDc5YzY0YTQ3OTRjOWVkNmMyZGFiOWI","commit":{"author":{"name":"Celia Chen","email":"celia@openai.com","date":"2026-07-28T19:53:16Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T19:58:25Z"},"message":"Use the shared HTTP client for TUI network checks (#35821)\n\n## Why\n\nTUI update checks and local OSS provider detection constructed their own HTTP\nclients instead of using Codex's shared client behavior.\n\n## What changed\n\n- Route update requests through the configured route-aware client pool while\n  retaining the existing default headers and custom CA fallback.\n- Probe the hardcoded LM Studio and Ollama loopback endpoints with a shared\n  direct client and a per-request timeout.\n- Limit the legacy invalid-custom-CA fallback to the default routing policy so\n  system-proxy routing still reports certificate configuration errors.\n\n## Testing\n\nAdd coverage for local provider probes with invalid `CODEX_CA_CERTIFICATE` and\n`SSL_CERT_FILE` values, and for custom CA fallback under both routing policies.\n\nGitOrigin-RevId: b5c230b61e8964b3f1af3395052361ff716d6ce1","tree":{"sha":"e20dd0101749430d492e396156f386e748aed614","url":"https://api.github.com/repos/openai/codex/git/trees/e20dd0101749430d492e396156f386e748aed614"},"url":"https://api.github.com/repos/openai/codex/git/commits/8bbdf6c8f9ecf4833479c64a4794c9ed6c2dab9b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/8bbdf6c8f9ecf4833479c64a4794c9ed6c2dab9b","html_url":"https://github.com/openai/codex/commit/8bbdf6c8f9ecf4833479c64a4794c9ed6c2dab9b","comments_url":"https://api.github.com/repos/openai/codex/commits/8bbdf6c8f9ecf4833479c64a4794c9ed6c2dab9b/comments","author":{"login":"celia-oai","id":209693228,"node_id":"U_kgDODH-qLA","avatar_url":"https://avatars.githubusercontent.com/u/209693228?v=4","gravatar_id":"","url":"https://api.github.com/users/celia-oai","html_url":"https://github.com/celia-oai","followers_url":"https://api.github.com/users/celia-oai/followers","following_url":"https://api.github.com/users/celia-oai/following{/other_user}","gists_url":"https://api.github.com/users/celia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/celia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celia-oai/subscriptions","organizations_url":"https://api.github.com/users/celia-oai/orgs","repos_url":"https://api.github.com/users/celia-oai/repos","events_url":"https://api.github.com/users/celia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/celia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"dd6b8803538ce80eccaef4804c5ecf574457dbef","url":"https://api.github.com/repos/openai/codex/commits/dd6b8803538ce80eccaef4804c5ecf574457dbef","html_url":"https://github.com/openai/codex/commit/dd6b8803538ce80eccaef4804c5ecf574457dbef"}]},{"sha":"dd6b8803538ce80eccaef4804c5ecf574457dbef","node_id":"C_kwDOOYsS4doAKGRkNmI4ODAzNTM4Y2U4MGVjY2FlZjQ4MDRjNWVjZjU3NDQ1N2RiZWY","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-07-28T19:21:33Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T19:27:00Z"},"message":"Advance latest-alpha-cli after release publishing completes (#35818)\n\n## What changed\n\nMake the `update-branch` job wait for successful R2 publication before moving\n`latest-alpha-cli`. For releases that publish npm packages, also require the npm\njob to succeed; releases that intentionally skip npm publication can still\nadvance the branch.\n\nGitOrigin-RevId: 38381b82c95c5c9650b2d72258ea7b835bdfa555","tree":{"sha":"51dc37ad5c89e16b2c32a07723ed4a020c5bf371","url":"https://api.github.com/repos/openai/codex/git/trees/51dc37ad5c89e16b2c32a07723ed4a020c5bf371"},"url":"https://api.github.com/repos/openai/codex/git/commits/dd6b8803538ce80eccaef4804c5ecf574457dbef","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/dd6b8803538ce80eccaef4804c5ecf574457dbef","html_url":"https://github.com/openai/codex/commit/dd6b8803538ce80eccaef4804c5ecf574457dbef","comments_url":"https://api.github.com/repos/openai/codex/commits/dd6b8803538ce80eccaef4804c5ecf574457dbef/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"709283b432fb5231c9bca720c239b25046968aa2","url":"https://api.github.com/repos/openai/codex/commits/709283b432fb5231c9bca720c239b25046968aa2","html_url":"https://github.com/openai/codex/commit/709283b432fb5231c9bca720c239b25046968aa2"}]},{"sha":"709283b432fb5231c9bca720c239b25046968aa2","node_id":"C_kwDOOYsS4doAKDcwOTI4M2I0MzJmYjUyMzFjOWJjYTcyMGMyMzliMjUwNDY5NjhhYTI","commit":{"author":{"name":"Celia Chen","email":"celia@openai.com","date":"2026-07-28T19:04:05Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T19:11:36Z"},"message":"Use configured HTTP clients for all MCP OAuth requests (#35814)\n\n## What changed\n\n- Require callers to provide an HTTP client for MCP OAuth discovery and login, removing the separate direct `reqwest` path.\n- Use the shared `http` and `url` types throughout the MCP client and drop its direct `reqwest` dependency.\n- Preserve configured MCP headers when routing OAuth discovery through the provided client.\n\n## Testing\n\n- Add coverage that routed OAuth discovery forwards configured headers.\n\nGitOrigin-RevId: 1345f56bd794626533133447597a5908e57b9b48","tree":{"sha":"8985c1613481665dd3bf8b037ae3bc555bceecc3","url":"https://api.github.com/repos/openai/codex/git/trees/8985c1613481665dd3bf8b037ae3bc555bceecc3"},"url":"https://api.github.com/repos/openai/codex/git/commits/709283b432fb5231c9bca720c239b25046968aa2","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/709283b432fb5231c9bca720c239b25046968aa2","html_url":"https://github.com/openai/codex/commit/709283b432fb5231c9bca720c239b25046968aa2","comments_url":"https://api.github.com/repos/openai/codex/commits/709283b432fb5231c9bca720c239b25046968aa2/comments","author":{"login":"celia-oai","id":209693228,"node_id":"U_kgDODH-qLA","avatar_url":"https://avatars.githubusercontent.com/u/209693228?v=4","gravatar_id":"","url":"https://api.github.com/users/celia-oai","html_url":"https://github.com/celia-oai","followers_url":"https://api.github.com/users/celia-oai/followers","following_url":"https://api.github.com/users/celia-oai/following{/other_user}","gists_url":"https://api.github.com/users/celia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/celia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celia-oai/subscriptions","organizations_url":"https://api.github.com/users/celia-oai/orgs","repos_url":"https://api.github.com/users/celia-oai/repos","events_url":"https://api.github.com/users/celia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/celia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"9ea975a2dc88d039512313da3e332013e8bd911e","url":"https://api.github.com/repos/openai/codex/commits/9ea975a2dc88d039512313da3e332013e8bd911e","html_url":"https://github.com/openai/codex/commit/9ea975a2dc88d039512313da3e332013e8bd911e"}]},{"sha":"9ea975a2dc88d039512313da3e332013e8bd911e","node_id":"C_kwDOOYsS4doAKDllYTk3NWEyZGM4OGQwMzk1MTIzMTNkYTNlMzMyMDEzZThiZDkxMWU","commit":{"author":{"name":"Celia Chen","email":"celia@openai.com","date":"2026-07-28T17:56:56Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T18:25:29Z"},"message":"Route MCP OAuth through configured HTTP clients (#35806)\n\n## What changed\n\n- Pass resolved, route-aware HTTP clients through MCP OAuth discovery and login so CLI commands, plugin installation, and skill dependency setup honor configured proxies and execution environments.\n- Apply per-plugin MCP server configuration and requirements before starting OAuth during installation, and skip disabled servers or servers assigned to unowned environments.\n- Preserve configured MCP server policies when merging remotely installed plugin metadata.\n\n## Testing\n\n- Cover proxy-routed OAuth for `codex mcp add`, `codex mcp login`, plugin installation, and skill MCP dependencies.\n- Cover plugin-install OAuth filtering for disabled servers, plugin requirements, and unowned environments.\n\nGitOrigin-RevId: f84c88820e24a627faa78d6bed1b371682ecdc2f","tree":{"sha":"f2fc1cb9a716a77c72ca3fcf039b9f2c1ec8b826","url":"https://api.github.com/repos/openai/codex/git/trees/f2fc1cb9a716a77c72ca3fcf039b9f2c1ec8b826"},"url":"https://api.github.com/repos/openai/codex/git/commits/9ea975a2dc88d039512313da3e332013e8bd911e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/9ea975a2dc88d039512313da3e332013e8bd911e","html_url":"https://github.com/openai/codex/commit/9ea975a2dc88d039512313da3e332013e8bd911e","comments_url":"https://api.github.com/repos/openai/codex/commits/9ea975a2dc88d039512313da3e332013e8bd911e/comments","author":{"login":"celia-oai","id":209693228,"node_id":"U_kgDODH-qLA","avatar_url":"https://avatars.githubusercontent.com/u/209693228?v=4","gravatar_id":"","url":"https://api.github.com/users/celia-oai","html_url":"https://github.com/celia-oai","followers_url":"https://api.github.com/users/celia-oai/followers","following_url":"https://api.github.com/users/celia-oai/following{/other_user}","gists_url":"https://api.github.com/users/celia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/celia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celia-oai/subscriptions","organizations_url":"https://api.github.com/users/celia-oai/orgs","repos_url":"https://api.github.com/users/celia-oai/repos","events_url":"https://api.github.com/users/celia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/celia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"8f00b9a04cb542ad19a79f9f6c32348421741602","url":"https://api.github.com/repos/openai/codex/commits/8f00b9a04cb542ad19a79f9f6c32348421741602","html_url":"https://github.com/openai/codex/commit/8f00b9a04cb542ad19a79f9f6c32348421741602"}]},{"sha":"8f00b9a04cb542ad19a79f9f6c32348421741602","node_id":"C_kwDOOYsS4doAKDhmMDBiOWEwNGNiNTQyYWQxOWE3OWY5ZjZjMzIzNDg0MjE3NDE2MDI","commit":{"author":{"name":"Felicia Chen","email":"fchen@openai.com","date":"2026-07-28T17:45:31Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T17:51:37Z"},"message":"Tag reports with the selected turn's model and effort (#35802)\n\n## What changed\n\n- Read the selected turn's `model` and reasoning `effort` from its rollout and add them to the report's upload tags.\n- Use the latest turn context when the request has no `turn_id`, without substituting another turn when a requested ID is missing.\n- Prefer the request-derived model and effort over values captured in the report snapshot.\n\n## Testing\n\n- Added coverage for selecting a reported turn, falling back to the latest turn, handling a missing turn, preserving an unspecified effort, and upload-tag precedence.\n\nGitOrigin-RevId: 133bab7730e18b28c4b26ae55fbce55d8e5705fb","tree":{"sha":"de980748c59213d4e2f89fd5bf925feb7e544a1b","url":"https://api.github.com/repos/openai/codex/git/trees/de980748c59213d4e2f89fd5bf925feb7e544a1b"},"url":"https://api.github.com/repos/openai/codex/git/commits/8f00b9a04cb542ad19a79f9f6c32348421741602","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/8f00b9a04cb542ad19a79f9f6c32348421741602","html_url":"https://github.com/openai/codex/commit/8f00b9a04cb542ad19a79f9f6c32348421741602","comments_url":"https://api.github.com/repos/openai/codex/commits/8f00b9a04cb542ad19a79f9f6c32348421741602/comments","author":{"login":"fchen-oai","id":288173853,"node_id":"U_kgDOES0vHQ","avatar_url":"https://avatars.githubusercontent.com/u/288173853?v=4","gravatar_id":"","url":"https://api.github.com/users/fchen-oai","html_url":"https://github.com/fchen-oai","followers_url":"https://api.github.com/users/fchen-oai/followers","following_url":"https://api.github.com/users/fchen-oai/following{/other_user}","gists_url":"https://api.github.com/users/fchen-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/fchen-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fchen-oai/subscriptions","organizations_url":"https://api.github.com/users/fchen-oai/orgs","repos_url":"https://api.github.com/users/fchen-oai/repos","events_url":"https://api.github.com/users/fchen-oai/events{/privacy}","received_events_url":"https://api.github.com/users/fchen-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4f6eaf7af9d975b822d1d658ba1893d6d5a87646","url":"https://api.github.com/repos/openai/codex/commits/4f6eaf7af9d975b822d1d658ba1893d6d5a87646","html_url":"https://github.com/openai/codex/commit/4f6eaf7af9d975b822d1d658ba1893d6d5a87646"}]},{"sha":"4f6eaf7af9d975b822d1d658ba1893d6d5a87646","node_id":"C_kwDOOYsS4doAKDRmNmVhZjdhZjlkOTc1YjgyMmQxZDY1OGJhMTg5M2Q2ZDVhODc2NDY","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-07-28T16:51:47Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T16:57:17Z"},"message":"Wait for MCP readiness in the curated sync test (#35794)\n\n## What changed\n\nUpdate the existing-thread curated MCP sync test to wait for each server's\n`ready` startup notification before proceeding through refresh boundaries or\ncalling the synced server's tool.\n\nGitOrigin-RevId: 56fd7ff72ff277a043c4a2d8168079da053b4829","tree":{"sha":"95d7f7527872fb798e950903091fde1febd4bbd4","url":"https://api.github.com/repos/openai/codex/git/trees/95d7f7527872fb798e950903091fde1febd4bbd4"},"url":"https://api.github.com/repos/openai/codex/git/commits/4f6eaf7af9d975b822d1d658ba1893d6d5a87646","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4f6eaf7af9d975b822d1d658ba1893d6d5a87646","html_url":"https://github.com/openai/codex/commit/4f6eaf7af9d975b822d1d658ba1893d6d5a87646","comments_url":"https://api.github.com/repos/openai/codex/commits/4f6eaf7af9d975b822d1d658ba1893d6d5a87646/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fa1d4c40d0e63eef2e0ba8a9e004ccd0a80b77f5","url":"https://api.github.com/repos/openai/codex/commits/fa1d4c40d0e63eef2e0ba8a9e004ccd0a80b77f5","html_url":"https://github.com/openai/codex/commit/fa1d4c40d0e63eef2e0ba8a9e004ccd0a80b77f5"}]},{"sha":"fa1d4c40d0e63eef2e0ba8a9e004ccd0a80b77f5","node_id":"C_kwDOOYsS4doAKGZhMWQ0YzQwZDBlNjNlZWYyZTBiYThhOWUwMDRjY2QwYTgwYjc3ZjU","commit":{"author":{"name":"Owen Lin","email":"owen@openai.com","date":"2026-07-28T15:55:13Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T16:00:39Z"},"message":"Gate paginated thread history on the state database (#35787)\n\n## Why\n\nLocal thread stores without an initialized state database should not implicitly\ncreate SQLite files or partially delete threads that have materialized history.\n\n## What changed\n\n- Report paginated history listing as unsupported when no state database is\n  available, and skip history projection and materialization in that mode.\n- Reject paginated forks without a state database.\n- Validate access to materialized history before deleting rollout files, so a\n  failed deletion preserves both the rollout and its history rows.\n\n## Testing\n\nAdded coverage that a store without a state database creates no SQLite files\nand preserves materialized history when deletion is unsupported. Existing\nprojection tests now initialize the state runtime explicitly.\n\nGitOrigin-RevId: 2eaa0f5f0de8d5e4d84375ec50b310746a0ee68e","tree":{"sha":"49accba06923c9b565e2833201dbc65b5031bde7","url":"https://api.github.com/repos/openai/codex/git/trees/49accba06923c9b565e2833201dbc65b5031bde7"},"url":"https://api.github.com/repos/openai/codex/git/commits/fa1d4c40d0e63eef2e0ba8a9e004ccd0a80b77f5","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fa1d4c40d0e63eef2e0ba8a9e004ccd0a80b77f5","html_url":"https://github.com/openai/codex/commit/fa1d4c40d0e63eef2e0ba8a9e004ccd0a80b77f5","comments_url":"https://api.github.com/repos/openai/codex/commits/fa1d4c40d0e63eef2e0ba8a9e004ccd0a80b77f5/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"cf7e9cfe6a196d14a34a4a2e10265143df336781","url":"https://api.github.com/repos/openai/codex/commits/cf7e9cfe6a196d14a34a4a2e10265143df336781","html_url":"https://github.com/openai/codex/commit/cf7e9cfe6a196d14a34a4a2e10265143df336781"}]},{"sha":"cf7e9cfe6a196d14a34a4a2e10265143df336781","node_id":"C_kwDOOYsS4doAKGNmN2U5Y2ZlNmExOTZkMTRhMzRhNGEyZTEwMjY1MTQzZGYzMzY3ODE","commit":{"author":{"name":"Arun Eswara","email":"ase@openai.com","date":"2026-07-28T15:45:34Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T15:50:45Z"},"message":"Support self-serve Business ProLite accounts (#35785)\n\n## What changed\n\n- Recognize `self_serve_business_prolite` across authentication, account and rate-limit APIs, generated schemas, workspace classification, status display, cloud configuration gating, and usage-limit messaging.\n- Keep the Python SDK's `PlanType` enum compatible with non-empty string values introduced by newer Codex runtimes while preserving its known constants.\n\n## Testing\n\n- Cover token parsing, account reads and notifications, backend rate-limit mapping, workspace behavior, error formatting, and Python SDK response coercion for the new plan value.\n\nGitOrigin-RevId: 70bc17a7c4ba4028cb10e4333cc1f2ac64da361f","tree":{"sha":"cce1f1ae409197e8567e7430b6d5844183dff4ea","url":"https://api.github.com/repos/openai/codex/git/trees/cce1f1ae409197e8567e7430b6d5844183dff4ea"},"url":"https://api.github.com/repos/openai/codex/git/commits/cf7e9cfe6a196d14a34a4a2e10265143df336781","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/cf7e9cfe6a196d14a34a4a2e10265143df336781","html_url":"https://github.com/openai/codex/commit/cf7e9cfe6a196d14a34a4a2e10265143df336781","comments_url":"https://api.github.com/repos/openai/codex/commits/cf7e9cfe6a196d14a34a4a2e10265143df336781/comments","author":{"login":"ase-openai","id":199828667,"node_id":"U_kgDOC-kkuw","avatar_url":"https://avatars.githubusercontent.com/u/199828667?v=4","gravatar_id":"","url":"https://api.github.com/users/ase-openai","html_url":"https://github.com/ase-openai","followers_url":"https://api.github.com/users/ase-openai/followers","following_url":"https://api.github.com/users/ase-openai/following{/other_user}","gists_url":"https://api.github.com/users/ase-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/ase-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ase-openai/subscriptions","organizations_url":"https://api.github.com/users/ase-openai/orgs","repos_url":"https://api.github.com/users/ase-openai/repos","events_url":"https://api.github.com/users/ase-openai/events{/privacy}","received_events_url":"https://api.github.com/users/ase-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"bb1af235ea2822d7a40f75ef52e4d6a2cde84da2","url":"https://api.github.com/repos/openai/codex/commits/bb1af235ea2822d7a40f75ef52e4d6a2cde84da2","html_url":"https://github.com/openai/codex/commit/bb1af235ea2822d7a40f75ef52e4d6a2cde84da2"}]},{"sha":"bb1af235ea2822d7a40f75ef52e4d6a2cde84da2","node_id":"C_kwDOOYsS4doAKGJiMWFmMjM1ZWEyODIyZDdhNDBmNzVlZjUyZTRkNmEyY2RlODRkYTI","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-07-28T14:29:15Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T14:34:04Z"},"message":"Load thread titles concurrently during session startup (#35779)\n\n## What changed\n\nRun the thread-title lookup alongside instruction refresh and plugin and skill\nwarmup, avoiding an additional sequential wait during session initialization.\n\nGitOrigin-RevId: 021f48abeac249c5d3fe526d026bf031acf1bed9","tree":{"sha":"27f6df2cf264aef45ece5313e529d7a4b511630a","url":"https://api.github.com/repos/openai/codex/git/trees/27f6df2cf264aef45ece5313e529d7a4b511630a"},"url":"https://api.github.com/repos/openai/codex/git/commits/bb1af235ea2822d7a40f75ef52e4d6a2cde84da2","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/bb1af235ea2822d7a40f75ef52e4d6a2cde84da2","html_url":"https://github.com/openai/codex/commit/bb1af235ea2822d7a40f75ef52e4d6a2cde84da2","comments_url":"https://api.github.com/repos/openai/codex/commits/bb1af235ea2822d7a40f75ef52e4d6a2cde84da2/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"84ccb2938bfeee481e9481244f073d27d3c672cf","url":"https://api.github.com/repos/openai/codex/commits/84ccb2938bfeee481e9481244f073d27d3c672cf","html_url":"https://github.com/openai/codex/commit/84ccb2938bfeee481e9481244f073d27d3c672cf"}]},{"sha":"84ccb2938bfeee481e9481244f073d27d3c672cf","node_id":"C_kwDOOYsS4doAKDg0Y2NiMjkzOGJmZWVlNDgxZTk0ODEyNDRmMDczZDI3ZDNjNjcyY2Y","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-07-28T14:08:13Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T14:13:03Z"},"message":"Resolve MCP tool catalogs concurrently (#35777)\n\n## What changed\n\n- Resolve per-server tool catalogs concurrently in `list_all_tools` and binding capture.\n- After the shared startup wait, recheck servers that previously exposed cached tools so a newly ready client contributes its current catalog and callable client.\n\n## Testing\n\n- Add gated-client tests that verify multiple server catalogs start before any one server is released.\n- Verify binding capture replaces cached Codex Apps tools with the ready client's tools when startup completes during capture.\n\nGitOrigin-RevId: a30d1a535ed1588f2bba21f2741e8bbd9342e339","tree":{"sha":"086ce1ca0898aceaa2b7b94388e1556cdeef280e","url":"https://api.github.com/repos/openai/codex/git/trees/086ce1ca0898aceaa2b7b94388e1556cdeef280e"},"url":"https://api.github.com/repos/openai/codex/git/commits/84ccb2938bfeee481e9481244f073d27d3c672cf","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/84ccb2938bfeee481e9481244f073d27d3c672cf","html_url":"https://github.com/openai/codex/commit/84ccb2938bfeee481e9481244f073d27d3c672cf","comments_url":"https://api.github.com/repos/openai/codex/commits/84ccb2938bfeee481e9481244f073d27d3c672cf/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"03748ad5e18a3c9c1f0828561dcf1f3f0d7b2f77","url":"https://api.github.com/repos/openai/codex/commits/03748ad5e18a3c9c1f0828561dcf1f3f0d7b2f77","html_url":"https://github.com/openai/codex/commit/03748ad5e18a3c9c1f0828561dcf1f3f0d7b2f77"}]},{"sha":"03748ad5e18a3c9c1f0828561dcf1f3f0d7b2f77","node_id":"C_kwDOOYsS4doAKDAzNzQ4YWQ1ZTE4YTNjOWMxZjA4Mjg1NjFkY2YxZjNmMGQ3YjJmNzc","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-07-28T13:34:22Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T13:39:35Z"},"message":"Scale skill metadata budgets with context windows (#35773)\n\n## What changed\n\n- Allocate 2% of the resolved model context window to skill metadata without\n  imposing the previous 4,000-token ceiling.\n- Keep the 8,000-character fallback when no context window is available.\n- Extend catalog rendering coverage to verify that a 400,000-token context\n  window receives an 8,000-token metadata budget and includes more skills.\n\nGitOrigin-RevId: 5120d462de22fbfe5f9c4ab0d1bb97e51950d4b2","tree":{"sha":"d4aba51b5a9e1c7689bbf6e38e1ba60f6379bc54","url":"https://api.github.com/repos/openai/codex/git/trees/d4aba51b5a9e1c7689bbf6e38e1ba60f6379bc54"},"url":"https://api.github.com/repos/openai/codex/git/commits/03748ad5e18a3c9c1f0828561dcf1f3f0d7b2f77","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/03748ad5e18a3c9c1f0828561dcf1f3f0d7b2f77","html_url":"https://github.com/openai/codex/commit/03748ad5e18a3c9c1f0828561dcf1f3f0d7b2f77","comments_url":"https://api.github.com/repos/openai/codex/commits/03748ad5e18a3c9c1f0828561dcf1f3f0d7b2f77/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"7cde2323f3712999e9ab98b16287e08b7735d52f","url":"https://api.github.com/repos/openai/codex/commits/7cde2323f3712999e9ab98b16287e08b7735d52f","html_url":"https://github.com/openai/codex/commit/7cde2323f3712999e9ab98b16287e08b7735d52f"}]},{"sha":"7cde2323f3712999e9ab98b16287e08b7735d52f","node_id":"C_kwDOOYsS4doAKDdjZGUyMzIzZjM3MTI5OTllOWFiOThiMTYyODdlMDhiNzczNWQ1MmY","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-28T13:26:08Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T13:31:41Z"},"message":"Throttle models cache TTL renewals (#35772)\n\n## Why\n\nMatching model ETags can arrive on every response, but a recent models cache does\nnot need to be rewritten each time.\n\n## What changed\n\nRenew the models cache timestamp only after more than half of its configured TTL\nhas elapsed. Matching ETags continue to avoid refetching `/models`.\n\n## Testing\n\nAdded integration coverage that verifies a recent cache remains unchanged and an\nolder cache is renewed without another `/models` request.\n\nGitOrigin-RevId: b45da3824674c6b41d982ba4a405b419b09b7715","tree":{"sha":"92047bea37853bf3a9d6bdc2dbe3a22a3f02ca32","url":"https://api.github.com/repos/openai/codex/git/trees/92047bea37853bf3a9d6bdc2dbe3a22a3f02ca32"},"url":"https://api.github.com/repos/openai/codex/git/commits/7cde2323f3712999e9ab98b16287e08b7735d52f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/7cde2323f3712999e9ab98b16287e08b7735d52f","html_url":"https://github.com/openai/codex/commit/7cde2323f3712999e9ab98b16287e08b7735d52f","comments_url":"https://api.github.com/repos/openai/codex/commits/7cde2323f3712999e9ab98b16287e08b7735d52f/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"f6160ca5b3da580616883e9039f0e76ad359d515","url":"https://api.github.com/repos/openai/codex/commits/f6160ca5b3da580616883e9039f0e76ad359d515","html_url":"https://github.com/openai/codex/commit/f6160ca5b3da580616883e9039f0e76ad359d515"}]},{"sha":"f6160ca5b3da580616883e9039f0e76ad359d515","node_id":"C_kwDOOYsS4doAKGY2MTYwY2E1YjNkYTU4MDYxNjg4M2U5MDM5ZjBlNzZhZDM1OWQ1MTU","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-07-28T13:11:25Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T13:16:04Z"},"message":"Share the skills budget across host and executor catalogs (#35769)\n\n## Why\n\nRendering host and executor skill catalogs independently allows their combined\nmetadata to exceed the skills context budget.\n\n## What changed\n\n- Allocate one budget across both catalogs when both contain model-visible\n  skills.\n- Prefer retaining executor skills when budget pressure requires omissions,\n  while preserving an executor omission marker and reporting when all host\n  skills were omitted.\n- Evaluate absolute and aliased host paths under the shared budget and select\n  the rendering that best preserves executor entries, total entries, and\n  descriptions, in that order.\n\n## Testing\n\nAdded renderer and production-turn coverage for shared-budget description\nshortening, host-first omission, executor omission markers, and alias selection.\n\nGitOrigin-RevId: 30041736a76aa173cb641aa98a876a306cb437d2","tree":{"sha":"ed6b83d6b9505bfe6d1820904c63a5dc60046461","url":"https://api.github.com/repos/openai/codex/git/trees/ed6b83d6b9505bfe6d1820904c63a5dc60046461"},"url":"https://api.github.com/repos/openai/codex/git/commits/f6160ca5b3da580616883e9039f0e76ad359d515","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/f6160ca5b3da580616883e9039f0e76ad359d515","html_url":"https://github.com/openai/codex/commit/f6160ca5b3da580616883e9039f0e76ad359d515","comments_url":"https://api.github.com/repos/openai/codex/commits/f6160ca5b3da580616883e9039f0e76ad359d515/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a68d0a74bd38ddc01361ce42262da689b788afce","url":"https://api.github.com/repos/openai/codex/commits/a68d0a74bd38ddc01361ce42262da689b788afce","html_url":"https://github.com/openai/codex/commit/a68d0a74bd38ddc01361ce42262da689b788afce"}]},{"sha":"a68d0a74bd38ddc01361ce42262da689b788afce","node_id":"C_kwDOOYsS4doAKGE2OGQwYTc0YmQzOGRkYzAxMzYxY2U0MjI2MmRhNjg5Yjc4OGFmY2U","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-07-28T12:36:36Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T12:43:20Z"},"message":"Emit host skill budget warnings from world state (#35766)\n\n## Why\n\nHost skill catalogs supplied through extension world state should report budget warnings only when their catalog update is actually rendered.\n\n## What changed\n\n- Stop rebuilding an extension-owned host catalog in core.\n- Emit host catalog budget warnings when the corresponding world-state fragment is rendered, and deduplicate them with executor catalog warnings.\n- Cover full, shortened, and omitted host and executor catalogs, including repeated turns and resumed persisted snapshots.\n\nGitOrigin-RevId: ba28b6e337281b49ed4da2175c193fd4a6898ab7","tree":{"sha":"693e912b3653024d75838e3fbcda5dfaf51b4d9f","url":"https://api.github.com/repos/openai/codex/git/trees/693e912b3653024d75838e3fbcda5dfaf51b4d9f"},"url":"https://api.github.com/repos/openai/codex/git/commits/a68d0a74bd38ddc01361ce42262da689b788afce","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a68d0a74bd38ddc01361ce42262da689b788afce","html_url":"https://github.com/openai/codex/commit/a68d0a74bd38ddc01361ce42262da689b788afce","comments_url":"https://api.github.com/repos/openai/codex/commits/a68d0a74bd38ddc01361ce42262da689b788afce/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"e597169e9a783156e50ae9765d891a3dd74df064","url":"https://api.github.com/repos/openai/codex/commits/e597169e9a783156e50ae9765d891a3dd74df064","html_url":"https://github.com/openai/codex/commit/e597169e9a783156e50ae9765d891a3dd74df064"}]},{"sha":"e597169e9a783156e50ae9765d891a3dd74df064","node_id":"C_kwDOOYsS4doAKGU1OTcxNjllOWE3ODMxNTZlNTBhZTk3NjVkODkxYTNkZDc0ZGYwNjQ","commit":{"author":{"name":"Tamir Duberstein","email":"tamird@openai.com","date":"2026-07-28T09:36:31Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T09:41:52Z"},"message":"Keep agent registry identities consistent (#35744)\n\n## Why\n\nAn agent can be registered again with restored path metadata after a root thread\nresumes. Leaving its previous registry entry behind can make later lookup and\nrelease operations act on stale metadata.\n\n## What changed\n\n- Add a thread-to-path index alongside the agent tree.\n- Keep both indexes synchronized when root and spawned agents are registered,\n  replaced, moved between paths, or released.\n- Preserve other restored siblings when one agent is closed, while still\n  allowing a surviving sibling to be reloaded for follow-up work.\n\n## Testing\n\nAdd registry coverage for replacement, release, and path migration, plus resume\ntests with multiple sibling agents.\n\nGitOrigin-RevId: 1c1acf422884a6842d9bbdf89ba993d98187770d","tree":{"sha":"87617fa56c49d2cbcc335a4adc61843a2d4d114e","url":"https://api.github.com/repos/openai/codex/git/trees/87617fa56c49d2cbcc335a4adc61843a2d4d114e"},"url":"https://api.github.com/repos/openai/codex/git/commits/e597169e9a783156e50ae9765d891a3dd74df064","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/e597169e9a783156e50ae9765d891a3dd74df064","html_url":"https://github.com/openai/codex/commit/e597169e9a783156e50ae9765d891a3dd74df064","comments_url":"https://api.github.com/repos/openai/codex/commits/e597169e9a783156e50ae9765d891a3dd74df064/comments","author":{"login":"tamird","id":1535036,"node_id":"MDQ6VXNlcjE1MzUwMzY=","avatar_url":"https://avatars.githubusercontent.com/u/1535036?v=4","gravatar_id":"","url":"https://api.github.com/users/tamird","html_url":"https://github.com/tamird","followers_url":"https://api.github.com/users/tamird/followers","following_url":"https://api.github.com/users/tamird/following{/other_user}","gists_url":"https://api.github.com/users/tamird/gists{/gist_id}","starred_url":"https://api.github.com/users/tamird/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tamird/subscriptions","organizations_url":"https://api.github.com/users/tamird/orgs","repos_url":"https://api.github.com/users/tamird/repos","events_url":"https://api.github.com/users/tamird/events{/privacy}","received_events_url":"https://api.github.com/users/tamird/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"d9e1c9cd5590e9b151e4cb5a82fd208f234b7422","url":"https://api.github.com/repos/openai/codex/commits/d9e1c9cd5590e9b151e4cb5a82fd208f234b7422","html_url":"https://github.com/openai/codex/commit/d9e1c9cd5590e9b151e4cb5a82fd208f234b7422"}]},{"sha":"d9e1c9cd5590e9b151e4cb5a82fd208f234b7422","node_id":"C_kwDOOYsS4doAKGQ5ZTFjOWNkNTU5MGU5YjE1MWU0Y2I1YTgyZmQyMDhmMjM0Yjc0MjI","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-28T09:27:42Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T09:32:48Z"},"message":"Avoid blocking turns on optional MCP startup (#35742)\n\n## Why\n\nA pending optional MCP server can delay the first model request even when the\nturn does not need that server.\n\n## What changed\n\n- Give optional MCP servers a shared one-second startup grace, then omit servers\n  that are still pending from the captured tool catalog.\n- Continue waiting when the turn explicitly requires a server through a plugin,\n  skill dependency, or `mcp://` mention, and preserve this behavior for input\n  received between sampling steps.\n- Route direct resource requests to the live connection set when a pending\n  server was omitted from the binding, while keeping all-server resource\n  discovery non-blocking.\n\n## Testing\n\n- Cover the shared grace period and resource behavior for pending optional\n  servers.\n- Verify plugin, plugin-skill, and direct MCP mentions wait for startup.\n- Verify an Apps-enabled turn proceeds without tools from an unrelated pending\n  optional server.\n\nGitOrigin-RevId: b5f895c5a5362fe73f7d33250367662d4a217e4d","tree":{"sha":"3b96fb8f5e6dbd017ad97309d952b0ba6ff944c1","url":"https://api.github.com/repos/openai/codex/git/trees/3b96fb8f5e6dbd017ad97309d952b0ba6ff944c1"},"url":"https://api.github.com/repos/openai/codex/git/commits/d9e1c9cd5590e9b151e4cb5a82fd208f234b7422","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/d9e1c9cd5590e9b151e4cb5a82fd208f234b7422","html_url":"https://github.com/openai/codex/commit/d9e1c9cd5590e9b151e4cb5a82fd208f234b7422","comments_url":"https://api.github.com/repos/openai/codex/commits/d9e1c9cd5590e9b151e4cb5a82fd208f234b7422/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"8e271dc02b23d42827875019924be0f5005642b0","url":"https://api.github.com/repos/openai/codex/commits/8e271dc02b23d42827875019924be0f5005642b0","html_url":"https://github.com/openai/codex/commit/8e271dc02b23d42827875019924be0f5005642b0"}]},{"sha":"8e271dc02b23d42827875019924be0f5005642b0","node_id":"C_kwDOOYsS4doAKDhlMjcxZGMwMmIyM2Q0MjgyNzg3NTAxOTkyNGJlMGY1MDA1NjQyYjA","commit":{"author":{"name":"ningyi-oai","email":"ningyi@openai.com","date":"2026-07-28T07:53:13Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T07:58:10Z"},"message":"Add bounded metadata for executed tool calls (#35738)\n\n## What changed\n\n- Add protocol types and `ResponseItem` helpers for attaching and clearing\n  locally recorded tool-call names and arguments.\n- Bound serialized metadata across a prompt, replacing oversized arguments and\n  omitted calls with trusted truncation details.\n- Prevent deserialized response items or model-provided arguments from forging\n  locally generated tool-call and truncation metadata.\n\n## Testing\n\n- Cover prompt-wide size limits, omission accounting, idempotent bounding, and\n  forged truncation markers.\n\nGitOrigin-RevId: 960a223437ce81fe6b4cbb5fc7a9774408b2755b","tree":{"sha":"a338d50600406bde5f68db05c1c1a9dda3702989","url":"https://api.github.com/repos/openai/codex/git/trees/a338d50600406bde5f68db05c1c1a9dda3702989"},"url":"https://api.github.com/repos/openai/codex/git/commits/8e271dc02b23d42827875019924be0f5005642b0","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/8e271dc02b23d42827875019924be0f5005642b0","html_url":"https://github.com/openai/codex/commit/8e271dc02b23d42827875019924be0f5005642b0","comments_url":"https://api.github.com/repos/openai/codex/commits/8e271dc02b23d42827875019924be0f5005642b0/comments","author":{"login":"ningyi-oai","id":242065200,"node_id":"U_kgDODm2fMA","avatar_url":"https://avatars.githubusercontent.com/u/242065200?v=4","gravatar_id":"","url":"https://api.github.com/users/ningyi-oai","html_url":"https://github.com/ningyi-oai","followers_url":"https://api.github.com/users/ningyi-oai/followers","following_url":"https://api.github.com/users/ningyi-oai/following{/other_user}","gists_url":"https://api.github.com/users/ningyi-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/ningyi-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ningyi-oai/subscriptions","organizations_url":"https://api.github.com/users/ningyi-oai/orgs","repos_url":"https://api.github.com/users/ningyi-oai/repos","events_url":"https://api.github.com/users/ningyi-oai/events{/privacy}","received_events_url":"https://api.github.com/users/ningyi-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"f2bee854a73666e1c3e922a853dda591b1a25fcf","url":"https://api.github.com/repos/openai/codex/commits/f2bee854a73666e1c3e922a853dda591b1a25fcf","html_url":"https://github.com/openai/codex/commit/f2bee854a73666e1c3e922a853dda591b1a25fcf"}]},{"sha":"f2bee854a73666e1c3e922a853dda591b1a25fcf","node_id":"C_kwDOOYsS4doAKGYyYmVlODU0YTczNjY2ZTFjM2U5MjJhODUzZGRhNTkxYjFhMjVmY2Y","commit":{"author":{"name":"thomas","email":"tsarlandie@openai.com","date":"2026-07-28T06:00:04Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T06:06:58Z"},"message":"Complete MCP 2026 client support (#35725)\n\n## What changed\n\n- Drive multi-round `tools/call` and `resources/read` requests through\n  `input_required` responses, preserving opaque request state and elicitation\n  metadata across JSON, SSE, and stdio transports.\n- Decode modern discovery and elicitation result shapes while retaining legacy\n  initialization, elicitation defaults, and discovery fallback behavior.\n- Apply the 8 MiB modern-protocol response limit to JSON, SSE events, and stdio\n  messages, and reject executor stream recovery when output sequence gaps would\n  corrupt the protocol stream.\n\n## Testing\n\nAdded integration coverage for discovery, multi-round requests, legacy\nfallbacks, message limits, stdio launchers, SSE responses, session recovery,\nand executor output recovery.\n\nGitOrigin-RevId: d26a08883a2825e8ce2408ac498114b33859225e","tree":{"sha":"f72a983980f6bda9f56d281f4221973c43464da3","url":"https://api.github.com/repos/openai/codex/git/trees/f72a983980f6bda9f56d281f4221973c43464da3"},"url":"https://api.github.com/repos/openai/codex/git/commits/f2bee854a73666e1c3e922a853dda591b1a25fcf","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/f2bee854a73666e1c3e922a853dda591b1a25fcf","html_url":"https://github.com/openai/codex/commit/f2bee854a73666e1c3e922a853dda591b1a25fcf","comments_url":"https://api.github.com/repos/openai/codex/commits/f2bee854a73666e1c3e922a853dda591b1a25fcf/comments","author":{"login":"tsarlandie-oai","id":291887306,"node_id":"U_kgDOEWXYyg","avatar_url":"https://avatars.githubusercontent.com/u/291887306?v=4","gravatar_id":"","url":"https://api.github.com/users/tsarlandie-oai","html_url":"https://github.com/tsarlandie-oai","followers_url":"https://api.github.com/users/tsarlandie-oai/followers","following_url":"https://api.github.com/users/tsarlandie-oai/following{/other_user}","gists_url":"https://api.github.com/users/tsarlandie-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/tsarlandie-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tsarlandie-oai/subscriptions","organizations_url":"https://api.github.com/users/tsarlandie-oai/orgs","repos_url":"https://api.github.com/users/tsarlandie-oai/repos","events_url":"https://api.github.com/users/tsarlandie-oai/events{/privacy}","received_events_url":"https://api.github.com/users/tsarlandie-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"be2e4afcd7392339d6adbaf0d31b26316bcaa2ab","url":"https://api.github.com/repos/openai/codex/commits/be2e4afcd7392339d6adbaf0d31b26316bcaa2ab","html_url":"https://github.com/openai/codex/commit/be2e4afcd7392339d6adbaf0d31b26316bcaa2ab"}]},{"sha":"be2e4afcd7392339d6adbaf0d31b26316bcaa2ab","node_id":"C_kwDOOYsS4doAKGJlMmU0YWZjZDczOTIzMzlkNmFkYmFmMGQzMWIyNjMxNmJjYWEyYWI","commit":{"author":{"name":"thomas","email":"tsarlandie@openai.com","date":"2026-07-28T05:46:41Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T05:52:12Z"},"message":"Add MCP 2026-07-28 discovery support (#35724)\n\n## What changed\n\n- Add an opt-in `mcp_2026_07_28` protocol mode while preserving the legacy\n  lifecycle by default.\n- Negotiate the new protocol over streamable HTTP with `server/discover`,\n  including bounded responses, redirect protection, and fallback only when a\n  response establishes that the endpoint is legacy-only.\n- Require stdio servers to opt in with\n  `CODEX_MCP_PROTOCOL_VERSION=2026-07-28`, and add a bounded local stdio\n  transport for the modern lifecycle.\n- Consume paginated tool, resource, and resource-template catalogs in modern\n  mode, reject repeated cursors, and retain discovered server identity.\n- Reconnect reusable MCP clients when their selected protocol mode changes.\n\n## Testing\n\n- Cover HTTP JSON and SSE discovery, legacy fallback and rejection cases,\n  redirects, retries, response limits, and pagination.\n- Cover local and executor stdio discovery, protocol markers, message limits,\n  and legacy compatibility.\n\nGitOrigin-RevId: f6a78816e127d2a482292d63b91c8384f1595903","tree":{"sha":"4fc3edc15cb6d549be15374b083b17a3f7bf0a3c","url":"https://api.github.com/repos/openai/codex/git/trees/4fc3edc15cb6d549be15374b083b17a3f7bf0a3c"},"url":"https://api.github.com/repos/openai/codex/git/commits/be2e4afcd7392339d6adbaf0d31b26316bcaa2ab","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/be2e4afcd7392339d6adbaf0d31b26316bcaa2ab","html_url":"https://github.com/openai/codex/commit/be2e4afcd7392339d6adbaf0d31b26316bcaa2ab","comments_url":"https://api.github.com/repos/openai/codex/commits/be2e4afcd7392339d6adbaf0d31b26316bcaa2ab/comments","author":{"login":"tsarlandie-oai","id":291887306,"node_id":"U_kgDOEWXYyg","avatar_url":"https://avatars.githubusercontent.com/u/291887306?v=4","gravatar_id":"","url":"https://api.github.com/users/tsarlandie-oai","html_url":"https://github.com/tsarlandie-oai","followers_url":"https://api.github.com/users/tsarlandie-oai/followers","following_url":"https://api.github.com/users/tsarlandie-oai/following{/other_user}","gists_url":"https://api.github.com/users/tsarlandie-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/tsarlandie-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tsarlandie-oai/subscriptions","organizations_url":"https://api.github.com/users/tsarlandie-oai/orgs","repos_url":"https://api.github.com/users/tsarlandie-oai/repos","events_url":"https://api.github.com/users/tsarlandie-oai/events{/privacy}","received_events_url":"https://api.github.com/users/tsarlandie-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"85c6da1c7931310a99e3dbc4e2e0de8f17e34f13","url":"https://api.github.com/repos/openai/codex/commits/85c6da1c7931310a99e3dbc4e2e0de8f17e34f13","html_url":"https://github.com/openai/codex/commit/85c6da1c7931310a99e3dbc4e2e0de8f17e34f13"}]},{"sha":"85c6da1c7931310a99e3dbc4e2e0de8f17e34f13","node_id":"C_kwDOOYsS4doAKDg1YzZkYTFjNzkzMTMxMGE5OWUzZGJjNGUyZTBkZThmMTdlMzRmMTM","commit":{"author":{"name":"joeytrasatti-openai","email":"joey.trasatti@openai.com","date":"2026-07-28T05:13:12Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T05:26:16Z"},"message":"Add persisted sections for organizing threads (#35722)\n\n## What changed\n\n- Replace the `isPinned` thread metadata and filters with an optional persisted\n  `section` and `sectionId`.\n- Add the paginated `threadSection/list` app-server method so clients can\n  discover sections even when they contain no threads.\n- Seed a stable `Pinned` section, validate section assignments, and support\n  filtering for a specific section or for unsectioned threads.\n\n## Testing\n\n- Cover section protocol serialization, listing and pagination, metadata\n  updates, filtering, persistence, migration compatibility, and operation\n  without SQLite state.\n\nGitOrigin-RevId: 7972b5471d29317b9387bfd90aa9f573f691ad4c","tree":{"sha":"4492019dc71078afc28f52d902365f54c385db41","url":"https://api.github.com/repos/openai/codex/git/trees/4492019dc71078afc28f52d902365f54c385db41"},"url":"https://api.github.com/repos/openai/codex/git/commits/85c6da1c7931310a99e3dbc4e2e0de8f17e34f13","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/85c6da1c7931310a99e3dbc4e2e0de8f17e34f13","html_url":"https://github.com/openai/codex/commit/85c6da1c7931310a99e3dbc4e2e0de8f17e34f13","comments_url":"https://api.github.com/repos/openai/codex/commits/85c6da1c7931310a99e3dbc4e2e0de8f17e34f13/comments","author":{"login":"joeytrasatti-openai","id":187452053,"node_id":"U_kgDOCyxKlQ","avatar_url":"https://avatars.githubusercontent.com/u/187452053?v=4","gravatar_id":"","url":"https://api.github.com/users/joeytrasatti-openai","html_url":"https://github.com/joeytrasatti-openai","followers_url":"https://api.github.com/users/joeytrasatti-openai/followers","following_url":"https://api.github.com/users/joeytrasatti-openai/following{/other_user}","gists_url":"https://api.github.com/users/joeytrasatti-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/joeytrasatti-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/joeytrasatti-openai/subscriptions","organizations_url":"https://api.github.com/users/joeytrasatti-openai/orgs","repos_url":"https://api.github.com/users/joeytrasatti-openai/repos","events_url":"https://api.github.com/users/joeytrasatti-openai/events{/privacy}","received_events_url":"https://api.github.com/users/joeytrasatti-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"9291a123fb96ca7d11eae27bcdecec06dcbe0d14","url":"https://api.github.com/repos/openai/codex/commits/9291a123fb96ca7d11eae27bcdecec06dcbe0d14","html_url":"https://github.com/openai/codex/commit/9291a123fb96ca7d11eae27bcdecec06dcbe0d14"}]},{"sha":"9291a123fb96ca7d11eae27bcdecec06dcbe0d14","node_id":"C_kwDOOYsS4doAKDkyOTFhMTIzZmI5NmNhN2QxMWVhZTI3YmNkZWNlYzA2ZGNiZTBkMTQ","commit":{"author":{"name":"Channing Conger","email":"cconger@openai.com","date":"2026-07-28T05:13:06Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T05:22:02Z"},"message":"Honor disabled code mode fallback without a process host (#35721)\n\n## Why\n\nWhen the code mode host feature was disabled, thread startup always selected the in-process provider, even when `disable_in_process_fallback` was set.\n\n## What changed\n\n- Select a disabled provider when both the process host and in-process fallback are disabled.\n- Return a clear tool error instead of running code mode in process for that configuration.\n\n## Testing\n\nAdded an integration test covering code mode with the process host feature and in-process fallback both disabled.\n\nGitOrigin-RevId: 3ed80afc23e0a5518c0133fe337a37b1fa545ead","tree":{"sha":"221f2703d93d78a0055d491ae89cb9bf94247eb9","url":"https://api.github.com/repos/openai/codex/git/trees/221f2703d93d78a0055d491ae89cb9bf94247eb9"},"url":"https://api.github.com/repos/openai/codex/git/commits/9291a123fb96ca7d11eae27bcdecec06dcbe0d14","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/9291a123fb96ca7d11eae27bcdecec06dcbe0d14","html_url":"https://github.com/openai/codex/commit/9291a123fb96ca7d11eae27bcdecec06dcbe0d14","comments_url":"https://api.github.com/repos/openai/codex/commits/9291a123fb96ca7d11eae27bcdecec06dcbe0d14/comments","author":{"login":"cconger","id":200563,"node_id":"MDQ6VXNlcjIwMDU2Mw==","avatar_url":"https://avatars.githubusercontent.com/u/200563?v=4","gravatar_id":"","url":"https://api.github.com/users/cconger","html_url":"https://github.com/cconger","followers_url":"https://api.github.com/users/cconger/followers","following_url":"https://api.github.com/users/cconger/following{/other_user}","gists_url":"https://api.github.com/users/cconger/gists{/gist_id}","starred_url":"https://api.github.com/users/cconger/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cconger/subscriptions","organizations_url":"https://api.github.com/users/cconger/orgs","repos_url":"https://api.github.com/users/cconger/repos","events_url":"https://api.github.com/users/cconger/events{/privacy}","received_events_url":"https://api.github.com/users/cconger/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"61de0d8fe812137cec943d58309b26df1dd227b5","url":"https://api.github.com/repos/openai/codex/commits/61de0d8fe812137cec943d58309b26df1dd227b5","html_url":"https://github.com/openai/codex/commit/61de0d8fe812137cec943d58309b26df1dd227b5"}]},{"sha":"61de0d8fe812137cec943d58309b26df1dd227b5","node_id":"C_kwDOOYsS4doAKDYxZGUwZDhmZTgxMjEzN2NlYzk0M2Q1ODMwOWIyNmRmMWRkMjI3YjU","commit":{"author":{"name":"thomas","email":"tsarlandie@openai.com","date":"2026-07-28T05:12:24Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T05:17:25Z"},"message":"Upgrade rmcp to 3.0.0-beta.3 (#35720)\n\n## What changed\n\n- Update the `rmcp` model and transport integrations for `3.0.0-beta.3`.\n- Preserve legacy `elicitation/create` form requests, schema defaults, metadata, and wire-format compatibility while adopting the new elicitation types.\n- Harden OAuth discovery by using GET-first discovery without starting an MCP session, preventing cross-origin header redirects, validating authorization-server and callback issuers, and retaining compatibility with metadata that omits an issuer.\n- Keep stored OAuth credentials readable and avoid requiring reauthorization after transient refresh failures.\n\n## Testing\n\n- Add coverage for legacy elicitation round trips, OAuth discovery variants, callback issuer validation, credential migration, and refresh failures.\n\nGitOrigin-RevId: 756197d26f3fd347c28c400228f6b3d06ed493b7","tree":{"sha":"ae06864dfb1d590033077eff11636b0625e2f6b2","url":"https://api.github.com/repos/openai/codex/git/trees/ae06864dfb1d590033077eff11636b0625e2f6b2"},"url":"https://api.github.com/repos/openai/codex/git/commits/61de0d8fe812137cec943d58309b26df1dd227b5","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/61de0d8fe812137cec943d58309b26df1dd227b5","html_url":"https://github.com/openai/codex/commit/61de0d8fe812137cec943d58309b26df1dd227b5","comments_url":"https://api.github.com/repos/openai/codex/commits/61de0d8fe812137cec943d58309b26df1dd227b5/comments","author":{"login":"tsarlandie-oai","id":291887306,"node_id":"U_kgDOEWXYyg","avatar_url":"https://avatars.githubusercontent.com/u/291887306?v=4","gravatar_id":"","url":"https://api.github.com/users/tsarlandie-oai","html_url":"https://github.com/tsarlandie-oai","followers_url":"https://api.github.com/users/tsarlandie-oai/followers","following_url":"https://api.github.com/users/tsarlandie-oai/following{/other_user}","gists_url":"https://api.github.com/users/tsarlandie-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/tsarlandie-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tsarlandie-oai/subscriptions","organizations_url":"https://api.github.com/users/tsarlandie-oai/orgs","repos_url":"https://api.github.com/users/tsarlandie-oai/repos","events_url":"https://api.github.com/users/tsarlandie-oai/events{/privacy}","received_events_url":"https://api.github.com/users/tsarlandie-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"899539c03ac46301c8e860bc0096854f57625b82","url":"https://api.github.com/repos/openai/codex/commits/899539c03ac46301c8e860bc0096854f57625b82","html_url":"https://github.com/openai/codex/commit/899539c03ac46301c8e860bc0096854f57625b82"}]},{"sha":"899539c03ac46301c8e860bc0096854f57625b82","node_id":"C_kwDOOYsS4doAKDg5OTUzOWMwM2FjNDYzMDFjOGU4NjBiYzAwOTY4NTRmNTc2MjViODI","commit":{"author":{"name":"Celia Chen","email":"celia@openai.com","date":"2026-07-28T04:49:36Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T04:54:32Z"},"message":"Reuse route-aware clients for OpenAI file uploads (#35717)\n\n## What changed\n\n- Store a request-logging-disabled `RouteAwareClientPool` in session services and use it for file creation, blob upload, and finalization requests.\n- Preserve the existing system-root fallback for transport-default proxy routes, and emit a warning event when that fallback is used.\n- Remove the direct `reqwest` dependency from `codex-api` now that uploads use the shared HTTP abstraction.\n\n## Testing\n\n- Add coverage for completing multiple uploads through a shared client pool.\n\nGitOrigin-RevId: 01842415cad2d349a6bd3869abb3332e8110ebce","tree":{"sha":"38b3476ca5c4e8c0fca3352a035fd65f09fed6ed","url":"https://api.github.com/repos/openai/codex/git/trees/38b3476ca5c4e8c0fca3352a035fd65f09fed6ed"},"url":"https://api.github.com/repos/openai/codex/git/commits/899539c03ac46301c8e860bc0096854f57625b82","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/899539c03ac46301c8e860bc0096854f57625b82","html_url":"https://github.com/openai/codex/commit/899539c03ac46301c8e860bc0096854f57625b82","comments_url":"https://api.github.com/repos/openai/codex/commits/899539c03ac46301c8e860bc0096854f57625b82/comments","author":{"login":"celia-oai","id":209693228,"node_id":"U_kgDODH-qLA","avatar_url":"https://avatars.githubusercontent.com/u/209693228?v=4","gravatar_id":"","url":"https://api.github.com/users/celia-oai","html_url":"https://github.com/celia-oai","followers_url":"https://api.github.com/users/celia-oai/followers","following_url":"https://api.github.com/users/celia-oai/following{/other_user}","gists_url":"https://api.github.com/users/celia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/celia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celia-oai/subscriptions","organizations_url":"https://api.github.com/users/celia-oai/orgs","repos_url":"https://api.github.com/users/celia-oai/repos","events_url":"https://api.github.com/users/celia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/celia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"2494d939cfb33f95cbce61ac7283193861960577","url":"https://api.github.com/repos/openai/codex/commits/2494d939cfb33f95cbce61ac7283193861960577","html_url":"https://github.com/openai/codex/commit/2494d939cfb33f95cbce61ac7283193861960577"}]},{"sha":"2494d939cfb33f95cbce61ac7283193861960577","node_id":"C_kwDOOYsS4doAKDI0OTRkOTM5Y2ZiMzNmOTVjYmNlNjFhYzcyODMxOTM4NjE5NjA1Nzc","commit":{"author":{"name":"Celia Chen","email":"celia@openai.com","date":"2026-07-28T04:16:49Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T04:21:28Z"},"message":"Support streaming bodies in route-aware HTTP requests (#35715)\n\n## What changed\n\n- Add `RouteAwareRequestBuilder::body_stream` for sending fallible byte streams without exposing the underlying HTTP client body type.\n- Expose request- and body-error classification on `RouteAwareRequestError`.\n- Add `RouteAwareRequestError::without_url` so callers can remove credential-bearing URLs, such as signed upload URLs, from transport errors.\n\n## Testing\n\n- Verify streamed request bytes reach the server.\n- Verify URL secrets are absent after stripping a transport error's URL.\n\nGitOrigin-RevId: 6a100f56a9aa7d79d9b6dd0f103135f5f2060617","tree":{"sha":"dd6c9d43d1e93b329b1cd616b1abb2af0ebfcd51","url":"https://api.github.com/repos/openai/codex/git/trees/dd6c9d43d1e93b329b1cd616b1abb2af0ebfcd51"},"url":"https://api.github.com/repos/openai/codex/git/commits/2494d939cfb33f95cbce61ac7283193861960577","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/2494d939cfb33f95cbce61ac7283193861960577","html_url":"https://github.com/openai/codex/commit/2494d939cfb33f95cbce61ac7283193861960577","comments_url":"https://api.github.com/repos/openai/codex/commits/2494d939cfb33f95cbce61ac7283193861960577/comments","author":{"login":"celia-oai","id":209693228,"node_id":"U_kgDODH-qLA","avatar_url":"https://avatars.githubusercontent.com/u/209693228?v=4","gravatar_id":"","url":"https://api.github.com/users/celia-oai","html_url":"https://github.com/celia-oai","followers_url":"https://api.github.com/users/celia-oai/followers","following_url":"https://api.github.com/users/celia-oai/following{/other_user}","gists_url":"https://api.github.com/users/celia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/celia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celia-oai/subscriptions","organizations_url":"https://api.github.com/users/celia-oai/orgs","repos_url":"https://api.github.com/users/celia-oai/repos","events_url":"https://api.github.com/users/celia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/celia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"49025589b0216b876b1a6a20977536c7d55cdb8b","url":"https://api.github.com/repos/openai/codex/commits/49025589b0216b876b1a6a20977536c7d55cdb8b","html_url":"https://github.com/openai/codex/commit/49025589b0216b876b1a6a20977536c7d55cdb8b"}]},{"sha":"49025589b0216b876b1a6a20977536c7d55cdb8b","node_id":"C_kwDOOYsS4doAKDQ5MDI1NTg5YjAyMTZiODc2YjFhNmEyMDk3NzUzNmM3ZDU1Y2RiOGI","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-07-28T03:28:50Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T03:33:31Z"},"message":"Add configurable developer instructions for v2 subagents (#35708)\n\n## What changed\n\n- Add `features.multi_agent_v2.subagent_developer_instructions` to override inherited developer instructions for subagents that do not define role-specific instructions.\n- Preserve role-specific instructions as the higher-precedence setting, and carry the effective instructions through full and bounded forks, compacted histories, and cold resume without duplication.\n- Treat an unset override as inheritance and a blank override as clearing inherited instructions.\n\n## Testing\n\n- Cover configuration parsing and materialization, instruction precedence, fork modes, compaction, role application, and resumed subagents.\n\nGitOrigin-RevId: 32321e61abc59b14a1be5f31e6bd6570bb1cd89d","tree":{"sha":"77a7fb73357054ab65ed21a4ead6dfc2b55142a4","url":"https://api.github.com/repos/openai/codex/git/trees/77a7fb73357054ab65ed21a4ead6dfc2b55142a4"},"url":"https://api.github.com/repos/openai/codex/git/commits/49025589b0216b876b1a6a20977536c7d55cdb8b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/49025589b0216b876b1a6a20977536c7d55cdb8b","html_url":"https://github.com/openai/codex/commit/49025589b0216b876b1a6a20977536c7d55cdb8b","comments_url":"https://api.github.com/repos/openai/codex/commits/49025589b0216b876b1a6a20977536c7d55cdb8b/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"3418498f01422f5f650ea645d4bd19e05c3a9616","url":"https://api.github.com/repos/openai/codex/commits/3418498f01422f5f650ea645d4bd19e05c3a9616","html_url":"https://github.com/openai/codex/commit/3418498f01422f5f650ea645d4bd19e05c3a9616"}]},{"sha":"3418498f01422f5f650ea645d4bd19e05c3a9616","node_id":"C_kwDOOYsS4doAKDM0MTg0OThmMDE0MjJmNWY2NTBlYTY0NWQ0YmQxOWUwNWMzYTk2MTY","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-07-28T01:11:56Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T01:17:52Z"},"message":"Honor the configured SQLite home in the logs client (#35695)\n\n## Why\n\n`just log` derived the logs database path from `CODEX_HOME`, so it could read\nthe wrong database when `sqlite_home` or `CODEX_SQLITE_HOME` selected a\ndifferent location.\n\n## What changed\n\n- Move `logs_client` into `codex-cli` so it can resolve the shared\n  `SqliteConfig` through the standard configuration loader.\n- Keep `--db` as a direct override that skips config loading and preserves\n  native path bytes.\n- Update the `just log` recipes to run the client from its new crate.\n\n## Testing\n\n- Add coverage for bypassing invalid Codex config with `--db`.\n- Add Unix coverage for non-UTF-8 database paths.\n\nGitOrigin-RevId: fabd64a66543be26a6f5d3b5e509016c3270350e","tree":{"sha":"acf1ff6a9c676462833301241624730490f30d65","url":"https://api.github.com/repos/openai/codex/git/trees/acf1ff6a9c676462833301241624730490f30d65"},"url":"https://api.github.com/repos/openai/codex/git/commits/3418498f01422f5f650ea645d4bd19e05c3a9616","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/3418498f01422f5f650ea645d4bd19e05c3a9616","html_url":"https://github.com/openai/codex/commit/3418498f01422f5f650ea645d4bd19e05c3a9616","comments_url":"https://api.github.com/repos/openai/codex/commits/3418498f01422f5f650ea645d4bd19e05c3a9616/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"f029bb795ccbbd8471511f5a8b93e56d8f2b6d31","url":"https://api.github.com/repos/openai/codex/commits/f029bb795ccbbd8471511f5a8b93e56d8f2b6d31","html_url":"https://github.com/openai/codex/commit/f029bb795ccbbd8471511f5a8b93e56d8f2b6d31"}]},{"sha":"f029bb795ccbbd8471511f5a8b93e56d8f2b6d31","node_id":"C_kwDOOYsS4doAKGYwMjliYjc5NWNjYmJkODQ3MTUxMWY1YThiOTNlNTZkOGYyYjZkMzE","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-07-28T00:33:42Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T00:38:45Z"},"message":"Refresh the subagent picker in the background (#35693)\n\n## Why\n\nOpening the subagent picker could wait on thread metadata and live event-store locks, delaying terminal input. Its cached entries could also omit descendants that were not observed in the current TUI session.\n\n## What changed\n\n- Render the picker immediately from cached navigation state and refresh root descendants asynchronously with `thread/list`.\n- Merge discovered descendants into an open picker while preserving its selection and live status, and coalesce concurrent refresh requests.\n- Ignore refresh responses from a previous session and avoid blocking on busy event stores.\n\n## Testing\n\n- Extend session lifecycle coverage for nonblocking picker opens, refresh coalescing, descendant discovery, selection preservation, and status updates.\n- Add coverage for rejecting a refresh response after navigation state is cleared.\n\nGitOrigin-RevId: 7eae7f696f8d2d323a47b3fd2800ea1c1cdbf2a0","tree":{"sha":"25b4379dad10f2e69ecb007cda59045c8ebba4bc","url":"https://api.github.com/repos/openai/codex/git/trees/25b4379dad10f2e69ecb007cda59045c8ebba4bc"},"url":"https://api.github.com/repos/openai/codex/git/commits/f029bb795ccbbd8471511f5a8b93e56d8f2b6d31","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/f029bb795ccbbd8471511f5a8b93e56d8f2b6d31","html_url":"https://github.com/openai/codex/commit/f029bb795ccbbd8471511f5a8b93e56d8f2b6d31","comments_url":"https://api.github.com/repos/openai/codex/commits/f029bb795ccbbd8471511f5a8b93e56d8f2b6d31/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"63682c4e1ad8b4341b93a5e68c666f521806eb98","url":"https://api.github.com/repos/openai/codex/commits/63682c4e1ad8b4341b93a5e68c666f521806eb98","html_url":"https://github.com/openai/codex/commit/63682c4e1ad8b4341b93a5e68c666f521806eb98"}]},{"sha":"63682c4e1ad8b4341b93a5e68c666f521806eb98","node_id":"C_kwDOOYsS4doAKDYzNjgyYzRlMWFkOGI0MzQxYjkzYTVlNjhjNjY2ZjUyMTgwNmViOTg","commit":{"author":{"name":"Tamir Duberstein","email":"tamird@openai.com","date":"2026-07-28T00:19:48Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T00:24:52Z"},"message":"Include empty-preview threads in relationship listings (#35691)\n\n## What changed\n\n- Include threads without preview text when listing direct children or descendants from the persisted spawn graph.\n- Continue filtering those threads out of the global thread list.\n\n## Testing\n\n- Extend the relationship pagination test to cover an empty-preview child in direct-child and descendant results.\n\nGitOrigin-RevId: c2e7bb04c5f64558a48b1d7877bd24edaa364bb4","tree":{"sha":"9f5296f2eafff81a5c64e8c04a0145b0a8614ded","url":"https://api.github.com/repos/openai/codex/git/trees/9f5296f2eafff81a5c64e8c04a0145b0a8614ded"},"url":"https://api.github.com/repos/openai/codex/git/commits/63682c4e1ad8b4341b93a5e68c666f521806eb98","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/63682c4e1ad8b4341b93a5e68c666f521806eb98","html_url":"https://github.com/openai/codex/commit/63682c4e1ad8b4341b93a5e68c666f521806eb98","comments_url":"https://api.github.com/repos/openai/codex/commits/63682c4e1ad8b4341b93a5e68c666f521806eb98/comments","author":{"login":"tamird","id":1535036,"node_id":"MDQ6VXNlcjE1MzUwMzY=","avatar_url":"https://avatars.githubusercontent.com/u/1535036?v=4","gravatar_id":"","url":"https://api.github.com/users/tamird","html_url":"https://github.com/tamird","followers_url":"https://api.github.com/users/tamird/followers","following_url":"https://api.github.com/users/tamird/following{/other_user}","gists_url":"https://api.github.com/users/tamird/gists{/gist_id}","starred_url":"https://api.github.com/users/tamird/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tamird/subscriptions","organizations_url":"https://api.github.com/users/tamird/orgs","repos_url":"https://api.github.com/users/tamird/repos","events_url":"https://api.github.com/users/tamird/events{/privacy}","received_events_url":"https://api.github.com/users/tamird/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"8d6a91b1ff926bb6006aff94ef4f9e628863cc09","url":"https://api.github.com/repos/openai/codex/commits/8d6a91b1ff926bb6006aff94ef4f9e628863cc09","html_url":"https://github.com/openai/codex/commit/8d6a91b1ff926bb6006aff94ef4f9e628863cc09"}]},{"sha":"8d6a91b1ff926bb6006aff94ef4f9e628863cc09","node_id":"C_kwDOOYsS4doAKDhkNmE5MWIxZmY5MjZiYjYwMDZhZmY5NGVmNGY5ZTYyODg2M2NjMDk","commit":{"author":{"name":"Owen Lin","email":"owen@openai.com","date":"2026-07-28T00:08:38Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-28T00:14:22Z"},"message":"Preserve item timestamps in thread history projections (#35689)\n\n## What changed\n\n- Add optional start and completion timestamps to `ThreadHistoryItemChange`.\n- Populate them from canonical `ItemCompleted` records during stateless thread history projection.\n- Treat a zero completion timestamp as absent, and leave timestamps unset for legacy builder events that do not provide them.\n\n## Testing\n\n- Cover projected item timestamps, including missing start times and zero completion times.\n\nGitOrigin-RevId: 2187530f489ad3d86b6ab65faaaab1eab5357f1b","tree":{"sha":"0d35a1ebc10388dc95bb7eb35873733595e5b3d6","url":"https://api.github.com/repos/openai/codex/git/trees/0d35a1ebc10388dc95bb7eb35873733595e5b3d6"},"url":"https://api.github.com/repos/openai/codex/git/commits/8d6a91b1ff926bb6006aff94ef4f9e628863cc09","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/8d6a91b1ff926bb6006aff94ef4f9e628863cc09","html_url":"https://github.com/openai/codex/commit/8d6a91b1ff926bb6006aff94ef4f9e628863cc09","comments_url":"https://api.github.com/repos/openai/codex/commits/8d6a91b1ff926bb6006aff94ef4f9e628863cc09/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"8c72d61727de81ea6354ae55969612629a36c11d","url":"https://api.github.com/repos/openai/codex/commits/8c72d61727de81ea6354ae55969612629a36c11d","html_url":"https://github.com/openai/codex/commit/8c72d61727de81ea6354ae55969612629a36c11d"}]},{"sha":"8c72d61727de81ea6354ae55969612629a36c11d","node_id":"C_kwDOOYsS4doAKDhjNzJkNjE3MjdkZTgxZWE2MzU0YWU1NTk2OTYxMjYyOWEzNmMxMWQ","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-07-27T23:51:54Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T23:56:47Z"},"message":"Point crossterm patch to the OpenAI OSS fork (#35688)\n\n## What changed\n\n- Update the `crossterm` Cargo patch to use the OpenAI OSS fork while retaining the existing revision.\n- Refresh the Cargo and Bazel lockfiles and the `cargo-deny` Git-source allowlist for the new repository URL.\n\nGitOrigin-RevId: 96c70abca95b9c5c8f19d1bc2d30976c5797ba8c","tree":{"sha":"cbe91999ca797bc1bf90f97edd95985c49c94756","url":"https://api.github.com/repos/openai/codex/git/trees/cbe91999ca797bc1bf90f97edd95985c49c94756"},"url":"https://api.github.com/repos/openai/codex/git/commits/8c72d61727de81ea6354ae55969612629a36c11d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/8c72d61727de81ea6354ae55969612629a36c11d","html_url":"https://github.com/openai/codex/commit/8c72d61727de81ea6354ae55969612629a36c11d","comments_url":"https://api.github.com/repos/openai/codex/commits/8c72d61727de81ea6354ae55969612629a36c11d/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fb6aad9ae34116128e537696c24e35fe6548e1c2","url":"https://api.github.com/repos/openai/codex/commits/fb6aad9ae34116128e537696c24e35fe6548e1c2","html_url":"https://github.com/openai/codex/commit/fb6aad9ae34116128e537696c24e35fe6548e1c2"}]},{"sha":"fb6aad9ae34116128e537696c24e35fe6548e1c2","node_id":"C_kwDOOYsS4doAKGZiNmFhZDlhZTM0MTE2MTI4ZTUzNzY5NmMyNGUzNWZlNjU0OGUxYzI","commit":{"author":{"name":"viyatb-oai","email":"viyatb@openai.com","date":"2026-07-27T22:41:04Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T23:16:37Z"},"message":"Load cloud-managed profiles for `codex sandbox` (#35685)\n\n## What changed\n\n- Bootstrap the cloud configuration bundle when `codex sandbox` receives an\n  explicit permission profile together with `--include-managed-config`.\n- Pass the resulting managed requirements through sandbox configuration loading\n  so the requested cloud-managed permission profile is enforced.\n- Keep the default path from loading cloud-managed profiles when managed\n  configuration is not requested.\n\n## Testing\n\n- Add unit and subprocess coverage for fetching, caching, and enforcing a\n  cloud-managed permission profile.\n\nGitOrigin-RevId: dfe637af5895496ae88b8128ca2f5ec29341ad06","tree":{"sha":"ac211f976545f24bbf9420e928c69afeeed877f9","url":"https://api.github.com/repos/openai/codex/git/trees/ac211f976545f24bbf9420e928c69afeeed877f9"},"url":"https://api.github.com/repos/openai/codex/git/commits/fb6aad9ae34116128e537696c24e35fe6548e1c2","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fb6aad9ae34116128e537696c24e35fe6548e1c2","html_url":"https://github.com/openai/codex/commit/fb6aad9ae34116128e537696c24e35fe6548e1c2","comments_url":"https://api.github.com/repos/openai/codex/commits/fb6aad9ae34116128e537696c24e35fe6548e1c2/comments","author":{"login":"viyatb-oai","id":234056686,"node_id":"U_kgDODfNr7g","avatar_url":"https://avatars.githubusercontent.com/u/234056686?v=4","gravatar_id":"","url":"https://api.github.com/users/viyatb-oai","html_url":"https://github.com/viyatb-oai","followers_url":"https://api.github.com/users/viyatb-oai/followers","following_url":"https://api.github.com/users/viyatb-oai/following{/other_user}","gists_url":"https://api.github.com/users/viyatb-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/viyatb-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/viyatb-oai/subscriptions","organizations_url":"https://api.github.com/users/viyatb-oai/orgs","repos_url":"https://api.github.com/users/viyatb-oai/repos","events_url":"https://api.github.com/users/viyatb-oai/events{/privacy}","received_events_url":"https://api.github.com/users/viyatb-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4d1f66bf8199713e4a77ad55458bc6e3dcbef5c5","url":"https://api.github.com/repos/openai/codex/commits/4d1f66bf8199713e4a77ad55458bc6e3dcbef5c5","html_url":"https://github.com/openai/codex/commit/4d1f66bf8199713e4a77ad55458bc6e3dcbef5c5"}]},{"sha":"4d1f66bf8199713e4a77ad55458bc6e3dcbef5c5","node_id":"C_kwDOOYsS4doAKDRkMWY2NmJmODE5OTcxM2U0YTc3YWQ1NTQ1OGJjNmUzZGNiZWY1YzU","commit":{"author":{"name":"Owen Lin","email":"owen@openai.com","date":"2026-07-27T22:04:39Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T22:12:15Z"},"message":"Preserve paginated thread metadata across resumes (#35678)\n\n## Why\n\nPaginated rollout history may contain only a bounded suffix. Deriving display\nmetadata from that suffix can replace the thread's original preview, title, and\nfirst user message when the thread is read or resumed.\n\n## What changed\n\n- Use SQLite as the canonical source of display metadata for paginated thread\n  reads, including reads by an explicit rollout path.\n- Seed resume metadata tracking from the persisted values so appended history\n  fills only missing fields instead of overwriting existing ones.\n- Prefer an explicitly requested rollout path over a stale path stored in\n  SQLite while retaining the canonical metadata.\n\n## Testing\n\nAdded coverage for reads by ID and path, bounded-history resumes across app\nserver restarts, preservation of existing metadata, initialization of missing\nfields, and stale persisted rollout paths.\n\nGitOrigin-RevId: b393d0727afcba70fda7f50a6f2dcca0632745b4","tree":{"sha":"6cce0f7c70bf823bd5927e36f1759d45fa14f9d3","url":"https://api.github.com/repos/openai/codex/git/trees/6cce0f7c70bf823bd5927e36f1759d45fa14f9d3"},"url":"https://api.github.com/repos/openai/codex/git/commits/4d1f66bf8199713e4a77ad55458bc6e3dcbef5c5","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4d1f66bf8199713e4a77ad55458bc6e3dcbef5c5","html_url":"https://github.com/openai/codex/commit/4d1f66bf8199713e4a77ad55458bc6e3dcbef5c5","comments_url":"https://api.github.com/repos/openai/codex/commits/4d1f66bf8199713e4a77ad55458bc6e3dcbef5c5/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"bbeee9a40686975a1bfb5e8a4b6d98dccbb43dab","url":"https://api.github.com/repos/openai/codex/commits/bbeee9a40686975a1bfb5e8a4b6d98dccbb43dab","html_url":"https://github.com/openai/codex/commit/bbeee9a40686975a1bfb5e8a4b6d98dccbb43dab"}]},{"sha":"bbeee9a40686975a1bfb5e8a4b6d98dccbb43dab","node_id":"C_kwDOOYsS4doAKGJiZWVlOWE0MDY4Njk3NWExYmZiNWU4YTRiNmQ5OGRjY2JiNDNkYWI","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-07-27T21:38:38Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T21:43:27Z"},"message":"Prepare MCP and plugin recommendations concurrently (#35675)\n\n## Why\n\nTurn preparation waited for MCP discovery before requesting endpoint plugin\nrecommendations, adding their latencies together.\n\n## What changed\n\n- Prepare the MCP runtime and endpoint plugin recommendations concurrently.\n- Wait for both results before building tools and starting model sampling.\n- Cancel the combined preparation when the turn is interrupted.\n\n## Testing\n\n- Add coverage that gates MCP initialization and verifies recommendation fetching\n  overlaps it while the final request includes both results.\n- Verify interrupting concurrent preparation prevents model sampling.\n\nGitOrigin-RevId: 295ec268331bf05304e6b313925fd2b6c2ae4190","tree":{"sha":"2b1edb38f452b5be2e57373baab97b8ae39ff1bf","url":"https://api.github.com/repos/openai/codex/git/trees/2b1edb38f452b5be2e57373baab97b8ae39ff1bf"},"url":"https://api.github.com/repos/openai/codex/git/commits/bbeee9a40686975a1bfb5e8a4b6d98dccbb43dab","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/bbeee9a40686975a1bfb5e8a4b6d98dccbb43dab","html_url":"https://github.com/openai/codex/commit/bbeee9a40686975a1bfb5e8a4b6d98dccbb43dab","comments_url":"https://api.github.com/repos/openai/codex/commits/bbeee9a40686975a1bfb5e8a4b6d98dccbb43dab/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"294d813263de08061cb303e7b601d7ea6a5e72e8","url":"https://api.github.com/repos/openai/codex/commits/294d813263de08061cb303e7b601d7ea6a5e72e8","html_url":"https://github.com/openai/codex/commit/294d813263de08061cb303e7b601d7ea6a5e72e8"}]},{"sha":"294d813263de08061cb303e7b601d7ea6a5e72e8","node_id":"C_kwDOOYsS4doAKDI5NGQ4MTMyNjNkZTA4MDYxY2IzMDNlN2I2MDFkN2VhNmE1ZTcyZTg","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-07-27T21:12:17Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T21:17:42Z"},"message":"Route curated plugins by authentication mode (#35671)\n\n## Why\n\nCurated plugin capabilities need to follow the active authentication mode, including after an account switch and when the configured model provider differs from the authentication source.\n\n## What changed\n\n- Select the ChatGPT, remote, or API curated marketplace from the current authentication mode, with an API marketplace fallback for ambient Amazon Bedrock credentials.\n- Apply that selection consistently to plugin loading, hooks, skills, installed-plugin conflict filtering, marketplace listing, and `codex mcp` discovery.\n- Start the local curated repository sync when an account change makes the remote catalog unavailable, and refresh existing thread MCP runtimes when the effective plugin cache changes.\n\n## Testing\n\nAdded coverage for account switches, ChatGPT-authenticated Bedrock sessions, API-key MCP discovery, curated marketplace filtering, hook and skill routing, and existing-thread MCP refreshes.\n\nGitOrigin-RevId: dbefdba3a3ea7281e7b6013e057a418770ccfc95","tree":{"sha":"5454b7e2337f11fb51620fc67b8a97c1ce3e87cb","url":"https://api.github.com/repos/openai/codex/git/trees/5454b7e2337f11fb51620fc67b8a97c1ce3e87cb"},"url":"https://api.github.com/repos/openai/codex/git/commits/294d813263de08061cb303e7b601d7ea6a5e72e8","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/294d813263de08061cb303e7b601d7ea6a5e72e8","html_url":"https://github.com/openai/codex/commit/294d813263de08061cb303e7b601d7ea6a5e72e8","comments_url":"https://api.github.com/repos/openai/codex/commits/294d813263de08061cb303e7b601d7ea6a5e72e8/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fd41e813cb5939029acab29cb5f2fb8ac8d8286d","url":"https://api.github.com/repos/openai/codex/commits/fd41e813cb5939029acab29cb5f2fb8ac8d8286d","html_url":"https://github.com/openai/codex/commit/fd41e813cb5939029acab29cb5f2fb8ac8d8286d"}]},{"sha":"fd41e813cb5939029acab29cb5f2fb8ac8d8286d","node_id":"C_kwDOOYsS4doAKGZkNDFlODEzY2I1OTM5MDI5YWNhYjI5Y2I1ZjJmYjhhYzhkODI4NmQ","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-07-27T21:06:17Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T21:12:00Z"},"message":"Raise the Windows exec yield floor to 10 seconds (#35670)\n\n## What changed\n\n- Clamp the initial `exec_command` yield time to at least 10 seconds on Windows.\n- Update the tool description and unit coverage for the new effective range.\n- Allow the Windows Ctrl-C integration test up to 20 seconds to complete.\n\nGitOrigin-RevId: 65d4d1c9a89dc9979e10d3e565af61c9f632c058","tree":{"sha":"766befaace4908999bf62cb0f16ed1fd28ea92eb","url":"https://api.github.com/repos/openai/codex/git/trees/766befaace4908999bf62cb0f16ed1fd28ea92eb"},"url":"https://api.github.com/repos/openai/codex/git/commits/fd41e813cb5939029acab29cb5f2fb8ac8d8286d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fd41e813cb5939029acab29cb5f2fb8ac8d8286d","html_url":"https://github.com/openai/codex/commit/fd41e813cb5939029acab29cb5f2fb8ac8d8286d","comments_url":"https://api.github.com/repos/openai/codex/commits/fd41e813cb5939029acab29cb5f2fb8ac8d8286d/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"bbb92457b04fe7e7c27d450f9221014f8abf09ca","url":"https://api.github.com/repos/openai/codex/commits/bbb92457b04fe7e7c27d450f9221014f8abf09ca","html_url":"https://github.com/openai/codex/commit/bbb92457b04fe7e7c27d450f9221014f8abf09ca"}]},{"sha":"bbb92457b04fe7e7c27d450f9221014f8abf09ca","node_id":"C_kwDOOYsS4doAKGJiYjkyNDU3YjA0ZmU3ZTdjMjdkNDUwZjkyMjEwMTRmOGFiZjA5Y2E","commit":{"author":{"name":"viyatb-oai","email":"viyatb@openai.com","date":"2026-07-27T20:37:10Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T20:43:04Z"},"message":"Expose the network proxy spec constructor (#35668)\n\nGitOrigin-RevId: 84c4f11cd6c5fea867228a9f821d4901bf4204c6","tree":{"sha":"784b62fff3cab404b416ce666724cb42d8a3ce2d","url":"https://api.github.com/repos/openai/codex/git/trees/784b62fff3cab404b416ce666724cb42d8a3ce2d"},"url":"https://api.github.com/repos/openai/codex/git/commits/bbb92457b04fe7e7c27d450f9221014f8abf09ca","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/bbb92457b04fe7e7c27d450f9221014f8abf09ca","html_url":"https://github.com/openai/codex/commit/bbb92457b04fe7e7c27d450f9221014f8abf09ca","comments_url":"https://api.github.com/repos/openai/codex/commits/bbb92457b04fe7e7c27d450f9221014f8abf09ca/comments","author":{"login":"viyatb-oai","id":234056686,"node_id":"U_kgDODfNr7g","avatar_url":"https://avatars.githubusercontent.com/u/234056686?v=4","gravatar_id":"","url":"https://api.github.com/users/viyatb-oai","html_url":"https://github.com/viyatb-oai","followers_url":"https://api.github.com/users/viyatb-oai/followers","following_url":"https://api.github.com/users/viyatb-oai/following{/other_user}","gists_url":"https://api.github.com/users/viyatb-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/viyatb-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/viyatb-oai/subscriptions","organizations_url":"https://api.github.com/users/viyatb-oai/orgs","repos_url":"https://api.github.com/users/viyatb-oai/repos","events_url":"https://api.github.com/users/viyatb-oai/events{/privacy}","received_events_url":"https://api.github.com/users/viyatb-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c21c8a5e215bc7b9215fc727cfe17f60ab170333","url":"https://api.github.com/repos/openai/codex/commits/c21c8a5e215bc7b9215fc727cfe17f60ab170333","html_url":"https://github.com/openai/codex/commit/c21c8a5e215bc7b9215fc727cfe17f60ab170333"}]},{"sha":"c21c8a5e215bc7b9215fc727cfe17f60ab170333","node_id":"C_kwDOOYsS4doAKGMyMWM4YTVlMjE1YmM3YjkyMTVmYzcyN2NmZTE3ZjYwYWIxNzAzMzM","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-07-27T19:52:26Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T20:00:11Z"},"message":"Fix the async watcher test harness on Windows (#35665)\n\nInitialize the Windows-only `ProcessDriver::tty` field to `false` when\nconstructing the streaming output test harness.\n\nGitOrigin-RevId: 95683779072cba31664d059750b81ee0d9c17664","tree":{"sha":"1b0f1ae12249977a5a40d8bf4f8c1c9f98ca748f","url":"https://api.github.com/repos/openai/codex/git/trees/1b0f1ae12249977a5a40d8bf4f8c1c9f98ca748f"},"url":"https://api.github.com/repos/openai/codex/git/commits/c21c8a5e215bc7b9215fc727cfe17f60ab170333","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c21c8a5e215bc7b9215fc727cfe17f60ab170333","html_url":"https://github.com/openai/codex/commit/c21c8a5e215bc7b9215fc727cfe17f60ab170333","comments_url":"https://api.github.com/repos/openai/codex/commits/c21c8a5e215bc7b9215fc727cfe17f60ab170333/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"b672b3c409324ac3ae53982734f0ee555c27202e","url":"https://api.github.com/repos/openai/codex/commits/b672b3c409324ac3ae53982734f0ee555c27202e","html_url":"https://github.com/openai/codex/commit/b672b3c409324ac3ae53982734f0ee555c27202e"}]},{"sha":"b672b3c409324ac3ae53982734f0ee555c27202e","node_id":"C_kwDOOYsS4doAKGI2NzJiM2M0MDkzMjRhYzNhZTUzOTgyNzM0ZjBlZTU1NWMyNzIwMmU","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-27T19:31:20Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T19:37:02Z"},"message":"Evaluate character matching over skill routing metadata (#35663)\n\n## What changed\n\n- Add a character n-gram shadow selector that combines skill descriptions with host interface metadata and tool dependency names and descriptions.\n- Bound routing fields, dependency records, and candidate counts before ranking.\n- Exclude explicitly selected skills from shadow candidates and only record invocations for skills eligible for the experiment.\n\n## Testing\n\n- Add unit coverage for host interface metadata, connector dependencies, baseline description matches, and long routing metadata.\n\nGitOrigin-RevId: 36ef0cb4a68601f2d9d41c3344c88f7927c32bf4","tree":{"sha":"db603b07183d25df501fc4027c714a391fe91fe3","url":"https://api.github.com/repos/openai/codex/git/trees/db603b07183d25df501fc4027c714a391fe91fe3"},"url":"https://api.github.com/repos/openai/codex/git/commits/b672b3c409324ac3ae53982734f0ee555c27202e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/b672b3c409324ac3ae53982734f0ee555c27202e","html_url":"https://github.com/openai/codex/commit/b672b3c409324ac3ae53982734f0ee555c27202e","comments_url":"https://api.github.com/repos/openai/codex/commits/b672b3c409324ac3ae53982734f0ee555c27202e/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"8495963ac6d15a3ac891517d979f5509d55605c0","url":"https://api.github.com/repos/openai/codex/commits/8495963ac6d15a3ac891517d979f5509d55605c0","html_url":"https://github.com/openai/codex/commit/8495963ac6d15a3ac891517d979f5509d55605c0"}]},{"sha":"8495963ac6d15a3ac891517d979f5509d55605c0","node_id":"C_kwDOOYsS4doAKDg0OTU5NjNhYzZkMTVhM2FjODkxNTE3ZDk3OWY1NTA5ZDU1NjA1YzA","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-27T18:56:38Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T19:01:53Z"},"message":"Place host skills before permission instructions (#35661)\n\n## What changed\n\n- Insert the `host_skills` world-state section before the permissions section\n  when permissions are present.\n- Verify that skill metadata appears before `<permissions instructions>` in the\n  rendered developer message.\n\nGitOrigin-RevId: e9fc62f498c384e841fc34ef679850557645f989","tree":{"sha":"93c7b0796596c959c87c644e692ea16b5ffdfa1f","url":"https://api.github.com/repos/openai/codex/git/trees/93c7b0796596c959c87c644e692ea16b5ffdfa1f"},"url":"https://api.github.com/repos/openai/codex/git/commits/8495963ac6d15a3ac891517d979f5509d55605c0","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/8495963ac6d15a3ac891517d979f5509d55605c0","html_url":"https://github.com/openai/codex/commit/8495963ac6d15a3ac891517d979f5509d55605c0","comments_url":"https://api.github.com/repos/openai/codex/commits/8495963ac6d15a3ac891517d979f5509d55605c0/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"2f19a57704fb7b1db032bc38cf995034254eaebb","url":"https://api.github.com/repos/openai/codex/commits/2f19a57704fb7b1db032bc38cf995034254eaebb","html_url":"https://github.com/openai/codex/commit/2f19a57704fb7b1db032bc38cf995034254eaebb"}]},{"sha":"2f19a57704fb7b1db032bc38cf995034254eaebb","node_id":"C_kwDOOYsS4doAKDJmMTlhNTc3MDRmYjdiMWRiMDMyYmMzOGNmOTk1MDM0MjU0ZWFlYmI","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-07-27T18:33:19Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T18:41:09Z"},"message":"Preserve multi-agent settings across config representations (#35656)\n\n## Why\n\n`features.multi_agent_v2` can be represented as either a legacy boolean toggle\nor a table with an `enabled` field and nested settings. Layering or editing\nconfigs that mix these forms could replace one form with the other and discard\nthe enabled state or nested settings.\n\n## What changed\n\n- Normalize boolean toggles to the table's `enabled` field when merging config\n  layers, applying CLI overrides, and editing user or profile config.\n- Preserve nested multi-agent settings when toggling the feature, while keeping\n  ordinary replacement semantics for unrelated paths.\n- Attribute normalized `enabled` values to the layer that supplied the boolean\n  toggle so config write results report overrides correctly.\n\n## Testing\n\nAdded coverage for layered config, CLI overrides, config edits, app-server\nwrites, and origin metadata using both root and profile feature paths.\n\nGitOrigin-RevId: 38b248c949b9ea5d6340a73d754f91c1834ac486","tree":{"sha":"1ea0f4305d629192b40026483fbb44bd68740125","url":"https://api.github.com/repos/openai/codex/git/trees/1ea0f4305d629192b40026483fbb44bd68740125"},"url":"https://api.github.com/repos/openai/codex/git/commits/2f19a57704fb7b1db032bc38cf995034254eaebb","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/2f19a57704fb7b1db032bc38cf995034254eaebb","html_url":"https://github.com/openai/codex/commit/2f19a57704fb7b1db032bc38cf995034254eaebb","comments_url":"https://api.github.com/repos/openai/codex/commits/2f19a57704fb7b1db032bc38cf995034254eaebb/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"6b23635a7e8d92862940702a2ec65c1226402cdb","url":"https://api.github.com/repos/openai/codex/commits/6b23635a7e8d92862940702a2ec65c1226402cdb","html_url":"https://github.com/openai/codex/commit/6b23635a7e8d92862940702a2ec65c1226402cdb"}]},{"sha":"6b23635a7e8d92862940702a2ec65c1226402cdb","node_id":"C_kwDOOYsS4doAKDZiMjM2MzVhN2U4ZDkyODYyOTQwNzAyYTJlYzY1YzEyMjY0MDJjZGI","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-07-27T18:31:39Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T18:37:11Z"},"message":"Terminate Windows non-TTY processes on interrupt (#35655)\n\n## Why\n\nWindows non-TTY exec sessions reported interrupts as unsupported, so sending\nCtrl-C through `write_stdin` did not stop the running process.\n\n## What changed\n\n- Route interrupt requests for Windows non-TTY processes through their existing\n  termination callback, including pipe-backed processes.\n- Track whether driver-backed Windows sessions use a TTY so PTY interrupts keep\n  their existing behavior.\n- Consume the terminator after a successful interrupt to avoid invoking it again\n  when the process handle is dropped.\n\n## Testing\n\nAdded coverage for local and remote exec-server sessions, unified exec, pipe\nfallbacks, and legacy Windows sandbox processes.\n\nGitOrigin-RevId: 34504d01f091ef57bb961e98ad5a8d9f1acee4ee","tree":{"sha":"b3fadc5359d8f3ee27c279bb871b531c1c53ff70","url":"https://api.github.com/repos/openai/codex/git/trees/b3fadc5359d8f3ee27c279bb871b531c1c53ff70"},"url":"https://api.github.com/repos/openai/codex/git/commits/6b23635a7e8d92862940702a2ec65c1226402cdb","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/6b23635a7e8d92862940702a2ec65c1226402cdb","html_url":"https://github.com/openai/codex/commit/6b23635a7e8d92862940702a2ec65c1226402cdb","comments_url":"https://api.github.com/repos/openai/codex/commits/6b23635a7e8d92862940702a2ec65c1226402cdb/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"9f82ffed1b2fb63370055dad3f2ad63564eeebbf","url":"https://api.github.com/repos/openai/codex/commits/9f82ffed1b2fb63370055dad3f2ad63564eeebbf","html_url":"https://github.com/openai/codex/commit/9f82ffed1b2fb63370055dad3f2ad63564eeebbf"}]},{"sha":"9f82ffed1b2fb63370055dad3f2ad63564eeebbf","node_id":"C_kwDOOYsS4doAKDlmODJmZmVkMWIyZmI2MzM3MDA1NWRhZDNmMmFkNjM1NjRlZWViYmY","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-07-27T18:07:16Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T18:12:42Z"},"message":"Test developer instruction inheritance for multi-agent workers (#35653)\n\n## Testing\n\n- Verify full, compacted, and bounded history forks preserve developer messages while removing stale parent usage hints.\n- Add an app-server regression test that cold-resumes a root thread and confirms a roleless worker retains inherited developer instructions when lazily reloaded for follow-up work.\n\nGitOrigin-RevId: 40e454a2a2b721ea645cbc607b17a3ae6b617bd9","tree":{"sha":"258b60f639147ccc0a3bac684227d7b6b939c117","url":"https://api.github.com/repos/openai/codex/git/trees/258b60f639147ccc0a3bac684227d7b6b939c117"},"url":"https://api.github.com/repos/openai/codex/git/commits/9f82ffed1b2fb63370055dad3f2ad63564eeebbf","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/9f82ffed1b2fb63370055dad3f2ad63564eeebbf","html_url":"https://github.com/openai/codex/commit/9f82ffed1b2fb63370055dad3f2ad63564eeebbf","comments_url":"https://api.github.com/repos/openai/codex/commits/9f82ffed1b2fb63370055dad3f2ad63564eeebbf/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"462ed19a05917b1ec88a015b2cf6342cfe8f7c85","url":"https://api.github.com/repos/openai/codex/commits/462ed19a05917b1ec88a015b2cf6342cfe8f7c85","html_url":"https://github.com/openai/codex/commit/462ed19a05917b1ec88a015b2cf6342cfe8f7c85"}]},{"sha":"462ed19a05917b1ec88a015b2cf6342cfe8f7c85","node_id":"C_kwDOOYsS4doAKDQ2MmVkMTlhMDU5MTdiMWVjODhhMDE1YjJjZjYzNDJjZmU4ZjdjODU","commit":{"author":{"name":"viyatb-oai","email":"viyatb@openai.com","date":"2026-07-27T18:01:36Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T18:07:31Z"},"message":"Enable network policy callbacks for remote exec (#35652)\n\n## What changed\n\n- Forward remote managed-network policy requests to the controller-side decider when Guardian review is enabled.\n- Bound callbacks using the configured permission-hook and Guardian review timeouts, restore trusted execution attribution, and recheck live baseline policy before requesting a decision.\n- Cancel pending decisions when the process or execution scope ends, and propagate EOF across the sandbox proxy bridge with half-closes.\n\n## Testing\n\n- Cover callback enablement, strict allowlist behavior, live policy updates, trusted attribution, and execution-scope cancellation.\n\nGitOrigin-RevId: 83b47657c8c4546dfe98eec8b272833e96a46b7e","tree":{"sha":"ef656f0b3d98140acbb801f25042af8bf5fdc03d","url":"https://api.github.com/repos/openai/codex/git/trees/ef656f0b3d98140acbb801f25042af8bf5fdc03d"},"url":"https://api.github.com/repos/openai/codex/git/commits/462ed19a05917b1ec88a015b2cf6342cfe8f7c85","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/462ed19a05917b1ec88a015b2cf6342cfe8f7c85","html_url":"https://github.com/openai/codex/commit/462ed19a05917b1ec88a015b2cf6342cfe8f7c85","comments_url":"https://api.github.com/repos/openai/codex/commits/462ed19a05917b1ec88a015b2cf6342cfe8f7c85/comments","author":{"login":"viyatb-oai","id":234056686,"node_id":"U_kgDODfNr7g","avatar_url":"https://avatars.githubusercontent.com/u/234056686?v=4","gravatar_id":"","url":"https://api.github.com/users/viyatb-oai","html_url":"https://github.com/viyatb-oai","followers_url":"https://api.github.com/users/viyatb-oai/followers","following_url":"https://api.github.com/users/viyatb-oai/following{/other_user}","gists_url":"https://api.github.com/users/viyatb-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/viyatb-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/viyatb-oai/subscriptions","organizations_url":"https://api.github.com/users/viyatb-oai/orgs","repos_url":"https://api.github.com/users/viyatb-oai/repos","events_url":"https://api.github.com/users/viyatb-oai/events{/privacy}","received_events_url":"https://api.github.com/users/viyatb-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"976129f0973b3323e2200016df43e83f88270543","url":"https://api.github.com/repos/openai/codex/commits/976129f0973b3323e2200016df43e83f88270543","html_url":"https://github.com/openai/codex/commit/976129f0973b3323e2200016df43e83f88270543"}]},{"sha":"976129f0973b3323e2200016df43e83f88270543","node_id":"C_kwDOOYsS4doAKDk3NjEyOWYwOTczYjMzMjNlMjIwMDAxNmRmNDNlODNmODgyNzA1NDM","commit":{"author":{"name":"Felipe Coury","email":"felipe.coury@openai.com","date":"2026-07-27T17:54:28Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T17:59:06Z"},"message":"Preserve TUI input when terminal focus returns (#35649)\n\n## Why\n\nRefreshing the terminal palette on a focus event can block the input loop and\ndiscard keystrokes entered while focus is returning.\n\n## What changed\n\n- Keep the palette cached by the startup probe when handling `FocusGained`.\n- Continue updating focus state and requesting a redraw without issuing new\n  foreground or background color queries.\n\n## Testing\n\n- Verify a queued key is delivered after `FocusGained`.\n- Exercise focus regain in a pseudo-terminal with immediate and delayed input,\n  and verify it emits no additional palette queries.\n\nGitOrigin-RevId: 16e26f81c1343d01f6d0baeff3f204bcc91dd6f3","tree":{"sha":"1d9536585a63f440343e1590ac630ace71257881","url":"https://api.github.com/repos/openai/codex/git/trees/1d9536585a63f440343e1590ac630ace71257881"},"url":"https://api.github.com/repos/openai/codex/git/commits/976129f0973b3323e2200016df43e83f88270543","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/976129f0973b3323e2200016df43e83f88270543","html_url":"https://github.com/openai/codex/commit/976129f0973b3323e2200016df43e83f88270543","comments_url":"https://api.github.com/repos/openai/codex/commits/976129f0973b3323e2200016df43e83f88270543/comments","author":{"login":"fcoury-oai","id":272635208,"node_id":"U_kgDOEEAVSA","avatar_url":"https://avatars.githubusercontent.com/u/272635208?v=4","gravatar_id":"","url":"https://api.github.com/users/fcoury-oai","html_url":"https://github.com/fcoury-oai","followers_url":"https://api.github.com/users/fcoury-oai/followers","following_url":"https://api.github.com/users/fcoury-oai/following{/other_user}","gists_url":"https://api.github.com/users/fcoury-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/fcoury-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fcoury-oai/subscriptions","organizations_url":"https://api.github.com/users/fcoury-oai/orgs","repos_url":"https://api.github.com/users/fcoury-oai/repos","events_url":"https://api.github.com/users/fcoury-oai/events{/privacy}","received_events_url":"https://api.github.com/users/fcoury-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"e8f0f64f2057740ca18d66dbeebe077156d7a2a9","url":"https://api.github.com/repos/openai/codex/commits/e8f0f64f2057740ca18d66dbeebe077156d7a2a9","html_url":"https://github.com/openai/codex/commit/e8f0f64f2057740ca18d66dbeebe077156d7a2a9"}]},{"sha":"e8f0f64f2057740ca18d66dbeebe077156d7a2a9","node_id":"C_kwDOOYsS4doAKGU4ZjBmNjRmMjA1Nzc0MGNhMThkNjZkYmVlYmUwNzcxNTZkN2EyYTk","commit":{"author":{"name":"malsamiri-oai","email":"malsamiri@openai.com","date":"2026-07-27T16:49:34Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T16:54:52Z"},"message":"Preserve thread metadata when rollout files are missing (#35644)\n\n## What changed\n\n- Skip threads whose rollout files cannot be found while continuing through\n  database pages until the requested number of valid threads is collected.\n- Retain the skipped threads and their rollout paths in the state database\n  instead of deleting their metadata during listing.\n\n## Testing\n\n- Update the state-backed listing test to verify that a missing rollout path\n  does not consume a page slot or remove the stored thread metadata.\n\nGitOrigin-RevId: 51c03a78434b0aeeb5a2dc685b97243b6ad958bf","tree":{"sha":"1a6a87e2550cf34636736298df70c1fda19bc0d5","url":"https://api.github.com/repos/openai/codex/git/trees/1a6a87e2550cf34636736298df70c1fda19bc0d5"},"url":"https://api.github.com/repos/openai/codex/git/commits/e8f0f64f2057740ca18d66dbeebe077156d7a2a9","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/e8f0f64f2057740ca18d66dbeebe077156d7a2a9","html_url":"https://github.com/openai/codex/commit/e8f0f64f2057740ca18d66dbeebe077156d7a2a9","comments_url":"https://api.github.com/repos/openai/codex/commits/e8f0f64f2057740ca18d66dbeebe077156d7a2a9/comments","author":{"login":"malsamiri-oai","id":247488832,"node_id":"U_kgDODsBhQA","avatar_url":"https://avatars.githubusercontent.com/u/247488832?v=4","gravatar_id":"","url":"https://api.github.com/users/malsamiri-oai","html_url":"https://github.com/malsamiri-oai","followers_url":"https://api.github.com/users/malsamiri-oai/followers","following_url":"https://api.github.com/users/malsamiri-oai/following{/other_user}","gists_url":"https://api.github.com/users/malsamiri-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/malsamiri-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/malsamiri-oai/subscriptions","organizations_url":"https://api.github.com/users/malsamiri-oai/orgs","repos_url":"https://api.github.com/users/malsamiri-oai/repos","events_url":"https://api.github.com/users/malsamiri-oai/events{/privacy}","received_events_url":"https://api.github.com/users/malsamiri-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"0affaf2acb888304f91cadb2c497313e95b715b8","url":"https://api.github.com/repos/openai/codex/commits/0affaf2acb888304f91cadb2c497313e95b715b8","html_url":"https://github.com/openai/codex/commit/0affaf2acb888304f91cadb2c497313e95b715b8"}]},{"sha":"0affaf2acb888304f91cadb2c497313e95b715b8","node_id":"C_kwDOOYsS4doAKDBhZmZhZjJhY2I4ODgzMDRmOTFjYWRiMmM0OTczMTNlOTViNzE1Yjg","commit":{"author":{"name":"Felipe Coury","email":"felipe.coury@openai.com","date":"2026-07-27T16:29:21Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T16:33:59Z"},"message":"Make OpenTelemetry provider shutdown idempotent (#35642)\n\n## What changed\n\n- Guard `OtelProvider::shutdown` so exporters shut down at most once, including when an explicit shutdown is followed by `Drop`.\n- Let tracer provider shutdown handle flushing without a separate `force_flush` call.\n- Add regression tests for explicit shutdown and drop-only shutdown.\n\nGitOrigin-RevId: f3c8769146ee57102477eb9ee7fd948f688efb79","tree":{"sha":"3ff5889989ef09c00e3b616c1ad2067295508439","url":"https://api.github.com/repos/openai/codex/git/trees/3ff5889989ef09c00e3b616c1ad2067295508439"},"url":"https://api.github.com/repos/openai/codex/git/commits/0affaf2acb888304f91cadb2c497313e95b715b8","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/0affaf2acb888304f91cadb2c497313e95b715b8","html_url":"https://github.com/openai/codex/commit/0affaf2acb888304f91cadb2c497313e95b715b8","comments_url":"https://api.github.com/repos/openai/codex/commits/0affaf2acb888304f91cadb2c497313e95b715b8/comments","author":{"login":"fcoury-oai","id":272635208,"node_id":"U_kgDOEEAVSA","avatar_url":"https://avatars.githubusercontent.com/u/272635208?v=4","gravatar_id":"","url":"https://api.github.com/users/fcoury-oai","html_url":"https://github.com/fcoury-oai","followers_url":"https://api.github.com/users/fcoury-oai/followers","following_url":"https://api.github.com/users/fcoury-oai/following{/other_user}","gists_url":"https://api.github.com/users/fcoury-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/fcoury-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fcoury-oai/subscriptions","organizations_url":"https://api.github.com/users/fcoury-oai/orgs","repos_url":"https://api.github.com/users/fcoury-oai/repos","events_url":"https://api.github.com/users/fcoury-oai/events{/privacy}","received_events_url":"https://api.github.com/users/fcoury-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"bd2de422aa287b97b06ca6425a10935bcf1b3731","url":"https://api.github.com/repos/openai/codex/commits/bd2de422aa287b97b06ca6425a10935bcf1b3731","html_url":"https://github.com/openai/codex/commit/bd2de422aa287b97b06ca6425a10935bcf1b3731"}]},{"sha":"bd2de422aa287b97b06ca6425a10935bcf1b3731","node_id":"C_kwDOOYsS4doAKGJkMmRlNDIyYWEyODdiOTdiMDZjYTY0MjVhMTA5MzViY2YxYjM3MzE","commit":{"author":{"name":"charlesgong-openai","email":"charlesgong@openai.com","date":"2026-07-27T14:26:39Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T14:31:50Z"},"message":"Parse Claude and Cursor session records separately (#35623)\n\n## Why\n\nCursor session messages can place `<cursor_commands>` and `<timestamp>` context\nbefore the actual `<user_query>`. Treating both external session formats with one\nparser left that context in the imported message and generated title.\n\n## What changed\n\n- Route detected sessions through format-specific Claude and Cursor parsers.\n- Strip recognized Cursor context wrappers when extracting a trailing\n  `<user_query>`, while preserving messages with unknown leading context.\n- Keep shared content-block, tool-call, and timestamp parsing in a common module.\n\n## Testing\n\nAdd parser coverage for wrapped Cursor queries, unknown context, working-directory\nprecedence, Claude metadata, content hashing, and shared tool annotations.\n\nGitOrigin-RevId: b49328d46ab4937e3c599588a3d3081e8ab798cd","tree":{"sha":"58b21e3070df3609bad7e99e4d8cbf8688ac432a","url":"https://api.github.com/repos/openai/codex/git/trees/58b21e3070df3609bad7e99e4d8cbf8688ac432a"},"url":"https://api.github.com/repos/openai/codex/git/commits/bd2de422aa287b97b06ca6425a10935bcf1b3731","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/bd2de422aa287b97b06ca6425a10935bcf1b3731","html_url":"https://github.com/openai/codex/commit/bd2de422aa287b97b06ca6425a10935bcf1b3731","comments_url":"https://api.github.com/repos/openai/codex/commits/bd2de422aa287b97b06ca6425a10935bcf1b3731/comments","author":{"login":"charlesgong-openai","id":200841148,"node_id":"U_kgDOC_iXvA","avatar_url":"https://avatars.githubusercontent.com/u/200841148?v=4","gravatar_id":"","url":"https://api.github.com/users/charlesgong-openai","html_url":"https://github.com/charlesgong-openai","followers_url":"https://api.github.com/users/charlesgong-openai/followers","following_url":"https://api.github.com/users/charlesgong-openai/following{/other_user}","gists_url":"https://api.github.com/users/charlesgong-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/charlesgong-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charlesgong-openai/subscriptions","organizations_url":"https://api.github.com/users/charlesgong-openai/orgs","repos_url":"https://api.github.com/users/charlesgong-openai/repos","events_url":"https://api.github.com/users/charlesgong-openai/events{/privacy}","received_events_url":"https://api.github.com/users/charlesgong-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fea2d8b18f5fade817d0d3a9cf4f278b6210ab01","url":"https://api.github.com/repos/openai/codex/commits/fea2d8b18f5fade817d0d3a9cf4f278b6210ab01","html_url":"https://github.com/openai/codex/commit/fea2d8b18f5fade817d0d3a9cf4f278b6210ab01"}]},{"sha":"fea2d8b18f5fade817d0d3a9cf4f278b6210ab01","node_id":"C_kwDOOYsS4doAKGZlYTJkOGIxOGY1ZmFkZTgxN2QwZDNhOWNmNGYyNzhiNjIxMGFiMDE","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-07-27T14:08:07Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T14:12:50Z"},"message":"Skip restored token usage replay for exec resumes (#35621)\n\n## What changed\n\nSet `excludeTurns` on `codex exec` thread resume requests so the app server\ndoes not return reconstructed turns or replay their restored token usage.\n\n## Testing\n\nExtend the `resume --last` integration test to verify that resuming a session\nemits only the live turn's `thread/tokenUsage/updated` event.\n\nGitOrigin-RevId: 3347071142e7453ea9e3ac9ac292aa5384d98430","tree":{"sha":"a33a9d378360359c7070806a621f5c509fd48145","url":"https://api.github.com/repos/openai/codex/git/trees/a33a9d378360359c7070806a621f5c509fd48145"},"url":"https://api.github.com/repos/openai/codex/git/commits/fea2d8b18f5fade817d0d3a9cf4f278b6210ab01","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fea2d8b18f5fade817d0d3a9cf4f278b6210ab01","html_url":"https://github.com/openai/codex/commit/fea2d8b18f5fade817d0d3a9cf4f278b6210ab01","comments_url":"https://api.github.com/repos/openai/codex/commits/fea2d8b18f5fade817d0d3a9cf4f278b6210ab01/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fbe65995bbcd4da249cfdafe0300ac3cb2cb3b3c","url":"https://api.github.com/repos/openai/codex/commits/fbe65995bbcd4da249cfdafe0300ac3cb2cb3b3c","html_url":"https://github.com/openai/codex/commit/fbe65995bbcd4da249cfdafe0300ac3cb2cb3b3c"}]},{"sha":"fbe65995bbcd4da249cfdafe0300ac3cb2cb3b3c","node_id":"C_kwDOOYsS4doAKGZiZTY1OTk1YmJjZDRkYTI0OWNmZGFmZTAzMDBhYzNjYjJjYjNiM2M","commit":{"author":{"name":"rka-oai","email":"rka@openai.com","date":"2026-07-27T12:47:24Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T12:52:37Z"},"message":"Support model-owned token budget defaults (#35608)\n\n## What changed\n\n- Add token-budget settings to model catalog messages and apply them when the\n  feature is enabled without explicit token-budget configuration.\n- Keep explicit user settings authoritative, reject invalid catalog defaults,\n  and preserve resolved defaults in exported config locks.\n- Manage context-window guidance through world state so it updates once when\n  the active model changes while retaining prior conversation history.\n\n## Testing\n\n- Cover catalog defaults, explicit overrides, disabled features, invalid\n  values, config-lock replay, and model switching.\n\nGitOrigin-RevId: 54544fefaa14b09f5ef5bad9967a13c52b87b0fe","tree":{"sha":"3f5ff797762145182919d3e42f9a63b864ace18e","url":"https://api.github.com/repos/openai/codex/git/trees/3f5ff797762145182919d3e42f9a63b864ace18e"},"url":"https://api.github.com/repos/openai/codex/git/commits/fbe65995bbcd4da249cfdafe0300ac3cb2cb3b3c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fbe65995bbcd4da249cfdafe0300ac3cb2cb3b3c","html_url":"https://github.com/openai/codex/commit/fbe65995bbcd4da249cfdafe0300ac3cb2cb3b3c","comments_url":"https://api.github.com/repos/openai/codex/commits/fbe65995bbcd4da249cfdafe0300ac3cb2cb3b3c/comments","author":{"login":"rka-oai","id":240799229,"node_id":"U_kgDODlpN_Q","avatar_url":"https://avatars.githubusercontent.com/u/240799229?v=4","gravatar_id":"","url":"https://api.github.com/users/rka-oai","html_url":"https://github.com/rka-oai","followers_url":"https://api.github.com/users/rka-oai/followers","following_url":"https://api.github.com/users/rka-oai/following{/other_user}","gists_url":"https://api.github.com/users/rka-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rka-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rka-oai/subscriptions","organizations_url":"https://api.github.com/users/rka-oai/orgs","repos_url":"https://api.github.com/users/rka-oai/repos","events_url":"https://api.github.com/users/rka-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rka-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"16d7daad7c5dc73da8558102a65bb7d7709807e1","url":"https://api.github.com/repos/openai/codex/commits/16d7daad7c5dc73da8558102a65bb7d7709807e1","html_url":"https://github.com/openai/codex/commit/16d7daad7c5dc73da8558102a65bb7d7709807e1"}]},{"sha":"16d7daad7c5dc73da8558102a65bb7d7709807e1","node_id":"C_kwDOOYsS4doAKDE2ZDdkYWFkN2M1ZGM3M2RhODU1ODEwMmE2NWJiN2Q3NzA5ODA3ZTE","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-07-27T12:27:34Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T12:32:32Z"},"message":"Record metrics for empty skill catalogs (#35607)\n\n## Why\n\nEmpty rendered skill catalogs skipped catalog telemetry instead of reporting\nzero-valued counts.\n\n## What changed\n\n- Record a default render report when thread, turn-input, or executor catalog\n  rendering produces no fragment.\n- Record zero-valued host world-state metrics when skill instructions are\n  enabled but no host skills are available.\n- Preserve the `catalog_surface` tag so empty host and executor catalogs remain\n  distinguishable.\n\n## Testing\n\nAdd coverage for empty catalog rendering and mixed nonempty-executor,\nempty-host world state.\n\nGitOrigin-RevId: f68d65806703c0ded1ece1e5ae1ffaf6d6045126","tree":{"sha":"a14195b5b18887faa755f09d3149d471d4fb72de","url":"https://api.github.com/repos/openai/codex/git/trees/a14195b5b18887faa755f09d3149d471d4fb72de"},"url":"https://api.github.com/repos/openai/codex/git/commits/16d7daad7c5dc73da8558102a65bb7d7709807e1","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/16d7daad7c5dc73da8558102a65bb7d7709807e1","html_url":"https://github.com/openai/codex/commit/16d7daad7c5dc73da8558102a65bb7d7709807e1","comments_url":"https://api.github.com/repos/openai/codex/commits/16d7daad7c5dc73da8558102a65bb7d7709807e1/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"d6ea5991e7f91eec5bad1fb4cb36f6be638878bc","url":"https://api.github.com/repos/openai/codex/commits/d6ea5991e7f91eec5bad1fb4cb36f6be638878bc","html_url":"https://github.com/openai/codex/commit/d6ea5991e7f91eec5bad1fb4cb36f6be638878bc"}]},{"sha":"d6ea5991e7f91eec5bad1fb4cb36f6be638878bc","node_id":"C_kwDOOYsS4doAKGQ2ZWE1OTkxZTdmOTFlZWM1YmFkMWZiNGNiMzZmNmJlNjM4ODc4YmM","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-07-27T10:59:20Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T11:04:02Z"},"message":"Add metrics for extension-rendered skill catalogs (#35597)\n\n## What changed\n\n- Add an optional `ExtensionMetrics` capability to thread, turn-input, and world-state contributors, backed by session telemetry in the host.\n- Record skill counts, omissions, and truncated description characters for extension-rendered catalogs, tagged by the catalog surface.\n- Preserve host session attribution on extension metrics, including the effective model for each turn, and prevent extension tags from overriding host metadata.\n- Avoid duplicate host-catalog samples by recording world-state metrics only when the section is published or changes.\n\n## Testing\n\n- Cover metric values and surface tags, session metadata preservation, turn-level model changes, and host world-state publication behavior.\n\nGitOrigin-RevId: 9059e521943a8f81df25a38b03692eddbc1d990d","tree":{"sha":"c928c9d77cbfb44d4ab3f188996df6740a935f3d","url":"https://api.github.com/repos/openai/codex/git/trees/c928c9d77cbfb44d4ab3f188996df6740a935f3d"},"url":"https://api.github.com/repos/openai/codex/git/commits/d6ea5991e7f91eec5bad1fb4cb36f6be638878bc","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/d6ea5991e7f91eec5bad1fb4cb36f6be638878bc","html_url":"https://github.com/openai/codex/commit/d6ea5991e7f91eec5bad1fb4cb36f6be638878bc","comments_url":"https://api.github.com/repos/openai/codex/commits/d6ea5991e7f91eec5bad1fb4cb36f6be638878bc/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"3d519bf63a1ca9b319b1aefc3062558af0c06273","url":"https://api.github.com/repos/openai/codex/commits/3d519bf63a1ca9b319b1aefc3062558af0c06273","html_url":"https://github.com/openai/codex/commit/3d519bf63a1ca9b319b1aefc3062558af0c06273"}]},{"sha":"3d519bf63a1ca9b319b1aefc3062558af0c06273","node_id":"C_kwDOOYsS4doAKDNkNTE5YmY2M2ExY2E5YjMxOWIxYWVmYzMwNjI1NThhZjBjMDYyNzM","commit":{"author":{"name":"zsol-openai","email":"zsol@openai.com","date":"2026-07-27T10:46:58Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T10:54:58Z"},"message":"Allow alpha hotfix versions in R2 releases (#35595)\n\n## Why\n\nThe Rust release workflow accepts alpha versions with a second numeric suffix,\nsuch as `1.2.3-alpha.4.1`, but the R2 publisher rejects them as invalid.\n\n## What changed\n\n- Allow up to two numeric suffix components for alpha versions in\n  `publish_r2_release.py`.\n- Document that its version pattern must remain aligned with release tag\n  validation in `rust-release.yml`.\n\nGitOrigin-RevId: 8df68ce4f4d3e652367f7394a642827f21979d70","tree":{"sha":"174fa52549464cb4449e7b8d8bca30b599257365","url":"https://api.github.com/repos/openai/codex/git/trees/174fa52549464cb4449e7b8d8bca30b599257365"},"url":"https://api.github.com/repos/openai/codex/git/commits/3d519bf63a1ca9b319b1aefc3062558af0c06273","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/3d519bf63a1ca9b319b1aefc3062558af0c06273","html_url":"https://github.com/openai/codex/commit/3d519bf63a1ca9b319b1aefc3062558af0c06273","comments_url":"https://api.github.com/repos/openai/codex/commits/3d519bf63a1ca9b319b1aefc3062558af0c06273/comments","author":{"login":"zsol-openai","id":282072647,"node_id":"U_kgDOENAWRw","avatar_url":"https://avatars.githubusercontent.com/u/282072647?v=4","gravatar_id":"","url":"https://api.github.com/users/zsol-openai","html_url":"https://github.com/zsol-openai","followers_url":"https://api.github.com/users/zsol-openai/followers","following_url":"https://api.github.com/users/zsol-openai/following{/other_user}","gists_url":"https://api.github.com/users/zsol-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/zsol-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zsol-openai/subscriptions","organizations_url":"https://api.github.com/users/zsol-openai/orgs","repos_url":"https://api.github.com/users/zsol-openai/repos","events_url":"https://api.github.com/users/zsol-openai/events{/privacy}","received_events_url":"https://api.github.com/users/zsol-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"8a1c9414399bd8c52cd11d89f420767c41f4ae99","url":"https://api.github.com/repos/openai/codex/commits/8a1c9414399bd8c52cd11d89f420767c41f4ae99","html_url":"https://github.com/openai/codex/commit/8a1c9414399bd8c52cd11d89f420767c41f4ae99"}]},{"sha":"8a1c9414399bd8c52cd11d89f420767c41f4ae99","node_id":"C_kwDOOYsS4doAKDhhMWM5NDE0Mzk5YmQ4YzUyY2QxMWQ4OWY0MjA3NjdjNDFmNGFlOTk","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-27T10:46:05Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T10:50:59Z"},"message":"Recommend longer waits in the v2 wait_agent schema (#35594)\n\n## What changed\n\nUpdate the v2 `wait_agent` timeout description to recommend minute-scale waits\nthat avoid busy polling, matching the existing v1 guidance. Extend the tool-spec\ntest to cover the updated description.\n\nGitOrigin-RevId: 615dfbd7cb5038013131ae8cb959d35e07c6f48a","tree":{"sha":"3602bbbff7dbb431739d32614673bd4a2728261a","url":"https://api.github.com/repos/openai/codex/git/trees/3602bbbff7dbb431739d32614673bd4a2728261a"},"url":"https://api.github.com/repos/openai/codex/git/commits/8a1c9414399bd8c52cd11d89f420767c41f4ae99","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/8a1c9414399bd8c52cd11d89f420767c41f4ae99","html_url":"https://github.com/openai/codex/commit/8a1c9414399bd8c52cd11d89f420767c41f4ae99","comments_url":"https://api.github.com/repos/openai/codex/commits/8a1c9414399bd8c52cd11d89f420767c41f4ae99/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"3bbf1fe75701c97fb190e0867002ba2d9dbda5db","url":"https://api.github.com/repos/openai/codex/commits/3bbf1fe75701c97fb190e0867002ba2d9dbda5db","html_url":"https://github.com/openai/codex/commit/3bbf1fe75701c97fb190e0867002ba2d9dbda5db"}]},{"sha":"3bbf1fe75701c97fb190e0867002ba2d9dbda5db","node_id":"C_kwDOOYsS4doAKDNiYmYxZmU3NTcwMWM5N2ZiMTkwZTA4NjcwMDJiYTJkOWRiZGE1ZGI","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-27T10:16:56Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T10:25:32Z"},"message":"Expose cached MCP tools before server startup (#35590)\n\n## Why\n\nCached MCP definitions can be supplied to inference without waiting for the\nserver to finish initializing.\n\n## What changed\n\n- Publish cached tools while startup is still in progress, clearing their\n  potentially stale read-only hint.\n- Wait for the selected server to start before executing a tool call, then\n  prepare the call against the refreshed live binding.\n- Keep cached tools visible in a binding even when no live client is available,\n  while rejecting attempts to prepare those calls.\n\n## Testing\n\n- Cover cached-tool visibility before startup and replacement with live tool\n  metadata afterward.\n- Verify cached definitions reach inference before MCP initialization and that\n  calls unavailable in the live catalog return the expected model-visible\n  error.\n\nGitOrigin-RevId: 3aae8f474c344ccdc5e08fe321bbad21d85bffd1","tree":{"sha":"c097183a0205a3717e4e08fefff700e92d66f9c8","url":"https://api.github.com/repos/openai/codex/git/trees/c097183a0205a3717e4e08fefff700e92d66f9c8"},"url":"https://api.github.com/repos/openai/codex/git/commits/3bbf1fe75701c97fb190e0867002ba2d9dbda5db","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/3bbf1fe75701c97fb190e0867002ba2d9dbda5db","html_url":"https://github.com/openai/codex/commit/3bbf1fe75701c97fb190e0867002ba2d9dbda5db","comments_url":"https://api.github.com/repos/openai/codex/commits/3bbf1fe75701c97fb190e0867002ba2d9dbda5db/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"95637f7056835fea66bdd0044414af480fc0fd74","url":"https://api.github.com/repos/openai/codex/commits/95637f7056835fea66bdd0044414af480fc0fd74","html_url":"https://github.com/openai/codex/commit/95637f7056835fea66bdd0044414af480fc0fd74"}]},{"sha":"95637f7056835fea66bdd0044414af480fc0fd74","node_id":"C_kwDOOYsS4doAKDk1NjM3ZjcwNTY4MzVmZWE2NmJkZDAwNDQ0MTRhZjQ4MGZjMGZkNzQ","commit":{"author":{"name":"zm-oai","email":"zm@openai.com","date":"2026-07-27T02:11:54Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-27T02:16:11Z"},"message":"Add managed policy for in-app updates (#35537)\n\n## What changed\n\n- Add the stable, default-enabled `in_app_updates` requirements-only feature.\n- Allow administrators to disable in-app updates through `[features]` in `requirements.toml`.\n- Expose the policy through `configRequirements/read` and include it in the config schema.\n\n## Testing\n\n- Verify that in-app updates are enabled by default and disabled by the managed requirement.\n- Verify that `configRequirements/read` returns the configured policy.\n\nGitOrigin-RevId: e9c7074b516fe58385fdf7dc8420c0109c0c3df6","tree":{"sha":"94ef09896a19262032bdd216e8431b28fad10e2f","url":"https://api.github.com/repos/openai/codex/git/trees/94ef09896a19262032bdd216e8431b28fad10e2f"},"url":"https://api.github.com/repos/openai/codex/git/commits/95637f7056835fea66bdd0044414af480fc0fd74","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/95637f7056835fea66bdd0044414af480fc0fd74","html_url":"https://github.com/openai/codex/commit/95637f7056835fea66bdd0044414af480fc0fd74","comments_url":"https://api.github.com/repos/openai/codex/commits/95637f7056835fea66bdd0044414af480fc0fd74/comments","author":{"login":"zm-oai","id":215741035,"node_id":"U_kgDODNvyaw","avatar_url":"https://avatars.githubusercontent.com/u/215741035?v=4","gravatar_id":"","url":"https://api.github.com/users/zm-oai","html_url":"https://github.com/zm-oai","followers_url":"https://api.github.com/users/zm-oai/followers","following_url":"https://api.github.com/users/zm-oai/following{/other_user}","gists_url":"https://api.github.com/users/zm-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/zm-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zm-oai/subscriptions","organizations_url":"https://api.github.com/users/zm-oai/orgs","repos_url":"https://api.github.com/users/zm-oai/repos","events_url":"https://api.github.com/users/zm-oai/events{/privacy}","received_events_url":"https://api.github.com/users/zm-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"18f50c9e628af083a52d9240de09fc2db24d79ce","url":"https://api.github.com/repos/openai/codex/commits/18f50c9e628af083a52d9240de09fc2db24d79ce","html_url":"https://github.com/openai/codex/commit/18f50c9e628af083a52d9240de09fc2db24d79ce"}]},{"sha":"18f50c9e628af083a52d9240de09fc2db24d79ce","node_id":"C_kwDOOYsS4doAKDE4ZjUwYzllNjI4YWYwODNhNTJkOTI0MGRlMDlmYzJkYjI0ZDc5Y2U","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-07-26T23:30:37Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-26T23:36:33Z"},"message":"Track model and personality in world state (#35530)\n\n## What changed\n\n- Add model and personality sections to the persisted world-state snapshot.\n- Generate model-switch and personality instructions through world-state diffs, including when prior state must be inferred during replay.\n- Keep those instruction fragments in standalone developer messages instead of merging them with adjacent context updates.\n\n## Testing\n\n- Cover initial, unchanged, and changed model and personality states.\n- Verify that model changes are recorded in rollout world-state items.\n\nGitOrigin-RevId: 497e29cf38cac08e992e546df900f6f8b01120f9","tree":{"sha":"bb1cb394be6c564e1a8221c94397f86708db6e15","url":"https://api.github.com/repos/openai/codex/git/trees/bb1cb394be6c564e1a8221c94397f86708db6e15"},"url":"https://api.github.com/repos/openai/codex/git/commits/18f50c9e628af083a52d9240de09fc2db24d79ce","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/18f50c9e628af083a52d9240de09fc2db24d79ce","html_url":"https://github.com/openai/codex/commit/18f50c9e628af083a52d9240de09fc2db24d79ce","comments_url":"https://api.github.com/repos/openai/codex/commits/18f50c9e628af083a52d9240de09fc2db24d79ce/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"0896bf6fc05ead454888b90044e1a08f99b6d778","url":"https://api.github.com/repos/openai/codex/commits/0896bf6fc05ead454888b90044e1a08f99b6d778","html_url":"https://github.com/openai/codex/commit/0896bf6fc05ead454888b90044e1a08f99b6d778"}]},{"sha":"0896bf6fc05ead454888b90044e1a08f99b6d778","node_id":"C_kwDOOYsS4doAKDA4OTZiZjZmYzA1ZWFkNDU0ODg4YjkwMDQ0ZTFhMDhmOTliNmQ3Nzg","commit":{"author":{"name":"Tamir Duberstein","email":"tamird@openai.com","date":"2026-07-26T22:13:59Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-26T22:19:45Z"},"message":"Skip inactive TUI threads without pending user interaction (#35525)\n\n## What changed\n\nOnly collect buffered requests from inactive threads whose event store reports\npending user input or approval. This keeps unrelated requests from being\nconsidered when pending interactions are surfaced after leaving a side\nconversation.\n\n## Testing\n\nExtend the side-conversation routing test with an unrelated dynamic tool request\nand verify that only the pending subagent approval is selected.\n\nGitOrigin-RevId: 388968277bde34bedc43187c1d1746d76166131e","tree":{"sha":"ec8dc18ec23116df625107b43c83c6f1bc5ebea7","url":"https://api.github.com/repos/openai/codex/git/trees/ec8dc18ec23116df625107b43c83c6f1bc5ebea7"},"url":"https://api.github.com/repos/openai/codex/git/commits/0896bf6fc05ead454888b90044e1a08f99b6d778","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/0896bf6fc05ead454888b90044e1a08f99b6d778","html_url":"https://github.com/openai/codex/commit/0896bf6fc05ead454888b90044e1a08f99b6d778","comments_url":"https://api.github.com/repos/openai/codex/commits/0896bf6fc05ead454888b90044e1a08f99b6d778/comments","author":{"login":"tamird","id":1535036,"node_id":"MDQ6VXNlcjE1MzUwMzY=","avatar_url":"https://avatars.githubusercontent.com/u/1535036?v=4","gravatar_id":"","url":"https://api.github.com/users/tamird","html_url":"https://github.com/tamird","followers_url":"https://api.github.com/users/tamird/followers","following_url":"https://api.github.com/users/tamird/following{/other_user}","gists_url":"https://api.github.com/users/tamird/gists{/gist_id}","starred_url":"https://api.github.com/users/tamird/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tamird/subscriptions","organizations_url":"https://api.github.com/users/tamird/orgs","repos_url":"https://api.github.com/users/tamird/repos","events_url":"https://api.github.com/users/tamird/events{/privacy}","received_events_url":"https://api.github.com/users/tamird/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"9ca6df68dafec86880952949b95354ce19e0599b","url":"https://api.github.com/repos/openai/codex/commits/9ca6df68dafec86880952949b95354ce19e0599b","html_url":"https://github.com/openai/codex/commit/9ca6df68dafec86880952949b95354ce19e0599b"}]},{"sha":"9ca6df68dafec86880952949b95354ce19e0599b","node_id":"C_kwDOOYsS4doAKDljYTZkZjY4ZGFmZWM4Njg4MDk1Mjk0OWI5NTM1NGNlMTllMDU5OWI","commit":{"author":{"name":"Felipe Coury","email":"felipe.coury@openai.com","date":"2026-07-26T22:09:41Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-26T22:15:29Z"},"message":"Preserve terminal turn errors in replayed history (#35524)\n\n## Why\n\nWhen rebuilding a thread from rollout events, errors embedded in turn completion\nevents were ignored. Failed retries could therefore be restored as completed\nturns, causing warnings such as model-overload errors to disappear from the TUI\ntranscript.\n\n## What changed\n\n- Mark turns with terminal completion errors as failed and retain their message\n  and structured error information.\n- Apply late completion errors to their matching historical turn without\n  interrupting the active turn.\n\n## Testing\n\nAdded history-builder coverage for current and late completion errors, plus a\nTUI replay snapshot covering repeated overload failures.\n\nGitOrigin-RevId: 5c474baa0fd5c73368b444d79fb850cbd4c8023a","tree":{"sha":"b328c56e6afe059f310d500e269d9b94b2eaf2b1","url":"https://api.github.com/repos/openai/codex/git/trees/b328c56e6afe059f310d500e269d9b94b2eaf2b1"},"url":"https://api.github.com/repos/openai/codex/git/commits/9ca6df68dafec86880952949b95354ce19e0599b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/9ca6df68dafec86880952949b95354ce19e0599b","html_url":"https://github.com/openai/codex/commit/9ca6df68dafec86880952949b95354ce19e0599b","comments_url":"https://api.github.com/repos/openai/codex/commits/9ca6df68dafec86880952949b95354ce19e0599b/comments","author":{"login":"fcoury-oai","id":272635208,"node_id":"U_kgDOEEAVSA","avatar_url":"https://avatars.githubusercontent.com/u/272635208?v=4","gravatar_id":"","url":"https://api.github.com/users/fcoury-oai","html_url":"https://github.com/fcoury-oai","followers_url":"https://api.github.com/users/fcoury-oai/followers","following_url":"https://api.github.com/users/fcoury-oai/following{/other_user}","gists_url":"https://api.github.com/users/fcoury-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/fcoury-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fcoury-oai/subscriptions","organizations_url":"https://api.github.com/users/fcoury-oai/orgs","repos_url":"https://api.github.com/users/fcoury-oai/repos","events_url":"https://api.github.com/users/fcoury-oai/events{/privacy}","received_events_url":"https://api.github.com/users/fcoury-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"5a3808b77d18668f2ec794e64de094112a2e600b","url":"https://api.github.com/repos/openai/codex/commits/5a3808b77d18668f2ec794e64de094112a2e600b","html_url":"https://github.com/openai/codex/commit/5a3808b77d18668f2ec794e64de094112a2e600b"}]},{"sha":"5a3808b77d18668f2ec794e64de094112a2e600b","node_id":"C_kwDOOYsS4doAKDVhMzgwOGI3N2QxODY2OGYyZWM3OTRlNjRkZTA5NDExMmEyZTYwMGI","commit":{"author":{"name":"Felipe Coury","email":"felipe.coury@openai.com","date":"2026-07-26T22:06:49Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-26T22:11:26Z"},"message":"Shut down the in-process outbound router explicitly (#35523)\n\n## Why\n\nDetached processor work can retain outgoing message senders, so waiting for\nchannel closure can keep the in-process app-server's outbound router alive\nduring shutdown.\n\n## What changed\n\nAdd an explicit shutdown signal for the outbound router and prioritize it over\npending outgoing messages. Send that signal after processor tasks are stopped\nso runtime shutdown no longer depends on every sender being dropped.\n\n## Testing\n\nAdd a paused-time test that verifies the router exits and closes its channel\neven when an outgoing sender is still retained.\n\nGitOrigin-RevId: a8f88d88a0950f50339b1c56909fedb781f178d4","tree":{"sha":"1dd2fe6b195ee233e555e6b222f8187013d41fdb","url":"https://api.github.com/repos/openai/codex/git/trees/1dd2fe6b195ee233e555e6b222f8187013d41fdb"},"url":"https://api.github.com/repos/openai/codex/git/commits/5a3808b77d18668f2ec794e64de094112a2e600b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/5a3808b77d18668f2ec794e64de094112a2e600b","html_url":"https://github.com/openai/codex/commit/5a3808b77d18668f2ec794e64de094112a2e600b","comments_url":"https://api.github.com/repos/openai/codex/commits/5a3808b77d18668f2ec794e64de094112a2e600b/comments","author":{"login":"fcoury-oai","id":272635208,"node_id":"U_kgDOEEAVSA","avatar_url":"https://avatars.githubusercontent.com/u/272635208?v=4","gravatar_id":"","url":"https://api.github.com/users/fcoury-oai","html_url":"https://github.com/fcoury-oai","followers_url":"https://api.github.com/users/fcoury-oai/followers","following_url":"https://api.github.com/users/fcoury-oai/following{/other_user}","gists_url":"https://api.github.com/users/fcoury-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/fcoury-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fcoury-oai/subscriptions","organizations_url":"https://api.github.com/users/fcoury-oai/orgs","repos_url":"https://api.github.com/users/fcoury-oai/repos","events_url":"https://api.github.com/users/fcoury-oai/events{/privacy}","received_events_url":"https://api.github.com/users/fcoury-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"61a44880a85d2fd0d8770908dea5733495e571c8","url":"https://api.github.com/repos/openai/codex/commits/61a44880a85d2fd0d8770908dea5733495e571c8","html_url":"https://github.com/openai/codex/commit/61a44880a85d2fd0d8770908dea5733495e571c8"}]},{"sha":"61a44880a85d2fd0d8770908dea5733495e571c8","node_id":"C_kwDOOYsS4doAKDYxYTQ0ODgwYTg1ZDJmZDBkODc3MDkwOGRlYTU3MzM0OTVlNTcxYzg","commit":{"author":{"name":"rka-oai","email":"rka@openai.com","date":"2026-07-26T01:10:47Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-26T01:23:38Z"},"message":"Raise the MCP server recursion limit (#35414)\n\n## What changed\n\n- Set the Rust recursion limit to 256 for both the MCP server library and binary crates.\n- Populate `started_at_ms` in the thread-fork test's completed-item fixture.\n\nGitOrigin-RevId: b25eeaeecaf94265fe3be8f23cb3c395595afc2a","tree":{"sha":"d4e319b0d00c0adb679b877c1c3a3e358d7d5287","url":"https://api.github.com/repos/openai/codex/git/trees/d4e319b0d00c0adb679b877c1c3a3e358d7d5287"},"url":"https://api.github.com/repos/openai/codex/git/commits/61a44880a85d2fd0d8770908dea5733495e571c8","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/61a44880a85d2fd0d8770908dea5733495e571c8","html_url":"https://github.com/openai/codex/commit/61a44880a85d2fd0d8770908dea5733495e571c8","comments_url":"https://api.github.com/repos/openai/codex/commits/61a44880a85d2fd0d8770908dea5733495e571c8/comments","author":{"login":"rka-oai","id":240799229,"node_id":"U_kgDODlpN_Q","avatar_url":"https://avatars.githubusercontent.com/u/240799229?v=4","gravatar_id":"","url":"https://api.github.com/users/rka-oai","html_url":"https://github.com/rka-oai","followers_url":"https://api.github.com/users/rka-oai/followers","following_url":"https://api.github.com/users/rka-oai/following{/other_user}","gists_url":"https://api.github.com/users/rka-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rka-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rka-oai/subscriptions","organizations_url":"https://api.github.com/users/rka-oai/orgs","repos_url":"https://api.github.com/users/rka-oai/repos","events_url":"https://api.github.com/users/rka-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rka-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"62fd410384cca008446c2d64a4f2b3f915f4906e","url":"https://api.github.com/repos/openai/codex/commits/62fd410384cca008446c2d64a4f2b3f915f4906e","html_url":"https://github.com/openai/codex/commit/62fd410384cca008446c2d64a4f2b3f915f4906e"}]},{"sha":"62fd410384cca008446c2d64a4f2b3f915f4906e","node_id":"C_kwDOOYsS4doAKDYyZmQ0MTAzODRjY2EwMDg0NDZjMmQ2NGE0ZjJiM2Y5MTVmNDkwNmU","commit":{"author":{"name":"victor-openai","email":"victor@openai.com","date":"2026-07-25T23:49:05Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-25T23:54:08Z"},"message":"Ignore generated system skills in the skills watcher (#35408)\n\n## What changed\n\n- Exclude `SkillScope::System` roots from watcher registration because generated\n  system skills are installed before the watcher starts.\n- Ignore events under the system skill cache that arrive through the recursively\n  watched legacy user-skills root, avoiding unnecessary cache clears and\n  `SkillsChanged` notifications.\n\nGitOrigin-RevId: ce8ba28ba873372b638950b676e4d09172a5c688","tree":{"sha":"885c8ddcb88478020a0283af1cd0f19b6869ec23","url":"https://api.github.com/repos/openai/codex/git/trees/885c8ddcb88478020a0283af1cd0f19b6869ec23"},"url":"https://api.github.com/repos/openai/codex/git/commits/62fd410384cca008446c2d64a4f2b3f915f4906e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/62fd410384cca008446c2d64a4f2b3f915f4906e","html_url":"https://github.com/openai/codex/commit/62fd410384cca008446c2d64a4f2b3f915f4906e","comments_url":"https://api.github.com/repos/openai/codex/commits/62fd410384cca008446c2d64a4f2b3f915f4906e/comments","author":{"login":"victor-openai","id":204937719,"node_id":"U_kgDODDcZ9w","avatar_url":"https://avatars.githubusercontent.com/u/204937719?v=4","gravatar_id":"","url":"https://api.github.com/users/victor-openai","html_url":"https://github.com/victor-openai","followers_url":"https://api.github.com/users/victor-openai/followers","following_url":"https://api.github.com/users/victor-openai/following{/other_user}","gists_url":"https://api.github.com/users/victor-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/victor-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/victor-openai/subscriptions","organizations_url":"https://api.github.com/users/victor-openai/orgs","repos_url":"https://api.github.com/users/victor-openai/repos","events_url":"https://api.github.com/users/victor-openai/events{/privacy}","received_events_url":"https://api.github.com/users/victor-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"20dafe201d91d4405eef05ecd1db0257f13a9ac8","url":"https://api.github.com/repos/openai/codex/commits/20dafe201d91d4405eef05ecd1db0257f13a9ac8","html_url":"https://github.com/openai/codex/commit/20dafe201d91d4405eef05ecd1db0257f13a9ac8"}]},{"sha":"20dafe201d91d4405eef05ecd1db0257f13a9ac8","node_id":"C_kwDOOYsS4doAKDIwZGFmZTIwMWQ5MWQ0NDA1ZWVmMDVlY2QxZGIwMjU3ZjEzYTlhYzg","commit":{"author":{"name":"Felipe Coury","email":"felipe.coury@openai.com","date":"2026-07-25T19:24:41Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-25T19:28:57Z"},"message":"Make the keymap action menu responsive (#35375)\n\n## What changed\n\n- Stack action descriptions below their labels when the keymap action menu is too narrow for a readable description column.\n- Keep descriptions column-aligned at wider terminal widths.\n- Show a dash instead of a number beside the disabled remove-binding action.\n\n## Testing\n\n- Add snapshot coverage for the action menu at 48, 64, and 96 columns.\n\nGitOrigin-RevId: 25b97fd2d8764563e0a0c36d436711f2429093c4","tree":{"sha":"3e7e724066bae5eccd7a5c0013a349fb4ab0124f","url":"https://api.github.com/repos/openai/codex/git/trees/3e7e724066bae5eccd7a5c0013a349fb4ab0124f"},"url":"https://api.github.com/repos/openai/codex/git/commits/20dafe201d91d4405eef05ecd1db0257f13a9ac8","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/20dafe201d91d4405eef05ecd1db0257f13a9ac8","html_url":"https://github.com/openai/codex/commit/20dafe201d91d4405eef05ecd1db0257f13a9ac8","comments_url":"https://api.github.com/repos/openai/codex/commits/20dafe201d91d4405eef05ecd1db0257f13a9ac8/comments","author":{"login":"fcoury-oai","id":272635208,"node_id":"U_kgDOEEAVSA","avatar_url":"https://avatars.githubusercontent.com/u/272635208?v=4","gravatar_id":"","url":"https://api.github.com/users/fcoury-oai","html_url":"https://github.com/fcoury-oai","followers_url":"https://api.github.com/users/fcoury-oai/followers","following_url":"https://api.github.com/users/fcoury-oai/following{/other_user}","gists_url":"https://api.github.com/users/fcoury-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/fcoury-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fcoury-oai/subscriptions","organizations_url":"https://api.github.com/users/fcoury-oai/orgs","repos_url":"https://api.github.com/users/fcoury-oai/repos","events_url":"https://api.github.com/users/fcoury-oai/events{/privacy}","received_events_url":"https://api.github.com/users/fcoury-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"322d5b96cfa5c8fd52bd83ecfdb79cd9b330205f","url":"https://api.github.com/repos/openai/codex/commits/322d5b96cfa5c8fd52bd83ecfdb79cd9b330205f","html_url":"https://github.com/openai/codex/commit/322d5b96cfa5c8fd52bd83ecfdb79cd9b330205f"}]},{"sha":"322d5b96cfa5c8fd52bd83ecfdb79cd9b330205f","node_id":"C_kwDOOYsS4doAKDMyMmQ1Yjk2Y2ZhNWM4ZmQ1MmJkODNlY2ZkYjc5Y2Q5YjMzMDIwNWY","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-07-25T16:18:05Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-25T16:22:44Z"},"message":"Keep unified mention results fresh (#35365)\n\n## What changed\n\n- Restart file search whenever a unified mention popup opens so restored or repeated queries receive results instead of inheriting stale search state.\n- Cache the popup's filtered rows and refresh them when the query, file matches, search mode, skills, or plugins change.\n\n## Testing\n\n- Add regression tests for bare, reopened, and restored unified mention searches.\n\nGitOrigin-RevId: 9d38438fade01a0552e03cb05e023ee64af60a4c","tree":{"sha":"f6400792cf55b018daff7a8dd3e1c092db02b66e","url":"https://api.github.com/repos/openai/codex/git/trees/f6400792cf55b018daff7a8dd3e1c092db02b66e"},"url":"https://api.github.com/repos/openai/codex/git/commits/322d5b96cfa5c8fd52bd83ecfdb79cd9b330205f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/322d5b96cfa5c8fd52bd83ecfdb79cd9b330205f","html_url":"https://github.com/openai/codex/commit/322d5b96cfa5c8fd52bd83ecfdb79cd9b330205f","comments_url":"https://api.github.com/repos/openai/codex/commits/322d5b96cfa5c8fd52bd83ecfdb79cd9b330205f/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"5c36e869c1a7bdc5ec4c1325d02e60dfbadcc9b8","url":"https://api.github.com/repos/openai/codex/commits/5c36e869c1a7bdc5ec4c1325d02e60dfbadcc9b8","html_url":"https://github.com/openai/codex/commit/5c36e869c1a7bdc5ec4c1325d02e60dfbadcc9b8"}]},{"sha":"5c36e869c1a7bdc5ec4c1325d02e60dfbadcc9b8","node_id":"C_kwDOOYsS4doAKDVjMzZlODY5YzFhN2JkYzVlYzRjMTMyNWQwMmU2MGRmYmFkY2M5Yjg","commit":{"author":{"name":"tongzhou wang","email":"tz@openai.com","date":"2026-07-25T16:07:34Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-25T16:12:42Z"},"message":"Bound Code Mode metadata compatibility headers (#35364)\n\n## Why\n\nThe Code Mode tool-name mapping is unbounded and can make HTTP and WebSocket\nheaders grow without limit.\n\n## What changed\n\nOmit `code_mode_tool_names` from the direct `x-codex-turn-metadata`\ncompatibility header while retaining it in the canonical\n`client_metadata[\"x-codex-turn-metadata\"]` payload.\n\nGitOrigin-RevId: 494a30b6846e32ab44eb79b08dfec63360f563a7","tree":{"sha":"b6a472149200c01d8a46ee865c35ef4adab7c1e4","url":"https://api.github.com/repos/openai/codex/git/trees/b6a472149200c01d8a46ee865c35ef4adab7c1e4"},"url":"https://api.github.com/repos/openai/codex/git/commits/5c36e869c1a7bdc5ec4c1325d02e60dfbadcc9b8","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/5c36e869c1a7bdc5ec4c1325d02e60dfbadcc9b8","html_url":"https://github.com/openai/codex/commit/5c36e869c1a7bdc5ec4c1325d02e60dfbadcc9b8","comments_url":"https://api.github.com/repos/openai/codex/commits/5c36e869c1a7bdc5ec4c1325d02e60dfbadcc9b8/comments","author":{"login":"tz-openai","id":191285271,"node_id":"U_kgDOC2bIFw","avatar_url":"https://avatars.githubusercontent.com/u/191285271?v=4","gravatar_id":"","url":"https://api.github.com/users/tz-openai","html_url":"https://github.com/tz-openai","followers_url":"https://api.github.com/users/tz-openai/followers","following_url":"https://api.github.com/users/tz-openai/following{/other_user}","gists_url":"https://api.github.com/users/tz-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/tz-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tz-openai/subscriptions","organizations_url":"https://api.github.com/users/tz-openai/orgs","repos_url":"https://api.github.com/users/tz-openai/repos","events_url":"https://api.github.com/users/tz-openai/events{/privacy}","received_events_url":"https://api.github.com/users/tz-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"af7f6f4d346a71e78869f4c0e507160f921fffed","url":"https://api.github.com/repos/openai/codex/commits/af7f6f4d346a71e78869f4c0e507160f921fffed","html_url":"https://github.com/openai/codex/commit/af7f6f4d346a71e78869f4c0e507160f921fffed"}]},{"sha":"af7f6f4d346a71e78869f4c0e507160f921fffed","node_id":"C_kwDOOYsS4doAKGFmN2Y2ZjRkMzQ2YTcxZTc4ODY5ZjRjMGU1MDcxNjBmOTIxZmZmZWQ","commit":{"author":{"name":"Owen Lin","email":"owen@openai.com","date":"2026-07-25T15:59:00Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-25T16:06:54Z"},"message":"Include item start times in completion events (#35363)\n\n## What changed\n\n- Add an optional `started_at_ms` field to `ItemCompletedEvent`, retaining\n  compatibility with older persisted events that lack it.\n- Track the first start timestamp for each in-flight item and attach it when\n  emitting and persisting the completion event. If no start was recorded, use\n  the completion timestamp as a fallback.\n- Emit a complete start/completion lifecycle for subagent activity items.\n\n## Testing\n\n- Cover concurrent item timing, repeated starts, turn-boundary cleanup, the\n  missing-start fallback, subagent activity, and persisted web-search events.\n\nGitOrigin-RevId: e7cec9c4f1ef6ba67f287e81fb4d7d856fcf87a7","tree":{"sha":"13c1c0b536242bc0375ec6d9b2872a9d1b3c0e73","url":"https://api.github.com/repos/openai/codex/git/trees/13c1c0b536242bc0375ec6d9b2872a9d1b3c0e73"},"url":"https://api.github.com/repos/openai/codex/git/commits/af7f6f4d346a71e78869f4c0e507160f921fffed","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/af7f6f4d346a71e78869f4c0e507160f921fffed","html_url":"https://github.com/openai/codex/commit/af7f6f4d346a71e78869f4c0e507160f921fffed","comments_url":"https://api.github.com/repos/openai/codex/commits/af7f6f4d346a71e78869f4c0e507160f921fffed/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"3a08af44b2a4450bab0a9393f9d36ae621dde6bb","url":"https://api.github.com/repos/openai/codex/commits/3a08af44b2a4450bab0a9393f9d36ae621dde6bb","html_url":"https://github.com/openai/codex/commit/3a08af44b2a4450bab0a9393f9d36ae621dde6bb"}]},{"sha":"3a08af44b2a4450bab0a9393f9d36ae621dde6bb","node_id":"C_kwDOOYsS4doAKDNhMDhhZjQ0YjJhNDQ1MGJhYjBhOTM5M2Y5ZDM2YWU2MjFkZGU2YmI","commit":{"author":{"name":"viyatb-oai","email":"viyatb@openai.com","date":"2026-07-25T15:57:36Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-25T16:03:00Z"},"message":"Handle exec-server network policy requests in the client (#35359)\n\n## What changed\n\n- Add client-side handling for exec-server network policy requests, including request validation, per-process decision routing, and allow, deny, or ask responses.\n- Bound concurrent callbacks and fail closed when requests are invalid, exceed capacity, time out, or outlive their process session.\n- Replace the callback opt-in flag with a launch-level `policyDecisionTimeoutMs` value and include transport overhead in the executor timeout.\n- Preserve callback admission limits across connection recovery and clean up policy state when process startup is abandoned or a session ends.\n\n## Testing\n\n- Cover decision forwarding, invalid and excess requests, cancellation during process cleanup, abandoned starts, timeout propagation, and launch-config serialization.\n\nGitOrigin-RevId: 6ee2a0139e0f8170cf1a5cdd646bd811b7d3c1f6","tree":{"sha":"1975f445eb46cded70bd70a53432b7bb3fcc7de5","url":"https://api.github.com/repos/openai/codex/git/trees/1975f445eb46cded70bd70a53432b7bb3fcc7de5"},"url":"https://api.github.com/repos/openai/codex/git/commits/3a08af44b2a4450bab0a9393f9d36ae621dde6bb","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/3a08af44b2a4450bab0a9393f9d36ae621dde6bb","html_url":"https://github.com/openai/codex/commit/3a08af44b2a4450bab0a9393f9d36ae621dde6bb","comments_url":"https://api.github.com/repos/openai/codex/commits/3a08af44b2a4450bab0a9393f9d36ae621dde6bb/comments","author":{"login":"viyatb-oai","id":234056686,"node_id":"U_kgDODfNr7g","avatar_url":"https://avatars.githubusercontent.com/u/234056686?v=4","gravatar_id":"","url":"https://api.github.com/users/viyatb-oai","html_url":"https://github.com/viyatb-oai","followers_url":"https://api.github.com/users/viyatb-oai/followers","following_url":"https://api.github.com/users/viyatb-oai/following{/other_user}","gists_url":"https://api.github.com/users/viyatb-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/viyatb-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/viyatb-oai/subscriptions","organizations_url":"https://api.github.com/users/viyatb-oai/orgs","repos_url":"https://api.github.com/users/viyatb-oai/repos","events_url":"https://api.github.com/users/viyatb-oai/events{/privacy}","received_events_url":"https://api.github.com/users/viyatb-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4c43465133428898aa84f0bfc02c306ed65fb66a","url":"https://api.github.com/repos/openai/codex/commits/4c43465133428898aa84f0bfc02c306ed65fb66a","html_url":"https://github.com/openai/codex/commit/4c43465133428898aa84f0bfc02c306ed65fb66a"}]},{"sha":"4c43465133428898aa84f0bfc02c306ed65fb66a","node_id":"C_kwDOOYsS4doAKDRjNDM0NjUxMzM0Mjg4OThhYTg0ZjBiZmMwMmMzMDZlZDY1ZmI2NmE","commit":{"author":{"name":"xli-oai","email":"xli@openai.com","date":"2026-07-25T02:04:13Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-25T02:09:11Z"},"message":"Skip plugin MCP filtering when no allowlists are configured (#35280)\n\n## What changed\n\n- Leave plugin MCP servers unchanged when every plugin requirement omits\n  `mcp_servers`.\n- Continue treating an explicitly empty `mcp_servers` allowlist as deny-all.\n\n## Testing\n\nAdded coverage for both absent and explicitly empty plugin MCP allowlists.\n\nGitOrigin-RevId: 80bb9aa6bbd779d669c573f63681dc46019b668c","tree":{"sha":"0595b8dcf1e7da753bd10970c3cdac8eb6d64361","url":"https://api.github.com/repos/openai/codex/git/trees/0595b8dcf1e7da753bd10970c3cdac8eb6d64361"},"url":"https://api.github.com/repos/openai/codex/git/commits/4c43465133428898aa84f0bfc02c306ed65fb66a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4c43465133428898aa84f0bfc02c306ed65fb66a","html_url":"https://github.com/openai/codex/commit/4c43465133428898aa84f0bfc02c306ed65fb66a","comments_url":"https://api.github.com/repos/openai/codex/commits/4c43465133428898aa84f0bfc02c306ed65fb66a/comments","author":{"login":"xli-oai","id":270779301,"node_id":"U_kgDOECPDpQ","avatar_url":"https://avatars.githubusercontent.com/u/270779301?v=4","gravatar_id":"","url":"https://api.github.com/users/xli-oai","html_url":"https://github.com/xli-oai","followers_url":"https://api.github.com/users/xli-oai/followers","following_url":"https://api.github.com/users/xli-oai/following{/other_user}","gists_url":"https://api.github.com/users/xli-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/xli-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/xli-oai/subscriptions","organizations_url":"https://api.github.com/users/xli-oai/orgs","repos_url":"https://api.github.com/users/xli-oai/repos","events_url":"https://api.github.com/users/xli-oai/events{/privacy}","received_events_url":"https://api.github.com/users/xli-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c3e926e61cb234fc180d8896bdb9655b58c3e735","url":"https://api.github.com/repos/openai/codex/commits/c3e926e61cb234fc180d8896bdb9655b58c3e735","html_url":"https://github.com/openai/codex/commit/c3e926e61cb234fc180d8896bdb9655b58c3e735"}]}]