[{"sha":"c7d529ca0fc478dec9060ea04bcc8589f9b1cd3a","node_id":"C_kwDOPTymldoAKGM3ZDUyOWNhMGZjNDc4ZGVjOTA2MGVhMDRiY2M4NTg5ZjliMWNkM2E","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-01T22:02:50Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-01T22:02:50Z"},"message":"feat(code): list valid extras when `/install` has no argument (#3695)\n\nRunning `/install` in dcode with no argument previously printed only\n`Usage: /install <extra> [--force]`, leaving users to guess which extras\nexist or dig through `pyproject.toml`. The no-arg path now renders the\nfull set of installable extras grouped by category, so discovery happens\ninline.","tree":{"sha":"b22c2b0e27a168d5744fa4f9a4bb325c5b2cac9f","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/b22c2b0e27a168d5744fa4f9a4bb325c5b2cac9f"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/c7d529ca0fc478dec9060ea04bcc8589f9b1cd3a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqHgGKCRC1aQ7uu5UhlAAA1coQAILgCYOApsVdH0F7d6Jl+8GJ\n+i8fztk5EheTTBf9m3/5422QwTOsFw3NpcV/Dtw1Co2jHDobfBNs4og9/hN9bzLZ\nizl5XYopTo7onILDzMdpD2cKutWXCeg0Yu6J/13XqyVp9i009nIlc8Qlmz5oi2wv\naV/CFeEMzR86hmyCOW/A0jKzXo+TjlhzLQUOUt9knhCSS5DCqV2yQQ6op6hVkkZO\n9j0s3Qe3yrxgT2ofvyLzUTDBDvefzTklwBgb3Aq4H1tcNTxAa/w98uxiEHzQALQg\nB1flF5Wqhw4FVtRQA2IBVcEVFrm0XQvi1S+HcgiO8bJWeYjHL3pOl8EafU2DoCAP\nu5pgGKT6xzQXNlq2uvEMLZSMtmHS9+fbWKAcCC0K57tmN85eCx7cOD1P+ssTRa6n\n4S2jLLIkh2wP/0BdHnuCYe6/jU3FtWAFEkYNrKu1mm69xb0EA/j2fCdT66eJpqgD\ng/pyp6VNKy/sVS0pcwsyCoTfb42CewqwSGDNyd4s+E6e0Wh2dFxBJgQZQ4KOlHBi\nvsumNa16p7hOTCnYAUCr2LaAxshAcV3elkpa19ttzxajy2V0Bg5X8+dKKuYzqrXD\nSLh0XGGaBUTqOXlaZYJZzcRgzS1lQ07HGbjfcd0oQgKPgKkHLBgRa4OORy846CP7\nA69RPTkD2Bn5mRDZm8x+\n=0ixv\n-----END PGP SIGNATURE-----\n","payload":"tree b22c2b0e27a168d5744fa4f9a4bb325c5b2cac9f\nparent c62e56a80a22719164a31fb5d7c969f6f6980e73\