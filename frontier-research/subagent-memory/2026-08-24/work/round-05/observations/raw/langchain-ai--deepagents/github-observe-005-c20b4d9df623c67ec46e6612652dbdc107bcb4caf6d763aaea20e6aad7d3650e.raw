ac58d3e14aa8b7ab099b6db74d","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/0355416c0d4817ac58d3e14aa8b7ab099b6db74d","html_url":"https://github.com/langchain-ai/deepagents/commit/0355416c0d4817ac58d3e14aa8b7ab099b6db74d"}]},{"sha":"0355416c0d4817ac58d3e14aa8b7ab099b6db74d","node_id":"C_kwDOPTymldoAKDAzNTU0MTZjMGQ0ODE3YWM1OGQzZTE0YWE4YjdhYjA5OWI2ZGI3NGQ","commit":{"author":{"name":"Johannes du Plessis","email":"johannes@langchain.dev","date":"2026-08-11T23:17:07Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-11T23:17:07Z"},"message":"feat(code): add `/context` usage report (#5407)\n\n`/context` now opens a color-coded context-window visualization with\nmodel totals, a proportional usage bar, category breakdown, and\nremaining capacity.\n\n---\n\nProvider-reported totals remain distinct from local estimates, and\npost-offload conversation usage is reconstructed from the effective\ncompacted history.\n\n## Screenshots\n<img width=\"750\" height=\"763\" alt=\"Screenshot 2026-08-10 at 4 26 34 PM\"\nsrc=\"https://github.com/user-attachments/assets/d7c196b2-0558-4f6e-b170-33693d3ca8e8\"\n/>\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/019fee0f-a502-762b-bbcb-08ec3cbc181c)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"de4df1cfc4e8b95caec7916ef255d652cf6df968","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/de4df1cfc4e8b95caec7916ef255d652cf6df968"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/0355416c0d4817ac58d3e14aa8b7ab099b6db74d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqe61zCRC1aQ7uu5UhlAAA844QABC6kiDsSxBbwucG5CEN0NlY\nLdkwbi2etuEDNUk/Ilu8xIMmMYYRNdPp1RWCrSqXEkQFqDPhcaLdT0TBp7GMAvLv\nj+L2RHp60XVxnOSKKpuNmP7US+ZckWW0hBO6SF3Tv92u2Z+cR49kpQeVNg/Qgkjv\nZihyfBUBe8lyodUH9Oi19ip5dtYRJcGhZqJc8bO55n8BOJxHJdylAefq/A5BmPks\n3rRSVakm4Q4n7/2qMCh3VitlLc4JchPL4qw6Mrzdo6kZgJ3RnJMQkxLxjFdAVGj9\nrUY3q+RfdCZPgrqkQDxo/uEVzCFKjB2MEJZ5rnesJaejyuYP3AVcCTddhizjOlYW\n2slrvC5FY9UxoDsXdG48Cuvuxu3JrpLxERH+ix4MmsNIP7Etiq0OHAQJw/zZqBWK\nVm1T9ewFOLteATmJCmjDfRheokIrRSVIjJH69eK1KQjw4+uR9MYOEFUClIKZp+Nk\nlT5lZ8IXty5G+0RvW4jLOSRcmmbpujj2D8fS4uPDruLRwtHKcT9H1JCXc9srtx5L\nOplLLboUHfHO0TDK/uTuWw7/9PXLwILRtm+nSx/uB3uvWajMCv0qVxlauHiOMAOi\ngTeZvDPDFn6IGLqv8chrgubKGgsKeU56L5xnZ6EkqRm8pfhKd4trZNbWRWvW4QPg\nIar1WpYokeA6wGToMmNy\n=C/tz\n-----END PGP SIGNATURE-----\n","payload":"tree de4df1cfc4e8b95caec7916ef255d652cf6df968\nparent 61d32797ef85d1380e356cd2f9de1eb7926417ec\nauthor Johannes du Plessis <johannes@langchain.dev> 1786490227 -0700\ncommitter GitHub <noreply@github.com> 1786490227 -0700\n\nfeat(code): add `/context` usage report (#5407)\n\n`/context` now opens a color-coded context-window visualization with\nmodel totals, a proportional usage bar, category breakdown, and\nremaining capacity.\n\n---\n\nProvider-reported totals remain distinct from local estimates, and\npost-offload conversation usage is reconstructed from the effective\ncompacted history.\n\n## Screenshots\n<img width=\"750\" height=\"763\" alt=\"Screenshot 2026-08-10 at 4 26 34 PM\"\nsrc=\"https://github.com/user-attachments/assets/d7c196b2-0558-4f6e-b170-33693d3ca8e8\"\n/>\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/019fee0f-a502-762b-bbcb-08ec3cbc181c)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-08-11T23:17:12Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/0355416c0d4817ac58d3e14aa8b7ab099b6db74d","html_url":"https://github.com/langchain-ai/deepagents/commit/0355416c0d4817ac58d3e14aa8b7ab099b6db74d","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/0355416c0d4817ac58d3e14aa8b7ab099b6db74d/comments","author":{"login":"johannes117","id":51395795,"node_id":"MDQ6VXNlcjUxMzk1Nzk1","avatar_url":"https://avatars.githubusercontent.com/u/51395795?v=4","gravatar_id":"","url":"https://api.github.com/users/johannes117","html_url":"https://github.com/johannes117","followers_url":"https://api.github.com/users/johannes117/followers","following_url":"https://api.github.com/users/johannes117/following{/other_user}","gists_url":"https://api.github.com/users/johannes117/gists{/gist_id}","starred_url":"https://api.github.com/users/johannes117/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/johannes117/subscriptions","organizations_url":"https://api.github.com/users/johannes117/orgs","repos_url":"https://api.github.com/users/johannes117/repos","events_url":"https://api.github.com/users/johannes117/events{/privacy}","received_events_url":"https://api.github.com/users/johannes117/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"61d32797ef85d1380e356cd2f9de1eb7926417ec","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/61d32797ef85d1380e356cd2f9de1eb7926417ec","html_url":"https://github.com/langchain-ai/deepagents/commit/61d32797ef85d1380e356cd2f9de1eb7926417ec"}]},{"sha":"61d32797ef85d1380e356cd2f9de1eb7926417ec","node_id":"C_kwDOPTymldoAKDYxZDMyNzk3ZWY4NWQxMzgwZTM1NmNkMmY5ZGUxZWI3OTI2NDE3ZWM","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-08-11T22:11:18Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-11T22:11:18Z"},"message":"fix(code): clarify project hooks trust prompt and stop prompting for user hooks (#5426)\n\nThe project hooks trust prompt now states what is actually being\ntrusted, and no longer offers the user's own hooks file as if a project\nhad shipped it.\n\n## Prompt copy\n\n```\nProject hooks can run arbitrary shell commands on your machine.\nHooks file: /path/to/project/.deepagents/hooks.json\nOnly trust projects you control. Allow once runs this file as it is now;\nalways allow trusts \"/path/to/project\" for future sessions and future edits.\n```\n\nThe old copy said hooks \"can execute commands from <path>\" and named\nneither the scope nor the directory the grant attaches to. The\ndistinction matters: allow once fingerprints `hooks.json` (edits\ninvalidate the grant); only always allow survives edits and later\nsessions. `HookTrustScreen` (shown on cwd switch) carries the same\nwording.\n\n## User hooks are no longer promptable as project hooks\n\nLaunching from `~` with no enclosing Git repo made the project hooks\npath identical to the user hooks path (`~/.deepagents/hooks.json`), so\nthe prompt asked the user to grant project trust to their own config —\nand granting it subjected that file to the project-hook gate. The trust\ncheck now returns an ungranted policy when the two paths coincide.\n\nNon-Git workspaces otherwise keep working: the hooks loader resolves a\nnon-repo directory as its own project root, so gating on a Git root\nwould have silently stopped loading hooks that still get read.\n\n## Path escaping\n\nPrompt paths are interpolated into Rich markup; a directory named\n`proj[bold]x` would render as `projx`. Paths are now escaped.","tree":{"sha":"85c06dabf8e22024cf8eee080a803b1691c4e713","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/85c06dabf8e22024cf8eee080a803b1691c4e713"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/61d32797ef85d1380e356cd2f9de1eb7926417ec","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqe54GCRC1aQ7uu5UhlAAAo1oQAF+Fc6DgqxD7f8FZA6Dgox3D\nNhtmUyNgE0pZJk83eeknr8OzJ6soIFRQmVQiTcedp0U/D3vKZcfX4PaHswAJ7RyI\nGH2r6FVs0zD/aY7VciYPk8v1ZnApI8Ihr3eD8+YVfRCj013S+tHFYyqoBQ6rmafY\nezNduS2L1qZ+VSklucuE8QLsTWkhkXdLvxjwnZG/fd8mrHbAn1acYP5pKA2Z0w4L\nrdhleLmZGDTWT/lBi9MlOgVornV4kfmN2A8kv9hNE21Itmh5/aaFhpv9KPK/7hVZ\nPgTMIDLTcTI6munyohr5BdH6LOKdJ30o9Y6dv6bjHoWVvJdh5KB1jYLFNU3JCRvZ\nzqWsw9QHHX/03lRbQE9K/Pc3SvtddlRlGOsuVjsv1uVmPRx3+7jYYIz0qkP4TMNK\njesEn/BzgnA4ZwG/PAMCpKWqWXl9jySmXj7lsoUpTA57DrOJkE1VHVAlOZc6e0UG\nkqTybrN9VHx3UyagOleq4kLvACmBHE7rSDEY7a7lItuUr/815ZV+d60XIuS1ltFw\nEtijNoff6qGEC9zxy804Ra0qWgIKDkjp+FzUeZFh3JsecC2wakIRBwYusdQmVx+i\n6g81EWwd2dCzPxej2Y8OCdBKPiTNX59SC8ElcAJ30TbTCDani9LR0DZ0Qw9Pp/cR\nYS9Wzql3/OPJuroPxyli\n=CPXG\n-----END PGP SIGNATURE-----\n","payload":"tree 85c06dabf8e22024cf8eee080a803b1691c4e713\nparent aaefb1eea1652abf370b5ac699be8307aee979e5\nauthor Mason Daugherty <mason@langchain.dev> 1786486278 -0700\ncommitter GitHub <noreply@github.com> 1786486278 -0700\n\nfix(code): clarify project hooks trust prompt and stop prompting for user hooks (#5426)\n\nThe project hooks trust prompt now states what is actually being\ntrusted, and no longer offers the user's own hooks file as if a project\nhad shipped it.\n\n## Prompt copy\n\n```\nProject hooks can run arbitrary shell commands on your machine.\nHooks file: /path/to/project/.deepagents/hooks.json\nOnly trust projects you control. Allow once runs this file as it is now;\nalways allow trusts \"/path/to/project\" for future sessions and future edits.\n```\n\nThe old copy said hooks \"can execute commands from <path>\" and named\nneither the scope nor the directory the grant attaches to. The\ndistinction matters: allow once fingerprints `hooks.json` (edits\ninvalidate the grant); only always allow survives edits and later\nsessions. `HookTrustScreen` (shown on cwd switch) carries the same\nwording.\n\n## User hooks are no longer promptable as project hooks\n\nLaunching from `~` with no enclosing Git repo made the project hooks\npath identical to the user hooks path (`~/.deepagents/hooks.json`), so\nthe prompt asked the user to grant project trust to their own config —\nand granting it subjected that file to the project-hook gate. The trust\ncheck now returns an ungranted policy when the two paths coincide.\n\nNon-Git workspaces otherwise keep working: the hooks loader resolves a\nnon-repo directory as its own project root, so gating on a Git root\nwould have silently stopped loading hooks that still get read.\n\n## Path escaping\n\nPrompt paths are interpolated into Rich markup; a directory named\n`proj[bold]x` would render as `projx`. Paths are now escaped.","verified_at":"2026-08-11T22:11:22Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/61d32797ef85d1380e356cd2f9de1eb7926417ec","html_url":"https://github.com/langchain-ai/deepagents/commit/61d32797ef85d1380e356cd2f9de1eb7926417ec","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/61d32797ef85d1380e356cd2f9de1eb7926417ec/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"aaefb1eea1652abf370b5ac699be8307aee979e5","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/aaefb1eea1652abf370b5ac699be8307aee979e5","html_url":"https://github.com/langchain-ai/deepagents/commit/aaefb1eea1652abf370b5ac699be8307aee979e5"}]},{"sha":"aaefb1eea1652abf370b5ac699be8307aee979e5","node_id":"C_kwDOPTymldoAKGFhZWZiMWVlYTE2NTJhYmYzNzBiNWFjNjk5YmU4MzA3YWVlOTc5ZTU","commit":{"author":{"name":"Johannes du Plessis","email":"johannes@langchain.dev","date":"2026-08-11T21:53:37Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-11T21:53:37Z"},"message":"feat(acp): support persistent session loading (#5365)\n\nACP agents can now opt into durable `session/load`, restoring session\nconfiguration and replaying complete conversation history after process\nrestarts.\n\n---\n\n`AgentServerACP` previously exposed only in-process threads. This adds\nan explicit `load_sessions` capability backed by the graph checkpointer,\npersists ACP ownership, cwd, mode, and model metadata, and returns\nprotocol errors for unknown sessions or mismatched working directories.\n\nReplay is reconstructed across checkpoint history so messages removed\nfrom the latest state by compaction are still included, as required by\nACP v1. Tool calls and multimodal message content are converted back\ninto their ACP session-update forms. The feature remains opt-in so\nexisting adapters retain their current behavior.\n\nThe follow-up dcode integration is stacked separately because\n`deepagents-acp` and `deepagents-code` are independently released.\n\n<details>\n<summary>Test plan</summary>\n\n- `PYTHONPATH=libs/acp:libs/deepagents libs/code/.venv/bin/python -m\npytest -q libs/acp/tests`\n- ACP Ruff format and lint checks\n- SQLite close/reopen exercise, including messages removed from current\nstate by compaction\n\n</details>\n\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/019fd88f-b03e-7476-86ba-2ef3c4634a72)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"5e0bc451599fa81a8447a3a59e52c14b834b22b8","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/5e0bc451599fa81a8447a3a59e52c14b834b22b8"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/aaefb1eea1652abf370b5ac699be8307aee979e5","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqe5nhCRC1aQ7uu5UhlAAAuFIQACnGxm7RH9uzXePb6WGB/b0b\nVSqctinaQcjxwecMLfk2KRs3Zahl3LtDZSaCNftHJwIvo8+lDl6wUwGnynzxnDeL\ndNzuPA5AhycbZiFhrVKfUa/3RThsYtNSUAF6TMNIIMp1FTULKuedZaWDXwWWFE7N\nA49kXw56J1+6yMQwRPEGRLtOLjAF4Mg2+ZbWQFEK8eHQ949FtUVklfYXSIrqKrzf\nkDUWQwOD1yF1gvTK1WgxbUoVRyNDH4MBqWXEiwUpPpDJy3axQRFK/D6X3UxOMbj+\n8IEkgUX0o2pnM97M20dCaAYKbrLBK75tr0ZTiOn4LlDHI4iw+QKnnz7TCrHRoI+c\nUwYFvZr0hIoCDJzQg+vXp8+z/ICcOPE3EaCTmPCwjOYzMBbfWZFi6nzCEoaFJ8g8\n4b7Kbe9sIC3FhNuWXz1I4pccNB+D45V8qYRHE8VsI1eal1pVaucf11JxpxmqQ/0T\n+Vjf6C6F/Tqvvp7MQCQXUcmttHajmL06w00JjoerEONn5zEFFktBqFK2TCGsGtBN\n+RTP1nJfP0tvXYC4cRHGChQeUKfLSntA0a2p6qQLezCdnt7vrcmsE44JwTXoNZYi\n2zaOMyBUh04MdmkccCZPkFtJG9wYX3ZyiCYbb9alvf9vQ2hFmDURFGIu84h9jU9t\nUTGCXAAhBbyzt+f8Fw+J\n=d3ig\n-----END PGP SIGNATURE-----\n","payload":"tree 5e0bc451599fa81a8447a3a59e52c14b834b22b8\nparent 10353bda7196f307db9b22ef1173764aeda6daa7\nauthor Johannes du Plessis <johannes@langchain.dev> 1786485217 -0700\ncommitter GitHub <noreply@github.com> 1786485217 -0700\n\nfeat(acp): support persistent session loading (#5365)\n\nACP agents can now opt into durable `session/load`, restoring session\nconfiguration and replaying complete conversation history after process\nrestarts.\n\n---\n\n`AgentServerACP` previously exposed only in-process threads. This adds\nan explicit `load_sessions` capability backed by the graph checkpointer,\npersists ACP ownership, cwd, mode, and model metadata, and returns\nprotocol errors for unknown sessions or mismatched working directories.\n\nReplay is reconstructed across checkpoint history so messages removed\nfrom the latest state by compaction are still included, as required by\nACP v1. Tool calls and multimodal message content are converted back\ninto their ACP session-update forms. The feature remains opt-in so\nexisting adapters retain their current behavior.\n\nThe follow-up dcode integration is stacked separately because\n`deepagents-acp` and `deepagents-code` are independently released.\n\n<details>\n<summary>Test plan</summary>\n\n- `PYTHONPATH=libs/acp:libs/deepagents libs/code/.venv/bin/python -m\npytest -q libs/acp/tests`\n- ACP Ruff format and lint checks\n- SQLite close/reopen exercise, including messages removed from current\nstate by compaction\n\n</details>\n\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/019fd88f-b03e-7476-86ba-2ef3c4634a72)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-08-11T21:53:42Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/aaefb1eea1652abf370b5ac699be8307aee979e5","html_url":"https://github.com/langchain-ai/deepagents/commit/aaefb1eea1652abf370b5ac699be8307aee979e5","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/aaefb1eea1652abf370b5ac699be8307aee979e5/comments","author":{"login":"johannes117","id":51395795,"node_id":"MDQ6VXNlcjUxMzk1Nzk1","avatar_url":"https://avatars.githubusercontent.com/u/51395795?v=4","gravatar_id":"","url":"https://api.github.com/users/johannes117","html_url":"https://github.com/johannes117","followers_url":"https://api.github.com/users/johannes117/followers","following_url":"https://api.github.com/users/johannes117/following{/other_user}","gists_url":"https://api.github.com/users/johannes117/gists{/gist_id}","starred_url":"https://api.github.com/users/johannes117/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/johannes117/subscriptions","organizations_url":"https://api.github.com/users/johannes117/orgs","repos_url":"https://api.github.com/users/johannes117/repos","events_url":"https://api.github.com/users/johannes117/events{/privacy}","received_events_url":"https://api.github.com/users/johannes117/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"10353bda7196f307db9b22ef1173764aeda6daa7","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/10353bda7196f307db9b22ef1173764aeda6daa7","html_url":"https://github.com/langchain-ai/deepagents/commit/10353bda7196f307db9b22ef1173764aeda6daa7"}]},{"sha":"10353bda7196f307db9b22ef1173764aeda6daa7","node_id":"C_kwDOPTymldoAKDEwMzUzYmRhNzE5NmYzMDdkYjliMjJlZjExNzM3NjRhZWRhNmRhYTc","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-08-11T21:49:16Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-11T21:49:16Z"},"message":"fix(code): warn on stale dependencies in editable installs (#5386)\n\n`dcode` now checks at launch whether an editable installation has\nruntime dependencies older than the minimum versions in the checkout's\n`pyproject.toml`. If so, it shows a warning naming each stale package\nand the command to fix it. Non-interactive launches print it to stderr:\n\n```\nWarning: this editable dcode install is running against dependencies older than the floors declared\nin the checkout's pyproject.toml:\n  - langchain-quickjs 0.3.0 is installed, but langchain-quickjs<0.4.0,>=0.3.4 is required\nRefresh the active environment:\n  uv pip install --python ~/.local/share/dcode-dev/bin/python -e <repo>/libs/code --upgrade\nContinuing anyway; behavior may be broken.\n```\n\nInteractive (TUI) launches instead show a one-sentence startup toast and\nprint the full warning to stderr on exit.\n\n---\n\nEditable installs resolve dependencies once at install time and never\nre-check them. When minimums move up on `main`, an old venv can silently\nrun new code against old dependencies.\n\nHow it works:\n\n- **Editable-only.** Uses PEP 610 `direct_url.json`; released installs\nreturn immediately, so there is no startup cost for end users.\n- **Floors come from the live checkout, not install metadata.**\n`Requires-Dist` is frozen at install time, so the check parses\n`project.dependencies` from the `pyproject.toml` adjacent to the running\npackage. `>=`/`~=` specifiers and exact pins (e.g. the\n`deepagents==X.Y.Z` pin) count as floors; requirements with inapplicable\nmarkers or uninstalled distributions are skipped.\n- **Two channels, one warning.** The channel is chosen from launch mode,\nnot TTY: non-interactive launches and subcommands print the full warning\nto stderr (never stdout, since ACP uses it for JSON-RPC); interactive\nlaunches toast a summary at startup and print the full warning at\nteardown, where it survives the alternate screen.\n- **Warning only, no block.** Startup continues normally; any failure in\nthe check degrades to a debug log.","tree":{"sha":"fb8e4178dfa01bd8bccd95acad7f78bfdd4a6e07","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/fb8e4178dfa01bd8bccd95acad7f78bfdd4a6e07"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/10353bda7196f307db9b22ef1173764aeda6daa7","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqe5jcCRC1aQ7uu5UhlAAAGKcQAFXc6KYHKLSWrft2Hjqapwmi\nd9oSLzyda7tWlLFw/ciG/G0o0K4kPCaikmj/Q6/F9DcInGUQgxYDSOPg6k+UUzDL\nE/YC8YZRyQMzYIixrgnTkIFkDvfERAcghRkvvb7D4aRTcucKFEQlZD3cN50Z96Q/\ncpNsnPDhBA5XE457hNDxrgdemwLszr6D6W168dHXn80dmmlZ9708E5BrRZu+55oB\nNytzjfGxHUO5FiiYhjj6DP0phVqq74DZuVXvI3ZTRZZi7WMsYmU+RK0u96c0/Ky1\nLaUGpONtPxoaY3DP/8IA76jmEtepcBq+m0HBbBDi8WQ7dMWJHWsKXqAqhgYJxjmZ\n274RP2BoPadlLdxB/ZvVntwqHVVL23JSpW6hcfnSjebFM5bkRVKy6xkTkh0J4b0a\njNRSNWelZ2Bh1Y7MHjf0Y+JHafMgb9ICdMQUyUxRyk5qT+SqbNIe/8tPP5YRikgq\n+N9gT5DTigI3okdKZSgibDvuzPzHAJg4Fy5fYQZbft9aGRNcsEUzmuWklv+6r9hP\nApaavyjqoqmVHpBM2zq+0sV2g2bIJuwTl2Z3f0l+cZAvRyyvjEB/iwUv/BqcG6dr\nRIPFPFECFYFissTOGh7UiOedK75VZ17/2q1akfOOOiqzaHvddN78CzukpzLpneBi\n5TsQXxeUaZsgN7O7SCAd\n=9Ayi\n-----END PGP SIGNATURE-----\n","payload":"tree fb8e4178dfa01bd8bccd95acad7f78bfdd4a6e07\nparent cf8ea93a634b2ae03fa9033db6e0e240ed2ae1a1\nauthor Mason Daugherty <mason@langchain.dev> 1786484956 -0700\ncommitter GitHub <noreply@github.com> 1786484956 -0700\n\nfix(code): warn on stale dependencies in editable installs (#5386)\n\n`dcode` now checks at launch whether an editable installation has\nruntime dependencies older than the minimum versions in the checkout's\n`pyproject.toml`. If so, it shows a warning naming each stale package\nand the command to fix it. Non-interactive launches print it to stderr:\n\n```\nWarning: this editable dcode install is running against dependencies older than the floors declared\nin the checkout's pyproject.toml:\n  - langchain-quickjs 0.3.0 is installed, but langchain-quickjs<0.4.0,>=0.3.4 is required\nRefresh the active environment:\n  uv pip install --python ~/.local/share/dcode-dev/bin/python -e <repo>/libs/code --upgrade\nContinuing anyway; behavior may be broken.\n```\n\nInteractive (TUI) launches instead show a one-sentence startup toast and\nprint the full warning to stderr on exit.\n\n---\n\nEditable installs resolve dependencies once at install time and never\nre-check them. When minimums move up on `main`, an old venv can silently\nrun new code against old dependencies.\n\nHow it works:\n\n- **Editable-only.** Uses PEP 610 `direct_url.json`; released installs\nreturn immediately, so there is no startup cost for end users.\n- **Floors come from the live checkout, not install metadata.**\n`Requires-Dist` is frozen at install time, so the check parses\n`project.dependencies` from the `pyproject.toml` adjacent to the running\npackage. `>=`/`~=` specifiers and exact pins (e.g. the\n`deepagents==X.Y.Z` pin) count as floors; requirements with inapplicable\nmarkers or uninstalled distributions are skipped.\n- **Two channels, one warning.** The channel is chosen from launch mode,\nnot TTY: non-interactive launches and subcommands print the full warning\nto stderr (never stdout, since ACP uses it for JSON-RPC); interactive\nlaunches toast a summary at startup and print the full warning at\nteardown, where it survives the alternate screen.\n- **Warning only, no block.** Startup continues normally; any failure in\nthe check degrades to a debug log.","verified_at":"2026-08-11T21:49:21Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/10353bda7196f307db9b22ef1173764aeda6daa7","html_url":"https://github.com/langchain-ai/deepagents/commit/10353bda7196f307db9b22ef1173764aeda6daa7","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/10353bda7196f307db9b22ef1173764aeda6daa7/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"cf8ea93a634b2ae03fa9033db6e0e240ed2ae1a1","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/cf8ea93a634b2ae03fa9033db6e0e240ed2ae1a1","html_url":"https://github.com/langchain-ai/deepagents/commit/cf8ea93a634b2ae03fa9033db6e0e240ed2ae1a1"}]},{"sha":"cf8ea93a634b2ae03fa9033db6e0e240ed2ae1a1","node_id":"C_kwDOPTymldoAKGNmOGVhOTNhNjM0YjJhZTAzZmE5MDMzZGI2ZTBlMjQwZWQyYWUxYTE","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-08-11T21:47:43Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-11T21:47:43Z"},"message":"fix(code): count distinct targets in grouped tool summaries (#5409)\n\nThe summary line for a step counts the tool calls, but it shows the\ncount with a noun. If the agent reads one file two times, the line shows\n`Read 2 files`. Only one file is correct.\n\n| Tool calls | Before | After |\n| --- | --- | --- |\n| read `a.py` two times | `Read 2 files` | `Read 1 file` |\n| read `a.py`, read `b.py` | `Read 2 files` | `Read 2 files` |\n| edit `a.py` three times | `Edited 3 files` | `Edited 1 file (3 edits)`\n|\n| edit `a.py` two times, edit `b.py` | `Edited 3 files` | `Edited 2\nfiles (3 edits)` |\n| fetch one URL two times | `Fetched 2 URLs` | `Fetched 1 URL (2 calls)`\n|\n\nThe line now counts the different targets. A target is the file or the\nURL of a call, from the `file_path`, `path` or `url` argument. The\npresent-tense line uses the same counts, for example `Reading 1 file`.\n\nEvery mutating category (`edit`, `write`, `delete`) and `fetch` also\nshow the number of operations in parentheses. Each mutation writes to\nthe file and has a diff, so the number of files alone is not sufficient:\na group spans a whole step, so `delete a.py`, `write_file a.py`, `delete\na.py` is two real deletions of one path. A repeated fetch of one URL is\na deliberate new request, so `Fetched 1 URL` alone would hide the second\ncall. A repeated read keeps one number, because the agent usually reads\na large file in parts.\n\n## Limits\n\n- `shell`, `js`, `task` and `search` count attempts, not objects. Two\nruns of one command are two operations.\n- `web_search` shows repeated calls with a different phrase, for example\n`Searched the web 2 times`.\n- `ls` counts every listing. A listing is a snapshot, not a durable\nobject, so an intervening write can make the second listing of one\ndirectory show different contents.\n- A call whose target argument is missing or is not a string counts for\nitself. Failing to identify a target only restores the old count, while\na wrong match would hide work.\n\nPaths are compared in the canonical form the filesystem middleware\nitself produces. `_normalize_path_target` mirrors `validate_path`, so\ntwo spellings that the middleware resolves to one file count as one\nfile. The normalization is purely lexical and never touches the\nfilesystem.\n\n- A relative and an absolute spelling match, because the middleware\nanchors a relative path at the virtual root: `a.py` and `/a.py` are one\nfile.\n- A backslash is a separator, because the middleware accepts one: `a\\b`\nand `a/b` are one file.\n- Redundant segments collapse: `d//a.py`, `d/./a.py` and `d/a.py/` are\nall `d/a.py`.\n- A `..` segment turns the normalization off. The middleware rejects\nthose paths, so there is no canonical form to agree with, and folding\none would count a call that could not have run.\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"e2c767c313200dcc42269d9512e37199aa68f1ad","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/e2c767c313200dcc42269d9512e37199aa68f1ad"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/cf8ea93a634b2ae03fa9033db6e0e240ed2ae1a1","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqe5h/CRC1aQ7uu5UhlAAAGwUQAJk0bXfhtWNmKf/PhvmP3u3J\no5a4kEt5C+mJeQJMqklout23lHO2atXmUUHKdfpMK65CrBG3xpVheFP1NWL+Mwqw\ngSCILl4HmH6oajikO6GpbRiGbOd/o4LhoEcK/qHuLriK4HdSiLROvBMjdo4AMEj6\nXZoouAUTRhwXapB6y647NmXjUZbL0rUL+f9oYWQ9s4CfBYqbV7/prJus1lHxNkjU\nPd89VmpK8f9CMS/Qd0/dNN+CV1z68biWYEf5OV3Ur2PN60s8FEe5JnhHyruVxAZO\n5HWbY1JShn5XjgyjKHBA5Y38NFNHOqvk66THo6J/WH3CQBHA7MjlIMeJfgojrG1Y\n3AetIC+vHbDs556w4QUUixg5y48ql4IjWHR021nrZj03YHKkPPs/curE+rX8zhM3\n/w2+2s6YEAF4XJLtLjVQ9AgV5PTKAs03jS2QbOQKsc2tAJ+L3Fs2iv9UdxSLks/t\nNXwl+giCmUBrDltnnNKdKrmS5FHqhXHrL1X+nGF+9tqbQW7ULX2pIuwenHn9SfoE\nWVfKFgbIIumQeIu0gJnVokxRZXLW518dXnRJ605TYO3NFCYw0NB1EAcAlvEICtsl\n/ok+o+6ntPlYZhgDk4n2j5Ykdcqh/zJS/nFUS6yInfRa5WD2+nWc+muc25Tzyg2h\n48bcE2HrSqBAXjkFYXtb\n=DjhS\n-----END PGP SIGNATURE-----\n","payload":"tree e2c767c313200dcc42269d9512e37199aa68f1ad\nparent d3aa88857612aa34157c3056d6170b8b7c93128b\nauthor Mason Daugherty <mason@langchain.dev> 1786484863 -0700\ncommitter GitHub <noreply@github.com> 1786484863 -0700\n\nfix(code): count distinct targets in grouped tool summaries (#5409)\n\nThe summary line for a step counts the tool calls, but it shows the\ncount with a noun. If the agent reads one file two times, the line shows\n`Read 2 files`. Only one file is correct.\n\n| Tool calls | Before | After |\n| --- | --- | --- |\n| read `a.py` two times | `Read 2 files` | `Read 1 file` |\n| read `a.py`, read `b.py` | `Read 2 files` | `Read 2 files` |\n| edit `a.py` three times | `Edited 3 files` | `Edited 1 file (3 edits)`\n|\n| edit `a.py` two times, edit `b.py` | `Edited 3 files` | `Edited 2\nfiles (3 edits)` |\n| fetch one URL two times | `Fetched 2 URLs` | `Fetched 1 URL (2 calls)`\n|\n\nThe line now counts the different targets. A target is the file or the\nURL of a call, from the `file_path`, `path` or `url` argument. The\npresent-tense line uses the same counts, for example `Reading 1 file`.\n\nEvery mutating category (`edit`, `write`, `delete`) and `fetch` also\nshow the number of operations in parentheses. Each mutation writes to\nthe file and has a diff, so the number of files alone is not sufficient:\na group spans a whole step, so `delete a.py`, `write_file a.py`, `delete\na.py` is two real deletions of one path. A repeated fetch of one URL is\na deliberate new request, so `Fetched 1 URL` alone would hide the second\ncall. A repeated read keeps one number, because the agent usually reads\na large file in parts.\n\n## Limits\n\n- `shell`, `js`, `task` and `search` count attempts, not objects. Two\nruns of one command are two operations.\n- `web_search` shows repeated calls with a different phrase, for example\n`Searched the web 2 times`.\n- `ls` counts every listing. A listing is a snapshot, not a durable\nobject, so an intervening write can make the second listing of one\ndirectory show different contents.\n- A call whose target argument is missing or is not a string counts for\nitself. Failing to identify a target only restores the old count, while\na wrong match would hide work.\n\nPaths are compared in the canonical form the filesystem middleware\nitself produces. `_normalize_path_target` mirrors `validate_path`, so\ntwo spellings that the middleware resolves to one file count as one\nfile. The normalization is purely lexical and never touches the\nfilesystem.\n\n- A relative and an absolute spelling match, because the middleware\nanchors a relative path at the virtual root: `a.py` and `/a.py` are one\nfile.\n- A backslash is a separator, because the middleware accepts one: `a\\b`\nand `a/b` are one file.\n- Redundant segments collapse: `d//a.py`, `d/./a.py` and `d/a.py/` are\nall `d/a.py`.\n- A `..` segment turns the normalization off. The middleware rejects\nthose paths, so there is no canonical form to agree with, and folding\none would count a call that could not have run.\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-08-11T21:47:46Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/cf8ea93a634b2ae03fa9033db6e0e240ed2ae1a1","html_url":"https://github.com/langchain-ai/deepagents/commit/cf8ea93a634b2ae03fa9033db6e0e240ed2ae1a1","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/cf8ea93a634b2ae03fa9033db6e0e240ed2ae1a1/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"d3aa88857612aa34157c3056d6170b8b7c93128b","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/d3aa88857612aa34157c3056d6170b8b7c93128b","html_url":"https://github.com/langchain-ai/deepagents/commit/d3aa88857612aa34157c3056d6170b8b7c93128b"}]},{"sha":"d3aa88857612aa34157c3056d6170b8b7c93128b","node_id":"C_kwDOPTymldoAKGQzYWE4ODg1NzYxMmFhMzQxNTdjMzA1NmQ2MTcwYjhiN2M5MzEyOGI","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-08-11T21:11:20Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-11T21:11:20Z"},"message":"fix(infra): allow transferred issues (#5429)\n\nRelated\nhttps://github.com/langchain-ai/deepagents/issues/5428#issuecomment-5258093627\n\nTransferred issues no longer get auto-closed as \"submitted\nprogrammatically\" by the unchecked-issues workflow.\n\n---\n\nWhen an issue is transferred from another repo, GitHub fires an `opened`\nevent in the destination repo, but the issue keeps its original\n`created_at` timestamp and has no issue type in the new repo. Rule 0 in\n`close_unchecked_issues.yml` treats a missing issue type as proof of\nprogrammatic submission, so transferred issues were being closed with\nthe \"submitted programmatically\" comment (see the linked issue above).\n\nThe fix adds an age-based heuristic before Rule 0: if the issue was\ncreated more than 5 minutes ago, it's treated as a transfer and Rule 0\nis skipped. Rules 1–4 (checkbox/template validation) still apply, so a\ntransferred issue that genuinely ignored the template can still be\nclosed — just not for the wrong reason.\n\nFresh issues (age < 5 min) are unaffected: a bot or script that just\nopened an issue via the API still trips Rule 0 as before.","tree":{"sha":"0e0ab933cfd87f6bb2c59cb2435530909b5a394f","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/0e0ab933cfd87f6bb2c59cb2435530909b5a394f"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/d3aa88857612aa34157c3056d6170b8b7c93128b","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqe4/4CRC1aQ7uu5UhlAAAc1wQAFjOoIjmoLM+5IlCq+lymhAS\nwsm1lGhHdZdCccF9c+fMgVVLObGyN03bES+EDFLd4u5ljo71O8De30gHiJ4zHF98\nHgopuFRHelJqFxpa2YXdG2LdseqqAul09ahKtO65QrQBO8iBsOE1M6aRvWpBF9Wy\n3NTCEiPox5oCOAxmmzsD/r9srxR97hN0uviDakC+hqmDLPXVX+l0CbIl6MmhdMkX\n3yo/PUm1SlBUe7Y1JepidGDnqB8LKQngGPcCJ9V9TmQHWSxR5CpzAtd2Fe/erxKs\nRYMtujttVRwc0P6VCo2Nd/dW7OgbdyWMn7vFT0U+so/v2xIBDY6F7oU7O0IAMxnV\n/IYuXM7+/ia5C061RFR2NxcPfHLXAI1mDeXYCEtpoMoycUTskYm2mTlaSzj+S6Jp\n8uqRs/+XU26+VxC9+RLGheHgOCqZqr8Ynx1WK2EjCNS0ylDwi4hNIDP+yE1svWa+\n9m/bzxEa42nTJjQsy5URwMJbC0I1A9UqfKELFm6IQfnUSMoZ0dS4PmMdfVVuGQZ7\norijixZtUKDLguk0fmnhKRE6UszB3H9Pc2wKaT1+NLqQ/oaCjxV7VJpHFVJ4Nk1R\nb1YXQ1/VF4OMAF8iFvEKiYd1q9C+FYzqO1ZC0SE1ndh3N99/Tl6qLRP25Us2Egyi\nGGbWkZGC5JMhUZA0xC57\n=yLHS\n-----END PGP SIGNATURE-----\n","payload":"tree 0e0ab933cfd87f6bb2c59cb2435530909b5a394f\nparent a27208d70f94b82eaa0772198d3af270ffff1208\nauthor Mason Daugherty <mason@langchain.dev> 1786482680 -0700\ncommitter GitHub <noreply@github.com> 1786482680 -0700\n\nfix(infra): allow transferred issues (#5429)\n\nRelated\nhttps://github.com/langchain-ai/deepagents/issues/5428#issuecomment-5258093627\n\nTransferred issues no longer get auto-closed as \"submitted\nprogrammatically\" by the unchecked-issues workflow.\n\n---\n\nWhen an issue is transferred from another repo, GitHub fires an `opened`\nevent in the destination repo, but the issue keeps its original\n`created_at` timestamp and has no issue type in the new repo. Rule 0 in\n`close_unchecked_issues.yml` treats a missing issue type as proof of\nprogrammatic submission, so transferred issues were being closed with\nthe \"submitted programmatically\" comment (see the linked issue above).\n\nThe fix adds an age-based heuristic before Rule 0: if the issue was\ncreated more than 5 minutes ago, it's treated as a transfer and Rule 0\nis skipped. Rules 1–4 (checkbox/template validation) still apply, so a\ntransferred issue that genuinely ignored the template can still be\nclosed — just not for the wrong reason.\n\nFresh issues (age < 5 min) are unaffected: a bot or script that just\nopened an issue via the API still trips Rule 0 as before.","verified_at":"2026-08-11T21:11:23Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/d3aa88857612aa34157c3056d6170b8b7c93128b","html_url":"https://github.com/langchain-ai/deepagents/commit/d3aa88857612aa34157c3056d6170b8b7c93128b","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/d3aa88857612aa34157c3056d6170b8b7c93128b/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a27208d70f94b82eaa0772198d3af270ffff1208","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a27208d70f94b82eaa0772198d3af270ffff1208","html_url":"https://github.com/langchain-ai/deepagents/commit/a27208d70f94b82eaa0772198d3af270ffff1208"}]},{"sha":"a27208d70f94b82eaa0772198d3af270ffff1208","node_id":"C_kwDOPTymldoAKGEyNzIwOGQ3MG