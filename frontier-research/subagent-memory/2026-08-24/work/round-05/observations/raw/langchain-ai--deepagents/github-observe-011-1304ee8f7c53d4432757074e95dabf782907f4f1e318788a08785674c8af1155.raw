pi.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"60918f3d219c04562a1f91ec9810b8163f7c9f6c","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/60918f3d219c04562a1f91ec9810b8163f7c9f6c","html_url":"https://github.com/langchain-ai/deepagents/commit/60918f3d219c04562a1f91ec9810b8163f7c9f6c"}]},{"sha":"60918f3d219c04562a1f91ec9810b8163f7c9f6c","node_id":"C_kwDOPTymldoAKDYwOTE4ZjNkMjE5YzA0NTYyYTFmOTFlYzk4MTBiODE2M2Y3YzlmNmM","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-13T06:26:44Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-13T06:26:44Z"},"message":"feat(infra): add package Git log to release notes (#4673)\n\nGitHub release descriptions now include a collapsible, package-scoped\ncommit history.\n\n---\n\nGitHub releases currently use package changelog entries when available.\nThat leaves out commit-level package history.\n\nThis change appends a collapsible, package-scoped Git log to every\nrelease body. The log uses the latest stable package tag that is\nreachable from the release commit, so releases from version branches do\nnot accidentally compare against a newer tag from another line. Initial\nand divergent histories are identified separately, and commit subjects,\nlog length, and the final release body are bounded to stay within\nGitHub's limits.","tree":{"sha":"2a4bf4abcbfe0f2d6de484f6ac55f1c51d0186ae","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/2a4bf4abcbfe0f2d6de484f6ac55f1c51d0186ae"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/60918f3d219c04562a1f91ec9810b8163f7c9f6c","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqVIUkCRC1aQ7uu5UhlAAA2Z8QACiLEjLPGRb/Hqj3efR0ptpt\nSda2n0esQVXVTUqXXXZeSqkOJY20+lNHmCEBrpgGK7FUn3mOD2rx1QuQC/MhlPEU\nT2HFBMVuFZbzDi6VAYQZhaToGBn9ZPfSJgkRV1rqZ+hIfZ3wa5Gjcdij2uLO0S59\nBPLgzYT/I+649t9gdqw0XnhKOEtLzqMLVfNV9lW1yzdRughkPM0v1knvjS1qcb8V\n36VkzhwKUQxEbEQWNY+ng5A8IevAiyjThEsNuZDiyy6fM1a3gXxwdb2j2QDc11bg\nRypmFxKNlui6ZPemGNBU43by9lxsEYKxP4ANQwsi1OjlcgH3ZATeqQFsOp9g1R8F\num4d5yWyuqbGbg+uYGgvhxi1hEWfaxdnLfVbeOPlKMyjmDeg0ZcQoFIB9K8G4G/F\n7XZGf2BtDSgtTTZaKHCVQe3gGacTWHLeb8JK9uH2Z1p4zExqF8yifA9NaW9EkoDe\nnL0aJf+P0Pbp6+9RThdavi/XsAPmPOL3KfBI31guHiezZ2L1eGPm0HL/lqAuerQg\nY/LQ6Jut5PtSsF9EP3+zHqE1+bPQbQ9Ej02SUXpG915250nUp1js+UTRoTrEw+cU\nfPm6ubyubpP7zbdJA/1HotpECE8Qs15ytBoNeoUvhJ+GFZuWNAz2gtU62NvZ22Oj\nS+2rZc0PX0JVjaKzNs9K\n=sq2Q\n-----END PGP SIGNATURE-----\n","payload":"tree 2a4bf4abcbfe0f2d6de484f6ac55f1c51d0186ae\nparent 306bd893f214237b6b4eede7c2ce0eaff66f5527\nauthor Mason Daugherty <mason@langchain.dev> 1783924004 -0400\ncommitter GitHub <noreply@github.com> 1783924004 -0400\n\nfeat(infra): add package Git log to release notes (#4673)\n\nGitHub release descriptions now include a collapsible, package-scoped\ncommit history.\n\n---\n\nGitHub releases currently use package changelog entries when available.\nThat leaves out commit-level package history.\n\nThis change appends a collapsible, package-scoped Git log to every\nrelease body. The log uses the latest stable package tag that is\nreachable from the release commit, so releases from version branches do\nnot accidentally compare against a newer tag from another line. Initial\nand divergent histories are identified separately, and commit subjects,\nlog length, and the final release body are bounded to stay within\nGitHub's limits.","verified_at":"2026-07-13T06:26:45Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/60918f3d219c04562a1f91ec9810b8163f7c9f6c","html_url":"https://github.com/langchain-ai/deepagents/commit/60918f3d219c04562a1f91ec9810b8163f7c9f6c","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/60918f3d219c04562a1f91ec9810b8163f7c9f6c/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"306bd893f214237b6b4eede7c2ce0eaff66f5527","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/306bd893f214237b6b4eede7c2ce0eaff66f5527","html_url":"https://github.com/langchain-ai/deepagents/commit/306bd893f214237b6b4eede7c2ce0eaff66f5527"}]},{"sha":"306bd893f214237b6b4eede7c2ce0eaff66f5527","node_id":"C_kwDOPTymldoAKDMwNmJkODkzZjIxNDIzN2I2YjRlZWRlN2MyY2UwZWFmZjY2ZjU1Mjc","commit":{"author":{"name":"Will Bradley","email":"will.bradley@langchain.dev","date":"2026-07-13T06:19:12Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-13T06:19:12Z"},"message":"fix(code): preserve `Ctrl+D` deletion in non-empty input (#4626)\n\nCtrl+D now deletes the character to the right in a non-empty prompt and\nonly exits from an empty prompt.\n\n---\n\nA priority app binding intercepted Ctrl+D before the focused chat text\narea could apply its standard delete-right behavior. Delegate Ctrl+D to\nthe focused text area while a draft exists, and retain quit behavior for\nan empty prompt and existing modal flows.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/9c524bf4-b1c3-5e11-d131-8d5d44be990b)\n\n---------\n\nCo-authored-by: Will Bradley <3030224+wbbradley@users.noreply.github.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","tree":{"sha":"4491214b3e889bac35706dedaa7700ec0683ba3c","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/4491214b3e889bac35706dedaa7700ec0683ba3c"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/306bd893f214237b6b4eede7c2ce0eaff66f5527","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqVINgCRC1aQ7uu5UhlAAAK20QAEtf/HAJQbt/1OsFoc5MENUX\nA0KVmlJjxK0V1y1wvnvnakmsTY31LYOXATCmAczIiOV7bdmx46ooRB2wr19z9/iT\ncIE6kwHrmzPIf8uINNTxZ9Q30ohjN0irVkOzW4Mi7LvzGURbOHecY2zgMXcTuzwX\njRhf64GSY6/PGTmJiFzaGAc+rYFq2crCptikbt0boQEq58+oxQKd4WhihVdavFop\ntrla3Oi9LJX5aSNSj6B8Zq67XKvdtB9yf4y4dxz0Bc25AZ1Nw8HgNnfGAaM/rO+F\nOsgeqJjeTQG/3m1UanDEAtPz9L/+6NXKf/F6uVPGZimqlCaz3z0sllPD17rePwOy\nIVhwJ0C6sR6faPi6uOTKEP/1lC0fsj0jOr74uDqt1i5ZDpFd9u5WJgbFV3fQ6QAn\nGiBL2Ry8KvrWvBo3dXhIu8OnTkl+aJd9yUJgFNl8dPsTzHVoneFd60+XyttcRkTR\n054f+HSarcKlyEi/x+NRShWbRAM/cEGiTyPCIRqMyeCZUAjPTJ8sXFJzVMr/Fnb7\n80XuHL9movPM8a30kffT7bg0pm5QuLDMmwWbuK6+pl/aTlQaKy2ozYb+tl33LzkY\nuXJZXMH89lXkGBeGVo6HTQU0OR6iES2yri5j8TRFmdGZf+EhXo1GKhRCTbmZei/G\ntSqNkNzAnZBm2mRx7pWL\n=rRkA\n-----END PGP SIGNATURE-----\n","payload":"tree 4491214b3e889bac35706dedaa7700ec0683ba3c\nparent e6f10a149051128677c9f6f37663922054a7ac26\nauthor Will Bradley <will.bradley@langchain.dev> 1783923552 -0600\ncommitter GitHub <noreply@github.com> 1783923552 -0400\n\nfix(code): preserve `Ctrl+D` deletion in non-empty input (#4626)\n\nCtrl+D now deletes the character to the right in a non-empty prompt and\nonly exits from an empty prompt.\n\n---\n\nA priority app binding intercepted Ctrl+D before the focused chat text\narea could apply its standard delete-right behavior. Delegate Ctrl+D to\nthe focused text area while a draft exists, and retain quit behavior for\nan empty prompt and existing modal flows.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/9c524bf4-b1c3-5e11-d131-8d5d44be990b)\n\n---------\n\nCo-authored-by: Will Bradley <3030224+wbbradley@users.noreply.github.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","verified_at":"2026-07-13T06:19:13Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/306bd893f214237b6b4eede7c2ce0eaff66f5527","html_url":"https://github.com/langchain-ai/deepagents/commit/306bd893f214237b6b4eede7c2ce0eaff66f5527","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/306bd893f214237b6b4eede7c2ce0eaff66f5527/comments","author":{"login":"wbbradley","id":3030224,"node_id":"MDQ6VXNlcjMwMzAyMjQ=","avatar_url":"https://avatars.githubusercontent.com/u/3030224?v=4","gravatar_id":"","url":"https://api.github.com/users/wbbradley","html_url":"https://github.com/wbbradley","followers_url":"https://api.github.com/users/wbbradley/followers","following_url":"https://api.github.com/users/wbbradley/following{/other_user}","gists_url":"https://api.github.com/users/wbbradley/gists{/gist_id}","starred_url":"https://api.github.com/users/wbbradley/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wbbradley/subscriptions","organizations_url":"https://api.github.com/users/wbbradley/orgs","repos_url":"https://api.github.com/users/wbbradley/repos","events_url":"https://api.github.com/users/wbbradley/events{/privacy}","received_events_url":"https://api.github.com/users/wbbradley/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users