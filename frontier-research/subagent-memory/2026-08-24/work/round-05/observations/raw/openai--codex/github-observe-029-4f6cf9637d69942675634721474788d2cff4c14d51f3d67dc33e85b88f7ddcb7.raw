ntent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"ad2012d645b7146d31bb03f98e2bd9371635d11a","url":"https://api.github.com/repos/openai/codex/commits/ad2012d645b7146d31bb03f98e2bd9371635d11a","html_url":"https://github.com/openai/codex/commit/ad2012d645b7146d31bb03f98e2bd9371635d11a"}]},{"sha":"ad2012d645b7146d31bb03f98e2bd9371635d11a","node_id":"C_kwDOOYsS4doAKGFkMjAxMmQ2NDViNzE0NmQzMWJiMDNmOThlMmJkOTM3MTYzNWQxMWE","commit":{"author":{"name":"Eric Burke","email":"163169620+eburke-openai@users.noreply.github.com","date":"2026-06-04T03:34:51Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-04T03:34:51Z"},"message":"ci: sign macOS release artifacts with Azure Key Vault (#26252)\n\n## Why\n\nThe public Codex release workflow needs to sign and notarize macOS\nbinaries and DMGs without placing the Developer ID private key in\nGitHub. This moves the private-key operation behind the protected\n`codesigning` environment and uses GitHub OIDC with Azure Key Vault\nPKCS#11, while preserving the existing external `build_unsigned` /\n`promote_signed` fallback.\n\n## What changed\n\n- Add a reusable AKV PKCS11 setup action that authenticates to Azure\nwith OIDC, downloads pinned signing tools, verifies their SHA-256\ndigests, and loads the public signing certificate from Key Vault.\n- Replace the legacy macOS signing action with scripts that support\nAKV-backed `rcodesign`, notarize signed binaries and DMGs, and staple\nDMG notarization tickets.\n- Restructure `rust-release.yml` so macOS builds produce unsigned\nartifacts first, protected jobs perform signing and notarization, macOS\nrunners package and verify the results, and release publishing waits for\nverified artifacts.\n- Preserve the manual external-signing handoff flow and make manual-mode\nconditions explicit.\n- Move the Codex entitlements file alongside the signing scripts and\nupdate CODEOWNERS for the new signing surfaces.\n\n## Verification\n\n- [Live protected signing workflow\nrun](https://github.com/openai/codex/actions/runs/26903610631) completed\nsuccessfully for both macOS architectures, including binary\nsigning/notarization, DMG signing/notarization, and final artifact\nverification.\n- Downloaded both signed DMGs and independently verified their checksums\nand strict signatures.\n- Confirmed `xcrun stapler validate` succeeds and Gatekeeper accepts\nboth DMGs as `Notarized Developer ID`.\n- Mounted both DMGs and confirmed the contained `codex` and\n`codex-responses-api-proxy` binaries have valid Developer ID signatures\nfor the expected architectures.\n\n---------\n\nCo-authored-by: shijie-openai <shijie.rao@openai.com>","tree":{"sha":"a303bbb1f71b1b85e44ccc42d1d14af346a64fc3","url":"https://api.github.com/repos/openai/codex/git/trees/a303bbb1f71b1b85e44ccc42d1d14af346a64fc3"},"url":"https://api.github.com/repos/openai/codex/git/commits/ad2012d645b7146d31bb03f98e2bd9371635d11a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqIPJbCRC1aQ7uu5UhlAAABxcQAFG/NFQAUA60b34vXhUR7n3u\nX00/DT0K337HfPgHkpkfQ1f/YithE/k7cqs5UCbVTm4tfaYcwzQmHYohHqVMJjjV\nYy7MljIk0yUDnhWWwcJoy8Oq36scvrgTxF4SKlFXJKa4wl6sPkGHDpvL2SdMd5NX\nv7aZIq2/bjSzGtWRUqMk0RzJMKTiCzUrAuh1QhQ4w505RQAqtGwZZjbeyvcUAExq\nrSx/EaqYDwH42mnNNjLGTuKoGNdBbTU1OAMfKx9CeRmQxDLmr3vzAvJvdchfHSLa\nBCs3H/ei0PucEX2AjCdU050fNmIE1Vdexif6MyP2fh5TGOPiBB1QDfV/rT0IKNiE\n6qbFAQDijh8DWB6WZWOmUyY9D/3G3fROmv5lsnnaOnguFfGCXbENRemcZ/IMAxmN\nR4FtHbNvqauc9X4qdgD1WBhVmz62ToCLF4/qIq0EG7R63VbtPHjYtXrS8Ixqwnh6\ng80o7oaRa1HrIwCebJ72svJdZldNsxS/vBVQWRHR+sFZgMNt2PeWMnCdHqqq0yrw\nNlgBAaCUvfuyq/qGsiA2Lb+2EXuMHZKEdvm2Vd1vpXq4YDfBZea4EqUKslgTswc5\nLJIqgcMgN0iWrSpe0X0wBU2thyY8c2QeWwEMOF71TDtirufc4M058hYiQObx29/7\niGLXy0/Pi27OluDdLGUr\n=V+GN\n-----END PGP SIGNATURE-----\n","payload":"tree a303bbb1f71b1b85e44ccc42d1d14af346a64fc3\nparent c143a86de8c5da3ae5127565b9ffe7094d2e5c28\nauthor Eric Burke <163169620+eburke-openai@users.noreply.github.com> 1780544091 -0400\ncommitter GitHub <noreply@github.com> 1780544091 -0700\n\nci: sign macOS release artifacts with Azure Key Vault (#26252)\n\n## Why\n\nThe public Codex release workflow needs to sign and notarize macOS\nbinaries and DMGs without placing the Developer ID private key in\nGitHub. This moves the private-key operation behind the protected\n`codesigning` environment and uses GitHub OIDC with Azure Key Vault\nPKCS#11, while preserving the existing external `build_unsigned` /\n`promote_signed` fallback.\n\n## What changed\n\n- Add a reusable AKV PKCS11 setup action that authenticates to Azure\nwith OIDC, downloads pinned signing tools, verifies their SHA-256\ndigests, and loads the public signing certificate from Key Vault.\n- Replace the legacy macOS signing action with scripts that support\nAKV-backed `rcodesign`, notarize signed binaries and DMGs, and staple\nDMG notarization tickets.\n- Restructure `rust-release.yml` so macOS builds produce unsigned\nartifacts first, protected jobs perform signing and notarization, macOS\nrunners package and verify the results, and release publishing waits for\nverified artifacts.\n- Preserve the manual external-signing handoff flow and make manual-mode\nconditions explicit.\n- Move the Codex entitlements file alongside the signing scripts and\nupdate CODEOWNERS for the new signing surfaces.\n\n## Verification\n\n- [Live protected signing workflow\nrun](https://github.com/openai/codex/actions/runs/26903610631) completed\nsuccessfully for both macOS architectures, including binary\nsigning/notarization, DMG signing/notarization, and final artifact\nverification.\n- Downloaded both signed DMGs and independently verified their checksums\nand strict signatures.\n- Confirmed `xcrun stapler validate` succeeds and Gatekeeper accepts\nboth DMGs as `Notarized Developer ID`.\n- Mounted both DMGs and confirmed the contained `codex` and\n`codex-responses-api-proxy` binaries have valid Developer ID signatures\nfor the expected architectures.\n\n---------\n\nCo-authored-by: shijie-openai <shijie.rao@openai.com>","verified_at":"2026-06-04T03:34:52Z"}},"url":"https://api.github.com/repos/openai/codex/commits/ad2012d645b7146d31bb03f98e2bd9371635d11a","html_url":"https://github.com/openai/codex/commit/ad2012d645b7146d31bb03f98e2bd9371635d11a","comments_url":"https://api.github.com/repos/openai/codex/commits/ad2012d645b7146d31bb03f98e2bd9371635d11a/comments","author":{"login":"eburke-openai","id":163169620,"node_id":"U_kgDOCbnFVA","avatar_url":"https://avatars.githubusercontent.com/u/163169620?v=4","gravatar_id":"","url":"https://api.github.com/users/eburke-openai","html_url":"https://github.com/eburke-openai","followers_url":"https://api.github.com/users/eburke-openai/followers","following_url":"https://api.github.com/users/eburke-openai/following{/other_user}","gists_url":"https://api.github.com/users/eburke-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/eburke-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/eburke-openai/subscriptions","organizations_url":"https://api.github.com/users/eburke-openai/orgs","repos_url":"https://api.github.com/users/eburke-openai/repos","events_url":"https://api.github.com/users/eburke-openai/events{/privacy}","received_events_url":"https://api.github.com/users/eburke-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c143a86de8c5da3ae5127565b9ffe7094d2e5c28","url":"https://api.github.com/repos/openai/codex/commits/c143a86de8c5da3ae5127565b9ffe7094d2e5c28","html_url":"https://github.com/openai/codex/commit/c143a86de8c5da3ae5127565b9ffe7094d2e5c28"}]},{"sha":"c143a86de8c5da3ae5127565b9ffe7094d2e5c28","node_id":"C_kwDOOYsS4doAKGMxNDNhODZkZThjNWRhM2FlNTEyNzU2NWI5ZmZlNzA5NGQyZTVjMjg","commit":{"author":{"name":"rhan-oai","email":"rhan@openai.com","date":"2026-06-04T03:00:44Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-04T03:00:44Z"},"message":"[codex-analytics] report compaction request token counts (#25946)\n\n## Why\n\nCompaction analytics need token counts that better represent the request\nbeing compacted. The existing session snapshot can diverge from the\nactual remote compaction request after output rewriting, and remote v2\ncan use server-side Responses usage when available.\n\n## What changed\n\n- Add an optional `active_context_tokens_before` override to\n`CompactionAnalyticsAttempt::track(...)` for remote compaction when it\nhas a better before-token value than the begin-time session snapshot.\nThe local `/compact` path passes no override.\n- For remote v1 `responses_compact`, subtract the estimated token delta\nfrom pre-compaction output rewriting from the session snapshot, capped\nby locally-added tokens since the last successful API response.\n- For remote v2 `responses_compaction_v2`, use the same bounded\noutput-rewrite fallback as remote v1, then overwrite\n`active_context_tokens_before` with server `token_usage.input_tokens`\nfrom the `response.completed` event when present.\n- Keep the existing v2 compaction-output validation while carrying the\ncompleted response token usage through `collect_compaction_output`.\n\n## Verification\n\n- `just fmt`\n- `just test -p codex-core\ncollect_compaction_output_accepts_additional_output_items`\n- `git diff --check`","tree":{"sha":"25d575de9194c6af0059367f262ce9c63af278e6","url":"https://api.github.com/repos/openai/codex/git/trees/25d575de9194c6af0059367f262ce9c63af278e6"},"url":"https://api.github.com/repos/openai/codex/git/commits/c143a86de8c5da3ae5127565b9ffe7094d2e5c28","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqIOpcCRC1aQ7uu5UhlAAAgbgQAARMwdvbb/QdX1ipgbSP9urs\nlH3rFRU653o5YwGXHHK9sNSU+kUtVb4hEZlUEQ8Ug+4RA+Sz7ov/K/wmkeI1LjXO\ndj6mCTQmkrFx2VgFcUlWaWLmzTu+BtvBi9BqKFYmWwgdsjn79Q8l57bwl3WUHC0e\n1e/gyRPduE2SqcmY26RE7ZgIDkwGTOKHcOjSQ4xhKfb/bX8BFY0Mo+WBo6xsCjYv\nR9f9dF634UNXQHzZN2xamViFVvB2vUHMs4L7Iawfn5mbW2y9GRUMi1fXLMDB5co1\nhQmwYtRtW9UnFpE9uL4ROWu8ko3nVMn3xeLMlTm72lIvhavKDlcJYfKp5NfEA/2r\nnmv2Hl2ZxooNqX63Evcegp7f7p2fW13jnbmeLi78u9+e/lV4hz8EzX+fWgdqUxA9\n2nK4IT/ZMOMKdkrAxKEQOf2xL0HkcfqKF9SD58ZagX+P2FxGMAvPrWw92SLmPC2k\nqCin8DjXC3PHsbU6Nysa4qmS8GuC+mkI0sEOzvwbkSL2SUr6fM5ZvwOSRwTpdfuE\nV5+TtTNyisLk4ucGCQizxK/7XWHG0m/y7q27i0+zK/YqHXdwa7M9AzMmxFbtmVpR\n6/D02jZQEc0vV74nzT4F6wV6edOzEVz2U9MyQGp5xN+PrfBwp2U/plqwK+s8LrWv\nH53y/FUt3ICWznXOUz+k\n=eW42\n-----END PGP SIGNATURE-----\n","payload":"tree 25d575de9194c6af0059367f262ce9c63af278e6\nparent 6bcccb0ee6b875a41ed9e8fb7e299a6b98dd3faa\nauthor rhan-oai <rhan@openai.com> 1780542044 -0700\ncommitter GitHub <noreply@github.com> 1780542044 +0000\n\n[codex-analytics] report compaction request token counts (#25946)\n\n## Why\n\nCompaction analytics need token counts that better represent the request\nbeing compacted. The existing session snapshot can diverge from the\nactual remote compaction request after output rewriting, and remote v2\ncan use server-side Responses usage when available.\n\n## What changed\n\n- Add an optional `active_context_tokens_before` override to\n`CompactionAnalyticsAttempt::track(...)` for remote compaction when it\nhas a better before-token value than the begin-time session snapshot.\nThe local `/compact` path passes no override.\n- For remote v1 `responses_compact`, subtract the estimated token delta\nfrom pre-compaction output rewriting from the session snapshot, capped\nby locally-added tokens since the last successful API response.\n- For remote v2 `responses_compaction_v2`, use the same bounded\noutput-rewrite fallback as remote v1, then overwrite\n`active_context_tokens_before` with server `token_usage.input_tokens`\nfrom the `response.completed` event when present.\n- Keep the existing v2 compaction-output validation while carrying the\ncompleted response token usage through `collect_compaction_output`.\n\n## Verification\n\n- `just fmt`\n- `just test -p codex-core\ncollect_compaction_output_accepts_additional_output_items`\n- `git diff --check`","verified_at":"2026-06-04T03:00:45Z"}},"url":"https://api.github.com/repos/openai/codex/commits/c143a86de8c5da3ae5127565b9ffe7094d2e5c28","html_url":"https://github.com/openai/codex/commit/c143a86de8c5da3ae5127565b9ffe7094d2e5c28","comments_url":"https://api.github.com/repos/openai/codex/commits/c143a86de8c5da3ae5127565b9ffe7094d2e5c28/comments","author":{"login":"rhan-oai","id":214716640,"node_id":"U_kgDODMxQ4A","avatar_url":"https://avatars.githubusercontent.com/u/214716640?v=4","gravatar_id":"","url":"https://api.github.com/users/rhan-oai","html_url":"https://github.com/rhan-oai","followers_url":"https://api.github.com/users/rhan-oai/followers","following_url":"https://api.github.com/users/rhan-oai/following{/other_user}","gists_url":"https://api.github.com/users/rhan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rhan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rhan-oai/subscriptions","organizations_url":"https://api.github.com/users/rhan-oai/orgs","repos_url":"https://api.github.com/users/rhan-oai/repos","events_url":"https://api.github.com/users/rhan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rhan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"6bcccb0ee6b875a41ed9e8fb7e299a6b98dd3faa","url":"https://api.github.com/repos/openai/codex/commits/6bcccb0ee6b875a41ed9e8fb7e299a6b98dd3faa","html_url":"https://github.com/openai/codex/commit/6bcccb0ee6b875a41ed9e8fb7e299a6b98dd3faa"}]},{"sha":"6bcccb0ee6b875a41ed9e8fb7e299a6b98dd3faa","node_id":"C_kwDOOYsS4doAKDZiY2NjYjBlZTZiODc1YTQxZWQ5ZThmYjdlMjk5YTZiOThkZDNmYWE","commit":{"author":{"name":"Michael Bolin","email":"mbolin@openai.com","date":"2026-06-04T02:08:19Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-04T02:08:19Z"},"message":"cli: add package path from install context (#26189)\n\n## Why\n\nCodex package installs include helper binaries in `codex-path`, such as\nthe bundled `rg`. Package-layout launches should add that directory\nbefore user commands run, but standalone launches were missing it while\nnpm launches only worked because `codex.js` had its own legacy `PATH`\nrewrite. That made npm and standalone package behavior diverge.\n\nShell snapshot restoration can also reset `PATH` after runtime setup.\nAny package-owned `PATH` prepend has to be recorded as an explicit\nruntime override so shells, unified exec, and user-shell commands keep\naccess to `codex-path` after a snapshot is sourced.\n\n## Repro\n\nBefore this change, a curl-installed package could contain `rg` under\n`codex-path` but still fail to put it on `PATH`:\n\n```shell\nmkdir /tmp/test-codex-curl\ncurl -fsSL https://chatgpt.com/codex/install.sh \\\n  | CODEX_HOME=/tmp/test-codex-curl CODEX_NON_INTERACTIVE=1 sh\n/tmp/test-codex-curl/packages/standalone/current/bin/codex exec \\\n  --skip-git-repo-check 'print `which -a rg`'\nfind /tmp/test-codex-curl -name rg\n```\n\nThe `which -a rg` output omitted the packaged helper even though `find`\nshowed it under\n`/tmp/test-codex-curl/packages/standalone/releases/.../codex-path/rg`.\n\nThe npm install path behaved differently only because\n`codex-cli/bin/codex.js` had legacy `PATH` rewriting:\n\n```shell\nmkdir /tmp/test-codex-npm\ncd /tmp/test-codex-npm\nnpm install @openai/codex\n./node_modules/.bin/codex exec --skip-git-repo-check 'print `which -a rg`'\n```\n\nThat printed the npm package's `vendor/<target>/codex-path/rg` first.\nThis PR moves that behavior into Rust-side package launch setup so\ncurl/standalone and npm/bun launches agree without JS rewriting `PATH`.\n\n## What Changed\n\n- `codex-rs/arg0` now uses\n`InstallContext::current().package_layout.path_dir` to prepend the\npackage helper directory before any threads are created.\n- Package helper `PATH` setup is independent from the temporary arg0\nalias setup, so `codex-path` is still added even if CODEX_HOME tempdir,\nlock, or symlink setup fails.\n- `codex-rs/install-context` detects the canonical package layout we\nship: `bin/`, `codex-resources/`, and `codex-path/` next to\n`codex-package.json`.\n- Shell, local unified exec, and user-shell runtimes now record package\n`codex-path` prepends in `explicit_env_overrides`, matching the existing\nzsh-fork behavior so shell snapshots cannot restore over the package\nhelper path.\n- Remote unified exec requests do not receive the local app-server\npackage path overlay.\n- `codex-cli/bin/codex.js` no longer computes or overrides `PATH`; it\nonly locates the native binary in the canonical package layout and\npasses npm/bun management metadata.\n- Added regression tests for `PATH` ordering, package layout detection,\nand shell snapshot preservation of package path prepends.\n\n## Verification\n\n- `node --check codex-cli/bin/codex.js`\n- `just test -p codex-install-context -p codex-arg0`\n- `just test -p codex-core\nuser_shell_snapshot_preserves_package_path_prepend`\n- `just test -p codex-core tools::runtimes::tests`\n- `just bazel-lock-update`\n- `just bazel-lock-check`\n- `just fix -p codex-install-context -p codex-arg0 -p codex-core`","tree":{"sha":"a85ef780fd7796ff5f8b375d113ca6ead5065b48","url":"https://api.github.com/repos/openai/codex/git/trees/a85ef780fd7796ff5f8b375d113ca6ead5065b48"},"url":"https://api.github.com/repos/openai/codex/git/commits/6bcccb0ee6b875a41ed9e8fb7e299a6b98dd3faa","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqIN4TCRC1aQ7uu5UhlAAAqRcQAKdVARIT35JIbOQt8VbSjcqY\n2TGRNsrYqqEqZWAPPmv2r3mUERGJoC3ZxzxzkN3zWZoIeJTNWHSCF9ABqDOGTTR2\nR6C28u0Q7iMjJp4/GSZ+fUIAOQS9pq2EEwSImmajc8uGMYcK22UyML2wUR5RWGxD\nuKW0SmInFfTtb3i1QNlzKrTV3bGB1z01vElJ2/0Q0p7bTw52XZNtwgtxSZdCd+tG\nC1qS0tD6jAt2MFS7kCahJUdbF6+Tg1jwu9Sw+ZryUxGkcLyRjp9PN83BjMjNkOjt\nosRmeJeWxhNcvN5GyJ0njImgPxrWBTDzN0/CfHyfsNJQ1sl6PtusTh4AurcZN+C4\nQgHsqYKJJIVGqsO8UJ04dYEYJvS5I+FPDK5wFUHDYqUoYZiU4DdjYm1vKbeh6ynh\nx7zi1djFtPM7bdMVCKsN0qrp/mC6y/6T8cIm1oxBGdcAEEdQBWE+7/1AEfWmd/Hk\nd81jN5nRe40CULrEJTOC5yjK1s649USWyM3MO9yhcpWcJaPLieNjvCBFZyXF8oc1\nn1EfLxn+db+HTGTgr1WeJ5uXw+paZwcUOYc4yQj9KHXD/gDeP+l0429NOjZGe86P\nqIKbiWZD7zYebAJ4Z9kDGB6pIXockb2VuFT5zHnVft24adDEl3qJw1LkEzsbpnNz\nJlojMVzXZq6u/E/HKM8E\n=Q2hV\n-----END PGP SIGNATURE-----\n","payload":"tree a85ef780fd7796ff5f8b375d113ca6ead5065b48\nparent 80b65e99457344f5f05fb4948eb35c6b1d320e3f\nauthor Michael Bolin <mbolin@openai.com> 1780538899 -0700\ncommitter GitHub <noreply@github.com> 1780538899 -0700\n\ncli: add package path from install context (#26189)\n\n## Why\n\nCodex package installs include helper binaries in `codex-path`, such as\nthe bundled `rg`. Package-layout launches should add that directory\nbefore user commands run, but standalone launches were missing it while\nnpm launches only worked because `codex.js` had its own legacy `PATH`\nrewrite. That made npm and standalone package behavior diverge.\n\nShell snapshot restoration can also reset `PATH` after runtime setup.\nAny package-owned `PATH` prepend has to be recorded as an explicit\nruntime override so shells, unified exec, and user-shell commands keep\naccess to `codex-path` after a snapshot is sourced.\n\n## Repro\n\nBefore this change, a curl-installed package could contain `rg` under\n`codex-path` but still fail to put it on `PATH`:\n\n```shell\nmkdir /tmp/test-codex-curl\ncurl -fsSL https://chatgpt.com/codex/install.sh \\\n  | CODEX_HOME=/tmp/test-codex-curl CODEX_NON_INTERACTIVE=1 sh\n/tmp/test-codex-curl/packages/standalone/current/bin/codex exec \\\n  --skip-git-repo-check 'print `which -a rg`'\nfind /tmp/test-codex-curl -name rg\n```\n\nThe `which -a rg` output omitted the packaged helper even though `find`\nshowed it under\n`/tmp/test-codex-curl/packages/standalone/releases/.../codex-path/rg`.\n\nThe npm install path behaved differently only because\n`codex-cli/bin/codex.js` had legacy `PATH` rewriting:\n\n```shell\nmkdir /tmp/test-codex-npm\ncd /tmp/test-codex-npm\nnpm install @openai/codex\n./node_modules/.bin/codex exec --skip-git-repo-check 'print `which -a rg`'\n```\n\nThat printed the npm package's `vendor/<target>/codex-path/rg` first.\nThis PR moves that behavior into Rust-side package launch setup so\ncurl/standalone and npm/bun launches agree without JS rewriting `PATH`.\n\n## What Changed\n\n- `codex-rs/arg0` now uses\n`InstallContext::current().package_layout.path_dir` to prepend the\npackage helper directory before any threads are created.\n- Package helper `PATH` setup is independent from the temporary arg0\nalias setup, so `codex-path` is still added even if CODEX_HOME tempdir,\nlock, or symlink setup fails.\n- `codex-rs/install-context` detects the canonical package layout we\nship: `bin/`, `codex-resources/`, and `codex-path/` next to\n`codex-package.json`.\n- Shell, local unified exec, and user-shell runtimes now record package\n`codex-path` prepends in `explicit_env_overrides`, matching the existing\nzsh-fork behavior so shell snapshots cannot restore over the package\nhelper path.\n- Remote unified exec requests do not receive the local app-server\npackage path overlay.\n- `codex-cli/bin/codex.js` no longer computes or overrides `PATH`; it\nonly locates the native binary in the canonical package layout and\npasses npm/bun management metadata.\n- Added regression tests for `PATH` ordering, package layout detection,\nand shell snapshot preservation of package path prepends.\n\n## Verification\n\n- `node --check codex-cli/bin/codex.js`\n- `just test -p codex-install-context -p codex-arg0`\n- `just test -p codex-core\nuser_shell_snapshot_preserves_package_path_prepend`\n- `just test -p codex-core tools::runtimes::tests`\n- `just bazel-lock-update`\n- `just bazel-lock-check`\n- `just fix -p codex-install-context -p codex-arg0 -p codex-core`","verified_at":"2026-06-04T02:08:19Z"}},"url":"https://api.github.com/repos/openai/codex/commits/6bcccb0ee6b875a41ed9e8fb7e299a6b98dd3faa","html_url":"https://github.com/openai/codex/commit/6bcccb0ee6b875a41ed9e8fb7e299a6b98dd3faa","comments_url":"https://api.github.com/repos/openai/codex/commits/6bcccb0ee6b875a41ed9e8fb7e299a6b98dd3faa/comments","author":{"login":"bolinfest","id":655869,"node_id":"MDQ6VXNlcjY1NTg2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/655869?v=4","gravatar_id":"","url":"https://api.github.com/users/bolinfest","html_url":"https://github.com/bolinfest","followers_url":"https://api.github.com/users/bolinfest/followers","following_url":"https://api.github.com/users/bolinfest/following{/other_user}","gists_url":"https://api.github.com/users/bolinfest/gists{/gist_id}","starred_url":"https://api.github.com/users/bolinfest/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bolinfest/subscriptions","organizations_url":"https://api.github.com/users/bolinfest/orgs","repos_url":"https://api.github.com/users/bolinfest/repos","events_url":"https://api.github.com/users/bolinfest/events{/privacy}","received_events_url":"https://api.github.com/users/bolinfest/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0ND