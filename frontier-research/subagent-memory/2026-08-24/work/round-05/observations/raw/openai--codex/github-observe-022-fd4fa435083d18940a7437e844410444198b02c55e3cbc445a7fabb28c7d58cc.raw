34380e46cfd909c3642c1e05d3d8283c40ef","html_url":"https://github.com/openai/codex/commit/f91334380e46cfd909c3642c1e05d3d8283c40ef","comments_url":"https://api.github.com/repos/openai/codex/commits/f91334380e46cfd909c3642c1e05d3d8283c40ef/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"5267e805fb830891c0b23376bcd9cbd382c3473c","url":"https://api.github.com/repos/openai/codex/commits/5267e805fb830891c0b23376bcd9cbd382c3473c","html_url":"https://github.com/openai/codex/commit/5267e805fb830891c0b23376bcd9cbd382c3473c"}]},{"sha":"5267e805fb830891c0b23376bcd9cbd382c3473c","node_id":"C_kwDOOYsS4doAKDUyNjdlODA1ZmI4MzA4OTFjMGIyMzM3NmJjZDljYmQzODJjMzQ3M2M","commit":{"author":{"name":"Owen Lin","email":"owenlin0@gmail.com","date":"2026-06-26T16:12:42Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T16:12:42Z"},"message":"feat(app-server): add history_mode to thread (#29927)\n\n## Description\n\nThis PR adds a new `historyMode = \"legacy\" | \"paginated\"` to `Thread`.\nThis will be stored in `SessionMeta` in the JSONL rollout file and as a\nnew column in the SQLite thread_metadata table, and exposed on\n`thread/start` and on the `Thread` object in app-server.\n\n## What changed\n\n- Added canonical `ThreadHistoryMode` with `legacy` and `paginated`,\ndefaulting old and new SessionMeta to `legacy`.\n- Carried `history_mode` through core session config, ThreadStore stored\nmetadata, local/in-memory stores, rollout metadata extraction, and the\nexisting SQLite `threads` table.\n- Added experimental `historyMode` to app-server v2 `Thread` and\n`thread/start`.\n- Made paginated stored threads metadata-discoverable but unsupported\nfor legacy full-history reads, `load_history`, live resume, and create\npaths.\n- Regenerated app-server schema fixtures and added\nprotocol/state/thread-store/app-server coverage for persistence and\nfail-closed behavior.\n\n## Compatibility floor\nBecause users may be running various versions of Codex binaries on the\nsame machine (TUI, Codex App, etc.), we will need to establish a\ncompatibility floor for upcoming paginated threads, which will change\nhow thread storage reads and writes work.\n\nThe overall plan here:\n```\nRelease N:\n- Add historyMode to SessionMeta / Thread / SQLite metadata.\n- Teach binaries to understand paginated threads.\n- If a binary sees `historyMode=\"paginated\"` but does not support the paginated contract, it refuses to resume/mutate the thread.\n- Default remains `\"legacy\"`.\n\nRelease N+1:\n- First-party clients start opting into paginated threads where appropriate.\n- Internal dogfood / staged rollout.\n- Measure old-client usage and paginated-thread unsupported errors.\n\nRelease N+2:\n- Only after Release N+ is overwhelmingly deployed, make paginated the default.\n- Accept that a small tail of N-1-or-older binaries may not understand paginated threads.\n```\n\nThe important behavior change is fail-closed handling for a binary that\nencounters a persisted `paginated` thread before it knows how to fully\nsupport paginated history. In app-server, if a thread is `paginated`, we\nwill:\n\n- allow metadata-only discovery paths like `thread/list` and\n`thread/read(includeTurns=false)`, so clients can still see the thread\nand inspect its `historyMode`\n- reject legacy full-history/live-thread paths like\n`thread/read(includeTurns=true)` and `thread/resume` with an unsupported\nJSON-RPC error\n- avoid silently treating an unknown or future `historyMode` as `legacy`\n\nUnder the hood, the ThreadStore layer also rejects legacy operations\nthat would need to load or replay the full thread history for a\npaginated thread. That gives us the behavior we want for Release N:\nfuture paginated threads are visible, but this binary fails closed\ninstead of trying to operate on them as if they were legacy threads.","tree":{"sha":"f2b37f2bebc938a3cf6c19c3340b25b74f073df3","url":"https://api.github.com/repos/openai/codex/git/trees/f2b37f2bebc938a3cf6c19c3340b25b74f073df3"},"url":"https://api.github.com/repos/openai/codex/git/commits/5267e805fb830891c0b23376bcd9cbd382c3473c","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPqT7CRC1aQ7uu5UhlAAAtjsQADPyKdVOiXF/wUZzAGF7K6u6\nf2l5IIluvmuP/uyGvu0Sy/gjQsZPOWwfnhXepDt93JzUfQw8vQZMFo7s3VId4SYh\nZOJMlRVE2lpqp3zfrKtapzbzW+lvmRKESmOVBkJRMIkmwDLzDH14zb68FMN2A2eq\n5rSIKVgYDysJAWMg+Lrnxi5a4+/4+ZwKwkhNL264HPrOpTnmDtsp4BxR4+U6f/63\nxJS1c5IC0/gYLzjBgv6lnDEaNXjy7GXgGKpqJ60uJuLCcbpNJkvdmuQ/dUE+DLYC\n/wP7mjIwucqB44QyVgYh+EoQOu8Pkf/Dc3aoaX4TEH2vT27ivjo+y5Ap5ZLTI2fX\n6mJ1IfUfGLxZGB7UA9hrjEXPFAalIDqr3GYNNnDSTOQX2Id0l80vnxaCQw0ttz5T\npUfklEY/TQLlZ0Qp9Y5RY+4Oa9uWhz8nkmbnRdlDxzZ5HE69qBnfM1szINTy5CcD\ngT3CB+63DoxDCQRNQrewq192J0YmsVP76YfW7Jg8n8mvsyUvXsccJrKkeJQoN7Rx\nsqx/+OZQ6If51MnJZgnwZtXPZ5CVUhdvM/Qoz5UEcB/aKzLmY2XtuuUMgs6lv7xl\nNkojnKbMKyFEKweLXAiyHGuyazxJ4lfEwZ0hu5ZeawyiY/pDlZOWNK4a12satSjd\nn7ZADL2/z+RecF8uwCHF\n=6GZI\n-----END PGP SIGNATURE-----\n","payload":"tree f2b37f2bebc938a3cf6c19c3340b25b74f073df3\nparent 2c5bc5e284402d2e618c15e396d2e81bcc1ec257\nauthor Owen Lin <owenlin0@gmail.com> 1782490362 -0700\ncommitter GitHub <noreply@github.com> 1782490362 -0700\n\nfeat(app-server): add history_mode to thread (#29927)\n\n## Description\n\nThis PR adds a new `historyMode = \"legacy\" | \"paginated\"` to `Thread`.\nThis will be stored in `SessionMeta` in the JSONL rollout file and as a\nnew column in the SQLite thread_metadata table, and exposed on\n`thread/start` and on the `Thread` object in app-server.\n\n## What changed\n\n- Added canonical `ThreadHistoryMode` with `legacy` and `paginated`,\ndefaulting old and new SessionMeta to `legacy`.\n- Carried `history_mode` through core session config, ThreadStore stored\nmetadata, local/in-memory stores, rollout metadata extraction, and the\nexisting SQLite `threads` table.\n- Added experimental `historyMode` to app-server v2 `Thread` and\n`thread/start`.\n- Made paginated stored threads metadata-discoverable but unsupported\nfor legacy full-history reads, `load_history`, live resume, and create\npaths.\n- Regenerated app-server schema fixtures and added\nprotocol/state/thread-store/app-server coverage for persistence and\nfail-closed behavior.\n\n## Compatibility floor\nBecause users may be running various versions of Codex binaries on the\nsame machine (TUI, Codex App, etc.), we will need to establish a\ncompatibility floor for upcoming paginated threads, which will change\nhow thread storage reads and writes work.\n\nThe overall plan here:\n```\nRelease N:\n- Add historyMode to SessionMeta / Thread / SQLite metadata.\n- Teach binaries to understand paginated threads.\n- If a binary sees `historyMode=\"paginated\"` but does not support the paginated contract, it refuses to resume/mutate the thread.\n- Default remains `\"legacy\"`.\n\nRelease N+1:\n- First-party clients start opting into paginated threads where appropriate.\n- Internal dogfood / staged rollout.\n- Measure old-client usage and paginated-thread unsupported errors.\n\nRelease N+2:\n- Only after Release N+ is overwhelmingly deployed, make paginated the default.\n- Accept that a small tail of N-1-or-older binaries may not understand paginated threads.\n```\n\nThe important behavior change is fail-closed handling for a binary that\nencounters a persisted `paginated` thread before it knows how to fully\nsupport paginated history. In app-server, if a thread is `paginated`, we\nwill:\n\n- allow metadata-only discovery paths like `thread/list` and\n`thread/read(includeTurns=false)`, so clients can still see the thread\nand inspect its `historyMode`\n- reject legacy full-history/live-thread paths like\n`thread/read(includeTurns=true)` and `thread/resume` with an unsupported\nJSON-RPC error\n- avoid silently treating an unknown or future `historyMode` as `legacy`\n\nUnder the hood, the ThreadStore layer also rejects legacy operations\nthat would need to load or replay the full thread history for a\npaginated thread. That gives us the behavior we want for Release N:\nfuture paginated threads are visible, but this binary fails closed\ninstead of trying to operate on them as if they were legacy threads.","verified_at":"2026-06-26T16:12:43Z"}},"url":"https://api.github.com/repos/openai/codex/commits/5267e805fb830891c0b23376bcd9cbd382c3473c","html_url":"https://github.com/openai/codex/commit/5267e805fb830891c0b23376bcd9cbd382c3473c","comments_url":"https://api.github.com/repos/openai/codex/commits/5267e805fb830891c0b23376bcd9cbd382c3473c/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"2c5bc5e284402d2e618c15e396d2e81bcc1ec257","url":"https://api.github.com/repos/openai/codex/commits/2c5bc5e284402d2e618c15e396d2e81bcc1ec257","html_url":"https://github.com/openai/codex/commit/2c5bc5e284402d2e618c15e396d2e81bcc1ec257"}]},{"sha":"2c5bc5e284402d2e618c15e396d2e81bcc1ec257","node_id":"C_kwDOOYsS4doAKDJjNWJjNWUyODQ0MDJkMmU2MThjMTVlMzk2ZDJlODFiY2MxZWMyNTc","commit":{"author":{"name":"charlesgong-openai","email":"charlesgong@openai.com","date":"2026-06-26T15:24:12Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T15:24:12Z"},"message":"Relax hooks.json top-level metadata validation (#30229)\n\n## Summary\n- Allow a top-level `description` string in `hooks.json`.\n- Continue rejecting unknown top-level keys and root-level hook events;\nevents must remain under `hooks`.\n\n## Testing\n- `just test -p codex-config`","tree":{"sha":"3bf54cc083f2ad015789aa410a9ed01eac79c083","url":"https://api.github.com/repos/openai/codex/git/trees/3bf54cc083f2ad015789aa410a9ed01eac79c083"},"url":"https://api.github.com/repos/openai/codex/git/commits/2c5bc5e284402d2e618c15e396d2e81bcc1ec257","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPpmcCRC1aQ7uu5UhlAAAtt0QAI8jTW9A6e4/lWpGiYkCfikd\nEYBhjyEBDE47ov8wCZTcdyeFvBGidHLvQtUVO+n0sfYPANpkxdQCNNLppk34ruuF\n+ZB9CE2BaEgBa5ia8BgEK6kB0pr5x4lZR61d1Gh8Xh/iSG5RSrhwlO8/dJSmFRyu\nZIosUcilgXm6RrCt5Y1kBsfNKcw7QvqyJBMRTaJVLTPkYbv0h3yp0FXD6at9tdch\nTGemjT0BszWeZoYM9T+dBFO8XsHvXOXseyl1jyV9tI65ZcWLpcdGkrICBNO1sMgQ\n7gHqcvMiLeN34Ep5fxbbuphJRVHkScLPLpGap9MA6NqEF0TxtYxCxlS5L3r/1hQl\nVMoLHrtPTtchpBVgBDBGgf4sQ