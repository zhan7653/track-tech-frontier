[{"sha":"41ece455b7fa7166f4fc38522952afdaa2604e18","node_id":"C_kwDOOYsS4doAKDQxZWNlNDU1YjdmYTcxNjZmNGZjMzg1MjI5NTJhZmRhYTI2MDRlMTg","commit":{"author":{"name":"rka-oai","email":"rka@openai.com","date":"2026-08-11T05:26:16Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-11T05:32:28Z"},"message":"Validate images before returning `view_image` output (#37939)\n\n## What changed\n\n- Reject invalid or unsupported image data before producing tool output, so\n  non-image file contents are not exposed through code mode.\n- Preserve valid image bytes and metadata while leaving image preparation and\n  resizing to the history insertion path.\n\n## Testing\n\n- Cover invalid images in both code mode and standard `view_image` calls.\n- Verify that code mode preserves PNG bytes, dimensions, EXIF orientation, and\n  metadata.\n\nGitOrigin-RevId: 07343ed10b781d0ce0ffb5b24432658be4c046e3","tree":{"sha":"5979bce6b3189d6fefd094c8ed7ea191a1347b6d","url":"https://api.github.com/repos/openai/codex/git/trees/5979bce6b3189d6fefd094c8ed7ea191a1347b6d"},"url":"https://api.github.com/repos/openai/codex/git/commits/41ece455b7fa7166f4fc38522952afdaa2604e18","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/41ece455b7fa7166f4fc38522952afdaa2604e18","html_url":"https://github.com/openai/codex/commit/41ece455b7fa7166f4fc38522952afdaa2604e18","comments_url":"https://api.github.com/repos/openai/codex/commits/41ece455b7fa7166f4fc38522952afdaa2604e18/comments","author":{"login":"rka-oai","id":240799229,"node_id":"U_kgDODlpN_Q","avatar_url":"https://avatars.githubusercontent.com/u/240799229?v=4","gravatar_id":"","url":"https://api.github.com/users/rka-oai","html_url":"https://github.com/rka-oai","followers_url":"https://api.github.com/users/rka-oai/followers","following_url":"https://api.github.com/users/rka-oai/following{/other_user}","gists_url":"https://api.github.com/users/rka-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rka-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rka-oai/subscriptions","organizations_url":"https://api.github.com/users/rka-oai/orgs","repos_url":"https://api.github.com/users/rka-oai/repos","events_url":"https://api.github.com/users/rka-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rka-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"2cc9dbb9846b2dc03948414df6712adb967c70eb","url":"https://api.github.com/repos/openai/codex/commits/2cc9dbb9846b2dc03948414df6712adb967c70eb","html_url":"https://github.com/openai/codex/commit/2cc9dbb9846b2dc03948414df6712adb967c70eb"}]},{"sha":"2cc9dbb9846b2dc03948414df6712adb967c70eb","node_id":"C_kwDOOYsS4doAKDJjYzlkYmI5ODQ2YjJkYzAzOTQ4NDE0ZGY2NzEyYWRiOTY3YzcwZWI","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-08-11T03:27:48Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-11T03:39:02Z"},"message":"Add shared runtime build information (#37929)\n\n## What changed\n\n- Add `codex-build-info` to resolve a packaged runtime's semantic version from `codex-package.json` while preserving the commit stamped into the executable.\n- Represent source builds as version `0.0.0` and expose helpers for display, serialization, and source-build detection.\n- Stamp `STABLE_GIT_COMMIT` into final Bazel Rust binaries so Git changes do not invalidate the shared library graph.\n\n## Testing\n\n- Cover packaged, source, legacy, and invalid-version resolution, plus serialization round trips.\n\nGitOrigin-RevId: 669b02449644c738ba2946a1b7aafe4ec31a9edb","tree":{"sha":"2d63cc2797ace311a14b3f2d01c5b91152927481","url":"https://api.github.com/repos/openai/codex/git/trees/2d63cc2797ace311a14b3f2d01c5b91152927481"},"url":"https://api.github.com/repos/openai/codex/git/commits/2cc9dbb9846b2dc03948414df6712adb967c70eb","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/2cc9dbb9846b2dc03948414df6712adb967c70eb","html_url":"https://github.com/openai/codex/commit/2cc9dbb9846b2dc03948414df6712adb967c70eb","comments_url":"https://api.github.com/repos/openai/codex/commits/2cc9dbb9846b2dc03948414df6712adb967c70eb/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"722784e9366a0343a005f91fadf6d807c8a22c76","url":"https://api.github.com/repos/openai/codex/commits/722784e9366a0343a005f91fadf6d807c8a22c76","html_url":"https://github.com/openai/codex/commit/722784e9366a0343a005f91fadf6d807c8a22c76"}]},{"sha":"722784e9366a0343a005f91fadf6d807c8a22c76","node_id":"C_kwDOOYsS4doAKDcyMjc4NGU5MzY2YTAzNDNhMDA1ZjkxZmFkZjZkODA3YzhhMjJjNzY","commit":{"author":{"name":"Bryan Ashley","email":"bryan.ashley@bashley.net","date":"2026-08-11T03:25:25Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-11T03:35:45Z"},"message":"Distinguish turn-start thread persistence (#37926)\n\n## What changed\n\n- Add `PersistContext` to the thread-store persistence contract so stores can\n  identify persistence requested immediately before model sampling. A\n  `TurnStart` request may be enqueued in the background when later flush and\n  shutdown operations fence it and report any failure; all other persistence\n  remains synchronous.\n- Use the turn-start context only for the initial input of a regular turn, while\n  admission acknowledgments, steered input, and other persistence paths keep\n  the standard durability behavior.\n- Flush pending metadata before turn-start persistence and ensure shutdown is\n  still attempted if that metadata update fails.\n\n## Testing\n\n- Verify that developer instructions and user input are persisted before the\n  model request completes for a default paginated-history thread.\n\nGitOrigin-RevId: 162f0ec796a61aebe66ca0b909fbcccec3047b85","tree":{"sha":"0f7eb7b7c80ef9ce299a1099a134a130da74369a","url":"https://api.github.com/repos/openai/codex/git/trees/0f7eb7b7c80ef9ce299a1099a134a130da74369a"},"url":"https://api.github.com/repos/openai/codex/git/commits/722784e9366a0343a005f91fadf6d807c8a22c76","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/722784e9366a0343a005f91fadf6d807c8a22c76","html_url":"https://github.com/openai/codex/commit/722784e9366a0343a005f91fadf6d807c8a22c76","comments_url":"https://api.github.com/repos/openai/codex/commits/722784e9366a0343a005f91fadf6d807c8a22c76/comments","author":{"login":"bryanashley","id":1095642,"node_id":"MDQ6VXNlcjEwOTU2NDI=","avatar_url":"https://avatars.githubusercontent.com/u/1095642?v=4","gravatar_id":"","url":"https://api.github.com/users/bryanashley","html_url":"https://github.com/bryanashley","followers_url":"https://api.github.com/users/bryanashley/followers","following_url":"https://api.github.com/users/bryanashley/following{/other_user}","gists_url":"https://api.github.com/users/bryanashley/gists{/gist_id}","starred_url":"https://api.github.com/users/bryanashley/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bryanashley/subscriptions","organizations_url":"https://api.github.com/users/bryanashley/orgs","repos_url":"https://api.github.com/users/bryanashley/repos","events_url":"https://api.github.com/users/bryanashley/events{/privacy}","received_events_url":"https://api.github.com/users/bryanashley/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"f8821d85eb68678b9287f901c224e6aa71a827e3","url":"https://api.github.com/repos/openai/codex/commits/f8821d85eb68678b9287f901c224e6aa71a827e3","html_url":"https://github.com/openai/codex/commit/f8821d85eb68678b9287f901c224e6aa71a827e3"}]},{"sha":"f8821d85eb68678b9287f901c224e6aa71a827e3","node_id":"C_kwDOOYsS4doAKGY4ODIxZDg1ZWI2ODY3OGI5Mjg3ZjkwMWMyMjRlNmFhNzFhODI3ZTM","commit":{"author":{"name":"Channing Conger","email":"cconger@openai.com","date":"2026-08-11T02:51:34Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-11T03:06:53Z"},"message":"Extract reusable code-mode host test support (#37922)\n\n## What changed\n\n- Move the host process harness and common session delegates into shared test\n  support modules.\n- Allow the host harness to start either WebSocket or gRPC listeners and\n  validate the endpoint scheme they publish.\n- Update the stdio and WebSocket integration tests to use the shared fixtures.\n\nGitOrigin-RevId: a0408be7c88e4eb9ad1832b6d2698781de77168a","tree":{"sha":"4c9441016994ae2caa660aa0f70a86d4917cd557","url":"https://api.github.com/repos/openai/codex/git/trees/4c9441016994ae2caa660aa0f70a86d4917cd557"},"url":"https://api.github.com/repos/openai/codex/git/commits/f8821d85eb68678b9287f901c224e6aa71a827e3","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/f8821d85eb68678b9287f901c224e6aa71a827e3","html_url":"https://github.com/openai/codex/commit/f8821d85eb68678b9287f901c224e6aa71a827e3","comments_url":"https://api.github.com/repos/openai/codex/commits/f8821d85eb68678b9287f901c224e6aa71a827e3/comments","author":{"login":"cconger","id":200563,"node_id":"MDQ6VXNlcjIwMDU2Mw==","avatar_url":"https://avatars.githubusercontent.com/u/200563?v=4","gravatar_id":"","url":"https://api.github.com/users/cconger","html_url":"https://github.com/cconger","followers_url":"https://api.github.com/users/cconger/followers","following_url":"https://api.github.com/users/cconger/following{/other_user}","gists_url":"https://api.github.com/users/cconger/gists{/gist_id}","starred_url":"https://api.github.com/users/cconger/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cconger/subscriptions","organizations_url":"https://api.github.com/users/cconger/orgs","repos_url":"https://api.github.com/users/cconger/repos","events_url":"https://api.github.com/users/cconger/events{/privacy}","received_events_url":"https://api.github.com/users/cconger/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"070a26a1f00817931a17e2cdf8fbe03a2a0ed128","url":"https://api.github.com/repos/openai/codex/commits/070a26a1f00817931a17e2cdf8fbe03a2a0ed128","html_url":"https://github.com/openai/codex/commit/070a26a1f00817931a17e2cdf8fbe03a2a0ed128"}]},{"sha":"070a26a1f00817931a17e2cdf8fbe03a2a0ed128","node_id":"C_kwDOOYsS4doAKDA3MGEyNmExZjAwODE3OTMxYTE3ZTJjZGY4ZmJlMDNhMmEwZWQxMjg","commit":{"author":{"name":"Abhinav","email":"abhinav@openai.com","date":"2026-08-11T01:00:46Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-11T01:05:48Z"},"message":"Apply refreshed cloud config bundles to later sessions (#37908)\n\n## Why\n\nBackground refreshes previously warmed only the on-disk cache, so new sessions in the same process continued using the startup snapshot.\n\n## What changed\n\n- Make `CloudConfigBundleLoader` retrieve the latest shared bundle on each configuration load.\n- Update the in-memory bundle after successful refreshes while preserving the last successful bundle when a refresh fails.\n- Stop refresh work when its loader is replaced or its final clone is dropped.\n\n## Testing\n\n- Cover refreshed requirements and managed configuration in later sessions.\n- Cover concurrent initial loads, refresh failures and recovery, bundle clearing, and refresh-task cancellation.\n\nGitOrigin-RevId: ae3d79b575bad71a1eed370cee6dc66dc022ffa8","tree":{"sha":"9caf1abf881379c8c443f97d6a14f9190f6deb8e","url":"https://api.github.com/repos/openai/codex/git/trees/9caf1abf881379c8c443f97d6a14f9190f6deb8e"},"url":"https://api.github.com/repos/openai/codex/git/commits/070a26a1f00817931a17e2cdf8fbe03a2a0ed128","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/070a26a1f00817931a17e2cdf8fbe03a2a0ed128","html_url":"https://github.com/openai/codex/commit/070a26a1f00817931a17e2cdf8fbe03a2a0ed128","comments_url":"https://api.github.com/repos/openai/codex/commits/070a26a1f00817931a17e2cdf8fbe03a2a0ed128/comments","author":{"login":"abhinav-oai","id":274334565,"node_id":"U_kgDOEFoDZQ","avatar_url":"https://avatars.githubusercontent.com/u/274334565?v=4","gravatar_id":"","url":"https://api.github.com/users/abhinav-oai","html_url":"https://github.com/abhinav-oai","followers_url":"https://api.github.com/users/abhinav-oai/followers","following_url":"https://api.github.com/users/abhinav-oai/following{/other_user}","gists_url":"https://api.github.com/users/abhinav-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/abhinav-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abhinav-oai/subscriptions","organizations_url":"https://api.github.com/users/abhinav-oai/orgs","repos_url":"https://api.github.com/users/abhinav-oai/repos","events_url":"https://api.github.com/users/abhinav-oai/events{/privacy}","received_events_url":"https://api.github.com/users/abhinav-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"9be95745fb84f540582e6ef4144e7edf5bcb7959","url":"https://api.github.com/repos/openai/codex/commits/9be95745fb84f540582e6ef4144e7edf5bcb7959","html_url":"https://github.com/openai/codex/commit/9be95745fb84f540582e6ef4144e7edf5bcb7959"}]},{"sha":"9be95745fb84f540582e6ef4144e7edf5bcb7959","node_id":"C_kwDOOYsS4doAKDliZTk1NzQ1ZmI4NGY1NDA1ODJlNmVmNDE0NGU3ZWRmNWJjYjc5NTk","commit":{"author":{"name":"Channing Conger","email":"cconger@openai.com","date":"2026-08-11T00:46:47Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-11T00:52:35Z"},"message":"Make gRPC code-mode notifications fire-and-forget (#37906)\n\n## What changed\n\n- Send notification events without waiting for client acknowledgment, so an\n  unacknowledged notification no longer delays cell completion.\n- Keep the notification acknowledgment RPC as a compatibility no-op after\n  validating the session and notification ID.\n- Remove pending-notification tracking and cancellation events from the gRPC\n  session routing path.\n\n## Testing\n\n- Verify that a cell completes after emitting an unacknowledged notification\n  and that a later acknowledgment is still accepted.\n\nGitOrigin-RevId: 19cf3ed5ce82cf45d84fa75f238c2afa4e83acb5","tree":{"sha":"779bc5da1dc6a3d6acd3bad684336fbf1bea0370","url":"https://api.github.com/repos/openai/codex/git/trees/779bc5da1dc6a3d6acd3bad684336fbf1bea0370"},"url":"https://api.github.com/repos/openai/codex/git/commits/9be95745fb84f540582e6ef4144e7edf5bcb7959","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/9be95745fb84f540582e6ef4144e7edf5bcb7959","html_url":"https://github.com/openai/codex/commit/9be95745fb84f540582e6ef4144e7edf5bcb7959","comments_url":"https://api.github.com/repos/openai/codex/commits/9be95745fb84f540582e6ef4144e7edf5bcb7959/comments","author":{"login":"cconger","id":200563,"node_id":"MDQ6VXNlcjIwMDU2Mw==","avatar_url":"https://avatars.githubusercontent.com/u/200563?v=4","gravatar_id":"","url":"https://api.github.com/users/cconger","html_url":"https://github.com/cconger","followers_url":"https://api.github.com/users/cconger/followers","following_url":"https://api.github.com/users/cconger/following{/other_user}","gists_url":"https://api.github.com/users/cconger/gists{/gist_id}","starred_url":"https://api.github.com/users/cconger/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cconger/subscriptions","organizations_url":"https://api.github.com/users/cconger/orgs","repos_url":"https://api.github.com/users/cconger/repos","events_url":"https://api.github.com/users/cconger/events{/privacy}","received_events_url":"https://api.github.com/users/cconger/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"260261ed8f5c91ad6b7f695571a4111ed1a46272","url":"https://api.github.com/repos/openai/codex/commits/260261ed8f5c91ad6b7f695571a4111ed1a46272","html_url":"https://github.com/openai/codex/commit/260261ed8f5c91ad6b7f695571a4111ed1a46272"}]},{"sha":"260261ed8f5c91ad6b7f695571a4111ed1a46272","node_id":"C_kwDOOYsS4doAKDI2MDI2MWVkOGY1YzkxYWQ2YjdmNjk1NTcxYTQxMTFlZDFhNDYyNzI","commit":{"author":{"name":"rka-oai","email":"rka@openai.com","date":"2026-08-11T00:08:09Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-11T00:17:36Z"},"message":"Defer `view_image` processing to history insertion (#37902)\n\n## What changed\n\n- Pass image bytes from `view_image` through unchanged for both direct and code-mode calls, leaving decoding and resizing to the shared history-insertion path.\n- Represent invalid image data with the existing image-omission placeholder instead of returning a tool error.\n\n## Testing\n\n- Update the `view_image` integration test to cover placeholder output for invalid image data.\n\nGitOrigin-RevId: 62863defd4815efb8a7725712fd583ad81db3fbb","tree":{"sha":"005dfc74ed7d10999357d1b7694f2af71b91f790","url":"https://api.github.com/repos/openai/codex/git/trees/005dfc74ed7d10999357d1b7694f2af71b91f790"},"url":"https://api.github.com/repos/openai/codex/git/commits/260261ed8f5c91ad6b7f695571a4111ed1a46272","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/260261ed8f5c91ad6b7f695571a4111ed1a46272","html_url":"https://github.com/openai/codex/commit/260261ed8f5c91ad6b7f695571a4111ed1a46272","comments_url":"https://api.github.com/repos/openai/codex/commits/260261ed8f5c91ad6b7f695571a4111ed1a46272/comments","author":{"login":"rka-oai","id":240799229,"node_id":"U_kgDODlpN_Q","avatar_url":"https://avatars.githubusercontent.com/u/240799229?v=4","gravatar_id":"","url":"https://api.github.com/users/rka-oai","html_url":"https://github.com/rka-oai","followers_url":"https://api.github.com/users/rka-oai/followers","following_url":"https://api.github.com/users/rka-oai/following{/other_user}","gists_url":"https://api.github.com/users/rka-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rka-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rka-oai/subscriptions","organizations_url":"https://api.github.com/users/rka-oai/orgs","repos_url":"https://api.github.com/users/rka-oai/repos","events_url":"https://api.github.com/users/rka-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rka-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"ab3b4d26d4739ad824e31d0b5d96284d84630947","url":"https://api.github.com/repos/openai/codex/commits/ab3b4d26d4739ad824e31d0b5d96284d84630947","html_url":"https://github.com/openai/codex/commit/ab3b4d26d4739ad824e31d0b5d96284d84630947"}]},{"sha":"ab3b4d26d4739ad824e31d0b5d96284d84630947","node_id":"C_kwDOOYsS4doAKGFiM2I0ZDI2ZDQ3MzlhZDgyNGUzMWQwYjVkOTYyODRkODQ2MzA5NDc","commit":{"author":{"name":"Owen Lin","email":"owen@openai.com","date":"2026-08-10T23:34:58Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T23:41:52Z"},"message":"Make submission operations move-only (#37901)\n\n## What changed\n\n- Remove `Clone` from `Submission` and remove `Clone` and `PartialEq` from `Op`.\n- Consume operations directly in the submission loop instead of cloning them.\n- Limit thread-manager test capture to the operation variants under test and update assertions to compare their relevant fields.\n\nGitOrigin-RevId: 781cc631391b8583d94dad5ca45f589856c0b21a","tree":{"sha":"8550cb068790ddaf0d9e11d90b84e3c1b0c2c34c","url":"https://api.github.com/repos/openai/codex/git/trees/8550cb068790ddaf0d9e11d90b84e3c1b0c2c34c"},"url":"https://api.github.com/repos/openai/codex/git/commits/ab3b4d26d4739ad824e31d0b5d96284d84630947","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/ab3b4d26d4739ad824e31d0b5d96284d84630947","html_url":"https://github.com/openai/codex/commit/ab3b4d26d4739ad824e31d0b5d96284d84630947","comments_url":"https://api.github.com/repos/openai/codex/commits/ab3b4d26d4739ad824e31d0b5d96284d84630947/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"1549756b7866be6a440ae00a3fd6d4f905d5c253","url":"https://api.github.com/repos/openai/codex/commits/1549756b7866be6a440ae00a3fd6d4f905d5c253","html_url":"https://github.com/openai/codex/commit/1549756b7866be6a440ae00a3fd6d4f905d5c253"}]},{"sha":"1549756b7866be6a440ae00a3fd6d4f905d5c253","node_id":"C_kwDOOYsS4doAKDE1NDk3NTZiNzg2NmJlNmE0NDBhZTAwYTNmZDZkNGY5MDVkNWMyNTM","commit":{"author":{"name":"joeytrasatti-openai","email":"joey.trasatti@openai.com","date":"2026-08-10T23:26:23Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T23:32:42Z"},"message":"Add appearance metadata to thread sections (#37898)\n\n## What changed\n\n- Add optional `icon` and `color` appearance fields to custom thread sections and expose them through the app-server protocol.\n- Persist appearance metadata in SQLite and include it when listing sections or returning threads.\n- Let `threadSection/update` preserve an omitted appearance, clear it with `null`, or replace it with a new value.\n- Reject appearance fields larger than 64 bytes.\n\n## Testing\n\n- Cover protocol compatibility, persistence across restart, update and clear behavior, and field-length validation.\n\nGitOrigin-RevId: 8f55ce4f42f8bd17aa5416848a85845f681953df","tree":{"sha":"a45832fbc98aaf840ea8ba913f16756e422d2405","url":"https://api.github.com/repos/openai/codex/git/trees/a45832fbc98aaf840ea8ba913f16756e422d2405"},"url":"https://api.github.com/repos/openai/codex/git/commits/1549756b7866be6a440ae00a3fd6d4f905d5c253","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/1549756b7866be6a440ae00a3fd6d4f905d5c253","html_url":"https://github.com/openai/codex/commit/1549756b7866be6a440ae00a3fd6d4f905d5c253","comments_url":"https://api.github.com/repos/openai/codex/commits/1549756b7866be6a440ae00a3fd6d4f905d5c253/comments","author":{"login":"joeytrasatti-openai","id":187452053,"node_id":"U_kgDOCyxKlQ","avatar_url":"https://avatars.githubusercontent.com/u/187452053?v=4","gravatar_id":"","url":"https://api.github.com/users/joeytrasatti-openai","html_url":"https://github.com/joeytrasatti-openai","followers_url":"https://api.github.com/users/joeytrasatti-openai/followers","following_url":"https://api.github.com/users/joeytrasatti-openai/following{/other_user}","gists_url":"https://api.github.com/users/joeytrasatti-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/joeytrasatti-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/joeytrasatti-openai/subscriptions","organizations_url":"https://api.github.com/users/joeytrasatti-openai/orgs","repos_url":"https://api.github.com/users/joeytrasatti-openai/repos","events_url":"https://api.github.com/users/joeytrasatti-openai/events{/privacy}","received_events_url":"https://api.github.com/users/joeytrasatti-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"92912d6d84e567f8fc921c0b7c429abff182b004","url":"https://api.github.com/repos/openai/codex/commits/92912d6d84e567f8fc921c0b7c429abff182b004","html_url":"https://github.com/openai/codex/commit/92912d6d84e567f8fc921c0b7c429abff182b004"}]},{"sha":"92912d6d84e567f8fc921c0b7c429abff182b004","node_id":"C_kwDOOYsS4doAKDkyOTEyZDZkODRlNTY3ZjhmYzkyMWMwYjdjNDI5YWJmZjE4MmIwMDQ","commit":{"author":{"name":"Sean Huang","email":"seanh@openai.com","date":"2026-08-10T22:52:57Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T23:03:31Z"},"message":"Add hermetic Windows SDK and MSVC runtime repositories (#37896)\n\n## What changed\n\n- Add pinned `windows_support` repositories for the Windows SDK and MSVC runtime on `x64` and `arm64`.\n- Require explicit acceptance through `--repo_env=BAZEL_MSVC_RUNTIME_VISUAL_STUDIO_EULA=1` before materializing the MSVC runtime.\n- Preserve case-only SDK aliases when repositories created on case-insensitive Windows filesystems are consumed by case-sensitive remote executors.\n\nGitOrigin-RevId: c7a5278e87c5e7e25e9c5f60af3d99e19303b0fd","tree":{"sha":"9d9ea7ee5d18a647454a78521f344870327a1fe4","url":"https://api.github.com/repos/openai/codex/git/trees/9d9ea7ee5d18a647454a78521f344870327a1fe4"},"url":"https://api.github.com/repos/openai/codex/git/commits/92912d6d84e567f8fc921c0b7c429abff182b004","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/92912d6d84e567f8fc921c0b7c429abff182b004","html_url":"https://github.com/openai/codex/commit/92912d6d84e567f8fc921c0b7c429abff182b004","comments_url":"https://api.github.com/repos/openai/codex/commits/92912d6d84e567f8fc921c0b7c429abff182b004/comments","author":{"login":"seanh-oai","id":309889850,"node_id":"U_kgDOEniLOg","avatar_url":"https://avatars.githubusercontent.com/u/309889850?v=4","gravatar_id":"","url":"https://api.github.com/users/seanh-oai","html_url":"https://github.com/seanh-oai","followers_url":"https://api.github.com/users/seanh-oai/followers","following_url":"https://api.github.com/users/seanh-oai/following{/other_user}","gists_url":"https://api.github.com/users/seanh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/seanh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/seanh-oai/subscriptions","organizations_url":"https://api.github.com/users/seanh-oai/orgs","repos_url":"https://api.github.com/users/seanh-oai/repos","events_url":"https://api.github.com/users/seanh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/seanh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"9e301c8c9a38a867ec16395e89c1d2e7c514850b","url":"https://api.github.com/repos/openai/codex/commits/9e301c8c9a38a867ec16395e89c1d2e7c514850b","html_url":"https://github.com/openai/codex/commit/9e301c8c9a38a867ec16395e89c1d2e7c514850b"}]},{"sha":"9e301c8c9a38a867ec16395e89c1d2e7c514850b","node_id":"C_kwDOOYsS4doAKDllMzAxYzhjOWEzOGE4NjdlYzE2Mzk1ZTg5YzFkMmU3YzUxNDg1MGI","commit":{"author":{"name":"knittel-openai","email":"153027209+knittel-openai@users.noreply.github.com","date":"2026-08-10T22:51:10Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T22:58:53Z"},"message":"Add configurable Responses API request metadata (#37895)\n\n## What changed\n\n- Add `responses_api_metadata` for product-owned key/value metadata included in\n  every Responses API turn metadata payload, including parent and subagent\n  requests.\n- Limit the map to 16 entries, ASCII identifier keys of at most 64 bytes, and\n  values of at most 128 bytes. Reject reserved Codex metadata keys and ignore\n  this setting in project-local configuration.\n- Give configured product metadata precedence over app-server client metadata\n  while keeping it out of metadata sent to external MCP servers.\n\n## Testing\n\n- Cover reserved-key validation, metadata precedence, MCP isolation, and\n  propagation to parent and subagent Responses API requests.\n\nGitOrigin-RevId: a7be798294fde25145ab375a468321bb4e4a49f1","tree":{"sha":"d50b4edb366ad2e4a20f11a40b8e070dd84909e0","url":"https://api.github.com/repos/openai/codex/git/trees/d50b4edb366ad2e4a20f11a40b8e070dd84909e0"},"url":"https://api.github.com/repos/openai/codex/git/commits/9e301c8c9a38a867ec16395e89c1d2e7c514850b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/9e301c8c9a38a867ec16395e89c1d2e7c514850b","html_url":"https://github.com/openai/codex/commit/9e301c8c9a38a867ec16395e89c1d2e7c514850b","comments_url":"https://api.github.com/repos/openai/codex/commits/9e301c8c9a38a867ec16395e89c1d2e7c514850b/comments","author":{"login":"knittel-openai","id":153027209,"node_id":"U_kgDOCR8CiQ","avatar_url":"https://avatars.githubusercontent.com/u/153027209?v=4","gravatar_id":"","url":"https://api.github.com/users/knittel-openai","html_url":"https://github.com/knittel-openai","followers_url":"https://api.github.com/users/knittel-openai/followers","following_url":"https://api.github.com/users/knittel-openai/following{/other_user}","gists_url":"https://api.github.com/users/knittel-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/knittel-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/knittel-openai/subscriptions","organizations_url":"https://api.github.com/users/knittel-openai/orgs","repos_url":"https://api.github.com/users/knittel-openai/repos","events_url":"https://api.github.com/users/knittel-openai/events{/privacy}","received_events_url":"https://api.github.com/users/knittel-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"7a18a5c5285abb499da0c7c4e9c92ce67d39b4a1","url":"https://api.github.com/repos/openai/codex/commits/7a18a5c5285abb499da0c7c4e9c92ce67d39b4a1","html_url":"https://github.com/openai/codex/commit/7a18a5c5285abb499da0c7c4e9c92ce67d39b4a1"}]},{"sha":"7a18a5c5285abb499da0c7c4e9c92ce67d39b4a1","node_id":"C_kwDOOYsS4doAKDdhMThhNWM1Mjg1YWJiNDk5ZGEwYzdjNGU5YzkyY2U2N2QzOWI0YTE","commit":{"author":{"name":"Vivian Fang","email":"vivian@openai.com","date":"2026-08-10T22:34:22Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T22:43:47Z"},"message":"Validate images before returning `view_image` output (#37892)\n\n## What changed\n\n- Decode image data in the `view_image` handler and return a clear error for invalid or unsupported input.\n- Re-encode code-mode images as PNG pixel data while preserving original image bytes for direct tool calls.\n- Cover code-mode PNG output and rejection of invalid image data.\n\nGitOrigin-RevId: 0a00e595ab749c19eab866a22f6577b6627e19f1","tree":{"sha":"3137ae2d16befba7ba52de11edc3c16b9313813e","url":"https://api.github.com/repos/openai/codex/git/trees/3137ae2d16befba7ba52de11edc3c16b9313813e"},"url":"https://api.github.com/repos/openai/codex/git/commits/7a18a5c5285abb499da0c7c4e9c92ce67d39b4a1","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/7a18a5c5285abb499da0c7c4e9c92ce67d39b4a1","html_url":"https://github.com/openai/codex/commit/7a18a5c5285abb499da0c7c4e9c92ce67d39b4a1","comments_url":"https://api.github.com/repos/openai/codex/commits/7a18a5c5285abb499da0c7c4e9c92ce67d39b4a1/comments","author":{"login":"vivi","id":5145763,"node_id":"MDQ6VXNlcjUxNDU3NjM=","avatar_url":"https://avatars.githubusercontent.com/u/5145763?v=4","gravatar_id":"","url":"https://api.github.com/users/vivi","html_url":"https://github.com/vivi","followers_url":"https://api.github.com/users/vivi/followers","following_url":"https://api.github.com/users/vivi/following{/other_user}","gists_url":"https://api.github.com/users/vivi/gists{/gist_id}","starred_url":"https://api.github.com/users/vivi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vivi/subscriptions","organizations_url":"https://api.github.com/users/vivi/orgs","repos_url":"https://api.github.com/users/vivi/repos","events_url":"https://api.github.com/users/vivi/events{/privacy}","received_events_url":"https://api.github.com/users/vivi/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"7f928f6ddc4310752122c51c6a80b233e0c3e85a","url":"https://api.github.com/repos/openai/codex/commits/7f928f6ddc4310752122c51c6a80b233e0c3e85a","html_url":"https://github.com/openai/codex/commit/7f928f6ddc4310752122c51c6a80b233e0c3e85a"}]},{"sha":"7f928f6ddc4310752122c51c6a80b233e0c3e85a","node_id":"C_kwDOOYsS4doAKDdmOTI4ZjZkZGM0MzEwNzUyMTIyYzUxYzZhODBiMjMzZTBjM2U4NWE","commit":{"author":{"name":"Matthew Zeng","email":"mzeng@openai.com","date":"2026-08-10T22:29:25Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T22:39:29Z"},"message":"Use thread configuration for `app/read` (#37891)\n\n## What changed\n\n- Add an optional `threadId` parameter to `app/read`.\n- When provided, load the thread's effective configuration before applying app feature gating, workspace policy, and plugin attribution.\n- Share the thread-aware configuration loader with `app/list`.\n\n## Testing\n\n- Add coverage showing that `app/read` honors a thread-level connector feature override.\n\nGitOrigin-RevId: 161e910a2d7435ecf4acd0ba9f5f5069d1631f12","tree":{"sha":"b972a1e2b6cf1268b74d500bbdf97bf40acdbc35","url":"https://api.github.com/repos/openai/codex/git/trees/b972a1e2b6cf1268b74d500bbdf97bf40acdbc35"},"url":"https://api.github.com/repos/openai/codex/git/commits/7f928f6ddc4310752122c51c6a80b233e0c3e85a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/7f928f6ddc4310752122c51c6a80b233e0c3e85a","html_url":"https://github.com/openai/codex/commit/7f928f6ddc4310752122c51c6a80b233e0c3e85a","comments_url":"https://api.github.com/repos/openai/codex/commits/7f928f6ddc4310752122c51c6a80b233e0c3e85a/comments","author":{"login":"mzeng-openai","id":175741029,"node_id":"U_kgDOCnmYZQ","avatar_url":"https://avatars.githubusercontent.com/u/175741029?v=4","gravatar_id":"","url":"https://api.github.com/users/mzeng-openai","html_url":"https://github.com/mzeng-openai","followers_url":"https://api.github.com/users/mzeng-openai/followers","following_url":"https://api.github.com/users/mzeng-openai/following{/other_user}","gists_url":"https://api.github.com/users/mzeng-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/mzeng-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mzeng-openai/subscriptions","organizations_url":"https://api.github.com/users/mzeng-openai/orgs","repos_url":"https://api.github.com/users/mzeng-openai/repos","events_url":"https://api.github.com/users/mzeng-openai/events{/privacy}","received_events_url":"https://api.github.com/users/mzeng-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"9742cc8ed5def37a4575263733f70a01ca22047b","url":"https://api.github.com/repos/openai/codex/commits/9742cc8ed5def37a4575263733f70a01ca22047b","html_url":"https://github.com/openai/codex/commit/9742cc8ed5def37a4575263733f70a01ca22047b"}]},{"sha":"9742cc8ed5def37a4575263733f70a01ca22047b","node_id":"C_kwDOOYsS4doAKDk3NDJjYzhlZDVkZWYzN2E0NTc1MjYzNzMzZjcwYTAxY2EyMjA0N2I","commit":{"author":{"name":"viyatb-oai","email":"viyatb@openai.com","date":"2026-08-10T22:15:17Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T22:28:15Z"},"message":"Ignore Unix socket proxy settings on Windows (#37889)\n\n## Why\n\nUnix socket proxy permissions are macOS-only, but configuring them could still\nclamp Windows proxy listeners to loopback and emit warnings about unsupported\nsettings.\n\n## What changed\n\n- Exclude Unix socket permissions from Windows runtime settings and bind-address\n  clamping.\n- Suppress the macOS-only Unix socket warning on Windows.\n- Preserve the original configuration for state updates and remote launch\n  configuration.\n\n## Testing\n\nAdd coverage for proxy startup, live configuration replacement, remote launch\nconfiguration, and warning behavior with Unix socket permissions configured.\n\nGitOrigin-RevId: 5d72f5365486ab11ae3cf5edfd78da665e05344d","tree":{"sha":"6d25f81c0ca04a8baabfa2f36034b28db20fe2f6","url":"https://api.github.com/repos/openai/codex/git/trees/6d25f81c0ca04a8baabfa2f36034b28db20fe2f6"},"url":"https://api.github.com/repos/openai/codex/git/commits/9742cc8ed5def37a4575263733f70a01ca22047b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/9742cc8ed5def37a4575263733f70a01ca22047b","html_url":"https://github.com/openai/codex/commit/9742cc8ed5def37a4575263733f70a01ca22047b","comments_url":"https://api.github.com/repos/openai/codex/commits/9742cc8ed5def37a4575263733f70a01ca22047b/comments","author":{"login":"viyatb-oai","id":234056686,"node_id":"U_kgDODfNr7g","avatar_url":"https://avatars.githubusercontent.com/u/234056686?v=4","gravatar_id":"","url":"https://api.github.com/users/viyatb-oai","html_url":"https://github.com/viyatb-oai","followers_url":"https://api.github.com/users/viyatb-oai/followers","following_url":"https://api.github.com/users/viyatb-oai/following{/other_user}","gists_url":"https://api.github.com/users/viyatb-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/viyatb-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/viyatb-oai/subscriptions","organizations_url":"https://api.github.com/users/viyatb-oai/orgs","repos_url":"https://api.github.com/users/viyatb-oai/repos","events_url":"https://api.github.com/users/viyatb-oai/events{/privacy}","received_events_url":"https://api.github.com/users/viyatb-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"cc2f2620330116b961c87430d9fdaa16d948d3bf","url":"https://api.github.com/repos/openai/codex/commits/cc2f2620330116b961c87430d9fdaa16d948d3bf","html_url":"https://github.com/openai/codex/commit/cc2f2620330116b961c87430d9fdaa16d948d3bf"}]},{"sha":"cc2f2620330116b961c87430d9fdaa16d948d3bf","node_id":"C_kwDOOYsS4doAKGNjMmYyNjIwMzMwMTE2Yjk2MWM4NzQzMGQ5ZmRhYTE2ZDk0OGQzYmY","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-08-10T22:06:38Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T22:12:14Z"},"message":"Extend bundled package discovery and expose its version (#37886)\n\n## What changed\n\n- Recognize executables under `codex-resources/` as part of a package layout by resolving the sibling `bin/` directory, while requiring that directory to exist.\n- Add `InstallContext::package_manifest()` to parse the semantic package version from `codex-package.json`.\n\n## Testing\n\n- Extend the package-layout test fixture with a complete manifest and verify that version `1.2.3` is returned.\n\nGitOrigin-RevId: 034aad3e8b865c6c6ecdff47da7c12c969744404","tree":{"sha":"fe6ebe77aac7ef880fe931fba86af958fe0b7603","url":"https://api.github.com/repos/openai/codex/git/trees/fe6ebe77aac7ef880fe931fba86af958fe0b7603"},"url":"https://api.github.com/repos/openai/codex/git/commits/cc2f2620330116b961c87430d9fdaa16d948d3bf","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/cc2f2620330116b961c87430d9fdaa16d948d3bf","html_url":"https://github.com/openai/codex/commit/cc2f2620330116b961c87430d9fdaa16d948d3bf","comments_url":"https://api.github.com/repos/openai/codex/commits/cc2f2620330116b961c87430d9fdaa16d948d3bf/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"9558d830f632407349227a3a3d4e1bda9b173e0b","url":"https://api.github.com/repos/openai/codex/commits/9558d830f632407349227a3a3d4e1bda9b173e0b","html_url":"https://github.com/openai/codex/commit/9558d830f632407349227a3a3d4e1bda9b173e0b"}]},{"sha":"9558d830f632407349227a3a3d4e1bda9b173e0b","node_id":"C_kwDOOYsS4doAKDk1NThkODMwZjYzMjQwNzM0OTIyN2EzYTNkNGUxYmRhOWIxNzNlMGI","commit":{"author":{"name":"ftoddywala","email":"ftoddywala@openai.com","date":"2026-08-10T21:45:02Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T21:50:55Z"},"message":"Read safety buffering from response metadata (#37882)\n\n## What changed\n\n- Parse safety-buffering payloads from typed `response.metadata` SSE events.\n- Preserve the existing top-level `safety_buffering` field as the authoritative value when it is present, including when it is null or malformed.\n- Continue applying the header-provided fallback model when the metadata payload omits `retry_model`.\n\n## Testing\n\n- Add parser coverage for metadata fallback, top-level precedence, and unrelated metadata events.\n- Exercise metadata-based safety-buffering delivery through the core SSE integration test.\n\nGitOrigin-RevId: 7dadfd54be28f2f33c2283de92fd49da0557d98a","tree":{"sha":"d0dc4c878400183fcde66b2fb6de218ce7874a17","url":"https://api.github.com/repos/openai/codex/git/trees/d0dc4c878400183fcde66b2fb6de218ce7874a17"},"url":"https://api.github.com/repos/openai/codex/git/commits/9558d830f632407349227a3a3d4e1bda9b173e0b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/9558d830f632407349227a3a3d4e1bda9b173e0b","html_url":"https://github.com/openai/codex/commit/9558d830f632407349227a3a3d4e1bda9b173e0b","comments_url":"https://api.github.com/repos/openai/codex/commits/9558d830f632407349227a3a3d4e1bda9b173e0b/comments","author":{"login":"ftoddywala","id":274331736,"node_id":"U_kgDOEFn4WA","avatar_url":"https://avatars.githubusercontent.com/u/274331736?v=4","gravatar_id":"","url":"https://api.github.com/users/ftoddywala","html_url":"https://github.com/ftoddywala","followers_url":"https://api.github.com/users/ftoddywala/followers","following_url":"https://api.github.com/users/ftoddywala/following{/other_user}","gists_url":"https://api.github.com/users/ftoddywala/gists{/gist_id}","starred_url":"https://api.github.com/users/ftoddywala/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ftoddywala/subscriptions","organizations_url":"https://api.github.com/users/ftoddywala/orgs","repos_url":"https://api.github.com/users/ftoddywala/repos","events_url":"https://api.github.com/users/ftoddywala/events{/privacy}","received_events_url":"https://api.github.com/users/ftoddywala/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a9dee37f9c62519e49a42c5bf1fb683f7bf750de","url":"https://api.github.com/repos/openai/codex/commits/a9dee37f9c62519e49a42c5bf1fb683f7bf750de","html_url":"https://github.com/openai/codex/commit/a9dee37f9c62519e49a42c5bf1fb683f7bf750de"}]},{"sha":"a9dee37f9c62519e49a42c5bf1fb683f7bf750de","node_id":"C_kwDOOYsS4doAKGE5ZGVlMzdmOWM2MjUxOWU0OWE0MmM1YmYxZmI2ODNmN2JmNzUwZGU","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-10T20:34:14Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T21:00:00Z"},"message":"Add configurable goal token budget limits (#37878)\n\n## What changed\n\n- Add `goals.max_goal_token_budget` as a positive-integer configuration setting.\n- Use the configured maximum as the default budget for new goals and when `tokenBudget` is reset to `null`.\n- Reject goal creation and updates whose token budget exceeds the configured maximum, including requests through goal tools and `thread/goal/set`.\n- Respect managed configuration precedence and per-thread configuration overrides.\n\n## Testing\n\n- Cover configuration parsing and managed overrides.\n- Cover defaulting, resetting, and rejecting oversized budgets through the goal service, goal tools, and app-server API.\n\nGitOrigin-RevId: f8d7e6418cdc237d454c8cf47bb32ba0d44a60cf","tree":{"sha":"0e38b4d859896ab1d089b5da547ee584a6d28aea","url":"https://api.github.com/repos/openai/codex/git/trees/0e38b4d859896ab1d089b5da547ee584a6d28aea"},"url":"https://api.github.com/repos/openai/codex/git/commits/a9dee37f9c62519e49a42c5bf1fb683f7bf750de","comment_count":2,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a9dee37f9c62519e49a42c5bf1fb683f7bf750de","html_url":"https://github.com/openai/codex/commit/a9dee37f9c62519e49a42c5bf1fb683f7bf750de","comments_url":"https://api.github.com/repos/openai/codex/commits/a9dee37f9c62519e49a42c5bf1fb683f7bf750de/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a603d7ca5c0fc5f965abfba09366ae5fb091350e","url":"https://api.github.com/repos/openai/codex/commits/a603d7ca5c0fc5f965abfba09366ae5fb091350e","html_url":"https://github.com/openai/codex/commit/a603d7ca5c0fc5f965abfba09366ae5fb091350e"}]},{"sha":"a603d7ca5c0fc5f965abfba09366ae5fb091350e","node_id":"C_kwDOOYsS4doAKGE2MDNkN2NhNWMwZmM1Zjk2NWFiZmJhMDkzNjZhZTVmYjA5MTM1MGU","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-08-10T19:48:41Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T19:57:40Z"},"message":"Honor the configured Windows sandbox level for managed networking (#37875)\n\n## Why\n\nManaged networking implicitly selected the elevated Windows sandbox backend,\neven when the sandbox was configured to use a restricted token.\n\n## What changed\n\n- Select the Windows sandbox backend solely from `WindowsSandboxLevel`.\n- Reject managed networking with a restricted-token sandbox before spawning a\n  process, since managed networking requires the elevated backend.\n- Cover the rejection through sandbox preparation, unified exec, and Windows\n  sandbox session tests.\n\nGitOrigin-RevId: 308858652d7b629af623d22896dafde3a23d3758","tree":{"sha":"baae4a9853764918ed354bbe55ccc507632b5a23","url":"https://api.github.com/repos/openai/codex/git/trees/baae4a9853764918ed354bbe55ccc507632b5a23"},"url":"https://api.github.com/repos/openai/codex/git/commits/a603d7ca5c0fc5f965abfba09366ae5fb091350e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a603d7ca5c0fc5f965abfba09366ae5fb091350e","html_url":"https://github.com/openai/codex/commit/a603d7ca5c0fc5f965abfba09366ae5fb091350e","comments_url":"https://api.github.com/repos/openai/codex/commits/a603d7ca5c0fc5f965abfba09366ae5fb091350e/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"46f5d6eba91e8b0702975bb7461793e433094a6b","url":"https://api.github.com/repos/openai/codex/commits/46f5d6eba91e8b0702975bb7461793e433094a6b","html_url":"https://github.com/openai/codex/commit/46f5d6eba91e8b0702975bb7461793e433094a6b"}]},{"sha":"46f5d6eba91e8b0702975bb7461793e433094a6b","node_id":"C_kwDOOYsS4doAKDQ2ZjVkNmViYTkxZThiMDcwMjk3NWJiNzQ2MTc5M2U0MzMwOTRhNmI","commit":{"author":{"name":"pradeepg-oai","email":"pradeepg@openai.com","date":"2026-08-10T19:44:10Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T19:53:01Z"},"message":"Keep runtime summary metrics out of Statsig exports (#37874)\n\n## What changed\n\n- Exclude conversation turn count, response-engine latency, and turn token usage metrics from the built-in Statsig exporter, alongside the existing API and tool-call exclusions.\n- Apply the Statsig exclusion list consistently to counters, histograms, gauges, observable gauges, and duration histograms.\n- Preserve all excluded metrics for custom OTLP exporters and extend the loopback coverage to verify they are exported.\n\nGitOrigin-RevId: e49f9aa1433126a3de8dbed76a4d2688f2831af8","tree":{"sha":"bed32dc2e288b7e1eafc8ce5ac508c927f63fd75","url":"https://api.github.com/repos/openai/codex/git/trees/bed32dc2e288b7e1eafc8ce5ac508c927f63fd75"},"url":"https://api.github.com/repos/openai/codex/git/commits/46f5d6eba91e8b0702975bb7461793e433094a6b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/46f5d6eba91e8b0702975bb7461793e433094a6b","html_url":"https://github.com/openai/codex/commit/46f5d6eba91e8b0702975bb7461793e433094a6b","comments_url":"https://api.github.com/repos/openai/codex/commits/46f5d6eba91e8b0702975bb7461793e433094a6b/comments","author":{"login":"pradeepg-oai","id":263820970,"node_id":"U_kgDOD7mWqg","avatar_url":"https://avatars.githubusercontent.com/u/263820970?v=4","gravatar_id":"","url":"https://api.github.com/users/pradeepg-oai","html_url":"https://github.com/pradeepg-oai","followers_url":"https://api.github.com/users/pradeepg-oai/followers","following_url":"https://api.github.com/users/pradeepg-oai/following{/other_user}","gists_url":"https://api.github.com/users/pradeepg-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/pradeepg-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pradeepg-oai/subscriptions","organizations_url":"https://api.github.com/users/pradeepg-oai/orgs","repos_url":"https://api.github.com/users/pradeepg-oai/repos","events_url":"https://api.github.com/users/pradeepg-oai/events{/privacy}","received_events_url":"https://api.github.com/users/pradeepg-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"63002bdb26c939925f3fa59b9575cc0a3564cb45","url":"https://api.github.com/repos/openai/codex/commits/63002bdb26c939925f3fa59b9575cc0a3564cb45","html_url":"https://github.com/openai/codex/commit/63002bdb26c939925f3fa59b9575cc0a3564cb45"}]},{"sha":"63002bdb26c939925f3fa59b9575cc0a3564cb45","node_id":"C_kwDOOYsS4doAKDYzMDAyYmRiMjZjOTM5OTI1ZjNmYTU5Yjk1NzVjYzBhMzU2NGNiNDU","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-08-10T19:21:33Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T19:26:52Z"},"message":"Extract persisted history types into a dedicated crate (#37871)\n\n## What changed\n\n- Add `codex-history` for model-history and persisted-rollout domain types, including `RolloutItem`, `RolloutLine`, `CompactedItem`, and initial/resumed history state.\n- Re-export the persisted types from `codex-rollout` and update consumers to use the new crate boundary instead of `codex-protocol`.\n- Preserve existing rollout serialization, including legacy numeric compacted-window IDs.\n\n## Testing\n\n- Add `codex-history` tests for rollout JSON round trips, compacted-history compatibility, persisted history modes, and multi-agent version selection.\n\nGitOrigin-RevId: 944daa9297ddd231d3aebbdcb05fff4adf8b4e1b","tree":{"sha":"e6581e5a00796a87bdd4012071044a3d1150cb4f","url":"https://api.github.com/repos/openai/codex/git/trees/e6581e5a00796a87bdd4012071044a3d1150cb4f"},"url":"https://api.github.com/repos/openai/codex/git/commits/63002bdb26c939925f3fa59b9575cc0a3564cb45","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/63002bdb26c939925f3fa59b9575cc0a3564cb45","html_url":"https://github.com/openai/codex/commit/63002bdb26c939925f3fa59b9575cc0a3564cb45","comments_url":"https://api.github.com/repos/openai/codex/commits/63002bdb26c939925f3fa59b9575cc0a3564cb45/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a1c88e865dbf08c7767f828448b8f8efc7f3bb9c","url":"https://api.github.com/repos/openai/codex/commits/a1c88e865dbf08c7767f828448b8f8efc7f3bb9c","html_url":"https://github.com/openai/codex/commit/a1c88e865dbf08c7767f828448b8f8efc7f3bb9c"}]},{"sha":"a1c88e865dbf08c7767f828448b8f8efc7f3bb9c","node_id":"C_kwDOOYsS4doAKGExYzg4ZTg2NWRiZjA4Yzc3NjdmODI4NDQ4YjhmOGVmYzdmM2JiOWM","commit":{"author":{"name":"viyatb-oai","email":"viyatb@openai.com","date":"2026-08-10T18:36:16Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T18:44:58Z"},"message":"Reject duplicate resolved paths in apply_patch (#37867)\n\n## What changed\n\n- Reject patches containing multiple operations whose paths resolve to the same file, such as `duplicate.txt` and `./duplicate.txt`.\n- Preserve support for patches that update multiple distinct files.\n\n## Testing\n\n- Add CLI integration coverage for distinct updates and duplicate resolved paths.\n\nGitOrigin-RevId: 0fb7f69ae31acc5c677268ffd9e38ad8d8314276","tree":{"sha":"9531d3f35ac8150d97d1d55826590ad753076f05","url":"https://api.github.com/repos/openai/codex/git/trees/9531d3f35ac8150d97d1d55826590ad753076f05"},"url":"https://api.github.com/repos/openai/codex/git/commits/a1c88e865dbf08c7767f828448b8f8efc7f3bb9c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a1c88e865dbf08c7767f828448b8f8efc7f3bb9c","html_url":"https://github.com/openai/codex/commit/a1c88e865dbf08c7767f828448b8f8efc7f3bb9c","comments_url":"https://api.github.com/repos/openai/codex/commits/a1c88e865dbf08c7767f828448b8f8efc7f3bb9c/comments","author":{"login":"viyatb-oai","id":234056686,"node_id":"U_kgDODfNr7g","avatar_url":"https://avatars.githubusercontent.com/u/234056686?v=4","gravatar_id":"","url":"https://api.github.com/users/viyatb-oai","html_url":"https://github.com/viyatb-oai","followers_url":"https://api.github.com/users/viyatb-oai/followers","following_url":"https://api.github.com/users/viyatb-oai/following{/other_user}","gists_url":"https://api.github.com/users/viyatb-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/viyatb-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/viyatb-oai/subscriptions","organizations_url":"https://api.github.com/users/viyatb-oai/orgs","repos_url":"https://api.github.com/users/viyatb-oai/repos","events_url":"https://api.github.com/users/viyatb-oai/events{/privacy}","received_events_url":"https://api.github.com/users/viyatb-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"dd22460869a9649219900d7c099d8cd4e70124b2","url":"https://api.github.com/repos/openai/codex/commits/dd22460869a9649219900d7c099d8cd4e70124b2","html_url":"https://github.com/openai/codex/commit/dd22460869a9649219900d7c099d8cd4e70124b2"}]},{"sha":"dd22460869a9649219900d7c099d8cd4e70124b2","node_id":"C_kwDOOYsS4doAKGRkMjI0NjA4NjlhOTY0OTIxOTkwMGQ3YzA5OWQ4Y2Q0ZTcwMTI0YjI","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-10T18:33:37Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T18:40:02Z"},"message":"Add MCP OAuth credential contention regression tests (#37866)\n\n## What changed\n\n- Cover non-blocking credential probes when the file or secrets store is locked, including retaining only a matching prior credential snapshot and recovering after the lock is released.\n- Extend the streamable HTTP OAuth round trip to verify that user turns continue during store contention, newly discovered servers recover after contention, and logged-out servers do not reuse authenticated connections.\n- Cover reconciliation of authentication failures and effective `Authorization` headers.\n\nGitOrigin-RevId: 8e377644001bd0be04dc9f79841080094d09d199","tree":{"sha":"051da8314938b892040451c1b76b9131d6d92e68","url":"https://api.github.com/repos/openai/codex/git/trees/051da8314938b892040451c1b76b9131d6d92e68"},"url":"https://api.github.com/repos/openai/codex/git/commits/dd22460869a9649219900d7c099d8cd4e70124b2","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/dd22460869a9649219900d7c099d8cd4e70124b2","html_url":"https://github.com/openai/codex/commit/dd22460869a9649219900d7c099d8cd4e70124b2","comments_url":"https://api.github.com/repos/openai/codex/commits/dd22460869a9649219900d7c099d8cd4e70124b2/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4b0e2a0bffcc9ca4781dd38e27032591d25e8996","url":"https://api.github.com/repos/openai/codex/commits/4b0e2a0bffcc9ca4781dd38e27032591d25e8996","html_url":"https://github.com/openai/codex/commit/4b0e2a0bffcc9ca4781dd38e27032591d25e8996"}]},{"sha":"4b0e2a0bffcc9ca4781dd38e27032591d25e8996","node_id":"C_kwDOOYsS4doAKDRiMGUyYTBiZmZjYzljYTQ3ODFkZDM4ZTI3MDMyNTkxZDI1ZTg5OTY","commit":{"author":{"name":"mchen-oai","email":"mchen@openai.com","date":"2026-08-10T18:01:20Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T18:20:12Z"},"message":"Support MCP form input in full-access user threads (#37864)\n\n## Why\n\nStandard MCP forms can require user-entered values even when tool permissions are\notherwise auto-approved in full-access sessions.\n\n## What changed\n\n- Recognize the `openai/standard-form-input` client extension and surface\n  non-approval forms in full-access, user-initiated root threads.\n- Keep approval forms, automation and subagent threads, headless sessions, and\n  clients without the capability on their existing decline or review paths.\n- Treat the capability as client-only so it is not advertised to MCP servers,\n  and enable it after session startup so required servers cannot block startup\n  waiting for form input.\n\n## Testing\n\nAdd unit and app-server coverage for accepted form round trips, declined cases,\napproval metadata safeguards, resumed threads, and extension filtering.\n\nGitOrigin-RevId: 053bfe397a5c79eceef90a81d13e2aca6353af43","tree":{"sha":"c21b0b77960cbc466683e343938e22298ededaab","url":"https://api.github.com/repos/openai/codex/git/trees/c21b0b77960cbc466683e343938e22298ededaab"},"url":"https://api.github.com/repos/openai/codex/git/commits/4b0e2a0bffcc9ca4781dd38e27032591d25e8996","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4b0e2a0bffcc9ca4781dd38e27032591d25e8996","html_url":"https://github.com/openai/codex/commit/4b0e2a0bffcc9ca4781dd38e27032591d25e8996","comments_url":"https://api.github.com/repos/openai/codex/commits/4b0e2a0bffcc9ca4781dd38e27032591d25e8996/comments","author":{"login":"mchen-oai","id":250037145,"node_id":"U_kgDODudDmQ","avatar_url":"https://avatars.githubusercontent.com/u/250037145?v=4","gravatar_id":"","url":"https://api.github.com/users/mchen-oai","html_url":"https://github.com/mchen-oai","followers_url":"https://api.github.com/users/mchen-oai/followers","following_url":"https://api.github.com/users/mchen-oai/following{/other_user}","gists_url":"https://api.github.com/users/mchen-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/mchen-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mchen-oai/subscriptions","organizations_url":"https://api.github.com/users/mchen-oai/orgs","repos_url":"https://api.github.com/users/mchen-oai/repos","events_url":"https://api.github.com/users/mchen-oai/events{/privacy}","received_events_url":"https://api.github.com/users/mchen-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"ee7815dad2328cb01cca117d13bc632ba0ec07ee","url":"https://api.github.com/repos/openai/codex/commits/ee7815dad2328cb01cca117d13bc632ba0ec07ee","html_url":"https://github.com/openai/codex/commit/ee7815dad2328cb01cca117d13bc632ba0ec07ee"}]},{"sha":"ee7815dad2328cb01cca117d13bc632ba0ec07ee","node_id":"C_kwDOOYsS4doAKGVlNzgxNWRhZDIzMjhjYjAxY2NhMTE3ZDEzYmM2MzJiYTBlYzA3ZWU","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-08-10T17:52:37Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T18:03:46Z"},"message":"Rename environment config for turn scope (#37862)\n\n## What changed\n\n- Rename `EnvironmentConfig` to `TurnEnvironmentConfig` to make its scope explicit.\n- Rename the corresponding `SessionConfiguration` accessor and update all call sites.\n\nGitOrigin-RevId: f47d745566199e699bd8e7c671c313eaf3bba79e","tree":{"sha":"91545021dc71554475665a559ea50e4b78bf6d1f","url":"https://api.github.com/repos/openai/codex/git/trees/91545021dc71554475665a559ea50e4b78bf6d1f"},"url":"https://api.github.com/repos/openai/codex/git/commits/ee7815dad2328cb01cca117d13bc632ba0ec07ee","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/ee7815dad2328cb01cca117d13bc632ba0ec07ee","html_url":"https://github.com/openai/codex/commit/ee7815dad2328cb01cca117d13bc632ba0ec07ee","comments_url":"https://api.github.com/repos/openai/codex/commits/ee7815dad2328cb01cca117d13bc632ba0ec07ee/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"afcc95b4310b46210e42ad6b12f537c2ee066736","url":"https://api.github.com/repos/openai/codex/commits/afcc95b4310b46210e42ad6b12f537c2ee066736","html_url":"https://github.com/openai/codex/commit/afcc95b4310b46210e42ad6b12f537c2ee066736"}]},{"sha":"afcc95b4310b46210e42ad6b12f537c2ee066736","node_id":"C_kwDOOYsS4doAKGFmY2M5NWI0MzEwYjQ2MjEwZTQyYWQ2YjEyZjUzN2MyZWUwNjY3MzY","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-10T17:51:36Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T17:58:15Z"},"message":"Speed up MCP OAuth credential reads (#37860)\n\n## Why\n\nRefreshing MCP connection identities should not stall the async executor while another process holds the OAuth credential-store lock.\n\n## What changed\n\n- Probe file and secrets credential stores without waiting during runtime refreshes, retaining the last known credentials when the store is contended.\n- Reuse unchanged authentication failures while credentials are temporarily unavailable instead of restarting the connection.\n- Run blocking credential loads on a blocking worker during MCP client construction.\n- Allow OAuth fallback when a configured authorization header is missing, empty, or invalid.\n\nGitOrigin-RevId: 38dad5606da9a1ceb30fe945000ec9151a5058fa","tree":{"sha":"59fe5cbcab10009b0d359f44471bcf6e4bb17bf7","url":"https://api.github.com/repos/openai/codex/git/trees/59fe5cbcab10009b0d359f44471bcf6e4bb17bf7"},"url":"https://api.github.com/repos/openai/codex/git/commits/afcc95b4310b46210e42ad6b12f537c2ee066736","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/afcc95b4310b46210e42ad6b12f537c2ee066736","html_url":"https://github.com/openai/codex/commit/afcc95b4310b46210e42ad6b12f537c2ee066736","comments_url":"https://api.github.com/repos/openai/codex/commits/afcc95b4310b46210e42ad6b12f537c2ee066736/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"d06dc73290729d2bcb464b955a4cfd9992abc35d","url":"https://api.github.com/repos/openai/codex/commits/d06dc73290729d2bcb464b955a4cfd9992abc35d","html_url":"https://github.com/openai/codex/commit/d06dc73290729d2bcb464b955a4cfd9992abc35d"}]},{"sha":"d06dc73290729d2bcb464b955a4cfd9992abc35d","node_id":"C_kwDOOYsS4doAKGQwNmRjNzMyOTA3MjlkMmJjYjQ2NGI5NTVhNGNmZDk5OTJhYmMzNWQ","commit":{"author":{"name":"Dylan Hurd","email":"dylan.hurd@openai.com","date":"2026-08-10T17:19:17Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T17:24:51Z"},"message":"Route intercepted exec approvals through shared review (#37851)\n\n## What changed\n\n- Send Unix `execve` approvals intercepted by the zsh fork through the shared approval pipeline, including permission hooks, Guardian review, user prompts, and telemetry.\n- Resolve the active turn and its auto-review setting when an intercepted command needs approval, so commands sent to persistent terminals use the current turn's reviewer.\n- Give each intercepted command a distinct approval ID and propagate an aborted approval as a turn abort.\n\n## Testing\n\n- Cover Guardian review for intercepted `unified_exec` commands and persistent terminals across turns.\n- Verify repeated identical intercepted commands receive separate user approvals.\n\nGitOrigin-RevId: e6cccf160637e4246aff4714c22f08c90b65306d","tree":{"sha":"cac1bb4a4815e8471455ef5c1443eca877c5e503","url":"https://api.github.com/repos/openai/codex/git/trees/cac1bb4a4815e8471455ef5c1443eca877c5e503"},"url":"https://api.github.com/repos/openai/codex/git/commits/d06dc73290729d2bcb464b955a4cfd9992abc35d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/d06dc73290729d2bcb464b955a4cfd9992abc35d","html_url":"https://github.com/openai/codex/commit/d06dc73290729d2bcb464b955a4cfd9992abc35d","comments_url":"https://api.github.com/repos/openai/codex/commits/d06dc73290729d2bcb464b955a4cfd9992abc35d/comments","author":{"login":"dylan-hurd-oai","id":220976066,"node_id":"U_kgDODSvTwg","avatar_url":"https://avatars.githubusercontent.com/u/220976066?v=4","gravatar_id":"","url":"https://api.github.com/users/dylan-hurd-oai","html_url":"https://github.com/dylan-hurd-oai","followers_url":"https://api.github.com/users/dylan-hurd-oai/followers","following_url":"https://api.github.com/users/dylan-hurd-oai/following{/other_user}","gists_url":"https://api.github.com/users/dylan-hurd-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/dylan-hurd-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dylan-hurd-oai/subscriptions","organizations_url":"https://api.github.com/users/dylan-hurd-oai/orgs","repos_url":"https://api.github.com/users/dylan-hurd-oai/repos","events_url":"https://api.github.com/users/dylan-hurd-oai/events{/privacy}","received_events_url":"https://api.github.com/users/dylan-hurd-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"78d3665d1569b6b0cf227a8668a837f8d6c79aab","url":"https://api.github.com/repos/openai/codex/commits/78d3665d1569b6b0cf227a8668a837f8d6c79aab","html_url":"https://github.com/openai/codex/commit/78d3665d1569b6b0cf227a8668a837f8d6c79aab"}]},{"sha":"78d3665d1569b6b0cf227a8668a837f8d6c79aab","node_id":"C_kwDOOYsS4doAKDc4ZDM2NjVkMTU2OWI2YjBjZjIyN2E4NjY4YTgzN2Y4ZDZjNzlhYWI","commit":{"author":{"name":"victor-openai","email":"victor@openai.com","date":"2026-08-10T17:08:31Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T17:14:51Z"},"message":"Expose plugin ownership in MCP server status (#37850)\n\n## What changed\n\n- Add `pluginId` to each `mcpServerStatus/list` result.\n- Populate it for MCP servers contributed by installed or selected plugins, and\n  return `null` for servers from other sources.\n- Update the generated protocol schemas, TypeScript bindings, and app-server\n  documentation.\n\n## Testing\n\n- Cover plugin-owned servers in plugin installation and executor flows.\n- Verify non-plugin servers and protocol serialization return a null\n  `pluginId`.\n\nGitOrigin-RevId: 0e4b912252cf51be56dcb63e0c1c7365a5e870ee","tree":{"sha":"a3509546c925495a8295af1d1df9700ff031de66","url":"https://api.github.com/repos/openai/codex/git/trees/a3509546c925495a8295af1d1df9700ff031de66"},"url":"https://api.github.com/repos/openai/codex/git/commits/78d3665d1569b6b0cf227a8668a837f8d6c79aab","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/78d3665d1569b6b0cf227a8668a837f8d6c79aab","html_url":"https://github.com/openai/codex/commit/78d3665d1569b6b0cf227a8668a837f8d6c79aab","comments_url":"https://api.github.com/repos/openai/codex/commits/78d3665d1569b6b0cf227a8668a837f8d6c79aab/comments","author":{"login":"victor-openai","id":204937719,"node_id":"U_kgDODDcZ9w","avatar_url":"https://avatars.githubusercontent.com/u/204937719?v=4","gravatar_id":"","url":"https://api.github.com/users/victor-openai","html_url":"https://github.com/victor-openai","followers_url":"https://api.github.com/users/victor-openai/followers","following_url":"https://api.github.com/users/victor-openai/following{/other_user}","gists_url":"https://api.github.com/users/victor-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/victor-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/victor-openai/subscriptions","organizations_url":"https://api.github.com/users/victor-openai/orgs","repos_url":"https://api.github.com/users/victor-openai/repos","events_url":"https://api.github.com/users/victor-openai/events{/privacy}","received_events_url":"https://api.github.com/users/victor-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"97729885d4707a123db31ae80f5fb0eeda6b7706","url":"https://api.github.com/repos/openai/codex/commits/97729885d4707a123db31ae80f5fb0eeda6b7706","html_url":"https://github.com/openai/codex/commit/97729885d4707a123db31ae80f5fb0eeda6b7706"}]},{"sha":"97729885d4707a123db31ae80f5fb0eeda6b7706","node_id":"C_kwDOOYsS4doAKDk3NzI5ODg1ZDQ3MDdhMTIzZGIzMWFlODBmNWZiMGVlZGE2Yjc3MDY","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-10T16:55:47Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T17:02:19Z"},"message":"Expose the session ID to shell commands (#37848)\n\n## What changed\n\n- Set `CODEX_SESSION_ID` to the shared root-session ID for shell tool calls,\n  unified exec processes, and user shell commands.\n- Preserve `CODEX_SESSION_ID` when restoring a shell snapshot, alongside the\n  existing runtime-owned environment variables.\n\nGitOrigin-RevId: 5228867d25507105c7edf11607a8298958c3b917","tree":{"sha":"35a41b38c3aa33109231ae68e3518108e14f6df7","url":"https://api.github.com/repos/openai/codex/git/trees/35a41b38c3aa33109231ae68e3518108e14f6df7"},"url":"https://api.github.com/repos/openai/codex/git/commits/97729885d4707a123db31ae80f5fb0eeda6b7706","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/97729885d4707a123db31ae80f5fb0eeda6b7706","html_url":"https://github.com/openai/codex/commit/97729885d4707a123db31ae80f5fb0eeda6b7706","comments_url":"https://api.github.com/repos/openai/codex/commits/97729885d4707a123db31ae80f5fb0eeda6b7706/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4996cf05af6e96e03d0d997681e7db85bce04deb","url":"https://api.github.com/repos/openai/codex/commits/4996cf05af6e96e03d0d997681e7db85bce04deb","html_url":"https://github.com/openai/codex/commit/4996cf05af6e96e03d0d997681e7db85bce04deb"}]},{"sha":"4996cf05af6e96e03d0d997681e7db85bce04deb","node_id":"C_kwDOOYsS4doAKDQ5OTZjZjA1YWY2ZTk2ZTAzZDBkOTk3NjgxZTdkYjg1YmNlMDRkZWI","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-10T16:41:44Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T16:57:09Z"},"message":"Preserve environments when reloading V2 agents (#37847)\n\n## What changed\n\n- Restore a V2 agent's inherited environment selections when reloading its\n  thread after residency eviction.\n- Keep the restored execution environment and its tools available when the\n  agent receives a follow-up task.\n\n## Testing\n\n- Add an integration test that evicts and reloads a V2 agent, then verifies\n  its environment selection and `exec_command` tool are preserved.\n\nGitOrigin-RevId: a5d4ad0fa465c717b32b7ae6807486429187a41d","tree":{"sha":"6624d249d055718bb2ef3696283444436c43e040","url":"https://api.github.com/repos/openai/codex/git/trees/6624d249d055718bb2ef3696283444436c43e040"},"url":"https://api.github.com/repos/openai/codex/git/commits/4996cf05af6e96e03d0d997681e7db85bce04deb","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4996cf05af6e96e03d0d997681e7db85bce04deb","html_url":"https://github.com/openai/codex/commit/4996cf05af6e96e03d0d997681e7db85bce04deb","comments_url":"https://api.github.com/repos/openai/codex/commits/4996cf05af6e96e03d0d997681e7db85bce04deb/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"92cbfb4d2431bdc53dc03507aea2dc5b8e932e40","url":"https://api.github.com/repos/openai/codex/commits/92cbfb4d2431bdc53dc03507aea2dc5b8e932e40","html_url":"https://github.com/openai/codex/commit/92cbfb4d2431bdc53dc03507aea2dc5b8e932e40"}]},{"sha":"92cbfb4d2431bdc53dc03507aea2dc5b8e932e40","node_id":"C_kwDOOYsS4doAKDkyY2JmYjRkMjQzMWJkYzUzZGMwMzUwN2FlYTJkYzViOGU5MzJlNDA","commit":{"author":{"name":"cooper-oai","email":"cooper@openai.com","date":"2026-08-10T15:43:25Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T15:50:53Z"},"message":"Use the shared environment scrubber in git-utils (#37843)\n\nCall `scrub_non_inheritable_env_vars` directly from each Git command path and\nremove the redundant crate-local forwarding helper.\n\nGitOrigin-RevId: 9e4125dc538ea888626bde3cb3646a90712206a2","tree":{"sha":"61d23e1f6aa3392cd8e1e8c71c5951e56103aeb9","url":"https://api.github.com/repos/openai/codex/git/trees/61d23e1f6aa3392cd8e1e8c71c5951e56103aeb9"},"url":"https://api.github.com/repos/openai/codex/git/commits/92cbfb4d2431bdc53dc03507aea2dc5b8e932e40","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/92cbfb4d2431bdc53dc03507aea2dc5b8e932e40","html_url":"https://github.com/openai/codex/commit/92cbfb4d2431bdc53dc03507aea2dc5b8e932e40","comments_url":"https://api.github.com/repos/openai/codex/commits/92cbfb4d2431bdc53dc03507aea2dc5b8e932e40/comments","author":{"login":"cooper-oai","id":242064477,"node_id":"U_kgDODm2cXQ","avatar_url":"https://avatars.githubusercontent.com/u/242064477?v=4","gravatar_id":"","url":"https://api.github.com/users/cooper-oai","html_url":"https://github.com/cooper-oai","followers_url":"https://api.github.com/users/cooper-oai/followers","following_url":"https://api.github.com/users/cooper-oai/following{/other_user}","gists_url":"https://api.github.com/users/cooper-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/cooper-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cooper-oai/subscriptions","organizations_url":"https://api.github.com/users/cooper-oai/orgs","repos_url":"https://api.github.com/users/cooper-oai/repos","events_url":"https://api.github.com/users/cooper-oai/events{/privacy}","received_events_url":"https://api.github.com/users/cooper-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"8b1b065719103f5c5a1bdd8b6a95354a72b06d97","url":"https://api.github.com/repos/openai/codex/commits/8b1b065719103f5c5a1bdd8b6a95354a72b06d97","html_url":"https://github.com/openai/codex/commit/8b1b065719103f5c5a1bdd8b6a95354a72b06d97"}]},{"sha":"8b1b065719103f5c5a1bdd8b6a95354a72b06d97","node_id":"C_kwDOOYsS4doAKDhiMWIwNjU3MTkxMDNmNWM1YTFiZGQ4YjZhOTUzNTRhNzJiMDZkOTc","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-08-10T15:34:35Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T15:43:10Z"},"message":"Speed up MCP OAuth credential reads (#37842)\n\n## Why\n\nConcurrent MCP startup and status checks should not serialize when they only read the shared credential store. Repeated reads of the encrypted MCP OAuth store also needlessly decrypted unchanged contents.\n\n## What changed\n\n- Use shared locks for `File` and `Secrets` credential reads while keeping saves and deletes exclusive.\n- Cache decrypted MCP OAuth secrets by store path, ciphertext, and passphrase, and invalidate the cache after writes.\n\n## Testing\n\n- Cover concurrent readers, reader/writer exclusion, shared credential loads, and cache invalidation after updates and deletes.\n\nGitOrigin-RevId: f13512e6404d4919879ba5ba77a3e34e52b35640","tree":{"sha":"f0e8d2322f31a51428627c5cf07381288d510020","url":"https://api.github.com/repos/openai/codex/git/trees/f0e8d2322f31a51428627c5cf07381288d510020"},"url":"https://api.github.com/repos/openai/codex/git/commits/8b1b065719103f5c5a1bdd8b6a95354a72b06d97","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/8b1b065719103f5c5a1bdd8b6a95354a72b06d97","html_url":"https://github.com/openai/codex/commit/8b1b065719103f5c5a1bdd8b6a95354a72b06d97","comments_url":"https://api.github.com/repos/openai/codex/commits/8b1b065719103f5c5a1bdd8b6a95354a72b06d97/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"3c60d4da648bfa98e3c51c5161ac2720519c733e","url":"https://api.github.com/repos/openai/codex/commits/3c60d4da648bfa98e3c51c5161ac2720519c733e","html_url":"https://github.com/openai/codex/commit/3c60d4da648bfa98e3c51c5161ac2720519c733e"}]},{"sha":"3c60d4da648bfa98e3c51c5161ac2720519c733e","node_id":"C_kwDOOYsS4doAKDNjNjBkNGRhNjQ4YmZhOThlM2M1MWM1MTYxYWMyNzIwNTE5YzczM2U","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-10T14:56:57Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T15:03:03Z"},"message":"Tighten the skills extension API surface (#37838)\n\n## What changed\n\n- Restrict host loading, snapshot, and outcome implementation details to the\n  skills extension crate.\n- Require `HostSkillsLoadInput` construction through its public constructor\n  instead of exposing its fields.\n- Remove redundant implicit-invocation helpers from `SkillLoadOutcome`; use the\n  `ImplicitSkillLookup` interface for enabled-skill lookup instead.\n\nGitOrigin-RevId: e79c77fc3e69ecc0231b0c87e5f9f24a5487f9e4","tree":{"sha":"fce1246f97a1b033fce90cac032623f27c18ea9c","url":"https://api.github.com/repos/openai/codex/git/trees/fce1246f97a1b033fce90cac032623f27c18ea9c"},"url":"https://api.github.com/repos/openai/codex/git/commits/3c60d4da648bfa98e3c51c5161ac2720519c733e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/3c60d4da648bfa98e3c51c5161ac2720519c733e","html_url":"https://github.com/openai/codex/commit/3c60d4da648bfa98e3c51c5161ac2720519c733e","comments_url":"https://api.github.com/repos/openai/codex/commits/3c60d4da648bfa98e3c51c5161ac2720519c733e/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"3b67b03a3f6b0590589fb85d2be26d0eb58ac159","url":"https://api.github.com/repos/openai/codex/commits/3b67b03a3f6b0590589fb85d2be26d0eb58ac159","html_url":"https://github.com/openai/codex/commit/3b67b03a3f6b0590589fb85d2be26d0eb58ac159"}]},{"sha":"3b67b03a3f6b0590589fb85d2be26d0eb58ac159","node_id":"C_kwDOOYsS4doAKDNiNjdiMDNhM2Y2YjA1OTA1ODlmYjg1ZDJiZTI2ZDBlYjU4YWMxNTk","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-10T14:38:41Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T14:45:55Z"},"message":"Run plugin and skill tests on Windows (#37836)\n\n## Why\n\nThe plugin and skill test suites were excluded wholesale on Windows, even though\nmost cases do not depend on POSIX behavior.\n\n## What changed\n\n- Make generated TOML and JSON fixtures escape Windows paths correctly.\n- Use Windows-safe path canonicalization and normalize advertised skill paths.\n- Select test environments through the environment-aware builders.\n- Run the suites on Windows while narrowly skipping cases that execute POSIX\n  commands or require matching host and executor path conventions.\n\nGitOrigin-RevId: aadf31013c2bf9bac728adc4dd96f572d4a3bf3f","tree":{"sha":"0c3da554b339b969ece0e384b15773bbd5238a73","url":"https://api.github.com/repos/openai/codex/git/trees/0c3da554b339b969ece0e384b15773bbd5238a73"},"url":"https://api.github.com/repos/openai/codex/git/commits/3b67b03a3f6b0590589fb85d2be26d0eb58ac159","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/3b67b03a3f6b0590589fb85d2be26d0eb58ac159","html_url":"https://github.com/openai/codex/commit/3b67b03a3f6b0590589fb85d2be26d0eb58ac159","comments_url":"https://api.github.com/repos/openai/codex/commits/3b67b03a3f6b0590589fb85d2be26d0eb58ac159/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"680934adc4dcda56b5f8621b7a52672383c00349","url":"https://api.github.com/repos/openai/codex/commits/680934adc4dcda56b5f8621b7a52672383c00349","html_url":"https://github.com/openai/codex/commit/680934adc4dcda56b5f8621b7a52672383c00349"}]},{"sha":"680934adc4dcda56b5f8621b7a52672383c00349","node_id":"C_kwDOOYsS4doAKDY4MDkzNGFkYzRkY2RhNTZiNWY4NjIxYjdhNTI2NzIzODNjMDAzNDk","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-10T14:19:46Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T14:30:30Z"},"message":"Encapsulate watchable skill root selection (#37833)\n\n## Why\n\nThe app server should not need access to host skill root internals to decide\nwhich paths require filesystem watching.\n\n## What changed\n\n- Add `HostSkillsService::watchable_skill_root_paths` to return non-plugin,\n  non-system skill roots for the watcher.\n- Make `HostSkillRoot` and root resolution private to the skills extension.\n- Update the app-server watcher to consume the filtered paths directly.\n\n## Testing\n\nAdd a host service test confirming that user skill roots remain watchable while\nplugin and generated system roots are excluded.\n\nGitOrigin-RevId: b3e3b576e4ffe96230af71d9bf7c6c315b1705d3","tree":{"sha":"703bc42661197157344d36dabfbd14e6b3ac158b","url":"https://api.github.com/repos/openai/codex/git/trees/703bc42661197157344d36dabfbd14e6b3ac158b"},"url":"https://api.github.com/repos/openai/codex/git/commits/680934adc4dcda56b5f8621b7a52672383c00349","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/680934adc4dcda56b5f8621b7a52672383c00349","html_url":"https://github.com/openai/codex/commit/680934adc4dcda56b5f8621b7a52672383c00349","comments_url":"https://api.github.com/repos/openai/codex/commits/680934adc4dcda56b5f8621b7a52672383c00349/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"bfb7790eb3ca171789c6d596973e94ac9895e1d8","url":"https://api.github.com/repos/openai/codex/commits/bfb7790eb3ca171789c6d596973e94ac9895e1d8","html_url":"https://github.com/openai/codex/commit/bfb7790eb3ca171789c6d596973e94ac9895e1d8"}]},{"sha":"bfb7790eb3ca171789c6d596973e94ac9895e1d8","node_id":"C_kwDOOYsS4doAKGJmYjc3OTBlYjNjYTE3MTc4OWM2ZDU5Njk3M2U5NGFjOTg5NWUxZDg","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-10T14:19:20Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T14:25:13Z"},"message":"Remove obsolete plugin skill discovery helpers (#37832)\n\n## What changed\n\n- Remove the path-only `effective_skill_roots` API and its type-erasing trait in favor of `effective_plugin_skill_roots`, which preserves plugin metadata.\n- Remove skill-path ancestor lookup helpers and keep namespace resolution scoped to an explicit plugin root.\n- Update plugin manager and namespace tests to exercise the retained APIs directly.\n\nGitOrigin-RevId: 507bf43bc6147bb5ab2deba4fa176bea2535159c","tree":{"sha":"a1de7360c976b6c262d07cc02eea7f233ca74688","url":"https://api.github.com/repos/openai/codex/git/trees/a1de7360c976b6c262d07cc02eea7f233ca74688"},"url":"https://api.github.com/repos/openai/codex/git/commits/bfb7790eb3ca171789c6d596973e94ac9895e1d8","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/bfb7790eb3ca171789c6d596973e94ac9895e1d8","html_url":"https://github.com/openai/codex/commit/bfb7790eb3ca171789c6d596973e94ac9895e1d8","comments_url":"https://api.github.com/repos/openai/codex/commits/bfb7790eb3ca171789c6d596973e94ac9895e1d8/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"d109393270432531ac0010542ae7973801e0d9d7","url":"https://api.github.com/repos/openai/codex/commits/d109393270432531ac0010542ae7973801e0d9d7","html_url":"https://github.com/openai/codex/commit/d109393270432531ac0010542ae7973801e0d9d7"}]},{"sha":"d109393270432531ac0010542ae7973801e0d9d7","node_id":"C_kwDOOYsS4doAKGQxMDkzOTMyNzA0MzI1MzFhYzAwMTA1NDJhZTc5NzM4MDFlMGQ5ZDc","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-10T13:33:36Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T13:39:23Z"},"message":"Track running unified exec processes at turn completion (#37828)\n\n## What changed\n\nAdd the `codex.turn.unified_exec.running_processes` counter and increment it\nby the number of background terminal processes remaining when a turn finishes.\n\nGitOrigin-RevId: 82a33b89533960d86cef95360fa122836c8aa84d","tree":{"sha":"74e2a0823d371ad103f92c9211d154876dc4e320","url":"https://api.github.com/repos/openai/codex/git/trees/74e2a0823d371ad103f92c9211d154876dc4e320"},"url":"https://api.github.com/repos/openai/codex/git/commits/d109393270432531ac0010542ae7973801e0d9d7","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/d109393270432531ac0010542ae7973801e0d9d7","html_url":"https://github.com/openai/codex/commit/d109393270432531ac0010542ae7973801e0d9d7","comments_url":"https://api.github.com/repos/openai/codex/commits/d109393270432531ac0010542ae7973801e0d9d7/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"1c042dd4d823b451ae44029abaf0e13b7cef8904","url":"https://api.github.com/repos/openai/codex/commits/1c042dd4d823b451ae44029abaf0e13b7cef8904","html_url":"https://github.com/openai/codex/commit/1c042dd4d823b451ae44029abaf0e13b7cef8904"}]},{"sha":"1c042dd4d823b451ae44029abaf0e13b7cef8904","node_id":"C_kwDOOYsS4doAKDFjMDQyZGQ0ZDgyM2I0NTFhZTQ0MDI5YWJhZjBlMTNiN2NlZjg5MDQ","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-10T11:20:04Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T11:27:22Z"},"message":"Keep multi-workspace skill listings consistent (#37812)\n\n## Why\n\nA single `skills/list` request should use one view of shared skill roots across\nall requested workspaces while still applying each workspace's skill rules.\n\n## What changed\n\n- Add a request-scoped host skills view that reuses non-plugin root snapshots\n  across `cwd` entries without persisting them across requests.\n- Resolve user-scoped plugin skill roots once per request, then apply workspace\n  skill configuration separately for each `cwd`.\n- Make `forceReload` refresh plugin roots before building the request-scoped\n  view so subsequent entries see the refreshed skills.\n\n## Testing\n\nExpanded `skills/list` and host skills service tests to cover multiple ordered\nworkspaces, per-workspace skill rules, request-local snapshots, cached results,\nand forced plugin-root refreshes.\n\nGitOrigin-RevId: eedd3a4c3e213b7f30df6cacd3adf23ba2967437","tree":{"sha":"aaf01ba071efc9a4ebbbe54dc743dad6b8945579","url":"https://api.github.com/repos/openai/codex/git/trees/aaf01ba071efc9a4ebbbe54dc743dad6b8945579"},"url":"https://api.github.com/repos/openai/codex/git/commits/1c042dd4d823b451ae44029abaf0e13b7cef8904","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/1c042dd4d823b451ae44029abaf0e13b7cef8904","html_url":"https://github.com/openai/codex/commit/1c042dd4d823b451ae44029abaf0e13b7cef8904","comments_url":"https://api.github.com/repos/openai/codex/commits/1c042dd4d823b451ae44029abaf0e13b7cef8904/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"34ecac1f2b44b6aa072925980beafbeb2a842b60","url":"https://api.github.com/repos/openai/codex/commits/34ecac1f2b44b6aa072925980beafbeb2a842b60","html_url":"https://github.com/openai/codex/commit/34ecac1f2b44b6aa072925980beafbeb2a842b60"}]},{"sha":"34ecac1f2b44b6aa072925980beafbeb2a842b60","node_id":"C_kwDOOYsS4doAKDM0ZWNhYzFmMmI0NGI2YWEwNzI5MjU5ODBiZWFmYmViMmE4NDJiNjA","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-10T11:15:14Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T11:22:55Z"},"message":"Support packaged defaults in config layering (#37810)\n\n## What changed\n\n- Load an optional package-supplied config file as the lowest-precedence\n  configuration layer, so every existing layer can override its values.\n- Report the layer as `packagedDefaults`, including its source path, through\n  config diagnostics and the app-server protocol.\n- Return an error when a configured packaged defaults file is missing.\n\n## Testing\n\n- Cover precedence across packaged, system, user, and session layers.\n- Cover the missing-file error path.\n\nGitOrigin-RevId: 52406890f4d580eedabc90bf2a9ee3affa36fee1","tree":{"sha":"e19fa3134571aec8f34f166d5ab5bc3c9a6ccc74","url":"https://api.github.com/repos/openai/codex/git/trees/e19fa3134571aec8f34f166d5ab5bc3c9a6ccc74"},"url":"https://api.github.com/repos/openai/codex/git/commits/34ecac1f2b44b6aa072925980beafbeb2a842b60","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/34ecac1f2b44b6aa072925980beafbeb2a842b60","html_url":"https://github.com/openai/codex/commit/34ecac1f2b44b6aa072925980beafbeb2a842b60","comments_url":"https://api.github.com/repos/openai/codex/commits/34ecac1f2b44b6aa072925980beafbeb2a842b60/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"09f47c87857a8cd143e76edc4121f29b7d8f7f21","url":"https://api.github.com/repos/openai/codex/commits/09f47c87857a8cd143e76edc4121f29b7d8f7f21","html_url":"https://github.com/openai/codex/commit/09f47c87857a8cd143e76edc4121f29b7d8f7f21"}]},{"sha":"09f47c87857a8cd143e76edc4121f29b7d8f7f21","node_id":"C_kwDOOYsS4doAKDA5ZjQ3Yzg3ODU3YThjZDE0M2U3NmVkYzQxMjFmMjliN2Q4ZjdmMjE","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-10T11:05:05Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T11:10:01Z"},"message":"Simplify package-based skill reads (#37808)\n\n## What changed\n\n- Make `package` the only required argument to `skills.read`, resolving the\n  owning orchestrator or executor catalog automatically.\n- Default omitted `resource` values to the package's main `SKILL.md`.\n- Render orchestrator skills as package locators and instruct the model to read\n  them directly without first calling `skills.list`.\n- Update skill extension and app-server coverage for direct main-resource\n  reads, referenced resources, aliases, and the revised tool schema.\n\nGitOrigin-RevId: 9faf57a8d0935566a15094931eaabaa8f0613e9e","tree":{"sha":"64e71702b0d2f3760b782b6f8e48195f509f60b6","url":"https://api.github.com/repos/openai/codex/git/trees/64e71702b0d2f3760b782b6f8e48195f509f60b6"},"url":"https://api.github.com/repos/openai/codex/git/commits/09f47c87857a8cd143e76edc4121f29b7d8f7f21","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/09f47c87857a8cd143e76edc4121f29b7d8f7f21","html_url":"https://github.com/openai/codex/commit/09f47c87857a8cd143e76edc4121f29b7d8f7f21","comments_url":"https://api.github.com/repos/openai/codex/commits/09f47c87857a8cd143e76edc4121f29b7d8f7f21/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"beeba1d2fc4987c7e8512e12ee8035808f025035","url":"https://api.github.com/repos/openai/codex/commits/beeba1d2fc4987c7e8512e12ee8035808f025035","html_url":"https://github.com/openai/codex/commit/beeba1d2fc4987c7e8512e12ee8035808f025035"}]},{"sha":"beeba1d2fc4987c7e8512e12ee8035808f025035","node_id":"C_kwDOOYsS4doAKGJlZWJhMWQyZmM0OTg3YzdlODUxMmUxMmVlODAzNTgwOGYwMjUwMzU","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-10T10:45:49Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T10:50:49Z"},"message":"Share model-visible tool specs across prompts (#37807)\n\n## Why\n\nBuilding a prompt cloned every model-visible `ToolSpec`, even though the tool\nset is immutable for the lifetime of its router.\n\n## What changed\n\n- Store model-visible tool specs as an `Arc<[ToolSpec]>` in `ToolRouter` and\n  `Prompt` so prompt construction only clones the shared pointer.\n- Keep separately built routers on distinct shared slices so refreshed tool\n  sets remain independent.\n\n## Testing\n\nExtend router tests to verify allocation sharing within a router, allocation\nseparation across rebuilt routers, and the existing deferred-tool filtering.\n\nGitOrigin-RevId: 1e04cd7c4d1b3fa0b494c5c51670232d38ba8ebb","tree":{"sha":"75005f67d38b5d4b0013b1a9b8d00a07394060d0","url":"https://api.github.com/repos/openai/codex/git/trees/75005f67d38b5d4b0013b1a9b8d00a07394060d0"},"url":"https://api.github.com/repos/openai/codex/git/commits/beeba1d2fc4987c7e8512e12ee8035808f025035","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/beeba1d2fc4987c7e8512e12ee8035808f025035","html_url":"https://github.com/openai/codex/commit/beeba1d2fc4987c7e8512e12ee8035808f025035","comments_url":"https://api.github.com/repos/openai/codex/commits/beeba1d2fc4987c7e8512e12ee8035808f025035/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c8e6e8555c42cf9eae0bd3c5f0519b64fce6cbce","url":"https://api.github.com/repos/openai/codex/commits/c8e6e8555c42cf9eae0bd3c5f0519b64fce6cbce","html_url":"https://github.com/openai/codex/commit/c8e6e8555c42cf9eae0bd3c5f0519b64fce6cbce"}]},{"sha":"c8e6e8555c42cf9eae0bd3c5f0519b64fce6cbce","node_id":"C_kwDOOYsS4doAKGM4ZTZlODU1NWM0MmNmOWVhZTBiZDNjNWYwNTE5YjY0ZmNlNmNiY2U","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-10T10:36:34Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T10:42:42Z"},"message":"Initialize the install attempt ID in the plugin analytics test (#37806)\n\nGitOrigin-RevId: b8fa3e322e47beba799cd3bfcf5a23097f5ddb87","tree":{"sha":"811155cbc3709ba0fc44fe5fd31579775be3d65a","url":"https://api.github.com/repos/openai/codex/git/trees/811155cbc3709ba0fc44fe5fd31579775be3d65a"},"url":"https://api.github.com/repos/openai/codex/git/commits/c8e6e8555c42cf9eae0bd3c5f0519b64fce6cbce","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c8e6e8555c42cf9eae0bd3c5f0519b64fce6cbce","html_url":"https://github.com/openai/codex/commit/c8e6e8555c42cf9eae0bd3c5f0519b64fce6cbce","comments_url":"https://api.github.com/repos/openai/codex/commits/c8e6e8555c42cf9eae0bd3c5f0519b64fce6cbce/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"8cabf5a6cf103cebe338d46346e43e3201e64f41","url":"https://api.github.com/repos/openai/codex/commits/8cabf5a6cf103cebe338d46346e43e3201e64f41","html_url":"https://github.com/openai/codex/commit/8cabf5a6cf103cebe338d46346e43e3201e64f41"}]},{"sha":"8cabf5a6cf103cebe338d46346e43e3201e64f41","node_id":"C_kwDOOYsS4doAKDhjYWJmNWE2Y2YxMDNjZWJlMzM4ZDQ2MzQ2ZTQzZTMyMDFlNjRmNDE","commit":{"author":{"name":"alicec-oai","email":"alicec@openai.com","date":"2026-08-10T06:42:02Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T06:47:21Z"},"message":"Use native transparency in the imagegen skill (#37788)\n\n## What changed\n\n- Direct the built-in `image_gen` path to request transparent backgrounds and\n  preserve the generated alpha channel.\n- Remove the built-in chroma-key generation and local background-removal\n  workflow from the skill guidance and examples.\n- Keep CLI model fallback explicit, including confirmation before switching\n  from `gpt-image-2` to `gpt-image-1.5` for transparent CLI output.\n\nGitOrigin-RevId: 1a6fbbb632bbf3f95146347d66da5382313b32a2","tree":{"sha":"09431f05554a0a993b250585e4ee4d2bcb689f18","url":"https://api.github.com/repos/openai/codex/git/trees/09431f05554a0a993b250585e4ee4d2bcb689f18"},"url":"https://api.github.com/repos/openai/codex/git/commits/8cabf5a6cf103cebe338d46346e43e3201e64f41","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/8cabf5a6cf103cebe338d46346e43e3201e64f41","html_url":"https://github.com/openai/codex/commit/8cabf5a6cf103cebe338d46346e43e3201e64f41","comments_url":"https://api.github.com/repos/openai/codex/commits/8cabf5a6cf103cebe338d46346e43e3201e64f41/comments","author":{"login":"alicec-oai","id":307245258,"node_id":"U_kgDOElAwyg","avatar_url":"https://avatars.githubusercontent.com/u/307245258?v=4","gravatar_id":"","url":"https://api.github.com/users/alicec-oai","html_url":"https://github.com/alicec-oai","followers_url":"https://api.github.com/users/alicec-oai/followers","following_url":"https://api.github.com/users/alicec-oai/following{/other_user}","gists_url":"https://api.github.com/users/alicec-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/alicec-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alicec-oai/subscriptions","organizations_url":"https://api.github.com/users/alicec-oai/orgs","repos_url":"https://api.github.com/users/alicec-oai/repos","events_url":"https://api.github.com/users/alicec-oai/events{/privacy}","received_events_url":"https://api.github.com/users/alicec-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"89a335ed50258dc9dc5b3d7f410db61b431244f9","url":"https://api.github.com/repos/openai/codex/commits/89a335ed50258dc9dc5b3d7f410db61b431244f9","html_url":"https://github.com/openai/codex/commit/89a335ed50258dc9dc5b3d7f410db61b431244f9"}]},{"sha":"89a335ed50258dc9dc5b3d7f410db61b431244f9","node_id":"C_kwDOOYsS4doAKDg5YTMzNWVkNTAyNThkYzlkYzViM2Q3ZjQxMGRiNjFiNDMxMjQ0Zjk","commit":{"author":{"name":"kylepatel-oai","email":"kylepatel@openai.com","date":"2026-08-10T03:21:08Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T03:28:19Z"},"message":"Forward install attempt IDs for remote plugins (#37773)\n\n## Why\n\nClients need to correlate a remote plugin installation request with a specific\ninstallation attempt.\n\n## What changed\n\n- Add the optional `installAttemptId` field to `PluginInstallParams`.\n- Forward the value as `install_attempt_id` in the remote plugin install POST\n  body.\n- Preserve the existing empty request body when the field is omitted.\n\n## Testing\n\n- Cover protocol serialization and remote install request bodies with and\n  without an attempt ID.\n\nGitOrigin-RevId: ffdceff4f9329b650848e6428a9ba39646c242c3","tree":{"sha":"572deff20c4f67eb44270147b325cb0bf60dc6d1","url":"https://api.github.com/repos/openai/codex/git/trees/572deff20c4f67eb44270147b325cb0bf60dc6d1"},"url":"https://api.github.com/repos/openai/codex/git/commits/89a335ed50258dc9dc5b3d7f410db61b431244f9","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/89a335ed50258dc9dc5b3d7f410db61b431244f9","html_url":"https://github.com/openai/codex/commit/89a335ed50258dc9dc5b3d7f410db61b431244f9","comments_url":"https://api.github.com/repos/openai/codex/commits/89a335ed50258dc9dc5b3d7f410db61b431244f9/comments","author":{"login":"kylepatel-oai","id":213686906,"node_id":"U_kgDODLyaeg","avatar_url":"https://avatars.githubusercontent.com/u/213686906?v=4","gravatar_id":"","url":"https://api.github.com/users/kylepatel-oai","html_url":"https://github.com/kylepatel-oai","followers_url":"https://api.github.com/users/kylepatel-oai/followers","following_url":"https://api.github.com/users/kylepatel-oai/following{/other_user}","gists_url":"https://api.github.com/users/kylepatel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/kylepatel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kylepatel-oai/subscriptions","organizations_url":"https://api.github.com/users/kylepatel-oai/orgs","repos_url":"https://api.github.com/users/kylepatel-oai/repos","events_url":"https://api.github.com/users/kylepatel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/kylepatel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c9c6c0daa994109cec50fddcb57d076fdf9e738c","url":"https://api.github.com/repos/openai/codex/commits/c9c6c0daa994109cec50fddcb57d076fdf9e738c","html_url":"https://github.com/openai/codex/commit/c9c6c0daa994109cec50fddcb57d076fdf9e738c"}]},{"sha":"c9c6c0daa994109cec50fddcb57d076fdf9e738c","node_id":"C_kwDOOYsS4doAKGM5YzZjMGRhYTk5NDEwOWNlYzUwZmRkY2I1N2QwNzZmZGY5ZTczOGM","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-10T01:34:21Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T01:44:30Z"},"message":"Add a feature flag to preserve apply_patch line endings (#37758)\n\n## What changed\n\n- Add the `apply_patch_preserve_line_endings` feature, disabled by default, to\n  preserve CRLF, CR, and mixed line endings when `apply_patch` updates files.\n- Apply the feature consistently to built-in patch handling and patches invoked\n  through shell, user-shell, unified-exec, and app-server command execution.\n- Keep the active feature configuration authoritative over inherited, shell\n  snapshot, and client-provided environment values.\n\n## Testing\n\n- Cover line-ending behavior with the feature enabled and disabled for custom\n  tool calls, shell heredocs, command execution, and the `apply_patch` CLI.\n\nGitOrigin-RevId: 531a7c66761959c650270559f57941929f03e6c4","tree":{"sha":"59d892575d074d28e133225ea6f18fbd4df06938","url":"https://api.github.com/repos/openai/codex/git/trees/59d892575d074d28e133225ea6f18fbd4df06938"},"url":"https://api.github.com/repos/openai/codex/git/commits/c9c6c0daa994109cec50fddcb57d076fdf9e738c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c9c6c0daa994109cec50fddcb57d076fdf9e738c","html_url":"https://github.com/openai/codex/commit/c9c6c0daa994109cec50fddcb57d076fdf9e738c","comments_url":"https://api.github.com/repos/openai/codex/commits/c9c6c0daa994109cec50fddcb57d076fdf9e738c/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"21aa552e8727c03189d0f7d18bbd6e7583e88f88","url":"https://api.github.com/repos/openai/codex/commits/21aa552e8727c03189d0f7d18bbd6e7583e88f88","html_url":"https://github.com/openai/codex/commit/21aa552e8727c03189d0f7d18bbd6e7583e88f88"}]},{"sha":"21aa552e8727c03189d0f7d18bbd6e7583e88f88","node_id":"C_kwDOOYsS4doAKDIxYWE1NTJlODcyN2MwMzE4OWQwZjdkMThiYmQ2ZTc1ODNlODhmODg","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-10T01:34:21Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T01:39:55Z"},"message":"Add a line-ending preservation mode to `apply_patch` (#37757)\n\n## Why\n\nUpdating a file with `apply_patch` historically normalized its contents to LF,\nwhich can rewrite line endings outside the requested change.\n\n## What changed\n\n- Add an opt-in `PreserveLineEndings` update mode and thread it through patch\n  verification, application, and the standalone executable. Existing APIs keep\n  the LF-normalizing mode by default.\n- Retain the original endings of untouched and context lines, including in\n  mixed-ending files, and use the file's first line ending for inserted or\n  replaced lines.\n- Track patch context separately from identical changed lines so preservation\n  does not alter replacement ordering or matching.\n\n## Testing\n\nAdd coverage for CRLF, CR, mixed endings, trailing blank lines, repeated lines,\nEOF overlap rejection, and legacy LF normalization.\n\nGitOrigin-RevId: 085f0cbc57e0965aa62c6a2d0e80870424e762f5","tree":{"sha":"bbc4047193122e12eed98abb02cd84b5fbc515f1","url":"https://api.github.com/repos/openai/codex/git/trees/bbc4047193122e12eed98abb02cd84b5fbc515f1"},"url":"https://api.github.com/repos/openai/codex/git/commits/21aa552e8727c03189d0f7d18bbd6e7583e88f88","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/21aa552e8727c03189d0f7d18bbd6e7583e88f88","html_url":"https://github.com/openai/codex/commit/21aa552e8727c03189d0f7d18bbd6e7583e88f88","comments_url":"https://api.github.com/repos/openai/codex/commits/21aa552e8727c03189d0f7d18bbd6e7583e88f88/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"f344a80a3b4a2e9a3f70f04526c77c6a979f5fb4","url":"https://api.github.com/repos/openai/codex/commits/f344a80a3b4a2e9a3f70f04526c77c6a979f5fb4","html_url":"https://github.com/openai/codex/commit/f344a80a3b4a2e9a3f70f04526c77c6a979f5fb4"}]},{"sha":"f344a80a3b4a2e9a3f70f04526c77c6a979f5fb4","node_id":"C_kwDOOYsS4doAKGYzNDRhODBhM2I0YTJlOWEzZjcwZjA0NTI2Yzc3YzZhOTc5ZjVmYjQ","commit":{"author":{"name":"stefanstokic-oai","email":"stefanstokic@openai.com","date":"2026-08-10T00:06:34Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-10T00:12:01Z"},"message":"Bound Cursor project path resolution (#37747)\n\n## Why\n\nResolving the working directory encoded in a Cursor project name could recursively scan large directory trees.\n\n## What changed\n\n- Probe a bounded set of path candidates using common filename separators instead of walking the directory tree.\n- Stop after 128 probes and reject ambiguous matches or unsafe encoded components.\n- Parse Windows drive prefixes separately from the encoded path.\n\n## Testing\n\nAdded coverage for common separators, ambiguous leaf and ancestor paths, and Windows drive prefixes.\n\nGitOrigin-RevId: 34b2a2bbe2d302fac3d2614a5e36dd3fa20cf2e5","tree":{"sha":"2ef62e461c36027e2fbf6eecfc5933c2d3c9a6bb","url":"https://api.github.com/repos/openai/codex/git/trees/2ef62e461c36027e2fbf6eecfc5933c2d3c9a6bb"},"url":"https://api.github.com/repos/openai/codex/git/commits/f344a80a3b4a2e9a3f70f04526c77c6a979f5fb4","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/f344a80a3b4a2e9a3f70f04526c77c6a979f5fb4","html_url":"https://github.com/openai/codex/commit/f344a80a3b4a2e9a3f70f04526c77c6a979f5fb4","comments_url":"https://api.github.com/repos/openai/codex/commits/f344a80a3b4a2e9a3f70f04526c77c6a979f5fb4/comments","author":{"login":"stefanstokic-oai","id":278208182,"node_id":"U_kgDOEJUetg","avatar_url":"https://avatars.githubusercontent.com/u/278208182?v=4","gravatar_id":"","url":"https://api.github.com/users/stefanstokic-oai","html_url":"https://github.com/stefanstokic-oai","followers_url":"https://api.github.com/users/stefanstokic-oai/followers","following_url":"https://api.github.com/users/stefanstokic-oai/following{/other_user}","gists_url":"https://api.github.com/users/stefanstokic-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/stefanstokic-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stefanstokic-oai/subscriptions","organizations_url":"https://api.github.com/users/stefanstokic-oai/orgs","repos_url":"https://api.github.com/users/stefanstokic-oai/repos","events_url":"https://api.github.com/users/stefanstokic-oai/events{/privacy}","received_events_url":"https://api.github.com/users/stefanstokic-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c0ad3ab014a27d66d1631fb00f7a70b035f46f0d","url":"https://api.github.com/repos/openai/codex/commits/c0ad3ab014a27d66d1631fb00f7a70b035f46f0d","html_url":"https://github.com/openai/codex/commit/c0ad3ab014a27d66d1631fb00f7a70b035f46f0d"}]},{"sha":"c0ad3ab014a27d66d1631fb00f7a70b035f46f0d","node_id":"C_kwDOOYsS4doAKGMwYWQzYWIwMTRhMjdkNjZkMTYzMWZiMDBmN2E3MGIwMzVmNDZmMGQ","commit":{"author":{"name":"Channing Conger","email":"cconger@openai.com","date":"2026-08-09T23:34:02Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-09T23:39:25Z"},"message":"Add gRPC TCP transport to the code-mode host (#37745)\n\n## What changed\n\n- Accept `grpc://IP:PORT` endpoints through `--listen` and serve the existing\n  code-mode gRPC service over TCP.\n- Print the bound HTTP endpoint to stdout so callers can discover the port when\n  binding to port `0`.\n- Apply the protocol frame-size limits and disable Nagle's algorithm on accepted\n  connections.\n\n## Testing\n\n- Add an end-to-end test that starts the host on an ephemeral port, connects a\n  gRPC client, and opens a session.\n- Verify accepted gRPC sockets have `TCP_NODELAY` enabled.\n\nGitOrigin-RevId: 51d6c21dff8cffb47068c0677ba10ff370385cec","tree":{"sha":"6e1098d475d2a51c272276e7bdc3b538ddb9e4a5","url":"https://api.github.com/repos/openai/codex/git/trees/6e1098d475d2a51c272276e7bdc3b538ddb9e4a5"},"url":"https://api.github.com/repos/openai/codex/git/commits/c0ad3ab014a27d66d1631fb00f7a70b035f46f0d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c0ad3ab014a27d66d1631fb00f7a70b035f46f0d","html_url":"https://github.com/openai/codex/commit/c0ad3ab014a27d66d1631fb00f7a70b035f46f0d","comments_url":"https://api.github.com/repos/openai/codex/commits/c0ad3ab014a27d66d1631fb00f7a70b035f46f0d/comments","author":{"login":"cconger","id":200563,"node_id":"MDQ6VXNlcjIwMDU2Mw==","avatar_url":"https://avatars.githubusercontent.com/u/200563?v=4","gravatar_id":"","url":"https://api.github.com/users/cconger","html_url":"https://github.com/cconger","followers_url":"https://api.github.com/users/cconger/followers","following_url":"https://api.github.com/users/cconger/following{/other_user}","gists_url":"https://api.github.com/users/cconger/gists{/gist_id}","starred_url":"https://api.github.com/users/cconger/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cconger/subscriptions","organizations_url":"https://api.github.com/users/cconger/orgs","repos_url":"https://api.github.com/users/cconger/repos","events_url":"https://api.github.com/users/cconger/events{/privacy}","received_events_url":"https://api.github.com/users/cconger/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"50ef7395faee1d0e2d01730f9636aa06091c7be3","url":"https://api.github.com/repos/openai/codex/commits/50ef7395faee1d0e2d01730f9636aa06091c7be3","html_url":"https://github.com/openai/codex/commit/50ef7395faee1d0e2d01730f9636aa06091c7be3"}]},{"sha":"50ef7395faee1d0e2d01730f9636aa06091c7be3","node_id":"C_kwDOOYsS4doAKDUwZWY3Mzk1ZmFlZTFkMGUyZDAxNzMwZjk2MzZhYTA2MDkxYzdiZTM","commit":{"author":{"name":"charlesgong-openai","email":"charlesgong@openai.com","date":"2026-08-09T18:37:06Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-09T18:42:06Z"},"message":"Report I/O subtypes for session config import failures (#37723)\n\n## What changed\n\n- Append a stable `std::io::ErrorKind` category to the\n  `failed_to_load_session_config` subtype, including categories such as\n  `invalid_data`, `not_found`, and `permission_denied`.\n- Propagate the categorized subtype through session import failure reporting.\n\n## Testing\n\n- Add an app-server test that verifies an invalid config reports\n  `failed_to_load_session_config_invalid_data` in both the import completion\n  notification and analytics event.\n\nGitOrigin-RevId: e9a1a7cd36979911f422805180dd91b6ed65e14e","tree":{"sha":"7ae9a86c7335a1998941f91468eafe303ea43f93","url":"https://api.github.com/repos/openai/codex/git/trees/7ae9a86c7335a1998941f91468eafe303ea43f93"},"url":"https://api.github.com/repos/openai/codex/git/commits/50ef7395faee1d0e2d01730f9636aa06091c7be3","comment_count":1,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/50ef7395faee1d0e2d01730f9636aa06091c7be3","html_url":"https://github.com/openai/codex/commit/50ef7395faee1d0e2d01730f9636aa06091c7be3","comments_url":"https://api.github.com/repos/openai/codex/commits/50ef7395faee1d0e2d01730f9636aa06091c7be3/comments","author":{"login":"charlesgong-openai","id":200841148,"node_id":"U_kgDOC_iXvA","avatar_url":"https://avatars.githubusercontent.com/u/200841148?v=4","gravatar_id":"","url":"https://api.github.com/users/charlesgong-openai","html_url":"https://github.com/charlesgong-openai","followers_url":"https://api.github.com/users/charlesgong-openai/followers","following_url":"https://api.github.com/users/charlesgong-openai/following{/other_user}","gists_url":"https://api.github.com/users/charlesgong-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/charlesgong-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charlesgong-openai/subscriptions","organizations_url":"https://api.github.com/users/charlesgong-openai/orgs","repos_url":"https://api.github.com/users/charlesgong-openai/repos","events_url":"https://api.github.com/users/charlesgong-openai/events{/privacy}","received_events_url":"https://api.github.com/users/charlesgong-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a16863f8704831d13e041ed7dba2c4a57a2a940b","url":"https://api.github.com/repos/openai/codex/commits/a16863f8704831d13e041ed7dba2c4a57a2a940b","html_url":"https://github.com/openai/codex/commit/a16863f8704831d13e041ed7dba2c4a57a2a940b"}]},{"sha":"a16863f8704831d13e041ed7dba2c4a57a2a940b","node_id":"C_kwDOOYsS4doAKGExNjg2M2Y4NzA0ODMxZDEzZTA0MWVkN2RiYTJjNGE1N2EyYTk0MGI","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-09T15:44:33Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-09T15:49:17Z"},"message":"Keep wrapped composer whitespace with following text (#37709)\n\n## Why\n\nOverflowing whitespace in the TUI composer could occupy a separate blank row\ninstead of remaining attached to the text that follows it.\n\n## What changed\n\n- Add composer-specific, grapheme-safe wrapping that keeps breakable Unicode\n  whitespace with the following word while preserving semantic breakpoints such\n  as hyphens and nonbreaking spaces.\n- Preserve cursor insertion rows and positions as content reflows, including\n  across full lines and wrapped fragments.\n- Keep wrapping linear for maximum-length unbroken input.\n\n## Testing\n\nAdd focused rendering and cursor tests for ASCII and Unicode whitespace,\nhyphenated words, reflowed fragments, and maximum-length input.\n\nGitOrigin-RevId: fb7713e33bfddf37460b6c2f6f0c9700f31d86bf","tree":{"sha":"2ac39af5d3d55eb80b6d1bb358abd45bfd2db453","url":"https://api.github.com/repos/openai/codex/git/trees/2ac39af5d3d55eb80b6d1bb358abd45bfd2db453"},"url":"https://api.github.com/repos/openai/codex/git/commits/a16863f8704831d13e041ed7dba2c4a57a2a940b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a16863f8704831d13e041ed7dba2c4a57a2a940b","html_url":"https://github.com/openai/codex/commit/a16863f8704831d13e041ed7dba2c4a57a2a940b","comments_url":"https://api.github.com/repos/openai/codex/commits/a16863f8704831d13e041ed7dba2c4a57a2a940b/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"646f7c0a91b8e327d263335da68ae8ef212895ce","url":"https://api.github.com/repos/openai/codex/commits/646f7c0a91b8e327d263335da68ae8ef212895ce","html_url":"https://github.com/openai/codex/commit/646f7c0a91b8e327d263335da68ae8ef212895ce"}]},{"sha":"646f7c0a91b8e327d263335da68ae8ef212895ce","node_id":"C_kwDOOYsS4doAKDY0NmY3YzBhOTFiOGUzMjdkMjYzMzM1ZGE2OGFlOGVmMjEyODk1Y2U","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-08-09T02:59:39Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-09T03:05:10Z"},"message":"Advertise environment config read support (#37654)\n\n## What changed\n\n- Add `environmentConfigRead` to exec-server environment capabilities and advertise it for local executors.\n- Default the capability to `false` when deserializing responses from older executors.\n\n## Testing\n\n- Verify legacy capability responses remain compatible and the environment config integration reports support.\n\nGitOrigin-RevId: c2110fea9e0e6e756eaeaaad096c50a943668c99","tree":{"sha":"0ea9b544498eb4984aa8668de401969234218d41","url":"https://api.github.com/repos/openai/codex/git/trees/0ea9b544498eb4984aa8668de401969234218d41"},"url":"https://api.github.com/repos/openai/codex/git/commits/646f7c0a91b8e327d263335da68ae8ef212895ce","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/646f7c0a91b8e327d263335da68ae8ef212895ce","html_url":"https://github.com/openai/codex/commit/646f7c0a91b8e327d263335da68ae8ef212895ce","comments_url":"https://api.github.com/repos/openai/codex/commits/646f7c0a91b8e327d263335da68ae8ef212895ce/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"94937de51ba28d4b308dbe1b8472d6fe1dddad28","url":"https://api.github.com/repos/openai/codex/commits/94937de51ba28d4b308dbe1b8472d6fe1dddad28","html_url":"https://github.com/openai/codex/commit/94937de51ba28d4b308dbe1b8472d6fe1dddad28"}]},{"sha":"94937de51ba28d4b308dbe1b8472d6fe1dddad28","node_id":"C_kwDOOYsS4doAKDk0OTM3ZGU1MWJhMjhkNGIzMDhkYmUxYjg0NzJkNmZlMWRkZGFkMjg","commit":{"author":{"name":"charlesgong-openai","email":"charlesgong@openai.com","date":"2026-08-09T00:58:30Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-09T01:03:34Z"},"message":"Improve plugin install failure analytics (#37645)\n\n## Why\n\nPlugin install failures need stable, low-cardinality details that distinguish\nactionable causes without relying on error messages.\n\n## What changed\n\n- Add HTTP status subtypes for remote catalog, mutation, and bundle download\n  failures, including specific common statuses and a general `http_5xx` bucket.\n- Emit failure analytics when a remote plugin is disabled by an administrator or\n  unavailable under its install policy.\n- Preserve marketplace I/O, configuration, and task failure subtypes, including\n  failures that occur before a plugin ID can be resolved.\n\n## Testing\n\nAdd app-server coverage for catalog and install HTTP failures, unavailable\nremote plugins, unreadable marketplace files, and oversized bundle error\nresponses.\n\nGitOrigin-RevId: 71a4888c492d1806bf4ff92bebc48f40cfb89300","tree":{"sha":"4b0f77e1a67d17e40c8442a165d9a2bcc43775dc","url":"https://api.github.com/repos/openai/codex/git/trees/4b0f77e1a67d17e40c8442a165d9a2bcc43775dc"},"url":"https://api.github.com/repos/openai/codex/git/commits/94937de51ba28d4b308dbe1b8472d6fe1dddad28","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/94937de51ba28d4b308dbe1b8472d6fe1dddad28","html_url":"https://github.com/openai/codex/commit/94937de51ba28d4b308dbe1b8472d6fe1dddad28","comments_url":"https://api.github.com/repos/openai/codex/commits/94937de51ba28d4b308dbe1b8472d6fe1dddad28/comments","author":{"login":"charlesgong-openai","id":200841148,"node_id":"U_kgDOC_iXvA","avatar_url":"https://avatars.githubusercontent.com/u/200841148?v=4","gravatar_id":"","url":"https://api.github.com/users/charlesgong-openai","html_url":"https://github.com/charlesgong-openai","followers_url":"https://api.github.com/users/charlesgong-openai/followers","following_url":"https://api.github.com/users/charlesgong-openai/following{/other_user}","gists_url":"https://api.github.com/users/charlesgong-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/charlesgong-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charlesgong-openai/subscriptions","organizations_url":"https://api.github.com/users/charlesgong-openai/orgs","repos_url":"https://api.github.com/users/charlesgong-openai/repos","events_url":"https://api.github.com/users/charlesgong-openai/events{/privacy}","received_events_url":"https://api.github.com/users/charlesgong-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a875dd6b220b9bf2fc522dd915f133699ecd32de","url":"https://api.github.com/repos/openai/codex/commits/a875dd6b220b9bf2fc522dd915f133699ecd32de","html_url":"https://github.com/openai/codex/commit/a875dd6b220b9bf2fc522dd915f133699ecd32de"}]},{"sha":"a875dd6b220b9bf2fc522dd915f133699ecd32de","node_id":"C_kwDOOYsS4doAKGE4NzVkZDZiMjIwYjliZjJmYzUyMmRkOTE1ZjEzMzY5OWVjZDMyZGU","commit":{"author":{"name":"Abhinav","email":"abhinav@openai.com","date":"2026-08-09T00:52:12Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-09T00:57:15Z"},"message":"Generalize hook handler execution (#37644)\n\n## What changed\n\n- Represent configured handlers by handler kind and route execution through the\n  hooks engine, while preserving command hook behavior.\n- Reject MCP tool inputs containing values such as `null` that cannot be\n  represented in TOML for trust hashing.\n\n## Testing\n\n- Add coverage for rejecting `null` at the top level and within nested MCP tool\n  input objects and arrays.\n\nGitOrigin-RevId: 3854a349c2a721691450467592f99cf57e6260ef","tree":{"sha":"eb9178c860525965201c16f829fa1aac068d8b50","url":"https://api.github.com/repos/openai/codex/git/trees/eb9178c860525965201c16f829fa1aac068d8b50"},"url":"https://api.github.com/repos/openai/codex/git/commits/a875dd6b220b9bf2fc522dd915f133699ecd32de","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a875dd6b220b9bf2fc522dd915f133699ecd32de","html_url":"https://github.com/openai/codex/commit/a875dd6b220b9bf2fc522dd915f133699ecd32de","comments_url":"https://api.github.com/repos/openai/codex/commits/a875dd6b220b9bf2fc522dd915f133699ecd32de/comments","author":{"login":"abhinav-oai","id":274334565,"node_id":"U_kgDOEFoDZQ","avatar_url":"https://avatars.githubusercontent.com/u/274334565?v=4","gravatar_id":"","url":"https://api.github.com/users/abhinav-oai","html_url":"https://github.com/abhinav-oai","followers_url":"https://api.github.com/users/abhinav-oai/followers","following_url":"https://api.github.com/users/abhinav-oai/following{/other_user}","gists_url":"https://api.github.com/users/abhinav-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/abhinav-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abhinav-oai/subscriptions","organizations_url":"https://api.github.com/users/abhinav-oai/orgs","repos_url":"https://api.github.com/users/abhinav-oai/repos","events_url":"https://api.github.com/users/abhinav-oai/events{/privacy}","received_events_url":"https://api.github.com/users/abhinav-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"420accf199e10bc908837ce5c7609b3bb9a38c8d","url":"https://api.github.com/repos/openai/codex/commits/420accf199e10bc908837ce5c7609b3bb9a38c8d","html_url":"https://github.com/openai/codex/commit/420accf199e10bc908837ce5c7609b3bb9a38c8d"}]},{"sha":"420accf199e10bc908837ce5c7609b3bb9a38c8d","node_id":"C_kwDOOYsS4doAKDQyMGFjY2YxOTllMTBiYzkwODgzN2NlNWM3NjA5YjNiYjlhMzhjOGQ","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-08-09T00:23:53Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-09T00:29:14Z"},"message":"Use the step context for command approval prefix rules (#37641)\n\n## What changed\n\nRead `allow_prefix_rules` from the turn attached to the active step context\nwhen selecting the exec policy and constructing unified exec approval requests.\n\nGitOrigin-RevId: d2d26e88b9cefa28bb2df5b9f71aa7b30b7ea331","tree":{"sha":"aaa0238cefd0362eb03ead661335f979ffc0648b","url":"https://api.github.com/repos/openai/codex/git/trees/aaa0238cefd0362eb03ead661335f979ffc0648b"},"url":"https://api.github.com/repos/openai/codex/git/commits/420accf199e10bc908837ce5c7609b3bb9a38c8d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/420accf199e10bc908837ce5c7609b3bb9a38c8d","html_url":"https://github.com/openai/codex/commit/420accf199e10bc908837ce5c7609b3bb9a38c8d","comments_url":"https://api.github.com/repos/openai/codex/commits/420accf199e10bc908837ce5c7609b3bb9a38c8d/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"266c6920d9b82fe4d68959529565256b12a9be99","url":"https://api.github.com/repos/openai/codex/commits/266c6920d9b82fe4d68959529565256b12a9be99","html_url":"https://github.com/openai/codex/commit/266c6920d9b82fe4d68959529565256b12a9be99"}]},{"sha":"266c6920d9b82fe4d68959529565256b12a9be99","node_id":"C_kwDOOYsS4doAKDI2NmM2OTIwZDliODJmZTRkNjg5NTk1Mjk1NjUyNTZiMTJhOWJlOTk","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-08T20:51:57Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-08T21:01:19Z"},"message":"Include buffered turns when editing prompts (#37622)\n\n## Why\n\nPrompt editing looks up the selected user message in the thread's turns, but\nnew live turns may still exist only in the replay buffer.\n\n## What changed\n\nReconstruct buffered turns from turn and item notifications before locating\nthe prompt to edit. Preserve completion metadata and avoid duplicating turns\nor items already present in the snapshot.\n\n## Testing\n\nExtend the prompt-edit fork test to cover a selected turn supplied through the\nreplay buffer and verify that the source thread remains unchanged.\n\nGitOrigin-RevId: e357098085a4def871f3df65b6721a31e07b737f","tree":{"sha":"5466f16e25ec8b448ae1098483752cd3f192a1ed","url":"https://api.github.com/repos/openai/codex/git/trees/5466f16e25ec8b448ae1098483752cd3f192a1ed"},"url":"https://api.github.com/repos/openai/codex/git/commits/266c6920d9b82fe4d68959529565256b12a9be99","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/266c6920d9b82fe4d68959529565256b12a9be99","html_url":"https://github.com/openai/codex/commit/266c6920d9b82fe4d68959529565256b12a9be99","comments_url":"https://api.github.com/repos/openai/codex/commits/266c6920d9b82fe4d68959529565256b12a9be99/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"dd43a9967ff19ce2b96282d2fd5cbdd2022a9b11","url":"https://api.github.com/repos/openai/codex/commits/dd43a9967ff19ce2b96282d2fd5cbdd2022a9b11","html_url":"https://github.com/openai/codex/commit/dd43a9967ff19ce2b96282d2fd5cbdd2022a9b11"}]},{"sha":"dd43a9967ff19ce2b96282d2fd5cbdd2022a9b11","node_id":"C_kwDOOYsS4doAKGRkNDNhOTk2N2ZmMTljZTJiOTYyODJkMmZkNWNiZGQyMDIyYTliMTE","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-08-08T20:02:28Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-08T20:07:27Z"},"message":"Use step environments for Guardian approval reviews (#37618)\n\n## Why\n\nDeferred environments can become ready after a turn starts. Guardian approval\nreviews must use the environment selected for the current step so their working\ndirectory and permission context are not taken from the stale turn snapshot.\n\n## What changed\n\n- Carry `StepContext` through tool execution and approval handling.\n- Add a Guardian review context that pairs the parent turn with the current\n  step's environment snapshot.\n- Use that snapshot for Guardian prompts, reviewer sessions, and delegated\n  reviewer threads while retaining turn-level fallbacks for callers without a\n  step context.\n\n## Testing\n\nAdded an integration test that makes a deferred remote environment ready before\nan escalated command and verifies Guardian receives that environment's working\ndirectory and denied-read policy instead of the initial local environment's.\n\nGitOrigin-RevId: 779096bc7d0e0c7453a009c02141029714b9b407","tree":{"sha":"92925bb71167c36eb721259b86743f27c7b2ec66","url":"https://api.github.com/repos/openai/codex/git/trees/92925bb71167c36eb721259b86743f27c7b2ec66"},"url":"https://api.github.com/repos/openai/codex/git/commits/dd43a9967ff19ce2b96282d2fd5cbdd2022a9b11","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/dd43a9967ff19ce2b96282d2fd5cbdd2022a9b11","html_url":"https://github.com/openai/codex/commit/dd43a9967ff19ce2b96282d2fd5cbdd2022a9b11","comments_url":"https://api.github.com/repos/openai/codex/commits/dd43a9967ff19ce2b96282d2fd5cbdd2022a9b11/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"936f5eb3ee223ab34dcb221fa7c5f9943c8092bd","url":"https://api.github.com/repos/openai/codex/commits/936f5eb3ee223ab34dcb221fa7c5f9943c8092bd","html_url":"https://github.com/openai/codex/commit/936f5eb3ee223ab34dcb221fa7c5f9943c8092bd"}]},{"sha":"936f5eb3ee223ab34dcb221fa7c5f9943c8092bd","node_id":"C_kwDOOYsS4doAKDkzNmY1ZWIzZWUyMjNhYjM0ZGNiMjIxZmE3YzVmOTk0M2M4MDkyYmQ","commit":{"author":{"name":"cooper-oai","email":"cooper@openai.com","date":"2026-08-08T17:12:54Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-08T17:18:02Z"},"message":"Add workload identity token exchange support (#37610)\n\n## What changed\n\n- Add the `codex-workload-identity` crate for exchanging a file-backed JWT assertion and federation rule ID for short-lived ChatGPT credentials.\n- Cache valid access tokens, refresh them before expiry or after rejection, and coalesce concurrent exchanges. Continue using a still-valid cached token when a proactive refresh fails transiently.\n- Validate assertion files, token endpoints, and exchange responses; honor outbound proxy policy for HTTPS endpoints and redact access tokens from debug output.\n\n## Testing\n\n- Cover request encoding, assertion rotation, caching, concurrent refreshes, transient-failure fallback, configuration validation, and malformed inputs and responses.\n\nGitOrigin-RevId: 5496851683c2dcf6aaad6840053b97f7c0be076e","tree":{"sha":"e4f83465ca28099d6fdb841c7da2e5141b717a05","url":"https://api.github.com/repos/openai/codex/git/trees/e4f83465ca28099d6fdb841c7da2e5141b717a05"},"url":"https://api.github.com/repos/openai/codex/git/commits/936f5eb3ee223ab34dcb221fa7c5f9943c8092bd","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/936f5eb3ee223ab34dcb221fa7c5f9943c8092bd","html_url":"https://github.com/openai/codex/commit/936f5eb3ee223ab34dcb221fa7c5f9943c8092bd","comments_url":"https://api.github.com/repos/openai/codex/commits/936f5eb3ee223ab34dcb221fa7c5f9943c8092bd/comments","author":{"login":"cooper-oai","id":242064477,"node_id":"U_kgDODm2cXQ","avatar_url":"https://avatars.githubusercontent.com/u/242064477?v=4","gravatar_id":"","url":"https://api.github.com/users/cooper-oai","html_url":"https://github.com/cooper-oai","followers_url":"https://api.github.com/users/cooper-oai/followers","following_url":"https://api.github.com/users/cooper-oai/following{/other_user}","gists_url":"https://api.github.com/users/cooper-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/cooper-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cooper-oai/subscriptions","organizations_url":"https://api.github.com/users/cooper-oai/orgs","repos_url":"https://api.github.com/users/cooper-oai/repos","events_url":"https://api.github.com/users/cooper-oai/events{/privacy}","received_events_url":"https://api.github.com/users/cooper-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c4513cb982e9fa7ad41e5ca988a434ebd5e8209d","url":"https://api.github.com/repos/openai/codex/commits/c4513cb982e9fa7ad41e5ca988a434ebd5e8209d","html_url":"https://github.com/openai/codex/commit/c4513cb982e9fa7ad41e5ca988a434ebd5e8209d"}]},{"sha":"c4513cb982e9fa7ad41e5ca988a434ebd5e8209d","node_id":"C_kwDOOYsS4doAKGM0NTEzY2I5ODJlOWZhN2FkNDFlNWNhOTg4YTQzNGViZDVlODIwOWQ","commit":{"author":{"name":"cooper-oai","email":"cooper@openai.com","date":"2026-08-08T16:51:07Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-08T16:58:26Z"},"message":"Prevent launch context from reaching child processes (#37607)\n\n## Why\n\nModel-reachable child processes should not inherit Codex launch context.\n\n## What changed\n\n- Treat `OPENAI_FEDERATION_RULE_ID` and `OPENAI_IDENTITY_TOKEN_FILE` as non-inheritable environment variables, with case-insensitive matching.\n- Remove them after shell environment policy overrides and before spawning commands across execution, MCP, hooks, Git helpers, and remote helper processes.\n\n## Testing\n\n- Cover inherited and explicitly configured variants, including mixed-case names.\n- Verify the variables are absent from real child environments and app-server command and process execution.\n\nGitOrigin-RevId: 2535527893985fef0995617f4c5b2462bea7c136","tree":{"sha":"52b6471a71f67b1c65dcaf345c2158a1b49b1eb3","url":"https://api.github.com/repos/openai/codex/git/trees/52b6471a71f67b1c65dcaf345c2158a1b49b1eb3"},"url":"https://api.github.com/repos/openai/codex/git/commits/c4513cb982e9fa7ad41e5ca988a434ebd5e8209d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c4513cb982e9fa7ad41e5ca988a434ebd5e8209d","html_url":"https://github.com/openai/codex/commit/c4513cb982e9fa7ad41e5ca988a434ebd5e8209d","comments_url":"https://api.github.com/repos/openai/codex/commits/c4513cb982e9fa7ad41e5ca988a434ebd5e8209d/comments","author":{"login":"cooper-oai","id":242064477,"node_id":"U_kgDODm2cXQ","avatar_url":"https://avatars.githubusercontent.com/u/242064477?v=4","gravatar_id":"","url":"https://api.github.com/users/cooper-oai","html_url":"https://github.com/cooper-oai","followers_url":"https://api.github.com/users/cooper-oai/followers","following_url":"https://api.github.com/users/cooper-oai/following{/other_user}","gists_url":"https://api.github.com/users/cooper-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/cooper-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cooper-oai/subscriptions","organizations_url":"https://api.github.com/users/cooper-oai/orgs","repos_url":"https://api.github.com/users/cooper-oai/repos","events_url":"https://api.github.com/users/cooper-oai/events{/privacy}","received_events_url":"https://api.github.com/users/cooper-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"3aae5d885bac39c1262491aa3fd100dfd8b3919f","url":"https://api.github.com/repos/openai/codex/commits/3aae5d885bac39c1262491aa3fd100dfd8b3919f","html_url":"https://github.com/openai/codex/commit/3aae5d885bac39c1262491aa3fd100dfd8b3919f"}]},{"sha":"3aae5d885bac39c1262491aa3fd100dfd8b3919f","node_id":"C_kwDOOYsS4doAKDNhYWU1ZDg4NWJhYzM5YzEyNjI0OTFhYTNmZDEwMGRmZDhiMzkxOWY","commit":{"author":{"name":"Abhinav","email":"abhinav@openai.com","date":"2026-08-08T04:50:14Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-08T04:57:06Z"},"message":"Expose execution mode in hook listings (#37538)\n\n## What changed\n\n- Add `executionMode` to `HookMetadata` returned by `hooks/list`, with `sync` as the default for compatibility.\n- Propagate each discovered hook's `sync` or `async` mode through the app-server protocol and generated schemas.\n- Show the execution mode in the TUI hooks browser.\n\n## Testing\n\n- Cover async and default-sync modes in `hooks/list` tests and TUI snapshots.\n\nGitOrigin-RevId: 9c9f2890798fe417face76c15847616b2dea9db4","tree":{"sha":"40d3704467f2f9774602af33d284819c5f4487dd","url":"https://api.github.com/repos/openai/codex/git/trees/40d3704467f2f9774602af33d284819c5f4487dd"},"url":"https://api.github.com/repos/openai/codex/git/commits/3aae5d885bac39c1262491aa3fd100dfd8b3919f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/3aae5d885bac39c1262491aa3fd100dfd8b3919f","html_url":"https://github.com/openai/codex/commit/3aae5d885bac39c1262491aa3fd100dfd8b3919f","comments_url":"https://api.github.com/repos/openai/codex/commits/3aae5d885bac39c1262491aa3fd100dfd8b3919f/comments","author":{"login":"abhinav-oai","id":274334565,"node_id":"U_kgDOEFoDZQ","avatar_url":"https://avatars.githubusercontent.com/u/274334565?v=4","gravatar_id":"","url":"https://api.github.com/users/abhinav-oai","html_url":"https://github.com/abhinav-oai","followers_url":"https://api.github.com/users/abhinav-oai/followers","following_url":"https://api.github.com/users/abhinav-oai/following{/other_user}","gists_url":"https://api.github.com/users/abhinav-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/abhinav-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abhinav-oai/subscriptions","organizations_url":"https://api.github.com/users/abhinav-oai/orgs","repos_url":"https://api.github.com/users/abhinav-oai/repos","events_url":"https://api.github.com/users/abhinav-oai/events{/privacy}","received_events_url":"https://api.github.com/users/abhinav-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"6f647caa9bd62b16824cf5efc8e4575090feddf4","url":"https://api.github.com/repos/openai/codex/commits/6f647caa9bd62b16824cf5efc8e4575090feddf4","html_url":"https://github.com/openai/codex/commit/6f647caa9bd62b16824cf5efc8e4575090feddf4"}]},{"sha":"6f647caa9bd62b16824cf5efc8e4575090feddf4","node_id":"C_kwDOOYsS4doAKDZmNjQ3Y2FhOWJkNjJiMTY4MjRjZjVlZmM4ZTQ1NzUwOTBmZWRkZjQ","commit":{"author":{"name":"Abhinav","email":"abhinav@openai.com","date":"2026-08-08T04:18:58Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-08T04:24:12Z"},"message":"Support asynchronous command hooks (#37533)\n\n## Why\n\nHook configurations can mark command handlers as asynchronous, but Codex previously skipped those handlers outside `SessionEnd`.\n\n## What changed\n\n- Run asynchronous command hooks in the background with a per-session concurrency limit, while keeping `SessionEnd` hooks synchronous.\n- Prevent asynchronous hooks from blocking, stopping, rewriting, or otherwise controlling the operation that launched them.\n- Deliver warnings and additional context at safe turn boundaries: inject results into an active turn after sampling, or buffer them ahead of the next user prompt when the session is idle.\n- Preserve in-flight hooks across configuration reloads, scope spilled output to the thread, and abort outstanding work during session shutdown.\n\n## Testing\n\nAdd unit and integration coverage for background scheduling, concurrency, output parsing, active and idle result delivery, configuration reloads, and shutdown cleanup.\n\nGitOrigin-RevId: 8094552e4afe7b47b09a61bb575bb20f4e491d8d","tree":{"sha":"c1f7e04c6a1b4c51c0750610f652b237897de4d8","url":"https://api.github.com/repos/openai/codex/git/trees/c1f7e04c6a1b4c51c0750610f652b237897de4d8"},"url":"https://api.github.com/repos/openai/codex/git/commits/6f647caa9bd62b16824cf5efc8e4575090feddf4","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/6f647caa9bd62b16824cf5efc8e4575090feddf4","html_url":"https://github.com/openai/codex/commit/6f647caa9bd62b16824cf5efc8e4575090feddf4","comments_url":"https://api.github.com/repos/openai/codex/commits/6f647caa9bd62b16824cf5efc8e4575090feddf4/comments","author":{"login":"abhinav-oai","id":274334565,"node_id":"U_kgDOEFoDZQ","avatar_url":"https://avatars.githubusercontent.com/u/274334565?v=4","gravatar_id":"","url":"https://api.github.com/users/abhinav-oai","html_url":"https://github.com/abhinav-oai","followers_url":"https://api.github.com/users/abhinav-oai/followers","following_url":"https://api.github.com/users/abhinav-oai/following{/other_user}","gists_url":"https://api.github.com/users/abhinav-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/abhinav-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abhinav-oai/subscriptions","organizations_url":"https://api.github.com/users/abhinav-oai/orgs","repos_url":"https://api.github.com/users/abhinav-oai/repos","events_url":"https://api.github.com/users/abhinav-oai/events{/privacy}","received_events_url":"https://api.github.com/users/abhinav-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"61a3dd4387dabbbc9725bfac0b99dec1d902cfb3","url":"https://api.github.com/repos/openai/codex/commits/61a3dd4387dabbbc9725bfac0b99dec1d902cfb3","html_url":"https://github.com/openai/codex/commit/61a3dd4387dabbbc9725bfac0b99dec1d902cfb3"}]},{"sha":"61a3dd4387dabbbc9725bfac0b99dec1d902cfb3","node_id":"C_kwDOOYsS4doAKDYxYTNkZDQzODdkYWJiYmM5NzI1YmZhYzBiOTlkZWMxZDkwMmNmYjM","commit":{"author":{"name":"Channing Conger","email":"cconger@openai.com","date":"2026-08-08T04:08:25Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-08T04:13:55Z"},"message":"Implement the gRPC code-mode host service (#37530)\n\n## What changed\n\n- Export `GrpcCodeModeHost` as a transport-independent implementation of the\n  code-mode gRPC API.\n- Support leased sessions, execution and wait lifecycle operations, filtered\n  nested tool-call subscriptions, tool completions, and notification\n  acknowledgements.\n- Share host-wide request and active-cell limits across the existing and gRPC\n  transports, and bound identifiers, metadata, subscriptions, and pending\n  callbacks.\n\n## Testing\n\n- Add coverage for request conversion, ordered callback routing, cancellation,\n  session cleanup, backpressure, malformed input, and resource-limit handling.\n\nGitOrigin-RevId: f146ba7e6fe4e4aa02f25dd3f961120980516d0e","tree":{"sha":"2ef1c4f5b1a16283b5bf4d2f2cee34ba7262055d","url":"https://api.github.com/repos/openai/codex/git/trees/2ef1c4f5b1a16283b5bf4d2f2cee34ba7262055d"},"url":"https://api.github.com/repos/openai/codex/git/commits/61a3dd4387dabbbc9725bfac0b99dec1d902cfb3","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/61a3dd4387dabbbc9725bfac0b99dec1d902cfb3","html_url":"https://github.com/openai/codex/commit/61a3dd4387dabbbc9725bfac0b99dec1d902cfb3","comments_url":"https://api.github.com/repos/openai/codex/commits/61a3dd4387dabbbc9725bfac0b99dec1d902cfb3/comments","author":{"login":"cconger","id":200563,"node_id":"MDQ6VXNlcjIwMDU2Mw==","avatar_url":"https://avatars.githubusercontent.com/u/200563?v=4","gravatar_id":"","url":"https://api.github.com/users/cconger","html_url":"https://github.com/cconger","followers_url":"https://api.github.com/users/cconger/followers","following_url":"https://api.github.com/users/cconger/following{/other_user}","gists_url":"https://api.github.com/users/cconger/gists{/gist_id}","starred_url":"https://api.github.com/users/cconger/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cconger/subscriptions","organizations_url":"https://api.github.com/users/cconger/orgs","repos_url":"https://api.github.com/users/cconger/repos","events_url":"https://api.github.com/users/cconger/events{/privacy}","received_events_url":"https://api.github.com/users/cconger/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"f65ea998c7536fffd89e4e4d4c90ab135eb8b0f9","url":"https://api.github.com/repos/openai/codex/commits/f65ea998c7536fffd89e4e4d4c90ab135eb8b0f9","html_url":"https://github.com/openai/codex/commit/f65ea998c7536fffd89e4e4d4c90ab135eb8b0f9"}]},{"sha":"f65ea998c7536fffd89e4e4d4c90ab135eb8b0f9","node_id":"C_kwDOOYsS4doAKGY2NWVhOTk4Yzc1MzZmZmZkODllNGU0ZDRjOTBhYjEzNWViOGIwZjk","commit":{"author":{"name":"stefanstokic-oai","email":"stefanstokic@openai.com","date":"2026-08-08T03:46:25Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-08T03:52:37Z"},"message":"Keep external agent detection from blocking config requests (#37528)\n\n## Why\n\nExternal agent detection can spend time reading session transcripts. Sharing the\nconfiguration serialization queue causes unrelated configuration requests to\nwait for detection to finish.\n\n## What changed\n\n- Give `externalAgentConfig/detect` its own global serialization queue.\n- Keep configuration reads, requirements reads, writes, and external agent\n  imports responsive while detection is still running.\n\n## Testing\n\nAdd a Unix app-server test that blocks transcript detection on a FIFO and\nverifies the unrelated requests complete before detection is released.\n\nGitOrigin-RevId: d2764dcdb0e96d810c790c570c48fa45690a3dc1","tree":{"sha":"113765bf87904e061ce7f04f8094973f23a7a57d","url":"https://api.github.com/repos/openai/codex/git/trees/113765bf87904e061ce7f04f8094973f23a7a57d"},"url":"https://api.github.com/repos/openai/codex/git/commits/f65ea998c7536fffd89e4e4d4c90ab135eb8b0f9","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/f65ea998c7536fffd89e4e4d4c90ab135eb8b0f9","html_url":"https://github.com/openai/codex/commit/f65ea998c7536fffd89e4e4d4c90ab135eb8b0f9","comments_url":"https://api.github.com/repos/openai/codex/commits/f65ea998c7536fffd89e4e4d4c90ab135eb8b0f9/comments","author":{"login":"stefanstokic-oai","id":278208182,"node_id":"U_kgDOEJUetg","avatar_url":"https://avatars.githubusercontent.com/u/278208182?v=4","gravatar_id":"","url":"https://api.github.com/users/stefanstokic-oai","html_url":"https://github.com/stefanstokic-oai","followers_url":"https://api.github.com/users/stefanstokic-oai/followers","following_url":"https://api.github.com/users/stefanstokic-oai/following{/other_user}","gists_url":"https://api.github.com/users/stefanstokic-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/stefanstokic-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stefanstokic-oai/subscriptions","organizations_url":"https://api.github.com/users/stefanstokic-oai/orgs","repos_url":"https://api.github.com/users/stefanstokic-oai/repos","events_url":"https://api.github.com/users/stefanstokic-oai/events{/privacy}","received_events_url":"https://api.github.com/users/stefanstokic-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"dd916428cd738001049e95d13854b80b78878065","url":"https://api.github.com/repos/openai/codex/commits/dd916428cd738001049e95d13854b80b78878065","html_url":"https://github.com/openai/codex/commit/dd916428cd738001049e95d13854b80b78878065"}]},{"sha":"dd916428cd738001049e95d13854b80b78878065","node_id":"C_kwDOOYsS4doAKGRkOTE2NDI4Y2Q3MzgwMDEwNDllOTVkMTM4NTRiODBiNzg4NzgwNjU","commit":{"author":{"name":"Abhinav","email":"abhinav@openai.com","date":"2026-08-08T03:43:04Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-08T03:48:34Z"},"message":"Terminate timed-out hook process trees (#37527)\n\n## Why\n\nTiming out a command hook can leave descendant processes running after the hook itself is stopped.\n\n## What changed\n\n- Run hook commands in a process group on Unix and a job object on Windows.\n- Terminate the full process tree when hook execution is cancelled or fails, with `taskkill` as a Windows fallback.\n- Preserve descendants when a hook completes successfully so intentionally detached helpers can continue running.\n\nGitOrigin-RevId: 1a18653d34c6f1685ef8c4f8e8546663b276292a","tree":{"sha":"b75807a85e8fc2963ab0dd5330d9f29097d10800","url":"https://api.github.com/repos/openai/codex/git/trees/b75807a85e8fc2963ab0dd5330d9f29097d10800"},"url":"https://api.github.com/repos/openai/codex/git/commits/dd916428cd738001049e95d13854b80b78878065","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/dd916428cd738001049e95d13854b80b78878065","html_url":"https://github.com/openai/codex/commit/dd916428cd738001049e95d13854b80b78878065","comments_url":"https://api.github.com/repos/openai/codex/commits/dd916428cd738001049e95d13854b80b78878065/comments","author":{"login":"abhinav-oai","id":274334565,"node_id":"U_kgDOEFoDZQ","avatar_url":"https://avatars.githubusercontent.com/u/274334565?v=4","gravatar_id":"","url":"https://api.github.com/users/abhinav-oai","html_url":"https://github.com/abhinav-oai","followers_url":"https://api.github.com/users/abhinav-oai/followers","following_url":"https://api.github.com/users/abhinav-oai/following{/other_user}","gists_url":"https://api.github.com/users/abhinav-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/abhinav-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abhinav-oai/subscriptions","organizations_url":"https://api.github.com/users/abhinav-oai/orgs","repos_url":"https://api.github.com/users/abhinav-oai/repos","events_url":"https://api.github.com/users/abhinav-oai/events{/privacy}","received_events_url":"https://api.github.com/users/abhinav-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"2e3a1702c2e7adea5f2ae9ea2799c625024b4fda","url":"https://api.github.com/repos/openai/codex/commits/2e3a1702c2e7adea5f2ae9ea2799c625024b4fda","html_url":"https://github.com/openai/codex/commit/2e3a1702c2e7adea5f2ae9ea2799c625024b4fda"}]},{"sha":"2e3a1702c2e7adea5f2ae9ea2799c625024b4fda","node_id":"C_kwDOOYsS4doAKDJlM2ExNzAyYzJlN2FkZWE1ZjJhZTllYTI3OTljNjI1MDI0YjRmZGE","commit":{"author":{"name":"Won Park","email":"won@openai.com","date":"2026-08-08T01:32:05Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-08T01:37:02Z"},"message":"Expose auto-review ignore rules in config requirements (#37519)\n\n## What changed\n\n- Add `ignoreRules` to `AutoReviewRequirements` in the app-server v2 protocol and generated schemas.\n- Return configured `auto_review.ignore_rules` values from `configRequirements/read`.\n- Document that listed models ignore saved command-prefix approvals.\n\n## Testing\n\n- Extend config mapping and RPC tests to cover `ignore_rules`.\n\nGitOrigin-RevId: ed74fbba7693176fe09b161bbee2cb27847e0e1e","tree":{"sha":"7a95ae421b3eb39bb8709829fb5e0b1059489a21","url":"https://api.github.com/repos/openai/codex/git/trees/7a95ae421b3eb39bb8709829fb5e0b1059489a21"},"url":"https://api.github.com/repos/openai/codex/git/commits/2e3a1702c2e7adea5f2ae9ea2799c625024b4fda","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/2e3a1702c2e7adea5f2ae9ea2799c625024b4fda","html_url":"https://github.com/openai/codex/commit/2e3a1702c2e7adea5f2ae9ea2799c625024b4fda","comments_url":"https://api.github.com/repos/openai/codex/commits/2e3a1702c2e7adea5f2ae9ea2799c625024b4fda/comments","author":{"login":"won-openai","id":262224683,"node_id":"U_kgDOD6E7Kw","avatar_url":"https://avatars.githubusercontent.com/u/262224683?v=4","gravatar_id":"","url":"https://api.github.com/users/won-openai","html_url":"https://github.com/won-openai","followers_url":"https://api.github.com/users/won-openai/followers","following_url":"https://api.github.com/users/won-openai/following{/other_user}","gists_url":"https://api.github.com/users/won-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/won-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/won-openai/subscriptions","organizations_url":"https://api.github.com/users/won-openai/orgs","repos_url":"https://api.github.com/users/won-openai/repos","events_url":"https://api.github.com/users/won-openai/events{/privacy}","received_events_url":"https://api.github.com/users/won-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"e734a1a5c1c6e51d7a28ec8ec6381d7ffb18e23b","url":"https://api.github.com/repos/openai/codex/commits/e734a1a5c1c6e51d7a28ec8ec6381d7ffb18e23b","html_url":"https://github.com/openai/codex/commit/e734a1a5c1c6e51d7a28ec8ec6381d7ffb18e23b"}]},{"sha":"e734a1a5c1c6e51d7a28ec8ec6381d7ffb18e23b","node_id":"C_kwDOOYsS4doAKGU3MzRhMWE1YzFjNmU1MWQ3YTI4ZWM4ZWM2MzgxZDdmZmIxOGUyM2I","commit":{"author":{"name":"andrewgu-oai","email":"andrewgu@openai.com","date":"2026-08-08T00:53:30Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-08T00:59:39Z"},"message":"Ignore reusable command approvals for cyber models (#37516)\n\n## What changed\n\n- Filter saved `allow` prefix rules from the execution policy for cyber-specialized models and models listed in `auto_review.ignore_rules`, while preserving prompt, forbidden, network, and host-executable policy entries.\n- Apply the filtered policy consistently to permission instructions, shell commands, unified exec, and the zsh-fork backend.\n- Limit cyber-model command approvals to one-time decisions without proposing reusable policy amendments. General models continue to honor saved prefixes, including after switching models within a thread.\n\n## Testing\n\n- Add policy-level coverage for filtering allow-prefix rules while retaining restrictive and network rules.\n- Add end-to-end coverage across shell and unified exec paths, zsh-fork execution, user and automatic review, and model switching.\n\nGitOrigin-RevId: f3bd3872424291b12354ec415f33986ec369a368","tree":{"sha":"396533141ca365e46a1080e062ff4fd069763f4d","url":"https://api.github.com/repos/openai/codex/git/trees/396533141ca365e46a1080e062ff4fd069763f4d"},"url":"https://api.github.com/repos/openai/codex/git/commits/e734a1a5c1c6e51d7a28ec8ec6381d7ffb18e23b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/e734a1a5c1c6e51d7a28ec8ec6381d7ffb18e23b","html_url":"https://github.com/openai/codex/commit/e734a1a5c1c6e51d7a28ec8ec6381d7ffb18e23b","comments_url":"https://api.github.com/repos/openai/codex/commits/e734a1a5c1c6e51d7a28ec8ec6381d7ffb18e23b/comments","author":{"login":"andrewgu-oai","id":312661362,"node_id":"U_kgDOEqLVcg","avatar_url":"https://avatars.githubusercontent.com/u/312661362?v=4","gravatar_id":"","url":"https://api.github.com/users/andrewgu-oai","html_url":"https://github.com/andrewgu-oai","followers_url":"https://api.github.com/users/andrewgu-oai/followers","following_url":"https://api.github.com/users/andrewgu-oai/following{/other_user}","gists_url":"https://api.github.com/users/andrewgu-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/andrewgu-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/andrewgu-oai/subscriptions","organizations_url":"https://api.github.com/users/andrewgu-oai/orgs","repos_url":"https://api.github.com/users/andrewgu-oai/repos","events_url":"https://api.github.com/users/andrewgu-oai/events{/privacy}","received_events_url":"https://api.github.com/users/andrewgu-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c2bcb9a26b5bdbdc66c48cf3bc3bb382568e800c","url":"https://api.github.com/repos/openai/codex/commits/c2bcb9a26b5bdbdc66c48cf3bc3bb382568e800c","html_url":"https://github.com/openai/codex/commit/c2bcb9a26b5bdbdc66c48cf3bc3bb382568e800c"}]},{"sha":"c2bcb9a26b5bdbdc66c48cf3bc3bb382568e800c","node_id":"C_kwDOOYsS4doAKGMyYmNiOWEyNmI1YmRiZGM2NmM0OGNmM2JjM2JiMzgyNTY4ZTgwMGM","commit":{"author":{"name":"Won Park","email":"won@openai.com","date":"2026-08-07T23:40:46Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T23:49:12Z"},"message":"Reuse parent compactions in Guardian review sessions (#37513)\n\n## What changed\n\n- Add the under-development `guardian_reuse_parent_compaction` feature.\n- Restart Guardian review sessions after parent history rewrites and seed them with the latest encrypted compaction that has a response item ID.\n- Keep the existing reviewer when a rewritten history has no reusable compaction, preserving authorization and restriction context held by that session.\n\n## Testing\n\n- Cover reuse-key invalidation and compaction eligibility.\n- Verify review-session behavior across parent compaction and a subsequent summary-free history reset.\n\nGitOrigin-RevId: 891805d3c3dca34ddda6e3bfc5097be4ff164267","tree":{"sha":"0fe12493439ad321263caf740d522162f3e389d4","url":"https://api.github.com/repos/openai/codex/git/trees/0fe12493439ad321263caf740d522162f3e389d4"},"url":"https://api.github.com/repos/openai/codex/git/commits/c2bcb9a26b5bdbdc66c48cf3bc3bb382568e800c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c2bcb9a26b5bdbdc66c48cf3bc3bb382568e800c","html_url":"https://github.com/openai/codex/commit/c2bcb9a26b5bdbdc66c48cf3bc3bb382568e800c","comments_url":"https://api.github.com/repos/openai/codex/commits/c2bcb9a26b5bdbdc66c48cf3bc3bb382568e800c/comments","author":{"login":"won-openai","id":262224683,"node_id":"U_kgDOD6E7Kw","avatar_url":"https://avatars.githubusercontent.com/u/262224683?v=4","gravatar_id":"","url":"https://api.github.com/users/won-openai","html_url":"https://github.com/won-openai","followers_url":"https://api.github.com/users/won-openai/followers","following_url":"https://api.github.com/users/won-openai/following{/other_user}","gists_url":"https://api.github.com/users/won-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/won-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/won-openai/subscriptions","organizations_url":"https://api.github.com/users/won-openai/orgs","repos_url":"https://api.github.com/users/won-openai/repos","events_url":"https://api.github.com/users/won-openai/events{/privacy}","received_events_url":"https://api.github.com/users/won-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"208f05b23387c47d7e52fd2153d59255e945d0b7","url":"https://api.github.com/repos/openai/codex/commits/208f05b23387c47d7e52fd2153d59255e945d0b7","html_url":"https://github.com/openai/codex/commit/208f05b23387c47d7e52fd2153d59255e945d0b7"}]},{"sha":"208f05b23387c47d7e52fd2153d59255e945d0b7","node_id":"C_kwDOOYsS4doAKDIwOGYwNWIyMzM4N2M0N2Q3ZTUyZmQyMTUzZDU5MjU1ZTk0NWQwYjc","commit":{"author":{"name":"viyatb-oai","email":"viyatb@openai.com","date":"2026-08-07T23:38:08Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T23:43:14Z"},"message":"Enforce automatic review for managed models (#37511)\n\n## What changed\n\n- Add the managed `auto_review.required_on_models` requirement, unioning model slugs across requirement layers and exposing the result through `configRequirements/read`.\n- Force listed models to use `on-request` approvals with the `auto_review` reviewer. Downgrade Full Access to workspace-write when starting a protected session, and reject incompatible runtime overrides or use when automatic review is disabled.\n- Preserve these protections across thread starts, resumes, forks, model changes, turn overrides, MCP approvals, and TUI session attachment.\n\n## Testing\n\n- Add coverage for layered model requirements and exact provider-alias matching.\n- Add app-server tests for protected thread lifecycle operations, unsafe setting overrides, legacy thread upgrades, disabled automatic review, and requirements API output.\n\nGitOrigin-RevId: c4b1d52c3b5b75e86880725412b8f0812e0dfcd9","tree":{"sha":"8f7a66ec5d31a729066275f6f0744ea6aa459e7d","url":"https://api.github.com/repos/openai/codex/git/trees/8f7a66ec5d31a729066275f6f0744ea6aa459e7d"},"url":"https://api.github.com/repos/openai/codex/git/commits/208f05b23387c47d7e52fd2153d59255e945d0b7","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/208f05b23387c47d7e52fd2153d59255e945d0b7","html_url":"https://github.com/openai/codex/commit/208f05b23387c47d7e52fd2153d59255e945d0b7","comments_url":"https://api.github.com/repos/openai/codex/commits/208f05b23387c47d7e52fd2153d59255e945d0b7/comments","author":{"login":"viyatb-oai","id":234056686,"node_id":"U_kgDODfNr7g","avatar_url":"https://avatars.githubusercontent.com/u/234056686?v=4","gravatar_id":"","url":"https://api.github.com/users/viyatb-oai","html_url":"https://github.com/viyatb-oai","followers_url":"https://api.github.com/users/viyatb-oai/followers","following_url":"https://api.github.com/users/viyatb-oai/following{/other_user}","gists_url":"https://api.github.com/users/viyatb-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/viyatb-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/viyatb-oai/subscriptions","organizations_url":"https://api.github.com/users/viyatb-oai/orgs","repos_url":"https://api.github.com/users/viyatb-oai/repos","events_url":"https://api.github.com/users/viyatb-oai/events{/privacy}","received_events_url":"https://api.github.com/users/viyatb-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"8073dbb20bbd57f2acdc18708a95e8fbbfc8b91f","url":"https://api.github.com/repos/openai/codex/commits/8073dbb20bbd57f2acdc18708a95e8fbbfc8b91f","html_url":"https://github.com/openai/codex/commit/8073dbb20bbd57f2acdc18708a95e8fbbfc8b91f"}]},{"sha":"8073dbb20bbd57f2acdc18708a95e8fbbfc8b91f","node_id":"C_kwDOOYsS4doAKDgwNzNkYmIyMGJiZDU3ZjJhY2RjMTg3MDhhOTVlOGZiYmZjOGI5MWY","commit":{"author":{"name":"Channing Conger","email":"cconger@openai.com","date":"2026-08-07T23:22:47Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T23:27:39Z"},"message":"Define the code-mode host gRPC protocol (#37510)\n\n## What changed\n\n- Add the `codex.code_mode.v1` protobuf API for managing code-mode sessions, executions, waits, tool callbacks, notifications, and content results.\n- Generate and export the Rust client/server bindings with `tonic` under Cargo.\n- Add Bazel protobuf targets and a `prost` toolchain that uses the workspace's Rust runtime versions.\n\nGitOrigin-RevId: 51d9d044e01dab2f4d25ab79aa7a52585485eee3","tree":{"sha":"0a57de6117654364c1b91080cc402ce4004cddd8","url":"https://api.github.com/repos/openai/codex/git/trees/0a57de6117654364c1b91080cc402ce4004cddd8"},"url":"https://api.github.com/repos/openai/codex/git/commits/8073dbb20bbd57f2acdc18708a95e8fbbfc8b91f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/8073dbb20bbd57f2acdc18708a95e8fbbfc8b91f","html_url":"https://github.com/openai/codex/commit/8073dbb20bbd57f2acdc18708a95e8fbbfc8b91f","comments_url":"https://api.github.com/repos/openai/codex/commits/8073dbb20bbd57f2acdc18708a95e8fbbfc8b91f/comments","author":{"login":"cconger","id":200563,"node_id":"MDQ6VXNlcjIwMDU2Mw==","avatar_url":"https://avatars.githubusercontent.com/u/200563?v=4","gravatar_id":"","url":"https://api.github.com/users/cconger","html_url":"https://github.com/cconger","followers_url":"https://api.github.com/users/cconger/followers","following_url":"https://api.github.com/users/cconger/following{/other_user}","gists_url":"https://api.github.com/users/cconger/gists{/gist_id}","starred_url":"https://api.github.com/users/cconger/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cconger/subscriptions","organizations_url":"https://api.github.com/users/cconger/orgs","repos_url":"https://api.github.com/users/cconger/repos","events_url":"https://api.github.com/users/cconger/events{/privacy}","received_events_url":"https://api.github.com/users/cconger/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4ca25a2c4e6db7db0a5a5c907055786b85ca2321","url":"https://api.github.com/repos/openai/codex/commits/4ca25a2c4e6db7db0a5a5c907055786b85ca2321","html_url":"https://github.com/openai/codex/commit/4ca25a2c4e6db7db0a5a5c907055786b85ca2321"}]},{"sha":"4ca25a2c4e6db7db0a5a5c907055786b85ca2321","node_id":"C_kwDOOYsS4doAKDRjYTI1YTJjNGU2ZGI3ZGIwYTVhNWM5MDcwNTU3ODZiODVjYTIzMjE","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-08-07T22:36:20Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T22:41:20Z"},"message":"Include sandbox mode in response metadata (#37507)\n\n## What changed\n\n- Add the effective permission profile as `sandbox_mode` in turn metadata for regular, prewarm, compaction, and detached memory requests.\n- Reserve `sandbox_mode` so client-provided metadata cannot override the computed value.\n\n## Testing\n\n- Cover metadata headers and request bodies for read-only and danger-full-access modes.\n\nGitOrigin-RevId: 13c690cc99bc2691023f281ca527af049bb1286f","tree":{"sha":"3ce6c00684c99901636d2301849ba5b2fb474ab5","url":"https://api.github.com/repos/openai/codex/git/trees/3ce6c00684c99901636d2301849ba5b2fb474ab5"},"url":"https://api.github.com/repos/openai/codex/git/commits/4ca25a2c4e6db7db0a5a5c907055786b85ca2321","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4ca25a2c4e6db7db0a5a5c907055786b85ca2321","html_url":"https://github.com/openai/codex/commit/4ca25a2c4e6db7db0a5a5c907055786b85ca2321","comments_url":"https://api.github.com/repos/openai/codex/commits/4ca25a2c4e6db7db0a5a5c907055786b85ca2321/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"45f8cafa4e2ec20f9b189d5aa9409e424b6d3d09","url":"https://api.github.com/repos/openai/codex/commits/45f8cafa4e2ec20f9b189d5aa9409e424b6d3d09","html_url":"https://github.com/openai/codex/commit/45f8cafa4e2ec20f9b189d5aa9409e424b6d3d09"}]},{"sha":"45f8cafa4e2ec20f9b189d5aa9409e424b6d3d09","node_id":"C_kwDOOYsS4doAKDQ1ZjhjYWZhNGUyZWMyMGY5YjE4OWQ1YWE5NDA5ZTQyNGI2ZDNkMDk","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-07T21:30:58Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T21:36:33Z"},"message":"Remove the codex-core-skills crate (#37505)\n\n## What changed\n\n- Move `SkillLoadOutcome` and its implicit-path indexing into\n  `codex-skills-extension`.\n- Import shared skill types directly from `codex-skills` and keep the skill\n  prompt size limit with the extension renderer that uses it.\n- Remove `codex-core-skills` from the Cargo workspace and dependent crates.\n\nGitOrigin-RevId: 4e9e84909fa2f692bcc94af990bb4671affd776f","tree":{"sha":"60968d12156739975417f36b4d99dd2c7add0532","url":"https://api.github.com/repos/openai/codex/git/trees/60968d12156739975417f36b4d99dd2c7add0532"},"url":"https://api.github.com/repos/openai/codex/git/commits/45f8cafa4e2ec20f9b189d5aa9409e424b6d3d09","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/45f8cafa4e2ec20f9b189d5aa9409e424b6d3d09","html_url":"https://github.com/openai/codex/commit/45f8cafa4e2ec20f9b189d5aa9409e424b6d3d09","comments_url":"https://api.github.com/repos/openai/codex/commits/45f8cafa4e2ec20f9b189d5aa9409e424b6d3d09/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"abc5d0b552a812e0ad3479e85ad7a926ce682f43","url":"https://api.github.com/repos/openai/codex/commits/abc5d0b552a812e0ad3479e85ad7a926ce682f43","html_url":"https://github.com/openai/codex/commit/abc5d0b552a812e0ad3479e85ad7a926ce682f43"}]},{"sha":"abc5d0b552a812e0ad3479e85ad7a926ce682f43","node_id":"C_kwDOOYsS4doAKGFiYzVkMGI1NTJhODEyZTBhZDM0NzllODVhZDdhOTI2Y2U2ODJmNDM","commit":{"author":{"name":"Sean Huang","email":"seanh@openai.com","date":"2026-08-07T21:03:38Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T21:10:49Z"},"message":"Disable Nagle's algorithm for code-mode WebSockets (#37504)\n\n## Why\n\nCode-mode WebSocket connections are latency-sensitive, so buffering small TCP\nwrites can delay request and response traffic.\n\n## What changed\n\n- Enable `TCP_NODELAY` on outbound remote-session WebSocket connections.\n- Enable `TCP_NODELAY` on sockets accepted by the code-mode host, logging a\n  warning if the socket option cannot be set.\n\n## Testing\n\n- Add a listener test that connects to the host and verifies the accepted\n  socket has `TCP_NODELAY` enabled.\n\nGitOrigin-RevId: e51c781c4b47c6a4ae1c32c93cd79768719a68d9","tree":{"sha":"efb31145ddb8baa31a227bc936f0e56baeb97acd","url":"https://api.github.com/repos/openai/codex/git/trees/efb31145ddb8baa31a227bc936f0e56baeb97acd"},"url":"https://api.github.com/repos/openai/codex/git/commits/abc5d0b552a812e0ad3479e85ad7a926ce682f43","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/abc5d0b552a812e0ad3479e85ad7a926ce682f43","html_url":"https://github.com/openai/codex/commit/abc5d0b552a812e0ad3479e85ad7a926ce682f43","comments_url":"https://api.github.com/repos/openai/codex/commits/abc5d0b552a812e0ad3479e85ad7a926ce682f43/comments","author":{"login":"seanh-oai","id":309889850,"node_id":"U_kgDOEniLOg","avatar_url":"https://avatars.githubusercontent.com/u/309889850?v=4","gravatar_id":"","url":"https://api.github.com/users/seanh-oai","html_url":"https://github.com/seanh-oai","followers_url":"https://api.github.com/users/seanh-oai/followers","following_url":"https://api.github.com/users/seanh-oai/following{/other_user}","gists_url":"https://api.github.com/users/seanh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/seanh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/seanh-oai/subscriptions","organizations_url":"https://api.github.com/users/seanh-oai/orgs","repos_url":"https://api.github.com/users/seanh-oai/repos","events_url":"https://api.github.com/users/seanh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/seanh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"beac16cccd6702d1f1d26e231b9dca50ec6e25a2","url":"https://api.github.com/repos/openai/codex/commits/beac16cccd6702d1f1d26e231b9dca50ec6e25a2","html_url":"https://github.com/openai/codex/commit/beac16cccd6702d1f1d26e231b9dca50ec6e25a2"}]},{"sha":"beac16cccd6702d1f1d26e231b9dca50ec6e25a2","node_id":"C_kwDOOYsS4doAKGJlYWMxNmNjY2Q2NzAyZDFmMWQyNmUyMzFiOWRjYTUwZWM2ZTI1YTI","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-07T20:58:40Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T21:04:16Z"},"message":"Move host skill prompt injection into the skills extension (#37503)\n\n## What changed\n\n- Add `HostSkillsSnapshot::load_skill_prompts` so the skills extension owns reading and rendering selected host skills.\n- Keep explicit invocation telemetry, unreadable-skill warnings, plugin prompt ordering, and suppression of host prompts superseded by provider prompts.\n- Remove the legacy prompt injection and fragment implementation from `codex-core-skills`.\n\n## Testing\n\n- Cover prompt truncation without an installed skills extension, skill/plugin ordering, selective provider supersession, unreadable skills, and contextual fragment detection.\n\nGitOrigin-RevId: 9c8b84ad54b90d174abc287ab49cc5a231e9e1aa","tree":{"sha":"9590efddd6919a729305b0cdddb90afe2470abbf","url":"https://api.github.com/repos/openai/codex/git/trees/9590efddd6919a729305b0cdddb90afe2470abbf"},"url":"https://api.github.com/repos/openai/codex/git/commits/beac16cccd6702d1f1d26e231b9dca50ec6e25a2","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/beac16cccd6702d1f1d26e231b9dca50ec6e25a2","html_url":"https://github.com/openai/codex/commit/beac16cccd6702d1f1d26e231b9dca50ec6e25a2","comments_url":"https://api.github.com/repos/openai/codex/commits/beac16cccd6702d1f1d26e231b9dca50ec6e25a2/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"8e4b10446eed7bafb39d8a469f9be25a41f4864f","url":"https://api.github.com/repos/openai/codex/commits/8e4b10446eed7bafb39d8a469f9be25a41f4864f","html_url":"https://github.com/openai/codex/commit/8e4b10446eed7bafb39d8a469f9be25a41f4864f"}]},{"sha":"8e4b10446eed7bafb39d8a469f9be25a41f4864f","node_id":"C_kwDOOYsS4doAKDhlNGIxMDQ0NmVlZDdiYWZiMzlkOGE0NjlmOWJlMjVhNDFmNDg2NGY","commit":{"author":{"name":"rka-oai","email":"rka@openai.com","date":"2026-08-07T20:20:08Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T20:26:08Z"},"message":"Remove the legacy code-mode tool metadata inventory (#37500)\n\n## What changed\n\n- Stop adding `code_mode_tool_names` to Responses Lite turn metadata.\n- Keep `code_mode_tool_names` reserved so client metadata cannot reintroduce the removed, unbounded inventory.\n- Use the opt-in `tool_namespaces_info` metadata, including each function's `code_mode_name`, when authoritative tool details are requested.\n\n## Testing\n\n- Update Responses Lite and code-mode tests to verify the opt-in namespace metadata and normalized code-mode names.\n\nGitOrigin-RevId: cbfb9af984de71c7cc175d0cd47ae799a5275309","tree":{"sha":"0523ab2b7a0366e6acd78b3c36c42abf7f3fc294","url":"https://api.github.com/repos/openai/codex/git/trees/0523ab2b7a0366e6acd78b3c36c42abf7f3fc294"},"url":"https://api.github.com/repos/openai/codex/git/commits/8e4b10446eed7bafb39d8a469f9be25a41f4864f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/8e4b10446eed7bafb39d8a469f9be25a41f4864f","html_url":"https://github.com/openai/codex/commit/8e4b10446eed7bafb39d8a469f9be25a41f4864f","comments_url":"https://api.github.com/repos/openai/codex/commits/8e4b10446eed7bafb39d8a469f9be25a41f4864f/comments","author":{"login":"rka-oai","id":240799229,"node_id":"U_kgDODlpN_Q","avatar_url":"https://avatars.githubusercontent.com/u/240799229?v=4","gravatar_id":"","url":"https://api.github.com/users/rka-oai","html_url":"https://github.com/rka-oai","followers_url":"https://api.github.com/users/rka-oai/followers","following_url":"https://api.github.com/users/rka-oai/following{/other_user}","gists_url":"https://api.github.com/users/rka-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rka-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rka-oai/subscriptions","organizations_url":"https://api.github.com/users/rka-oai/orgs","repos_url":"https://api.github.com/users/rka-oai/repos","events_url":"https://api.github.com/users/rka-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rka-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"6db53df37f4e87cbf4a01888168c11c4d356f199","url":"https://api.github.com/repos/openai/codex/commits/6db53df37f4e87cbf4a01888168c11c4d356f199","html_url":"https://github.com/openai/codex/commit/6db53df37f4e87cbf4a01888168c11c4d356f199"}]},{"sha":"6db53df37f4e87cbf4a01888168c11c4d356f199","node_id":"C_kwDOOYsS4doAKDZkYjUzZGYzN2Y0ZTg3Y2JmNGEwMTg4ODE2OGMxMWM0ZDM1NmYxOTk","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-07T20:00:24Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T20:10:08Z"},"message":"Preserve child waiters during process termination (#37498)\n\n## Why\n\nAborting the child waiter during termination can leave an exited PTY child\nunreaped and prevent the session from recording its exit status.\n\n## What changed\n\n- Detach the child waiter instead of aborting it when terminating or dropping a\n  `ProcessHandle`, while continuing to abort the I/O helper tasks.\n- Cover explicit termination and handle drops for pipe processes, plus queued\n  PTY waiters and PTY process-group termination on Unix.\n\nGitOrigin-RevId: 313787f4edec80b30cf5a78f0cc6733f1520d9a4","tree":{"sha":"020b6c6ceba478d4c46921220a68f322e48c1119","url":"https://api.github.com/repos/openai/codex/git/trees/020b6c6ceba478d4c46921220a68f322e48c1119"},"url":"https://api.github.com/repos/openai/codex/git/commits/6db53df37f4e87cbf4a01888168c11c4d356f199","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/6db53df37f4e87cbf4a01888168c11c4d356f199","html_url":"https://github.com/openai/codex/commit/6db53df37f4e87cbf4a01888168c11c4d356f199","comments_url":"https://api.github.com/repos/openai/codex/commits/6db53df37f4e87cbf4a01888168c11c4d356f199/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"62b7386b07e488b39cc9cbf651cb5acf3acacd04","url":"https://api.github.com/repos/openai/codex/commits/62b7386b07e488b39cc9cbf651cb5acf3acacd04","html_url":"https://github.com/openai/codex/commit/62b7386b07e488b39cc9cbf651cb5acf3acacd04"}]},{"sha":"62b7386b07e488b39cc9cbf651cb5acf3acacd04","node_id":"C_kwDOOYsS4doAKDYyYjczODZiMDdlNDg4YjM5Y2M5Y2JmNjUxY2I1YWNmM2FjYWNkMDQ","commit":{"author":{"name":"dshakiba-OAI","email":"dshakiba@openai.com","date":"2026-08-07T19:50:46Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T19:56:29Z"},"message":"Limit payload traces in diagnostic logs (#37497)\n\n## Why\n\nHigh-volume request and streamed-response payloads can overwhelm the SQLite log database and diagnostic ring buffer used for reports.\n\n## What changed\n\n- Limit HTTP transport, SSE, and WebSocket diagnostics to `DEBUG` in persistent log sinks while leaving unrelated trace diagnostics available.\n- Log known unhandled response events and delta events at `TRACE`, and surface unexpected event kinds at `DEBUG` without including their payloads.\n- Report structured parse-error metadata instead of logging an unparseable SSE payload.\n\n## Testing\n\n- Cover filtering for transport, SSE, WebSocket, and unrelated trace records in both report and SQLite log sinks.\n- Cover unknown and unsupported delta response events.\n\nGitOrigin-RevId: 6d9121e093ddadf6834da394df544d9c09d8aeb9","tree":{"sha":"7920f8c05aa0e616c6b768cda37ef335afa8d1f0","url":"https://api.github.com/repos/openai/codex/git/trees/7920f8c05aa0e616c6b768cda37ef335afa8d1f0"},"url":"https://api.github.com/repos/openai/codex/git/commits/62b7386b07e488b39cc9cbf651cb5acf3acacd04","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/62b7386b07e488b39cc9cbf651cb5acf3acacd04","html_url":"https://github.com/openai/codex/commit/62b7386b07e488b39cc9cbf651cb5acf3acacd04","comments_url":"https://api.github.com/repos/openai/codex/commits/62b7386b07e488b39cc9cbf651cb5acf3acacd04/comments","author":{"login":"dshakiba-OAI","id":276123405,"node_id":"U_kgDOEHVPDQ","avatar_url":"https://avatars.githubusercontent.com/u/276123405?v=4","gravatar_id":"","url":"https://api.github.com/users/dshakiba-OAI","html_url":"https://github.com/dshakiba-OAI","followers_url":"https://api.github.com/users/dshakiba-OAI/followers","following_url":"https://api.github.com/users/dshakiba-OAI/following{/other_user}","gists_url":"https://api.github.com/users/dshakiba-OAI/gists{/gist_id}","starred_url":"https://api.github.com/users/dshakiba-OAI/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dshakiba-OAI/subscriptions","organizations_url":"https://api.github.com/users/dshakiba-OAI/orgs","repos_url":"https://api.github.com/users/dshakiba-OAI/repos","events_url":"https://api.github.com/users/dshakiba-OAI/events{/privacy}","received_events_url":"https://api.github.com/users/dshakiba-OAI/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"41014b11bd0c9f73dfa979f8e84147f83e3c2a78","url":"https://api.github.com/repos/openai/codex/commits/41014b11bd0c9f73dfa979f8e84147f83e3c2a78","html_url":"https://github.com/openai/codex/commit/41014b11bd0c9f73dfa979f8e84147f83e3c2a78"}]},{"sha":"41014b11bd0c9f73dfa979f8e84147f83e3c2a78","node_id":"C_kwDOOYsS4doAKDQxMDE0YjExYmQwYzlmNzNkZmE5NzlmOGU4NDE0N2Y4M2UzYzJhNzg","commit":{"author":{"name":"Evan Fannin","email":"evanf@openai.com","date":"2026-08-07T19:31:05Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T19:36:52Z"},"message":"Add MCP event discovery and subscriptions (#37494)\n\n## What changed\n\n- Expose hosted Plugin Runtime event definitions through `McpResourceClient::list_events`.\n- Add cancellable `events/stream` subscriptions that route lifecycle notifications to the matching request and cancel when the stream is dropped.\n- Bound event notification and queue sizes, time out stalled response headers, and close streamable HTTP responses locally on cancellation.\n\n## Testing\n\n- Add streamable HTTP integration coverage for isolated concurrent subscriptions, local cancellation, and stalled response-header timeouts.\n\nGitOrigin-RevId: 98c6fffa8f004eb2638c1b0705f659222cbbdfdb","tree":{"sha":"256f9a5c6396db08dac01d85330f3bb19e2f9ce1","url":"https://api.github.com/repos/openai/codex/git/trees/256f9a5c6396db08dac01d85330f3bb19e2f9ce1"},"url":"https://api.github.com/repos/openai/codex/git/commits/41014b11bd0c9f73dfa979f8e84147f83e3c2a78","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/41014b11bd0c9f73dfa979f8e84147f83e3c2a78","html_url":"https://github.com/openai/codex/commit/41014b11bd0c9f73dfa979f8e84147f83e3c2a78","comments_url":"https://api.github.com/repos/openai/codex/commits/41014b11bd0c9f73dfa979f8e84147f83e3c2a78/comments","author":{"login":"evan-oai","id":257628848,"node_id":"U_kgDOD1sasA","avatar_url":"https://avatars.githubusercontent.com/u/257628848?v=4","gravatar_id":"","url":"https://api.github.com/users/evan-oai","html_url":"https://github.com/evan-oai","followers_url":"https://api.github.com/users/evan-oai/followers","following_url":"https://api.github.com/users/evan-oai/following{/other_user}","gists_url":"https://api.github.com/users/evan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/evan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/evan-oai/subscriptions","organizations_url":"https://api.github.com/users/evan-oai/orgs","repos_url":"https://api.github.com/users/evan-oai/repos","events_url":"https://api.github.com/users/evan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/evan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"2b1811e56201ba4c7a0b26fd1cf07a077d42d32f","url":"https://api.github.com/repos/openai/codex/commits/2b1811e56201ba4c7a0b26fd1cf07a077d42d32f","html_url":"https://github.com/openai/codex/commit/2b1811e56201ba4c7a0b26fd1cf07a077d42d32f"}]},{"sha":"2b1811e56201ba4c7a0b26fd1cf07a077d42d32f","node_id":"C_kwDOOYsS4doAKDJiMTgxMWU1NjIwMWJhNGM3YTBiMjZmZDFjZjA3YTA3N2Q0MmQzMmY","commit":{"author":{"name":"rka-oai","email":"rka@openai.com","date":"2026-08-07T19:26:18Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T19:32:15Z"},"message":"Include tool namespace inventory in turn metadata (#37492)\n\n## What changed\n\n- Add opt-in `tool_namespaces_info` metadata for Responses Lite turns when\n  `tool_registry.turn_metadata_includes_tool_info` is enabled.\n- Describe each model-visible function's namespace, direct and deferred\n  exposure, Code Mode name, and harness or MCP ownership.\n- Reject visible namespaces shared by different owners when strict collision\n  checking and tool inventory metadata are enabled.\n- Keep tool inventories out of compatibility headers and metadata sent to MCP\n  servers.\n\n## Testing\n\n- Cover opt-in behavior, MCP exposure details, namespace ownership collisions,\n  reserved metadata handling, and Responses Lite request serialization.\n\nGitOrigin-RevId: 6a6965d2ba98e29444fdfbb4ccec6aafcf0391e6","tree":{"sha":"9cd648fac1473056fec902c20d7b746978826f28","url":"https://api.github.com/repos/openai/codex/git/trees/9cd648fac1473056fec902c20d7b746978826f28"},"url":"https://api.github.com/repos/openai/codex/git/commits/2b1811e56201ba4c7a0b26fd1cf07a077d42d32f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/2b1811e56201ba4c7a0b26fd1cf07a077d42d32f","html_url":"https://github.com/openai/codex/commit/2b1811e56201ba4c7a0b26fd1cf07a077d42d32f","comments_url":"https://api.github.com/repos/openai/codex/commits/2b1811e56201ba4c7a0b26fd1cf07a077d42d32f/comments","author":{"login":"rka-oai","id":240799229,"node_id":"U_kgDODlpN_Q","avatar_url":"https://avatars.githubusercontent.com/u/240799229?v=4","gravatar_id":"","url":"https://api.github.com/users/rka-oai","html_url":"https://github.com/rka-oai","followers_url":"https://api.github.com/users/rka-oai/followers","following_url":"https://api.github.com/users/rka-oai/following{/other_user}","gists_url":"https://api.github.com/users/rka-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rka-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rka-oai/subscriptions","organizations_url":"https://api.github.com/users/rka-oai/orgs","repos_url":"https://api.github.com/users/rka-oai/repos","events_url":"https://api.github.com/users/rka-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rka-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"ba94150c2a63633e216c27292f8bb53ad7c75a52","url":"https://api.github.com/repos/openai/codex/commits/ba94150c2a63633e216c27292f8bb53ad7c75a52","html_url":"https://github.com/openai/codex/commit/ba94150c2a63633e216c27292f8bb53ad7c75a52"}]},{"sha":"ba94150c2a63633e216c27292f8bb53ad7c75a52","node_id":"C_kwDOOYsS4doAKGJhOTQxNTBjMmE2MzYzM2UyMTZjMjcyOTJmOGJiNTNhZDdjNzVhNTI","commit":{"author":{"name":"rphilizaire-openai","email":"rphilizaire@openai.com","date":"2026-08-07T18:58:52Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T19:09:46Z"},"message":"Alias resource-backed skill locators under context pressure (#37489)\n\n## Why\n\nLong executor and orchestrator resource identifiers can consume enough of the\nskills context budget to omit otherwise available skills.\n\n## What changed\n\n- Add source-aware root aliases for executor, orchestrator, and host skill\n  catalogs, including catalogs with a single shared root.\n- Select the best combination of aliased catalogs under the shared metadata\n  budget while accounting for root tables and alias usage instructions.\n- Explain how to expand shortened `skill://` locators and accept the resulting\n  description-shortening warning in app-server coverage.\n\n## Testing\n\n- Add rendering and production-turn coverage for singleton, executor,\n  orchestrator, host, and combined catalog aliases.\n\nGitOrigin-RevId: c1bc1f3d371eae9526232674060235272cc28f16","tree":{"sha":"e181a08bf91fc54e396acd48e1c0a85024a18e94","url":"https://api.github.com/repos/openai/codex/git/trees/e181a08bf91fc54e396acd48e1c0a85024a18e94"},"url":"https://api.github.com/repos/openai/codex/git/commits/ba94150c2a63633e216c27292f8bb53ad7c75a52","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/ba94150c2a63633e216c27292f8bb53ad7c75a52","html_url":"https://github.com/openai/codex/commit/ba94150c2a63633e216c27292f8bb53ad7c75a52","comments_url":"https://api.github.com/repos/openai/codex/commits/ba94150c2a63633e216c27292f8bb53ad7c75a52/comments","author":{"login":"rphilizaire-openai","id":200841089,"node_id":"U_kgDOC_iXgQ","avatar_url":"https://avatars.githubusercontent.com/u/200841089?v=4","gravatar_id":"","url":"https://api.github.com/users/rphilizaire-openai","html_url":"https://github.com/rphilizaire-openai","followers_url":"https://api.github.com/users/rphilizaire-openai/followers","following_url":"https://api.github.com/users/rphilizaire-openai/following{/other_user}","gists_url":"https://api.github.com/users/rphilizaire-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/rphilizaire-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rphilizaire-openai/subscriptions","organizations_url":"https://api.github.com/users/rphilizaire-openai/orgs","repos_url":"https://api.github.com/users/rphilizaire-openai/repos","events_url":"https://api.github.com/users/rphilizaire-openai/events{/privacy}","received_events_url":"https://api.github.com/users/rphilizaire-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"ce22ea9712aef301faa1c017f83bf06a43bb9580","url":"https://api.github.com/repos/openai/codex/commits/ce22ea9712aef301faa1c017f83bf06a43bb9580","html_url":"https://github.com/openai/codex/commit/ce22ea9712aef301faa1c017f83bf06a43bb9580"}]},{"sha":"ce22ea9712aef301faa1c017f83bf06a43bb9580","node_id":"C_kwDOOYsS4doAKGNlMjJlYTk3MTJhZWYzMDFmYWExYzAxN2Y4M2JmMDZhNDNiYjk1ODA","commit":{"author":{"name":"rphilizaire-openai","email":"rphilizaire@openai.com","date":"2026-08-07T18:58:52Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T19:04:39Z"},"message":"Generalize skill locator aliases across providers (#37488)\n\n## What changed\n\n- Compact executor and orchestrator skill locators under metadata pressure, using provider-specific `e` and `o` aliases alongside host `r` aliases.\n- Derive alias roots from executor discovery paths and orchestrator namespaces while preserving host plugin root handling.\n- Centralize alias ordering, deduplication, and longest-prefix matching across skill providers.\n\n## Testing\n\n- Cover alias planning, cross-platform executor roots, and host plugin discovery.\n\nGitOrigin-RevId: e7d15bd3891c08ae20170e96c4ad45c76d353707","tree":{"sha":"cb3cd13f337339d4e1869108ae40de681a5511a3","url":"https://api.github.com/repos/openai/codex/git/trees/cb3cd13f337339d4e1869108ae40de681a5511a3"},"url":"https://api.github.com/repos/openai/codex/git/commits/ce22ea9712aef301faa1c017f83bf06a43bb9580","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/ce22ea9712aef301faa1c017f83bf06a43bb9580","html_url":"https://github.com/openai/codex/commit/ce22ea9712aef301faa1c017f83bf06a43bb9580","comments_url":"https://api.github.com/repos/openai/codex/commits/ce22ea9712aef301faa1c017f83bf06a43bb9580/comments","author":{"login":"rphilizaire-openai","id":200841089,"node_id":"U_kgDOC_iXgQ","avatar_url":"https://avatars.githubusercontent.com/u/200841089?v=4","gravatar_id":"","url":"https://api.github.com/users/rphilizaire-openai","html_url":"https://github.com/rphilizaire-openai","followers_url":"https://api.github.com/users/rphilizaire-openai/followers","following_url":"https://api.github.com/users/rphilizaire-openai/following{/other_user}","gists_url":"https://api.github.com/users/rphilizaire-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/rphilizaire-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rphilizaire-openai/subscriptions","organizations_url":"https://api.github.com/users/rphilizaire-openai/orgs","repos_url":"https://api.github.com/users/rphilizaire-openai/repos","events_url":"https://api.github.com/users/rphilizaire-openai/events{/privacy}","received_events_url":"https://api.github.com/users/rphilizaire-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"27e4a05cd34f069ce043770b8e79969c992e87d4","url":"https://api.github.com/repos/openai/codex/commits/27e4a05cd34f069ce043770b8e79969c992e87d4","html_url":"https://github.com/openai/codex/commit/27e4a05cd34f069ce043770b8e79969c992e87d4"}]},{"sha":"27e4a05cd34f069ce043770b8e79969c992e87d4","node_id":"C_kwDOOYsS4doAKDI3ZTRhMDVjZDM0ZjA2OWNlMDQzNzcwYjhlNzk5NjljOTkyZTg3ZDQ","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-07T18:28:56Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T18:38:24Z"},"message":"Expose runtime activity in server diagnostics (#37486)\n\n## What changed\n\n- Add lifecycle-backed gauges for in-flight and queued app requests, pending server requests and mailbox messages, active turns, and live MCP connections.\n- Register each gauge on first use and decrement it when the tracked work or resource is dropped.\n- Document the new `server/diagnostics` gauge names and account for the diagnostics request itself in the response example and test.\n\nGitOrigin-RevId: 4bb82a3918af0b502d149b5d761ad669b2083f39","tree":{"sha":"ee3977e9d73aa391dbd177b4d71d1e1b4e5c62b8","url":"https://api.github.com/repos/openai/codex/git/trees/ee3977e9d73aa391dbd177b4d71d1e1b4e5c62b8"},"url":"https://api.github.com/repos/openai/codex/git/commits/27e4a05cd34f069ce043770b8e79969c992e87d4","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/27e4a05cd34f069ce043770b8e79969c992e87d4","html_url":"https://github.com/openai/codex/commit/27e4a05cd34f069ce043770b8e79969c992e87d4","comments_url":"https://api.github.com/repos/openai/codex/commits/27e4a05cd34f069ce043770b8e79969c992e87d4/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"5a0d0929e20cd819d046b8ca8f10d942b9b683cf","url":"https://api.github.com/repos/openai/codex/commits/5a0d0929e20cd819d046b8ca8f10d942b9b683cf","html_url":"https://github.com/openai/codex/commit/5a0d0929e20cd819d046b8ca8f10d942b9b683cf"}]},{"sha":"5a0d0929e20cd819d046b8ca8f10d942b9b683cf","node_id":"C_kwDOOYsS4doAKDVhMGQwOTI5ZTIwY2Q4MTlkMDQ2YjhjYThmMTBkOTQyYjliNjgzY2Y","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-07T18:25:30Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T18:33:46Z"},"message":"Keep response streams alive through connection failures (#37485)\n\n## What changed\n\n- Classify HTTP connection failures separately from other network errors without exposing request URLs.\n- For sampling requests, retry connection failures with exponential delays from 5 to 60 seconds and show a `Reconnecting... waiting for network` stream error.\n- Preserve the normal stream retry budget while waiting for the provider to become reachable. Keep the existing bounded retry behavior for other retryable errors.\n\n## Testing\n\n- Verify connection errors are classified without leaking URL contents.\n- Verify a turn recovers after its provider becomes reachable and still applies the configured retry limit to a subsequent incomplete stream.\n\nGitOrigin-RevId: 646553290c865a1332abd30c4a64ed9266bbfc6f","tree":{"sha":"c0ddf2a9215cab0d5d9f0bf4eb47b8c78173eac8","url":"https://api.github.com/repos/openai/codex/git/trees/c0ddf2a9215cab0d5d9f0bf4eb47b8c78173eac8"},"url":"https://api.github.com/repos/openai/codex/git/commits/5a0d0929e20cd819d046b8ca8f10d942b9b683cf","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/5a0d0929e20cd819d046b8ca8f10d942b9b683cf","html_url":"https://github.com/openai/codex/commit/5a0d0929e20cd819d046b8ca8f10d942b9b683cf","comments_url":"https://api.github.com/repos/openai/codex/commits/5a0d0929e20cd819d046b8ca8f10d942b9b683cf/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"509565820f90db39e2d19f12b8571f84a02b3b0e","url":"https://api.github.com/repos/openai/codex/commits/509565820f90db39e2d19f12b8571f84a02b3b0e","html_url":"https://github.com/openai/codex/commit/509565820f90db39e2d19f12b8571f84a02b3b0e"}]},{"sha":"509565820f90db39e2d19f12b8571f84a02b3b0e","node_id":"C_kwDOOYsS4doAKDUwOTU2NTgyMGY5MGRiMzllMmQxOWYxMmI4NTcxZjg0YTAyYjNiMGU","commit":{"author":{"name":"pakrym-oai","email":"pakrym@openai.com","date":"2026-08-07T18:17:38Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T18:22:42Z"},"message":"Interrupt active code-mode cells with their turn (#37483)\n\n## Why\n\nInterrupting a turn should also stop code-mode work that the turn left running.\n\n## What changed\n\n- Add the disabled-by-default `code_mode_interrupt` feature.\n- When an interrupted turn has the feature enabled, terminate all active code-mode cells and propagate cancellation through nested tool calls.\n- Keep the reusable code-mode session alive so its stored state remains available to later turns.\n\n## Testing\n\nAdd an integration test that interrupts a long-running nested tool, verifies that active and background cells are removed, and confirms that session state is preserved.\n\nGitOrigin-RevId: 2b8634776a89b636318a39b9e9ad2eefc07cead8","tree":{"sha":"f56d79d52a17eefbdf76fea3625ad4b1a94ec965","url":"https://api.github.com/repos/openai/codex/git/trees/f56d79d52a17eefbdf76fea3625ad4b1a94ec965"},"url":"https://api.github.com/repos/openai/codex/git/commits/509565820f90db39e2d19f12b8571f84a02b3b0e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/509565820f90db39e2d19f12b8571f84a02b3b0e","html_url":"https://github.com/openai/codex/commit/509565820f90db39e2d19f12b8571f84a02b3b0e","comments_url":"https://api.github.com/repos/openai/codex/commits/509565820f90db39e2d19f12b8571f84a02b3b0e/comments","author":{"login":"pakrym-oai","id":204937752,"node_id":"U_kgDODDcaGA","avatar_url":"https://avatars.githubusercontent.com/u/204937752?v=4","gravatar_id":"","url":"https://api.github.com/users/pakrym-oai","html_url":"https://github.com/pakrym-oai","followers_url":"https://api.github.com/users/pakrym-oai/followers","following_url":"https://api.github.com/users/pakrym-oai/following{/other_user}","gists_url":"https://api.github.com/users/pakrym-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/pakrym-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pakrym-oai/subscriptions","organizations_url":"https://api.github.com/users/pakrym-oai/orgs","repos_url":"https://api.github.com/users/pakrym-oai/repos","events_url":"https://api.github.com/users/pakrym-oai/events{/privacy}","received_events_url":"https://api.github.com/users/pakrym-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"511262b98445efbd7635253a0247611ebb0107b7","url":"https://api.github.com/repos/openai/codex/commits/511262b98445efbd7635253a0247611ebb0107b7","html_url":"https://github.com/openai/codex/commit/511262b98445efbd7635253a0247611ebb0107b7"}]},{"sha":"511262b98445efbd7635253a0247611ebb0107b7","node_id":"C_kwDOOYsS4doAKDUxMTI2MmI5ODQ0NWVmYmQ3NjM1MjUzYTAyNDc2MTFlYmIwMTA3Yjc","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-08-07T17:53:43Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T18:05:17Z"},"message":"Delegate remote process sandboxing to the executor (#37480)\n\n## What changed\n\n- Preserve executor-native working directories, workspace roots, and permission profiles when preparing remote `exec_command` requests instead of resolving them through the host platform.\n- Send sandbox intent to the remote executor, including a restricted-token default for Windows executors and `-NoProfile` for elevated PowerShell commands.\n- Reject intercepted cross-platform `apply_patch` commands when filesystem writes are restricted, while continuing to allow them for unsandboxed or full-disk-write profiles.\n\n## Testing\n\nExtended remote unified-exec coverage for foreign Windows workspaces, elevated PowerShell, sandbox metadata, and restricted and unrestricted intercepted patches.\n\nGitOrigin-RevId: 9fd328879fa2c15594fd58e40b6b32e8ba0847e7","tree":{"sha":"651af181191a2dff712003311cd7d7983af3c340","url":"https://api.github.com/repos/openai/codex/git/trees/651af181191a2dff712003311cd7d7983af3c340"},"url":"https://api.github.com/repos/openai/codex/git/commits/511262b98445efbd7635253a0247611ebb0107b7","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/511262b98445efbd7635253a0247611ebb0107b7","html_url":"https://github.com/openai/codex/commit/511262b98445efbd7635253a0247611ebb0107b7","comments_url":"https://api.github.com/repos/openai/codex/commits/511262b98445efbd7635253a0247611ebb0107b7/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"92fb33b7583ac909a21efaebcd2fad6e79643a6f","url":"https://api.github.com/repos/openai/codex/commits/92fb33b7583ac909a21efaebcd2fad6e79643a6f","html_url":"https://github.com/openai/codex/commit/92fb33b7583ac909a21efaebcd2fad6e79643a6f"}]},{"sha":"92fb33b7583ac909a21efaebcd2fad6e79643a6f","node_id":"C_kwDOOYsS4doAKDkyZmIzM2I3NTgzYWM5MDlhMjFlZmFlYmNkMmZhZDZlNzk2NDNhNmY","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-08-07T17:47:07Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T17:54:41Z"},"message":"Report temporary directories in exec-server environment info (#37479)\n\n## What changed\n\n- Add optional `temporaryDirectories` file URIs to `EnvironmentInfo` so clients can resolve `:tmpdir` against executor-local defaults.\n- Populate local environment info from `TMPDIR` on Unix and `TEMP`/`TMP` on Windows, resolving relative Unix paths against the working directory and removing duplicates.\n- Cover protocol round trips, platform environment discovery, relative Unix paths, and the exec-server response.\n\nGitOrigin-RevId: a41580f783b004011c064c7a4f9fdc7adf4fba10","tree":{"sha":"f22148e128c112f430313ae67e25ef10779533a3","url":"https://api.github.com/repos/openai/codex/git/trees/f22148e128c112f430313ae67e25ef10779533a3"},"url":"https://api.github.com/repos/openai/codex/git/commits/92fb33b7583ac909a21efaebcd2fad6e79643a6f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/92fb33b7583ac909a21efaebcd2fad6e79643a6f","html_url":"https://github.com/openai/codex/commit/92fb33b7583ac909a21efaebcd2fad6e79643a6f","comments_url":"https://api.github.com/repos/openai/codex/commits/92fb33b7583ac909a21efaebcd2fad6e79643a6f/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"204389afcc09301945f0b81a418ffd6145b8dadb","url":"https://api.github.com/repos/openai/codex/commits/204389afcc09301945f0b81a418ffd6145b8dadb","html_url":"https://github.com/openai/codex/commit/204389afcc09301945f0b81a418ffd6145b8dadb"}]},{"sha":"204389afcc09301945f0b81a418ffd6145b8dadb","node_id":"C_kwDOOYsS4doAKDIwNDM4OWFmY2MwOTMwMTk0NWYwYjgxYTQxOGZmZDYxNDViOGRhZGI","commit":{"author":{"name":"andrewgu-oai","email":"andrewgu@openai.com","date":"2026-08-07T17:38:43Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T17:49:48Z"},"message":"Shard state unit tests under Bazel (#37478)\n\n## Why\n\nWindows runs the state crate's database-heavy Rust tests serially within each\nshard.\n\n## What changed\n\nConfigure `state-unit-tests` to run across four Bazel shards.\n\nGitOrigin-RevId: f540f3c157734a2b9944bae9af554ad9dbc4a69b","tree":{"sha":"bcad8060651dba3370be03213e3b16d0dee909eb","url":"https://api.github.com/repos/openai/codex/git/trees/bcad8060651dba3370be03213e3b16d0dee909eb"},"url":"https://api.github.com/repos/openai/codex/git/commits/204389afcc09301945f0b81a418ffd6145b8dadb","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/204389afcc09301945f0b81a418ffd6145b8dadb","html_url":"https://github.com/openai/codex/commit/204389afcc09301945f0b81a418ffd6145b8dadb","comments_url":"https://api.github.com/repos/openai/codex/commits/204389afcc09301945f0b81a418ffd6145b8dadb/comments","author":{"login":"andrewgu-oai","id":312661362,"node_id":"U_kgDOEqLVcg","avatar_url":"https://avatars.githubusercontent.com/u/312661362?v=4","gravatar_id":"","url":"https://api.github.com/users/andrewgu-oai","html_url":"https://github.com/andrewgu-oai","followers_url":"https://api.github.com/users/andrewgu-oai/followers","following_url":"https://api.github.com/users/andrewgu-oai/following{/other_user}","gists_url":"https://api.github.com/users/andrewgu-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/andrewgu-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/andrewgu-oai/subscriptions","organizations_url":"https://api.github.com/users/andrewgu-oai/orgs","repos_url":"https://api.github.com/users/andrewgu-oai/repos","events_url":"https://api.github.com/users/andrewgu-oai/events{/privacy}","received_events_url":"https://api.github.com/users/andrewgu-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"248d8c0e2297ef0851832f593f8340b465044726","url":"https://api.github.com/repos/openai/codex/commits/248d8c0e2297ef0851832f593f8340b465044726","html_url":"https://github.com/openai/codex/commit/248d8c0e2297ef0851832f593f8340b465044726"}]},{"sha":"248d8c0e2297ef0851832f593f8340b465044726","node_id":"C_kwDOOYsS4doAKDI0OGQ4YzBlMjI5N2VmMDg1MTgzMmY1OTNmODM0MGI0NjUwNDQ3MjY","commit":{"author":{"name":"tongzhou wang","email":"tz@openai.com","date":"2026-08-07T17:35:59Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T17:44:05Z"},"message":"Include call IDs in MCP requests and clarify metadata config (#37477)\n\n## What changed\n\n- Add the tool call ID to `_meta.callId` for every MCP tool request.\n- Rename `features.tool_registry.include_tool_metadata` to\n  `features.tool_registry.turn_metadata_includes_tool_info` to clarify that the\n  setting controls authoritative tool information in per-turn metadata.\n- Update config parsing, schema generation, and session config locking for the\n  renamed setting.\n\n## Testing\n\n- Cover `callId` metadata for custom, plugin, and Codex Apps MCP calls.\n- Update strict-config, config-loading, feature-config, and config-lock tests for\n  the renamed setting.\n\nGitOrigin-RevId: ac0e58c489b03bd9b55a356f545de86c8ecaf865","tree":{"sha":"8eb45b437277ccb0ed82941fa8a7eb6146e72d44","url":"https://api.github.com/repos/openai/codex/git/trees/8eb45b437277ccb0ed82941fa8a7eb6146e72d44"},"url":"https://api.github.com/repos/openai/codex/git/commits/248d8c0e2297ef0851832f593f8340b465044726","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/248d8c0e2297ef0851832f593f8340b465044726","html_url":"https://github.com/openai/codex/commit/248d8c0e2297ef0851832f593f8340b465044726","comments_url":"https://api.github.com/repos/openai/codex/commits/248d8c0e2297ef0851832f593f8340b465044726/comments","author":{"login":"tz-openai","id":191285271,"node_id":"U_kgDOC2bIFw","avatar_url":"https://avatars.githubusercontent.com/u/191285271?v=4","gravatar_id":"","url":"https://api.github.com/users/tz-openai","html_url":"https://github.com/tz-openai","followers_url":"https://api.github.com/users/tz-openai/followers","following_url":"https://api.github.com/users/tz-openai/following{/other_user}","gists_url":"https://api.github.com/users/tz-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/tz-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tz-openai/subscriptions","organizations_url":"https://api.github.com/users/tz-openai/orgs","repos_url":"https://api.github.com/users/tz-openai/repos","events_url":"https://api.github.com/users/tz-openai/events{/privacy}","received_events_url":"https://api.github.com/users/tz-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"572954683910555cbbe3034bc8a2a0aa2bc7e66a","url":"https://api.github.com/repos/openai/codex/commits/572954683910555cbbe3034bc8a2a0aa2bc7e66a","html_url":"https://github.com/openai/codex/commit/572954683910555cbbe3034bc8a2a0aa2bc7e66a"}]},{"sha":"572954683910555cbbe3034bc8a2a0aa2bc7e66a","node_id":"C_kwDOOYsS4doAKDU3Mjk1NDY4MzkxMDU1NWNiYmUzMDM0YmM4YTJhMGFhMmJjN2U2NmE","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-07T16:52:31Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T16:57:47Z"},"message":"Expose app-server diagnostics through the experimental API (#37470)\n\n## What changed\n\n- Add the experimental `server/diagnostics` request, returning the app-server process ID, resident memory, platform-dependent physical footprint, and registered diagnostic gauges.\n- Export the new protocol types in the generated JSON and TypeScript schemas and document the request.\n\n## Testing\n\n- Verify the response includes process measurements and the registered live-thread gauge.\n- Verify the request is rejected unless `capabilities.experimentalApi` is enabled.\n\nGitOrigin-RevId: 099d60a9c421a74ff1a72fe524e0dfeb89cf1057","tree":{"sha":"1feeae78ed849ac71ccbc0547d7a471653e6707b","url":"https://api.github.com/repos/openai/codex/git/trees/1feeae78ed849ac71ccbc0547d7a471653e6707b"},"url":"https://api.github.com/repos/openai/codex/git/commits/572954683910555cbbe3034bc8a2a0aa2bc7e66a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/572954683910555cbbe3034bc8a2a0aa2bc7e66a","html_url":"https://github.com/openai/codex/commit/572954683910555cbbe3034bc8a2a0aa2bc7e66a","comments_url":"https://api.github.com/repos/openai/codex/commits/572954683910555cbbe3034bc8a2a0aa2bc7e66a/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"b3278e96cb6df4b77b8dd93cf6c65d74990a033d","url":"https://api.github.com/repos/openai/codex/commits/b3278e96cb6df4b77b8dd93cf6c65d74990a033d","html_url":"https://github.com/openai/codex/commit/b3278e96cb6df4b77b8dd93cf6c65d74990a033d"}]},{"sha":"b3278e96cb6df4b77b8dd93cf6c65d74990a033d","node_id":"C_kwDOOYsS4doAKGIzMjc4ZTk2Y2I2ZGY0Yjc3YjhkZDkzY2Y2YzY1ZDc0OTkwYTAzM2Q","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-07T16:15:02Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T16:20:38Z"},"message":"Move skill config rule resolution into `codex-config` (#37466)\n\n## What changed\n\n- Define skill config selectors, ordered rules, and layer-stack parsing in `codex-config`.\n- Resolve disabled skill paths from generic skill name/path pairs, so configuration logic no longer depends on `SkillMetadata`.\n- Update plugin and host skill consumers to use the `codex-config` API and consolidate the rule tests with the skill config tests.\n\nGitOrigin-RevId: 3fe67869708df2652befe28d58cdeba933256f84","tree":{"sha":"db0f1560e009964c15230ea9f1e10089a1518da0","url":"https://api.github.com/repos/openai/codex/git/trees/db0f1560e009964c15230ea9f1e10089a1518da0"},"url":"https://api.github.com/repos/openai/codex/git/commits/b3278e96cb6df4b77b8dd93cf6c65d74990a033d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/b3278e96cb6df4b77b8dd93cf6c65d74990a033d","html_url":"https://github.com/openai/codex/commit/b3278e96cb6df4b77b8dd93cf6c65d74990a033d","comments_url":"https://api.github.com/repos/openai/codex/commits/b3278e96cb6df4b77b8dd93cf6c65d74990a033d/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"3b366654f1de1b77587ffb026c8f35507f3fe4ef","url":"https://api.github.com/repos/openai/codex/commits/3b366654f1de1b77587ffb026c8f35507f3fe4ef","html_url":"https://github.com/openai/codex/commit/3b366654f1de1b77587ffb026c8f35507f3fe4ef"}]},{"sha":"3b366654f1de1b77587ffb026c8f35507f3fe4ef","node_id":"C_kwDOOYsS4doAKDNiMzY2NjU0ZjFkZTFiNzc1ODdmZmIwMjZjOGYzNTUwN2YzZmU0ZWY","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-07T15:31:47Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T15:38:22Z"},"message":"Remove the unused remote skills client (#37461)\n\n## What changed\n\n- Remove the unused `core-skills` client for listing and exporting remote\n  skills.\n- Remove its `codex-core-skills` and `codex-core` exports and dependencies that\n  are no longer needed.\n\nGitOrigin-RevId: 747f760dc97da3d4dea10d619a2341f43410d0bf","tree":{"sha":"99e9c150f03b76baac9216dc329350d75b91a02d","url":"https://api.github.com/repos/openai/codex/git/trees/99e9c150f03b76baac9216dc329350d75b91a02d"},"url":"https://api.github.com/repos/openai/codex/git/commits/3b366654f1de1b77587ffb026c8f35507f3fe4ef","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/3b366654f1de1b77587ffb026c8f35507f3fe4ef","html_url":"https://github.com/openai/codex/commit/3b366654f1de1b77587ffb026c8f35507f3fe4ef","comments_url":"https://api.github.com/repos/openai/codex/commits/3b366654f1de1b77587ffb026c8f35507f3fe4ef/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"33e365b19e4a7023b9b3ed74b57aa11748165a53","url":"https://api.github.com/repos/openai/codex/commits/33e365b19e4a7023b9b3ed74b57aa11748165a53","html_url":"https://github.com/openai/codex/commit/33e365b19e4a7023b9b3ed74b57aa11748165a53"}]},{"sha":"33e365b19e4a7023b9b3ed74b57aa11748165a53","node_id":"C_kwDOOYsS4doAKDMzZTM2NWIxOWU0YTcwMjNiOWIzZWQ3NGI1N2FhMTE3NDgxNjVhNTM","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-07T15:04:25Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T15:16:06Z"},"message":"Remove the legacy core skill loader (#37457)\n\n## What changed\n\n- Use `HostSkillRoot` throughout host root resolution and loading, including plugin roots.\n- Remove the duplicate loader, root snapshot, and product-filtering implementation from `core-skills` now that loading is owned by the skills extension.\n- Move and expand loader coverage for discovery, namespaces, filesystem routing, root merging, symlinks, and frontmatter parsing.\n\n## Testing\n\n- Added focused unit and integration tests under `ext/skills` and `skills` for the consolidated loader behavior.\n\nGitOrigin-RevId: 214d06d59bf3033ee0f220ea5959ee4feff66782","tree":{"sha":"edfcea638220a4e8294b7974208873e47a1bb91c","url":"https://api.github.com/repos/openai/codex/git/trees/edfcea638220a4e8294b7974208873e47a1bb91c"},"url":"https://api.github.com/repos/openai/codex/git/commits/33e365b19e4a7023b9b3ed74b57aa11748165a53","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/33e365b19e4a7023b9b3ed74b57aa11748165a53","html_url":"https://github.com/openai/codex/commit/33e365b19e4a7023b9b3ed74b57aa11748165a53","comments_url":"https://api.github.com/repos/openai/codex/commits/33e365b19e4a7023b9b3ed74b57aa11748165a53/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c5d94319715d2598a2e8b2b7d0e21a3b1e83aec6","url":"https://api.github.com/repos/openai/codex/commits/c5d94319715d2598a2e8b2b7d0e21a3b1e83aec6","html_url":"https://github.com/openai/codex/commit/c5d94319715d2598a2e8b2b7d0e21a3b1e83aec6"}]},{"sha":"c5d94319715d2598a2e8b2b7d0e21a3b1e83aec6","node_id":"C_kwDOOYsS4doAKGM1ZDk0MzE5NzE1ZDI1OThhMmU4YjJiN2QwZTIxYTNiMWU4M2FlYzY","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-07T14:29:14Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T14:35:42Z"},"message":"Unify plugin skill loading through the shared loader (#37452)\n\n## What changed\n\n- Route plugin inventory loading and capability summaries through the injected\n  `SkillRootLoader`.\n- Preserve recursive discovery for legacy plugins while restricting agent-plugin\n  skill discovery to direct children of the skills root.\n\n## Testing\n\n- Verify `plugin/read` excludes nested agent-plugin skills.\n- Verify installed agent-plugin telemetry reports skills only for portable,\n  direct-child layouts.\n\nGitOrigin-RevId: 9e78dd0c70a632d510c780963a6ceb3ad4bc2522","tree":{"sha":"b73c508503ba02d6c6a0f282abb52cf4c8121135","url":"https://api.github.com/repos/openai/codex/git/trees/b73c508503ba02d6c6a0f282abb52cf4c8121135"},"url":"https://api.github.com/repos/openai/codex/git/commits/c5d94319715d2598a2e8b2b7d0e21a3b1e83aec6","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c5d94319715d2598a2e8b2b7d0e21a3b1e83aec6","html_url":"https://github.com/openai/codex/commit/c5d94319715d2598a2e8b2b7d0e21a3b1e83aec6","comments_url":"https://api.github.com/repos/openai/codex/commits/c5d94319715d2598a2e8b2b7d0e21a3b1e83aec6/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a9d59d8b8e4bcafc8425bee7c373cb8394a85e9b","url":"https://api.github.com/repos/openai/codex/commits/a9d59d8b8e4bcafc8425bee7c373cb8394a85e9b","html_url":"https://github.com/openai/codex/commit/a9d59d8b8e4bcafc8425bee7c373cb8394a85e9b"}]},{"sha":"a9d59d8b8e4bcafc8425bee7c373cb8394a85e9b","node_id":"C_kwDOOYsS4doAKGE5ZDU5ZDhiOGU0YmNhZmM4NDI1YmVlN2MzNzNjYjgzOTRhODVlOWI","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-07T14:10:23Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T14:17:14Z"},"message":"Respect plugin skill availability in tool suggestions (#37447)\n\n## Why\n\nPlugin suggestions should report skills only when the plugin has an enabled skill.\n\n## What changed\n\n- Load suggestion metadata through the shared plugin skill-root loader.\n- Apply skill configuration when setting `has_skills` on suggestion candidates.\n\n## Testing\n\nAdded coverage for local plugin suggestions with the plugin skill both enabled and disabled.\n\nGitOrigin-RevId: bceb14528c9042b474eaad6efaf919bef72e0ca4","tree":{"sha":"b141294d8ce444a9e5014c91d7eb1ce6d05778c7","url":"https://api.github.com/repos/openai/codex/git/trees/b141294d8ce444a9e5014c91d7eb1ce6d05778c7"},"url":"https://api.github.com/repos/openai/codex/git/commits/a9d59d8b8e4bcafc8425bee7c373cb8394a85e9b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a9d59d8b8e4bcafc8425bee7c373cb8394a85e9b","html_url":"https://github.com/openai/codex/commit/a9d59d8b8e4bcafc8425bee7c373cb8394a85e9b","comments_url":"https://api.github.com/repos/openai/codex/commits/a9d59d8b8e4bcafc8425bee7c373cb8394a85e9b/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"964a227d8cda5ea4b8cb091b571a7a15a4e22b2b","url":"https://api.github.com/repos/openai/codex/commits/964a227d8cda5ea4b8cb091b571a7a15a4e22b2b","html_url":"https://github.com/openai/codex/commit/964a227d8cda5ea4b8cb091b571a7a15a4e22b2b"}]},{"sha":"964a227d8cda5ea4b8cb091b571a7a15a4e22b2b","node_id":"C_kwDOOYsS4doAKDk2NGEyMjdkOGNkYTVlYTRiOGNiMDkxYjU3MWE3YTE1YTRlMjJiMmI","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-07T13:59:22Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T14:08:13Z"},"message":"Preserve base instruction provenance across sessions (#37446)\n\n## Why\n\nPersisted base instructions need to retain whether they were explicitly customized or generated from a model template. Without that distinction, forks and config-lock replays can treat model-generated instructions as custom and keep the wrong template after a model or personality change.\n\n## What changed\n\n- Record custom or model provenance with base instructions in rollouts and config locks.\n- Preserve custom instructions across model changes, while allowing model-generated instructions to follow the selected model and personality.\n- Keep legacy rollouts without provenance compatible and propagate provenance through forks and spawned agents.\n\n## Testing\n\n- Cover provenance serialization and legacy rollout decoding.\n- Cover role personality changes, forked model changes, config-lock replay, and multi-agent configuration.\n\nGitOrigin-RevId: 801c26559835f558027ce5112700c0cd31fcb21b","tree":{"sha":"0e83b867f1223a1b859b080e5eb99e7bfc77c1a5","url":"https://api.github.com/repos/openai/codex/git/trees/0e83b867f1223a1b859b080e5eb99e7bfc77c1a5"},"url":"https://api.github.com/repos/openai/codex/git/commits/964a227d8cda5ea4b8cb091b571a7a15a4e22b2b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/964a227d8cda5ea4b8cb091b571a7a15a4e22b2b","html_url":"https://github.com/openai/codex/commit/964a227d8cda5ea4b8cb091b571a7a15a4e22b2b","comments_url":"https://api.github.com/repos/openai/codex/commits/964a227d8cda5ea4b8cb091b571a7a15a4e22b2b/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"e58d9ef447785d4e81718dc11c2bcce14782fa8a","url":"https://api.github.com/repos/openai/codex/commits/e58d9ef447785d4e81718dc11c2bcce14782fa8a","html_url":"https://github.com/openai/codex/commit/e58d9ef447785d4e81718dc11c2bcce14782fa8a"}]},{"sha":"e58d9ef447785d4e81718dc11c2bcce14782fa8a","node_id":"C_kwDOOYsS4doAKGU1OGQ5ZWY0NDc3ODVkNGU4MTcxOGRjMTFjMmJjY2UxNDc4MmZhOGE","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-07T13:47:56Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T13:54:24Z"},"message":"Unify plugin skill loading with the host skill service (#37444)\n\n## What changed\n\n- Inject the host skill loader into `PluginsManager` so plugin discovery and agent turns use the same loading and product-policy behavior.\n- Share plugin skill snapshots across those paths, preserving a consistent view of skills across workspaces.\n- Apply migrated-command precedence after product filtering, allowing an eligible migrated command to replace a filtered native skill with the same name.\n\n## Testing\n\n- Add coverage for product-restricted plugin skills, native-versus-migrated command precedence, and the skills exposed to agent turns.\n\nGitOrigin-RevId: f5ef0d0766ebeeb30d73ffaf044d003c2906ea4d","tree":{"sha":"e77fbccb504af33f0942295e10debe82f6761a0f","url":"https://api.github.com/repos/openai/codex/git/trees/e77fbccb504af33f0942295e10debe82f6761a0f"},"url":"https://api.github.com/repos/openai/codex/git/commits/e58d9ef447785d4e81718dc11c2bcce14782fa8a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/e58d9ef447785d4e81718dc11c2bcce14782fa8a","html_url":"https://github.com/openai/codex/commit/e58d9ef447785d4e81718dc11c2bcce14782fa8a","comments_url":"https://api.github.com/repos/openai/codex/commits/e58d9ef447785d4e81718dc11c2bcce14782fa8a/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"e75a1888d7e91ce56fc90d0edd32a9e6a8974686","url":"https://api.github.com/repos/openai/codex/commits/e75a1888d7e91ce56fc90d0edd32a9e6a8974686","html_url":"https://github.com/openai/codex/commit/e75a1888d7e91ce56fc90d0edd32a9e6a8974686"}]},{"sha":"e75a1888d7e91ce56fc90d0edd32a9e6a8974686","node_id":"C_kwDOOYsS4doAKGU3NWExODg4ZDdlOTFjZTU2ZmM5MGQwZWRkMzJhOWU2YTg5NzQ2ODY","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-07T13:18:16Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T13:23:23Z"},"message":"Load plugin skill roots through the host skills service (#37440)\n\n## What changed\n\n- Implement `SkillRootLoader<PluginSkillRoot>` for `HostSkillsService`.\n- Load roots concurrently while preserving request order, product restrictions, cached snapshots, skill errors, and per-skill filesystem metadata.\n- Deduplicate overlapping roots and prefer native plugin skills over migrated commands with the same plugin ID and skill name.\n\n## Testing\n\n- Cover native and migrated skill precedence, nested and overlapping roots, product filtering, snapshot reuse, error propagation, and symlinked migration roots.\n\nGitOrigin-RevId: 2270d10616b3a0463852c563ee071c524cd11e6b","tree":{"sha":"fcbf2df432538623be96cfc8c704009f23074a58","url":"https://api.github.com/repos/openai/codex/git/trees/fcbf2df432538623be96cfc8c704009f23074a58"},"url":"https://api.github.com/repos/openai/codex/git/commits/e75a1888d7e91ce56fc90d0edd32a9e6a8974686","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/e75a1888d7e91ce56fc90d0edd32a9e6a8974686","html_url":"https://github.com/openai/codex/commit/e75a1888d7e91ce56fc90d0edd32a9e6a8974686","comments_url":"https://api.github.com/repos/openai/codex/commits/e75a1888d7e91ce56fc90d0edd32a9e6a8974686/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a4b129eb3e1a6929c09d6e2e1af0638122c56f0d","url":"https://api.github.com/repos/openai/codex/commits/a4b129eb3e1a6929c09d6e2e1af0638122c56f0d","html_url":"https://github.com/openai/codex/commit/a4b129eb3e1a6929c09d6e2e1af0638122c56f0d"}]},{"sha":"a4b129eb3e1a6929c09d6e2e1af0638122c56f0d","node_id":"C_kwDOOYsS4doAKGE0YjEyOWViM2UxYTY5MjljMDlkNmUyZTFhZjA2MzgxMjJjNTZmMGQ","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-07T12:41:51Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T12:47:14Z"},"message":"Add shared skill root loading interfaces (#37439)\n\n## What changed\n\n- Add `SkillRootLoader` and its request/result types to `codex-skills` so skill roots can be loaded through a shared, object-safe interface.\n- Add owner-managed snapshot cache handles that support reuse and use cache allocation identity for equality and hashing.\n- Move `SkillError` into `codex-skills` and re-export the new loading API.\n\n## Testing\n\n- Verify snapshot sharing and identity semantics.\n- Verify loaders can be used as shared trait objects.\n\nGitOrigin-RevId: a26a8101008a6c862824a7346cdbe6d05f4bcc01","tree":{"sha":"559a6b0d4afb8a2e7ff08eb1ea2ffc4a7afd0035","url":"https://api.github.com/repos/openai/codex/git/trees/559a6b0d4afb8a2e7ff08eb1ea2ffc4a7afd0035"},"url":"https://api.github.com/repos/openai/codex/git/commits/a4b129eb3e1a6929c09d6e2e1af0638122c56f0d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a4b129eb3e1a6929c09d6e2e1af0638122c56f0d","html_url":"https://github.com/openai/codex/commit/a4b129eb3e1a6929c09d6e2e1af0638122c56f0d","comments_url":"https://api.github.com/repos/openai/codex/commits/a4b129eb3e1a6929c09d6e2e1af0638122c56f0d/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a7dcd20d3895ec4c9cbdde534745bbffbc2d2e28","url":"https://api.github.com/repos/openai/codex/commits/a7dcd20d3895ec4c9cbdde534745bbffbc2d2e28","html_url":"https://github.com/openai/codex/commit/a7dcd20d3895ec4c9cbdde534745bbffbc2d2e28"}]},{"sha":"a7dcd20d3895ec4c9cbdde534745bbffbc2d2e28","node_id":"C_kwDOOYsS4doAKGE3ZGNkMjBkMzg5NWVjNGM5Y2JkZGU1MzQ3NDViYmZmYmMyZDJlMjg","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-07T11:21:54Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T11:30:17Z"},"message":"Add process diagnostics snapshots (#37434)\n\n## What changed\n\n- Add a `codex-diagnostics` crate that snapshots the process ID, available\n  resident-memory measurements, and registered process-wide gauges.\n- Provide guards that update gauges for the lifetime of measured objects.\n- Track live `CodexThread` instances with the `core.threads.live` gauge.\n\n## Testing\n\n- Add unit coverage for gauge registration, guard lifetimes, process memory\n  snapshots, and live-thread reporting.\n\nGitOrigin-RevId: 3236b086bd4ebe31ed4768ab87a5fa288b0891b0","tree":{"sha":"83e561a42c49427bb9565f3efaeb0af123a8bd1d","url":"https://api.github.com/repos/openai/codex/git/trees/83e561a42c49427bb9565f3efaeb0af123a8bd1d"},"url":"https://api.github.com/repos/openai/codex/git/commits/a7dcd20d3895ec4c9cbdde534745bbffbc2d2e28","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a7dcd20d3895ec4c9cbdde534745bbffbc2d2e28","html_url":"https://github.com/openai/codex/commit/a7dcd20d3895ec4c9cbdde534745bbffbc2d2e28","comments_url":"https://api.github.com/repos/openai/codex/commits/a7dcd20d3895ec4c9cbdde534745bbffbc2d2e28/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"51e36d2ec23c0eff710053d28c400d447500a41a","url":"https://api.github.com/repos/openai/codex/commits/51e36d2ec23c0eff710053d28c400d447500a41a","html_url":"https://github.com/openai/codex/commit/51e36d2ec23c0eff710053d28c400d447500a41a"}]},{"sha":"51e36d2ec23c0eff710053d28c400d447500a41a","node_id":"C_kwDOOYsS4doAKDUxZTM2ZDJlYzIzYzBlZmY3MTAwNTNkMjhjNDAwZDQ0NzUwMGE0MWE","commit":{"author":{"name":"acrognale-oai","email":"acrognale@openai.com","date":"2026-08-07T11:19:57Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T11:26:01Z"},"message":"Expose multi-agent versions in model/list (#37433)\n\n## What changed\n\n- Add nullable `multiAgentVersion` metadata to v2 `model/list` responses.\n- Represent supported values as `disabled`, `v1`, or `v2` in the Rust API and generated JSON Schema and TypeScript exports.\n- Forward the value from model catalog presets through app-server responses.\n\n## Testing\n\n- Extend the remote model catalog test fixture with a `v2` multi-agent version.\n\nGitOrigin-RevId: bd3b2bbe0a3b562b4d1f03df7da2a73a35713978","tree":{"sha":"171697bc17d38345d33c68027e70f2a581edc197","url":"https://api.github.com/repos/openai/codex/git/trees/171697bc17d38345d33c68027e70f2a581edc197"},"url":"https://api.github.com/repos/openai/codex/git/commits/51e36d2ec23c0eff710053d28c400d447500a41a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/51e36d2ec23c0eff710053d28c400d447500a41a","html_url":"https://github.com/openai/codex/commit/51e36d2ec23c0eff710053d28c400d447500a41a","comments_url":"https://api.github.com/repos/openai/codex/commits/51e36d2ec23c0eff710053d28c400d447500a41a/comments","author":{"login":"acrognale-oai","id":256206888,"node_id":"U_kgDOD0VoKA","avatar_url":"https://avatars.githubusercontent.com/u/256206888?v=4","gravatar_id":"","url":"https://api.github.com/users/acrognale-oai","html_url":"https://github.com/acrognale-oai","followers_url":"https://api.github.com/users/acrognale-oai/followers","following_url":"https://api.github.com/users/acrognale-oai/following{/other_user}","gists_url":"https://api.github.com/users/acrognale-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/acrognale-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/acrognale-oai/subscriptions","organizations_url":"https://api.github.com/users/acrognale-oai/orgs","repos_url":"https://api.github.com/users/acrognale-oai/repos","events_url":"https://api.github.com/users/acrognale-oai/events{/privacy}","received_events_url":"https://api.github.com/users/acrognale-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"85e0661c3baacc62db7b006d2b8085b006d0795e","url":"https://api.github.com/repos/openai/codex/commits/85e0661c3baacc62db7b006d2b8085b006d0795e","html_url":"https://github.com/openai/codex/commit/85e0661c3baacc62db7b006d2b8085b006d0795e"}]},{"sha":"85e0661c3baacc62db7b006d2b8085b006d0795e","node_id":"C_kwDOOYsS4doAKDg1ZTA2NjFjM2JhYWNjNjJkYjdiMDA2ZDJiODA4NWIwMDZkMDc5NWU","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-07T09:44:53Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T09:50:43Z"},"message":"Cap project instructions across environments (#37424)\n\n## Why\n\nApplying `project_doc_max_bytes` independently to every selected environment\nallows the total project instruction payload to grow with the number of\nenvironments.\n\n## What changed\n\nTreat `project_doc_max_bytes` as one shared byte budget. Consume it in selected\nenvironment order, truncate the entry that reaches the remaining limit, and\nskip later environments once the budget is exhausted.\n\nUpdate the configuration descriptions to document the aggregate limit.\n\n## Testing\n\nAdd unit and integration coverage for partial and exhausted budgets across\nmultiple environments.\n\nGitOrigin-RevId: 4664bdf1f23b66986349d503f44cf51560b9024f","tree":{"sha":"4a19d66885739dd2da60e7c8d8ed27b7ed7aba74","url":"https://api.github.com/repos/openai/codex/git/trees/4a19d66885739dd2da60e7c8d8ed27b7ed7aba74"},"url":"https://api.github.com/repos/openai/codex/git/commits/85e0661c3baacc62db7b006d2b8085b006d0795e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/85e0661c3baacc62db7b006d2b8085b006d0795e","html_url":"https://github.com/openai/codex/commit/85e0661c3baacc62db7b006d2b8085b006d0795e","comments_url":"https://api.github.com/repos/openai/codex/commits/85e0661c3baacc62db7b006d2b8085b006d0795e/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"95c7265e849e6e360a7fa53ffeac70b25d6051a3","url":"https://api.github.com/repos/openai/codex/commits/95c7265e849e6e360a7fa53ffeac70b25d6051a3","html_url":"https://github.com/openai/codex/commit/95c7265e849e6e360a7fa53ffeac70b25d6051a3"}]},{"sha":"95c7265e849e6e360a7fa53ffeac70b25d6051a3","node_id":"C_kwDOOYsS4doAKDk1YzcyNjVlODQ5ZTZlMzYwYTdmYTUzZmZlYWM3MGIyNWQ2MDUxYTM","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-08-07T08:23:01Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T08:32:30Z"},"message":"Add executor-local config reads to the exec server (#37408)\n\n## What changed\n\n- Add the `environmentConfig/read` RPC for selecting literal TOML paths from executor-local config and requirements layers.\n- Return layer precedence, cloud insertion points, source and base-directory metadata, and executor home and hostname context without normalizing path-bearing values.\n- Expose the operation through both remote clients and local `Environment` instances, with invalid selectors reported as invalid parameters.\n\n## Testing\n\n- Cover projected remote config reads and rejection of empty selectors.\n\nGitOrigin-RevId: fee15bf833de6bcb2058d405ed5b1d5d928d7218","tree":{"sha":"3503e9ef04e992e643d3c9deec219c7d2f83ebc0","url":"https://api.github.com/repos/openai/codex/git/trees/3503e9ef04e992e643d3c9deec219c7d2f83ebc0"},"url":"https://api.github.com/repos/openai/codex/git/commits/95c7265e849e6e360a7fa53ffeac70b25d6051a3","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/95c7265e849e6e360a7fa53ffeac70b25d6051a3","html_url":"https://github.com/openai/codex/commit/95c7265e849e6e360a7fa53ffeac70b25d6051a3","comments_url":"https://api.github.com/repos/openai/codex/commits/95c7265e849e6e360a7fa53ffeac70b25d6051a3/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"957f8eedee0d9b1de94b2d9ee18af522b701d80b","url":"https://api.github.com/repos/openai/codex/commits/957f8eedee0d9b1de94b2d9ee18af522b701d80b","html_url":"https://github.com/openai/codex/commit/957f8eedee0d9b1de94b2d9ee18af522b701d80b"}]},{"sha":"957f8eedee0d9b1de94b2d9ee18af522b701d80b","node_id":"C_kwDOOYsS4doAKDk1N2Y4ZWVkZWUwZDliMWRlOTRiMmQ5ZWUxOGFmNTIyYjcwMWQ4MGI","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-08-07T08:23:00Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-07T08:28:10Z"},"message":"Add a loader for executor-local config layers (#37406)\n\n## What changed\n\n- Add `load_local_config_layers` to return raw configuration and requirements layers with their sources, base directories, precedence order, and cloud insertion positions.\n- Support projecting layer stacks to selected TOML paths while preserving non-table override blockers and adjusting cloud insertion positions when empty layers are removed.\n- Reuse project discovery and trust handling for local reads, including linked-worktree hooks, without resolving relative paths or including profiles, session flags, thread layers, or cloud-provided values.\n\n## Testing\n\n- Cover layer ordering, raw relative paths, legacy requirements, trust filtering, projection semantics, and untrusted linked-worktree hook handling.\n\nGitOrigin-RevId: a1098af5650ac44e5a230ba9a5fe918927986d05","tree":{"sha":"a8cfdd02409730b18e67cf2baf89bbebdd382d12","url":"https://api.github.com/repos/openai/codex/git/trees/a8cfdd02409730b18e67cf2baf89bbebdd382d12"},"url":"https://api.github.com/repos/openai/codex/git/commits/957f8eedee0d9b1de94b2d9ee18af522b701d80b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/957f8eedee0d9b1de94b2d9ee18af522b701d80b","html_url":"https://github.com/openai/codex/commit/957f8eedee0d9b1de94b2d9ee18af522b701d80b","comments_url":"https://api.github.com/repos/openai/codex/commits/957f8eedee0d9b1de94b2d9ee18af522b701d80b/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c87a218bd3e7ee0a0181109b3ff7bbc2156de13e","url":"https://api.github.com/repos/openai/codex/commits/c87a218bd3e7ee0a0181109b3ff7bbc2156de13e","html_url":"https://github.com/openai/codex/commit/c87a218bd3e7ee0a0181109b3ff7bbc2156de13e"}]}]