codex/commit/ca2e343f6564faaf740f50a0cf27b2092b6c40fd","comments_url":"https://api.github.com/repos/openai/codex/commits/ca2e343f6564faaf740f50a0cf27b2092b6c40fd/comments","author":{"login":"celia-oai","id":209693228,"node_id":"U_kgDODH-qLA","avatar_url":"https://avatars.githubusercontent.com/u/209693228?v=4","gravatar_id":"","url":"https://api.github.com/users/celia-oai","html_url":"https://github.com/celia-oai","followers_url":"https://api.github.com/users/celia-oai/followers","following_url":"https://api.github.com/users/celia-oai/following{/other_user}","gists_url":"https://api.github.com/users/celia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/celia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celia-oai/subscriptions","organizations_url":"https://api.github.com/users/celia-oai/orgs","repos_url":"https://api.github.com/users/celia-oai/repos","events_url":"https://api.github.com/users/celia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/celia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e88626621bad4bb2655fa8b5fc7d2f73d68e168d","url":"https://api.github.com/repos/openai/codex/commits/e88626621bad4bb2655fa8b5fc7d2f73d68e168d","html_url":"https://github.com/openai/codex/commit/e88626621bad4bb2655fa8b5fc7d2f73d68e168d"}]},{"sha":"e88626621bad4bb2655fa8b5fc7d2f73d68e168d","node_id":"C_kwDOOYsS4doAKGU4ODYyNjYyMWJhZDRiYjI2NTVmYThiNWZjN2QyZjczZDY4ZTE2OGQ","commit":{"author":{"name":"Dylan Hurd","email":"dylan.hurd@openai.com","date":"2026-05-27T07:23:15Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T07:23:15Z"},"message":"fix(auto-review) skip legacy notify for auto review threads (#24714)\n\n## Summary\nClear inherited legacy `notify` from Guardian review session config,\nsince we should not be passing auto review threads into `notify`\ntargets. Keeps legacy notify payload and hook runtime behavior unchanged\nfor normal user turns.\n\n## Testing\n- [x] add a Guardian config regression and dedicated Guardian\nintegration test so review sessions cannot inherit parent notify hooks","tree":{"sha":"5e92212bbd056fc340cdf786d02a395819f1f68d","url":"https://api.github.com/repos/openai/codex/git/trees/5e92212bbd056fc340cdf786d02a395819f1f68d"},"url":"https://api.github.com/repos/openai/codex/git/commits/e88626621bad4bb2655fa8b5fc7d2f73d68e168d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqFpvjCRC1aQ7uu5UhlAAAvQAQAEVbIRPpD8B9c9N/yy3iDDV7\n60o1+MmBCB4xuRvPYDSl32MEQsjM1sdV92VrsWfVD1i5SNvN+PquKyfOnr/ala10\nXLt7/3Hx9mt7Zo/C5mgA4SVHLge2rr5wggOdMqa0QtWVlPZxlQGUv3HdDOWTp19Y\n1qLkFWif7N6vCY1swnwxCT7WEuOxfkHyuYRCT4RdM1N6/84B2BkFiMAdIv8ifugn\n3b9pWknvuyFDz8osU6w45DU0efd3AiPzYXhKR+l1O0BLV9xggsgOChmxpaQHvQT9\nzsHkpZOXoU+Re+wdz/RZ/XpniekX1Tx395umaguv4fi123xHSmh9DcwPdsXsJIf5\nLKFCya382ejoihtTxOxCcqSAVeyJgPKzik1n3kPF4mNRJU+thuazJDeJruLOfjdK\n+jPvoCXXTXMwbt2vRRWwXnC4tI4h3BLok1q7KK