dex/commits/36268f177f557c0443e5c9475dc0c68852b49373","html_url":"https://github.com/openai/codex/commit/36268f177f557c0443e5c9475dc0c68852b49373","comments_url":"https://api.github.com/repos/openai/codex/commits/36268f177f557c0443e5c9475dc0c68852b49373/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"83915c7ca1c20bda394096ace3d33595b9c7e11c","url":"https://api.github.com/repos/openai/codex/commits/83915c7ca1c20bda394096ace3d33595b9c7e11c","html_url":"https://github.com/openai/codex/commit/83915c7ca1c20bda394096ace3d33595b9c7e11c"}]},{"sha":"83915c7ca1c20bda394096ace3d33595b9c7e11c","node_id":"C_kwDOOYsS4doAKDgzOTE1YzdjYTFjMjBiZGEzOTQwOTZhY2UzZDMzNTk1YjljN2UxMWM","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-19T15:08:55Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-19T15:26:15Z"},"message":"Correct normalized dynamic tool coverage across response modes (#39497)\n\n## What changed\n\n- Keep validating normalized dynamic tool visibility for both Responses and Responses Lite.\n- Exercise the normalized dynamic tool call and its returned metadata only for Responses Lite.\n- Let the standard Responses case complete in a single mocked response without expecting a dynamic tool request.\n\nGitOrigin-RevId: 7793e6f6df07fc58c2976a773a1198496af08dfd","tree":{"sha":"2005e508c3f4903fc644f460000876669499908b","url":"https://api.github.com/repos/openai/codex/git/trees/2005e508c3f4903fc644f460000876669499908b"},"url":"https://api.github.com/repos/openai/codex/git/commits/83915c7ca1c20bda394096ace3d33595b9c7e11c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/83915c7ca1c20bda394096ace3d33595b9c7e11c","html_url":"https://github.com/openai/codex/commit/83915c7ca1c20bda394096ace3d33595b9c7e11c","comments_url":"https://api.github.com/repos/openai/codex/commits/83915c7ca1c20bda394096ace3d33595b9c7e11c/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"af700180808cce2ce28a31aad0fbad4dc58b857a","url":"https://api.github.com/repos/openai/codex/commits/af700180808cce2ce28a31aad0fbad4dc58b857a","html_url":"https://github.com/openai/codex/commit/af700180808cce2ce28a31aad0fbad4dc58b857a"}]},{"sha":"af700180808cce2ce28a31aad0fbad4dc58b857a","node_id":"C_kwDOOYsS4doAKGFmNzAwMTgwODA4Y2NlMmNlMjhhMzFhYWQwZmJhZDRkYzU4Yjg1N2E","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-19T15:08:32Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-19T15:21:11Z"},"message":"Use default timeouts in cyber exec policy tests (#39496)\n\n## What changed\n\nStop setting explicit one-second `timeout_ms` and `yield_time_ms` values in the\nmock command calls. The shell command and unified exec variants now use their\ndefault timing behavior while testing cyber exec policy.\n\nGitOrigin-RevId: b1c25304ca47e7b08f023fe678467fc00330158b","tree":{"sha":"e88e3147d739ec5ef05dd766fca496584b5cb1f4","url":"https://api.github.com/repos/openai/codex/git/trees/e88e3147d739ec5ef05dd766fca496584b5cb1f4"},"url":"https://api.github.com/repos/openai/codex/git/commits/af700180808cce2ce28a31aad0fbad4dc58b857a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/af700180808cce2ce28a31aad0fbad4dc58b857a","html_url":"https://github.com/openai/codex/commit/af700180808cce2ce28a31aad0fbad4dc58b857a","comments_url":"https://api.github.com/repos/openai/codex/commits/af700180808cce2ce28a31aad0fbad4dc58b857a/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"94a831d9dd33566240895af96fc6ed7ddda08859","url":"https://api.github.com/repos/openai/codex/commits/94a831d9dd33566240895af96fc6ed7ddda08859","html_url":"https://github.com/openai/codex/commit/94a831d9dd33566240895af96fc6ed7ddda08859"}]},{"sha":"94a831d9dd33566240895af96fc6ed7ddda08859","node_id":"C_kwDOOYsS4doAKDk0YTgzMWQ5ZGQzMzU2NjI0MDg5NWFmOTZmYzZlZDdkZGRhMDg4NTk","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-19T15:08:23Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-19T15:17:02Z"},"message":"Test panoramic Guardian transcript image resizing (#39494)\n\n## What changed\n\nUse a 2049-by-32 image in the Guardian transcript evidence test and verify that\nit is resized to 2048-by-32 while preserving its aspect ratio.\n\nGitOrigin-RevId: 4b1b404c0fc76c46739379ef154e629bf8d669f3","tree":{"sha":"32be144c358cfeb53aaf02f3a0ad8f4b0a3f7af5","url":"https://api.github.com/repos/openai/codex/git/trees/32be144c358cfeb53aaf02f3a0ad8f4b0a3f7af5"},"url":"https://api.github.com/repos/openai/codex/git/commits/94a831d9dd33566240895af96fc6ed7ddda08859","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/94a831d9dd33566240895af96fc6ed7ddda08859","html_url":"https://github.com/openai/codex/commit/94a831d9dd33566240895af96fc6ed7ddda08859","comments_url":"https://api.github.com/repos/openai/codex/commits/94a831d9dd33566240895af96fc6ed7ddda08859/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fcdf2b501412d85efa3ce6bc217b8b51d7ed792a","url":"https://api.github.com/repos/openai/codex/commits/fcdf2b501412d85efa3ce6bc217b8b51d7ed792a","html_url":"https://github.com/openai/codex/commit/fcdf2b501412d85efa3ce6bc217b8b51d7ed792a"}]},{"sha":"fcdf2b501412d85efa3ce6bc217b8b51d7ed792a","node_id":"C_kwDOOYsS4doAKGZjZGYyYjUwMTQxMmQ4NWVmYTNjZTZiYzIxN2I4YjUxZDdlZDc5MmE","commit":{"author":{"name":"Tamir Duberstein","email":"tamird@openai.com","date":"2026-08-19T14:43:31Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-19T14:49:58Z"},"message":"Make head-tail buffer capacity const generic (#39493)\n\n## What changed\n\n- Parameterize `HeadTailBuffer` by a const `MAX_BYTES` value and derive its\n  head and tail budgets from that value.\n- Keep `UNIFIED_EXEC_OUTPUT_MAX_BYTES` as the default capacity for production\n  call sites.\n- Update focused buffer tests to select their smaller capacities through the\n  type parameter.\n\nGitOrigin-RevId: 106e81a2c2db935f7f77a4f301ef591017958287","tree":{"sha":"1b8f2915ab4f3497ab60632718b2de58cd13616d","url":"https://api.github.com/repos/openai/codex/git/trees/1b8f2915ab4f3497ab60632718b2de58cd13616d"},"url":"https://api.github.com/repos/openai/codex/git/commits/fcdf2b501412d85efa3ce6bc217b8b51d7ed792a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fcdf2b501412d85efa3ce6bc217b8b51d7ed792a","html_url":"https://github.com/openai/codex/commit/fcdf2b501412d85efa3ce6bc217b8b51d7ed792a","comments_url":"https://api.github.com/repos/openai/codex/commits/fcdf2b501412d85efa3ce6bc217b8b51d7ed792a/comments","author":{"login":"tamird","id":1535036,"node_id":"MDQ6VXNlcjE1MzUwMzY=","avatar_url":"https://avatars.githubusercontent.com/u/1535036?v=4","gravatar_id":"","url":"https://api.github.com/users/tamird","html_url":"https://github.com/tamird","followers_url":"https://api.github.com/users/tamird/followers","following_url":"https://api.github.com/users/tamird/following{/other_user}","gists_url":"https://api.github.com/users/tamird/gists{/gist_id}","starred_url":"https://api.github.com/users/tamird/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tamird/subscriptions","organizations_url":"https://api.github.com/users/tamird/orgs","repos_url":"https://api.github.com/users/tamird/repos","events_url":"https://api.github.com/users/tamird/events{/privacy}","received_events_url":"https://api.github.com/users/tamird/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"d1d51f6315f84a1737c655cb4d78104d030d5102","url":"https://api.github.com/repos/openai/codex/commits/d1d51f6315f84a1737c655cb4d78104d030d5102","html_url":"https://github.com/openai/codex/commit/d1d51f6315f84a1737c655cb4d78104d030d5102"}]},{"sha":"d1d51f6315f84a1737c655cb4d78104d030d5102","node_id":"C_kwDOOYsS4doAKGQxZDUxZjYzMTVmODRhMTczN2M2NTVjYjRkNzgxMDRkMDMwZDUxMDI","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-19T12:48:59Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-19T12:56:08Z"},"message":"Move shell snapshot tests into shell-command (#39480)\n\n## What changed\n\n- Co-locate the Bash and zsh snapshot-script tests with\n  `codex-shell-command`, where `snapshot_script` is implemented.\n- Add `tempfile` as a dev dependency for the relocated tests.\n- Keep the higher-level snapshot lifecycle tests in `codex-core`.\n\nGitOrigin-RevId: 6d5e9ab95962722f7c89ea40512bd70ee81d8da2","tree":{"sha":"c976d591cd7090d3f30bf8c04a7f112a55c74ed0","url":"https://api.github.com/repos/openai/codex/git/trees/c976d591cd7090d3f30bf8c04a7f112a55c74ed0"},"url":"https://api.github.com/repos/openai/codex/git/commits/d1d51f6315f84a1737c655cb4d78104d030d5102","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/d1d51f6315f84a1737c655cb4d78104d030d5102","html_url":"https://github.com/openai/codex/commit/d1d51f6315f84a1737c655cb4d78104d030d5102","comments_url":"https://api.github.com/repos/openai/codex/commits/d1d51f6315f84a1737c655cb4d78104d030d5102/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"e741cd9ace0286bf0be3d5e1c7f569b345e33ee5","url":"https://api.github.com/repos/openai/codex/commits/e741cd9ace0286bf0be3d5e1c7f569b345e33ee5","html_url":"https://github.com/openai/codex/commit/e741cd9ace0286bf0be3d5e1c7f569b345e33ee5"}]},{"sha":"e741cd9ace0286bf0be3d5e1c7f569b345e33ee5","node_id":"C_kwDOOYsS4doAKGU3NDFjZDlhY2UwMjg2YmYwYmUzZDVlMWM3ZjU2OWIzNDVlMzNlZTU","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-19T11:53:44Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-19T11:59:23Z"},"message":"Consolidate Guardian extensions into `codex-guardian-v2` (#39474)\n\n## What changed\n\n- Move the Guardian thread lifecycle contributor and subagent-spawn context into `codex-guardian-v2`.\n- Install the lifecycle contributor and asynchronous risk scorer through a single extension entry point.\n- Remove the redundant `codex-guardian` crate and group the existing scorer implementation under `async_scorer`.\n\nGitOrigin-RevId: 97141190c843e588b8c09c9ccd3fe00e1fae39a4","tree":{"sha":"8b8f55154bdb1f7d02f4e0bd677dbf3c6dca4e3b","url":"https://api.github.com/repos/openai/codex/git/trees/8b8f55154bdb1f7d02f4e0bd677dbf3c6dca4e3b"},"url":"https://api.github.com/repos/openai/codex/git/commits/e741cd9ace0286bf0be3d5e1c7f569b345e33ee5","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/e741cd9ace0286bf0be3d5e1c7f569b345e33ee5","html_url":"https://github.com/openai/codex/commit/e741cd9ace0286bf0be3d5e1c7f569b345e33ee5","comments_url":"https://api.github.com/repos/openai/codex/commits/e741cd9ace0286bf0be3d5e1c7f569b345e33ee5/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"f5a3dc55404ddc066a4e4a65602fee166ecc46b3","url":"https://api.github.com/repos/openai/codex/commits/f5a3dc55404ddc066a4e4a65602fee166ecc46b3","html_url":"https://github.com/openai/codex/commit/f5a3dc55404ddc066a4e4a65602fee166ecc46b3"}]},{"sha":"f5a3dc55404ddc066a4e4a65602fee166ecc46b3","node_id":"C_kwDOOYsS4doAKGY1YTNkYzU1NDA0ZGRjMDY2YTRlNGE2NTYwMmZlZTE2NmVjYzQ2YjM","commit":{"author":{"name":"rka-oai","email":"rka@openai.com","date":"2026-08-19T08:55:01Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-19T09:01:23Z"},"message":"Remove the feature gate for async user messages (#39452)\n\n## What changed\n\n- Expose `send_user_message_async` to root agents whenever the selected model advertises support for it.\n- Retain `send_async_message` as a removed compatibility flag so existing configuration is accepted without controlling tool availability.\n- Update the async message test to cover model-driven tool exposure without enabling the legacy flag.\n\nGitOrigin-RevId: 558b427c2b203a057dd7c836e0ec702ae6134346","tree":{"sha":"68a563f8eb1aa329f72593efadeb1e77088e64e4","url":"https://api.github.com/repos/openai/codex/git/trees/68a563f8eb1aa329f72593efadeb1e77088e64e4"},"url":"https://api.github.com/repos/openai/codex/git/commits/f5a3dc55404ddc066a4e4a65602fee166ecc46b3","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/f5a3dc55404ddc066a4e4a65602fee166ecc46b3","html_url":"https://github.com/openai/codex/commit/f5a3dc55404ddc066a4e4a65602fee166ecc46b3","comments_url":"https://api.github.com/repos/openai/codex/commits/f5a3dc55404ddc066a4e4a65602fee166ecc46b3/comments","author":{"login":"rka-oai","id":240799229,"node_id":"U_kgDODlpN_Q","avatar_url":"https://avatars.githubusercontent.com/u/240799229?v=4","gravatar_id":"","url":"https://api.github.com/users/rka-oai","html_url":"https://github.com/rka-oai","followers_url":"https://api.github.com/users/rka-oai/followers","following_url":"https://api.github.com/users/rka-oai/following{/other_user}","gists_url":"https://api.github.com/users/rka-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rka-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rka-oai/subscriptions","organizations_url":"https://api.github.com/users/rka-oai/orgs","repos_url":"https://api.github.com/users/rka-oai/repos","events_url":"https://api.github.com/users/rka-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rka-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"3929c99a97d1aa0fb8000903a4b57b24fbabe742","url":"https://api.github.com/repos/openai/codex/commits/3929c99a97d1aa0fb8000903a4b57b24fbabe742","html_url":"https://github.com/openai/codex/commit/3929c99a97d1aa0fb8000903a4b57b24fbabe742"}]},{"sha":"3929c99a97d1aa0fb8000903a4b57b24fbabe742","node_id":"C_kwDOOYsS4doAKDM5MjljOTlhOTdkMWFhMGZiODAwMDkwM2E0YjU3YjI0ZmJhYmU3NDI","commit":{"author":{"name":"alexsong-oai","email":"alexsong@openai.com","date":"2026-08-19T04:32:41Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-19T04:46:58Z"},"message":"Refresh expired AWS credentials for Bedrock (#39410)\n\n## Why\n\nBedrock sessions that use the AWS SDK credential chain need a way to recover when credentials expire during a request.\n\n## What changed\n\n- Add `aws.auth_refresh` provider configuration with an `aws` command, arguments, and a configurable timeout.\n- Run the command for refreshable Bedrock authentication failures, reload the SDK credentials, re-sign the request, and retry it.\n- Share refresh state across matching provider configurations so concurrent failures invoke the command only once. Bearer tokens, command auth, and static environment credentials do not use this recovery path.\n\n## Testing\n\n- Add coverage for configuration validation, refreshable error classification, concurrent refresh sharing, and an end-to-end retry signed with refreshed credentials.\n\nGitOrigin-RevId: 0302fe3aabdbc1097e7bd62a74d407ba38a3cc57","tree":{"sha":"1a9115d3a04e2fb15e9cad645d0929ce3337df90","url":"https://api.github.com/repos/openai/codex/git/trees/1a9115d3a04e2fb15e9cad645d0929ce3337df90"},"url":"https://api.github.com/repos/openai/codex/git/commits/3929c99a97d1aa0fb8000903a4b57b24fbabe742","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/3929c99a97d1aa0fb8000903a4b57b24fbabe742","html_url":"https://github.com/openai/codex/commit/3929c99a97d1aa0fb8000903a4b57b24fbabe742","comments_url":"https://api.github.com/repos/openai/codex/commits/3929c99a97d1aa0fb8000903a4b57b24fbabe742/comments","author":{"login":"alexsong-oai","id":256201575,"node_id":"U_kgDOD0VTZw","avatar_url":"https://avatars.githubusercontent.com/u/256201575?v=4","gravatar_id":"","url":"https://api.github.com/users/alexsong-oai","html_url":"https://github.com/alexsong-oai","followers_url":"https://api.github.com/users/alexsong-oai/followers","following_url":"https://api.github.com/users/alexsong-oai/following{/other_user}","gists_url":"https://api.github.com/users/alexsong-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/alexsong-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alexsong-oai/subscriptions","organizations_url":"https://api.github.com/users/alexsong-oai/orgs","repos_url":"https://api.github.com/users/alexsong-oai/repos","events_url":"https://api.github.com/users/alexsong-oai/events{/privacy}","received_events_url":"https://api.github.com/users/alexsong-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"6cc2ba8a9567e3083531283f923127b86a6c5908","url":"https://api.github.com/repos/openai/codex/commits/6cc2ba8a9567e3083531283f923127b86a6c5908","html_url":"https://github.com/openai/codex/commit/6cc2ba8a9567e3083531283f923127b86a6c5908"}]},{"sha":"6cc2ba8a9567e3083531283f923127b86a6c5908","node_id":"C_kwDOOYsS4doAKDZjYzJiYThhOTU2N2UzMDgzNTMxMjgzZjkyMzEyN2I4NmE2YzU5MDg","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-08-19T03:57:32Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-19T04:06:50Z"},"message":"Support FD mounts with older system Bubblewrap versions (#39404)\n\n## Why\n\nSystem Bubblewrap installations that lack `--ro-bind-fd` cannot directly create\nthe descriptor-backed read-only mounts used by the Linux sandbox.\n\n## What changed\n\n- Detect `--ro-bind-fd` support when probing system Bubblewrap.\n- On older versions, translate descriptor-backed mounts to `/proc/self/fd`\n  read-only binds and pass their descriptors and destinations to the trusted\n  inner sandbox stage for verification.\n- Reject malformed, duplicate, mismatched, or symlink-substituted mounts, and\n  close inherited descriptors before running sandboxed code.\n\n## Testing\n\nAdded unit coverage for capability detection, legacy argument translation,\ninvalid mount rejection, inode verification, and descriptor closure.\n\nGitOrigin-RevId: dfc0a457b572cdd9aed093fb5abf57360e9724a2","tree":{"sha":"210937832943535de464bfd0526d56fe7724b491","url":"https://api.github.com/repos/openai/codex/git/trees/210937832943535de464bfd0526d56fe7724b491"},"url":"https://api.github.com/repos/openai/codex/git/commits/6cc2ba8a9567e3083531283f923127b86a6c5908","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/6cc2ba8a9567e3083531283f923127b86a6c5908","html_url":"https://github.com/openai/codex/commit/6cc2ba8a9567e3083531283f923127b86a6c5908","comments_url":"https://api.github.com/repos/openai/codex/commits/6cc2ba8a9567e3083531283f923127b86a6c5908/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"956f590ad549e75913894614ce0cbec4d5fd677a","url":"https://api.github.com/repos/openai/codex/commits/956f590ad549e75913894614ce0cbec4d5fd677a","html_url":"https://github.com/openai/codex/commit/956f590ad549e75913894614ce0cbec4d5fd677a"}]},{"sha":"956f590ad549e75913894614ce0cbec4d5fd677a","node_id":"C_kwDOOYsS4doAKDk1NmY1OTBhZDU0OWU3NTkxMzg5NDYxNGNlMGNiZWM0ZDVmZDY3N2E","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-08-19T03:44:47Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-19T03:52:59Z"},"message":"Remove npm package staging from repo checks (#39402)\n\n## What changed\n\nRemove the `repo-checks` steps that staged a Codex npm package from a fixed\nrelease workflow and uploaded the resulting tarball as an artifact.\n\nGitOrigin-RevId: bb3756188eeea2ed236710273234e70f17dc9e9d","tree":{"sha":"64f6f5a00183b51cada31a78920ab04f869286cf","url":"https://api.github.com/repos/openai/codex/git/trees/64f6f5a00183b51cada31a78920ab04f869286cf"},"url":"https://api.github.com/repos/openai/codex/git/commits/956f590ad549e75913894614ce0cbec4d5fd677a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/956f590ad549e75913894614ce0cbec4d5fd677a","html_url":"https://github.com/openai/codex/commit/956f590ad549e75913894614ce0cbec4d5fd677a","comments_url":"https://api.github.com/repos/openai/codex/commits/956f590ad549e75913894614ce0cbec4d5fd677a/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"14a8ac89af0a3c9033c1fa4d747ec5d6333e9890","url":"https://api.github.com/repos/openai/codex/commits/14a8ac89af0a3c9033c1fa4d747ec5d6333e9890","html_url":"https://github.com/openai/codex/commit/14a8ac89af0a3c9033c1fa4d747ec5d6333e9890"}]},{"sha":"14a8ac89af0a3c9033c1fa4d747ec5d6333e9890","node_id":"C_kwDOOYsS4doAKDE0YThhYzg5YWYwYTNjOTAzM2MxZmE0ZDc0N2VjNWQ2MzMzZTk4OTA","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-19T02:40:06Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-19T02:45:45Z"},"message":"Prefer the most recent session when queueing by name (#39385)\n\n## What changed\n\n- Resolve duplicate exact-name matches to the most recent session instead of rejecting the queue request as ambiguous.\n- Include non-interactive and custom-source sessions in name-based queue lookups.\n- Prefer state database matches before falling back to rollout scanning.\n\n## Testing\n\n- Cover queueing to non-interactive and custom-source sessions, including duplicate names and a state database match that avoids importing a legacy rollout.\n\nGitOrigin-RevId: 5b019da0a950c9381d324a09a21c78a9d0ac2252","tree":{"sha":"778851a5abf104e155ca60770056f9a167fcbdb7","url":"https://api.github.com/repos/openai/codex/git/trees/778851a5abf104e155ca60770056f9a167fcbdb7"},"url":"https://api.github.com/repos/openai/codex/git/commits/14a8ac89af0a3c9033c1fa4d747ec5d6333e9890","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/14a8ac89af0a3c9033c1fa4d747ec5d6333e9890","html_url":"https://github.com/openai/codex/commit/14a8ac89af0a3c9033c1fa4d747ec5d6333e9890","comments_url":"https://api.github.com/repos/openai/codex/commits/14a8ac89af0a3c9033c1fa4d747ec5d6333e9890/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"8843960ba06b1b2570e689f3fff354c324ab2417","url":"https://api.github.com/repos/openai/codex/commits/8843960ba06b1b2570e689f3fff354c324ab2417","html_url":"https://github.com/openai/codex/commit/8843960ba06b1b2570e689f3fff354c324ab2417"}]},{"sha":"8843960ba06b1b2570e689f3fff354c324ab2417","node_id":"C_kwDOOYsS4doAKDg4NDM5NjBiYTA2YjFiMjU3MGU2ODlmM2ZmZjM1NGMzMjRhYjI0MTc","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-19T02:23:21Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-19T02:28:42Z"},"message":"Scope TUI approval requests to their threads (#39372)\n\n## Why\n\nApproval and item IDs can collide across concurrent threads. Tracking pending app-server approvals by ID alone can therefore resolve, submit, or dismiss a request from the wrong thread.\n\n## What changed\n\n- Key command execution, file change, and permissions approvals by both thread ID and approval ID.\n- Route approval responses through the originating thread and require the thread to match when processing resolution notifications or dismissing approval prompts.\n- Canonicalize parseable thread IDs so equivalent UUID representations still match.\n\n## Testing\n\n- Cover colliding approval IDs across threads, mismatched resolution notifications, prompt dismissal, and response routing for primary and background threads.\n\nGitOrigin-RevId: c2d899a1e4b6a6413c78a0595a5311f5fabb9815","tree":{"sha":"27cbeebb23f9638dd25bdff7ef7879e74a29e230","url":"https://api.github.com/repos/openai/codex/git/trees/27cbeebb23f9638dd25bdff7ef7879e74a29e230"},"url":"https://api.github.com/repos/openai/codex/git/commits/8843960ba06b1b2570e689f3fff354c324ab2417","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/8843960ba06b1b2570e689f3fff354c324ab2417","html_url":"https://github.com/openai/codex/commit/8843960ba06b1b2570e689f3fff354c324ab2417","comments_url":"https://api.github.com/repos/openai/codex/commits/8843960ba06b1b2570e689f3fff354c324ab2417/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fde2156057c38c0227ce94c8514d04c7498df60d","url":"https://api.github.com/repos/openai/codex/commits/fde2156057c38c0227ce94c8514d04c7498df60d","html_url":"https://github.com/openai/codex/commit/fde2156057c38c0227ce94c8514d04c7498df60d"}]},{"sha":"fde2156057c38c0227ce94c8514d04c7498df60d","node_id":"C_kwDOOYsS4doAKGZkZTIxNTYwNTdjMzhjMDIyN2NlOTRjODUxNGQwNGM3NDk4ZGY2MGQ","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-08-19T01:21:11Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-19T01:26:16Z"},"message":"Enforce environment MCP policies (#39335)\n\n## What changed\n\n- Add environment-provided MCP restrictions for configured and plugin-provided servers.\n- Disable attachment-scoped servers while their environment configuration is pending, failed, or unselected, while preserving selected-plugin access and the controller-owned Apps server.\n- Apply the resolved policy to runtime startup, model tool exposure, telemetry, OAuth flows, and skill dependency installation.\n\n## Testing\n\n- Cover policy filtering for configured and plugin servers, environment state transitions, Apps ownership, and managed OAuth rejection.\n\nGitOrigin-RevId: 7ca5d4dda14068e758497f88835d5cba685e159e","tree":{"sha":"a0aaaa924986804ad5a852c95a0dcd29ddc4853c","url":"https://api.github.com/repos/openai/codex/git/trees/a0aaaa924986804ad5a852c95a0dcd29ddc4853c"},"url":"https://api.github.com/repos/openai/codex/git/commits/fde2156057c38c0227ce94c8514d04c7498df60d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fde2156057c38c0227ce94c8514d04c7498df60d","html_url":"https://github.com/openai/codex/commit/fde2156057c38c0227ce94c8514d04c7498df60d","comments_url":"https://api.github.com/repos/openai/codex/commits/fde2156057c38c0227ce94c8514d04c7498df60d/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"d35e5495f991508409ff30e38db8dbe49d565570","url":"https://api.github.com/repos/openai/codex/commits/d35e5495f991508409ff30e38db8dbe49d565570","html_url":"https://github.com/openai/codex/commit/d35e5495f991508409ff30e38db8dbe49d565570"}]},{"sha":"d35e5495f991508409ff30e38db8dbe49d565570","node_id":"C_kwDOOYsS4doAKGQzNWU1NDk1Zjk5MTUwODQwOWZmMzBlMzhkYjhkYmU0OWQ1NjU1NzA","commit":{"author":{"name":"Abhinav","email":"abhinav@openai.com","date":"2026-08-19T01:05:23Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-19T01:15:10Z"},"message":"Route hook MCP calls through current connections (#39331)\n\n## What changed\n\n- Execute hook-triggered MCP calls through the runtime's latest connection set instead of preparing a separate catalog-bound call.\n- Keep hook calls from waiting for server startup or reconnecting, and reject disconnected servers immediately.\n- Apply the shorter of the hook-requested timeout and the server's configured tool timeout.\n\n## Testing\n\n- Update connection manager tests to cover non-waiting calls and disabled tool filters.\n\nGitOrigin-RevId: 3166b2d1e26d9ae2b8b3a648b4d0897cc260eb93","tree":{"sha":"6d10d964a3b2eea76c2c69a6402aeb1efdda361c","url":"https://api.github.com/repos/openai/codex/git/trees/6d10d964a3b2eea76c2c69a6402aeb1efdda361c"},"url":"https://api.github.com/repos/openai/codex/git/commits/d35e5495f991508409ff30e38db8dbe49d565570","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/d35e5495f991508409ff30e38db8dbe49d565570","html_url":"https://github.com/openai/codex/commit/d35e5495f991508409ff30e38db8dbe49d565570","comments_url":"https://api.github.com/repos/openai/codex/commits/d35e5495f991508409ff30e38db8dbe49d565570/comments","author":{"login":"abhinav-oai","id":274334565,"node_id":"U_kgDOEFoDZQ","avatar_url":"https://avatars.githubusercontent.com/u/274334565?v=4","gravatar_id":"","url":"https://api.github.com/users/abhinav-oai","html_url":"https://github.com/abhinav-oai","followers_url":"https://api.github.com/users/abhinav-oai/followers","following_url":"https://api.github.com/users/abhinav-oai/following{/other_user}","gists_url":"https://api.github.com/users/abhinav-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/abhinav-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abhinav-oai/subscriptions","organizations_url":"https://api.github.com/users/abhinav-oai/orgs","repos_url":"https://api.github.com/users/abhinav-oai/repos","events_url":"https://api.github.com/users/abhinav-oai/events{/privacy}","received_events_url":"https://api.github.com/users/abhinav-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"67ed4e717acfb8f729c9aa3f2bbdf19bbae73817","url":"https://api.github.com/repos/openai/codex/commits/67ed4e717acfb8f729c9aa3f2bbdf19bbae73817","html_url":"https://github.com/openai/codex/commit/67ed4e717acfb8f729c9aa3f2bbdf19bbae73817"}]},{"sha":"67ed4e717acfb8f729c9aa3f2bbdf19bbae73817","node_id":"C_kwDOOYsS4doAKDY3ZWQ0ZTcxN2FjZmI4ZjcyOWM5YWEzZjJiYmRmMTliYmFlNzM4MTc","commit":{"author":{"name":"charlesgong-openai","email":"charlesgong@openai.com","date":"2026-08-19T01:00:58Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-19T01:06:12Z"},"message":"Stop migrating Cursor sandbox settings (#39325)\n\n## What changed\n\n- Ignore `.cursor/sandbox.json` during external agent config migration.\n- Continue importing supported settings from `.cursor/cli-config.json`.\n\n## Testing\n\n- Update app-server migration coverage to verify that environment variables from `cli-config.json` are imported.\n\nGitOrigin-RevId: 6094f1cb6f698392d58056f826da21c1f1389a1b","tree":{"sha":"4d3036600bdd571a0396252428e9a8095c634220","url":"https://api.github.com/repos/openai/codex/git/trees/4d3036600bdd571a0396252428e9a8095c634220"},"url":"https://api.github.com/repos/openai/codex/git/commits/67ed4e717acfb8f729c9aa3f2bbdf19bbae73817","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/67ed4e717acfb8f729c9aa3f2bbdf19bbae73817","html_url":"https://github.com/openai/codex/commit/67ed4e717acfb8f729c9aa3f2bbdf19bbae73817","comments_url":"https://api.github.com/repos/openai/codex/commits/67ed4e717acfb8f729c9aa3f2bbdf19bbae73817/comments","author":{"login":"charlesgong-openai","id":200841148,"node_id":"U_kgDOC_iXvA","avatar_url":"https://avatars.githubusercontent.com/u/200841148?v=4","gravatar_id":"","url":"https://api.github.com/users/charlesgong-openai","html_url":"https://github.com/charlesgong-openai","followers_url":"https://api.github.com/users/charlesgong-openai/followers","following_url":"https://api.github.com/users/charlesgong-openai/following{/other_user}","gists_url":"https://api.github.com/users/charlesgong-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/charlesgong-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charlesgong-openai/subscriptions","organizations_url":"https://api.github.com/users/charlesgong-openai/orgs","repos_url":"https://api.github.com/users/charlesgong-openai/repos","events_url":"https://api.github.com/users/charlesgong-openai/events{/privacy}","received_events_url":"https://api.github.com/users/charlesgong-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"b537d5a0970f9d3153b1e647e2b42deed32555e0","url":"https://api.github.com/repos/openai/codex/commits/b537d5a0970f9d3153b1e647e2b42deed32555e0","html_url":"https://github.com/openai/codex/commit/b537d5a0970f9d3153b1e647e2b42deed32555e0"}]},{"sha":"b537d5a0970f9d3153b1e647e2b42deed32555e0","node_id":"C_kwDOOYsS4doAKGI1MzdkNWEwOTcwZjlkMzE1M2IxZTY0N2UyYjQyZGVlZDMyNTU1ZTA","commit":{"author":{"name":"cooper-oai","email":"cooper@openai.com","date":"2026-08-19T00:22:17Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-19T00:28:52Z"},"message":"Enforce workspace restrictions for header authentication (#39322)\n\n## What changed\n\n- Validate externally supplied header credentials against configured ChatGPT workspace restrictions using their `chatgpt-account-id` header.\n- Reject header credentials with a missing or disallowed account ID, including credentials returned during refresh, without replacing the previously cached authentication.\n- Document that identity headers must be bound to validated credentials because Codex uses them for managed authentication policy.\n\n## Testing\n\n- Add coverage for allowed, disallowed, and missing account IDs.\n- Add coverage for rejecting a refresh that changes to a disallowed workspace.\n\nGitOrigin-RevId: 3e3db2607cd8f9f1b8000472342e42e4b1cf00b2","tree":{"sha":"2046065351699fba608ba480c0ddc300e3b853e2","url":"https://api.github.com/repos/openai/codex/git/trees/2046065351699fba608ba480c0ddc300e3b853e2"},"url":"https://api.github.com/repos/openai/codex/git/commits/b537d5a0970f9d3153b1e647e2b42deed32555e0","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/b537d5a0970f9d3153b1e647e2b42deed32555e0","html_url":"https://github.com/openai/codex/commit/b537d5a0970f9d3153b1e647e2b42deed32555e0","comments_url":"https://api.github.com/repos/openai/codex/commits/b537d5a0970f9d3153b1e647e2b42deed32555e0/comments","author":{"login":"cooper-oai","id":242064477,"node_id":"U_kgDODm2cXQ","avatar_url":"https://avatars.githubusercontent.com/u/242064477?v=4","gravatar_id":"","url":"https://api.github.com/users/cooper-oai","html_url":"https://github.com/cooper-oai","followers_url":"https://api.github.com/users/cooper-oai/followers","following_url":"https://api.github.com/users/cooper-oai/following{/other_user}","gists_url":"https://api.github.com/users/cooper-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/cooper-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cooper-oai/subscriptions","organizations_url":"https://api.github.com/users/cooper-oai/orgs","repos_url":"https://api.github.com/users/cooper-oai/repos","events_url":"https://api.github.com/users/cooper-oai/events{/privacy}","received_events_url":"https://api.github.com/users/cooper-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"f1087ff151b06e781ecb086068d45fcc62d02da3","url":"https://api.github.com/repos/openai/codex/commits/f1087ff151b06e781ecb086068d45fcc62d02da3","html_url":"https://github.com/openai/codex/commit/f1087ff151b06e781ecb086068d45fcc62d02da3"}]},{"sha":"f1087ff151b06e781ecb086068d45fcc62d02da3","node_id":"C_kwDOOYsS4doAKGYxMDg3ZmYxNTFiMDZlNzgxZWNiMDg2MDY4ZDQ1ZmNjNjJkMDJkYTM","commit":{"author":{"name":"thomas","email":"tsarlandie@openai.com","date":"2026-08-18T23:51:57Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-19T00:05:23Z"},"message":"Expand OAuth metadata redirect test coverage (#39320)\n\n## What changed\n\n- Cover same-origin redirects for protected-resource and authorization-server metadata.\n- Verify that cross-origin redirects are rejected before contacting their targets and that redirect cycles fail within a bounded timeout.\n- Exercise issuer validation and resource-header isolation for both direct and redirected metadata across legacy and Agent Plugin discovery modes.\n- Reuse the test environment's local HTTP client throughout the discovery tests.\n\nGitOrigin-RevId: bd12ac232c3b020a1c098a413361f8e205699699","tree":{"sha":"85183d6c932b8eba2ac3d77018bfda7c918d4206","url":"https://api.github.com/repos/openai/codex/git/trees/85183d6c932b8eba2ac3d77018bfda7c918d4206"},"url":"https://api.github.com/repos/openai/codex/git/commits/f1087ff151b06e781ecb086068d45fcc62d02da3","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/f1087ff151b06e781ecb086068d45fcc62d02da3","html_url":"https://github.com/openai/codex/commit/f1087ff151b06e781ecb086068d45fcc62d02da3","comments_url":"https://api.github.com/repos/openai/codex/commits/f1087ff151b06e781ecb086068d45fcc62d02da3/comments","author":{"login":"tsarlandie-oai","id":291887306,"node_id":"U_kgDOEWXYyg","avatar_url":"https://avatars.githubusercontent.com/u/291887306?v=4","gravatar_id":"","url":"https://api.github.com/users/tsarlandie-oai","html_url":"https://github.com/tsarlandie-oai","followers_url":"https://api.github.com/users/tsarlandie-oai/followers","following_url":"https://api.github.com/users/tsarlandie-oai/following{/other_user}","gists_url":"https://api.github.com/users/tsarlandie-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/tsarlandie-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tsarlandie-oai/subscriptions","organizations_url":"https://api.github.com/users/tsarlandie-oai/orgs","repos_url":"https://api.github.com/users/tsarlandie-oai/repos","events_url":"https://api.github.com/users/tsarlandie-oai/events{/privacy}","received_events_url":"https://api.github.com/users/tsarlandie-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"71dbf72b0576f9e7be1ef28d275bc79ece6d4b6c","url":"https://api.github.com/repos/openai/codex/commits/71dbf72b0576f9e7be1ef28d275bc79ece6d4b6c","html_url":"https://github.com/openai/codex/commit/71dbf72b0576f9e7be1ef28d275bc79ece6d4b6c"}]},{"sha":"71dbf72b0576f9e7be1ef28d275bc79ece6d4b6c","node_id":"C_kwDOOYsS4doAKDcxZGJmNzJiMDU3NmY5ZTdiZTFlZjI4ZDI3NWJjNzllY2U2ZDRiNmM","commit":{"author":{"name":"rka-oai","email":"rka@openai.com","date":"2026-08-18T23:43:40Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T23:59:19Z"},"message":"Add the async user message tool (#39319)\n\n## What changed\n\n- Add `send_user_message_async` for root agents when the async-message feature is enabled and the model advertises tool support.\n- Emit the supplied text as an asynchronous agent message and immediately return an accepted result so the turn can continue.\n- Keep the user-visible update out of the model's input context.\n\n## Testing\n\n- Add an integration test covering tool registration, item events, continued turn execution, and model context.\n\nGitOrigin-RevId: 13d5168cb8cd6742db17bb74a15c910994e9c98b","tree":{"sha":"d4de5464583c8df18bada52c09b81b971a77ba7c","url":"https://api.github.com/repos/openai/codex/git/trees/d4de5464583c8df18bada52c09b81b971a77ba7c"},"url":"https://api.github.com/repos/openai/codex/git/commits/71dbf72b0576f9e7be1ef28d275bc79ece6d4b6c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/71dbf72b0576f9e7be1ef28d275bc79ece6d4b6c","html_url":"https://github.com/openai/codex/commit/71dbf72b0576f9e7be1ef28d275bc79ece6d4b6c","comments_url":"https://api.github.com/repos/openai/codex/commits/71dbf72b0576f9e7be1ef28d275bc79ece6d4b6c/comments","author":{"login":"rka-oai","id":240799229,"node_id":"U_kgDODlpN_Q","avatar_url":"https://avatars.githubusercontent.com/u/240799229?v=4","gravatar_id":"","url":"https://api.github.com/users/rka-oai","html_url":"https://github.com/rka-oai","followers_url":"https://api.github.com/users/rka-oai/followers","following_url":"https://api.github.com/users/rka-oai/following{/other_user}","gists_url":"https://api.github.com/users/rka-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rka-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rka-oai/subscriptions","organizations_url":"https://api.github.com/users/rka-oai/orgs","repos_url":"https://api.github.com/users/rka-oai/repos","events_url":"https://api.github.com/users/rka-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rka-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"657bd889ae28edcbf5395c103b479bf8b328704e","url":"https://api.github.com/repos/openai/codex/commits/657bd889ae28edcbf5395c103b479bf8b328704e","html_url":"https://github.com/openai/codex/commit/657bd889ae28edcbf5395c103b479bf8b328704e"}]}]