d2a936305a591807b))\n\n---\n\n_Everything above this line will be the GitHub release body._\n\n---\n\n> [!NOTE]\n> A **New Contributors** section is appended to the GitHub release notes\nautomatically at publish time (see [Release\nPipeline](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md#release-pipeline),\nstep 2).\n\n---------\n\nCo-authored-by: github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","verified_at":"2026-06-26T07:35:55Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/de6e3415ce2324d1bd8c8e7ddbdadd8213ec78ef","html_url":"https://github.com/langchain-ai/deepagents/commit/de6e3415ce2324d1bd8c8e7ddbdadd8213ec78ef","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/de6e3415ce2324d1bd8c8e7ddbdadd8213ec78ef/comments","author":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c20c8e2fc138f72f1444107d2a936305a591807b","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/c20c8e2fc138f72f1444107d2a936305a591807b","html_url":"https://github.com/langchain-ai/deepagents/commit/c20c8e2fc138f72f1444107d2a936305a591807b"}]},{"sha":"c20c8e2fc138f72f1444107d2a936305a591807b","node_id":"C_kwDOPTymldoAKGMyMGM4ZTJmYzEzOGY3MmYxNDQ0MTA3ZDJhOTM2MzA1YTU5MTgwN2I","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T07:28:53Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T07:28:53Z"},"message":"fix(code): pin app version when installing extras (#4313)\n\nInstalling a provider extra rebuilds the `dcode` uv tool environment.\nThat rebuild should keep the currently running app version, not let uv\nbacktrack to an older `deepagents-code` release when the latest stable\napp depends on prerelease packages.\n\n## Changes\n- Pin `_install_extra_uv_tool_command` and `install_package_command` to\nthe running `deepagents-code` version and pass `--prerelease allow` for\ndependency resolution.\n- Keep malformed app version pins as `ValueError` while preserving the\nexisting `ExtrasIntrospectionError` path for invalid installed-extra\nmetadata.\n- Update command-builder and executor coverage for pinned extra/package\ninstalls, prerelease dependency resolution, and invalid version\nhandling.","tree":{"sha":"21ddda91faec43cc078bf01e835447549e2d5a85","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/21ddda91faec43cc078bf01e835447549e2d5a85"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/c20c8e2fc138f72f1444107d2a936305a591807b","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPio1CRC1aQ7uu5UhlAAA2JgQAB1zQqSW1Zvim8hZNeLBacyZ\nQ2PhWjNaDlfTxsrPVbzP0MKtkxI45fIpETIL78CCMjaHTKRy8VuDQvwRUO7Cq0vs\n0tPWSa9QTZo0dkvj5m6ItTXl6LPtF7Ejtcg4IZEdBdonApYu7QlSVv+6Z0AKq+0M\n6IGYDiWGH8nGVF3KlipYRQA0HFDJhYzZC10+z61eyym2a0NUX56I/riMHFerSlT7\nc+Bit9zLjVLn2/sUzeITK7IJMITU28WJfsqgLbVgoYZaOarMApatYxqhyLQUrj+K\n7Qpg8fSNRBGjaa/mNRx1GJcm5ZuzpRGwXmifL/pgP4VgmsGTeRnHY24SzgmMb0lX\nHDehddznbGZnvhKmDWgzwZrOHSSSacQ012k217KM18Hb2nPoN6jH3bhlGr3pp04P\nlUUsTGLxqJ3eH/6xpKc3QHNOTeH+te3FJYIcIOl6BXSYon7NaM4D/3Lu5myjr3Eq\nLQGYEtoQX/VNtDTNEVqqECl2smiuXYKhazElhaJFV3ntq52WYEzEKPy7AH8TDrLR\nTSnW0+S6t6nUiJCo14p7Y3Ql8dTZWo1712em7Re7ONAbAyGK7ZFxeMG3KLRFjsCR\npPrZ4hMQpA3VHFJlMyl7q8bcbDwfGKoFwkiftZzyo4SCg7gdCzwJ0W7xY/HIfuK/\nxETK8ZJisRnUXr9QverD\n=poFP\n-----END PGP SIGNATURE-----\n","payload":"tree 21ddda91faec43cc078bf01e835447549e2d5a85\nparent 38a370b829beb94fb4ef3b5bff6f327a75908f07\nauthor Mason Daugherty <mason@langchain.dev> 1782458933 -0400\ncommitter GitHub <noreply@github.com> 1782458933 -0400\n\nfix(code): pin app version when installing extras (#4313)\n\nInstalling a provider extra rebuilds the `dcode` uv tool environment.\nThat rebuild should keep the currently running app version, not let uv\nbacktrack to an older `deepagents-code` release when the latest stable\napp depends on prerelease packages.\n\n## Changes\n- Pin `_install_extra_uv_tool_command` and `install_package_command` to\nthe running `deepagents-code` version and pass `--prerelease allow` for\ndependency resolution.\n- Keep malformed app version pins as `ValueError` while preserving the\nexisting `ExtrasIntrospectionError` path for invalid installed-extra\nmetadata.\n- Update command-builder and executor coverage for pinned extra/package\ninstalls, prerelease dependency resolution, and invalid version\nhandling.","verified_at":"2026-06-26T07:28:54Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/c20c8e2fc138f72f1444107d2a936305a591807b","html_url":"https://github.com/langchain-ai/deepagents/commit/c20c8e2fc138f72f1444107d2a936305a591807b","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/c20c8e2fc138f72f1444107d2a936305a591807b/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"38a370b829beb94fb4ef3b5bff6f327a75908f07","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/38a370b829beb94fb4ef3b5bff6f327a75908f07","html_url":"https://github.com/langchain-ai/deepagents/commit/38a370b829beb94fb4ef3b5bff6f327a75908f07"}]},{"sha":"38a370b829beb94fb4ef3b5bff6f327a75908f07","node_id":"C_kwDOPTymldoAKDM4YTM3MGI4MjliZWI5NGZiNGVmM2I1YmZmNmYzMjdhNzU5MDhmMDc","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T07:28:41Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T07:28:41Z"},"message":"chore(code,evals,talon): cap Pydantic below 2.14 alpha (#4315)\n\n`deepagents-code` currently has to resolve with prereleases enabled\nbecause it pins the prerelease SDK package `deepagents==0.7.0a2`. That\nglobal prerelease mode can also pull unrelated transitive prereleases.\n\nIn practice, installer-style `uv tool install --prerelease allow\ndeepagents-code==0.1.25` can select `pydantic==2.14.0a1`. That alpha\ncurrently exposes a LangChain class-construction failure on Python\n3.12/3.13 while importing `BaseLLM`, which causes `dcode` startup to\ncrash with `'function' object is not subscriptable` while evaluating\n`dict[str, Any] | None`.\n\nThis adds a temporary direct Pydantic bound for `deepagents-code` so the\ninstaller still permits the prerelease Deep Agents SDK while avoiding\nthe unrelated Pydantic alpha. The lock updates include the `code`\npackage lock and the `evals` lock entry that mirrors the local\n`deepagents-code` dependency.\n\nThe LangChain-side hardening is being handled separately in\nlangchain-ai/langchain#38480.","tree":{"sha":"52389d776aa8ee6fa57f1a7c9176671f516eea22","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/52389d776aa8ee6fa57f1a7c9176671f516eea22"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/38a370b829beb94fb4ef3b5bff6f327a75908f07","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPiopCRC1aQ7uu5UhlAAA5n8QAAMxKE0o60/lmTAb0B/438Nk\nKliwkQKCqVgomuaV/7sBti09waMG3XDXVtGsRUU83icOifUtnxl6xI3cIjIFudy3\nR4ZWLhuJhF7UMZJzGPzZhW9CfhOh1KCB8d4xqumBaLCUWe+lICA1LLEpUNpOFPZQ\nJK96FRY3AqUgnqwivDUUzZ8SkQbiVfvNyMJOFam8Vht8GEu4PE/p8XQYju470aK7\nunukecfJqjuIULESiGV6ms//3pgn9xgu+rQ1Uo4Gy4KehRO78ASIjk7h2RKvzrOA\nDq57edExJZaTyAapPKn7ih8Cj4LlM70Ro07p8JE7WrgK21o8p12VbQmNNqNn7Oup\nBZIehLmevyIBBOm6qSCeA+5dtNVQtkkWVpEb1nEWDitRNr2hHY3AY/drLazXD+uK\nYJvD1zwcw4Hs/Th95HveO3cJOjI5fgtJOHPpEYk/dQ/bx7WiOehOptvARo1QhBmo\nbphsYJsBy9XBIt3EJFyy3s88BucKnuu6CJWG9YWTGz97CsiRB4Sd23mz2+U6rPyz\nvoQrfOWp1izdbGKq02NHSXflHSmtkGuKnTNfg/kCRah9n7uSQ03XFnUza+7XRW5Y\nxGuOS6p+qS/LGVy58uIiSgBHZ3vnWmtTIbGneCIrCxTmCUmXjmE1Nn1+nLXrlD6K\nPohB03+e0+GJQeg02UGT\n=aP4X\n-----END PGP SIGNATURE-----\n","payload":"tree 52389d776aa8ee6fa57f1a7c9176671f516eea22\nparent e645adf7ec0e8d12e355d7a22302595b45b33710\nauthor Mason Daugherty <mason@langchain.dev> 1782458921 -0400\ncommitter GitHub <noreply@github.com> 1782458921 -0400\n\nchore(code,evals,talon): cap Pydantic below 2.14 alpha (#4315)\n\n`deepagents-code` currently has to resolve with prereleases enabled\nbecause it pins the prerelease SDK package `deepagents==0.7.0a2`. That\nglobal prerelease mode can also pull unrelated transitive prereleases.\n\nIn practice, installer-style `uv tool install --prerelease allow\ndeepagents-code==0.1.25` can select `pydantic==2.14.0a1`. That alpha\ncurrently exposes a LangChain class-construction failure on Python\n3.12/3.13 while importing `BaseLLM`, which causes `dcode` startup to\ncrash with `'function' object is not subscriptable` while evaluating\n`dict[str, Any] | None`.\n\nThis adds a temporary direct Pydantic bound for `deepagents-code` so the\ninstaller still permits the prerelease Deep Agents SDK while avoiding\nthe unrelated Pydantic alpha. The lock updates include the `code`\npackage lock and the `evals` lock entry that mirrors the local\n`deepagents-code` dependency.\n\nThe LangChain-side hardening is being handled separately in\nlangchain-ai/langchain#38480.","verified_at":"2026-06-26T07:28:41Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/38a370b829beb94fb4ef3b5bff6f327a75908f07","html_url":"https://github.com/langchain-ai/deepagents/commit/38a370b829beb94fb4ef3b5bff6f327a75908f07","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/38a370b829beb94fb4ef3b5bff6f327a75908f07/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e645adf7ec0e8d12e355d7a22302595b45b33710","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/e645adf7ec0e8d12e355d7a22302595b45b33710","html_url":"https://github.com/langchain-ai/deepagents/commit/e645adf7ec0e8d12e355d7a22302595b45b33710"}]},{"sha":"e645adf7ec0e8d12e355d7a22302595b45b33710","node_id":"C_kwDOPTymldoAKGU2NDVhZGY3ZWMwZThkMTJlMzU1ZDdhMjIzMDI1OTViNDViMzM3MTA","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T07:18:52Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T07:18:52Z"},"message":"hotfix(code): avoid reinstalling existing `uv` (#4314)\n\nThe install script now resolves an existing `uv` before invoking the\nupstream installer, including installs that are present in\n`~/.local/bin` but hidden by a minimal MDM or cron PATH. Bad `UV_BIN`\nvalues fail fast with a clear error instead of falling through to a\nnetwork install attempt.\n\n## Changes\n- Added `resolve_uv_bin` to check `UV_BIN`, PATH, uv’s generated env\nfile, and `~/.local/bin/uv` before installing uv.\n- Hardened env-file sourcing so stale or hand-written `~/.local/bin/env`\nfiles with non-zero commands do not abort the installer.\n- Tightened `UV_BIN` path validation so directories are rejected before\n`uv tool install` runs.\n- Added installer regression coverage for minimal-PATH uv detection,\ndefensive env-file sourcing, and invalid `UV_BIN` values.","tree":{"sha":"9bd06ad20b429c822b9b9802608b7edf0d9c8926","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/9bd06ad20b429c822b9b9802608b7edf0d9c8926"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/e645adf7ec0e8d12e355d7a22302595b45b33710","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPifcCRC1aQ7uu5UhlAAASvoQABT9uCpm6EElMcocLX8bJGWN\n6PI+ZCNPRKz5of8GVAQ1NcgZBAMgtv4NGkheHTqAnmR4P1JFJB+1vMd+KbKLarQS\nATi9MZ6XrprM5msODDbGwf8LnojZGySTYmma/DwB0lg3qNlSsBWWn/QJabQpz7Iw\nS4wH8pX/GJC4eauaeZGAj/GNnkEwcXqrm15F4U3A8vw7KVDnRmQXrMhsFaedrGi2\nSjH/j9c/l92191bt/3TU3Gte/J5w8OHFFzoS0ISTz45abMJQBK/iRDEAFKWsaCn2\nalADZHJZXP3Y1DDfqiDeiYwTO4kQO9+fdr+cC2pwDvZlwrsmzUFo8tv+eqkyS9Ks\njuGz9rbPbyUA+3ya0qkMV13fAq+5wtZYr7gpJ+xzX85/RdBLkvb5RcDO/ERQuiHR\nR5802chd2NScSm8pSOs/JoPqPJW1ZTfXhhttnCYfCd/5zNr9WLT7LmAf6AFoQ9Fi\n4VbgTYR+6jvPcyuVXs/ma2UwinZznESABrwjEl7f8YuWz48ibRxnzjj1B/IqL1UC\nlVbEBpP8UBEj5ePzPSPLYe4v0a2H8H7vaTXymFvp6+yEO46seRbLd7HTMFImIH8M\nmQv9ITIRA5Ppf8JsIJnR8aW9A9cHVysz06qo2p8DIDbixLROfxBY0eANhSn8X+wv\nTjH8Quv4/XX8YY2O663h\n=ShsN\n-----END PGP SIGNATURE-----\n","payload":"tree 9bd06ad20b429c822b9b9802608b7edf0d9c8926\nparent 09ad92f6371ce2915a3fc0d5ff94fc13d4b67778\nauthor Mason Daugherty <mason@langchain.dev> 1782458332 -0400\ncommitter GitHub <noreply@github.com> 1782458332 -0400\n\nhotfix(code): avoid reinstalling existing `uv` (#4314)\n\nThe install script now resolves an existing `uv` before invoking the\nupstream installer, including installs that are present in\n`~/.local/bin` but hidden by a minimal MDM or cron PATH. Bad `UV_BIN`\nvalues fail fast with a clear error instead of falling through to a\nnetwork install attempt.\n\n## Changes\n- Added `resolve_uv_bin` to check `UV_BIN`, PATH, uv’s generated env\nfile, and `~/.local/bin/uv` before installing uv.\n- Hardened env-file sourcing so stale or hand-written `~/.local/bin/env`\nfiles with non-zero commands do not abort the installer.\n- Tightened `UV_BIN` path validation so directories are rejected before\n`uv tool install` runs.\n- Added installer regression coverage for minimal-PATH uv detection,\ndefensive env-file sourcing, and invalid `UV_BIN` values.","verified_at":"2026-06-26T07:18:52Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/e645adf7ec0e8d12e355d7a22302595b45b33710","html_url":"https://github.com/langchain-ai/deepagents/commit/e645adf7ec0e8d12e355d7a22302595b45b33710","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/e645adf7ec0e8d12e355d7a22302595b45b33710/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"09ad92f6371ce2915a3fc0d5ff94fc13d4b67778","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/09ad92f6371ce2915a3fc0d5ff94fc13d4b67778","html_url":"https://github.com/langchain-ai/deepagents/commit/09ad92f6371ce2915a3fc0d5ff94fc13d4b67778"}]},{"sha":"09ad92f6371ce2915a3fc0d5ff94fc13d4b67778","node_id":"C_kwDOPTymldoAKDA5YWQ5MmY2MzcxY2UyOTE1YTNmYzBkNWZmOTRmYzEzZDRiNjc3Nzg","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T06:23:19Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T06:23:19Z"},"message":"hotfix(code): allow prerelease dependencies in installer (#4308)\n\nFollow-up to fd0b17deb023f498fe97de558cc55d031ee55295, which changed the\ninstaller to use `--prerelease if-necessary` but still allowed uv to\nresolve `deepagents-code==0.1.22` instead of the latest release that\npins `deepagents==0.7.0a2`.\n\n`if-necessary` is not enough here because uv can satisfy the top-level\n`deepagents-code` requirement with an older stable candidate. The\ninstaller now defaults to `--prerelease allow`, which lets the latest\nstable `deepagents-code` release resolve even when it depends on a\nprerelease SDK.","tree":{"sha":"9c78d927b2289853b2539357731c6906b6dc0c57","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/9c78d927b2289853b2539357731c6906b6dc0c57"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/09ad92f6371ce2915a3fc0d5ff94fc13d4b67778","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPhrXCRC1aQ7uu5UhlAAAKbgQAGQ9QL0R44aIxU7oQYw82/0P\nYxzxHkQo77uBZ5FWwMGp0Mo+9r7mHW73CCtY0nAg3UYkTJ1xP+BIs0yJsIcfVTMb\nRrApY1kAnomlqw3Lp8c7OKUxwRVAHBXKGhSewk5uiZjsMYLt6d7UqsEHqoGZeeRz\nJjOgzytnmRbES1DOK69vlHRnP2A2PNFacrmwpX5hXhtXHBkJ3iZIE8zfskmlb9Nu\nHcnJ48JPJCP1DaA1MPRszvAUCTJEJ7ifMPaXUDhCjfJEfWtiPBJhmGfehM2LeSK3\njRmAHjyv1+nABNytppILhI6bv0PasTSvbIZp6+G8KaiopC1u5YZLhQZ8RWDfsmf7\ni7QOTDX/iG12r9aCYptnWK+qzzqPr6xA56682IjQE6vAQFwaPIBQ6BrG/RtZIFCz\n1soVGbgZlsTDtnCS9/zOZCIQH1JuMnq47L3FtFggLHzZ5jztOr6WWrfqkbC6Zua6\nsL/LY5SLtcFqDb7XdRpAP49U/kmlunDEQMACBKQSCll0NyfZJMseCgLoo//lpo9h\nN/udL1Ut4k/KEulj7u4E3QWrsoqHHmBfMHwjDvQKOWJ4pxggeduWwWvLM4HzrGi0\nR+hckQSUxzRKsnTraexSYC96mgDjj+Tt1VUH19n300xNYjOGTzQfz73Kjwsb6KLt\nP03eyXAN189UTVhqRinN\n=fkj/\n-----END PGP SIGNATURE-----\n","payload":"tree 9c78d927b2289853b2539357731c6906b6dc0c57\nparent fd0b17deb023f498fe97de558cc55d031ee55295\nauthor Mason Daugherty <mason@langchain.dev> 1782454999 -0400\ncommitter GitHub <noreply@github.com> 1782454999 -0400\n\nhotfix(code): allow prerelease dependencies in installer (#4308)\n\nFollow-up to fd0b17deb023f498fe97de558cc55d031ee55295, which changed the\ninstaller to use `--prerelease if-necessary` but still allowed uv to\nresolve `deepagents-code==0.1.22` instead of the latest release that\npins `deepagents==0.7.0a2`.\n\n`if-necessary` is not enough here because uv can satisfy the top-level\n`deepagents-code` requirement with an older stable candidate. The\ninstaller now defaults to `--prerelease allow`, which lets the latest\nstable `deepagents-code` release resolve even when it depends on a\nprerelease SDK.","verified_at":"2026-06-26T06:23:20Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/09ad92f6371ce2915a3fc0d5ff94fc13d4b67778","html_url":"https://github.com/langchain-ai/deepagents/commit/09ad92f6371ce2915a3fc0d5ff94fc13d4b67778","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/09ad92f6371ce2915a3fc0d5ff94fc13d4b67778/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"fd0b17deb023f498fe97de558cc55d031ee55295","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/fd0b17deb023f498fe97de558cc55d031ee55295","html_url":"https://github.com/langchain-ai/deepagents/commit/fd0b17deb023f498fe97de558cc55d031ee55295"}]},{"sha":"fd0b17deb023f498fe97de558cc55d031ee55295","node_id":"C_kwDOPTymldoAKGZkMGIxN2RlYjAyM2Y0OThmZTk3ZGU1NThjYzU1ZDAzMWVlNTUyOTU","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T06:15:49Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T06:15:49Z"},"message":"hotfix(code): use `if-necessary` for installer prerelease resolution (#4306)\n\nStable `deepagents-code` releases can temporarily depend on pre-release\npackages, which made the default installer path fail when uv refused\npre-release resolution. The installer now applies uv's `if-necessary`\nstrategy for unpinned installs while keeping exact version pins mutually\nexclusive with explicitly requested pre-release settings.\n\n## Changes\n\n- Default unpinned installs to `--prerelease if-necessary`, but avoid\nforwarding that default when `DEEPAGENTS_CODE_VERSION` selects an exact\npackage version.\n- Keep the mutual-exclusion error for explicit\n`DEEPAGENTS_CODE_PRERELEASE` plus `DEEPAGENTS_CODE_VERSION`, preserving\npinned install behavior.\n- Filter uv download/build progress and newer timing summary variants\nfrom non-verbose output while preserving them under\n`DEEPAGENTS_CODE_VERBOSE=1`.\n- Shorten the managed ripgrep setup message so the installer no longer\nadvertises the opt-out path during the normal setup flow.","tree":{"sha":"80259cddf7c40971334936861a797d43df6636b6","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/80259cddf7c40971334936861a797d43df6636b6"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/fd0b17deb023f498fe97de558cc55d031ee55295","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPhkVCRC1aQ7uu5UhlAAAW9cQAJuqjGQuNkA3zRvlSF3TdtRA\ne+MqMuw+VrwQ6mE6pscTRm4oKZZqjaUvDDe7FgOZJ5nh04DZsjOcqojRw+ap4FGS\n7eCNjLlYEcjZqdBpsX/ZpJ7DQyPFHLxawzgxuZhBGTyXiE6kbjHradPc67gBmTFk\nfR4yrqsRDGfp4e+Uj0z2pyO9LNSNcVFpiF1cP0qwwvJzHrFXMnkYyUK2cZXL3bvW\n2tyJEft3IqoXE7o7JRYwi/OmxvPNrYZbiOCx3zISp3ntuQ9cXsR7e/y3bpeZ0eZO\nYwJx6u3ynu/zg1ZqyQdm4uAczGtaY5yiO3N/LbxKDGDydGMD0RH9dtDasqb6WTLX\nwLQPVZsvbA2w/4qC0KhgrTYh33SPZnBw4ouUbK9BYBUA04+JQUN0nBR7S+pY6PsO\niThT64K8uV6gtg7vIehRVd4JHcMNxPModQvUlwCbTeTtX6gTcEk3fzfTJHxUtq8q\nRdvgs+Jw6LYcqP3GP4dV8DTASt9WQI5cIxhPpAZoa4MFXATebWJmOhH58tgVBh9F\nhcQbzJA3DAxo5KjCFEZUnEik2ndB5KcQC3Q7qydLm8AZZbmDIaVOuzH8Ji3xMQnX\nIF/34V2AMCdY/R4pinvCYGjXoxidAAHiFb3SMea+6XgahBVrOP9eTslwhqqRtJZc\n88/UEAJTGzmXX+UxrY+r\n=zflS\n-----END PGP SIGNATURE-----\n","payload":"tree 80259cddf7c40971334936861a797d43df6636b6\nparent 9f2622d0a0054083dd3f9965c26ebb1eda150cbc\nauthor Mason Daugherty <mason@langchain.dev> 1782454549 -0400\ncommitter GitHub <noreply@github.com> 1782454549 -0400\n\nhotfix(code): use `if-necessary` for installer prerelease resolution (#4306)\n\nStable `deepagents-code` releases can temporarily depend on pre-release\npackages, which made the default installer path fail when uv refused\npre-release resolution. The installer now applies uv's `if-necessary`\nstrategy for unpinned installs while keeping exact version pins mutually\nexclusive with explicitly requested pre-release settings.\n\n## Changes\n\n- Default unpinned installs to `--prerelease if-necessary`, but avoid\nforwarding that default when `DEEPAGENTS_CODE_VERSION` selects an exact\npackage version.\n- Keep the mutual-exclusion error for explicit\n`DEEPAGENTS_CODE_PRERELEASE` plus `DEEPAGENTS_CODE_VERSION`, preserving\npinned install behavior.\n- Filter uv download/build progress and newer timing summary variants\nfrom non-verbose output while preserving them under\n`DEEPAGENTS_CODE_VERBOSE=1`.\n- Shorten the managed ripgrep setup message so the installer no longer\nadvertises the opt-out path during the normal setup flow.","verified_at":"2026-06-26T06:15:50Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/fd0b17deb023f498fe97de558cc55d031ee55295","html_url":"https://github.com/langchain-ai/deepagents/commit/fd0b17deb023f498fe97de558cc55d031ee55295","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/fd0b17deb023f498fe97de558cc55d031ee55295/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"9f2622d0a0054083dd3f9965c26ebb1eda150cbc","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9f2622d0a0054083dd3f9965c26ebb1eda150cbc","html_url":"https://github.com/langchain-ai/deepagents/commit/9f2622d0a0054083dd3f9965c26ebb1eda150cbc"}]},{"sha":"9f2622d0a0054083dd3f9965c26ebb1eda150cbc","node_id":"C_kwDOPTymldoAKDlmMjYyMmQwYTAwNTQwODNkZDNmOTk2NWMyNmViYjFlZGExNTBjYmM","commit":{"author":{"name":"github-actions[bot]","email":"41898282+github-actions[bot]@users.noreply.github.com","date":"2026-06-26T06:02:58Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T06:02:58Z"},"message":"release(deepagents-code): 0.1.25 (#4289)\n\n> [!CAUTION]\n> Merging this PR will automatically publish to **PyPI** and create a\n**GitHub release**.\n\nFor the full release process, see\n[`.github/RELEASING.md`](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md).\n\n---\n\n_Everything below this line will be the GitHub release body._\n\n---\n\n\n##\n[0.1.25](https://github.com/langchain-ai/deepagents/compare/deepagents-code==0.1.24...deepagents-code==0.1.25)\n(2026-06-26)\n\n### Bug Fixes\n\n* Bind ephemeral port instead of squatting `langgraph dev`'s 2024\n([#4264](https://github.com/langchain-ai/deepagents/issues/4264))\n([11e5359](https://github.com/langchain-ai/deepagents/commit/11e5359851f0291783661b4311ad5e4436a36fb7))\n* Block dotenv shell startup hooks\n([#4288](https://github.com/langchain-ai/deepagents/issues/4288))\n([686d6f3](https://github.com/langchain-ai/deepagents/commit/686d6f3a1da8b6393efb4c0cf87b3eb35e0cca50))\n* Defer server graph construction\n([#4300](https://github.com/langchain-ai/deepagents/issues/4300))\n([220dfc0](https://github.com/langchain-ai/deepagents/commit/220dfc0e6b03f9ccb499c6b850c586b9d57cc077))\n* Avoid blocking MCP imports during graph readiness\n([#4302](https://github.com/langchain-ai/deepagents/issues/4302))\n([7533ca8](https://github.com/langchain-ai/deepagents/commit/7533ca89f3afc9863ba5e1ecee2d4c5974dea320))\n* Gate `delete` file operations\n([#4299](https://github.com/langchain-ai/deepagents/issues/4299))\n([92a8681](https://github.com/langchain-ai/deepagents/commit/92a86819adfefbc6ccfd01a861191ba292eca754))\n* Handle recursive `fetch_url` conversion\n([#4257](https://github.com/langchain-ai/deepagents/issues/4257))\n([f240a40](https://github.com/langchain-ai/deepagents/commit/f240a40dc05d812c38e9926c1d81ba38deb86e3f))\n* Report editable SDK runtime version\n([#4304](https://github.com/langchain-ai/deepagents/issues/4304))\n([4439e91](https://github.com/langchain-ai/deepagents/commit/4439e912da4bfa6f1e38e14b5a03d2bfe9367d3b))\n* Show months instead of \"0y ago\" for 360-364 day old timestamps\n([#4267](https://github.com/langchain-ai/deepagents/issues/4267))\n([820b331](https://github.com/langchain-ai/deepagents/commit/820b331552cb7ce4695ddca3c9b8343a3144392b))\n* Surface `/auth`-stored credentials in `config show`/`get`\n([#4258](https://github.com/langchain-ai/deepagents/issues/4258))\n([c7c8788](https://github.com/langchain-ai/deepagents/commit/c7c8788ecf0068914298a6055a5f3fd31c36bd44))\n* Switch input mode without flashing the mode trigger\n([#4243](https://github.com/langchain-ai/deepagents/issues/4243))\n([fc5d9cb](https://github.com/langchain-ai/deepagents/commit/fc5d9cb8fb978ec95f98407692d4809ea1e86577))\n\n---\n\n_Everything above this line will be the GitHub release body._\n\n---\n\n> [!NOTE]\n> A **New Contributors** section is appended to the GitHub release notes\nautomatically at publish time (see [Release\nPipeline](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md#release-pipeline),\nstep 2).\n\n---------\n\nCo-authored-by: github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","tree":{"sha":"f2e33cbf91d39e32c000996a7d7cf1ed31a41797","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/f2e33cbf91d39e32c000996a7d7cf1ed31a41797"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/9f2622d0a0054083dd3f9965c26ebb1eda150cbc","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPhYSCRC1aQ7uu5UhlAAA4XcQAFNaVASOkFEfAgNTX6DrqGQm\nejPcDpkG2+1Fa0nifhW+Xd0HLMResgyk2XTj/NtL9CCk6deDD1FV1jhjAhm8KWUQ\nY5KC1jCY4+CNA/cvHrXyE+TPPA4bLrfveRxPSoYU/T1bsuZCVzNWDvYo19xIVRgJ\nhean+yR9KjiBvdXYYRObu2vHWsLhBGK2SDTTxLo5vspoCCEqpNMvwW6+oHw43msn\nQjq5qRkUKRBKb+ns/+eBlkWnsFcc01C1p4Mo7yJ6fMwL5rP96vmkW8VhYZXNn+EF\nDkJeSUAEhMensU28YefUAwPI3MGw92aFsKP65Ni6wGzr3iQAja3+8TGYjUely9lF\n6DXDm4jew9yDCC4mwDagJ7o8qs2+e1dQUYDVhCBfzWu0sF56K54hx7vFG8w4AQsX\nLJbFnln8+AgkL5uyx23fOiJh7qR4iOksSkTtE/JN85F8kjT/S2xwOqfj6mQQI6QM\n4KNaJR9I94bdD5Cfz7h2Mu96ZE8FnLcdz183Bapxj2q/DYY/qk+CDtWy0lovClbu\n03SyJGDbSh4iD1ITG26179BmA8FX8NeiPuycuLO8F4eq2B4dgO2TbNENgxjUrrAJ\nHZtZew7yHHglDH66jDqNmw+IfvkRQ2EvhBMEs0USeaCe4ujqJ26A20VZdZ9ZJntM\nfyHD1ySxpO0MILqTRCDK\n=JZCJ\n-----END PGP SIGNATURE-----\n","payload":"tree f2e33cbf91d39e32c000996a7d7cf1ed31a41797\nparent 4439e912da4bfa6f1e38e14b5a03d2bfe9367d3b\nauthor github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com> 1782453778 -0400\ncommitter GitHub <noreply@github.com> 1782453778 -0400\n\nrelease(deepagents-code): 0.1.25 (#4289)\n\n> [!CAUTION]\n> Merging this PR will automatically publish to **PyPI** and create a\n**GitHub release**.\n\nFor the full release process, see\n[`.github/RELEASING.md`](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md).\n\n---\n\n_Everything below this line will be the GitHub release body._\n\n---\n\n\n##\n[0.1.25](https://github.com/langchain-ai/deepagents/compare/deepagents-code==0.1.24...deepagents-code==0.1.25)\n(2026-06-26)\n\n### Bug Fixes\n\n* Bind ephemeral port instead of squatting `langgraph dev`'s 2024\n([#4264](https://github.com/langchain-ai/deepagents/issues/4264))\n([11e5359](https://github.com/langchain-ai/deepagents/commit/11e5359851f0291783661b4311ad5e4436a36fb7))\n* Block dotenv shell startup hooks\n([#4288](https://github.com/langchain-ai/deepagents/issues/4288))\n([686d6f3](https://github.com/langchain-ai/deepagents/commit/686d6f3a1da8b6393efb4c0cf87b3eb35e0cca50))\n* Defer server graph construction\n([#4300](https://github.com/langchain-ai/deepagents/issues/4300))\n([220dfc0](https://github.com/langchain-ai/deepagents/commit/220dfc0e6b03f9ccb499c6b850c586b9d57cc077))\n* Avoid blocking MCP imports during graph readiness\n([#4302](https://github.com/langchain-ai/deepagents/issues/4302))\n([7533ca8](https://github.com/langchain-ai/deepagents/commit/7533ca89f3afc9863ba5e1ecee2d4c5974dea320))\n* Gate `delete` file operations\n([#4299](https://github.com/langchain-ai/deepagents/issues/4299))\n([92a8681](https://github.com/langchain-ai/deepagents/commit/92a86819adfefbc6ccfd01a861191ba292eca754))\n* Handle recursive `fetch_url` conversion\n([#4257](https://github.com/langchain-ai/deepagents/issues/4257))\n([f240a40](https://github.com/langchain-ai/deepagents/commit/f240a40dc05d812c38e9926c1d81ba38deb86e3f))\n* Report editable SDK runtime version\n([#4304](https://github.com/langchain-ai/deepagents/issues/4304))\n([4439e91](https://github.com/langchain-ai/deepagents/commit/4439e912da4bfa6f1e38e14b5a03d2bfe9367d3b))\n* Show months instead of \"0y ago\" for 360-364 day old timestamps\n([#4267](https://github.com/langchain-ai/deepagents/issues/4267))\n([820b331](https://github.com/langchain-ai/deepagents/commit/820b331552cb7ce4695ddca3c9b8343a3144392b))\n* Surface `/auth`-stored credentials in `config show`/`get`\n([#4258](https://github.com/langchain-ai/deepagents/issues/4258))\n([c7c8788](https://github.com/langchain-ai/deepagents/commit/c7c8788ecf0068914298a6055a5f3fd31c36bd44))\n* Switch input mode without flashing the mode trigger\n([#4243](https://github.com/langchain-ai/deepagents/issues/4243))\n([fc5d9cb](https://github.com/langchain-ai/deepagents/commit/fc5d9cb8fb978ec95f98407692d4809ea1e86577))\n\n---\n\n_Everything above this line will be the GitHub release body._\n\n---\n\n> [!NOTE]\n> A **New Contributors** section is appended to the GitHub release notes\nautomatically at publish time (see [Release\nPipeline](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md#release-pipeline),\nstep 2).\n\n---------\n\nCo-authored-by: github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","verified_at":"2026-06-26T06:02:59Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9f2622d0a0054083dd3f9965c26ebb1eda150cbc","html_url":"https://github.com/langchain-ai/deepagents/commit/9f2622d0a0054083dd3f9965c26ebb1eda150cbc","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9f2622d0a0054083dd3f9965c26ebb1eda150cbc/comments","author":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"4439e912da4bfa6f1e38e14b5a03d2bfe9367d3b","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4439e912da4bfa6f1e38e14b5a03d2bfe9367d3b","html_url":"https://github.com/langchain-ai/deepagents/commit/4439e912da4bfa6f1e38e14b5a03d2bfe9367d3b"}]},{"sha":"4439e912da4bfa6f1e38e14b5a03d2bfe9367d3b","node_id":"C_kwDOPTymldoAKDQ0MzllOTEyZGE0YmZhNmYxZTM4ZTE0YjVhMDNkMmJmZTkzNjdkM2I","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T05:56:54Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T05:56:54Z"},"message":"fix(code): report editable SDK runtime version (#4304)\n\nEditable SDK installs can leave package metadata behind when the local\nsource version changes. Version reporting now detects when `deepagents`\nitself is installed editable and reads the imported SDK’s runtime\n`__version__`, while keeping metadata-based behavior for normal installs\nand fallback cases.\n\n## Changes\n\n- Teach `resolve_sdk_version()` to detect editable `deepagents` installs\nvia `direct_url.json` and prefer runtime `deepagents.__version__` when\navailable.\n- Keep normal package installs on\n`importlib.metadata.version(\"deepagents\")`, and degrade back to metadata\nwhen editable metadata is malformed or the runtime version cannot be\nread.\n- Cover stale editable metadata, non-editable metadata, malformed\neditable metadata, import failures, and unusable runtime versions in\n`TestResolveSdkVersion`.","tree":{"sha":"260a691e2d13d0b1542588c0f864411dcf268d5a","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/260a691e2d13d0b1542588c0f864411dcf268d5a"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/4439e912da4bfa6f1e38e14b5a03d2bfe9367d3b","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPhSmCRC1aQ7uu5UhlAAAy6gQAEBY6skjQTPDT6VRSJyc+QhB\nHg8wdrDxzyYNfJ2jmcF/wyrsjkyVmAjLvNzaFw8aLN4o4JZf+KE0eTxB4FZw/bdM\nPoULPplaSNCPsFwbFJuiWenqDVCX8wgDXEimAHTRJDiELdWOP/M+z1NGFvb1brol\nyBNAX/UTXNM7Adzhw6hKAJR4UQ4J657JtFhax2QS2QcTwr9Bxsp7NZqZqfTwoK5m\noyF9onrhYM8kDJvKnK+G0WobrB06bgvFgdt8KXbnO3SoXGDnpf7m09tAKsND3GND\n7kVzN7QLHrqkjfQ2Omh31PxQA9F8aPKfI/na6YRVkujY1Zwa2+yEbWdX02zh4gdK\n/C24Bj05jNUddC3O7F/yke6h1i4sEurExXt7n10LgR6xhcZ98UvahwQab30wsvzZ\nxlK5MZoORk4jBK3GwZwIoqoVgUry8gpBLK6dEsADRFmFq2o2P3yhNFxOZL5kqQNa\nbifAIDxeKKRwteDzX5kVfRWKibn9M/6pffT/0qJgdFEAPHiaMrC0B15kia34tP7T\nfr385nuKWXS7+x88ZKcthtJ+HMBzxyus4Y5hZpye2jDRVHhXw5/4akZ0AgnM9Lru\nY2r5qJfc3VvnJm5JiELUsMCN0SEk415jJlr45o4bNvtLwswBtKDSZiZobT8wdFDz\nNtR3QbZ+vjnOIFlOzuoO\n=MABr\n-----END PGP SIGNATURE-----\n","payload":"tree 260a691e2d13d0b1542588c0f864411dcf268d5a\nparent 76d0476811de2ce3c79a2b7b686233a2907ad13e\nauthor Mason Daugherty <mason@langchain.dev> 1782453414 -0400\ncommitter GitHub <noreply@github.com> 1782453414 -0400\n\nfix(code): report editable SDK runtime version (#4304)\n\nEditable SDK installs can leave package metadata behind when the local\nsource version changes. Version reporting now detects when `deepagents`\nitself is installed editable and reads the imported SDK’s runtime\n`__version__`, while keeping metadata-based behavior for normal installs\nand fallback cases.\n\n## Changes\n\n- Teach `resolve_sdk_version()` to detect editable `deepagents` installs\nvia `direct_url.json` and prefer runtime `deepagents.__version__` when\navailable.\n- Keep normal package installs on\n`importlib.metadata.version(\"deepagents\")`, and degrade back to metadata\nwhen editable metadata is malformed or the runtime version cannot be\nread.\n- Cover stale editable metadata, non-editable metadata, malformed\neditable metadata, import failures, and unusable runtime versions in\n`TestResolveSdkVersion`.","verified_at":"2026-06-26T05:56:54Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4439e912da4bfa6f1e38e14b5a03d2bfe9367d3b","html_url":"https://github.com/langchain-ai/deepagents/commit/4439e912da4bfa6f1e38e14b5a03d2bfe9367d3b","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4439e912da4bfa6f1e38e14b5a03d2bfe9367d3b/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"76d0476811de2ce3c79a2b7b686233a2907ad13e","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/76d0476811de2ce3c79a2b7b686233a2907ad13e","html_url":"https://github.com/langchain-ai/deepagents/commit/76d0476811de2ce3c79a2b7b686233a2907ad13e"}]},{"sha":"76d0476811de2ce3c79a2b7b686233a2907ad13e","node_id":"C_kwDOPTymldoAKDc2ZDA0NzY4MTFkZTJjZTNjNzlhMmI3YjY4NjIzM2EyOTA3YWQxM2U","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T05:28:49Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T05:28:49Z"},"message":"docs(repo): explain prerelease branch constraint (#4303)\n\nClarifies why alpha, beta, RC, and `.dev` version bumps must stay off\n`main` and long-lived `vX.Y` branches.\n\nThe release docs now explain the underlying release-please limitation:\nPyPI requires PEP 440 prerelease versions like `0.0.35a1`, but\nrelease-please's `_version.py` updater does not match those values. If a\nprerelease version lands on a long-lived branch, a later GA release PR\ncan update `pyproject.toml` while leaving `_version.py` stuck on the\nprerelease version.","tree":{"sha":"e1749402b3a81152c25b887f67565a4c94e6bc3b","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/e1749402b3a81152c25b887f67565a4c94e6bc3b"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/76d0476811de2ce3c79a2b7b686233a2907ad13e","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPg4RCRC1aQ7uu5UhlAAARdsQAJzBnYha3VTZ0Q9pGLHUi8xr\nm8Js5KmXR/dCutESodRtP1r0qpd4W7tisZGDg07I/fZdWJB7jnpYZuAcZMAqj5J8\nUHmLKByKzjDrW3NDlhckt1tl6Zmg2FVP/6ecDTwPiPLkxJW4FrlFXc499h1JyicV\nKjWhD/dv/B5SaHGB8czkXVcf2K+muvytTKKaXvTsT8iu4wVYlVBDmHFT8IiaevX9\nEHj6rjZ/QY07ps7YC+PdVI7BRDID9G4LOmk8v3cMY5bBkfrROfQBhaNJpLkis667\nCEd6uxBaSXLdi5sfCwG96Ja//euvGjApG5ZGLQNeu2jxa+Kd60bewuAndV7wW1UL\ncXqagliMfbil8PoUSINfvp3vM8FaBRseD0syXqlKk8emUNvdP9aeFE388NplEddu\nme3RMOWBHQqYZ/iG2gjU1AjvjiopcJ3qZgudcEUyPnfI3zr+LISpxkGne7o555YL\n3HimFLiynoVMTiFOAL9CWHyRAftHe/ahwRaN2Pv3/u0lw75vcnVfv3y1OaNe4C+m\nnvjoY/5L5dKBqoqHLS7yPqOHxST/kKnmgfd1Nii+BiVWIYRNPYLJT9CdH02roWJK\nw7ragSFl0ykj6zBuWd6c+k53x0Lc7hkEXxPZCdtxvcPvPOJ78cOy9uzqugLW9rT5\n7RN9VtudvgeJqxJcrIBP\n=Nx/s\n-----END PGP SIGNATURE-----\n","payload":"tree e1749402b3a81152c25b887f67565a4c94e6bc3b\nparent fc5d9cb8fb978ec95f98407692d4809ea1e86577\nauthor Mason Daugherty <mason@langchain.dev> 1782451729 -0400\ncommitter GitHub <noreply@github.com> 1782451729 -0400\n\ndocs(repo): explain prerelease branch constraint (#4303)\n\nClarifies why alpha, beta, RC, and `.dev` version bumps must stay off\n`main` and long-lived `vX.Y` branches.\n\nThe release docs now explain the underlying release-please limitation:\nPyPI requires PEP 440 prerelease versions like `0.0.35a1`, but\nrelease-please's `_version.py` updater does not match those values. If a\nprerelease version lands on a long-lived branch, a later GA release PR\ncan update `pyproject.toml` while leaving `_version.py` stuck on the\nprerelease version.","verified_at":"2026-06-26T05:28:50Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/76d0476811de2ce3c79a2b7b686233a2907ad13e","html_url":"https://github.com/langchain-ai/deepagents/commit/76d0476811de2ce3c79a2b7b686233a2907ad13e","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/76d0476811de2ce3c79a2b7b686233a2907ad13e/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"fc5d9cb8fb978ec95f98407692d4809ea1e86577","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/fc5d9cb8fb978ec95f98407692d4809ea1e86577","html_url":"https://github.com/langchain-ai/deepagents/commit/fc5d9cb8fb978ec95f98407692d4809ea1e86577"}]},{"sha":"fc5d9cb8fb978ec95f98407692d4809ea1e86577","node_id":"C_kwDOPTymldoAKGZjNWQ5Y2I4ZmI5NzhlYzk1Zjk4NDA3NjkyZDQ4MDllYTFlODY1Nzc","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T05:15:00Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T05:15:00Z"},"message":"fix(code): switch input mode without flashing the mode trigger (#4243)\n\nFixed a brief flash of the `!`/`/` character when switching the chat\ninput into shell, incognito, or command mode.\n\n---\n\nTyping a mode trigger (`!`, `!!`, `/`) at the start of the chat input\nflashed the literal character for one frame: `TextArea` inserted it, a\nre-entrant change pass stripped it, and `watch_mode`'s\n`call_after_refresh` swapped the prompt glyph a frame later. This\nintercepts the trigger keystroke in `ChatTextArea._on_key` and switches\nthe mode directly — without ever inserting the character — driving the\nsame completion/hint refresh inline. Mode-detection logic is extracted\ninto `_resolve_prefix_mode`, shared with the change handler, which still\ncovers the paste/history/drag-drop paths.\n\n### Related: backspace mode exit\n\nBecause the trigger is now consumed rather than inserted-then-stripped,\nthe prompt prefix is purely a mode selector and never lives in the draft\ntext. Backspace exits command/shell mode when the cursor is at the start\nof the prompt, including an empty prompt or a draft with text after the\ncursor. That preserves the draft text while clearing mode-specific UI\nsuch as slash-command argument hints. Exiting a mode (via backspace or\nEscape) no longer restores `/`, `!`, or `!!` into the input.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/6515e475-76cd-4055-e8b3-b4dceef5b10e)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"a70b688e41321a2b6f9f334e0a01a659dcae9e07","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/a70b688e41321a2b6f9f334e0a01a659dcae9e07"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/fc5d9cb8fb978ec95f98407692d4809ea1e86577","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPgrUCRC1aQ7uu5UhlAAAJiYQACY9jijQOagw7eS105FQEZ1n\nTLAEaEw/4wGtK4/wikAOwwJGVzt3EmiDzi8cCCNf/RpRE3IgaLA3o90rUGwbrM/i\nX3BWgP4SJZaGj6r51MLmFR5u2gjo03f5z8jXdBMAPmUYJONWp0pFo23DrZzxJgPV\n0BzEy4vOcDCsxrT11We1DF28UaDakyW44nZRsPvzLDux35czWAZaItGK9/f4BONn\nIG6EbLqhrO44fd4BmcsEjXPY6qMvYHh3/aSgedkDcwE03mN92ink6ZWJ3kENJHfc\nkAbdqWVxooMDFx32kopgccHIve16nIWEzxUnlq64UF3BKmR0QgdTPtnyK63Dnxp3\nX/uZn8wQfrAV0bdW+Ifq45jMIicpBi6ppoALYzsjCHTSbYSM34k/dVlvC3z4CcHv\nIpDSHdUIFsHm5C+/G/1mlY5Jtr6a3pe8gGIoxIE/arxfGaCW4PJLAr/BmhotZPa5\n8wv4wHtKA7pJLisVnnZYiC8Qk+8IDDWpePjBKt+G8lDOnhBaj/3NEt4YAh76rDiH\nUaQAHCZX1Vb4D34PvazcRTx0QuodIGRIZj12l35msG+wV47vslm50Q3pw6ytiQdd\nS6TX3V8mTGX2rfzKeI8IDv1OL0QZNAYmWcWG3mW+Y62dqI/x4VY3ra7/lOR0UFmP\nJQ0ZNEMUD7+K0MLmy9uO\n=BVrS\n-----END PGP SIGNATURE-----\n","payload":"tree a70b688e41321a2b6f9f334e0a01a659dcae9e07\nparent 7533ca89f3afc9863ba5e1ecee2d4c5974dea320\nauthor Mason Daugherty <mason@langchain.dev> 1782450900 -0400\ncommitter GitHub <noreply@github.com> 1782450900 -0400\n\nfix(code): switch input mode without flashing the mode trigger (#4243)\n\nFixed a brief flash of the `!`/`/` character when switching the chat\ninput into shell, incognito, or command mode.\n\n---\n\nTyping a mode trigger (`!`, `!!`, `/`) at the start of the chat input\nflashed the literal character for one frame: `TextArea` inserted it, a\nre-entrant change pass stripped it, and `watch_mode`'s\n`call_after_refresh` swapped the prompt glyph a frame later. This\nintercepts the trigger keystroke in `ChatTextArea._on_key` and switches\nthe mode directly — without ever inserting the character — driving the\nsame completion/hint refresh inline. Mode-detection logic is extracted\ninto `_resolve_prefix_mode`, shared with the change handler, which still\ncovers the paste/history/drag-drop paths.\n\n### Related: backspace mode exit\n\nBecause the trigger is now consumed rather than inserted-then-stripped,\nthe prompt prefix is purely a mode selector and never lives in the draft\ntext. Backspace exits command/shell mode when the cursor is at the start\nof the prompt, including an empty prompt or a draft with text after the\ncursor. That preserves the draft text while clearing mode-specific UI\nsuch as slash-command argument hints. Exiting a mode (via backspace or\nEscape) no longer restores `/`, `!`, or `!!` into the input.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/6515e475-76cd-4055-e8b3-b4dceef5b10e)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-26T05:15:00Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/fc5d9cb8fb978ec95f98407692d4809ea1e86577","html_url":"https://github.com/langchain-ai/deepagents/commit/fc5d9cb8fb978ec95f98407692d4809ea1e86577","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/fc5d9cb8fb978ec95f98407692d4809ea1e86577/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7533ca89f3afc9863ba5e1ecee2d4c5974dea320","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7533ca89f3afc9863ba5e1ecee2d4c5974dea320","html_url":"https://github.com/langchain-ai/deepagents/commit/7533ca89f3afc9863ba5e1ecee2d4c5974dea320"}]},{"sha":"7533ca89f3afc9863ba5e1ecee2d4c5974dea320","node_id":"C_kwDOPTymldoAKDc1MzNjYTg5ZjNhZmM5ODYzYmE1ZTFlY2VlMmQ0YzU5NzRkZWEzMjA","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T04:50:27Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T04:50:27Z"},"message":"fix(code): avoid blocking MCP imports during graph readiness (#4302)\n\nLangGraph dev runs the graph readiness endpoint under BlockBuster. After\nserver graph construction was deferred until `/assistants/agent/graph`,\nthe MCP-enabled startup path imported `langchain_mcp_adapters` on the\nserver event loop; that first import pulls in\n`jsonschema_specifications`, which scans package resources with\n`Path.iterdir()`, so readiness failed with `BlockingError: Blocking call\nto ScandirIterator.__next__`.\n\nThe fix warms those adapter imports in a worker thread before the MCP\nresolver runs, then keeps the actual MCP discovery async on the server\nloop. A subprocess BlockBuster regression test initially reproduced the\nexact shape, but Linux CI crashed inside that child process with\n`SIGSEGV`; the durable test now asserts the important contract\nin-process: the warmup runs before the MCP resolver, and separately that\nthe warmup and CLI graph construction stay off the event-loop thread.\n\n## Changes\n- Warm MCP adapter imports through `asyncio.to_thread()` before MCP tool\nloading, so import-time package-resource scans happen off the LangGraph\nserver event loop.\n- Offload synchronous CLI graph construction into a worker thread,\ncovering custom subagent discovery, async-subagent config loading,\nsettings updates, and other filesystem-backed setup before\n`create_cli_agent()` returns the graph.\n- Keep `make_graph()` lock-serialized and cached while documenting why\nprocess-global settings writes are safe in that single-build path.\n\n## Testing\n- Added thread-affinity assertions for MCP import warmup and CLI graph\nconstruction.\n- Added in-process regression coverage that the MCP import warmup runs\nbefore the MCP resolver, plus guards for the `no_mcp=True` skip path and\ninterpreter settings ordering.\n- Ran `make -C libs/code test\nTEST_FILE=\"tests/unit_tests/test_server_graph.py\"`.\n- Ran `make -C libs/code lint`.","tree":{"sha":"41bc487dc61bdb8814e704c456c1b7378d861039","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/41bc487dc61bdb8814e704c456c1b7378d861039"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/7533ca89f3afc9863ba5e1ecee2d4c5974dea320","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPgUTCRC1aQ7uu5UhlAAAKjcQAFHOapJFocNROOYSMRNNw0az\nHfbaHP5pqrkf2yRwMoBB8El5GoHEhIp4TT+hkAHdKWnG4K8xyKQz4GgAP15NH4pz\ntUXDYvDm9XbKiMfKuxDUoVKSyUrMgLmn90ScJ9haN+K640072zR9mkls9TWu6SfD\notvQa7+KbBRQP9uTHdQUM1h6rpfxoP6nyvnR2dvsP9YRnKLd+y+iggK3PIe0dCO1\n/dF1V1ERWWRCD9DPl0kJ2X8xfQuuLmo15Do6JXojWlW+le70zWrvs5ZifrKVdxBs\n+1Gt7oYvDkB0+L389StHyz5klOQDRaqPXT9fonyD5IKsw8sCUKgFX3ENmD5fRgWt\n7ywYjRB5H1IxdPZL7/EQ5dSSN3bQ9d51SlPDQhtdMO172N9cIkDAq3cMKr4O73TA\nRi9lS9hiLLyeuq5q4oa7Oz42C1UdLCBe8MM1VZRDVQSSFUQ0e4eWegKzXLj/f4Ib\nfrmMpqkaITv6q471Q3M+kbGU0vEnjsNJSJzT1Ac5oPprQFRFDTXLgzbOhW7gzYJM\nB4IFLHZackcliRxBGpHK0TUnFra9d/cG7AamHuBUEt8juzk4IOUo8rx+J1V6Jrh+\nnQ+GvTDfe8TDA0wzVG1GBs+eo5sT9zLMu6Y9FbjExVriyXWhesOiFiRxyK+lebls\nhmFXHfFfyd1eQyeiqTSe\n=SsgC\n-----END PGP SIGNATURE-----\n","payload":"tree 41bc487dc61bdb8814e704c456c1b7378d861039\nparent 11e5359851f0291783661b4311ad5e4436a36fb7\nauthor Mason Daugherty <mason@langchain.dev> 1782449427 -0400\ncommitter GitHub <noreply@github.com> 1782449427 -0400\n\nfix(code): avoid blocking MCP imports during graph readiness (#4302)\n\nLangGraph dev runs the graph readiness endpoint under BlockBuster. After\nserver graph construction was deferred until `/assistants/agent/graph`,\nthe MCP-enabled startup path imported `langchain_mcp_adapters` on the\nserver event loop; that first import pulls in\n`jsonschema_specifications`, which scans package resources with\n`Path.iterdir()`, so readiness failed with `BlockingError: Blocking call\nto ScandirIterator.__next__`.\n\nThe fix warms those adapter imports in a worker thread before the MCP\nresolver runs, then keeps the actual MCP discovery async on the server\nloop. A subprocess BlockBuster regression test initially reproduced the\nexact shape, but Linux CI crashed inside that child process with\n`SIGSEGV`; the durable test now asserts the important contract\nin-process: the warmup runs before the MCP resolver, and separately that\nthe warmup and CLI graph construction stay off the event-loop thread.\n\n## Changes\n- Warm MCP adapter imports through `asyncio.to_thread()` before MCP tool\nloading, so import-time package-resource scans happen off the LangGraph\nserver event loop.\n- Offload synchronous CLI graph construction into a worker thread,\ncovering custom subagent discovery, async-subagent config loading,\nsettings updates, and other filesystem-backed setup before\n`create_cli_agent()` returns the graph.\n- Keep `make_graph()` lock-serialized and cached while documenting why\nprocess-global settings writes are safe in that single-build path.\n\n## Testing\n- Added thread-affinity assertions for MCP import warmup and CLI graph\nconstruction.\n- Added in-process regression coverage that the MCP import warmup runs\nbefore the MCP resolver, plus guards for the `no_mcp=True` skip path and\ninterpreter settings ordering.\n- Ran `make -C libs/code test\nTEST_FILE=\"tests/unit_tests/test_server_graph.py\"`.\n- Ran `make -C libs/code lint`.","verified_at":"2026-06-26T04:50:27Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7533ca89f3afc9863ba5e1ecee2d4c5974dea320","html_url":"https://github.com/langchain-ai/deepagents/commit/7533ca89f3afc9863ba5e1ecee2d4c5974dea320","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7533ca89f3afc9863ba5e1ecee2d4c5974dea320/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"11e5359851f0291783661b4311ad5e4436a36fb7","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/11e5359851f0291783661b4311ad5e4436a36fb7","html_url":"https://github.com/langchain-ai/deepagents/commit/11e5359851f0291783661b4311ad5e4436a36fb7"}]},{"sha":"11e5359851f0291783661b4311ad5e4436a36fb7","node_id":"C_kwDOPTymldoAKDExZTUzNTk4NTFmMDI5MTc4MzY2MWI0MzExYWQ1ZTQ0MzZhMzZmYjc","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T04:43:44Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T04:43:44Z"},"message":"fix(code): bind ephemeral port instead of squatting `langgraph dev`'s 2024 (#4264)\n\n`deepagents-code` no longer occupies port 2024, so you can run your own\n`langgraph dev` projects alongside it without a port collision.\n\n---\n\n`deepagents-code`'s internal `langgraph dev` server defaulted to port\n2024 — the same well-known default the `langgraph` CLI uses — so it\nsquatted that port and collided with users' own `langgraph dev`\nprojects. The server is internal/ephemeral (callers only reach it via\n`ServerProcess.url`), so it now binds an OS-assigned free port by\ndefault and leaves 2024 available. Explicit ports are still honored,\nkeeping the existing in-use fallback.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/e1e18910-5c4f-7030-0c5f-cc8b2ed40d96)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"81eec392794868ec85601a9b9874f86eb34c0edc","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/81eec392794868ec85601a9b9874f86eb34c0edc"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/11e5359851f0291783661b4311ad5e4436a36fb7","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPgOACRC1aQ7uu5UhlAAAV5cQAAz5ns4hoR48jg+fOFIVgCmJ\nVxKH90Es1TIGpjMC2NmWHl1Qi3IlM94Nvcm7PXJNaL6tw3jp+4a3XKTUUreEU/dz\npnMjTuFrilTvIGW+6bXx2cDrj/xtYDNSKGW5qXex7s67J6QMBxrJuO7ur1AwZmKp\n6ilTY9HCJ2JrfQ+rGUCGykx0sEfSmITX/KKjTqn+oweRf+8W9AyaUszgzREUsY1l\njVueLwsNCTpZgAEAGx5n8xednDRRQKs3L/mQd4b9UhcLjPJiNaYA0zzGmrnotpRV\naa0VxYtTOWPA+hejKaBdMz4aKoWxQJRfVP8TKAcSBCjLsi+Fy1AkVsbOsCoETWkH\nBnZ3W3TUFfLX/+iIDJ1JmP43D+fwbzSWhcr//Tcyfka0tmLWb+5uUddup3uN1Z6C\n2hGAqN1SKGSPSOC21Nl/GnOYFufRDXTeJuTFRNcEsx+k4IEFx3rZIB2pTb7EfG6K\nvotzt6AYPvECiTlXhsc6q/HYnmddRsdxvK4EvlukRDlGkwtyvGSQ8uCi/KFDlx6A\naVGndIkUk9nNmqkbXqIksV6hO9VT89+olGxu+SzwhBUQfnYmOaJ14kMSPN5vSipe\nPlbFJgfjeQQIhmonaltp6gOFBRh4nHapXqJ1v8aMcgHva9np8CmUiIMd1srKPEWE\nGUddjet/YjxiU52Jl4Xv\n=6D7v\n-----END PGP SIGNATURE-----\n","payload":"tree 81eec392794868ec85601a9b9874f86eb34c0edc\nparent 220dfc0e6b03f9ccb499c6b850c586b9d57cc077\nauthor Mason Daugherty <mason@langchain.dev> 1782449024 -0400\ncommitter GitHub <noreply@github.com> 1782449024 -0400\n\nfix(code): bind ephemeral port instead of squatting `langgraph dev`'s 2024 (#4264)\n\n`deepagents-code` no longer occupies port 2024, so you can run your own\n`langgraph dev` projects alongside it without a port collision.\n\n---\n\n`deepagents-code`'s internal `langgraph dev` server defaulted to port\n2024 — the same well-known default the `langgraph` CLI uses — so it\nsquatted that port and collided with users' own `langgraph dev`\nprojects. The server is internal/ephemeral (callers only reach it via\n`ServerProcess.url`), so it now binds an OS-assigned free port by\ndefault and leaves 2024 available. Explicit ports are still honored,\nkeeping the existing in-use fallback.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/e1e18910-5c4f-7030-0c5f-cc8b2ed40d96)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-26T04:43:45Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/11e5359851f0291783661b4311ad5e4436a36fb7","html_url":"https://github.com/langchain-ai/deepagents/commit/11e5359851f0291783661b4311ad5e4436a36fb7","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/11e5359851f0291783661b4311ad5e4436a36fb7/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"220dfc0e6b03f9ccb499c6b850c586b9d57cc077","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/220dfc0e6b03f9ccb499c6b850c586b9d57cc077","html_url":"https://github.com/langchain-ai/deepagents/commit/220dfc0e6b03f9ccb499c6b850c586b9d57cc077"}]},{"sha":"220dfc0e6b03f9ccb499c6b850c586b9d57cc077","node_id":"C_kwDOPTymldoAKDIyMGRmYzBlNmIwM2Y5Y2NiNDk5YzZiODUwYzU4NmI5ZDU3Y2MwNzc","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T04:11:29Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T04:11:29Z"},"message":"fix(code): defer server graph construction (#4300)\n\nImport-only checks were constructing the server graph, which let runtime\nstartup behavior leak into local validation and touch a developer’s real\ndcode config. The server graph is now exposed as a LangGraph factory so\nMCP discovery runs only when the server actually builds the graph, and\nthe import checker runs against an isolated home directory.\n\n## Changes\n\n- Switch the generated LangGraph reference from `server_graph.py:graph`\nto `server_graph.py:make_graph`, relying on LangGraph’s factory support\ninstead of constructing the graph at module import time.\n- Keep startup error marker behavior inside `make_graph()` so server\nstartup failures still surface cleanly to the parent process, while\nplain imports remain side-effect free.\n- Run `check_imports.py` with a temporary `HOME` so import validation\ncannot read or depend on local `~/.deepagents` config, MCP auth tokens,\nor other user state.\n- Update server graph tests to assert MCP discovery does not happen on\nimport and still happens when `make_graph()` is invoked.\n- Override `UV_FROZEN` only for the `uv lock --check` command so `make\ncheck` performs the real lockfile freshness check without warning.\n\n## Testing\n\n- `make -C libs/code check PYTHON_FILES=\nPYTEST_EXTRA=\"tests/unit_tests/test_server_graph.py\ntests/unit_tests/test_server_manager.py -q\" COV_ARGS=`\n- `make -C libs/code check_imports`\n- Focused ruff, ty, and pytest checks for the touched server\ngraph/server manager files","tree":{"sha":"fdc37bf538668144384c1b938d2e119cdeea1bb9","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/fdc37bf538668144384c1b938d2e119cdeea1bb9"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/220dfc0e6b03f9ccb499c6b850c586b9d57cc077","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPfvxCRC1aQ7uu5UhlAAA55AQACJ8IYsLy6jMEv463DrhpJFi\nE8ekYAfla93Ef8AL7OuMpe+Ng4TRlOb1VzUd49lJAlfQe83R7elWb+MFDdW0MEOf\namM1kr0fGC2c4PJO0svwwWSCEFqKyKPdQ9RKa4f5FRjbwGguY9cZMji7c+5GdhLD\nXYQcbnEjIGOoEzjuHjYCxElOgJaBBKeSfpUvgggtLwlDHn2xuiQmrhK+7vnOJF2H\n7LRlATJQHkjlHM93u6QDbLqWAJGKYqSlSOd89IWVo+dgPebYSV6+4sqmteToCgIG\nv78QteZgio+If5zfszJIVl6R7FcWWycl1MmpVVZwFVF4sOeYtKpY+X7STtafbZhB\nu7OaZTwJLSuP4mkKw3Q7BryzpPDHd4S1Hpe8yzpJlVvgIjIyStte1Sg23ZBawphV\noQVjwU0dcjGNidG3+VeW5OMeEwltGT7gHps1VG0AC4D/JIrqfylALXnViqIt9QVQ\nhCDA7JuLKMX5FDden03D8jHqnZjnTPgqxl7Np69m6e3IrMz8caiH371Sg4tWg5Bx\npXpumEzvUjw+Sqa7OLAq9QaxpjO622Nkdlik4T4SUN01H6bvEVwRejSH8WdXZ6+2\n7wO+xvp4GGEXpsD+9WIMDdV8tYXj+jIg8S06uPPxzD0Q50K20XxjND9zVVC9Ii59\ngjGIh1SeGGFXyXXD7FD6\n=v7qs\n-----END PGP SIGNATURE-----\n","payload":"tree fdc37bf538668144384c1b938d2e119cdeea1bb9\nparent 92a86819adfefbc6ccfd01a861191ba292eca754\nauthor Mason Daugherty <mason@langchain.dev> 1782447089 -0400\ncommitter GitHub <noreply@github.com> 1782447089 -0400\n\nfix(code): defer server graph construction (#4300)\n\nImport-only checks were constructing the server graph, which let runtime\nstartup behavior leak into local validation and touch a developer’s real\ndcode config. The server graph is now exposed as a LangGraph factory so\nMCP discovery runs only when the server actually builds the graph, and\nthe import checker runs against an isolated home directory.\n\n## Changes\n\n- Switch the generated LangGraph reference from `server_graph.py:graph`\nto `server_graph.py:make_graph`, relying on LangGraph’s factory support\ninstead of constructing the graph at module import time.\n- Keep startup error marker behavior inside `make_graph()` so server\nstartup failures still surface cleanly to the parent process, while\nplain imports remain side-effect free.\n- Run `check_imports.py` with a temporary `HOME` so import validation\ncannot read or depend on local `~/.deepagents` config, MCP auth tokens,\nor other user state.\n- Update server graph tests to assert MCP discovery does not happen on\nimport and still happens when `make_graph()` is invoked.\n- Override `UV_FROZEN` only for the `uv lock --check` command so `make\ncheck` performs the real lockfile freshness check without warning.\n\n## Testing\n\n- `make -C libs/code check PYTHON_FILES=\nPYTEST_EXTRA=\"tests/unit_tests/test_server_graph.py\ntests/unit_tests/test_server_manager.py -q\" COV_ARGS=`\n- `make -C libs/code check_imports`\n- Focused ruff, ty, and pytest checks for the touched server\ngraph/server manager files","verified_at":"2026-06-26T04:11:30Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/220dfc0e6b03f9ccb499c6b850c586b9d57cc077","html_url":"https://github.com/langchain-ai/deepagents/commit/220dfc0e6b03f9ccb499c6b850c586b9d57cc077","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/220dfc0e6b03f9ccb499c6b850c586b9d57cc077/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"92a86819adfefbc6ccfd01a861191ba292eca754","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/92a86819adfefbc6ccfd01a861191ba292eca754","html_url":"https://github.com/langchain-ai/deepagents/commit/92a86819adfefbc6ccfd01a861191ba292eca754"}]},{"sha":"92a86819adfefbc6ccfd01a861191ba292eca754","node_id":"C_kwDOPTymldoAKDkyYTg2ODE5YWRmZWZiYzZjY2ZkMDFhODYxMTkxYmEyOTJlY2E3NTQ","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T03:33:34Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T03:33:34Z"},"message":"fix(code): gate `delete` file operations (#4299)\n\n`delete` now follows the same approval, display, tracking, and\nmemory-protection paths as other mutating file tools. This closes the\ngap where destructive deletes could bypass file-operation previews and\nmanaged memory protections.\n\n## Changes\n- Register `delete` as a write-capable tool for PTC auditing and add it\nto the human approval interrupt map.\n- Add delete-specific approval previews that show removed file content\nas a unified diff when possible, or flag directories and unreadable\npaths explicitly.\n- Track completed delete operations in `FileOpTracker`, modeling\nsuccessful file deletion as an empty after-state so removed lines appear\nin operation diffs.\n- Extend `ManagedMemoryGuardMiddleware` to reject deletes of guarded\nmemory files, including parent-directory deletes that would remove a\nmanaged memory block.\n- Display `delete` calls consistently with other file tools in message\nheaders and tool labels.","tree":{"sha":"a569e766ef4691f8faa27e3219c1c6d4396defea","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/a569e766ef4691f8faa27e3219c1c6d4396defea"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/92a86819adfefbc6ccfd01a861191ba292eca754","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPfMOCRC1aQ7uu5UhlAAA5GoQAI0fch1JMk5e4ppbd5WyN978\naqQuTpm6Q7pZc06tiZdp5nDz3dZvQ63C1ZX9IasylARfcmOgemHheDPn7L3nsm79\nSnL8qkq6Qz+peAxpo7FrPJ2EwuvamCz0bMo6lenY7KnBpWSB1dyN2dlseFc4NW2r\nBqHcdn5Ss4IOySgJYQuOeyAj8KY0Q7jD4YtKRp9Mc+zPQK48vTADzyvy7ejqkaC4\nOhv0FLtdtKude0samCDauXpKyAwDS8s91icSuho8HXECAgeJ2f0lWXUPHzw1jVEX\nm6yEflB6A1ZiAxHu8EtudB0GBwwAXGO+aIrHTXPk5IWo4SgyzoZPb/2I/LYxSd8Z\nsNMc87Szi/l0xgWSvFI6MXq4uUt5OMiQjZf3wqQOSBvQvo7ltULIGQfdExutJ0a1\n9iY5NkfX4+e/czUp02TaR0G5TeY/2FAFtPbTL4EmhGE6LP8RQr/vqKJG3ufdaV4a\nEQ5z6Fy8pfI07cYvRLXCJNngMXkZxJEPJxcgklNpwr9gcEpmG/8g3ridXqstpgSJ\nd2MiqBGEPdymPYXEfUz6nm+3KzSDH2yOBm/cqc7Qmn9SIkUe8AqIRbEg6r5vGUl+\nnzaLntWrHTic7d8+9/1s4IswkwVtAJEq54Kk/goRPSX0NE7x0X77Tja0ASAHpvGj\nKi+y5t8kXym8uaAOcYoA\n=zWzg\n-----END PGP SIGNATURE-----\n","payload":"tree a569e766ef4691f8faa27e3219c1c6d4396defea\nparent 133b10a09d4fdfcedc488554dfa57d4ddc86f128\nauthor Mason Daugherty <mason@langchain.dev> 1782444814 -0400\ncommitter GitHub <noreply@github.com> 1782444814 -0400\n\nfix(code): gate `delete` file operations (#4299)\n\n`delete` now follows the same approval, display, tracking, and\nmemory-protection paths as other mutating file tools. This closes the\ngap where destructive deletes could bypass file-operation previews and\nmanaged memory protections.\n\n## Changes\n- Register `delete` as a write-capable tool for PTC auditing and add it\nto the human approval interrupt map.\n- Add delete-specific approval previews that show removed file content\nas a unified diff when possible, or flag directories and unreadable\npaths explicitly.\n- Track completed delete operations in `FileOpTracker`, modeling\nsuccessful file deletion as an empty after-state so removed lines appear\nin operation diffs.\n- Extend `ManagedMemoryGuardMiddleware` to reject deletes of guarded\nmemory files, including parent-directory deletes that would remove a\nmanaged memory block.\n- Display `delete` calls consistently with other file tools in message\nheaders and tool labels.","verified_at":"2026-06-26T03:33:34Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/92a86819adfefbc6ccfd01a861191ba292eca754","html_url":"https://github.com/langchain-ai/deepagents/commit/92a86819adfefbc6ccfd01a861191ba292eca754","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/92a86819adfefbc6ccfd01a861191ba292eca754/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"133b10a09d4fdfcedc488554dfa57d4ddc86f128","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/133b10a09d4fdfcedc488554dfa57d4ddc86f128","html_url":"https://github.com/langchain-ai/deepagents/commit/133b10a09d4fdfcedc488554dfa57d4ddc86f128"}]},{"sha":"133b10a09d4fdfcedc488554dfa57d4ddc86f128","node_id":"C_kwDOPTymldoAKDEzM2IxMGEwOWQ0ZmRmY2VkYzQ4ODU1NGRmYTU3ZDRkZGM4NmYxMjg","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T02:19:18Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T02:19:18Z"},"message":"fix(repo): exclude tests from release scope (#4298)\n\nRelease-please scopes commits to packages by file paths. Test-only\nchanges can therefore open package release PRs when a bump-worthy commit\nupdates snapshots under a managed package, even if no runtime package\nbehavior changed.\n\nThis excludes each managed package's `tests` directory from\nrelease-please parsing so test-only commits do not trigger package\nreleases. Commits that also touch runtime or package files still remain\nin scope.","tree":{"sha":"070be5e821f8f75f3997c3a794504b0e26e60400","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/070be5e821f8f75f3997c3a794504b0e26e60400"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/133b10a09d4fdfcedc488554dfa57d4ddc86f128","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPeGmCRC1aQ7uu5UhlAAA5b0QAG1kBOOlR6LZehmWUK16ydLj\nPjch9XNQ+KGpJhYkgdEpnfpBsJkeLoVCfaaNil8NSEOPL8srgIxKIP1roCYooIkH\nGC80nQDFche4HdQDsbv7+m5d4BoEfoGe4GL0BgSTKyf1RQ/E6mo6aafgMA6ROoG5\nYsemLwn8mGs37zAI6ILIXUgFRRXnPt7LtN6RthC5eLkp24bjVWNsjwLs92aXb+d7\norBbaHN2OOR3M0W9DtnTNPQ6Xu1s4XJIrruMeXjmVdrfzrEFwPdGwHgAVzHHRnPp\njNvnbb4BAMrO5rLl0cE7n5OUXTxI6kwgFYfeOf56Wu6BZZpPmSK7d5vEyWRBKWBg\nzpjoWRsH2mrPDCDkI3ouTD01ZUA/9s9+EfzBRShjWW0GBKAwSUeknumpxCkfY9LE\nDo6HpECP0LRhIHlYnIWkm0sMY+L2D9WPgE1YoNPQQREpGq0VuPpvp+wfVRbyWH/K\nF1wccJsBS5AfakpRfMxTv+289lvyCA453EmY4SfhU58f0px1o80kk6UD2ewAPINl\nrmgSc+chBKAkL8bxYkx8EmalN24eAiFjkTV4s4WlrHN85UvKwcG4g/n9PVLsCu42\nOB6U6HZ8gR9EpnHC3xae8w8/EaR5Xt3W93aAcAgXb6Vdj42DfyUX3ZZQZo2iNfY/\n468I465Uznol5oaCQVNj\n=9RWB\n-----END PGP SIGNATURE-----\n","payload":"tree 070be5e821f8f75f3997c3a794504b0e26e60400\nparent 88c507d2c860ea750c53e7962f073f45f3a58d01\nauthor Mason Daugherty <mason@langchain.dev> 1782440358 -0400\ncommitter GitHub <noreply@github.com> 1782440358 -0400\n\nfix(repo): exclude tests from release scope (#4298)\n\nRelease-please scopes commits to packages by file paths. Test-only\nchanges can therefore open package release PRs when a bump-worthy commit\nupdates snapshots under a managed package, even if no runtime package\nbehavior changed.\n\nThis excludes each managed package's `tests` directory from\nrelease-please parsing so test-only commits do not trigger package\nreleases. Commits that also touch runtime or package files still remain\nin scope.","verified_at":"2026-06-26T02:19:19Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/133b10a09d4fdfcedc488554dfa57d4ddc86f128","html_url":"https://github.com/langchain-ai/deepagents/commit/133b10a09d4fdfcedc488554dfa57d4ddc86f128","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/133b10a09d4fdfcedc488554dfa57d4ddc86f128/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"88c507d2c860ea750c53e7962f073f45f3a58d01","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/88c507d2c860ea750c53e7962f073f45f3a58d01","html_url":"https://github.com/langchain-ai/deepagents/commit/88c507d2c860ea750c53e7962f073f45f3a58d01"}]},{"sha":"88c507d2c860ea750c53e7962f073f45f3a58d01","node_id":"C_kwDOPTymldoAKDg4YzUwN2QyYzg2MGVhNzUwYzUzZTc5NjJmMDczZjQ1ZjNhNThkMDE","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T02:01:35Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T02:01:35Z"},"message":"fix(infra): allow repo hotfix history-repair merges (#4295)\n\nThe empty-commit guard in the release-please workflow correctly blocks\npathless commits because release-please cannot scope them to a package.\nPR #4294 exposed a narrow false positive: a history-repair PR can\nproduce an empty merge commit while the second-parent side contains\nreal, file-changing commits that release-please should process.\n\nThis keeps the guard strict while allowing that repair shape:\n\n- normal file-changing commits still pass immediately\n- direct empty commits still fail\n- empty merge commits still fail unless their subject is repo-scoped\n`hotfix(repo): ...`\n- repo hotfix empty merge commits only pass when the second-parent side\nintroduces commits and every merged commit touches files\n\nVerified locally against the failed #4294 merge commit, an empty direct\ncommit, and an empty merge commit with a release-relevant subject.","tree":{"sha":"5600ca58e2a2925f28531de804bbecc5098d348e","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/5600ca58e2a2925f28531de804bbecc5098d348e"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/88c507d2c860ea750c53e7962f073f45f3a58d01","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPd1/CRC1aQ7uu5UhlAAAcFEQAKLARVMusYdg38GoGGUKAJdK\nndg+ezzR0BU/eNvKs0gow34CZHd4TSOhlHTNskVctWLY1ApMDstAgaQB0dAuOpZ3\nvWRFoLChDL8aWrEPjE+2y/G9XYV1HnW7upQj2GNMDVyShDoMLdxrnuxAxinP7K4X\nOZ4GNHVHE3Y6tTFi1Xh46netJ5oTvA9yCOoNHL/+xFk9fWWQhDv7HJQ/3CsUKZvt\nn7ItWT4VKLy/7/miYqVdF0bpdjsSZBJfqxoQJJ4pxEl3FdiDw37i6gX568jW12R5\nQKD6VtmHkfSD7RZ4PEmolZboTLHxBKrdvpFWpOu3e4fL43Q4PJiobxx3fGgAO8JO\nucVtSKA9Ja9vkVVaKbfg9sGdOyYzzcdI/o8coGnlYKAnRYlIUhYGU8gkRYOpgJVe\nDJI8DqYYow7jUwuUXOPnLLN8b3Wo6lh5jeMQ8N/7Es3AWHE43bPywZmbDLnDXIRW\nvqPVN8244+pGCe263Yee7n3YjGjehHyrqfRlj6RK83JXSZlM++46ZL/n9uzMCM+r\n3Q7l/gtTEFkdHm5mJFLqa/OX+6BjoNyb4HADhfsUrmA1NuZ66ezbbcrIMtiGlnmZ\nrGOx+LHO/AIWfE7R1oIzdDmJ+iEmscMmdtv1zXTX/Fjnl9RCk0iIW/P13JY8imo5\n4IP9wt/hV2671iQYTU22\n=Gaap\n-----END PGP SIGNATURE-----\n","payload":"tree 5600ca58e2a2925f28531de804bbecc5098d348e\nparent 122a96d24dc9606e24506c9d7e9b40eb85e76a87\nauthor Mason Daugherty <mason@langchain.dev> 1782439295 -0400\ncommitter GitHub <noreply@github.com> 1782439295 -0400\n\nfix(infra): allow repo hotfix history-repair merges (#4295)\n\nThe empty-commit guard in the release-please workflow correctly blocks\npathless commits because release-please cannot scope them to a package.\nPR #4294 exposed a narrow false positive: a history-repair PR can\nproduce an empty merge commit while the second-parent side contains\nreal, file-changing commits that release-please should process.\n\nThis keeps the guard strict while allowing that repair shape:\n\n- normal file-changing commits still pass immediately\n- direct empty commits still fail\n- empty merge commits still fail unless their subject is repo-scoped\n`hotfix(repo): ...`\n- repo hotfix empty merge commits only pass when the second-parent side\nintroduces commits and every merged commit touches files\n\nVerified locally against the failed #4294 merge commit, an empty direct\ncommit, and an empty merge commit with a release-relevant subject.","verified_at":"2026-06-26T02:01:35Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/88c507d2c860ea750c53e7962f073f45f3a58d01","html_url":"https://github.com/langchain-ai/deepagents/commit/88c507d2c860ea750c53e7962f073f45f3a58d01","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/88c507d2c860ea750c53e7962f073f45f3a58d01/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"122a96d24dc9606e24506c9d7e9b40eb85e76a87","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/122a96d24dc9606e24506c9d7e9b40eb85e76a87","html_url":"https://github.com/langchain-ai/deepagents/commit/122a96d24dc9606e24506c9d7e9b40eb85e76a87"}]},{"sha":"122a96d24dc9606e24506c9d7e9b40eb85e76a87","node_id":"C_kwDOPTymldoAKDEyMmE5NmQyNGRjOTYwNmUyNDUwNmM5ZDdlOWI0MGViODVlNzZhODc","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T01:34:50Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T01:34:50Z"},"message":"hotfix(repo): restore v0.7 commit history (#4294)\n\nPR #4280 was intended to land the clean `v0.7` commit sequence on\n`main`, but it was merged as a single squash commit instead by accident.\nThis repairs the history without rewriting `main`.\n\nThe branch first reverts the mistaken squash commit, then reapplies the\nthree intended version-line commits with corrected authorship and\nrelease-please metadata.\n\nThe final tree intentionally matches current `main`; this PR is history\nand release metadata repair only.\n\n---------\n\nCo-authored-by: Nishitha Madhu <nishitha.madhu@langchain.dev>","tree":{"sha":"5227c3c459303d7561a0dba65e83cb4fafabcc8a","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/5227c3c459303d7561a0dba65e83cb4fafabcc8a"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/122a96d24dc9606e24506c9d7e9b40eb85e76a87","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPdc6CRC1aQ7uu5UhlAAAp+sQAFyykrSaUU24QfKwOhiOpGZd\ne6Qr33fny+5GQ3qXPff+mbDPN1cv0apCuMmaqGvmHdaH2y+qzzD+eFfxuPiXfs/x\n2HfVH8Q+rXrLNbox2svfWaApNV0eOlwx9gAi1FH1DybVeYy0wLu0lTGeLApC/azY\nB1uHtkW2hed8548RIUAsKZjovKfPh8rcwdqGHTwf1I9PHr5EIF1NJ25wes3HvK4b\nPLA/YuuMvDQ6tBPF3/8RsrM+hUod5QLJx4+vqYB26I84OQZL24d3euzcL94bKmV/\nNZHahXpv/83WQCObfPGdfe7ZZPqNAN2/ywLWt8u5CNAD+euYh/NFoiwkSKrQYhb/\nZgyOHIZQH2h7KsYwE1ty6Ws4ThpcOdEukccrJYLtLK6We+KLV0Bo4PqNwbGmjZht\nMKd9PVx56PX2Ukc2kDuXo05PbqRDzvj4GrvokiTYy9Ap9Abhx4fnFf0rm+PM+KwN\nNw+37/yx5MmPZoYPMdUKYnG12tU4/NusAiDzPhn/R4pLik6Lz1FLGXXjNWzR7e7f\nMHz/X8jmFKT23+0yArDU7L5ubwUgMbQnfvPw1Udp9WiOdjQIN24N9VXszyl30e12\ntwCZ66MbQkDj6fTomTHy0oI6Js/CkVTw1TLNrGzAgZJ2AdxMjXbPMk3YnGUnS3lO\nCAYBagfMNGHhHolHHVkZ\n=6Ksw\n-----END PGP SIGNATURE-----\n","payload":"tree 5227c3c459303d7561a0dba65e83cb4fafabcc8a\nparent f240a40dc05d812c38e9926c1d81ba38deb86e3f\nparent 2506fccfac0e09b656d5e2fefe23162f1c762331\nauthor Mason Daugherty <mason@langchain.dev> 1782437690 -0400\ncommitter GitHub <noreply@github.com> 1782437690 -0400\n\nhotfix(repo): restore v0.7 commit history (#4294)\n\nPR #4280 was intended to land the clean `v0.7` commit sequence on\n`main`, but it was merged as a single squash commit instead by accident.\nThis repairs the history without rewriting `main`.\n\nThe branch first reverts the mistaken squash commit, then reapplies the\nthree intended version-line commits with corrected authorship and\nrelease-please metadata.\n\nThe final tree intentionally matches current `main`; this PR is history\nand release metadata repair only.\n\n---------\n\nCo-authored-by: Nishitha Madhu <nishitha.madhu@langchain.dev>","verified_at":"2026-06-26T01:34:51Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/122a96d24dc9606e24506c9d7e9b40eb85e76a87","html_url":"https://github.com/langchain-ai/deepagents/commit/122a96d24dc9606e24506c9d7e9b40eb85e76a87","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/122a96d24dc9606e24506c9d7e9b40eb85e76a87/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f240a40dc05d812c38e9926c1d81ba38deb86e3f","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/f240a40dc05d812c38e9926c1d81ba38deb86e3f","html_url":"https://github.com/langchain-ai/deepagents/commit/f240a40dc05d812c38e9926c1d81ba38deb86e3f"},{"sha":"2506fccfac0e09b656d5e2fefe23162f1c762331","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/2506fccfac0e09b656d5e2fefe23162f1c762331","html_url":"https://github.com/langchain-ai/deepagents/commit/2506fccfac0e09b656d5e2fefe23162f1c762331"}]},{"sha":"2506fccfac0e09b656d5e2fefe23162f1c762331","node_id":"C_kwDOPTymldoAKDI1MDZmY2NmYWMwZTA5YjY1NmQ1ZTJmZWZlMjMxNjJmMWM3NjIzMzE","commit":{"author":{"name":"Nishitha Madhu","email":"nishitha.madhu@langchain.dev","date":"2026-06-26T01:32:04Z"},"committer":{"name":"Mason Daugherty","email":"github@mdrxy.com","date":"2026-06-26T01:32:04Z"},"message":"feat(sdk)!: allow `write_file` to overwrite existing files\n\nSquashed from https://github.com/langchain-ai/deepagents/pull/4109.\n\nChanges `write_file` from create-only behavior to whole-file replacement. The tool now creates the file when it is missing and replaces the entire file when it already exists. The tool description no longer requires reading the file first, because overwrite is an intentional write mode rather than an error case.\n\nBREAKING CHANGE: Agents can now overwrite existing files with `write_file` instead of receiving a file-exists error. Workflows, prompts, tests, or guardrails that relied on that error to force `edit_file` usage or to protect existing content must add explicit permission/HITL checks or use `edit_file` when preserving existing content matters.","tree":{"sha":"5227c3c459303d7561a0dba65e83cb4fafabcc8a","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/5227c3c459303d7561a0dba65e83cb4fafabcc8a"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/2506fccfac0e09b656d5e2fefe23162f1c762331","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgw4aRwS28FuhHCLf5WCTI2N4oQZ\nguR7Z5vIQft5qBt/MAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQFnYQcPeTviQ6Do2GKpPrtxmqeuQxYkSIYlUaux1h1kSytCSt8J9tGTLMXyd3iTgi4\n8bNiIqa45KzuEP3CkK6AA=\n-----END SSH SIGNATURE-----","payload":"tree 5227c3c459303d7561a0dba65e83cb4fafabcc8a\nparent f2a21ec1606c2560bd2fd5765409a05c2a44edee\nauthor Nishitha Madhu <nishitha.madhu@langchain.dev> 1782437524 -0400\ncommitter Mason Daugherty <github@mdrxy.com> 1782437524 -0400\n\nfeat(sdk)!: allow `write_file` to overwrite existing files\n\nSquashed from https://github.com/langchain-ai/deepagents/pull/4109.\n\nChanges `write_file` from create-only behavior to whole-file replacement. The tool now creates the file when it is missing and replaces the entire file when it already exists. The tool description no longer requires reading the file first, because overwrite is an intentional write mode rather than an error case.\n\nBREAKING CHANGE: Agents can now overwrite existing files with `write_file` instead of receiving a file-exists error. Workflows, prompts, tests, or guardrails that relied on that error to force `edit_file` usage or to protect existing content must add explicit permission/HITL checks or use `edit_file` when preserving existing content matters.\n","verified_at":"2026-06-26T01:32:52Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/2506fccfac0e09b656d5e2fefe23162f1c762331","html_url":"https://github.com/langchain-ai/deepagents/commit/2506fccfac0e09b656d5e2fefe23162f1c762331","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/2506fccfac0e09b656d5e2fefe23162f1c762331/comments","author":{"login":"imnishitha","id":32355027,"node_id":"MDQ6VXNlcjMyMzU1MDI3","avatar_url":"https://avatars.githubusercontent.com/u/32355027?v=4","gravatar_id":"","url":"https://api.github.com/users/imnishitha","html_url":"https://github.com/imnishitha","followers_url":"https://api.github.com/users/imnishitha/followers","following_url":"https://api.github.com/users/imnishitha/following{/other_user}","gists_url":"https://api.github.com/users/imnishitha/gists{/gist_id}","starred_url":"https://api.github.com/users/imnishitha/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/imnishitha/subscriptions","organizations_url":"https://api.github.com/users/imnishitha/orgs","repos_url":"https://api.github.com/users/imnishitha/repos","events_url":"https://api.github.com/users/imnishitha/events{/privacy}","received_events_url":"https://api.github.com/users/imnishitha/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f2a21ec1606c2560bd2fd5765409a05c2a44edee","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/f2a21ec1606c2560bd2fd5765409a05c2a44edee","html_url":"https://github.com/langchain-ai/deepagents/commit/f2a21ec1606c2560bd2fd5765409a05c2a44edee"}]},{"sha":"f2a21ec1606c2560bd2fd5765409a05c2a44edee","node_id":"C_kwDOPTymldoAKGYyYTIxZWMxNjA2YzI1NjBiZDJmZDU3NjU0MDlhMDVjMmE0NGVkZWU","commit":{"author":{"name":"Nishitha Madhu","email":"nishitha.madhu@langchain.dev","date":"2026-06-26T01:32:02Z"},"committer":{"name":"Mason Daugherty","email":"github@mdrxy.com","date":"2026-06-26T01:32:02Z"},"message":"feat(sdk)!: add recursive filesystem delete support\n\nCombines the v0.7-only delete support work originally merged through:\n\n- https://github.com/langchain-ai/deepagents/pull/3659\n- https://github.com/langchain-ai/deepagents/pull/3691\n- https://github.com/langchain-ai/deepagents/pull/3765\n- https://github.com/langchain-ai/deepagents/pull/3851\n\nAdds a `delete` filesystem tool backed by the backend protocol and supported by state, store, filesystem, sandbox, context-hub, and composite backends. The tool deletes files or directories recursively, and prefix-style backends remove the exact key plus nested descendants.\n\nFilesystem permissions treat `delete` as a write operation. Because recursive deletes can affect descendants, deny and interrupt checks use bulk path overlap instead of exact-path matching.\n\nBREAKING CHANGE: Agents now see a destructive `delete` filesystem tool when the backend supports it. Existing agents may choose to remove files or directories recursively, and existing filesystem permission rules that allow writes can now authorize deletion unless a narrower deny or interrupt rule blocks the target subtree.","tree":{"sha":"3642dfd6dfcba500aa4f30ae3e6640baa067da7f","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/3642dfd6dfcba500aa4f30ae3e6640baa067da7f"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/f2a21ec1606c2560bd2fd5765409a05c2a44edee","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgw4aRwS28FuhHCLf5WCTI2N4oQZ\nguR7Z5vIQft5qBt/MAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQJXgNqI4av4xiQAl6OPnJUOwfemk+Ee8RWFMePfyn8sfgyg9eRajhoUOttfX4Gdd4L\nO05+R7mSHw1AMGCNqATQo=\n-----END SSH SIGNATURE-----","payload":"tree 3642dfd6dfcba500aa4f30ae3e6640baa067da7f\nparent efafd1e070aeae8901ee3123c7fcbf1815a33c4f\nauthor Nishitha Madhu <nishitha.madhu@langchain.dev> 1782437522 -0400\ncommitter Mason Daugherty <github@mdrxy.com> 1782437522 -0400\n\nfeat(sdk)!: add recursive filesystem delete support\n\nCombines the v0.7-only delete support work originally merged through:\n\n- https://github.com/langchain-ai/deepagents/pull/3659\n- https://github.com/langchain-ai/deepagents/pull/3691\n- https://github.com/langchain-ai/deepagents/pull/3765\n- https://github.com/langchain-ai/deepagents/pull/3851\n\nAdds a `delete` filesystem tool backed by the backend protocol and supported by state, store, filesystem, sandbox, context-hub, and composite backends. The tool deletes files or directories recursively, and prefix-style backends remove the exact key plus nested descendants.\n\nFilesystem permissions treat `delete` as a write operation. Because recursive deletes can affect descendants, deny and interrupt checks use bulk path overlap instead of exact-path matching.\n\nBREAKING CHANGE: Agents now see a destructive `delete` filesystem tool when the backend supports it. Existing agents may choose to remove files or directories recursively, and existing filesystem permission rules that allow writes can now authorize deletion unless a narrower deny or interrupt rule blocks the target subtree.\n","verified_at":"2026-06-26T01:32:52Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/f2a21ec1606c2560bd2fd5765409a05c2a44edee","html_url":"https://github.com/langchain-ai/deepagents/commit/f2a21ec1606c2560bd2fd5765409a05c2a44edee","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/f2a21ec1606c2560bd2fd5765409a05c2a44edee/comments","author":{"login":"imnishitha","id":32355027,"node_id":"MDQ6VXNlcjMyMzU1MDI3","avatar_url":"https://avatars.githubusercontent.com/u/32355027?v=4","gravatar_id":"","url":"https://api.github.com/users/imnishitha","html_url":"https://github.com/imnishitha","followers_url":"https://api.github.com/users/imnishitha/followers","following_url":"https://api.github.com/users/imnishitha/following{/other_user}","gists_url":"https://api.github.com/users/imnishitha/gists{/gist_id}","starred_url":"https://api.github.com/users/imnishitha/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/imnishitha/subscriptions","organizations_url":"https://api.github.com/users/imnishitha/orgs","repos_url":"https://api.github.com/users/imnishitha/repos","events_url":"https://api.github.com/users/imnishitha/events{/privacy}","received_events_url":"https://api.github.com/users/imnishitha/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"efafd1e070aeae8901ee3123c7fcbf1815a33c4f","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/efafd1e070aeae8901ee3123c7fcbf1815a33c4f","html_url":"https://github.com/langchain-ai/deepagents/commit/efafd1e070aeae8901ee3123c7fcbf1815a33c4f"}]},{"sha":"efafd1e070aeae8901ee3123c7fcbf1815a33c4f","node_id":"C_kwDOPTymldoAKGVmYWZkMWUwNzBhZWFlODkwMWVlMzEyM2M3ZmNiZjE4MTVhMzNjNGY","commit":{"author":{"name":"Mason Daugherty","email":"61371264+mdrxy@users.noreply.github.com","date":"2026-06-26T01:32:00Z"},"committer":{"name":"Mason Daugherty","email":"github@mdrxy.com","date":"2026-06-26T01:32:00Z"},"message":"fix(sdk): return sentinel for empty file lists (#3709)\n\nls and glob now return a human-readable empty-result sentinel instead of exposing a raw empty list string. This keeps filesystem tool output explicit for agents while deferring the behavior change to the v0.7 line.","tree":{"sha":"0ca1b45b9083b786e9bf8fcf698151fe00bea695","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/0ca1b45b9083b786e9bf8fcf698151fe00bea695"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/efafd1e070aeae8901ee3123c7fcbf1815a33c4f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgw4aRwS28FuhHCLf5WCTI2N4oQZ\nguR7Z5vIQft5qBt/MAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQPIbH8Sx5azSYmNkcvbmIQfYqJt1ClMvvhcIP2gd6EKPrrSlLc+YbL4kvv1J0b7cYI\nKbZFo/uacgIhsNL3or7gE=\n-----END SSH SIGNATURE-----","payload":"tree 0ca1b45b9083b786e9bf8fcf698151fe00bea695\nparent 9491688e3c5fe488fb402a07fedd5c02f5a4cbff\nauthor Mason Daugherty <61371264+mdrxy@users.noreply.github.com> 1782437520 -0400\ncommitter Mason Daugherty <github@mdrxy.com> 1782437520 -0400\n\nfix(sdk): return sentinel for empty file lists (#3709)\n\nls and glob now return a human-readable empty-result sentinel instead of exposing a raw empty list string. This keeps filesystem tool output explicit for agents while deferring the behavior change to the v0.7 line.\n","verified_at":"2026-06-26T01:32:52Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/efafd1e070aeae8901ee3123c7fcbf1815a33c4f","html_url":"https://github.com/langchain-ai/deepagents/commit/efafd1e070aeae8901ee3123c7fcbf1815a33c4f","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/efafd1e070aeae8901ee3123c7fcbf1815a33c4f/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/o