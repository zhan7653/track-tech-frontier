"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"4a806bc703b69334cccd05bcd27d411602e82318","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4a806bc703b69334cccd05bcd27d411602e82318","html_url":"https://github.com/langchain-ai/deepagents/commit/4a806bc703b69334cccd05bcd27d411602e82318"}]},{"sha":"4a806bc703b69334cccd05bcd27d411602e82318","node_id":"C_kwDOPTymldoAKDRhODA2YmM3MDNiNjkzMzRjY2NkMDViY2QyN2Q0MTE2MDJlODIzMTg","commit":{"author":{"name":"Johannes du Plessis","email":"johannes@langchain.dev","date":"2026-07-09T18:31:49Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-09T18:31:49Z"},"message":"feat(code): add `GPT-5.6` model family (#4600)\n\nDeep Agents Code now supports GPT-5.6 Sol, Terra, and Luna through\nOpenAI API keys and ChatGPT sign-in, including the new `max` reasoning\neffort.\n\n---\n\nOpenAI's GPT-5.6 profiles have not reached `langchain-openai` yet, which\nwould otherwise keep the new family out of the model selector. This adds\nSol, Terra, and Luna as curated recommendations while preserving\nupstream profiles as the authoritative metadata source once they are\nreleased.\n\n- Surface all three models through the OpenAI API and ChatGPT\nOAuth/Codex paths.\n- Support the documented `medium` default and new `max` reasoning\neffort.\n- Cover model discovery, display names, Codex allowlisting, and\nreasoning behavior.","tree":{"sha":"941cd7cac251b1b424547bef500fac6264a56bf2","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/941cd7cac251b1b424547bef500fac6264a56bf2"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/4a806bc703b69334cccd05bcd27d411602e82318","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqT+kVCRC1aQ7uu5UhlAAA1TQQAJd4WkgONsOrikbc/YpRpA8e\na/ykF4yAUT8OoPfi1UaoAP4CKbVw6nYDrC6j6JVJrMQC2S5ZJELicWPtzOu1NNwn\nbGdVvs+iHxxK+ww/6/chFS5eT+OHiugLeaZVveTy9K0ZV/C9nojpydabwZtD1pW3\nNujb4HLc2+2YKxq2vAptAMj6KcrpHtmN5yn1HsGZRYz45XRfokbn/bDKSGQr3a8K\ngeCRQZrBs8nI0bicqCJXl1+bbJTNWZCPDUjWGveyq4AzHH4JQmmhu+jPFEHplQeJ\n1tF3KiH7BaOmNgAKQx4IzFoHuSqHHlVSFpchpai3+rw1EI8KRwKMUDM2wql1o03P\nUG9MmuqeeRZveb6YfhNYYszt5CsFK2vIjKHncriWgGUGq0b0W4CUL81MPaOBEq6C\nMeZc0zcNiZF1g+GBOGBN6aTOBNYlG7ViClbbLRHtLkC34fQTh0ahy03YkvCq6sWH\n7jwoD7mPswfNyCxmD/BqUnFbFjm9r2S636pJb1WcEYwhPaT1W3hRqn90DBR163nc\nC1Q3if2dUNub91sny8y3w8LT75x7pPUwJOQ0ECwUYc0hE8s9vIJwtUXkUU2Ulv6m\nBgFNQXtuDHR6F+tB781X2SNIjguAdnjDwi7SqzI+199vwrvP5y06QVDeo2DaimjK\nmcoVO/8SYp8p5xFuvPNJ\n=zKcr\n-----END PGP SIGNATURE-----\n","payload":"tree 941cd7cac251b1b424547bef500fac6264a56bf2\nparent b0a209da3a8c9f80e2e3d5e199340736c854c567\nauthor Johannes du Plessis <johannes@langchain.dev> 1783621909 -0700\ncommitter GitHub <noreply@github.com> 1783621909 -0700\n\nfeat(code): add `GPT-5.6` model family (#4600)\n\nDeep Agents Code now supports GPT-5.6 Sol, Terra, and Luna through\nOpenAI API keys and ChatGPT sign-in, including the new `max` reasoning\neffort.\n\n---\n\nOpenAI's GPT-5.6 profiles have not reached `langchain-openai` yet, which\nwould otherwise keep the new family out of the model selector. This adds\nSol, Terra, and Luna as curated recommendations while preserving\nupstream profiles as the authoritative metadata source once they are\nreleased.\n\n- Surface all three models through the OpenAI API and ChatGPT\nOAuth/Codex paths.\n- Support the documented `medium` default and new `max` reasoning\neffort.\n- Cover model discovery, display names, Codex allowlisting, and\nreasoning behavior.","verified_at":"2026-07-09T18:31:50Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4a806bc703b69334cccd05bcd27d411602e82318","html_url":"https://github.com/langchain-ai/deepagents/commit/4a806bc703b69334cccd05bcd27d411602e82318","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4a806bc703b69334cccd05bcd27d411602e82318/comments","author":{"login":"johannes117","id":51395795,"node_id":"MDQ6VXNlcjUxMzk1Nzk1","avatar_url":"https://avatars.githubusercontent.com/u/51395795?v=4","gravatar_id":"","url":"https://api.github.com/users/johannes117","html_url":"https://github.com/johannes117","followers_url":"https://api.github.com/users/johannes117/followers","following_url":"https://api.github.com/users/johannes117/following{/other_user}","gists_url":"https://api.github.com/users/johannes117/gists{/gist_id}","starred_url":"https://api.github.com/users/johannes117/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/johannes117/subscriptions","organizations_url":"https://api.github.com/users/johannes117/orgs","repos_url":"https://api.github.com/users/johannes117/repos","events_url":"https://api.github.com/users/johannes117/events{/priva