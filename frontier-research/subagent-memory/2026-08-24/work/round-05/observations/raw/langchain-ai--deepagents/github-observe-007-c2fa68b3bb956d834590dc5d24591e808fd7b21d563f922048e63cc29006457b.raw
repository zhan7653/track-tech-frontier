ub.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"4d2d6aed808575e2e03539bc7fa84562c93b7eb5","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4d2d6aed808575e2e03539bc7fa84562c93b7eb5","html_url":"https://github.com/langchain-ai/deepagents/commit/4d2d6aed808575e2e03539bc7fa84562c93b7eb5"}]},{"sha":"4d2d6aed808575e2e03539bc7fa84562c93b7eb5","node_id":"C_kwDOPTymldoAKDRkMmQ2YWVkODA4NTc1ZTJlMDM1MzliYzdmYTg0NTYyYzkzYjdlYjU","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-28T18:21:57Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-28T18:21:57Z"},"message":"feat(code): allow muting the \"YOLO is active\" toast (#5103)\n\nThe recurring \"YOLO is active\" warning toast can now be turned off from\n`/notifications`, or by adding `yolo` to `[warnings].suppress` in\n`config.toml`.\n\n---\n\nPeople who deliberately live in YOLO get the no-review warning on every\nlaunch and on every switch back into the mode, with no way to opt out.\nBoth call sites now go through a single `_warn_yolo_active` helper that\nhonors a new `yolo` key in the existing `[warnings].suppress` list — the\nsame mechanism already used for the ripgrep and Tavily warnings — so the\nopt-out is both a config key and a checkbox in the `/notifications`\nmodal.\n\nThe suppression is deliberately cosmetic. The first-enable\nacknowledgement modal, the `startup.yolo_switcher` policy, and the\nstatus-bar mode indicator are all untouched, so unrestricted mode still\nrequires an explicit opt-in and stays visible while it is on.\n\n<details>\n<summary>Test plan</summary>\n\n- New tests cover the default warning, the muted path, that muting does\nnot weaken the mode switch or the status-bar indicator, and that the new\n`/notifications` checkbox persists the key.\n\n</details>\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/40b5babe-cea3-6b01-d998-fc3b980ad406)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"b5a8eadbb4cd03dc031060d5cda1573940f9596e","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/b5a8eadbb4cd03dc031060d5cda1573940f9596e"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/4d2d6aed808575e2e03539bc7fa84562c93b7eb5","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqaPNGCRC1aQ7uu5UhlAAAqU8QAG3f+mO7mDsxMLHgqVL2udLM\nyDG8SvkdO1u/2XAJp+ILnYKz1Pog8e2kBAPsqbGn9Aqrio/sJGKDTXIncvPW8AR3\nZv+gZd3UcEjYeXZSvGKJM2t3VVGBfZhek92L0I8EOQYMpObpsbn4qnwBDvVckQrT\nSPQdphpPMmbyCmXuzQ/6vHZXcSH7r5f3/5C2PRuSnRck5aCVHqG2SU4R56aU+0P+\n0sABx2Lxx2NMf+CjQIEL61x3eFo9I2cWU6+YUkduMxnN87ZY+7fZtUspoabY4QoV\nFTf/FAWc6T54NpLJhoMWI5VQlqn/hR2XP5+H0Qb5FYw1DLsSbTuKB7qBe3ImTwCk\nLQnCOJFSBfHo5gSrlzgzoJR/bBCTGbDimnNi/xsWDN7Ey0NGuRrSFVaE/ZOsTDsZ\nhbaFlqu23p7DBxcetz7EctfDlnf2A1FRF6PJon3dpoBRC0qps2bztMI/xpvExWFN\nPB5skdwwpBms0c1Y4Dm/UdvUYW8A71DJcK3MFn2FXDOp1pXkLFmSDKvwxQsC0rw/\nL6nl5N4kecEhC7afW+xbfA1hNgyeMalblWVy3RABRuZrRE7E8HI4uSDfD8qH2xtS\nNtWJU2HP3ijvbv5QEXx+xb9ryt2UFbf6YjK2hnq/pxq1eucjHiZHZBVy1onb3dkc\nJrkNajBggbbLimStBZ3O\n=eHkC\n-----END PGP SIGNATURE-----\n","payload":"tree b5a8eadbb4cd03dc031060d5cda1573940f9596e\nparent 0fd459c3360d654ec25c925af03ffdf06c6e75e1\nauthor Mason Daugherty <mason@langchain.dev> 1785262917 -0400\ncommitter GitHub <noreply@github.com> 1785262917 -0400\n\nfeat(code): allow muting the \"YOLO is active\" toast (#5103)\n\nThe recurring \"YOLO is active\" warning toast can now be turned off from\n`/notifications`, or by adding `yolo` to `[warnings].suppress` in\n`config.toml`.\n\n---\n\nPeople who deliberately live in YOLO get the no-review warning on every\nlaunch and on every switch back into the mode, with no way to opt out.\nBoth call sites now go through a single `_warn_yolo_active` helper that\nhonors a new `yolo` key in the existing `[warnings].suppress` list — the\nsame mechanism already used for the ripgrep and Tavily warnings — so the\nopt-out is both a config key and a checkbox in the `/notifications`\nmodal.\n\nThe suppression is deliberately cosmetic. The first-enable\nacknowledgement modal, the `startup.yolo_switcher` policy, and the\nstatus-bar mode indicator are all untouched, so unrestricted mode still\nrequires an explicit opt-in and stays visible while it is on.\n\n<details>\n<summary>Test plan</summary>\n\n- New tests cover the default warning, the muted path, that muting does\nnot weaken the mode switch or the status-bar indicator, and that the new\n`/notifications` checkbox persists the key.\n\n</details>\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/40b5babe-cea3-6b01-d998-fc3b980ad406)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-07-28T18:21:58Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4d2d6aed808575e2e03539bc7fa84562c93b7eb5","html_url":"https://github.com/langchain-ai/deepagents/commit/4d2d6aed808575e2e03539bc7fa84562c93b7eb5","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4d2d6aed808575e2e03539bc7fa84562c93b7eb5/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"0fd459c3360d654ec25c925af03ffdf06c6e75e1","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/0fd459c3360d654ec25c925af03ffdf06c6e75e1","html_url":"https://github.com/langchain-ai/deepagents/commit/0fd459c3360d654ec25c925af03ffdf06c6e75e1"}]},{"sha":"0fd459c3360d654ec25c925af03ffdf06c6e75e1","node_id":"C_kwDOPTymldoAKDBmZDQ1OWMzMzYwZDY1NGVjMjVjOTI1YWYwM2ZmZGYwNmM2ZTc1ZTE","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-28T18:18:30Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-28T18:18:30Z"},"message":"docs(repo): clarify PR body is release note without heading (#5121)\n\nPR descriptions that mention `release-note-ready` text still led agents\nto append a separate `## Release Note` section that duplicated the\nfrontmatter summary. Clarifies that the plain paragraph above `---` is\nthe release note, bans both heading casings, and shows the anti-pattern.\n\n---\n\nThe release-note content already belongs in the unlabeled opening\nsummary. Agents were treating \"release-note-ready\" as a cue to add a\nsecond section. Tightens the wording in contributor agent guidance and\nthe GitHub PR template so the rule is positive (\"that paragraph is the\nrelease note\") and includes a concrete bad example.\n\nRelated #5119\n\n---------\n\nSigned-off-by: Mason Daugherty <mason@langchain.dev>","tree":{"sha":"85db3ba30cc25c4a4fbd2d1c19e217e3f73d8803","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/85db3ba30cc25c4a4fbd2d1c19e217e3f73d8803"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/0fd459c3360d654ec25c925af03ffdf06c6e75e1","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqaPJ2CRC1aQ7uu5UhlAAAXb8QAKFnHDd0pf6TiINI/wD1xicO\n9HmHnvTlpnChOMUV1Uw9AWak2R80+tLeCRml1vzcfztjRw5avgdHVaWEUVHbA0bU\n3qzM1/lOYc/5L6TvpDB7WOpFvMGzbO7V6Jgq8JV1QrIq2Q75LnzIog1h3e+LW6GD\nux3zHLixj+IMLBIN6ShIRwcZtBsNwEHd3jJVk6rKPrp1cJa5kessPqUh26xsCcez\nqeKFgjrwXFch8luH76ots39Wg2yPPeNNwA3lRedJhqBx7WK/rYJxWgOxBC/zD+XF\n0npfSVkAazNPww6J0UEoWSNzmjmfzoTHbyRIrWcoVk+FdOjlhYIs9yRpYQ/TpPlx\nCAefYhm35f7c6Pj1f9NCfedrzvorP4FJIkaLN2B54YN9mzn+jVi79tJD1vDaM3qx\n1XPiY9HH4Y/gke33V3QWxuLj/xPESGHYZv6YQC5IHPIfjKh2JTDWy6xFbjh+niVG\n8R8rEdEdH0KR5G84vXJxclpqThDc/civlqmbqTsUvehWd0uZ/N11ES3tdVHKvpIF\n6HorzKywHc/rX4Y5bHhbsYAg+xNBxNzx2ScSjjculnF3dw39BXwaHbqpnK4iiyu4\ndp+TYiUf8snrGVgiWl4In6agHyXK072H56ynUS3vZBh7V/F01VJyowRiJ9r9Eb8w\nUy5McBhpRoNfRLSRhecE\n=XuCi\n-----END PGP SIGNATURE-----\n","payload":"tree 85db3ba30cc25c4a4fbd2d1c19e217e3f73d8803\nparent fef1ff33e99cd6cb7b2cbbea8db8df453866dc5e\nauthor Mason Daugherty <mason@langchain.dev> 1785262710 -0400\ncommitter GitHub <noreply@github.com> 1785262710 -0400\n\ndocs(repo): clarify PR body is release note without heading (#5121)\n\nPR descriptions that mention `release-note-ready` text still led agents\nto append a separate `## Release Note` section that duplicated the\nfrontmatter summary. Clarifies that the plain paragraph above `---` is\nthe release note, bans both heading casings, and shows the anti-pattern.\n\n---\n\nThe release-note content already belongs in the unlabeled opening\nsummary. Agents were treating \"release-note-ready\" as a cue to add a\nsecond section. Tightens the wording in contributor agent guidance and\nthe GitHub PR template so the rule is positive (\"that paragraph is the\nrelease note\") and includes a concrete bad example.\n\nRelated #5119\n\n---------\n\nSigned-off-by: Mason Daugherty <mason@langchain.dev>","verified_at":"2026-07-28T18:18:31Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/0fd459c3360d654ec25c925af03ffdf06c6e75e1","html_url":"https://github.com/langchain-ai/deepagents/commit/0fd459c3360d654ec25c925af03ffdf06c6e75e1","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/0fd459c3360d654ec25c925af03ffdf06c6e75e1/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"fef1ff33e99cd6cb7b2cbbea8db8df453866dc5e","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/fef1ff33e99cd6cb7b2cbbea8db8df453866dc5e","html_url":"https://github.com/langchain-ai/deepagents/commit/fef1ff33e99cd6cb7b2cbbea8db8df453866dc5e"}]},{"sha":"fef1ff33e99cd6cb7b2cbbea8db8df453866dc5e","node_id":"C_kwDOPTymldoAKGZlZjFmZjMzZTk5Y2Q2Y2I3YjJjYmJlYThkYjhkZjQ1Mzg2NmRjNWU","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-28T17:37:05Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-28T17:37:05Z"},"message":"chore(deps): raise `langchain-anthropic` minimum to 1.5.3 (#5120)\n\nRaise the `langchain-anthropic` lower bound to `1.5.3` across packages\nand examples so installs stay on the latest stable release.\n\n---\n\nAlso drops a hand-maintained test copy of Harbor's agent dependency list\nso pin bumps don't require a second, easy-to-forget edit.\n\n### Why the Harbor test change\n\nHarbor installs the eval agent from a committed `langgraph.json`. That\nfile lists every provider package (Anthropic, OpenAI, Fireworks, …) so a\nlocal run can pick any model. In CI, a small helper then **prunes** that\nlist down to the one provider the job actually uses, so each sandbox\ndoesn't install Wikipedia of chat SDKs.\n\nThe pruner has a unit/CI suite under `.github/scripts/`. Until this PR,\nthat suite kept its own constant (`SAMPLE_DEPS`) that was a **verbatim\nsecond copy** of the real `langgraph.json` dependencies, plus a test\nwhose only job was “//snip// these two lists still match.”\n\nThat design meant every pin bump in Harbor had to touch two places. This\nPR only updated the real file at first; CI's **Validate Release\nOptions** job failed because the fixture still said `1.5.2`.\n\nRather than keep nursing that mirror, the suite now **reads the\ncommitted `langgraph.json` directly** for the full multi-provider\ndependency list. Version pins live in one place. What still needs\ndeliberate sync is only the provider **name → package** map in the\npruner (which provider string corresponds to which `langchain-*`\npackage) — not the version lower bounds.\n\nLockfiles were refreshed with a targeted `langchain-anthropic` upgrade;\nresolution also moves transitive `langchain-core` to `1.5.2` where locks\nstill recorded the previous pin.","tree":{"sha":"7ee13456bf98d341d1d835274dd12d3f1c3d19ae","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/7ee13456bf98d341d1d835274dd12d3f1c3d19ae"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/fef1ff33e99cd6cb7b2cbbea8db8df453866dc5e","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqaOjBCRC1aQ7uu5UhlAAAe9cQAI25M3z/QnlXwOfnqKIkUYln\nBw/6irTyL+tYMBSf3Ut2/dJXCDJBKq35gu5Q8aRouoLkqMbB7G9GDpCVFyN16q3b\nlk/cn+jeL2n6n6jPhD2Y9ABirFfXoHylpI4JP6ORwQz4jEvwDvnaZ1U/7bV4nJG/\nThBxmktDaciRLRAlWh+OxuHI6DXcH/aBJEyNAJbj794R3v1SQzkFUSfiqvD7VPX8\nzjtJbfLMngM4VZ+VywwxfFKAuGjl+YxnMlY7QWBP+XYnb+qsu82CLL9B3J9RLuLw\nD3svVT7Tpco/CJmVBiGUnpHYVV0jCyYPyKy3997jd0GMZVV/npJp7ExUP/zSEUj0\n7uHJXHNs8l2vA6i734bPCRTbDAaH6HjalJySm4I/KGT9ScOxnmsMs/q61vB45hqp\na0ffcWj6qvmJwONW9yGM7sl1efbfny79+Xqt/G3gLP0HSj3qh+WdlRrSpVKuis9n\n8wbksAPiud8Jy4mYw1OYkMaAdqM5r1v6reUFbv8iWqgmrv1DS15SUZI1rTAqfMaE\ndjupZFMxq30GEn8IcGKSYmd9Dl+VQOoBI23/mnCJJwW1VKeKiSQuXBc4exvIxyAG\nrBkT0HdkOMR1B2Ra93X/MOFf9Ft4wRSPcj0TvkTxAAceHnztC3rz+/QmSvoaDuOC\nbDaMhOfGFfXi1yiae9A9\n=q/82\n-----END PGP SIGNATURE-----\n","payload":"tree 7ee13456bf98d341d1d835274dd12d3f1c3d19ae\nparent 7348b8f5098aef6d2f15243861300b98bf24378c\nauthor Mason Daugherty <mason@langchain.dev> 1785260225 -0400\ncommitter GitHub <noreply@github.com> 1785260225 -0400\n\nchore(deps): raise `langchain-anthropic` minimum to 1.5.3 (#5120)\n\nRaise the `langchain-anthropic` lower bound to `1.5.3` across packages\nand examples so installs stay on the latest stable release.\n\n---\n\nAlso drops a hand-maintained test copy of Harbor's agent dependency list\nso pin bumps don't require a second, easy-to-forget edit.\n\n### Why the Harbor test change\n\nHarbor installs the eval agent from a committed `langgraph.json`. That\nfile lists every provider package (Anthropic, OpenAI, Fireworks, …) so a\nlocal run can pick any model. In CI, a small helper then **prunes** that\nlist down to the one provider the job actually uses, so each sandbox\ndoesn't install Wikipedia of chat SDKs.\n\nThe pruner has a unit/CI suite under `.github/scripts/`. Until this PR,\nthat suite kept its own constant (`SAMPLE_DEPS`) that was a **verbatim\nsecond copy** of the real `langgraph.json` dependencies, plus a test\nwhose only job was “//snip// these two lists still match.”\n\nThat design meant every pin bump in Harbor had to touch two places. This\nPR only updated the real file at first; CI's **Validate Release\nOptions** job failed because the fixture still said `1.5.2`.\n\nRather than keep nursing that mirror, the suite now **reads the\ncommitted `langgraph.json` directly** for the full multi-provider\ndependency list. Version pins live in one place. What still needs\ndeliberate sync is only the provider **name → package** map in the\npruner (which provider string corresponds to which `langchain-*`\npackage) — not the version lower bounds.\n\nLockfiles were refreshed with a targeted `langchain-anthropic` upgrade;\nresolution also moves transitive `langchain-core` to `1.5.2` where locks\nstill recorded the previous pin.","verified_at":"2026-07-28T17:37:06Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/fef1ff33e99cd6cb7b2cbbea8db8df453866dc5e","html_url":"https://github.com/langchain-ai/deepagents/commit/fef1ff33e99cd6cb7b2cbbea8db8df453866dc5e","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/fef1ff33e99cd6cb7b2cbbea8db8df453866dc5e/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7348b8f5098aef6d2f15243861300b98bf24378c","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7348b8f5098aef6d2f15243861300b98bf24378c","html_url":"https://github.com/langchain-ai/deepagents/commit/7348b8f5098aef6d2f15243861300b98bf24378c"}]},{"sha":"7348b8f5098aef6d2f15243861300b98bf24378c","node_id":"C_kwDOPTymldoAKDczNDhiOGY1MDk4YWVmNmQyZjE1MjQzODYxMzAwYjk4YmYyNDM3OGM","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-28T16:35:20Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-28T16:35:20Z"},"message":"style(code): show `ctrl+x` hint when `ask_user` free-text field is shown (#5096)\n\nThe `ask_user` prompt now shows a `Ctrl+X external editor` hint when a\nfree-text answer field is available.\n\n---\n\nThe `ask_user` menu footer now advertises the `Ctrl+X external editor`\nshortcut only while a free-text entry field is actually shown — always\nfor text questions, and for multiple-choice questions once the \"Other\"\noption reveals its input. The app-level `ctrl+x` binding already routes\nto the focused ask-user input, so this makes that capability\ndiscoverable without adding noise when only choices are selectable.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/e9704180-2474-bb8b-cf38-67d872a44987)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"b31530806984478f5673859aab2a515b0e45aa0e","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/b31530806984478f5673859aab2a515b0e45aa0e"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/7348b8f5098aef6d2f15243861300b98bf24378c","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqaNpICRC1aQ7uu5UhlAAAt8EQACMdqbvw415JkCzKkU8S49h3\ncKjkOURpMrU5mxJnEJ79B0eNGnP0EcFGJcpujWpJ9cfaTshgLRwEfDT0PaVQaaWM\nA0cN3k4FVt4/VADCphv4URCOJcOyBoAmsswaL+JCV2ZkSjGEr9BjzKNBGneWDiu7\ngmtZeMeDQYnp4ls3fy5UV5MfEBQbbJb9Fhs8HQVEpiU3Y4YCf7lvqCg/2HhSMv98\n8RkpHI5KS6meiuqFBxW/jwBF+Qz6EFtUcwkXPztk3CU3z6ZQdKbpQn5DK9876zBZ\nkOp0bla+HIxDLStCcASQS+4zQTZWZdLINhIE/4Ut662MbJa1p6zAqXHSE1+nkHbe\n7gFicOFumZW+FJ2gSzZTbp5/wd/K6QWn2d8ZSCGCKq+KWl9s2Hpp5D9WMRV5TUhF\nRMXj2X5mCKxf1wFnEwUK5rpPvzHHut1sZBRqlAJ+ADVa8OIpI+IofeSeNfI247Dl\nZrk0KqL+M1C+OluLxuix/Qi2l4xJdH/lfaEd8ghAiDeszMDeI6i1xjI5RZ6mY0qT\n6dFHKVjkLGPj0WuoqfJGvPowfYWrimRw9N9pvHj1mR57np84/rWRFLLB5gxXQYok\n3s0qZ3foiN/rpiA6BxA7Shuaq7cPUEh6/Cpjf7W0UZlViKZE7++HfZDeJGHFJhZI\n66uY9PJf15LzE00Dp9hV\n=c349\n-----END PGP SIGNATURE-----\n","payload":"tree b31530806984478f5673859aab2a515b0e45aa0e\nparent d4d2b60e37ae034e69f60ab5f34267b542c00dd5\nauthor Mason Daugherty <mason@langchain.dev> 1785256520 -0400\ncommitter GitHub <noreply@github.com> 1785256520 -0400\n\nstyle(code): show `ctrl+x` hint when `ask_user` free-text field is shown (#5096)\n\nThe `ask_user` prompt now shows a `Ctrl+X external editor` hint when a\nfree-text answer field is available.\n\n---\n\nThe `ask_user` menu footer now advertises the `Ctrl+X external editor`\nshortcut only while a free-text entry field is actually shown — always\nfor text questions, and for multiple-choice questions once the \"Other\"\noption reveals its input. The app-level `ctrl+x` binding already routes\nto the focused ask-user input, so this makes that capability\ndiscoverable without adding noise when only choices are selectable.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/e9704180-2474-bb8b-cf38-67d872a44987)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-07-28T16:35:21Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7348b8f5098aef6d2f15243861300b98bf24378c","html_url":"https://github.com/langchain-ai/deepagents/commit/7348b8f5098aef6d2f15243861300b98bf24378c","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7348b8f5098aef6d2f15243861300b98bf24378c/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"d4d2b60e37ae034e69f60ab5f34267b542c00dd5","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/d4d2b60e37ae034e69f60ab5f34267b542c00dd5","html_url":"https://github.com/langchain-ai/deepagents/commit/d4d2b60e37ae034e69f60ab5f34267b542c00dd5"}]},{"sha":"d4d2b60e37ae034e69f60ab5f34267b542c00dd5","node_id":"C_kwDOPTymldoAKGQ0ZDJiNjBlMzdhZTAzNGU2OWY2MGFiNWYzNDI2N2I1NDJjMDBkZDU","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-28T16:29:41Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-28T16:29:41Z"},"message":"fix(code): ignore mouse hits on detached widgets (#5114)\n\nRelated Textualize/textual#6643\n\nClicking or starting a text selection in the transcript while the agent\nwas streaming a response could take the whole app down with\n`AttributeError: 'NoneType' object has no attribute 'region'`. Mouse\npresses on markdown that is being replaced mid-stream are now ignored\ninstead of crashing.\n\n---\n\nTextual's compositor keeps reporting a widget as visible for a few\nevent-loop iterations after it leaves the DOM. `Markdown.update` — which\n`MarkdownStream` runs on every flush of a streaming assistant message —\ndetaches and remounts its blocks constantly, so that stale window is\nopen more or less continuously while output streams. When a mouse press\nlands in it, `Screen._forward_event` starts a text selection from the\nhit widget's parent, which is `None` for a detached widget, and\ndereferences `container.region`.\n\nReproduced against the pinned Textual with upstream's minimal example\n(no `deepagents` code involved), so this is fixed here only as a\nstopgap: it joins the other version-scoped shims in the Textual patch\nmodule as a fourth independent, separately guarded patch, with\nTextualize/textual#6643 as its removal criterion.\n\nThe guard wraps the public `Screen.get_widget_and_offset_at` — the\nsingle funnel for all three hit lookups in `_forward_event` (selection\nstart, drag update, and drag-in-progress) — and returns no hit when the\nwidget is detached. Textual then takes its existing \"nothing selectable\nhere\" branch, so a press on a just-pruned paragraph starts no selection\nrather than killing the process. This mirrors Textual's own\n`is_attached` guarding of live selections.\n\nWorth a careful look: the patch is on a public Textual method rather\nthan a private one, so it changes hit-testing for every mouse event, not\njust selection. Live widgets are unaffected, and there is a test pinning\nthat.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/a1475bad-bf2c-b5aa-716f-6d5e0cdbc40b)\n\n## References\n- Plan:\nhttps://openswe.vercel.app/agents/a1475bad-bf2c-b5aa-716f-6d5e0cdbc40b/plan\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"7c66512cd8d5af5037ce07276bbc405a9e812812","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/7c66512cd8d5af5037ce07276bbc405a9e812812"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/d4d2b60e37ae034e69f60ab5f34267b542c00dd5","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqaNj1CRC1aQ7uu5UhlAAAt0gQAGqQekryX2u7Drltx6EUpXd7\n0B3lo+99WLUAjMOMgt/JCmrGMcG8hdlInlI6ZMBoUhKuGpni07XYVRiQ2RiFo4sS\nZuGlb8usJensJPvOLboL9VLNpr2pNPowviACU8GA5keqhIFf2kb3i84kG/f8ddgZ\nmU7P4F1rdMuOWeBlwy9HAqZfv0DntzG/HoO5crrTRcGAFLVxOZYCFDERhKQqbets\nE07YESJJADwHDR42WWQ0evYrglq2Y50wk/1+allhVS7yywQGGMY0IXlEdY28SG/5\nzjZ7M+FEWvQOrTCM5KbUfpXU7LaQO4av2V7wFaIN1Ry5fpjyuX8ahRdOGbPrrzI7\nag8ve9NmQq4DrdZN5sDfsbokTDxuzmrCmubezNpfL9KfiSeXjdai/OprQiLSyNfE\nnO2ySeiyBQjnYuVFFUgb4pJ13so3TvnuTm1eMUS8ebPzIe656yaWBbtKDqjTjOJU\n+0/O4FWpKHHHOZHE3tB+2bK3KroLHSyAFzu9YeD1CbU2fASS/cA0oXzRFgNy1lni\ndZSN09GRhK4xJNH6jdl2zF2mRzwc+TVHfsJO8chFAXTFmNWL8nCPStOZ4uyXiqQV\nh6CK/cUCMEVeMdaYnNy4rixx7SXotvYkzTU1/iB701Qe0escrZ4y0Sfm08PdQn+h\nKWXqISRZBHSru0zK5kYf\n=oHsr\n-----END PGP SIGNATURE-----\n","payload":"tree 7c66512cd8d5af5037ce07276bbc405a9e812812\nparent 93e1bb5769128468aeee8e3a88eb5ffc603a5a35\nauthor Mason Daugherty <mason@langchain.dev> 1785256181 -0400\ncommitter GitHub <noreply@github.com> 1785256181 -0400\n\nfix(code): ignore mouse hits on detached widgets (#5114)\n\nRelated Textualize/textual#6643\n\nClicking or starting a text selection in the transcript while the agent\nwas streaming a response could take the whole app down with\n`AttributeError: 'NoneType' object has no attribute 'region'`. Mouse\npresses on markdown that is being replaced mid-stream are now ignored\ninstead of crashing.\n\n---\n\nTextual's compositor keeps reporting a widget as visible for a few\nevent-loop iterations after it leaves the DOM. `Markdown.update` — which\n`MarkdownStream` runs on every flush of a streaming assistant message —\ndetaches and remounts its blocks constantly, so that stale window is\nopen more or less continuously while output streams. When a mouse press\nlands in it, `Screen._forward_event` starts a text selection from the\nhit widget's parent, which is `None` for a detached widget, and\ndereferences `container.region`.\n\nReproduced against the pinned Textual with upstream's minimal example\n(no `deepagents` code involved), so this is fixed here only as a\nstopgap: it joins the other version-scoped shims in the Textual patch\nmodule as a fourth independent, separately guarded patch, with\nTextualize/textual#6643 as its removal criterion.\n\nThe guard wraps the public `Screen.get_widget_and_offset_at` — the\nsingle funnel for all three hit lookups in `_forward_event` (selection\nstart, drag update, and drag-in-progress) — and returns no hit when the\nwidget is detached. Textual then takes its existing \"nothing selectable\nhere\" branch, so a press on a just-pruned paragraph starts no selection\nrather than killing the process. This mirrors Textual's own\n`is_attached` guarding of live selections.\n\nWorth a careful look: the patch is on a public Textual method rather\nthan a private one, so it changes hit-testing for every mouse event, not\njust selection. Live widgets are unaffected, and there is a test pinning\nthat.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/a1475bad-bf2c-b5aa-716f-6d5e0cdbc40b)\n\n## References\n- Plan:\nhttps://openswe.vercel.app/agents/a1475bad-bf2c-b5aa-716f-6d5e0cdbc40b/plan\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-07-28T16:29:41Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/d4d2b60e37ae034e69f60ab5f34267b542c00dd5","html_url":"https://github.com/langchain-ai/deepagents/commit/d4d2b60e37ae034e69f60ab5f34267b542c00dd5","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/d4d2b60e37ae034e69f60ab5f34267b542c00dd5/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"93e1bb5769128468aeee8e3a88eb5ffc603a5a35","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/93e1bb5769128468aeee8e3a88eb5ffc603a5a35","html_url":"https://github.com/langchain-ai/deepagents/commit/93e1bb5769128468aeee8e3a88eb5ffc603a5a35"}]},{"sha":"93e1bb5769128468aeee8e3a88eb5ffc603a5a35","node_id":"C_kwDOPTymldoAKDkzZTFiYjU3NjkxMjg0NjhhZWVlOGUzYTg4ZWI1ZmZjNjAzYTVhMzU","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-28T16:19:48Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-28T16:19:48Z"},"message":"docs(infra): document TAVILY_API_KEY for evals environment (#5115)\n\nDocument `TAVILY_API_KEY` as a credential for the GitHub Actions `evals`\nenvironment, matching the secret now configured there for Tavily-backed\n`web_search`.","tree":{"sha":"9f33572abfd5dfd4e0f718729f29f3f914513671","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/9f33572abfd5dfd4e0f718729f29f3f914513671"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/93e1bb5769128468aeee8e3a88eb5ffc603a5a35","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqaNakCRC1aQ7uu5UhlAAA27EQAJrm0B2nWanP2i39/O9oWFYE\nGg0JLaUUDqNGjCT8DWG4bslC3CYMD/mOKr1/t8x2K6HY6ony+cGupMBqa0IruJnN\ntf4ef1XOiPAesinme0uVH3mVT/A1Ij7F/aRK0gd5DFGmVa2/Drk6LSeP+G58W/Z/\n50I1dSk5Wbe7wB1paZyzZHWVBAnWQyREJwljysR4tbbgzs1jNKdSEhb78yVJQrMM\nQzz3y0I8eV1n/YszMrm9W+zuN1nFGuc9OY9yiPzTvZdIN9U7/Ni/zfo8ATfh38bE\nLcoNfVRt6D/wFpzrbpUI3HQmJuqtpjtJGBZchbpaKKtGvMKopbVMCJFFdpuSXKji\nOvHpuCf8z4TDSD21NOnkTwM4S3TH/6P3YerOf1kyr40QwZ8uWxoP1CWUXdF1Xn1/\nkscsdOa8rxK0