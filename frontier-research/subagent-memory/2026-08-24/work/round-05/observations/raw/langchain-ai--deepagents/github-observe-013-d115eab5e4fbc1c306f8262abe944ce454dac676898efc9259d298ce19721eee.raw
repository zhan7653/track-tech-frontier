atars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"54aae4beab238043e0953ae7fab07ba295d56ad1","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/54aae4beab238043e0953ae7fab07ba295d56ad1","html_url":"https://github.com/langchain-ai/deepagents/commit/54aae4beab238043e0953ae7fab07ba295d56ad1"}]},{"sha":"54aae4beab238043e0953ae7fab07ba295d56ad1","node_id":"C_kwDOPTymldoAKDU0YWFlNGJlYWIyMzgwNDNlMDk1M2FlN2ZhYjA3YmEyOTVkNTZhZDE","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T21:50:29Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T21:50:29Z"},"message":"style(code): wrap auth modal footer hints on narrow terminals (#4309)\n\nThe `/auth` modal footer key-hints (e.g. `… Esc close`) were rendered\nwith a fixed CSS `height: 1`, so on narrow terminals the trailing `Esc`\nhint truncated instead of wrapping. Switching the help lines to `height:\nauto` lets them wrap to additional lines. Applied to\n`AuthManagerScreen`, `AuthPromptScreen`, and `AuthConfirmScreen`.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/f7873cbf-eb6b-bab1-7757-d961d068cd29)\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"5945310a362e7ec5d90324086bac0cc03a5592ae","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/5945310a362e7ec5d90324086bac0cc03a5592ae"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/54aae4beab238043e0953ae7fab07ba295d56ad1","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPvQlCRC1aQ7uu5UhlAAAEvcQACa1PrnMyXIJDpDhR8Ceird6\nCFdN4sEAKWSTF7NlMzixlwfc7Pm4F4fBuO5KzSt7kBPw61OPwtGWFWZ+fECIN3gy\nGBIdYsGk66VvoKXdg036F2WW/DAFbxIonBborGe+QdIKDdQmEstP100E2207q52L\nSxrSb8GPvKOn2HPPlzYsqXiOMok8pnpzksor7tNVmZ0RmtNOE0XCDfi/o00HPHwh\nh0fjuqfKmxc5I3Cys8p9pKeQfmddQe9/Cgw5y2FvBnif2JYuhWU92yvhJMLloBdB\nwVgje63u8zagG+ATt/5MtDO/30J4dYB9pKqxntm8RKfInfGuJrZx/6wO5SdFzEEx\nMqWqblXeaTwOW2BoeYIJFl8fy4qBTLdZWMeRUuN9VHNgRRad4eDTUOhKe0eUFMAE\nHCZvpTYUvTIbcZmfSk+XPrxoOwNXXKM7aABJ03w98XRd9noc3hpQBxM5tTpGPHsU\n6FNF3kTFrtk7rIYTmBhBdgS5K8c9jL3vz2FBUPELXr/Wuhn3dYXeBE5Wzagp3GKZ\nj7KCvn2I4YiOvxgx3zKwbE0rnhpWK0KF6xwrbKBCea7ILh/yYdrF30jtZ48cszkL\nPsrK6H+JHnaEhmwrnuGW51n7K3yTd9CSEQdaj+rg0g9uDqx0dUAJcBTxpG28gJCx\nso3lrMVv4FTrwrO5LmEB\n=BwOc\n-----END PGP SIGNATURE-----\n","payload":"tree 5945310a362e7ec5d90324086bac0cc03a5592ae\nparent 9cee60274d38d4ad8a2d7a7e9d3ae59aebce5261\nauthor Mason Daugherty <mason@langchain.dev> 1782510629 -0400\ncommitter GitHub <noreply@github.com> 1782510629 -0400\n\nstyle(code): wrap auth modal footer hints on narrow terminals (#4309)\n\nThe `/auth` modal footer key-hints (e.g. `… Esc close`) were rendered\nwith a fixed CSS `height: 1`, so on narrow terminals the trailing `Esc`\nhint truncated instead of wrapping. Switching the help lines to `height:\nauto` lets them wrap to additional lines. Applied to\n`AuthManagerScreen`, `AuthPromptScreen`, and `AuthConfirmScreen`.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/f7873cbf-eb6b-bab1-7757-d961d068cd29)\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-26T21:50:29Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/54aae4beab238043e0953ae7fab07ba295d56ad1","html_url":"https://github.com/langchain-ai/deepagents/commit/54aae4beab238043e0953ae7fab07ba295d56ad1","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/54aae4beab238043e0953ae7fab07ba295d56ad1/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"9cee60274d38d4ad8a2d7a7e9d3ae59aebce5261","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9cee60274d38d4ad8a2d7a7e9d3ae59aebce5261","html_url":"https://github.com/langchain-ai/deepagents/commit/9cee60274d38d4ad8a2d7a7e9d3ae59aebce5261"}]},{"sha":"9cee60274d38d4ad8a2d7a7e9d3ae59aebce5261","node_id":"C_kwDOPTymldoAKDljZWU2MDI3NGQzOGQ0YWQ4YTJkN2E3ZTlkM2FlNTlhZWJjZTUyNjE","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T21:25:14Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T21:25:14Z"},"message":"fix(code): clearer MCP config JSON parse errors (#4327)\n\nDeep Agents Code now shows a clearer, actionable error (with a hint and\na caret pointing at the offending line) when an MCP config file contains\ninvalid JSON.\n\n---\n\nWhen an MCP config file (e.g. `~/.deepagents/.mcp.json`) contains\ninvalid JSON, the error now surfaces an actionable hint (trailing comma,\n`//`/`/*` comments, missing value/delimiter/property name) and a caret\nsnippet pointing at the offending line, instead of just the raw decoder\nmessage. The error is still a `json.JSONDecodeError`, so the file path\nis added by existing callers and the multi-line text renders in the\n`/mcp` error modal.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/cd550fdd-ee5a-3c41-a8ea-5dcd09b8c06f)\n\n## References\n- Plan:\nhttps://openswe.vercel.app/agents/cd550fdd-ee5a-3c41-a8ea-5dcd09b8c06f/plan\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"012a43bee9e257dcf7f451748fd83d809749b960","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/012a43bee9e257dcf7f451748fd83d809749b960"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/9cee60274d38d4ad8a2d7a7e9d3ae59aebce5261","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPu46CRC1aQ7uu5UhlAAARXIQABOfodXYv8wK0LmIFGHz2zM0\nqLOtL3O62xrc/+Qj7JSusMoI6TQzkEEixJhwcZ3l+ny5woqKuEPoWNJXndgBXZOJ\n9jbXzOaDisQ7nZcZyHixIyloGtY+vXLIbZF+tYmPzs5gcPUdLjC23qjkgo/sA9Je\nfLOOuWGUxFSawLQtSRtHLNx/LRjlnZS+UC+LkLfGdotmPrJ5qg3hePxgTN9ySD3Z\nrEnKyCKu6iTBV8qEa9ffIAb1YomTbofZagpYCr4L+bpGvv8dC1I//rs/oxPAFsGb\n7G4DeIOr37Fb92MYKTSCRhN+BDDzNrPRTH0tDF8VZ5uI5R2+8PGVnXXz2udaipyE\n82OsGcWkH9Lf1/M5TeBafPIKPviUKSO1iXHof4XwcIRM/hUt5zo22/4gt7WcSdvg\nrP1BgoCSE24Eov/Ssl6Y75pjJ5ctjG1tTPtp59ZJSNkmuk0JiTj+ZDwwETmwUJb2\nm9pCDFvjg4lkqwm8hWCWfhxbDJSmkbHR4OANwJ60Y/B8pIOi8PwiAFc0qxUFHzua\ndHvJ/Gi7nh2LKdgggQ0cvNdMola0f102oZ3euJ+FopL0aifKkrM5bK16PLo0YILn\n1AkLGDGO12JLctL9SRVFlb9pcV5R6zYFAn81vjDWKgtmYfdvoc+lPMDfMAGUaK/1\nMCgT3KevwpStVb4u9W1D\n=aIYJ\n-----END PGP SIGNATURE-----\n","payload":"tree 012a43bee9e257dcf7f451748fd83d809749b960\nparent 5e6eae9f094a5167b6bf01f2d84cf06ca5cd80c3\nauthor Mason Daugherty <mason@langchain.dev> 1782509114 -0400\ncommitter GitHub <noreply@github.com> 1782509114 -0400\n\nfix(code): clearer MCP config JSON parse errors (#4327)\n\nDeep Agents Code now shows a clearer, actionable error (with a hint and\na caret pointing at the offending line) when an MCP config file contains\ninvalid JSON.\n\n---\n\nWhen an MCP config file (e.g. `~/.deepagents/.mcp.json`) contains\ninvalid JSON, the error now surfaces an actionable hint (trailing comma,\n`//`/`/*` comments, missing value/delimiter/property name) and a caret\nsnippet pointing at the offending line, instead of just the raw decoder\nmessage. The error is still a `json.JSONDecodeError`, so the file path\nis added by existing callers and the multi-line text renders in the\n`/mcp` error modal.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/cd550fdd-ee5a-3c41-a8ea-5dcd09b8c06f)\n\n## References\n- Plan:\nhttps://openswe.vercel.app/agents/cd550fdd-ee5a-3c41-a8ea-5dcd09b8c06f/plan\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-26T21:25:15Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9cee60274d38d4ad8a2d7a7e9d3ae59aebce5261","html_url":"https://github.com/langchain-ai/deepagents/commit/9cee60274d38d4ad8a2d7a7e9d3ae59aebce5261","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9cee60274d38d4ad8a2d7a7e9d3ae59aebce5261/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"5e6eae9f094a5167b6bf01f2d84cf06ca5cd80c3","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/5e6eae9f094a5167b6bf01f2d84cf06ca5cd80c3","html_url":"https://github.com/langchain-ai/deepagents/commit/5e6eae9f094a5167b6bf01f2d84cf06ca5cd80c3"}]},{"sha":"5e6eae9f094a5167b6bf01f2d84cf06ca5cd80c3","node_id":"C_kwDOPTymldoAKDVlNmVhZTlmMDk0YTUxNjdiNmJmMDFmMmQ4NGNmMDZjYTVjZDgwYzM","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T21:16:28Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T21:16:28Z"},"message":"feat(code): quit shortcut on completed update modal (#4312)\n\nAdd a `q` shortcut to quit the app from the update-complete modal.\n\n---\n\nThe \"Updating Deep Agents Code\" modal tells users to \"Quit and relaunch\"\nonce the self-update finishes, but only offered Esc (close modal). This\nadds a `q` shortcut that exits the app, active only after the update\ncommand completes, and surfaces it in the modal help line when done.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/f676294d-7c1a-943c-ad84-bf77cb7ed926)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"72eb82515ec71e13b3b1163430e09959e93de15a","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/72eb82515ec71e13b3b1163430e09959e93de15a"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/5e6eae9f094a5167b6bf01f2d84cf06ca5cd80c3","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPuwsCRC1aQ7uu5UhlAAAohgQAHcZGALST1858D7z9Rogh40s\n8EA3E7fez7mYWBYuS0IYZEaOHWRm1oBJ+TRrJT2w2pBbn4liPA/xUkcO/K7YOuVJ\nBy4tXz+AQBvnoCBpW8fYIoqo6IgEaEEU2n0d4KBwsX8UZ3C5bnhOF1SeMx8ztEe5\nIadsJHSsPycyaz2YFp/NlVwPeWpB0N++r0RocH3bqGwqfxujfr/msKUoCPt0s2WS\nashEckdCpsJWD714gx7x774APwCVlPy5QRJDCYFZHR6BZ6Bctcck+sQ3WHhEhIYA\nXYOe6nEOjpSnTJH3fXanwgnT97UwzNbAySSL0ffIbBIzfH0bCTJ6VGqVIORE82Ng\naX+L6VrdQ4zi/psS3Jd6W0voFPGVRv4YJooDNYFeF8ph/PlVthnvcsErNj7VLXkA\nnvv7kV9xlad/Am3C6oGGD15W2ZVtRPfQ6m6zj5LMF3X9ffMw7q0lpK+rMSSJFuAm\niAHZsgxJ3dsMZ3Swe3ryauFbNdnO7Eu3m98KNNdPsEc88vBIoPDL6ANI0RQJUBB5\nnzwGvOgdvoxGAkgeJm6FM6Tt2tFP77v5Jh+NA66g+8sgeZer0kQScg9d+2JHv6rJ\n3326Qr7xg4AE7isDe+Na9e0TmQHZKN8KnIC5qwVcSBPoWmMZeHWEi7YDw/EPr1Wn\nnDmhYz2dhJdrvKmyVFgr\n=8SUR\n-----END PGP SIGNATURE-----\n","payload":"tree 72eb82515ec71e13b3b1163430e09959e93de15a\nparent 8e8680bd01d717b3e639ad205eeb461e52998732\nauthor Mason Daugherty <mason@langchain.dev> 1782508588 -0400\ncommitter GitHub <noreply@github.com> 1782508588 -0400\n\nfeat(code): quit shortcut on completed update modal (#4312)\n\nAdd a `q` shortcut to quit the app from the update-complete modal.\n\n---\n\nThe \"Updating Deep Agents Code\" modal tells users to \"Quit and relaunch\"\nonce the self-update finishes, but only offered Esc (close modal). This\nadds a `q` shortcut that exits the app, active only after the update\ncommand completes, and surfaces it in the modal help line when done.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/f676294d-7c1a-943c-ad84-bf77cb7ed926)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-26T21:16:29Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/5e6eae9f094a5167b6bf01f2d84cf06ca5cd80c3","html_url":"https://github.com/langchain-ai/deepagents/commit/5e6eae9f094a5167b6bf01f2d84cf06ca5cd80c3","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/5e6eae9f094a5167b6bf01f2d84cf06ca5cd80c3/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"8e8680bd01d717b3e639ad205eeb461e52998732","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/8e8680bd01d717b3e639ad205eeb461e52998732","html_url":"https://github.com/langchain-ai/deepagents/commit/8e8680bd01d717b3e639ad205eeb461e52998732"}]},{"sha":"8e8680bd01d717b3e639ad205eeb461e52998732","node_id":"C_kwDOPTymldoAKDhlODY4MGJkMDFkNzE3YjNlNjM5YWQyMDVlZWI0NjFlNTI5OTg3MzI","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T20:46:11Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T20:46:11Z"},"message":"build(deps): refresh dependency minimums (#4331)\n\nRefreshes dependency minimums across packages and examples so published\nconstraints line up with current lock resolutions and companion package\nreleases. The SDK also drops two now-unneeded typing workarounds after\nthe dependency/tooling refresh.\n\n## Changes\n- Updates lower bounds for LangChain provider integrations, LangSmith\nsandbox support, Deep Agents package pins, and test tooling across\nlibraries and examples.\n- Regenerates `uv.lock` files for the affected packages after the\ndependency refresh.\n- Removes the obsolete `ty` ignore in `_tool_name` and adds explicit\n`FileData` dictionary typing in `_file_data_reducer` for the current\ntype checker.","tree":{"sha":"a04a665e2c53afc8eb224bfcc8e4dc22b23c3482","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/a04a665e2c53afc8eb224bfcc8e4dc22b23c3482"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/8e8680bd01d717b3e639ad205eeb461e52998732","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPuUTCRC1aQ7uu5UhlAAAtOQQAISqwUkUZdmLo8MtxAQGoT9F\nwaOo5PvqApYqzGeaSKY6IH+Prwm+1MV0jrf6GhadMu83pIufi/cnQSOUYgc2r+oK\nMEa3CMtNYz9n7/S7ZOLyljafQEUCWC5HVbWJf2HSNjzzJD+GVVPkubL5egAjnmhw\neOvdfiNGRGD0+HbHYgEhhIRXrTB2kh7hB+W8FkxcZfsPPQnpKrtKWrUR6sVNVgsp\npUybHj2iNXT31xEpSYenxP+NEcijWkcxYb5zw4RFGBrSSbPdhoTwJVIuQk1Au1a8\nEGxUVpUSG1srZXbSNT/xfbwgwXw/gic5KvWsVfQW8rb5oppvF6T6uSkXsBqaggn1\nmNQlYxmBIOmmZfWoxT2JzYA1+HnvD5ztnhU+H64Pfr/bb9zlXO6wClsUE0d+8Em2\neYGpQRZFlL1b5eorDWWnME5G1XCvGV3WRxGOLru04BL37n3BvtZOeUX2qOd9jhwQ\nSPtgohQG+IygKpye/ZqJTuxBn6sh+CXp6b5IcVaf9eFcGR51ccUXxe99aCozBgUs\nH7H4noWIVVXLUmphx9LDn2OEdhgTQgIM7b3CbTs1uRZJCqr7ntKLcm8oMvLJl7MW\npxEiZx1a6rcGjsxJyepdOYV2Cj1ccUnTH9GV2ma6DkHi2E7qwDfoXL4ShbX5R232\nWSMqJnEYsYPNIu7/ab+d\n=ryWy\n-----END PGP SIGNATURE-----\n","payload":"tree a04a665e2c53afc8eb224bfcc8e4dc22b23c3482\nparent 8f20d74892112c3b88aaca63d8c04a355fd6726f\nauthor Mason Daugherty <mason@langchain.dev> 1782506771 -0400\ncommitter GitHub <noreply@github.com> 1782506771 -0400\n\nbuild(deps): refresh dependency minimums (#4331)\n\nRefreshes dependency minimums across packages and examples so published\nconstraints line up with current lock resolutions and companion package\nreleases. The SDK also drops two now-unneeded typing workarounds after\nthe dependency/tooling refresh.\n\n## Changes\n- Updates lower bounds for LangChain provider integrations, LangSmith\nsandbox support, Deep Agents package pins, and test tooling across\nlibraries and examples.\n- Regenerates `uv.lock` files for the affected packages after the\ndependency refresh.\n- Removes the obsolete `ty` ignore in `_tool_name` and adds explicit\n`FileData` dictionary typing in `_file_data_reducer` for the current\ntype checker.","verified_at":"2026-06-26T20:46:12Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/8e8680bd01d717b3e639ad205eeb461e52998732","html_url":"https://github.com/langchain-ai/deepagents/commit/8e8680bd01d717b3e639ad205eeb461e52998732","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/8e8680bd01d717b3e639ad205eeb461e52998732/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"8f20d74892112c3b88aaca63d8c04a355fd6726f","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/8f20d74892112c3b88aaca63d8c04a355fd6726f","html_url":"https://github.com/langchain-ai/deepagents/commit/8f20d74892112c3b88aaca63d8c04a355fd6726f"}]},{"sha":"8f20d74892112c3b88aaca63d8c04a355fd6726f","node_id":"C_kwDOPTymldoAKDhmMjBkNzQ4OTIxMTJjM2I4OGFhY2E2M2Q4YzA0YTM1NWZkNjcyNmY","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T20:17:01Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T20:17:01Z"},"message":"fix(code): honor Baseten base URL env precedence (#4328)\n\nBaseten endpoint configuration now follows `langchain-baseten`:\n`BASETEN_BASE_URL` is the primary base URL env var and\n`BASETEN_API_BASE` remains as the legacy fallback. Stored `/auth`\nendpoints now pair Baseten keys with the canonical endpoint env var\nwhile clearing stale legacy values.\n\n## Changes\n- Register Baseten in `PROVIDER_BASE_URL_ENV` with `BASETEN_BASE_URL`\nbefore `BASETEN_API_BASE`.\n- Update `ModelConfig.get_base_url` to check all built-in base URL env\nvars in provider precedence order instead of only the canonical name.\n- Preserve `config.toml` `base_url_env` override behavior for custom\nproviders.\n- Add regression coverage for Baseten env precedence, legacy fallback,\n`/auth` endpoint application, and local test env isolation.","tree":{"sha":"466b6306f5e8ed97dd9dd7cab0b8accad1246102","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/466b6306f5e8ed97dd9dd7cab0b8accad1246102"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/8f20d74892112c3b88aaca63d8c04a355fd6726f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPt49CRC1aQ7uu5UhlAAAQ5AQACdMgb+/iGz45OwdCUXFSIDP\nyp9wkbNaBMbBB2+1Bh3jMgHo9w1GHv/R/wdhbuHjAKxYD5qBAkWOlkOj0G0EP2NY\nX7bGf8nobnsj0kA7ALgEkYw9yWyuIGuk7kY3cY9SkkkpBuV604fSdjUSldww5W/+\neQNFu37nBy+9ejpwKpzVj+GgdGFNHhEsy4LSy+Hfniw2z1Nz0idupWYbRvHiZcHU\nEivrCg5/aWZhVWgD+q9IaM/NLt1814ubNaTdbXCmOYTuiPFUIct0Unt4ZmliyrPd\nqbs3Fo9muEwIqzC7hHDbbjxmqoMgEq2yIhXX9CZF3Hb8SRtvNclzzDuAB2UBoh56\ntGleRufa7HXQAqPL8vRZro1SwJxnxk1h3+K5MjIDeYmhOfyOowzYN3MZJ13vEW1h\n07YggOwGp53/VBuANLX6RhOQvnx2Xm/jIqp1F6HUsbF9EdTHvvsgF+rdES9lYNM5\n7ByQkOB5l3oi1hc5vpftmwHuS2Wj65iiXaQfaWql1WkovHbbr8NZlhlEklADmhu2\n5YepyWX3FIMyDkaIWm4x31FLtBQxP3fHxj4k3wo0za7lbxOQkYysXypkn9B7gNAd\nEF8F1M7Fyo4qcgNqfyCjiUHdKYorV1P/V1GGKK87YJMU3O7RCrP4iyfE0JCmOKmn\nn9gqhcUL+OG2aux8IJEw\n=azAh\n-----END PGP SIGNATURE-----\n","payload":"tree 466b6306f5e8ed97dd9dd7cab0b8accad1246102\nparent db2fef2953b69706a3a58416cd575511981730ec\nauthor Mason Daugherty <mason@langchain.dev> 1782505021 -0400\ncommitter GitHub <noreply@github.com> 1782505021 -0400\n\nfix(code): honor Baseten base URL env precedence (#4328)\n\nBaseten endpoint configuration now follows `langchain-baseten`:\n`BASETEN_BASE_URL` is the primary base URL env var and\n`BASETEN_API_BASE` remains as the legacy fallback. Stored `/auth`\nendpoints now pair Baseten keys with the canonical endpoint env var\nwhile clearing stale legacy values.\n\n## Changes\n- Register Baseten in `PROVIDER_BASE_URL_ENV` with `BASETEN_BASE_URL`\nbefore `BASETEN_API_BASE`.\n- Update `ModelConfig.get_base_url` to check all built-in base URL env\nvars in provider precedence order instead of only the canonical name.\n- Preserve `config.toml` `base_url_env` override behavior for custom\nproviders.\n- Add regression coverage for Baseten env precedence, legacy fallback,\n`/auth` endpoint application, and local test env isolation.","verified_at":"2026-06-26T20:17:01Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/8f20d74892112c3b88aaca63d8c04a355fd6726f","html_url":"https://github.com/langchain-ai/deepagents/commit/8f20d74892112c3b88aaca63d8c04a355fd6726f","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/8f20d74892112c3b88aaca63d8c04a355fd6726f/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"db2fef2953b69706a3a58416cd575511981730ec","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/db2fef2953b69706a3a58416cd575511981730ec","html_url":"https://github.com/langchain-ai/deepagents/commit/db2fef2953b69706a3a58416cd575511981730ec"}]},{"sha":"db2fef2953b69706a3a58416cd575511981730ec","node_id":"C_kwDOPTymldoAKGRiMmZlZjI5NTNiNjk3MDZhM2E1ODQxNmNkNTc1NTExOTgxNzMwZWM","commit":{"author":{"name":"github-actions[bot]","email":"41898282+github-actions[bot]@users.noreply.github.com","date":"2026-06-26T19:00:18Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T19:00:18Z"},"message":"release(deepagents-code): 0.1.27 (#4326)\n\n> [!CAUTION]\n> Merging this PR will automatically publish to **PyPI** and create a\n**GitHub release**.\n\nFor the full release process, see\n[`.github/RELEASING.md`](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md).\n\n---\n\n_Everything below this line will be the GitHub release body._\n\n---\n\n\n##\n[0.1.27](https://github.com/langchain-ai/deepagents/compare/deepagents-code==0.1.26...deepagents-code==0.1.27)\n(2026-06-26)\n\n### Features\n\n* Show last update check time in `dcode doctor`\n([#4307](https://github.com/langchain-ai/deepagents/issues/4307))\n([b669f37](https://github.com/langchain-ai/deepagents/commit/b669f37fb08998cfbf983da76f57822215614e7b))\n\n### Bug Fixes\n\n* `dcode doctor` shows `not configured` for unset tracing\n([#4318](https://github.com/langchain-ai/deepagents/issues/4318))\n([e323d0c](https://github.com/langchain-ai/deepagents/commit/e323d0c7d91f3b11e03a016c14cf52008dc66b55))\n* Drop duplicate token-request `client_id` under Basic auth\n([#4323](https://github.com/langchain-ai/deepagents/issues/4323))\n([426dfad](https://github.com/langchain-ai/deepagents/commit/426dfad3ea1e453914cb87efa8fc70fb85a9efcb))\n* Include skill invocations in input history\n([#4211](https://github.com/langchain-ai/deepagents/issues/4211))\n([7b8d0b2](https://github.com/langchain-ai/deepagents/commit/7b8d0b2ec184e0d9a0cbe858a0d9a7128791969d))\n* Offload `create_model` in server graph factory to unblock Codex\n([#4324](https://github.com/langchain-ai/deepagents/issues/4324))\n([064ea0c](https://github.com/langchain-ai/deepagents/commit/064ea0c6851353d0b0bc347a0758149765688945))\n\n---\n\n_Everything above this line will be the GitHub release body._\n\n---\n\n> [!NOTE]\n> A **New Contributors** section is appended to the GitHub release notes\nautomatically at publish time (see [Release\nPipeline](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md#release-pipeline),\nstep 2).\n\n---------\n\nCo-authored-by: github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","tree":{"sha":"a76eeac072997aebd381012f16d4c967a31bae64","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/a76eeac072997aebd381012f16d4c967a31bae64"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/db2fef2953b69706a3a58416cd575511981730ec","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPsxCCRC1aQ7uu5UhlAAAx3IQAAlaUiBr8wyyNSifmcT8bFmB\n2QsSwXk3gOJL+gF2mHYbCYaV/mpGLLpqLmT5IT88kmYsY5RqMzkax7F3qNJVKrn7\nPAEPtfaUbKGj/CunCJciluNPNk6LaVdr2wB1HV0kqb5uZtlBKgbDKo/vOm2JTCK9\npMcq/+Xc+Ycekej+hhjlH2mPvTXx2y9tapJWVhuHs0BA7ut1wcI6iUoT6h7GsrxX\niyl5fmx7U4OX53nz2f9WND2Fm/dJFLiWfABYQ6ctrFr3YEAjUZMxCMkAAr5wTmwS\npiZyp2x1wR9meGu2xyzvOn1hyiqkLUo08vkHi9XbF3VHFnjrsGI1OG2aVvD3WX4u\n9zMKC2KySxJWEh1DsZstKPXncurQXdJzKFxO/fLb4YGiaGzyYgqqVcaqhVhUn1GE\nAvk0KNFC7tybuG7NpRTglX1xjD+gBcZ4iEW9XK6OPLFTAVkRVicsyTvPeU7m8y3W\nQ0ry5HKy+l02dWxUw7/VLO46x4KlSm252oUQffA5cIqnWG2DFR7x+OoBbTC9OPlr\n35f3dq9Qh/cg6Xxd6XD4vIJK/eUt9CG48iehq2aqWwjgvgrW2RHNIBNIYKdoiAd8\npHH+FrwosA5UHNxjroUzFF5pa//cI220+85MZDPJrTJli6txyco4S/CLkICt48xc\nrx4CdWTZpb21Gkme9iOC\n=STx5\n-----END PGP SIGNATURE-----\n","payload":"tree a76eeac072997aebd381012f16d4c967a31bae64\nparent 7b8d0b2ec184e0d9a0cbe858a0d9a7128791969d\nauthor github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com> 1782500418 -0400\ncommitter GitHub <noreply@github.com> 1782500418 -0400\n\nrelease(deepagents-code): 0.1.27 (#4326)\n\n> [!CAUTION]\n> Merging this PR will automatically publish to **PyPI** and create a\n**GitHub release**.\n\nFor the full release process, see\n[`.github/RELEASING.md`](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md).\n\n---\n\n_Everything below this line will be the GitHub release body._\n\n---\n\n\n##\n[0.1.27](https://github.com/langchain-ai/deepagents/compare/deepagents-code==0.1.26...deepagents-code==0.1.27)\n(2026-06-26)\n\n### Features\n\n* Show last update check time in `dcode doctor`\n([#4307](https://github.com/langchain-ai/deepagents/issues/4307))\n([b669f37](https://github.com/langchain-ai/deepagents/commit/b669f37fb08998cfbf983da76f57822215614e7b))\n\n### Bug Fixes\n\n* `dcode doctor` shows `not configured` for unset tracing\n([#4318](https://github.com/langchain-ai/deepagents/issues/4318))\n([e323d0c](https://github.com/langchain-ai/deepagents/commit/e323d0c7d91f3b11e03a016c14cf52008dc66b55))\n* Drop duplicate token-request `client_id` under Basic auth\n([#4323](https://github.com/langchain-ai/deepagents/issues/4323))\n([426dfad](https://github.com/langchain-ai/deepagents/commit/426dfad3ea1e453914cb87efa8fc70fb85a9efcb))\n* Include skill invocations in input history\n([#4211](https://github.com/langchain-ai/deepagents/issues/4211))\n([7b8d0b2](https://github.com/langchain-ai/deepagents/commit/7b8d0b2ec184e0d9a0cbe858a0d9a7128791969d))\n* Offload `create_model` in server graph factory to unblock Codex\n([#4324](https://github.com/langchain-ai/deepagents/issues/4324))\n([064ea0c](https://github.com/langchain-ai/deepagents/commit/064ea0c6851353d0b0bc347a0758149765688945))\n\n---\n\n_Everything above this line will be the GitHub release body._\n\n---\n\n> [!NOTE]\n> A **New Contributors** section is appended to the GitHub release notes\nautomatically at publish time (see [Release\nPipeline](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md#release-pipeline),\nstep 2).\n\n---------\n\nCo-authored-by: github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","verified_at":"2026-06-26T19:00:19Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/db2fef2953b69706a3a58416cd575511981730ec","html_url":"https://github.com/langchain-ai/deepagents/commit/db2fef2953b69706a3a58416cd575511981730ec","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/db2fef2953b69706a3a58416cd575511981730ec/comments","author":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7b8d0b2ec184e0d9a0cbe858a0d9a7128791969d","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7b8d0b2ec184e0d9a0cbe858a0d9a7128791969d","html_url":"https://github.com/langchain-ai/deepagents/commit/7b8d0b2ec184e0d9a0cbe858a0d9a7128791969d"}]},{"sha":"7b8d0b2ec184e0d9a0cbe858a0d9a7128791969d","node_id":"C_kwDOPTymldoAKDdiOGQwYjJlYzE4NGUwZDlhMGNiZTg1OGEwZDlhNzEyODc5MTk2OWQ","commit":{"author":{"name":"John Kennedy","email":"65985482+jkennedyvz@users.noreply.github.com","date":"2026-06-26T18:50:15Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T18:50:15Z"},"message":"fix(code): include skill invocations in input history (#4211)\n\nThe `HistoryManager.add()` method blanket-excluded all slash-prefixed\ninput from history. This meant `/skill:<name>` invocations were silently\ndropped, and the up-arrow could never recall them — it skipped to the\nlast non-skill message instead.\n\nChange the guard to exclude only non-skill slash commands (e.g. `/help`,\n`/quit`, `/model`), which are ephemeral UI actions. `/skill:<name>`\ninvocations (case-insensitive) are now stored and recallable via\nup-arrow navigation, matching user expectation for repeatable prompts.\n\n**Scope note:** history captures the raw submitted text *before* the app\nlayer rewrites convenience aliases (`/remember` → `/skill:remember`, and\nthe skill-creator alias) into their `/skill:` form. As a result, those\naliases — and the redundant `/<name>` forms of skills — are\nintentionally not stored here; only the canonical `/skill:<name>`\ninvocation is recallable. The guard and a negative test pin this\nboundary so it doesn't drift silently.\n\n---------\n\nCo-authored-by: Deep Agent <agent@deepagents.dev>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","tree":{"sha":"838150f08ad6184e856398c7f872ddf880b512a2","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/838150f08ad6184e856398c7f872ddf880b512a2"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/7b8d0b2ec184e0d9a0cbe858a0d9a7128791969d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPsnnCRC1aQ7uu5UhlAAArBEQAIsk0335BhdywQTbhvMr97MK\nFEEu8UxGnFdnWupQBJWQCQ5RZ7cz6jDVZU6rmpgwuN7Z6HiaCY5h9VohJgfDnIww\nvfWXEUCe+Pi7UEBKYBZrP2ve6Pa+o0UX1hlyQZhtYIaVhuNpfU/eXTjiTQu+4dez\nd26vZyWK/HQEFGfdstaF6AVoVs+HTG+MT8X/cqhrspdZ4ZVWYc5CS0uRJc65M3OE\nQq8Zgdt97WZju+7TQHTlETFbYEDRVfO5HwfmZ7MkE/RWX2R+KjyKIMoSxeg/4jiX\n2FeW9uL9tPTT7bcb1xDpwxDvMKTgVEg3DlZaIF0s6KcTJWOdrxhljcWjjvK1TpPd\nRUtut7f/3WmEU2ykG7eBW4EcNgPtyCPgJkBjQ+/TquqvW1DVTZRKoMpNWWeC4D2O\nVd4beRWWs/h4SJyxDcyGZ648xAIhszkcljNFePCkqvsJrLiHvIYU3xLLbmjtC0Yc\n36UJ8SfVvrk9qwoy9gSxnG+QVRMUcXT0WwjvOgCzHwEfNVjqiV9GzgkFj137QqDq\nWRlkHa8igXX42WUGWU9maC33tgMZDN+WeC+s7B3MfExKZYqq9ijjrwRpQiDVqnPc\nie16wzb3ZUwBNd+NMXLcZk0R8LRFTlQ5rS+na3OTNVwe5bQMRCRIYVspJwz1jxYW\nqc0ZjSmiI913SYbq/Zy0\n=dfII\n-----END PGP SIGNATURE-----\n","payload":"tree 838150f08ad6184e856398c7f872ddf880b512a2\nparent 7c87ceca069874db8555705efab3973301baa1cb\nauthor John Kennedy <65985482+jkennedyvz@users.noreply.github.com> 1782499815 -0700\ncommitter GitHub <noreply@github.com> 1782499815 -0400\n\nfix(code): include skill invocations in input history (#4211)\n\nThe `HistoryManager.add()` method blanket-excluded all slash-prefixed\ninput from history. This meant `/skill:<name>` invocations were silently\ndropped, and the up-arrow could never recall them — it skipped to the\nlast non-skill message instead.\n\nChange the guard to exclude only non-skill slash commands (e.g. `/help`,\n`/quit`, `/model`), which are ephemeral UI actions. `/skill:<name>`\ninvocations (case-insensitive) are now stored and recallable via\nup-arrow navigation, matching user expectation for repeatable prompts.\n\n**Scope note:** history captures the raw submitted text *before* the app\nlayer rewrites convenience aliases (`/remember` → `/skill:remember`, and\nthe skill-creator alias) into their `/skill:` form. As a result, those\naliases — and the redundant `/<name>` forms of skills — are\nintentionally not stored here; only the canonical `/skill:<name>`\ninvocation is recallable. The guard and a negative test pin this\nboundary so it doesn't drift silently.\n\n---------\n\nCo-authored-by: Deep Agent <agent@deepagents.dev>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","verified_at":"2026-06-26T18:50:16Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7b8d0b2ec184e0d9a0cbe858a0d9a7128791969d","html_url":"https://github.com/langchain-ai/deepagents/commit/7b8d0b2ec184e0d9a0cbe858a0d9a7128791969d","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7b8d0b2ec184e0d9a0cbe858a0d9a7128791969d/comments","author":{"login":"jkennedyvz","id":65985482,"node_id":"MDQ6VXNlcjY1OTg1NDgy","avatar_url":"https://avatars.githubusercontent.com/u/65985482?v=4","gravatar_id":"","url":"https://api.github.com/users/jkennedyvz","html_url":"https://github.com/jkennedyvz","followers_url":"https://api.github.com/users/jkennedyvz/followers","following_url":"https://api.github.com/users/jkennedyvz/following{/other_user}","gists_url":"https://api.github.com/users/jkennedyvz/gists{/gist_id}","starred_url":"https://api.github.com/users/jkennedyvz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jkennedyvz/subscriptions","organizations_url":"https://api.github.com/users/jkennedyvz/orgs","repos_url":"https://api.github.com/users/jkennedyvz/repos","events_url":"https://api.github.com/users/jkennedyvz/events{/privacy}","received_events_url":"https://api.github.com/users/jkennedyvz/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7c87ceca069874db8555705efab3973301baa1cb","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7c87ceca069874db8555705efab3973301baa1cb","html_url":"https://github.com/langchain-ai/deepagents/commit/7c87ceca069874db8555705efab3973301baa1cb"}]},{"sha":"7c87ceca069874db8555705efab3973301baa1cb","node_id":"C_kwDOPTymldoAKDdjODdjZWNhMDY5ODc0ZGI4NTU1NzA1ZWZhYjM5NzMzMDFiYWExY2I","commit":{"author":{"name":"John Kennedy","email":"65985482+jkennedyvz@users.noreply.github.com","date":"2026-06-26T18:47:36Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T18:47:36Z"},"message":"feat(talon): add Telegram channel adapter, CLI wiring, and offset persistence (#4097)\n\nImplements a Telegram Bot API channel for Talon and updates the shared\nchannel policy so Telegram and WhatsApp use the same exposure rules.\n\n---\n\n## Telegram channel\n\nAdds a pure-Python Telegram channel adapter that uses the Bot API\ndirectly rather than a local bridge. It supports long polling, persisted\nupdate offsets, inbound media downloads, outbound text and media, typing\nindicators, message edits, and plain-text message delivery.\n\nTelegram configuration is wired through `DEEPAGENTS_TALON_TELEGRAM_*`,\nwith `TELEGRAM_BOT_TOKEN` accepted as a convenience alias. The host can\nrun Telegram, WhatsApp, or both channels against the same Talon runtime.\n\n## Shared Channel Exposure\n\nMoves provider-specific exposure parsing into the shared channel\nabstraction via `ChannelExposureEnv` and `channel_exposure_from_env`.\nTelegram and WhatsApp now share the same handling for `self`,\n`allowlist`, `open`, mention patterns, open-exposure acknowledgement,\nand operator identity.\n\n`ChannelExposure` now supports multiple operator IDs while preserving\nthe existing single `operator_id` API. The existing\n`DEEPAGENTS_TALON_TELEGRAM_OPERATOR_ID` and\n`DEEPAGENTS_TALON_WHATSAPP_OPERATOR_ID` env vars accept comma-separated\nIDs, so `self` exposure can allow more than one trusted operator without\nduplicating logic in each provider.\n\n## Media And Runtime Handling\n\nAdds shared media helpers for inbound media metadata, outbound media\nvalidation, and configured media-size caps. Telegram and WhatsApp both\nuse the common cap handling, while WhatsApp keeps a lower\nprovider-specific cap because its bridge materializes downloads in\nmemory.\n\nThe host and runtime wiring now preserve channel metadata, support\nchannel-specific approval handling, and allow Telegram channel posts\nthrough the same serialized agent execution path as other Talon\nchannels.\n\n## Example App\n\nRefreshes the example app from a WhatsApp-only example into a general\nTalon Docker example. The example now documents running WhatsApp,\nTelegram, or both; adds placeholder-only env settings for Telegram\nallowlists and channel toggles; keeps local secrets in an ignored\n`.env`; and updates the Docker setup so the packaged WhatsApp bridge and\nTalon runtime work together from the same container.\n\n## Review Notes\n\nThe exposure changes are intentionally centralized in the shared channel\nlayer. Provider modules should only declare their env var names and\nprovider-specific requirements, such as Telegram requiring an operator\nID for `self` exposure.\n\nThe example app changes are mostly naming and configuration surface\nupdates so it reflects the new multi-channel Talon host rather than only\nWhatsApp.\n\n---------\n\nSigned-off-by: John Kennedy <65985482+jkennedyvz@users.noreply.github.com>\nCo-authored-by: Deep Agent <agent@deepagents.dev>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>","tree":{"sha":"d729e5c8a7286e2cbe3d16194a5a342efbd4cde3","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/d729e5c8a7286e2cbe3d16194a5a342efbd4cde3"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/7c87ceca069874db8555705efab3973301baa1cb","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPslICRC1aQ7uu5UhlAAAWQUQAFdIH/cQRRnWLPcB5G1shE0i\nCQpqB0sOhfQKDMAkb2CADmEy4MZdwFt3vsj9GUdz8Me8z0VUOsR8ZDeABEcbBCWh\nH0x7h7z2ZslKHCeHT/fvUmPoMxucG9coF/1uq1idvcpXiRTt8gnXTaHeVIiso3/3\nS3cIzKbf45/sSG1/JGiVx9WqnL4lRYooOUpwMi0mp4Mo3LWy76Ary+Th+zVhiMDM\nhefULdcrX82s0IMH3tdcdAem4F+UJ1Ydionol4BBSCNQsHD+7e6LFAk5CHvu8Uy9\ng3v8sjDlUS5oUhNSjo7X3yIQ8igQchoXUGUAxNQraHhnhHvg4+xyAHmE4Gyun9Wf\nXmXZt9WfoTU6M0VErKrzJpvF9jirNFxWoo+dK90SwzDgpgHYP49RyaXguo0hNfFl\nVrZ/NZw7WGHImHHXLEwarH9tpPUzKrY90bQQkKYVmBKV+Sa0VyZdAdDeOZJsmnQn\ndoMYATsEFGVjxMTgtjnvpQdvjcmHwuE9i4Mx1kitVMao4Zn5tuDPiOyO/IZ2JxTy\nui7D3oOpmALA4quHZY0G8DJs2nGFQTGJUI0+3SuNya6p7nyEykGH4SXEOUWtkFTa\n9NozkypvqA5cFJeukEJtkOX19fkGWrbCSliok2TFUjYHyHcU7CGVKPg9Bsw6HrAH\nS/DR6AkwGxYU8WlZKQ3h\n=5Ff/\n-----END PGP SIGNATURE-----\n","payload":"tree d729e5c8a7286e2cbe3d16194a5a342efbd4cde3\nparent 426dfad3ea1e453914cb87efa8fc70fb85a9efcb\nauthor John Kennedy <65985482+jkennedyvz@users.noreply.github.com> 1782499656 -0700\ncommitter GitHub <noreply@github.com> 1782499656 -0400\n\nfeat(talon): add Telegram channel adapter, CLI wiring, and offset persistence (#4097)\n\nImplements a Telegram Bot API channel for Talon and updates the shared\nchannel policy so Telegram and WhatsApp use the same exposure rules.\n\n---\n\n## Telegram channel\n\nAdds a pure-Python Telegram channel adapter that uses the Bot API\ndirectly rather than a local bridge. It supports long polling, persisted\nupdate offsets, inbound media downloads, outbound text and media, typing\nindicators, message edits, and plain-text message delivery.\n\nTelegram configuration is wired through `DEEPAGENTS_TALON_TELEGRAM_*`,\nwith `TELEGRAM_BOT_TOKEN` accepted as a convenience alias. The host can\nrun Telegram, WhatsApp, or both channels against the same Talon runtime.\n\n## Shared Channel Exposure\n\nMoves provider-specific exposure parsing into the shared channel\nabstraction via `ChannelExposureEnv` and `channel_exposure_from_env`.\nTelegram and WhatsApp now share the same handling for `self`,\n`allowlist`, `open`, mention patterns, open-exposure acknowledgement,\nand operator identity.\n\n`ChannelExposure` now supports multiple operator IDs while preserving\nthe existing single `operator_id` API. The existing\n`DEEPAGENTS_TALON_TELEGRAM_OPERATOR_ID` and\n`DEEPAGENTS_TALON_WHATSAPP_OPERATOR_ID` env vars accept comma-separated\nIDs, so `self` exposure can allow more than one trusted operator without\nduplicating logic in each provider.\n\n## Media And Runtime Handling\n\nAdds shared media helpers for inbound media metadata, outbound media\nvalidation, and configured media-size caps. Telegram and WhatsApp both\nuse the common cap handling, while WhatsApp keeps a lower\nprovider-specific cap because its bridge materializes downloads in\nmemory.\n\nThe host and runtime wiring now preserve channel metadata, support\nchannel-specific approval handling, and allow Telegram channel posts\nthrough the same serialized agent execution path as other Talon\nchannels.\n\n## Example App\n\nRefreshes the example app from a WhatsApp-only example into a general\nTalon Docker example. The example now documents running WhatsApp,\nTelegram, or both; adds placeholder-only env settings for Telegram\nallowlists and channel toggles; keeps local secrets in an ignored\n`.env`; and updates the Docker setup so the packaged WhatsApp bridge and\nTalon runtime work together from the same container.\n\n## Review Notes\n\nThe exposure changes are intentionally centralized in the shared channel\nlayer. Provider modules should only declare their env var names and\nprovider-specific requirements, such as Telegram requiring an operator\nID for `self` exposure.\n\nThe example app changes are mostly naming and configuration surface\nupdates so it reflects the new multi-channel Talon host rather than only\nWhatsApp.\n\n---------\n\nSigned-off-by: John Kennedy <65985482+jkennedyvz@users.noreply.github.com>\nCo-authored-by: Deep Agent <agent@deepagents.dev>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>","verified_at":"2026-06-26T18:47:37Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7c87ceca069874db8555705efab3973301baa1cb","html_url":"https://github.com/langchain-ai/deepagents/commit/7c87ceca069874db8555705efab3973301baa1cb","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7c87ceca069874db8555705efab3973301baa1cb/comments","author":{"login":"jkennedyvz","id":65985482,"node_id":"MDQ6VXNlcjY1OTg1NDgy","avatar_url":"https://avatars.githubusercontent.com/u/65985482?v=4","gravatar_id":"","url":"https://api.github.com/users/jkennedyvz","html_url":"https://github.com/jkennedyvz","followers_url":"https://api.github.com/users/jkennedyvz/followers","following_url":"https://api.github.com/users/jkennedyvz/following{/other_user}","gists_url":"https://api.github.com/users/jkennedyvz/gists{/gist_id}","starred_url":"https://api.github.com/users/jkennedyvz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jkennedyvz/subscriptions","organizations_url":"https://api.github.com/users/jkennedyvz/orgs","repos_url":"https://api.github.com/users/jkennedyvz/repos","events_url":"https://api.github.com/users/jkennedyvz/events{/privacy}","received_events_url":"https://api.github.com/users/jkennedyvz/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"426dfad3ea1e453914cb87efa8fc70fb85a9efcb","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/426dfad3ea1e453914cb87efa8fc70fb85a9efcb","html_url":"https://github.com/langchain-ai/deepagents/commit/426dfad3ea1e453914cb87efa8fc70fb85a9efcb"}]},{"sha":"426dfad3ea1e453914cb87efa8fc70fb85a9efcb","node_id":"C_kwDOPTymldoAKDQyNmRmYWQzZWExZTQ1MzkxNGNiODdlZmE4ZmM3MGZiODVhOWVmY2I","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T18:46:04Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T18:46:04Z"},"message":"fix(code): drop duplicate token-request `client_id` under Basic auth (#4323)\n\nFix MCP OAuth login failures with servers that reject a duplicate\n`client_id` under HTTP Basic client authentication (e.g. Pylon).\n\n---\n\nMCP OAuth login fails against servers like Pylon because the MCP Python\nSDK includes `client_id` in the token-request body *and* in the\n`Authorization: Basic` header when `token_endpoint_auth_method ==\n\"client_secret_basic\"`. Such servers reject the duplicate client\nidentity with an `OAuthTokenError`. This wraps `prepare_token_auth` in\n`_ExpiryAwareOAuthClientProvider` to strip the redundant body\n`client_id` only when a Basic header is present (RFC 6749 §2.3.1),\nleaving `client_secret_post`/`none` flows untouched. This replaces the\nmanual token-file workaround of editing `token_endpoint_auth_method` to\n`client_secret_post`.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/122e4418-1b0a-8162-81dc-9d4b7e953de0)\n\n## References\n- Plan:\nhttps://openswe.vercel.app/agents/122e4418-1b0a-8162-81dc-9d4b7e953de0/plan\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"d54f57183d0fabdd67aa4197a846f90e25581eb7","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/d54f57183d0fabdd67aa4197a846f90e25581eb7"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/426dfad3ea1e453914cb87efa8fc70fb85a9efcb","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPsjsCRC1aQ7uu5UhlAAAmVUQAAZ2doNkINd2z2+oAP7PDVK5\ndR7OcDocnKab7NADL1C8ai7tAQAq7IIe9TDeUc3t9y5NCSkdQ6C6a6l7rvNTWCp9\nbaBna2Xr0foithTIgWe77X7EIup651i3fJZY0TA7wzMyneDJxmPHJL6Z9IiD60wk\nBgLo3NXHBPRXyfosdjh1kmGjmGoXOF73sGrmX+h0/emiauiyeFaRavkVT8R0UqGT\nap8LqKqgeTIiV0PyppfOXQezaqlReEtlGSHKFchIy+RWes0JEv0g1XnJNND1XNIB\n52oddq91TT929bcaLSH+moXdI5cQogme/7ZkRAsblqCgyPV0xVzJdegDHFuXkO3G\nJELmVUb9Yk04QyS7nfHkFzerpY/9FVS0zwJeT9CTIyBHOF5S1KDRZ8qTctHhhE2a\n50ibKpB6T2LufDPu23qaG1x64z2Cwjl5CrgUM6S7+48ziuT1rKpcmQWGYT+rVYkT\nNyAdN3IzgudRtybMZ7AfKUFgfwaV06jHc+FSRNXgnfvmqLR58fSFWCU04JFxcmJT\nSTlP1/7+0TkRLemlntmh66CFaG7h/7libF4Akqnba5muCVeJfhdjfyLmopcLLzLF\nwWXVtayjiYfc85I3VO0GAiIeq/oxYfMWu2x+XJ113tvFlNSZRowYb7qutG/sGI5f\nl7In3vM5L2mVNkZD5Bbh\n=qSAd\n-----END PGP SIGNATURE-----\n","payload":"tree d54f57183d0fabdd67aa4197a846f90e25581eb7\nparent 064ea0c6851353d0b0bc347a0758149765688945\nauthor Mason Daugherty <mason@langchain.dev> 1782499564 -0400\ncommitter GitHub <noreply@github.com> 1782499564 -0400\n\nfix(code): drop duplicate token-request `client_id` under Basic auth (#4323)\n\nFix MCP OAuth login failures with servers that reject a duplicate\n`client_id` under HTTP Basic client authentication (e.g. Pylon).\n\n---\n\nMCP OAuth login fails against servers like Pylon because the MCP Python\nSDK includes `client_id` in the token-request body *and* in the\n`Authorization: Basic` header when `token_endpoint_auth_method ==\n\"client_secret_basic\"`. Such servers reject the duplicate client\nidentity with an `OAuthTokenError`. This wraps `prepare_token_auth` in\n`_ExpiryAwareOAuthClientProvider` to strip the redundant body\n`client_id` only when a Basic header is present (RFC 6749 §2.3.1),\nleaving `client_secret_post`/`none` flows untouched. This replaces the\nmanual token-file workaround of editing `token_endpoint_auth_method` to\n`client_secret_post`.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/122e4418-1b0a-8162-81dc-9d4b7e953de0)\n\n## References\n- Plan:\nhttps://openswe.vercel.app/agents/122e4418-1b0a-8162-81dc-9d4b7e953de0/plan\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-26T18:46:04Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/426dfad3ea1e453914cb87efa8fc70fb85a9efcb","html_url":"https://github.com/langchain-ai/deepagents/commit/426dfad3ea1e453914cb87efa8fc70fb85a9efcb","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/426dfad3ea1e453914cb87efa8fc70fb85a9efcb/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"064ea0c6851353d0b0bc347a0758149765688945","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/064ea0c6851353d0b0bc347a0758149765688945","html_url":"https://github.com/langchain-ai/deepagents/commit/064ea0c6851353d0b0bc347a0758149765688945"}]},{"sha":"064ea0c6851353d0b0bc347a0758149765688945","node_id":"C_kwDOPTymldoAKDA2NGVhMGM2ODUxMzUzZDBiMGJjMzQ3YTA3NTgxNDk3NjU2ODg5NDU","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T18:20:43Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T18:20:43Z"},"message":"fix(code): offload `create_model` in server graph factory to unblock Codex (#4324)\n\nFix `Blocking call to os.mkdir` server startup failure when using\n`openai_codex` (ChatGPT) models.\n\n---\n\nThe async langgraph dev server graph factory\n(`server_graph._make_graph`) called `create_model` synchronously on the\nevent loop. For the `openai_codex` provider, `create_model` →\n`build_chat_model` → `provider.get_token()` acquires a cross-process\nfile lock that *unconditionally* calls `os.mkdir` (on every call,\nregardless of token freshness). The dev server runs `blockbuster`, which\nrejects blocking IO on the loop, so graph readiness fails with a 500:\n`Blocking call to os.mkdir`. This made the server unstartable for\nChatGPT/Codex users, and re-running `/auth` did not help because the\n`mkdir` is unconditional. Fix: offload `create_model` via\n`asyncio.to_thread`, matching the existing pattern in\n`configurable_model._apply_overrides_async`.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/2b7c33d3-d7a8-d82b-c254-affd26a14334)\n\n## References\n- Plan:\nhttps://openswe.vercel.app/agents/2b7c33d3-d7a8-d82b-c254-affd26a14334/plan\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"a64248ee76e9b5b9b92c66134268676f562ce1a8","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/a64248ee76e9b5b9b92c66134268676f562ce1a8"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/064ea0c6851353d0b0bc347a0758149765688945","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPsL7CRC1aQ7uu5UhlAAAm+YQACRhRcKwTE20nyjRNzU8TV/v\ng2TsqdalLbmzoVmtk9GKw1qSC48VHOWOaWN9iy8ENg+bja3Tfb3RydSeG+p24I6z\nRaqpnXGzaRlF7lctlR50Ew5X8yFrir3Z56L8C5b3EAnjQOHyaUQGanlaZya1hipG\nPFUrw/VlDicVovv3MNYyS6Axcc0JHfZYcGjijnyxSaBrpPCm6//m4haH1QJPDGh0\nm8ouqIHYUmlfUAoUdCHawE0bQUaEs0+EECarVe5d43gkAGUDAzTFipIEghU+VNk8\niSpCqs+FyTNPTaDGeKc8V6+VJOdzVOBx4Y7AsCWLzZapdnT/X5MuuuQggXY+MKGU\nSOscU/Z50Qw05tG+lPjt5RzkiyBYRY2obcv+b2Hw3EwFW1hpFxEZMGNUCIDWeXa7\nORNKEoRhCpq7tOxFXbkUqXXVMN7Y8Lrkz8PCsGeuEjRr1301MhGJESYO3zj45mvM\nvgdisSAMcTyABdTErm+PYMLTB/6St1TxAl4pgxfVZPWE/bVF8rniqe9lf1SmnGux\nH6BCqhuI+dqKLuTe4Hp4w7b8A4RTmRhKracr2sN48i1+xec/BK5vzQWeCXD7HIYh\n591mRQy8RXPLH4sov9C0TMNedBIrLoQPujitpZVVcl2mQsLbYQZyURRS80x0an4k\ngei+i+euSxW10sNQ+HVn\n=w66c\n-----END PGP SIGNATURE-----\n","payload":"tree a64248ee76e9b5b9b92c66134268676f562ce1a8\nparent b669f37fb08998cfbf983da76f57822215614e7b\nauthor Mason Daugherty <mason@langchain.dev> 1782498043 -0400\ncommitter GitHub <noreply@github.com> 1782498043 -0400\n\nfix(code): offload `create_model` in server graph factory to unblock Codex (#4324)\n\nFix `Blocking call to os.mkdir` server startup failure when using\n`openai_codex` (ChatGPT) models.\n\n---\n\nThe async langgraph dev server graph factory\n(`server_graph._make_graph`) called `create_model` synchronously on the\nevent loop. For the `openai_codex` provider, `create_model` →\n`build_chat_model` → `provider.get_token()` acquires a cross-process\nfile lock that *unconditionally* calls `os.mkdir` (on every call,\nregardless of token freshness). The dev server runs `blockbuster`, which\nrejects blocking IO on the loop, so graph readiness fails with a 500:\n`Blocking call to os.mkdir`. This made the server unstartable for\nChatGPT/Codex users, and re-running `/auth` did not help because the\n`mkdir` is unconditional. Fix: offload `create_model` via\n`asyncio.to_thread`, matching the existing pattern in\n`configurable_model._apply_overrides_async`.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/2b7c33d3-d7a8-d82b-c254-affd26a14334)\n\n## References\n- Plan:\nhttps://openswe.vercel.app/agents/2b7c33d3-d7a8-d82b-c254-affd26a14334/plan\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-26T18:20:44Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/064ea0c6851353d0b0bc347a0758149765688945","html_url":"https://github.com/langchain-ai/deepagents/commit/064ea0c6851353d0b0bc347a0758149765688945","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/064ea0c6851353d0b0bc347a0758149765688945/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ