s/a398382c85ce518ea1b7f365e49df905cdcd498b","html_url":"https://github.com/langchain-ai/deepagents/commit/a398382c85ce518ea1b7f365e49df905cdcd498b"}]},{"sha":"a398382c85ce518ea1b7f365e49df905cdcd498b","node_id":"C_kwDOPTymldoAKGEzOTgzODJjODVjZTUxOGVhMWI3ZjM2NWU0OWRmOTA1Y2RjZDQ5OGI","commit":{"author":{"name":"Alexander Olsen","email":"aolsenjazz@gmail.com","date":"2026-06-25T15:58:38Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-25T15:58:38Z"},"message":"feat(sdk): add Bedrock prompt caching middleware (#4108)\n\nBedrock models now receive `BedrockPromptCachingMiddleware`\nautomatically when `langchain-aws` is installed.\n\nAdds Python SDK parity with\n[deepagentsjs](https://github.com/langchain-ai/deepagentsjs/pull/611) by\nwiring Bedrock prompt caching into main and subagent middleware stacks\nfor AWS Bedrock models.\n\nDocs PR: https://github.com/langchain-ai/docs/pull/4587\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/696a9011-2123-6396-5992-265911c8d2af)\n\n---------\n\nCo-authored-by: Alexander Olsen <13665641+aolsenjazz@users.noreply.github.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>","tree":{"sha":"a0ba5a40c7e21348e65f45c76ac952bd9b79097b","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/a0ba5a40c7e21348e65f45c76ac952bd9b79097b"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/a398382c85ce518ea1b7f365e49df905cdcd498b","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPVAuCRC1aQ7uu5UhlAAA484QAJXhE8In4/fr6osjGTWLhcIe\njzn79ACeDIw9g/w502UlHbk7E3ePhDFWK7W+wz6rsFK6JXWslYh+WB5EISzxDS6p\noFaYrzaqMNhcE2Zma3exSGGhHKU/XY/+W28OQOm1Pz8zksPWSrDE7kjp3cBlisxd\nCmE5C5qAHvpTB01sb+m5FS04o8WCO2ULhaAZqxg78CFq/cN5aL0uSM8/4PCczC6F\nMmWCwYkr2zJF3o/sYtIkMvtmaJl9cwswMJnpvaj6a+uuA8FAJyloYQluzScaX31V\nJ/ajDXbsrl5lZv1Go0EHhXwqhb7JZR8rsjDMroJv5cchogVjwxJg8NqCL66HTvZd\nHuKV/DpmUB/duMGuTJlT9gbv3GhKq2+9Dn2bW0IjoCvTk10iw5/YCT8mbB6M8IY8\nrO6sYxbfMDN9Zx9reFjvoLgxf07yYC7F9VoPkcS9SDpUxTEzGkxN6/DXr6eb3hWp\nxy+QTyHyOZ519lPyu8RwD4+h+kXq72dgWw47m74JzIaHa2HH3YeoXIKnUZAojQEy\ngKo8ut1psqJe/uBSqA1VnkrR7Gwl8UmKbu2zn2Z2NtxlKPl6xLVBwSYREfnoH8XD\nh9yyGPGSTtjf1vJT+1fKc9S4rwSt0g/54CjeX3Pu/yPRlS8mm7CIW2avDGU+nyxM\nDbVdM0Z6kldUok+jGxIf\n=+8Kw\n-----END PGP SIGNATURE-----\n","payload":"tree a0ba5a40c7e21348e65f45c76ac952bd9b79097b\nparent 7db4316e1402e6b6fe517bf7371a695ef9960c5f\nauthor Alexander Olsen <aolsenjazz@gmail.com> 1782403118 -0400\ncommitter GitHub <noreply@github.com> 1782403118 -0400\n\nfeat(sdk): add Bedrock prompt caching middleware (#4108)\n\nBedrock models now receive `BedrockPromptCachingMiddleware`\nautomatically when `langchain-aws` is installed.\n\nAdds Python SDK parity with\n[deepagentsjs](https://github.com/langchain-ai/deepagentsjs/pull/611) by\nwiring Bedrock prompt caching into main and subagent middleware stacks\nfor AWS Bedrock models.\n\nDocs PR: https://github.com/langchain-ai/docs/pull/4587\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/696a9011-2123-6396-5992-265911c8d2af)\n\n---------\n\nCo-authored-by: Alexander Olsen <13665641+aolsenjazz@users.noreply.github.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>","verified_at":"2026-06-25T15:58:38Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a398382c85ce518ea1b7f365e49df905cdcd498b","html_url":"https://github.com/langchain-ai/deepagents/commit/a398382c85ce518ea1b7f365e49df905cdcd498b","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a398382c85ce518ea1b7f365e49df905cdcd498b/comments","author":{"login":"aolsenjazz","id":13665641,"node_id":"MDQ6VXNlcjEzNjY1NjQx","avatar_url":"https://avatars.githubusercontent.com/u/13665641?v=4","gravatar_id":"","url":"https://api.github.com/users/aolsenjazz","html_url":"https://github.com/aolsenjazz","followers_url":"https://api.github.com/users/aolsenjazz/followers","following_url":"https://api.github.com/users/aolsenjazz/following{/other_user}","gists_url":"https://api.github.com/users/aolsenjazz/gists{/gist_id}","starred_url":"https://api.github.com/users/aolsenjazz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aolsenjazz/subscriptions","organizations_url":"https://api.github.com/users/aolsenjazz/orgs","repos_url":"https://api.github.com/users/aolsenjazz/repos","events_url":"https://api.github.com/users/aolsenjazz/events{/privacy}","received_events_url":"https://api.github.com/users/aolsenjazz/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7db4316e1402e6b6fe517bf7371a695ef9960c5f","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7db4316e1402e6b6fe517bf7371a695ef9960c5f","html_url":"https://github.com/langchain-ai/deepagents/commit/7db4316e1402e6b6fe517bf7371a695ef9960c5f"}]},{"sha":"7db4316e1402e6b6fe517bf7371a695ef9960c5f","node_id":"C_kwDOPTymldoAKDdkYjQzMTZlMTQwMmU2YjZmZTUxN2JmNzM3MWE2OTVlZjk5NjBjNWY","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-25T09:44:43Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-25T09:44:43Z"},"message":"ci(repo): fail release guard when a pending release already failed (#4249)\n\nThe `guard-pending-release` job previously had only two outcomes when a\nmerged release PR stayed labeled `autorelease: pending`: wait up to 45\nmin for an in-flight publish, or defer to the next push. A publish that\nhad *already failed* looked identical to one still running, so the guard\nburned the full timeout and then silently deferred — hiding a state that\nactually needs a human. A third fallback now detects that case and fails\nthe job loudly with the failed run links.\n\n## Changes\n- Add a third fallback to `guard-pending-release`: if a merged PR still\ncarries `autorelease: pending` but its matching `release.yml` run has\nalready completed with a failed conclusion\n(`failure`/`cancelled`/`timed_out`/`action_required`/`startup_failure`),\nfail the job (exit 1) with `::error::` annotations and a step summary\npointing the operator at the failed run, instead of waiting out the\ntimeout.\n- Correlate pending PRs to publish runs in new\n`describe_failed_pending_releases`, matching `release.yml` run\n`displayTitle` to the release PR title and taking the most recent run\nper title (so a re-dispatched, now-succeeding release isn't flagged).\n- Split the old `list_pending` into `list_pending_json` +\n`format_pending` so the raw PR JSON can be reused for run matching;\n`poll_pending` now also populates `FAILED_RELEASES`, and both the\ninitial check and the wait loop bail via `fail_failed_releases`.\n- Grant the job `actions: read`, required for `gh run list` to read\npublish-run state.\n- Document the load-bearing coupling: the title match works only because\n`release-please-config.json`'s `pull-request-title-pattern` and\n`release.yml`'s `run-name` render identically — a drift degrades\nfail-open to the existing wait/skip path rather than misfiring.","tree":{"sha":"7807c0d81b7c40d47a9361d4a9d663b5d49e7958","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/7807c0d81b7c40d47a9361d4a9d663b5d49e7958"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/7db4316e1402e6b6fe517bf7371a695ef9960c5f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPPiLCRC1aQ7uu5UhlAAAOk4QAFld/ODtupSOEf903WHOfzDP\ntZkZr+RWbPaE7STe18I1xTB5Hw4vXxcwoR5r0yWBSdPOf57yaDA413YcixgUbUWJ\n5VocCgjTorInyxASnRx881PkcBQes+V5wyo3IqVGpPkwtJezXxCMnbyYq/D5GU4X\nVPTfjAT37qxHptM1RFLEtsATtOqXWbYdP8MHTVbD59czt9U1lC6R/zPle9F9B/uw\nKz9nLQkm2y1IEJkLgu50TfiqFPqMOkDFXiFMI0CAxqhpi4ynrkoI46gLu/l3ydmV\nhYwrw/A7CzI2XOzRbNejQEW9+UY4mPTp1Ev9lq8zyd6hKJVsjKkZM+pElME+t+kn\nRZtJi/ud0XvyfS+3WtNTdVY02ihY8lC1Oo6PxJlAwunfk4q1IxE1ptbsxy21R0ML\noxERxpOdT5TWygT30Vq2MYkr+dMYy76UvfMsN5RONC49gNYONG6Anq+cE3ScJUso\nrzMpPVw+467fZW5iAIa7xSOC3guv0YWGQXVUDKLTzYSeMYN23rebaoYDh3qJcLrg\nYpBz3a7jr7V4GxsOQGko6aXdgzXv7VT87/D8i0dDdN+p5b+7nBVYFNdS7L4WDBUY\nFI+omtMtFFPoOfvKSO6m0F2nM6leyHA2tQEQz1onCzqNmPai+k0JGWQh1tkKX7kM\nm53cJ24JaYOHT4giEBqz\n=WhcT\n-----END PGP SIGNATURE-----\n","payload":"tree 7807c0d81b7c40d47a9361d4a9d663b5d49e7958\nparent 96caad4c69c6aab5d0caa7630cb1ef0577689950\nauthor Mason Daugherty <mason@langchain.dev> 1782380683 -0400\ncommitter GitHub <noreply@github.com> 1782380683 -0400\n\nci(repo): fail release guard when a pending release already failed (#4249)\n\nThe `guard-pending-release` job previously had only two outcomes when a\nmerged release PR stayed labeled `autorelease: pending`: wait up to 45\nmin for an in-flight publish, or defer to the next push. A publish that\nhad *already failed* looked identical to one still running, so the guard\nburned the full timeout and then silently deferred — hiding a state that\nactually needs a human. A third fallback now detects that case and fails\nthe job loudly with the failed run links.\n\n## Changes\n- Add a third fallback to `guard-pending-release`: if a merged PR still\ncarries `autorelease: pending` but its matching `release.yml` run has\nalready completed with a failed conclusion\n(`failure`/`cancelled`/`timed_out`/`action_required`/`startup_failure`),\nfail the job (exit 1) with `::error::` annotations and a step summary\npointing the operator at the failed run, instead of waiting out the\ntimeout.\n- Correlate pending PRs to publish runs in new\n`describe_failed_pending_releases`, matching `release.yml` run\n`displayTitle` to the release PR title and taking the most recent run\nper title (so a re-dispatched, now-succeeding release isn't flagged).\n- Split the old `list_pending` into `list_pending_json` +\n`format_pending` so the raw PR JSON can be reused for run matching;\n`poll_pending` now also populates `FAILED_RELEASES`, and both the\ninitial check and the wait loop bail via `fail_failed_releases`.\n- Grant the job `actions: read`, required for `gh run list` to read\npublish-run state.\n- Document the load-bearing coupling: the title match works only because\n`release-please-config.json`'s `pull-request-title-pattern` and\n`release.yml`'s `run-name` render identically — a drift degrades\nfail-open to the existing wait/skip path rather than misfiring.","verified_at":"2026-06-25T09:44:43Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7db4316e1402e6b6fe517bf7371a695ef9960c5f","html_url":"https://github.com/langchain-ai/deepagents/commit/7db4316e1402e6b6fe517bf7371a695ef9960c5f","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7db4316e1402e6b6fe517bf7371a695ef9960c5f/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_u