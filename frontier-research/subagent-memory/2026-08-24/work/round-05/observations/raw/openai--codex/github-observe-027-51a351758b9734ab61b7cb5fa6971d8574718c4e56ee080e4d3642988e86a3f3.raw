ZVJVmR5d9j47Fie98cXjlMJskZHfiBVs893nyRA89ygdBHHzBqvuPveZiX\n9J4TXw6qjwof5HnHgovg\n=yFv/\n-----END PGP SIGNATURE-----\n","payload":"tree 83db7366c40c7b5ab947bbb432e4d00889416cb8\nparent 5a56caf18cb773b3d1c60e66d594e9512c7f18e7\nauthor David de Regt <ddr@openai.com> 1781227396 -0700\ncommitter GitHub <noreply@github.com> 1781227396 -0700\n\nfix: Recover from sqlite directory being a file (#27719)\n\nMissed this file in the last PR -- this ensures that if you're in the\nreally-weird edge case of your sqlite directory being a file, that it\nwill fix it and recover properly.","verified_at":"2026-06-12T01:23:16Z"}},"url":"https://api.github.com/repos/openai/codex/commits/69b0f52b2a728d71f4800793c6c069956a91a2f8","html_url":"https://github.com/openai/codex/commit/69b0f52b2a728d71f4800793c6c069956a91a2f8","comments_url":"https://api.github.com/repos/openai/codex/commits/69b0f52b2a728d71f4800793c6c069956a91a2f8/comments","author":{"login":"ddr-oai","id":248761566,"node_id":"U_kgDODtPM3g","avatar_url":"https://avatars.githubusercontent.com/u/248761566?v=4","gravatar_id":"","url":"https://api.github.com/users/ddr-oai","html_url":"https://github.com/ddr-oai","followers_url":"https://api.github.com/users/ddr-oai/followers","following_url":"https://api.github.com/users/ddr-oai/following{/other_user}","gists_url":"https://api.github.com/users/ddr-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/ddr-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ddr-oai/subscriptions","organizations_url":"https://api.github.com/users/ddr-oai/orgs","repos_url":"https://api.github.com/users/ddr-oai/repos","events_url":"https://api.github.com/users/ddr-oai/events{/privacy}","received_events_url":"https://api.github.com/users/ddr-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"5a56caf18cb773b3d1c60e66d594e9512c7f18e7","url":"https://api.github.com/repos/openai/codex/commits/5a56caf18cb773b3d1c60e66d594e9512c7f18e7","html_url":"https://github.com/openai/codex/commit/5a56caf18cb773b3d1c60e66d594e9512c7f18e7"}]},{"sha":"5a56caf18cb773b3d1c60e66d594e9512c7f18e7","node_id":"C_kwDOOYsS4doAKDVhNTZjYWYxOGNiNzczYjNkMWM2MGU2NmQ1OTRlOTUxMmM3ZjE4ZTc","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-12T01:16:39Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T01:16:39Z"},"message":"[codex] Remove async_trait from first-party code (#27475)\n\n## Why\n\nFirst-party async traits should expose their `Send` contracts explicitly\nwithout requiring `async_trait`. This completes the migration pattern\nestablished in #27303 and #27304.\n\n## What changed\n\n- Replaced the remaining first-party `async_trait` traits with native\nreturn-position `impl Future + Send` where statically dispatched and\nexplicit boxed `Send` futures where object safety is required.\n- Kept implementations behavior-preserving, outlining existing async\nbodies into inherent methods where that keeps the diff reviewable.\n- Removed all direct first-party `async-trait` dependencies and the\nworkspace dependency declaration.\n- Added a cargo-deny policy that permits `async-trait` only through the\nremaining transitive wrapper crates.\n- Updated `rand` from 0.8.5 to 0.8.6 to resolve RUSTSEC-2026-0097 and\nkeep the full cargo-deny check passing.\n\n## Validation\n\n- `just test -p codex-exec-server`: 216 passed, 2 skipped.\n- `just test -p codex-model-provider`: 39 passed.\n- `just test -p codex-core` and `just test`: changed tests passed;\nremaining failures are environment-sensitive suites unrelated to this\nmigration.\n- `cargo deny check`\n- `just fix`\n- `just fmt`\n- `cargo shear`\n- `just bazel-lock-check`","tree":{"sha":"ee87793513349868cd817b6532fbe7273f22d720","url":"https://api.github.com/repos/openai/codex/git/trees/ee87793513349868cd817b6532fbe7273f22d720"},"url":"https://api.github.com/repos/openai/codex/git/commits/5a56caf18cb773b3d1c60e66d594e9512c7f18e7","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK133CRC1aQ7uu5UhlAAA5NMQAFNFio1aYE45M8tPs/cVZJZN\nxpGhNi27S2uBQqhLCu7RUQV/eBntl/Uf8yuwjCidha8Lf9b/IN4AVBS+/tV+wXqH\nkOW97+xOKG53pmkumBB+0zgwl+X87YsfCY4GV46vjLsLwso9mWkmcmX10/QSuRAh\nCkpfmglRVvZRuDzgJqrYeNqUUs7X0b6RlIo9eirwmbiy/eadsi48h804s5WojocE\nxHc/zs5u3o0DgTUJFr+j/upjJ6NM88606WRK8rxDEywInsCZxOsrR7cDUR8C+GJ4\n7LqbUKHgFIvnG22Ehwk+rh+Vrv1Lnb2nkJ+Fv7W0orrzZtkF8GDkd6enAXcuwN+4\nrni8UGsZPIfED+CK41aRcfjqsWn/+yIeRdSbXecYrs+B1Mr3x2PoWwVWMImwG2q0\n0D4gttOaaIMEEmUVd10QYkkccn0IslmL35ZWQZIPr0IORgomCWAsXoUX8JP2Q9sU\nM3Lq5+FZHiKJ2usJtKrBrpxLT7hm6RB7v/KQbmha2N6SDsBOgUfURyqN2M9kB9Fk\ngg4+fz+P9/RB0jz5+PvI+mJMTyyqvHzq9u2MhpX0smHSbKv0vEHIcptyTPoZY6Ul\n9DkxtP1OcZY+86FDlGWmdIDHVNCOEwZN4MlOAHy2KatsLAY7zcPPykhylkeeKF7p\n9dJwgSH66qp01VSO5oYO\n=b3F/\n-----END PGP SIGNATURE-----\n","payload":"tree ee87793513349868cd817b6532fbe7273f22d720\nparent 1829ed11228d9ffad6bf7d6db615324126065b23\nauthor Adam Perry @ OpenAI <anp@openai.com> 1781226999 -0700\ncommitter GitHub <noreply@github.com> 1781226999 -0700\n\n[codex] Remove async_trait from first-party code (#27475)\n\n## Why\n\nFirst-party async traits should expose their `Send` contracts explicitly\nwithout requiring `async_trait`. This completes the migration pattern\nestablished in #27303 and #27304.\n\n## What changed\n\n- Replaced the remaining first-party `async_trait` traits with native\nreturn-position `impl Future + Send` where statically dispatched and\nexplicit boxed `Send` futures where object safety is required.\n- Kept implementations behavior-preserving, outlining existing async\nbodies into inherent methods where that keeps the diff reviewable.\n- Removed all direct first-party `async-trait` dependencies and the\nworkspace dependency declaration.\n- Added a cargo-deny policy that permits `async-trait` only through the\nremaining transitive wrapper crates.\n- Updated `rand` from 0.8.5 to 0.8.6 to resolve RUSTSEC-2026-0097 and\nkeep the full cargo-deny check passing.\n\n## Validation\n\n- `just test -p codex-exec-server`: 216 passed, 2 skipped.\n- `just test -p codex-model-provider`: 39 passed.\n- `just test -p codex-core` and `just test`: changed tests passed;\nremaining failures are environment-sensitive suites unrelated to this\nmigration.\n- `cargo deny check`\n- `just fix`\n- `just fmt`\n- `cargo shear`\n- `just bazel-lock-check`","verified_at":"2026-06-12T01:16:40Z"}},"url":"https://api.github.com/repos/openai/codex/commits/5a56caf18cb773b3d1c60e66d594e9512c7f18e7","html_url":"https://github.com/openai/codex/commit/5a56caf18cb773b3d1c60e66d594e9512c7f18e7","comments_url":"https://api.github.com/repos/openai/codex/commits/5a56caf18cb773b3d1c60e66d594e9512c7f18e7/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"1829ed11228d9ffad6bf7d6db615324126065b23","url":"https://api.github.com/repos/openai/codex/commits/1829ed11228d9ffad6bf7d6db615324126065b23","html_url":"https://github.com/openai/codex/commit/1829ed11228d9ffad6bf7d6db615324126065b23"}]},{"sha":"1829ed11228d9ffad6bf7d6db615324126065b23","node_id":"C_kwDOOYsS4doAKDE4MjllZDExMjI4ZDlmZmFkNmJmN2Q2ZGI2MTUzMjQxMjYwNjViMjM","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-12T00:15:19Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T00:15:19Z"},"message":"Fix image extension PathUri conversion (#27711)\n\n## Why\n\n`main` stopped compiling when #27498 passed an `AbsolutePathBuf` to the\n`ExecutorFileSystem` API migrated to `PathUri` by #27653.\n\n## What\n\nConvert referenced image paths to `PathUri` before filesystem reads,\ndeclare the internal path-URI dependency, and refresh `Cargo.lock`.","tree":{"sha":"118cb99901bb6278afc7180b15743fcb1766b873","url":"https://api.github.com/repos/openai/codex/git/trees/118cb99901bb6278afc7180b15743fcb1766b873"},"url":"https://api.github.com/repos/openai/codex/git/commits/1829ed11228d9ffad6bf7d6db615324126065b23","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK0+XCRC1aQ7uu5UhlAAAYI8QAKf08s+oCjdKhctSLLz9lF5r\nztXlFArYPNoXz5K46+rfla1vEKIsVyTyTuoahLYNwEItKwPTT1jO0GjM1KXSMtvI\nBNBuvQqNO/nTBDqncjXd5ETo9AGUrvGikboGG16ePb/rU5Ol3FK75/bIQMZlDF4k\ndgphS4jnwyBqtBHWYwhUebT3tj4zp85syO4SY8iX3uWAnyv+bCli2D0qgvytiP3G\nINIt7PePzPxXVylZ173kcb/L9IU09pyUesEK0ETVV7iRciciHxUr9vwslYF71ay6\n7vgjLsbQCJbreJrxIw8rCiuJXLfewOFa50kR/IhEO/EWIsfhWc2LHXiwFtJQ0E7C\nYY7dAl6lxZwFZqI4yvlZDRQ62VM3fP9zrgAICWffe/x16KpYq3aNAlj+LAGNM+Vs\nTdFfpD5RZt+XFUEwNqRtDLf4C2M+WGQ4dJeGXaT0GWH8JKkH+UeeqpkYBJ+1+/dM\n4Qga1Gf0cyVaa2yXrfSYF21OAyYrD81fN60TIplD2uElfQ9ZnqD2uCfog0YgHysj\nTonGRH541sacfF0sba3xjUK/DQaAxXoSfIulpUKiUpA2kVgL8TREoQn5r0FOZzhF\nsBwy8YIvMj7k59LF7XteLzzm+Qr0MlGg5HWvUvBiMg8/zF7v9QCfHFLRTL7G/Rm4\ndA08JChHtYt/gf/M3zSC\n=TYL0\n-----END PGP SIGNATURE-----\n","payload":"tree 118cb99901bb6278afc7180b15743fcb1766b873\nparent 44403dd3ddff55753af49dd9eba1351c28dc256a\nauthor Adam Perry @ OpenAI <anp@openai.com> 1781223319 -0700\ncommitter GitHub <noreply@github.com> 1781223319 +0000\n\nFix image extension PathUri conversion (#27711)\n\n## Why\n\n`main` stopped compiling when #27498 passed an `AbsolutePathBuf` to the\n`ExecutorFileSystem` API migrated to `PathUri` by #27653.\n\n## What\n\nConvert referenced image paths to `PathUri` before filesystem reads,\ndeclare the internal path-URI dependency, and refresh `Cargo.lock`.","verified_at":"2026-06-12T00:15:20Z"}},"url":"https://api.github.com/repos/openai/codex/commits/1829ed11228d9ffad6bf7d6db615324126065b23","html_url":"https://github.com/openai/codex/commit/1829ed11228d9ffad6bf7d6db615324126065b23","comments_url":"https://api.github.com/repos/openai/codex/commits/1829ed11228d9ffad6bf7d6db615324126065b23/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"44403dd3ddff55753af49dd9eba1351c28dc256a","url":"https://api.github.com/repos/openai/codex/commits/44403dd3ddff55753af49dd9eba1351c28dc256a","html_url":"https://github.com/openai/codex/commit/44403dd3ddff55753af49dd9eba1351c28dc256a"}]},{"sha":"44403dd3ddff55753af49dd9eba1351c28dc256a","node_id":"C_kwDOOYsS4doAKDQ0NDAzZGQzZGRmZjU1NzUzYWY0OWRkOWViYTEzNTFjMjhkYzI1NmE","commit":{"author":{"name":"Mitsuhiro Kotake","email":"kotakem@openai.com","date":"2026-06-12T00:15:04Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T00:15:04Z"},"message":"tui: clear stale hook row after turn completion (#27619)\n\nFixes #27210.\n\n## Why\nWhen the app server reports a visible `HookStarted` event for a\n`PostToolUse` hook but the turn reaches `TurnCompleted` before a\nmatching hook completion event arrives, the TUI can leave the transient\n`Running PostToolUse hook` row visible after the agent is done.\nInterrupted and failed turn cleanup already drops transient live hook\nrows; the normal completion path did not.\n\n## What Changed\n- Added `ChatWidget::clear_active_hook_cell()` for dropping transient\nlive hook status without writing it to history.\n- Call that cleanup from normal task completion, while reusing it for\nthe existing start/finalize cleanup paths.\n- Added `completed_turn_clears_visible_running_hook` snapshot coverage\nfor the reported `PostToolUse` case.\n\n## Tests\n- `just test -p codex-tui completed_turn_clears_visible_running_hook`\n- `just test -p codex-tui` (fails on current `main` in unrelated\nguardian tests:\n`update_feature_flags_disabling_guardian_clears_review_policy_and_restores_default`\nand\n`update_feature_flags_disabling_guardian_clears_manual_review_policy_without_history`)","tree":{"sha":"ad5945b796a6d40d0df55e23f1d8b71045a34fa4","url":"https://api.github.com/repos/openai/codex/git/trees/ad5945b796a6d40d0df55e23f1d8b71045a34fa4"},"url":"https://api.github.com/repos/openai/codex/git/commits/44403dd3ddff55753af49dd9eba1351c28dc256a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK0+ICRC1aQ7uu5UhlAAA+wIQACQF1iuev1oqUnLgt13p8lVt\n4L0D+AJ0hPUmTO+1AIF3p4qY0joU44eck+XF3wOsxQG9W3lhvBx/lre5NBWf141o\nFtXzWdZygWBhP2LIAiie5EQs+/ItxeCTEMZKDAkhM4/jqBwfFWI707CMNnXRL/53\n0uQMtG6gWfzonMUVmQSYlM53EL4A8PvvIfZTDo0nDrZipoi6HrZjX9rKfOkpGinW\nohBlaK1LfNGpQoA4Gj94xP2kKR/46W7b5WRildqRiwWfhb18SjuRTpKNTaBzwsJy\n6U/T+3Qtt+AT/4GZlutGm4OXHE0rMWoz57A/ImT5eMYvR3+Y9qDTt/BGgL/MHBXi\nRVgeHOl2ZS9A8mpDlpdO8sWjzv3id988ty063jeSLFH6vRmfB/kxaQ6RJqS9lgxA\npY1nlgBxgYm/kkpen4NLYnXrnHAr1WEsblaUeNG8bLXn5cBFHwjiDeW9WySaSm4X\nyk1Hhd9evdKa3PPa6Toa0sbRk761Z9EVfABGaVbrpFlHjwr8GbjglRo6UyjUTREf\nqmaq/9EHcF46/WAjvnHfBwxkGPus63aPEVokSzgDx+D3duPoVx6GooTBL3MTpMs/\nr2+o3J0uHy6fImHvCnQbIBOdSy/03eBe5CZHKdQx5WM2LzyRMwTUSm4yI2HGtF6S\nzo3g+M2aBNBkE5G6mjwz\n=lN0o\n-----END PGP SIGNATURE-----\n","payload":"tree ad5945b796a6d40d0df55e23f1d8b71045a34fa4\nparent 92d90369108daefad443183379a55357e8448b1a\nauthor Mitsuhiro Kotake <kotakem@openai.com> 1781223304 +0900\ncommitter GitHub <noreply@github.com> 1781223304 +0900\n\ntui: clear stale hook row after turn completion (#27619)\n\nFixes #27210.\n\n## Why\nWhen the app server reports a visible `HookStarted` event for a\n`PostToolUse` hook but the turn reaches `TurnCompleted` before a\nmatching hook completion event arrives, the TUI can leave the transient\n`Running PostToolUse hook` row visible after the agent is done.\nInterrupted and failed turn cleanup already drops transient live hook\nrows; the normal completion path did not.\n\n## What Changed\n- Added `ChatWidget::clear_active_hook_cell()` for dropping transient\nlive hook status without writing it to history.\n- Call that cleanup from normal task completion, while reusing it for\nthe existing start/finalize cleanup paths.\n- Added `completed_turn_clears_visible_running_hook` snapshot coverage\nfor the reported `PostToolUse` case.\n\n## Tests\n- `just test -p codex-tui completed_turn_clears_visible_running_hook`\n- `just test -p codex-tui` (fails on current `main` in unrelated\nguardian tests:\n`update_feature_flags_disabling_guardian_clears_review_policy_and_restores_default`\nand\n`update_feature_flags_disabling_guardian_clears_manual_review_policy_without_history`)","verified_at":"2026-06-12T00:15:05Z"}},"url":"https://api.github.com/repos/openai/codex/commits/44403dd3ddff55753af49dd9eba1351c28dc256a","html_url":"https://github.com/openai/codex/commit/44403dd3ddff55753af49dd9eba1351c28dc256a","comments_url":"https://api.github.com/repos/openai/codex/commits/44403dd3ddff55753af49dd9eba1351c28dc256a/comments","author":{"login":"kotakem-openai","id":236717381,"node_id":"U_kgDODhwFRQ","avatar_url":"https://avatars.githubusercontent.com/u/236717381?v=4","gravatar_id":"","url":"https://api.github.com/users/kotakem-openai","html_url":"https://github.com/kotakem-openai","followers_url":"https://api.github.com/users/kotakem-openai/followers","following_url":"https://api.github.com/users/kotakem-openai/following{/other_user}","gists_url":"https://api.github.com/users/kotakem-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/kotakem-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kotakem-openai/subscriptions","organizations_url":"https://api.github.com/users/kotakem-openai/orgs","repos_url":"https://api.github.com/users/kotakem-openai/repos","events_url":"https://api.github.com/users/kotakem-openai/events{/privacy}","received_events_url":"https://api.github.com/users/kotakem-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"92d90369108daefad443183379a55357e8448b1a","url":"https://api.github.com/repos/openai/codex/commits/92d90369108daefad443183379a55357e8448b1a","html_url":"https://github.com/openai/codex/commit/92d90369108daefad443183379a55357e8448b1a"}]},{"sha":"92d90369108daefad443183379a55357e8448b1a","node_id":"C_kwDOOYsS4doAKDkyZDkwMzY5MTA4ZGFlZmFkNDQzMTgzMzc5YTU1MzU3ZTg0NDhiMWE","commit":{"author":{"name":"mchen-oai","email":"mchen@openai.com","date":"2026-06-11T23:55:01Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-11T23:55:01Z"},"message":"Add spans to turn lifecycle gaps (#27623)\n\n## Why\nCodex app-server latency traces do not granularly cover turn task\nstartup and inter-request handoffs. These spans help attribute time\nacross task execution, startup prewarm, in-flight tool completion, and\nrollout persistence.\n\n## What changed\n- Add `session_task.run` spans around task execution and\n`session_task.flush_rollout` around flushing pending conversation\ntranscript writes to durable storage\n- Add `regular_task.prepare_run_turn` around regular-turn startup (Send\nthe `TurnStarted` event, reset turn-specific reasoning state, and\nresolve any startup prewarm)\n- Add `startup_prewarm.resolve` around waiting for background session\nprewarming to finish, fail, time out, or be cancelled\n- Add a function-level trace span around draining in-flight tool calls\n(Wait for tool calls to complete, record tool result in conversation\nhistory, and other bookkeeping)\n\n## Verification\nTrigger Codex rollout and observe new spans are included","tree":{"sha":"019b740407b9134e32c939c18fa8ee327254feec","url":"https://api.github.com/repos/openai/codex/git/trees/019b740407b9134e32c939c18fa8ee327254feec"},"url":"https://api.github.com/repos/openai/codex/git/commits/92d90369108daefad443183379a55357e8448b1a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK0rVCRC1aQ7uu5UhlAAAy8YQACq9BynA8eUrVr7tMEYeGtdy\nxhnlVXk8B7PvkGLkRQOtvA+JwyyWGSV8CwkP2WvunoWu5zhGOhqZe2m3jUhSS3cp\nrJTg9t9y65ELXclUTS2saMNLD2cA8yTFCiyroAq/WW8lGTBx1finKRfyp6dtIFnX\n3x38xAr03cScLwnDjkV/xZMQF3erghEAQWdVgxr6pM7+A49f5S7l5fGa7Ap7fsq/\nX4D24pOtHrpGPxRYnXpV8WkLZIefMqUwEjjN1vEOygvuw155QBcHxGIv8DWcd2QC\nuU/veHOHzJgQKM1BSIN1rlZbJgc2ixl6dNnVBPVS5plORGJGY0lEHLwS4fJqk76z\nUWwTg2J6ZOFDP8HDjpRLO3LA4TfuIusQ7Oh9W0JlwAe6Iam/GmHrhdaWatHdasU2\npKXqCCmSDDHRCINkqC+VkyQvZB5wEhh1Vf7eexNj1fPpbrdV2O915ZmC7APTmncl\nHaHkRSDOvMGvYVPcrLaqvf51/wCusrV5Syo6rtH9EWF1hig2iBpyHIbkdYCoK0wE\nHd7eQyQGP9fF0dzP24cJAyHzmJAae2JnJnqmwsnMoZFF+wK69YHRqy5HDrvfhvJN\nOHtAfCh8G2UQntFZwymT+mf8tsOz4ZtbHpb2kupc9lAD8Ep38zpobGZHTmRRd315\nzv6wOnk1uYm7SSLKaURh\n=S84l\n-----END PGP SIGNATURE-----\n","payload":"tree 019b740407b9134e32c939c18fa8ee327254feec\nparent 19ce6394af86b5e721f648cb9b68e52c2cb1f1ea\nauthor mchen-oai <mchen@openai.com> 1781222101 -0700\ncommitter GitHub <noreply@github.com> 1781222101 -0700\n\nAdd spans to turn lifecycle gaps (#27623)\n\n## Why\nCodex app-server latency traces do not granularly cover turn task\nstartup and inter-request handoffs. These spans help attribute time\nacross task execution, startup prewarm, in-flight tool completion, and\nrollout persistence.\n\n## What changed\n- Add `session_task.run` spans around task execution and\n`session_task.flush_rollout` around flushing pending conversation\ntranscript writes to durable storage\n- Add `regular_task.prepare_run_turn` around regular-turn startup (Send\nthe `TurnStarted` event, reset turn-specific reasoning state, and\nresolve any startup prewarm)\n- Add `startup_prewarm.resolve` around waiting for background session\nprewarming to finish, fail, time out, or be cancelled\n- Add a function-level trace span around draining in-flight tool calls\n(Wait for tool calls to complete, record tool result in conversation\nhistory, and other bookkeeping)\n\n## Verification\nTrigger Codex rollout and observe new spans are included","verified_at":"2026-06-11T23:55:01Z"}},"url":"https://api.github.com/repos/openai/codex/commits/92d90369108daefad443183379a55357e8448b1a","html_url":"https://github.com/openai/codex/commit/92d90369108daefad443183379a55357e8448b1a","comments_url":"https://api.github.com/repos/openai/codex/commits/92d90369108daefad443183379a55357e8448b1a/comments","author":{"login":"mchen-oai","id":250037145,"node_id":"U_kgDODudDmQ","avatar_url":"https://avatars.githubusercontent.com/u/250037145?v=4","gravatar_id":"","url":"https://api.github.com/users/mchen-oai","html_url":"https://github.com/mchen-oai","followers_url":"https://api.github.com/users/mchen-oai/followers","following_url":"https://api.github.com/users/mchen-oai/following{/other_user}","gists_url":"https://api.github.com/users/mchen-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/mchen-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mchen-oai/subscriptions","organizations_url":"https://api.github.com/users/mchen-oai/orgs","repos_url":"https://api.github.com/users/mchen-oai/repos","events_url":"https://api.github.com/users/mchen-oai/events{/privacy}","received_events_url":"https://api.github.com/users/mchen-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"19ce6394af86b5e721f648cb9b68e52c2cb1f1ea","url":"https://api.github.com/repos/openai/codex/commits/19ce6394af86b5e721f648cb9b68e52c2cb1f1ea","html_url":"https://github.com/openai/codex/commit/19ce6394af86b5e721f648cb9b68e52c2cb1f1ea"}]},{"sha":"19ce6394af86b5e721f648cb9b68e52c2cb1f1ea","node_id":"C_kwDOOYsS4doAKDE5Y2U2Mzk0YWY4NmI1ZTcyMWY2NDhjYjliNjhlNTJjMmNiMWYxZWE","commit":{"author":{"name":"Won Park","email":"won@openai.com","date":"2026-06-11T23:32:52Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-11T23:32:52Z"},"message":"Route image extension reads through turn environments v2 (#27498)\n\n## Why\n\nImage generation used `std::fs::read` for referenced image paths, which\ndid not support environment-backed filesystems or their sandbox context.\n\n## What changed\n\n- Expose optional turn environments to extension tool calls.\n- Include each environment’s ID, working directory, filesystem, and\nsandbox context.\n- Read referenced images through the selected environment filesystem.\n- Keep sandbox usage at the extension call site so extensions can choose\nthe appropriate access mode.\n- Consolidate image request construction into one async function.\n- Add coverage for successful environment reads and read failures.\n\n## Validation\n\n- `cargo check -p codex-image-generation-extension --tests`\n- `just fmt`\n- `just bazel-lock-update`\n- `just bazel-lock-check`\n\n`just test -p codex-image-generation-extension` could not complete\nbecause the build exhausted available disk space.","tree":{"sha":"2001aa6ba4937b633df2fae36e1286b4be0b64d3","url":"https://api.github.com/repos/openai/codex/git/trees/2001aa6ba4937b633df2fae36e1286b4be0b64d3"},"url":"https://api.github.com/repos/openai/codex/git/commits/19ce6394af86b5e721f648cb9b68e52c2cb1f1ea","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK0WkCRC1aQ7uu5UhlAAAQj8QAIVwyUXHAunx66e2tMHgMZMS\nSHr/90bGg8jFEHo33q8WyXNrlfyUW3SZ/Xhk7E97/VYHs1PiMogrNM3GIfCxXCR+\n+rrTtevNv9uwMfH3djsgNT21YW/PwX61GtPR1SEew9gWRIlt7QImPtmHam40nYWi\nIxZ+HYAt2l5NN+57VGM5p8jZ2IRZ7ikeKiJyyMlqNE1OLp+KMCQ/5ycd6NTvX+pt\nLjcIlV2sUbUmjGbtQzcwSuK3kGIgACFotgbCs248O1dHGYjzNS78sHRhogar6Krh\nOY30u7S8bR5zwAS1CO9XiFQ+LBTOqpLnYH+MARE4oWhRMd17VfVFi8WPUCx+0xb6\n8QlhesmD04NbKLKoU6O7bHtvV1TSCli8a1CBx47wvmJubgb9kzpDdMM9VeExWyPe\nIcXCQ9I5u0OXuDH+YKbmNBvlJuWQgOBU4xuHlIGZ+8ebJIsSUhnK1AJzkwId3/Zq\n+satwwZ0MDAm72/a3+CjnuCNeCWsGjBI0aNAKETkydURLvEyjyvZ9CIYxap0W8Wa\nGdvxmxkehyj2WWySwrqZ3KHryMOSZBNIeKHnju9nTAKpkbzd/VoBR5s0qgGuidF0\nNJrrSUCjb7mquujp1oi1UbnmcpIIsQIOvXmUsgC1bEx04Xsh+v63wzk2fK0TeEIH\nynhWKVVKClpqq0xCbf4Q\n=osyi\n-----END PGP SIGNATURE-----\n","payload":"tree 2001aa6ba4937b633df2fae36e1286b4be0b64d3\nparent b2cc01fc7ca1a05bb9774121f40086aab87275fc\nauthor Won Park <won@openai.com> 1781220772 -0700\ncommitter GitHub <noreply@github.com> 1781220772 -0700\n\nRoute image extension reads through turn environments v2 (#27498)\n\n## Why\n\nImage generation used `std::fs::read` for referenced image paths, which\ndid not support environment-backed filesystems or their sandbox context.\n\n## What changed\n\n- Expose optional turn environments to extension tool calls.\n- Include each environment’s ID, working directory, filesystem, and\nsandbox context.\n- Read referenced images through the selected environment filesystem.\n- Keep sandbox usage at the extension call site so extensions can choose\nthe appropriate access mode.\n- Consolidate image request construction into one async function.\n- Add coverage for successful environment reads and read failures.\n\n## Validation\n\n- `cargo check -p codex-image-generation-extension --tests`\n- `just fmt`\n- `just bazel-lock-update`\n- `just bazel-lock-check`\n\n`just test -p codex-image-generation-extension` could not complete\nbecause the build exhausted available disk space.","verified_at":"2026-06-11T23:32:52Z"}},"url":"https://api.github.com/repos/openai/codex/commits/19ce6394af86b5e721f648cb9b68e52c2cb1f1ea","html_url":"https://github.com/openai/codex/commit/19ce6394af86b5e721f648cb9b68e52c2cb1f1ea","comments_url":"https://api.github.com/repos/openai/codex/commits/19ce6394af86b5e721f648cb9b68e52c2cb1f1ea/comments","author":{"login":"won-openai","id":262224683,"node_id":"U_kgDOD6E7Kw","avatar_url":"https://avatars.githubusercontent.com/u/262224683?v=4","gravatar_id":"","url":"https://api.github.com/users/won-openai","html_url":"https://github.com/won-openai","followers_url":"https://api.github.com/users/won-openai/followers","following_url":"https://api.github.com/users/won-openai/following{/other_user}","gists_url":"https://api.github.com/users/won-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/won-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/won-openai/subscriptions","organizations_url":"https://api.github.com/users/won-openai/orgs","repos_url":"https://api.github.com/users/won-openai/repos","events_url":"https://api.github.com/users/won-openai/events{/privacy}","received_events_url":"https://api.github.com/users/won-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b2cc01fc7ca1a05bb9774121f40086aab87275fc","url":"https://api.github.com/repos/openai/codex/commits/b2cc01fc7ca1a05bb9774121f40086aab87275fc","html_url":"https://github.com/openai/codex/commit/b2cc01fc7ca1a05bb9774121f40086aab87275fc"}]},{"sha":"b2cc01fc7ca1a05bb9774121f40086aab87275fc","node_id":"C_kwDOOYsS4doAKGIyY2MwMWZjN2NhMWEwNWJiOTc3NDEyMWY0MDA4NmFhYjg3Mjc1ZmM","commit":{"author":{"name":"Tom","email":"wiltzius@openai.com","date":"2026-06-11T23:24:12Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-11T23:24:12Z"},"message":"[codex] Move persistence policy application into ThreadStore (#27318)\n\nMove the application of the persistence policy into the thread store, so\nthread stores can get raw append items rather than canonical append\nitems. This will enable store-specific projections over the raw input\nitems.","tree":{"sha":"bd0dd3d3e6ad6da973c0c3c5817700cae0ef0b0e","url":"https://api.github.com/repos/openai/codex/git/trees/bd0dd3d3e6ad6da973c0c3c5817700cae0ef0b0e"},"url":"https://api.github.com/repos/openai/codex/git/commits/b2cc01fc7ca1a05bb9774121f40086aab87275fc","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK0OcCRC1aQ7uu5UhlAAAUGAQAIyR0olZDYhFAbOTkBn10oek\n0NYDObYH+h+RCw188su8FdS0Kh3TVQ9aiPKMJ7hMYnD4j4H0NXiN6MP/XvMUMrEW\n7rGytA5QWjG7OtoATE/jh8MChs/a2L/ApcIzlpaqisI1tQhvVPO+dO8+qmRr38Y8\nYfOGEfQAD9R7+r3MXG5r/omgmc1LZRXLOpuClGDaT0W/s3lB9c3iDlZa1I0l/n8g\n9KFKC67IufVdM7A8304wSr9sv5isNBevHs3hXhxV8IRaEs5a1QAj/DXoDB/jKerH\nVzORJo6lfgPt+tPvCgkF54XBdsFtCdI/SkBT+c/52cS8TyUXQvJJ0125t1TjeKbX\nBu9OItBp1v14FebRWs+lY2UH9dD8KEzsIY0mQsw0VypLZYPU3uSpIccewoVAreEk\nCFjc/p71TZTrCnkxZBWhpeChTH6FL+h2fUCzJPdjLaHk/0VGXAQCQhcdAncoj29P\n/cp+ZQiqQCiYWoI/Dzk1GZuJ2wl33z0oDlHZnqKA5jWPaADKOS6N2UIp1kPaDpiT\nB6ggxjBcQC1U1eTmtFbu+6NscUnHKZjiUJKWaiBIDutL9/m4qZZV/keik6FAp8ra\nLSCDgGk5hqLelFea+DUl3IPtVlSc4n/bhWR54ey6KLEfKDuo790DRWlLmMzl0Qly\ng8okzT8rDlPf1tYziApt\n=TUaD\n-----END PGP SIGNATURE-----\n","payload":"tree bd0dd3d3e6ad6da973c0c3c5817700cae0ef0b0e\nparent eddc5c75ed527a8348bfcaa85692e53189600833\nauthor Tom <wiltzius@openai.com> 1781220252 -0700\ncommitter GitHub <noreply@github.com> 1781220252 -0700\n\n[codex] Move persistence policy application into ThreadStore (#27318)\n\nMove the application of the persistence policy into the thread store, so\nthread stores can get raw append items rather than canonical append\nitems. This will enable store-specific projections over the raw input\nitems.","verified_at":"2026-06-11T23:24:13Z"}},"url":"https://api.github.com/repos/openai/codex/commits/b2cc01fc7ca1a05bb9774121f40086aab87275fc","html_url":"https://github.com/openai/codex/commit/b2cc01fc7ca1a05bb9774121f40086aab87275fc","comments_url":"https://api.github.com/repos/openai/codex/commits/b2cc01fc7ca1a05bb9774121f40086aab87275fc/comments","author":{"login":"wiltzius-openai","id":176426546,"node_id":"U_kgDOCoQOMg","avatar_url":"https://avatars.githubusercontent.com/u/176426546?v=4","gravatar_id":"","url":"https://api.github.com/users/wiltzius-openai","html_url":"https://github.com/wiltzius-openai","followers_url":"https://api.github.com/users/wiltzius-openai/followers","following_url":"https://api.github.com/users/wiltzius-openai/following{/other_user}","gists_url":"https://api.github.com/users/wiltzius-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/wiltzius-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wiltzius-openai/subscriptions","organizations_url":"https://api.github.com/users/wiltzius-openai/orgs","repos_url":"https://api.github.com/users/wiltzius-openai/repos","events_url":"https://api.github.com/users/wiltzius-openai/events{/privacy}","received_events_url":"https://api.github.com/users/wiltzius-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"eddc5c75ed527a8348bfcaa85692e53189600833","url":"https://api.github.com/repos/openai/codex/commits/eddc5c75ed527a8348bfcaa85692e53189600833","html_url":"https://github.com/openai/codex/commit/eddc5c75ed527a8348bfcaa85692e53189600833"}]},{"sha":"eddc5c75ed527a8348bfcaa85692e53189600833","node_id":"C_kwDOOYsS4doAKGVkZGM1Yzc1ZWQ1MjdhODM0OGJmY2FhODU2OTJlNTMxODk2MDA4MzM","commit":{"author":{"name":"Abhinav","email":"abhinav@openai.com","date":"2026-06-11T23:08:07Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-11T23:08:07Z"},"message":"Warn when hooks.json has unsupported top-level fields (#26426)\n\nAddresses #25875.\n\n## Summary\n\n`hooks.json` accepted unknown top-level fields. A file with\n`SessionStart` at the root parsed as an empty hook configuration without\nwarning.\n\n## Repro\n\n```json\n{ \"SessionStart\": [...] }\n```\n\nPreviously: zero hooks, zero warnings.\n\nNow:\n\n```text\nunknown field `SessionStart`, expected `hooks`\n```\n\nThe supported shape remains:\n\n```json\n{ \"hooks\": { \"SessionStart\": [...] } }\n```\n\n## Fix\n\nReject unknown top-level fields and surface the parse warning in human\nand JSONL `codex exec` output.","tree":{"sha":"1f837f69086f1532919cfb6fe7b0d8a8715693ef","url":"https://api.github.com/repos/openai/codex/git/trees/1f837f69086f1532919cfb6fe7b0d8a8715693ef"},"url":"https://api.github.com/repos/openai/codex/git/commits/eddc5c75ed527a8348bfcaa85692e53189600833","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKz/XCRC1aQ7uu5UhlAAAI3EQAAqPqnH4wPmfDb7PW8E0aOCf\nRL+bBh0ZK3i1inkL0CFAufyx1D/2NC4pJmiMxykZhWYyYq7uJcW03qu8OZb9T4IW\nMk8G1fgDEJlFJWKbfWabJdj+msEswMJNJ6oc9kACenctqRfgPnJ3ilBjXv+HL7d6\nMut/N1yBjlFuWlDjuzYvogRSWI34/TNJbcSA/QHS/Rd8R9GkL3/yG7HTugzjfCKS\nboIoBEpYMJvr7QHwU4P/iJUxCeJVY+UBEC4FcYlHAHdlBp+/4Bjkz8Icjd7vZk4O\nbKcKxEGuso5sNKNerdvvD2RHAUkHsy8MTA60by6hfbIFkCe38gl+qpqvYHjfOpin\nuIwr0za0ZvdmFc83vmmFAaOCYzBtJ7OrGC1IFVshRKk/7kR2i1USl/wth3P53xz/\nqFLAd2p0zCaeSrkMzFbXgdIgdF1vHfPOkEtdxIiIxQpgsEbHv0YqIOo3Jquh1x1l\ncexGWqFIMCTTOKCTr9Kpjy3IhV8XgLnAquA5PTIusvsh6YGSNulaVhIPPXUF9y3P\nUOyw6iLEHSE3LGpDB8vX20+8oXS040OROoFdMpVAxnj2F1GknP3UgKzY/8qp0DSD\nZopHIyXGD+/pqe+ZXL/XvklNgu0krek+zkHkf6yq3B40NuDRu4EvNCiqq4Glpi0f\nO+8WaySutYrIZUbZ3OIa\n=11Aj\n-----END PGP SIGNATURE-----\n","payload":"tree 1f837f69086f1532919cfb6fe7b0d8a8715693ef\nparent e069153f2a1e386674e9747024009eec410da456\nauthor Abhinav <abhinav@openai.com> 1781219287 -0700\ncommitter GitHub <noreply@github.com> 1781219287 +0000\n\nWarn when hooks.json has unsupported top-level fields (#26426)\n\nAddresses #25875.\n\n## Summary\n\n`hooks.json` accepted unknown top-level fields. A file with\n`SessionStart` at the root parsed as an empty hook configuration without\nwarning.\n\n## Repro\n\n```json\n{ \"SessionStart\": [...] }\n```\n\nPreviously: zero hooks, zero warnings.\n\nNow:\n\n```text\nunknown field `SessionStart`, expected `hooks`\n```\n\nThe supported shape remains:\n\n```json\n{ \"hooks\": { \"SessionStart\": [...] } }\n```\n\n## Fix\n\nReject unknown top-level fields and surface the parse warning in human\nand JSONL `codex exec` output.","verified_at":"2026-06-11T23:08:08Z"}},"url":"https://api.github.com/repos/openai/codex/commits/eddc5c75ed527a8348bfcaa85692e53189600833","html_url":"https://github.com/openai/codex/commit/eddc5c75ed527a8348bfcaa85692e53189600833","comments_url":"https://api.github.com/repos/openai/codex/commits/eddc5c75ed527a8348bfcaa85692e53189600833/comments","author":{"login":"abhinav-oai","id":274334565,"node_id":"U_kgDOEFoDZQ","avatar_url":"https://avatars.githubusercontent.com/u/274334565?v=4","gravatar_id":"","url":"https://api.github.com/users/abhinav-oai","html_url":"https://github.com/abhinav-oai","followers_url":"https://api.github.com/users/abhinav-oai/followers","following_url":"https://api.github.com/users/abhinav-oai/following{/other_user}","gists_url":"https://api.github.com/users/abhinav-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/abhinav-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abhinav-oai/subscriptions","organizations_url":"https://api.github.com/users/abhinav-oai/orgs","repos_url":"https://api.github.com/users/abhinav-oai/repos","events_url":"https://api.github.com/users/abhinav-oai/events{/privacy}","received_events_url":"https://api.github.com/users/abhinav-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e069153f2a1e386674e9747024009eec410da456","url":"https://api.github.com/repos/openai/codex/commits/e069153f2a1e386674e9747024009eec410da456","html_url":"https://github.com/openai/codex/commit/e069153f2a1e386674e9747024009eec410da456"}]},{"sha":"e069153f2a1e386674e9747024009eec410da456","node_id":"C_kwDOOYsS4doAKGUwNjkxNTNmMmExZTM4NjY3NGU5NzQ3MDI0MDA5ZWVjNDEwZGE0NTY","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-11T22:48:53Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-11T22:48:53Z"},"message":"Remove fs/join and fs/parent from exec-server protocol (#27700)\n\n## Summary\n\nPath composition is already handled by `PathUri`, leaving `fs/join` and\n`fs/parent` as redundant exec-server protocol surface. Because\napp-server and exec-server are deployed atomically, these obsolete\nmethods can be removed without a compatibility shim.\n\nThis removes the protocol constants and payloads, public client APIs,\nserver registrations and handlers, and endpoint-only tests. Existing\nin-process `PathUri` join/parent coverage remains.\n\n## Validation\n\n- `just test -p codex-exec-server` (215 passed, 2 skipped)","tree":{"sha":"7f2ce0a3ca1bfc4890ce2b83405447f71de0e4d2","url":"https://api.github.com/repos/openai/codex/git/trees/7f2ce0a3ca1bfc4890ce2b83405447f71de0e4d2"},"url":"https://api.github.com/repos/openai/codex/git/commits/e069153f2a1e386674e9747024009eec410da456","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKztVCRC1aQ7uu5UhlAAA1f8QAKqgCUFylNgjyYQaXmp1VGcz\nDbLX5aEcgBWmJxjBVuxj6/dzYCLdbNJDDeNNzElzZukcG8Uetf0LJHckw/zWmst2\n6u6wgWSaxqv9u1Qv+vD9RLlbPbiifpGt55mGotf+GnRgLmvFPjYhnHc0gYVfwyNO\nZXfHjW2nvUhMAce4guphlbcxQdymwH971yEfmR42fEmmfT3+egkrmPS1ZkWK7ll2\nXiVWGgCr4IAkkFP4q+LPWq/I08/f3UAoEkzINyaC+r5lD2B3gMxJrOHOTQnd/hHx\nFVwaS5sXBdmiDk/v3OdkYzSLeQLhp5gg+LxYsieAE/7r5B+1CHWgLrh8l+GDNhIJ\nUpQqY+KpNO851mc7tHpDQObXFmIP3S9sJS8ck6Zwbd7fL/ZPsll0VSMM1ZXIMsXu\nrVKfux+PI0tyw7xcBBH8ZZYmR+bJYB5ZYFORsZH3uxn9RBSuq49OYWF+3H3ltbkQ\nHl1vIqhsq7E4/wWcxWcbSIvTfLdvqVOfraqq0QnoH1NpmpaHzGTDTs6FCslJO491\nSqJL9I5YDNEzrTNeoAcxj0c0DgjnE5a4kfzAyik7WzjguIbQcEuINMk7TqizbqVZ\ncxSvwrUOemmvEwPHY0yFl1L6aFmokE6inpbpRY8zGeUdKCOz0Az8+9yUZ1Weplm0\nf70HXjp0anGM+m1+Wqc0\n=r6mh\n-----END PGP SIGNATURE-----\n","payload":"tree 7f2ce0a3ca1bfc4890ce2b83405447f71de0e4d2\nparent b7a5d81f840673a2198c762a1cfa4c73bbc82c54\nauthor Adam Perry @ OpenAI <anp@openai.com> 1781218133 -0700\ncommitter GitHub <noreply@github.com> 1781218133 -0700\n\nRemove fs/join and fs/parent from exec-server protocol (#27700)\n\n## Summary\n\nPath composition is already handled by `PathUri`, leaving `fs/join` and\n`fs/parent` as redundant exec-server protocol surface. Because\napp-server and exec-server are deployed atomically, these obsolete\nmethods can be removed without a compatibility shim.\n\nThis removes the protocol constants and payloads, public client APIs,\nserver registrations and handlers, and endpoint-only tests. Existing\nin-process `PathUri` join/parent coverage remains.\n\n## Validation\n\n- `just test -p codex-exec-server` (215 passed, 2 skipped)","verified_at":"2026-06-11T22:48:54Z"}},"url":"https://api.github.com/repos/openai/codex/commits/e069153f2a1e386674e9747024009eec410da456","html_url":"https://github.com/openai/codex/commit/e069153f2a1e386674e9747024009eec410da456","comments_url":"https://api.github.com/repos/openai/codex/commits/e069153f2a1e386674e9747024009eec410da456/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b7a5d81f840673a2198c762a1cfa4c73bbc82c54","url":"https://api.github.com/repos/openai/codex/commits/b7a5d81f840673a2198c762a1cfa4c73bbc82c54","html_url":"https://github.com/openai/codex/commit/b7a5d81f840673a2198c762a1cfa4c73bbc82c54"}]},{"sha":"b7a5d81f840673a2198c762a1cfa4c73bbc82c54","node_id":"C_kwDOOYsS4doAKGI3YTVkODFmODQwNjczYTIxOThjNzYyYTFjZmE0YzczYmJjODJjNTQ","commit":{"author":{"name":"Celia Chen","email":"celia@openai.com","date":"2026-06-11T22:33:38Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-11T22:33:38Z"},"message":"feat: prefer managed Bedrock auth in model provider (#27689)\n\n## Why\n\nThe Amazon Bedrock model provider currently discards the shared\n`AuthManager`, so a Codex-managed Bedrock API key cannot reach\nrequest-time provider auth. Bedrock instead falls through to AWS\nenvironment or SDK credentials, and the request endpoint can be resolved\nfrom a different region than the managed credential.\n\nManaged Bedrock login should control both the bearer credential and\nMantle region. Unrelated OpenAI or ChatGPT credentials must remain\nisolated from Bedrock.\n\n## What changed\n\n- Pass the shared `AuthManager` into `AmazonBedrockModelProvider`.\n- Select `CodexAuth::BedrockApiKey` before the existing\n`AWS_BEARER_TOKEN_BEDROCK` and AWS SDK/SigV4 paths.\n- Use the managed Bedrock auth region when resolving the Mantle\nendpoint.\n- Filter other `CodexAuth` variants so OpenAI and ChatGPT auth are not\nexposed to Bedrock request auth or unauthorized recovery.\n- Add focused coverage for provider construction, managed-auth\nprecedence, bearer headers, endpoint selection, and OpenAI-auth\nisolation.","tree":{"sha":"e5067221252ca6f77695bf76b85df2df8415c4d1","url":"https://api.github.com/repos/openai/codex/git/trees/e5067221252ca6f77695bf76b85df2df8415c4d1"},"url":"https://api.github.com/repos/openai/codex/git/commits/b7a5d81f840673a2198c762a1cfa4c73bbc82c54","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKzfCCRC1aQ7uu5UhlAAAQUYQAKGlHkgySRLm2RsNrE72g4J3\nLtopbWXyXSCmb8FFWSShaz1irMaFpCaZ8kFlik78brmgnjNnecgOEaHWjeXWMeUG\neXI0wrsv6IMF97KIYiny2plLyvv2SPyXnqPVXSbzdjgegIXYXbMoTaPQn9KX2i4p\nEDAGs5K4Rr+OsXIdfi0lYtauGCEe9VYb2nsOCA8KlJSSAk5lXdoKNWNrM4EEY2t2\nGjS53Qy2xlZGG6XYv4XwR1XeHrHrcYjjd2uBjyd81bMOGnTq/P0cuPdMpLA0lDaP\n+fDWGocDuOBcJPteglIB8M9f/6khGnX34be5xxEW3spngYO/uxiwVtXMbXNVCuuP\nfKc/f5f0taL2M9EyPDC5gm67WVHViO2jNSb6JyYy7By11ZgXjmEUXdkyBH7j3zrq\niaSQo4S1VPdp4kjd4q1RHEWrUyJDYymEHRnv87QbFN9E/R0LaNemsiZqpPI1yIpj\n8fBOFFWoub0wkTKGMgWiujbyNTaw7uGedOqNgzx9RUWjkdGCh8B1lfCdXfzY81wT\n1m8+B6/mykfFCJn3HbLMldtm7U9mqExZSUIUFKVcTFezB42JAcsqmKCcQzQ+TNUH\nsSRvCaFG26m2g21A2NZgyHRBHT1PuhZiUO+FAXuhzOuKRlAtyPzeutH3w9dCWzX2\nG6Efc8SEKUZoMVsgnqBo\n=0qWL\n-----END PGP SIGNATURE-----\n","payload":"tree e5067221252ca6f77695bf76b85df2df8415c4d1\nparent 0d8dee94278af682eb8c3befec10cb67e7caba2c\nauthor Celia Chen <celia@openai.com> 1781217218 -0700\ncommitter GitHub <noreply@github.com> 1781217218 -0700\n\nfeat: prefer managed Bedrock auth in model provider (#27689)\n\n## Why\n\nThe Amazon Bedrock model provider currently discards the shared\n`AuthManager`, so a Codex-managed Bedrock API key cannot reach\nrequest-time provider auth. Bedrock instead falls through to AWS\nenvironment or SDK credentials, and the request endpoint can be resolved\nfrom a different region than the managed credential.\n\nManaged Bedrock login should control both the bearer credential and\nMantle region. Unrelated OpenAI or ChatGPT credentials must remain\nisolated from Bedrock.\n\n## What changed\n\n- Pass the shared `AuthManager` into `AmazonBedrockModelProvider`.\n- Select `CodexAuth::BedrockApiKey` before the existing\n`AWS_BEARER_TOKEN_BEDROCK` and AWS SDK/SigV4 paths.\n- Use the managed Bedrock auth region when resolving the Mantle\nendpoint.\n- Filter other `CodexAuth` variants so OpenAI and ChatGPT auth are not\nexposed to Bedrock request auth or unauthorized recovery.\n- Add focused coverage for provider construction, managed-auth\nprecedence, bearer headers, endpoint selection, and OpenAI-auth\nisolation.","verified_at":"2026-06-11T22:33:39Z"}},"url":"https://api.github.com/repos/openai/codex/commits/b7a5d81f840673a2198c762a1cfa4c73bbc82c54","html_url":"https://github.com/openai/codex/commit/b7a5d81f840673a2198c762a1cfa4c73bbc82c54","comments_url":"https://api.github.com/repos/openai/codex/commits/b7a5d81f840673a2198c762a1cfa4c73bbc82c54/comments","author":{"login":"celia-oai","id":209693228,"node_id":"U_kgDODH-qLA","avatar_url":"https://avatars.githubusercontent.com/u/209693228?v=4","gravatar_id":"","url":"https://api.github.com/users/celia-oai","html_url":"https://github.com/celia-oai","followers_url":"https://api.github.com/users/celia-oai/followers","following_url":"https://api.github.com/users/celia-oai/following{/other_user}","gists_url":"https://api.github.com/users/celia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/celia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celia-oai/subscriptions","organizations_url":"https://api.github.com/users/celia-oai/orgs","repos_url":"https://api.github.com/users/celia-oai/repos","events_url":"https://api.github.com/users/celia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/celia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"0d8dee94278af682eb8c3befec10cb67e7caba2c","url":"https://api.github.com/repos/openai/codex/commits/0d8dee94278af682eb8c3befec10cb67e7caba2c","html_url":"https://github.com/openai/codex/commit/0d8dee94278af682eb8c3befec10cb67e7caba2c"}]},{"sha":"0d8dee94278af682eb8c3befec10cb67e7caba2c","node_id":"C_kwDOOYsS4doAKDBkOGRlZTk0Mjc4YWY2ODJlYjhjM2JlZmVjMTBjYjY3ZTdjYWJhMmM","commit":{"author":{"name":"Abhinav","email":"abhinav@openai.com","date":"2026-06-11T22:25:55Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-11T22:25:55Z"},"message":"[codex] Avoid duplicate hooks.json discovery with profiles (#26418)\n\n## Summary\n\nV2 profiles add both `config.toml` and `<profile>.config.toml` to the\nconfig stack. Because both user layers resolve hook discovery to the\nsame Codex home, Codex loaded the same `hooks.json` twice. This\nduplicated hook rows and caused each matching command to run twice.\n\nDeduplicate JSON hook discovery by absolute config folder within each\neffective config stack. TOML hooks remain layer-specific, and multi-cwd\n`hooks/list` results remain independently resolved per cwd.\n\n## Reproduction\n\n1. Add `config.toml` and `work.config.toml` under `$CODEX_HOME`.\n2. Add one command hook to `$CODEX_HOME/hooks.json`.\n3. Run Codex with `--profile work`.\n4. Trigger the hook.\n\nBefore this change, one declaration creates two handlers. Afterward, it\ncreates one.\n\nFixes #25645 and addresses the single-cwd duplication in #25437.\n\n## Validation\n\n- `cargo nextest run -p codex-hooks`\n- `just fix -p codex-hooks`\n- `just fmt`\n- `just argument-comment-lint -p codex-hooks`","tree":{"sha":"d0ff0ee5ba4fada68670911d83642140765a28ed","url":"https://api.github.com/repos/openai/codex/git/trees/d0ff0ee5ba4fada68670911d83642140765a28ed"},"url":"https://api.github.com/repos/openai/codex/git/commits/0d8dee94278af682eb8c3befec10cb67e7caba2c","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKzXzCRC1aQ7uu5UhlAAAPVkQAKDM7p6Luod+6AAzUBg5z8Bm\n4VUVx3gjtiGkLck0dpJVQ0KLczdAMpqq8TSoZ8ibzuyWX7Ed4OZsMLC8uhHtwOCY\neUbzpQXpm6gZ4C+tYSmkK8mcCeye36POLswL2LDwQEIMXTWsHhIT8G3bujtOvtyC\nDhA2CBZi3yogptJsyCBhzICMIpV6RdtrAT9lfh/3VfClS6ATHqhPVbiXJ9JlYTgh\nCHTrM6aWYbc7SQb4PkVLSnOxeDnKMdwK8Xe2h+nObF/iPDzDWrbGJ/nmSkLnhOd/\nvjqdU7W6cMGKESc2G6Ml2vgiIUTiOhKkzKOt+46+v6QuhfTW/myGu8mngp6nTjuU\nWObIHza3KIfOp9xSrzrgZy3gu6HBqu/XqxhaQNMeRxh0e5xmDOqCqg9vhZoWKTyx\nG05GBrxDuA4XyAbR92w+sdVAJKVpHFYzlJHHJcRr4eej2iOA9geEVnys5wUe5e0J\nhN9yBfA8Kw582agsVijriwgnk04QPHpUdFP5KiBztKtqO2T0K9AbuQ6JMXyaxASk\n2o/53rmG+0WDLnLJXFMbp8EfUIer9FjSjJqX35BIn1nf4kB4FQhGA1nzvvzQ8JHn\nODuQyvI0wbtdrF7PdB0YpLKd6yxBw0IxTFqu6P7FJAb4MiKZeYlqXxdqtQRQj0nh\nfj7u1jkFmZuUvywHdhK3\n=/Udw\n-----END PGP SIGNATURE-----\n","payload":"tree d0ff0ee5ba4fada68670911d83642140765a28ed\nparent 7516eb5c70f8478e20955b4203c5c892ef641055\nauthor Abhinav <abhinav@openai.com> 1781216755 -0700\ncommitter GitHub <noreply@github.com> 1781216755 -0700\n\n[codex] Avoid duplicate hooks.json discovery with profiles (#26418)\n\n## Summary\n\nV2 profiles add both `config.toml` and `<profile>.config.toml` to the\nconfig stack. Because both user layers resolve hook discovery to the\nsame Codex home, Codex loaded the same `hooks.json` twice. This\nduplicated hook rows and caused each matching command to run twice.\n\nDeduplicate JSON hook discovery by absolute config folder within each\neffective config stack. TOML hooks remain layer-specific, and multi-cwd\n`hooks/list` results remain independently resolved per cwd.\n\n## Reproduction\n\n1. Add `config.toml` and `work.config.toml` under `$CODEX_HOME`.\n2. Add one command hook to `$CODEX_HOME/hooks.json`.\n3. Run Codex with `--profile work`.\n4. Trigger the hook.\n\nBefore this change, one declaration creates two handlers. Afterward, it\ncreates one.\n\nFixes #25645 and addresses the single-cwd duplication in #25437.\n\n## Validation\n\n- `cargo nextest run -p codex-hooks`\n- `just fix -p codex-hooks`\n- `just fmt`\n- `just argument-comment-lint -p codex-hooks`","verified_at":"2026-06-11T22:25:56Z"}},"url":"https://api.github.com/repos/openai/codex/commits/0d8dee94278af682eb8c3befec10cb67e7caba2c","html_url":"https://github.com/openai/codex/commit/0d8dee94278af682eb8c3befec10cb67e7caba2c","comments_url":"https://api.github.com/repos/openai/codex/commits/0d8dee94278af682eb8c3befec10cb67e7caba2c/comments","author":{"login":"abhinav-oai","id":274334565,"node_id":"U_kgDOEFoDZQ","avatar_url":"https://avatars.githubusercontent.com/u/274334565?v=4","gravatar_id":"","url":"https://api.github.com/users/abhinav-oai","html_url":"https://github.com/abhinav-oai","followers_url":"https://api.github.com/users/abhinav-oai/followers","following_url":"https://api.github.com/users/abhinav-oai/following{/other_user}","gists_url":"https://api.github.com/users/abhinav-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/abhinav-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abhinav-oai/subscriptions","organizations_url":"https://api.github.com/users/abhinav-oai/orgs","repos_url":"https://api.github.com/users/abhinav-oai/repos","events_url":"https://api.github.com/users/abhinav-oai/events{/privacy}","received_events_url":"https://api.github.com/users/abhinav-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7516eb5c70f8478e20955b4203c5c892ef641055","url":"https://api.github.com/repos/openai/codex/commits/7516eb5c70f8478e20955b4203c5c892ef641055","html_url":"https://github.com/openai/codex/commit/7516eb5c70f8478e20955b4203c5c892ef641055"}]},{"sha":"7516eb5c70f8478e20955b4203c5c892ef641055","node_id":"C_kwDOOYsS4doAKDc1MTZlYjVjNzBmODQ3OGUyMDk1NWI0MjAzYzVjODkyZWY2NDEwNTU","commit":{"author":{"name":"pakrym-oai","email":"pakrym@openai.com","date":"2026-06-11T22:10:29Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-11T22:10:29Z"},"message":"Include thread id in token budget context (#27663)\n\n## Why\n\nThe token budget full-context fragment identifies the current context\nwindow, but not the thread that owns that window. Including the thread\nid makes the initial context-window metadata self-contained, and\n`get_context_remaining` also needs to be usable from Code Mode without\nforcing callers to parse the model-facing fragment string.\n\n## What changed\n\n- Include the session thread id in the initial `<token_budget>` context\nfragment.\n- Expose `get_context_remaining` as a Code Mode nested tool while\nkeeping `new_context` direct-model-only.\n- Keep direct model-facing `get_context_remaining` output as the\nexisting `<token_budget>` text fragment.\n- Return only `tokens_left` from the Code Mode structured result for\n`get_context_remaining`.\n- Update token-budget integration tests and add Code Mode coverage for\nthe structured result.\n\n## Verification\n\n- `just test -p codex-core token_budget`\n- `just test -p codex-core\ncode_mode_get_context_remaining_returns_structured_result`\n- `just test -p core_test_support redacted_text_mode_normalizes_uuids`","tree":{"sha":"ae2c365ba857966ad47c498c90b092f9dedc25bb","url":"https://api.github.com/repos/openai/codex/git/trees/ae2c365ba857966ad47c498c90b092f9dedc25bb"},"url":"https://api.github.com/repos/openai/codex/git/commits/7516eb5c70f8478e20955b4203c5c892ef641055","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKzJWCRC1aQ7uu5UhlAAA968QAG/Yj3txxPMjc5jR5W+RGpkN\nM0eFIfuq+oXtL1SFs+48y/TO6D6JN0BN9R7r0YuRNLXdplU2SNlMlmfqlL0ijvuU\nklNvNaPl9gqu3ORc1IiIxEVubgIr0mKfiLb0Ua70b8LFXpLZldGYiEoTIWh6M1Jc\nWxEKgE09pM74Hoym55Wef2e4GHlnAWqnUhhamuljSZgSYF7X38QuwY0BnXG0Atlt\ns9eXfc+Kroz663Yc/fC6WPUjmBdxLA4hjDAPmMr5KcJ6A3g9Wo/OPcPUpVFcYfdI\nh/0A4EQrT0VitJ3joCSbxu1HY9ccVeDQ/ZipNNwR8PQWFEhbCIgrRMvF/kfozo7K\n/Q9mCyp3KhWa2OjbXmsKY20AiBmSOmf0H1Veg74pCEznXxFpL6h2UVoYJ7l2K2Re\nyAJWv08spFHPe5XTXlKXi3wh5iRCg738qNfxLnVcst2Zo43CzjBevDoQK7ypjrFL\n4CxrAwR+9lpTf7GheubO9DH176hap0zT/lE5XtpbYLMHby0KEtD1PnInmeVztG4E\n1X5UEZE+n+Y1hL6ihCXGjH1cUc9/FSzEwhr8KzrA5QSsA2sLayh0vEL6KQrWKdJH\nybluVKu+ZFlw4ixgWQQKokuzU5lOoReBD0oDp3lDWGmB1xe0AYB5aPBcRU9DtQGw\nJcV+KrwYHWJMT/eH6xXW\n=f1kN\n-----END PGP SIGNATURE-----\n","payload":"tree ae2c365ba857966ad47c498c90b092f9dedc25bb\nparent d23bb22f25c5ad82381aabaf84e733a002490417\nauthor pakrym-oai <pakrym@openai.com> 1781215829 -0700\ncommitter GitHub <noreply@github.com> 1781215829 -0700\n\nInclude thread id in token budget context (#27663)\n\n## Why\n\nThe token budget full-context fragment identifies the current context\nwindow, but not the thread that owns that window. Including the thread\nid makes the initial context-window metadata self-contained, and\n`get_context_remaining` also needs to be usable from Code Mode without\nforcing callers to parse the model-facing fragment string.\n\n## What changed\n\n- Include the session thread id in the initial `<token_budget>` context\nfragment.\n- Expose `get_context_remaining` as a Code Mode nested tool while\nkeeping `new_context` direct-model-only.\n- Keep direct model-facing `get_context_remaining` output as the\nexisting `<token_budget>` text fragment.\n- Return only `tokens_left` from the Code Mode structured result for\n`get_context_remaining`.\n- Update token-budget integration tests and add Code Mode coverage for\nthe structured result.\n\n## Verification\n\n- `just test -p codex-core token_budget`\n- `just test -p codex-core\ncode_mode_get_context_remaining_returns_structured_result`\n- `just test -p core_test_support redacted_text_mode_normalizes_uuids`","verified_at":"2026-06-11T22:10:30Z"}},"url":"https://api.github.com/repos/openai/codex/commits/7516eb5c70f8478e20955b4203c5c892ef641055","html_url":"https://github.com/openai/codex/commit/7516eb5c70f8478e20955b4203c5c892ef641055","comments_url":"https://api.github.com/repos/openai/codex/commits/7516eb5c70f8478e20955b4203c5c892ef641055/comments","author":{"login":"pakrym-oai","id":204937752,"node_id":"U_kgDODDcaGA","avatar_url":"https://avatars.githubusercontent.com/u/204937752?v=4","gravatar_id":"","url":"https://api.github.com/users/pakrym-oai","html_url":"https://github.com/pakrym-oai","followers_url":"https://api.github.com/users/pakrym-oai/followers","following_url":"https://api.github.com/users/pakrym-oai/following{/other_user}","gists_url":"https://api.github.com/users/pakrym-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/pakrym-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pakrym-oai/subscriptions","organizations_url":"https://api.github.com/users/pakrym-oai/orgs","repos_url":"https://api.github.com/users/pakrym-oai/repos","events_url":"https://api.github.com/users/pakrym-oai/events{/privacy}","received_events_url":"https://api.github.com/users/pakrym-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"d23bb22f25c5ad82381aabaf84e733a002490417","url":"https://api.github.com/repos/openai/codex/commits/d23bb22f25c5ad82381aabaf84e733a002490417","html_url":"https://github.com/openai/codex/commit/d23bb22f25c5ad82381aabaf84e733a002490417"}]},{"sha":"d23bb22f25c5ad82381aabaf84e733a002490417","node_id":"C_kwDOOYsS4doAKGQyM2JiMjJmMjVjNWFkODIzODFhYWJhZjg0ZTczM2EwMDI0OTA0MTc","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-11T22:09:12Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-11T22:09:12Z"},"message":"[codex] migrate exec-server filesystem protocol to PathUri (#27653)\n\nExec-server filesystem calls should preserve cross-platform `file:` URIs\nacross the remote boundary instead of converting them through paths\nnative to the client host.\n\nThis changes the exec-server filesystem protocol DTOs to use `PathUri`,\ncarries those values directly through remote and sandbox-helper\ntransports, and keeps legacy native absolute-path request strings\nreadable for compatibility. It also updates protocol documentation and\ncoverage for URI serialization and non-native URI forwarding.","tree":{"sha":"d50adda70f61a5ccc8e8ccefa64c5af9adacfbae","url":"https://api.github.com/repos/openai/codex/git/trees/d50adda70f61a5ccc8e8ccefa64c5af9adacfbae"},"url":"https://api.github.com/repos/openai/codex/git/commits/d23bb22f25c5ad82381aabaf84e733a002490417","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKzIICRC1aQ7uu5UhlAAA/v0QAB+OheCsY9s+lNV62GFsE8+O\njQ1v6nM7AZKfWjefjWgv7/kjIBVVldMHdXOfKWiVGMUmjfkp5AH3FunTT76GOATM\nr+kJ+7f8soCHnCzCD3NoWMKzJABbkrEco4TylffexJzemSX7Sqeb9EOvpFxR2fkS\nR+AXr0wMiD/cPULYG24McBGRKFdiX2o7016BoWwX288P2aUT+vaI+Syf85ze4apq\n0Wbj/1BBPbZLF9Cr90LTfhCDivk4k6wHT/8V+n/4Kvqdfs19J3aZUGeD97Z9M2jP\n5OkSLBUGRHDNDMyLbgu0zkX1bSFdkYBU9IEib5PY3y7T2fwKpLpXQvNXOjryxs32\ndrG4UxvCg7G/SRlipwz5DXDuDDinpDGMZMb+neNwXf6sJbHzIwSUDRMKToyfMr7D\n7g458cx3UxgnV5Vv4mDKpbN6y4h7S7sCCzzKdooXEvrie+c2vhpUmHrmRouWXW5p\nzsG5b806mMqfQCb1W+jnDNq6vouIqVehgXxyx/i0PKtgmCa6labQvyT3bunCw4/S\nFEz1M5heHkfX9ngWiFuJhaP1F+FhMAddRfphp36aL0hpK1/JfOHV43VkaTopU5Kk\ne8aa2XGLzL34k12IDCSQrKBwDm3+PjpgtCuYfpIWHV+923uqHk7Au8OgTXBtPt02\nyzL4sXi4kubqy6UBd3IW\n=KkQb\n-----END PGP SIGNATURE-----\n","payload":"tree d50adda70f61a5ccc8e8ccefa64c5af9adacfbae\nparent b5f1bb75d491b285e2fcdb7c27022b5f717093f7\nauthor Adam Perry @ OpenAI <anp@openai.com> 1781215752 -0700\ncommitter GitHub <noreply@github.com> 1781215752 -0700\n\n[codex] migrate exec-server filesystem protocol to PathUri (#27653)\n\nExec-server filesystem calls should preserve cross-platform `file:` URIs\nacross the remote boundary instead of converting them through paths\nnative to the client host.\n\nThis changes the exec-server filesystem protocol DTOs to use `PathUri`,\ncarries those values directly through remote and sandbox-helper\ntransports, and keeps legacy native absolute-path request strings\nreadable for compatibility. It also updates protocol documentation and\ncoverage for URI serialization and non-native URI forwarding.","verified_at":"2026-06-11T22:09:13Z"}},"url":"https://api.github.com/repos/openai/codex/commits/d23bb22f25c5ad82381aabaf84e733a002490417","html_url":"https://github.com/openai/codex/commit/d23bb22f25c5ad82381aabaf84e733a002490417","comments_url":"https://api.github.com/repos/openai/codex/commits/d23bb22f25c5ad82381aabaf84e733a002490417/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b5f1bb75d491b285e2fcdb7c27022b5f717093f7","url":"https://api.github.com/repos/openai/codex/commits/b5f1bb75d491b285e2fcdb7c27022b5f717093f7","html_url":"https://github.com/openai/codex/commit/b5f1bb75d491b285e2fcdb7c27022b5f717093f7"}]},{"sha":"b5f1bb75d491b285e2fcdb7c27022b5f717093f7","node_id":"C_kwDOOYsS4doAKGI1ZjFiYjc1ZDQ5MWIyODVlMmZjZGI3YzI3MDIyYjVmNzE3MDkzZjc","commit":{"author":{"name":"cooper-oai","email":"cooper@openai.com","date":"2026-06-11T21:17:37Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-11T21:17:37Z"},"message":"[codex-rs] enforce PAT workspace restrictions (#27450)\n\n## Summary\n\n- validate a hydrated personal access token's workspace against\n`forced_chatgpt_workspace_id` before persisting `codex login\n--with-access-token`\n- apply the same PAT-only check when restricted auth managers load\nenvironment, ephemeral, or persisted credentials\n- enforce PAT workspace restrictions in the existing central\nlogin-restriction path\n- leave Agent Identity and cloud bootstrap behavior unchanged\n\n## Scope\n\nThis is intentionally the small PAT-only change. It does not attempt the\nbroader auth-manager/bootstrap unification; that needs separate design\nwork.\n\n## Validation\n\n- `CARGO_INCREMENTAL=0 CARGO_TARGET_DIR=/tmp/codex-pat-target just test\n-p codex-login -p codex-cli` (410 passed)\n- `CARGO_INCREMENTAL=0 CARGO_TARGET_DIR=/tmp/codex-pat-target just fix\n-p codex-login -p codex-cli`\n- `just fmt`\n- `git diff --check`\n\nContext: https://openai.slack.com/archives/D0AUPLV03RQ/p1781138331548269","tree":{"sha":"a928ba7477c4d8ae1b53c2dbc01ca1a655d5d830","url":"https://api.github.com/repos/openai/codex/git/trees/a928ba7477c4d8ae1b53c2dbc01ca1a655d5d830"},"url":"https://api.github.com/repos/openai/codex/git/commits/b5f1bb75d491b285e2fcdb7c27022b5f717093f7","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKyXxCRC1aQ7uu5UhlAAAaGEQAK7+aTCpcirk2/hKy297FBz/\nGicKqOQsofE7E1dsARNDI0Fx9kEFt/of8A9Vfo5E+vDNSF0bWEcZT+LCMqbne7ML\nZ0cuUxw5ngoOh+pQwZfkAl06bO67xsJSavaANU1dmJZKBTumizs1RImN+yrMKdmC\nmrOQyCX1mwduT4mjMSA7fIJ1Vqr7qGWerFJuXwoaEgsOiKBn2oBE86FcxY5ReiU/\no6mCqdRleQs2GRFSyPoONWYF8Q1bTEZp1yxRqNQkOIiIpFnDzVRToBBkTCswgqb3\nZl3sW0jj8QD+YVYN462qbEp+91KdTz5lHtTsmgXxUOHzxmBhbqz0igykJKX1U/wy\naihsVOCW1khO/46HgRBE9wXAy9EP47zTZm1BCFs3LEViSFYqf2Tb4gaPFRYkMxWi\nS/eGfXAtL3zal8/CsjsuF+W8MZxIkiJW6XYcnUVRjNoqNYrk6D/JuFpLYc8vQGdi\n7FOi8sW0f7gz26dTKrn+pZeWpTPsR12qAm5nRiQUxHm89cVoNK/O1V04P7A2Cq6F\nTc9fXp0JaOI9K7bSvWBXbDFe6+kKRLOtRRyTa6XKnEtSoFDLKTOHM6s9+C5lgugs\nILso6eqCjQxpYUWLVf4dFoZUKkZz1uRXgs/x4VVA74FPW3i3tMhiwUGOEiiDh9Sd\nofs2wiGcP44yeahAyWp5\n=i6Vh\n-----END PGP SIGNATURE-----\n","payload":"tree a928ba7477c4d8ae1b53c2dbc01ca1a655d5d830\nparent 14df0e8833aad0d6d78287954b61ffac67af936c\nauthor cooper-oai <cooper@openai.com> 1781212657 -0700\ncommitter GitHub <noreply@github.com> 1781212657 -0700\n\n[codex-rs] enforce PAT workspace restrictions (#27450)\n\n## Summary\n\n- validate a hydrated personal access token's workspace against\n`forced_chatgpt_workspace_id` before persisting `codex login\n--with-access-token`\n- apply the same PAT-only check when restricted auth managers load\nenvironment, ephemeral, or persisted credentials\n- enforce PAT workspace restrictions in the existing central\nlogin-restriction path\n- leave Agent Identity and cloud bootstrap behavior unchanged\n\n## Scope\n\nThis is intentionally the small PAT-only change. It does not attempt the\nbroader auth-manager/bootstrap unification; that needs separate design\nwork.\n\n## Validation\n\n- `CARGO_INCREMENTAL=0 CARGO_TARGET_DIR=/tmp/codex-pat-target just test\n-p codex-login -p codex-cli` (410 passed)\n- `CARGO_INCREMENTAL=0 CARGO_TARGET_DIR=/tmp/codex-pat-target just fix\n-p codex-login -p codex-cli`\n- `just fmt`\n- `git diff --check`\n\nContext: https://openai.slack.com/archives/D0AUPLV03RQ/p1781138331548269","verified_at":"2026-06-11T21:17:37Z"}},"url":"https://api.github.com/repos/openai/codex/commits/b5f1bb75d491b285e2fcdb7c27022b5f717093f7","html_url":"https://github.com/openai/codex/commit/b5f1bb75d491b285e2fcdb7c27022b5f717093f7","comments_url":"https://api.github.com/repos/openai/codex/commits/b5f1bb75d491b285e2fcdb7c27022b5f717093f7/comments","author":{"login":"cooper-oai","id":242064477,"node_id":"U_kgDODm2cXQ","avatar_url":"https://avatars.githubusercontent.com/u/242064477?v=4","gravatar_id":"","url":"https://api.github.com/users/cooper-oai","html_url":"https://github.com/cooper-oai","followers_url":"https://api.github.com/users/cooper-oai/followers","following_url":"https://api.github.com/users/cooper-oai/following{/other_user}","gists_url":"https://api.github.com/users/cooper-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/cooper-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cooper-oai/subscriptions","organizations_url":"https://api.github.com/users/cooper-oai/orgs","repos_url":"https://api.github.com/users/cooper-oai/repos","events_url":"https://api.github.com/users/cooper-oai/events{/privacy}","received_events_url":"https://api.github.com/users/cooper-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"14df0e8833aad0d6d78287954b61ffac67af936c","url":"https://api.github.com/repos/openai/codex/commits/14df0e8833aad0d6d78287954b61ffac67af936c","html_url":"https://github.com/openai/codex/commit/14df0e8833aad0d6d78287954b61ffac67af936c"}]},{"sha":"14df0e8833aad0d6d78287954b61ffac67af936c","node_id":"C_kwDOOYsS4doAKDE0ZGYwZTg4MzNhYWQwZDZkNzgyODc5NTRiNjFmZmFjNjdhZjkzNmM","commit":{"author":{"name":"Owen Lin","email":"owenlin0@gmail.com","date":"2026-06-11T20:42:09Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-11T20:42:09Z"},"message":"core: Consolidate Responses API Codex metadata (#27122)\n\n## What\nIntroduce a `CodexResponsesMetadata` struct that defines all the core\nmetadata we send to Responses API. Example fields are `thread_id`,\n`turn_id`, `window_id`, etc.\n\nGoing forward, `client_metadata[\"x-codex-turn-metadata\"]` will be the\ncanonical way Codex sends metadata to Responses API across both HTTP and\nwebsocket transports.\n\nFor now, we continue to emit the existing top-level HTTP headers and\ntop-level `client_metadata` fields from the same\n`CodexResponsesMetadata` struct for compatibility reasons.\n\nAlso, app-server clients who specify additional\n`responsesapi_client_metadata` via `turn/start` and `turn/steer` will\nhave those fields merged into\n`client_metadata[\"x-codex-turn-metadata\"]`, but cannot override the\nreserved fields that core uses (i.e. the fields in\n`CodexResponsesMetadata`).\n\n## Why\n\nResponses API request instrumentation is the source of truth for\ndownstream Codex analytics that join requests by Codex IDs such as\nsession, thread, turn, and context window. Before this change, those\nvalues were assembled through several request-specific paths: HTTP\nrequest bodies, websocket handshake headers, websocket `response.create`\npayloads, compaction requests, and the rich `x-codex-turn-metadata`\nenvelope all had their own wiring.\n\nThat made metadata propagation easy to drift across API-key/direct\nResponses API requests, ChatGPT-auth/proxied requests, websocket\nrequests, and compaction requests. It also made additions like\n`window_id` error-prone because a field could be added to one transport\nprojection but missed in another.\n\n## What changed\n\n- Added `CodexResponsesMetadata` as the core-owned snapshot for Codex\nmetadata sent to ResponsesAPI.\n- Render `client_metadata[\"x-codex-turn-metadata\"]`, flat\n`client_metadata` projections, and direct compatibility headers from\nthat same snapshot.\n- Include the known Codex-owned fields in the turn metadata blob,\nincluding installation/session/thread/turn/window IDs, request kind,\nlineage, sandbox/workspace metadata, timing, and compaction details.\n- Treat app-server `responsesapi_client_metadata` as enrichment for the\nCodex turn metadata blob while preventing those extras from overriding\nCodex-owned fields.\n- Use the same metadata path for normal turns, websocket prewarm, local\ncompaction, remote v1 compaction, and remote v2 compaction.\n- Keep websocket connection-only preconnect metadata separate so\nhandshakes carry compatibility identity headers without inventing a fake\nturn metadata blob.\n\n## Verification\n\n- `cargo check -p codex-core`\n- `just fix -p codex-core`","tree":{"sha":"a1fd2e8c228afe0a7d5e921940bb8a3345f621f4","url":"https://api.github.com/repos/openai/codex/git/trees/a1fd2e8c228afe0a7d5e921940bb8a3345f621f4"},"url":"https://api.github.com/repos/openai/codex/git/commits/14df0e8833aad0d6d78287954b61ffac67af936c","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKx2hCRC1aQ7uu5UhlAAAKrcQABvdupjBhZemk+vqFVoXjZmC\nVo6g1REly23646iGj45vcwX4bzz4qSdm3HbvXVp9jBa8Ny1YssvwSF/ODoe1VKtf\nCKGJ7ESPhxoFqC0XubdiNuUHf05R3Dvcy1YLKLMmbw0j7onb9PVxu1hW/CSIfHqN\neoQt4+hn/DVIKN2m4OFkOkhZuabTO7Tv5QpTqSc6w2mfkNi7TrqqE2h6d3MAGmLb\nTGWFh1ylJF80ZkIrDpRbkDOQBlHxTUnO4HcKVeIszzwwZAkbRBk5H2Eyz5dxnokA\nWwaKKnHvIjLf/iK8IiHU6Qxkg2IwlE3s4ZhT98tuFB9WOPU15mTFo+wYvUy1UPjE\nA6EMCTCyyno2cXKxE2if/u6zAtdiw2RipBRC/RnKogYSR2tzkf0VmZhIe7/Hnz45\nZ/jVJG1f3jMa49SIPqqT8zg0g7yOhj4npTFsyQJ2mTEJiNNlIuW8CruhzM0ykkSV\nJ19KqWooH+TNs0B60PkCBMVWpZfOYe00+CvFBxo/r6lqi92928Dy8aef+dRKZ5nb\nSoV299ESl3N4lQu0uD0QCkt90BTPW59KJmL/ili7sL98TO205ZfaOSuIHbqlmj5k\nDLYCPx3c4lvx9zjoIas7SPE5LnwuoR42WJgOMbGu/QehPEgUd/WUEaHdMhgjX+u7\nAmiTvmj7ZZgfWpKLk3gX\n=rR/+\n-----END PGP SIGNATURE-----\n","payload":"tree a1fd2e8c228afe0a7d5e921940bb8a3345f621f4\nparent 4a5a67649952e7a657c32d8534c42fdfc8db2448\nauthor Owen Lin <owenlin0@gmail.com> 1781210529 -0700\ncommitter GitHub <noreply@github.com> 1781210529 -0700\n\ncore: Consolidate Responses API Codex metadata (#27122)\n\n## What\nIntroduce a `CodexResponsesMetadata` struct that defines all the core\nmetadata we send to Responses API. Example fields are `thread_id`,\n`turn_id`, `window_id`, etc.\n\nGoing forward, `client_metadata[\"x-codex-turn-metadata\"]` will be the\ncanonical way Codex sends metadata to Responses API across both HTTP and\nwebsocket transports.\n\nFor now, we continue to emit the existing top-level HTTP headers and\ntop-level `client_metadata` fields from the same\n`CodexResponsesMetadata` struct for compatibility reasons.\n\nAlso, app-server clients who specify additional\n`responsesapi_client_metadata` via `turn/start` and `turn/steer` will\nhave those fields merged into\n`client_metadata[\"x-codex-turn-metadata\"]`, but cannot override the\nreserved fields that core uses (i.e. the fields in\n`CodexResponsesMetadata`).\n\n## Why\n\nResponses API request instrumentation is the source of truth for\ndownstream Codex analytics that join requests by Codex IDs such as\nsession, thread, turn, and context window. Before this change, those\nvalues were assembled through several request-specific paths: HTTP\nrequest bodies, websocket handshake headers, websocket `response.create`\npayloads, compaction requests, and the rich `x-codex-turn-metadata`\nenvelope all had their own wiring.\n\nThat made metadata propagation easy to drift across API-key/direct\nResponses API requests, ChatGPT-auth/proxied requests, websocket\nrequests, and compaction requests. It also made additions like\n`window_id` error-prone because a field could be added to one transport\nprojection but missed in another.\n\n## What changed\n\n- Added `CodexResponsesMetadata` as the core-owned snapshot for Codex\nmetadata sent to ResponsesAPI.\n- Render `client_metadata[\"x-codex-turn-metadata\"]`, flat\n`client_metadata` projections, and direct compatibility headers from\nthat same snapshot.\n- Include the known Codex-owned fields in the turn metadata blob,\nincluding installation/session/thread/turn/window IDs, request kind,\nlineage, sandbox/workspace metadata, timing, and compaction details.\n- Treat app-server `responsesapi_client_metadata` as enrichment for the\nCodex turn metadata blob while preventing those extras from overriding\nCodex-owned fields.\n- Use the same metadata path for normal turns, websocket prewarm, local\ncompaction, remote v1 compaction, and remote v2 compaction.\n- Keep websocket connection-only preconnect metadata separate so\nhandshakes carry compatibility identity headers without inventing a fake\nturn metadata blob.\n\n## Verification\n\n- `cargo check -p codex-core`\n- `just fix -p codex-core`","verified_at":"2026-06-11T20:42:10Z"}},"url":"https://api.github.com/repos/openai/codex/commits/14df0e8833aad0d6d78287954b61ffac67af936c","html_url":"https://github.com/openai/codex/commit/14df0e8833aad0d6d78287954b61ffac67af936c","comments_url":"https://api.github.com/repos/openai/codex/commits/14df0e8833aad0d6d78287954b61ffac67af936c/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"4a5a67649952e7a657c32d8534c42fdfc8db2448","url":"https://api.github.com/repos/openai/codex/commits/4a5a67649952e7a657c32d8534c42fdfc8db2448","html_url":"https://github.com/openai/codex/commit/4a5a67649952e7a657c32d8534c42fdfc8db2448"}]},{"sha":"4a5a67649952e7a657c32d8534c42fdfc8db2448","node_id":"C_kwDOOYsS4doAKDRhNWE2NzY0OTk1MmU3YTY1N2MzMmQ4NTM0YzQyZmRmYzhkYjI0NDg","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-11T19:54:52Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-11T19:54:52Z"},"message":"Resolve MCP server registrations through a catalog (#27634)\n\n## Why\n\nMCP servers currently come from user config, local plugins,\ncompatibility Apps synthesis, and host extensions. Those sources were\ncomposed by mutating a shared map, leaving registration identity,\nprecedence, removal, and provenance implicit in assembly order.\n\nBefore adding executor-owned MCPs, Codex needs one durable resolution\nboundary above `McpConnectionManager`. This PR introduces that boundary\nwhile preserving current server configuration, policy, and runtime\nbehavior. Executor-scoped registrations and explicit policy layers\nremain follow-ups.\n\n## What changed\n\n- Add typed `McpServerRegistration` inputs and an immutable\n`ResolvedMcpCatalog` in `codex-mcp`.\n- Retain each registration's complete `McpServerConfig`, including its\nenvironment binding, while recording its source and provenance.\n- Preserve the existing structural precedence between plugin, config,\ncompatibility, and ordered extension sources.\n- Resolve equal-precedence actions by contribution order; provenance IDs\nare used only for diagnostics and cannot affect the winner.\n- Preserve extension removals and the existing name-scoped `enabled =\nfalse` veto.\n- Report same-tier conflicts with every contender and the final catalog\noutcome, including whether the winning action registers or removes the\nserver.\n- Require MCP contributors to provide a stable diagnostic identity.\n- Derive materialized server maps and plugin ownership from the resolved\ncatalog.\n\n`McpConnectionManager`, transport startup, tool calls, and resource\nrouting continue to consume the same effective `McpServerConfig` values.\n\n## Scope\n\nThis PR does not add new MCP capabilities or change user-visible\nbehavior. It does not add executor plugin discovery, thread-scoped\nregistrations, dynamic refresh generations, or new user/managed policy\nsemantics.\n\n## Verification\n\n- Added focused catalog coverage for source precedence, complete\nconfiguration preservation, disabled vetoes, plugin ownership,\ncontribution-order tie breaking, removal outcomes, and conflict\ndiagnostics.\n- Extended hosted Apps coverage for ordered extension removal and\nApps-disabled hosts with and without the hosted extension installed.\n- `cargo check -p codex-mcp --tests -p codex-extension-api -p\ncodex-core`","tree":{"sha":"f05741e7fcd86b955e4990d1054a355ae528d11a","url":"https://api.github.com/repos/openai/codex/git/trees/f05741e7fcd86b955e4990d1054a355ae528d11a"},"url":"https://api.github.com/repos/openai/codex/git/commits/4a5a67649952e7a657c32d8534c42fdfc8db2448","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKxKMCRC1aQ7uu5UhlAAAVXQQAF6g7k18JFq76Uz7iHtYGKL2\no9VRgrMQdWfnV9Pib5DVK3EQ54iCBUvobXZ8qMOPlzWpO0qmIDl8lsqmjKpwvh/x\nFfzwfMLhuCh/zvlr/ya49b4yGKaMLH2Yp3KqIM7dNCpd9lzhZk7YoxsUxBLRL/NO\npVJC3M7AfeVBCMwhcgwbt+WODUvk5CmZXlof4eQs74qGQk+j2GlM+tzPwr8exvcc\n2RijjJdNJ/q/UIIykQszWYyerYHaCi4A4Cki3aDOWqCycf5srcc1XDYp89IYe9sb\nkSRVDGILlYNFBHpSMEvx7hgBlnHhugblMDlkjR8HgoKQMB7rW+XY/4/XJFUH9uYD\nwlaX4+/e6UrH8O2CyNppK5lUwuUTrgwDOPzj16/YN5nnUkjZz4dshpLzrhIma6/C\n71RjDDfetCDVXBSjzYfPVGeGDHvQZqXN3sMFA5q6/bwzrwwsbPZGGacpyDbz4ISi\nZYO3p2EZy+TJKz0liASVY/Uh5gz/CIUkWf0qhEPGRUwmaI4eZ3sZ1FZCGtlyzNgJ\nrrAl4IVKgJ7aqKcXu4BwyMKxNl5othsQ1mqtrt5QUYWSJ0GigO7RmE43LT5mS+F0\nu6Z9bTRKcnzScAuOlQJTDqKKs0GlGKgf7pRmrs461dy+lrid5/yY8uqh4TNcvdq6\nBFCgfXwwtmp5sHce79MZ\n=SJUt\n-----END PGP SIGNATURE-----\n","payload":"tree f05741e7fcd86b955e4990d1054a355ae528d11a\nparent 236b50125d7b3ef0a4a2d9e629ae67fa2bf431af\nauthor jif <jif@openai.com> 1781207692 +0100\ncommitter GitHub <noreply@github.com> 1781207692 +0200\n\nResolve MCP server registrations through a catalog (#27634)\n\n## Why\n\nMCP servers currently come from user config, local plugins,\ncompatibility Apps synthesis, and host extensions. Those sources were\ncomposed by mutating a shared map, leaving registration identity,\nprecedence, removal, and provenance implicit in assembly order.\n\nBefore adding executor-owned MCPs, Codex needs one durable resolution\nboundary above `McpConnectionManager`. This PR introduces that boundary\nwhile preserving current server configuration, policy, and runtime\nbehavior. Executor-scoped registrations and explicit policy layers\nremain follow-ups.\n\n## What changed\n\n- Add typed `McpServerRegistration` inputs and an immutable\n`ResolvedMcpCatalog` in `codex-mcp`.\n- Retain each registration's complete `McpServerConfig`, including its\nenvironment binding, while recording its source and provenance.\n- Preserve the existing structural precedence between plugin, config,\ncompatibility, and ordered extension sources.\n- Resolve equal-precedence actions by contribution order; provenance IDs\nare used only for diagnostics and cannot affect the winner.\n- Preserve extension removals and the existing name-scoped `enabled =\nfalse` veto.\n- Report same-tier conflicts with every contender and the final catalog\noutcome, including whether the winning action registers or removes the\nserver.\n- Require MCP contributors to provide a stable diagnostic identity.\n- Derive materialized server maps and plugin ownership from the resolved\ncatalog.\n\n`McpConnectionManager`, transport startup, tool calls, and resource\nrouting continue to consume the same effective `McpServerConfig` values.\n\n## Scope\n\nThis PR does not add new MCP capabilities or change user-visible\nbehavior. It does not add executor plugin discovery, thread-scoped\nregistrations, dynamic refresh generations, or new user/managed policy\nsemantics.\n\n## Verification\n\n- Added focused catalog coverage for source precedence, complete\nconfiguration preservation, disabled vetoes, plugin ownership,\ncontribution-order tie breaking, removal outcomes, and conflict\ndiagnostics.\n- Extended hosted Apps coverage for ordered extension removal and\nApps-disabled hosts with and without the hosted extension installed.\n- `cargo check -p codex-mcp --tests -p codex-extension-api -p\ncodex-core`","verified_at":"2026-06-11T19:54:53Z"}},"url":"https://api.github.com/repos/openai/codex/commits/4a5a67649952e7a657c32d8534c42fdfc8db2448","html_url":"https://github.com/openai/codex/commit/4a5a67649952e7a657c32d8534c42fdfc8db2448","comments_url":"https://api.github.com/repos/openai/codex/commits/4a5a67649952e7a657c32d8534c42fdfc8db2448/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"236b50125d7b3ef0a4a2d9e629ae67fa2bf431af","url":"https://api.github.com/repos/openai/codex/commits/236b50125d7b3ef0a4a2d9e629ae67fa2bf431af","html_url":"https://github.com/openai/codex/commit/236b50125d7b3ef0a4a2d9e629ae67fa2bf431af"}]},{"sha":"236b50125d7b3ef0a4a2d9e629ae67fa2bf431af","node_id":"C_kwDOOYsS4doAKDIzNmI1MDEyNWQ3YjNlZjBhNGEyZDllNjI5YWU2N2ZhMmJmNDMxYWY","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-11T19:28:47Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-11T19:28:47Z"},"message":"[codex] Load user instructions through an injected provider (#27101)\n\n## Why\n\nWe want to remove implicit use of `$CODEX_HOME` from `codex-core` and\nmake embedders responsible for supplying user-level instructions. This\nalso ensures user instructions load when no primary environment is\nselected.\n\n## What changed\n\nStacked on #27415, which makes `codex exec` surface thread-scoped\nruntime warnings.\n\n- Added `UserInstructionsProvider` to `codex-extension-api`, with\nabsolute source attribution and recoverable loading warnings.\n- Added `codex-home` with the filesystem-backed provider for\n`AGENTS.override.md` and `AGENTS.md`, preserving precedence, fallback,\ntrimming, lossy UTF-8 handling, and the existing uncapped global\ninstruction size.\n- Removed global instruction loading from `Config` and require\n`ThreadManager` callers to inject a provider.\n- Load provider instructions once for each fresh root runtime, including\nruntimes without a primary environment. Running sessions retain their\nsnapshot, while child agents inherit the parent snapshot without\ninvoking the provider.\n- Keep provider instructions separate while loading project `AGENTS.md`,\nthen assemble the model-visible instructions with the existing ordering,\nsource attribution, warning, and turn-context behavior.\n- Wired the Codex home provider through the CLI, app server, MCP server,\ncore facade, and thread-manager sample.\n\n## Validation\n\n- `just test -p codex-home -p codex-extension-api`\n- `just test -p codex-core agents_md`\n- `just test -p codex-core guardian`\n- `just test -p codex-app-server\nthread_start_without_selected_environment_includes_only_global_instruction_source`\n- `just test -p codex-exec warning`\n- `just bazel-lock-check`","tree":{"sha":"3086f153396fd7e2905affb6eb065823283092eb","url":"https://api.github.com/repos/openai/codex/git/trees/3086f153396fd7e2905affb6eb065823283092eb"},"url":"https://api.github.com/repos/openai/codex/git/commits/236b50125d7b3ef0a4a2d9e629ae67fa2bf431af","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKwxvCRC1aQ7uu5UhlAAACZgQAAP0q+cYv7vURlTji53XwU/J\nw+F9oYxxG6y90Q+HWh5g981zuZpzFjaDAy3ItvlJcjM74N1VYbAccz1cxzzB/pfe\nE1EqOZGQC5MQDTC9n4+wcTbi0OJTfKbmQsc310OIicleeYb34y1ohCpOzCRkikDM\nt6j4d7TJmbuk3+0uUAGitV+FxPq523YH8yfmXTmNXFYdlXRHU5DNzDXLNQgD/T6j\nkkFXyuWPakJNmEuATwqsmhEtJvk3d+uoBHaj78XywiVCDANow+qgI8AbljOXQitJ\nzeOpRQ2wkdAxb90VP5Xwx85s3unq83qNPR7ZvtpFK2a7pe8GmsfmCTfeaojx8jKN\nqJRyPhT5midC/onJ09LowUEGyqC+CGtW4G0iElUZYC3gy6Zy1NtG0zpyZkri1RO5\nYRN4WrxYkbi+Dw0Pfz8inb/X3DIUUvbhYDQ2mvSQfDIsKjnpEtS9QV2YeYNgC+/d\nLGrtvDsMf2KSRm+VoP5PnwQVYGGLylJIaFP/koxYnnflbiZ3bgKc59n7vFPsNK6o\naxAA6jPUsRnk0/Psr4MNkLPyIACiiTpC6Nvwq0b3dZ/1Zbz9ZwIWVWzUb/CI55s1\nqceGaAc0pbMs0fnH+fk/VDRgODdvJb79+62aNnomjXvt0XR85AWzpA137FuDHEA/\nSPDCTRTtjYZgyjFatGvo\n=Z0+i\n-----END PGP SIGNATURE-----\n","payload":"tree 3086f153396fd7e2905affb6eb065823283092eb\nparent b2a4e3be271e1119ae802a412f941d770ab0376a\nauthor Adam Perry @ OpenAI <anp@openai.com> 1781206127 -0700\ncommitter GitHub <noreply@github.com> 1781206127 +0000\n\n[codex] Load user instructions through an injected provider (#27101)\n\n## Why\n\nWe want to remove implicit use of `$CODEX_HOME` from `codex-core` and\nmake embedders responsible for supplying user-level instructions. This\nalso ensures user instructions load when no primary environment is\nselected.\n\n## What changed\n\nStacked on #27415, which makes `codex exec` surface thread-scoped\nruntime warnings.\n\n- Added `UserInstructionsProvider` to `codex-extension-api`, with\nabsolute source attribution and recoverable loading warnings.\n- Added `codex-home` with the filesystem-backed provider for\n`AGENTS.override.md` and `AGENTS.md`, preserving precedence, fallback,\ntrimming, lossy UTF-8 handling, and the existing uncapped global\ninstruction size.\n- Removed global instruction loading from `Config` and require\n`ThreadManager` callers to inject a provider.\n- Load provider instructions once for each fresh root runtime, including\nruntimes without a primary environment. Running sessions retain their\nsnapshot, while child agents inherit the parent snapshot without\ninvoking the provider.\n- Keep provider instructions separate while loading project `AGENTS.md`,\nthen assemble the model-visible instructions with the existing ordering,\nsource attribution, warning, and turn-context behavior.\n- Wired the Codex home provider through the CLI, app server, MCP server,\ncore facade, and thread-manager sample.\n\n## Validation\n\n- `just test -p codex-home -p codex-extension-api`\n- `just test -p codex-core agents_md`\n- `just test -p codex-core guardian`\n- `just test -p codex-app-server\nthread_start_without_selected_environment_includes_only_global_instruction_source`\n- `just test -p codex-exec warning`\n- `just bazel-lock-check`","verified_at":"2026-06-11T19:28:47Z"}},"url":"https://api.github.com/repos/openai/codex/commits/236b50125d7b3ef0a4a2d9e629ae67fa2bf431af","html_url":"https://github.com/openai/codex/commit/236b50125d7b3ef0a4a2d9e629ae67fa2bf431af","comments_url":"https://api.github.com/repos/openai/codex/commits/236b50125d7b3ef0a4a2d9e629ae67fa2bf431af/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b2a4e3be271e1119ae802a412f941d770ab0376a","url":"https://api.github.com/repos/openai/codex/commits/b2a4e3be271e1119ae802a412f941d770ab0376a","html_url":"https://github.com/openai/codex/commit/b2a4e3be271e1119ae802a412f941d770ab0376a"}]},{"sha":"b2a4e3be271e1119ae802a412f941d770ab0376a","node_id":"C_kwDOOYsS4doAKGIyYTRlM2JlMjcxZTExMTlhZTgwMmE0MTJmOTQxZDc3MGFiMDM3NmE","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-11T18:44:18Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-11T18:44:18Z"},"message":"[codex] migrate ExecutorFileSystem paths to PathUri (#27424)\n\n## Why\n\nWe're moving exec-server to use PathUri for its internal path\nrepresentations.\n\n## What\n\nMove `ExecutorFileSystem` APIs to use `PathUri` instead of\n`AbsolutePathBuf`. Future changes will convert higher-level parts of\nexec-server.","tree":{"sha":"75ff601163606d968c5aeb7c69797f49bb3661cc","url":"https://api.github.com/repos/openai/codex/git/trees/75ff601163606d968c5aeb7c69797f49bb3661cc"},"url":"https://api.github.com/repos/openai/codex/git/commits/b2a4e3be271e1119ae802a412f941d770ab0376a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKwICCRC1aQ7uu5UhlAAAcTQQAK/Jc/zzVxQ1TKfKTinl+fdz\nTets700AN9AmeycWfmmFXffdxXPQatIiabci9YqakAFAZH1Ed8pI0ktufBGNfkNA\n7HRJOfJX3U9qGQ4DcWJWh4JAqlW3OgP2IZqMNriRpzYfGaOVq2YmRxi4Sxh2pcFc\n5HwTyu5MugaV16Or9mIALTYOVe6zSBrig97ZL7VLLNOZzF3VSqYm5azNa1jVpE37\nH50JIFgnlyEhqm2MsJ9om5jcol/zSR9