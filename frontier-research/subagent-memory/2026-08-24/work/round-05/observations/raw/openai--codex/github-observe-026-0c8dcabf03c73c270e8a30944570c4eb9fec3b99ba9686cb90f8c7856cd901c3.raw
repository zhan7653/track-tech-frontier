pi.github.com/users/adaley-openai/orgs","repos_url":"https://api.github.com/users/adaley-openai/repos","events_url":"https://api.github.com/users/adaley-openai/events{/privacy}","received_events_url":"https://api.github.com/users/adaley-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"1b81365926670763246bdf791a5758b2b3264a9b","url":"https://api.github.com/repos/openai/codex/commits/1b81365926670763246bdf791a5758b2b3264a9b","html_url":"https://github.com/openai/codex/commit/1b81365926670763246bdf791a5758b2b3264a9b"}]},{"sha":"1b81365926670763246bdf791a5758b2b3264a9b","node_id":"C_kwDOOYsS4doAKDFiODEzNjU5MjY2NzA3NjMyNDZiZGY3OTFhNTc1OGIyYjMyNjRhOWI","commit":{"author":{"name":"Shijie Rao","email":"shijie.rao@openai.com","date":"2026-06-15T18:49:19Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T18:49:19Z"},"message":"Add request user input auto-resolution timer (#28235)\n\n## Summary\n- Add TUI auto-resolution handling for `request_user_input` prompts when\n`autoResolutionMs` is present.\n- Use a 60s hidden grace period followed by a 60s visible countdown,\nthen submit an empty answer response if the user does not interact.\n- Snooze auto-resolution on key or paste interaction and add\nsnapshot/test coverage for the countdown UI.\n\n## Notes\n- The TUI currently treats `autoResolutionMs` as an enable signal and\nintentionally does not use the provided duration value for the countdown\npolicy.\n\n### Auto resolution\n\n\nhttps://github.com/user-attachments/assets/5323152f-2ece-4aba-b75d-c32aa776f544\n\n\n### Snooze after interaction\n\n\nhttps://github.com/user-attachments/assets/100d54c4-3a41-4c6c-9c07-cd28075a0d62","tree":{"sha":"3642b88ffc9d670054318c20e039b6a73a0093d4","url":"https://api.github.com/repos/openai/codex/git/trees/3642b88ffc9d670054318c20e039b6a73a0093d4"},"url":"https://api.github.com/repos/openai/codex/git/commits/1b81365926670763246bdf791a5758b2b3264a9b","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMEkvCRC1aQ7uu5UhlAAAzWgQAE0FeyvdfhbtsdnqS3a/g4ta\ntRHZhTiHlNUCclrRQQlc6NjfRxSwIgoinOItwY1CnVmnUYO6rDO/3GpdHSZT4GxC\nWBQjiF0L1fYjiDyXr1pjy55WrNhnRIVp8r4ylcO1WyIfOVaCxt2UQzXwC8Yxpi3b\n6jvlXQh5OxFBElCokeGcfkbS38aQBrQ8tX4XmwCJE6RofRmX1Tma5Dd8du1e7yGZ\nogwCznSb77QP9Ee6PqWE9mVuJeCm0FwXyLIBkIuEGloIW3IkAsgf+KLI0HzMFSPN\nS7QtpSmfCmdCxrCP4anpCDK9bFRxELr0e3XvQAV7X/WcAgyoxFA4Dmh7OenVSVZZ\nCQpbo0RQTzXcoc3FszDPmuLLxD9mmfGYxhTHvdlHSo+eUsODNyl1R8FvPoxwerp7\nBYET1sRCsRU1nMmyZapOAmdm+Ou3Rx6pCX5D9higIQlEFiS5qLwAYwNHZyTjxl1h\nOnEvmTWKgXAL3cdgLcuif3hXcKnUavlgM0YoaOxD69rI4SSD2NVijWyydd9yLKLx\nt9OYWmEGkiv20PeickMnbQlKNYujH8gyl0PLKrZxV6s5AYLGMDLMGpYCElwrCyOW\nDGLOWl3tf9CuxcT7AvvugwlYhKzLVuEH8CtiScISrkt9K6oW25UQU44fnV4xSsEF\noIi3kgrnjcjGzyuud60s\n=9s4P\n-----END PGP SIGNATURE-----\n","payload":"tree 3642b88ffc9d670054318c20e039b6a73a0093d4\nparent 71633f8b8f7a6ddd7f5a23f68afa2850b5ad8511\nauthor Shijie Rao <shijie.rao@openai.com> 1781549359 -0700\ncommitter GitHub <noreply@github.com> 1781549359 -0700\n\nAdd request user input auto-resolution timer (#28235)\n\n## Summary\n- Add TUI auto-resolution handling for `request_user_input` prompts when\n`autoResolutionMs` is present.\n- Use a 60s hidden grace period followed by a 60s visible countdown,\nthen submit an empty answer response if the user does not interact.\n- Snooze auto-resolution on key or paste interaction and add\nsnapshot/test coverage for the countdown UI.\n\n## Notes\n- The TUI currently treats `autoResolutionMs` as an enable signal and\nintentionally does not use the provided duration value for the countdown\npolicy.\n\n### Auto resolution\n\n\nhttps://github.com/user-attachments/assets/5323152f-2ece-4aba-b75d-c32aa776f544\n\n\n### Snooze after interaction\n\n\nhttps://github.com/user-attachments/assets/100d54c4-3a41-4c6c-9c07-cd28075a0d62","verified_at":"2026-06-15T18:49:20Z"}},"url":"https://api.github.com/repos/openai/codex/commits/1b81365926670763246bdf791a5758b2b3264a9b","html_url":"https://github.com/openai/codex/commit/1b81365926670763246bdf791a5758b2b3264a9b","comments_url":"https://api.github.com/repos/openai/codex/commits/1b81365926670763246bdf791a5758b2b3264a9b/comments","author":{"login":"shijie-oai","id":235382242,"node_id":"U_kgDODgel4g","avatar_url":"https://avatars.githubusercontent.com/u/235382242?v=4","gravatar_id":"","url":"https://api.github.com/users/shijie-oai","html_url":"https://github.com/shijie-oai","followers_url":"https://api.github.com/users/shijie-oai/followers","following_url":"https://api.github.com/users/shijie-oai/following{/other_user}","gists_url":"https://api.github.com/users/shijie-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/shijie-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shijie-oai/subscriptions","organizations_url":"https://api.github.com/users/shijie-oai/orgs","repos_url":"https://api.github.com/users/shijie-oai/repos","events_url":"https://api.github.com/users/shijie-oai/events{/privacy}","received_events_url":"https://api.github.com/users/shijie-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"71633f8b8f7a6ddd7f5a23f68afa2850b5ad8511","url":"https://api.github.com/repos/openai/codex/commits/71633f8b8f7a6ddd7f5a23f68afa2850b5ad8511","html_url":"https://github.com/openai/codex/commit/71633f8b8f7a6ddd7f5a23f68afa2850b5ad8511"}]},{"sha":"71633f8b8f7a6ddd7f5a23f68afa2850b5ad8511","node_id":"C_kwDOOYsS4doAKDcxNjMzZjhiOGY3YTZkZGQ3ZjVhMjNmNjhhZmEyODUwYjVhZDg1MTE","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-15T18:48:31Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T18:48:31Z"},"message":"[codex] add path-types skill (#28347)\n\n## Why\n\nCodex contributors and agents need repository-scoped guidance for\nchoosing compatible Rust types\nfor operating system paths during the ongoing URI migration. Keeping the\nguidance in the repository\nmakes the app-server and exec-server rules available consistently\nwithout relying on a personal\nskill installation.\n\n## What\n\n- Add the `path-types` skill at `.codex/skills/path-types/SKILL.md`.\n- Document the intended uses of `ApiPathString`, `PathUri`,\n`AbsolutePathBuf`, and `PathBuf` across\n  protocol, internal, and shared dependency boundaries.\n- Keep migrations of existing types limited to explicit requests and\nproportional edits.\n\n## Validation\n\n- Validated the skill structure with skill-creator's\n`quick_validate.py`.","tree":{"sha":"2a97d0e9ffb926c4a7450185e88b32fc5b520abc","url":"https://api.github.com/repos/openai/codex/git/trees/2a97d0e9ffb926c4a7450185e88b32fc5b520abc"},"url":"https://api.github.com/repos/openai/codex/git/commits/71633f8b8f7a6ddd7f5a23f68afa2850b5ad8511","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMEj/CRC1aQ7uu5UhlAAAJw0QAF4ZmjH6ayStnOB9earfR4v+\nzt6bMU/63We0P/bZ7eX7FpsllUS/PFcTFs9kyZw5Mg4UWe4tSkWK/w0qO/00teLM\nEBAE0WJc2USQ0ksWEqA1vUQcwqdooz90mDdpWNQhJvXjAFOZt60doCRpBHs6Efv3\nd0JGsGWGJNyS5ZpODcsp+m1cKNxk6JQ1OaH9zGJw0bbjYPFv4lfvsHIul3ATngBO\njqpFZv2AAjPf02Umq/2bYPt43PPfbm8y5tSlHBOjdE7qam6K2oCTDS0oSLLHb5Cr\nq/1Lm1Ij7uMOw5bIMKKnkUDzYfRK+uvaEbjJLqutaYdyrghJWsw4l2rwaV6SNit1\nMtOigr+bYH9Rm0leUW/rI33XsfDwABkmcEukr+rV7d9mib7Z6QaR1atXyzg7bg8n\n2n8HJgKbhQo5bqdBjOuB80SiYU7eYHjpvOcoAh1W70jMlUWsxX/fwyZaIViRuw+Z\nKrICgXSg4DAmuNv+IZVUNyr4WO966dEx5lW0G+qGJGqKDF5SPCtBRoyDYVB6SBkn\nqLuW7xqfY0sS8fBFSx2uoXq0gb+sysICh/YklvYV4vkvOQHThbdEuc5QteMvjXlN\n0fzbatiCyoDXG5Kb3+5zH2qWOt5rpPZdc/OkgQCAxeXlhVAn0CUKofN0iGWrdD6I\n0FLkJXmMJHwkPh+BIgpX\n=yzUm\n-----END PGP SIGNATURE-----\n","payload":"tree 2a97d0e9ffb926c4a7450185e88b32fc5b520abc\nparent d5a8117e087fc1201cf059a2add082e7529022e3\nauthor Adam Perry @ OpenAI <anp@openai.com> 1781549311 -0700\ncommitter GitHub <noreply@github.com> 1781549311 -0700\n\n[codex] add path-types skill (#28347)\n\n## Why\n\nCodex contributors and agents need repository-scoped guidance for\nchoosing compatible Rust types\nfor operating system paths during the ongoing URI migration. Keeping the\nguidance in the repository\nmakes the app-server and exec-server rules available consistently\nwithout relying on a personal\nskill installation.\n\n## What\n\n- Add the `path-types` skill at `.codex/skills/path-types/SKILL.md`.\n- Document the intended uses of `ApiPathString`, `PathUri`,\n`AbsolutePathBuf`, and `PathBuf` across\n  protocol, internal, and shared dependency boundaries.\n- Keep migrations of existing types limited to explicit requests and\nproportional edits.\n\n## Validation\n\n- Validated the skill structure with skill-creator's\n`quick_validate.py`.","verified_at":"2026-06-15T18:48:32Z"}},"url":"https://api.github.com/repos/openai/codex/commits/71633f8b8f7a6ddd7f5a23f68afa2850b5ad8511","html_url":"https://github.com/openai/codex/commit/71633f8b8f7a6ddd7f5a23f68afa2850b5ad8511","comments_url":"https://api.github.com/repos/openai/codex/commits/71633f8b8f7a6ddd7f5a23f68afa2850b5ad8511/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"d5a8117e087fc1201cf059a2add082e7529022e3","url":"https://api.github.com/repos/openai/codex/commits/d5a8117e087fc1201cf059a2add082e7529022e3","html_url":"https://github.com/openai/codex/commit/d5a8117e087fc1201cf059a2add082e7529022e3"}]},{"sha":"d5a8117e087fc1201cf059a2add082e7529022e3","node_id":"C_kwDOOYsS4doAKGQ1YTgxMTdlMDg3ZmMxMjAxY2YwNTlhMmFkZDA4MmU3NTI5MDIyZTM","commit":{"author":{"name":"malsamiri-oai","email":"malsamiri@openai.com","date":"2026-06-15T18:32:13Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T18:32:13Z"},"message":"Use aws-lc-rs for rustls crypto provider (#27706)\n\n## Why\n\nSome enterprise TLS proxies issue certificate chains signed with\n`ecdsa_secp521r1_sha512` / `ECDSA_NISTP521_SHA512`. Custom CA\nconfiguration such as `SSL_CERT_FILE` can add the right trust root, but\nit cannot make `rustls`'s `ring` verifier support a certificate\nsignature algorithm it does not advertise.\n\nThat can still break TLS after the CA bundle is configured, including on\nRust websocket paths that call the shared\n`ensure_rustls_crypto_provider()` helper, such as the Responses\nwebsocket connector and remote app-server client:\n\n-\n[`codex-api/src/endpoint/responses_websocket.rs`](https://github.com/openai/codex/blob/eddc5c75ed527a8348bfcaa85692e53189600833/codex-rs/codex-api/src/endpoint/responses_websocket.rs#L441)\n-\n[`app-server-client/src/remote.rs`](https://github.com/openai/codex/blob/eddc5c75ed527a8348bfcaa85692e53189600833/codex-rs/app-server-client/src/remote.rs#L718)\n\nThe `aws-lc-rs` `rustls` provider supports this P-521/SHA-512\ncertificate signature scheme, so use it as Codex's process-wide `rustls`\nprovider.\n\n## What Changed\n\n- Switch the workspace `rustls` feature from `ring` to `aws_lc_rs`.\n- Update `codex-utils-rustls-provider` to install\n`rustls::crypto::aws_lc_rs::default_provider()`.\n- Add an assertion and integration test that the installed provider\nsupports `ECDSA_NISTP521_SHA512`.\n\n## Verification\n\n```shell\njust fmt\njust test -p codex-utils-rustls-provider\njust bazel-lock-update\njust bazel-lock-check\n```","tree":{"sha":"fda53692340f64ce33b289b775a51b55a681305f","url":"https://api.github.com/repos/openai/codex/git/trees/fda53692340f64ce33b289b775a51b55a681305f"},"url":"https://api.github.com/repos/openai/codex/git/commits/d5a8117e087fc1201cf059a2add082e7529022e3","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMEUtCRC1aQ7uu5UhlAAABX0QAKiLHfymzBuX/Yl0TNJOFoFa\n0gAV+ypEBeDiGlm2v3w9JI/vtlvfTmHyZ3bNU5M5DXKIFGz+WheenKxJhFgHQybY\nwqMtr69jEycTiY32dFj6gudGohSupRKjaeWNJs5Lp/u89LrnP4uxUxAiwDiG7m07\nNLdy95KrVZ00bVU5cWplXb0sTFRKGpvouGey9JLlCQeUc7UcWBoHebFmUb9ippvk\njHvj0XUYTkhXtO7MXeFYuQVI8Ec41cikpFbiPu0CLIgiNoZnWwyflvBlxxvrmKvw\neYOB/GAKoJYCRS5Ba+T6yde1j1YBjdDbnuS8h4Ddw5V7r1hpxP7sK+Iuu5K+bub6\nQBL38NziQE/iX6ToOQxMiwp3xpmHXUqEfMeOxxOb5n3o/pt0PNwm/52/Yqim5Jrn\n2VOTvXAgxYWBtTD77HsObBjQPdmhpw1HSkvzh0pdbL+gwGZIbcVSwATKe73fg3NE\n5IZRH7IOMqbtBsq2gc0qtl/KnkTK7doqQh1qRD0iB2BJSBV8Z/RArXgfhBGwgYBC\nHHSUfRykpdRd+DEc7Q3Yd0dEPshh9eU2eq1S9DwfPVaAJPRMUixqMWxPuIgZZxJl\nj5lIuGOUND9PhYA0gW5zWodWnmKQLiEfz4rV2Lt+GKiLpEV1xM2/j1BTipmXIYgH\nPtZDcye1wy3evtC6vPz0\n=fiVs\n-----END PGP SIGNATURE-----\n","payload":"tree fda53692340f64ce33b289b775a51b55a681305f\nparent c3415f76c91065e3180892afe1c99e8b4f47ac57\nauthor malsamiri-oai <malsamiri@openai.com> 1781548333 -0700\ncommitter GitHub <noreply@github.com> 1781548333 -0700\n\nUse aws-lc-rs for rustls crypto provider (#27706)\n\n## Why\n\nSome enterprise TLS proxies issue certificate chains signed with\n`ecdsa_secp521r1_sha512` / `ECDSA_NISTP521_SHA512`. Custom CA\nconfiguration such as `SSL_CERT_FILE` can add the right trust root, but\nit cannot make `rustls`'s `ring` verifier support a certificate\nsignature algorithm it does not advertise.\n\nThat can still break TLS after the CA bundle is configured, including on\nRust websocket paths that call the shared\n`ensure_rustls_crypto_provider()` helper, such as the Responses\nwebsocket connector and remote app-server client:\n\n-\n[`codex-api/src/endpoint/responses_websocket.rs`](https://github.com/openai/codex/blob/eddc5c75ed527a8348bfcaa85692e53189600833/codex-rs/codex-api/src/endpoint/responses_websocket.rs#L441)\n-\n[`app-server-client/src/remote.rs`](https://github.com/openai/codex/blob/eddc5c75ed527a8348bfcaa85692e53189600833/codex-rs/app-server-client/src/remote.rs#L718)\n\nThe `aws-lc-rs` `rustls` provider supports this P-521/SHA-512\ncertificate signature scheme, so use it as Codex's process-wide `rustls`\nprovider.\n\n## What Changed\n\n- Switch the workspace `rustls` feature from `ring` to `aws_lc_rs`.\n- Update `codex-utils-rustls-provider` to install\n`rustls::crypto::aws_lc_rs::default_provider()`.\n- Add an assertion and integration test that the installed provider\nsupports `ECDSA_NISTP521_SHA512`.\n\n## Verification\n\n```shell\njust fmt\njust test -p codex-utils-rustls-provider\njust bazel-lock-update\njust bazel-lock-check\n```","verified_at":"2026-06-15T18:32:14Z"}},"url":"https://api.github.com/repos/openai/codex/commits/d5a8117e087fc1201cf059a2add082e7529022e3","html_url":"https://github.com/openai/codex/commit/d5a8117e087fc1201cf059a2add082e7529022e3","comments_url":"https://api.github.com/repos/openai/codex/commits/d5a8117e087fc1201cf059a2add082e7529022e3/comments","author":{"login":"malsamiri-oai","id":247488832,"node_id":"U_kgDODsBhQA","avatar_url":"https://avatars.githubusercontent.com/u/247488832?v=4","gravatar_id":"","url":"https://api.github.com/users/malsamiri-oai","html_url":"https://github.com/malsamiri-oai","followers_url":"https://api.github.com/users/malsamiri-oai/followers","following_url":"https://api.github.com/users/malsamiri-oai/following{/other_user}","gists_url":"https://api.github.com/users/malsamiri-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/malsamiri-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/malsamiri-oai/subscriptions","organizations_url":"https://api.github.com/users/malsamiri-oai/orgs","repos_url":"https://api.github.com/users/malsamiri-oai/repos","events_url":"https://api.github.com/users/malsamiri-oai/events{/privacy}","received_events_url":"https://api.github.com/users/malsamiri-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c3415f76c91065e3180892afe1c99e8b4f47ac57","url":"https://api.github.com/repos/openai/codex/commits/c3415f76c91065e3180892afe1c99e8b4f47ac57","html_url":"https://github.com/openai/codex/commit/c3415f76c91065e3180892afe1c99e8b4f47ac57"}]},{"sha":"c3415f76c91065e3180892afe1c99e8b4f47ac57","node_id":"C_kwDOOYsS4doAKGMzNDE1Zjc2YzkxMDY1ZTMxODA4OTJhZmUxYzk5ZThiNGY0N2FjNTc","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-06-15T18:30:48Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T18:30:48Z"},"message":"Extract shared Windows sandbox session runner (#28357)\n\n## Why\n\nThis is the first PR in a stack for the Windows fs-helper sandbox fix.\nBefore changing fs-helper behavior, this pulls the reusable Windows\nsandbox session launch pieces out of the debug CLI path so later PRs can\ncall the same backend selection and stdio forwarding logic.\n\nKeeping this as a pure refactor makes the later security fix easier to\nreview: `codex sandbox windows` should continue to launch the same\nelevated or restricted-token backend, just through shared APIs in\n`windows-sandbox-rs` instead of code local to\n`cli/src/debug_sandbox.rs`.\n\n## What Changed\n\n- Added `WindowsSandboxSessionRequest` and\n`spawn_windows_sandbox_session_for_level()` in `windows-sandbox-rs` to\nshare the elevated-vs-legacy session launch decision.\n- Moved the Windows sandbox stdio forwarding helpers from\n`cli/src/debug_sandbox.rs` into\n`windows-sandbox-rs/src/stdio_bridge.rs`.\n- Updated `codex sandbox windows` to call the shared session launcher\nand stdio bridge.\n- Added unit coverage for the moved stdio forwarding helpers.\n\n## Verification\n\n- `just bazel-lock-update`\n- `just bazel-lock-check`\n- `just test -p codex-windows-sandbox stdio_bridge::tests`\n- `just fix -p codex-windows-sandbox -p codex-sandboxing -p\ncodex-exec-server -p codex-arg0 -p codex-core -p codex-file-system`\n- The new `stdio_bridge` tests also passed as part of `just test -p\ncodex-windows-sandbox` on the stack tip. That full local run still fails\nin pre-existing legacy session integration tests with\n`CreateRestrictedToken failed: 87` on this workstation.","tree":{"sha":"2783820517437c1cc417b7032881a82423c28aeb","url":"https://api.github.com/repos/openai/codex/git/trees/2783820517437c1cc417b7032881a82423c28aeb"},"url":"https://api.github.com/repos/openai/codex/git/commits/c3415f76c91065e3180892afe1c99e8b4f47ac57","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMETYCRC1aQ7uu5UhlAAA9aoQAIqUMKbbZv9HNx5wGVIkRTV0\n9znuajbFwEU+1M8oSiZEtXCXKdeWVx/WRhDLTgIaoNj0+rhxGJQaMF+u15tuGIHe\nOoWZokkbMNOIBRGWGbuRy0arfnaqvn2D6UVd0UmrNJAUR0r4jwlGzrWawXZlN9ZL\nxARqD0P5mhglkycFRMvwq7Yy+cdoKiJif+bYjo3sA9wSD5BMR/h9HGf8+Lt/UaHA\na25E/85SbtLiu9lQMHI4zr7ubXkcfuR/i086kMKpySuXyTCQW7f0uqzjVXRRUoUe\n8//2zPtXxSLtl2b9tDPgiU/FMKWPJjhJIWvDFdpghzGYottbbi5hy849OyO8YDmA\n6CHItrZR28mu+QvtzVOeKERP4/mlmrd/5M7K11QppZKITbRLrQWbsApnMx79TKXz\ndLeSXVb7ckSfkk3WDwXpoVpXOQlaNkwQOuhp9905Aj++D00bzElY+fncp6krjZLJ\nYkHlhpoecD6b5vw5popuEG2ocGhZvEGSx84Gl1z0ZaJHDFQYl/61m7uYwaC2iUkC\noqI4uEpMcOFJHMyRWGIJd3H5WfHi28T7NKDUvedvD6rYLXA108MNF1x1yXqEUSrI\nxtzOLk3EV4DHdYwvQPLKCXVrUeWlWqNrM65JcoESVJQc/UPMyBn3+E4JR43zHe4M\nkXK3fCXG6DIYZlxZklm9\n=8Cvx\n-----END PGP SIGNATURE-----\n","payload":"tree 2783820517437c1cc417b7032881a82423c28aeb\nparent 0afe559318cddc3c47e508944b7bf2ee5791f43d\nauthor iceweasel-oai <iceweasel@openai.com> 1781548248 -0700\ncommitter GitHub <noreply@github.com> 1781548248 +0000\n\nExtract shared Windows sandbox session runner (#28357)\n\n## Why\n\nThis is the first PR in a stack for the Windows fs-helper sandbox fix.\nBefore changing fs-helper behavior, this pulls the reusable Windows\nsandbox session launch pieces out of the debug CLI path so later PRs can\ncall the same backend selection and stdio forwarding logic.\n\nKeeping this as a pure refactor makes the later security fix easier to\nreview: `codex sandbox windows` should continue to launch the same\nelevated or restricted-token backend, just through shared APIs in\n`windows-sandbox-rs` instead of code local to\n`cli/src/debug_sandbox.rs`.\n\n## What Changed\n\n- Added `WindowsSandboxSessionRequest` and\n`spawn_windows_sandbox_session_for_level()` in `windows-sandbox-rs` to\nshare the elevated-vs-legacy session launch decision.\n- Moved the Windows sandbox stdio forwarding helpers from\n`cli/src/debug_sandbox.rs` into\n`windows-sandbox-rs/src/stdio_bridge.rs`.\n- Updated `codex sandbox windows` to call the shared session launcher\nand stdio bridge.\n- Added unit coverage for the moved stdio forwarding helpers.\n\n## Verification\n\n- `just bazel-lock-update`\n- `just bazel-lock-check`\n- `just test -p codex-windows-sandbox stdio_bridge::tests`\n- `just fix -p codex-windows-sandbox -p codex-sandboxing -p\ncodex-exec-server -p codex-arg0 -p codex-core -p codex-file-system`\n- The new `stdio_bridge` tests also passed as part of `just test -p\ncodex-windows-sandbox` on the stack tip. That full local run still fails\nin pre-existing legacy session integration tests with\n`CreateRestrictedToken failed: 87` on this workstation.","verified_at":"2026-06-15T18:30:48Z"}},"url":"https://api.github.com/repos/openai/codex/commits/c3415f76c91065e3180892afe1c99e8b4f47ac57","html_url":"https://github.com/openai/codex/commit/c3415f76c91065e3180892afe1c99e8b4f47ac57","comments_url":"https://api.github.com/repos/openai/codex/commits/c3415f76c91065e3180892afe1c99e8b4f47ac57/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"0afe559318cddc3c47e508944b7bf2ee5791f43d","url":"https://api.github.com/repos/openai/codex/commits/0afe559318cddc3c47e508944b7bf2ee5791f43d","html_url":"https://github.com/openai/codex/commit/0afe559318cddc3c47e508944b7bf2ee5791f43d"}]},{"sha":"0afe559318cddc3c47e508944b7bf2ee5791f43d","node_id":"C_kwDOOYsS4doAKDBhZmU1NTkzMThjZGRjM2M0N2U1MDg5NDRiN2JmMmVlNTc5MWY0M2Q","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-15T18:20:19Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T18:20:19Z"},"message":"skills: cache orchestrator resources per thread (#28336)\n\n## Why\n\nHosted orchestrator skills are read through the remote MCP resource\nserver. Within one thread, the same catalog or skill resource can be\nrequested multiple times by prompt injection and the `skills.list` /\n`skills.read` tools. Re-fetching adds latency and can make those\nsurfaces observe different remote contents during the same thread.\n\nThis is a follow-up to #28333: orchestrator skills remain limited to\nthreads without a local executor, and those threads now get a stable\nper-thread view of the remote skill data they use.\n\n## What changed\n\n- Reuse the existing per-thread orchestrator catalog snapshot for\n`skills.list` and `skills.read` availability checks.\n- Cache successful orchestrator resource reads by authority, package,\nand resource so prompt injection and tool calls share the same contents.\n- Keep the cache memory-only and bounded to 100 resources and 8 MiB per\nthread.\n- Leave host and executor skill reads unchanged, and do not cache failed\nremote reads.\n\n## Verification\n\n- Extended the app-server MCP resource integration test to read the same\nhosted skill resource twice and verify that the remote server receives\none read.\n- The same test verifies that catalog discovery and the selected skill's\nmain prompt are each fetched only once per thread.","tree":{"sha":"89a7f7d23405995c50e8f2e78c7d097388c858ee","url":"https://api.github.com/repos/openai/codex/git/trees/89a7f7d23405995c50e8f2e78c7d097388c858ee"},"url":"https://api.github.com/repos/openai/codex/git/commits/0afe559318cddc3c47e508944b7bf2ee5791f43d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMEJjCRC1aQ7uu5UhlAAAjmMQAAFs75T91nI4l//VP2dX/Wxc\nXDBSPuS+aLLVVHYMs1et2ncmAurE0R0uvInjbTn4MZ4W3ksBzp6PYsJMMwVRVxMR\nx759QWw97W0NGpS+EekpgqZ84KMaF8ekvbK3j9OhjCdhDsxGQcsW9FnSuUvYdRcK\nvzp0Jxk52HxqPHoC6ZjcS7Wk+ASsjbUs9DDI1QQriRS4APhKsGbZQCQfYJ5rkKFz\n8tWTg9fy/0zM6FAyaT3dOGL2wpbgazd5e9LvhPtfR7JpuIzoikOo6pme84oAU97D\nr7MHaPOG+1OYaVnlysvCw/4ZSy89VLp4XmncYvn7ZPbTbYBkm/PimoU3ZA7FUFfk\ntZpHe3twk2UXol0gLb0Cegadv8LQ/u9cT04zO177r3U4F27kOjtlE5pALLuQonNX\nFfYRx822zzNhimYf+oz56dVO6n/f//BcYMilb7L+ajOGtp4k/usooNmyktsWJz6B\nM4TSQhQZbJrVQMoSUiKKSoBJ9Jc8jn2TvQVLh9/zllVfesQgUkQf8qC0IkKcNc0W\ndpcT58juQhFn79GwCAHJFT3UpdX9vDqffMUUKACfqkrINpIa7iGxVGGO56wNIE5v\nx7ox/3s5p+x7r2bPdA3nyGllaSw+8gX8dfC1KRB1lNRz+3+01zvH9XLk/tyk6ioc\nmdYGqcQhKaCS1bEqpK+c\n=mMZF\n-----END PGP SIGNATURE-----\n","payload":"tree 89a7f7d23405995c50e8f2e78c7d097388c858ee\nparent ee40dddbf6a50a6f0641180ca299be7a3a03fd22\nauthor jif <jif@openai.com> 1781547619 +0100\ncommitter GitHub <noreply@github.com> 1781547619 +0200\n\nskills: cache orchestrator resources per thread (#28336)\n\n## Why\n\nHosted orchestrator skills are read through the remote MCP resource\nserver. Within one thread, the same catalog or skill resource can be\nrequested multiple times by prompt injection and the `skills.list` /\n`skills.read` tools. Re-fetching adds latency and can make those\nsurfaces observe different remote contents during the same thread.\n\nThis is a follow-up to #28333: orchestrator skills remain limited to\nthreads without a local executor, and those threads now get a stable\nper-thread view of the remote skill data they use.\n\n## What changed\n\n- Reuse the existing per-thread orchestrator catalog snapshot for\n`skills.list` and `skills.read` availability checks.\n- Cache successful orchestrator resource reads by authority, package,\nand resource so prompt injection and tool calls share the same contents.\n- Keep the cache memory-only and bounded to 100 resources and 8 MiB per\nthread.\n- Leave host and executor skill reads unchanged, and do not cache failed\nremote reads.\n\n## Verification\n\n- Extended the app-server MCP resource integration test to read the same\nhosted skill resource twice and verify that the remote server receives\none read.\n- The same test verifies that catalog discovery and the selected skill's\nmain prompt are each fetched only once per thread.","verified_at":"2026-06-15T18:20:20Z"}},"url":"https://api.github.com/repos/openai/codex/commits/0afe559318cddc3c47e508944b7bf2ee5791f43d","html_url":"https://github.com/openai/codex/commit/0afe559318cddc3c47e508944b7bf2ee5791f43d","comments_url":"https://api.github.com/repos/openai/codex/commits/0afe559318cddc3c47e508944b7bf2ee5791f43d/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"ee40dddbf6a50a6f0641180ca299be7a3a03fd22","url":"https://api.github.com/repos/openai/codex/commits/ee40dddbf6a50a6f0641180ca299be7a3a03fd22","html_url":"https://github.com/openai/codex/commit/ee40dddbf6a50a6f0641180ca299be7a3a03fd22"}]},{"sha":"ee40dddbf6a50a6f0641180ca299be7a3a03fd22","node_id":"C_kwDOOYsS4doAKGVlNDBkZGRiZjZhNTBhNmYwNjQxMTgwY2EyOTliZTdhM2EwM2ZkMjI","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-15T18:08:15Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T18:08:15Z"},"message":"core: let steer interrupt wait_agent (#28341)\n\n## Why\n\n`wait_agent` can block for a long timeout while waiting for sub-agent\nmailbox activity. Although same-turn user steer is accepted during that\ntool call, the input remains pending until the wait returns, so an\nexplicit request to change direction can appear unresponsive.\n\n## What changed\n\n- Notify active `wait_agent` calls when user input is steered into the\ncurrent turn.\n- Check for already-pending steer input when subscribing so input that\nraces with tool startup is not missed.\n- Distinguish mailbox activity, steered input, and timeout outcomes,\nreturning `Wait interrupted by new input.` for the steer path.\n- Update the `wait_agent` tool description to document the early-return\nbehavior.\n\n## Testing\n\n- `just test -p codex-core input_queue_`\n- `just test -p codex-core wait_agent`\n\nThe coverage includes steer notification before and after subscription,\nplus an end-to-end test that verifies the interrupted wait result and\nsteered user input are both included exactly once in the follow-up model\nrequest.","tree":{"sha":"079bae4dce3e084222b42fab421b501e84611fb0","url":"https://api.github.com/repos/openai/codex/git/trees/079bae4dce3e084222b42fab421b501e84611fb0"},"url":"https://api.github.com/repos/openai/codex/git/commits/ee40dddbf6a50a6f0641180ca299be7a3a03fd22","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMD+PCRC1aQ7uu5UhlAAAmOcQAFIwK3VuQnshr7ZbAqVysFDB\nCySYtDyurOP7SFctylIg0tDdVWBPVkIAC+KvdPNdEhOK19kd8WV8LRo/zIiMIEhi\npTHXWd3qLJdB+ANKXZIW8TG6ctV8HLw6VX1luIxLNWa+JdROhxM81YrG/SCGgjUa\nnKiqrZfpZjz6ucccHxQre6v3Dn6MTyA6g4R4rbF5jIhrlACxulWXNgI8FGVmS0vf\nkCxSL4H92Jb3V1prMuCkzfQLsiLVMrwC+xIrNsGvOHCPvlhOJUu9csv6u6R/qEbt\nDcOKrD/FJd/LjZ8myzGpWO2LoIQcPyDk5fhVkdLrul1/PHB6+SFmeDkuLTH7wfYL\nPtwpKq4/aepwFL9283qlDO/E3RthuPXjczQ4+bBb89gYW2y501/fOMZXqh1clSG3\nR7FgOaWZID24wwQUDGbDSX6rb2XkijaixMabBGHjVfGSAzXKi9Dkgnrey1WoPAkB\nxChnJJqjIfkGT/kyr0rvqwrTi7OaTKJ6PV89CsdO+eMjmjbDZnCgjSjh+6UsfakF\n/Qx5G1fRrZoZSbHuSl/JMJgs99Z7dCB7V7ChxpDy92PDwJcJDY17rEybZIfcJaxC\nDIZIjDi5lqHEE1gB+8tM+61S4TheBDNyG/YCa1f4wgcoROGuJKqDt+Oz/JjPSosv\nUIkGdazzXgqWggbleRFt\n=X28g\n-----END PGP SIGNATURE-----\n","payload":"tree 079bae4dce3e084222b42fab421b501e84611fb0\nparent 336f907ec1f8c05f856f304efaac0d4cb1ea3b57\nauthor jif <jif@openai.com> 1781546895 +0100\ncommitter GitHub <noreply@github.com> 1781546895 +0200\n\ncore: let steer interrupt wait_agent (#28341)\n\n## Why\n\n`wait_agent` can block for a long timeout while waiting for sub-agent\nmailbox activity. Although same-turn user steer is accepted during that\ntool call, the input remains pending until the wait returns, so an\nexplicit request to change direction can appear unresponsive.\n\n## What changed\n\n- Notify active `wait_agent` calls when user input is steered into the\ncurrent turn.\n- Check for already-pending steer input when subscribing so input that\nraces with tool startup is not missed.\n- Distinguish mailbox activity, steered input, and timeout outcomes,\nreturning `Wait interrupted by new input.` for the steer path.\n- Update the `wait_agent` tool description to document the early-return\nbehavior.\n\n## Testing\n\n- `just test -p codex-core input_queue_`\n- `just test -p codex-core wait_agent`\n\nThe coverage includes steer notification before and after subscription,\nplus an end-to-end test that verifies the interrupted wait result and\nsteered user input are both included exactly once in the follow-up model\nrequest.","verified_at":"2026-06-15T18:08:15Z"}},"url":"https://api.github.com/repos/openai/codex/commits/ee40dddbf6a50a6f0641180ca299be7a3a03fd22","html_url":"https://github.com/openai/codex/commit/ee40dddbf6a50a6f0641180ca299be7a3a03fd22","comments_url":"https://api.github.com/repos/openai/codex/commits/ee40dddbf6a50a6f0641180ca299be7a3a03fd22/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"336f907ec1f8c05f856f304efaac0d4cb1ea3b57","url":"https://api.github.com/repos/openai/codex/commits/336f907ec1f8c05f856f304efaac0d4cb1ea3b57","html_url":"https://github.com/openai/codex/commit/336f907ec1f8c05f856f304efaac0d4cb1ea3b57"}]},{"sha":"336f907ec1f8c05f856f304efaac0d4cb1ea3b57","node_id":"C_kwDOOYsS4doAKDMzNmY5MDdlYzFmOGMwNWY4NTZmMzA0ZWZhYWMwZDRjYjFlYTNiNTc","commit":{"author":{"name":"Anton Panasenko","email":"apanasenko@openai.com","date":"2026-06-15T17:56:53Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T17:56:53Z"},"message":"Support staging OAuth client ID overrides (#28257)\n\n## Summary\n\n- allow app-server ChatGPT login to use a configured OAuth client ID\n- reuse the same client ID for refresh and revoke requests\n- cover staging login, refresh, and revoke request payloads\n\n## Tests\n\n- `just test -p codex-login`\n- `just test -p codex-app-server\nlogin_account_chatgpt_uses_debug_oauth_overrides`\n- `just test -p codex-login\nlogout_with_revoke_revokes_refresh_token_then_removes_auth`\n- `just fix -p codex-login`\n- `just fix -p codex-app-server`\n- `just fmt`","tree":{"sha":"5555ff8c26565def30c20d4200e8864fef0f53ce","url":"https://api.github.com/repos/openai/codex/git/trees/5555ff8c26565def30c20d4200e8864fef0f53ce"},"url":"https://api.github.com/repos/openai/codex/git/commits/336f907ec1f8c05f856f304efaac0d4cb1ea3b57","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMDzlCRC1aQ7uu5UhlAAABywQAIq6ZUXNYHJyqExpfrO3uU1X\ncua73OqTbwMR476F4OMtTY5q0j96CG/6+woOxokAioQpqB6oAafdB4l9uxZeqFs5\njF9tl2tgQsXGSi6fBOPowU3opw6ZtCt+KQnH5s+1PENP5suPUno+9KbXWnlzT380\nAE9/TnAoHaT5G8KBhXs6hFihW/O4wogyO5RfqYC2zrCgcdOa1jXB5A6Q2p3D62p+\ns3X6kJu+OHyxYtDl2jikTH4rwxg4K8Wt/rlxW1UcD5qDjb6hmPZOQH6jlVuAgzBC\nA7z9gsDYk9IDrUFdYHJbtY/DstjjG0v9bAB0pFkEYOTcKd8nISRN62jZ4ZKaJzNi\nFwJLPpqjNpleiUlVnO2B/EuKyHPSXTzYogeT+bgG9k1oEFbK1p/1ywGt1uX7D0kL\nvcmkDOwKVBm4I7KR/9Ju0p/IR3werOFK93sI7wnPlX61SkMmYG7YBmLxJPXWRplg\noOG40gFg3wi07sw4VYpG4hSRGZ/LBiR4UubwUriqgiOWs6UY0cd3Cxbx8y6eBsCf\n0oufJXjRy7SKiVaArPy3PbJhqB6kDrPyXDs18D4DAx6kT/NVSJp8uPs0/N9PWVPj\nDIU+ktrc0/cmBO6OISjxgfH8PL/Jqk1XQVMTcNIQzfrHhPanl2jamv99DOrYE+PF\ns70ePxk8cdLm1MjQWYtL\n=/Fjw\n-----END PGP SIGNATURE-----\n","payload":"tree 5555ff8c26565def30c20d4200e8864fef0f53ce\nparent aae4c0b02b35658d5bbd259773041bf1b6e2fad8\nauthor Anton Panasenko <apanasenko@openai.com> 1781546213 -0700\ncommitter GitHub <noreply@github.com> 1781546213 -0700\n\nSupport staging OAuth client ID overrides (#28257)\n\n## Summary\n\n- allow app-server ChatGPT login to use a configured OAuth client ID\n- reuse the same client ID for refresh and revoke requests\n- cover staging login, refresh, and revoke request payloads\n\n## Tests\n\n- `just test -p codex-login`\n- `just test -p codex-app-server\nlogin_account_chatgpt_uses_debug_oauth_overrides`\n- `just test -p codex-login\nlogout_with_revoke_revokes_refresh_token_then_removes_auth`\n- `just fix -p codex-login`\n- `just fix -p codex-app-server`\n- `just fmt`","verified_at":"2026-06-15T17:56:53Z"}},"url":"https://api.github.com/repos/openai/codex/commits/336f907ec1f8c05f856f304efaac0d4cb1ea3b57","html_url":"https://github.com/openai/codex/commit/336f907ec1f8c05f856f304efaac0d4cb1ea3b57","comments_url":"https://api.github.com/repos/openai/codex/commits/336f907ec1f8c05f856f304efaac0d4cb1ea3b57/comments","author":{"login":"apanasenko-oai","id":228802911,"node_id":"U_kgDODaNBXw","avatar_url":"https://avatars.githubusercontent.com/u/228802911?v=4","gravatar_id":"","url":"https://api.github.com/users/apanasenko-oai","html_url":"https://github.com/apanasenko-oai","followers_url":"https://api.github.com/users/apanasenko-oai/followers","following_url":"https://api.github.com/users/apanasenko-oai/following{/other_user}","gists_url":"https://api.github.com/users/apanasenko-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/apanasenko-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/apanasenko-oai/subscriptions","organizations_url":"https://api.github.com/users/apanasenko-oai/orgs","repos_url":"https://api.github.com/users/apanasenko-oai/repos","events_url":"https://api.github.com/users/apanasenko-oai/events{/privacy}","received_events_url":"https://api.github.com/users/apanasenko-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"aae4c0b02b35658d5bbd259773041bf1b6e2fad8","url":"https://api.github.com/repos/openai/codex/commits/aae4c0b02b35658d5bbd259773041bf1b6e2fad8","html_url":"https://github.com/openai/codex/commit/aae4c0b02b35658d5bbd259773041bf1b6e2fad8"}]},{"sha":"aae4c0b02b35658d5bbd259773041bf1b6e2fad8","node_id":"C_kwDOOYsS4doAKGFhZTRjMGIwMmIzNTY1OGQ1YmJkMjU5NzczMDQxYmYxYjZlMmZhZDg","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-15T17:52:30Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T17:52:30Z"},"message":"bound prompt image cache retention (#28294)\n\n## Why\n\nThe prompt image cache was bounded to 32 entries, but not by the size of\nthose entries. A set of large encoded images could therefore retain\nsubstantially more memory than intended. Cache hits also cloned the full\nencoded payload.\n\n## What changed\n\n- cap the cache at 64 MiB of encoded image data while preserving its\nexisting 32-entry limit\n- skip caching an image that exceeds the entire byte budget\n- evict least-recently-used entries until the cache is back within its\nbyte budget\n- share cached encoded bytes with `Arc<[u8]>` so cache hits do not\ndeep-clone image payloads\n\n## Validation\n\n- `just test -p codex-utils-image`","tree":{"sha":"6e10562eb4f217610b3e504d4e8786ec17f7ab38","url":"https://api.github.com/repos/openai/codex/git/trees/6e10562eb4f217610b3e504d4e8786ec17f7ab38"},"url":"https://api.github.com/repos/openai/codex/git/commits/aae4c0b02b35658d5bbd259773041bf1b6e2fad8","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMDveCRC1aQ7uu5UhlAAAYU8QAKsr3uqwLqjtMO9h1PlA4rI8\nMA1m34uGAUfRMH8U1F6DTc6Zfmmh+pJfkVbJVIPt+T/2yFpL7nLR/0UYJd8min8c\n+GUb3Ly+sWYNkwV7V85KE8xXWxQx58c5csM+JvNKLnUfZJw+hBnrZPTeid8hwcbt\nTEGMO9K72uOHXPhnKkDZgKnTjuq+ONxYQrp5fUyGHBHmaNS+iWAXnSCctoYQV++/\nSgBz5A2z2mVkOVxVPFbhnA0kRgLNS3oZ1SGslYyWzhjzaPAfO4b439R/gsjWET/y\niByIBmbyyyYCmTjMRrmGzRIOlOZ5esA6lpt3Hb0TChOeADVDXG7JumWWdPGpF60L\nBoNbLwqQQjM+wgU3E2E5NVsHoZx/YQLt6PsOsoip56z27b/D/iC0iEqQWenWPGVG\nxj6M5KA/lYb3VeNSJRSh0jjJ0mM9rFFpuANKI+HI69LKmLxU7iYyQ+vRC945TqYp\nrp+OQT2cDDjTq8fw8p6rX/2pGzFf/+OLFgCOB17h4VDAxShKAprv6BNewqlWoOy2\nG6C0NYkKKzE3xpfbWaD284NbysAU6XaeJMmf8zs2fvIAL+vJ5obF14VHu7C4lIFe\n6t/NTimBU/HgoO+ZTXitgfp+mp4T8qaoyf1Xf0l33HSIbDg904v5gRvVzB8CvQuA\nmEqMPdYl0MPbjR1dWVXi\n=bnug\n-----END PGP SIGNATURE-----\n","payload":"tree 6e10562eb4f217610b3e504d4e8786ec17f7ab38\nparent 29224d945b0b4f5f773c3f80c59c0af91c3db855\nauthor jif <jif@openai.com> 1781545950 +0100\ncommitter GitHub <noreply@github.com> 1781545950 +0200\n\nbound prompt image cache retention (#28294)\n\n## Why\n\nThe prompt image cache was bounded to 32 entries, but not by the size of\nthose entries. A set of large encoded images could therefore retain\nsubstantially more memory than intended. Cache hits also cloned the full\nencoded payload.\n\n## What changed\n\n- cap the cache at 64 MiB of encoded image data while preserving its\nexisting 32-entry limit\n- skip caching an image that exceeds the entire byte budget\n- evict least-recently-used entries until the cache is back within its\nbyte budget\n- share cached encoded bytes with `Arc<[u8]>` so cache hits do not\ndeep-clone image payloads\n\n## Validation\n\n- `just test -p codex-utils-image`","verified_at":"2026-06-15T17:52:30Z"}},"url":"https://api.github.com/repos/openai/codex/commits/aae4c0b02b35658d5bbd259773041bf1b6e2fad8","html_url":"https://github.com/openai/codex/commit/aae4c0b02b35658d5bbd259773041bf1b6e2fad8","comments_url":"https://api.github.com/repos/openai/codex/commits/aae4c0b02b35658d5bbd259773041bf1b6e2fad8/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"29224d945b0b4f5f773c3f80c59c0af91c3db855","url":"https://api.github.com/repos/openai/codex/commits/29224d945b0b4f5f773c3f80c59c0af91c3db855","html_url":"https://github.com/openai/codex/commit/29224d945b0b4f5f773c3f80c59c0af91c3db855"}]},{"sha":"29224d945b0b4f5f773c3f80c59c0af91c3db855","node_id":"C_kwDOOYsS4doAKDI5MjI0ZDk0NWIwYjRmNWY3NzNjM2Y4MGM1OWMwYWY5MWMzZGI4NTU","commit":{"author":{"name":"canvrno-oai","email":"kbond@openai.com","date":"2026-06-15T17:25:37Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T17:25:37Z"},"message":"TUI Plugin Sharing 2 - add remote plugin section plumbing (#26702)\n\nThis adds the background plumbing for remote-backed plugin catalog\nsections while leaving the fuller directory presentation to the next PR.\nThe TUI can fetch section-specific remote marketplace results, keep\nlocal plugin data available, and carry section errors forward for later\nrendering.\n\n- Fetches explicit remote marketplace kinds for curated, workspace, and\nshared-with-me sections.\n- Gates shared-with-me loading on the plugin sharing feature flag.\n- Adds section-level error state and user-actionable error copy.\n- Merges remote marketplace results into the cached plugin list without\ndiscarding local results.","tree":{"sha":"0935db3ca2644e89be5e48dac617137b2c721b77","url":"https://api.github.com/repos/openai/codex/git/trees/0935db3ca2644e89be5e48dac617137b2c721b77"},"url":"https://api.github.com/repos/openai/codex/git/commits/29224d945b0b4f5f773c3f80c59c0af91c3db855","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMDWRCRC1aQ7uu5UhlAAASD4QAIodkhp6d/iHvM7M0+k68IMx\nmIyxrzwOinDx0P0ZK6qBKR0zYgyG8jCuXPYR3qUfTYuxJb/SlsTZv3tQ9G0Ma4oU\nS0LUen8GGs7Mj4ou/PXiFfIunfbDrqJlfGQNqA/MVX66ZRRXNfDxjDlsc3PQlmJx\nYBA8TTybmAlGX+A1HZXmrSZKIBC7XcKNBy2iLI+unAFaR1Dtd1ml2SOFruJOtx2Y\nmI34CeP2eaJGT2V87vMbGj2yDJd5Y1cjLXuJ8pGUE5v4etpt9vwM86jr+LifGGAH\ntr2oq/mCuX7KpAD7Ez/NMKwJjhOuPlty7TFahjAbuWNVbed86g1sYgi8m5vXbtAh\niUCIzg8LhNn9lGP/TmYfK8y2kn+ZkXY0SkhMjSTMf6uJoYAwP2NCNDCsgMqwTOT8\nYN0h8rIJ11SaSHAmUwUoUxLxLdArOCCdH3MsdnsaMD3HGE3nwhf3VHADy2VNaUpD\nyd0lRp1h6Lv7GNzGQf/44Xbkp+PtuZ/PKa6oXzG8ftYqFHZ5gGk5LFd2BadtJEvQ\ntP5oo8+k4eL43KtMrgnKn+C27FGxuHx6C2N/iR4ITuWCzWfMubMiA7zwp1puYuu/\nbm0aY2v1xrqbHQcCaFL16xDfK929AJZ53eefTZ5315A9DJpIKCvnz2VQ0XbrxX9N\nzOd5PWMh9LKGqrj2/EsA\n=vcV1\n-----END PGP SIGNATURE-----\n","payload":"tree 0935db3ca2644e89be5e48dac617137b2c721b77\nparent a18de1f3b6482cf162a473d173db7bf24206333e\nauthor canvrno-oai <kbond@openai.com> 1781544337 -0700\ncommitter GitHub <noreply@github.com> 1781544337 -0700\n\nTUI Plugin Sharing 2 - add remote plugin section plumbing (#26702)\n\nThis adds the background plumbing for remote-backed plugin catalog\nsections while leaving the fuller directory presentation to the next PR.\nThe TUI can fetch section-specific remote marketplace results, keep\nlocal plugin data available, and carry section errors forward for later\nrendering.\n\n- Fetches explicit remote marketplace kinds for curated, workspace, and\nshared-with-me sections.\n- Gates shared-with-me loading on the plugin sharing feature flag.\n- Adds section-level error state and user-actionable error copy.\n- Merges remote marketplace results into the cached plugin list without\ndiscarding local results.","verified_at":"2026-06-15T17:25:38Z"}},"url":"https://api.github.com/repos/openai/codex/commits/29224d945b0b4f5f773c3f80c59c0af91c3db855","html_url":"https://github.com/openai/codex/commit/29224d945b0b4f5f773c3f80c59c0af91c3db855","comments_url":"https://api.github.com/repos/openai/codex/commits/29224d945b0b4f5f773c3f80c59c0af91c3db855/comments","author":{"login":"canvrno-oai","id":257630656,"node_id":"U_kgDOD1shwA","avatar_url":"https://avatars.githubusercontent.com/u/257630656?v=4","gravatar_id":"","url":"https://api.github.com/users/canvrno-oai","html_url":"https://github.com/canvrno-oai","followers_url":"https://api.github.com/users/canvrno-oai/followers","following_url":"https://api.github.com/users/canvrno-oai/following{/other_user}","gists_url":"https://api.github.com/users/canvrno-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/canvrno-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/canvrno-oai/subscriptions","organizations_url":"https://api.github.com/users/canvrno-oai/orgs","repos_url":"https://api.github.com/users/canvrno-oai/repos","events_url":"https://api.github.com/users/canvrno-oai/events{/privacy}","received_events_url":"https://api.github.com/users/canvrno-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a18de1f3b6482cf162a473d173db7bf24206333e","url":"https://api.github.com/repos/openai/codex/commits/a18de1f3b6482cf162a473d173db7bf24206333e","html_url":"https://github.com/openai/codex/commit/a18de1f3b6482cf162a473d173db7bf24206333e"}]},{"sha":"a18de1f3b6482cf162a473d173db7bf24206333e","node_id":"C_kwDOOYsS4doAKGExOGRlMWYzYjY0ODJjZjE2MmE0NzNkMTczZGI3YmYyNDIwNjMzM2U","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-15T17:24:50Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T17:24:50Z"},"message":"guardian: isolate review context from skills and memories (#28285)\n\n## Why\n\nGuardian reviews embed the parent session transcript as untrusted\nevidence. Skill or plugin mentions in that transcript must not be\ninterpreted as requests to inject more instructions into the Guardian\nrequest, and memory context adds unrelated model-visible context to an\napproval decision.\n\nKeeping those sources out of the nested review session makes the request\nsmaller and preserves the trust boundary around the transcript being\nassessed.\n\n## What changed\n\n- Skip skill and plugin discovery when building turns for Guardian\nreviewer sessions.\n- Disable memory context and dedicated memory tools in the derived\nGuardian configuration.\n- Extend the Guardian request-layout coverage to verify that a `$skill`\nmention remains visible only as transcript evidence while neither the\nskill body nor memory context is injected.\n- Expand the Guardian configuration test to cover the disabled memory\nsettings.\n\n## Testing\n\n- Updated the Guardian review request snapshot and assertions for skill\nand memory isolation.\n- Extended the Guardian session configuration test to cover memories.","tree":{"sha":"b34dbcca27cc197e8c4d14d169d09e93d7b13118","url":"https://api.github.com/repos/openai/codex/git/trees/b34dbcca27cc197e8c4d14d169d09e93d7b13118"},"url":"https://api.github.com/repos/openai/codex/git/commits/a18de1f3b6482cf162a473d173db7bf24206333e","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMDViCRC1aQ7uu5UhlAAAM4EQAAfk8QchbXH8rNEAwqHvD5Fz\nPHWJZkN7IjJKLgI8PUjr1nzHNnixDAg7mwpYdlaH8NXrV6dTXD//WxZbqO+cEUCT\nrP4pnYHVAvQ2SwF40oLcg4C53bds4+6xdREJDNjmBEtYYldEzi8k6EgIoYNSBJDI\nGveIzP9eWhLLUgN8GdRmv2w2LDbYtz8H8aE8aewp2k4RxDMyVbLuUTcmxRZqoXPq\nEEQATEJHqYv9qo3NbpCnKR8ot+iBLO68xKb19dbRu0AkVswwlwzdDELJRg3jpLve\n9nKfYXrWAgwt5EbLzBAdyiZgzAjbG3sIA42y9ngqyizsj57PEtf7ODKbKoAmrx/S\n4ORwNlhJM2a60x40bANnT+T0EC0kJ3xv+v2CcuhnWwBV0AtN9wnU1gYYbV/hop5n\nru1y9Bw3JhdKhwG5dCaWewY0VI7PHtRHQH929TdtsWOIeuqXNm5tb+E8bUf3N2Cz\nb7n44bxtXxHK3/Xe8hBuBBskkG+YxTZUhDb+m8Njdmg6rYVPPBdORA+oyGBXwqJO\nXwszVcaUpQoon85HYXYKYPfZfZwg2/P/Ofo5gf4bYzoI+BrBG8ZNftwif6rokDCy\nXCywQ5XHA+Jqv7QM/s6PEfmFkqp25OOQcQD/DEIBX96vVuysIoaDDZ3zLF1zwfX3\nO0d5MFFm8lgX5AsloLiV\n=3tRu\n-----END PGP SIGNATURE-----\n","payload":"tree b34dbcca27cc197e8c4d14d169d09e93d7b13118\nparent bd4fe31c5a89316051e086ec672cd63b7339e99a\nauthor jif <jif@openai.com> 1781544290 +0100\ncommitter GitHub <noreply@github.com> 1781544290 +0200\n\nguardian: isolate review context from skills and memories (#28285)\n\n## Why\n\nGuardian reviews embed the parent session transcript as untrusted\nevidence. Skill or plugin mentions in that transcript must not be\ninterpreted as requests to inject more instructions into the Guardian\nrequest, and memory context adds unrelated model-visible context to an\napproval decision.\n\nKeeping those sources out of the nested review session makes the request\nsmaller and preserves the trust boundary around the transcript being\nassessed.\n\n## What changed\n\n- Skip skill and plugin discovery when building turns for Guardian\nreviewer sessions.\n- Disable memory context and dedicated memory tools in the derived\nGuardian configuration.\n- Extend the Guardian request-layout coverage to verify that a `$skill`\nmention remains visible only as transcript evidence while neither the\nskill body nor memory context is injected.\n- Expand the Guardian configuration test to cover the disabled memory\nsettings.\n\n## Testing\n\n- Updated the Guardian review request snapshot and assertions for skill\nand memory isolation.\n- Extended the Guardian session configuration test to cover memories.","verified_at":"2026-06-15T17:24:50Z"}},"url":"https://api.github.com/repos/openai/codex/commits/a18de1f3b6482cf162a473d173db7bf24206333e","html_url":"https://github.com/openai/codex/commit/a18de1f3b6482cf162a473d173db7bf24206333e","comments_url":"https://api.github.com/repos/openai/codex/commits/a18de1f3b6482cf162a473d173db7bf24206333e/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"bd4fe31c5a89316051e086ec672cd63b7339e99a","url":"https://api.github.com/repos/openai/codex/commits/bd4fe31c5a89316051e086ec672cd63b7339e99a","html_url":"https://github.com/openai/codex/commit/bd4fe31c5a89316051e086ec672cd63b7339e99a"}]},{"sha":"bd4fe31c5a89316051e086ec672cd63b7339e99a","node_id":"C_kwDOOYsS4doAKGJkNGZlMzFjNWE4OTMxNjA1MWUwODZlYzY3MmNkNjNiNzMzOWU5OWE","commit":{"author":{"name":"pakrym-oai","email":"pakrym@openai.com","date":"2026-06-15T17:17:34Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T17:17:34Z"},"message":"[codex] preserve explicit environment cwd (#27995)\n\n## Why\n\n`TurnEnvironmentSelections::new` rewrote the primary environment's\nexplicit `cwd` to the legacy fallback cwd. For a remote-first selection,\nthis could replace the remote working directory with a local fallback\npath and made the legacy cwd overlay authoritative over\nenvironment-owned state.\n\n## What changed\n\n- Preserve every explicit environment cwd when constructing turn\nenvironment selections.\n- Keep `cwd`-only app-server updates compatible by rebuilding the\ndefault environment selections at the requested cwd.\n- Cover both explicit primary cwd preservation and cwd-only updates\nreaching the model-visible execution environment.\n\n## Testing\n\n- `just test -p codex-core\nsession_update_settings_does_not_rewrite_sticky_environment_cwds`\n- `just test -p codex-core\nenvironment_settings_preserve_explicit_primary_cwd`\n- `just test -p codex-app-server\nthread_settings_update_cwd_retargets_default_environment`","tree":{"sha":"ce6268ab69bc3dbbaeb9c0f7be3eecdf08508513","url":"https://api.github.com/repos/openai/codex/git/trees/ce6268ab69bc3dbbaeb9c0f7be3eecdf08508513"},"url":"https://api.github.com/repos/openai/codex/git/commits/bd4fe31c5a89316051e086ec672cd63b7339e99a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMDOuCRC1aQ7uu5UhlAAABEMQAAO63EM0tUaU3G5HR1Xkp2oh\naiq9CQb9LdomlVsvUSLN86KJe5y3jFIn6l/Q6DFDYWqxt34p/FPe4TByiq9zoItK\nBBW/aj3YiqJ8wZjzTHBvx5XhNZkXqBAXOXQq6hBTcsr1ZZsJdC+5HLV1nR6ve/7O\n6sjXuupLSeumKprY3Aem8/xQ5nDvWIQyddC31+I2NZB7N3XPvfKaQLF4mkAAB8Fo\np9dNtB8ftqP9aws02Cf8jkiE5Z2depH4+KKImfRQnmkTvyL7mMl9yxHZ44a5J7zO\n7ZOdoRLANl5lw/Y6vZHU/2k0Z4eTuhdSlvvYf68jC0ny7xrxkoBGPKjgN4fMqg+w\n4M50kEbFa+5Z/gZ2S8ocxxENEyA4N4tf4xTluV6IJH6rEegQMAY8R0ThpI5SJwMm\nfkA8Yr3pI9k4wbMcJ31YKOxp/iNYEtie502EZPrU6yyyivl3UY35b+PGnHwsuHXP\n22KV2P/VpLgMZz0eHbjflMKNAcPGh6lAJ65ba5KnE9cNmtOcyFbqhnRoMNuT6Uka\n/ZQFgC+IiY31Q4s7DipMizU/NNNpgCpZ/qXqjP9U++VghBMv1gN7SeCyuc6ZaBe0\nsIRQODT169hah4ztPp6JOlC0NYj+G4L8vu3kSi7hCQ7+iee+r83Y8QApcO/J/quc\nYqvczhJUmGLzYQzv0GeS\n=hkG9\n-----END PGP SIGNATURE-----\n","payload":"tree ce6268ab69bc3dbbaeb9c0f7be3eecdf08508513\nparent 495da4564337099f064b25f7e2f00436f56bc076\nauthor pakrym-oai <pakrym@openai.com> 1781543854 -0700\ncommitter GitHub <noreply@github.com> 1781543854 +0000\n\n[codex] preserve explicit environment cwd (#27995)\n\n## Why\n\n`TurnEnvironmentSelections::new` rewrote the primary environment's\nexplicit `cwd` to the legacy fallback cwd. For a remote-first selection,\nthis could replace the remote working directory with a local fallback\npath and made the legacy cwd overlay authoritative over\nenvironment-owned state.\n\n## What changed\n\n- Preserve every explicit environment cwd when constructing turn\nenvironment selections.\n- Keep `cwd`-only app-server updates compatible by rebuilding the\ndefault environment selections at the requested cwd.\n- Cover both explicit primary cwd preservation and cwd-only updates\nreaching the model-visible execution environment.\n\n## Testing\n\n- `just test -p codex-core\nsession_update_settings_does_not_rewrite_sticky_environment_cwds`\n- `just test -p codex-core\nenvironment_settings_preserve_explicit_primary_cwd`\n- `just test -p codex-app-server\nthread_settings_update_cwd_retargets_default_environment`","verified_at":"2026-06-15T17:17:34Z"}},"url":"https://api.github.com/repos/openai/codex/commits/bd4fe31c5a89316051e086ec672cd63b7339e99a","html_url":"https://github.com/openai/codex/commit/bd4fe31c5a89316051e086ec672cd63b7339e99a","comments_url":"https://api.github.com/repos/openai/codex/commits/bd4fe31c5a89316051e086ec672cd63b7339e99a/comments","author":{"login":"pakrym-oai","id":204937752,"node_id":"U_kgDODDcaGA","avatar_url":"https://avatars.githubusercontent.com/u/204937752?v=4","gravatar_id":"","url":"https://api.github.com/users/pakrym-oai","html_url":"https://github.com/pakrym-oai","followers_url":"https://api.github.com/users/pakrym-oai/followers","following_url":"https://api.github.com/users/pakrym-oai/following{/other_user}","gists_url":"https://api.github.com/users/pakrym-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/pakrym-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pakrym-oai/subscriptions","organizations_url":"https://api.github.com/users/pakrym-oai/orgs","repos_url":"https://api.github.com/users/pakrym-oai/repos","events_url":"https://api.github.com/users/pakrym-oai/events{/privacy}","received_events_url":"https://api.github.com/users/pakrym-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"495da4564337099f064b25f7e2f00436f56bc076","url":"https://api.github.com/repos/openai/codex/commits/495da4564337099f064b25f7e2f00436f56bc076","html_url":"https://github.com/openai/codex/commit/495da4564337099f064b25f7e2f00436f56bc076"}]},{"sha":"495da4564337099f064b25f7e2f00436f56bc076","node_id":"C_kwDOOYsS4doAKDQ5NWRhNDU2NDMzNzA5OWYwNjRiMjVmN2UyZjAwNDM2ZjU2YmMwNzY","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-15T17:11:26Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T17:11:26Z"},"message":"reuse encoded Responses request bodies (#28327)\n\n## Why\n\nResponses HTTP requests were converted from `ResponsesApiRequest` into a\nfull `serde_json::Value`. `EndpointSession` then deep-cloned that value\nfor each retry, and the transport serialized and compressed it again\nbefore every send.\n\nLarge histories make those copies expensive. Retry attempts should reuse\nthe same immutable request bytes.\n\n## What\n\n- Serialize standard Responses requests directly into a ref-counted\n`EncodedJsonBody`.\n- Preserve the Azure path that attaches item IDs before encoding.\n- Prepare JSON, compression, and derived content headers once before the\nretry loop.\n- Clone the prepared request per attempt so body clones only bump the\n`Bytes` reference count.\n- Keep auth inside the retry loop. Signing auth sees the exact final\nheaders and body bytes that the transport sends.\n- Preserve request-body TRACE output. With TRACE plus compression,\nretain the original JSON bytes for logging; normal requests keep only\nthe final wire bytes.\n- Leave non-Responses endpoint bodies on the existing `Value` path.\n\n## Performance\n\nA temporary release-mode measurement used a 10 MiB JSON body and 10\nretry preparations:\n\n- old `Value` clone + serialize path: 30 ms total\n- prepared shared-byte path: less than 1 ms total\n\nThat is about 3 ms avoided per retry for this payload on the test\nmachine. Each retry also stops allocating another request-sized JSON\ntree and serialized buffer. Without TRACE, compressed requests retain\nonly the final compressed wire bytes.\n\n## Validation\n\n- `just test -p codex-client` — 28 passed\n- `just test -p codex-api` — 125 passed\n- `just fix -p codex-client`\n- `just fix -p codex-api`","tree":{"sha":"786e09e849353c68fe7af8264ff9dcf3d3c99e6f","url":"https://api.github.com/repos/openai/codex/git/trees/786e09e849353c68fe7af8264ff9dcf3d3c99e6f"},"url":"https://api.github.com/repos/openai/codex/git/commits/495da4564337099f064b25f7e2f00436f56bc076","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMDI+CRC1aQ7uu5UhlAAAQ94QAEmg4XpQ1GVw4aervEy1XYH2\n9u9VZi540PBLF6oGl67o+irTzbyn3YCpqTLiQb010fd0x3bzX/kdUvs3k4JBjgKD\nSBH7JgxAqGVHdZS17L1iAQikoeT3kh2Ae2ljx5xQvYC0LaVGQTDRiBDYEEOm8lCa\nnsHVmvD36Ln4lb0QFV7vL8jhjFFh54fLZuWQsv9ZedddPY2nRXtoQnQE1V7+NCx9\nY50PNX2y2RtU6MPgD+4m+TvGHerZ2+gaNHKkZnxOf+egVmZ5cpRTWLim2DecXDJ3\nB95lAdnLxV9rBG54jF3GXbFHkxAR77VP6ouZkPdPDQv7dsa3fsx1xGtv3mYLLQyN\nudVMQFzGcTbxL15irDNsyCEMiJOJGDYvQLzdI9Nc2qXFasdCfDHV9lPrNXX2nld9\nfrHaJDmBbY5FgWzjSuALR3GvcP4cbfb+bfD/xeVK0+eqbcZW1InyPOYSYGAbqB3q\nOEVZbp+7qZdZJvHhWE7TFQ585aTwCDQutd/3uKRhdlBqbjGYS/88D26V3CRmwK7s\ncl7gOC/1j6UdM4RMoLrYOLq5TDojuML1VUL/zYVic1Wm7DF3SF6X/4BYwOqIuCa/\nirER08XxrxYXZ4CvI4+nIm4Cy+2YOqyseNoArt3OiHcaUH6DBZDN/sMaBTTwF6NU\nR0pDzzWfK9xnp41Kriwh\n=0Bj+\n-----END PGP SIGNATURE-----\n","payload":"tree 786e09e849353c68fe7af8264ff9dcf3d3c99e6f\nparent bed60e37468a2cf9cfbf01b0cb8e14795e5408d6\nauthor jif <jif@openai.com> 1781543486 +0100\ncommitter GitHub <noreply@github.com> 1781543486 +0200\n\nreuse encoded Responses request bodies (#28327)\n\n## Why\n\nResponses HTTP requests were converted from `ResponsesApiRequest` into a\nfull `serde_json::Value`. `EndpointSession` then deep-cloned that value\nfor each retry, and the transport serialized and compressed it again\nbefore every send.\n\nLarge histories make those copies expensive. Retry attempts should reuse\nthe same immutable request bytes.\n\n## What\n\n- Serialize standard Responses requests directly into a ref-counted\n`EncodedJsonBody`.\n- Preserve the Azure path that attaches item IDs before encoding.\n- Prepare JSON, compression, and derived content headers once before the\nretry loop.\n- Clone the prepared request per attempt so body clones only bump the\n`Bytes` reference count.\n- Keep auth inside the retry loop. Signing auth sees the exact final\nheaders and body bytes that the transport sends.\n- Preserve request-body TRACE output. With TRACE plus compression,\nretain the original JSON bytes for logging; normal requests keep only\nthe final wire bytes.\n- Leave non-Responses endpoint bodies on the existing `Value` path.\n\n## Performance\n\nA temporary release-mode measurement used a 10 MiB JSON body and 10\nretry preparations:\n\n- old `Value` clone + serialize path: 30 ms total\n- prepared shared-byte path: less than 1 ms total\n\nThat is about 3 ms avoided per retry for this payload on the test\nmachine. Each retry also stops allocating another request-sized JSON\ntree and serialized buffer. Without TRACE, compressed requests retain\nonly the final compressed wire bytes.\n\n## Validation\n\n- `just test -p codex-client` — 28 passed\n- `just test -p codex-api` — 125 passed\n- `just fix -p codex-client`\n- `just fix -p codex-api`","verified_at":"2026-06-15T17:11:26Z"}},"url":"https://api.github.com/repos/openai/codex/commits/495da4564337099f064b25f7e2f00436f56bc076","html_url":"https://github.com/openai/codex/commit/495da4564337099f064b25f7e2f00436f56bc076","comments_url":"https://api.github.com/repos/openai/codex/commits/495da4564337099f064b25f7e2f00436f56bc076/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"bed60e37468a2cf9cfbf01b0cb8e14795e5408d6","url":"https://api.github.com/repos/openai/codex/commits/bed60e37468a2cf9cfbf01b0cb8e14795e5408d6","html_url":"https://github.com/openai/codex/commit/bed60e37468a2cf9cfbf01b0cb8e14795e5408d6"}]},{"sha":"bed60e37468a2cf9cfbf01b0cb8e14795e5408d6","node_id":"C_kwDOOYsS4doAKGJlZDYwZTM3NDY4YTJjZjljZmJmMDFiMGNiOGUxNDc5NWU1NDA4ZDY","commit":{"author":{"name":"richardopenai","email":"richardlee@openai.com","date":"2026-06-15T16:59:26Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T16:59:26Z"},"message":"[codex] Cover OTLP HTTP log and trace event export (#27059)\n\n## Why\n\nThe generic OTLP HTTP paths for log events and trace events need\nend-to-end coverage before exec-server relies on them.\n\n## What changed\n\n- Adds loopback coverage for exporting `codex_otel.log_only` events to\n`/v1/logs`.\n- Verifies `codex_otel.trace_safe` events are present in the exported\ntrace payload.\n\nThis is a test-only PR. It does not change OTEL runtime behavior or\nmetric APIs.\n\n## Related work\n\n- #26091: counter descriptions\n- #27057: gauge instruments\n- #27058: second-based duration histograms\n\nThis PR is independent and can land directly on `main`.\n\n## Validation\n\n- `just test -p codex-otel`\n- `just fix -p codex-otel`\n- `just fmt`","tree":{"sha":"05849d5f215aa2c75df20ee0dce9a6be19103394","url":"https://api.github.com/repos/openai/codex/git/trees/05849d5f215aa2c75df20ee0dce9a6be19103394"},"url":"https://api.github.com/repos/openai/codex/git/commits/bed60e37468a2cf9cfbf01b0cb8e14795e5408d6","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMC9uCRC1aQ7uu5UhlAAAgyQQAJU1ZnCVRyjW1tpoz2Q8m8Gf\nNHwsRAE4ZSQ9xD9rRuzajDQ4lCJaFMGcCHMWfmJjVn14kvaYNQkj6gd0wLQvHmED\ntFE4xFYy4zDOvnxWIJbrFKMdVSP9agdUJWCLZeVs5rIyERZhlIlXP4QKO36c7mQ1\nZ9zvR5S4hslr8K1S14TacIcV1AWD0e7Mlkf6cx51M2pm370YNzXHehJeP3Ua5NKU\njhN+U6DmVs0cbamYdFw0GXGxRxgnNsXCb15cp4CpY46ts/deGv9AgJzklnDCkbRj\nqKFGJ47p6Y6G1LdzejgdpQ9YtTEAmuCuRYi91i/Dbqsd0t3i/LxmJipPBgZZ6RX3\nb/fOb1j2mxGThSWQOvWTmuuIxzR67FSUrFTd0TpupJ/5fqBn/rrNOoIggio7h3cA\ncAU5YutikQPB6ug05tSoLNRKe+WYOd5OiwWbNb5DIzRUu08onddeCJB1bIupgucr\nF5RZWPT1FGTR2YC5H0qnoNdlTT+CoUwz0Qr4dOph9Q3r0u3fCQDOrQG2dDM8CjEq\nE+02ZyqCWxnUdQPEFbeEAo8XplmPUqReUAx3S/iBqW02SoIyrfvlWgF8q9w4E7vz\nlcvmDl3z2woAShminWw8vO3/NQvMvW7Am07NOXS+e8lIlGvxpb6vSqhMX1TCCHHc\n1b33vbsDN2DQzrcC3i0q\n=vs4T\n-----END PGP SIGNATURE-----\n","payload":"tree 05849d5f215aa2c75df20ee0dce9a6be19103394\nparent 5e58b6d77f91d4f50197680b1afb21a0ce2eee34\nauthor richardopenai <richardlee@openai.com> 1781542766 -0700\ncommitter GitHub <noreply@github.com> 1781542766 -0700\n\n[codex] Cover OTLP HTTP log and trace event export (#27059)\n\n## Why\n\nThe generic OTLP HTTP paths for log events and trace events need\nend-to-end coverage before exec-server relies on them.\n\n## What changed\n\n- Adds loopback coverage for exporting `codex_otel.log_only` events to\n`/v1/logs`.\n- Verifies `codex_otel.trace_safe` events are present in the exported\ntrace payload.\n\nThis is a test-only PR. It does not change OTEL runtime behavior or\nmetric APIs.\n\n## Related work\n\n- #26091: counter descriptions\n- #27057: gauge instruments\n- #27058: second-based duration histograms\n\nThis PR is independent and can land directly on `main`.\n\n## Validation\n\n- `just test -p codex-otel`\n- `just fix -p codex-otel`\n- `just fmt`","verified_at":"2026-06-15T16:59:26Z"}},"url":"https://api.github.com/repos/openai/codex/commits/bed60e37468a2cf9cfbf01b0cb8e14795e5408d6","html_url":"https://github.com/openai/codex/commit/bed60e37468a2cf9cfbf01b0cb8e14795e5408d6","comments_url":"https://api.github.com/repos/openai/codex/commits/bed60e37468a2cf9cfbf01b0cb8e14795e5408d6/comments","author":{"login":"richardopenai","id":272641442,"node_id":"U_kgDOEEAtog","avatar_url":"https://avatars.githubusercontent.com/u/272641442?v=4","gravatar_id":"","url":"https://api.github.com/users/richardopenai","html_url":"https://github.com/richardopenai","followers_url":"https://api.github.com/users/richardopenai/followers","following_url":"https://api.github.com/users/richardopenai/following{/other_user}","gists_url":"https://api.github.com/users/richardopenai/gists{/gist_id}","starred_url":"https://api.github.com/users/richardopenai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/richardopenai/subscriptions","organizations_url":"https://api.github.com/users/richardopenai/orgs","repos_url":"https://api.github.com/users/richardopenai/repos","events_url":"https://api.github.com/users/richardopenai/events{/privacy}","received_events_url":"https://api.github.com/users/richardopenai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"5e58b6d77f91d4f50197680b1afb21a0ce2eee34","url":"https://api.github.com/repos/openai/codex/commits/5e58b6d77f91d4f50197680b1afb21a0ce2eee34","html_url":"https://github.com/openai/codex/commit/5e58b6d77f91d4f50197680b1afb21a0ce2eee34"}]},{"sha":"5e58b6d77f91d4f50197680b1afb21a0ce2eee34","node_id":"C_kwDOOYsS4doAKDVlNThiNmQ3N2Y5MWQ0ZjUwMTk3NjgwYjFhZmIyMWEwY2UyZWVlMzQ","commit":{"author":{"name":"pakrym-oai","email":"pakrym@openai.com","date":"2026-06-15T16:56:21Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T16:56:21Z"},"message":"[codex] remove stale PathExt import (#28344)\n\n## Why\n\n`main` fails dev-profile Cargo and Bazel Clippy builds because\n`core/src/tools/runtimes/mod_tests.rs` imports `PathExt` after its last\nuse was removed. With warnings denied, that stale import prevents\n`codex-core` test targets from compiling across platforms.\n\n## What changed\n\nRemove the unused `PathExt` import. Remaining `.abs()` calls in the\nmodule operate on `PathBuf` and continue to use `PathBufExt`.\n\n## Validation\n\n- `just fmt`\n- Focused `codex-core` test compile attempted; blocked locally by disk\nexhaustion before compilation completed. The CI failure itself is the\nunused-import diagnostic this change removes.","tree":{"sha":"2406f3a7e330a2e6a4d571ba5d0f3a82d6f35f88","url":"https://api.github.com/repos/openai/codex/git/trees/2406f3a7e330a2e6a4d571ba5d0f3a82d6f35f88"},"url":"https://api.github.com/repos/openai/codex/git/commits/5e58b6d77f91d4f50197680b1afb21a0ce2eee34","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMC61CRC1aQ7uu5UhlAAAO5kQAJ/N13vN01CI+CxOtseSG8Qn\n+ZyCOeHyTvwJ7GJHLblNX62gmvDpxfyIzteZ6HGDaqpMr7T+TSGc16GcD+FwXEPn\nenPlNJJ8ZxXZJ60HnXbVxqDzjJfzFLvNr4TR0XKQp5HutI0FIkGnCOq/AgANDlD7\ncy9PKjTZ1mip98RWoWeSWgPRr8m7fWM10rg+1SL9C5NSSmkgQhBODoWWVolG6qfy\nibt4QPFLtEzvtuDPoCkamiMe4YeuXgAcGNvw+Ueoi9X5gxk+G9gFk2jCoAfeadRR\nR7fK4i0/XqKWw9BYTp4vUYyvDnH8hEN8i43ZvgODVXVhXOXd5nQSkmXFfXfGKhak\nrpwn6l+jy9455AttV3sdA8G3VKCvyl0nv0+i6lu1/YJCFlHB4SONuKPok+MwCJJi\nKd8gSpD6lKkKsxkxpFKWkW4Kf8MWIgv2bI2IC4ejLLuTVovZ2wavK6PSMqRcRZHG\n7NCYKMUouMPlYbVtdep34AztfyouYhuNn+ZUr72gh2pFXijA6oSsBp4Dw6Tz8tdF\nIKpt1rTanUVj0YcVLmYiywon4J00gfQpEl2GUWrEj7fCK5vOhKTKXU2z9he2xbj4\nqvphypbQtk7vPbPm5yc6ZMcBjHoOtpZaVYSwCzhiY+zKfJugP6hRS7BdqX0KTTLE\n5R9atPshAorQl5cWvW0R\n=yPLg\n-----END PGP SIGNATURE-----\n","payload":"tree 2406f3a7e330a2e6a4d571ba5d0f3a82d6f35f88\nparent 95765542c92c922fae4a9b2ce8a97d101702d24d\nauthor pakrym-oai <pakrym@openai.com> 1781542581 -0700\ncommitter GitHub <noreply@github.com> 1781542581 -0700\n\n[codex] remove stale PathExt import (#28344)\n\n## Why\n\n`main` fails dev-profile Cargo and Bazel Clippy builds because\n`core/src/tools/runtimes/mod_tests.rs` imports `PathExt` after its last\nuse was removed. With warnings denied, that stale import prevents\n`codex-core` test targets from compiling across platforms.\n\n## What changed\n\nRemove the unused `PathExt` import. Remaining `.abs()` calls in the\nmodule operate on `PathBuf` and continue to use `PathBufExt`.\n\n## Validation\n\n- `just fmt`\n- Focused `codex-core` test compile attempted; blocked locally by disk\nexhaustion before compilation completed. The CI failure itself is the\nunused-import diagnostic this change removes.","verified_at":"2026-06-15T16:56:21Z"}},"url":"https://api.github.com/repos/openai/codex/commits/5e58b6d77f91d4f50197680b1afb21a0ce2eee34","html_url":"https://github.com/openai/codex/commit/5e58b6d77f91d4f50197680b1afb21a0ce2eee34","comments_url":"https://api.github.com/repos/openai/codex/commits/5e58b6d77f91d4f50197680b1afb21a0ce2eee34/comments","author":{"login":"pakrym-oai","id":204937752,"node_id":"U_kgDODDcaGA","avatar_url":"https://avatars.githubusercontent.com/u/204937752?v=4","gravatar_id":"","url":"https://api.github.com/users/pakrym-oai","html_url":"https://github.com/pakrym-oai","followers_url":"https://api.github.com/users/pakrym-oai/followers","following_url":"https://api.github.com/users/pakrym-oai/following{/other_user}","gists_url":"https://api.github.com/users/pakrym-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/pakrym-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pakrym-oai/subscriptions","organizations_url":"https://api.github.com/users/pakrym-oai/orgs","repos_url":"https://api.github.com/users/pakrym-oai/repos","events_url":"https://api.github.com/users/pakrym-oai/events{/privacy}","received_events_url":"https://api.github.com/users/pakrym-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"95765542c92c922fae4a9b2ce8a97d101702d24d","url":"https://api.github.com/repos/openai/codex/commits/95765542c92c922fae4a9b2ce8a97d101702d24d","html_url":"https://github.com/openai/codex/commit/95765542c92c922fae4a9b2ce8a97d101702d24d"}]},{"sha":"95765542c92c922fae4a9b2ce8a97d101702d24d","node_id":"C_kwDOOYsS4doAKDk1NzY1NTQyYzkyYzkyMmZhZTRhOWIyY2U4YTk3ZDEwMTcwMmQyNGQ","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-15T16:48:47Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T16:48:47Z"},"message":"avoid cloning websocket request history (#28313)\n\n## Why\n\nWebSocket continuations only send the new part of a request. Checking\nwhether a request could be continued was cloning the full previous\nrequest, the current request, and their input history.\n\nFor long conversations or large tool lists, that meant copying several\nrequest-sized values on every continuation.\n\n## What changed\n\n- compare the request settings by reference\n- check the previous input and server response as borrowed prefixes\n- allocate only the new input items that will be sent\n\nThe reuse rules stay the same, including ignoring `client_metadata` for\nthis check.\n\nThe comparison is still `O(n)`, but it removes several `O(n)`\nallocations and copies. Temporary memory no longer grows by multiple\nfull request sizes for each continuation.\n\n## Performance\n\nLocal rollout traces show continuation checks on turns around 260k input\ntokens. Before this change the reuse gate cloned the previous request,\nthe current request, and the previous input history before deciding\nwhether it could continue incrementally. After this change it borrows\nthose structures and allocates only the incremental tail. For large\ncontinuations with a small delta, that removes roughly three\nrequest-sized copies from the hot path and reduces temporary memory from\nmultiple full request sizes to just the new tail.\n\n## Validation\n\n- `just test -p codex-core\nresponses_websocket_v2_creates_with_previous_response_id_on_prefix`\n- `just test -p codex-core\nresponses_websocket_v2_creates_without_previous_response_id_when_non_input_fields_change`","tree":{"sha":"debcaf12bc224790c2dec90970f22c10530e183e","url":"https://api.github.com/repos/openai/codex/git/trees/debcaf12bc224790c2dec90970f22c10530e183e"},"url":"https://api.github.com/repos/openai/codex/git/commits/95765542c92c922fae4a9b2ce8a97d101702d24d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMCzvCRC1aQ7uu5UhlAAAK70QABm2gXmSVtjM+LCqgflgqmjo\nOPpY4vnE49HyFoBMIZw8Guxb3u6yL/InqJzus3TCbHKC3qForDwAS7siuXGW2Etj\nPu0KN+PODje2nbXnJZQg/EsO8qJEhZpHqky/y5pCqjMabp9hDJ03MkMtZNp7FCLC\n+PnqGLMYj+Z15o312hfZlvUnGWfm8zM1/B4rtLluBb33v0NFmzI6CsKjjdHHzSZy\nJTVIOIeMp4jU0tZFK6gWPCE1aeVCngFRSAMhx3jCWEGuNAMahNV2jLBXFPKUB/41\nxdG17zqYgOvpPZR2rbPUCCCnjn70EvCv8YTvmgKU7VUb4dLqeR1ZLEMJLgXbN4MR\nn8jBresEfUqTv7TJ8GoI3gBHy5I2V4Tux4zpdrgOhR39wF64KSIbwdZB5CELq2SJ\n0mWtgtexkYyF40goypTeLKVCh13K6aQfd1ZQ0vdzOI/AQ1ed5vb0T4I9USYUVW3v\n92m6wNSYBh+pPf50GOaZ8vc3SM7bjYuIQmAM/9wMvrWKJG75RB9ItUbkgU6fp5Jt\nJoBhDHWNRGgXipqQJFzlR+07IdFCUGzJjH6b5KwlZgY6ODDlA6KLFCpj/ao2ZT36\n2RhRxdKn0TQVJPczqSINCuGDVo9p0eJRWWPKjFpo/WK+Z1itr3Ovu+PoKe643Qni\nZo9C8B5xTbxTQu1gdTdq\n=hLCZ\n-----END PGP SIGNATURE-----\n","payload":"tree debcaf12bc224790c2dec90970f22c10530e183e\nparent baddb5e68632d3248750305be39179dae6c049dc\nauthor jif <jif@openai.com> 1781542127 +0100\ncommitter GitHub <noreply@github.com> 1781542127 +0200\n\navoid cloning websocket request history (#28313)\n\n## Why\n\nWebSocket continuations only send the new part of a request. Checking\nwhether a request could be continued was cloning the full previous\nrequest, the current request, and their input history.\n\nFor long conversations or large tool lists, that meant copying several\nrequest-sized values on every continuation.\n\n## What changed\n\n- compare the request settings by reference\n- check the previous input and server response as borrowed prefixes\n- allocate only the new input items that will be sent\n\nThe reuse rules stay the same, including ignoring `client_metadata` for\nthis check.\n\nThe comparison is still `O(n)`, but it removes several `O(n)`\nallocations and copies. Temporary memory no longer grows by multiple\nfull request sizes for each continuation.\n\n## Performance\n\nLocal rollout traces show continuation checks on turns around 260k input\ntokens. Before this change the reuse gate cloned the previous request,\nthe current request, and the previous input history before deciding\nwhether it could continue incrementally. After this change it borrows\nthose structures and allocates only the incremental tail. For large\ncontinuations with a small delta, that removes roughly three\nrequest-sized copies from the hot path and reduces temporary memory from\nmultiple full request sizes to just the new tail.\n\n## Validation\n\n- `just test -p codex-core\nresponses_websocket_v2_creates_with_previous_response_id_on_prefix`\n- `just test -p codex-core\nresponses_websocket_v2_creates_without_previous_response_id_when_non_input_fields_change`","verified_at":"2026-06-15T16:48:47Z"}},"url":"https://api.github.com/repos/openai/codex/commits/95765542c92c922fae4a9b2ce8a97d101702d24d","html_url":"https://github.com/openai/codex/commit/95765542c92c922fae4a9b2ce8a97d101702d24d","comments_url":"https://api.github.com/repos/openai/codex/commits/95765542c92c922fae4a9b2ce8a97d101702d24d/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"baddb5e68632d3248750305be39179dae6c049dc","url":"https://api.github.com/repos/openai/codex/commits/baddb5e68632d3248750305be39179dae6c049dc","html_url":"https://github.com/openai/codex/commit/baddb5e68632d3248750305be39179dae6c049dc"}]},{"sha":"baddb5e68632d3248750305be39179dae6c049dc","node_id":"C_kwDOOYsS4doAKGJhZGRiNWU2ODYzMmQzMjQ4NzUwMzA1YmUzOTE3OWRhZTZjMDQ5ZGM","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-15T16:33:35Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T16:33:35Z"},"message":"serialize websocket requests directly (#28323)\n\n## Why\n\nResponses WebSocket requests were encoded in two steps: first into a\nfull `serde_json::Value`, then again into the JSON string sent over the\nsocket.\n\nThat walks the full request twice and keeps an extra JSON tree alive.\nThese requests can contain the complete conversation history and tool\nschemas, so the extra work grows with the request size.\n\n## What changed\n\n- serialize `ResponsesWsRequest` directly to the wire string\n- pass that string through the existing WebSocket stream and send path\n- keep the existing error mapping, tracing, send timeout, and telemetry\nbehavior\n- compare the new wire JSON with the previous `to_value` payload in a\nfocused test\n\n## Performance\n\nI measured both paths in an optimized temporary test using a\n6,324,180-byte request: 4 MiB of history plus 256 tools with 8 KiB\ndescriptions. Each path ran 100 times.\n\n- previous `to_value` + `to_string`: 209 ms total, 2.09 ms per request\n- direct `to_string`: 174 ms total, 1.74 ms per request\n- difference: about 17% faster, or 0.35 ms per request\n\nThe direct path also removes one full temporary `serde_json::Value`\ntree. For this mostly string-backed payload, that avoids roughly one\npayload-sized copy plus the JSON node overhead. The exact memory saving\ndepends on the request shape.\n\nThe temporary benchmark was removed before committing.\n\n## Validation\n\n- `just test -p codex-api` — 125 passed\n- `just fix -p codex-api`","tree":{"sha":"c7a88dfa86de1f2acf404e68975cb13922a133a9","url":"https://api.github.com/repos/openai/codex/git/trees/c7a88dfa86de1f2acf404e68975cb13922a133a9"},"url":"https://api.github.com/repos/openai/codex/git/commits/baddb5e68632d3248750305be39179dae6c049dc","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMClfCRC1aQ7uu5UhlAAAC4MQAAhKx8dNrCSJwb39cC3VLA2X\nkGDT4b/9AOt3fCPVvIO7fFEy1JmPzMfTwvthAEPzJGW0K2BhLko+olzULpWt+hQ3\nITbzzzRMxBpUx7TfSXboNkIag4TwtuQ6MDxTZBWAY9Kp/K9pXn6VvaZfkMvLhChB\nQQ6ahgIbzdz0QRRjNv1tLthr6+vsZjmkErVQmykwHNpG+/ye+y6xvhXDQNJZ4uQv\n8+dCM34dLqvEjJahStQoTqup3Kk7a/LzLst1q0BrZ2OdyQpIDMII2zlqqgOeh2dK\n2H0v3TplddudjNVbApL2vtit0kgA/jzTtCoC/uzD7DcRfeKLPxKxuNIVoLXmG8iQ\nKSQ5nLrqi+GLlRKzAtGPykqLvR4zjbQOO0lCsK9GvJ6rOywXr+SWKCrUcFbrY1VB\nxPkuXTnwmQnCr00K6Kwb0U2TL1C4mX1voPs8DyTUXaRS5UK1uSnF+g/nB16rFbVr\nsma6d0/cEvEf/ycH9WvEuqyhy8lMETtdgU3Jo2/j/34jF0hzvquOFbNXik64TV4U\nHty9mRBnmUn+QwRB5P4DhYgrgsGhdtB9QnK/0t0fJMPFyG1UpbHcAyi/pBkTRFeW\nAAN9nB0aofX33LjlphMEhwQctXSzW4b4ErI52WW8R+hNGj3K88Bv/b9ohvsR24SG\n8OVnGObFF50xoo4VmpZ3\n=rO5V\n-----END PGP SIGNATURE-----\n","payload":"tree c7a88dfa86de1f2acf404e68975cb13922a133a9\nparent e67bc683f33baf65b35d6ffd5d4ca7972a5c3711\nauthor jif <jif@openai.com> 1781541215 +0100\ncommitter GitHub <noreply@github.com> 1781541215 +0200\n\nserialize websocket requests directly (#28323)\n\n## Why\n\nResponses WebSocket requests were encoded in two steps: first into a\nfull `serde_json::Value`, then again into the JSON string sent over the\nsocket.\n\nThat walks the full request twice and keeps an extra JSON tree alive.\nThese requests can contain the complete conversation history and tool\nschemas, so the extra work grows with the request size.\n\n## What changed\n\n- serialize `ResponsesWsRequest` directly to the wire string\n- pass that string through the existing WebSocket stream and send path\n- keep the existing error mapping, tracing, send timeout, and telemetry\nbehavior\n- compare the new wire JSON with the previous `to_value` payload in a\nfocused test\n\n## Performance\n\nI measured both paths in an optimized temporary test using a\n6,324,180-byte request: 4 MiB of history plus 256 tools with 8 KiB\ndescriptions. Each path ran 100 times.\n\n- previous `to_value` + `to_string`: 209 ms total, 2.09 ms per request\n- direct `to_string`: 174 ms total, 1.74 ms per request\n- difference: about 17% faster, or 0.35 ms per request\n\nThe direct path also removes one full temporary `serde_json::Value`\ntree. For this mostly string-backed payload, that avoids roughly one\npayload-sized copy plus the JSON node overhead. The exact memory saving\ndepends on the request shape.\n\nThe temporary benchmark was removed before committing.\n\n## Validation\n\n- `just test -p codex-api` — 125 passed\n- `just fix -p codex-api`","verified_at":"2026-06-15T16:33:36Z"}},"url":"https://api.github.com/repos/openai/codex/commits/baddb5e68632d3248750305be39179dae6c049dc","html_url":"https://github.com/openai/codex/commit/baddb5e68632d3248750305be39179dae6c049dc","comments_url":"https://api.github.com/repos/openai/codex/commits/baddb5e68632d3248750305be39179dae6c049dc/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e67bc683f33baf65b35d6ffd5d4ca7972a5c3711","url":"https://api.github.com/repos/openai/codex/commits/e67bc683f33baf65b35d6ffd5d4ca7972a5c3711","html_url":"https://github.com/openai/codex/commit/e67bc683f33baf65b35d6ffd5d4ca7972a5c3711"}]},{"sha":"e67bc683f33baf65b35d6ffd5d4ca7972a5c3711","node_id":"C_kwDOOYsS4doAKGU2N2JjNjgzZjMzYmFmNjViMzVkNmZmZDVkNGNhNzk3MmE1YzM3MTE","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-15T16:26:44Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T16:26:44Z"},"message":"avoid cloning sampling request input (#28306)\n\n## Why\n\nEvery model request cloned the full prepared input just to keep it for\nthe legacy after-agent hook. That copy gets more expensive as the\nconversation grows.\n\n## What\n\nMove the prepared input into the sampling loop and return it with the\nresult. If the request retries, keep the first input so the hook still\nsees the same data as before.\n\nThis removes one `O(n)` clone per sampling request, where `n` is the\nsize of the prepared input. It saves `O(n)` copy work and `O(n)`\ntemporary memory.\n\nNo behavior change is intended.\n\n## Performance\n\nLocal rollout traces show turns reaching roughly 260k input tokens. On\nturns of that size, this removes the only unconditional full\nprepared-input clone on the happy path. That avoids one request-sized\nallocation/copy per sampling attempt for large conversations, and the\nsavings scale linearly with request size.\n\n## Testing\n\n- `just test -p codex-core continue_after_stream_error`\n- `just fix -p codex-core`","tree":{"sha":"0b37c3b9982962a773d65557cd9421560fa8725f","url":"https://api.github.com/repos/openai/codex/git/trees/0b37c3b9982962a773d65557cd9421560fa8725f"},"url":"https://api.github.com/repos/openai/codex/git/commits/e67bc683f33baf65b35d6ffd5d4ca7972a5c3711","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMCfECRC1aQ7uu5UhlAAAg3wQAGG/lQJSGeuOI/P/tfs3bvWV\nWlXzU+CzYLQaWB04i9zqjAlOusDP3lDeyrcP0nRQOXnW9m5r3908xNF49+5+sflJ\ngEmV1P7P3uYVyfPg54+2mWUyYMmP2hPJS8OJ4Mqb6r8UV6HqNgT2rWiUR+kjFnAY\nWmPP6P16ys4Scm4Uonf/HRq4WP8xAIbpD9b/S7rGcGxFvbYENx2W0hj+Z7Zz5z9c\npTM1TQg6FdWxAue12G7HE7tUOzjW7wURHhq0c5xfXWg9weSdJ0mWGszab8aXMtQd\nBFYdc2NgFu+p+mIZR6phbFdgL0Yx9Rp0y2MB9Znbe05psybp5N+XPtOGaEeoQEf8\nkGmHK/TBJrYmh/a3/0wAMOZ9EQ63IuNxNHBCz6ifaKQJarzCu0WlUmwq+CPf7RBM\n1It4gAezW3Dy7rrWFbSnXK0EMsoGHZEysjHE6E2OpLJGesiGbTYJ1LKknKjYT3q2\nfiHesonEvdbSgPGaMdKob4q8YJeWRqmhOapwC3li28cZlFRW1TKZ8RF98QI3WsTX\neVU5FRbihfuS6bjF40Nzp22lFZOtkxBYJTQdGegwqfltQM3vfTOq048anKd1dOBe\nYcSWFZVDxPjb/PwRwbj4TXOjXzU19FOoZtYX/8O0Kr4m9NTCLE2F80U6RJW2Ybit\nGczRJFiBdeKN//lTczyv\n=ifbc\n-----END PGP SIGNATURE-----\n","payload":"tree 0b37c3b9982962a773d65557cd9421560fa8725f\nparent 828d7476a0192e025fb4b5375743b00473799707\nauthor jif <jif@openai.com> 1781540804 +0100\ncommitter GitHub <noreply@github.com> 1781540804 +0200\n\navoid cloning sampling request input (#28306)\n\n## Why\n\nEvery model request cloned the full prepared input just to keep it for\nthe legacy after-agent hook. That copy gets more expensive as the\nconversation grows.\n\n## What\n\nMove the prepared input into the sampling loop and return it with the\nresult. If the request retries, keep the first input so the hook still\nsees the same data as before.\n\nThis removes one `O(n)` clone per sampling request, where `n` is the\nsize of the prepared input. It saves `O(n)` copy work and `O(n)`\ntemporary memory.\n\nNo behavior change is intended.\n\n## Performance\n\nLocal rollout traces show turns reaching roughly 260k input tokens. On\nturns of that size, this removes the only unconditional full\nprepared-input clone on the happy path. That avoids one request-sized\nallocation/copy per sampling attempt for large conversations, and the\nsavings scale linearly with request size.\n\n## Testing\n\n- `just test -p codex-core continue_after_stream_error`\n- `just fix -p codex-core`","verified_at":"2026-06-15T16:26:45Z"}},"url":"https://api.github.com/repos/openai/codex/commits/e67bc683f33baf65b35d6ffd5d4ca7972a5c3711","html_url":"https://github.com/openai/codex/commit/e67bc683f33baf65b35d6ffd5d4ca7972a5c3711","comments_url":"https://api.github.com/repos/openai/codex/commits/e67bc683f33baf65b35d6ffd5d4ca7972a5c3711/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"828d7476a0192e025fb4b5375743b00473799707","url":"https://api.github.com/repos/openai/codex/commits/828d7476a0192e025fb4b5375743b00473799707","html_url":"https://github.com/openai/codex/commit/828d7476a0192e025fb4b5375743b00473799707"}]},{"sha":"828d7476a0192e025fb4b5375743b00473799707","node_id":"C_kwDOOYsS4doAKDgyOGQ3NDc2YTAxOTJlMDI1ZmI0YjUzNzU3NDNiMDA0NzM3OTk3MDc","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-15T16:26:34Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T16:26:34Z"},"message":"linearize history output normalization (#28309)\n\n## Why\n\nWhen we prepare the conversation history, every tool call needs a\nmatching output.\n\nBefore this change, we scanned the full history again for every call. In\na tool-heavy conversation, that makes the work `O(items x calls)`, or\n`O(n^2)` in the worst case.\n\n## What\n\nScan the history once and collect the IDs of existing outputs. Then each\ncall can check its ID with an expected `O(1)` lookup.\n\nThe full normalization step is now expected `O(n)`. The output order and\nmissing-output behavior stay the same.\n\n## Performance\n\nBased on local rollout traces, one tool-heavy session reached roughly\n17,050 transcript items with about 4,292 tool-call items. On a history\nof that shape, the old `calls x items` scan does about 73.2 million\nmembership checks, while the new pass does about 21.3 thousand set\ninserts/lookups. That is roughly 3.4k times less membership work in this\nnormalization step.\n\n## Validation\n\n- `just test -p codex-core normalize_` (19 passed)","tree":{"sha":"14550fc0a7aa0c930e9cfff61d7fa24206104134","url":"https://api.github.com/repos/openai/codex/git/trees/14550fc0a7aa0c930e9cfff61d7fa24206104134"},"url":"https://api.github.com/repos/openai/codex/git/commits/828d7476a0192e025fb4b5375743b00473799707","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMCe6CRC1aQ7uu5UhlAAAWnoQAIh0aNuAdPTLh2QxbcQmAoAH\nbBy1DLL/p+tDgCOulVqfujjgGIdK+Iw++r+fcNrBsXwN0kOiSjL2N8kRlZ9dnw50\nwxA4ocA/edLCRBEejWHcBEExmNzyqn39OxfG525VCyb/O0Qwwe2USAnu+McWZYl6\nwOFFukbn4Xxw4mebHyYeTd6+h65LHAoU32ByiLjbJJHKbBi4Im1yDI6Cblv1XNtm\nqFKdkiUFtXhmHrjclzt017d0XX5DRjYVS7R+ZrGGDUy7M3KptcHvNpqr0y43XkTi\n3tfAuILqoyYgqdPOfW2Mau5ij3655JRPpRqTxZWnFRm1F6z/isYRFow4pdXuQSvP\n1zJF8+aJ+/tJ0DmiKhYSTHCMl1n6Y0ro+sCo0f3GbbXPSE3kRCMN9N33Jw9HahKz\nISmrcSTsxgmTeWErtFObq1Vj0V2H9FSCp/1fhtzN2WHcATZS+nPGhNGYCljB+tgV\nozysHEwey9sUfIzYahAxdWs4XZ3g/AC7kx+NEZwYSNSJKtSAawVBjHHXRYfifReN\nzcvDKmPDRHinDXvGf2UNj8DvcOr//KQ2ojhqdkdpKjvgfvoXvuk7GzEnWGsn+9Kg\nUVu80BZkYCVd1lAvaTzh4DqW4vcwkPaYFVHbB4MDlHv72n98dOzWn2d9ZGX5GRyw\nnfoZZDF4eyPglTk02NTA\n=j/h1\n-----END PGP SIGNATURE-----\n","payload":"tree 14550fc0a7aa0c930e9cfff61d7fa24206104134\nparent 11faf9af94fa345ba090701f071c8d3107fbca45\nauthor jif <jif@openai.com> 1781540794 +0100\ncommitter GitHub <noreply@github.com> 1781540794 +0200\n\nlinearize history output normalization (#28309)\n\n## Why\n\nWhen we prepare the conversation history, every tool call needs a\nmatching output.\n\nBefore this change, we scanned the full history again for every call. In\na tool-heavy conversation, that makes the work `O(items x calls)`, or\n`O(n^2)` in the worst case.\n\n## What\n\nScan the history once and collect the IDs of existing outputs. Then each\ncall can check its ID with an expected `O(1)` lookup.\n\nThe full normalization step is now expected `O(n)`. The output order and\nmissing-output behavior stay the same.\n\n## Performance\n\nBased on local rollout traces, one tool-heavy session reached roughly\n17,050 transcript items with about 4,292 tool-call items. On a history\nof that shape, the old `calls x items` scan does about 73.2 million\nmembership checks, while the new pass does about 21.3 thousand set\ninserts/lookups. That is roughly 3.4k times less membership work in this\nnormalization step.\n\n## Validation\n\n- `just test -p codex-core normalize_` (19 passed)","verified_at":"2026-06-15T16:26:34Z"}},"url":"https://api.github.com/repos/openai/codex/commits/828d7476a0192e025fb4b5375743b00473799707","html_url":"https://github.com/openai/codex/commit/828d7476a0192e025fb4b5375743b00473799707","comments_url":"https://api.github.com/repos/openai/codex/commits/828d7476a0192e025fb4b5375743b00473799707/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"11faf9af94fa345ba090701f071c8d3107fbca45","url":"https://api.github.com/repos/openai/codex/commits/11faf9af94fa345ba090701f071c8d3107fbca45","html_url":"https://github.com/openai/codex/commit/11faf9af94fa345ba090701f071c8d3107fbca45"}]},{"sha":"11faf9af94fa345ba090701f071c8d3107fbca45","node_id":"C_kwDOOYsS4doAKDExZmFmOWFmOTRmYTM0NWJhMDkwNzAxZjA3MWM4ZDMxMDdmYmNhNDU","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-06-15T15:35:57Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T15:35:57Z"},"message":"Expose explicit dynamic tool namespaces in thread start (#27371)\n\nStacked on #27365.\n\n## Stack note\n\n[#27365](https://github.com/openai/codex/pull/27365) kept `thread/start`\nunchanged and converted its input in `thread_processor`. This PR updates\n`thread/start` to accept explicit functions and namespaces directly.\n\nLegacy per-tool arrays are still accepted and converted while reading\nthe request. As a result, `thread_processor` can validate and pass the\ntools through directly, which is why some code added in #27365 is\nremoved here.\n\n## Why\n\n`thread/start.dynamicTools` still repeats namespace data on each\nfunction even though core now stores explicit namespace groups. The\nrequest API should use the same shape so each namespace has one\ndescription and one member list.\n\n## What changed\n\n- Accept top-level functions and explicit namespace objects in\n`dynamicTools`.\n- Continue accepting fully legacy flat arrays, including\n`exposeToContext`.\n- Reject arrays that mix legacy and canonical entries.\n- Reuse the protocol types directly and remove the temporary app-server\nadapter.\n- Update validation, docs, the test client, and generated schemas.\n\n## Test plan\n\n- `just test -p codex-app-server-protocol`\n- `just test -p codex-app-server\ndynamic_tool_call_round_trip_sends_text_content_items_to_model`\n- `just test -p codex-app-server\nthread_start_normalizes_legacy_dynamic_tools_into_model_request`\n- `just test -p codex-app-server\nthread_start_rejects_mixed_dynamic_tool_formats`\n- `just test -p codex-app-server\nthread_start_rejects_hidden_dynamic_tools_without_namespace`","tree":{"sha":"03ad00e290f37ded427abc03b5d301cb9b599bf8","url":"https://api.github.com/repos/openai/codex/git/trees/03ad00e290f37ded427abc03b5d301cb9b599bf8"},"url":"https://api.github.com/repos/openai/codex/git/commits/11faf9af94fa345ba090701f071c8d3107fbca45","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMBvdCRC1aQ7uu5UhlAAAycMQAGY/VOX8xw2XLSxa10hfS+n2\nNPODYqr9nHpXzqbo49irdYtlEO74/XfUIJkR9zrccZspdaXbZS40Cq4n7zqWrM6r\nYW1+YSYuWi+X4jEGXDkIUuW49NlYR5vzMsF7zaoHlRV1tQ6+I3w3XaZOWtlSm45f\nl6zufMiGnU9+UeutJ6P48Bw6QKJn2N68YDE0bVX8/1qgK55G20Q4O+WDvzz74YFs\ncekZHgSZm8m0q5E+tdu74Tc3yHIhdlUsIfx5KV1p2/h8eFpEOYzCPasPQ/VaIibb\nxN/1JJdjW8FoSRa3mui2AP1TFtq25DGWkMKy9JAm2RMqNDnbrScf2u5UspBlWC0E\nQeCyvz7rUOp8W7AvpFAOjWfIZBincNjuzxzmgoykvlaglLsqjHjwy4cGrSdEf8hk\nDPOmzl9TAzC0TXRIuKGi9ZtDooZ98fnwac8vdIlckE/hT0tjfRTxC2XlTkqRAIsO\ncusOAG5Ld7IW7uxVKhWXcG1ya7KyiWOSFVOVE3CRoTto/fC5vvPiwoWu/mowjl5Q\njyqCSqDpx9rhhil3SNSr79lNVbkQ6g/z72zRD23V5YyyokCL3mBhrDLIIJ868VvO\n7JVqX5ItlykmzBE8f072vhHq7ttuk+7pdmlu24lhair2CuGQW7jlIPfCpgPlNSzO\n2iDNBkhrVF8ikflcCJxn\n=Z3tg\n-----END PGP SIGNATURE-----\n","payload":"tree 03ad00e290f37ded427abc03b5d301cb9b599bf8\nparent 42ad752f36190026b5b697530ada2805eb0e0ef2\nauthor sayan-oai <sayan@openai.com> 1781537757 -0700\ncommitter GitHub <noreply@github.com> 1781537757 +0000\n\nExpose explicit dynamic tool namespaces in thread start (#27371)\n\nStacked on #27365.\n\n## Stack note\n\n[#27365](https://github.com/openai/codex/pull/27365) kept `thread/start`\nunchanged and converted its input in `thread_processor`. This PR updates\n`thread/start` to accept explicit functions and namespaces directly.\n\nLegacy per-tool arrays are still accepted and converted while reading\nthe request. As a result, `thread_processor` can validate and pass the\ntools through directly, which is why some code added in #27365 is\nremoved here.\n\n## Why\n\n`thread/start.dynamicTools` still repeats namespace data on each\nfunction even though core now stores explicit namespace groups. The\nrequest API should use the same shape so each namespace has one\ndescription and one member list.\n\n## What changed\n\n- Accept top-level functions and explicit namespace objects in\n`dynamicTools`.\n- Continue accepting fully legacy flat arrays, including\n`exposeToContext`.\n- Reject arrays that mix legacy and canonical entries.\n- Reuse the protocol types directly and remove the temporary app-server\nadapter.\n- Update validation, docs, the test client, and generated schemas.\n\n## Test plan\n\n- `just test -p codex-app-server-protocol`\n- `just test -p codex-app-server\ndynamic_tool_call_round_trip_sends_text_content_items_to_model`\n- `just test -p codex-app-server\nthread_start_normalizes_legacy_dynamic_tools_into_model_request`\n- `just test -p codex-app-server\nthread_start_rejects_mixed_dynamic_tool_formats`\n- `just test -p codex-app-server\nthread_start_rejects_hidden_dynamic_tools_without_namespace`","verified_at":"2026-06-15T15:35:57Z"}},"url":"https://api.github.com/repos/openai/codex/commits/11faf9af94fa345ba090701f071c8d3107fbca45","html_url":"https://github.com/openai/codex/commit/11faf9af94fa345ba090701f071c8d3107fbca45","comments_url":"https://api.github.com/repos/openai/codex/commits/11faf9af94fa345ba090701f071c8d3107fbca45/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"42ad752f36190026b5b697530ada2805eb0e0ef2","url":"https://api.github.com/repos/openai/codex/commits/42ad752f36190026b5b697530ada2805eb0e0ef2","html_url":"https://github.com/openai/codex/commit/42ad752f36190026b5b697530ada2805eb0e0ef2"}]},{"sha":"42ad752f36190026b5b697530ada2805eb0e0ef2","node_id":"C_kwDOOYsS4doAKDQyYWQ3NTJmMzYxOTAwMjZiNWI2OTc1MzBhZGEyODA1ZWIwZTBlZjI","commit":{"author":{"name":"pakrym-oai","email":"pakrym@openai.com","date":"2026-06-15T15:28:02Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T15:28:02Z"},"message":"[codex] simplify memory read metrics (#28164)\n\n## Why\n\nMemory read telemetry currently reconstructs the executable shell\ncommand after a tool call finishes. That duplicates shell, login-policy,\nand cwd resolution owned by the tool handlers, and can diverge from the\nenvironment-specific command that unified exec actually ran.\n\n## What changed\n\n- Expose the existing restricted shell-script parser directly for raw\nscript text.\n- Parse `shell_command` and `exec_command` input into plain command argv\nbefore classifying memory reads.\n- Preserve all-or-nothing safe-command validation for multi-command\nscripts.\n- Remove cwd resolution, shell selection, and the unnecessary async\nboundary from memory read metric emission.\n\n## Testing\n\n- `just test -p codex-shell-command`\n- `cargo check -p codex-core`","tree":{"sha":"4f5d10d0071a37edefb5f69be5459f5a27355d81","url":"https://api.github.com/repos/openai/codex/git/trees/4f5d10d0071a37edefb5f69be5459f5a27355d81"},"url":"https://api.github.com/repos/openai/codex/git/commits/42ad752f36190026b5b697530ada2805eb0e0ef2","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMBoCCRC1aQ7uu5UhlAAAs5gQACygljPUkNkkCeJZArdhDBSV\npBV+P+8g2hN6OrBhSRjOgdj0mZrV4q+tRGTFVsbwcrJ8HRR5SO1YisEWa+MUQUHQ\nIcP6cJvbEV2ErOmYtSOHxWxfCGg9s+0mmbg/HwXWRANTL3/XAUgdGuTGgWSUWMuP\nA6Ue5FF/KUaCpLVLYRI66UI/IO+3HIDoQ1gc4PSy2gj4plwZaAp1mYhwAt6EOsiD\nAfSHGf1B+qpO/QIV2MmnMxaaaTJQCprvH9L+85b3A2f1zjFeoMGLl4wcKZA0n7EV\nIFnzUFA5c5ayQWZ5ZiWDdwz2cNfmx2w/WM8upRUMnOt229VOeT981nzq6cvzFqDE\na/4xr5Hh19CDHb3YRjpHtrgre+xNBU/hRtLTtW4XTa5yS4JNhHOM9oYcutc95OmA\n4D7LyfULyBXW3KkyyVdk3ziixlnd2cdg2VGwXXWyE74LSJKGYDTEvvrdG/HchEj1\npvZv9msL9+xXSMGkyRK0a+Vz/j+zRZxBj10fRYHFz9v5UP9B2+R1mgs1ZOP2QhO2\nevyYUGJQ9/jc3e09XXOIABeWo2r7nS5Z1uwaQ3fs0m10Dz2JZsMqB7HG3CsHuXCu\nCKroVdsQorgXsQlv3h/6lUgE/yqixGupOFQKQZbmugoGUDTKqAO4eFNIr+QDpjlq\nEmbmFT45ny/k8ZL+CZUB\n=gceX\n-----END PGP SIGNATURE-----\n","payload":"tree 4f5d10d0071a37edefb5f69be5459f5a27355d81\nparent bbcfed8ac20c8c9f0905f3df74284b23f923d314\nauthor pakrym-oai <pakrym@openai.com> 1781537282 -0700\ncommitter GitHub <noreply@github.com> 1781537282 -0700\n\n[codex] simplify memory read metrics (#28164)\n\n## Why\n\nMemory read telemetry currently reconstructs the executable shell\ncommand after a tool call finishes. That duplicates shell, login-policy,\nand cwd resolution owned by the tool handlers, and can diverge from the\nenvironment-specific command that unified exec actually ran.\n\n## What changed\n\n- Expose the existing restricted shell-script parser directly for raw\nscript text.\n- Parse `shell_command` and `exec_command` input into plain command argv\nbefore classifying memory reads.\n- Preserve all-or-nothing safe-command validation for multi-command\nscripts.\n- Remove cwd resolution, shell selection, and the unnecessary async\nboundary from memory read metric emission.\n\n## Testing\n\n- `just test -p codex-shell-command`\n- `cargo check -p codex-core`","verified_at":"2026-06-15T15:28:03Z"}},"url":"https://api.github.com/repos/openai/codex/commits/42ad752f36190026b5b697530ada2805eb0e0ef2","html_url":"https://github.com/openai/codex/commit/42ad752f36190026b5b697530ada2805eb0e0ef2","comments_url":"https://api.github.com/repos/openai/codex/commits/42ad752f36190026b5b697530ada2805eb0e0ef2/comments","author":{"login":"pakrym-oai","id":204937752,"node_id":"U_kgDODDcaGA","avatar_url":"https://avatars.githubusercontent.com/u/204937752?v=4","gravatar_id":"","url":"https://api.github.com/users/pakrym-oai","html_url":"https://github.com/pakrym-oai","followers_url":"https://api.github.com/users/pakrym-oai/followers","following_url":"https://api.github.com/users/pakrym-oai/following{/other_user}","gists_url":"https://api.github.com/users/pakrym-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/pakrym-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pakrym-oai/subscriptions","organizations_url":"https://api.github.com/users/pakrym-oai/orgs","repos_url":"https://api.github.com/users/pakrym-oai/repos","events_url":"https://api.github.com/users/pakrym-oai/events{/privacy}","received_events_url":"https://api.github.com/users/pakrym-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"bbcfed8ac20c8c9f0905f3df74284b23f923d314","url":"https://api.github.com/repos/openai/codex/commits/bbcfed8ac20c8c9f0905f3df74284b23f923d314","html_url":"https://github.com/openai/codex/commit/bbcfed8ac20c8c9f0905f3df74284b23f923d314"}]},{"sha":"bbcfed8ac20c8c9f0905f3df74284b23f923d314","node_id":"C_kwDOOYsS4doAKGJiY2ZlZDhhYzIwYzhjOWYwOTA1ZjNkZjc0Mjg0YjIzZjkyM2QzMTQ","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-15T15:24:36Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T15:24:36Z"},"message":"chore: restore exec-server relay keepalives (#28286)\n\n## Why\n\nThe ws pump refactor removed the relay keepalive timers that had been\nadded to keep idle rendezvous connections alive. An idle relay could\ntherefore be closed by the rendezvous service or a load balancer,\ndisconnecting executor-backed MCP processes.\n\n## What\n\n- restore periodic WebSocket ping frames on both rendezvous relay\nendpoints\n- keep missed-tick behavior bounded with `MissedTickBehavior::Skip`\n- cover the harness and remote-environment pumps with focused\ntraffic-after-keepalive tests","tree":{"sha":"203bc9e35929bae62fa7f8ed6b66e40c984ade20","url":"https://api.github.com/repos/openai/codex/git/trees/203bc9e35929bae62fa7f8ed6b66e40c984ade20"},"url":"https://api.github.com/repos/openai/codex/git/commits/bbcfed8ac20c8c9f0905f3df74284b23f923d314","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMBk1CRC1aQ7uu5UhlAAAzoUQAGq9JTfMsNsIOU/kgxDSv+fL\nYDw76hcS2krWhgmD7UTi3Wjy5xy4PxDbpFsC1yMoWw70rswIQx5sI86JOhVhPmuI\nwH+q0Ms9j1n9uusKnR7Ap2/Vg61pVWDjE9+W1lj9zTjCFm1u/xQQ0YkkLU4NISsB\nSIb998uzSJqDpAPM5w1OW+muOkuQNFpCPC2r8CsAln3FDxJVDuuCsi1wpiLW1gVa\n+wMEM4cTck5cVQsTTl19jAhpMav/YwVqoaTMqD8HVHW4HtUxI67nE2zOnqNsHK0K\ngExIQaPaazUess7SaNc+/xcKsRl9pKvTEHCxPHMBVqvsH8kcudIEnBU032LRhYFh\nwiPMr8OysQOt0sa8Fb2LRPa9CQPDLbPukXx9V7NRWlgl7XOGpGBMdcNuMjVdx2+5\nO18WaB6LxacU2C6CcAX0WNSwAitHmJFwCj1gC6E+x57Udgp48VKhKt+5EIMjr0FF\n/m6zj9ostEirbk2iTnKaBsWJVdLT9biaaQxkyZtaURX2lxJFx2QCYlEo/xMWvvJh\nzTcS6pLCO55zkBhqTouNJXeeCAXPduonej5kkEQpD5L1U7fBYLjLFpGsgh/HU0Y0\nwdy3LPyOtzz4FpC3YAMXmhl7ntLtc02wrOJhWTeGAENZeLfB0zBKyOSyiegzfeGB\n7x+2YWZcPRm6FaDgd/mH\n=2PdX\n-----END PGP SIGNATURE-----\n","payload":"tree 203bc9e35929bae62fa7f8ed6b66e40c984ade20\nparent 8a6a039f26c22e57f0d4957123cc970d15562295\nauthor jif <jif@openai.com> 1781537076 +0100\ncommitter GitHub <noreply@github.com> 1781537076 +0200\n\nchore: restore exec-server relay keepalives (#28286)\n\n## Why\n\nThe ws pump refactor removed the relay keepalive timers that had been\nadded to keep idle rendezvous connections alive. An idle relay could\ntherefore be closed by the rendezvous service or a load balancer,\ndisconnecting executor-backed MCP processes.\n\n## What\n\n- restore periodic WebSocket ping frames on both rendezvous relay\nendpoints\n- keep missed-tick behavior bounded with `MissedTickBehavior::Skip`\n- cover the harness and remote-environment pumps with focused\ntraffic-after-keepalive tests","verified_at":"2026-06-15T15:24:37Z"}},"url":"https://api.github.com/repos/openai/codex/commits/bbcfed8ac20c8c9f0905f3df74284b23f923d314","html_url":"https://github.com/openai/codex/commit/bbcfed8ac20c8c9f0905f3df74284b23f923d314","comments_url":"https://api.github.com/repos/openai/codex/commits/bbcfed8ac20c8c9f0905f3df74284b23f923d314/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"8a6a039f26c22e57f0d4957123cc970d15562295","url":"https://api.github.com/repos/openai/codex/commits/8a6a039f26c22e57f0d4957123cc970d15562295","html_url":"https://github.com/openai/codex/commit/8a6a039f26c22e57f0d4957123cc970d15562295"}]},{"sha":"8a6a039f26c22e57f0d4957123cc970d15562295","node_id":"C_kwDOOYsS4doAKDhhNmEwMzlmMjZjMjJlNTdmMGQ0OTU3MTIzY2M5NzBkMTU1NjIyOTU","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-06-15T15:23:02Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T15:23:02Z"},"message":"Remove terminal resize reflow flag gates (#27794)\n\n## Why\n\n`terminal_resize_reflow` is now stable and should behave as always on.\nKeeping the disabled runtime paths around made the feature look\nconfigurable even though the rollout is complete, and old config could\nstill suggest there was a supported off mode.\n\n## What Changed\n\n- Marked `terminal_resize_reflow` as `Stage::Removed` while keeping it\ndefault-enabled for compatibility.\n- Ignored `[features].terminal_resize_reflow` config entries so stale\n`false` settings no longer affect the effective feature set.\n- Removed TUI branches that depended on the flag being disabled, so\ndraw, replay buffering, stream finalization, and resize scheduling all\nassume resize reflow is active.\n- Simplified resize smoke coverage to exercise the always-on behavior\nonly.\n\n## Verification\n\n- `just test -p codex-features`\n- `just test -p codex-tui resize_reflow`\n- `just test -p codex-tui initial_replay_buffer\nthread_switch_replay_buffer`","tree":{"sha":"bd0eee4c5003199642b0659c7c7b553d8cac83dd","url":"https://api.github.com/repos/openai/codex/git/trees/bd0eee4c5003199642b0659c7c7b553d8cac83dd"},"url":"https://api.github.com/repos/openai/codex/git/commits/8a6a039f26c22e57f0d4957123cc970d15562295","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMBjWCRC1aQ7uu5UhlAAADAQQAJHZftkuT0JiGvYaD7NWB1pE\n7Hop6f2uwRN6U6cz/wEDrQKDnUnLNhezTgxuLDAv/cVrgUohbv5GxYN5EiXm+SL0\nAcdLighILAyZq0UPGxFwr5UlCWBDfOgxqaQJmk+W22cL+RnmzRfOfz6xT57ZFuwu\nUHxDAf+2SLUzE03Woh5+2iAMqoGSuRlKP+3Bqmrj2lxzBGmDFrRrj0JN7Wgk8Z3h\n4cPUhdzWf9j/z1Yp0LpEclGsmi1Wz7AZ8HuS2IX64+Kwx/nryMDvw90S6zIVk9GD\n+L7dBbnZ4MXL8ANsRFyrA6NMnJQVM2tRvS8ZcU3UPEgs+Fo26Q0eAC51ZwaTo1Hh\nXgh6nUC10i5tbRXCBUIiKvozAppk6ucWvvtsE7KfvHOkXv96YJxky9nG7drgze7O\nRh0h97qt7EUUTRLxscff99E3ifHe5mf3ruqNXzbT2Fkx1RfyZrpdEyZM1pho3/Og\n2ZM59i7MKAdo+GRa71+8fLAWP6W8OhRokjnxYSNEPPOFDqu1uc1+AKgUUyZebWBR\nqMpqKTmuMkQmg+72Irfg0l97zsdrha5c3YtkUeFh0zLP15tWKmM2/3WsuuuQ05WM\nCkoKyo34LNXjwZmXVHLNW5p1LmdUlgrybfa0DdkL+gMegjtUdGLYBFYK+3CGA6I2\nWOALOAm4fneG3ijfyhZb\n=Ck5y\n-----END PGP SIGNATURE-----\n","payload":"tree bd0eee4c5003199642b0659c7c7b553d8cac83dd\nparent 1aa3e432ccf9a853cbe536c159f90d79c576314d\nauthor Eric Traut <etraut@openai.com> 1781536982 -0700\ncommitter GitHub <noreply@github.com> 1781536982 -0700\n\nRemove terminal resize reflow flag gates (#27794)\n\n## Why\n\n`terminal_resize_reflow` is now stable and should behave as always on.\nKeeping the disabled runtime paths around made the feature look\nconfigurable even though the rollout is complete, and old config could\nstill suggest there was a supported off mode.\n\n## What Changed\n\n- Marked `terminal_resize_reflow` as `Stage::Removed` while keeping it\ndefault-enabled for compatibility.\n- Ignored `[features].terminal_resize_reflow` config entries so stale\n`false` settings no longer affect the effective feature set.\n- Removed TUI branches that depended on the flag being disabled, so\ndraw, replay buffering, stream finalization, and resize scheduling all\nassume resize reflow is active.\n- Simplified resize smoke coverage to exercise the always-on behavior\nonly.\n\n## Verification\n\n- `just test -p codex-features`\n- `just test -p codex-tui resize_reflow`\n- `just test -p codex-tui initial_replay_buffer\nthread_switch_replay_buffer`","verified_at":"2026-06-15T15:23:02Z"}},"url":"https://api.github.com/repos/openai/codex/commits/8a6a039f26c22e57f0d4957123cc970d15562295","html_url":"https://github.com/openai/codex/commit/8a6a039f26c22e57f0d4957123cc970d15562295","comments_url":"https://api.github.com/repos/openai/codex/commits/8a6a039f26c22e57f0d4957123cc970d15562295/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"1aa3e432ccf9a853cbe536c159f90d79c576314d","url":"https://api.github.com/repos/openai/codex/commits/1aa3e432ccf9a853cbe536c159f90d79c576314d","html_url":"https://github.com/openai/codex/commit/1aa3e432ccf9a853cbe536c159f90d79c576314d"}]},{"sha":"1aa3e432ccf9a853cbe536c159f90d79c576314d","node_id":"C_kwDOOYsS4doAKDFhYTNlNDMyY2NmOWE4NTNjYmU1MzZjMTU5ZjkwZDc5YzU3NjMxNGQ","commit":{"author":{"name":"pakrym-oai","email":"pakrym@openai.com","date":"2026-06-15T15:18:13Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T15:18:13Z"},"message":"[codex] simplify shell snapshot ownership (#27756)\n\n## Why\n\nShell snapshot lifecycle state was split between `Shell` and\n`SessionServices`: `Shell` carried the receiver while session code\nexposed and forwarded the raw sender. That coupled shell identity to\nmutable snapshot state and made refresh, inheritance, and file lifetime\nharder to reason about.\n\n## What changed\n\n- make each `Arc<ShellSnapshot>` represent one cwd-specific snapshot\ngeneration\n- store the active generation in `SessionServices` with `ArcSwapOption`\n- have construction start the background build and expose only a\ncwd-validated snapshot path\n- use `ShellSnapshotFile` ownership to delete snapshot files\nautomatically\n- pass snapshot paths explicitly to shell runtimes instead of storing\nsnapshot state on `Shell`\n- preserve inherited and in-flight generations by pinning their `Arc`\nwhile they are in use\n\n## Test plan\n\n- `cargo check -p codex-core --lib`\n- `just test -p codex-core 'shell_snapshot::tests'`\n- `just test -p codex-core\nshell_command_snapshot_still_intercepts_apply_patch`\n- `just test -p codex-core\nshell_snapshot_deleted_after_shutdown_with_skills`","tree":{"sha":"6dccf3d558ceafb00045b2e345b86ab7b6bd3646","url":"https://api.github.com/repos/openai/codex/git/trees/6dccf3d558ceafb00045b2e345b86ab7b6bd3646"},"url":"https://api.github.com/repos/openai/codex/git/commits/1aa3e432ccf9a853cbe536c159f90d79c576314d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMBe1CRC1aQ7uu5UhlAAAPVAQAJr0UbjpawrR2uJMIeFTyhml\nPMH/ll6fLuiRedEC5fw2IpEJOWOCZHjoFm2fjVoR1RB68Au6w473AonoCCupd52Z\ns/7tSFhKXtiE8Ld3Zpg3NxhN30AnM2WocVXgJAx3odO6RifZl8GHBb9tisFBsNgF\nKZezqgLG2m5yB+02dc2HCW5xfPY+hVmSHxZ5AwZdjheNm76l1ICkgkBWfYP2cgUY\nGCp3zqVugvFbUaUzckGM9H4gW9N9d7hvLC3mrMDbf/kCDN1hmfZhk+wMGR3kg4v7\nLgL5u2a70kk54tYYmruwpwwWrmKL4o8NYdASzrRy8pRHm3O9mcfSlRLI1nAg5W+c\nENGISOooQZmMwrEMrNV9XzIQ/UeCpNDWHz29GUUGwRZia98JjEbsAJwB6o0/MaAA\nOThWb8RIMTFuq/uNg9Cms2gUI50p7M8HZT1eRHVUpFazwqMBsMIL2ahCgy8MxZta\no/G4IDjKMz2YRqYfPv8G1G/Vc/Z3vsO0gLWfRF9u0u8g8tFmgySW1Mp08lA6J9Y7\nRjZQUL/e7d5ln02xg/hCrOZq9HA6yFtjFdhHlKuXKl3Hv63BbS+rXyBHb+bfMFGa\nJTMzIVzReSQ2m8Fo019m8ZjSeNxmkon4zgn8y4y5Fz0wHavnkeNfLGsFHoYoGiIX\nxrHASwLG9Zx0HEmfAEvP\n=0M65\n-----END PGP SIGNATURE-----\n","payload":"tree 6dccf3d558ceafb00045b2e345b86ab7b6bd3646\nparent 6d9df687a5477d781474ba1a01aa109114e19f6e\nauthor pakrym-oai <pakrym@openai.com> 1781536693 -0700\ncommitter GitHub <noreply@github.com> 1781536693 -0700\n\n[codex] simplify shell snapshot ownership (#27756)\n\n## Why\n\nShell snapshot lifecycle state was split between `Shell` and\n`SessionServices`: `Shell` carried the receiver while session code\nexposed and forwarded the raw sender. That coupled shell identity to\nmutable snapshot state and made refresh, inheritance, and file lifetime\nharder to reason about.\n\n## What changed\n\n- make each `Arc<ShellSnapshot>` represent one cwd-specific snapshot\ngeneration\n- store the active generation in `SessionServices` with `ArcSwapOption`\n- have construction start the background build and expose only a\ncwd-validated snapshot path\n- use `ShellSnapshotFile` ownership to delete snapshot files\nautomatically\n- pass snapshot paths explicitly to shell runtimes instead of storing\nsnapshot state on `Shell`\n- preserve inherited and in-flight generations by pinning their `Arc`\nwhile they are in use\n\n## Test plan\n\n- `cargo check -p codex-core --lib`\n- `just test -p codex-core 'shell_snapshot::tests'`\n- `just test -p codex-core\nshell_command_snapshot_still_intercepts_apply_patch`\n- `just test -p codex-core\nshell_snapshot_deleted_after_shutdown_with_skills`","verified_at":"2026-06-15T15:18:13Z"}},"url":"https://api.github.com/repos/openai/codex/commits/1aa3e432ccf9a853cbe536c159f90d79c576314d","html_url":"https://github.com/openai/codex/commit/1aa3e432ccf9a853cbe536c159f90d79c576314d","comments_url":"https://api.github.com/repos/openai/codex/commits/1aa3e432ccf9a853cbe536c159f90d79c576314d/comments","author":{"login":"pakrym-oai","id":204937752,"node_id":"U_kgDODDcaGA","avatar_url":"https://avatars.githubusercontent.com/u/204937752?v=4","gravatar_id":"","url":"https://api.github.com/users/pakrym-oai","html_url":"https://github.com/pakrym-oai","followers_url":"https://api.github.com/users/pakrym-oai/followers","following_url":"https://api.github.com/users/pakrym-oai/following{/other_user}","gists_url":"https://api.github.com/users/pakrym-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/pakrym-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pakrym-oai/subscriptions","organizations_url":"https://api.github.com/users/pakrym-oai/orgs","repos_url":"https://api.github.com/users/pakrym-oai/repos","events_url":"https://api.github.com/users/pakrym-oai/events{/privacy}","received_events_url":"https://api.github.com/users/pakrym-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"6d9df687a5477d781474ba1a01aa109114e19f6e","url":"https://api.github.com/repos/openai/codex/commits/6d9df687a5477d781474ba1a01aa109114e19f6e","html_url":"https://github.com/openai/codex/commit/6d9df687a5477d781474ba1a01aa109114e19f6e"}]},{"sha":"6d9df687a5477d781474ba1a01aa109114e19f6e","node_id":"C_kwDOOYsS4doAKDZkOWRmNjg3YTU0NzdkNzgxNDc0YmExYTAxYWExMDkxMTRlMTlmNmU","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-15T15:15:45Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T15:15:45Z"},"message":"skills: hide orchestrator skills with a local executor (#28333)\n\n## Why\n\nApp-server threads without a local executor need orchestrator-owned\nskills from the hosted `codex_apps` MCP server. Threads with the local\nexecutor already discover installed skills from the local filesystem.\n\nAfter the orchestrator skill provider was enabled for every app-server\nthread, local-executor threads also received the hosted skill catalog\nand the `skills.list` and `skills.read` tools. This changed the existing\nlocal behavior and could expose a second hosted copy of a skill that was\nalready installed locally.\n\n## What changed\n\n- Expose the thread's selected execution environments to extensions at\nthread startup.\n- Enable orchestrator skills only when the reserved local environment is\nnot selected.\n- Apply that decision consistently to hosted skill catalog discovery,\nexplicit skill injection, and the `skills.list` and `skills.read` tools.\n\n## Verification\n\n- The existing no-executor app-server test continues to verify hosted\nskill discovery, invocation, and child-resource reads.\n- A new app-server test verifies that local-executor threads do not\nreceive hosted skill context or `skills.*` tools.","tree":{"sha":"a47ea254d350d76a6450d5c1f55888fa0aff03d0","url":"https://api.github.com/repos/openai/codex/git/trees/a47ea254d350d76a6450d5c1f55888fa0aff03d0"},"url":"https://api.github.com/repos/openai/codex/git/commits/6d9df687a5477d781474ba1a01aa109114e19f6e","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMBchCRC1aQ7uu5UhlAAAuYIQAFU3r4Zm+fikjwq3f3Z94gIT\nP19doaRj+s85FQgDfZvcD24w+JBIs6PAVSfnA65MaPhN6czMCt2SRBgB+iFX4YYg\nvddOxO+5ZJalwOXiqmUzNTvuK8J39ssjC2ZLFKkROogrtN61oJ6NJLr3RS4OgQkD\nUUML7K4W/LWIijaxeH8Kem2gZ1+fco/YRam6BiQ40a9mWWCEdwAoIWYp/in94l+A\naZNfyjcJg9CpoEpUlv8wqM+syeIfDm96MreREy0ICxefjx7+62ISxTlGMcdpUtrs\n1MKYparHcJals+TQCXUf4Voy2dE+cQeku56xYonfBktREXTrJ1MFtktYPP83rdl3\nxjMpB89RCOeeAjFBpJpVyP3sThDkUVtIAxnpU6MpnSCrT7Bv2Try+pCfPTTqith2\nfU2mEVz9Mrbowz+JLUsJdn0/zEufOFjGioaOJBPx+q/wvaqFuB6Ki8IODiBENjHC\nr0b2Ey2uJS693QcKE+rLBmJpXVtsLfDI2ZBZ6B89Hu1kyWwMY/X2N5PNFL8JPkd3\noIXn9Xuk31k2FcYKiCBmXghGvdULPYhHAhNiQtiXPvkXPNNpuFiB5sy8f6aDpc/H\nJBvWRJkGbqjHZuPCW99meiMqEA2Q7YUWJN9jUTkpceW0SfM94IItglhRx4e3h+HO\n4hqWCHQNnU9AZO2cg4h4\n=OxxE\n-----END PGP SIGNATURE-----\n","payload":"tree a47ea254d350d76a6450d5c1f55888fa0aff03d0\nparent a292faae5a4b1bc532d371e9cb0e1b343f3e4ba0\nauthor jif <jif@openai.com> 1781536545 +0100\ncommitter GitHub <noreply@github.com> 1781536545 +0200\n\nskills: hide orchestrator skills with a local executor (#28333)\n\n## Why\n\nApp-server threads without a local executor need orchestrator-owned\nskills from the hosted `codex_apps` MCP server. Threads with the local\nexecutor already discover installed skills from the local filesystem.\n\nAfter the orchestrator skill provider was enabled for every app-server\nthread, local-executor threads also received the hosted skill catalog\nand the `skills.list` and `skills.read` tools. This changed the existing\nlocal behavior and could expose a second hosted copy of a skill that was\nalready installed locally.\n\n## What changed\n\n- Expose the thread's selected execution environments to extensions at\nthread startup.\n- Enable orchestrator skills only when the reserved local environment is\nnot selected.\n- Apply that decision consistently to hosted skill catalog discovery,\nexplicit skill injection, and the `skills.list` and `skills.read` tools.\n\n## Verification\n\n- The existing no-executor app-server test continues to verify hosted\nskill discovery, invocation, and child-resource reads.\n- A new app-server test verifies that local-executor threads do not\nreceive hosted skill context or `skills.*` tools.","verified_at":"2026-06-15T15:15:46Z"}},"url":"https://api.github.com/repos/openai/codex/commits/6d9df687a5477d781474ba1a01aa109114e19f6e","html_url":"https://github.com/openai/codex/commit/6d9df687a5477d781474ba1a01aa109114e19f6e","comments_url":"https://api.github.com/repos/openai/codex/commits/6d9df687a5477d781474ba1a01aa109114e19f6e/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a292faae5a4b1bc532d371e9cb0e1b343f3e4ba0","url":"https://api.github.com/repos/openai/codex/commits/a292faae5a4b1bc532d371e9cb0e1b343f3e4ba0","html_url":"https://github.com/openai/codex/commit/a292faae5a4b1bc532d371e9cb0e1b343f3e4ba0"}]},{"sha":"a292faae5a4b1bc532d371e9cb0e1b343f3e4ba0","node_id":"C_kwDOOYsS4doAKGEyOTJmYWFlNWE0YjFiYzUzMmQzNzFlOWNiMGUxYjM0M2YzZTRiYTA","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-06-15T15:06:14Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T15:06:14Z"},"message":"Represent dynamic tools with explicit namespaces internally (#27365)\n\nFollow-up to #27356.\n\n## Stack note\n\nThis PR changes Codex's internal dynamic-tool shape while leaving\n`thread/start` unchanged. App-server therefore converts the existing\nper-tool input into explicit functions and namespaces before passing it\nto core.\n\n[#27371](https://github.com/openai/codex/pull/27371) updates\n`thread/start` to use the same explicit shape and removes this temporary\nconversion.\n\n## Why\n\nDynamic tools repeat namespace metadata on every function. Core should\nkeep one explicit namespace with its member tools so descriptions and\nmembership stay consistent across sessions and runtime planning.\n\n## What changed\n\n- Represent dynamic tools as top-level functions or explicit namespaces\nin protocol and session state.\n- Read old flat rollout metadata and write the canonical hierarchy.\n- Flatten namespace members only when registering callable tools.\n- Keep `thread/start.dynamicTools` flat for now and normalize it at the\napp-server boundary.\n\nNew builds can read old rollout metadata. Older builds cannot read newly\nwritten hierarchical metadata.\n\n## Test plan\n\n- `just test -p codex-app-server\nthread_start_normalizes_legacy_dynamic_tools_into_model_request`\n- `just test -p codex-protocol\nsession_meta_normalizes_legacy_dynamic_tools`\n- `just test -p codex-core\nresume_restores_dynamic_tools_from_rollout_with_sqlite_enabled`\n- `just test -p codex-core\ntool_search_returns_deferred_dynamic_tool_and_routes_follow_up_call`\n- `just test -p codex-core code_mode_can_call_hidden_dynamic_tools`\n- `just test -p codex-tools`","tree":{"sha":"c171a8400445b775686a1db2ac958ff0a289fd4c","url":"https://api.github.com/repos/openai/codex/git/trees/c171a8400445b775686a1db2ac958ff0a289fd4c"},"url":"https://api.github.com/repos/openai/codex/git/commits/a292faae5a4b1bc532d371e9cb0e1b343f3e4ba0","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMBTmCRC1aQ7uu5UhlAAA8msQABqRLCHwQoP5Qk99UiCJXD31\nKMLS588w5DTqBl8IIevs49cgbs3QAdFU4UBqXCoQZ0JGbHKWM6O4jkmIznya/Z6V\nqQ0rzpb/ZKZeRGPb3O+lVqS4seR/qtcJcjaOJXQo5nfPzecLMoNy9Iybk7e31ecT\n8VuGvH4gZPJwkvElPivWl0mErAuUIHMt9DidmnDJbUGTS1MVt/Nn1bH07B3yZz/k\nFtkGDrZoLK4KLxNYZbsCwZImQ6+ainRjsOXRJZvrf8+aQ0ce5F/9TLd+suh4QOWA\n8+/ehDe9OoWbxisGef1Cxmk7HnxvwClf672VL8Aomd8vOB04YnqPHBqEOlWf6vFT\nI1S0AxuLNeXJ+j/ranPLs8rUzvcvXUQ1/DRzQAdTy3DfU+WcDgnzNUgRAYnPqX7k\n9Zz9NcH1eJrC6UjeoF1tnb1E/XXk0kWuRSIpUy3eLGWNup/CjfqeOZIiLN91ttHo\nugJU2WE6QPJLwHFdInAu2aPmQ1R9GMGfujY33XFu0g7cutrJg927GKQpxJM7HkaH\nkoc479I7RWSbiTC7E/DxrgFXF1tHFlv8dAjIjDHkFWQLAKfPi01Jwp8DuIykD4qY\nGUhPrfYUStPlXK9MQc6DLXMFvpHK0fuctQCj6outZINxPnunvlCPXtDGdmsKT2rp\nyOKcfXjw0LHxx6fTclqz\n=yuax\n-----END PGP SIGNATURE-----\n","payload":"tree c171a8400445b775686a1db2ac958ff0a289fd4c\nparent b3f6f70b6873faa09a1eae1004f7dc5721f4281d\nauthor sayan-oai <sayan@openai.com> 1781535974 -0700\ncommitter GitHub <noreply@github.com> 1781535974 -0700\n\nRepresent dynamic tools with explicit namespaces internally (#27365)\n\nFollow-up to #27356.\n\n## Stack note\n\nThis PR changes Codex's internal dynamic-tool shape while leaving\n`thread/start` unchanged. App-server therefore converts the existing\nper-tool input into explicit functions and namespaces before passing it\nto core.\n\n[#27371](https://github.com/openai/codex/pull/27371) updates\n`thread/start` to use the same explicit shape and removes this temporary\nconversion.\n\n## Why\n\nDynamic tools repeat namespace metadata on every function. Core should\nkeep one explicit namespace with its member tools so descriptions and\nmembership stay consistent across sessions and runtime planning.\n\n## What changed\n\n- Represent dynamic tools as top-level functions or explicit namespaces\nin protocol and session state.\n- Read old flat rollout metadata and write the canonical hierarchy.\n- Flatten namespace members only when registering callable tools.\n- Keep `thread/start.dynamicTools` flat for now and normalize it at the\napp-server boundary.\n\nNew builds can read old rollout metadata. Older builds cannot read newly\nwritten hierarchical metadata.\n\n## Test plan\n\n- `just test -p codex-app-server\nthread_start_normalizes_legacy_dynamic_tools_into_model_request`\n- `just test -p codex-protocol\nsession_meta_normalizes_legacy_dynamic_tools`\n- `just test -p codex-core\nresume_restores_dynamic_tools_from_rollout_with_sqlite_enabled`\n- `just test -p codex-core\ntool_search_returns_deferred_dynamic_tool_and_routes_follow_up_call`\n- `just test -p codex-core code_mode_can_call_hidden_dynamic_tools`\n- `just test -p codex-tools`","verified_at":"2026-06-15T15:06:15Z"}},"url":"https://api.github.com/repos/openai/codex/commits/a292faae5a4b1bc532d371e9cb0e1b343f3e4ba0","html_url":"https://github.com/openai/codex/commit/a292faae5a4b1bc532d371e9cb0e1b343f3e4ba0","comments_url":"https://api.github.com/repos/openai/codex/commits/a292faae5a4b1bc532d371e9cb0e1b343f3e4ba0/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b3f6f70b6873faa09a1eae1004f7dc5721f4281d","url":"https://api.github.com/repos/openai/codex/commits/b3f6f70b6873faa09a1eae1004f7dc5721f4281d","html_url":"https://github.com/openai/codex/commit/b3f6f70b6873faa09a1eae1004f7dc5721f4281d"}]},{"sha":"b3f6f70b6873faa09a1eae1004f7dc5721f4281d","node_id":"C_kwDOOYsS4doAKGIzZjZmNzBiNjg3M2ZhYTA5YTFlYWUxMDA0ZjdkYzU3MjFmNDI4MWQ","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-15T14:58:01Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T14:58:01Z"},"message":"[codex] Cap feedback upload subtrees (#28332)\n\n## Summary\n- cap feedback log uploads to at most eight threads before SQLite log\naggregation and rollout attachment resolution\n- keep the root session included while bounding descendant fanout during\n`/feedback` uploads\n\n## Why\nVery large sessions can accumulate large spawned-thread subtrees.\nFeedback uploads currently walk the entire subtree and then read each\nresolved rollout into memory, which can blow up when one session has\nhundreds of descendants.\n\n## Validation\n- ran `just fmt`\n- did not run tests or Clippy per request; CI will cover validation","tree":{"sha":"c37aea19f8c549db4b58b772d944d689e0679fa1","url":"https://api.github.com/repos/openai/codex/git/trees/c37aea19f8c549db4b58b772d944d689e0679fa1"},"url":"https://api.github.com/repos/openai/codex/git/commits/b3f6f70b6873faa09a1eae1004f7dc5721f4281d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMBL5CRC1aQ7uu5UhlAAABAYQABq16+ztte0Z7pAvTiLI2fTS\nHbyqvWaHGr5YcXowNbDw4w65BmOtrjQkrty1zVuAYC/cA+UurqOFXjP3y4afm1l5\niYI/k8Ip9dSseUB581sXMh7yBqnuJGluBm3QGS2tZbu0aZHUaFERRfSJpD/xZ5R+\nepTrS+0p86vLoTHB/RfearKeKES5vUWNntSwPOGo36WIiv5SdIbK3iAQIubE7bN6\nUL2CchAxoBSLvUz5AoNB4RkbWquPghHrL6rt6ncLknr8AuiUcm/NmO1RhpSc3QhN\nwnh5xZ8Bm+Oj69ZVk54wGAiUFWNUxPwUYDWbLQC2fxyNfU4hGBTIurXrjQIx66dP\nmteHMkUBebkWOwW4yqT0MR0V2jpQCvBlmPxwVLt5Bi+sZ51HAx/ZWXC0qxRfB4vU\naSEh+Bxv1Xn1JmNkW5Y9DJ3pSdy1ZOXZSy3Hxqgr3JAc0NY+/z8wgP8Oq9jo1qhY\n+BMxMrbyq66rT0Q3ILr6uWIEF0z9onT2pBcPWKU6dFpNIR3e+JH6jMUbShUu6dhY\noUX7Q4i12wUAdT7pdWtbwfmQzBldE2is7J9tCaF4uAek3HCXgXIzJ8qtkDOODjux\nYyOoum0aRmEJZfx3TiF/QyCfA1TOxveKFvgsn8wV4sEWKO59vY7uOt9z5IT3WFLZ\nKOkQl9PbV6ZK0a9MT846\n=yMRi\n-----END PGP SIGNATURE-----\n","payload":"tree c37aea19f8c549db4b58b772d944d689e0679fa1\nparent c8c78b63a7cbc7101884613d0301db5cc58d730d\nauthor jif <jif@openai.com> 1781535481 +0100\ncommitter GitHub <noreply@github.com> 1781535481 +0200\n\n[codex] Cap feedback upload subtrees (#28332)\n\n## Summary\n- cap feedback log uploads to at most eight threads before SQLite log\naggregation and rollout attachment resolution\n- keep the root session included while bounding descendant fanout during\n`/feedback` uploads\n\n## Why\nVery large sessions can accumulate large spawned-thread subtrees.\nFeedback uploads currently walk the entire subtree and then read each\nresolved rollout into memory, which can blow up when one session has\nhundreds of descendants.\n\n## Validation\n- ran `just fmt`\n- did not run tests or Clippy per request; CI will cover validation","verified_at":"2026-06-15T14:58:01Z"}},"url":"https://api.github.com/repos/openai/codex/commits/b3f6f70b6873faa09a1eae1004f7dc5721f4281d","html_url":"https://github.com/openai/codex/commit/b3f6f70b6873faa09a1eae1004f7dc5721f4281d","comments_url":"https://api.github.com/repos/openai/codex/commits/b3f6f70b6873faa09a1eae1004f7dc5721f4281d/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c8c78b63a7cbc7101884613d0301db5cc58d730d","url":"https://api.github.com/repos/openai/codex/commits/c8c78b63a7cbc7101884613d0301db5cc58d730d","html_url":"https://github.com/openai/codex/commit/c8c78b63a7cbc7101884613d0301db5cc58d730d"}]},{"sha":"c8c78b63a7cbc7101884613d0301db5cc58d730d","node_id":"C_kwDOOYsS4doAKGM4Yzc4YjYzYTdjYmM3MTAxODg0NjEzZDAzMDFkYjVjYzU4ZDczMGQ","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-15T14:23:37Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T14:23:37Z"},"message":"Activate selected executor plugin MCPs in app-server (#27893)\n\n## Why\n\n#27870 teaches the MCP extension how to discover stdio MCP servers\ndeclared by a selected executor plugin, but app-server does not yet\ninstall that contributor or initialize its per-thread state. As a\nresult, `thread/start.selectedCapabilityRoots` can select the plugin\nwhile its MCP servers remain inactive.\n\nThis PR closes that app-server wiring gap:\n\n```text\nthread/start(selectedCapabilityRoots)\n    -> initialize the thread's selected-plugin MCP snapshot\n    -> read the selected plugin's .mcp.json through its environment\n    -> start declared stdio servers in that environment\n    -> expose their tools only on the selected thread\n```\n\n## What changed\n\n- Install the selected-executor-plugin MCP contributor in app-server\nusing the existing shared `EnvironmentManager`.\n- Initialize its frozen thread snapshot when `thread/start` includes\nselected capability roots.\n- Document that selected plugin stdio MCPs are activated in their owning\nenvironment.\n- Add an app-server E2E covering the complete selection-to-tool-call\npath.\n\nThe E2E verifies that:\n\n- the selected MCP process receives an executor-only environment value,\nproving the tool runs through the selected environment;\n- the MCP tool is advertised to the model and can be called;\n- a normal MCP config reload does not discard the thread's frozen\nselected-plugin registration;\n- another thread without the selected root does not see the MCP server.\n\n## Scope\n\n- Existing sessions without `selectedCapabilityRoots` are unchanged.\n- Only stdio MCP declarations are activated. HTTP declarations remain\ninactive.\n- This does not change selected-root persistence across resume/fork or\nadd hosted-plugin behavior.\n\n## Verification\n\n- Focused app-server E2E:\n`selected_executor_plugin_exposes_its_stdio_mcp_only_to_that_thread`\n\n## Stack\n\nStacked on #27870.","tree":{"sha":"0ea3d02f6c6c430d6f06ef44e59e39b7d1de3967","url":"https://api.github.com/repos/openai/codex/git/trees/0ea3d02f6c6c430d6f06ef44e59e39b7d1de3967"},"url":"https://api.github.com/repos/openai/codex/git/commits/c8c78b63a7cbc7101884613d0301db5cc58d730d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqMArpCRC1aQ7uu5UhlAAAr3YQAIfDdc4kbUpK6wT/QKXO04Ag\n8PMCnP5BAYb3MBGhpsQC8+HX/jkbWJKl18ENY/NRPQsqwgtYwN8aqh6w6dQNXk0j\nEI/Q0LS0XsfsF3bMnTFl8nTOa3XzOsUJkreMPTS6aX7q7gaP5OBMfkNVug+hO3ad\nkW7RtJSs4aKAT0rZosf6pMCjrPcNij6QTKNxYbfDdVk/m5wjDe2uBqhJYT4x8K8d\nGXQeXkuOGjEsdgq4aN8hYRCRg3Vkd0RzfVfjtzg0Pt+/brQUqcxT5DlRi64TiIFJ\nMSHG0bgCqHCSGD5ZMSLJvykGm5Jyn+8jjmHEJ2UUA5FFQ4Atm1tw4nNLLcLUlr/R\nuBbNO+IoYx9gERacvjCr8wlC3Z9DvQz7KUMZ3jC0vV/kHSHq6++DevLEiu3lcO/5\nHUrOuAa5bW67i32TV+eeDtXUU53YMcehD/ZNlrbtO7SlKy8MnsKkp3NPaotZilwa\nW+UvdZvu6Wp5Sjs+rwWJ+F8LN+AsJlgji5sWe+mTAp351Lsn183qzVCVo5K21fBM\ny3o+cyociBA4cDpQmuo5Tlnd8FizSzysm4ntYxooNwH5X29nFUT50vugo0SJIGuy\nSF6vHLy6sTS9HRViCLNXfRtHDkf2X2ZBuIgN3xWx2tIQpP3XeB7fpvs9r3UFVWb7\nJD7INLl2D6x6aOAGqFSV\n=0W/u\n-----END PGP SIGNATURE-----\n","payload":"tree 0ea3d02f6c6c430d6f06ef44e59e39b7d1de3967\nparent e5253b97fb6c39b984d84acb409d0e9552de407f\nauthor jif <jif@openai.com> 1781533417 +0100\ncommitter GitHub <noreply@github.com> 1781533417 +0200\n\nActivate selected executor plugin MCPs in app-server (#27893)\n\n## Why\n\n#27870 teaches the MCP extension how to discover stdio MCP servers\ndeclared by a selected executor plugin, but app-server does not yet\ninstall that contributor or initialize its per-thread state. As a\nresult, `thread/start.selectedCapabilityRoots` can select the plugin\nwhile its MCP servers remain inactive.\n\nThis PR closes that app-server wiring gap:\n\n```text\nthread/start(selectedCapabilityRoots)\n    -> initialize the thread's selected-plugin MCP snapshot\n    -> read the selected plugin's .mcp.json through its environment\n    -> start declared stdio servers in that environment\n    -> expose their tools only on the selected thread\n```\n\n## What changed\n\n- Install the selected-executor-plugin MCP contributor in app-server\nusing the existing shared `EnvironmentManager`.\n- Initialize its frozen thread snapshot when `thread/start` includes\nselected capability roots.\n- Document that selected plugin stdio MCPs are activated in their owning\nenvironment.\n- Add an app-server E2E covering the complete selection-to-tool-call\npath.\n\nThe E2E verifies that:\n\n- the selected MCP process receives an executor-only environment value,\nproving the tool runs through the selected environment;\n- the MCP tool is advertised to the model and can be called;\n- a normal MCP config reload does not discard the thread's frozen\nselected-plugin registration;\n- another thread without the selected root does not see the MCP server.\n\n## Scope\n\n- Existing sessions without `selectedCapabilityRoots` are unchanged.\n- Only stdio MCP declarations are activated. HTTP declarations remain\ninactive.\n- This does not change selected-root persistence across resume/fork or\nadd hosted-plugin behavior.\n\n## Verification\n\n- Focused app-server E2E:\n`selected_executor_plugin_exposes_its_stdio_mcp_only_to_that_thread`\n\n## Stack\n\nStacked on #27870.","verified_at":"2026-06-15T14:23:37Z"}},"url":"https://api.github.com/repos/openai/codex/commits/c8c78b63a7cbc7101884613d0301db5cc58d730d","html_url":"https://github.com/openai/codex/commit/c8c78b63a7cbc7101884613d0301db5cc58d730d","comments_url":"https://api.github.com/repos/openai/codex/commits/c8c78b63a7cbc7101884613d0301db5cc58d730d/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e5253b97fb6c39b984d84acb409d0e9552de407f","url":"https://api.github.com/repos/openai/codex/commits/e5253b97fb6c39b984d84acb409d0e9552de407f","html_url":"https://github.com/openai/codex/commit/e5253b97fb6c39b984d84acb409d0e9552de407f"}]},{"sha":"e5253b97fb6c39b984d84acb409d0e9552de407f","node_id":"C_kwDOOYsS4doAKGU1MjUzYjk3ZmI2YzM5Yjk4NGQ4NGFjYjQwOWQwZTk1NTJkZTQwN2Y","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-06-15T13:04:01Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T13:04:01Z"},"message":"[codex] Skip plugin MCP OAuth for matching app routes (#27461)\n\n## Context\n\nThis is PR5 in the plugin auth-routing stack. Earlier PRs make plugin\nsurface projection auth-aware, narrow App/MCP conflicts by App\ndeclaration name, and keep connector listings auth-aware. This PR\napplies the same name-based App/MCP conflict rule into plugin MCP\nloading, so install-time MCP OAuth and plugin detail metadata both\nreflect the MCPs available for the current auth route.\n\n## Stack\n\n- PR1: #27652 seed plugin manager auth at construction.\n- PR2: #27459 route plugin surfaces by auth mode.\n- PR3: #27607 dedupe plugin MCP servers by App declaration name.\n- PR4: #27602 preserve plugin Apps in connector listings.\n- PR5: #27461 skip install-time plugin MCP OAuth for matching App\nroutes.\n\n## Summary\n\n- Make `load_plugin_mcp_servers` auth-aware and let it load App\ndeclarations before filtering same-name MCP servers for Codex-backend\nauth.\n- Use that filtered MCP list for both install-time MCP OAuth and\nmarketplace plugin detail metadata.\n- Preserve API-key/direct auth behavior so plugin MCP servers remain\nvisible and can still start OAuth.\n\n## Validation\n\n```bash\ncargo fmt --all\ncargo test -p codex-core-plugins read_plugin_for_config_filters_mcp_servers_for_codex_backend_auth\ncargo check -p codex-core-plugins -p codex-app-server\ngit diff --check\ngit diff --cached --check\n```","tree":{"sha":"01483ace0b670ca9ecb2ebf8b56039e692a24f91","url":"https://api.github.com/repos/openai/codex/git/trees/01483ace0b670ca9ecb2ebf8b56039e692a24f91"},"url":"https://api.github.com/repos/openai/codex/git/commits/e5253b97fb6c39b984d84acb409d0e9552de407f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqL/hBCRC1aQ7uu5UhlAAA8LQQAAEgvnc3w9nYhMavOX3iLGcP\nwEWhlwuQJuL++NqeFi+WPFjq5cQjCxKLXwzl4IJKzsL4qxgxDYorQiw3MjjyMixU\nHKUCu+YSztpDoZuXXt/+uh09HhWsnvgtVXeekovVcUhVVRJtpfSDH0n2Q+aq4k1w\nzDCLLzIFDGboOZwjwGq0MSMcoOHQOzzGa/SWdfaeLoEAD2bo+nF1L4CO3S7082oq\nwhv2Dbm2779MvxFczweF8QmtbqSHB2ycEembu2jsDmA6qLZ/k/7vAFRglIaEM/14\nks4mmxkbGVmqy4KOoTv23iz6lLHQI1aq65m2gduHUo1tqxBWE3RNRtGZ4LaBAl34\ndagNI+FU+uCnVYkrjJthQnbVlQ9tjwSLRbTeWuf3VuQI2PKJytuhJPJAd1HYgEd8\n9PjZVcxemwVfdJxmk5Ck1r9FdRo1MlN3u0ndtJTIabE2ZX+E8HuxGHBwTmq8bn3x\nnDiHM216PXxmRmTCei7Gc+OxhlH3RTwsUBoLcZ9ZpISzYh1YPQ927HmpqvAUQVpO\ng6RwjJTAk1yK2NEhTubORxVFRaRSs6ZnJ+VpYm8Jcz0XsYGt4wl0tNMcGKOBzq8K\nZcmu3TXiEC45ZxZf8wFXRLgrtVD6O9Dimjfw7SYk7u0SkpNN5ExuTc2fdt3h0ZUg\nr9cebGZC9oXAZ1EaMrX9\n=+o46\n-----END PGP SIGNATURE-----\n","payload":"tree 01483ace0b670ca9ecb2ebf8b56039e692a24f91\nparent cededa26c5503fea47d9a8e7f4c4d95e565ac671\nauthor felixxia-oai <felixxia@openai.com> 1781528641 +0100\ncommitter GitHub <noreply@github.com> 1781528641 +0100\n\n[codex] Skip plugin MCP OAuth for matching app routes (#27461)\n\n## Context\n\nThis is PR5 in the plugin auth-routing stack. Earlier PRs make plugin\nsurface projection auth-aware, narrow App/MCP conflicts by App\ndeclaration name, and keep connector listings auth-aware. This PR\napplies the same name-based App/MCP conflict rule into plugin MCP\nloading, so install-time MCP OAuth and plugin detail metadata both\nreflect the MCPs available for the current auth route.\n\n## Stack\n\n- PR1: #27652 seed plugin manager auth at construction.\n- PR2: #27459 route plugin surfaces by auth mode.\n- PR3: #27607 dedupe plugin MCP servers by App declaration name.\n- PR4: #27602 preserve plugin Apps in connector listings.\n- PR5: #27461 skip install-time plugin MCP OAuth for matching App\nroutes.\n\n## Summary\n\n- Make `load_plugin_mcp_servers` auth-aware and let it load App\ndeclarations before filtering same-name MCP servers for Codex-backend\nauth.\n- Use that filtered MCP list for both install-time MCP OAuth and\nmarketplace plugin detail metadata.\n- Preserve API-key/direct auth behavior so plugin MCP servers remain\nvisible and can still start OAuth.\n\n## Validation\n\n```bash\ncargo fmt --all\ncargo test -p codex-core-plugins read_plugin_for_config_filters_mcp_servers_for_codex_backend_auth\ncargo check -p codex-core-plugins -p codex-app-server\ngit diff --check\ngit diff --cached --check\n```","verified_at":"2026-06-15T13:04:02Z"}},"url":"https://api.github.com/repos/openai/codex/commits/e5253b97fb6c39b984d84acb409d0e9552de407f","html_url":"https://github.com/openai/codex/commit/e5253b97fb6c39b984d84acb409d0e9552de407f","comments_url":"https://api.github.com/repos/openai/codex/commits/e5253b97fb6c39b984d84acb409d0e9552de407f/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"cededa26c5503fea47d9a8e7f4c4d95e565ac671","url":"https://api.github.com/repos/openai/codex/commits/cededa26c5503fea47d9a8e7f4c4d95e565ac671","html_url":"https://github.com/openai/codex/commit/cededa26c5503fea47d9a8e7f4c4d95e565ac671"}]},{"sha":"cededa26c5503fea47d9a8e7f4c4d95e565ac671","node_id":"C_kwDOOYsS4doAKGNlZGVkYTI2YzU1MDNmZWE0N2Q5YThlN2Y0YzRkOTVlNTY1YWM2NzE","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-06-15T12:50:08Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T12:50:08Z"},"message":"[codex] Preserve plugin apps in connector listings (#27602)\n\n## Context\n\nThis is PR4 in the plugin auth-routing stack. The earlier PRs make\nplugin surface projection auth-aware and narrow App/MCP conflicts by App\ndeclaration name. This PR keeps connector listing paths aligned with\nthat projected plugin App set.\n\nThis means ChatGPT/SIWC users will still see plugin-provided Apps in\nconnector listing surfaces like the Apps/connector picker, while API-key\nusers will not see Apps they cannot use.\n\n## Stack\n\n- PR1: #27652 seed plugin manager auth at construction.\n- PR2: #27459 route plugin surfaces by auth mode.\n- PR3: #27607 dedupe plugin MCP servers by App declaration name.\n- PR4: #27602 preserve plugin Apps in connector listings.\n- PR5: #27461 skip install-time plugin MCP OAuth for matching App\nroutes.\n\n## Summary\n\n- Have app-server compute effective plugin Apps from the existing\nPluginsManager and pass them into connector listing.\n- Keep plugin Apps visible in Apps/connector listing for ChatGPT/SIWC\nusers.\n- Keep API-key-style auth from surfacing plugin Apps in connector\nlistings.\n\n## Validation\n\n```bash\ncargo test -p codex-chatgpt connectors::tests\ncargo test -p codex-app-server list_apps_includes_plugin_apps_for_chatgpt_auth\ngit diff --check\n```","tree":{"sha":"34f845170fef762c876b2a37ac6fa950a757d3c3","url":"https://api.github.com/repos/openai/codex/git/trees/34f845170fef762c876b2a37ac6fa950a757d3c3"},"url":"https://api.github.com/repos/openai/codex/git/commits/cededa26c5503fea47d9a8e7f4c4d95e565ac671","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqL/UACRC1aQ7uu5UhlAAApY4QAInWzfYHHl3HoGF+eIj3KSBU\npGWrc5kMk3w53zJw5Nkxl3l4G6nNNt2EOhV3zucKYBRYocOODRry6DKW5AjHgr3l\nw6w2jdgYnN1jxIHFTB87kUBrRmcMrqUtGpPHwq3IVI3YJCbRThAlaE0FaTZeRSBp\nzkDyg2Ou6pYELVHGyCGQxFALabu1HzUfzQ/MDDmcF3sycfnikptCrEbm/ydYnmRQ\n8rEHikcY7Ew7SVRoo4gPM7IFtx192+owGNjsusFhSgE/PmJ91ynbC6NDrC9QnAuu\ndn5Q8s+Y9kyGhn+quo15JC8FlRGVl0zaHzPwY10XUUFkrpI915TTnn0bI+eEWQTH\neaOA1JX0+mIImnpzbTfx5/Qolyd4kpoutbw+Sa5QJQYfBYTBcHf5hA8bksHMOQyL\n0sRHRxz2vmZUxiE/r5EGIj3DjaQ5KWAyaA67bsqM9EvbCvZ9zPGkVzoMaPrTbuXL\nbcQs7+NzGpiUOxC7MnEi3+IHuyJm4Zu1HWNpcBjv0IIaaxQw7Y9wvFRIkfGxUU9L\nvzD18g3cy9KMWb8Pbc8BWpyYxsouAzJqo7HfD0GFpUWsmLM+kMiMsdNuEbNo3Kkn\nLwIJvDUeau/xRD+cZZgUE7kzkg5pvp6y/sc9uA1GTW/saSIAEfjNPteGftoTUQoQ\nQumGiSUZ9dLErXbSJ8IV\n=6tMK\n-----END PGP SIGNATURE-----\n","payload":"tree 34f845170fef762c876b2a37ac6fa950a757d3c3\nparent 127224cacce1bc08922f21a5ff3e3ddd33246474\nauthor felixxia-oai <felixxia@openai.com> 1781527808 +0100\ncommitter GitHub <noreply@github.com> 1781527808 +0100\n\n[codex] Preserve plugin apps in connector listings (#27602)\n\n## Context\n\nThis is PR4 in the plugin auth-routing stack. The earlier PRs make\nplugin surface projection auth-aware and narrow App/MCP conflicts by App\ndeclaration name. This PR keeps connector listing paths aligned with\nthat projected plugin App set.\n\nThis means ChatGPT/SIWC users will still see plugin-provided Apps in\nconnector listing surfaces like the Apps/connector picker, while API-key\nusers will not see Apps they cannot use.\n\n## Stack\n\n- PR1: #27652 seed plugin manager auth at construction.\n- PR2: #27459 route plugin surfaces by auth mode.\n- PR3: #27607 dedupe plugin MCP servers by App declaration name.\n- PR4: #27602 preserve plugin Apps in connector listings.\n- PR5: #27461 skip install-time plugin MCP OAuth for matching App\nroutes.\n\n## Summary\n\n- Have app-server compute effective plugin Apps from the existing\nPluginsManager and pass them into connector listing.\n- Keep plugin Apps visible in Apps/connector listing for ChatGPT/SIWC\nusers.\n- Keep API-key-style auth from surfacing plugin Apps in connector\nlistings.\n\n## Validation\n\n```bash\ncargo test -p codex-chatgpt connectors::tests\ncargo test -p codex-app-server list_apps_includes_plugin_apps_for_chatgpt_auth\ngit diff --check\n```","verified_at":"2026-06-15T12:50:08Z"}},"url":"https://api.github.com/repos/openai/codex/commits/cededa26c5503fea47d9a8e7f4c4d95e565ac671","html_url":"https://github.com/openai/codex/commit/cededa26c5503fea47d9a8e7f4c4d95e565ac671","comments_url":"https://api.github.com/repos/openai/codex/commits/cededa26c5503fea47d9a8e7f4c4d95e565ac671/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"127224cacce1bc08922f21a5ff3e3ddd33246474","url":"https://api.github.com/repos/openai/codex/commits/127224cacce1bc08922f21a5ff3e3ddd33246474","html_url":"https://github.com/openai/codex/commit/127224cacce1bc08922f21a5ff3e3ddd33246474"}]},{"sha":"127224cacce1bc08922f21a5ff3e3ddd33246474","node_id":"C_kwDOOYsS4doAKDEyNzIyNGNhY2NlMWJjMDg5MjJmMjFhNWZmM2UzZGRkMzMyNDY0NzQ","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-15T10:21:02Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T10:21:02Z"},"message":"[codex] update multi-agent v2 prompts (#28283)\n\n## Summary\n\n- align the default multi-agent v2 root and subagent hints with the\nevaluated prompt guidance for direct collaboration-tool calls, parallel\ndelegation, and shared workspaces\n- keep the current `interrupt_agent` tool name and existing\nconcurrency-hint placement, with the explicit no-spawn instruction last\n- document the context tradeoff between `fork_turns=\"none\"` and\n`fork_turns=\"all\"` in the v2 `spawn_agent` description\n- extend the focused prompt and tool-surface tests\n\n## Why\n\nThe evaluated multi-agent prompt includes operational guidance that is\nmissing from the current Codex defaults. This applies that guidance to\nthe current tool surface without restoring stale `close_agent` or\nduplicated concurrency wording.\n\n## User impact\n\nMulti-agent v2 receives clearer instructions about when and how to\nparallelize work, how agent workspaces interact, and how `fork_turns`\naffects subagent context. The existing default opt-out behavior remains\nin place.\n\n## Testing\n\n- `just fmt`\n- `just test -p codex-core\nmulti_agent_v2_default_usage_hints_use_configured_thread_cap`\n- `just test -p codex-core\nmulti_agent_feature_selects_one_agent_tool_family`","tree":{"sha":"7ff9de0e1543eb6bf795d969282fb9d3ecc3bfe7","url":"https://api.github.com/repos/openai/codex/git/trees/7ff9de0e1543eb6bf795d969282fb9d3ecc3bfe7"},"url":"https://api.github.com/repos/openai/codex/git/commits/127224cacce1bc08922f21a5ff3e3ddd33246474","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqL9IOCRC1aQ7uu5UhlAAANm4QAEuiU0M0ctKAJltLq8MpZ2jj\nJCVGI+f2y6gjoZO2RJT4gxBPIm9y+mF4A/BK3WSp8FZLKi2JiDAFsfRst8UWP7Ur\n9+1ju4sHOaEYaMy2xInd8LgUUmFPexD5Ca4/asyhyAh5r7McG2PlGm90pU+sdJn3\nCZs8ktNwBohcUQWDJnY8jxNMNuuI78bSeJV/cZnKFmMJ5iny0yNJIlvx+okfKxJM\n+v28AePHksy80bFihUzq25tnl6UPRubfdZpB6cJC/vpgeN7QEGoEclRFMQ00kGUJ\n21FZF1s7K/flomec6oegcjR4IiffgXfjBgHR6lGbvYEWyhTMbqHzYIkb8k7A5VnT\ncKAOUkDe7nLyrIIFxVVT6pCCEIvjS19vd+/kO08IMPspqnk9Fl8+PnYAb724iisV\nqNDpPH3JT10u6WoDPnmyG7q4OvHuSRTPO139ZYQ5XrJe9QPNPezWgCVhTFr2WUUw\nVTYQBkOW4JPv57t0oNwR0hScUUTTuHo7Eh9g0uiVchNyiNumxeAe/w08Ph9awTb6\nFU80cFxbQrjnKqRmHAT1EtVkphz/HCstiMb9RVs3S3Mw1nPruytYVPFE1/CmG2k0\nWeM6WI/HxCSQY0nIL8aBXIMO9QoXQWOzacb8ZTF71Zoy1gYhpDeMPY9mBAP8pvJt\n4Q8+WNQUNO+ldgA+/L5y\n=w4uS\n-----END PGP SIGNATURE-----\n","payload":"tree 7ff9de0e1543eb6bf795d969282fb9d3ecc3bfe7\nparent b3c423e475a9fa2bb1ad493e09408d13732d4b98\nauthor jif <jif@openai.com> 1781518862 +0100\ncommitter GitHub <noreply@github.com> 1781518862 +0200\n\n[codex] update multi-agent v2 prompts (#28283)\n\n## Summary\n\n- align the default multi-agent v2 root and subagent hints with the\nevaluated prompt guidance for direct collaboration-tool calls, parallel\ndelegation, and shared workspaces\n- keep the current `interrupt_agent` tool name and existing\nconcurrency-hint placement, with the explicit no-spawn instruction last\n- document the context tradeoff between `fork_turns=\"none\"` and\n`fork_turns=\"all\"` in the v2 `spawn_agent` description\n- extend the focused prompt and tool-surface tests\n\n## Why\n\nThe evaluated multi-agent prompt includes operational guidance that is\nmissing from the current Codex defaults. This applies that guidance to\nthe current tool surface without restoring stale `close_agent` or\nduplicated concurrency wording.\n\n## User impact\n\nMulti-agent v2 receives clearer instructions about when and how to\nparallelize work, how agent workspaces interact, and how `fork_turns`\naffects subagent context. The existing default opt-out behavior remains\nin place.\n\n## Testing\n\n- `just fmt`\n- `just test -p codex-core\nmulti_agent_v2_default_usage_hints_use_configured_thread_cap`\n- `just test -p codex-core\nmulti_agent_feature_selects_one_agent_tool_family`","verified_at":"2026-06-15T10:21:03Z"}},"url":"https://api.github.com/repos/openai/codex/commits/127224cacce1bc08922f21a5ff3e3ddd33246474","html_url":"https://github.com/openai/codex/commit/127224cacce1bc08922f21a5ff3e3ddd33246474","comments_url":"https://api.github.com/repos/openai/codex/commits/127224cacce1bc08922f21a5ff3e3ddd33246474/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b3c423e475a9fa2bb1ad493e09408d13732d4b98","url":"https://api.github.com/repos/openai/codex/commits/b3c423e475a9fa2bb1ad493e09408d13732d4b98","html_url":"https://github.com/openai/codex/commit/b3c423e475a9fa2bb1ad493e09408d13732d4b98"}]},{"sha":"b3c423e475a9fa2bb1ad493e09408d13732d4b98","node_id":"C_kwDOOYsS4doAKGIzYzQyM2U0NzVhOWZhMmJiMWFkNDkzZTA5NDA4ZDEzNzMyZDRiOTg","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-15T09:52:05Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T09:52:05Z"},"message":"Discover stdio MCP servers from selected executor plugins (#27870)\n\n## Why\n\n**In short:** this PR discovers MCP registrations by reading a selected\nplugin's `.mcp.json` on its executor. #27884 then resolves those\nregistrations in the shared catalog.\n\n`thread/start.selectedCapabilityRoots` can select a plugin root owned by\nan executor, and Codex can resolve that package through the executor\nfilesystem. MCP declarations inside the selected plugin are still\nignored.\n\nThis PR adds the source-specific discovery layer on top of the\nselected-plugin catalog boundary in #27884:\n\n```text\nselected capability root\n        |\n        v\nresolve the plugin through its executor filesystem\n        |\n        v\nread and normalize its MCP config through the same filesystem\n        |\n        v\ncontribute stdio registrations bound to that environment ID\n```\n\nThe existing MCP launcher and connection manager remain unchanged. MCP\nconfig parsing is shared with local plugins through #27863.\n\n## What changed\n\n- Added an executor plugin MCP provider in the MCP extension.\n- Retained only the exact filesystem capability used for package\nresolution and reused it for the selected plugin's MCP config, with no\nhost-filesystem fallback or unrelated process/HTTP authority.\n- Read either the manifest-declared MCP config or the default\n`.mcp.json`; a missing default file means the plugin has no MCP servers.\n- Accepted stdio servers only for this first vertical. Executor-owned\nHTTP declarations are skipped with a warning until their placement\nsemantics are defined.\n- Normalized stdio registrations with the owning environment's stable\nlogical ID and plugin-root working directory.\n- Resolved environment-variable names on the owning executor and\nrejected explicit local forwarding for non-local plugins.\n- Froze discovered declarations once per active thread runtime, then\napplied current managed plugin and MCP requirements when contributing\nthem.\n- Carried the selected root ID, display name, and selection order into\nthe catalog contribution defined by #27884.\n\n## Behavior and scope\n\nThere is intentionally no production behavior change yet. This PR\nprovides the executor provider and contribution boundary, but app-server\ndoes not install it in this change. Existing local plugin MCP loading is\nunchanged, and no MCP process is launched by this PR alone.\n\n## Assumptions\n\n- The selected root ID is the plugin policy identity; the manifest\ndisplay name is presentation metadata.\n- An environment ID is a stable logical authority. Reconnection or\nreplacement under the same ID does not change ownership.\n- Selected plugin packages and their manifests are trusted inputs.\n- The selected package and MCP discovery snapshot remain frozen for the\nactive thread runtime.\n\n## Follow-up\n\nThe next PR installs this contributor in app-server and adds an\nend-to-end test proving that a selected plugin MCP tool launches on its\nowning executor, can be called by the model, survives an explicit MCP\nrefresh, and is invisible when its root was not selected.\n\nResume, fork, environment removal or ID changes, dynamic catalog reload,\nand executor-owned HTTP MCP placement remain separate lifecycle\ndecisions.\n\n## Verification\n\nFocused tests cover executor-only filesystem reads, missing and\nmalformed config, stdio filtering and normalization, managed\nrequirements, package attribution, and selection order. CI owns\nexecution of the test suite.","tree":{"sha":"6daa9ade053031a4cb5a985fb0e6702e32d7ae24","url":"https://api.github.com/repos/openai/codex/git/trees/6daa9ade053031a4cb5a985fb0e6702e32d7ae24"},"url":"https://api.github.com/repos/openai/codex/git/commits/b3c423e475a9fa2bb1ad493e09408d13732d4b98","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqL8tFCRC1aQ7uu5UhlAAAn0IQAHsTITdKWMmnpIojwFI1Rb7W\n+AdK/2OOAxDQmeJileyKdAlWwwNB5ob3IaSQZAScGQ4+doj96db8kj8owaB85l+9\n2KMsj/wFL2Sqv3zPt9WsMu9E002X0VT4TP6Q/9ICZWLLOm4yLrH04SjgSOjNdBjp\nso8hekpZouw9I7a7Mr1kVHOS+0Il8ttrommc77BI7Niz9wVbNr0DIm1K9bWAeJTQ\nGWyWWT3F/sONyj3DR0BCMMrbj7zA/YahWlT9BzI0g9pXCm6rqdNnFmHXNndclZ+n\n+Lei6WkhbRIVvM6c7OmdjBPWQ/O1frIfC8p2nV+wyiE5V/KhRFruWtNEGgbl6pIg\nsDkDf673P+TUDjCp829XIkvPWTcMACF2y6yQPQAKTaF+UgmIKS6QeQ4H0qiKf+CW\nQKqTHiHKtFCN/X6x+y2Y6cj2ZPywRLbzNhyt/wrKsy3MqJkvRvbsiBfed7CdwVM8\neRK2tn4Q9iHJSUTcFG9kkJs7F6q44XuVUDlkgkXdyEHlwDkQ/toQp1KuWF1zOi+7\nwld9lKUeMo/HZl/B1vhDFufDuuM/0OMUjHS5ghhR0utLy0D8M5UdPVK8TWn6Fb2m\nckdK4amuB7dgm5XdLROb1zIyJF1UtkxOvEPFBDcaBWkuvnAg2eBWG2Vr2nHzu8Pk\nkpC3DpElXDoNcCE+7R1J\n=gC/f\n-----END PGP SIGNATURE-----\n","payload":"tree 6daa9ade053031a4cb5a985fb0e6702e32d7ae24\nparent c3a479620f48101b80d83d01e5e189fbd4c71fb1\nauthor jif <jif@openai.com> 1781517125 +0100\ncommitter GitHub <noreply@github.com> 1781517125 +0200\n\nDiscover stdio MCP servers from selected executor plugins (#27870)\n\n## Why\n\n**In short:** this PR discovers MCP registrations by reading a selected\nplugin's `.mcp.json` on its executor. #27884 then resolves those\nregistrations in the shared catalog.\n\n`thread/start.selectedCapabilityRoots` can select a plugin root owned by\nan executor, and Codex can resolve that package through the executor\nfilesystem. MCP declarations inside the selected plugin are still\nignored.\n\nThis PR adds the source-specific discovery layer on top of the\nselected-plugin catalog boundary in #27884:\n\n```text\nselected capability root\n        |\n        v\nresolve the plugin through its executor filesystem\n        |\n        v\nread and normalize its MCP config through the same filesystem\n        |\n        v\ncontribute stdio registrations bound to that environment ID\n```\n\nThe existing MCP launcher and connection manager remain unchanged. MCP\nconfig parsing is shared with local plugins through #27863.\n\n## What changed\n\n- Added an executor plugin MCP provider in the MCP extension.\n- Retained only the exact filesystem capability used for package\nresolution and reused it for the selected plugin's MCP config, with no\nhost-filesystem fallback or unrelated process/HTTP authority.\n- Read either the manifest-declared MCP config or the default\n`.mcp.json`; a missing default file means the plugin has no MCP servers.\n- Accepted stdio servers only for this first vertical. Executor-owned\nHTTP declarations are skipped with a warning until their placement\nsemantics are defined.\n- Normalized stdio registrations with the owning environment's stable\nlogical ID and plugin-root working directory.\n- Resolved environment-variable names on the owning executor and\nrejected explicit local forwarding for non-local plugins.\n- Froze discovered declarations once per active thread runtime, then\napplied current managed plugin and MCP requirements when contributing\nthem.\n- Carried the selected root ID, display name, and selection order into\nthe catalog contribution defined by #27884.\n\n## Behavior and scope\n\nThere is intentionally no production behavior change yet. This PR\nprovides the executor provider and contribution boundary, but app-server\ndoes not install it in this change. Existing local plugin MCP loading is\nunchanged, and no MCP process is launched by this PR alone.\n\n## Assumptions\n\n- The selected root ID is the plugin policy identity; the manifest\ndisplay name is presentation metadata.\n- An environment ID is a stable logical authority. Reconnection or\nreplacement under the same ID does not change ownership.\n- Selected plugin packages and their manifests are trusted inputs.\n- The selected package and MCP discovery snapshot remain frozen for the\nactive thread runtime.\n\n## Follow-up\n\nThe next PR installs this contributor in app-server and adds an\nend-to-end test proving that a selected plugin MCP tool launches on its\nowning executor, can be called by the model, survives an explicit MCP\nrefresh, and is invisible when its root was not selected.\n\nResume, fork, environment removal or ID changes, dynamic catalog reload,\nand executor-owned HTTP MCP placement remain separate lifecycle\ndecisions.\n\n## Verification\n\nFocused tests cover executor-only filesystem reads, missing and\nmalformed config, stdio filtering and normalization, managed\nrequirements, package attribution, and selection order. CI owns\nexecution of the test suite.","verified_at":"2026-06-15T09:52:06Z"}},"url":"https://api.github.com/repos/openai/codex/commits/b3c423e475a9fa2bb1ad493e09408d13732d4b98","html_url":"https://github.com/openai/codex/commit/b3c423e475a9fa2bb1ad493e09408d13732d4b98","comments_url":"https://api.github.com/repos/openai/codex/commits/b3c423e475a9fa2bb1ad493e09408d13732d4b98/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c3a479620f48101b80d83d01e5e189fbd4c71fb1","url":"https://api.github.com/repos/openai/codex/commits/c3a479620f48101b80d83d01e5e189fbd4c71fb1","html_url":"https://github.com/openai/codex/commit/c3a479620f48101b80d83d01e5e189fbd4c71fb1"}]},{"sha":"c3a479620f48101b80d83d01e5e189fbd4c71fb1","node_id":"C_kwDOOYsS4doAKGMzYTQ3OTYyMGY0ODEwMWI4MGQ4M2QwMWU1ZTE4OWZiZDRjNzFmYjE","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-06-15T09:10:51Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-15T09:10:51Z"},"message":"Add selected-plugin precedence and attribution to the MCP catalog (#27884)\n\n## Why\n\n**In short:** this PR resolves already-discovered MCP registrations. It\ndoes not read selected plugins or discover their MCP servers.\n\nThe resolved MCP catalog currently builds config and auto-discovered\nplugin registrations before runtime contributors are applied. A\nthread-selected plugin needs a distinct precedence tier in that same\ninitial resolution pass: otherwise a disabled lower-precedence winner\ncan leave stale name-level state behind, and the winning MCP tools\ncannot be attributed to the selected package reliably.\n\nThis PR adds that catalog boundary before executor discovery is\nconnected.\n\n## What changed\n\n- Added an explicit selected-plugin registration tier between\nauto-discovered plugins and explicit config.\n- Collected selected-plugin contributions before the initial catalog\nbuild, while leaving compatibility and generic extension overlays in\ntheir existing runtime phase.\n- Retained the winning plugin ID and display name directly on\nplugin-owned catalog registrations.\n- Derived MCP tool provenance from the winning catalog entry instead of\njoining against local-only plugin summaries.\n- Retained the winning selected server's tool approval policy in the\nrunning connection manager, so a selected registration cannot inherit\napproval behavior from a losing local plugin.\n- Kept remembered approval session-scoped for selected plugins until\nthere is an authority-aware persistence contract; Codex will not write\napproval back to an unrelated local plugin.\n- Preserved existing name-level disabled vetoes for discovered plugins\nand config, while keeping a selected package's own disabled registration\nscoped to that registration.\n- Preserved deterministic selection order and existing config,\ncompatibility, and extension precedence.\n\nThe resulting order is:\n\n```text\nauto-discovered plugin\n  < selected plugin\n  < explicit config\n  < compatibility registration\n  < extension overlay\n```\n\n## Behavior and scope\n\nThis is a catalog and provenance change only. No production host\ncontributes selected-plugin MCP registrations yet, so existing local MCP\nbehavior remains unchanged.\n\nThe stacked follow-up, #27870, installs the executor plugin provider\nthat produces these registrations. App-server activation remains a\nseparate final step.\n\n## Verification\n\nFocused tests cover precedence, deterministic selected-plugin conflicts,\ndisabled-veto behavior across catalog phases, managed requirements\nbefore selected-plugin resolution, winning-server approval policy, and\nattribution when local and selected packages share an ID or server name.\nCI owns execution of the test suite.","tree":{"sha":"df829ad20c8524dccbc920ae86827a3270514cae","url":"https://api.github.com/repos/openai/codex/git/trees/df829ad20c8524dccbc920ae86827a3270514cae"},"url":"https://api.github.com/repos/openai/codex/git/commits/c3a479620f48101b80d83d01e5e189fbd4c71fb1","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqL8GbCRC1aQ7uu5UhlAAAdcEQAIg0Na3Jwdx/W7Q52BvYoLnq\nGd0/FFHHyagiL/uHIxHszi7gbNqeSo8C5a2OqdO3FOO4Neq6NxxWCe6xB7EsdhNI\nknzekmI/8JQNHQ/bCqFJPLeZy9jfScGHLM6elpicqN+xKLvXaCcM+DLdDnX6BeCJ\nUkE2XNXI6ArcsJH5sajdwU0O/5WZfSsa36+sLn8nXzcYf6uwzsHgjMVpwZU0qo8W\nZvHBZv+CAkhnVIMfMnXGnq2lxx2woV8wtSgITAucSyeUsYfLR23MCCMFtryB0VXa\njHEU/agVZA0UA4LUqvYd9+w4Bp5fyvn2Zupo9KRs5gOfj+E2rEKlaOaxq6EHFrkw\nLm7IdtSsJgVgs6BhE0CtdV5JwjWfcNEO8GZzS5oaBX7oviTO8niSG5hDx/HJzztD\noYkc9PDGDEdB0+PoaOxgIk/KBW4e/ZDgagmsKM/YXc06s6ttKHdK8R+sVLtS+crB\nZbNX4FAnYbDvBkYVAF6X/uDo3YoJvD36+L4KLCP+cnyxRZ5fTFQT3iO6asETOGjJ\n1V2VZBYV5aQOMP8JiG/9C87u3jLGw5lqqYYk/kajnsomc7AwYqP76dQm3CzzX46x\njfEMPjviRAjWip5Ejw+QDCL6kFtTGv9dInJ28kZbLg5pGQABvfUo+Kax8NXf/COb\n2Mrmj1MfPA0QM/0Ed6yR\n=lwNX\n-----END PGP SIGNATURE-----\n","payload":"tree df829ad20c8524dccbc920ae86827a3270514cae\nparent dfd03ea01bbec2613013b477fb82abc67534a7d7\nauthor jif <jif@openai.com> 1781514651 +0100\ncommitter GitHub <noreply@github.com> 1781514651 +0200\n\nAdd selected-plugin precedence and attribution to the MCP catalog (#27884)\n\n## Why\n\n**In short:** this PR resolves already-discovered MCP registrations. It\ndoes not read selected plugins or discover their MCP servers.\n\nThe resolved MCP catalog currently builds config and auto-discovered\nplugin registrations before runtime contributors are applied. A\nthread-selected plugin needs a distinct precedence tier in that same\ninitial resolution pass: otherwise a disabled lower-precedence winner\ncan leave stale name-level state behind, and the winning MCP tools\ncannot be attributed to the selected package reliably.\n\nThis PR adds that catalog boundary before executor discovery is\nconnected.\n\n## What changed\n\n- Added an explicit selected-plugin registration tier between\nauto-discovered plugins and explicit config.\n- Collected selected-plugin contributions before the initial catalog\nbuild, while leaving compatibility and generic extension overlays in\ntheir existing runtime phase.\n- Retained the winning plugin ID and display name directly on\nplugin-owned catalog registrations.\n- Derived MCP tool provenance from the winning catalog entry instead of\njoining against local-only plugin summaries.\n- Retained the winning selected server's tool approval policy in the\nrunning connection manager, so a selected registration cannot inherit\napproval behavior from a losing local plugin.\n- Kept remembered approval session-scoped for selected plugins until\nthere is an authority-aware persistence contract; Codex will not write\napproval back to an unrelated local plugin.\n- Preserved existing name-level disabled vetoes for discovered plugins\nand config, while keeping a selected package's own disabled registration\nscoped to that registration.\n- Preserved deterministic selection order and existing config,\ncompatibility, and extension precedence.\n\nThe resulting order is:\n\n```text\nauto-discovered plugin\n  < selected plugin\n  < explicit config\n  < compatibility registration\n  < extension overlay\n```\n\n## Behavior and scope\n\nThis is a catalog and provenance change only. No production host\ncontributes selected-plugin MCP registrations yet, so existing local MCP\nbehavior remains unchanged.\n\nThe stacked follow-up, #27870, installs the executor plugin provider\nthat produces these registrations. App-server activation remains a\nseparate final step.\n\n## Verification\n\nFocused tests cover precedence, deterministic selected-plugin conflicts,\ndisabled-veto behavior across catalog phases, managed requirements\nbefore selected-plugin resolution, winning-server approval policy, and\nattribution when local and selected packages share an ID or server name.\nCI owns execution of the test suite.","verified_at":"2026-06-15T09:10:52Z"}},"url":"https://api.github.com/repos/openai/codex/commits/c3a479620f48101b80d83d01e5e189fbd4c71fb1","html_url":"https://github.com/openai/codex/commit/c3a479620f48101b80d83d01e5e189fbd4c71fb1","comments_url":"https://api.github.com/repos/openai/codex/commits/c3a479620f48101b80d83d01e5e189fbd4c71fb1/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"dfd03ea01bbec2613013b477fb82abc67534a7d7","url":"https://api.github.com/repos/openai/codex/commits/dfd03ea01bbec2613013b477fb82abc67534a7d7","html_url":"https://github.com/openai/codex/commit/dfd03ea01bbec2613013b477fb82abc67534a7d7"}]},{"sha":"dfd03ea01bbec2613013b477fb82abc67534a7d7","node_id":"C_kwDOOYsS4doAKGRmZDAzZWEwMWJiZWMyNjEzMDEzYjQ3N2ZiODJhYmM2NzUzNGE3ZDc","commit":{"author":{"name":"Brent Traut","email":"btraut@openai.com","date":"2026-06-14T07:14:26Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-14T07:14:26Z"},"message":"feat(app-server): filter threads by parent (#26662)\n\n## Why\n\nClients that display or coordinate spawned subagents need an\nauthoritative snapshot of a thread's immediate spawned children when\nthey connect to app-server or recover after missing live events.\n`thread/list` cannot query by parent, so clients must otherwise scan\nunrelated threads or reconstruct relationships from rollout history and\ntransient events.\n\nThe direct spawn relationship already exists in persisted\n`thread_spawn_edges` state. Review and Guardian threads do not\nparticipate in that lifecycle and are intentionally outside this\nfilter's scope.\n\n## What changed\n\nThis adds an experimental `parentThreadId` filter to `thread/list`.\nParent-filtered requests return direct spawned children from persisted\nstate while preserving the existing response shape, explicit filters,\nsorting, and timestamp-only cursor behavior. The lookup does not read\nrollout transcripts or recursively return descendants.\n\nSupersedes #25112 with the narrower `thread/list` filter approach.\n\n## How it works\n\n1. An experimental client passes a valid thread ID as `parentThreadId`.\n2. App-server routes the list through the existing thread-store and\nstate-database boundaries.\n3. SQLite selects threads whose IDs have a direct persisted spawn edge\nfrom that parent.\n4. Omitted provider and source filters include all values; explicit\nfilters keep ordinary `thread/list` semantics.\n5. Grandchildren, Review threads, and Guardian threads are excluded.\n\n## Verification\n\nState (144 tests), rollout (69 tests), and focused app-server\nthread-list (31 tests) suites passed. Scoped Clippy checks and\nrepository formatting also passed. Coverage includes direct spawned\nchildren, omitted grandchildren, pagination, malformed IDs, mixed source\nkinds, explicit filters, and operation without rollout files.","tree":{"sha":"d7a99fc4c602fbac4585e6874b14a291f30042d5","url":"https://api.github.com/repos/openai/codex/git/trees/d7a99fc4c602fbac4585e6874b14a291f30042d5"},"url":"https://api.github.com/repos/openai/codex/git/commits/dfd03ea01bbec2613013b477fb82abc67534a7d7","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLlTSCRC1aQ7uu5UhlAAApsQQAHN3U1b7XhcZT+bd7Xg0/LNR\nWsiF5X6FcqJXlsDPkFoWPoY5ElTlzFjbJ6LlLDjer5NK9hR/FN6YdwVJ6ecpdTYH\ndvspYo1W3M6rL8tZtHzvz4/yQu1cHyFhEgCLwmzBcrcnnmKp9UVV3yFCpE3BGhBl\nNVUZCuKvN9YUyQ4eiz1nRGFy9eFyNfVTzqTWJzO0l1APifocyagcMBZ7h5yp9/n4\nGxUumRPsHmbbv9yF7a3zgILP7m5uWdhm1pY5NuT4kbzrHz2D8Dh4kAffVcSpT1y4\ngTvL49zu8Ymb49pPIxZRarkShs8cQiJZGRCoCcpcK9kH1po1ScUusjiQivqm9XBj\nVwsDi87kUiaUuFVQQeFQptkoq/MbefJm99XCK7wkDCG8YtOH+5splCBUjLA3tDda\nuXo7KG4sEicnYMH/XKoLE7IdDhHulxNQO/GiTGlKi2mOk4z9dRwzdssvqWXTVfNg\n1TnjWMezfhhkrmvpz7gq88WBPQ/myC0IEr/kSeAUV2Nj2qnYD3DwbCGfrwCeWslg\nImc91JJaTx5iwJx0lySPXVaBskMylLEupRz42M3RsZfYAKFBqneo3qNcx6+2SCM/\nL9utwGIGU7k0pifzkwBN2k5fIsCqzroJEU9IrDQVyMxEmY9+RG7Qds10p3pP2fWI\nUd/n7RZsj3SovYW9zdq3\n=k3UP\n-----END PGP SIGNATURE-----\n","payload":"tree d7a99fc4c602fbac4585e6874b14a291f30042d5\nparent efbd00f21f2cec9877f9e4606f1652d5262c64b6\nauthor Brent Traut <btraut@openai.com> 1781421266 -0700\ncommitter GitHub <noreply@github.com> 1781421266 -0700\n\nfeat(app-server): filter threads by parent (#26662)\n\n## Why\n\nClients that display or coordinate spawned subagents need an\nauthoritative snapshot of a thread's immediate spawned children when\nthey connect to app-server or recover after missing live events.\n`thread/list` cannot query by parent, so clients must otherwise scan\nunrelated threads or reconstruct relationships from rollout history and\ntransient events.\n\nThe direct spawn relationship already exists in persisted\n`thread_spawn_edges` state. Review and Guardian threads do not\nparticipate in that lifecycle and are intentionally outside this\nfilter's scope.\n\n## What changed\n\nThis adds an experimental `parentThreadId` filter to `thread/list`.\nParent-filtered requests return direct spawned children from persisted\nstate while preserving the existing response shape, explicit filters,\nsorting, and timestamp-only cursor behavior. The lookup does not read\nrollout transcripts or recursively return descendants.\n\nSupersedes #25112 with the narrower `thread/list` filter approach.\n\n## How it works\n\n1. An experimental client passes a valid thread ID as `parentThreadId`.\n2. App-server routes the list through the existing thread-store and\nstate-database boundaries.\n3. SQLite selects threads whose IDs have a direct persisted spawn edge\nfrom that parent.\n4. Omitted provider and source filters include all values; explicit\nfilters keep ordinary `thread/list` semantics.\n5. Grandchildren, Review threads, and Guardian threads are excluded.\n\n## Verification\n\nState (144 tests), rollout (69 tests), and focused app-server\nthread-list (31 tests) suites passed. Scoped Clippy checks and\nrepository formatting also passed. Coverage includes direct spawned\nchildren, omitted grandchildren, pagination, malformed IDs, mixed source\nkinds, explicit filters, and operation without rollout files.","verified_at":"2026-06-14T07:14:27Z"}},"url":"https://api.github.com/repos/openai/codex/commits/dfd03ea01bbec2613013b477fb82abc67534a7d7","html_url":"https://github.com/openai/codex/commit/dfd03ea01bbec2613013b477fb82abc67534a7d7","comments_url":"https://api.github.com/repos/openai/codex/commits/dfd03ea01bbec2613013b477fb82abc67534a7d7/comments","author":{"login":"btraut-openai","id":284131405,"node_id":"U_kgDOEO-ATQ","avatar_url":"https://avatars.githubusercontent.com/u/284131405?v=4","gravatar_id":"","url":"https://api.github.com/users/btraut-openai","html_url":"https://github.com/btraut-openai","followers_url":"https://api.github.com/users/btraut-openai/followers","following_url":"https://api.github.com/users/btraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/btraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/btraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/btraut-openai/subscriptions","organizations_url":"https://api.github.com/users/btraut-openai/orgs","repos_url":"https://api.github.com/users/btraut-openai/repos","events_url":"https://api.github.com/users/btraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/btraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"efbd00f21f2cec9877f9e4606f1652d5262c64b6","url":"https://api.github.com/repos/openai/codex/commits/efbd00f21f2cec9877f9e4606f1652d5262c64b6","html_url":"https://github.com/openai/codex/commit/efbd00f21f2cec9877f9e4606f1652d5262c64b6"}]},{"sha":"efbd00f21f2cec9877f9e4606f1652d5262c64b6","node_id":"C_kwDOOYsS4doAKGVmYmQwMGYyMWYyY2VjOTg3N2Y5ZTQ2MDZmMTY1MmQ1MjYyYzY0YjY","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-14T06:07:46Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-14T06:07:46Z"},"message":"[codex] exec-server honors remote environment cwd and shell (#28122)\n\n## Why\n\nNext slice needed to make progress on the `remote_env_windows` test is\nto support passing a Windows cwd for the remote environment and using\nthat environment's native shell. This lets the test run a real Windows\nprocess instead of only recording an early path or shell mismatch.\n\n## What\n\n- change `TurnEnvironmentSelection.cwd` from `AbsolutePathBuf` to\n`PathUri`\n- convert local cwd values to URIs when constructing selections\n- preserve a remote primary cwd instead of replacing it with the local\nlegacy fallback\n- prefer the selected environment's discovered shell for unified exec,\nfalling back to the session shell when unavailable\n- convert back to a host-native absolute path at current native-only\nconsumer boundaries\n- reject or deny unsupported foreign cwd values at the existing\nrequest-permissions boundary, with TODOs for its future migration\n- extend the hermetic Wine test to execute Windows PowerShell in\n`C:\\windows` and verify successful process completion\n- record the current app-server rejection against the same Wine-backed\nremote Windows fixture when its cwd is supplied as a native Windows path","tree":{"sha":"dd70cd102781530e4f2e57ce05582f9c9b4f06fa","url":"https://api.github.com/repos/openai/codex/git/trees/dd70cd102781530e4f2e57ce05582f9c9b4f06fa"},"url":"https://api.github.com/repos/openai/codex/git/commits/efbd00f21f2cec9877f9e4606f1652d5262c64b6","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLkUyCRC1aQ7uu5UhlAAAUWMQAJKxGIEfgUrZh74s/WxQUYfR\no9vpBNBS8yrDRbuL3KxijfjLZ14wxJsz1Zlr5ks03ud2MmMM6nckWI3Q2qgDaq28\nSHfTdlKOy4jOHY0Vbfo5HN7qaVhNqw5ppFx3rEmvgZiJ0PkGRYHbbi9Mk//cjeNB\nNmzp+jGf3wJZFA4H+YL4tXU9evFzn6H5M2wiowQMV+NDntb37ceuZ3Xs8iz52dNg\nTyBke3yyBwVZ5SuKAwqgl+oot8WxJBGhSrM9PtfkWiMf8uZQaKyUwpHEx1cp+wxu\nQsgwx/dKn5U/h9yzKIEgHFmR7EblCTUshu+YXKk3rrhUGE75vaWtt0hMV/IeLIjc\nff5epq4iUx+/gswYpGXrr3y8OZgBAS7PU6Qjp1wjpXL78C2qK1wPb4aG98Ax8hE4\njYh3nY8LhSTmm/+UVERRisZSvb0LJoDPBJOTIPHq4bjPZFR9o1gzMeJaXBxJ1FxF\naT8Xl7Q6wDXZXqHH2Rh6w4FRpkers/Zqqe0XKSq/49NgFox0zJuf5HcZi3a6kacO\ncnuBuRXzYLMsZR6XOFAXPAqjWpy9H41zzL3Q92UkQDOL3k+yFI6XTmg5iLCmKcdW\n+rRxMaW8XqF+Xeb3oHfaaoWkTwKa8sMBogLDsAIPA1CCjv/zvoCo8DEdh1NP6Ov5\nWBQ8HuQX8LdR1WIAjaDz\n=2TFD\n-----END PGP SIGNATURE-----\n","payload":"tree dd70cd102781530e4f2e57ce05582f9c9b4f06fa\nparent 5e9249ec0266f6331d1cb811d472c4d20cd5131d\nauthor Adam Perry @ OpenAI <anp@openai.com> 1781417266 -0700\ncommitter GitHub <noreply@github.com> 1781417266 +0000\n\n[codex] exec-server honors remote environment cwd and shell (#28122)\n\n## Why\n\nNext slice needed to make progress on the `remote_env_windows` test is\nto support passing a Windows cwd for the remote environment and using\nthat environment's native shell. This lets the test run a real Windows\nprocess instead of only recording an early path or shell mismatch.\n\n## What\n\n- change `TurnEnvironmentSelection.cwd` from `AbsolutePathBuf` to\n`PathUri`\n- convert local cwd values to URIs when constructing selections\n- preserve a remote primary cwd instead of replacing it with the local\nlegacy fallback\n- prefer the selected environment's discovered shell for unified exec,\nfalling back to the session shell when unavailable\n- convert back to a host-native absolute path at current native-only\nconsumer boundaries\n- reject or deny unsupported foreign cwd values at the existing\nrequest-permissions boundary, with TODOs for its future migration\n- extend the hermetic Wine test to execute Windows PowerShell in\n`C:\\windows` and verify successful process completion\n- record the current app-server rejection against the same Wine-backed\nremote Windows fixture when its cwd is supplied as a native Windows path","verified_at":"2026-06-14T06:07:47Z"}},"url":"https://api.github.com/repos/openai/codex/commits/efbd00f21f2cec9877f9e4606f1652d5262c64b6","html_url":"https://github.com/openai/codex/commit/efbd00f21f2cec9877f9e4606f1652d5262c64b6","comments_url":"https://api.github.com/repos/openai/codex/commits/efbd00f21f2cec9877f9e4606f1652d5262c64b6/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"5e9249ec0266f6331d1cb811d472c4d20cd5131d","url":"https://api.github.com/repos/openai/codex/commits/5e9249ec0266f6331d1cb811d472c4d20cd5131d","html_url":"https://github.com/openai/codex/commit/5e9249ec0266f6331d1cb811d472c4d20cd5131d"}]},{"sha":"5e9249ec0266f6331d1cb811d472c4d20cd5131d","node_id":"C_kwDOOYsS4doAKDVlOTI0OWVjMDI2NmY2MzMxZDFjYjgxMWQ0NzJjNGQyMGNkNTEzMWQ","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-14T05:26:49Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-14T05:26:49Z"},"message":"path-uri: render native paths across platforms (#27819)\n\n## Why\n\nWe're moving to `PathUri` in more places to support cross-OS\napp-server/exec-server, but we don't want to expose the URI encoding to\nusers of app-server's public APIs yet.\n\nWe'll need to translate at the app-server API boundary between\nclient-visible \"regular\" paths that are appropriate for the OS of the\nenvironment for which the paths make sense, which means using the\nenvironment's path personality to do the conversion.\n\n`PathUri` doesn't yet attempt to encode environment ID, so for now we'll\nsniff the most likely path convention for a given path.\n\n## What\n\n- Add `PathConvention` and `NativePathString` with host-independent\nPOSIX, Windows drive, and UNC rendering.\n- Cover cross-host rendering, encoding, Unicode, invalid components.","tree":{"sha":"02d90ab9d9dac63d335709297ee07eaca495fb6a","url":"https://api.github.com/repos/openai/codex/git/trees/02d90ab9d9dac63d335709297ee07eaca495fb6a"},"url":"https://api.github.com/repos/openai/codex/git/commits/5e9249ec0266f6331d1cb811d472c4d20cd5131d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLjuZCRC1aQ7uu5UhlAAAhk4QAKQRuZhj8WjE2l7cBanFr/u0\n2GjCRABAC5aXY8yznDkkMEINSle5zrAx+HR3V3FhBSxKTF+nNlrSGW1cmCxMNGBy\nNa+3F3pnO7KuZX2yx+ikHtZGhZsV9G+Vy0Z45w0kH4Qt266c0sqv448ARE/IfsDb\nwsO5xP2YbeQ/MMUYyRfKvA5O+VT3kDcFuhScEPQ8UFBXMZH9CABAqaexBywH42bY\nD93qXjt0L9uLMVj/hNLesOYjBoOdGdO3jiwK4TtjvTDRJ9kcbBSVr5BJB3DJjlF9\nZic2xA9HSARBs9RUQ6PVCizB0ELtS/vHUtGN7eE9WmeOiHV/0hiavb812orBzTkB\n7MxRYDnz2iwmrRrUreRAagen9XvSkX5ddmM/mgvOp/gb4Uf9GRDNLpSvro1z7hAs\nqOV1j6+PFIa8lLFZPOKQCCKdWkqWeTRKunCyEt4NLUst6rn1rQmnPoXw27Uuu8Xa\nqRdqS4hCxVEsEGTl0iYmElmeO4uwfyN2gn1dy8mN+jQPZpNthPIyos1fIVraUZLV\nj4QNYZdnzVStnmxXlQ2OCbw+2jXKVvJBQet4Zh7Zjj+125ey/mMNxe4DVYBl+XyQ\nvnOREik5TJG6ofvt/GNfciwIcLikcj3ZpUrzZQG6ISHX4atERCfv7CSw4nB18jwg\nooZ+c2RhptPZvgW2rqrC\n=cJcN\n-----END PGP SIGNATURE-----\n","payload":"tree 02d90ab9d9dac63d335709297ee07eaca495fb6a\nparent 42dec90bc448bfd0e398878583799a6c9afc5234\nauthor Adam Perry @ OpenAI <anp@openai.com> 1781414809 -0700\ncommitter GitHub <noreply@github.com> 1781414809 +0000\n\npath-uri: render native paths across platforms (#27819)\n\n## Why\n\nWe're moving to `PathUri` in more places to support cross-OS\napp-server/exec-server, but we don't want to expose the URI encoding to\nusers of app-server's public APIs yet.\n\nWe'll need to translate at the app-server API boundary between\nclient-visible \"regular\" paths that are appropriate for the OS of the\nenvironment for which the paths make sense, which means using the\nenvironment's path personality to do the conversion.\n\n`PathUri` doesn't yet attempt to encode environment ID, so for now we'll\nsniff the most likely path convention for a given path.\n\n## What\n\n- Add `PathConvention` and `NativePathString` with host-independent\nPOSIX, Windows drive, and UNC rendering.\n- Cover cross-host rendering, encoding, Unicode, invalid components.","verified_at":"2026-06-14T05:26:50Z"}},"url":"https://api.github.com/repos/openai/codex/commits/5e9249ec0266f6331d1cb811d472c4d20cd5131d","html_url":"https://github.com/openai/codex/commit/5e9249ec0266f6331d1cb811d472c4d20cd5131d","comments_url":"https://api.github.com/repos/openai/codex/commits/5e9249ec0266f6331d1cb811d472c4d20cd5131d/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"42dec90bc448bfd0e398878583799a6c9afc5234","url":"https://api.github.com/repos/openai/codex/commits/42dec90bc448bfd0e398878583799a6c9afc5234","html_url":"https://github.com/openai/codex/commit/42dec90bc448bfd0e398878583799a6c9afc5234"}]},{"sha":"42dec90bc448bfd0e398878583799a6c9afc5234","node_id":"C_kwDOOYsS4doAKDQyZGVjOTBiYzQ0OGJmZDBlMzk4ODc4NTgzNzk5YTZjOWFmYzUyMzQ","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-14T04:52:32Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-14T04:52:32Z"},"message":"bazel: add PowerShell to Wine test harness (#28120)\n\n## Why\n\nCross-OS tests in the wine environment will be much more faithful if we\ncan also test powershell integration.\n\n## What\n\nAdd an x86_64 powershell binary to the bazel wine environment and\ninclude smoke tests.","tree":{"sha":"63f0d680f9e5803b3a5aa0a6870918991332b939","url":"https://api.github.com/repos/openai/codex/git/trees/63f0d680f9e5803b3a5aa0a6870918991332b939"},"url":"https://api.github.com/repos/openai/codex/git/commits/42dec90bc448bfd0e398878583799a6c9afc5234","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLjOQCRC1aQ7uu5UhlAAA6hQQAC0VSel0U3Q3QnEvTsslLbxM\nU3YZIbydUTVB2LN8VDyVhPrbb8tfJacQk0cPdDy8rqsiQiDsRQkDA4yVY3NSokgg\nGurUTQTmowp1oJ+wIsGlfg8BMM3hMrP4Tm5gbdaXy1CKt2/MQ9fAG0qSSgTvPu16\nggDQu4iwm100bMEe/341v+BI+gWIXcMCULIoZ4z6HuuKL7CVXCCUa9gRNEZidfvF\nyIYQeC/14peD7Zi3AnGwDIJbs24W66+KuP/TPsSOfV0vANzwq+T9vxkt64LNcfco\nQ2TIyMsr3xzIE6FWn2CLxhoHKVBADZxyuwKnBNQhi8EDIO0pMGoOKZhGmXayP20M\nf+V1pqZk6ekgh6mtLwBA+Z+hZ6EpxX36X+oXgUifexjnhTNZxQDdeD/OTsIbvEto\nnFzlcyXFaKVJmU43aGNGZpuEm59sV1U4wCAvtUofRE0hADBpVVQMQTMZV14qxtrl\nrZPLyChpcyyAT6zUmUALdZ104dmXr/LVQeuiN9v8hnWyF1kSupxwpGUS47P51Sxh\nAprK8d1GjMgIElE9vnfdvu4SMiAkzt5rPFOuwEDTTmEv/0z8UgwgTQZaBn6YnXCq\nfFIZGIcplhGpG3XJR0kJKjTCT5eWwLbZ2IQI66m1HKGbAgQyBf3CSCMIq9N1V+4w\ncZV1jTDws2TzdmAPS21f\n=Vovs\n-----END PGP SIGNATURE-----\n","payload":"tree 63f0d680f9e5803b3a5aa0a6870918991332b939\nparent 740c4f269de8db915dde9d238ec0b8da6339aa56\nauthor Adam Perry @ OpenAI <anp@openai.com> 1781412752 -0700\ncommitter GitHub <noreply@github.com> 1781412752 +0000\n\nbazel: add PowerShell to Wine test harness (#28120)\n\n## Why\n\nCross-OS tests in the wine environment will be much more faithful if we\ncan also test powershell integration.\n\n## What\n\nAdd an x86_64 powershell binary to the bazel wine environment and\ninclude smoke tests.","verified_at":"2026-06-14T04:52:33Z"}},"url":"https://api.github.com/repos/openai/codex/commits/42dec90bc448bfd0e398878583799a6c9afc5234","html_url":"https://github.com/openai/codex/commit/42dec90bc448bfd0e398878583799a6c9afc5234","comments_url":"https://api.github.com/repos/openai/codex/commits/42dec90bc448bfd0e398878583799a6c9afc5234/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"740c4f269de8db915dde9d238ec0b8da6339aa56","url":"https://api.github.com/repos/openai/codex/commits/740c4f269de8db915dde9d238ec0b8da6339aa56","html_url":"https://github.com/openai/codex/commit/740c4f269de8db915dde9d238ec0b8da6339aa56"}]},{"sha":"740c4f269de8db915dde9d238ec0b8da6339aa56","node_id":"C_kwDOOYsS4doAKDc0MGM0ZjI2OWRlOGRiOTE1ZGRlOWQyMzhlYzBiOGRhNjMzOWFhNTY","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-14T04:43:39Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-14T04:43:39Z"},"message":"build: run buildifier from just fmt (#28125)\n\n## Intent\n\nKeep Bazel and Starlark files consistently formatted without requiring\ncontributors to install or version buildifier themselves.\n\n## Implementation\n\n- Add a SHA-256-pinned, cross-platform DotSlash manifest for buildifier\nv8.5.1.\n- Run buildifier from the shared `just fmt` and `just fmt-check` driver,\nwith Windows-safe explicit DotSlash invocation.\n- Provision DotSlash in formatting CI and contributor devcontainers, and\ndocument the source-build prerequisite.\n- Apply the initial mechanical buildifier formatting baseline.","tree":{"sha":"66da14a2be8957891bf6ab688496691cb590fe3b","url":"https://api.github.com/repos/openai/codex/git/trees/66da14a2be8957891bf6ab688496691cb590fe3b"},"url":"https://api.github.com/repos/openai/codex/git/commits/740c4f269de8db915dde9d238ec0b8da6339aa56","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLjF7CRC1aQ7uu5UhlAAApR8QAIFB/kq/boesaqs0JerQa3rQ\n7eZsfzUoCs87x3A3sclRH4mhVB84PQTyQdNis2y0RKoDzlCfIEl6iL8sTlEo/oSH\ngP6kLhG4Gk6gqYjaExhIF1UnQMrRW02NN5XZ4RR5r3HqURS2aciOIAL/dJlm07iN\nZg+fAfoJpaZJ8Agnpb1gHHzsso6vqWLJUHbEsV3ZWSgnQfWBzmOZvsfCqL8Hk0t3\ncUN7GXyL3zwnrs4ZQYZr7tAHS4R1cu5VvRp9AG5WbJ99nCZT90TW9zKHPMa5GtZ1\nzBE2WPfiOIRj8vLZ/xS1C6EsvqfQTgeJseZM453JioBHBWtYj8wB+l8Ly4EXi4aq\n9V0oYvt9ByYEo8DqtCmIYGj8IYS/HMtxhw6+LrlSCWshDTRzJSux6AplRbvEUoFc\n06oc1aNhsHaTqiK4ZaV8oJbMgMOwizOf5jWPu/Lf/4sxAwPLFT/j4nN39yGgodlK\nrb0Y94jJK824tDHuLeBvN106QfzN9pRV+610SIfTnz8wlA/t+5TQb8lB3fwVNnoR\natfi0pVqWGgjJduKQJ7siFKBwiaDLCsJAOccjOCO4TcdtO2KC5FfS+fTF3EcISX5\nk5DRqbXwsK2txUA2e1j054NPrj3pPh2g8kTnXNCCN6sp6bEnG3qA1nc29iv53LtI\nr6GsMn+x9bJF3tW7F1vA\n=Yja9\n-----END PGP SIGNATURE-----\n","payload":"tree 66da14a2be8957891bf6ab688496691cb590fe3b\nparent 73c58011b3c2122b862a8724423976e93647f74d\nauthor Adam Perry @ OpenAI <anp@openai.com> 1781412219 -0700\ncommitter GitHub <noreply@github.com> 1781412219 -0700\n\nbuild: run buildifier from just fmt (#28125)\n\n## Intent\n\nKeep Bazel and Starlark files consistently formatted without requiring\ncontributors to install or version buildifier themselves.\n\n## Implementation\n\n- Add a SHA-256-pinned, cross-platform DotSlash manifest for buildifier\nv8.5.1.\n- Run buildifier from the shared `just fmt` and `just fmt-check` driver,\nwith Windows-safe explicit DotSlash invocation.\n- Provision DotSlash in formatting CI and contributor devcontainers, and\ndocument the source-build prerequisite.\n- Apply the initial mechanical buildifier formatting baseline.","verified_at":"2026-06-14T04:43:40Z"}},"url":"https://api.github.com/repos/openai/codex/commits/740c4f269de8db915dde9d238ec0b8da6339aa56","html_url":"https://github.com/openai/codex/commit/740c4f269de8db915dde9d238ec0b8da6339aa56","comments_url":"https://api.github.com/repos/openai/codex/commits/740c4f269de8db915dde9d238ec0b8da6339aa56/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"73c58011b3c2122b862a8724423976e93647f74d","url":"https://api.github.com/repos/openai/codex/commits/73c58011b3c2122b862a8724423976e93647f74d","html_url":"https://github.com/openai/codex/commit/73c58011b3c2122b862a8724423976e93647f74d"}]},{"sha":"73c58011b3c2122b862a8724423976e93647f74d","node_id":"C_kwDOOYsS4doAKDczYzU4MDExYjNjMjEyMmI4NjJhODcyNDQyMzk3NmU5MzY0N2Y3NGQ","commit":{"author":{"name":"Gabriel Peal","email":"gpeal@users.noreply.github.com","date":"2026-06-14T04:28:31Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-14T04:28:31Z"},"message":"[codex] Pin bundled SQLite to fixed WAL-reset version (#27992)\n\n## Summary\n\nPrevent dependency refreshes from silently downgrading Codex's bundled\nSQLite to a release affected by the WAL-reset corruption bug.\n\nSQLx 0.9 accepts a broad `libsqlite3-sys` range. An unrelated lock\nrefresh therefore moved Codex from `libsqlite3-sys 0.37.0` back to\n`0.35.0`, changing the bundled SQLite runtime from 3.51.3 to 3.50.2.\nSQLite documents the affected versions and fix in [The WAL Reset\nBug](https://www.sqlite.org/wal.html#the_wal_reset_bug) and the [SQLite\n3.51.3 changelog](https://www.sqlite.org/changes.html#version_3_51_3).","tree":{"sha":"35a58e38fb3d94a8263ba13d12be9fad6d0cfd67","url":"https://api.github.com/repos/openai/codex/git/trees/35a58e38fb3d94a8263ba13d12be9fad6d0cfd67"},"url":"https://api.github.com/repos/openai/codex/git/commits/73c58011b3c2122b862a8724423976e93647f74d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLi3vCRC1aQ7uu5UhlAAAT5kQADjKMTLl9n1bLoJ0zaLDYM1k\nIQuH3xHqBtxi26MxF0uggR7dExqxyqs9Z8xJVjlgCBe6VFx4Gj/h3rIEb8KXiHUJ\nrf2sYdt5mnHjOoVs6gvAkGxmTSROz552E9O6NDYwb5eGTOwbERwc/Ym7qIHP2tri\n6ni4Si1FDd3y6YG+7euj84d/ou6f3vCJyrzSdPd5wlV+PNgyApE9sYMT0xvzETCQ\nRRgwcVJEFbxvPtxC/k0kcpHUZC91PKckVEtVwAke6d2xBy7Lhs9ugPnqa23+RtSr\nW1WQikG1NFXrVCONnvwzQdFaZ1g5isCOqNBot3nHlnFOA/HCsiBa88aEsV6qK1pE\nhC2y1xg/t0lkq+2Lfy01BuySiDpDqd+gg7eTYopX2WsOid4fbWiOrYhiXRdy44Rb\nqXz7Yy6lJ8oxXAB1IEj3ItV6D7nEZV7JKyEEI7vGv2uLwzTnyK+9w+PSsDsSC5/m\nqQM0/Dj2bv7nr+bhDJKtUPHPhDyd8C0bP8s647t9p1x4k4rmfaAJpjT7HYttI3N4\nPI0B4znXjNXdaHAXaH9hX3MGDM335YVarSXJXiG7axx2V7cvJLnfk3YwVuNjrkvL\n0HDpy779Idfdx+6K0chYK0Lp4UdK5Fxbq3HiUaR0srPITUK6Y+SF2RyBwMeI2AAr\nk247/gbtr1jzInvJABNr\n=6TSw\n-----END PGP SIGNATURE-----\n","payload":"tree 35a58e38fb3d94a8263ba13d12be9fad6d0cfd67\nparent 51316ead4a434e97928d1331e446d4bf274d44a5\nauthor Gabriel Peal <gpeal@users.noreply.github.com> 1781411311 -0700\ncommitter GitHub <noreply@github.com> 1781411311 -0700\n\n[codex] Pin bundled SQLite to fixed WAL-reset version (#27992)\n\n## Summary\n\nPrevent dependency refreshes from silently downgrading Codex's bundled\nSQLite to a release affected by the WAL-reset corruption bug.\n\nSQLx 0.9 accepts a broad `libsqlite3-sys` range. An unrelated lock\nrefresh therefore moved Codex from `libsqlite3-sys 0.37.0` back to\n`0.35.0`, changing the bundled SQLite runtime from 3.51.3 to 3.50.2.\nSQLite documents the affected versions and fix in [The WAL Reset\nBug](https://www.sqlite.org/wal.html#the_wal_reset_bug) and the [SQLite\n3.51.3 changelog](https://www.sqlite.org/changes.html#version_3_51_3).","verified_at":"2026-06-14T04:28:32Z"}},"url":"https://api.github.com/repos/openai/codex/commits/73c58011b3c2122b862a8724423976e93647f74d","html_url":"https://github.com/openai/codex/commit/73c58011b3c2122b862a8724423976e93647f74d","comments_url":"https://api.github.com/repos/openai/codex/commits/73c58011b3c2122b862a8724423976e93647f74d/comments","author":{"login":"gpeal","id":1307745,"node_id":"MDQ6VXNlcjEzMDc3NDU=","avatar_url":"https://avatars.githubusercontent.com/u/1307745?v=4","gravatar_id":"","url":"https://api.github.com/users/gpeal","html_url":"https://github.com/gpeal","followers_url":"https://api.github.com/users/gpeal/followers","following_url":"https://api.github.com/users/gpeal/following{/other_user}","gists_url":"https://api.github.com/users/gpeal/gists{/gist_id}","starred_url":"https://api.github.com/users/gpeal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gpeal/subscriptions","organizations_url":"https://api.github.com/users/gpeal/orgs","repos_url":"https://api.github.com/users/gpeal/repos","events_url":"https://api.github.com/users/gpeal/events{/privacy}","received_events_url":"https://api.github.com/users/gpeal/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"51316ead4a434e97928d1331e446d4bf274d44a5","url":"https://api.github.com/repos/openai/codex/commits/51316ead4a434e97928d1331e446d4bf274d44a5","html_url":"https://github.com/openai/codex/commit/51316ead4a434e97928d1331e446d4bf274d44a5"}]},{"sha":"51316ead4a434e97928d1331e446d4bf274d44a5","node_id":"C_kwDOOYsS4doAKDUxMzE2ZWFkNGE0MzRlOTc5MjhkMTMzMWU0NDZkNGJmMjc0ZDQ0YTU","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-06-14T00:53:09Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-14T00:53:09Z"},"message":"[codex] Dedupe plugin MCPs by app declaration name (#27607)\n\n## Context\n\nThis is the next step in the plugin auth-routing stack. The earlier PRs\nmake `PluginsManager` auth-aware and move the broad App/MCP surface\ndecision into that layer. This PR narrows the ChatGPT/SIWC behavior so\nwe only hide a plugin MCP server when it conflicts with an App\ndeclaration of the same name.\n\nIn product terms: if a plugin exposes both an App route and MCP route\nfor `foo`, ChatGPT/SIWC sessions should use the App route for `foo`. If\nthe same plugin also exposes a separate MCP server like `foo2`, that MCP\nserver should remain available.\n\n```json\n// .app.json\n{\n  \"apps\": {\n    \"foo\": {\n      \"id\": \"connector_abc\"\n    }\n  }\n}\n```\n\n```json\n// .mcp.json\n{\n  \"mcpServers\": {\n    \"foo\": {\n      \"url\": \"https://mcp.foo.com/mcp\"\n    },\n    \"foo2\": {\n      \"url\": \"https://mcp.foo2.com/mcp\"\n    }\n  }\n}\n```\n\n## Stack\n\n- PR1: #27652 seed plugin manager auth at construction.\n- PR2: #27459 route plugin surfaces by auth mode.\n- PR3: #27607 dedupe plugin MCP servers by App declaration name.\n- PR4: #27602 preserve plugin Apps in connector listings.\n- PR5: #27461 skip install-time plugin MCP OAuth for matching App\nroutes.\n\n## Summary\n\n- Preserve App declaration names in loaded plugin metadata.\n- Keep public effective App outputs as deduped connector IDs for\nexisting callers.\n- For ChatGPT/SIWC, suppress only plugin MCP servers whose names match\ndeclared App names.\n\n## Validation\n\n```bash\ncargo fmt --all\ncargo test -p codex-core-plugins plugin_auth_projection\ncargo test -p codex-core-plugins effective_apps\ncargo test -p codex-core-plugins read_plugin_for_config_installed_git_source_reads_from_cache_without_cloning\ncargo test -p codex-core explicit_plugin_mentions_use_apps_for_chatgpt_dual_surface_plugins\ncargo test -p codex-core explicit_plugin_mentions_keep_non_conflicting_mcp_for_chatgpt_auth\ncargo test -p codex-app-server --test all plugin_install_filters_disallowed_apps_needing_auth\ngit diff --check\n```\n\n---------\n\nCo-authored-by: Xin Lin <xl@openai.com>","tree":{"sha":"fc5ba45ef66fa8ec2c058cc659a3b83faef7f51a","url":"https://api.github.com/repos/openai/codex/git/trees/fc5ba45ef66fa8ec2c058cc659a3b83faef7f51a"},"url":"https://api.github.com/repos/openai/codex/git/commits/51316ead4a434e97928d1331e446d4bf274d44a5","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLft1CRC1aQ7uu5UhlAAApO4QABjdBIH8eojXfU2vRK+WBpQv\nts+w+/Rt51amPJygmHHl0hmdPl6bPbae0qAmncFMPbDlPUcWpm2VprsqaiPG6+MS\njyBOu3XzY+YhzQGjOc5dwV4jNvKyYvpXfv110erVigWxCCAb2akULygmluUUyl5A\nQO+eA533kOH9w80q4weXQwQPiSRIJYby7RN5VauOIVwXSd3mAvWGojUTU2tbF4OX\nRA8VT9M1hI3hPqI0iaxv3x3ENke8R3Mt04xhB1B6rcQzndBqHwMvxLyYz+QZVNnK\nzzVkN+vbZjI8guQvu48bTDQJr8oPdm2/m9Kfv7w4pJfpuxqeBPqP0SkcSi1QdN5h\n5GTHRK/lH7jwxoFaHyqUUt8yJKblEBjQV4HMlAR2oqPY9cNhU6zvmIACRwgg7lRr\nEu+8bYnL4mi54t/qYo+2ojoLDlKJAKwbocvV2tF/aqmiIeoAu73owjVeW6fd1drK\n3LEN5iFGNQh185XcAnoxXSW+SHD0m02NfqGUsY3rshRD/w4jDGMyFJMqOpvburpx\n1fKc7sDTKR7jVYo55Po7YK5HDuXWhOhGdoYa0bToJ4LyPvxk/r2sj/A9FKpyvy5/\noAuOozkJQX2BSZuoAhxGNo/hxcRqbLqrjLZMRLPPJbEClSNIx36hHkvDcywc/GKr\nKLFcExzG5xvahBWqiO8r\n=KopQ\n-----END PGP SIGNATURE-----\n","payload":"tree fc5ba45ef66fa8ec2c058cc659a3b83faef7f51a\nparent 0fed4497f50ad5f0b2f7972a1bfd14c5a09a85c5\nauthor felixxia-oai <felixxia@openai.com> 1781398389 +0100\ncommitter GitHub <noreply@github.com> 1781398389 -0700\n\n[codex] Dedupe plugin MCPs by app declaration name (#27607)\n\n## Context\n\nThis is the next step in the plugin auth-routing stack. The earlier PRs\nmake `PluginsManager` auth-aware and move the broad App/MCP surface\ndecision into that layer. This PR narrows the ChatGPT/SIWC behavior so\nwe only hide a plugin MCP server when it conflicts with an App\ndeclaration of the same name.\n\nIn product terms: if a plugin exposes both an App route and MCP route\nfor `foo`, ChatGPT/SIWC sessions should use the App route for `foo`. If\nthe same plugin also exposes a separate MCP server like `foo2`, that MCP\nserver should remain available.\n\n```json\n// .app.json\n{\n  \"apps\": {\n    \"foo\": {\n      \"id\": \"connector_abc\"\n    }\n  }\n}\n```\n\n```json\n// .mcp.json\n{\n  \"mcpServers\": {\n    \"foo\": {\n      \"url\": \"https://mcp.foo.com/mcp\"\n    },\n    \"foo2\": {\n      \"url\": \"https://mcp.foo2.com/mcp\"\n    }\n  }\n}\n```\n\n## Stack\n\n- PR1: #27652 seed plugin manager auth at construction.\n- PR2: #27459 route plugin surfaces by auth mode.\n- PR3: #27607 dedupe plugin MCP servers by App declaration name.\n- PR4: #27602 preserve plugin Apps in connector listings.\n- PR5: #27461 skip install-time plugin MCP OAuth for matching App\nroutes.\n\n## Summary\n\n- Preserve App declaration names in loaded plugin metadata.\n- Keep public effective App outputs as deduped connector IDs for\nexisting callers.\n- For ChatGPT/SIWC, suppress only plugin MCP servers whose names match\ndeclared App names.\n\n## Validation\n\n```bash\ncargo fmt --all\ncargo test -p codex-core-plugins plugin_auth_projection\ncargo test -p codex-core-plugins effective_apps\ncargo test -p codex-core-plugins read_plugin_for_config_installed_git_source_reads_from_cache_without_cloning\ncargo test -p codex-core explicit_plugin_mentions_use_apps_for_chatgpt_dual_surface_plugins\ncargo test -p codex-core explicit_plugin_mentions_keep_non_conflicting_mcp_for_chatgpt_auth\ncargo test -p codex-app-server --test all plugin_install_filters_disallowed_apps_needing_auth\ngit diff --check\n```\n\n---------\n\nCo-authored-by: Xin Lin <xl@openai.com>","verified_at":"2026-06-14T00:53:09Z"}},"url":"https://api.github.com/repos/openai/codex/commits/51316ead4a434e97928d1331e446d4bf274d44a5","html_url":"https://github.com/openai/codex/commit/51316ead4a434e97928d1331e446d4bf274d44a5","comments_url":"https://api.github.com/repos/openai/codex/commits/51316ead4a434e97928d1331e446d4bf274d44a5/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"0fed4497f50ad5f0b2f7972a1bfd14c5a09a85c5","url":"https://api.github.com/repos/openai/codex/commits/0fed4497f50ad5f0b2f7972a1bfd14c5a09a85c5","html_url":"https://github.com/openai/codex/commit/0fed4497f50ad5f0b2f7972a1bfd14c5a09a85c5"}]},{"sha":"0fed4497f50ad5f0b2f7972a1bfd14c5a09a85c5","node_id":"C_kwDOOYsS4doAKDBmZWQ0NDk3ZjUwYWQ1ZjBiMmY3OTcyYTFiZmQxNGM1YTA5YTg1YzU","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-13T20:56:42Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-13T20:56:42Z"},"message":"[codex] Carry exec-server cwd as PathUri (#28032)\n\n## Why\n\nThis is the second-to-last place in the exec-server protocol that needs\nto migrate to URIs to support cross-OS operation.\n\n## What\n\n- Change `ExecParams.cwd` to `PathUri`.\n- Keep the cwd URI-shaped through core and rmcp producers, converting it\nto `AbsolutePathBuf` only in `LocalProcess::start_process`.\n- Reject non-native cwd URIs before launch and update the affected\nprotocol documentation and call sites.","tree":{"sha":"6d4a8c3319b37af90124cf296f35ff4fe51aa99b","url":"https://api.github.com/repos/openai/codex/git/trees/6d4a8c3319b37af90124cf296f35ff4fe51aa99b"},"url":"https://api.github.com/repos/openai/codex/git/commits/0fed4497f50ad5f0b2f7972a1bfd14c5a09a85c5","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLcQKCRC1aQ7uu5UhlAAAPEwQAI9so/l7Lh5jDzHtgh8Iq07p\nLCDzG2NBn40qxuvn/klF5yiy1W9/WHs0AJR6r+mZ1E2Hatm6oB+ssJIwqkqDGg7s\nnms4OtEXdX9zb6Fb/AFuAGU2/OwFwvEdVeifotBpRJH7HbZJKZl2tpkGg4Fr2iQj\nCZ2YhowlkSZm1Xn2QKKKM+c+xOuuOoKiW7yTn33QqH2MbL7qcvKj0L2trRmi2QAL\nLdm16HjXnRGEQD1a2W+4RJhoV0KckA4x6imDqGvk7l79TvTuMDP0aMnx65pVlUCp\nY2g708z+6sX0YgV88r2qVwcHx+pr3DtCYPsXxdqUniE7GBAsOgaVD3HyGRZGC0VC\nirvohaVDrGjcwEH3a1RkC19duXorbpPdRSURznZl2XKPCJLUWo3uP3Q1wEbRk5Cy\nNJlu/EfWA6OMZyFWUZ5yD3ye8p9gug1aYC5rDYBWvZrSamytqe7aP6UnG0dWuDFw\n1f8RP3oCGZb3+Rw9C5Ke7WbYnE68OlshPu9FdL6s7cY2SXBHXlLZBiKvWODnEXbB\nrT6k/ZTv5tidwKdTE6F7aqqfn+Qo+VE8qryCENgYJhIz88pxwcYaxGEAAS13s0LZ\nepHpURczGM9gdr2o9TPfB7m8Gke6IgUude/04lvdHx6LQfrw2w44kocXMaYx06J2\n2LuaN54qaUjt0K2o/GWH\n=+O5g\n-----END PGP SIGNATURE-----\n","payload":"tree 6d4a8c3319b37af90124cf296f35ff4fe51aa99b\nparent 17586d80ee6e3096f205cb36cc2968ba1a9adc8d\nauthor Adam Perry @ OpenAI <anp@openai.com> 1781384202 -0700\ncommitter GitHub <noreply@github.com> 1781384202 +0000\n\n[codex] Carry exec-server cwd as PathUri (#28032)\n\n## Why\n\nThis is the second-to-last place in the exec-server protocol that needs\nto migrate to URIs to support cross-OS operation.\n\n## What\n\n- Change `ExecParams.cwd` to `PathUri`.\n- Keep the cwd URI-shaped through core and rmcp producers, converting it\nto `AbsolutePathBuf` only in `LocalProcess::start_process`.\n- Reject non-native cwd URIs before launch and update the affected\nprotocol documentation and call sites.","verified_at":"2026-06-13T20:56:42Z"}},"url":"https://api.github.com/repos/openai/codex/commits/0fed4497f50ad5f0b2f7972a1bfd14c5a09a85c5","html_url":"https://github.com/openai/codex/commit/0fed4497f50ad5f0b2f7972a1bfd14c5a09a85c5","comments_url":"https://api.github.com/repos/openai/codex/commits/0fed4497f50ad5f0b2f7972a1bfd14c5a09a85c5/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"17586d80ee6e3096f205cb36cc2968ba1a9adc8d","url":"https://api.github.com/repos/openai/codex/commits/17586d80ee6e3096f205cb36cc2968ba1a9adc8d","html_url":"https://github.com/openai/codex/commit/17586d80ee6e3096f205cb36cc2968ba1a9adc8d"}]},{"sha":"17586d80ee6e3096f205cb36cc2968ba1a9adc8d","node_id":"C_kwDOOYsS4doAKDE3NTg2ZDgwZWU2ZTMwOTZmMjA1Y2IzNmNjMjk2OGJhMWE5YWRjOGQ","commit":{"author":{"name":"Tamir Duberstein","email":"tamird@openai.com","date":"2026-06-13T19:55:53Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-13T19:55:53Z"},"message":"[codex] package Windows ARM64 on x64 (#28001)\n\nThe first release after parallelizing Windows packaging moved the\ncritical path to the ARM64 packaging job:\n\nhttps://github.com/openai/codex/actions/runs/27451157324\n\nThe x64 job started immediately and finished in 5m29s. The ARM64\njob waited 76s for its runner and then took 5m56s, holding the\nrelease for 1m43s after x64 had finished.\n\nPackaging only downloads, signs, archives, and compresses already\nbuilt binaries. It does not execute target code. Run both packaging\njobs on x64 runners, keeping ARM64 hardware for compilation.","tree":{"sha":"f6297ff246e336ba3c0e77ffc40a1da43d13f5d7","url":"https://api.github.com/repos/openai/codex/git/trees/f6297ff246e336ba3c0e77ffc40a1da43d13f5d7"},"url":"https://api.github.com/repos/openai/codex/git/commits/17586d80ee6e3096f205cb36cc2968ba1a9adc8d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLbXJCRC1aQ7uu5UhlAAAp4YQAFOFPTgVzMRZDdeWinb7tnRx\nL4kA4+5QFORX6PQTZTpPzSdhpkc8P/lo/4YbfNihE9ZPOcAcXapWKbVxUC96ROfm\nTYrFLrTIy33wv414r0Yq1RoPnUDMKq3AlApoFKpIVA140aExZ7uFnC31UBS85d8g\n0IcHuyTIkAqtFRDXkS5X0jezTzt9kuH0pdclUFkDbyKqmNxIVMj4vDMo3Um4al8G\nXGt0RKIPZFoRoF5k1CbPMyPPDQLd4qSxri3GlH1O1rR1osalkf34ttKkSHehriYk\nOjf3vY2dGI/4FXPUejcW3M0GpTLxElqNKOrzphNOtM8r5mP+VWn19uXxkzaqTigL\n8GPIMu5BpgCnU25elpNmjad3mBReUJ0xzahhOrhyKVVHibdcDBJnio6cPSIdGY/m\nVAKIcxDiUfTvCB3qdgDmOyAXBcp+ahIgVnvhs6osHSnVkEp/7L2CieCAWmhbRB03\nDdUdVXTxjYK/eSwlCKPsQarFOuq6QmHomO4pKsA4VEGmWfz4zmOJwN35ghoPmsP6\nSvg5NUEcZqx/R+4kUa0j0ne6rWLbAXmmHLq9gqrcymtZGnrVXdRMji5zkK4T+Iuk\nQrfguu65jYAeF+KWKsTMQBAkRcXWvZz7LNidI1qTndDhhjuF4aTXyBt2ozSHOSTq\niTMf7uOlOYlbGnm+6Xoq\n=17kz\n-----END PGP SIGNATURE-----\n","payload":"tree f6297ff246e336ba3c0e77ffc40a1da43d13f5d7\nparent f297b9f07de10c7d8b9ed284b674d06cc5ff7723\nauthor Tamir Duberstein <tamird@openai.com> 1781380553 -0400\ncommitter GitHub <noreply@github.com> 1781380553 -0700\n\n[codex] package Windows ARM64 on x64 (#28001)\n\nThe first release after parallelizing Windows packaging moved the\ncritical path to the ARM64 packaging job:\n\nhttps://github.com/openai/codex/actions/runs/27451157324\n\nThe x64 job started immediately and finished in 5m29s. The ARM64\njob waited 76s for its runner and then took 5m56s, holding the\nrelease for 1m43s after x64 had finished.\n\nPackaging only downloads, signs, archives, and compresses already\nbuilt binaries. It does not execute target code. Run both packaging\njobs on x64 runners, keeping ARM64 hardware for compilation.","verified_at":"2026-06-13T19:55:54Z"}},"url":"https://api.github.com/repos/openai/codex/commits/17586d80ee6e3096f205cb36cc2968ba1a9adc8d","html_url":"https://github.com/openai/codex/commit/17586d80ee6e3096f205cb36cc2968ba1a9adc8d","comments_url":"https://api.github.com/repos/openai/codex/commits/17586d80ee6e3096f205cb36cc2968ba1a9adc8d/comments","author":{"login":"tamird","id":1535036,"node_id":"MDQ6VXNlcjE1MzUwMzY=","avatar_url":"https://avatars.githubusercontent.com/u/1535036?v=4","gravatar_id":"","url":"https://api.github.com/users/tamird","html_url":"https://github.com/tamird","followers_url":"https://api.github.com/users/tamird/followers","following_url":"https://api.github.com/users/tamird/following{/other_user}","gists_url":"https://api.github.com/users/tamird/gists{/gist_id}","starred_url":"https://api.github.com/users/tamird/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tamird/subscriptions","organizations_url":"https://api.github.com/users/tamird/orgs","repos_url":"https://api.github.com/users/tamird/repos","events_url":"https://api.github.com/users/tamird/events{/privacy}","received_events_url":"https://api.github.com/users/tamird/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f297b9f07de10c7d8b9ed284b674d06cc5ff7723","url":"https://api.github.com/repos/openai/codex/commits/f297b9f07de10c7d8b9ed284b674d06cc5ff7723","html_url":"https://github.com/openai/codex/commit/f297b9f07de10c7d8b9ed284b674d06cc5ff7723"}]},{"sha":"f297b9f07de10c7d8b9ed284b674d06cc5ff7723","node_id":"C_kwDOOYsS4doAKGYyOTdiOWYwN2RlMTBjN2Q4YjllZDI4NGI2NzRkMDZjYzVmZjc3MjM","commit":{"author":{"name":"Ahmed Ibrahim","email":"aibrahim@openai.com","date":"2026-06-13T08:27:58Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-13T08:27:58Z"},"message":"[codex] Send turn state through compact requests (#28002)\n\n## Context\n\nInline compaction is part of the active logical turn. Compact requests\nand the sampling requests around them should use the same turn state,\nincluding when compaction is the first request to establish it.\n\n## Change\n\nPass the turn-scoped `OnceLock` directly to inline v1 compaction so\n`/responses/compact` includes an established value in the existing HTTP\nheader. Capture `x-codex-turn-state` from the compact response into that\nsame lock, allowing pre-turn compact to establish the value that\nsubsequent sampling reuses.\n\nV2 compact already uses the normal Responses HTTP/WebSocket path and\ncontinues to share the same `OnceLock` without separate plumbing. The\nfirst returned value wins for the logical turn.\n\n## Test plan\n\nIntegration coverage verifies that:\n\n- pre-turn v1 compact can establish state for the first sampling request\n- inline v1 compact receives established state over HTTP\n- inline v2 compact reuses established state over HTTP\n- inline v2 compact reuses established state over WebSocket\n\nCI validates the full change.","tree":{"sha":"1a74cade4a188974a1a8902846536ad0547087d7","url":"https://api.github.com/repos/openai/codex/git/trees/1a74cade4a188974a1a8902846536ad0547087d7"},"url":"https://api.github.com/repos/openai/codex/git/commits/f297b9f07de10c7d8b9ed284b674d06cc5ff7723","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLRSOCRC1aQ7uu5UhlAAAq5IQAJQwWjnt7QqAj/hYFkj2zl2w\n5aNF/yA0+dkHTfIXYiQiDZPHdF+KEexDl+coFXHKaUo+nDUaPFZhhxPH2D21lbz0\nz9c4tRB/f0m6Oss6l22V86lBMx5gDe/VoCep5EmM0/BA8G40JSgV0KT0IkcdcaM+\nD5AMHRJ+O1Cir8oy7bvtnkmPaJguybkG9C6QDAdyjFLUZHzNEJOvsf85NtPmCuYZ\n1IDDQ0puiBNTHs8LAO+pKZ6eQ/Y6ltLbRv0tPOmXRL9U6drSECPOuKxrwEqqb9KG\n1zChADAlTn7NGkhnJYjIjvYtqK/WRWm1l+CA/DwytE3kyCaVVUCXT9mBVgourGyd\ngjjNy99duAFi/y0YfcIuSRKiIXJjnoDhF/Ri6igGMhDRvvn1ObfsfQUSlN4qTt2W\n6Meo053Ftz+vlEHssNFxkFr491eTskItP1DsMGQspn82DqqGOvXSM2oRLvje+hGo\nfS4V860S1NNnyoJvTyLf20MnxRh47gcaLphBXaiACosJeUk21CBxgJT+bSZtaayZ\nwMbEJHH4s9waSO1paZDurqUPDrse7qe8LHVDVi70fpSJc9hUU62ytEU1OoTrMvoe\nCmbZaKK+ZvoKKmvmB+hYekSD57X+s1hxa+KwOYEIn9yuh3lyfnG6t+l8riAIE2sG\nwcXB89VGLp0hx3JZCmtm\n=iV1v\n-----END PGP SIGNATURE-----\n","payload":"tree 1a74cade4a188974a1a8902846536ad0547087d7\nparent 640d61b121e886682a03374fdf668e8b9b97ecf2\nauthor Ahmed Ibrahim <aibrahim@openai.com> 1781339278 -0700\ncommitter GitHub <noreply@github.com> 1781339278 -0700\n\n[codex] Send turn state through compact requests (#28002)\n\n## Context\n\nInline compaction is part of the active logical turn. Compact requests\nand the sampling requests around them should use the same turn state,\nincluding when compaction is the first request to establish it.\n\n## Change\n\nPass the turn-scoped `OnceLock` directly to inline v1 compaction so\n`/responses/compact` includes an established value in the existing HTTP\nheader. Capture `x-codex-turn-state` from the compact response into that\nsame lock, allowing pre-turn compact to establish the value that\nsubsequent sampling reuses.\n\nV2 compact already uses the normal Responses HTTP/WebSocket path and\ncontinues to share the same `OnceLock` without separate plumbing. The\nfirst returned value wins for the logical turn.\n\n## Test plan\n\nIntegration coverage verifies that:\n\n- pre-turn v1 compact can establish state for the first sampling request\n- inline v1 compact receives established state over HTTP\n- inline v2 compact reuses established state over HTTP\n- inline v2 compact reuses established state over WebSocket\n\nCI validates the full change.","verified_at":"2026-06-13T08:27:58Z"}},"url":"https://api.github.com/repos/openai/codex/commits/f297b9f07de10c7d8b9ed284b674d06cc5ff7723","html_url":"https://github.com/openai/codex/commit/f297b9f07de10c7d8b9ed284b674d06cc5ff7723","comments_url":"https://api.github.com/repos/openai/codex/commits/f297b9f07de10c7d8b9ed284b674d06cc5ff7723/comments","author":{"login":"aibrahim-oai","id":219906144,"node_id":"U_kgDODRuAYA","avatar_url":"https://avatars.githubusercontent.com/u/219906144?v=4","gravatar_id":"","url":"https://api.github.com/users/aibrahim-oai","html_url":"https://github.com/aibrahim-oai","followers_url":"https://api.github.com/users/aibrahim-oai/followers","following_url":"https://api.github.com/users/aibrahim-oai/following{/other_user}","gists_url":"https://api.github.com/users/aibrahim-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/aibrahim-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aibrahim-oai/subscriptions","organizations_url":"https://api.github.com/users/aibrahim-oai/orgs","repos_url":"https://api.github.com/users/aibrahim-oai/repos","events_url":"https://api.github.com/users/aibrahim-oai/events{/privacy}","received_events_url":"https://api.github.com/users/aibrahim-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"640d61b121e886682a03374fdf668e8b9b97ecf2","url":"https://api.github.com/repos/openai/codex/commits/640d61b121e886682a03374fdf668e8b9b97ecf2","html_url":"https://github.com/openai/codex/commit/640d61b121e886682a03374fdf668e8b9b97ecf2"}]},{"sha":"640d61b121e886682a03374fdf668e8b9b97ecf2","node_id":"C_kwDOOYsS4doAKDY0MGQ2MWIxMjFlODg2NjgyYTAzMzc0ZmRmNjY4ZThiOWI5N2VjZjI","commit":{"author":{"name":"Ahmed Ibrahim","email":"aibrahim@openai.com","date":"2026-06-13T07:44:39Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-13T07:44:39Z"},"message":"[codex] Send request-scoped turn state over WebSocket (#27996)\n\n## Context\n\nTurn state is scoped to one logical turn, but the WebSocket path\ncurrently exchanges it through upgrade headers, which are scoped to the\nphysical connection. A connection may be reused across turns, so its\nhandshake cannot represent the turn lifecycle reliably.\n\n## Change\n\nExchange turn state on each WebSocket response request instead:\n\n- send an established value in `response.create.client_metadata`\n- read the returned value from the existing `response.metadata` event\n- retain the first value in the turn-scoped `ModelClientSession`\n`OnceLock`\n- start the next logical turn without state, even when it reuses the\nsame WebSocket connection\n\nThis gives WebSocket requests the same first-value-wins contract as the\nexisting HTTP path.\n\n## Test plan\n\nIntegration coverage verifies that:\n\n- WebSocket replays returned state on same-turn follow-ups\n- later response metadata does not replace the first value\n- state resets at the logical turn boundary without requiring a\nreconnect\n\nCI validates the full change.\n\n## Stack\n\nThis is 1/2. #28002 builds on this request-scoped transport to carry\nestablished state through compact requests.","tree":{"sha":"7d6f700d33f243e0c73f28e2f33212e0239d1379","url":"https://api.github.com/repos/openai/codex/git/trees/7d6f700d33f243e0c73f28e2f33212e0239d1379"},"url":"https://api.github.com/repos/openai/codex/git/commits/640d61b121e886682a03374fdf668e8b9b97ecf2","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLQpnCRC1aQ7uu5UhlAAAUpsQAGID/4qEHtn9fHyI6RXQ5Ib7\nfzHIWTdu6mE8Px743eiRh60GFUXPtza4TzvUMwkjMST53tROwtZkQuos6k4TAZJT\nUy8AFUCLLeCRP/iFHp1yk+kfpMUaF3EGzjxZzbsATNA/n3yJFAvnHbmrtEZgdrSn\ntrmExCZ+PYpb52Cvk7agCnijuyF+uodnSj6fNso7FrcCzPyxnqw/tkzcWTv3SPII\n2CQNFE8u4vD4XDU7C8z2pOhxR9HAw888v19kkEEjoBQI5yHHb3d0A331JRyL7Qc+\nxerbfzD0vihYj9iYN8cIlCCW8PSzjau5Rb73L2nzgAiHVf+mruTA2rbT4yUIKNV9\nsOLO+vXR5CsMLYDvrTDsPnFEWYiei8Jge2hmTeRhfCx0o0a8NBkVUo0KU6mb5VzP\nMZ/wRKBVlDC+EbgN+4EbjsBYFjs/xa8kECoGYimIyhPCiFCROGoO6idfzDndlwPZ\n5mdU5p4IXJ8EF7bZu5mRaLnmzygp/lpXdZ0kur/H1yQ7O9rJwe5TETOEnO2UtK+I\nUGvHD9Hn4V3P2Ui6A4USOlSXNOg6EQ/AHkT42pKuXN30SGG5JWu43P46nc131xBs\np2LifAoi66xep2qLkCsD8DndEkhwe1yb8QJLHCjE4XzTeTOYsM8TbBz9MOcL12t5\nUlp7B8VOiTYJ/EpRFQSv\n=kews\n-----END PGP SIGNATURE-----\n","payload":"tree 7d6f700d33f243e0c73f28e2f33212e0239d1379\nparent 9d938a46d9119c3aaa4aac056950951027adec34\nauthor Ahmed Ibrahim <aibrahim@openai.com> 1781336679 -0700\ncommitter GitHub <noreply@github.com> 1781336679 -0700\n\n[codex] Send request-scoped turn state over WebSocket (#27996)\n\n## Context\n\nTurn state is scoped to one logical turn, but the WebSocket path\ncurrently exchanges it through upgrade headers, which are scoped to the\nphysical connection. A connection may be reused across turns, so its\nhandshake cannot represent the turn lifecycle reliably.\n\n## Change\n\nExchange turn state on each WebSocket response request instead:\n\n- send an established value in `response.create.client_metadata`\n- read the returned value from the existing `response.metadata` event\n- retain the first value in the turn-scoped `ModelClientSession`\n`OnceLock`\n- start the next logical turn without state, even when it reuses the\nsame WebSocket connection\n\nThis gives WebSocket requests the same first-value-wins contract as the\nexisting HTTP path.\n\n## Test plan\n\nIntegration coverage verifies that:\n\n- WebSocket replays returned state on same-turn follow-ups\n- later response metadata does not replace the first value\n- state resets at the logical turn boundary without requiring a\nreconnect\n\nCI validates the full change.\n\n## Stack\n\nThis is 1/2. #28002 builds on this request-scoped transport to carry\nestablished state through compact requests.","verified_at":"2026-06-13T07:44:39Z"}},"url":"https://api.github.com/repos/openai/codex/commits/640d61b121e886682a03374fdf668e8b9b97ecf2","html_url":"https://github.com/openai/codex/commit/640d61b121e886682a03374fdf668e8b9b97ecf2","comments_url":"https://api.github.com/repos/openai/codex/commits/640d61b121e886682a03374fdf668e8b9b97ecf2/comments","author":{"login":"aibrahim-oai","id":219906144,"node_id":"U_kgDODRuAYA","avatar_url":"https://avatars.githubusercontent.com/u/219906144?v=4","gravatar_id":"","url":"https://api.github.com/users/aibrahim-oai","html_url":"https://github.com/aibrahim-oai","followers_url":"https://api.github.com/users/aibrahim-oai/followers","following_url":"https://api.github.com/users/aibrahim-oai/following{/other_user}","gists_url":"https://api.github.com/users/aibrahim-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/aibrahim-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aibrahim-oai/subscriptions","organizations_url":"https://api.github.com/users/aibrahim-oai/orgs","repos_url":"https://api.github.com/users/aibrahim-oai/repos","events_url":"https://api.github.com/users/aibrahim-oai/events{/privacy}","received_events_url":"https://api.github.com/users/aibrahim-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"9d938a46d9119c3aaa4aac056950951027adec34","url":"https://api.github.com/repos/openai/codex/commits/9d938a46d9119c3aaa4aac056950951027adec34","html_url":"https://github.com/openai/codex/commit/9d938a46d9119c3aaa4aac056950951027adec34"}]},{"sha":"9d938a46d9119c3aaa4aac056950951027adec34","node_id":"C_kwDOOYsS4doAKDlkOTM4YTQ2ZDkxMTljM2FhYTRhYWMwNTY5NTA5NTEwMjdhZGVjMzQ","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-13T03:20:23Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-13T03:20:23Z"},"message":"[codex] Add hermetic Wine exec-server test (#27937)\n\n## Why\n\nWe want to make it possible for an app-server orchestrator on one OS to\ncontrol an exec-server on another host running a different OS. In\npractice this kinda already works if you get lucky and the two hosts\nhave the same path format, but we mangle quite a lot of operations if\neither end is Windows.\n\nThis test starts exercising that interaction, although right now the\ninitial bootstrap fails. Future changes will expand the test's\nassertions to match improved support.\n\n## What\n\nStacked on #27964. This adds a small Windows exec-server fixture and a\nLinux protocol smoke test using the reusable Wine harness, covering\nWindows environment discovery, non-TTY `cmd.exe` execution, output, exit\nstatus, and working directory.\n\nOnce we've got the full codex binary cross-building under Bazel we could\nconsider moving to the real binary instead of the stripped down\nexec-server-only binary used here.","tree":{"sha":"5c144a23a7f1e5ad353ce088c79a0be9efba6d62","url":"https://api.github.com/repos/openai/codex/git/trees/5c144a23a7f1e5ad353ce088c79a0be9efba6d62"},"url":"https://api.github.com/repos/openai/codex/git/commits/9d938a46d9119c3aaa4aac056950951027adec34","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLMx3CRC1aQ7uu5UhlAAApu8QAEiatSGrT7SsHreXkHO9Aqg7\nbM8fL+ZEnbWxLUwEIMHveBI879ZM5At63a4MITSWmpZiOIJHXDKfzKQ/CnH2WvtB\nM6vPZXJEP1zLGb/cEFv3XqP2ZE/4C1KnQlRcBcplzQKrIgtKFImF6ZeOmnlp14Wh\nhhD/OadjILSuDQCsBNnAro9EYant55g+Ss+5+5ysM6NPTLhF8VQgvQ5Lvmhv8Phf\nrWZ4ttw9dCp0IQ7ya6OykoAG73j7LBkpu8807VayBQqeStUr5jsseXT1R5oJMnhm\ny00I25Hd/5ZYIxgEy89iH6kBjAcs226HSmM95UHhlQxvETAQiZ6NmfiZPCZepsml\npJhNajqBELqXH7SFp5h7WHWxAmK24CDa8Oj0IPSEBfCA0af0PL7I+kk/vsi6FPIy\n70a+7T9MBOU4EeBlrd+P3nyKjPCDPntCbZhIvWtMGwchbVgnE73F9/Nbq/h/KumT\nssKCqUB4r0+goLcjoZ7v5U5AeXqMiRjAkV4DrS7k/T6/j413mkCwYB7NtqZkGJC2\ngeazbOtxKFlxaG/wm0fQiiFDFQhHhyLfRMLz4fz6WvAFKRBtECtIonE/Cwo9GDDX\n0hk5Q6Mbve4HguZ3XNM3j4QbSsrHZZSjjYOgkWWoZvRDraDmxkNiq0lL5JNK2cKi\nxGCoW/7ljdjtbZ8qKftn\n=GfH6\n-----END PGP SIGNATURE-----\n","payload":"tree 5c144a23a7f1e5ad353ce088c79a0be9efba6d62\nparent b9dc3b7a8ba24fe2a6ffa33890f35ca1d3e8ecf2\nauthor Adam Perry @ OpenAI <anp@openai.com> 1781320823 -0700\ncommitter GitHub <noreply@github.com> 1781320823 -0700\n\n[codex] Add hermetic Wine exec-server test (#27937)\n\n## Why\n\nWe want to make it possible for an app-server orchestrator on one OS to\ncontrol an exec-server on another host running a different OS. In\npractice this kinda already works if you get lucky and the two hosts\nhave the same path format, but we mangle quite a lot of operations if\neither end is Windows.\n\nThis test starts exercising that interaction, although right now the\ninitial bootstrap fails. Future changes will expand the test's\nassertions to match improved support.\n\n## What\n\nStacked on #27964. This adds a small Windows exec-server fixture and a\nLinux protocol smoke test using the reusable Wine harness, covering\nWindows environment discovery, non-TTY `cmd.exe` execution, output, exit\nstatus, and working directory.\n\nOnce we've got the full codex binary cross-building under Bazel we could\nconsider moving to the real binary instead of the stripped down\nexec-server-only binary used here.","verified_at":"2026-06-13T03:20:23Z"}},"url":"https://api.github.com/repos/openai/codex/commits/9d938a46d9119c3aaa4aac056950951027adec34","html_url":"https://github.com/openai/codex/commit/9d938a46d9119c3aaa4aac056950951027adec34","comments_url":"https://api.github.com/repos/openai/codex/commits/9d938a46d9119c3aaa4aac056950951027adec34/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b9dc3b7a8ba24fe2a6ffa33890f35ca1d3e8ecf2","url":"https://api.github.com/repos/openai/codex/commits/b9dc3b7a8ba24fe2a6ffa33890f35ca1d3e8ecf2","html_url":"https://github.com/openai/codex/commit/b9dc3b7a8ba24fe2a6ffa33890f35ca1d3e8ecf2"}]},{"sha":"b9dc3b7a8ba24fe2a6ffa33890f35ca1d3e8ecf2","node_id":"C_kwDOOYsS4doAKGI5ZGMzYjdhOGJhMjRmZTJhNmZmYTMzODkwZjM1Y2ExZDNlOGVjZjI","commit":{"author":{"name":"Anton Panasenko","email":"apanasenko@openai.com","date":"2026-06-13T03:10:12Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-13T03:10:12Z"},"message":"feat(app-server): enforce managed remote control disable (#27961)\n\n## Why\n\nManaged deployments need a reliable deny gate for remote control.\nPersisted enablement and explicit startup requests currently remain able\nto start the transport, while the removed `features.remote_control` key\nis intentionally only a compatibility no-op.\n\nThis adds a dedicated requirement that administrators can use to force\nremote control off without deleting the user's persisted preference.\nRemoving the requirement and restarting restores the prior choice.\n\n## What Changed\n\n- Added top-level `allow_remote_control` requirements parsing, sourced\nlayer precedence, debug output, and `configRequirements/read` exposure\nas `allowRemoteControl`.\n- Added a typed transport policy captured from the startup requirements\nsnapshot. Managed disable forces the initial state to disabled and\nprevents enrollment, refresh, connection, and persisted-preference\nmutation.\n- Rejected every `remoteControl/*` RPC before parameter deserialization\nwith JSON-RPC `-32600` and `remote control is disabled by managed\nrequirements`.\n- Preserved the existing disabled status notification and the previous\nbehavior when the requirement is `true` or omitted.\n- Regenerated app-server protocol schemas and documented the new\nrequirement.\n\n## Verification\n\n- Confirmed all remote-control RPCs, including a malformed request,\nreturn the managed-policy error while the initial status notification\nremains `disabled`.\n- Confirmed explicit ephemeral startup and persisted enablement make no\nbackend connection and leave the SQLite preference unchanged.\n- Confirmed `allow_remote_control = true` does not enable or block\nremote control and `configRequirements/read` returns\n`allowRemoteControl: false` for the deny policy.\n\nRelated issue: N/A (managed-policy hardening).","tree":{"sha":"55e3bb45825af30034d9b3931eeab19372801650","url":"https://api.github.com/repos/openai/codex/git/trees/55e3bb45825af30034d9b3931eeab19372801650"},"url":"https://api.github.com/repos/openai/codex/git/commits/b9dc3b7a8ba24fe2a6ffa33890f35ca1d3e8ecf2","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLMoUCRC1aQ7uu5UhlAAAvCMQAIFS++wQssIqzQePH9y/8H0P\nck45+yFmsibfnOFtfavhmIwJnxmOFqnH6e33LBzMpKLaq9vLD7KMssmEwW9f2Khj\n5cegKk+AKE5ZE18sKkSOBjHkiMX/8u6uzyYf9I/8wJxfHuIp95Bb36+SgijM23hn\nKLxAuYo9/MbRm9VaKGXzjqp1cUy4v/VHSp1XcUtyvR7NhG2f2hK/qB8muq/V8AAr\nWAjWfPu/ugFQyNLTTRBfOVh3NQjktgQrg64NBfePu40ChMkmKoQOjZIqlPxlBQDU\nSjJirjfi1D6H0rrQypigtm1alFnkd6GfTfLb8zKpt2nDFUnS5dzZ/yiI9kdPBTgb\n/RpBih4dGYrgL27QTI7X/bGmHphxLT6GOoMNBO7dHfyB5CULIqnDkLzMaiYbb1bq\nsZyrzbKSJ2kfntbDCUVXSGpyb6i0LpsL5WrVgE8Q5sElk3V5ANa1EbjGoz0icOAw\nfpgdcPJB41OeeEun2z6RPvL/tmGB162dkM0Tx9AJXNDir1w1Ana+i8vTlv1zH0Ks\n/2+mI8yHnH41OCJFR3sZKOYYmeFIT6nMZgeUDmefoDoKS17RVDerd5QeF8AvQD3h\nJMROl/3x2+W30YQeVJw+ts90L3vXo4qXGMlMQMwty3xqlSvSwW6z3T/7u+GjRnUm\n4/m61xHEavxnJNVFUnTp\n=j4V1\n-----END PGP SIGNATURE-----\n","payload":"tree 55e3bb45825af30034d9b3931eeab19372801650\nparent 5d7db08b61555784ce8b08e1a5a308432e9c06a5\nauthor Anton Panasenko <apanasenko@openai.com> 1781320212 -0700\ncommitter GitHub <noreply@github.com> 1781320212 -0700\n\nfeat(app-server): enforce managed remote control disable (#27961)\n\n## Why\n\nManaged deployments need a reliable deny gate for remote control.\nPersisted enablement and explicit startup requests currently remain able\nto start the transport, while the removed `features.remote_control` key\nis intentionally only a compatibility no-op.\n\nThis adds a dedicated requirement that administrators can use to force\nremote control off without deleting the user's persisted preference.\nRemoving the requirement and restarting restores the prior choice.\n\n## What Changed\n\n- Added top-level `allow_remote_control` requirements parsing, sourced\nlayer precedence, debug output, and `configRequirements/read` exposure\nas `allowRemoteControl`.\n- Added a typed transport policy captured from the startup requirements\nsnapshot. Managed disable forces the initial state to disabled and\nprevents enrollment, refresh, connection, and persisted-preference\nmutation.\n- Rejected every `remoteControl/*` RPC before parameter deserialization\nwith JSON-RPC `-32600` and `remote control is disabled by managed\nrequirements`.\n- Preserved the existing disabled status notification and the previous\nbehavior when the requirement is `true` or omitted.\n- Regenerated app-server protocol schemas and documented the new\nrequirement.\n\n## Verification\n\n- Confirmed all remote-control RPCs, including a malformed request,\nreturn the managed-policy error while the initial status notification\nremains `disabled`.\n- Confirmed explicit ephemeral startup and persisted enablement make no\nbackend connection and leave the SQLite preference unchanged.\n- Confirmed `allow_remote_control = true` does not enable or block\nremote control and `configRequirements/read` returns\n`allowRemoteControl: false` for the deny policy.\n\nRelated issue: N/A (managed-policy hardening).","verified_at":"2026-06-13T03:10:12Z"}},"url":"https://api.github.com/repos/openai/codex/commits/b9dc3b7a8ba24fe2a6ffa33890f35ca1d3e8ecf2","html_url":"https://github.com/openai/codex/commit/b9dc3b7a8ba24fe2a6ffa33890f35ca1d3e8ecf2","comments_url":"https://api.github.com/repos/openai/codex/commits/b9dc3b7a8ba24fe2a6ffa33890f35ca1d3e8ecf2/comments","author":{"login":"apanasenko-oai","id":228802911,"node_id":"U_kgDODaNBXw","avatar_url":"https://avatars.githubusercontent.com/u/228802911?v=4","gravatar_id":"","url":"https://api.github.com/users/apanasenko-oai","html_url":"https://github.com/apanasenko-oai","followers_url":"https://api.github.com/users/apanasenko-oai/followers","following_url":"https://api.github.com/users/apanasenko-oai/following{/other_user}","gists_url":"https://api.github.com/users/apanasenko-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/apanasenko-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/apanasenko-oai/subscriptions","organizations_url":"https://api.github.com/users/apanasenko-oai/orgs","repos_url":"https://api.github.com/users/apanasenko-oai/repos","events_url":"https://api.github.com/users/apanasenko-oai/events{/privacy}","received_events_url":"https://api.github.com/users/apanasenko-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"5d7db08b61555784ce8b08e1a5a308432e9c06a5","url":"https://api.github.com/repos/openai/codex/commits/5d7db08b61555784ce8b08e1a5a308432e9c06a5","html_url":"https://github.com/openai/codex/commit/5d7db08b61555784ce8b08e1a5a308432e9c06a5"}]},{"sha":"5d7db08b61555784ce8b08e1a5a308432e9c06a5","node_id":"C_kwDOOYsS4doAKDVkN2RiMDhiNjE1NTU3ODRjZThiMDhlMWE1YTMwODQzMmU5YzA2YTU","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-06-13T02:42:11Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-13T02:42:11Z"},"message":"[codex] Gate plugin MCP servers by auth route (#27459)\n\n## Context\n\nSome plugins expose both Apps and MCP servers. This PR moves auth-aware\nsurface projection into `core-plugins::PluginsManager`, so callers get a\nconsistent effective plugin view. Later PRs narrow the conflict rule and\nupdate listing/install paths.\n\nThe high level goal of this PR is to set up the plumbing to\nconditionally filter App/MCP in the plugin manager layer. We start by\nremoving MCP servers when using SIWC/Codex-backend auth, and removing\nApps when using API-key-style auth.\n\nThis PR is now stacked on #27652, which contains only the constructor\nplumbing for seeding `PluginsManager` with the current auth mode.\n\n## Stack\n\n- PR1: #27652 seed plugin manager auth at construction.\n- PR2: #27459 route plugin surfaces by auth mode.\n- PR3: #27607 dedupe plugin MCP servers by App declaration name.\n- PR4: #27602 preserve plugin Apps in connector listings.\n- PR5: #27461 skip install-time plugin MCP OAuth for matching App\nroutes.\n\n## Summary\n\n- API-key/non-ChatGPT routes hide plugin Apps and keep plugin MCPs.\n- ChatGPT/SIWC with Apps enabled keeps plugin Apps and suppresses MCPs\nfor dual-surface plugins.\n- MCP-only plugins stay available for ChatGPT/SIWC sessions.\n- Cached plugin load outcomes are re-projected when auth mode changes.\n\n## Validation\n\n```bash\ncargo test -p codex-core-plugins plugin_auth_projection\ncargo test -p codex-core list_tool_suggest_discoverable_plugins\ngit diff --check\n```","tree":{"sha":"d29eb5daf3e50ba6b28f2b26ca2f541c61e322a5","url":"https://api.github.com/repos/openai/codex/git/trees/d29eb5daf3e50ba6b28f2b26ca2f541c61e322a5"},"url":"https://api.github.com/repos/openai/codex/git/commits/5d7db08b61555784ce8b08e1a5a308432e9c06a5","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLMODCRC1aQ7uu5UhlAAAuuoQAHoox6DkedNlW/PRCBjQRoVU\nX+3lUO9INEOGg84T1la+dvfW8ElaF3AggMpG4EmCBFe3eM7HleYndY+2mrfpxp62\nJlohQ7HvFFW6crUJeHVzPo0sk7dFdxx2vWcGMaGcsliFyPUnKvY/jLvyzGVDDqTy\njIa2bwHYe5XDcUL/sw/sqpRGmdoBudxdKbFSjCVNT5OYLyfzR/C0lVDCEZd2GuV2\nbcnhLxt39jDUU0eydlXKQwJahph3zjxoIjCooD/RC8B2siDpVIkWZ7KEPosY4Beg\n1xK3FuVpeQZQfBmnHTTQp5NhcDWAnyu/BK+0Wp9vtnI7/Eb6IStwgOf4gqSjHJFd\nJZZC9JNvIHfDBu5RI1UvM2HPPdt8pJTA31sTWwJynyVNLouiu9bXpNhtaYvi6Ocp\n239D4cTtSABUCqEq7BGzq5E0DDRqt6A/EGkKQzOAVdDlNDmnOwWlMBuHxQVVzpYB\nV5Ake0ZVbWx3xa4vtXU3jemYLMhdEfMdDJeHWzc/TkFuyoZpZF+TWPjaNRlS1Fr2\nDsK6sCOmQxwGciD2C9oiMYd+V7ygcC3y86mz9FkP99PUmgzpEV0QSeCjO2wvCx5P\n9jASHdF3Mp7It7fc2Lxb7omv5IedwhtgsDZfsmHDWFlMRmS7sdU02k9uPzb3vfoQ\n0TfMxPdjCGy7QhnjIVIT\n=LZWD\n-----END PGP SIGNATURE-----\n","payload":"tree d29eb5daf3e50ba6b28f2b26ca2f541c61e322a5\nparent 5c8136f48a2b2102815918f8c58efa7173de703a\nauthor felixxia-oai <felixxia@openai.com> 1781318531 +0100\ncommitter GitHub <noreply@github.com> 1781318531 -0700\n\n[codex] Gate plugin MCP servers by auth route (#27459)\n\n## Context\n\nSome plugins expose both Apps and MCP servers. This PR moves auth-aware\nsurface projection into `core-plugins::PluginsManager`, so callers get a\nconsistent effective plugin view. Later PRs narrow the conflict rule and\nupdate listing/install paths.\n\nThe high level goal of this PR is to set up the plumbing to\nconditionally filter App/MCP in the plugin manager layer. We start by\nremoving MCP servers when using SIWC/Codex-backend auth, and removing\nApps when using API-key-style auth.\n\nThis PR is now stacked on #27652, which contains only the constructor\nplumbing for seeding `PluginsManager` with the current auth mode.\n\n## Stack\n\n- PR1: #27652 seed plugin manager auth at construction.\n- PR2: #27459 route plugin surfaces by auth mode.\n- PR3: #27607 dedupe plugin MCP servers by App declaration name.\n- PR4: #27602 preserve plugin Apps in connector listings.\n- PR5: #27461 skip install-time plugin MCP OAuth for matching App\nroutes.\n\n## Summary\n\n- API-key/non-ChatGPT routes hide plugin Apps and keep plugin MCPs.\n- ChatGPT/SIWC with Apps enabled keeps plugin Apps and suppresses MCPs\nfor dual-surface plugins.\n- MCP-only plugins stay available for ChatGPT/SIWC sessions.\n- Cached plugin load outcomes are re-projected when auth mode changes.\n\n## Validation\n\n```bash\ncargo test -p codex-core-plugins plugin_auth_projection\ncargo test -p codex-core list_tool_suggest_discoverable_plugins\ngit diff --check\n```","verified_at":"2026-06-13T02:42:12Z"}},"url":"https://api.github.com/repos/openai/codex/commits/5d7db08b61555784ce8b08e1a5a308432e9c06a5","html_url":"https://github.com/openai/codex/commit/5d7db08b61555784ce8b08e1a5a308432e9c06a5","comments_url":"https://api.github.com/repos/openai/codex/commits/5d7db08b61555784ce8b08e1a5a308432e9c06a5/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"5c8136f48a2b2102815918f8c58efa7173de703a","url":"https://api.github.com/repos/openai/codex/commits/5c8136f48a2b2102815918f8c58efa7173de703a","html_url":"https://github.com/openai/codex/commit/5c8136f48a2b2102815918f8c58efa7173de703a"}]},{"sha":"5c8136f48a2b2102815918f8c58efa7173de703a","node_id":"C_kwDOOYsS4doAKDVjODEzNmY0OGEyYjIxMDI4MTU5MThmOGM1OGVmYTcxNzNkZTcwM2E","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-13T01:24:49Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-13T01:24:49Z"},"message":"[codex] Add hermetic Wine test support (#27964)\n\n## Why\n\nWe want to make it possible for an app-server orchestrator on one OS to\ncontrol an exec-server on another host running a different OS. In\npractice this kinda already works if you get lucky and the two hosts\nhave the same path format, but we mangle quite a lot of operations if\neither end is Windows.\n\nWe should be able to test the cross-platform interactions for\nexec-server, but we want to do this fairly soon and need a lightweight\noption for testing. Using Wine to run the Windows side is far from\nperfect, but it should give us a decent measure of how well we're\nhandling the basics of paths, process spawning, shell interaction, etc.\n\nFuture changes will add actual exec-server tests and possibly extensions\nto the Wine testing environment.\n\n## What\n\nTo make the cross-target-triple build easy, these tests are added only\nto the Bazel build. This change adds an x86_64 Wine prebuilt managed by\nBazel and some build rules that can set up the needed toolchain\ntransition.\n\nThe support library for running Wine in a test environment created by\nthe Bazel rules comes with its own basic unit and integration tests.\nTheir primary priority is to make sure we don't leak child processes on\ndeveloper machines and that we can build and launch a basic hello world\nbinary.\n\n## Validation\n\nConfirmed these new tests are running on the [x86_64 bazel ubuntu\njobs](https://github.com/openai/codex/actions/runs/27446432302/job/81132356855?pr=27937):\n\n```\n//bazel/rules/testing/wine:wine-smoke-test                      (cached) PASSED in 3.7s\n//bazel/rules/testing/wine:wine-test-support-unit-tests         (cached) PASSED in 15.8s\n```","tree":{"sha":"925bebb9bdce00af4052b4e89ab34e613d30147f","url":"https://api.github.com/repos/openai/codex/git/trees/925bebb9bdce00af4052b4e89ab34e613d30147f"},"url":"https://api.github.com/repos/openai/codex/git/commits/5c8136f48a2b2102815918f8c58efa7173de703a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLLFhCRC1aQ7uu5UhlAAAM8YQAAKs4aV3bMPQoISMR/89YlVL\nFTCqWU7KXmAENo9YxeI5ixGtMndeQ88IBkJbigpG4x5fiy3pj5s9bh6u/2K9bbqc\nsmfOfmxRcNThUmwRoPM7Y8uCMRZQhZBVLcgtYaCbekFgDJT75g6qA/VdwhkuOcX2\n5Rtz8vhtNT+O9tJfEnV1LX1TFXgy0o+nySOX/si0IOyX5b8VYh+lQmNHB0OZYOJ1\nQNT7TbXu/yCx9Hv9ahV5lS3c8hpS4bjleZ5U091jEk/Gkl9jSfod4tHjNGVOpB1C\nVHSSTWYYHzEJTY5LtGS4jXoSKx4zDjjIUvu2nYf2hVeTJwAGXrDqk0yTI0dVRjtf\noNaAD5w9WExF+r6wEdtwhjzlzP+UJtkcj6cTXIW0jvDY+pOA0Ww5QDT2BXh7E695\num1YFDU+5I2W/+CCZg6L8CW5nUi1ZIIhbYmO4nmSqFIo8DLCK/ti5fTa36mBZNH8\nkD119mz3Bb6zetFlh9BtdRFN+u2nsfHkGr9iM1SfN1i7h/sAn70/qge8vyOwpB1D\nxSjoUDi0DW6fNygoXX6JL3GfX3BJYd9/PyNQK+GJoujxcu623BNnb7q2AwT7M+N6\noMB4AZL1rMjQn+cL1taLqXTuDpUN39uRkpjJqSawHnZu6UVA+T+BgBn1IJ6rMeUy\nczjEAJhDXHnLRYM3ek1p\n=uTua\n-----END PGP SIGNATURE-----\n","payload":"tree 925bebb9bdce00af4052b4e89ab34e613d30147f\nparent aef40ad91fdb8afed89bc6b2821e58cc6f929608\nauthor Adam Perry @ OpenAI <anp@openai.com> 1781313889 -0700\ncommitter GitHub <noreply@github.com> 1781313889 -0700\n\n[codex] Add hermetic Wine test support (#27964)\n\n## Why\n\nWe want to make it possible for an app-server orchestrator on one OS to\ncontrol an exec-server on another host running a different OS. In\npractice this kinda already works if you get lucky and the two hosts\nhave the same path format, but we mangle quite a lot of operations if\neither end is Windows.\n\nWe should be able to test the cross-platform interactions for\nexec-server, but we want to do this fairly soon and need a lightweight\noption for testing. Using Wine to run the Windows side is far from\nperfect, but it should give us a decent measure of how well we're\nhandling the basics of paths, process spawning, shell interaction, etc.\n\nFuture changes will add actual exec-server tests and possibly extensions\nto the Wine testing environment.\n\n## What\n\nTo make the cross-target-triple build easy, these tests are added only\nto the Bazel build. This change adds an x86_64 Wine prebuilt managed by\nBazel and some build rules that can set up the needed toolchain\ntransition.\n\nThe support library for running Wine in a test environment created by\nthe Bazel rules comes with its own basic unit and integration tests.\nTheir primary priority is to make sure we don't leak child processes on\ndeveloper machines and that we can build and launch a basic hello world\nbinary.\n\n## Validation\n\nConfirmed these new tests are running on the [x86_64 bazel ubuntu\njobs](https://github.com/openai/codex/actions/runs/27446432302/job/81132356855?pr=27937):\n\n```\n//bazel/rules/testing/wine:wine-smoke-test                      (cached) PASSED in 3.7s\n//bazel/rules/testing/wine:wine-test-support-unit-tests         (cached) PASSED in 15.8s\n```","verified_at":"2026-06-13T01:24:49Z"}},"url":"https://api.github.com/repos/openai/codex/commits/5c8136f48a2b2102815918f8c58efa7173de703a","html_url":"https://github.com/openai/codex/commit/5c8136f48a2b2102815918f8c58efa7173de703a","comments_url":"https://api.github.com/repos/openai/codex/commits/5c8136f48a2b2102815918f8c58efa7173de703a/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"aef40ad91fdb8afed89bc6b2821e58cc6f929608","url":"https://api.github.com/repos/openai/codex/commits/aef40ad91fdb8afed89bc6b2821e58cc6f929608","html_url":"https://github.com/openai/codex/commit/aef40ad91fdb8afed89bc6b2821e58cc6f929608"}]},{"sha":"aef40ad91fdb8afed89bc6b2821e58cc6f929608","node_id":"C_kwDOOYsS4doAKGFlZjQwYWQ5MWZkYjhhZmVkODliYzZiMjgyMWU1OGNjNmY5Mjk2MDg","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-06-13T01:00:31Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-13T01:00:31Z"},"message":"[codex] Add auth mode to plugin manager constructor (#27652)\n\n## Context\n\nPlugins can expose more than one way for Codex to use them: App\nconnectors for ChatGPT/SIWC-backed sessions and MCP servers for API key\nlogin sessions. The broader goal is to make `PluginsManager` the place\nthat understands which plugin surfaces should be visible for the current\nauth route, so callers do not each have to make that decision\nthemselves.\n\nThis PR is the small setup step for that work. It lets the plugin\nmanager be created with the current `AuthMode`, which gives the followup\nauth routing PRs the information they need without relying on setter\ninjection.\n\n## Stack\n\n- PR1: #27652 seed plugin manager auth at construction.\n- PR2: #27459 route plugin surfaces by auth mode.\n- PR3: #27607 dedupe plugin MCP servers by App declaration name.\n- PR4: #27602 preserve plugin Apps in connector listings.\n- PR5: #27461 skip install-time plugin MCP OAuth for matching App\nroutes.\n\n## Summary\n\n- Let `PluginsManager::new_with_restriction_product` accept an initial\n`AuthMode`.\n- Keep `PluginsManager::new` behavior unchanged for ordinary callers.\n\n## Validation\n\n```bash\ncargo test -p codex-core-plugins plugins_manager_tracks_auth_mode\ncargo test -p codex-core list_tool_suggest_discoverable_plugins\ngit diff --check\n```\n\n---------\n\nCo-authored-by: Xin Lin <xl@openai.com>","tree":{"sha":"97289c93d472441b828f75b613fa2e53f3a07854","url":"https://api.github.com/repos/openai/codex/git/trees/97289c93d472441b828f75b613fa2e53f3a07854"},"url":"https://api.github.com/repos/openai/codex/git/commits/aef40ad91fdb8afed89bc6b2821e58cc6f929608","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLKuvCRC1aQ7uu5UhlAAAmFwQAFRFes8t2S0U9LkAHu24y/ln\nZhzV0cVj0aPKyTQFg3Ye2/ADfI04eIUdKhvVylRQreJ38WjtpHYd4mhn6S/CuGpn\nnNsAssqatvW3ZmY6+mlAWtPpCaY+x3rc0fMs490l8gPLF/oxZ8dCeoxh0BbUWB9T\nBDch9r4XJTdPKv92qTVWtk4wQB3+Qbrwo6xEkStvhyjjO97eaWJvW1AuZwKikIeB\nrLyIht9qFUqmhPPBW6uqN8dCzIgOuFqhqpY8ZEehsEqSvtu90HmokO/YMJGp6/Yb\n1OK2JFPlX5mOVDTiWSMd0Eh/ct5R/SBy6UbQgEL88Ww0dbdrJwIf6Djqha54Nhsk\n338ACvaRQPEm1aTIuJaTpb+wIoTnmSkLpnyeX/d//bru1GHPWj9yc+vcyZm5rXAm\nCqTo+yErK+CeU/UqQJmmyNDJ9xysgVCqOTqraYqrJ76nnNXEO9truDTgfjdvzaIf\nzlz9Idpn8WyWS5qN4xDLGqnYnNyWd3l6N4CraXKL+LIUfaxYySxvpa623QKsw/PH\n6I15Zzz4gFCgOUnMDNrl09RqO58T+6jpxP//6+zyGUmj0CKHxU8BORELJ/JuNxjH\nKFEcF8mek7GXSO7v5+U8Kvg6/lQISxf+gXpgMILCPJInZxkrbtiFnSJD8jccEzZ2\ntFdcV+PFcTM0i0sdx7AK\n=TlyY\n-----END PGP SIGNATURE-----\n","payload":"tree 97289c93d472441b828f75b613fa2e53f3a07854\nparent 044c1420a180207b1bc04fac82963233921ca2dd\nauthor felixxia-oai <felixxia@openai.com> 1781312431 +0100\ncommitter GitHub <noreply@github.com> 1781312431 -0700\n\n[codex] Add auth mode to plugin manager constructor (#27652)\n\n## Context\n\nPlugins can expose more than one way for Codex to use them: App\nconnectors for ChatGPT/SIWC-backed sessions and MCP servers for API key\nlogin sessions. The broader goal is to make `PluginsManager` the place\nthat understands which plugin surfaces should be visible for the current\nauth route, so callers do not each have to make that decision\nthemselves.\n\nThis PR is the small setup step for that work. It lets the plugin\nmanager be created with the current `AuthMode`, which gives the followup\nauth routing PRs the information they need without relying on setter\ninjection.\n\n## Stack\n\n- PR1: #27652 seed plugin manager auth at construction.\n- PR2: #27459 route plugin surfaces by auth mode.\n- PR3: #27607 dedupe plugin MCP servers by App declaration name.\n- PR4: #27602 preserve plugin Apps in connector listings.\n- PR5: #27461 skip install-time plugin MCP OAuth for matching App\nroutes.\n\n## Summary\n\n- Let `PluginsManager::new_with_restriction_product` accept an initial\n`AuthMode`.\n- Keep `PluginsManager::new` behavior unchanged for ordinary callers.\n\n## Validation\n\n```bash\ncargo test -p codex-core-plugins plugins_manager_tracks_auth_mode\ncargo test -p codex-core list_tool_suggest_discoverable_plugins\ngit diff --check\n```\n\n---------\n\nCo-authored-by: Xin Lin <xl@openai.com>","verified_at":"2026-06-13T01:00:32Z"}},"url":"https://api.github.com/repos/openai/codex/commits/aef40ad91fdb8afed89bc6b2821e58cc6f929608","html_url":"https://github.com/openai/codex/commit/aef40ad91fdb8afed89bc6b2821e58cc6f929608","comments_url":"https://api.github.com/repos/openai/codex/commits/aef40ad91fdb8afed89bc6b2821e58cc6f929608/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"044c1420a180207b1bc04fac82963233921ca2dd","url":"https://api.github.com/repos/openai/codex/commits/044c1420a180207b1bc04fac82963233921ca2dd","html_url":"https://github.com/openai/codex/commit/044c1420a180207b1bc04fac82963233921ca2dd"}]},{"sha":"044c1420a180207b1bc04fac82963233921ca2dd","node_id":"C_kwDOOYsS4doAKDA0NGMxNDIwYTE4MDIwN2IxYmMwNGZhYzgyOTYzMjMzOTIxY2EyZGQ","commit":{"author":{"name":"xl-openai","email":"xl@openai.com","date":"2026-06-13T00:51:09Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-13T00:51:09Z"},"message":"[codex] Limit app-based plugin suggestions to remote catalogs (#27988)\n\n## Summary\n\n- Keep local plugin suggestions bounded to fallback and explicitly\nconfigured plugins.\n- Preserve app-overlap recommendations for remote plugins using cached\ncatalog metadata.\n- Remove the WSL-specific local discovery exception and move\nmanager-owned discovery tests into `codex-core-plugins`.\n\n## Why\n\nLocal curated marketplaces were allowlisted before plugin detail\nloading, so every uninstalled candidate could be deep-read before its\napp IDs were checked. That caused per-turn reads of candidate plugin\nmanifests, skills, app configs, hooks, and MCP configs, which is\nespecially expensive on slow disks.\n\nRemote discovery does not need those local candidate reads because app\nIDs are already available in the cached remote catalog. Installed local\nplugins are still loaded when needed to determine the user's installed\napp IDs.\n\n## Validation\n\n- `just fmt`\n- `just test -p codex-core-plugins discoverable::tests` (13 passed)\n- `just test -p codex-core plugins::discoverable::tests` (4 passed)\n- `just bazel-lock-update`\n- `just bazel-lock-check`\n- `git diff --check`","tree":{"sha":"84e9b50b2fdcbab49b9fd4a6a0094e0a3e31acd3","url":"https://api.github.com/repos/openai/codex/git/trees/84e9b50b2fdcbab49b9fd4a6a0094e0a3e31acd3"},"url":"https://api.github.com/repos/openai/codex/git/commits/044c1420a180207b1bc04fac82963233921ca2dd","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLKl9CRC1aQ7uu5UhlAAAUFkQABBIBbmApo/+kxw+DXbs2cGM\nEjs2tARPVVql7SC7juIHby+FsB7cxB/7Y5i+lzqeERQezUFV0sXzuvPCtbOOUlE1\nZZwPSqfMJRjPXmeKchYck5h7/XrpzICQBD0vjVjaLJOnpGoKX6CIXY7oL8lKu+YO\nW99CL6fzpLxvGWV5gPZex53dR++ty69QmTdEA7l4PTb3h8CzWQPFRl3m97Vq1M39\nngywP9Sxxo+9Zz3PfmiNofZNu7sIGbc3WWrs0T3/g8Ack0dWGQRfbkL++3/ed0wT\nBJnog7sF8dOkeJDjbwZbKaPx3chlPVaiFd6MvTjHgd3BT6CxQq0jPREKV8Sophvp\nBr39s3TCNxH02kAdnPTHy8l0PF4uG07MyF9Vqq/ObwaGr73q0u9LRCZLmKgrOzE1\nBxzilxmumyreqHD7EgFbTFTFENkra/y3e0qPcjwaZw0y/t/wHJhUOL7EpBAOTdKh\nfY4QsPUTJ3byRjW6/3aqbZW6MAPg7BCyIXbyRn/oz4Cbtq5Hp6//Llwfo4NEqdmF\nPuNAJLGlG+sa88o1CTnx/Zq15aGTUSrc5x5q5YqZk6cSqJTzwlOSWrDIz0HA8xCt\nf9/PvHhVz2FhMUZO5ufJzW0sIuhlNQKyKmAmksMB4mxduPQimrXHw9AaD/uHAXDr\nsXmF/NChDfLseSaKCrIV\n=rV4X\n-----END PGP SIGNATURE-----\n","payload":"tree 84e9b50b2fdcbab49b9fd4a6a0094e0a3e31acd3\nparent c884536d848524d5f481eed6f8c02312de106a7a\nauthor xl-openai <xl@openai.com> 1781311869 -0700\ncommitter GitHub <noreply@github.com> 1781311869 -0700\n\n[codex] Limit app-based plugin suggestions to remote catalogs (#27988)\n\n## Summary\n\n- Keep local plugin suggestions bounded to fallback and explicitly\nconfigured plugins.\n- Preserve app-overlap recommendations for remote plugins using cached\ncatalog metadata.\n- Remove the WSL-specific local discovery exception and move\nmanager-owned discovery tests into `codex-core-plugins`.\n\n## Why\n\nLocal curated marketplaces were allowlisted before plugin detail\nloading, so every uninstalled candidate could be deep-read before its\napp IDs were checked. That caused per-turn reads of candidate plugin\nmanifests, skills, app configs, hooks, and MCP configs, which is\nespecially expensive on slow disks.\n\nRemote discovery does not need those local candidate reads because app\nIDs are already available in the cached remote catalog. Installed local\nplugins are still loaded when needed to determine the user's installed\napp IDs.\n\n## Validation\n\n- `just fmt`\n- `just test -p codex-core-plugins discoverable::tests` (13 passed)\n- `just test -p codex-core plugins::discoverable::tests` (4 passed)\n- `just bazel-lock-update`\n- `just bazel-lock-check`\n- `git diff --check`","verified_at":"2026-06-13T00:51:09Z"}},"url":"https://api.github.com/repos/openai/codex/commits/044c1420a180207b1bc04fac82963233921ca2dd","html_url":"https://github.com/openai/codex/commit/044c1420a180207b1bc04fac82963233921ca2dd","comments_url":"https://api.github.com/repos/openai/codex/commits/044c1420a180207b1bc04fac82963233921ca2dd/comments","author":{"login":"xl-openai","id":184293535,"node_id":"U_kgDOCvwYnw","avatar_url":"https://avatars.githubusercontent.com/u/184293535?v=4","gravatar_id":"","url":"https://api.github.com/users/xl-openai","html_url":"https://github.com/xl-openai","followers_url":"https://api.github.com/users/xl-openai/followers","following_url":"https://api.github.com/users/xl-openai/following{/other_user}","gists_url":"https://api.github.com/users/xl-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/xl-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/xl-openai/subscriptions","organizations_url":"https://api.github.com/users/xl-openai/orgs","repos_url":"https://api.github.com/users/xl-openai/repos","events_url":"https://api.github.com/users/xl-openai/events{/privacy}","received_events_url":"https://api.github.com/users/xl-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c884536d848524d5f481eed6f8c02312de106a7a","url":"https://api.github.com/repos/openai/codex/commits/c884536d848524d5f481eed6f8c02312de106a7a","html_url":"https://github.com/openai/codex/commit/c884536d848524d5f481eed6f8c02312de106a7a"}]},{"sha":"c884536d848524d5f481eed6f8c02312de106a7a","node_id":"C_kwDOOYsS4doAKGM4ODQ1MzZkODQ4NTI0ZDVmNDgxZWVkNmY4YzAyMzEyZGUxMDZhN2E","commit":{"author":{"name":"Felipe Coury","email":"felipe.coury@openai.com","date":"2026-06-13T00:33:43Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-13T00:33:43Z"},"message":"feat(tui): reland token activity command (#27925)\n\n## Why\n\n[#25345](https://github.com/openai/codex/pull/25345) was approved,\ngreen, and squash-merged into its stacked base branch,\n`fcoury/tokenmaxxing-api`. Four minutes later, that base branch was\nforce-pushed back to an API-only rebased head while preparing\n[#25344](https://github.com/openai/codex/pull/25344) for `main`. As a\nresult, the squash commit from #25345 was orphaned and the TUI command\nnever reached `main` or a release.\n\nThis PR relands the orphaned TUI change from\n[`411410b8`](https://github.com/openai/codex/commit/411410b85c2d8eb050d441f17396c5c4048d866f)\non current `main`.\n\n## What changed\n\n- Add `/usage`, `/usage daily`, `/usage weekly`, and `/usage cumulative`\nfor account token activity.\n- Fetch account usage asynchronously through the existing\n`account/usage/read` app-server RPC.\n- Render daily, weekly, and cumulative activity with theme-aware\nterminal palettes and bounded transient cards.\n- Preserve transcript ordering while assistant streams, history\nconsolidations, active cells, and hooks complete.\n- Hide `/usage` from completion when backend auth is unavailable while\nkeeping typed-command guidance.\n- Carry current-main behavior forward for cwd-aware Markdown parsing,\nWindows Terminal color detection, and personal access token auth.\n- Clear pending usage cards on thread rollback and delay completed cards\nuntil live hook output is committed.\n- Add focused regression and snapshot coverage for loading, auth errors,\ninvalid views, rollback, hook ordering, layout, and charts.\n\n## Prior review\n\nThe original implementation was approved by Eric Traut in #25345 after\ntesting multiple themes and light/dark terminals. This PR preserves that\nreviewed implementation while adapting it to current `main` and adding\nregression coverage for newer rollback and hook lifecycle behavior.\n\n## Validation\n\n- `just test -p codex-tui token_activity palette renderable\nusage_command` — 37 passed.\n- Focused rollback, hook-ordering, and error snapshot tests — 4 passed.\n- `just fix -p codex-tui` — passed.\n- `UV_CACHE_DIR=/private/tmp/codex-uv-cache just fmt` — passed.\n- `cargo insta pending-snapshots` — no pending snapshots.\n- `just test -p codex-tui` — 2,870 passed; two unrelated guardian\nfeature-flag tests failed because their expected `OverrideTurnContext`\nevent was absent:\n-\n`update_feature_flags_disabling_guardian_clears_manual_review_policy_without_history`\n-\n`update_feature_flags_disabling_guardian_clears_review_policy_and_restores_default`\n- `just argument-comment-lint` could not complete because the local\nBazel LLVM `compiler-rt` repository is missing `include/sanitizer/*.h`.\nThe touched Rust diff was manually inspected and no missing\nopaque-literal argument comments were found.","tree":{"sha":"5222b99c00a1955da1f313bc8124de910bbc80b1","url":"https://api.github.com/repos/openai/codex/git/trees/5222b99c00a1955da1f313bc8124de910bbc80b1"},"url":"https://api.github.com/repos/openai/codex/git/commits/c884536d848524d5f481eed6f8c02312de106a7a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLKVnCRC1aQ7uu5UhlAAAUJcQADkzvryMl3101PzyodiTlfgx\nIo0Kg87gEtOT3TQCvotM8km709rrCCBzqfUEn+KXYV1tqNgSkgkENm8LCWD6ifds\n/LD6/vLEX9Bls1dhuqOH2JmL1cFdZ0uKMgJywYQCGKEft57vKicUsD1Vn6UNKYEp\nm9vwAMEi7s5cQvQiEY9APrqfjJ1Lxxn+29jH+8Qmje7lEV1uaPpguRWwRbPWcTZ6\neVPP6PYx8BpAwvEaSn0EtXyR4HUc13agt6Pmf9Rt6ANuf1vF/JrReAkJumm8Vzf9\n/Jarc4M/cSdzv+Iz3x/I76XfwobqAHNjsWi3SlG0Ki+xqHN28N/Ig110uzjLdBfT\nDvzd4W/h1r8UrVSq5IJBrVVPAlOOiPzMHNmXlBHlxqsNaqQlrAgJjXhlpd22qqU/\nz/2BK0xVsAopZs7U2wcYwfnXnEWqIutdJYHpKNT6uYVCyDV13ZhmSdY+mpd7h0tj\nlpX6rrNmri9H3wELByz/9VlDa21TKj9q/mrOd7t4eUMTk06tSkUt4uTE3IiJW5LS\nm4bjKC0mWt3tZjmxDc2VvE9TgKX3OCtuur/IYSEMUlLtuRTIDfWicJAR+ubUmevz\n5xiyf7E5HClzTlP+f0YTCTuoROmSVpBDCnXGkcy9m6MIa6FBeGI++IodxrwjBAOW\nyoA4i4DgGkCrxQCm5k4N\n=Hf8c\n-----END PGP SIGNATURE-----\n","payload":"tree 5222b99c00a1955da1f313bc8124de910bbc80b1\nparent 9e078922534543b3bad2e6b920d398a661f9e40f\nauthor Felipe Coury <felipe.coury@openai.com> 1781310823 -0700\ncommitter GitHub <noreply@github.com> 1781310823 -0700\n\nfeat(tui): reland token activity command (#27925)\n\n## Why\n\n[#25345](https://github.com/openai/codex/pull/25345) was approved,\ngreen, and squash-merged into its stacked base branch,\n`fcoury/tokenmaxxing-api`. Four minutes later, that base branch was\nforce-pushed back to an API-only rebased head while preparing\n[#25344](https://github.com/openai/codex/pull/25344) for `main`. As a\nresult, the squash commit from #25345 was orphaned and the TUI command\nnever reached `main` or a release.\n\nThis PR relands the orphaned TUI change from\n[`411410b8`](https://github.com/openai/codex/commit/411410b85c2d8eb050d441f17396c5c4048d866f)\non current `main`.\n\n## What changed\n\n- Add `/usage`, `/usage daily`, `/usage weekly`, and `/usage cumulative`\nfor account token activity.\n- Fetch account usage asynchronously through the existing\n`account/usage/read` app-server RPC.\n- Render daily, weekly, and cumulative activity with theme-aware\nterminal palettes and bounded transient cards.\n- Preserve transcript ordering while assistant streams, history\nconsolidations, active cells, and hooks complete.\n- Hide `/usage` from completion when backend auth is unavailable while\nkeeping typed-command guidance.\n- Carry current-main behavior forward for cwd-aware Markdown parsing,\nWindows Terminal color detection, and personal access token auth.\n- Clear pending usage cards on thread rollback and delay completed cards\nuntil live hook output is committed.\n- Add focused regression and snapshot coverage for loading, auth errors,\ninvalid views, rollback, hook ordering, layout, and charts.\n\n## Prior review\n\nThe original implementation was approved by Eric Traut in #25345 after\ntesting multiple themes and light/dark terminals. This PR preserves that\nreviewed implementation while adapting it to current `main` and adding\nregression coverage for newer rollback and hook lifecycle behavior.\n\n## Validation\n\n- `just test -p codex-tui token_activity palette renderable\nusage_command` — 37 passed.\n- Focused rollback, hook-ordering, and error snapshot tests — 4 passed.\n- `just fix -p codex-tui` — passed.\n- `UV_CACHE_DIR=/private/tmp/codex-uv-cache just fmt` — passed.\n- `cargo insta pending-snapshots` — no pending snapshots.\n- `just test -p codex-tui` — 2,870 passed; two unrelated guardian\nfeature-flag tests failed because their expected `OverrideTurnContext`\nevent was absent:\n-\n`update_feature_flags_disabling_guardian_clears_manual_review_policy_without_history`\n-\n`update_feature_flags_disabling_guardian_clears_review_policy_and_restores_default`\n- `just argument-comment-lint` could not complete because the local\nBazel LLVM `compiler-rt` repository is missing `include/sanitizer/*.h`.\nThe touched Rust diff was manually inspected and no missing\nopaque-literal argument comments were found.","verified_at":"2026-06-13T00:33:44Z"}},"url":"https://api.github.com/repos/openai/codex/commits/c884536d848524d5f481eed6f8c02312de106a7a","html_url":"https://github.com/openai/codex/commit/c884536d848524d5f481eed6f8c02312de106a7a","comments_url":"https://api.github.com/repos/openai/codex/commits/c884536d848524d5f481eed6f8c02312de106a7a/comments","author":{"login":"fcoury-oai","id":272635208,"node_id":"U_kgDOEEAVSA","avatar_url":"https://avatars.githubusercontent.com/u/272635208?v=4","gravatar_id":"","url":"https://api.github.com/users/fcoury-oai","html_url":"https://github.com/fcoury-oai","followers_url":"https://api.github.com/users/fcoury-oai/followers","following_url":"https://api.github.com/users/fcoury-oai/following{/other_user}","gists_url":"https://api.github.com/users/fcoury-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/fcoury-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fcoury-oai/subscriptions","organizations_url":"https://api.github.com/users/fcoury-oai/orgs","repos_url":"https://api.github.com/users/fcoury-oai/repos","events_url":"https://api.github.com/users/fcoury-oai/events{/privacy}","received_events_url":"https://api.github.com/users/fcoury-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"9e078922534543b3bad2e6b920d398a661f9e40f","url":"https://api.github.com/repos/openai/codex/commits/9e078922534543b3bad2e6b920d398a661f9e40f","html_url":"https://github.com/openai/codex/commit/9e078922534543b3bad2e6b920d398a661f9e40f"}]},{"sha":"9e078922534543b3bad2e6b920d398a661f9e40f","node_id":"C_kwDOOYsS4doAKDllMDc4OTIyNTM0NTQzYjNiYWQyZTZiOTIwZDM5OGE2NjFmOWU0MGY","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-06-13T00:14:27Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-13T00:14:27Z"},"message":"[3 of 3] Support images in TUI goals (#27510)\n\n## Stack\n\n1. [1 of 3] Support long raw TUI goal objectives - #27508\n2. [2 of 3] Support long pasted text in TUI goals - #27509\n3. **[3 of 3] Support images in TUI goals** - this PR\n\n## Why\n\nThe first two PRs make goal definitions resilient to long text, but\n`/goal` still dropped image inputs from the composer. That meant a user\ncould attach images while defining a goal and the resulting goal\ncontinuation would not have any useful reference to those images.\n\nGoal state still persists only objective text, so image inputs need to\nbecome paths or URLs that the agent can read later.\n\n## What Changed\n\n- Extends TUI `GoalDraft` with local image attachments and remote image\nURLs.\n- Copies local goal images through the app-server filesystem layer into\nthe managed goal attachment directory, then rewrites active image\nplaceholders to file references.\n- Appends unplaced local images and remote image URLs to the objective\nas referenced image files or URLs.\n- Preserves goal image metadata through live `/goal` submission and\nqueued `/goal` dispatch.\n\n## Verification\n\n- Added goal materialization coverage for local image files and remote\nimage URLs.\n- Added/updated TUI slash-command coverage showing `/goal` drafts\ninclude attached images instead of dropping them.\n\n## Manual Testing\n\n- Attached an image by bracketed-pasting its local path into a live\n`/goal` composer. The `[Image #1]` placeholder became a server-host\n`image-1.png` reference, copied bytes matched exactly, and no attachment\nwas written under the TUI's local home.\n- Deleted an image placeholder before submitting a small goal and\nverified no image was copied.\n- Attached PNG and JPEG files to the same goal. Placeholder order was\npreserved as `image-1.png` and `image-2.jpg`, and both remote copies\nmatched their source bytes.\n- Tried extensionless, malformed-extension, and\nextension/content-mismatched paths; the composer rejected them as image\nattachments before goal dispatch rather than creating misleading managed\nimage files.\n- Combined a local image, a large pasted block, and enough raw text to\nexceed 4,000 characters. The remote attachment directory contained the\nimage, paste sidecar, and `goal-objective.md`; all embedded references\nused server-host paths and both payloads matched their sources.\n- Submitted an image replacement while a goal was active, verified no\nimage was copied before confirmation, then canceled and confirmed the\nattachment count was unchanged.","tree":{"sha":"7b6053b247fd341bd3af8431bbf63ad9b6aaf725","url":"https://api.github.com/repos/openai/codex/git/trees/7b6053b247fd341bd3af8431bbf63ad9b6aaf725"},"url":"https://api.github.com/repos/openai/codex/git/commits/9e078922534543b3bad2e6b920d398a661f9e40f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLKDjCRC1aQ7uu5UhlAAAGD8QAKKEuXkpLjhPXXiuxTe9daHw\nd5+y0RzEoGzJKDe/nZVA7RFqlO6T1XYhcGVHL9aLOOsS5yCjwF/l2TDNhVC9rMFL\nzvjdUTFqFWP0z4nzYsQQuiCGEyz9nZ7pVnMtlA1aRS9u9F5QXH/7q3wONVzW7xzW\niL9IodUwcLAdnYs6G+2nXmsttF1BwUH+8lOa0xY1gI4KM8EoNnmAWmjrb+4kuStb\nAcjQjGBjsvnTGYfxYnxq2sbqcpfVRI2XW9/ajRC7QchSC8OXtuAmcVlNk7KPsvV1\nJ+apnjS4C8bB/KNQ2AMAJ1PHQDOhGed7nTB1B44ZPQEld1WoEfpGDhzoyWlDtsAb\nuMg0ciFn0/rCtVFJmCYfNXd+L1ropqNNpNkgs/WwUx7X7VdkDYbFYn9gFeZ528//\nRFvcm24Y6L6kC721DNCWIw8A6p/ejVpDm7nF6i+letDWmZwwLopAUvcJyoooAKsl\nM2/CG3ab8PFfWC9dxifNtCMF8KvidmnzoMvEIEJ6TKKmkJBRLN+jsIahfCng6Lb4\npFWDjY9atiDFxzegXaFnUxr/CApEjoR6Lgla+VHI7S/Al4Ksj0hNnAbWULulAwSH\nCglMjsPEqU5LTl1UW/JbtUP9S/0IJ5XMZzIAV9EfILAXR7dwBOOmlT8y2IpfmeCk\nIKEhgljD8cmgSDhNoLbG\n=eY3u\n-----END PGP SIGNATURE-----\n","payload":"tree 7b6053b247fd341bd3af8431bbf63ad9b6aaf725\nparent bacfc5e4c097894c927b5451d085fe7e489f8510\nauthor Eric Traut <etraut@openai.com> 1781309667 -0700\ncommitter GitHub <noreply@github.com> 1781309667 -0700\n\n[3 of 3] Support images in TUI goals (#27510)\n\n## Stack\n\n1. [1 of 3] Support long raw TUI goal objectives - #27508\n2. [2 of 3] Support long pasted text in TUI goals - #27509\n3. **[3 of 3] Support images in TUI goals** - this PR\n\n## Why\n\nThe first two PRs make goal definitions resilient to long text, but\n`/goal` still dropped image inputs from the composer. That meant a user\ncould attach images while defining a goal and the resulting goal\ncontinuation would not have any useful reference to those images.\n\nGoal state still persists only objective text, so image inputs need to\nbecome paths or URLs that the agent can read later.\n\n## What Changed\n\n- Extends TUI `GoalDraft` with local image attachments and remote image\nURLs.\n- Copies local goal images through the app-server filesystem layer into\nthe managed goal attachment directory, then rewrites active image\nplaceholders to file references.\n- Appends unplaced local images and remote image URLs to the objective\nas referenced image files or URLs.\n- Preserves goal image metadata through live `/goal` submission and\nqueued `/goal` dispatch.\n\n## Verification\n\n- Added goal materialization coverage for local image files and remote\nimage URLs.\n- Added/updated TUI slash-command coverage showing `/goal` drafts\ninclude attached images instead of dropping them.\n\n## Manual Testing\n\n- Attached an image by bracketed-pasting its local path into a live\n`/goal` composer. The `[Image #1]` placeholder became a server-host\n`image-1.png` reference, copied bytes matched exactly, and no attachment\nwas written under the TUI's local home.\n- Deleted an image placeholder before submitting a small goal and\nverified no image was copied.\n- Attached PNG and JPEG files to the same goal. Placeholder order was\npreserved as `image-1.png` and `image-2.jpg`, and both remote copies\nmatched their source bytes.\n- Tried extensionless, malformed-extension, and\nextension/content-mismatched paths; the composer rejected them as image\nattachments before goal dispatch rather than creating misleading managed\nimage files.\n- Combined a local image, a large pasted block, and enough raw text to\nexceed 4,000 characters. The remote attachment directory contained the\nimage, paste sidecar, and `goal-objective.md`; all embedded references\nused server-host paths and both payloads matched their sources.\n- Submitted an image replacement while a goal was active, verified no\nimage was copied before confirmation, then canceled and confirmed the\nattachment count was unchanged.","verified_at":"2026-06-13T00:14:28Z"}},"url":"https://api.github.com/repos/openai/codex/commits/9e078922534543b3bad2e6b920d398a661f9e40f","html_url":"https://github.com/openai/codex/commit/9e078922534543b3bad2e6b920d398a661f9e40f","comments_url":"https://api.github.com/repos/openai/codex/commits/9e078922534543b3bad2e6b920d398a661f9e40f/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"bacfc5e4c097894c927b5451d085fe7e489f8510","url":"https://api.github.com/repos/openai/codex/commits/bacfc5e4c097894c927b5451d085fe7e489f8510","html_url":"https://github.com/openai/codex/commit/bacfc5e4c097894c927b5451d085fe7e489f8510"}]},{"sha":"bacfc5e4c097894c927b5451d085fe7e489f8510","node_id":"C_kwDOOYsS4doAKGJhY2ZjNWU0YzA5Nzg5NGM5MjdiNTQ1MWQwODVmZTdlNDg5Zjg1MTA","commit":{"author":{"name":"rphilizaire-openai","email":"rphilizaire@openai.com","date":"2026-06-13T00:11:32Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-13T00:11:32Z"},"message":"[codex] add latency tracing spans (#27710)\n\n## Why\n\nWe have some large gaps in our thread start, resume, and pre-sampling\ntraces that make it hard to tell where latency is coming from.\n\n## What Changed\n\n- Added coarse spans around thread start/resume, turn context\nconstruction, rollout reconstruction, skill/plugin loading, and tool\npreparation.\n- Added a breakdown of discoverable-tool preparation across connector\nloading, plugin discovery, and local plugin details.\n\n## Testing\n\n- `cargo check -p codex-app-server -p codex-core -p codex-core-skills -p\ncodex-core-plugins`\n- Built the app-server locally and exercised thread start, first turn,\nfollow-up turn, server restart, thread resume, and a resumed turn.","tree":{"sha":"95969ddf76810fb9d9f5e43b1336c5ba4ec07c34","url":"https://api.github.com/repos/openai/codex/git/trees/95969ddf76810fb9d9f5e43b1336c5ba4ec07c34"},"url":"https://api.github.com/repos/openai/codex/git/commits/bacfc5e4c097894c927b5451d085fe7e489f8510","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLKA0CRC1aQ7uu5UhlAAAsnsQAKC/uUHfmguRp8sun85fe9uw\nAcdXAPjErsUcb3RWkdmZ/JviyZV/h1Y5cMfxxfaJS/Z0vZoxIa59xxiLhoRs2O+c\nWxUCiQ90FT1HIRCMcaGymiIdNwajTKNodThCf1QllUfhQzRMXhAD6rnu5NgbljLd\nwH/jdP7IZW+oNdAAURCpzmhjtBUysaEGntNqWNaiPLtI/LytV7qWDpjIS/MNkgM8\ne5TQlQSj+9O2lJmT3erLjtUK0twZ3QS0HMabvvxM1XQLqHYl16/+M08bIhlj9XYx\n3Kc1DledSDYbyLhCt4Iuvl1Mds4ziN9IrYJ6ZdXUG47/EYZQaiPp8E9ESHE+TKhX\n1vpxNrKyLZ1RB8gFJ3fbfaiA5rU1FgAHw2jBvx2hqtKS1iNlJYRB1uqX1p5XOXpC\nzrxarel69MiUxc7Rd6b96lqec3NRM/jHC44nd4Rr8ZMhrHXYtHKxuujHR+oW+qt0\nL/qVe7zdCaqfOYhbKRcdmIdwkJ7OeCbeY9HsLLzx4n5hTYpecl1MMRoSMEXMTlaY\nyZG0ENcOOEUw15PYQ4KiHw4F1+6E+hwrNr7hI8uYiDX272XfsBt32XsVKn7Xabvh\napsbn9lhs+c8VXC4POrdFZNpmB2eqeH4+Mb49PsfucjK63hSEi8dC5ajD6R2mCz2\nq/RgGgrjgzOlB7nsEV8l\n=comW\n-----END PGP SIGNATURE-----\n","payload":"tree 95969ddf76810fb9d9f5e43b1336c5ba4ec07c34\nparent 1460b509f47e741bba076f1b22150bac1e9629b3\nauthor rphilizaire-openai <rphilizaire@openai.com> 1781309492 -0700\ncommitter GitHub <noreply@github.com> 1781309492 -0700\n\n[codex] add latency tracing spans (#27710)\n\n## Why\n\nWe have some large gaps in our thread start, resume, and pre-sampling\ntraces that make it hard to tell where latency is coming from.\n\n## What Changed\n\n- Added coarse spans around thread start/resume, turn context\nconstruction, rollout reconstruction, skill/plugin loading, and tool\npreparation.\n- Added a breakdown of discoverable-tool preparation across connector\nloading, plugin discovery, and local plugin details.\n\n## Testing\n\n- `cargo check -p codex-app-server -p codex-core -p codex-core-skills -p\ncodex-core-plugins`\n- Built the app-server locally and exercised thread start, first turn,\nfollow-up turn, server restart, thread resume, and a resumed turn.","verified_at":"2026-06-13T00:11:32Z"}},"url":"https://api.github.com/repos/openai/codex/commits/bacfc5e4c097894c927b5451d085fe7e489f8510","html_url":"https://github.com/openai/codex/commit/bacfc5e4c097894c927b5451d085fe7e489f8510","comments_url":"https://api.github.com/repos/openai/codex/commits/bacfc5e4c097894c927b5451d085fe7e489f8510/comments","author":{"login":"rphilizaire-openai","id":200841089,"node_id":"U_kgDOC_iXgQ","avatar_url":"https://avatars.githubusercontent.com/u/200841089?v=4","gravatar_id":"","url":"https://api.github.com/users/rphilizaire-openai","html_url":"https://github.com/rphilizaire-openai","followers_url":"https://api.github.com/users/rphilizaire-openai/followers","following_url":"https://api.github.com/users/rphilizaire-openai/following{/other_user}","gists_url":"https://api.github.com/users/rphilizaire-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/rphilizaire-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rphilizaire-openai/subscriptions","organizations_url":"https://api.github.com/users/rphilizaire-openai/orgs","repos_url":"https://api.github.com/users/rphilizaire-openai/repos","events_url":"https://api.github.com/users/rphilizaire-openai/events{/privacy}","received_events_url":"https://api.github.com/users/rphilizaire-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"1460b509f47e741bba076f1b22150bac1e9629b3","url":"https://api.github.com/repos/openai/codex/commits/1460b509f47e741bba076f1b22150bac1e9629b3","html_url":"https://github.com/openai/codex/commit/1460b509f47e741bba076f1b22150bac1e9629b3"}]},{"sha":"1460b509f47e741bba076f1b22150bac1e9629b3","node_id":"C_kwDOOYsS4doAKDE0NjBiNTA5ZjQ3ZTc0MWJiYTA3NmYxYjIyMTUwYmFjMWU5NjI5YjM","commit":{"author":{"name":"Tamir Duberstein","email":"tamird@openai.com","date":"2026-06-13T00:01:14Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-13T00:01:14Z"},"message":"[codex] stage npm packages concurrently (#27853)\n\nIn the release job from\n\nhttps://github.com/openai/codex/actions/runs/27391514823\n\nstaging the nine npm release tarballs serially took 104 seconds.\n\nEach package build writes to a separate staging directory, output path,\nand npm cache. Run them through the script's existing thread pool,\nbounded by the available CPU count. Delete each staging tree as its\nbuild finishes so concurrency does not retain all copies until the end.\n\nOn ubuntu-24.04 in\n\nhttps://github.com/openai/codex/actions/runs/27397232050\n\ntwo serial trials took 103 and 101 seconds, while concurrent trials\nboth took 41 seconds. Comparing every extracted file from the first\nserial and concurrent sets found no differences. This removes about one\nminute from every release.","tree":{"sha":"9acd8294b9e2105cb148cabeb8a4de40aa54da3d","url":"https://api.github.com/repos/openai/codex/git/trees/9acd8294b9e2105cb148cabeb8a4de40aa54da3d"},"url":"https://api.github.com/repos/openai/codex/git/commits/1460b509f47e741bba076f1b22150bac1e9629b3","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLJ3KCRC1aQ7uu5UhlAAAWvUQADC+bnoccXy+izqslSLX/kpL\n+8429OQ+J8eKH4a0f88ZvJF8LbYjfwDBCmJaBAG60Mvt8P3p+KHxqbDZSMFc5qv+\nhhDIzuCrat0ODw02JNmNOkz4TLKkAQC37sJNqXARiRkjxih0nP4HeVb6t91841uC\nkE9U6UEIpcDvjEGgJQJYCcMoTZSkHnF13eeIoZOqIZrvQJRKVcSLmeeX5BUhZ5EV\nhioVSjz/HIiApPbaA/nhSzvQ/biKe5AccD0BMEuWeifsGEe3A1rnze4c2OPPQHqp\ncmqlwgTzlvQxDCfh1F4mGwq/bSNe2tFOy7neE8cI5SSL2oERsBKdqJjr9uLXKrke\nsjJ7yNURlPrKwIYiFlisPZ6LAO0nkbiDFsYNRMbnAQTBUlt6RFlLzynZnjaH5MBn\naMDIgWxt9bTwgT+mJeluULXt12/t4Raqyq6pT9KD8dyBfVUCw+ZaZwH1aSPK4kaf\nQIUD5fbKKjT9VQ+FTgzo3WYfltfQQgIAnXSJpJYuoisovph+cU4VtSdsM0rJd3p1\n1pe5dhJeYAfetaNOAMEKJeD2X9AbqLWNDy0WqGNHRRUJiW2zZ9L84nyIlPq5v6Bv\nRqpn7AS6VNgrYzxs9MNvuiAn/Hg2HsdXkdqpB+/91LXEx/SkVo5o3JmgPx4BDLWk\nCChUVifOP5g94EBjmS7O\n=futq\n-----END PGP SIGNATURE-----\n","payload":"tree 9acd8294b9e2105cb148cabeb8a4de40aa54da3d\nparent 51483bb583a90cf36ac5da793a5a4af0ecd54c0b\nauthor Tamir Duberstein <tamird@openai.com> 1781308874 -0700\ncommitter GitHub <noreply@github.com> 1781308874 +0000\n\n[codex] stage npm packages concurrently (#27853)\n\nIn the release job from\n\nhttps://github.com/openai/codex/actions/runs/27391514823\n\nstaging the nine npm release tarballs serially took 104 seconds.\n\nEach package build writes to a separate staging directory, output path,\nand npm cache. Run them through the script's existing thread pool,\nbounded by the available CPU count. Delete each staging tree as its\nbuild finishes so concurrency does not retain all copies until the end.\n\nOn ubuntu-24.04 in\n\nhttps://github.com/openai/codex/actions/runs/27397232050\n\ntwo serial trials took 103 and 101 seconds, while concurrent trials\nboth took 41 seconds. Comparing every extracted file from the first\nserial and concurrent sets found no differences. This removes about one\nminute from every release.","verified_at":"2026-06-13T00:01:14Z"}},"url":"https://api.github.com/repos/openai/codex/commits/1460b509f47e741bba076f1b22150bac1e9629b3","html_url":"https://github.com/openai/codex/commit/1460b509f47e741bba076f1b22150bac1e9629b3","comments_url":"https://api.github.com/repos/openai/codex/commits/1460b509f47e741bba076f1b22150bac1e9629b3/comments","author":{"login":"tamird","id":1535036,"node_id":"MDQ6VXNlcjE1MzUwMzY=","avatar_url":"https://avatars.githubusercontent.com/u/1535036?v=4","gravatar_id":"","url":"https://api.github.com/users/tamird","html_url":"https://github.com/tamird","followers_url":"https://api.github.com/users/tamird/followers","following_url":"https://api.github.com/users/tamird/following{/other_user}","gists_url":"https://api.github.com/users/tamird/gists{/gist_id}","starred_url":"https://api.github.com/users/tamird/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tamird/subscriptions","organizations_url":"https://api.github.com/users/tamird/orgs","repos_url":"https://api.github.com/users/tamird/repos","events_url":"https://api.github.com/users/tamird/events{/privacy}","received_events_url":"https://api.github.com/users/tamird/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"51483bb583a90cf36ac5da793a5a4af0ecd54c0b","url":"https://api.github.com/repos/openai/codex/commits/51483bb583a90cf36ac5da793a5a4af0ecd54c0b","html_url":"https://github.com/openai/codex/commit/51483bb583a90cf36ac5da793a5a4af0ecd54c0b"}]},{"sha":"51483bb583a90cf36ac5da793a5a4af0ecd54c0b","node_id":"C_kwDOOYsS4doAKDUxNDgzYmI1ODNhOTBjZjM2YWM1ZGE3OTNhNWE0YWYwZWNkNTRjMGI","commit":{"author":{"name":"Tamir Duberstein","email":"tamird@openai.com","date":"2026-06-13T00:00:15Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-13T00:00:15Z"},"message":"[codex] parallelize Windows package archives (#27854)\n\nIn the Windows x64 packaging job from\n\nhttps://github.com/openai/codex/actions/runs/27391514823\n\nbuilding the primary and app-server package archives serially took 116\nseconds.\n\nBoth archives read the same signed-binary directory but write separate\npackage trees and output files. Run them concurrently with xargs -P2.\n\nThe package helper rewrites DotSlash executables under the process temp\ndirectory. A naive concurrent run failed when one process tried to\nreplace an executable used by the other. Give each bundle separate TMP\nand TEMP roots to keep those caches independent.\n\nOn Windows x64 in\n\nhttps://github.com/openai/codex/actions/runs/27397197944\n\nthree serial trials took 127, 128, and 126 seconds. Concurrent trials\ntook 76, 74, and 74 seconds, saving 52 to 54 seconds. This removes about\n50 seconds from the release critical path without changing the packaging\ncommands or output set.","tree":{"sha":"7b45d75a34596d3eaf541c08595703dd4577da7a","url":"https://api.github.com/repos/openai/codex/git/trees/7b45d75a34596d3eaf541c08595703dd4577da7a"},"url":"https://api.github.com/repos/openai/codex/git/commits/51483bb583a90cf36ac5da793a5a4af0ecd54c0b","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLJ2PCRC1aQ7uu5UhlAAANE0QAJBiDIP3rfhp24UNVNJcVR9S\n4R5iuwWK2hJ6DVNKl/LLZkqHqdBSI97Zy7HMQZyqdCKR7xtdqWQKyc3IKtbl3fkR\nDSqYwCtrBNWtovTWGoV4HuHJsCZOPAsb0srIWn1qC6XnCWVqSciuejMHhM670cBp\n8/HkSmBxX9NfDiSJG/Glpv91Syud2hqzeQuZuEPHkGEQ5pko3/uWHNE0v5Fs0Qdf\nFgMGUGiULXXn6JS6yZecoQePpHDv3BpbsILaIhEZZi2ykB+Par1vM9XDQvaz8qI/\n/3m4WjFbZhL+DvF97kD3Z8geHwlkE193lE1jOWBy2ZSLWxnLG6TaSEBEvVLrcQNa\nM4MhKLKfoxKwibu5Ypw7t4Y5HJOqqb85sp+oglXBMeU+N9w5B7zgMJas7QZdNlzr\n0KCgbYYjf+8vpdJEp1vT5fTPybsjjiBGQFptwfu2JqWd53Pea8eaAVf4q64HsyO0\nOJA7YNrg45AzAHvhZVeBTSU61/07mKUpnk4zXzT8p4wJ+qObTNI2bEtiHKyVo7LZ\nRgSd/IizWGxzb7P7FxT1hSSVzuT9TcyjfQUuf/ZWMtyTUmJZm/UJdURM63VplYzN\nJx5gUmBlRXRtXhl+v5Ed5UhPSZ2Qf0DppRHAs5YJWnQGifZqch2002T5bIW3fNXz\nhWvsp7puwLaAothhqEjM\n=T37d\n-----END PGP SIGNATURE-----\n","payload":"tree 7b45d75a34596d3eaf541c08595703dd4577da7a\nparent 968a3ac9c1e336b70c0b531515c7d27ac95c8601\nauthor Tamir Duberstein <tamird@openai.com> 1781308815 -0700\ncommitter GitHub <noreply@github.com> 1781308815 +0000\n\n[codex] parallelize Windows package archives (#27854)\n\nIn the Windows x64 packaging job from\n\nhttps://github.com/openai/codex/actions/runs/27391514823\n\nbuilding the primary and app-server package archives serially took 116\nseconds.\n\nBoth archives read the same signed-binary directory but write separate\npackage trees and output files. Run them concurrently with xargs -P2.\n\nThe package helper rewrites DotSlash executables under the process temp\ndirectory. A naive concurrent run failed when one process tried to\nreplace an executable used by the other. Give each bundle separate TMP\nand TEMP roots to keep those caches independent.\n\nOn Windows x64 in\n\nhttps://github.com/openai/codex/actions/runs/27397197944\n\nthree serial trials took 127, 128, and 126 seconds. Concurrent trials\ntook 76, 74, and 74 seconds, saving 52 to 54 seconds. This removes about\n50 seconds from the release critical path without changing the packaging\ncommands or output set.","verified_at":"2026-06-13T00:00:15Z"}},"url":"https://api.github.com/repos/openai/codex/commits/51483bb583a90cf36ac5da793a5a4af0ecd54c0b","html_url":"https://github.com/openai/codex/commit/51483bb583a90cf36ac5da793a5a4af0ecd54c0b","comments_url":"https://api.github.com/repos/openai/codex/commits/51483bb583a90cf36ac5da793a5a4af0ecd54c0b/comments","author":{"login":"tamird","id":1535036,"node_id":"MDQ6VXNlcjE1MzUwMzY=","avatar_url":"https://avatars.githubusercontent.com/u/1535036?v=4","gravatar_id":"","url":"https://api.github.com/users/tamird","html_url":"https://github.com/tamird","followers_url":"https://api.github.com/users/tamird/followers","following_url":"https://api.github.com/users/tamird/following{/other_user}","gists_url":"https://api.github.com/users/tamird/gists{/gist_id}","starred_url":"https://api.github.com/users/tamird/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tamird/subscriptions","organizations_url":"https://api.github.com/users/tamird/orgs","repos_url":"https://api.github.com/users/tamird/repos","events_url":"https://api.github.com/users/tamird/events{/privacy}","received_events_url":"https://api.github.com/users/tamird/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"968a3ac9c1e336b70c0b531515c7d27ac95c8601","url":"https://api.github.com/repos/openai/codex/commits/968a3ac9c1e336b70c0b531515c7d27ac95c8601","html_url":"https://github.com/openai/codex/commit/968a3ac9c1e336b70c0b531515c7d27ac95c8601"}]},{"sha":"968a3ac9c1e336b70c0b531515c7d27ac95c8601","node_id":"C_kwDOOYsS4doAKDk2OGEzYWM5YzFlMzM2YjcwYzBiNTMxNTE1YzdkMjdhYzk1Yzg2MDE","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-12T23:58:42Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T23:58:42Z"},"message":"[codex] make PathUri::from_abs_path infallible (#27976)\n\n## Why\n\n`PathUri::from_abs_path` can fail for absolute paths that do not have a\nnormal `file:` URI representation, forcing filesystem call sites to\nhandle a conversion error even though the original path can be preserved\nlosslessly.\n\n## What\n\nMake `from_abs_path` infallible and migrate its callers. Unrepresentable\npaths use `file:///%00/bad/path/<base64>`, encoding Unix bytes or\nWindows UTF-16LE; `to_abs_path` validates and decodes that fallback. The\nleading encoded null reserves a namespace that cannot collide with a\nreal Unix or Windows path, and fallback URIs remain opaque to lexical\npath operations.\n\n## Validation\n\nAdded path-URI coverage for Unix null and non-UTF-8 paths, Windows\ndevice/verbatim and non-Unicode paths, serialization, malformed\nfallbacks, opaque lexical operations, invalid native payloads, and\nliteral `/bad/path` collision resistance.","tree":{"sha":"d55ebcce69d4655c2f6c00a5e7569d3bd661bfd9","url":"https://api.github.com/repos/openai/codex/git/trees/d55ebcce69d4655c2f6c00a5e7569d3bd661bfd9"},"url":"https://api.github.com/repos/openai/codex/git/commits/968a3ac9c1e336b70c0b531515c7d27ac95c8601","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLJ0yCRC1aQ7uu5UhlAAAY54QACOBjtiA9/C0Aoeo86aaloia\ne7e1sWbFojYqwHhwDlTquefMsCCRaTKYzOzY8Cs/hlJ2+VlokK6eGuCpf105d3Ud\nt0h5vhZNwqJ/kHphkdTLXN4T2fVUedCr0rb2FY98sfAIOpnZawp+na1ogAdP0Xbc\niZJaqniwgVxbjkVTQHPSBE/esN0xJQhtUeHxEK8RVQu3QLqsCrQGZ42Ikohjgx4X\nh3es8ou9WybWu7GPxE7TZ0MO3AUjsD63zA7WHs2OJRb1dwSD+B3D5as7w8ZlVoaT\nKujUZaDVXGq28f3LvfYO3C6c76INlUqAkYHQFqk27owpw2RLCMzvn2XpUcidOeCl\npt+pk8g+PxjU+B4xg19Z6kNp+yFldvmVwvKFH3GBjKN1syLEwqm0Lp8yj24AjRZ4\nXl3D0KkRLNtLOzoNUqVBD4c8R6535dJEz9MLUaL/ag6souNWrgMuE/T3OLzJD/nb\nLVCuqP7JsK7klq1TAmsVal5EBg1nFCrH6/I6nRPLX8f9EbF4Y1+xGT/FnD52opLl\nUMLDoROC3gmu0DakT0h4Gi5dBeNVTQXA/WtAf+knTdYE5Lh+uWTG03UDUxGz5DTT\nk6/Fasqjlobq2z3rq87AppGyEurDxUmyP/yr02HaqOjrlkfLRMJUib9Py8E5gARz\nac4MuX32OAiizlMbdy27\n=p7Ph\n-----END PGP SIGNATURE-----\n","payload":"tree d55ebcce69d4655c2f6c00a5e7569d3bd661bfd9\nparent eb46984aaaae0b7bbe8351c864cfe09855ee705a\nauthor Adam Perry @ OpenAI <anp@openai.com> 1781308722 -0700\ncommitter GitHub <noreply@github.com> 1781308722 -0700\n\n[codex] make PathUri::from_abs_path infallible (#27976)\n\n## Why\n\n`PathUri::from_abs_path` can fail for absolute paths that do not have a\nnormal `file:` URI representation, forcing filesystem call sites to\nhandle a conversion error even though the original path can be preserved\nlosslessly.\n\n## What\n\nMake `from_abs_path` infallible and migrate its callers. Unrepresentable\npaths use `file:///%00/bad/path/<base64>`, encoding Unix bytes or\nWindows UTF-16LE; `to_abs_path` validates and decodes that fallback. The\nleading encoded null reserves a namespace that cannot collide with a\nreal Unix or Windows path, and fallback URIs remain opaque to lexical\npath operations.\n\n## Validation\n\nAdded path-URI coverage for Unix null and non-UTF-8 paths, Windows\ndevice/verbatim and non-Unicode paths, serialization, malformed\nfallbacks, opaque lexical operations, invalid native payloads, and\nliteral `/bad/path` collision resistance.","verified_at":"2026-06-12T23:58:42Z"}},"url":"https://api.github.com/repos/openai/codex/commits/968a3ac9c1e336b70c0b531515c7d27ac95c8601","html_url":"https://github.com/openai/codex/commit/968a3ac9c1e336b70c0b531515c7d27ac95c8601","comments_url":"https://api.github.com/repos/openai/codex/commits/968a3ac9c1e336b70c0b531515c7d27ac95c8601/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"eb46984aaaae0b7bbe8351c864cfe09855ee705a","url":"https://api.github.com/repos/openai/codex/commits/eb46984aaaae0b7bbe8351c864cfe09855ee705a","html_url":"https://github.com/openai/codex/commit/eb46984aaaae0b7bbe8351c864cfe09855ee705a"}]},{"sha":"eb46984aaaae0b7bbe8351c864cfe09855ee705a","node_id":"C_kwDOOYsS4doAKGViNDY5ODRhYWFhZTBiN2JiZTgzNTFjODY0Y2ZlMDk4NTVlZTcwNWE","commit":{"author":{"name":"Tamir Duberstein","email":"tamird@openai.com","date":"2026-06-12T23:52:23Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T23:52:23Z"},"message":"[codex] package Windows symbols in parallel (#27856)\n\nIn the x64 packaging job from\n\nhttps://github.com/openai/codex/actions/runs/27391514823\n\narchiving and uploading PDBs took 65 seconds after signing. Release\npackaging could not start until that work completed.\n\nWindows code signing changes executables but not their PDBs. Package\nthe PDBs in a sibling Ubuntu job as soon as all binary artifacts are\navailable. Signing and release packaging can then proceed without\nwaiting for the symbols archive, reducing the critical path by about\none minute.","tree":{"sha":"89d43d723b0357ce13a6d73bfbf506afc9d451ca","url":"https://api.github.com/repos/openai/codex/git/trees/89d43d723b0357ce13a6d73bfbf506afc9d451ca"},"url":"https://api.github.com/repos/openai/codex/git/commits/eb46984aaaae0b7bbe8351c864cfe09855ee705a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLJu3CRC1aQ7uu5UhlAAAQDMQAAcNdx2Jp2BZ9lCrUw21Ef6V\ndB8nz0vx/KFSi5S4KPQGxH/o4w+bqFWTmiNloKvf57pJaqyfDfiAT/kqCvlNg2M5\nl3/3RNZ5Mkh4gjt0EiolltShSXSGpm4Yqk0pOFLb+zrrcIgASE1DfsojxeaLp8tN\nNjlRuEEGS+mKtlKB9b628sWEpOCyCXN3dDc+YiKhWkUgoDBHdmJg9NnS1JP/5Xtt\nd6YbXPiXeeT0ADtgaM43HhoQKynQjlY3nvcyIBM+xzicP9Tn1AlTDw92zv8yxB9C\nTa+vlCfs3xGWp2jDkB9UAnsdxgSMCTuhV08sIm1qAP3FpS1uNe0xSCsbnXYtA/Dr\nNLSocVgS23bZ74NOAGmTuHJASsD9VVI4xPjcQ5kP5rzSG6Mq9KnnTnQ3XHI/DWK7\ncA8Hd2zNydfVurYjnZVwPyrnNIXRYxJoFZpKa3o0rILCHQGyHO7tXJd9BPFxqgzd\nRwdl3lRLzCfKX7fzdJBc9Ublu+KtQQxNisodDBSIi4sdQ59OsxdWAjKw5sB7sPNh\nOGaX9yEgnTMyMAhUJ+IyTBURDaE+DKWy/ENqtB7ugO/fPV76nOXpFsj0FeXPW184\nJVutT1xO6YA2WEVCW3SOVGciyqYdm1gGTiz9ssrKs4KmTN2ArIxKty7dpb7LzuTM\nTjXRtjLmtNpzyPqB55F0\n=/fFC\n-----END PGP SIGNATURE-----\n","payload":"tree 89d43d723b0357ce13a6d73bfbf506afc9d451ca\nparent 7ebd10783b61d59ba499597a741446a20cc716dd\nauthor Tamir Duberstein <tamird@openai.com> 1781308343 -0700\ncommitter GitHub <noreply@github.com> 1781308343 -0700\n\n[codex] package Windows symbols in parallel (#27856)\n\nIn the x64 packaging job from\n\nhttps://github.com/openai/codex/actions/runs/27391514823\n\narchiving and uploading PDBs took 65 seconds after signing. Release\npackaging could not start until that work completed.\n\nWindows code signing changes executables but not their PDBs. Package\nthe PDBs in a sibling Ubuntu job as soon as all binary artifacts are\navailable. Signing and release packaging can then proceed without\nwaiting for the symbols archive, reducing the critical path by about\none minute.","verified_at":"2026-06-12T23:52:24Z"}},"url":"https://api.github.com/repos/openai/codex/commits/eb46984aaaae0b7bbe8351c864cfe09855ee705a","html_url":"https://github.com/openai/codex/commit/eb46984aaaae0b7bbe8351c864cfe09855ee705a","comments_url":"https://api.github.com/repos/openai/codex/commits/eb46984aaaae0b7bbe8351c864cfe09855ee705a/comments","author":{"login":"tamird","id":1535036,"node_id":"MDQ6VXNlcjE1MzUwMzY=","avatar_url":"https://avatars.githubusercontent.com/u/1535036?v=4","gravatar_id":"","url":"https://api.github.com/users/tamird","html_url":"https://github.com/tamird","followers_url":"https://api.github.com/users/tamird/followers","following_url":"https://api.github.com/users/tamird/following{/other_user}","gists_url":"https://api.github.com/users/tamird/gists{/gist_id}","starred_url":"https://api.github.com/users/tamird/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tamird/subscriptions","organizations_url":"https://api.github.com/users/tamird/orgs","repos_url":"https://api.github.com/users/tamird/repos","events_url":"https://api.github.com/users/tamird/events{/privacy}","received_events_url":"https://api.github.com/users/tamird/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7ebd10783b61d59ba499597a741446a20cc716dd","url":"https://api.github.com/repos/openai/codex/commits/7ebd10783b61d59ba499597a741446a20cc716dd","html_url":"https://github.com/openai/codex/commit/7ebd10783b61d59ba499597a741446a20cc716dd"}]},{"sha":"7ebd10783b61d59ba499597a741446a20cc716dd","node_id":"C_kwDOOYsS4doAKDdlYmQxMDc4M2I2MWQ1OWJhNDk5NTk3YTc0MTQ0NmEyMGNjNzE2ZGQ","commit":{"author":{"name":"pakrym-oai","email":"pakrym@openai.com","date":"2026-06-12T23:37:14Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T23:37:14Z"},"message":"[codex] Let generic test turns inherit their environment (#27972)\n\n## Why\n\nThe paired thread-environment migration changed several generic test\nturn helpers from supplying a fallback cwd to explicitly selecting the\nlocal environment. That changes their meaning under\n`build_with_remote_env()`: remote-only fixtures cannot resolve the\nforced local selection, so the tests fail before exercising apply-patch,\nRMCP, unified-exec, or view-image behavior.\n\nGeneric helpers should inherit the environment selected by their\nfixture. Tests that intentionally exercise local routing continue to\nselect the local environment explicitly.\n\n## What changed\n\n- Remove forced `local_selections(...)` overrides from the generic\napply-patch, RMCP, unified-exec, and view-image turn helpers.\n- Remove the imports made unused by those deletions.\n\n## Testing\n\n- Not run locally; this is a test-fixture-only change and the `full-ci`\nbranch will exercise the affected remote shards.","tree":{"sha":"c027cf2eea4d3c9f2479bf6f49b7dc0a0fa0990b","url":"https://api.github.com/repos/openai/codex/git/trees/c027cf2eea4d3c9f2479bf6f49b7dc0a0fa0990b"},"url":"https://api.github.com/repos/openai/codex/git/commits/7ebd10783b61d59ba499597a741446a20cc716dd","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLJgqCRC1aQ7uu5UhlAAABy4QAFb/l800nnbjVE44NpolaxG3\n8tZQPbk1bP6N6cvnGDY1cppxRHuBDfj4FyiSpYPY/YeAiSl4iOsUhwtrqSed3TCq\nwiqFUtD8W3Muje2vFG+FKv+UD7TZq2JDUmqqva1lLicDB5NnahNVAhhmKZeZ5l6e\nK0i2o/w4uS7gN7HUCs6dXf+SNS2OAKW0LE48do72dfiBjtnX9iZ5iBXDpqRWocO/\nquhHUvcazypyHF0oTkhFQU6kMszeXBMrxIyPXBNRABkuypd4fx5sIEQ9EtlrzPwF\nJmfmAuzasWfRq1NnI3UXRvo+LSnUQQeonXHtE4hyidfJJdlIabH+jM22pEeUqLwv\nnJq4PKBIGYsQpnLD01PtkPqjPt18Id40b5Cw6J3fhwHAnRSptjvVbVpLb35RmMFG\n84vNX0wKLPyamL7Rl+lXPrifFV9fd00mwSa9SOu/Sgi3rN6akBQDstEdi9PGLtFL\nYkIPtS4RdyRfsB7fCckCmd+rz+VY7hLjOAqGfG/MUoGwTzeQjaOIh5Sptw/s6rvs\n22zK9Me6Nmzo2o2pSsU0qGZ3d7dQVLvhz3mousrHyK4EbEWB/8/LZQqJccrM7o/B\npIFxpStSj9cePaFruPSa9KrqKwZrPEXw5oAqd0IfqRzQC8EweUaUxYpLcxL1KPs2\nV0PHdm9vDZOxbCld3qIs\n=Hu7b\n-----END PGP SIGNATURE-----\n","payload":"tree c027cf2eea4d3c9f2479bf6f49b7dc0a0fa0990b\nparent 1bd6b4c41a1ed5ed412eae9a59b95c4ee25e9860\nauthor pakrym-oai <pakrym@openai.com> 1781307434 -0700\ncommitter GitHub <noreply@github.com> 1781307434 -0700\n\n[codex] Let generic test turns inherit their environment (#27972)\n\n## Why\n\nThe paired thread-environment migration changed several generic test\nturn helpers from supplying a fallback cwd to explicitly selecting the\nlocal environment. That changes their meaning under\n`build_with_remote_env()`: remote-only fixtures cannot resolve the\nforced local selection, so the tests fail before exercising apply-patch,\nRMCP, unified-exec, or view-image behavior.\n\nGeneric helpers should inherit the environment selected by their\nfixture. Tests that intentionally exercise local routing continue to\nselect the local environment explicitly.\n\n## What changed\n\n- Remove forced `local_selections(...)` overrides from the generic\napply-patch, RMCP, unified-exec, and view-image turn helpers.\n- Remove the imports made unused by those deletions.\n\n## Testing\n\n- Not run locally; this is a test-fixture-only change and the `full-ci`\nbranch will exercise the affected remote shards.","verified_at":"2026-06-12T23:37:14Z"}},"url":"https://api.github.com/repos/openai/codex/commits/7ebd10783b61d59ba499597a741446a20cc716dd","html_url":"https://github.com/openai/codex/commit/7ebd10783b61d59ba499597a741446a20cc716dd","comments_url":"https://api.github.com/repos/openai/codex/commits/7ebd10783b61d59ba499597a741446a20cc716dd/comments","author":{"login":"pakrym-oai","id":204937752,"node_id":"U_kgDODDcaGA","avatar_url":"https://avatars.githubusercontent.com/u/204937752?v=4","gravatar_id":"","url":"https://api.github.com/users/pakrym-oai","html_url":"https://github.com/pakrym-oai","followers_url":"https://api.github.com/users/pakrym-oai/followers","following_url":"https://api.github.com/users/pakrym-oai/following{/other_user}","gists_url":"https://api.github.com/users/pakrym-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/pakrym-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pakrym-oai/subscriptions","organizations_url":"https://api.github.com/users/pakrym-oai/orgs","repos_url":"https://api.github.com/users/pakrym-oai/repos","events_url":"https://api.github.com/users/pakrym-oai/events{/privacy}","received_events_url":"https://api.github.com/users/pakrym-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"1bd6b4c41a1ed5ed412eae9a59b95c4ee25e9860","url":"https://api.github.com/repos/openai/codex/commits/1bd6b4c41a1ed5ed412eae9a59b95c4ee25e9860","html_url":"https://github.com/openai/codex/commit/1bd6b4c41a1ed5ed412eae9a59b95c4ee25e9860"}]},{"sha":"1bd6b4c41a1ed5ed412eae9a59b95c4ee25e9860","node_id":"C_kwDOOYsS4doAKDFiZDZiNGM0MWExZWQ1ZWQ0MTJlYWU5YTU5Yjk1YzRlZTI1ZTk4NjA","commit":{"author":{"name":"canvrno-oai","email":"kbond@openai.com","date":"2026-06-12T23:29:40Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T23:29:40Z"},"message":"Promote TUI unified mentions in composer to default mentions feature (#27499)\n\n## Summary\n\nThis PR promotes Mentions 2.0 (unified TUI mention popup) to stable and\nenables it by default.\n\n- Keep `mentions_v2` as a temporary rollback path to the legacy split\npopups (`--disable mentions_v2`).\n- Add feature-default and snapshot coverage for the default experience.\n\n## Prior work\n\n- [#19068 — Unified mentions in\nTUI](https://github.com/openai/codex/pull/19068)\n- [#22375 — Use plugin/list to get plugins for\nmentions](https://github.com/openai/codex/pull/22375)\n- [#23363 — Unified mentions tweaks and rendering\npolish](https://github.com/openai/codex/pull/23363)\n\n## Test plan\n\n- Launch Codex without any feature overrides.\n- Type `@` in the TUI composer.\n- Confirm the unified mentions menu opens and displays filesystem,\nplugin, and skill results.","tree":{"sha":"ee52cd3f04a44ff764e7f6ad235dfc68811f196e","url":"https://api.github.com/repos/openai/codex/git/trees/ee52cd3f04a44ff764e7f6ad235dfc68811f196e"},"url":"https://api.github.com/repos/openai/codex/git/commits/1bd6b4c41a1ed5ed412eae9a59b95c4ee25e9860","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLJZkCRC1aQ7uu5UhlAAAS1oQACZHvlR9rDzw+ZYPg8oOTyFX\nTKaP6HtW2AZfYg974Vb2b4cGQqxVXu+vq/H36B77eu6wzTg9njPFC23NjPse1oep\nEJy4a9GgKuViE6DhRIuUO29AIna5fGTUQn4bzSUm8ZMSsU9w3MsLnJYWSZ6FX+lK\nE9o5v944XHVyPvcAnrSLUteCnTcJVNDu50CvJRvOcAdaMlD2ookipek79TLqqZsd\nE3C4aeUx80tMtSUkCCW2kTLQgJdOp7UY+WJAz6jYxoztFtqYMc7oM9VVpNV8wTNb\n9WHVHSABZx+su0vejDd0LEgrMPQE7v5Inb9Ha9Wag68+wmj670icO4RVNxUKwMNU\nUD7bnE8kbiGnzEIp5JZLo+v85q1eFQHg72anRxmIwwtTiWi77CXEZQ1E+eO4cUmG\njeQO7YKL6X6JvS6zi7fEUCv5RFg0Im3MM/fMtr0InxFxXYGHy7zWd8meA4iCjjMG\nYFUfCmAYU7zJlw2P+obl93kZAYmT4VCrO88EG8N+eZnOSHwzvum0fKzf/jrPU60i\nuHvFYJB4K75OVOmjNqxoShpuVWtZl5oE6DDoJFxw5EcgXq7GAOzs1kBkjYooJTsP\n2epSryUpHAnOVQzHgVTicN4N4/decKR6tpWUk1PkXzF/lhpqpXJ6OXLM6QwWvhtw\ndkqQvTOMW1li+TjjeiRj\n=0tVY\n-----END PGP SIGNATURE-----\n","payload":"tree ee52cd3f04a44ff764e7f6ad235dfc68811f196e\nparent 5c48e319543f9e567611d95cf4c56284220bd7f5\nauthor canvrno-oai <kbond@openai.com> 1781306980 -0700\ncommitter GitHub <noreply@github.com> 1781306980 -0700\n\nPromote TUI unified mentions in composer to default mentions feature (#27499)\n\n## Summary\n\nThis PR promotes Mentions 2.0 (unified TUI mention popup) to stable and\nenables it by default.\n\n- Keep `mentions_v2` as a temporary rollback path to the legacy split\npopups (`--disable mentions_v2`).\n- Add feature-default and snapshot coverage for the default experience.\n\n## Prior work\n\n- [#19068 — Unified mentions in\nTUI](https://github.com/openai/codex/pull/19068)\n- [#22375 — Use plugin/list to get plugins for\nmentions](https://github.com/openai/codex/pull/22375)\n- [#23363 — Unified mentions tweaks and rendering\npolish](https://github.com/openai/codex/pull/23363)\n\n## Test plan\n\n- Launch Codex without any feature overrides.\n- Type `@` in the TUI composer.\n- Confirm the unified mentions menu opens and displays filesystem,\nplugin, and skill results.","verified_at":"2026-06-12T23:29:41Z"}},"url":"https://api.github.com/repos/openai/codex/commits/1bd6b4c41a1ed5ed412eae9a59b95c4ee25e9860","html_url":"https://github.com/openai/codex/commit/1bd6b4c41a1ed5ed412eae9a59b95c4ee25e9860","comments_url":"https://api.github.com/repos/openai/codex/commits/1bd6b4c41a1ed5ed412eae9a59b95c4ee25e9860/comments","author":{"login":"canvrno-oai","id":257630656,"node_id":"U_kgDOD1shwA","avatar_url":"https://avatars.githubusercontent.com/u/257630656?v=4","gravatar_id":"","url":"https://api.github.com/users/canvrno-oai","html_url":"https://github.com/canvrno-oai","followers_url":"https://api.github.com/users/canvrno-oai/followers","following_url":"https://api.github.com/users/canvrno-oai/following{/other_user}","gists_url":"https://api.github.com/users/canvrno-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/canvrno-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/canvrno-oai/subscriptions","organizations_url":"https://api.github.com/users/canvrno-oai/orgs","repos_url":"https://api.github.com/users/canvrno-oai/repos","events_url":"https://api.github.com/users/canvrno-oai/events{/privacy}","received_events_url":"https://api.github.com/users/canvrno-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"5c48e319543f9e567611d95cf4c56284220bd7f5","url":"https://api.github.com/repos/openai/codex/commits/5c48e319543f9e567611d95cf4c56284220bd7f5","html_url":"https://github.com/openai/codex/commit/5c48e319543f9e567611d95cf4c56284220bd7f5"}]},{"sha":"5c48e319543f9e567611d95cf4c56284220bd7f5","node_id":"C_kwDOOYsS4doAKDVjNDhlMzE5NTQzZjllNTY3NjExZDk1Y2Y0YzU2Mjg0MjIwYmQ3ZjU","commit":{"author":{"name":"Tamir Duberstein","email":"tamird@openai.com","date":"2026-06-12T23:26:39Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T23:26:39Z"},"message":"[codex] parallelize Windows compression (#27855)\n\nEach Windows packaging job creates three compressed forms of five\nbinaries in sequence. This takes roughly two minutes and is on the\nrelease critical path.\n\nUse two xargs workers to compress independent binaries concurrently.\nThe workers only read the raw executables and write per-binary archive\nnames. The Codex zip can safely read the helper executables while their\nown archives are generated.\n\nOn a 16-vCPU AMD EPYC 9V74 Windows x64 release runner, alternating\ntrials against artifacts from release run 27391514823 measured:\n\n  serial:   121 s, 123 s, 121 s\n  parallel:  73 s,  73 s,  74 s\n\nThis saves 47 to 50 seconds in the x64 packaging lane, reducing the\nobserved release critical path by about 48 seconds when x64 remains the\nlimiting lane.\n\nhttps://github.com/openai/codex/actions/runs/27401905938","tree":{"sha":"31dd4c5e4462520e218bc75cf0c7af44cbee687c","url":"https://api.github.com/repos/openai/codex/git/trees/31dd4c5e4462520e218bc75cf0c7af44cbee687c"},"url":"https://api.github.com/repos/openai/codex/git/commits/5c48e319543f9e567611d95cf4c56284220bd7f5","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLJWvCRC1aQ7uu5UhlAAA28IQABug56nTPkoo2OezimD+IZn0\nvMHSuqudmV4MQIgvGKiYE+yG0j8Rs391v9jEPs2f/+ackObeCWvDxyOjNXJfgTj9\nN34h4XsdJrdhUKOPARdtXBb7I4nXSb2X0MoLWrU+f0kV9MuSlXzqDXZk3DlT3XCb\nJAbHRBIAnj07lvrUE6AuQiIzGTHjDKlah/nlndRHaHd8AXf8jRpq0sK1gvkqg/Sf\nlxbohGG++BVVCh5GQ7HGAopPBQyihlMVXI+vSXdmtWpLJpCVll/EuEpQ2sEPwci/\nED+s/CyzCj1QX0rD4sRyvjbTmneBqQNyUGXN18AxrH9B+gPajwqWZKwIkJHSCRiY\n9pujgZeiR2eg7+P4ROOUrFuHMXTgT3dpV5k75Y0wqex5fNDOADFrPSpas4LMFy78\n7RTvHTEl/7T+fQFvfHTiTxnT/GCyMsAO6V8lXA2/hSX9qJ2WEgSKiA3/KeFFy+hn\nYTxDIS9vZub8qyEQmbg4u5fd3GVWEUQqI4fKycSbSRNDx0ftrx9NHAhz8B43BlRw\nLRa4rB+4qoiFUFwUZVcD/ypNwdJHaFMrrQSQo6za8TlzMUmZ6EwyXpH0pRRN0H8m\nnAloKMduRB3wC5VqXmBrthhVO4qWuF2H2WskHM3BYppOTttII1PUga+Nod4GOCwh\nUNpepzUt5mhmutd8pJbQ\n=5wAQ\n-----END PGP SIGNATURE-----\n","payload":"tree 31dd4c5e4462520e218bc75cf0c7af44cbee687c\nparent fdd72e9cd9a952e14bc123d2c8cd13d950c1928a\nauthor Tamir Duberstein <tamird@openai.com> 1781306799 -0700\ncommitter GitHub <noreply@github.com> 1781306799 -0700\n\n[codex] parallelize Windows compression (#27855)\n\nEach Windows packaging job creates three compressed forms of five\nbinaries in sequence. This takes roughly two minutes and is on the\nrelease critical path.\n\nUse two xargs workers to compress independent binaries concurrently.\nThe workers only read the raw executables and write per-binary archive\nnames. The Codex zip can safely read the helper executables while their\nown archives are generated.\n\nOn a 16-vCPU AMD EPYC 9V74 Windows x64 release runner, alternating\ntrials against artifacts from release run 27391514823 measured:\n\n  serial:   121 s, 123 s, 121 s\n  parallel:  73 s,  73 s,  74 s\n\nThis saves 47 to 50 seconds in the x64 packaging lane, reducing the\nobserved release critical path by about 48 seconds when x64 remains the\nlimiting lane.\n\nhttps://github.com/openai/codex/actions/runs/27401905938","verified_at":"2026-06-12T23:26:40Z"}},"url":"https://api.github.com/repos/openai/codex/commits/5c48e319543f9e567611d95cf4c56284220bd7f5","html_url":"https://github.com/openai/codex/commit/5c48e319543f9e567611d95cf4c56284220bd7f5","comments_url":"https://api.github.com/repos/openai/codex/commits/5c48e319543f9e567611d95cf4c56284220bd7f5/comments","author":{"login":"tamird","id":1535036,"node_id":"MDQ6VXNlcjE1MzUwMzY=","avatar_url":"https://avatars.githubusercontent.com/u/1535036?v=4","gravatar_id":"","url":"https://api.github.com/users/tamird","html_url":"https://github.com/tamird","followers_url":"https://api.github.com/users/tamird/followers","following_url":"https://api.github.com/users/tamird/following{/other_user}","gists_url":"https://api.github.com/users/tamird/gists{/gist_id}","starred_url":"https://api.github.com/users/tamird/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tamird/subscriptions","organizations_url":"https://api.github.com/users/tamird/orgs","repos_url":"https://api.github.com/users/tamird/repos","events_url":"https://api.github.com/users/tamird/events{/privacy}","received_events_url":"https://api.github.com/users/tamird/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"fdd72e9cd9a952e14bc123d2c8cd13d950c1928a","url":"https://api.github.com/repos/openai/codex/commits/fdd72e9cd9a952e14bc123d2c8cd13d950c1928a","html_url":"https://github.com/openai/codex/commit/fdd72e9cd9a952e14bc123d2c8cd13d950c1928a"}]},{"sha":"fdd72e9cd9a952e14bc123d2c8cd13d950c1928a","node_id":"C_kwDOOYsS4doAKGZkZDcyZTljZDlhOTUyZTE0YmMxMjNkMmM4Y2QxM2Q5NTBjMTkyOGE","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-12T23:25:58Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T23:25:58Z"},"message":"Specify platform support in AGENTS.md (#27966)\n\nCodex seems to do interesting things with `cfg`'s sometimes and it seems\nit would be good to give it guidance about how broadly our Rust needs to\nwork.\n\nThis adds a very brief section to AGENTS.md explaining that we target\nthe major desktop OSes and that we want the vast majority of our logic\nto be portable across them.","tree":{"sha":"6b6e6696c8b1baf8fef87217afe5bd59b6df6b99","url":"https://api.github.com/repos/openai/codex/git/trees/6b6e6696c8b1baf8fef87217afe5bd59b6df6b99"},"url":"https://api.github.com/repos/openai/codex/git/commits/fdd72e9cd9a952e14bc123d2c8cd13d950c1928a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLJWGCRC1aQ7uu5UhlAAAiUwQAC8oVqWkwrYAeIfTPCAZZad5\nPPTHXhF2ZU9KvQ+cMbhYfVCbnt87rp/QTZUG3b/PVkifesG98Lr+NNHVgu4ZLRJx\n/uGnqpGSU+yKCjGdbc9KJUb4oSVHZAaDI5QHT99/If2eG89OJx8+wKhODILXd8t8\nrxVGjTTsZOH7v/iL90mQkRtTi9blVjKXg8OLzenws4kPWemN6+FHbRtuA4CQHA5r\nY0LiqFmwhzfEn20bKJrVWumTRTztdfwvFy4NdEyTvcU1+cn5LehFcABKKoXsHyjU\n+kRXgCsTaNYOpaXAqqb7nhS3Gk3+R2DIUn4Xh+Nz801a9cT49bwB6gJ3EqY6QKmM\nWMMQgkakzvH7Z19Czp05qjry0tBqQncAcLdI4pscKX0JKLX+Stkt2I8nARXePENO\nQmICrpVzEsoMeuCoMC8Mos/wKeYpdbLrE8iL76rtEcclI0EosF5VtBM4KpySl7cW\nltS521UhkUuVaxP7yjCToOekQUftau0Tx/Zrh38zUrojpy9/xN5bpLfn8OwBbauK\nVR115401g+gx7EUnu9w+sWdupfyZxBjyVrUIZDy3NbDb+BEUj1I8UEohLKf4qwWB\n7w6dN5PmGmZjQwE63PAmnz6GXco3RlYBuH3FPtO4/Hf4ynHk/gFsV6W0YHnazKso\nb2ZDcSqQSmH5we4MiJiz\n=7aVu\n-----END PGP SIGNATURE-----\n","payload":"tree 6b6e6696c8b1baf8fef87217afe5bd59b6df6b99\nparent 0605f9c14f2d962044d289f4fe465771a152175a\nauthor Adam Perry @ OpenAI <anp@openai.com> 1781306758 -0700\ncommitter GitHub <noreply@github.com> 1781306758 +0000\n\nSpecify platform support in AGENTS.md (#27966)\n\nCodex seems to do interesting things with `cfg`'s sometimes and it seems\nit would be good to give it guidance about how broadly our Rust needs to\nwork.\n\nThis adds a very brief section to AGENTS.md explaining that we target\nthe major desktop OSes and that we want the vast majority of our logic\nto be portable across them.","verified_at":"2026-06-12T23:25:59Z"}},"url":"https://api.github.com/repos/openai/codex/commits/fdd72e9cd9a952e14bc123d2c8cd13d950c1928a","html_url":"https://github.com/openai/codex/commit/fdd72e9cd9a952e14bc123d2c8cd13d950c1928a","comments_url":"https://api.github.com/repos/openai/codex/commits/fdd72e9cd9a952e14bc123d2c8cd13d950c1928a/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"0605f9c14f2d962044d289f4fe465771a152175a","url":"https://api.github.com/repos/openai/codex/commits/0605f9c14f2d962044d289f4fe465771a152175a","html_url":"https://github.com/openai/codex/commit/0605f9c14f2d962044d289f4fe465771a152175a"}]},{"sha":"0605f9c14f2d962044d289f4fe465771a152175a","node_id":"C_kwDOOYsS4doAKDA2MDVmOWMxNGYyZDk2MjA0NGQyODlmNGZlNDY1NzcxYTE1MjE3NWE","commit":{"author":{"name":"Won Park","email":"won@openai.com","date":"2026-06-12T22:50:30Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T22:50:30Z"},"message":"Add Guardian catalog diagnostics metadata (#27109)\n\n## Why\n\nWe need request-level evidence for Guardian cases where\n`codex-auto-review` is missing from the client-side model catalog and\nthe review falls back to the parent model.\n\n## What changed\n\n- Add `guardian_catalog_contains_auto_review` to Guardian Responses API\nclient metadata.\n- Add `guardian_model_provider_id` to Guardian Responses API client\nmetadata.\n- Keep review-session metadata optional so callers without metadata\npreserve the existing `None` path.\n- Add tests for override, normal preferred-model, and\nmissing-auto-review-catalog behavior.\n\n## Validation\n\n- `just test -p codex-core\nguardian_review_records_missing_auto_review_model_in_request_metadata`\n- `just test -p codex-core\nguardian_review_uses_model_catalog_override_when_preferred_review_model_exists`\n- `just test -p codex-core\nguardian_review_uses_preferred_review_model_without_model_catalog_override`\n- `git diff --check origin/main`","tree":{"sha":"65769aab497e95abf51375841c2b843ac27ea19c","url":"https://api.github.com/repos/openai/codex/git/trees/65769aab497e95abf51375841c2b843ac27ea19c"},"url":"https://api.github.com/repos/openai/codex/git/commits/0605f9c14f2d962044d289f4fe465771a152175a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLI02CRC1aQ7uu5UhlAAAE5UQAFRtd3kLcRD3QdRmoG06Z/ou\n80gV1f7NT1ZKdCeTFvewAaX05RE2ROCHP5I7EMHPqYHhigtjhl6xb6pmnWefvlrv\nMTHbzf3Ie5BtLMuswRVLVpYDoHbwUBMtDWHU2bxEQqu38n/hMtmOSUG7yjuYNVVy\nlaZYY+U02XQ4YjlTK5ChCN/GKV269aFvmYhdAidwCRNvb3GwZRJRtkWcvdmGCMeA\nBIdsc7SCkmHAfx7TdN8MCDP+frD1o/Ilk9OyIAEVk3XrdhFtMsF33FXe0detxHhs\neZ/mmqb6QKDsoq/ZNiez9HcLtyjuaSAempEd7SsrbROYFM+/F0nABvb8g9F2Pr5p\nrL2lB6opgX5on7nMe/fFcsrEy7lDiipbVRSR1Ti3gT+YQars22pLCH/UD8LLFKYo\nY8vU6jzMoquqVN4kspihv+VH7zDXt7zd+8pzP9lsq4TZKHlqWWQROI+V72HDnxTW\ngH50vOr1BS5stTys8Ac7uQF+uBVdb3iw2CGtTf+BSNA9BYJ+PYgXPLlwJYnHHmJG\nTRA1T4znWh9ZOl5tjzvQnpgwcx+aJ1M1Dm1E6IalJzSbSIPaFsvc34F12HaUxfEJ\niSfKb7U3hwZwRUqIuqNkbkn4xk513kOv2l4IbfInkgs8BZA6iDsPdl9x2BBgH7bn\n2BFl/DhMpxerRaQ/t26+\n=mjc1\n-----END PGP SIGNATURE-----\n","payload":"tree 65769aab497e95abf51375841c2b843ac27ea19c\nparent c0f1ec5afdc1102617611560bfc22063fe11108f\nauthor Won Park <won@openai.com> 1781304630 -0700\ncommitter GitHub <noreply@github.com> 1781304630 -0700\n\nAdd Guardian catalog diagnostics metadata (#27109)\n\n## Why\n\nWe need request-level evidence for Guardian cases where\n`codex-auto-review` is missing from the client-side model catalog and\nthe review falls back to the parent model.\n\n## What changed\n\n- Add `guardian_catalog_contains_auto_review` to Guardian Responses API\nclient metadata.\n- Add `guardian_model_provider_id` to Guardian Responses API client\nmetadata.\n- Keep review-session metadata optional so callers without metadata\npreserve the existing `None` path.\n- Add tests for override, normal preferred-model, and\nmissing-auto-review-catalog behavior.\n\n## Validation\n\n- `just test -p codex-core\nguardian_review_records_missing_auto_review_model_in_request_metadata`\n- `just test -p codex-core\nguardian_review_uses_model_catalog_override_when_preferred_review_model_exists`\n- `just test -p codex-core\nguardian_review_uses_preferred_review_model_without_model_catalog_override`\n- `git diff --check origin/main`","verified_at":"2026-06-12T22:50:30Z"}},"url":"https://api.github.com/repos/openai/codex/commits/0605f9c14f2d962044d289f4fe465771a152175a","html_url":"https://github.com/openai/codex/commit/0605f9c14f2d962044d289f4fe465771a152175a","comments_url":"https://api.github.com/repos/openai/codex/commits/0605f9c14f2d962044d289f4fe465771a152175a/comments","author":{"login":"won-openai","id":262224683,"node_id":"U_kgDOD6E7Kw","avatar_url":"https://avatars.githubusercontent.com/u/262224683?v=4","gravatar_id":"","url":"https://api.github.com/users/won-openai","html_url":"https://github.com/won-openai","followers_url":"https://api.github.com/users/won-openai/followers","following_url":"https://api.github.com/users/won-openai/following{/other_user}","gists_url":"https://api.github.com/users/won-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/won-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/won-openai/subscriptions","organizations_url":"https://api.github.com/users/won-openai/orgs","repos_url":"https://api.github.com/users/won-openai/repos","events_url":"https://api.github.com/users/won-openai/events{/privacy}","received_events_url":"https://api.github.com/users/won-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c0f1ec5afdc1102617611560bfc22063fe11108f","url":"https://api.github.com/repos/openai/codex/commits/c0f1ec5afdc1102617611560bfc22063fe11108f","html_url":"https://github.com/openai/codex/commit/c0f1ec5afdc1102617611560bfc22063fe11108f"}]},{"sha":"c0f1ec5afdc1102617611560bfc22063fe11108f","node_id":"C_kwDOOYsS4doAKGMwZjFlYzVhZmRjMTEwMjYxNzYxMTU2MGJmYzIyMDYzZmUxMTEwOGY","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-06-12T22:34:04Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T22:34:04Z"},"message":"[2 of 3] Support long pasted text in TUI goals (#27509)\n\n## Stack\n\n1. [1 of 3] Support long raw TUI goal objectives - #27508\n2. **[2 of 3] Support long pasted text in TUI goals** - this PR\n3. [3 of 3] Support images in TUI goals - #27510\n\n## Why\n\nLarge text pasted into the TUI composer is represented as a paste\nplaceholder plus pending paste metadata. For `/goal`, preserving only\nthe visible placeholder is not enough: the agent would see a short\nplaceholder string instead of the actual pasted text, and the long-text\nsupport from the first PR would never see the payload.\n\nThe TUI also needs to avoid writing stale sidecar files when a user\npastes a large block and then deletes its placeholder before submitting\nthe goal.\n\n## What Changed\n\n- Introduces a TUI `GoalDraft` for goal submissions so `/goal`, `/goal\nedit`, and queued goal commands can carry objective text plus text\nelements and pending paste payloads.\n- Materializes active pasted-text placeholders to `pasted-text-N.txt`\nfiles through the app-server filesystem path introduced in #27508.\n- Rewrites active paste placeholders in the persisted objective to file\nreferences, while leaving literal placeholder-looking text alone.\n- Filters out deleted paste placeholders so otherwise-small goals do not\nrequire `$CODEX_HOME` or remote filesystem writes.\n- Preserves pending paste metadata when a `/goal` command is queued\nbefore a thread exists.\n\n## Verification\n\n- Added goal materialization tests for active paste placeholders,\ndeleted paste placeholders, and whitespace-only paste payloads.\n- Added/updated TUI slash-command tests for large pasted text, queued\n`/goal` commands before thread start, and queued oversized goal\nbehavior.\n\n## Manual Testing\n\n- Used real terminal bracketed-paste sequences through a remote TUI\nsession. A 1,228-byte multiline paste became `pasted-text-1.txt`; its\nfirst/last lines and byte count matched exactly, and the persisted\nobjective referenced the server-host path.\n- Pasted a large block, deleted its placeholder, and submitted a small\nreplacement objective. No new directory or sidecar file was created.\n- Added two same-length large pastes to one goal. The composer\ndisambiguated their visible placeholders, and materialization preserved\norder and contents in `pasted-text-1.txt` and `pasted-text-2.txt`.\n- Submitted a whitespace-only large paste and verified the goal was\nrejected as empty without writing a file.\n- Submitted a pasted-text replacement while another goal was active,\nverified no file was written before confirmation, then canceled and\nconfirmed the original goal remained unchanged.\n- Combined a large paste with enough raw text to exceed 4,000 characters\nafter placeholder rewriting. The paste sidecar and `goal-objective.md`\nwere created in the same remote attachment directory, and `/goal edit`\nrestored the rewritten objective with its sidecar reference.","tree":{"sha":"41173c97a56750fd1cffac84eab837a130517489","url":"https://api.github.com/repos/openai/codex/git/trees/41173c97a56750fd1cffac84eab837a130517489"},"url":"https://api.github.com/repos/openai/codex/git/commits/c0f1ec5afdc1102617611560bfc22063fe11108f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLIlcCRC1aQ7uu5UhlAAA6xIQADecHbt5125ZftK0uYR1K9DA\nHqT22HyTVnUNVWKtaUNFtQM7s6gjB+MY3XGmfhIS8jOUHl6p/mw1Rg69Empt0HWS\nDqos2PultroyybYtmEK8EkoF7oYJ2G8GlXQfk67Drig1P5ATEAusLQnywBkkmNro\nTE1uBusTFa3rsILGG9mj6ryi3bqwOwRN317XQzWu4QYWVKilLF/Uley0t3Ok2QyP\n1g8HDx+5xhuRSe8y4ryRDNCE9KfBG1CVrIBohyWPTRpnWGQMUReOTnadrXAgIU/I\nFzEJyGX/DPB862LYZQLLDyAaKBJVLesSB1X2MFvKibf6D37Hi91cQ1u3LFxa3U3X\nfAelZas3TRBGbazfkBRlSXjxB/2XBaKJJtiyhr/s5srChjpYl/sZJmC8RrvzSxWk\nBWh9oLR9i/c/qM8M5R4x1UzQRmOoc7ZMTpxwxHhhz8w+zPYPcFuTkCfQNltvXXXb\ngOvph2NUKF4sxsO7zOcY5XpoavL+wrNXwCof6njFGbiU4ajVe0mPCmMTlnniEeD+\nNUIpniaodQ7/XFFuo2ExahWGzmoj2p9Y9X/Q1jLuO4UWJykETj0mWDPnK7oaDopR\nKd6cEIyD+Qf8j1UqXN+1Z8+QNN/0Eug0xY8YyhP2tYi9Z0je4WwSgK32fQDPf99M\nl23YX/n14rr4W8RXbwc3\n=Fqqx\n-----END PGP SIGNATURE-----\n","payload":"tree 41173c97a56750fd1cffac84eab837a130517489\nparent 216dee1189fd589ea6c0741a5f92f578a3ca4640\nauthor Eric Traut <etraut@openai.com> 1781303644 -0700\ncommitter GitHub <noreply@github.com> 1781303644 -0700\n\n[2 of 3] Support long pasted text in TUI goals (#27509)\n\n## Stack\n\n1. [1 of 3] Support long raw TUI goal objectives - #27508\n2. **[2 of 3] Support long pasted text in TUI goals** - this PR\n3. [3 of 3] Support images in TUI goals - #27510\n\n## Why\n\nLarge text pasted into the TUI composer is represented as a paste\nplaceholder plus pending paste metadata. For `/goal`, preserving only\nthe visible placeholder is not enough: the agent would see a short\nplaceholder string instead of the actual pasted text, and the long-text\nsupport from the first PR would never see the payload.\n\nThe TUI also needs to avoid writing stale sidecar files when a user\npastes a large block and then deletes its placeholder before submitting\nthe goal.\n\n## What Changed\n\n- Introduces a TUI `GoalDraft` for goal submissions so `/goal`, `/goal\nedit`, and queued goal commands can carry objective text plus text\nelements and pending paste payloads.\n- Materializes active pasted-text placeholders to `pasted-text-N.txt`\nfiles through the app-server filesystem path introduced in #27508.\n- Rewrites active paste placeholders in the persisted objective to file\nreferences, while leaving literal placeholder-looking text alone.\n- Filters out deleted paste placeholders so otherwise-small goals do not\nrequire `$CODEX_HOME` or remote filesystem writes.\n- Preserves pending paste metadata when a `/goal` command is queued\nbefore a thread exists.\n\n## Verification\n\n- Added goal materialization tests for active paste placeholders,\ndeleted paste placeholders, and whitespace-only paste payloads.\n- Added/updated TUI slash-command tests for large pasted text, queued\n`/goal` commands before thread start, and queued oversized goal\nbehavior.\n\n## Manual Testing\n\n- Used real terminal bracketed-paste sequences through a remote TUI\nsession. A 1,228-byte multiline paste became `pasted-text-1.txt`; its\nfirst/last lines and byte count matched exactly, and the persisted\nobjective referenced the server-host path.\n- Pasted a large block, deleted its placeholder, and submitted a small\nreplacement objective. No new directory or sidecar file was created.\n- Added two same-length large pastes to one goal. The composer\ndisambiguated their visible placeholders, and materialization preserved\norder and contents in `pasted-text-1.txt` and `pasted-text-2.txt`.\n- Submitted a whitespace-only large paste and verified the goal was\nrejected as empty without writing a file.\n- Submitted a pasted-text replacement while another goal was active,\nverified no file was written before confirmation, then canceled and\nconfirmed the original goal remained unchanged.\n- Combined a large paste with enough raw text to exceed 4,000 characters\nafter placeholder rewriting. The paste sidecar and `goal-objective.md`\nwere created in the same remote attachment directory, and `/goal edit`\nrestored the rewritten objective with its sidecar reference.","verified_at":"2026-06-12T22:34:05Z"}},"url":"https://api.github.com/repos/openai/codex/commits/c0f1ec5afdc1102617611560bfc22063fe11108f","html_url":"https://github.com/openai/codex/commit/c0f1ec5afdc1102617611560bfc22063fe11108f","comments_url":"https://api.github.com/repos/openai/codex/commits/c0f1ec5afdc1102617611560bfc22063fe11108f/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"216dee1189fd589ea6c0741a5f92f578a3ca4640","url":"https://api.github.com/repos/openai/codex/commits/216dee1189fd589ea6c0741a5f92f578a3ca4640","html_url":"https://github.com/openai/codex/commit/216dee1189fd589ea6c0741a5f92f578a3ca4640"}]},{"sha":"216dee1189fd589ea6c0741a5f92f578a3ca4640","node_id":"C_kwDOOYsS4doAKDIxNmRlZTExODlmZDU4OWVhNmMwNzQxYTVmOTJmNTc4YTNjYTQ2NDA","commit":{"author":{"name":"Alex Gamble","email":"agamble@openai.com","date":"2026-06-12T22:05:37Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T22:05:37Z"},"message":"[codex] add roles to realtime append text (#27936)\n\n## Summary\n\nAdd an explicit `user` or `developer` role to\n`thread/realtime/appendText` and propagate it through the realtime input\nqueue into `conversation.item.create`. Older JSON clients that omit the\nfield continue to default to `user`.\n\nThis lets app-provided context such as memory retain developer authority\nwithout bypassing app-server through a renderer-owned data channel. The\napp-server schemas, API documentation, and focused protocol and\nwebsocket coverage are updated with the new contract.\n\nThe Codex Apps consumer is tracked in\n[openai/openai#1025261](https://github.com/openai/openai/pull/1025261).","tree":{"sha":"30957bb30802f496c2e2e0d5e6557375f4890429","url":"https://api.github.com/repos/openai/codex/git/trees/30957bb30802f496c2e2e0d5e6557375f4890429"},"url":"https://api.github.com/repos/openai/codex/git/commits/216dee1189fd589ea6c0741a5f92f578a3ca4640","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLIKxCRC1aQ7uu5UhlAAAp7EQAKhQ+vYQUJX6ZIwiWnr6hVg/\njGtgQV7Wa6l/5g/fVpMxNG7RDeVx2AQ9lQMt1YwrCSPtVtd3Z7jcOMQ9bmMizSK4\ngr5OmG3B4wLEzct605419iLdkvWipX8ccErjY1hjrNFZhB8AoGr+pve/zbYcmLAg\nSVZlL3D+4OGqiLrYWauQoSfEJX5uJSRBmXBLaNESpd5jYmq0odcm0hG06/vU+Jrn\nGCanH/KxpTDFQNmiqy08Rr5ZzFELSjzXFbeUQcJiSDTZnRQTB1Bs2w7eiYrKi/So\nKc/gbdsjyMnwFXeSiWt8SiiqoItMlJYD6lrZQw0mQ/nvVdeJ5RwNMdVhpPYhvcAo\nQqs5usWMHx+SMfpDw2gnPNypa6RdN0YPHWqW+FnCbOqKvahjFbJsirkMIOp29ObM\nsgDJ7oPbxU23r6qS4Il9Xkh0L5HoC6VL/JU+3SXeYoI3A91wcmLMDM3s8al6RpFp\n6fsPhCp6nRrv3QX1Dq88pYZLAVxXo/mC/a4Bg2CLscNZ0JZjc2fDCysqF8DI0YQn\n93aS0TiOvEkr2Dg5T3CyLKCs2Ie5/8wqYzGaUxpiA4Jqv24yPJu/M9z12YUTdsji\nEaoOamy9ikxX+9pBayg/TvuBD+8ILysKFkaBUOmxiBvbDvp67LMWkLx0831Q4yGQ\nYRznd+gDh5k9vqzKYegO\n=u6Zh\n-----END PGP SIGNATURE-----\n","payload":"tree 30957bb30802f496c2e2e0d5e6557375f4890429\nparent 9915d34684c5cf6cca5c9674d5684300c5995af6\nauthor Alex Gamble <agamble@openai.com> 1781301937 -0700\ncommitter GitHub <noreply@github.com> 1781301937 -0700\n\n[codex] add roles to realtime append text (#27936)\n\n## Summary\n\nAdd an explicit `user` or `developer` role to\n`thread/realtime/appendText` and propagate it through the realtime input\nqueue into `conversation.item.create`. Older JSON clients that omit the\nfield continue to default to `user`.\n\nThis lets app-provided context such as memory retain developer authority\nwithout bypassing app-server through a renderer-owned data channel. The\napp-server schemas, API documentation, and focused protocol and\nwebsocket coverage are updated with the new contract.\n\nThe Codex Apps consumer is tracked in\n[openai/openai#1025261](https://github.com/openai/openai/pull/1025261).","verified_at":"2026-06-12T22:05:38Z"}},"url":"https://api.github.com/repos/openai/codex/commits/216dee1189fd589ea6c0741a5f92f578a3ca4640","html_url":"https://github.com/openai/codex/commit/216dee1189fd589ea6c0741a5f92f578a3ca4640","comments_url":"https://api.github.com/repos/openai/codex/commits/216dee1189fd589ea6c0741a5f92f578a3ca4640/comments","author":{"login":"agamble-oai","id":209693278,"node_id":"U_kgDODH-qXg","avatar_url":"https://avatars.githubusercontent.com/u/209693278?v=4","gravatar_id":"","url":"https://api.github.com/users/agamble-oai","html_url":"https://github.com/agamble-oai","followers_url":"https://api.github.com/users/agamble-oai/followers","following_url":"https://api.github.com/users/agamble-oai/following{/other_user}","gists_url":"https://api.github.com/users/agamble-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/agamble-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/agamble-oai/subscriptions","organizations_url":"https://api.github.com/users/agamble-oai/orgs","repos_url":"https://api.github.com/users/agamble-oai/repos","events_url":"https://api.github.com/users/agamble-oai/events{/privacy}","received_events_url":"https://api.github.com/users/agamble-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"9915d34684c5cf6cca5c9674d5684300c5995af6","url":"https://api.github.com/repos/openai/codex/commits/9915d34684c5cf6cca5c9674d5684300c5995af6","html_url":"https://github.com/openai/codex/commit/9915d34684c5cf6cca5c9674d5684300c5995af6"}]},{"sha":"9915d34684c5cf6cca5c9674d5684300c5995af6","node_id":"C_kwDOOYsS4doAKDk5MTVkMzQ2ODRjNWNmNmNjYTVjOTY3NGQ1Njg0MzAwYzU5OTVhZjY","commit":{"author":{"name":"Celia Chen","email":"celia@openai.com","date":"2026-06-12T22:03:51Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T22:03:51Z"},"message":"feat: use encrypted local secrets for MCP OAuth (#27541)\n\n## Summary\n\n- store MCP OAuth credentials in the configured auth credential backend\n- support encrypted-local OAuth storage, including legacy keyring\nmigration\n- propagate the credential backend through MCP refresh, session, CLI,\nand app-server paths\n\n## Stack\n\n1. #27504 — config and feature flag\n2. #27535 — auth-specific secret namespaces\n3. #27539 — encrypted CLI auth storage\n4. this PR — encrypted MCP OAuth storage\n\nThis is a parallel review stack; the original #17931 remains unchanged.\n\n## Tests\n\n- `just test -p codex-rmcp-client` (the transport round-trip test passed\nafter building the required `codex` binary and retrying)\n- `just test -p codex-mcp`\n- `just test -p codex-app-server\nrefresh_config_uses_latest_auth_keyring_backend`\n- `just test -p codex-core\nrefresh_mcp_servers_is_deferred_until_next_turn`\n- `just test -p codex-cli mcp`\n- `just fix -p codex-rmcp-client -p codex-mcp -p codex-core -p codex-cli\n-p codex-app-server -p codex-protocol`\n- `just bazel-lock-check`","tree":{"sha":"695676d13772549ebe51156e8a480898d1f9c4a7","url":"https://api.github.com/repos/openai/codex/git/trees/695676d13772549ebe51156e8a480898d1f9c4a7"},"url":"https://api.github.com/repos/openai/codex/git/commits/9915d34684c5cf6cca5c9674d5684300c5995af6","comment_count"