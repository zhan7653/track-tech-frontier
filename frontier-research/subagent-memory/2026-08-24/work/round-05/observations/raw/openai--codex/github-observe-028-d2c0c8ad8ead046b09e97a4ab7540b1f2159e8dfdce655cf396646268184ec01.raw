de25488d16353f\nparent 87b808bb570f01f4b6fc8485c5459052fac0e320\nauthor Eric Ning <ericning@openai.com> 1780779780 -0700\ncommitter GitHub <noreply@github.com> 1780779780 -0700\n\nfix(core-plugins): send Codex product SKU to plugin-service (#26804)","verified_at":"2026-06-06T21:03:01Z"}},"url":"https://api.github.com/repos/openai/codex/commits/cdc8ec065e224c74683cf3a134772e64fb0c0c63","html_url":"https://github.com/openai/codex/commit/cdc8ec065e224c74683cf3a134772e64fb0c0c63","comments_url":"https://api.github.com/repos/openai/codex/commits/cdc8ec065e224c74683cf3a134772e64fb0c0c63/comments","author":{"login":"ericning-o","id":182030612,"node_id":"U_kgDOCtmRFA","avatar_url":"https://avatars.githubusercontent.com/u/182030612?v=4","gravatar_id":"","url":"https://api.github.com/users/ericning-o","html_url":"https://github.com/ericning-o","followers_url":"https://api.github.com/users/ericning-o/followers","following_url":"https://api.github.com/users/ericning-o/following{/other_user}","gists_url":"https://api.github.com/users/ericning-o/gists{/gist_id}","starred_url":"https://api.github.com/users/ericning-o/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ericning-o/subscriptions","organizations_url":"https://api.github.com/users/ericning-o/orgs","repos_url":"https://api.github.com/users/ericning-o/repos","events_url":"https://api.github.com/users/ericning-o/events{/privacy}","received_events_url":"https://api.github.com/users/ericning-o/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"87b808bb570f01f4b6fc8485c5459052fac0e320","url":"https://api.github.com/repos/openai/codex/commits/87b808bb570f01f4b6fc8485c5459052fac0e320","html_url":"https://github.com/openai/codex/commit/87b808bb570f01f4b6fc8485c5459052fac0e320"}]},{"sha":"87b808bb570f01f4b6fc8485c5459052fac0e320","node_id":"C_kwDOOYsS4doAKDg3YjgwOGJiNTcwZjAxZjRiNmZjODQ4NWM1NDU5MDUyZmFjMGUzMjA","commit":{"author":{"name":"Anton Panasenko","email":"apanasenko@openai.com","date":"2026-06-06T05:54:57Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-06T05:54:57Z"},"message":"fix(remote-control): preserve enrollment on generic websocket 404s (#26741)\n\n## Why\n\nA remote-control WebSocket handshake can receive a generic HTTP 404 when\nan intermediary routes the request without preserving the WebSocket\nupgrade. Treating every 404 as proof that the remote app server is gone\nclears valid enrollment and causes repeated re-enrollment, new\nenvironment and server IDs, Habitat churn, and noisy `/server/enroll`\ntraffic.\n\n## What Changed\n\n- Clear enrollment only when a 404 JSON response explicitly contains\n`{\"detail\":\"Remote app server not found\"}`.\n- Preserve enrollment for empty, plain-text, malformed, or otherwise\nunrecognized 404 responses, return the transport error, and retry with\nthe existing reconnect backoff.\n- Log the status, correlation headers (`request-id` or\n`x-oai-request-id`, plus `cf-ray`), and bounded/redacted response body\nfor unrecognized 404s.\n- Cover both explicit missing-server re-enrollment and generic 404\nenrollment preservation/reconnect behavior.\n\n## Verification\n\n`just test -p codex-app-server-transport` passes all 114 tests on the\nrebased branch, including the targeted explicit and generic WebSocket\n404 scenarios.\n\nRelated issue: N/A","tree":{"sha":"d2eb87bd633bf8119719ef0f3e945a5b5e1c6af3","url":"https://api.github.com/repos/openai/codex/git/trees/d2eb87bd633bf8119719ef0f3e945a5b5e1c6af3"},"url":"https://api.github.com/repos/openai/codex/git/commits/87b808bb570f01f4b6fc8485c5459052fac0e320","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqI7YxCRC1aQ7uu5UhlAAA7XoQAGMKoj2BEK6GmTjiOUOXuOlI\nlELVQXXdCdbB6u+p4zyeG0n3YIoYLeRjWSSkGwPDFhPEG5lDuDsJYSwjSiBHVHJ7\nv9Teg0HACEt+ZoLK5eo743uvLzLqO8Ob5swt2RGacQScvngqrLEPiLGPiW7NZxJ4\noWTtOBAzDFRktMbvBwZWs1QR35CrwgWu50B0t60yXGkORx3eQKoUZ0EoO/3nyURA\n5Xf4dXEzwsIo9TYyoNuPSXfnodh00eLJ+vWgP4LUini9fQjSw29afBjQF9fug8UE\neIdPass7ojM/S++aPaQ90pcGAIHVLBjcXOR7/hANQYfb6fOjqHya2guG0X2rgsdc\ndZ2BHPqWwJJR/hQ0dJPqr07RnYbqssVJLQvkS1roMsEQcas6k0154/hCVy61Jv+Z\nsRet/RCF/g2ncNxjbvnhq6lZDymV7LzIM51l98CnG0vgcrtSPmND/CWBNujovDxX\nYQwUQ82BHD5Oq9B3oYf7uFHyQlYwhvDwAFnhP0ptB+8KBraJAU7OMkZ67rwPnwoy\nRIptLeSYylW/qnBW1NrvpITpUjUojnKamW5uhPpQb+pXYe7QHw7dxcvuptUgIctn\no9+yYWLLjVwyvAYhjCLIiLvYChk1b12CDlDe68ETMBBoy1TVgtS31SSuzdAJgYfG\nvG951evzIiFauagSoKH4\n=r4k3\n-----END PGP SIGNATURE-----\n","payload":"tree d2eb87bd633bf8119719ef0f3e945a5b5e1c6af3\nparent 3ea9e983334ce187b295359d19b17706b7dd1144\nauthor Anton Panasenko <apanasenko@openai.com> 1780725297 -0700\ncommitter GitHub <noreply@github.com> 1780725297 -0700\n\nfix(remote-control): preserve enrollment on generic websocket 404s (#26741)\n\n## Why\n\nA remote-control WebSocket handshake can receive a generic HTTP 404 when\nan intermediary routes the request without preserving the WebSocket\nupgrade. Treating every 404 as proof that the remote app server is gone\nclears valid enrollment and causes repeated re-enrollment, new\nenvironment and server IDs, Habitat churn, and noisy `/server/enroll`\ntraffic.\n\n## What Changed\n\n- Clear enrollment only when a 404 JSON response explicitly contains\n`{\"detail\":\"Remote app server not found\"}`.\n- Preserve enrollment for empty, plain-text, malformed, or otherwise\nunrecognized 404 responses, return the transport error, and retry with\nthe existing reconnect backoff.\n- Log the status, correlation headers (`request-id` or\n`x-oai-request-id`, plus `cf-ray`), and bounded/redacted response body\nfor unrecognized 404s.\n- Cover both explicit missing-server re-enrollment and generic 404\nenrollment preservation/reconnect behavior.\n\n## Verification\n\n`just test -p codex-app-server-transport` passes all 114 tests on the\nrebased branch, including the targeted explicit and generic WebSocket\n404 scenarios.\n\nRelated issue: N/A","verified_at":"2026-06-06T05:54:58Z"}},"url":"https://api.github.com/repos/openai/codex/commits/87b808bb570f01f4b6fc8485c5459052fac0e320","html_url":"https://github.com/openai/codex/commit/87b808bb570f01f4b6fc8485c5459052fac0e320","comments_url":"https://api.github.com/repos/openai/codex/commits/87b808bb570f01f4b6fc8485c5459052fac0e320/comments","author":{"login":"apanasenko-oai","id":228802911,"node_id":"U_kgDODaNBXw","avatar_url":"https://avatars.githubusercontent.com/u/228802911?v=4","gravatar_id":"","url":"https://api.github.com/users/apanasenko-oai","html_url":"https://github.com/apanasenko-oai","followers_url":"https://api.github.com/users/apanasenko-oai/followers","following_url":"https://api.github.com/users/apanasenko-oai/following{/other_user}","gists_url":"https://api.github.com/users/apanasenko-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/apanasenko-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/apanasenko-oai/subscriptions","organizations_url":"https://api.github.com/users/apanasenko-oai/orgs","repos_url":"https://api.github.com/users/apanasenko-oai/repos","events_url":"https://api.github.com/users/apanasenko-oai/events{/privacy}","received_events_url":"https://api.github.com/users/apanasenko-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"3ea9e983334ce187b295359d19b17706b7dd1144","url":"https://api.github.com/repos/openai/codex/commits/3ea9e983334ce187b295359d19b17706b7dd1144","html_url":"https://github.com/openai/codex/commit/3ea9e983334ce187b295359d19b17706b7dd1144"}]},{"sha":"3ea9e983334ce187b295359d19b17706b7dd1144","node_id":"C_kwDOOYsS4doAKDNlYTllOTgzMzM0Y2UxODdiMjk1MzU5ZDE5YjE3NzA2YjdkZDExNDQ","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-06T01:53:12Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-06T01:53:12Z"},"message":"Remove `just bench-smoke` from `just test`. (#26716)\n\n## Why\n\n`just test` should run the test suite without also compiling and\nexecuting benchmark smoke tests. Keeping benchmark validation explicit\navoids adding unrelated work to every project-specific test invocation.\n\n## What changed\n\n- Remove the `just bench-smoke` step from the Unix and Windows `test`\nrecipes.\n- Document `just bench` and `just bench-smoke` as the explicit benchmark\ncommands in `AGENTS.md`.\n\n## Validation\n\n- `just test -p codex-arg0`\n- `just --dry-run test`\n- `just --dry-run bench-smoke`","tree":{"sha":"05d33965f940ee412752f19b455b4c3661df2863","url":"https://api.github.com/repos/openai/codex/git/trees/05d33965f940ee412752f19b455b4c3661df2863"},"url":"https://api.github.com/repos/openai/codex/git/commits/3ea9e983334ce187b295359d19b17706b7dd1144","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqI32ICRC1aQ7uu5UhlAAAzfIQACbHTd8q5d8gyNuOAxzjxPt9\nBilev07Wsmi3WPgpNqTOa8XaFFwyke/VUXfrxCwbynCjsaeBVutoHAF8wJ2ICNTg\nUnfLpVsqK+fn2tD107DMa6ZdRz388Ug0R1VxB+CST0L6Z/sSLCvkNRkJDZG8vbl5\n1ZZclLqgBsABEbIARRn/zVez2qf87J1UC9F8CanK3N90ljiTnKlogE1FHpbR3Vbh\nV+ay7kezOBr3DOGPJgKw3jV1UD7eGAnnQhtlXE5KvQNSXqccF/ZpzeqhUubyBfqR\n7NeGZtRcNn8Fjy/OGWN8bjEp4iJbHZFYi+IBeiD10PEa7wLcWTUP4LkCkuTJPrK5\nC0rgJN/dv4A5+sqcKRDKMGJPHZdRiE4z3BWwMp/1rDWITb90qiQTJOU4nhrQJuUM\nqSewRE6nQrcttSgWpKWvhpCKq9Se4zUEaj7GCFa2JK4eI7DPO6gfUkGcTRBOMfsQ\n5h5Br0hNK4unn8IvcVGgjpQdiqYNwEs4WeuzHQHMfGN8QoTiC1XEHPlxt1vawZSz\nxdQ27MDCJGMKlXDwq0JvwDdnWfRgNB9v9Kj3KLKhW78TghFPep6gEOte/eq/AAtc\nBaLF8vFTARSgha45Ep5NFmr0mm+20GoSmRd8+hzjNVIKMzvCmgDHe8DeoaqPzhUe\nfmv1/EaVEokhTCql/gm/\n=ygEi\n-----END PGP SIGNATURE-----\n","payload":"tree 05d33965f940ee412752f19b455b4c3661df2863\nparent cbac22dabec0dd043c670b54de397a3be5fc0133\nauthor Adam Perry @ OpenAI <anp@openai.com> 1780710792 -0700\ncommitter GitHub <noreply@github.com> 1780710792 -0700\n\nRemove `just bench-smoke` from `just test`. (#26716)\n\n## Why\n\n`just test` should run the test suite without also compiling and\nexecuting benchmark smoke tests. Keeping benchmark validation explicit\navoids adding unrelated work to every project-specific test invocation.\n\n## What changed\n\n- Remove the `just bench-smoke` step from the Unix and Windows `test`\nrecipes.\n- Document `just bench` and `just bench-smoke` as the explicit benchmark\ncommands in `AGENTS.md`.\n\n## Validation\n\n- `just test -p codex-arg0`\n- `just --dry-run test`\n- `just --dry-run bench-smoke`","verified_at":"2026-06-06T01:53:13Z"}},"url":"https://api.github.com/repos/openai/codex/commits/3ea9e983334ce187b295359d19b17706b7dd1144","html_url":"https://github.com/openai/codex/commit/3ea9e983334ce187b295359d19b17706b7dd1144","comments_url":"https://api.github.com/repos/openai/codex/commits/3ea9e983334ce187b295359d19b17706b7dd1144/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"cbac22dabec0dd043c670b54de397a3be5fc0133","url":"https://api.github.com/repos/openai/codex/commits/cbac22dabec0dd043c670b54de397a3be5fc0133","html_url":"https://github.com/openai/codex/commit/cbac22dabec0dd043c670b54de397a3be5fc0133"}]},{"sha":"cbac22dabec0dd043c670b54de397a3be5fc0133","node_id":"C_kwDOOYsS4doAKGNiYWMyMmRhYmVjMGRkMDQzYzY3MGI1NGRlMzk3YTNiZTVmYzAxMzM","commit":{"author":{"name":"xl-openai","email":"xl@openai.com","date":"2026-06-06T01:37:47Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-06T01:37:47Z"},"message":"[codex] Deduplicate skill load warnings (#26698)\n\nSkill reloads can get noisy when the watcher keeps triggering\n`skills/list` and the same invalid `SKILL.md` error comes back each\ntime.\n\nThis keeps the first warning visible, then suppresses repeats while the\nsame `(path, message)` is still active. If the error clears and later\ncomes back, or if the message changes, it will show again.\n\nValidation:\n- `just fmt`\n- `just test -p codex-tui skill_load_warning_state`","tree":{"sha":"56c31fe5e68b275fdee61f78b555a30765d1e97b","url":"https://api.github.com/repos/openai/codex/git/trees/56c31fe5e68b275fdee61f78b555a30765d1e97b"},"url":"https://api.github.com/repos/openai/codex/git/commits/cbac22dabec0dd043c670b54de397a3be5fc0133","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqI3nrCRC1aQ7uu5UhlAAAGBYQAFbIGTnc0IPfUCcHuXMXWyYL\n7VSq4kn2Eb1epMD4tAKI297+4qgi7lxjjU+TtGvotbMqtvxGTx6FLW7M3nXftrtR\nz96P8gKDM+dcvJ+NfT0h6m8bgbmxzi2XTkQ57baEfmP3rhCzA6nhRWvrOB7ivI0h\nEgzJsc0GSWdpUWYq0BZPRIlZsYeCa745J/rxCe6QwMsY14hVV3gqaAqTKMin8ILz\n/msSctKUyCzGgs/ta2SKcn7u7fobgUDAyhv9BRLSsWGLW/ygSOrYBu4q6q5o54y2\nK9ewyWMFtg9g2ws3Yrv28zS7qHGnk348DON1dH99cmI4yfO2C36Qmda7jS6ScMZP\nPH05BGXMyAE1Q7uE5hwBuehS7dop42fRUa/HMEC2KMf3Zg/2lm7FdyeZ/8+bjPjk\nDaG9RipaNduti2r3SpYujF5bgt6/Nj4vYqZ6GkvJjps8vp2pke85xDtPGl6rzSld\nb0evwj9Uc+pYya+AzyApmTLEKyrVW+R0HE81SiqJ3H4lYs75qU4lEbbCRLJW2T9p\nOr371NWCIlCmLZmow8/14OKwM5MQeEqGIZiYRiS5S/UoaPi4DexV3QKf/XieaKY3\nCm3EVZbA4PyhKe9+4jf5SRH1txlLvEU/Jl5NdzMsAYJ4Dq+fxhrhSlSPOCCGlffd\nsjeR/oXyPEi+RgMHPknd\n=Py5A\n-----END PGP SIGNATURE-----\n","payload":"tree 56c31fe5e68b275fdee61f78b555a30765d1e97b\nparent 2f108f9fd970ed73df7e984d3a661acc02f33abc\nauthor xl-openai <xl@openai.com> 1780709867 -0700\ncommitter GitHub <noreply@github.com> 1780709867 -0700\n\n[codex] Deduplicate skill load warnings (#26698)\n\nSkill reloads can get noisy when the watcher keeps triggering\n`skills/list` and the same invalid `SKILL.md` error comes back each\ntime.\n\nThis keeps the first warning visible, then suppresses repeats while the\nsame `(path, message)` is still active. If the error clears and later\ncomes back, or if the message changes, it will show again.\n\nValidation:\n- `just fmt`\n- `just test -p codex-tui skill_load_warning_state`","verified_at":"2026-06-06T01:37:47Z"}},"url":"https://api.github.com/repos/openai/codex/commits/cbac22dabec0dd043c670b54de397a3be5fc0133","html_url":"https://github.com/openai/codex/commit/cbac22dabec0dd043c670b54de397a3be5fc0133","comments_url":"https://api.github.com/repos/openai/codex/commits/cbac22dabec0dd043c670b54de397a3be5fc0133/comments","author":{"login":"xl-openai","id":184293535,"node_id":"U_kgDOCvwYnw","avatar_url":"https://avatars.githubusercontent.com/u/184293535?v=4","gravatar_id":"","url":"https://api.github.com/users/xl-openai","html_url":"https://github.com/xl-openai","followers_url":"https://api.github.com/users/xl-openai/followers","following_url":"https://api.github.com/users/xl-openai/following{/other_user}","gists_url":"https://api.github.com/users/xl-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/xl-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/xl-openai/subscriptions","organizations_url":"https://api.github.com/users/xl-openai/orgs","repos_url":"https://api.github.com/users/xl-openai/repos","events_url":"https://api.github.com/users/xl-openai/events{/privacy}","received_events_url":"https://api.github.com/users/xl-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"2f108f9fd970ed73df7e984d3a661acc02f33abc","url":"https://api.github.com/repos/openai/codex/commits/2f108f9fd970ed73df7e984d3a661acc02f33abc","html_url":"https://github.com/openai/codex/commit/2f108f9fd970ed73df7e984d3a661acc02f33abc"}]},{"sha":"2f108f9fd970ed73df7e984d3a661acc02f33abc","node_id":"C_kwDOOYsS4doAKDJmMTA4ZjlmZDk3MGVkNzNkZjdlOTg0ZDNhNjYxYWNjMDJmMzNhYmM","commit":{"author":{"name":"viyatb-oai","email":"viyatb@openai.com","date":"2026-06-06T01:06:29Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-06T01:06:29Z"},"message":"permissions: enforce managed permission profile allowlists (#24852)\n\n## Why\n\nPermission profile allowlists are an enterprise security boundary, but\nthey also need to compose across the managed requirements layers added\nin #24620.\n\nA map representation lets each requirements layer add, allow, or revoke\nindividual profiles without replacing an entire array.\n\n## Managed Contract\n\nAdministrators configure the mergeable allow map with\n`allowed_permission_profiles`. A recommended enterprise configuration\nexplicitly lists every built-in and custom profile users should be able\nto select:\n\n```toml\ndefault_permissions = \"review_only\"\n\n[allowed_permission_profiles]\n\":read-only\" = true\n\":workspace\" = true\nreview_only = true\n# \":danger-full-access\" is intentionally omitted, so it is denied.\n\n[permissions.review_only]\nextends = \":read-only\"\n```\n\n- Profiles whose effective merged value is `true` are allowed.\n- Missing profiles and profiles set to `false` are denied.\n- This is a closed allowlist: built-in profiles and profiles introduced\nin future versions are denied unless explicitly allowed.\n- Explicitly list each built-in profile the enterprise wants to make\navailable. Omit built-ins such as `:danger-full-access` when they should\nremain unavailable.\n- Set `default_permissions` explicitly to the allowed profile users\nshould receive when they have no local selection.\n- Higher-precedence layers override only the profile keys they define.\n- `false` is only needed when a higher-precedence layer must revoke a\n`true` inherited from a lower layer.\n- Explicit keys must refer to known built-in or managed profiles.\n\nA custom or narrowed allowlist requires an allowed\n`default_permissions`. For compatibility, if both `:workspace` and\n`:read-only` are explicitly allowed, an omitted default resolves to\n`:workspace`; customer configurations should still set the intended\ndefault explicitly.\n\nWhen `allowed_permission_profiles` is absent, existing implicit\npermission and legacy `sandbox_mode` behavior is unchanged.\n\n## What Changed\n\n- Add `allowed_permission_profiles` as a `BTreeMap<String, bool>` that\nmerges per profile across requirements layers.\n- Enforce managed defaults, strict denial of omitted profiles, and the\nexplicitly allowed standard-pair fallback.\n- Expose `allowedPermissionProfiles` through `configRequirements/read`\nand regenerate its schemas.\n- Add regression coverage for map composition and revocation, managed\ndefaults, strict denial of omitted built-ins, and API output.\n\n## Verification\n\n- Focused `codex-config` coverage for layered map composition and\nrevocation\n- Focused `codex-core` coverage for managed defaults, invalid defaults,\nstrict denial of omitted built-ins, and the standard built-in pair\n- Focused `codex-app-server` coverage for requirements API output\n- Scoped Clippy for `codex-config`, `codex-core`,\n`codex-app-server-protocol`, and `codex-app-server`\n\n## Documentation\n\nThe managed `requirements.toml` documentation should introduce\n`allowed_permission_profiles` as a closed permission-profile allowlist\nbefore this setting is published on developers.openai.com.\n\n---------\n\nCo-authored-by: Codex <noreply@openai.com>","tree":{"sha":"6cdb10c2a4c3f620660cf98eca36855ad4ca7c2a","url":"https://api.github.com/repos/openai/codex/git/trees/6cdb10c2a4c3f620660cf98eca36855ad4ca7c2a"},"url":"https://api.github.com/repos/openai/codex/git/commits/2f108f9fd970ed73df7e984d3a661acc02f33abc","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqI3KVCRC1aQ7uu5UhlAAAAg0QAHeu4kIYn+p7W2MdNDX7iuEl\nePD8XxbGTKD+hrHLHUyT/ubJLLp4GAFjtetZsua8fGkx/TwwtNwfqSsOgu5nIH8R\nnFvRfTQqc87ZpoF+EnJtarYFeuu+khiSbhQbB9XBpa82b5NO4ISdIVok8AxxQN8S\n3b1BltUWXRH95YzytmgIDgODsc8ccBjL2k95dfm9WZHaAqhwLhN3uIudC6VWA/3r\ntpWGQZ7VdHqnXs9J2Ii9xkX9xNornqQH1FMiyo1jKpQTcVZ83/TTDVawSgKCu83R\nnSh54lnOilpYANG6KZr3w6EJrSwmSlnfCXNvqCkO44E4Bx2qz36agTUSktkeYf9E\nH/3pz+7copnAsxctGX0yVjGaycoBc9j9LcyEi9VJHMc8yaDdEQE/frFSTac9iWU6\nHq9lY3cIZB/GDPm1z6fV8EWFr+5aQT0+y5AmCZH9YElo0ckXMbWrGgf6mvieXJq7\npGoMI92Jrz4MEQl1EbpnqYJ0+qNSPUoTlItaNEN9N+1nBy2vTOINrS90oSBrPXgR\nlnY3mLGp3Rsf+0dou7ghphE4qIaTVZF0DhX4P6x0hWdTUtM7fvQEau86amRLAkLt\nP+YqYM1w4Dgoco4kLu98lmlOyB0K5Tgr/hbq491NqdfIvUqzklD15Nxw3xXv741d\nx/txblmtV9QJ2BskK2A9\n=CNQG\n-----END PGP SIGNATURE-----\n","payload":"tree 6cdb10c2a4c3f620660cf98eca36855ad4ca7c2a\nparent 954e2878bbd735839c13a5e4e7bd45c74648f549\nauthor viyatb-oai <viyatb@openai.com> 1780707989 -0700\ncommitter GitHub <noreply@github.com> 1780707989 -0700\n\npermissions: enforce managed permission profile allowlists (#24852)\n\n## Why\n\nPermission profile allowlists are an enterprise security boundary, but\nthey also need to compose across the managed requirements layers added\nin #24620.\n\nA map representation lets each requirements layer add, allow, or revoke\nindividual profiles without replacing an entire array.\n\n## Managed Contract\n\nAdministrators configure the mergeable allow map with\n`allowed_permission_profiles`. A recommended enterprise configuration\nexplicitly lists every built-in and custom profile users should be able\nto select:\n\n```toml\ndefault_permissions = \"review_only\"\n\n[allowed_permission_profiles]\n\":read-only\" = true\n\":workspace\" = true\nreview_only = true\n# \":danger-full-access\" is intentionally omitted, so it is denied.\n\n[permissions.review_only]\nextends = \":read-only\"\n```\n\n- Profiles whose effective merged value is `true` are allowed.\n- Missing profiles and profiles set to `false` are denied.\n- This is a closed allowlist: built-in profiles and profiles introduced\nin future versions are denied unless explicitly allowed.\n- Explicitly list each built-in profile the enterprise wants to make\navailable. Omit built-ins such as `:danger-full-access` when they should\nremain unavailable.\n- Set `default_permissions` explicitly to the allowed profile users\nshould receive when they have no local selection.\n- Higher-precedence layers override only the profile keys they define.\n- `false` is only needed when a higher-precedence layer must revoke a\n`true` inherited from a lower layer.\n- Explicit keys must refer to known built-in or managed profiles.\n\nA custom or narrowed allowlist requires an allowed\n`default_permissions`. For compatibility, if both `:workspace` and\n`:read-only` are explicitly allowed, an omitted default resolves to\n`:workspace`; customer configurations should still set the intended\ndefault explicitly.\n\nWhen `allowed_permission_profiles` is absent, existing implicit\npermission and legacy `sandbox_mode` behavior is unchanged.\n\n## What Changed\n\n- Add `allowed_permission_profiles` as a `BTreeMap<String, bool>` that\nmerges per profile across requirements layers.\n- Enforce managed defaults, strict denial of omitted profiles, and the\nexplicitly allowed standard-pair fallback.\n- Expose `allowedPermissionProfiles` through `configRequirements/read`\nand regenerate its schemas.\n- Add regression coverage for map composition and revocation, managed\ndefaults, strict denial of omitted built-ins, and API output.\n\n## Verification\n\n- Focused `codex-config` coverage for layered map composition and\nrevocation\n- Focused `codex-core` coverage for managed defaults, invalid defaults,\nstrict denial of omitted built-ins, and the standard built-in pair\n- Focused `codex-app-server` coverage for requirements API output\n- Scoped Clippy for `codex-config`, `codex-core`,\n`codex-app-server-protocol`, and `codex-app-server`\n\n## Documentation\n\nThe managed `requirements.toml` documentation should introduce\n`allowed_permission_profiles` as a closed permission-profile allowlist\nbefore this setting is published on developers.openai.com.\n\n---------\n\nCo-authored-by: Codex <noreply@openai.com>","verified_at":"2026-06-06T01:06:30Z"}},"url":"https://api.github.com/repos/openai/codex/commits/2f108f9fd970ed73df7e984d3a661acc02f33abc","html_url":"https://github.com/openai/codex/commit/2f108f9fd970ed73df7e984d3a661acc02f33abc","comments_url":"https://api.github.com/repos/openai/codex/commits/2f108f9fd970ed73df7e984d3a661acc02f33abc/comments","author":{"login":"viyatb-oai","id":234056686,"node_id":"U_kgDODfNr7g","avatar_url":"https://avatars.githubusercontent.com/u/234056686?v=4","gravatar_id":"","url":"https://api.github.com/users/viyatb-oai","html_url":"https://github.com/viyatb-oai","followers_url":"https://api.github.com/users/viyatb-oai/followers","following_url":"https://api.github.com/users/viyatb-oai/following{/other_user}","gists_url":"https://api.github.com/users/viyatb-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/viyatb-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/viyatb-oai/subscriptions","organizations_url":"https://api.github.com/users/viyatb-oai/orgs","repos_url":"https://api.github.com/users/viyatb-oai/repos","events_url":"https://api.github.com/users/viyatb-oai/events{/privacy}","received_events_url":"https://api.github.com/users/viyatb-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"954e2878bbd735839c13a5e4e7bd45c74648f549","url":"https://api.github.com/repos/openai/codex/commits/954e2878bbd735839c13a5e4e7bd45c74648f549","html_url":"https://github.com/openai/codex/commit/954e2878bbd735839c13a5e4e7bd45c74648f549"}]}]