usul/events{/privacy}","received_events_url":"https://api.github.com/users/hsusul/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c0f2ff7d8f064fd4e15799ec1c1ae21e2e21cf6f","url":"https://api.github.com/repos/openai/openai-agents-python/commits/c0f2ff7d8f064fd4e15799ec1c1ae21e2e21cf6f","html_url":"https://github.com/openai/openai-agents-python/commit/c0f2ff7d8f064fd4e15799ec1c1ae21e2e21cf6f"}]},{"sha":"c0f2ff7d8f064fd4e15799ec1c1ae21e2e21cf6f","node_id":"C_kwDOOGidp9oAKGMwZjJmZjdkOGYwNjRmZDRlMTU3OTllYzFjMWFlMjFlMmUyMWNmNmY","commit":{"author":{"name":"Alex Chang","email":"apcha@openai.com","date":"2026-08-14T21:06:00Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-14T21:06:00Z"},"message":"fix: preserve scripted annotation streaming across Python SDK releases (#4422)\n\nThis pull request fixes scripted annotation streaming before the next Python SDK release introduces accurately typed annotation-added events (openai/openai-python#3617).\n\nThe current helper passes output-text annotation models directly into streaming events. That works while the released SDK accepts an untyped annotation, but the upcoming SDK validates events against distinct event-specific annotation classes. As a result, the existing helper both fails static type checking and raises a validation error at runtime.\n\n- Preserve annotation contents, event ordering, and sequence numbers across both the released and upcoming Python SDKs.\n- Construct events from their serialized payload so each installed SDK applies its own event schema without relying on imports that do not exist in the current release.\n- Compare annotation payloads by their public serialized representation instead of requiring unrelated generated model classes to share an identity.","tree":{"sha":"7fbeb6315cedc1ca58ff5707cd5b1285ba5c531c","url":"https://api.github.com/repos/openai/openai-agents-python/git/trees/7fbeb6315cedc1ca58ff5707cd5b1285ba5c531c"},"url":"https://api.github.com/repos/openai/openai-agents-python/git/commits/c0f2ff7d8f064fd4e15799ec1c1ae21e2e21cf6f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqf4M4CRC1aQ7uu5UhlAAArycQABkulYw3uwEgfdWS5Ioa7187\nLDV7OAtKKYr2GJCNrge+bTZWfscmZwsQyCWv39to7rTeg/vsMFvpr2kYMeddfUl6\negryVj2VrqNCpW/exnudzBJvcuUYrtx/sne3PGa+nGZsGQAnSJkuNSLWdjwSjfpu\nLIKy7utS+tNJCDB89aviHoNqTui61+GhMBQwWXoM5bwSKmr44NHiY9ngWzE+bgUm\nnu1cE7zze7dFGFH5dmSrj3AhFwAAKSfAc6XlAJxETFCySPiYxoKPyzxB8wX3tZDZ\nB2ygnQtigOJassGRBvSCxCXrpYmbZ5PeWK2XxlQoxkwW/Pa32cxbj0T4A+lo+sPU\nm0dS9j+ckO129Jg/Y1lnIADXsdZcK6SdHvtUtmE2y3MOybHFTW/zcRMsHSnTZHJI\nrCagz8Xu/1pRLCuQbbwY3JwHKHoaCewu1yA3xkOo6o4DKtUNP64JDGERsdAdwX2G\nPfMkn7RcDt3HUDlb0407fPihDM+T07+qkNYauzNhXBAlnfFVs+zD1/4Ka4BaZ8Gv\nOq5eG3OPEYae7UWZ1txoGyGYrFlIIa6meV9HXGwXMp3rViToO4jLHcqDVzu2ELt4\nfuVdpiew7C8/R7K1oUSKjNzXnxHXHUb8Vw0iD1cVso3t/0JjrvXT6l63dmHaqyWz\nHrJnx3l73K3xfZVnl9Zd\n=2Y5r\n-----END PGP SIGNATURE-----\n","payload":"tree 7fbeb6315cedc1ca58ff5707cd5b1285ba5c531c\nparent 50d65f65c367a3b09dcd3313ee8d78471c35885e\nauthor Alex Chang <apcha@openai.com> 1786741560 -0400\ncommitter GitHub <noreply@github.com> 1786741560 -0400\n\nfix: preserve scripted annotation streaming across Python SDK releases (#4422)\n\nThis pull request fixes scripted annotation streaming before the next Python SDK release introduces accurately typed annotation-added events (openai/openai-python#3617).\n\nThe current helper passes output-text annotation models directly into streaming events. That works while the released SDK accepts an untyped annotation, but the upcoming SDK validates events against distinct event-specific annotation classes. As a result, the existing helper both fails static type checking and raises a validation error at runtime.\n\n- Preserve annotation contents, event ordering, and sequence numbers across both the released and upcoming Python SDKs.\n- Construct events from their serialized payload so each installed SDK applies its own event schema without relying on imports that do not exist in the current release.\n- Compare annotation payloads by their public serialized representation instead of requiring unrelated generated model classes to share an identity.","verified_at":"2026-08-14T21:06:00Z"}},"url":"https://api.github.com/repos/openai/openai-agents-python/commits/c0f2ff7d8f064fd4e15799ec1c1ae21e2e21cf6f","html_url":"https://github.com/openai/openai-agents-python/commit/c0f2ff7d8f064fd4e15799ec1c1ae21e2e21cf6f","comments_url":"https://api.github.com/repos/openai/openai-agents-python/commits/c0f2ff7d8f064fd4e15799ec1c1ae21e2e21cf6f/comments","author":{"login":"apcha-oai","id":228803254,"node_id":"U_kgDODaNCtg","avatar_url":"https://avatars.githubusercontent.com/u/228803254?v=4","gravatar_id":"","url":"https://api.github.com/users/apcha-oai","html_url":"https://github.com/apcha-oai","followers_url":"https://api.github.com/users/apcha-oai/followers","following_url":"https://api.github.com/users/apcha-oai/following{/other_user}","gists_url":"https://api.github.com/users/apcha-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/apcha-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/apcha-oai/subscriptions","organizations_url":"https://api.github.com/users/apcha-oai/orgs","repos_url":"https://api.github.com/users/apcha-oai/repos","events_url":"https://api.github.com/users/apcha-oai/events{/privacy}","received_events_url":"https://api.github.com/users/apcha-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"50d65f65c367a3b09dcd3313ee8d78471c35885e","url":"https://api.github.com/repos/openai/openai-agents-python/commits/50d65f65c367a3b09dcd3313ee8d78471c35885e","html_url":"https://github.com/openai/openai-agents-python/commit/50d65f65c367a3b09dcd3313ee8d78471c35885e"}]},{"sha":"50d65f65c367a3b09dcd3313ee8d78471c35885e","node_id":"C_kwDOOGidp9oAKDUwZDY1ZjY1YzM2N2EzYjA5ZGNkMzMxM2VlOGQ3ODQ3MWMzNTg4NWU","commit":{"author":{"name":"Kazuhiro Sera","email":"seratch@open