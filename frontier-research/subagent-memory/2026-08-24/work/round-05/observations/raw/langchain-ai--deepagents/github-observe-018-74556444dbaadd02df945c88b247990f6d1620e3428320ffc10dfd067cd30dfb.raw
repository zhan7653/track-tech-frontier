rcontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"550a8abf3c595d738162a97f694b5d9527613323","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/550a8abf3c595d738162a97f694b5d9527613323","html_url":"https://github.com/langchain-ai/deepagents/commit/550a8abf3c595d738162a97f694b5d9527613323"}]},{"sha":"550a8abf3c595d738162a97f694b5d9527613323","node_id":"C_kwDOPTymldoAKDU1MGE4YWJmM2M1OTVkNzM4MTYyYTk3ZjY5NGI1ZDk1Mjc2MTMzMjM","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-05-28T21:19:38Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-28T21:19:38Z"},"message":"fix(code): restore resumed thread model (#3651)\n\nResumed threads now carry the model they last used, so `dcode -r` can\ncontinue the conversation with the same provider/model instead of\nsilently falling back to the current default. Explicit `--model`\nselections still take precedence, and resume-driven switches stay\nsession-only so they do not rewrite the user's saved model preferences.","tree":{"sha":"2ab9601d5df8e141f8954c6298883de992d67c8f","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/2ab9601d5df8e141f8954c6298883de992d67c8f"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/550a8abf3c595d738162a97f694b5d9527613323","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqGLFqCRC1aQ7uu5UhlAAAsZAQAESL4mE5LYwKOcskNQms435N\nzNW5yW9Z+7ImJL5cz7QK4m/1lOqcK52+bK0Tyrqd58pwPCdOI6oKsrML1lFxy4NO\n0arh0ckXOQ2Yq8MXz9SfBlg0eRVfyB2F2vx/q60PV3HiIKWQUs2s+kOfODf1bxvQ\nvSbWnPH9kIq8oNAIYwGfcibaGkY6aQ8RW+QAjcpMB1DPfchG+07BCYAE4eesMLoS\nUzSdGjcTOq7aRe114bJsoHHavVRQzrQloC53GP4JnyAxn5t5OQZ88pq6wZ5H+K+y\nyrIbB0vskXagB257HKhK8seLjZY2WSJ/6bRPtOeGXSCM3LgHTIpr9xfQdWcxvHpa\nGnSOJOdTXTR2rbE7a3z3sqU58STLqj3qaQGMW6Ctd+3i4m7MwLK+wcg1jQCCTBLB\n/D6y6niAm5Etll9sgPpTn4vzieA2R+fMWGWtZx0rUMcSQhU9sOn6/GXgN3MzUJfT\ne7kYLrAq+SJ5nYFeBz+ZRKZr6j1sMx0q1NFe9U8++wuCEGzbLq0DKh25QIC6VP3s\nDL0DnjlxtlzXM8+DAELl65TVrdiqVP52TLCHlNYoWNhWI0i+9+x21ElTXSWOM/d/\nthUTudleQoiq9YVLet+HWqPVlsUklkClnP/Vv+W7mhwWqbTr6gt8iVoQzbwPjlFE\nBgUIh9fnVN8ZZLmtCTo3\n=zvsD\n-----END PGP SIGNATURE-----\n","payload":"tree 2ab9601d5df8e141f8954c6298883de992d67c8f\nparent f3e23cdba44cba02d92ab1558caec680fddb4225\nauthor Mason Daugherty <mason@langchain.dev> 1780003178 -0400\ncommitter GitHub <noreply@github.com> 1780003178 -0400\n\nfix(code): restore resumed thread model (#3651)\n\nResumed threads now carry the model they last used, so `dcode -r` can\ncontinue the conversation with the same provider/model instead of\nsilently falling back to the current default. Explicit `--model`\nselections still take precedence, and resume-driven switches stay\nsession-only so they do not rewrite the user's saved model preferences.","verified_at":"2026-05-28T21:19:39Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/550a8abf3c595d738162a97f694b5d9527613323","html_url":"https://github.com/langchain-ai/deepagents/commit/550a8abf3c595d738162a97f694b5d9527613323","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/550a8abf3c595d738162a97f694b5d9527613323/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravat