oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"795031621ddf23fe89be4de640ed6f524e9b560d","url":"https://api.github.com/repos/openai/codex/commits/795031621ddf23fe89be4de640ed6f524e9b560d","html_url":"https://github.com/openai/codex/commit/795031621ddf23fe89be4de640ed6f524e9b560d"}]},{"sha":"795031621ddf23fe89be4de640ed6f524e9b560d","node_id":"C_kwDOOYsS4doAKDc5NTAzMTYyMWRkZjIzZmU4OWJlNGRlNjQwZWQ2ZjUyNGU5YjU2MGQ","commit":{"author":{"name":"Shijie Rao","email":"shijie.rao@openai.com","date":"2026-06-01T17:34:12Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-01T17:34:12Z"},"message":"[codex] Use git CLI for release Cargo fetches (#25644)\n\n## Summary\n- Configure the rust-release build job with\n`CARGO_NET_GIT_FETCH_WITH_CLI=true`\n- Document the macOS SecureTransport/libgit2 failure mode that hit the\n`libwebrtc`/`libyuv` git submodule fetch\n\n## Root cause\nThe release run at\nhttps://github.com/openai/codex/actions/runs/26717498860/job/78745156683\nrepeatedly failed before compilation because Cargo's libgit2 fetch path\ncould not clone the nested `yuv-sys/libyuv` submodule from\n`chromium.googlesource.com`, ending with `SecureTransport error:\nconnection closed via error`.\n\n## Validation\n- `git diff --check`\n\nThis is a workflow-only change, so I did not run Rust package tests.","tree":{"sha":"e3472d129c95f22e73f13c0607b3b94ae9c3d5e0","url":"https://api.github.com/repos/openai/codex/git/trees/e3472d129c95f22e73f13c0607b3b94ae9c3d5e0"},"url":"https://api.github.com/repos/openai/codex/git/commits/795031621ddf23fe89be4de640ed6f524e9b560d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqHcKUCRC1aQ7uu5UhlAAAJboQAD6vEGO733uOFxlJp3m6DIIq\nyQ/8xlk5B+Z2fxN/PIBGDsgZz4vCnKDRQZJjlO2UQGJiD+mCHuXBbBfAwdDeoJqG\nSAbEvlZDRWuxPgIbjt/0UkFyEhudKqCHBRjqQsM1UdoP0BG0LHkohnGKs9+hVqPp\nOj8DVaZnUiIjYedq03lIsfI6nfqUX5MeBu8w1kqyo3tViEftGggn27kTQKdMiUxs\nua5JxP5dQPciVcaO2W11d6pdlHM3oVcB0gUJVwj2641OQQnnKd6LfaGJQKlbbPxG\nioNAxkFVlXWsD1VCaHyU6Hz/e3+RWsHQLMr8OFFdjMxtRipqrMaxAOlKFO6oYDgo\nfl8YRkFGEl4PXfxL9IBeFVSdex6D9Yiqz1uT2wrNuxRNgTm+OMi2f1br7N3+NZMC\niWCB/UVoK2YLIBZZKpEEnBVAamcbtZ3KyQJlL1GvVCJrPQdoIFADkS2crapSJvBW\nMQ/41QT7FCN1WKfKxb8N1mN9pcVqe3hmiGC5lq3wCwF2rV8nex+yCzlMp/l7/Gj/\noD3ThJuaCS1NhaXeWmGEuE15zLQTOCe7A33JNZh5K9NpkjIqnSgA+qaNUHs8JPxd\n8o2mXBmjP3HGyX9/FVfW3D0170WMGJFtINc5OONaJ7SBdCs/JXS6tiNwtDeEcdKe\nVEdY5XdaVynoeF2k5T1z\n=1TLi\n-----END PGP SIGNATURE-----\n","payload":"tree e3472d129c95f22e73f13c0607b3b94ae9c3d5e0\nparent 2bf1c986f92542ca73298867195855872a237a6a\nauthor Shijie Rao <shijie.rao@openai.com> 1780335252 -0700\ncommitter GitHub <noreply@github.com> 1780335252 -0700\n\n[codex] Use git CLI for release Cargo fetches (#25644)\n\n## Summary\n- Configure the rust-release build job with\n`CARGO_NET_GIT_FETCH_WITH_CLI=true`\n- Document the macOS SecureTransport/libgit2 failure mode that hit the\n`libwebrtc`/`libyuv` git submodule fetch\n\n## Root cause\nThe release run at\nhttps://github.com/openai/codex/actions/runs/26717498860/job/78745156683\nrepeatedly failed before compilation because Cargo's libgit2 fetch path\ncould not clone the nested `yuv-sys/libyuv` submodule from\n`chromium.googlesource.com`, ending with `SecureTransport error:\nconnection closed via error`.\n\n## Validation\n- `git diff --check`\n\nThis is a workflow-only change, so I did not run Rust package tests.","verified_at":"2026-06-01T17:34:13Z"}},"url":"https://api.github.com/repos/openai/codex/commits/795031621ddf23fe89be4de640ed6f524e9b560d","html_url":"https://github.com/openai/codex/commit/795031621ddf23fe89be4de640ed6f524e9b560d","comments_url":"https://api.github.com/repos/openai/codex/commits/795031621ddf23fe89be4de640ed6f524e9b560d/comments","author":{"login":"shijie-oai","id":235382242,"node_id":"U_kgDODgel4g","avatar_url":"https://avatars.githubusercontent.com/u/235382242?v=4","gravatar_id":"","url":"https://api.github.com/users/shijie-oai","html_url":"https://github.com/shijie-oai","followers_url":"https://api.github.com/users/shijie-oai/followers","following_url":"https://api.github.com/users/shijie-oai/following{/other_user}","gists_url":"https://api.github.com/users/shijie-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/shijie-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shijie-oai/subscriptions","organizations_url":"https://api.github.com/users/shijie-oai/orgs","repos_url":"https://api.github.c