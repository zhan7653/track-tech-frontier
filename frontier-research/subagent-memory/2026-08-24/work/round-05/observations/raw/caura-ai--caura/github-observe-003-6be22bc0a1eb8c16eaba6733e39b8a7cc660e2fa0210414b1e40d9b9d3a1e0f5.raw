e14bbaa5ea7887628be544349d042a18973b","filename":"static/images/memclaw-social-preview.png","status":"removed","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/caura-ai/caura/blob/599b72b3ad99f4c25bf527cb577f5535706fd46e/static%2Fimages%2Fmemclaw-social-preview.png","raw_url":"https://github.com/caura-ai/caura/raw/599b72b3ad99f4c25bf527cb577f5535706fd46e/static%2Fimages%2Fmemclaw-social-preview.png","contents_url":"https://api.github.com/repos/caura-ai/caura/contents/static%2Fimages%2Fmemclaw-social-preview.png?ref=599b72b3ad99f4c25bf527cb577f5535706fd46e"}]}