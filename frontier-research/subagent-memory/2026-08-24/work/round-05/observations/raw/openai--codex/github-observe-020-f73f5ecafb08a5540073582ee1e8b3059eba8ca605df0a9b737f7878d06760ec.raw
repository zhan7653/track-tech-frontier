236c27b56b378f","html_url":"https://github.com/openai/codex/commit/3eb56537eb598e157af8b415f6236c27b56b378f"}]},{"sha":"3eb56537eb598e157af8b415f6236c27b56b378f","node_id":"C_kwDOOYsS4doAKDNlYjU2NTM3ZWI1OThlMTU3YWY4YjQxNWY2MjM2YzI3YjU2YjM3OGY","commit":{"author":{"name":"olliem-oai","email":"olliem@openai.com","date":"2026-07-08T23:15:43Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T23:15:43Z"},"message":"Update auto review prompting (#31480)\n\n## Why\nAuto-review performance is weaker because of confusing instructions\nabout sandbox permissions, and because it is given many tools which are\nirrelevant to it.\n\n## What\n* Update the auto review prompt\n* Remove the permissions_instructions developer message\n* Only pass exec_tool and view_image tool to the reviewer\n\n## Validation\n`just fmt`\n`cargo test -p codex-core --lib --quiet`","tree":{"sha":"5481b30807eba96ba460c27c6cc3b814b384813e","url":"https://api.github.com/repos/openai/codex/git/trees/5481b30807eba96ba460c27c6cc3b814b384813e"},"url":"https://api.github.com/repos/openai/codex/git/commits/3eb56537eb598e157af8b415f6236c27b56b378f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTtofCRC1aQ7uu5UhlAAA0kkQAJZM/ohv1BjuhbJ0dOdO5he3\nmLzyFtNohB0+y2G7nyckOmviR5Y2HkEuQKel0HEd8+Xhn7c92jB3Et5QoJGkjEdZ\nSmvKmjJX3hfCKum9EMzQ364l+Zk9M0CjAVZzWo4lAGFvmWZEAajnBQhunOJ0rAMU\nLRhyI6Uytd0cJeypwms0LRgTHr0P/gBBqnC2gaTo3a4fBeLezTNbTSNxJhrNF2Uh\nFdv3yudZmBWMYeowekUq8F6re1iiJnvPP8zv5ZPoHT4095PZl/daXW9yEXIWvtzs\nM5X1icqMpKrdjQK8/7jFi/aSLs6+TDUn0PZpLEbC8koLMCz8hQngFMNaiL2gGqau\ntUPsG8p/3W4DK1adTCWG1etVVNs3L1l1fgWI35UgBXjNyJMz01pinC0Ek2Sac0z7\nBk7tT8TqPt0qgXikj5E7mcu9WRGZLP/iGDTPfE+8EyXvd4tfJUghM9k9/TcsYnFd\nfd/MmuBGL8wmeVI4Q6wld9NvJjbRbUm0jt90xevioxD2NeA/cvyT9LvpNRZ2IDpP\nf2jFa3PoL3+JWuILosN/68rhJmXY0lWJ7eiYxU11ybC1p2pJkKk2Y7QkK/dQUuT+\nyr1TU0Y4Sw2kMy4YFU7eqgP3sbmmiSz1sF5+ySwmtaLaLsZ39OmUwbJoFYOn8eJF\n17luVeeAo1/qQL3ZCyVu\n=ngSR\n-----END PGP SIGNATURE-----\n","payload":"tree 5481b30807eba96ba460c27c6cc3b814b384813e\nparent a09a7c41d8abbaec6543664bff04a81058192958\nauthor olliem-oai <olliem@openai.com> 1783552543 -0700\ncommitter GitHub <noreply@github.com> 1783552543 +0000\n\nUpdate auto review prompting (#31480)\n\n## Why\nAuto-review performance is weaker because of confusing instructions\nabout sandbox permissions, and because it is given many tools which are\nirrelevant to it.\n\n## What\n* Update the auto review prompt\n* Remove the permissions_instructions developer message\n* Only pass exec_tool and view_image tool to the reviewer\n\n## Validation\n`just fmt`\n`cargo test -p codex-core --lib --quiet`","verified_at":"2026-07-08T23:15:44Z"}},"url":"https://api.github.com/repos/openai/codex/commits/3eb56537eb598e157af8b415f6236c27b56b378f","html_url":"https://github.com/openai/codex/commit/3eb56537eb598e157af8b415f6236c27b56b378f","comments_url":"https://api.github.com/repos/openai/codex/commits/3eb56537eb598e157af8b415f6236c27b56b378f/comments","author":{"login":"olliem-oai","id":240798946,"node_id":"U_kgDODlpM4g","avatar_url":"https://avatars.githubusercontent.com/u/240798946?v=4","gravatar_id":"","url":"https://api.github.com/users/olliem-oai","html_url":"https://github.com/olliem-oai","followers_url":"https://api.github.com/users/olliem-oai/followers","following_url":"https://api.github.com/users/olliem-oai/following{/other_user}","gists_url":"https://api.github.com/users/olliem-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/olliem-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/olliem-oai/subscriptions","organizations_url":"https://api.github.com/users/olliem-oai/orgs","repos_url":"https://api.github.com/users/olliem-oai/repos","events_url":"https://api.github.com/users/olliem-oai/events{/privacy}","received_events_url":"https://api.github.com/users/olliem-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a09a7c41d8abbaec6543664bff04a81058192958","url":"https://api.github.com/repos/openai/codex/commits/a09a7c41d8abbaec6543664bff04a81058192958","html_url":"https://github.com/openai/codex/commit/a09a7c41d8abbaec6543664bff04a81058192958"}]},{"sha":"a09a7c41d8abbaec6543664bff04a81058192958","node_id":"C_kwDOOYsS4doAKGEwOWE3YzQxZDhhYmJhZWM2NTQzNjY0YmZmMDRhODEwNTgxOTI5NTg","commit":{"author":{"name":"jacobzhou-oai","email":"jacobzhou@openai.com","date":"2026-07-08T23:04:30Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T23:04:30Z"},"message":"[codex-apps] Omit internal fields from file payloads (#31330)\n\n## Summary\n\nCodex Apps file parameters are exposed to the model as local paths,\nuploaded at execution time, and rewritten into provided-file payloads\nbefore the MCP tool call.\n\nThe rewrite currently forwards two internal upload fields, `uri` and\n`file_size_bytes`, even though they are not part of the documented app\nfile-reference shape. Strict app schemas can reject those extra fields\nbefore execution.\n\n## Changes\n\n- Stop copying `uri` and `file_size_bytes` into app-facing MCP\narguments.\n- Keep the internal `UploadedOpenAiFile` result unchanged.\n- Preserve the existing `download_url`, `file_id`, `mime_type`, and\n`file_name` behavior for scalar and array file inputs.\n- Verify the MCP invocation and post-tool hook receive exactly the\ndocumented four-field payload against an `additionalProperties: false`\nschema.\n\nThis intentionally does not add schema inspection or change how\n`openai/fileParams` names are discovered.\n\n## Validation\n\n- `just test -p codex-core mcp_openai_file` (6 passed)\n- `just test -p codex-core codex_apps_file_params_` (2 passed)\n- `just fix -p codex-core`\n- `just fmt`\n- `git diff --check`","tree":{"sha":"ebd2f69e72b0f02e545e819375610caf6205f9eb","url":"https://api.github.com/repos/openai/codex/git/trees/ebd2f69e72b0f02e545e819375610caf6205f9eb"},"url":"https://api.github.com/repos/openai/codex/git/commits/a09a7c41d8abbaec6543664bff04a81058192958","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTtd+CRC1aQ7uu5UhlAAAx4MQAI9gw11A71aHHZEd46EtvHxO\nFW4DMBznxR8nTPHInNJ9MQgn0CTD/hjCHKw7zVLH6bVYsGRTf6YSXE3KqaeiSjur\nPE9vCRznllvTXLtcFIKaDKcou5H7zHVTdBPNcUp1yBECAuOwwyA2sdDNlVWNanCb\n9R/5tZIQrMHf4XCEx2WdbJKzuCwG3kOq0zoHvhJAvDQ4qPB1lPJURlc+8JPbg8Ui\nZNTSFHo8OIJewcrBxP5aR/lvsDPf6X6arYwtEvIKeou9i6eePvuy5BXXwLV/uqpr\nB6H1Nt/Tx2lvd+BSrTXLkEfg4CKD4tKVqCFC9J6IqpI5gevNrks/QXVWjFhUij2t\n96ndDa9U+b4EiijJ9YfSB2rPnTmNaWogMmXQ2d9IiZWp0k5t/t1qswUHe0oAkVyt\nDi9UliArzIdHxgqZgaC6FKhbJ/g33xmnt4jbkn1QTKkPxYLt+WLdDjhbXPn0Eiut\nPiyKGLnYfxbtM/nBN0FllQSJ2IMolvleOH1ejNigWekMwmk8En0m74/SY/76MKTi\nZQcea1ynQQcTnbbfMAy/gw8mW4SpvjkPFovjxne6Wo3q8xDPwagzlct63ttwGcQY\nzNREXgSUtHbUyKIbPCg/R+flkdoq5q6IWBQq+DX6tSuyqw3RWHC3DiZ3cXHCBh2/\nnpwFP+RtoBTIj52zxVP1\n=76zV\n-----END PGP SIGNATURE-----\n","payload":"tree ebd2f69e72b0f02e545e819375610caf6205f9eb\nparent 4e270ddec40939dcdfb0e8f3e1c824ec122ea9da\nauthor jacobzhou-oai <jacobzhou@openai.com> 1783551870 -0700\ncommitter GitHub <noreply@github.com> 1783551870 -0700\n\n[codex-apps] Omit internal fields from file payloads (#31330)\n\n## Summary\n\nCodex Apps file parameters are exposed to the model as local paths,\nuploaded at execution time, and rewritten into provided-file payloads\nbefore the MCP tool call.\n\nThe rewrite currently forwards two internal upload fields, `uri` and\n`file_size_bytes`, even though they are not part of the documented app\nfile-reference shape. Strict app schemas can reject those extra fields\nbefore execution.\n\n## Changes\n\n- Stop copying `uri` and `file_size_bytes` into app-facing MCP\narguments.\n- Keep the internal `UploadedOpenAiFile` result unchanged.\n- Preserve the existing `download_url`, `file_id`, `mime_type`, and\n`file_name` behavior for scalar and array file inputs.\n- Verify the MCP invocation and post-tool hook receive exactly the\ndocumented four-field payload against an `additionalProperties: false`\nschema.\n\nThis intentionally does not add schema inspection or change how\n`openai/fileParams` names are discovered.\n\n## Validation\n\n- `just test -p codex-core mcp_openai_file` (6 passed)\n- `just test -p codex-core codex_apps_file_params_` (2 passed)\n- `just fix -p codex-core`\n- `just fmt`\n- `git diff --check`","verified_at":"2026-07-08T23:04:31Z"}},"url":"https://api.github.com/repos/openai/codex/commits/a09a7c41d8abbaec6543664bff04a81058192958","html_url":"https://github.com/openai/codex/commit/a09a7c41d8abbaec6543664bff04a81058192958","comments_url":"https://api.github.com/repos/openai/codex/commits/a09a7c41d8abbaec6543664bff04a81058192958/comments","author":{"login":"jacobzhou-oai","id":263775611,"node_id":"U_kgDOD7jlew","avatar_url":"https://avatars.githubusercontent.com/u/263775611?v=4","gravatar_id":"","url":"https://api.github.com/users/jacobzhou-oai","html_url":"https://github.com/jacobzhou-oai","followers_url":"https://api.github.com/users/jacobzhou-oai/followers","following_url":"https://api.github.com/users/jacobzhou-oai/following{/other_user}","gists_url":"https://api.github.com/users/jacobzhou-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jacobzhou-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jacobzhou-oai/subscriptions","organizations_url":"https://api.github.com/users/jacobzhou-oai/orgs","repos_url":"https://api.github.com/users/jacobzhou-oai/repos","events_url":"https://api.github.com/users/jacobzhou-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jacobzhou-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"4e270ddec40939dcdfb0e8f3e1c824ec122ea9da","url":"https://api.github.com/repos/openai/codex/commits/4e270ddec40939dcdfb0e8f3e1c824ec122ea9da","html_url":"https://github.com/openai/codex/commit/4e270ddec40939dcdfb0e8f3e1c824ec122ea9da"}]},{"sha":"4e270ddec40939dcdfb0e8f3e1c824ec122ea9da","node_id":"C_kwDOOYsS4doAKDRlMjcwZGRlYzQwOTM5ZGNkZmIwZThmM2UxYzgyNGVjMTIyZWE5ZGE","commit":{"author":{"name":"Felipe Coury","email":"felipe.coury@openai.com","date":"2026-07-08T22:55:05Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T22:55:05Z"},"message":"test(app-server): use native rollout fixture paths (#31663)\n\n## Why\n\nWindows CI now places temporary and build files on the `D:` Dev Drive.\nFake rollout metadata still stored `/` as its working directory, but `/`\nis drive-relative on Windows. When the migrated auto-environment tests\nresumed or listed those rollouts, the fixture resolved to `D:\\` while\nthe established test expectation remained `C:\\`, causing unrelated PRs\nto fail the Windows app-server shard.\n\nThis follows the interaction between #31357, which moved CI build paths\nto the Dev Drive, and #31614, which migrated these app-server tests to\nautomatic environments.\n\n## What\n\n- Construct fake rollout working directories with `test_path_buf(\"/\")`,\nproducing a fully qualified native path on Windows while preserving `/`\non Unix.\n- Use the same native test-path helper for the legacy\nconversation-summary expectation.\n\n## How to Test\n\nAutomated tests were intentionally not run locally at request; the\napp-server suite was stopped during compilation. `just fmt` completed\nsuccessfully.\n\nTo verify the regression on a Windows runner:\n\n1. Configure `TEMP` and `TMP` on a non-`C:` drive, as CI does with the\nDev Drive.\n2. Run `just test -p codex-app-server`.\n3. Confirm the existing thread list, read, and resume tests no longer\nreport `D:\\` actual versus `C:\\` expected paths.\n\nThis is a test-fixture-only change, so there is no product smoke path.","tree":{"sha":"27187791aa2a6ba295106f30111ca11a57059f64","url":"https://api.github.com/repos/openai/codex/git/trees/27187791aa2a6ba295106f30111ca11a57059f64"},"url":"https://api.github.com/repos/openai/codex/git/commits/4e270ddec40939dcdfb0e8f3e1c824ec122ea9da","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTtVJCRC1aQ7uu5UhlAAAGd8QAB/V2KHqmeIkI578jxp7cHAi\ng6bx79bf0GtDOefBiM9Hr2sICssHro7Yuzx90fvFrzkongUUVj2rW/trKq5Ceiiu\nneANG6th01KLttaaLF3oKlK0dM40vweMIfJQEOTp39O9JJ4wGazUDLN3Kg/ILrQu\nht0U2A151w67d1wLtJR9mOkMmESq1qEEUzMARcD6NZho29P7+lfaRnXZ52yt0TY1\n6XM+fCCQmg+UfRfAuUcc1Q/GpXztiDVWf5pqupCyoIBxzpZtnv+GJI3QWfvDRRvZ\nFa4kbIFaGTnGEpu8JxWHGChvPnyY7xUjdR/LT01YmWcCFQf00dawYVyM2TkHzDoq\no599WoibXHLtDO184r9x6vI2OR+2aMvG04Ofpp2J5yvgaxah/pFA/aA5WtEwrnlh\n+vDcqAIxZ5c/qQlGfRPbpN/o5uhYSH89mO/A/DJq7FaMYWU8sINrrMUiwdMneFbG\nqtl4c6rQSvud74G5BvZv6Np+4r18Rp+gTGuTDcx4kVaqZbkTq749JHEaSfWrx6LD\nHHQUQ+iDifVSsmNHS+QGq15bUvK+XcguUs2TjTJhClGwkIYTf5MGGEDYV1WFevvF\nogxe1JTTaUS8SdsR3/YFRAhP9bM82G+i/BPhDiWygg7iToxEPnG4JawZ1qSAnR1N\n2ERg6AbTQPeksa5ChRzl\n=jjU2\n-----END PGP SIGNATURE-----\n","payload":"tree 27187791aa2a6ba295106f30111ca11a57059f64\nparent f3bfaca3c1f1004f6c7707d8f781ce43007a0b39\nauthor Felipe Coury <felipe.coury@openai.com> 1783551305 -0300\ncommitter GitHub <noreply@github.com> 1783551305 -0300\n\ntest(app-server): use native rollout fixture paths (#31663)\n\n## Why\n\nWindows CI now places temporary and build files on the `D:` Dev Drive.\nFake rollout metadata still stored `/` as its working directory, but `/`\nis drive-relative on Windows. When the migrated auto-environment tests\nresumed or listed those rollouts, the fixture resolved to `D:\\` while\nthe established test expectation remained `C:\\`, causing unrelated PRs\nto fail the Windows app-server shard.\n\nThis follows the interaction between #31357, which moved CI build paths\nto the Dev Drive, and #31614, which migrated these app-server tests to\nautomatic environments.\n\n## What\n\n- Construct fake rollout working directories with `test_path_buf(\"/\")`,\nproducing a fully qualified native path on Windows while preserving `/`\non Unix.\n- Use the same native test-path helper for the legacy\nconversation-summary expectation.\n\n## How to Test\n\nAutomated tests were intentionally not run locally at request; the\napp-server suite was stopped during compilation. `just fmt` completed\nsuccessfully.\n\nTo verify the regression on a Windows runner:\n\n1. Configure `TEMP` and `TMP` on a non-`C:` drive, as CI does with the\nDev Drive.\n2. Run `just test -p codex-app-server`.\n3. Confirm the existing thread list, read, and resume tests no longer\nreport `D:\\` actual versus `C:\\` expected paths.\n\nThis is a test-fixture-only change, so there is no product smoke path.","verified_at":"2026-07-08T22:55:06Z"}},"url":"https://api.github.com/repos/openai/codex/commits/4e270ddec40939dcdfb0e8f3e1c824ec122ea9da","html_url":"https://github.com/openai/codex/commit/4e270ddec40939dcdfb0e8f3e1c824ec122ea9da","comments_url":"https://api.github.com/repos/openai/codex/commits/4e270ddec40939dcdfb0e8f3e1c824ec122ea9da/comments","author":{"login":"fcoury-oai","id":272635208,"node_id":"U_kgDOEEAVSA","avatar_url":"https://avatars.githubusercontent.com/u/272635208?v=4","gravatar_id":"","url":"https://api.github.com/users/fcoury-oai","html_url":"https://github.com/fcoury-oai","followers_url":"https://api.github.com/users/fcoury-oai/followers","following_url":"https://api.github.com/users/fcoury-oai/following{/other_user}","gists_url":"https://api.github.com/users/fcoury-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/fcoury-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fcoury-oai/subscriptions","organizations_url":"https://api.github.com/users/fcoury-oai/orgs","repos_url":"https://api.github.com/users/fcoury-oai/repos","events_url":"https://api.github.com/users/fcoury-oai/events{/privacy}","received_events_url":"https://api.github.com/users/fcoury-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f3bfaca3c1f1004f6c7707d8f781ce43007a0b39","url":"https://api.github.com/repos/openai/codex/commits/f3bfaca3c1f1004f6c7707d8f781ce43007a0b39","html_url":"https://github.com/openai/codex/commit/f3bfaca3c1f1004f6c7707d8f781ce43007a0b39"}]},{"sha":"f3bfaca3c1f1004f6c7707d8f781ce43007a0b39","node_id":"C_kwDOOYsS4doAKGYzYmZhY2EzYzFmMTAwNGY2Yzc3MDdkOGY3ODFjZTQzMDA3YTBiMzk","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-07-08T22:45:57Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T22:45:57Z"},"message":"Clarify device-code phishing warning (#31648)\n\n## Why\n\nThe existing device-code warning does not help users distinguish a login\nthey initiated from a phishing attempt. The warning should tell users to\nstop when the code came from a website or another person.\n\n## What changed\n\n- Updated the warning in the direct CLI and TUI device-code login flows\nwith actionable guidance.\n- Added focused coverage for the styled direct CLI prompt.","tree":{"sha":"e49203e05cda89a579b76f935e80f6cd12710fa7","url":"https://api.github.com/repos/openai/codex/git/trees/e49203e05cda89a579b76f935e80f6cd12710fa7"},"url":"https://api.github.com/repos/openai/codex/git/commits/f3bfaca3c1f1004f6c7707d8f781ce43007a0b39","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTtMlCRC1aQ7uu5UhlAAAj/sQAAnZRezppikbSlsmcrt57b7v\n9uOjD9H7LlBAoXt76JUroIxE6QgnyWKdHHvLzGpoXEcwFb9kGJd99TYZ8VS5CbEP\n56tSrQw8b/9bK63GJFIULmdZx6t3y8VnkFs+jpvkroFlzfKLYH3nqMtvxKffj9TZ\nhUU+NNEjGVLhV/G8K+YXuqRH3lLnfLRjb8nRGT+yPNu8Q19PHipwRiEJczfC9lj1\nLJAlXHZ5egrMQW241tGCx38/euXaVxeJhelgD8lFqQBATppxarRkuCtKHyYv8I0w\nKmzKlVe/ajQNqkIcBQ0OfvrnVfeuAPefnyJ7IczvNUzb4J7x5VRaMiQEYdPbkDSe\n4J65DHKXiSK3TQE19p7GvML9ZY/gI9mLUG5LG4+kzpI2duiPUTIt2gshfsCdKbq9\nwS+c40d2ZcVSP3W73Ck5h0BqOxlLZIycjp2zHGfl0wtF/UaUKYYUHgb4nsgC1WHY\nQ0y5BuwG4iIuzb+J3sCNudPl3ZzHrinxt5GGSk7VrR9jM4POxyptXbxuBsGB7IGb\nSxjiQoj7RKNNHE82DPtleyHnAz4hMMe2sezqxRzq+43AG9Zjiq6pn+7bCyQroKsr\n+DN9hsc61C9SoY8MudZAW3LnQVZ4Kv804WipHdQJK+/VilClFCceCFT9JSdQ1CTu\n3/z+8MHyiYCifZ7wVieO\n=mlwY\n-----END PGP SIGNATURE-----\n","payload":"tree e49203e05cda89a579b76f935e80f6cd12710fa7\nparent c55cb4b36315d0c9fc6540ec0ae12ab553fcf00b\nauthor Eric Traut <etraut@openai.com> 1783550757 -0700\ncommitter GitHub <noreply@github.com> 1783550757 -0700\n\nClarify device-code phishing warning (#31648)\n\n## Why\n\nThe existing device-code warning does not help users distinguish a login\nthey initiated from a phishing attempt. The warning should tell users to\nstop when the code came from a website or another person.\n\n## What changed\n\n- Updated the warning in the direct CLI and TUI device-code login flows\nwith actionable guidance.\n- Added focused coverage for the styled direct CLI prompt.","verified_at":"2026-07-08T22:45:58Z"}},"url":"https://api.github.com/repos/openai/codex/commits/f3bfaca3c1f1004f6c7707d8f781ce43007a0b39","html_url":"https://github.com/openai/codex/commit/f3bfaca3c1f1004f6c7707d8f781ce43007a0b39","comments_url":"https://api.github.com/repos/openai/codex/commits/f3bfaca3c1f1004f6c7707d8f781ce43007a0b39/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c55cb4b36315d0c9fc6540ec0ae12ab553fcf00b","url":"https://api.github.com/repos/openai/codex/commits/c55cb4b36315d0c9fc6540ec0ae12ab553fcf00b","html_url":"https://github.com/openai/codex/commit/c55cb4b36315d0c9fc6540ec0ae12ab553fcf00b"}]},{"sha":"c55cb4b36315d0c9fc6540ec0ae12ab553fcf00b","node_id":"C_kwDOOYsS4doAKGM1NWNiNGIzNjMxNWQwYzlmYzY1NDBlYzBhZTEyYWI1NTNmY2YwMGI","commit":{"author":{"name":"Channing Conger","email":"cconger@openai.com","date":"2026-07-08T22:27:04Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T22:27:04Z"},"message":"code-mode: make all approvals trigger elicitation pause (#31650)\n\n### summary\n\nWe want to pause code-mode from yielding back to the model when a\nsubcommand triggers an approval prompt. This means that all of these\npreviously inline blocking requests should also take out a\nElicitationService registration.\n\nThis also does some plumbing refactoring to request patch approval to\nmake it match the other `request_*_approval` methods in that it blocks\non the approval in the function instead of returning the oneshot\nchannel, this affords our ability to encapsulate the ElicitationService\nregistration via RAII.\n\nAdds tests to confirm the blocking behavior for code_mode both in suite\ntests and that the session holds them.","tree":{"sha":"c85b80a8c873fbb4f78c3d92154176e53ced7061","url":"https://api.github.com/repos/openai/codex/git/trees/c85b80a8c873fbb4f78c3d92154176e53ced7061"},"url":"https://api.github.com/repos/openai/codex/git/commits/c55cb4b36315d0c9fc6540ec0ae12ab553fcf00b","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTs64CRC1aQ7uu5UhlAAAoyAQAEHOSkvZLxjEg0rTaHczTLW+\n5Jht4SVzPSpGIk+hBayE6Tnx1OjHbVOHXYP0tpnhHs5HgwxcsArxgcSnGFyoRybE\n9RaPDqs9XCjI6BTJ5c4jbCfUPOHv2h6pM0RScfGJnBddyUFxVHjAAKW4MbMrRq/U\nDwIvimkJbozq+4+sUIAuaU7DOOOOpFWu2cYvG7xdN6jQkYx4xvjPQrqwn4JZdf/W\nNbujUggQamCN7mcC9GkJ1N3tGohVqSpWNxz4l5HG4pXxtL6ttvk2oP2TcIxopyP6\noajvqQE4nps0NLQEMcoS8K/3mmu5liPfwr8JZ+w2nIlt3iS35gfdKI29wDOwp/Hv\nNdm7oesrNLKrYgbMVNG/LMuQmqvXJCsOvkKapJMksMOeqValkyLO3D4htic6Biv5\nbbxa5bixq9xOiysecU32wQ3w1ya2gmRmZRHMfpXno2lwgqC/iD+LbS2n0BExbgCN\nmWyaIzadPwN32Ognr+i3Dq0v3W0hAB3qPXvEkyWiq0eECTkI2VWG6V5kdvz+d6fm\neiceFoAKUIAqDrCP3nWfdcCCmpiW2Z6aUocii1lOPMX1INb/0hyh/FT+JrUo31fh\n5xMp1Kk48KXm6RMZy1J4OFVZwvmVqMT0o84Zvipp9+VGRPA5CEf5sNmXirl81tMi\n3l0Q0tPqjxwOF4HK3bYD\n=dBx+\n-----END PGP SIGNATURE-----\n","payload":"tree c85b80a8c873fbb4f78c3d92154176e53ced7061\nparent b6f9aee16dc7dc10fbf7fc17c6757c4183dee058\nauthor Channing Conger <cconger@openai.com> 1783549624 -0700\ncommitter GitHub <noreply@github.com> 1783549624 -0700\n\ncode-mode: make all approvals trigger elicitation pause (#31650)\n\n### summary\n\nWe want to pause code-mode from yielding back to the model when a\nsubcommand triggers an approval prompt. This means that all of these\npreviously inline blocking requests should also take out a\nElicitationService registration.\n\nThis also does some plumbing refactoring to request patch approval to\nmake it match the other `request_*_approval` methods in that it blocks\non the approval in the function instead of returning the oneshot\nchannel, this affords our ability to encapsulate the ElicitationService\nregistration via RAII.\n\nAdds tests to confirm the blocking behavior for code_mode both in suite\ntests and that the session holds them.","verified_at":"2026-07-08T22:27:04Z"}},"url":"https://api.github.com/repos/openai/codex/commits/c55cb4b36315d0c9fc6540ec0ae12ab553fcf00b","html_url":"https://github.com/openai/codex/commit/c55cb4b36315d0c9fc6540ec0ae12ab553fcf00b","comments_url":"https://api.github.com/repos/openai/codex/commits/c55cb4b36315d0c9fc6540ec0ae12ab553fcf00b/comments","author":{"login":"cconger","id":200563,"node_id":"MDQ6VXNlcjIwMDU2Mw==","avatar_url":"https://avatars.githubusercontent.com/u/200563?v=4","gravatar_id":"","url":"https://api.github.com/users/cconger","html_url":"https://github.com/cconger","followers_url":"https://api.github.com/users/cconger/followers","following_url":"https://api.github.com/users/cconger/following{/other_user}","gists_url":"https://api.github.com/users/cconger/gists{/gist_id}","starred_url":"https://api.github.com/users/cconger/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cconger/subscriptions","organizations_url":"https://api.github.com/users/cconger/orgs","repos_url":"https://api.github.com/users/cconger/repos","events_url":"https://api.github.com/users/cconger/events{/privacy}","received_events_url":"https://api.github.com/users/cconger/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b6f9aee16dc7dc10fbf7fc17c6757c4183dee058","url":"https://api.github.com/repos/openai/codex/commits/b6f9aee16dc7dc10fbf7fc17c6757c4183dee058","html_url":"https://github.com/openai/codex/commit/b6f9aee16dc7dc10fbf7fc17c6757c4183dee058"}]},{"sha":"b6f9aee16dc7dc10fbf7fc17c6757c4183dee058","node_id":"C_kwDOOYsS4doAKGI2ZjlhZWUxNmRjN2RjMTBmYmY3ZmMxN2M2NzU3YzQxODNkZWUwNTg","commit":{"author":{"name":"fbauer33","email":"fbauer@openai.com","date":"2026-07-08T22:14:23Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T22:14:23Z"},"message":"[codex] increase tool schema compaction threshold (#31497)\n\n## Why\n\nThe 4,000-byte limit is compacting the tool schemas of some hero\nusecases.\n\n## What changed\n\nRaise the limit to 5,000 bytes and update compaction test fixtures\naccordingly.","tree":{"sha":"09b8e65b89f282867b26117fb6a1b65384649d60","url":"https://api.github.com/repos/openai/codex/git/trees/09b8e65b89f282867b26117fb6a1b65384649d60"},"url":"https://api.github.com/repos/openai/codex/git/commits/b6f9aee16dc7dc10fbf7fc17c6757c4183dee058","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTsu/CRC1aQ7uu5UhlAAA97cQAH7DAu1Typn3yC1ml/Lb/Crs\nbPcwXMH9gv8SwJf2M5EtMfpnkp5YyIDIsDA6XDNiBfJzA8SwiA7VNljuXfMFe2DH\nxBxpO7XGPnfiVh5U2QfejYhVcoGM5h7oGp60aaHiNkj4nhneCTtfABxTuQD2B+/s\nN1w6nljpeZMEoy/YCIKd+Sq1P4jN3LZQ3h5xy1flo73DMZctjNujkw/hjjQR967v\nKVuzxFFz+aRgwFi6OFB3N8KICHtWYSMkO/UKjYnbdeiQzILZA9IhaXNo2aU6sE4N\n1HenkrulklpE/MsoHiV3eVl1lLJVHd6/654ziV15v8lnYx9huY/GRhzhGSZY0F5T\n3o217QOVVMw/dAc6NXQyN4t5SejhmxZhGUDdNOBG2jN4bHFwz1tUAKYSHulEw1rM\nQ0y4x/FqZo7osQGlouOBHsodjw9n9VhcoAoNm9XaOBHeIFbT+t4BZxQ3EWMdlzO1\nZTVTAdr7gnvqYZuHCiyjanJepvZjoS/LYwqGP3G0dy77vCMyHaE13v4mzwhl5feb\nt1nz4SOvrHnArlrcYW4RkPwqLiuwkabwBWyIMw9i0ceEdpYt6rSFDEpYvpVV1FW8\nu8sqXL/nI3iPgm/py8L8MT5Whk9QHEwHAZiY6rq0a1/mRtT6fETbv2maSs2uhYPj\nOHRo6lcjLCuiZpds6ihL\n=o+Bn\n-----END PGP SIGNATURE-----\n","payload":"tree 09b8e65b89f282867b26117fb6a1b65384649d60\nparent 5c7624a69e5620d749e0afa99a40e60e02f7ddc9\nauthor fbauer33 <fbauer@openai.com> 1783548863 -0700\ncommitter GitHub <noreply@github.com> 1783548863 -0700\n\n[codex] increase tool schema compaction threshold (#31497)\n\n## Why\n\nThe 4,000-byte limit is compacting the tool schemas of some hero\nusecases.\n\n## What changed\n\nRaise the limit to 5,000 bytes and update compaction test fixtures\naccordingly.","verified_at":"2026-07-08T22:14:24Z"}},"url":"https://api.github.com/repos/openai/codex/commits/b6f9aee16dc7dc10fbf7fc17c6757c4183dee058","html_url":"https://github.com/openai/codex/commit/b6f9aee16dc7dc10fbf7fc17c6757c4183dee058","comments_url":"https://api.github.com/repos/openai/codex/commits/b6f9aee16dc7dc10fbf7fc17c6757c4183dee058/comments","author":{"login":"fbauer33","id":295944961,"node_id":"U_kgDOEaPDAQ","avatar_url":"https://avatars.githubusercontent.com/u/295944961?v=4","gravatar_id":"","url":"https://api.github.com/users/fbauer33","html_url":"https://github.com/fbauer33","followers_url":"https://api.github.com/users/fbauer33/followers","following_url":"https://api.github.com/users/fbauer33/following{/other_user}","gists_url":"https://api.github.com/users/fbauer33/gists{/gist_id}","starred_url":"https://api.github.com/users/fbauer33/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fbauer33/subscriptions","organizations_url":"https://api.github.com/users/fbauer33/orgs","repos_url":"https://api.github.com/users/fbauer33/repos","events_url":"https://api.github.com/users/fbauer33/events{/privacy}","received_events_url":"https://api.github.com/users/fbauer33/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"5c7624a69e5620d749e0afa99a40e60e02f7ddc9","url":"https://api.github.com/repos/openai/codex/commits/5c7624a69e5620d749e0afa99a40e60e02f7ddc9","html_url":"https://github.com/openai/codex/commit/5c7624a69e5620d749e0afa99a40e60e02f7ddc9"}]},{"sha":"5c7624a69e5620d749e0afa99a40e60e02f7ddc9","node_id":"C_kwDOOYsS4doAKDVjNzYyNGE2OWU1NjIwZDc0OWUwYWZhOTlhNDBlNjBlMDJmN2RkYzk","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-07-08T21:13:59Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T21:13:59Z"},"message":"test: migrate app-server v2 starts to auto env (#31614)\n\n## Why\n\nWe should be running as many integrations tests as possible against the\nsplit cross-OS configuration.\n\n## What\n\n- migrate eligible thread starts and builders to auto env\n- keep explicit custom/local-executor cases local with rationale\ncomments\n- keep auto-env coverage where possible and add narrow `TODO(anp)` skips\nfor fixtures that are not target-native yet","tree":{"sha":"0f85faa9f26a75dd3d28c44c8a4af01eb566224d","url":"https://api.github.com/repos/openai/codex/git/trees/0f85faa9f26a75dd3d28c44c8a4af01eb566224d"},"url":"https://api.github.com/repos/openai/codex/git/commits/5c7624a69e5620d749e0afa99a40e60e02f7ddc9","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTr2XCRC1aQ7uu5UhlAAA+mIQAJlEpT0BU7xkqivCnGYUU+NG\nm9LvsYE1I4i7lR+1MVChWLV1fOm7qWkmnorFV3fxnLBKWmzY2F8uELS8p5QNUbqT\nX14jWCLBQO48vsnoOMPz8SD72vK5pVvJprEVsUwVtrjFAioIqtAiiZN61Gyu/FuI\n8yoUlPsuj7ArdQmcyjNDXu+Z/dg26oXzN0TCeY98BrwQrPZMKtu7bP+CtqTZMrjL\nK1PRJ2zxjL7T+ECkZRizx1qSoPw0T2Y/+7ATCQXepY+EXpL4NAXj9mVADH3pq90r\nmtxWeJgm8QN8EivuTuGmQ905lI724B5gUeq2d8JotkKgjNkmpNwoH1y3Wat2dUH9\nEg+tNMb6ufdUFImAm4fDtQjlLL5qJp9GshR2giDpbIGELvbzeHiHrd2NQn3Dtmnw\n6b3OncECqBmkCYWLzWVtLuG0zwapYAvAvq8YhdTs794+QH1ywRCy9fNEiY+vcmx+\n+iDQqePV8jJr3cBXgKGD3dLZkXMWjNkAY4PCyCpBdBgMS+VK6QwFXTWiMcmvN68/\nwnLI8Q8YirwDdLQip1e10FDPCtidrFfPp06LQUyEqotGDTzU0A1ME+jSUP1fZIOv\nTv2DP3Et+WQyc4JVdrT+/BBbulcmRGtf0vKxK8Y0rvehcc5w5CepOUcXw5HZc9/C\npNbWBSdaxM27rHVKDp5d\n=5L9o\n-----END PGP SIGNATURE-----\n","payload":"tree 0f85faa9f26a75dd3d28c44c8a4af01eb566224d\nparent 4b64bf0751a692d25691f361198c8d263e807839\nauthor Adam Perry @ OpenAI <anp@openai.com> 1783545239 -0700\ncommitter GitHub <noreply@github.com> 1783545239 -0700\n\ntest: migrate app-server v2 starts to auto env (#31614)\n\n## Why\n\nWe should be running as many integrations tests as possible against the\nsplit cross-OS configuration.\n\n## What\n\n- migrate eligible thread starts and builders to auto env\n- keep explicit custom/local-executor cases local with rationale\ncomments\n- keep auto-env coverage where possible and add narrow `TODO(anp)` skips\nfor fixtures that are not target-native yet","verified_at":"2026-07-08T21:13:59Z"}},"url":"https://api.github.com/repos/openai/codex/commits/5c7624a69e5620d749e0afa99a40e60e02f7ddc9","html_url":"https://github.com/openai/codex/commit/5c7624a69e5620d749e0afa99a40e60e02f7ddc9","comments_url":"https://api.github.com/repos/openai/codex/commits/5c7624a69e5620d749e0afa99a40e60e02f7ddc9/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"4b64bf0751a692d25691f361198c8d263e807839","url":"https://api.github.com/repos/openai/codex/commits/4b64bf0751a692d25691f361198c8d263e807839","html_url":"https://github.com/openai/codex/commit/4b64bf0751a692d25691f361198c8d263e807839"}]},{"sha":"4b64bf0751a692d25691f361198c8d263e807839","node_id":"C_kwDOOYsS4doAKDRiNjRiZjA3NTFhNjkyZDI1NjkxZjM2MTE5OGM4ZDI2M2U4MDc4Mzk","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-07-08T21:07:43Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T21:07:43Z"},"message":"chore: remove inert cargo audit workflow (#31461)\n\n## Why\n\n`codex-rs/.github/workflows/cargo-audit.yml` is nested below the\nrepository root, so GitHub Actions never discovers or runs it. RustSec\nadvisory enforcement already runs through the root `cargo-deny`\nworkflow.\n\n## What\n\nRemove the inert nested Cargo audit workflow.\n\n## Validation\n\n- Ran `git diff --check`.\n- Verified the workflow is absent from GitHub registered workflows and\nthat root blocking CI invokes `cargo-deny`.","tree":{"sha":"7ce1dac87a5104a24968d977907d5899fc39a0f7","url":"https://api.github.com/repos/openai/codex/git/trees/7ce1dac87a5104a24968d977907d5899fc39a0f7"},"url":"https://api.github.com/repos/openai/codex/git/commits/4b64bf0751a692d25691f361198c8d263e807839","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTrwfCRC1aQ7uu5UhlAAAEQkQAKQZTlCzoP+bD4Bc3/EY00UF\nOcvHoH2YhqLzkxK1WhIyqsGM2a3lHt1nnVgQyyQQ18J0UTlKQsCToaHYoO0JJN83\n298bHY40YTA9bsf/UJbqOxDoBnGJG1c9vlQC0bt7QnpE/Quy/6F8tBpF/0Q6cISE\nV39heLnMi9rK/HCojgztnFE+dXi27Qg7rkdX4dQ50Ekm23OKDrv1DWHF4VlrH8ii\npjnlPCC3k+LBTS8GriCz2U+04I9pLn9srBDBOVg2AUMNyHuR2pKz9MYe706KMKVe\nMAap/ms0hQdFh7dEMjs35IbQvwXYEGe+9u/m9AyeKtrDWM7XyjcY0QmCne4K15z7\nTokJzhF9ZQSbXqzdZhc/++3nK+TkxGehSq4sJ6rj/QEqJxcHp/grbQWWoA0YfDCl\nrVJA4kJQJg1+UdBWXGZ49qzp/9/XvA/7jVlW8rwzYw7sCzSuFE76wVAlcoqpziH5\n+bACXYIiAKGtzDSfzO/JI02o/RbNo3eIyFkknjVljkmnC5Xd5qcoxGhj916SGFH+\ngM8mgj+qrjNabOxJTiN9U+zU5ZJTw9qe0x4+z0IFiUKEhARFu6wgVdHaIWUrptIg\n/JeNRy2ZLPp4z6MOk4DYYSihGeMgx+XbGK9FgPTEQKY05QMLDO+1fdWbbn+OMkEb\nOFP+hrsnty1X39/rSoO1\n=ZgVn\n-----END PGP SIGNATURE-----\n","payload":"tree 7ce1dac87a5104a24968d977907d5899fc39a0f7\nparent bd5c860abe0f492d96f4f868717f8c377a538dd3\nauthor Adam Perry @ OpenAI <anp@openai.com> 1783544863 -0700\ncommitter GitHub <noreply@github.com> 1783544863 -0700\n\nchore: remove inert cargo audit workflow (#31461)\n\n## Why\n\n`codex-rs/.github/workflows/cargo-audit.yml` is nested below the\nrepository root, so GitHub Actions never discovers or runs it. RustSec\nadvisory enforcement already runs through the root `cargo-deny`\nworkflow.\n\n## What\n\nRemove the inert nested Cargo audit workflow.\n\n## Validation\n\n- Ran `git diff --check`.\n- Verified the workflow is absent from GitHub registered workflows and\nthat root blocking CI invokes `cargo-deny`.","verified_at":"2026-07-08T21:07:43Z"}},"url":"https://api.github.com/repos/openai/codex/commits/4b64bf0751a692d25691f361198c8d263e807839","html_url":"https://github.com/openai/codex/commit/4b64bf0751a692d25691f361198c8d263e807839","comments_url":"https://api.github.com/repos/openai/codex/commits/4b64bf0751a692d25691f361198c8d263e807839/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"bd5c860abe0f492d96f4f868717f8c377a538dd3","url":"https://api.github.com/repos/openai/codex/commits/bd5c860abe0f492d96f4f868717f8c377a538dd3","html_url":"https://github.com/openai/codex/commit/bd5c860abe0f492d96f4f868717f8c377a538dd3"}]},{"sha":"bd5c860abe0f492d96f4f868717f8c377a538dd3","node_id":"C_kwDOOYsS4doAKGJkNWM4NjBhYmUwZjQ5MmQ5NmY0Zjg2ODcxN2Y4YzM3N2E1MzhkZDM","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-07-08T21:06:37Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T21:06:37Z"},"message":"ci: route build IO through Dev Drives (#31357)\n\n## Why\n\nWindows Cargo and Bazel jobs spend significant time in filesystem-heavy\nbuild and cache directories. Route those directories through one CI\nbuild root so Windows can use its Dev Drive and Unix can use a stable\ncache root.\n\n## What\n\n- Have `setup-ci` define `CI_BUILD_ROOT`, `CARGO_TARGET_DIR`, Bazel\ncache/output paths, and temp paths.\n- Require Windows to find or provision a verified Dev Drive instead of\nfalling back to `C:`.\n- Pass the shared Bazel output base to `setup-bazel` so its explicit\n`output_base` does not defeat Dev Drive routing.\n- Point nextest, release, and V8 source-build paths at the shared\nenvironment contract.\n\n## Benchmark results\n\nOne-off cold-cache WPR/ETW traces show the explicit Bazel output-base\nrouting removes the dominant `C:` traffic:\n\n| sample | `C:\\_bazel` | summed `C:` traffic | traced test step |\n|---|---:|---:|---:|\n| shard 1 before | 62.2 GiB | 85.2 GiB | 16m22s |\n| shard 1 updated | 0 | 16.5 GiB | 12m05s |\n| shard 3 before | 67.2 GiB | 84.6 GiB | 16m48s |\n| shard 3 updated | 0 | 13.5 GiB | 11m08s |\n\nFor a cold x64 V8 source build, the retained build-tail sample showed\n`D:\\cargo-target` at ~1.29 GiB while measured `C:` roots totaled ~0.45\nGiB (`C:\\Users` ~0.33 GiB, `C:\\Program Files` ~0.06 GiB, `C:\\Windows`\n~0.03 GiB). The full cold build took 2h20m36s.\n\nThe Bazel timing improvement is directional because both refreshed\nshards failed tests. The V8 trace is a bounded build-tail sample, not\nthe full build. All final samples had zero lost ETW events; VHDX traffic\nwas excluded from the optimization ranking.\n\nRuns: [baseline\nBazel](https://github.com/openai/codex/actions/runs/28911908527),\n[updated\nBazel](https://github.com/openai/codex/actions/runs/28917133701), [V8\nbuild tail](https://github.com/openai/codex/actions/runs/28933626678).\n\n## Manual validation\n\n- Ran `just fmt`.\n- Ran `just test-github-scripts` (35 tests).\n- Parsed GitHub Actions YAML with `yq`.\n- Ran `git diff --check`.\n\n## Stack\n\n- [#31332](https://github.com/openai/codex/pull/31332) — parameterize\nCargo target paths\n- [#31356](https://github.com/openai/codex/pull/31356) — Windows 2025\nrunner bump\n- [#31357](https://github.com/openai/codex/pull/31357) — Dev Drive I/O\nrouting","tree":{"sha":"d0b72553749d2dea0930515644182282a6c00bc1","url":"https://api.github.com/repos/openai/codex/git/trees/d0b72553749d2dea0930515644182282a6c00bc1"},"url":"https://api.github.com/repos/openai/codex/git/commits/bd5c860abe0f492d96f4f868717f8c377a538dd3","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTrvdCRC1aQ7uu5UhlAAAItIQABm7TX+KsEM0WIQE67c02PcY\nnswIPKyTkAXR6nNh2DEqIq84zOr0Pl2am9CvsEQAlbZlGk8YCEYFJapDnzZmH2V+\ncD3S6x5OwOs11QOjH2uj8/rqcVCIBSsT1LrcTFnlUEhi2RW4G9NbbL8Q2lH5L9PV\nJprT/+p3xR9JFyrg8MeUi2gZbezytXvRN12xxRLlkOgauo9sPHI5P6LYR8ijIroo\nm2Ijgjij5AVgEw6ybt0BK+xFSSaUHkNWX4AQftfkptCUB58Py6ha1ZY5BiS2nyPk\nVpRjKdrdxT/WtsAve3dwAVxIy23GJFNYIgAnm4OAbExU7+11l0u3s2GcHASlQLOE\n2gT/EYIdCpjR4RMmc5DyTqN2psIOK/iA8JamyUJnpzEujMPX4eM5fvQtQWimY+ra\ne+U9aIVJ40qoyp+t+s01joTFZ+FSK9/Y3WLRLgUQ5Nn1tyy4pY4EagPjZopNpdTS\n4KHeCpP2WrD3z9IsDEt8tb43u0ZmRAEk0MZkqZpo0H4zjU1L8prvZ/oB4omMIQWX\nhWAgS7SNM9RAd8bs9YwErv1cvxyFwrsjGsonW5OI6ljnMseI27FjH3iB/TUiW355\ni/vypGY/6UCA2c7GgRUusYcHMiORukCyMp8MQH8L3Q0Inl9yS/ERdNEQfhDTaQO9\nRapjJ339M7QQwPUsd7ZA\n=Z7/J\n-----END PGP SIGNATURE-----\n","payload":"tree d0b72553749d2dea0930515644182282a6c00bc1\nparent e621d7df8c4571e0b996a29095ef0de5bc93af5c\nauthor Adam Perry @ OpenAI <anp@openai.com> 1783544797 -0700\ncommitter GitHub <noreply@github.com> 1783544797 -0700\n\nci: route build IO through Dev Drives (#31357)\n\n## Why\n\nWindows Cargo and Bazel jobs spend significant time in filesystem-heavy\nbuild and cache directories. Route those directories through one CI\nbuild root so Windows can use its Dev Drive and Unix can use a stable\ncache root.\n\n## What\n\n- Have `setup-ci` define `CI_BUILD_ROOT`, `CARGO_TARGET_DIR`, Bazel\ncache/output paths, and temp paths.\n- Require Windows to find or provision a verified Dev Drive instead of\nfalling back to `C:`.\n- Pass the shared Bazel output base to `setup-bazel` so its explicit\n`output_base` does not defeat Dev Drive routing.\n- Point nextest, release, and V8 source-build paths at the shared\nenvironment contract.\n\n## Benchmark results\n\nOne-off cold-cache WPR/ETW traces show the explicit Bazel output-base\nrouting removes the dominant `C:` traffic:\n\n| sample | `C:\\_bazel` | summed `C:` traffic | traced test step |\n|---|---:|---:|---:|\n| shard 1 before | 62.2 GiB | 85.2 GiB | 16m22s |\n| shard 1 updated | 0 | 16.5 GiB | 12m05s |\n| shard 3 before | 67.2 GiB | 84.6 GiB | 16m48s |\n| shard 3 updated | 0 | 13.5 GiB | 11m08s |\n\nFor a cold x64 V8 source build, the retained build-tail sample showed\n`D:\\cargo-target` at ~1.29 GiB while measured `C:` roots totaled ~0.45\nGiB (`C:\\Users` ~0.33 GiB, `C:\\Program Files` ~0.06 GiB, `C:\\Windows`\n~0.03 GiB). The full cold build took 2h20m36s.\n\nThe Bazel timing improvement is directional because both refreshed\nshards failed tests. The V8 trace is a bounded build-tail sample, not\nthe full build. All final samples had zero lost ETW events; VHDX traffic\nwas excluded from the optimization ranking.\n\nRuns: [baseline\nBazel](https://github.com/openai/codex/actions/runs/28911908527),\n[updated\nBazel](https://github.com/openai/codex/actions/runs/28917133701), [V8\nbuild tail](https://github.com/openai/codex/actions/runs/28933626678).\n\n## Manual validation\n\n- Ran `just fmt`.\n- Ran `just test-github-scripts` (35 tests).\n- Parsed GitHub Actions YAML with `yq`.\n- Ran `git diff --check`.\n\n## Stack\n\n- [#31332](https://github.com/openai/codex/pull/31332) — parameterize\nCargo target paths\n- [#31356](https://github.com/openai/codex/pull/31356) — Windows 2025\nrunner bump\n- [#31357](https://github.com/openai/codex/pull/31357) — Dev Drive I/O\nrouting","verified_at":"2026-07-08T21:06:37Z"}},"url":"https://api.github.com/repos/openai/codex/commits/bd5c860abe0f492d96f4f868717f8c377a538dd3","html_url":"https://github.com/openai/codex/commit/bd5c860abe0f492d96f4f868717f8c377a538dd3","comments_url":"https://api.github.com/repos/openai/codex/commits/bd5c860abe0f492d96f4f868717f8c377a538dd3/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e621d7df8c4571e0b996a29095ef0de5bc93af5c","url":"https://api.github.com/repos/openai/codex/commits/e621d7df8c4571e0b996a29095ef0de5bc93af5c","html_url":"https://github.com/openai/codex/commit/e621d7df8c4571e0b996a29095ef0de5bc93af5c"}]},{"sha":"e621d7df8c4571e0b996a29095ef0de5bc93af5c","node_id":"C_kwDOOYsS4doAKGU2MjFkN2RmOGM0NTcxZTBiOTk2YTI5MDk1ZWYwZGU1YmM5M2FmNWM","commit":{"author":{"name":"Michael Bolin","email":"mbolin@openai.com","date":"2026-07-08T21:06:15Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T21:06:15Z"},"message":"core: preserve Responses WebSockets with system proxy (#31441)\n\n## Why\n\nResponses WebSockets are the normal lower-latency transport for\nWebSocket-capable providers. They must not bypass an OS-selected proxy\nwhen `features.respect_system_proxy` is enabled, but disabling\nWebSockets whenever the feature is enabled would impose a substantial\nperformance penalty.\n\nMerged PR #31622 introduced the reusable proxy-aware WebSocket\ntransport. This PR makes the Responses API its first consumer so the\nexisting fast path uses the same effective proxy and trust policy as\nHTTP.\n\n## What changed\n\n- Register `codex-websocket-client` as a workspace dependency and use it\nfrom `codex-api`.\n- Feed the shared crate’s route-independent `WebSocketConnection` into\nthe existing Responses message pump.\n- Require a configured `HttpClientFactory` for normal Responses\nWebSocket connections and the CLI doctor probe, so neither path can open\na connection without consulting the effective proxy policy.\n- Pass the session factory from `core` and the effective configuration\nfactory from `doctor`.\n- Add an end-to-end Responses test that enables `RespectSystemProxy`,\nasserts the resolved policy, completes a turn over WebSocket, and\nverifies the connection and request counts.\n- Keep the existing Responses protocol handling, ping/pong pump, and\nsession-scoped HTTP fallback unchanged.\n\nThe DNS, proxy, TLS, custom-CA, and Happy Eyeballs implementation and\nits transport tests live in merged PR #31622. This PR deliberately\ncontains only the Responses integration and does not duplicate that\ntransport code.\n\n## Review guide\n\n1. `codex-rs/codex-api/src/endpoint/responses_websocket.rs` constructs\nthe shared connector and adapts its uniform stream to the existing pump.\n2. `codex-rs/core/src/client.rs` supplies the session-scoped factory for\nproduction Responses connections.\n3. `codex-rs/cli/src/doctor.rs` supplies the effective configuration\nfactory to the handshake probe.\n4. `codex-rs/core/tests/suite/client_websockets.rs` covers the\nenabled-feature path end to end.\n\n## Test plan\n\n- `cargo check --tests -p codex-api -p codex-core -p codex-cli`\n- `just test -p codex-api`\n- `just test -p codex-core\nresponses_websocket_streams_with_system_proxy_feature`\n- `cargo shear`\n- `just bazel-lock-check`\n\n\n---\n[//]: # (BEGIN SAPLING FOOTER)\nStack created with [Sapling](https://sapling-scm.com). Best reviewed\nwith [ReviewStack](https://reviewstack.dev/openai/codex/pull/31441).\n* #31637\n* #31431\n* #31363\n* #31362\n* #31361\n* __->__ #31441","tree":{"sha":"5a41e4807449ca397607bf10bf8008be8e1f7918","url":"https://api.github.com/repos/openai/codex/git/trees/5a41e4807449ca397607bf10bf8008be8e1f7918"},"url":"https://api.github.com/repos/openai/codex/git/commits/e621d7df8c4571e0b996a29095ef0de5bc93af5c","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTrvHCRC1aQ7uu5UhlAAAbZIQAGVx9WKkcCp7O/NEEagUXZcW\nyfHPx9eGR59KU/LGvbZH3BM+pgI9jrAD9Jdhqz9SKsRf43FpTirUTLBHRocNHDrG\n3E5U3AMhIBBbPx/eYBCzK27l3/Aq4kTgwSVD5U65Q6u8hBQTPfH25Ceuc12qwhov\n3ie8AIZhoDWElpgOOUiEP6gPMZpOLSpcfmaT6PgWgk6Py4jJq18uCAzRtEq3DKSP\nZoHu2ZkbuIDbo65yYjohzYgQLATW3YJ43FlK7MIN/M95A86Ol/FI4nVIBQjfgSPA\nR3DaOahFoce0XmvZq33AgwgUldSoLjSA+j139slFE9nBiIB86qgxdYTOCcfYMDR7\nD32U9R1golx82K5yUPNLPqPspW4GD/7y47dZJQcr3aJcQywoK+KZdgrefurMJ/yP\nq9qGEdoNDCWPFi8zo6IYZek15NUBPN0DtHFrfJmxRTd2jX4z5B8n8bBmk5wk5Fjm\njxBcgm2hIbFMHBahyyV9+wP/1puns/s/7Xyict5vpsghWTkeei1HTs1QfOMq3PO5\nJWeZjlT5tAKVkFBMr9xU3THf23QplXAGsqhOMDrf4wUKd1+z8myQ2ObPxAkTZyPI\nUPybCRURSfxTOtzOO1OIMT4udqpXbigq4USCzTgYFVeIZVd07gOj6TSYInIwjX1q\nIUPMsoDm8c9b2RV8gtwR\n=uaWO\n-----END PGP SIGNATURE-----\n","payload":"tree 5a41e4807449ca397607bf10bf8008be8e1f7918\nparent 602dbb42dcc9504252525bb01182771f39c68cf1\nauthor Michael Bolin <mbolin@openai.com> 1783544775 -0700\ncommitter GitHub <noreply@github.com> 1783544775 -0700\n\ncore: preserve Responses WebSockets with system proxy (#31441)\n\n## Why\n\nResponses WebSockets are the normal lower-latency transport for\nWebSocket-capable providers. They must not bypass an OS-selected proxy\nwhen `features.respect_system_proxy` is enabled, but disabling\nWebSockets whenever the feature is enabled would impose a substantial\nperformance penalty.\n\nMerged PR #31622 introduced the reusable proxy-aware WebSocket\ntransport. This PR makes the Responses API its first consumer so the\nexisting fast path uses the same effective proxy and trust policy as\nHTTP.\n\n## What changed\n\n- Register `codex-websocket-client` as a workspace dependency and use it\nfrom `codex-api`.\n- Feed the shared crate’s route-independent `WebSocketConnection` into\nthe existing Responses message pump.\n- Require a configured `HttpClientFactory` for normal Responses\nWebSocket connections and the CLI doctor probe, so neither path can open\na connection without consulting the effective proxy policy.\n- Pass the session factory from `core` and the effective configuration\nfactory from `doctor`.\n- Add an end-to-end Responses test that enables `RespectSystemProxy`,\nasserts the resolved policy, completes a turn over WebSocket, and\nverifies the connection and request counts.\n- Keep the existing Responses protocol handling, ping/pong pump, and\nsession-scoped HTTP fallback unchanged.\n\nThe DNS, proxy, TLS, custom-CA, and Happy Eyeballs implementation and\nits transport tests live in merged PR #31622. This PR deliberately\ncontains only the Responses integration and does not duplicate that\ntransport code.\n\n## Review guide\n\n1. `codex-rs/codex-api/src/endpoint/responses_websocket.rs` constructs\nthe shared connector and adapts its uniform stream to the existing pump.\n2. `codex-rs/core/src/client.rs` supplies the session-scoped factory for\nproduction Responses connections.\n3. `codex-rs/cli/src/doctor.rs` supplies the effective configuration\nfactory to the handshake probe.\n4. `codex-rs/core/tests/suite/client_websockets.rs` covers the\nenabled-feature path end to end.\n\n## Test plan\n\n- `cargo check --tests -p codex-api -p codex-core -p codex-cli`\n- `just test -p codex-api`\n- `just test -p codex-core\nresponses_websocket_streams_with_system_proxy_feature`\n- `cargo shear`\n- `just bazel-lock-check`\n\n\n---\n[//]: # (BEGIN SAPLING FOOTER)\nStack created with [Sapling](https://sapling-scm.com). Best reviewed\nwith [ReviewStack](https://reviewstack.dev/openai/codex/pull/31441).\n* #31637\n* #31431\n* #31363\n* #31362\n* #31361\n* __->__ #31441","verified_at":"2026-07-08T21:06:15Z"}},"url":"https://api.github.com/repos/openai/codex/commits/e621d7df8c4571e0b996a29095ef0de5bc93af5c","html_url":"https://github.com/openai/codex/commit/e621d7df8c4571e0b996a29095ef0de5bc93af5c","comments_url":"https://api.github.com/repos/openai/codex/commits/e621d7df8c4571e0b996a29095ef0de5bc93af5c/comments","author":{"login":"bolinfest","id":655869,"node_id":"MDQ6VXNlcjY1NTg2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/655869?v=4","gravatar_id":"","url":"https://api.github.com/users/bolinfest","html_url":"https://github.com/bolinfest","followers_url":"https://api.github.com/users/bolinfest/followers","following_url":"https://api.github.com/users/bolinfest/following{/other_user}","gists_url":"https://api.github.com/users/bolinfest/gists{/gist_id}","starred_url":"https://api.github.com/users/bolinfest/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bolinfest/subscriptions","organizations_url":"https://api.github.com/users/bolinfest/orgs","repos_url":"https://api.github.com/users/bolinfest/repos","events_url":"https://api.github.com/users/bolinfest/events{/privacy}","received_events_url":"https://api.github.com/users/bolinfest/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"602dbb42dcc9504252525bb01182771f39c68cf1","url":"https://api.github.com/repos/openai/codex/commits/602dbb42dcc9504252525bb01182771f39c68cf1","html_url":"https://github.com/openai/codex/commit/602dbb42dcc9504252525bb01182771f39c68cf1"}]},{"sha":"602dbb42dcc9504252525bb01182771f39c68cf1","node_id":"C_kwDOOYsS4doAKDYwMmRiYjQyZGNjOTUwNDI1MjUyNWJiMDExODI3NzFmMzljNjhjZjE","commit":{"author":{"name":"Owen Lin","email":"owenlin0@gmail.com","date":"2026-07-08T20:53:36Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T20:53:36Z"},"message":"core: stop emitting legacy command events directly (#31629)\n\n## Description\n\nThis PR removes the last path in core that emits `ExecCommandBegin` /\n`ExecCommandEnd` directly.\n\nEvery command execution now starts and completes through canonical\n`ItemStarted` / `ItemCompleted(TurnItem::CommandExecution)`. The\nexisting `HasLegacyEvent` compatibility layer still fans out Begin/End\nafterward, so raw core event consumers and legacy rollout replay keep\nseeing the same events.\n\n`UnifiedExecInteraction` is dormant today. Live unified exec uses\n`UnifiedExecStartup` for command lifecycle and `TerminalInteraction` for\n`write_stdin` and polling, so this is code cleanup rather than a current\nproduct behavior change. The main win is the code-level invariant where\nall core flows emit `TurnItem` instead of legacy events.\n\n## What changed\n\n- Removed the `UnifiedExecInteraction` branches that emitted legacy\ncommand events directly.\n- Routed every command source through the existing canonical\n`CommandExecution` lifecycle and compatibility fanout.","tree":{"sha":"b953f7a2fd87e8b63130694604728b521ffbeae3","url":"https://api.github.com/repos/openai/codex/git/trees/b953f7a2fd87e8b63130694604728b521ffbeae3"},"url":"https://api.github.com/repos/openai/codex/git/commits/602dbb42dcc9504252525bb01182771f39c68cf1","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTrjQCRC1aQ7uu5UhlAAAT/YQABStpjGxmxEF6PMbXpWZlenk\nfy1PZF0vbXrLF3H425poyop9ViY4jq3hfRLCtyQr2zYcQLUllivSP/uB8ha6TmHQ\nwgVdw5H4EKgSbSq1cBhovVKeJEXO4JK3/ccD5KzlihXORVh+D+PYSDUedmYj+UpX\n887eU6jfA+7wLqklZzlaQy2S5I96cKmKIT7/KqZZ5a8aDmiAGIqhul/BEI/9Ar8q\n1zFijQ7kumxtYi9B9dJOVtGQRK6u1UZNfQPT5RC7LASigB5giMQ4+dtq0H2ForaM\ndD+m1qPkobE1OXRW8sxUMVpYbO9GZTadhsU+9cu5T2I50H7fKKCLnVKg9QtRM/Lt\nk7dmzlyLvmxRiCLnkjvmH5KXQ42hHSui3yGSJ1u5KylCXBdUsH5eGIexF5MdX8lQ\nqlvs45oKriE+J6S+Ai3sP91zqumVlOg4QNH1cRABKSU/y+tawCJ4+5tOlBYjzuYi\nz7R1bPlrVx316LNdJ+BCIIf1Ihm6ASPcS9JwEU2gGWvydP2yP8wL7mwBL4PWBzdD\ni75LrYYhIXQiBL28jwp0qrIa/1Pdpw286JnkTBKJJBXP2nfGaESDFiuiLAo7M+lM\n9iyUEfaTH9HuDQteZVU4n147/BEsn4O9I5Yy9MHiGJRr2chPbtw2bw6p5RZ1lkm4\ns5H8qz1FMNopMKre9zuq\n=mnlV\n-----END PGP SIGNATURE-----\n","payload":"tree b953f7a2fd87e8b63130694604728b521ffbeae3\nparent bff9c4945a7ba83e5c9b1e5787ce7b0c5f0c613c\nauthor Owen Lin <owenlin0@gmail.com> 1783544016 -0700\ncommitter GitHub <noreply@github.com> 1783544016 +0000\n\ncore: stop emitting legacy command events directly (#31629)\n\n## Description\n\nThis PR removes the last path in core that emits `ExecCommandBegin` /\n`ExecCommandEnd` directly.\n\nEvery command execution now starts and completes through canonical\n`ItemStarted` / `ItemCompleted(TurnItem::CommandExecution)`. The\nexisting `HasLegacyEvent` compatibility layer still fans out Begin/End\nafterward, so raw core event consumers and legacy rollout replay keep\nseeing the same events.\n\n`UnifiedExecInteraction` is dormant today. Live unified exec uses\n`UnifiedExecStartup` for command lifecycle and `TerminalInteraction` for\n`write_stdin` and polling, so this is code cleanup rather than a current\nproduct behavior change. The main win is the code-level invariant where\nall core flows emit `TurnItem` instead of legacy events.\n\n## What changed\n\n- Removed the `UnifiedExecInteraction` branches that emitted legacy\ncommand events directly.\n- Routed every command source through the existing canonical\n`CommandExecution` lifecycle and compatibility fanout.","verified_at":"2026-07-08T20:53:37Z"}},"url":"https://api.github.com/repos/openai/codex/commits/602dbb42dcc9504252525bb01182771f39c68cf1","html_url":"https://github.com/openai/codex/commit/602dbb42dcc9504252525bb01182771f39c68cf1","comments_url":"https://api.github.com/repos/openai/codex/commits/602dbb42dcc9504252525bb01182771f39c68cf1/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"bff9c4945a7ba83e5c9b1e5787ce7b0c5f0c613c","url":"https://api.github.com/repos/openai/codex/commits/bff9c4945a7ba83e5c9b1e5787ce7b0c5f0c613c","html_url":"https://github.com/openai/codex/commit/bff9c4945a7ba83e5c9b1e5787ce7b0c5f0c613c"}]},{"sha":"bff9c4945a7ba83e5c9b1e5787ce7b0c5f0c613c","node_id":"C_kwDOOYsS4doAKGJmZjljNDk0NWE3YmE4M2U1YzliMWU1Nzg3Y2U3YjBjNWYwYzYxM2M","commit":{"author":{"name":"Celia Chen","email":"celia@openai.com","date":"2026-07-08T20:53:18Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T20:53:18Z"},"message":"feat: change amazon Bedrock GPT-5.6 display names (#31636)\n\n## Why\n\nAmazon Bedrock's GPT-5.6 variants currently appear as only `Sol`,\n`Terra`, and `Luna`. Those labels omit the model family and version,\nmaking them ambiguous in model lists and inconsistent with the naming of\nother GPT models.\n\n## What changed\n\n- Rename the three Bedrock model display names to `GPT-5.6 Sol`,\n`GPT-5.6 Terra`, and `GPT-5.6 Luna`.\n- Strengthen the Bedrock model-manager test to verify both model IDs and\ntheir propagated display names.\n\nModel IDs, ordering, priorities, reasoning support, and default\nselection are unchanged.","tree":{"sha":"46bfeefe952a7ea19bd3d26f416f189acc08110a","url":"https://api.github.com/repos/openai/codex/git/trees/46bfeefe952a7ea19bd3d26f416f189acc08110a"},"url":"https://api.github.com/repos/openai/codex/git/commits/bff9c4945a7ba83e5c9b1e5787ce7b0c5f0c613c","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTri+CRC1aQ7uu5UhlAAAMo4QACN8N1uQyz5yIPWf9zhBpjLs\n7rMZ8FpInZv7RkIwdfpTmUf1xwyfEEHF4jjEHGBNQsIL61yrxwuYFxW9dDcpYjDy\nNrCtZ2Of2simHvWP3VnRcyzzPzThna0g4D3y5Allmt+8ZDpGGTs5pUz5WhZPCJ77\nP3YI4sXC9dPy60PRBrtua69Kbb9lLH5mpGcmWaun1UeEBnwQQAZ+etXzxVfRd0DO\njgpuOpc1vysGM/vyr8rqOlqv50zxRY/LxSU08/llj0Gvvl7G0MYTXuDLxJogRmxf\nwzavj9AEVVn7QU6JffZ5tBY+gb5Bv6ySMcW74Rs360Wmw3mJAA5vsxXVWlFce5eI\n6uSxgb+CvOeNWxutxS0V2V1Gn0C1yhgH/eBFQEMmC9aYFuR+Q9aDfMS6eI/9S6+C\nIrwrBlBg/WpQ8SARCT1e0l/BmUs6CHzB01YJFRYEw/fgIspmfN+EOF5plEyTC+Oj\n8+9v6G6MZXEPeE+QutIRAUtmxL+SbLQVerGTJW3pv4KtDASRFNZmdO8nXtvqqgTU\nf9J4V+v6HOt4yvEuKbtNz5hIu/0Oqt6s4ZLeRW+QaXfavPYC/p219NXucSTS0MvR\nFAYI6uianZhTZyDeG+5RAcgYJyAzzuCoAFPKQlWvGdGNz+fehyc2X+KNySLujM2l\nq+rxXk9SvThjWQSqoyPL\n=i553\n-----END PGP SIGNATURE-----\n","payload":"tree 46bfeefe952a7ea19bd3d26f416f189acc08110a\nparent ba5dd1fd3acd8802325945b88219e69e8b744c40\nauthor Celia Chen <celia@openai.com> 1783543998 -0700\ncommitter GitHub <noreply@github.com> 1783543998 -0700\n\nfeat: change amazon Bedrock GPT-5.6 display names (#31636)\n\n## Why\n\nAmazon Bedrock's GPT-5.6 variants currently appear as only `Sol`,\n`Terra`, and `Luna`. Those labels omit the model family and version,\nmaking them ambiguous in model lists and inconsistent with the naming of\nother GPT models.\n\n## What changed\n\n- Rename the three Bedrock model display names to `GPT-5.6 Sol`,\n`GPT-5.6 Terra`, and `GPT-5.6 Luna`.\n- Strengthen the Bedrock model-manager test to verify both model IDs and\ntheir propagated display names.\n\nModel IDs, ordering, priorities, reasoning support, and default\nselection are unchanged.","verified_at":"2026-07-08T20:53:19Z"}},"url":"https://api.github.com/repos/openai/codex/commits/bff9c4945a7ba83e5c9b1e5787ce7b0c5f0c613c","html_url":"https://github.com/openai/codex/commit/bff9c4945a7ba83e5c9b1e5787ce7b0c5f0c613c","comments_url":"https://api.github.com/repos/openai/codex/commits/bff9c4945a7ba83e5c9b1e5787ce7b0c5f0c613c/comments","author":{"login":"celia-oai","id":209693228,"node_id":"U_kgDODH-qLA","avatar_url":"https://avatars.githubusercontent.com/u/209693228?v=4","gravatar_id":"","url":"https://api.github.com/users/celia-oai","html_url":"https://github.com/celia-oai","followers_url":"https://api.github.com/users/celia-oai/followers","following_url":"https://api.github.com/users/celia-oai/following{/other_user}","gists_url":"https://api.github.com/users/celia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/celia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celia-oai/subscriptions","organizations_url":"https://api.github.com/users/celia-oai/orgs","repos_url":"https://api.github.com/users/celia-oai/repos","events_url":"https://api.github.com/users/celia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/celia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"ba5dd1fd3acd8802325945b88219e69e8b744c40","url":"https://api.github.com/repos/openai/codex/commits/ba5dd1fd3acd8802325945b88219e69e8b744c40","html_url":"https://github.com/openai/codex/commit/ba5dd1fd3acd8802325945b88219e69e8b744c40"}]},{"sha":"ba5dd1fd3acd8802325945b88219e69e8b744c40","node_id":"C_kwDOOYsS4doAKGJhNWRkMWZkM2FjZDg4MDIzMjU5NDViODgyMTllNjllOGI3NDRjNDA","commit":{"author":{"name":"Owen Lin","email":"owenlin0@gmail.com","date":"2026-07-08T20:42:06Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T20:42:06Z"},"message":"feat(core): emit canonical hook prompt items (#31630)\n\n## Description\n\nThis PR moves hook prompts onto the canonical `TurnItem` lifecycle in\ncore.\n\nStop hooks now record their `ResponseItem` through the existing\nlifecycle path, which emits `ItemStarted` and `ItemCompleted`.\nApp-server consumes those events directly instead of deriving a hook\nprompt from `RawResponseItem`.\n\n## Why\n\nHook prompts were the only `ThreadItem` app-server synthesized from\n`RawResponseItem`. This brings them in line with other core-owned turn\nitems while preserving legacy rollout replay.\n\n## What changed\n\n- Route stop-hook prompts through\n`record_response_item_and_emit_turn_item`.\n- Materialize canonical hook prompts in `ThreadHistoryBuilder`.\n- Remove `RawResponseItem` to `ThreadItem` synthesis while preserving\nlegacy rollout replay.\n- Add focused coverage for lifecycle emission and canonical and legacy\nhistory materialization.","tree":{"sha":"e6609a4ad2e53b3893263adcd1c891f53be6fd73","url":"https://api.github.com/repos/openai/codex/git/trees/e6609a4ad2e53b3893263adcd1c891f53be6fd73"},"url":"https://api.github.com/repos/openai/codex/git/commits/ba5dd1fd3acd8802325945b88219e69e8b744c40","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTrYeCRC1aQ7uu5UhlAAASYYQAA+vCt6OuJtyhE/dQqAFx8MI\neo8h3TmuaQSMjFx0voFQFdmC5uI8UKBIhkkj7+RGo0HJYAqxPd9hQpLatcPq4DFQ\n4K/YmMdcgKm8e7KH9mvxegSuutlOpfasKxooAjilnSWecA9x6tWZxo0GQxGbyUkS\nwv75jBPnAEwZt52EweeRUMavFDq6ljbgk9JhQOGXs+EFyDtB8g3qsXS1Hu/onw3M\n5WzTm3hRtPTyfD10+eU9gCwqUJOZ+/tGo6y+NH5Uwdo2HjEIPrk9q5pzvpsKIjPe\n6p/nm3xeFqIREX1uOjCreXHJPRWk+AfOqT1sMv3h54RHpZme4G5+ho6ErvTBsms5\nJl6MryXpu8qhVV3w5gnvKNvkib3YstkGtQ7oa4IMLLbF5B9sjshqcqE32r1zyEF9\nL9E3UBM9uyvE/giv7ok3kL/f4aDcbyRgbkNjyokjMVQ1y7pg24+PoL0gU6FX27gJ\nw5pyK5ZnfysnuGV+1IFbxXyabl8v82bNGluRYTPD/lOSTcf2/6eUyQOsi66ugMuD\nDHRrldCSSOl3CxNI24f4e4nG15PQVx9lwjDkhvGuBGieRTBz8iSCT1FNKT8In9CW\nugz/HZYtCCA4DkkEo1r1GoNuf4JOKH3pgxPDXAH0nOIMGXklSdF4dmgYAXeXgZXk\n+ZQVaGboY68yJuiyN8+K\n=uEIx\n-----END PGP SIGNATURE-----\n","payload":"tree e6609a4ad2e53b3893263adcd1c891f53be6fd73\nparent bdaad6820cd884ea11787477f4c495e4de0a8be5\nauthor Owen Lin <owenlin0@gmail.com> 1783543326 -0700\ncommitter GitHub <noreply@github.com> 1783543326 -0700\n\nfeat(core): emit canonical hook prompt items (#31630)\n\n## Description\n\nThis PR moves hook prompts onto the canonical `TurnItem` lifecycle in\ncore.\n\nStop hooks now record their `ResponseItem` through the existing\nlifecycle path, which emits `ItemStarted` and `ItemCompleted`.\nApp-server consumes those events directly instead of deriving a hook\nprompt from `RawResponseItem`.\n\n## Why\n\nHook prompts were the only `ThreadItem` app-server synthesized from\n`RawResponseItem`. This brings them in line with other core-owned turn\nitems while preserving legacy rollout replay.\n\n## What changed\n\n- Route stop-hook prompts through\n`record_response_item_and_emit_turn_item`.\n- Materialize canonical hook prompts in `ThreadHistoryBuilder`.\n- Remove `RawResponseItem` to `ThreadItem` synthesis while preserving\nlegacy rollout replay.\n- Add focused coverage for lifecycle emission and canonical and legacy\nhistory materialization.","verified_at":"2026-07-08T20:42:06Z"}},"url":"https://api.github.com/repos/openai/codex/commits/ba5dd1fd3acd8802325945b88219e69e8b744c40","html_url":"https://github.com/openai/codex/commit/ba5dd1fd3acd8802325945b88219e69e8b744c40","comments_url":"https://api.github.com/repos/openai/codex/commits/ba5dd1fd3acd8802325945b88219e69e8b744c40/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"bdaad6820cd884ea11787477f4c495e4de0a8be5","url":"https://api.github.com/repos/openai/codex/commits/bdaad6820cd884ea11787477f4c495e4de0a8be5","html_url":"https://github.com/openai/codex/commit/bdaad6820cd884ea11787477f4c495e4de0a8be5"}]},{"sha":"bdaad6820cd884ea11787477f4c495e4de0a8be5","node_id":"C_kwDOOYsS4doAKGJkYWFkNjgyMGNkODg0ZWExMTc4NzQ3N2Y0YzQ5NWU0ZGUwYThiZTU","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-07-08T20:35:31Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T20:35:31Z"},"message":"Reuse MCP tool snapshot within a sampling request (#31292)\n\nFollow-up to #30226.\n\n## Why\n\n#30226 makes Apps World State inspect the MCP tool list, while\ntool-router construction reads the same list again later in the sampling\nrequest. `list_all_tools()` walks the MCP clients and may reconnect or\nwait for tools, so doing that work twice adds latency and lets context\nand tool construction observe different MCP states for one request.\n\n## What\n\n- Add a lazy MCP tool snapshot to `StepContext`.\n- Reuse that snapshot for Apps World State and tool-router construction.\n- Let each new `StepContext` refresh naturally for the next sampling\nrequest, without manager-level caching or invalidation.\n\n## Testing\n\n- `just test -p codex-core apps_instructions`\n- `just test -p codex-core\napps_guidance_appears_after_background_recovery_within_a_turn`","tree":{"sha":"87159604a374da55278e695c099b63a2cb732508","url":"https://api.github.com/repos/openai/codex/git/trees/87159604a374da55278e695c099b63a2cb732508"},"url":"https://api.github.com/repos/openai/codex/git/commits/bdaad6820cd884ea11787477f4c495e4de0a8be5","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTrSTCRC1aQ7uu5UhlAAARiIQACZ+S5anUv+BKzog+HCR1RPc\nUhWsLF+1wWgka58qeLmQvOWHO6ELd+pd/kUP8jTNbPUCocfVoz58G0CyfYZYaKuD\npUjCB0VsOuepTz53kxwSDzkHDNZy/sGKxQMztj5upsNYOaq9dlyecOvKXrJzay9L\nXVpohs/uWVpa9HzJIFymZbWA1ZDICRwyJVefhaOyWda8I+Ve0tZW/BK4gdiqhdBc\n4xgtaUHVNmHdKbBPch3QVUwM7CkSzU3jlTaKq8kAvE6KvsZBQIzoBH2YMoGc05Zh\n03X1rhgOVL7uRn9GHEwWHAOW+5GcBGW+NPf1NvDx+DVy/ssOMTgYa0jkhGVbEjxG\nRkirVuHFYxcQ2XbeBDqHhr34Q9JpUnFFxsE1q6rmCFEGIgEV6ygCRkhR5AgyCltI\nuihMCTTPVrdC2paRflJd+8lVEzOR3uKg6U+g8/dh631otnHUdEjtzbcW5OSr+FFJ\nouysdvuZ0vYdRXM9Ob+CSqPrKQSLg8EWlKDS5LzF1WPcmM4o9mZGv4t88cEyeini\nRnRQUpXUEWp6SmT5JiZNbUGsAB9Cz7FHAXNEwE0KTsTQ63qLpRm0GGTeK1O39Lla\ndMwPXhbYBx8iB7RCzmUuAHdgIN3eGGyzF4I2nlld2bq/wFwkr5RjtQUOvxTQmHeZ\nYbeyWqRFUgri3u6F8GU0\n=UAe1\n-----END PGP SIGNATURE-----\n","payload":"tree 87159604a374da55278e695c099b63a2cb732508\nparent c6b124bb31b5bc5db0142f3152e4a2ecd2dd2637\nauthor sayan-oai <sayan@openai.com> 1783542931 -0700\ncommitter GitHub <noreply@github.com> 1783542931 -0700\n\nReuse MCP tool snapshot within a sampling request (#31292)\n\nFollow-up to #30226.\n\n## Why\n\n#30226 makes Apps World State inspect the MCP tool list, while\ntool-router construction reads the same list again later in the sampling\nrequest. `list_all_tools()` walks the MCP clients and may reconnect or\nwait for tools, so doing that work twice adds latency and lets context\nand tool construction observe different MCP states for one request.\n\n## What\n\n- Add a lazy MCP tool snapshot to `StepContext`.\n- Reuse that snapshot for Apps World State and tool-router construction.\n- Let each new `StepContext` refresh naturally for the next sampling\nrequest, without manager-level caching or invalidation.\n\n## Testing\n\n- `just test -p codex-core apps_instructions`\n- `just test -p codex-core\napps_guidance_appears_after_background_recovery_within_a_turn`","verified_at":"2026-07-08T20:35:32Z"}},"url":"https://api.github.com/repos/openai/codex/commits/bdaad6820cd884ea11787477f4c495e4de0a8be5","html_url":"https://github.com/openai/codex/commit/bdaad6820cd884ea11787477f4c495e4de0a8be5","comments_url":"https://api.github.com/repos/openai/codex/commits/bdaad6820cd884ea11787477f4c495e4de0a8be5/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c6b124bb31b5bc5db0142f3152e4a2ecd2dd2637","url":"https://api.github.com/repos/openai/codex/commits/c6b124bb31b5bc5db0142f3152e4a2ecd2dd2637","html_url":"https://github.com/openai/codex/commit/c6b124bb31b5bc5db0142f3152e4a2ecd2dd2637"}]},{"sha":"c6b124bb31b5bc5db0142f3152e4a2ecd2dd2637","node_id":"C_kwDOOYsS4doAKGM2YjEyNGJiMzFiNWJjNWRiMDE0MmYzMTUyZTRhMmVjZDJkZDI2Mzc","commit":{"author":{"name":"Abhinav","email":"abhinav@openai.com","date":"2026-07-08T20:22:10Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T20:22:10Z"},"message":"[codex] Grant Windows sandbox access to primary runtime (#31574)\n\n## Why\n\nCodex Desktop installs its managed primary runtime under\n`%USERPROFILE%\\.cache\\codex-runtimes`. Elevated Windows sandbox commands\nrun as dedicated sandbox users. The synchronous runtime ACL refresh\nrepairs read/execute access for the Desktop runtime directories under\n`%LOCALAPPDATA%\\OpenAI\\Codex`, but did not include the managed primary\nruntime cache.\n\nAs a result, the Desktop app could discover a bundled runtime while a\nsandboxed command received `ACCESS_DENIED` when reading or executing it.\n\n## What changed\n\n- Include `%USERPROFILE%\\.cache\\codex-runtimes` in the managed runtime\npaths considered by the Windows sandbox ACL refresh.\n- Reuse the existing inherited read/execute ACL repair; no write\npermission is added.\n- Add Windows-target regression coverage for the runtime path list and\nthe primary-runtime-only case.\n\n## Impact\n\nBundled Python, Node, and native tools remain usable from elevated\nWindows sandbox sessions without broadening write access or granting\naccess to the rest of the user profile.\n\n## Validation\n\n- `just fmt`\n- `just test -p codex-windows-sandbox` (10/10 host-side tests passed)\n- Windows-target path tests included for CI","tree":{"sha":"c5860023a6a0cf4cc23158642ce4470685f62ee0","url":"https://api.github.com/repos/openai/codex/git/trees/c5860023a6a0cf4cc23158642ce4470685f62ee0"},"url":"https://api.github.com/repos/openai/codex/git/commits/c6b124bb31b5bc5db0142f3152e4a2ecd2dd2637","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTrFyCRC1aQ7uu5UhlAAAu1IQAAqSrwNq/rgxOgSfz8ZqiT1X\niYNT2tPvvzrt7VG0fsCQU53Qi/nJAFow6EOSYYuawaHuclxTzYX4viCS7Z+bs7m1\nSWnklLfo4z3Ba/YdxA5gmKC1+ned8mV/GnLU+JlcE9TQiwhq9GQ9U9qBrp346zGl\nBXE4QplOHDaDeRc+Ymf/sZz0b8/7GfIzGf2VzbUt4VHNVjk0Ipnmh7wBJtYnFr9i\nWz7wIUDDcJWRwy9ggqU2CaO35KFDz/p2jOfDfIxwuhOyRq2ZUpWwULnyrmnOSTSX\nwK/KRynHrOaVIrnfSVaLi9w97YVAArr/pUyTaZ536sT0bmhhsuzfTOoCXkAjJPQZ\n9GlvvaZERxMKasU6B0AGu04FAU65YnOEkAeMmOlykp0zfXFZJL8kojGoJzj8suSL\ndEbrT40X2h/oIBUZUmi9pi3R23uqQE1CKSOmpO7o6KGOy6Gvt398zDKxGAUevmri\nBdYiibX8OntkieH4md6f38LV4ugURoJNwMb+P8uLz3Wz8K6Qtv4PE/bD1mRljBrf\nAySW3WLKgKNsz7k0+WE+mdKsMH4OROQ5O+ESaSzPBo+I9gODvK6oRtYRWPIbV8md\nxmDThEEdkcrr4eXrl2c+r5IvFmpRmqtIgdYi90DtD9oosO+ltTlipj19Rx8P7gKl\nNFLxLFIUlQt+dVsphUyN\n=XRHS\n-----END PGP SIGNATURE-----\n","payload":"tree c5860023a6a0cf4cc23158642ce4470685f62ee0\nparent 2780bd588f8170abd41455d5509409ae0f76ffe9\nauthor Abhinav <abhinav@openai.com> 1783542130 -0700\ncommitter GitHub <noreply@github.com> 1783542130 -0700\n\n[codex] Grant Windows sandbox access to primary runtime (#31574)\n\n## Why\n\nCodex Desktop installs its managed primary runtime under\n`%USERPROFILE%\\.cache\\codex-runtimes`. Elevated Windows sandbox commands\nrun as dedicated sandbox users. The synchronous runtime ACL refresh\nrepairs read/execute access for the Desktop runtime directories under\n`%LOCALAPPDATA%\\OpenAI\\Codex`, but did not include the managed primary\nruntime cache.\n\nAs a result, the Desktop app could discover a bundled runtime while a\nsandboxed command received `ACCESS_DENIED` when reading or executing it.\n\n## What changed\n\n- Include `%USERPROFILE%\\.cache\\codex-runtimes` in the managed runtime\npaths considered by the Windows sandbox ACL refresh.\n- Reuse the existing inherited read/execute ACL repair; no write\npermission is added.\n- Add Windows-target regression coverage for the runtime path list and\nthe primary-runtime-only case.\n\n## Impact\n\nBundled Python, Node, and native tools remain usable from elevated\nWindows sandbox sessions without broadening write access or granting\naccess to the rest of the user profile.\n\n## Validation\n\n- `just fmt`\n- `just test -p codex-windows-sandbox` (10/10 host-side tests passed)\n- Windows-target path tests included for CI","verified_at":"2026-07-08T20:22:11Z"}},"url":"https://api.github.com/repos/openai/codex/commits/c6b124bb31b5bc5db0142f3152e4a2ecd2dd2637","html_url":"https://github.com/openai/codex/commit/c6b124bb31b5bc5db0142f3152e4a2ecd2dd2637","comments_url":"https://api.github.com/repos/openai/codex/commits/c6b124bb31b5bc5db0142f3152e4a2ecd2dd2637/comments","author":{"login":"abhinav-oai","id":274334565,"node_id":"U_kgDOEFoDZQ","avatar_url":"https://avatars.githubusercontent.com/u/274334565?v=4","gravatar_id":"","url":"https://api.github.com/users/abhinav-oai","html_url":"https://github.com/abhinav-oai","followers_url":"https://api.github.com/users/abhinav-oai/followers","following_url":"https://api.github.com/users/abhinav-oai/following{/other_user}","gists_url":"https://api.github.com/users/abhinav-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/abhinav-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abhinav-oai/subscriptions","organizations_url":"https://api.github.com/users/abhinav-oai/orgs","repos_url":"https://api.github.com/users/abhinav-oai/repos","events_url":"https://api.github.com/users/abhinav-oai/events{/privacy}","received_events_url":"https://api.github.com/users/abhinav-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"2780bd588f8170abd41455d5509409ae0f76ffe9","url":"https://api.github.com/repos/openai/codex/commits/2780bd588f8170abd41455d5509409ae0f76ffe9","html_url":"https://github.com/openai/codex/commit/2780bd588f8170abd41455d5509409ae0f76ffe9"}]},{"sha":"2780bd588f8170abd41455d5509409ae0f76ffe9","node_id":"C_kwDOOYsS4doAKDI3ODBiZDU4OGY4MTcwYWJkNDE0NTVkNTUwOTQwOWFlMGY3NmZmZTk","commit":{"author":{"name":"Michael Bolin","email":"mbolin@openai.com","date":"2026-07-08T19:57:27Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T19:57:27Z"},"message":"websocket-client: add proxy-aware connector (#31622)\n\n## Why\n\nThe route-aware WebSocket connection setup in #31441 is transport\ninfrastructure rather than Responses API protocol logic. Landing it\nfirst in a dedicated crate keeps `codex-api` focused on request and\nresponse behavior and makes the transport reusable by future WebSocket\nclients.\n\nWebSockets must also apply the same effective outbound proxy and\ncustom-CA policy as HTTP without disabling the lower-latency WebSocket\npath. Requiring an `HttpClientFactory` when constructing the connector\nmakes proxy-policy resolution part of the API instead of an optional\ncall-site convention.\n\nThis PR is an independent prerequisite based directly on `main`. After\nit merges, #31441 can rebase onto it and replace its in-crate connector\nwith this API.\n\n## What changed\n\n- Add a new `codex-websocket-client` workspace crate with a\n`WebSocketConnector` constructed from the effective `HttpClientFactory`.\n- Resolve every destination through that factory before connecting, then\nsupport direct connections, transport-default routing, HTTP proxies, and\nTLS-encrypted HTTPS proxies.\n- Preserve custom-CA trust for proxy and target TLS handshakes and\npreserve Happy Eyeballs fallback for explicit direct and proxy routes.\n- Expose an established `WebSocketConnection` as a uniform `Stream` and\n`Sink`, hiding route-specific transport types from protocol clients.\n- Add focused integration-style coverage for the public connector and\nmessage stream, real WSS over direct and CONNECT routes, implicit and\nexplicit HTTPS proxy ports, and stalled-address-family fallback.\n\n## Review guide\n\n1. `codex-rs/websocket-client/src/lib.rs` defines the small public API\nand the factory-required policy invariant.\n2. `codex-rs/websocket-client/src/dialer.rs` contains DNS, TCP, proxy\ntunneling, TLS, and WebSocket handshake setup.\n3. `codex-rs/websocket-client/src/dialer_tests.rs` verifies the public\nstream, direct and proxied WSS paths, HTTPS port preservation, and Happy\nEyeballs timing.\n4. There is intentionally no consumer migration here; #31441 will become\nthe first consumer after this prerequisite merges.\n\n## Test plan\n\n- `cargo check -p codex-websocket-client --tests`\n- `just test -p codex-websocket-client`\n- `cargo shear`\n- `just bazel-lock-check`","tree":{"sha":"d476df61a6a8a6f847a53ba3abf0aa768263ebd4","url":"https://api.github.com/repos/openai/codex/git/trees/d476df61a6a8a6f847a53ba3abf0aa768263ebd4"},"url":"https://api.github.com/repos/openai/codex/git/commits/2780bd588f8170abd41455d5509409ae0f76ffe9","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTqunCRC1aQ7uu5UhlAAAv2wQAImQfMG8LF4vmNR+IT9mnrfb\nbpDga/NPB7dvSSZa0XnwNJIzG68nZpm6VuEXVGxk3s7msLke8FwfAO7OntzBqmZU\ncQtaSSFG2ipkI7xxiZPgntPYzogj7mx933XixzFnBXfGYx6oN1sTaEmVaYw5qSPW\nsqD17j0Dj8Qro2Gfy/6aaL8v8EiOTY7uVyazoMgx5xUwmo9k2LYvcy6GeHaJMrxt\nqz6ET7c7xd0B1KaMpd+koUNRetYTxFy7vVt4I5B3fEUBLfkhfWDa9BUtG0T2SgAM\nDzCG3wtdtkhPHqouk8cgI5RMgsN2AQdUS+EMoizxc+/uz/Q7QlWm9aynfCTluAk8\nPuXzNhhDv/5XnpPzIRQiBjEhLwr7ZcOuWfOHgTz1GE0scbvFvv5aZgwK1qpSXNVj\nXvRTQPA1n4Y9CcDC2m2ZNaxnQ98lGVMIQBh27DYg0yUGKJ1Mnqkg1VLVwXHbpyTA\nj0+7L2Wihr8KNeP+gdHhU5JSTlRMMz47uTLDIE4CpHwROzjsNwasj0ztLh0B07ee\nrKnXzqRSKfF9Hy8wiA20ewX+ZvZ4A0FN8UGJKFwidnSSm3D4l3rA4GpULwjoDLMY\nLLREz/1bo1kWxzf+V9PiauZbEzUQMfYyqzfQ1g/2W1zXTBBpOaYtAe0FWXUKwO7+\ndATyge9HlmG2iU1rMnss\n=sMKn\n-----END PGP SIGNATURE-----\n","payload":"tree d476df61a6a8a6f847a53ba3abf0aa768263ebd4\nparent 927004c06dc55565af17f0bc8eeb5e35fb990351\nauthor Michael Bolin <mbolin@openai.com> 1783540647 -0700\ncommitter GitHub <noreply@github.com> 1783540647 -0700\n\nwebsocket-client: add proxy-aware connector (#31622)\n\n## Why\n\nThe route-aware WebSocket connection setup in #31441 is transport\ninfrastructure rather than Responses API protocol logic. Landing it\nfirst in a dedicated crate keeps `codex-api` focused on request and\nresponse behavior and makes the transport reusable by future WebSocket\nclients.\n\nWebSockets must also apply the same effective outbound proxy and\ncustom-CA policy as HTTP without disabling the lower-latency WebSocket\npath. Requiring an `HttpClientFactory` when constructing the connector\nmakes proxy-policy resolution part of the API instead of an optional\ncall-site convention.\n\nThis PR is an independent prerequisite based directly on `main`. After\nit merges, #31441 can rebase onto it and replace its in-crate connector\nwith this API.\n\n## What changed\n\n- Add a new `codex-websocket-client` workspace crate with a\n`WebSocketConnector` constructed from the effective `HttpClientFactory`.\n- Resolve every destination through that factory before connecting, then\nsupport direct connections, transport-default routing, HTTP proxies, and\nTLS-encrypted HTTPS proxies.\n- Preserve custom-CA trust for proxy and target TLS handshakes and\npreserve Happy Eyeballs fallback for explicit direct and proxy routes.\n- Expose an established `WebSocketConnection` as a uniform `Stream` and\n`Sink`, hiding route-specific transport types from protocol clients.\n- Add focused integration-style coverage for the public connector and\nmessage stream, real WSS over direct and CONNECT routes, implicit and\nexplicit HTTPS proxy ports, and stalled-address-family fallback.\n\n## Review guide\n\n1. `codex-rs/websocket-client/src/lib.rs` defines the small public API\nand the factory-required policy invariant.\n2. `codex-rs/websocket-client/src/dialer.rs` contains DNS, TCP, proxy\ntunneling, TLS, and WebSocket handshake setup.\n3. `codex-rs/websocket-client/src/dialer_tests.rs` verifies the public\nstream, direct and proxied WSS paths, HTTPS port preservation, and Happy\nEyeballs timing.\n4. There is intentionally no consumer migration here; #31441 will become\nthe first consumer after this prerequisite merges.\n\n## Test plan\n\n- `cargo check -p codex-websocket-client --tests`\n- `just test -p codex-websocket-client`\n- `cargo shear`\n- `just bazel-lock-check`","verified_at":"2026-07-08T19:57:27Z"}},"url":"https://api.github.com/repos/openai/codex/commits/2780bd588f8170abd41455d5509409ae0f76ffe9","html_url":"https://github.com/openai/codex/commit/2780bd588f8170abd41455d5509409ae0f76ffe9","comments_url":"https://api.github.com/repos/openai/codex/commits/2780bd588f8170abd41455d5509409ae0f76ffe9/comments","author":{"login":"bolinfest","id":655869,"node_id":"MDQ6VXNlcjY1NTg2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/655869?v=4","gravatar_id":"","url":"https://api.github.com/users/bolinfest","html_url":"https://github.com/bolinfest","followers_url":"https://api.github.com/users/bolinfest/followers","following_url":"https://api.github.com/users/bolinfest/following{/other_user}","gists_url":"https://api.github.com/users/bolinfest/gists{/gist_id}","starred_url":"https://api.github.com/users/bolinfest/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bolinfest/subscriptions","organizations_url":"https://api.github.com/users/bolinfest/orgs","repos_url":"https://api.github.com/users/bolinfest/repos","events_url":"https://api.github.com/users/bolinfest/events{/privacy}","received_events_url":"https://api.github.com/users/bolinfest/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"927004c06dc55565af17f0bc8eeb5e35fb990351","url":"https://api.github.com/repos/openai/codex/commits/927004c06dc55565af17f0bc8eeb5e35fb990351","html_url":"https://github.com/openai/codex/commit/927004c06dc55565af17f0bc8eeb5e35fb990351"}]},{"sha":"927004c06dc55565af17f0bc8eeb5e35fb990351","node_id":"C_kwDOOYsS4doAKDkyNzAwNGMwNmRjNTU1NjVhZjE3ZjBiYzhlZWI1ZTM1ZmI5OTAzNTE","commit":{"author":{"name":"Shijie Rao","email":"shijie.rao@openai.com","date":"2026-07-08T19:29:21Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T19:29:21Z"},"message":"tui: warn on Ultra with high multi-agent concurrency (#31621)\n\n## Why\n\nUltra reasoning may proactively use multiple agents. When\n`features.multi_agent_v2.max_concurrent_threads_per_session` is\nconfigured at 8 or higher, explicitly selecting Ultra can allow up to `N\n- 1` subagents to work concurrently and increase usage quickly. Showing\nthe configured limits at selection time makes that tradeoff visible and\npoints users to the setting that controls it.\n\n## What changed\n\n- Show a warning history cell after the user explicitly selects Ultra\nreasoning with a concurrent-thread limit of at least 8.\n- Include the configured concurrent-thread count and maximum subagent\ncount in the warning.\n- Apply the warning consistently across model and reasoning pickers,\nPlan-mode scope selection, and reasoning shortcuts.\n- Keep the trigger limited to the selected reasoning effort and\nconfigured thread limit, independent of how multi-agent v2 is activated.\n- Add focused threshold coverage and an `insta` snapshot for the\nrendered warning.\n\n## User impact\n\nUsers with high multi-agent concurrency receive a concrete warning\nimmediately after selecting Ultra. Other reasoning efforts, limits below\n8, and startup behavior are unchanged.\n\n\nhttps://github.com/user-attachments/assets/5795bcb9-432e-42bc-bde3-ee363e9aeb69\n\n## Test plan\n\n- `just test -p codex-tui ultra_reasoning_selection`\n- Built the full debug CLI with `cargo build -p codex-cli`.\n- Manually verified the debug TUI with a 10-thread limit: switching from\nMax to Ultra displayed the warning with 10 concurrent threads and up to\n9 subagents.","tree":{"sha":"954fe5a57eb65b679455441ed6e249ecc06d321b","url":"https://api.github.com/repos/openai/codex/git/trees/954fe5a57eb65b679455441ed6e249ecc06d321b"},"url":"https://api.github.com/repos/openai/codex/git/commits/927004c06dc55565af17f0bc8eeb5e35fb990351","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTqURCRC1aQ7uu5UhlAAAXGAQABgSEO6dyCUeskMuojAR5k3+\n8W2NoksQVQ2sgb5GUZRx5fH9RymfBVcwcxo7mfrBRVTkaRBTlPiN63R8rUjwvzpr\nAmaO8h8mTgrrcOxDew3cIKpMKwQgDQW8ynIoNOdLAqfczRvHqlO0CQWbN8ZYvtqe\nEewTnGLniUIdeWxuPdBs014IVDC6bGhjddFQUwdvxUoStKIwsgNJjpHHV0+yJOrf\nXyxqURRorXStpCio0z+x9VGnO+uGmEMo4EWqv8nag0qAUgDugEGOizRZk8U1Ja6D\n/l2hEzDkX6QyuIJ0mvzJIy11S+houcp1pu+ruHk4knTmvAimCW1mngOiE/AE1G7H\njNlm/qvwrCWG0LD/069WkhMRCQfMmWl8iBiXVljx55zFKN84jmFW6L7IUaR6+s6T\nTXUFp0EVtvrbipaDYCkMGdOJNk8nJ9ZkeIaDsbkGtxRyUppVFedFA5dxX50syZzO\nKRunf2k0OIK6R4ua6Jmbtz32Z3sIX28RmXnS7mf78GTSz1Jtg1VbtoLq01nauBbZ\nBgoyDx9HY6YQP6cna60lBGyLpHmphfYkjG1Sg6LRa/zZkZ0rAtF5dk/2/ICCUKrV\nKGvlOdL4duBiR1nWqpEnBco8ENq3zv1HuGcJMgQlk8+4+kdijdJsX6efxJ7GjvJr\n8wVeNYsJE4DuvVEVFK1X\n=yJcn\n-----END PGP SIGNATURE-----\n","payload":"tree 954fe5a57eb65b679455441ed6e249ecc06d321b\nparent 1d14221af26bde3280e0eeab51e6ae4200594b20\nauthor Shijie Rao <shijie.rao@openai.com> 1783538961 -0700\ncommitter GitHub <noreply@github.com> 1783538961 -0700\n\ntui: warn on Ultra with high multi-agent concurrency (#31621)\n\n## Why\n\nUltra reasoning may proactively use multiple agents. When\n`features.multi_agent_v2.max_concurrent_threads_per_session` is\nconfigured at 8 or higher, explicitly selecting Ultra can allow up to `N\n- 1` subagents to work concurrently and increase usage quickly. Showing\nthe configured limits at selection time makes that tradeoff visible and\npoints users to the setting that controls it.\n\n## What changed\n\n- Show a warning history cell after the user explicitly selects Ultra\nreasoning with a concurrent-thread limit of at least 8.\n- Include the configured concurrent-thread count and maximum subagent\ncount in the warning.\n- Apply the warning consistently across model and reasoning pickers,\nPlan-mode scope selection, and reasoning shortcuts.\n- Keep the trigger limited to the selected reasoning effort and\nconfigured thread limit, independent of how multi-agent v2 is activated.\n- Add focused threshold coverage and an `insta` snapshot for the\nrendered warning.\n\n## User impact\n\nUsers with high multi-agent concurrency receive a concrete warning\nimmediately after selecting Ultra. Other reasoning efforts, limits below\n8, and startup behavior are unchanged.\n\n\nhttps://github.com/user-attachments/assets/5795bcb9-432e-42bc-bde3-ee363e9aeb69\n\n## Test plan\n\n- `just test -p codex-tui ultra_reasoning_selection`\n- Built the full debug CLI with `cargo build -p codex-cli`.\n- Manually verified the debug TUI with a 10-thread limit: switching from\nMax to Ultra displayed the warning with 10 concurrent threads and up to\n9 subagents.","verified_at":"2026-07-08T19:29:22Z"}},"url":"https://api.github.com/repos/openai/codex/commits/927004c06dc55565af17f0bc8eeb5e35fb990351","html_url":"https://github.com/openai/codex/commit/927004c06dc55565af17f0bc8eeb5e35fb990351","comments_url":"https://api.github.com/repos/openai/codex/commits/927004c06dc55565af17f0bc8eeb5e35fb990351/comments","author":{"login":"shijie-oai","id":235382242,"node_id":"U_kgDODgel4g","avatar_url":"https://avatars.githubusercontent.com/u/235382242?v=4","gravatar_id":"","url":"https://api.github.com/users/shijie-oai","html_url":"https://github.com/shijie-oai","followers_url":"https://api.github.com/users/shijie-oai/followers","following_url":"https://api.github.com/users/shijie-oai/following{/other_user}","gists_url":"https://api.github.com/users/shijie-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/shijie-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shijie-oai/subscriptions","organizations_url":"https://api.github.com/users/shijie-oai/orgs","repos_url":"https://api.github.com/users/shijie-oai/repos","events_url":"https://api.github.com/users/shijie-oai/events{/privacy}","received_events_url":"https://api.github.com/users/shijie-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"1d14221af26bde3280e0eeab51e6ae4200594b20","url":"https://api.github.com/repos/openai/codex/commits/1d14221af26bde3280e0eeab51e6ae4200594b20","html_url":"https://github.com/openai/codex/commit/1d14221af26bde3280e0eeab51e6ae4200594b20"}]},{"sha":"1d14221af26bde3280e0eeab51e6ae4200594b20","node_id":"C_kwDOOYsS4doAKDFkMTQyMjFhZjI2YmRlMzI4MGUwZWVhYjUxZTZhZTQyMDA1OTRiMjA","commit":{"author":{"name":"stefanstokic-oai","email":"stefanstokic@openai.com","date":"2026-07-08T19:20:40Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T19:20:40Z"},"message":"[codex] Sanitize imported session fallback titles (#29875)\n\n## Summary\n\n- sanitize Claude-derived fallback titles without changing explicit\ncustom or generated source titles\n- recognize known leading control wrappers, including `ide_opened_file`,\n`ide_selection`, `local-command-stdout`, and `local-command-stderr`\n- skip separate control-only user records and use the next meaningful\nuser message as the fallback title\n- use `Imported session` only when every user record is control-only\n- preserve raw imported messages, previews, and transcript provenance\nunchanged\n\n## Why\n\nSessions without an explicit source title fall back to user-message\ncontent. Claude metadata can arrive as separate leading user records, so\nstripping only the first record still exposed raw control markup or\nproduced an unhelpful fallback.\n\n## Impact\n\nImported chats now receive readable fallback titles such as `Fix auth\nflow`, while the original wrapper-bearing messages remain visible in the\nimported transcript.\n\n## Validation\n\n- `just test -p codex-external-agent-sessions` — 37 tests passed\n- `just test -p codex-app-server\nexternal_agent_config_import_creates_session_rollouts` — focused\nintegration test passed\n- `just fix -p codex-external-agent-sessions`\n- `just fix -p codex-app-server`\n- `just bazel-lock-check`\n- `just fmt`","tree":{"sha":"8d4b7441ed3ee19fdfd480f762b4708673a38118","url":"https://api.github.com/repos/openai/codex/git/trees/8d4b7441ed3ee19fdfd480f762b4708673a38118"},"url":"https://api.github.com/repos/openai/codex/git/commits/1d14221af26bde3280e0eeab51e6ae4200594b20","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTqMICRC1aQ7uu5UhlAAAhCoQAC1EdR9hC47rCb3oN4pcz2TT\nmOqUXG5bhuuUNQJZdLPM1ViOKUHiWWOZ3owkbALp8MG/dXNEoU4mn52KHd0BFF1C\nTBNxOvPj+VWx3mwy/uxbEy7AN0KPO4bAssJzmtf5JSN4j1n/LC1vErjuSWq/4Dd+\nCpVQvIbhkzUtplqRCFXoKcNKgLhDHHXGmhgpDD10VT8KzAoSrfXKqg4wMalxB1xq\nKuLT2lkSEPM+IK+TIAwRXSzlHKdSzp/hUMS5AR+fP+E9n9h5R0W1f9CUDaHVa/Mv\nUCS4A302dPwe7B5gGTyzbm/9zG8pmXYWHpSkVAe/D/X5/i+iQdZr8g27L/uPZdq+\n6EJKhWZfP4ONXCnG+9yKR5TX0mSkJmcioj7pi70OxnooMR1Mue84SvRGzgCtiMTn\nCCgw7J9c4+afMoyLNWu4fMYNq77cTFF/Mk9q5O4hcbAFN3gw6ZxClBG/ohr4Wu8C\nsQXzPluoXWxq8QNvELLwFpSNhcG7y5Dn0457YRVw6ZaodR8brRuSEpHWPm+m8XH+\n5yNrFRLGkmQhCzkuYC+ZXkiQPLSL37J6N2j/sOmWzC28TOf/Juq6JNl6RiRCQfOy\nHz5Uf5P9qA0cozEuw3tj/30kxaW9y7yIsdZHU2CfzeNdby7Qb/CEhC1tRfjfKwWN\nGQdi8Le89BP5qN0InM1D\n=8Ijs\n-----END PGP SIGNATURE-----\n","payload":"tree 8d4b7441ed3ee19fdfd480f762b4708673a38118\nparent a14b4c2d7f606d30574b888af6d05972833b815e\nauthor stefanstokic-oai <stefanstokic@openai.com> 1783538440 -0400\ncommitter GitHub <noreply@github.com> 1783538440 -0400\n\n[codex] Sanitize imported session fallback titles (#29875)\n\n## Summary\n\n- sanitize Claude-derived fallback titles without changing explicit\ncustom or generated source titles\n- recognize known leading control wrappers, including `ide_opened_file`,\n`ide_selection`, `local-command-stdout`, and `local-command-stderr`\n- skip separate control-only user records and use the next meaningful\nuser message as the fallback title\n- use `Imported session` only when every user record is control-only\n- preserve raw imported messages, previews, and transcript provenance\nunchanged\n\n## Why\n\nSessions without an explicit source title fall back to user-message\ncontent. Claude metadata can arrive as separate leading user records, so\nstripping only the first record still exposed raw control markup or\nproduced an unhelpful fallback.\n\n## Impact\n\nImported chats now receive readable fallback titles such as `Fix auth\nflow`, while the original wrapper-bearing messages remain visible in the\nimported transcript.\n\n## Validation\n\n- `just test -p codex-external-agent-sessions` — 37 tests passed\n- `just test -p codex-app-server\nexternal_agent_config_import_creates_session_rollouts` — focused\nintegration test passed\n- `just fix -p codex-external-agent-sessions`\n- `just fix -p codex-app-server`\n- `just bazel-lock-check`\n- `just fmt`","verified_at":"2026-07-08T19:20:41Z"}},"url":"https://api.github.com/repos/openai/codex/commits/1d14221af26bde3280e0eeab51e6ae4200594b20","html_url":"https://github.com/openai/codex/commit/1d14221af26bde3280e0eeab51e6ae4200594b20","comments_url":"https://api.github.com/repos/openai/codex/commits/1d14221af26bde3280e0eeab51e6ae4200594b20/comments","author":{"login":"stefanstokic-oai","id":278208182,"node_id":"U_kgDOEJUetg","avatar_url":"https://avatars.githubusercontent.com/u/278208182?v=4","gravatar_id":"","url":"https://api.github.com/users/stefanstokic-oai","html_url":"https://github.com/stefanstokic-oai","followers_url":"https://api.github.com/users/stefanstokic-oai/followers","following_url":"https://api.github.com/users/stefanstokic-oai/following{/other_user}","gists_url":"https://api.github.com/users/stefanstokic-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/stefanstokic-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stefanstokic-oai/subscriptions","organizations_url":"https://api.github.com/users/stefanstokic-oai/orgs","repos_url":"https://api.github.com/users/stefanstokic-oai/repos","events_url":"https://api.github.com/users/stefanstokic-oai/events{/privacy}","received_events_url":"https://api.github.com/users/stefanstokic-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a14b4c2d7f606d30574b888af6d05972833b815e","url":"https://api.github.com/repos/openai/codex/commits/a14b4c2d7f606d30574b888af6d05972833b815e","html_url":"https://github.com/openai/codex/commit/a14b4c2d7f606d30574b888af6d05972833b815e"}]},{"sha":"a14b4c2d7f606d30574b888af6d05972833b815e","node_id":"C_kwDOOYsS4doAKGExNGI0YzJkN2Y2MDZkMzA1NzRiODg4YWY2ZDA1OTcyODMzYjgxNWU","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-08T18:46:18Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T18:46:18Z"},"message":"Bound exec-server pending RPCs (#31578)\n\n## Why\n\nAn untrusted exec-server can stop reading requests, never answer them,\nor send guessed responses before queued requests are written. Without\nclient-side admission, the orchestrator can retain unbounded RPC call\nfutures and request payloads.\n\nWe need a hard bound without adding a blanket timeout, because\nindividual operations already own their timeout and cleanup semantics.\n\n## What changed\n\n- hold one of 64 shared admission permits for the full lifetime of each\nregular RPC call, so an early response cannot free capacity while the\ncall remains queued\n- allow `process/terminate` and `fs/close` to use one additional cleanup\npermit\n- close the transport and fail pending calls if the cleanup permit is\nalso stuck, allowing teardown or recovery to release remote resources\n- leave the wire format and existing timeout behavior unchanged\n\n## Tests\n\n- `rpc_client_call_has_no_implicit_deadline` verifies that ordinary\ncalls remain untimed\n- `rpc_client_bounds_in_flight_calls_and_preserves_cleanup` covers the\nregular-call cap, guessed early responses, cleanup admission, and the\ncleanup circuit breaker","tree":{"sha":"0b1eef0a8efe94b18de54e19f4ca6adbc469d401","url":"https://api.github.com/repos/openai/codex/git/trees/0b1eef0a8efe94b18de54e19f4ca6adbc469d401"},"url":"https://api.github.com/repos/openai/codex/git/commits/a14b4c2d7f606d30574b888af6d05972833b815e","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTpr6CRC1aQ7uu5UhlAAAz4AQAHLej0BcsjrcJsvjTmobDyEJ\ni0KuZZQxoFBEnu/pJBREzyFrWC6Mk64+yB3fCdjgMujkiYXB6V935wPOJoZfS4xK\nhI8XkhlDZPvpHnnH2idEXWB9bd+w1IL0GITa3KT0uuwKsvL7t1ubATLyX1DQTqYg\n6gK95na+mstK8uDSXZ+/wfwX3fv0SXtNTbPZMwZgbKt09JocQ/0evq+qNjhykM00\ndGsLInDsay+P2mCNabXOOFXBC5mOojIHv/P+UriCHfp3ViDvFmX05M1agie/piWj\nifVnKG9Zo1v6Z0kulCGfORTXy7+sEbx5wAgKZ/FddKhGnHjq3cd/e8yQut7Jug89\nKxFa+FzORVJf2FhQDka3atEuVDjdkoRJ58WUuLvwEDsOExYZUBbPQI33wI4ZW04z\nirwLiHLt8rgKO+gDLGtLujtYCVUz27DAnL0/7yxSkD1uomYKsJPSXo209MF18LOo\ncXJSy0tKdeeNV7trIQ3xS+4vhZle15mTLbWTuOLG8C/zFyFJMCpc6ufpavpGLAOn\nYjsfb5wfSdTr3HUs+JJKpd0JlBpYfNOOEFaJqUHZdrSy1jAoMTcb9Zi7v7yqwNkk\nPx2bgf+6jUm7YHwKRslhUwJKHf687NLW32aomRK/13yOhy+yQzu+B/4z2fGRti2G\n7OMxV7EnyOr6wE/MUvBy\n=1QvB\n-----END PGP SIGNATURE-----\n","payload":"tree 0b1eef0a8efe94b18de54e19f4ca6adbc469d401\nparent 8d83687aaa356f4102a0130ecddb7ea518c0200c\nauthor jif <jif@openai.com> 1783536378 +0100\ncommitter GitHub <noreply@github.com> 1783536378 +0100\n\nBound exec-server pending RPCs (#31578)\n\n## Why\n\nAn untrusted exec-server can stop reading requests, never answer them,\nor send guessed responses before queued requests are written. Without\nclient-side admission, the orchestrator can retain unbounded RPC call\nfutures and request payloads.\n\nWe need a hard bound without adding a blanket timeout, because\nindividual operations already own their timeout and cleanup semantics.\n\n## What changed\n\n- hold one of 64 shared admission permits for the full lifetime of each\nregular RPC call, so an early response cannot free capacity while the\ncall remains queued\n- allow `process/terminate` and `fs/close` to use one additional cleanup\npermit\n- close the transport and fail pending calls if the cleanup permit is\nalso stuck, allowing teardown or recovery to release remote resources\n- leave the wire format and existing timeout behavior unchanged\n\n## Tests\n\n- `rpc_client_call_has_no_implicit_deadline` verifies that ordinary\ncalls remain untimed\n- `rpc_client_bounds_in_flight_calls_and_preserves_cleanup` covers the\nregular-call cap, guessed early responses, cleanup admission, and the\ncleanup circuit breaker","verified_at":"2026-07-08T18:46:18Z"}},"url":"https://api.github.com/repos/openai/codex/commits/a14b4c2d7f606d30574b888af6d05972833b815e","html_url":"https://github.com/openai/codex/commit/a14b4c2d7f606d30574b888af6d05972833b815e","comments_url":"https://api.github.com/repos/openai/codex/commits/a14b4c2d7f606d30574b888af6d05972833b815e/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"8d83687aaa356f4102a0130ecddb7ea518c0200c","url":"https://api.github.com/repos/openai/codex/commits/8d83687aaa356f4102a0130ecddb7ea518c0200c","html_url":"https://github.com/openai/codex/commit/8d83687aaa356f4102a0130ecddb7ea518c0200c"}]},{"sha":"8d83687aaa356f4102a0130ecddb7ea518c0200c","node_id":"C_kwDOOYsS4doAKDhkODM2ODdhYWEzNTZmNDEwMmEwMTMwZWNkZGI3ZWE1MThjMDIwMGM","commit":{"author":{"name":"Francis Chalissery","email":"fc@openai.com","date":"2026-07-08T18:38:18Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T18:38:18Z"},"message":"Fall back to HTTP when Apple Git is unavailable (#31496)\n\n## Summary\n\n- on macOS, resolve the curated plugin sync Git executable without\nexecuting it\n- treat Apple’s `/usr/bin/git` shim as unavailable when `xcode-select\n-p` reports that developer tools are absent\n- skip directly to the existing GitHub HTTP fallback in that case\n- preserve the original `git` command lookup on Windows and Linux,\nincluding CCA\n\n## Root cause\n\nCurated plugin startup sync invokes `git ls-remote` before its HTTP\nfallback. On a clean Mac, `git` resolves to Apple’s `/usr/bin/git` shim,\nand executing the shim opens the Xcode Command Line Tools installer\nbefore the process can fail and reach HTTP.\n\nOn macOS, this change resolves Git through `PATH` without executing it.\nIf the selected binary is Apple’s shim and developer tools are\nunavailable, startup sync marks the Git transport unavailable and enters\nthe existing HTTP fallback immediately.\n\nThe new availability detection is macOS-only by construction. Windows\nand Linux still execute the literal `git` command as before. If Git is\nmissing on Windows, the existing spawn-error path falls back to HTTP;\nLinux/CCA receives no new lookup or startup behavior.\n\n## Eager Git audit\n\nI also audited production Git process spawns in `codex-rs`.\n\n- This curated catalog sync is the only default projectless app-server\nstartup path found.\n- Configured Git marketplace auto-upgrade runs Git at plugin startup,\nbut only after a user has explicitly configured a Git marketplace.\n- Experimental Memories has background Git metadata/baseline paths when\nthe feature is enabled.\n- The separate cloud-tasks UI probes Git during environment\nautodetection.\n- Normal thread/turn Git metadata is gated by filesystem discovery of an\nexisting `.git` entry.\n- Marketplace add/install, patch apply, doctor, and TUI `/diff` paths\nare explicitly user-invoked.\n\n## Validation\n\n- `just fmt`\n- `just bazel-lock-update` — succeeded with no lockfile delta\n- `just test -p codex-core-plugins` — 313 passed\n- `just fix -p codex-core-plugins` — completed; emitted one pre-existing\nunrelated `large_enum_variant` warning in `manifest.rs`\n- `git diff --check`","tree":{"sha":"fcc587128377840ee4f174a923110f007dc6abcc","url":"https://api.github.com/repos/openai/codex/git/trees/fcc587128377840ee4f174a923110f007dc6abcc"},"url":"https://api.github.com/repos/openai/codex/git/commits/8d83687aaa356f4102a0130ecddb7ea518c0200c","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTpkaCRC1aQ7uu5UhlAAAl3QQADzdMRLQskGQcT5ddHY+BaDj\n708G2F2GcRXkw1ilmB6ZmEzDBfEXEoYi/lM+zgCS5V64zlymsiZKrca8/ptV+92A\ngak/gRp4BLPBDFvxTmuyCTK9Kec1PB+85167VuTqO77dt66ouVWeWmL/Zgs1izsn\nC1SpQEsEPhpg2cbRm+Su86tItn0cHDVOwavjoEjLdfS71FvJFCnmtlXOqNBLr4RS\nmKLI2OMxhIB97Y9KXR/it5pajL7Sen4FiV2y1hiCXb0Ax2Ze+fpec0V2t8qpm9TE\n1lRxCQQ++UFBNQHGPysSK3EJtIqc64acLOpFkhXqPUIuBRc3p1dqp6befEKD/Mkj\n40/nK+PSsd3SvRa135NaVa2G7hiZZIHXaAMVOIVW6QvEcL11CPAR9U3nBj6vBrRX\nlYxtdyJnK4HJ2fXk1jpF3tZ7MDsGeJgzZRhopP0ldX1DBU4jupaROks7txuGMRu2\nTLMjyFU5PzE2VwYC5KjNeINi4G3/huQNzh0VMXNPlEZ3/y3czvDejZWnRYBg1y+M\nYKwv4oDZi7srCg11v65GDDxUeFGYdK2c+PuA5JEObhwvF01W9/oT6LoUGt5iNT2D\nY99sMrhxt4IxOaE8Ys0F3PKatigDHAbhxSMGo3ZfjonfOB1u9vG9KRu35iI7XCZX\nJQ2VDoPGltXuxT3zX1Mj\n=aHi5\n-----END PGP SIGNATURE-----\n","payload":"tree fcc587128377840ee4f174a923110f007dc6abcc\nparent 154433c8f0e0a98131a92699e761cf34b30344ce\nauthor Francis Chalissery <fc@openai.com> 1783535898 -0700\ncommitter GitHub <noreply@github.com> 1783535898 +0000\n\nFall back to HTTP when Apple Git is unavailable (#31496)\n\n## Summary\n\n- on macOS, resolve the curated plugin sync Git executable without\nexecuting it\n- treat Apple’s `/usr/bin/git` shim as unavailable when `xcode-select\n-p` reports that developer tools are absent\n- skip directly to the existing GitHub HTTP fallback in that case\n- preserve the original `git` command lookup on Windows and Linux,\nincluding CCA\n\n## Root cause\n\nCurated plugin startup sync invokes `git ls-remote` before its HTTP\nfallback. On a clean Mac, `git` resolves to Apple’s `/usr/bin/git` shim,\nand executing the shim opens the Xcode Command Line Tools installer\nbefore the process can fail and reach HTTP.\n\nOn macOS, this change resolves Git through `PATH` without executing it.\nIf the selected binary is Apple’s shim and developer tools are\nunavailable, startup sync marks the Git transport unavailable and enters\nthe existing HTTP fallback immediately.\n\nThe new availability detection is macOS-only by construction. Windows\nand Linux still execute the literal `git` command as before. If Git is\nmissing on Windows, the existing spawn-error path falls back to HTTP;\nLinux/CCA receives no new lookup or startup behavior.\n\n## Eager Git audit\n\nI also audited production Git process spawns in `codex-rs`.\n\n- This curated catalog sync is the only default projectless app-server\nstartup path found.\n- Configured Git marketplace auto-upgrade runs Git at plugin startup,\nbut only after a user has explicitly configured a Git marketplace.\n- Experimental Memories has background Git metadata/baseline paths when\nthe feature is enabled.\n- The separate cloud-tasks UI probes Git during environment\nautodetection.\n- Normal thread/turn Git metadata is gated by filesystem discovery of an\nexisting `.git` entry.\n- Marketplace add/install, patch apply, doctor, and TUI `/diff` paths\nare explicitly user-invoked.\n\n## Validation\n\n- `just fmt`\n- `just bazel-lock-update` — succeeded with no lockfile delta\n- `just test -p codex-core-plugins` — 313 passed\n- `just fix -p codex-core-plugins` — completed; emitted one pre-existing\nunrelated `large_enum_variant` warning in `manifest.rs`\n- `git diff --check`","verified_at":"2026-07-08T18:38:18Z"}},"url":"https://api.github.com/repos/openai/codex/commits/8d83687aaa356f4102a0130ecddb7ea518c0200c","html_url":"https://github.com/openai/codex/commit/8d83687aaa356f4102a0130ecddb7ea518c0200c","comments_url":"https://api.github.com/repos/openai/codex/commits/8d83687aaa356f4102a0130ecddb7ea518c0200c/comments","author":{"login":"fc-oai","id":269039706,"node_id":"U_kgDOEAk4Wg","avatar_url":"https://avatars.githubusercontent.com/u/269039706?v=4","gravatar_id":"","url":"https://api.github.com/users/fc-oai","html_url":"https://github.com/fc-oai","followers_url":"https://api.github.com/users/fc-oai/followers","following_url":"https://api.github.com/users/fc-oai/following{/other_user}","gists_url":"https://api.github.com/users/fc-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/fc-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fc-oai/subscriptions","organizations_url":"https://api.github.com/users/fc-oai/orgs","repos_url":"https://api.github.com/users/fc-oai/repos","events_url":"https://api.github.com/users/fc-oai/events{/privacy}","received_events_url":"https://api.github.com/users/fc-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"154433c8f0e0a98131a92699e761cf34b30344ce","url":"https://api.github.com/repos/openai/codex/commits/154433c8f0e0a98131a92699e761cf34b30344ce","html_url":"https://github.com/openai/codex/commit/154433c8f0e0a98131a92699e761cf34b30344ce"}]},{"sha":"154433c8f0e0a98131a92699e761cf34b30344ce","node_id":"C_kwDOOYsS4doAKDE1NDQzM2M4ZjBlMGE5ODEzMWE5MjY5OWU3NjFjZjM0YjMwMzQ0Y2U","commit":{"author":{"name":"Owen Lin","email":"owenlin0@gmail.com","date":"2026-07-08T18:35:42Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T18:35:42Z"},"message":"chore(protocol): use UUIDv7 for generated item IDs (#31524)\n\n## Description\n\nUse UUIDv7 for item IDs generated locally in `codex-protocol`.\n\nThis covers user messages, agent messages, hook prompts, and context\ncompaction items. These IDs are generated once and carried through item\nlifecycle, so this only changes the UUID version. It keeps generated\nitem IDs consistent with thread and turn IDs.","tree":{"sha":"f5e549088997768a2631a584933c707f8b902ebe","url":"https://api.github.com/repos/openai/codex/git/trees/f5e549088997768a2631a584933c707f8b902ebe"},"url":"https://api.github.com/repos/openai/codex/git/commits/154433c8f0e0a98131a92699e761cf34b30344ce","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTph+CRC1aQ7uu5UhlAAAXAkQAFpIxbCqsisj9CXOYn6r6Fay\nYfdoyXruQOZRewUL3FDWKGFSHttidDazgomBxsoeMO8tw/ck/6RI8VBkXvrfJsfL\nxr825KmKFu7MMnzrPN7NpRU4K+uZO0bmg1NeDMTb+EhTJBr+hKzd3W0JIabEgBTh\nCP2v6bp0Bhz4ZaLcoXU8W4EeEzKyr9sV7YxR4m1X3VPINJjNOui3XiX1su4iBCyK\nqjCNYEEZ3TDhEgM964nRuiy6PuFxGf355f30hlEWPa/hqKTyctMLPjhgSSpAxo3f\nXaETpSrznNj32CkeaozpRlg78HhBagnqNuKQPiEceYLbaYh1Jd3kzcOnrbnCWRnG\nG8b4uuQl6LNFZvHDiHINXX9YspJdfNJ9gSH0j9wRPtkZRQdUNe5SV8KYdcoj4I33\n0aC2FhioqUJb4/lZ1UQXwTwVOkHhAebc8Ejqp0rshPapSs7VbpJ5Wu4/I9qFh5JC\n/vL+P7aTy/p8WOq619BrlSLMZ26PO2t4iusJtpSxUDN/LF6fTMWm57wFFKiLyBHg\nNPA0Ovh79B/wQMZxuRjomelvApVCJA+y4BdSgX+/oVcmBL89wAZDTlA7hJknftiN\nNtPkoIMcppuE0igflrn52EAsTl5R96nOzETHW5pG9Cadf8GiaSdPQN2kfsTtO+PE\nRHa5ECZ/82zRz2HSnNxT\n=QQxm\n-----END PGP SIGNATURE-----\n","payload":"tree f5e549088997768a2631a584933c707f8b902ebe\nparent 9077300d7f05bf0f45212f43c87feafffead10b0\nauthor Owen Lin <owenlin0@gmail.com> 1783535742 -0700\ncommitter GitHub <noreply@github.com> 1783535742 +0000\n\nchore(protocol): use UUIDv7 for generated item IDs (#31524)\n\n## Description\n\nUse UUIDv7 for item IDs generated locally in `codex-protocol`.\n\nThis covers user messages, agent messages, hook prompts, and context\ncompaction items. These IDs are generated once and carried through item\nlifecycle, so this only changes the UUID version. It keeps generated\nitem IDs consistent with thread and turn IDs.","verified_at":"2026-07-08T18:35:43Z"}},"url":"https://api.github.com/repos/openai/codex/commits/154433c8f0e0a98131a92699e761cf34b30344ce","html_url":"https://github.com/openai/codex/commit/154433c8f0e0a98131a92699e761cf34b30344ce","comments_url":"https://api.github.com/repos/openai/codex/commits/154433c8f0e0a98131a92699e761cf34b30344ce/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"9077300d7f05bf0f45212f43c87feafffead10b0","url":"https://api.github.com/repos/openai/codex/commits/9077300d7f05bf0f45212f43c87feafffead10b0","html_url":"https://github.com/openai/codex/commit/9077300d7f05bf0f45212f43c87feafffead10b0"}]},{"sha":"9077300d7f05bf0f45212f43c87feafffead10b0","node_id":"C_kwDOOYsS4doAKDkwNzczMDBkN2YwNWJmMGY0NTIxMmY0M2M4N2ZlYWZmZmVhZDEwYjA","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-07-08T18:10:35Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T18:10:35Z"},"message":"tui: sanitize terminal controls in user messages (#31494)\n\n## Why\n\nA pasted user message can contain a raw CSI sequence that corrupts\nterminal scrollback, making the latest response or input appear missing.\nThe same sequence may already be present in persisted history when an\naffected conversation is resumed.\n\n## What changed\n\n- Remove CSI sequences and non-whitespace control characters from\nexplicit paste input before it enters the composer.\n- Apply the same small transform before rich and raw `UserHistoryCell`\nrendering, so existing conversations render safely without mutating\nstored message content.","tree":{"sha":"e0c20bcb92da17ea47cb051e89cd9de752f6dd84","url":"https://api.github.com/repos/openai/codex/git/trees/e0c20bcb92da17ea47cb051e89cd9de752f6dd84"},"url":"https://api.github.com/repos/openai/codex/git/commits/9077300d7f05bf0f45212f43c87feafffead10b0","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTpKbCRC1aQ7uu5UhlAAAwDIQAChRgES86BYdYkBt4mwRKrlj\nRKJcATYm1bYRZS4Kk+atAs25/tEMHVGaX7eKfOjCJq/10rB1NUc0PaaiNhuF4eGn\nl41sVncpm5HUfULLQjGq5d8I6H0bH7hMm+eKBl34GwCFt0C36mmK3Xzt/pV2gEMm\nYrkaud6sRaeuP1/fwD5/IkReUG+q/ccNHgUc8uQiXALmlvNgJ8+VjpfRErNLOvWN\nUooUC7P9UiTpi6Ws+dbqYJNjvHV8hLyan/0ID23cgeMgzISyhEOn7f3hiEYrGccC\n8knQDWKkkUYmb1wgwunBv1WjS7X6pQpQ5aW5FFCUtlQ63plfWrfj16xS1F/B0hiB\nwgeT9Q/onnxBrMQiAGo4DGtvW9NurCkaretGXBg6mRasM7y3MyaIAZhXoEFami+/\nsx8R0tPCcqMbrKuApCsdFlYejvcmt01nIBFFwwqVomFTnJFE6MZ7+JztrlApVuJN\n+coJOoNae5JmF136ZnLzqqmgpI+V9bSueE7V9g3KqAV7asO5mEI6Y07wgdbpprl8\n2NP937LXEGy5X0yV3em6wZrPVAJbDOjYwGOKtK+EJFaHQX67SpV0R+tP41Dt6T28\nR3M8mmL98yT+trn5Ndn9SnK3M7VhTVLZ/390A4boHzTfCexwpcp2t+sQ3mF73PJ3\nzLTt+pZ+68fHo9S1zmeH\n=D7ci\n-----END PGP SIGNATURE-----\n","payload":"tree e0c20bcb92da17ea47cb051e89cd9de752f6dd84\nparent 9c6715924b4ce273248d03107383defc171a9a58\nauthor Eric Traut <etraut@openai.com> 1783534235 -0700\ncommitter GitHub <noreply@github.com> 1783534235 -0700\n\ntui: sanitize terminal controls in user messages (#31494)\n\n## Why\n\nA pasted user message can contain a raw CSI sequence that corrupts\nterminal scrollback, making the latest response or input appear missing.\nThe same sequence may already be present in persisted history when an\naffected conversation is resumed.\n\n## What changed\n\n- Remove CSI sequences and non-whitespace control characters from\nexplicit paste input before it enters the composer.\n- Apply the same small transform before rich and raw `UserHistoryCell`\nrendering, so existing conversations render safely without mutating\nstored message content.","verified_at":"2026-07-08T18:10:36Z"}},"url":"https://api.github.com/repos/openai/codex/commits/9077300d7f05bf0f45212f43c87feafffead10b0","html_url":"https://github.com/openai/codex/commit/9077300d7f05bf0f45212f43c87feafffead10b0","comments_url":"https://api.github.com/repos/openai/codex/commits/9077300d7f05bf0f45212f43c87feafffead10b0/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"9c6715924b4ce273248d03107383defc171a9a58","url":"https://api.github.com/repos/openai/codex/commits/9c6715924b4ce273248d03107383defc171a9a58","html_url":"https://github.com/openai/codex/commit/9c6715924b4ce273248d03107383defc171a9a58"}]},{"sha":"9c6715924b4ce273248d03107383defc171a9a58","node_id":"C_kwDOOYsS4doAKDljNjcxNTkyNGI0Y2UyNzMyNDhkMDMxMDczODNkZWZjMTcxYTlhNTg","commit":{"author":{"name":"Channing Conger","email":"cconger@openai.com","date":"2026-07-08T18:06:58Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T18:06:58Z"},"message":"code-mode: move to hosted mode by default  (#31500)\n\n## Summary\n\n  - Promote code_mode_host to stable and enable it by default.\n- Preserve features.code_mode_host = false as an opt-out to the\nin-process runtime.\n  - Run core code-mode tests through the standalone host.\n  - Keep explicit coverage for missing-host failures.","tree":{"sha":"9017e5acfd467c8d3ecda8fc094d95c95976e25e","url":"https://api.github.com/repos/openai/codex/git/trees/9017e5acfd467c8d3ecda8fc094d95c95976e25e"},"url":"https://api.github.com/repos/openai/codex/git/commits/9c6715924b4ce273248d03107383defc171a9a58","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTpHCCRC1aQ7uu5UhlAAA6YMQAB2jtUcRjTt4tLSpVYJzUa0t\n40kx+iI/jQuCwzZ7yW6mfCQUABDE+K17+lD0yOTQHbqU12WRUkrPrx7iVj+6bIfQ\nVgE98pyi28CULqinED6hJnqjlbA1DWlsj5xK0aj+y0en87lFfNAicueCDx0/K5/x\n8NgGfilsgMgwAwhP9e6r/3AY6FlJ2ZnluyUYci9dfkYpHvrTpT8R6ilSdaVCHN+P\n0hNXuRnUmqAKJWlzP3QWYkp6fsotONrbUZS2u7WHr/v6dhPQNuUD+aaeA+VJPPAl\nhnK2Qz297QcmLynpDQXeC5JupKSaXgPqcuft6wxwFrSdynVK9fmCFDCDPXFtzwg1\nu2y3lWc/mDiAcmnXY9qXNxnnbTEW/XUEstO5wx2OeQQFhvVL2ThlcLrDIcwAlWqK\nlt1e6XivyLE19+MJZf5z76d0vPuQzi94ItU4+V7MZmDTdW49UV7lB2EBhxsUbFaZ\nEv+7APbsDoAy73xaG7LCb7vVileoUnj83RNpagTtPI+tS7CIYctdFs05LXF1okcA\nLDMwkAz0rA01LFtnnrx/HltDbUwwSnjSOVvPEakVCIH5plzXXbzZmCClJEA36qnN\n0pRKzf2OJrRc3fYZbW+MEV0JYzJK4BxkdL5ygLibaB6qE3kaxES/hnCc90xAnr1H\nDpOi++DL2mSWnJ3KU7lh\n=CUAq\n-----END PGP SIGNATURE-----\n","payload":"tree 9017e5acfd467c8d3ecda8fc094d95c95976e25e\nparent 166534fc2278ca951a88cd3841557026edfeddf3\nauthor Channing Conger <cconger@openai.com> 1783534018 -0700\ncommitter GitHub <noreply@github.com> 1783534018 -0700\n\ncode-mode: move to hosted mode by default  (#31500)\n\n## Summary\n\n  - Promote code_mode_host to stable and enable it by default.\n- Preserve features.code_mode_host = false as an opt-out to the\nin-process runtime.\n  - Run core code-mode tests through the standalone host.\n  - Keep explicit coverage for missing-host failures.","verified_at":"2026-07-08T18:06:59Z"}},"url":"https://api.github.com/repos/openai/codex/commits/9c6715924b4ce273248d03107383defc171a9a58","html_url":"https://github.com/openai/codex/commit/9c6715924b4ce273248d03107383defc171a9a58","comments_url":"https://api.github.com/repos/openai/codex/commits/9c6715924b4ce273248d03107383defc171a9a58/comments","author":{"login":"cconger","id":200563,"node_id":"MDQ6VXNlcjIwMDU2Mw==","avatar_url":"https://avatars.githubusercontent.com/u/200563?v=4","gravatar_id":"","url":"https://api.github.com/users/cconger","html_url":"https://github.com/cconger","followers_url":"https://api.github.com/users/cconger/followers","following_url":"https://api.github.com/users/cconger/following{/other_user}","gists_url":"https://api.github.com/users/cconger/gists{/gist_id}","starred_url":"https://api.github.com/users/cconger/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cconger/subscriptions","organizations_url":"https://api.github.com/users/cconger/orgs","repos_url":"https://api.github.com/users/cconger/repos","events_url":"https://api.github.com/users/cconger/events{/privacy}","received_events_url":"https://api.github.com/users/cconger/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"166534fc2278ca951a88cd3841557026edfeddf3","url":"https://api.github.com/repos/openai/codex/commits/166534fc2278ca951a88cd3841557026edfeddf3","html_url":"https://github.com/openai/codex/commit/166534fc2278ca951a88cd3841557026edfeddf3"}]},{"sha":"166534fc2278ca951a88cd3841557026edfeddf3","node_id":"C_kwDOOYsS4doAKDE2NjUzNGZjMjI3OGNhOTUxYTg4Y2QzODQxNTU3MDI2ZWRmZWRkZjM","commit":{"author":{"name":"Felipe Coury","email":"felipe.coury@openai.com","date":"2026-07-08T18:05:57Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T18:05:57Z"},"message":"fix(windows-sandbox): allow deletion in writable roots (#31138)\n\n## Why\n\nThe legacy unelevated Windows sandbox allowed tools to create and update\nfiles in workspace-write roots, but it could not delete files that\nalready existed there. This breaks operations such as `apply_patch` file\ndeletion and replacement in the workspace, `TEMP`, and `TMP`.\n\nThe delete grant must also preserve deny-write carveouts. Granting\n`FILE_DELETE_CHILD` on a writable parent would let the sandbox remove\nprotected children such as `.git` or an explicit read-only subpath even\nwhen those children have direct deny ACEs.\n\nThis addresses the delete-failure variant reported in #30009 and #30712.\nIt does not claim to fix their separate split-root setup,\nelevated-helper, or proxy-related failure modes.\n\n## What Changed\n\n- Give writable-root capability ACEs inheritable `DELETE` rights without\ngranting parent-level `FILE_DELETE_CHILD`, so descendants can be removed\nwhile protected children remain protected.\n- Replace stale write ACEs that still contain `FILE_DELETE_CHILD`, and\nmake elevated setup detect and refresh that unsafe legacy state.\n- Keep read-only capability handling unchanged.\n- Add Windows regressions covering pre-existing files in the workspace,\n`TEMP`, and `TMP`, plus protected `.git` and outside-root controls.\n\nThe core ACL behavior is in\n[`acl.rs`](https://github.com/openai/codex/blob/767540eec35cc88dafc34d87fcec7e58087413fb/codex-rs/windows-sandbox-rs/src/acl.rs#L303-L438),\nstale-ACE detection is in\n[`setup_main/win.rs`](https://github.com/openai/codex/blob/767540eec35cc88dafc34d87fcec7e58087413fb/codex-rs/windows-sandbox-rs/src/bin/setup_main/win.rs#L163-L179),\nand the end-to-end regression is in\n[`unified_exec/tests.rs`](https://github.com/openai/codex/blob/767540eec35cc88dafc34d87fcec7e58087413fb/codex-rs/windows-sandbox-rs/src/unified_exec/tests.rs#L458-L568).\n\n## How to Test\n\nOn Windows:\n\n1. Start Codex with the legacy unelevated Windows sandbox and a\nworkspace-write permission profile.\n2. Seed pre-existing files in the workspace, `TEMP`, and `TMP`; also\ncreate a sibling file outside the writable roots and a protected `.git`\ndirectory.\n3. Delete the three files inside writable roots through a sandboxed\ncommand or `apply_patch`.\n4. Confirm the writable-root files are deleted, while the outside-root\nfile and protected `.git` directory remain intact.\n\nTargeted tests:\n\n- `just test -p codex-windows-sandbox`\n- Windows-only\n`legacy_workspace_write_delete_is_limited_to_writable_roots`\n- Windows-only `write_root_refresh_replaces_stale_delete_child_grant`\n\nThe final SHA passed all 31 required checks, including the Windows Bazel\ntest matrix, in [run\n28886245161](https://github.com/openai/codex/actions/runs/28886245161).","tree":{"sha":"a88feae38fa54a4ea3b3d67d0888eda3ab2c0870","url":"https://api.github.com/repos/openai/codex/git/trees/a88feae38fa54a4ea3b3d67d0888eda3ab2c0870"},"url":"https://api.github.com/repos/openai/codex/git/commits/166534fc2278ca951a88cd3841557026edfeddf3","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTpGFCRC1aQ7uu5UhlAAAgywQABTV84HzOQDjkg5JuFOLHsHY\n/CMS8In+c5stOObIKDdr+fzyw35utv/HLM57wiPU74rw3Ox/CmczA+zCDQfw1SLj\neJCfXfpFCeKEdwcdBbHCGrIKuXk8mRF7K7ILNqS1Bil9rsHNc0KPCGVoB8cHyd7Z\nOl7ZjMdoImVZKnUMv8uoTAU38n2ApCkdi/CiVHFKAJcYLlEvvqi5408cEBDm/aqS\nmKy3Af6AwaeDd/M9RrcNkDlyq/xhqhKVxLUP4B3NmAnzoNzda+aqKirWf/9vFtb0\nHDVBf7Wf8Zu3brT0b91ptkTrEyM1sK22nXaI+rrEgf2yaK3qK2+R2ZFwuibOzDx2\nY9nacbOJIBNbahzY189otkS9R7L6o+uDwywjnuXMjJw1ZdwXIm4gyMyaEMHOiI4H\nfsJp4x1cXs3mxuoxSI2+EenIWDovubBUtrUHHTFuWQmUI4nuRU/AE/8i6lWdZUVT\nfADPc3Kt1SvR8pJmuQ7dl+iS6yUiuR71IuUhuW8HqL6vI47RTO6Z3gRmnQDYBSvu\nDUUvhjWoZcaVOSEdMwzNmuqmPfkcyJQHiPb7ImRZk4AQMS24bwBdS0d6cv0E5ULy\ns2HtMbnWz+7EM49GvdVvt+81QHdnAhVg98b5uCiIRdBf0TrJnkPjQXN8pN6wPRSr\nFTXR8xLIGM+Dfr5N6E8k\n=WNkE\n-----END PGP SIGNATURE-----\n","payload":"tree a88feae38fa54a4ea3b3d67d0888eda3ab2c0870\nparent 48cf58233190ce6f2aa6c3194d022c0e273e8fd6\nauthor Felipe Coury <felipe.coury@openai.com> 1783533957 -0300\ncommitter GitHub <noreply@github.com> 1783533957 -0300\n\nfix(windows-sandbox): allow deletion in writable roots (#31138)\n\n## Why\n\nThe legacy unelevated Windows sandbox allowed tools to create and update\nfiles in workspace-write roots, but it could not delete files that\nalready existed there. This breaks operations such as `apply_patch` file\ndeletion and replacement in the workspace, `TEMP`, and `TMP`.\n\nThe delete grant must also preserve deny-write carveouts. Granting\n`FILE_DELETE_CHILD` on a writable parent would let the sandbox remove\nprotected children such as `.git` or an explicit read-only subpath even\nwhen those children have direct deny ACEs.\n\nThis addresses the delete-failure variant reported in #30009 and #30712.\nIt does not claim to fix their separate split-root setup,\nelevated-helper, or proxy-related failure modes.\n\n## What Changed\n\n- Give writable-root capability ACEs inheritable `DELETE` rights without\ngranting parent-level `FILE_DELETE_CHILD`, so descendants can be removed\nwhile protected children remain protected.\n- Replace stale write ACEs that still contain `FILE_DELETE_CHILD`, and\nmake elevated setup detect and refresh that unsafe legacy state.\n- Keep read-only capability handling unchanged.\n- Add Windows regressions covering pre-existing files in the workspace,\n`TEMP`, and `TMP`, plus protected `.git` and outside-root controls.\n\nThe core ACL behavior is in\n[`acl.rs`](https://github.com/openai/codex/blob/767540eec35cc88dafc34d87fcec7e58087413fb/codex-rs/windows-sandbox-rs/src/acl.rs#L303-L438),\nstale-ACE detection is in\n[`setup_main/win.rs`](https://github.com/openai/codex/blob/767540eec35cc88dafc34d87fcec7e58087413fb/codex-rs/windows-sandbox-rs/src/bin/setup_main/win.rs#L163-L179),\nand the end-to-end regression is in\n[`unified_exec/tests.rs`](https://github.com/openai/codex/blob/767540eec35cc88dafc34d87fcec7e58087413fb/codex-rs/windows-sandbox-rs/src/unified_exec/tests.rs#L458-L568).\n\n## How to Test\n\nOn Windows:\n\n1. Start Codex with the legacy unelevated Windows sandbox and a\nworkspace-write permission profile.\n2. Seed pre-existing files in the workspace, `TEMP`, and `TMP`; also\ncreate a sibling file outside the writable roots and a protected `.git`\ndirectory.\n3. Delete the three files inside writable roots through a sandboxed\ncommand or `apply_patch`.\n4. Confirm the writable-root files are deleted, while the outside-root\nfile and protected `.git` directory remain intact.\n\nTargeted tests:\n\n- `just test -p codex-windows-sandbox`\n- Windows-only\n`legacy_workspace_write_delete_is_limited_to_writable_roots`\n- Windows-only `write_root_refresh_replaces_stale_delete_child_grant`\n\nThe final SHA passed all 31 required checks, including the Windows Bazel\ntest matrix, in [run\n28886245161](https://github.com/openai/codex/actions/runs/28886245161).","verified_at":"2026-07-08T18:05:58Z"}},"url":"https://api.github.com/repos/openai/codex/commits/166534fc2278ca951a88cd3841557026edfeddf3","html_url":"https://github.com/openai/codex/commit/166534fc2278ca951a88cd3841557026edfeddf3","comments_url":"https://api.github.com/repos/openai/codex/commits/166534fc2278ca951a88cd3841557026edfeddf3/comments","author":{"login":"fcoury-oai","id":272635208,"node_id":"U_kgDOEEAVSA","avatar_url":"https://avatars.githubusercontent.com/u/272635208?v=4","gravatar_id":"","url":"https://api.github.com/users/fcoury-oai","html_url":"https://github.com/fcoury-oai","followers_url":"https://api.github.com/users/fcoury-oai/followers","following_url":"https://api.github.com/users/fcoury-oai/following{/other_user}","gists_url":"https://api.github.com/users/fcoury-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/fcoury-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fcoury-oai/subscriptions","organizations_url":"https://api.github.com/users/fcoury-oai/orgs","repos_url":"https://api.github.com/users/fcoury-oai/repos","events_url":"https://api.github.com/users/fcoury-oai/events{/privacy}","received_events_url":"https://api.github.com/users/fcoury-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"48cf58233190ce6f2aa6c3194d022c0e273e8fd6","url":"https://api.github.com/repos/openai/codex/commits/48cf58233190ce6f2aa6c3194d022c0e273e8fd6","html_url":"https://github.com/openai/codex/commit/48cf58233190ce6f2aa6c3194d022c0e273e8fd6"}]},{"sha":"48cf58233190ce6f2aa6c3194d022c0e273e8fd6","node_id":"C_kwDOOYsS4doAKDQ4Y2Y1ODIzMzE5MGNlNmYyYWE2YzMxOTRkMDIyYzBlMjczZThmZDY","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-08T17:58:02Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T17:58:02Z"},"message":"Round MCP timeout durations in error messages (#31612)\n\n## Summary\n\nMCP operation timeout errors currently print the full debug precision of\nthe remaining timeout budget. That makes a configured 30-second timeout\nshow up as something like `29.999999875s`.\n\nThis PR rounds the displayed duration to a whole unit, so the error is\nclean and stable:\n\n```text\ntimed out awaiting tools/list after 30s\n```\n\nThe timeout behavior itself is unchanged; this only affects the\nhuman-facing error text. A regression test covers the reported\n`tools/list` case.","tree":{"sha":"7b5bb63c66d1affe12c4f8283e867a4cd38100f6","url":"https://api.github.com/repos/openai/codex/git/trees/7b5bb63c66d1affe12c4f8283e867a4cd38100f6"},"url":"https://api.github.com/repos/openai/codex/git/commits/48cf58233190ce6f2aa6c3194d022c0e273e8fd6","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTo+qCRC1aQ7uu5UhlAAAJkgQAGN7H2LDqo2EZD1P6uxWWwpU\ny90WTixS8KkWDeqzLKx3OeE/1m6YagR1f4MoJ7emqnKxbCzQlGz7R2ypQsxzl65L\nOT6SNCfGnIQSM+jmKrJwxjdyDS6RsY5edsPMOfXRzcdLgzssPiGtf9mgyv8xgq5H\nLpcoaq2Yeg/y9YJCzwseWJRvT2eNCLPTj4Ej7xrYBSZuijMtsAXSVejtYtduxX4Y\nMhrRhgSDGsQdTHkYy+X5/TzNlkKOmpt28twMvmchfKN84ub1R4ajyaMJ+cmVdT8C\nz7EIWNEDTaoNp1EYjy+FwmNltJctpZ+Sfw8I08+/YPSzQSVQkx8XIgb4d9Flyjkm\nrh5T3lVgzB0oPg56d8ui4JehX9hiuaU3Y5mA5U59kpWu10+pySX5kn0FXUtrQo20\noqy8Q9N+G31pfXBWZveopi/Jil+61DnagjE4FSF6hIczCaxMTcRxEt3h/9kiasAm\ni1or1W0iOO1pXXzugc2vYJOkdwMHIm35Kp563Wzgs2ou6YyC/JTvSvF/Lor7Pl1e\n9XN2l6vh+U6ColF9THPivGSj0030ct8k1/pkdlwlsu2AFrs0ijzF6plmDcxQHkXf\nQhENRzayhPAFTW+oOXlDP0u9qUy8t98XGoi77HTjfhxQhrXRNB8keFkSMrdeP0QX\n/Hjbc7p/iuEcO4ckY+1V\n=XzSl\n-----END PGP SIGNATURE-----\n","payload":"tree 7b5bb63c66d1affe12c4f8283e867a4cd38100f6\nparent f73a07224653c2cc775b3f84f129b872b1e08f85\nauthor jif <jif@openai.com> 1783533482 +0100\ncommitter GitHub <noreply@github.com> 1783533482 +0100\n\nRound MCP timeout durations in error messages (#31612)\n\n## Summary\n\nMCP operation timeout errors currently print the full debug precision of\nthe remaining timeout budget. That makes a configured 30-second timeout\nshow up as something like `29.999999875s`.\n\nThis PR rounds the displayed duration to a whole unit, so the error is\nclean and stable:\n\n```text\ntimed out awaiting tools/list after 30s\n```\n\nThe timeout behavior itself is unchanged; this only affects the\nhuman-facing error text. A regression test covers the reported\n`tools/list` case.","verified_at":"2026-07-08T17:58:02Z"}},"url":"https://api.github.com/repos/openai/codex/commits/48cf58233190ce6f2aa6c3194d022c0e273e8fd6","html_url":"https://github.com/openai/codex/commit/48cf58233190ce6f2aa6c3194d022c0e273e8fd6","comments_url":"https://api.github.com/repos/openai/codex/commits/48cf58233190ce6f2aa6c3194d022c0e273e8fd6/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f73a07224653c2cc775b3f84f129b872b1e08f85","url":"https://api.github.com/repos/openai/codex/commits/f73a07224653c2cc775b3f84f129b872b1e08f85","html_url":"https://github.com/openai/codex/commit/f73a07224653c2cc775b3f84f129b872b1e08f85"}]},{"sha":"f73a07224653c2cc775b3f84f129b872b1e08f85","node_id":"C_kwDOOYsS4doAKGY3M2EwNzIyNDY1M2MyY2M3NzViM2Y4NGYxMjliODcyYjFlMDhmODU","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-07-08T17:50:18Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T17:50:18Z"},"message":"test: remove TestAppServer constructors (#31452)\n\n## Why\n\nFinish the TestAppServer builder migration after every caller has moved\noff the compatibility constructors.\n\n## What\n\n- remove the obsolete public TestAppServer constructors\n- leave TestAppServer::builder() as the only fixture construction API\n\n## Validation\n\n- cargo check -p codex-app-server --tests\n\n## Cleanup stack\n\n1. [#31425 test: add TestAppServer\nbuilder](https://github.com/openai/codex/pull/31425)\n2. [#31451 test: migrate TestAppServer callers to\nbuilder](https://github.com/openai/codex/pull/31451)\n3. this PR","tree":{"sha":"8afbdde811a1b07ffc3467540f08703a9d66bbd3","url":"https://api.github.com/repos/openai/codex/git/trees/8afbdde811a1b07ffc3467540f08703a9d66bbd3"},"url":"https://api.github.com/repos/openai/codex/git/commits/f73a07224653c2cc775b3f84f129b872b1e08f85","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTo3aCRC1aQ7uu5UhlAAAaGMQADc1Yv0Zktox7TeMqVhT4kwj\nstg9itiaBBXmohPlKjKeyE2FmfjptgTEt3MNXL4XmMCqyIZq+9hv/ee2QqLVCLOF\nfDY1V/zEj5WOD21xnRL82P4jFhCl8AOBh0PwGzxBe2rXvro2pJwWhPkkdD6jOGyb\njPm9OXzby8ZdniixSYVaCcifKWC76nuuheO93mPrO0LTZ5RT2a9cezNKOSSHYPf1\n7PIMAF3hmX7wYMr6sHYxT2OCVDrA6dFZOr+A3UyWAwvIXSUlvMde99YW+W12cT2u\nl2wrjim58+zL0LcucSQ7UoVFLK+oGVxwMZlw6trnOWDmg1aGoOKb29w+H0rG645V\n9mniNTOBA+uvczFb7pCstcmk3tURZiix3QGBECIxO3+Oi4MYzGfEr6p0URD5L+aO\nXcy/uWEQXFS1EOSh5mkwKlTOAif/73CwRx4TDwj+5OjwSaU4pnqACH7QHqylhlLF\nfoOurphRMsHlvzysCbiGu6LCnLar+G22UufYflMvMeSlpev0lDABMjPPZ+umzHHY\nvjPSZU01wWFx8b2ctGNlFd5Slo0JgWEtpshf8ewX3dq2tWZMWWhhNdTx6oxjclKm\nikksK74LPKOeD0VMkRORLVutOMO7Rd6yAfwk1PqDhYSAd8H42lPX7bI4wps4oQYe\n1anW7NtEJepbZkGcR4T8\n=lM4O\n-----END PGP SIGNATURE-----\n","payload":"tree 8afbdde811a1b07ffc3467540f08703a9d66bbd3\nparent 23aac925e7b3fd02b9d6a47147b7b8310a124b49\nauthor Adam Perry @ OpenAI <anp@openai.com> 1783533018 -0700\ncommitter GitHub <noreply@github.com> 1783533018 +0000\n\ntest: remove TestAppServer constructors (#31452)\n\n## Why\n\nFinish the TestAppServer builder migration after every caller has moved\noff the compatibility constructors.\n\n## What\n\n- remove the obsolete public TestAppServer constructors\n- leave TestAppServer::builder() as the only fixture construction API\n\n## Validation\n\n- cargo check -p codex-app-server --tests\n\n## Cleanup stack\n\n1. [#31425 test: add TestAppServer\nbuilder](https://github.com/openai/codex/pull/31425)\n2. [#31451 test: migrate TestAppServer callers to\nbuilder](https://github.com/openai/codex/pull/31451)\n3. this PR","verified_at":"2026-07-08T17:50:19Z"}},"url":"https://api.github.com/repos/openai/codex/commits/f73a07224653c2cc775b3f84f129b872b1e08f85","html_url":"https://github.com/openai/codex/commit/f73a07224653c2cc775b3f84f129b872b1e08f85","comments_url":"https://api.github.com/repos/openai/codex/commits/f73a07224653c2cc775b3f84f129b872b1e08f85/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"23aac925e7b3fd02b9d6a47147b7b8310a124b49","url":"https://api.github.com/repos/openai/codex/commits/23aac925e7b3fd02b9d6a47147b7b8310a124b49","html_url":"https://github.com/openai/codex/commit/23aac925e7b3fd02b9d6a47147b7b8310a124b49"}]},{"sha":"23aac925e7b3fd02b9d6a47147b7b8310a124b49","node_id":"C_kwDOOYsS4doAKDIzYWFjOTI1ZTdiM2ZkMDJiOWQ2YTQ3MTQ3YjdiODMxMGExMjRiNDk","commit":{"author":{"name":"Owen Lin","email":"owenlin0@gmail.com","date":"2026-07-08T16:59:50Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T16:59:50Z"},"message":"feat(core): emit canonical review mode items (#31473)\n\n## Description\n\nThis PR moves review-mode markers onto canonical `TurnItem` lifecycle:\n\n- `TurnItem::EnteredReviewMode`\n- `TurnItem::ExitedReviewMode`\n\nCore now emits `ItemStarted` / `ItemCompleted` for both. The completed\nitems map back into the existing `EnteredReviewMode` /\n`ExitedReviewMode` events, so raw core event consumers and legacy\nrollout persistence keep seeing the old events.\n\nThis is the compatibility layer needed before paginated rollouts persist\nreview markers as `ItemCompleted(TurnItem)`.\n\n## Why\n\nReview markers were one of the remaining app-server thread items created\ndirectly from legacy events. Giving them canonical items lets paginated\nhistory persist stable turn/item IDs without changing legacy rollouts.\n\n## What changed\n\n- Added canonical review-mode `TurnItem`s and switched review flow to\nemit their lifecycle.\n- Added completed-item → legacy review event mappings with stable\nturn/item IDs.\n- Switched app-server live notifications to the generic canonical item\npath and kept legacy replay compatible with old payloads.\n- Updated `ThreadHistoryBuilder` to replay canonical review items even\nthough review turns still do not emit `TurnStarted`.","tree":{"sha":"40557b789dbf421810b6dc46ff0573b245c2993d","url":"https://api.github.com/repos/openai/codex/git/trees/40557b789dbf421810b6dc46ff0573b245c2993d"},"url":"https://api.github.com/repos/openai/codex/git/commits/23aac925e7b3fd02b9d6a47147b7b8310a124b49","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqToIGCRC1aQ7uu5UhlAAAMWsQAJy9tI6szbCHnLeYCQoubo8Y\niQJ64LJbWJBHCkGbIAMhz7Pmbhc4qQJ0vBWjDPJ1OGo73IfpbfE68HtUYiGA+l9q\nnc3KPFlgBi716J1whCaWiX0JKWIAVbhVM/2yUkcoeszayfrGUTKP+6g/cV8bpnFp\nyng8/2CjTooqhVRdS6SNyACZYJLpL93TfPM6o1NnJzjbcRRC40VXd5SNYUJYgRcb\ngO/sqR7V54NlvnEzIyeo7Vm8My+Zm+wsevrjmbyHeVnsXq+f1YHxHMJcRHznhake\n6x3N/G45dcMFju35/GAVemVAJGh5PYHA93mn/A2Uo+JyGWZxZo7Bl1XLVp4nvhpw\nwCE+HR71onmWweqDET4dmqkoH0Tt1Mp1kuBjH9ek6PkLzUOGG5Vne7EAeX8z4o6N\nAlntTurg4fCUydQThs7ZSwc4kG+FtgNMXW1GfjSrsj6UL35hzLf2Wagv6Zhn5sDy\nhGo+u3xjCNt0IwIiP95bywcBn5IoNk+d/dwhW3R2cVeHcXViHK4deVvnSUVxKAS8\n5j3uwxeH5+zfBEADAxji12KE8+Rav3vW73pwNuLG/WW05r/kjiTDEUjC6qgXS3+Y\nWINzxZZ6JlFmfsKLpnBCdnQUsDKFGFv8DSSYsEZa8NC4/Og4S9n8B9kDREtjjE+U\nuHVM8bDrHOo02Ay1od8a\n=J7CL\n-----END PGP SIGNATURE-----\n","payload":"tree 40557b789dbf421810b6dc46ff0573b245c2993d\nparent a219b6fdb4e9f9655968adf20984916abc8b2290\nauthor Owen Lin <owenlin0@gmail.com> 1783529990 -0700\ncommitter GitHub <noreply@github.com> 1783529990 -0700\n\nfeat(core): emit canonical review mode items (#31473)\n\n## Description\n\nThis PR moves review-mode markers onto canonical `TurnItem` lifecycle:\n\n- `TurnItem::EnteredReviewMode`\n- `TurnItem::ExitedReviewMode`\n\nCore now emits `ItemStarted` / `ItemCompleted` for both. The completed\nitems map back into the existing `EnteredReviewMode` /\n`ExitedReviewMode` events, so raw core event consumers and legacy\nrollout persistence keep seeing the old events.\n\nThis is the compatibility layer needed before paginated rollouts persist\nreview markers as `ItemCompleted(TurnItem)`.\n\n## Why\n\nReview markers were one of the remaining app-server thread items created\ndirectly from legacy events. Giving them canonical items lets paginated\nhistory persist stable turn/item IDs without changing legacy rollouts.\n\n## What changed\n\n- Added canonical review-mode `TurnItem`s and switched review flow to\nemit their lifecycle.\n- Added completed-item → legacy review event mappings with stable\nturn/item IDs.\n- Switched app-server live notifications to the generic canonical item\npath and kept legacy replay compatible with old payloads.\n- Updated `ThreadHistoryBuilder` to replay canonical review items even\nthough review turns still do not emit `TurnStarted`.","verified_at":"2026-07-08T16:59:50Z"}},"url":"https://api.github.com/repos/openai/codex/commits/23aac925e7b3fd02b9d6a47147b7b8310a124b49","html_url":"https://github.com/openai/codex/commit/23aac925e7b3fd02b9d6a47147b7b8310a124b49","comments_url":"https://api.github.com/repos/openai/codex/commits/23aac925e7b3fd02b9d6a47147b7b8310a124b49/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a219b6fdb4e9f9655968adf20984916abc8b2290","url":"https://api.github.com/repos/openai/codex/commits/a219b6fdb4e9f9655968adf20984916abc8b2290","html_url":"https://github.com/openai/codex/commit/a219b6fdb4e9f9655968adf20984916abc8b2290"}]},{"sha":"a219b6fdb4e9f9655968adf20984916abc8b2290","node_id":"C_kwDOOYsS4doAKGEyMTliNmZkYjRlOWY5NjU1OTY4YWRmMjA5ODQ5MTZhYmM4YjIyOTA","commit":{"author":{"name":"Owen Lin","email":"owenlin0@gmail.com","date":"2026-07-08T16:40:00Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T16:40:00Z"},"message":"core: migrate standalone web search to extension-owned turn items (#31525)\n\n## Description\n\nThis PR migrates standalone web search onto the extension-owned\nturn-item path introduced in #31283.\n\nStandalone web search now emits `ExtensionItem::WebSearch` through\ngeneric `TurnItem::Extension`, while app-server still exposes the\nexisting typed `ThreadItem::WebSearch` JSON shape. Hosted Responses API\nweb search stays on core-owned `TurnItem::WebSearch`.\n\n## What changed\n\n- Added `web_search::WebSearchItem` and `WebSearchAction` to\n`codex-extension-items` under the stable `web.search` kind.\n- Collapsed `ExtensionTurnItem` to generic `{ item, legacy_events }` now\nthat no typed extension special cases remain.\n- Kept the existing `WebSearchBegin` / `WebSearchEnd` compatibility\nevents and canonical-first ordering.\n- Updated app-server projection/history and generated TypeScript; the\napp-server JSON schema is unchanged.","tree":{"sha":"4a27381c39815bfc2adb978cde5ad822f8bac9f5","url":"https://api.github.com/repos/openai/codex/git/trees/4a27381c39815bfc2adb978cde5ad822f8bac9f5"},"url":"https://api.github.com/repos/openai/codex/git/commits/a219b6fdb4e9f9655968adf20984916abc8b2290","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTn1gCRC1aQ7uu5UhlAAAXucQAJFkcrqAzt6mp1o+acu6SlLv\nchQwGuldtse4stFSnkQCn5GcNcPfFoH8ZC5H+2DU4tjf7Nyuwk0JJ86BXZxO3gcM\nLSAvxAOVhKbIE8MhZ1KIrLHtBGobd7q8oW6cyVCxuj+tDDJqJkFbd499fJ+VrBoE\nBMULjE5VkJuGope3udsebLb+6vAi0XZVme0hGRVZZsQJsf0DD6BpvP0XftRU7/T4\nlQ8rAK4qIPBw6AgkPgwrA5aScjuxkCG6iJcaZ51yBrK6DrcpQ7W2OQSdT+ZaRR+7\n2V/+YW5M5HBA070xZQkiaMuoVYW1k1Y/tatPpU8Wed2K6LOnhKQ164BKOzyqGSa/\nMre4HyRPQVXAbhobpotAbFLZ0x2LR5S+cfpwy5+Ua5r766kqrBdvM/zdkO6S9IVo\nHuiTRyoHVWP0PUmbfTLYvJgh8LNsmjmhOrIXCiNozYAEG+pebsdFCB625NBmgH6w\nfDhk5JUGtyaavzIPjhDWhtBJDI+IlsGN+M96BwOkBdX/FhbTS7O3sC3sgHhEl95y\nxMiSsP4TWRouddmkX4/IIRkSxbUBT//Afy3eMPceh8gIfGl10UqaAFQTCuP7gjNy\nTiHpuBakoMQvfAeXPH7znSXqveSnp6rtR86aUJwnirFYtp0W5+NHn00KnFq+aL20\nS1wxGLSFuFcmuhTC4F64\n=3xhk\n-----END PGP SIGNATURE-----\n","payload":"tree 4a27381c39815bfc2adb978cde5ad822f8bac9f5\nparent e212cc95b0faf340474b821cee431bddbf2003e6\nauthor Owen Lin <owenlin0@gmail.com> 1783528800 -0700\ncommitter GitHub <noreply@github.com> 1783528800 -0700\n\ncore: migrate standalone web search to extension-owned turn items (#31525)\n\n## Description\n\nThis PR migrates standalone web search onto the extension-owned\nturn-item path introduced in #31283.\n\nStandalone web search now emits `ExtensionItem::WebSearch` through\ngeneric `TurnItem::Extension`, while app-server still exposes the\nexisting typed `ThreadItem::WebSearch` JSON shape. Hosted Responses API\nweb search stays on core-owned `TurnItem::WebSearch`.\n\n## What changed\n\n- Added `web_search::WebSearchItem` and `WebSearchAction` to\n`codex-extension-items` under the stable `web.search` kind.\n- Collapsed `ExtensionTurnItem` to generic `{ item, legacy_events }` now\nthat no typed extension special cases remain.\n- Kept the existing `WebSearchBegin` / `WebSearchEnd` compatibility\nevents and canonical-first ordering.\n- Updated app-server projection/history and generated TypeScript; the\napp-server JSON schema is unchanged.","verified_at":"2026-07-08T16:40:01Z"}},"url":"https://api.github.com/repos/openai/codex/commits/a219b6fdb4e9f9655968adf20984916abc8b2290","html_url":"https://github.com/openai/codex/commit/a219b6fdb4e9f9655968adf20984916abc8b2290","comments_url":"https://api.github.com/repos/openai/codex/commits/a219b6fdb4e9f9655968adf20984916abc8b2290/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e212cc95b0faf340474b821cee431bddbf2003e6","url":"https://api.github.com/repos/openai/codex/commits/e212cc95b0faf340474b821cee431bddbf2003e6","html_url":"https://github.com/openai/codex/commit/e212cc95b0faf340474b821cee431bddbf2003e6"}]},{"sha":"e212cc95b0faf340474b821cee431bddbf2003e6","node_id":"C_kwDOOYsS4doAKGUyMTJjYzk1YjBmYWYzNDA0NzRiODIxY2VlNDMxYmRkYmYyMDAzZTY","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-07-08T16:17:58Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T16:17:58Z"},"message":"Detect Codex installs managed by pnpm (#31503)\n\n## Why\n\nThe Codex JavaScript shim currently distinguishes npm and Bun installs,\nbut a global pnpm install falls back to npm. That causes the native CLI,\n`codex doctor`, and update flows to report or run npm commands even\nthough pnpm owns the installation. pnpm also allows its global package\nand bin directories to differ, so `PNPM_HOME` does not reliably identify\nthe package owner.\n\n## What changed\n\n- detect pnpm-managed installs by finding pnpm's\n`node_modules/.modules.yaml` metadata from the launched JavaScript\nentrypoint\n- pass a mutually exclusive `CODEX_MANAGED_BY_PNPM` marker into the\nnative CLI\n- represent pnpm in install context, doctor output, version checks, and\nTUI update actions without changing the existing public\n`InstallContext::from_exe` signature\n- recommend `pnpm add -g @openai/codex` for pnpm-managed installs and\nsnapshot the rendered TUI update notice\n\nValidated with the 9-test install-context suite, the focused pnpm TUI\nsnapshot test, and Node's syntax check for the launcher.\n\nCloses https://github.com/openai/codex/issues/10294.","tree":{"sha":"ecb01075a265487310cb656fb20c3f9130b03ffe","url":"https://api.github.com/repos/openai/codex/git/trees/ecb01075a265487310cb656fb20c3f9130b03ffe"},"url":"https://api.github.com/repos/openai/codex/git/commits/e212cc95b0faf340474b821cee431bddbf2003e6","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTng2CRC1aQ7uu5UhlAAAchAQABn21O9AFH2EG+CASQIVUa57\nfA0WqK2H0j7PsbK0wOMZaS0MO6e/NBcK5WLwgPE4giDimOWB+f5FGwDQZ3gG5JVQ\nbBZEhDY7UGadLeOI4cc/SFP+szxRujsWH+HC5d8ZXYd5ILDdHAwbMACY5dnDvJs1\nxHa3N38f2/wmWQbzmIgrqGd9ubV13Oj1Ngaox8OHm41+TcOFCtziYsU2iPU0LHBJ\nvGsF4gt1jv3OZ/2kHwyQKD5BeljN7iUsROFmrAfA02LeTDnmvpmXlnwTbDJLKoT8\nHHTCDUe5lRjxc2+aJf9BWR7+DwBWv/diu4UwKt4uVONIpbXoezW4rJx659wb7nBn\nog/NtweV3/rFYg0bn1LlJgRbknBP1fhJEyc9/Xfol6DWiHUY9pRiu+ja6G/pLSGC\n1e6ZUh1ktlRJUT2cJlLYiuFeGtEZPC2TCFJooZwtM42mVhV1hs9fHPPXjCFU4wlE\nfPu+ZyfQev2rfDdw0IIfYB+l8a+mCcFS6ny5ouN/cRHGMlcoEikl8/7FtOyIyx75\nY6LpjWQSjEcAAyi/lNoBQyDMWIyI2+Xjo10f1xREgFQuax33zJhqL4zD1tNnCpM/\nPxxnYZBOU75Zf7kFFb31yKFLUdDIjyfsJh8HkzGSsRYf9EV+bk2IsOnNpxfQAM4v\nQz3x3hiuRB9J8lWE34PA\n=Pv2H\n-----END PGP SIGNATURE-----\n","payload":"tree ecb01075a265487310cb656fb20c3f9130b03ffe\nparent 0bbea86a6aae37b1f243676db4248000f04ad111\nauthor Charlie Marsh <charliemarsh@openai.com> 1783527478 -0400\ncommitter GitHub <noreply@github.com> 1783527478 -0400\n\nDetect Codex installs managed by pnpm (#31503)\n\n## Why\n\nThe Codex JavaScript shim currently distinguishes npm and Bun installs,\nbut a global pnpm install falls back to npm. That causes the native CLI,\n`codex doctor`, and update flows to report or run npm commands even\nthough pnpm owns the installation. pnpm also allows its global package\nand bin directories to differ, so `PNPM_HOME` does not reliably identify\nthe package owner.\n\n## What changed\n\n- detect pnpm-managed installs by finding pnpm's\n`node_modules/.modules.yaml` metadata from the launched JavaScript\nentrypoint\n- pass a mutually exclusive `CODEX_MANAGED_BY_PNPM` marker into the\nnative CLI\n- represent pnpm in install context, doctor output, version checks, and\nTUI update actions without changing the existing public\n`InstallContext::from_exe` signature\n- recommend `pnpm add -g @openai/codex` for pnpm-managed installs and\nsnapshot the rendered TUI update notice\n\nValidated with the 9-test install-context suite, the focused pnpm TUI\nsnapshot test, and Node's syntax check for the launcher.\n\nCloses https://github.com/openai/codex/issues/10294.","verified_at":"2026-07-08T16:17:59Z"}},"url":"https://api.github.com/repos/openai/codex/commits/e212cc95b0faf340474b821cee431bddbf2003e6","html_url":"https://github.com/openai/codex/commit/e212cc95b0faf340474b821cee431bddbf2003e6","comments_url":"https://api.github.com/repos/openai/codex/commits/e212cc95b0faf340474b821cee431bddbf2003e6/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"0bbea86a6aae37b1f243676db4248000f04ad111","url":"https://api.github.com/repos/openai/codex/commits/0bbea86a6aae37b1f243676db4248000f04ad111","html_url":"https://github.com/openai/codex/commit/0bbea86a6aae37b1f243676db4248000f04ad111"}]},{"sha":"0bbea86a6aae37b1f243676db4248000f04ad111","node_id":"C_kwDOOYsS4doAKDBiYmVhODZhNmFhZTM3YjFmMjQzNjc2ZGI0MjQ4MDAwZjA0YWQxMTE","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-08T15:10:28Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T15:10:28Z"},"message":"Stabilize shared rollout budget test (#31587)\n\n## Why\n\n`subagent_usage_draws_from_the_shared_budget` intermittently fails even\nwhen the shared-budget behavior is correct. `ResponseMock` records a\nrequest before the custom Wiremock predicate is checked, so the\nfollow-up mock can also contain unrelated requests. In a [recent Windows\nARM64 run](https://github.com/openai/codex/actions/runs/28916285431),\n`single_request()` saw all seven requests from the scenario.\n\n## What changed\n\nSelect the request containing the follow-up user prompt before making\nassertions. The test still requires exactly one matching follow-up\nrequest and still checks that the root sees 50 tokens remaining after\nthe child uses its share.\n\nThis is test-only. Shared-budget behavior and the common response-mock\nhelper are unchanged.","tree":{"sha":"e616df72e29969bf2180bbe2cc988d677044a1f8","url":"https://api.github.com/repos/openai/codex/git/trees/e616df72e29969bf2180bbe2cc988d677044a1f8"},"url":"https://api.github.com/repos/openai/codex/git/commits/0bbea86a6aae37b1f243676db4248000f04ad111","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTmhkCRC1aQ7uu5UhlAAArzgQAICXe58oHJFSiBI+CykI07/b\nxRRGZJXsSYh4Kbqc5KgDnsnPhZJK5UQMsQFr4dNq59b505CUn7QgEAAS1xlFKfIw\nsDWygK/C09+pqCPA+MeTrPlR4pFn3Ikgj5A8LOPaRvG6AOAHzHKGrj6J9IO8HaX1\nlzRWnO87+MbntunNuNIRzJmnxnDx/Au9geMNtEDR66jSAZNAzOhlqc6hc67dcBPM\nl/e8SfRWZGWxfFZ1uG/et2bW5vbMf5GHYfsOku4RCkSY+7poCWoPY3YOvChHNK4K\nDySRk5bCDLdhhBYbUbbt2hgWEze6lT0s5gxRV/i8LHW2oxAPas5nBoRvnF7QwIyW\nmuFEVo+tUOY4GscXK5mk2WCFOR2k+99t6coxu4qWOrz/CAQWfedNSdoCoAWkz4w4\n2nKiZ2J3t31PJ9cK+6uVAlW4IZPVQ+O8rnzROp7jKae3KQX69y4D/CwZocDjXEpQ\nG/U0XtCERTV+NnZgZs6eKhO4P3bjBPK4YAHLAG7sb7oQH68V3jRX2+Vx5EsTu2sL\nrz62BRtdSwuMUO4g8o8zgkA/uv3oLTKVQ6m3xPKYFxrwfkKmGQTwuP1NzMf2We3g\nG2SGG4wmm2u1I3gYYc/hvToTJAhUSmoj/hrYoZYzcsRhfW0Dgcr4BOAqUILvh7AY\n+aKWBf6CNFy7RjmfHUmZ\n=rukz\n-----END PGP SIGNATURE-----\n","payload":"tree e616df72e29969bf2180bbe2cc988d677044a1f8\nparent 1ee0e9a9495ca4643c0cbeea32df15619c5754bd\nauthor jif <jif@openai.com> 1783523428 +0100\ncommitter GitHub <noreply@github.com> 1783523428 +0100\n\nStabilize shared rollout budget test (#31587)\n\n## Why\n\n`subagent_usage_draws_from_the_shared_budget` intermittently fails even\nwhen the shared-budget behavior is correct. `ResponseMock` records a\nrequest before the custom Wiremock predicate is checked, so the\nfollow-up mock can also contain unrelated requests. In a [recent Windows\nARM64 run](https://github.com/openai/codex/actions/runs/28916285431),\n`single_request()` saw all seven requests from the scenario.\n\n## What changed\n\nSelect the request containing the follow-up user prompt before making\nassertions. The test still requires exactly one matching follow-up\nrequest and still checks that the root sees 50 tokens remaining after\nthe child uses its share.\n\nThis is test-only. Shared-budget behavior and the common response-mock\nhelper are unchanged.","verified_at":"2026-07-08T15:10:29Z"}},"url":"https://api.github.com/repos/openai/codex/commits/0bbea86a6aae37b1f243676db4248000f04ad111","html_url":"https://github.com/openai/codex/commit/0bbea86a6aae37b1f243676db4248000f04ad111","comments_url":"https://api.github.com/repos/openai/codex/commits/0bbea86a6aae37b1f243676db4248000f04ad111/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"1ee0e9a9495ca4643c0cbeea32df15619c5754bd","url":"https://api.github.com/repos/openai/codex/commits/1ee0e9a9495ca4643c0cbeea32df15619c5754bd","html_url":"https://github.com/openai/codex/commit/1ee0e9a9495ca4643c0cbeea32df15619c5754bd"}]},{"sha":"1ee0e9a9495ca4643c0cbeea32df15619c5754bd","node_id":"C_kwDOOYsS4doAKDFlZTBlOWE5NDk1Y2E0NjQzYzBjYmVlYTMyZGYxNTYxOWM1NzU0YmQ","commit":{"author":{"name":"charlesgong-openai","email":"charlesgong@openai.com","date":"2026-07-08T15:06:45Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T15:06:45Z"},"message":"Log plugin install failure subtypes (#31518)\n\n## Summary\n\n- classify plugin store and remote bundle I/O failures by privacy-safe\noperation context\n- include the normalized `sub_error_type` in structured plugin-install\nfailure warnings\n- leave analytics events and schemas unchanged\n\n## Why\n\nTop-level error types such as `store_io` collapse multiple filesystem\noperations, making logs harder to diagnose. The subtype identifies the\nfailed operation without logging paths or new exception details.\n\n## Impact\n\nPlugin-install warning logs gain an optional normalized subtype.\nAnalytics payloads, app-server APIs, and stored data are unchanged.\n\n## Validation\n\n- `just fmt`\n- `just test -p codex-core-plugins -p codex-app-server` (1,235 passed;\n14 failed and 6 timed out because local `sandbox-exec` was denied,\n`test_stdio_server` was unavailable, or user-level skill fixtures were\nloaded)","tree":{"sha":"2a23279b1797328a3dd280e5a9da4d2a9de871eb","url":"https://api.github.com/repos/openai/codex/git/trees/2a23279b1797328a3dd280e5a9da4d2a9de871eb"},"url":"https://api.github.com/repos/openai/codex/git/commits/1ee0e9a9495ca4643c0cbeea32df15619c5754bd","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTmeFCRC1aQ7uu5UhlAAAegIQAJm1WIZaMlE2EpTGEhtiP2qT\nFxD9W0Q5fx5xO1Nlzn3vjjnBoAdNKorT37497VdjySE9aehjInQ+H9MXnAJryeBF\ndx1wwp1YyLF1nDMPjTV2jjsSzXAKF9TdTgn6Byld7JLAmXNak4k8GO2iBokhzx6+\n9lG5JNK6X4POgOw1PQbuJs8W7ADzA7zGHMaHMHguPO4weXtH9hN30CQjWgbvQPYL\nIKer3lwqkqqbI8YPdI9bnGTqoi5sI5nEcGiSqHSrFibjSg09d4ZJO2cXDNObRLx1\nr+qytlTpK1fU7ee0nKYrqOD5CCfz162VItKAE1DDZOVCW3CgilB9PFwbyByTCuzx\nhl1jADNPfwEnt0/fimmK+wCDMUmjbsD5dCqQiHcu7PpGTXlcKKPrxwCcAiFdfhPj\nHkHeAkFzyq5oj+9rYe2NFLwoc/HjDe1XLasjz8RdDfwUE0UNlqoKyz061IP66tDH\nEIVg4fu9/h5EgagrGSs0GJfA+pEcRivc43UCSFIAmtM7YaDUSj2fL018UwInrzfY\n3o9dPtoulOK19KcHZ+xsafa8fdesiowr2HwpPqqC7UwuAWisU5gJA8FAojjNLi4X\nGq7XfcOUBDdGHL8WGA3L7bHkGoE2ZdogbD06e+Sp6Q9V4dBdTn6ehQONTGOUM+Wd\nnsLnCBL9iV9yynglEp5w\n=YjwW\n-----END PGP SIGNATURE-----\n","payload":"tree 2a23279b1797328a3dd280e5a9da4d2a9de871eb\nparent f17a57b7d5a1d1002bca37a57228d8214b862f00\nauthor charlesgong-openai <charlesgong@openai.com> 1783523205 -0400\ncommitter GitHub <noreply@github.com> 1783523205 -0400\n\nLog plugin install failure subtypes (#31518)\n\n## Summary\n\n- classify plugin store and remote bundle I/O failures by privacy-safe\noperation context\n- include the normalized `sub_error_type` in structured plugin-install\nfailure warnings\n- leave analytics events and schemas unchanged\n\n## Why\n\nTop-level error types such as `store_io` collapse multiple filesystem\noperations, making logs harder to diagnose. The subtype identifies the\nfailed operation without logging paths or new exception details.\n\n## Impact\n\nPlugin-install warning logs gain an optional normalized subtype.\nAnalytics payloads, app-server APIs, and stored data are unchanged.\n\n## Validation\n\n- `just fmt`\n- `just test -p codex-core-plugins -p codex-app-server` (1,235 passed;\n14 failed and 6 timed out because local `sandbox-exec` was denied,\n`test_stdio_server` was unavailable, or user-level skill fixtures were\nloaded)","verified_at":"2026-07-08T15:06:46Z"}},"url":"https://api.github.com/repos/openai/codex/commits/1ee0e9a9495ca4643c0cbeea32df15619c5754bd","html_url":"https://github.com/openai/codex/commit/1ee0e9a9495ca4643c0cbeea32df15619c5754bd","comments_url":"https://api.github.com/repos/openai/codex/commits/1ee0e9a9495ca4643c0cbeea32df15619c5754bd/comments","author":{"login":"charlesgong-openai","id":200841148,"node_id":"U_kgDOC_iXvA","avatar_url":"https://avatars.githubusercontent.com/u/200841148?v=4","gravatar_id":"","url":"https://api.github.com/users/charlesgong-openai","html_url":"https://github.com/charlesgong-openai","followers_url":"https://api.github.com/users/charlesgong-openai/followers","following_url":"https://api.github.com/users/charlesgong-openai/following{/other_user}","gists_url":"https://api.github.com/users/charlesgong-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/charlesgong-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charlesgong-openai/subscriptions","organizations_url":"https://api.github.com/users/charlesgong-openai/orgs","repos_url":"https://api.github.com/users/charlesgong-openai/repos","events_url":"https://api.github.com/users/charlesgong-openai/events{/privacy}","received_events_url":"https://api.github.com/users/charlesgong-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f17a57b7d5a1d1002bca37a57228d8214b862f00","url":"https://api.github.com/repos/openai/codex/commits/f17a57b7d5a1d1002bca37a57228d8214b862f00","html_url":"https://github.com/openai/codex/commit/f17a57b7d5a1d1002bca37a57228d8214b862f00"}]},{"sha":"f17a57b7d5a1d1002bca37a57228d8214b862f00","node_id":"C_kwDOOYsS4doAKGYxN2E1N2I3ZDVhMWQxMDAyYmNhMzdhNTcyMjhkODIxNGI4NjJmMDA","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-08T14:59:36Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T14:59:36Z"},"message":"Stabilize remote compaction parity against dynamic skill catalogs (#31585)\n\n## Why\n\nThe remote compaction parity test compares legacy and v2 sessions\ncreated with separate temporary homes. Those sessions can discover\ndifferent model-visible skill catalogs, so the request comparison can\nfail even when the compaction and service-tier behavior matches.\n\nThis is the most frequent retry-saved full-CI failure in the recent\nJUnit history.\n\n## What changed\n\nNormalize only the contents of `<skills_instructions>` before comparing\nthe captured requests. The opening and closing tags remain in the\ncomparison, so the test still catches a missing or misplaced skills\nblock.\n\nThe service-tier, compacted input, follow-up request, and\nreplacement-history assertions are unchanged. A focused normalizer test\ncovers the new behavior.\n\n## Scope\n\nThis is test-only. It does not change runtime compaction or skill\nbehavior. Exact skill-catalog rendering remains covered by the dedicated\nskills tests.","tree":{"sha":"09ea33c946805c68490b1b79d624c3a57ea5d6c4","url":"https://api.github.com/repos/openai/codex/git/trees/09ea33c946805c68490b1b79d624c3a57ea5d6c4"},"url":"https://api.github.com/repos/openai/codex/git/commits/f17a57b7d5a1d1002bca37a57228d8214b862f00","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTmXYCRC1aQ7uu5UhlAAAyWQQACefkNbp/LT75BUmdsFnqVqL\nh7v0AQFsczHvg5njdaOaMrQLW2eO1wJVAeFFoA8hvSjWSi74mxs+PURJtgFK9iga\n2TKq28yeav0A+EBKuom1StyeQ7+ho9D1gpaQFVtBioEdg76+85Kwd+DpuLbyPgco\nWoxE+vaLCzskZVoSqLHpWLmo0tLLJ5DSoHT83FxijzKwHj4RKqxq+2cfKfNaQLT1\nNZzomOf0eHVM2TwIwuHBKpZekDIUl3vDGMOF6oh5dmjcShK0kXW8aRCVyuxh1reG\n2upK+s3d1+ACSgQayGlZoRtIpxF6CIHkH830Bd1LjR7dt7toZ3raKpRG80KtYQf/\n1byMPFBX7MJX8TkduBXR6fHMOEZgHO+hS0jShP94uPIsVhJhmaMQzgFeMkkhOq8t\n6jSpmSaJYLj8a4N9vIfjvM9k5SjELQ9e+JtYM6k7o1OAvO5ZgCJv3rk0K6NGHaD4\nt8c/E9uyF3UPtCzTwhEX9CshL+EHSSO0ZryuimBJQTTg4vt+NnbbXGePZnXf0R4j\nuahaawCsAB7dd033L9TuuyGzYCE3FvzZ6g+8J21+yFBs65kEDi8JpilPB+bFzYFm\n5ZHfwJUPsnzhqU4r1jihmXTjmFpZO/3zfnG4zARfMQftBHVRWycOgmNCYJ6ecaOt\n/qbuMA0h1QNGGdzOTwLU\n=2E30\n-----END PGP SIGNATURE-----\n","payload":"tree 09ea33c946805c68490b1b79d624c3a57ea5d6c4\nparent 8dfd3975f5a7c3847dde13f80a949e8fab0d3bae\nauthor jif <jif@openai.com> 1783522776 +0100\ncommitter GitHub <noreply@github.com> 1783522776 +0100\n\nStabilize remote compaction parity against dynamic skill catalogs (#31585)\n\n## Why\n\nThe remote compaction parity test compares legacy and v2 sessions\ncreated with separate temporary homes. Those sessions can discover\ndifferent model-visible skill catalogs, so the request comparison can\nfail even when the compaction and service-tier behavior matches.\n\nThis is the most frequent retry-saved full-CI failure in the recent\nJUnit history.\n\n## What changed\n\nNormalize only the contents of `<skills_instructions>` before comparing\nthe captured requests. The opening and closing tags remain in the\ncomparison, so the test still catches a missing or misplaced skills\nblock.\n\nThe service-tier, compacted input, follow-up request, and\nreplacement-history assertions are unchanged. A focused normalizer test\ncovers the new behavior.\n\n## Scope\n\nThis is test-only. It does not change runtime compaction or skill\nbehavior. Exact skill-catalog rendering remains covered by the dedicated\nskills tests.","verified_at":"2026-07-08T14:59:36Z"}},"url":"https://api.github.com/repos/openai/codex/commits/f17a57b7d5a1d1002bca37a57228d8214b862f00","html_url":"https://github.com/openai/codex/commit/f17a57b7d5a1d1002bca37a57228d8214b862f00","comments_url":"https://api.github.com/repos/openai/codex/commits/f17a57b7d5a1d1002bca37a57228d8214b862f00/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"8dfd3975f5a7c3847dde13f80a949e8fab0d3bae","url":"https://api.github.com/repos/openai/codex/commits/8dfd3975f5a7c3847dde13f80a949e8fab0d3bae","html_url":"https://github.com/openai/codex/commit/8dfd3975f5a7c3847dde13f80a949e8fab0d3bae"}]},{"sha":"8dfd3975f5a7c3847dde13f80a949e8fab0d3bae","node_id":"C_kwDOOYsS4doAKDhkZmQzOTc1ZjVhN2MzODQ3ZGRlMTNmODBhOTQ5ZThmYWIwZDNiYWU","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-08T14:59:04Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T14:59:04Z"},"message":"Stabilize encrypted MAv2 spawn request test (#31586)\n\n## Why\n\nThe encrypted MAv2 spawn test often reads the parent follow-up request\nbefore the child has sent its first request. The response mock records\ncandidate requests before applying its specific matcher, so the test can\nsee an empty `agent_message` list even though delivery happens a moment\nlater.\n\n## What changed\n\nWait for the recorded child request that contains `agent_message`, using\nthe same short bounded polling pattern already used in this test module.\nThe exact encrypted payload and communication-log assertions stay\nunchanged.\n\nThis is test-only: it does not add product delays, loosen the assertion,\nor change multi-agent behavior. No follow-up is expected.","tree":{"sha":"6a0d13ad54888ea24405f7b01da711df317d077e","url":"https://api.github.com/repos/openai/codex/git/trees/6a0d13ad54888ea24405f7b01da711df317d077e"},"url":"https://api.github.com/repos/openai/codex/git/commits/8dfd3975f5a7c3847dde13f80a949e8fab0d3bae","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTmW4CRC1aQ7uu5UhlAAABIUQABcVKZPGzKXhV2gsuXHZ+AoS\nTarYEHT8qy8JPl7Vyc7aWz+pEfyLjfWp4wcwFQ3288CCLEN9B9V+ppEFQ3al77Qa\n1yj4sgpKwVNQ3+z008a615w3BplY+9SjiXTs8fVcKixPIrKsXQAN6KvARpS336/Q\nUE3z4Qv5xSuX0jOf3hKj9M2TikR6Xfb7a8V1HWClovb/nfmrSRr5TcFsJP2/M0P1\neJ6sL2QslypN7Tmqpmt1V1fFhU0qj9Ri3FbYjqJG2Hp+u/jBgfTaSjcAjpfe9OBv\nmv3AO6xcdrUMcl03PcLVlNw4MtQkKnLcXAdvLHY5Iajwkx4givnPYwE1A2dE8zvn\nB190QWav6DDa4LSGfc4BVES9psp0NJxYMUYlkb64Lb2kMubLQdY5HD/YwezcKpUk\nKIP6teyRnxtOVJSsFEjuwiiQdQP7rVskD7c5g3FXgmazc9IWm4UsxYjJqYbtmZKT\nPEiuyeCC4bWP+N1UFM5kEGArlHXGjriZ1JcbMKqUTFzbKxroKYSuBXx6i4n1orio\nFb4kgi0Ut7yeRPlr4aCy+HqdO1MMsE4cJOepFS8t5LJKcgvt0bqZ27w6H1iW+W1B\nxVduwnMwWcfJDeJ7/NH843lLZK9VQpSP+mU3J2tn4dSt4ZbV7OnTgIb20m3SN7cv\ngGBm1D32xPZdCap4M1j+\n=8IhS\n-----END PGP SIGNATURE-----\n","payload":"tree 6a0d13ad54888ea24405f7b01da711df317d077e\nparent 6849549b49446fc3db89ecc13d6226ab971bec79\nauthor jif <jif@openai.com> 1783522744 +0100\ncommitter GitHub <noreply@github.com> 1783522744 +0100\n\nStabilize encrypted MAv2 spawn request test (#31586)\n\n## Why\n\nThe encrypted MAv2 spawn test often reads the parent follow-up request\nbefore the child has sent its first request. The response mock records\ncandidate requests before applying its specific matcher, so the test can\nsee an empty `agent_message` list even though delivery happens a moment\nlater.\n\n## What changed\n\nWait for the recorded child request that contains `agent_message`, using\nthe same short bounded polling pattern already used in this test module.\nThe exact encrypted payload and communication-log assertions stay\nunchanged.\n\nThis is test-only: it does not add product delays, loosen the assertion,\nor change multi-agent behavior. No follow-up is expected.","verified_at":"2026-07-08T14:59:05Z"}},"url":"https://api.github.com/repos/openai/codex/commits/8dfd3975f5a7c3847dde13f80a949e8fab0d3bae","html_url":"https://github.com/openai/codex/commit/8dfd3975f5a7c3847dde13f80a949e8fab0d3bae","comments_url":"https://api.github.com/repos/openai/codex/commits/8dfd3975f5a7c3847dde13f80a949e8fab0d3bae/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"6849549b49446fc3db89ecc13d6226ab971bec79","url":"https://api.github.com/repos/openai/codex/commits/6849549b49446fc3db89ecc13d6226ab971bec79","html_url":"https://github.com/openai/codex/commit/6849549b49446fc3db89ecc13d6226ab971bec79"}]},{"sha":"6849549b49446fc3db89ecc13d6226ab971bec79","node_id":"C_kwDOOYsS4doAKDY4NDk1NDliNDk0NDZmYzNkYjg5ZWNjMTNkNjIyNmFiOTcxYmVjNzk","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-07-08T12:57:25Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T12:57:25Z"},"message":"Align empty branch list message with search (#31465)\n\n## Summary\n\nSelection rows reserve their first two columns for the selection cursor\nand render into the menu surface's left gutter. The empty-state message\nreused that shifted row area even though it has no cursor prefix, so `no\nmatches` appeared two columns to the left of the search field.\n\nThis renders empty lists at the inset list origin while preserving the\ncursor gutter for non-empty rows.","tree":{"sha":"446969bdb9fff33c5afbfe8d9d38493f67283e56","url":"https://api.github.com/repos/openai/codex/git/trees/446969bdb9fff33c5afbfe8d9d38493f67283e56"},"url":"https://api.github.com/repos/openai/codex/git/commits/6849549b49446fc3db89ecc13d6226ab971bec79","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTkk1CRC1aQ7uu5UhlAAAZ1UQAD6DkKd9UCkLLcJAlurBI6NU\nDBIJOlUy5Id8lpcQ620FhnUj2bfAreQ62ykQ/uV4jQN/CWP3R+9vbbeoEExMd6/q\nJ2/Q5qggxBn9P+o3bR0Q9KyhNU+R6bjYn8ffqmXTtAdbq1HofvYQFecnS3NS5MP5\nvQ9bSyAce01zXH4EgOhW7lS8Fqd/sUOImmfSbUTCOunfm6XRn7wdcxRMpAxcp7Xc\nSKLw9dFvCCFURNatRSN1lv9Uj+mDuidm7sHVpO0Hk4vQYhi25Dgh3S5uHUwMCnRG\nL/WEb3M16tKILLEq387i5JyhpF5CXXVvPb3DqwvDpH3hsN2uAXLN9ZWyGq3JRBxN\nZhYed6DpvbZOtNrX1O5l0zRPZqYmkY+ULl5bpyjU2hXNpirmJ4tY2uY5AYDVvs83\nEP4AqvpAdjvPjErIAcOqYozzkDWch2QLzJe0t/F6rqaX1lqiKB6DBjICLf8KMTak\nXO2Su5h2V1C+I35dNIN4kIFItjcK9IX5ORajfVOmTJFKH4LXStxO/87payTwRLGJ\nwHB8K2085WKUlgYKSCR9CxQ2JmbhK27gGmJZfrkVW9f3cY9+YjNjI4gap7LtjClD\nXwaWn9wJ7x+7tvsShiFE+K6lhSMw7OGtJtxqz6E8qaMsYANTJpec3l5BFsyZtMrt\nDQ67LQC8BARMuk5VuY1p\n=zLfp\n-----END PGP SIGNATURE-----\n","payload":"tree 446969bdb9fff33c5afbfe8d9d38493f67283e56\nparent a52b35fcf679a00a76cb50b7f94a643ccd38b52d\nauthor Charlie Marsh <charliemarsh@openai.com> 1783515445 -0400\ncommitter GitHub <noreply@github.com> 1783515445 -0400\n\nAlign empty branch list message with search (#31465)\n\n## Summary\n\nSelection rows reserve their first two columns for the selection cursor\nand render into the menu surface's left gutter. The empty-state message\nreused that shifted row area even though it has no cursor prefix, so `no\nmatches` appeared two columns to the left of the search field.\n\nThis renders empty lists at the inset list origin while preserving the\ncursor gutter for non-empty rows.","verified_at":"2026-07-08T12:57:25Z"}},"url":"https://api.github.com/repos/openai/codex/commits/6849549b49446fc3db89ecc13d6226ab971bec79","html_url":"https://github.com/openai/codex/commit/6849549b49446fc3db89ecc13d6226ab971bec79","comments_url":"https://api.github.com/repos/openai/codex/commits/6849549b49446fc3db89ecc13d6226ab971bec79/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a52b35fcf679a00a76cb50b7f94a643ccd38b52d","url":"https://api.github.com/repos/openai/codex/commits/a52b35fcf679a00a76cb50b7f94a643ccd38b52d","html_url":"https://github.com/openai/codex/commit/a52b35fcf679a00a76cb50b7f94a643ccd38b52d"}]},{"sha":"a52b35fcf679a00a76cb50b7f94a643ccd38b52d","node_id":"C_kwDOOYsS4doAKGE1MmIzNWZjZjY3OWEwMGE3NmNiNTBiN2Y5NGE2NDNjY2QzOGI1MmQ","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-08T12:49:05Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T12:49:05Z"},"message":"fs: support pruning hidden directories during walks (#31570)\n\nWhy\n\nFiltering hidden directories after a walk is too late: their descendants\nconsume traversal limits, and canonical directory deduplication can let\na hidden path claim a target before a visible symlink reaches it.\n\nWhat this changes\n\n- Add an optional pruneHiddenDirectories walk option. It defaults to\nfalse and is omitted from the wire when disabled.\n- Return hidden directory entries, but do not traverse them or add their\ncanonical identities to the visited set.\n- Cover the visible-symlink-to-hidden-directory case through both local\nand remote filesystem implementations.\n\nThis is the small filesystem prerequisite for #31566. Skill-specific\nbehavior remains in that PR.","tree":{"sha":"74a386993e473d053c0a51d6d39d118ce1e971f9","url":"https://api.github.com/repos/openai/codex/git/trees/74a386993e473d053c0a51d6d39d118ce1e971f9"},"url":"https://api.github.com/repos/openai/codex/git/commits/a52b35fcf679a00a76cb50b7f94a643ccd38b52d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTkdBCRC1aQ7uu5UhlAAA3KAQAJ4cH7u5p6aufCJfCrhBLoaE\ng2atgP0Yj7Qpyags/sMXdlxKteR4IoaOQF9PpwjpS8bquF+5OiO5ddhorOzwJ6NL\njAZzwm73KnrYPPS4bNBG+wDMzeSe7Scn0BE6O7Bi8HpyoTYALn4Qb3bJ4CAfXKYU\nHWPVCbQza7cV1MiqNp+57wvcp6jtGUdiNvpDCfHLtE3e1VwAj0N/Q9mADPVeIbr0\nSyJj58j0V3PZuaS8nUxS+f2tSb9vsmE6eRTcHmmH78SY/cH+B2lIjNs6RD/ttGEX\nWqv3pX9G/hxpEPM+U8kv2OxQGCOY+l0LeaCkNGLlf4+pOVz/ac1MxKzNx0Pm9vQe\nuLG2PEJeh8sTSev91c+T6Y8lmPPJe2lHhKnKr8pb5rLbRGR5NclV3wa/Xw/VUArd\n6xlibvOagLej3mr2GFOYOnpoByN7UnWuMuqWk9KVI8byAkw1W8GFt7FP5OLMs2bR\nx3fi3eOyW4TzeWwLtjRygglxg0pQBxA9hLJi4J8nrKn31mRgQkfvu/f1d5/uYUVd\nOo1TpOl1NPYNfAKcF3HKbXKVblZkdDXcjODxc51wW987AlJc5yh+kcb3ALhZv48I\nsBBbHOvRHWqLx93kW6d2Jxa3cNDi7woPoy7dYOMcZk4rAomooC8eIDg3SIBTaRUX\n28QBlm4Av2GxMnBvBIZz\n=Mv/C\n-----END PGP SIGNATURE-----\n","payload":"tree 74a386993e473d053c0a51d6d39d118ce1e971f9\nparent f1affbac5e5164b2bae825e9b39e9868bc4e0be2\nauthor jif <jif@openai.com> 1783514945 +0100\ncommitter GitHub <noreply@github.com> 1783514945 +0100\n\nfs: support pruning hidden directories during walks (#31570)\n\nWhy\n\nFiltering hidden directories after a walk is too late: their descendants\nconsume traversal limits, and canonical directory deduplication can let\na hidden path claim a target before a visible symlink reaches it.\n\nWhat this changes\n\n- Add an optional pruneHiddenDirectories walk option. It defaults to\nfalse and is omitted from the wire when disabled.\n- Return hidden directory entries, but do not traverse them or add their\ncanonical identities to the visited set.\n- Cover the visible-symlink-to-hidden-directory case through both local\nand remote filesystem implementations.\n\nThis is the small filesystem prerequisite for #31566. Skill-specific\nbehavior remains in that PR.","verified_at":"2026-07-08T12:49:05Z"}},"url":"https://api.github.com/repos/openai/codex/commits/a52b35fcf679a00a76cb50b7f94a643ccd38b52d","html_url":"https://github.com/openai/codex/commit/a52b35fcf679a00a76cb50b7f94a643ccd38b52d","comments_url":"https://api.github.com/repos/openai/codex/commits/a52b35fcf679a00a76cb50b7f94a643ccd38b52d/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f1affbac5e5164b2bae825e9b39e9868bc4e0be2","url":"https://api.github.com/repos/openai/codex/commits/f1affbac5e5164b2bae825e9b39e9868bc4e0be2","html_url":"https://github.com/openai/codex/commit/f1affbac5e5164b2bae825e9b39e9868bc4e0be2"}]},{"sha":"f1affbac5e5164b2bae825e9b39e9868bc4e0be2","node_id":"C_kwDOOYsS4doAKGYxYWZmYmFjNWU1MTY0YjJiYWU4MjVlOWIzOWU5ODY4YmM0ZTBiZTI","commit":{"author":{"name":"Owen Lin","email":"owenlin0@gmail.com","date":"2026-07-08T03:55:13Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T03:55:13Z"},"message":"core: support extension-owned turn items (#31283)\n\n## Description\n\nThis PR adds a `codex-extension-items` crate for extension-owned\n`TurnItem` schemas, and updates standalone image generation to start\nusing it via `TurnItem::Extension`.\n\nThis gives us a way to prevent Core from having to be aware of all\nextension items. App-server still exposes the existing public\n`ThreadItem::ImageGeneration` shape, now by wrapping the same shared\n`image_generation::ImageGenerationItem` type.\n\nThe new `codex-extension-items` crate is necessary because the image gen\nextension item is used by:\n- `codex-image-generation-extension`, which produces it.\n- `codex-tools / core`, which carry it generically.\n- `codex-protocol`, which serializes it into lifecycle events and\nrollouts.\n- `app-server protocol`, which wraps it in public\n`ThreadItem::ImageGeneration`\n\n```\nextension implementation\n        ↓\ncodex-extension-items\n        ↓\nprotocol / tools / app-server\n```\n\nWe keep the hosted Responses API image generation as\n`TurnItem::ImageGeneration` because core still owns its persistence and\nlegacy fanout.\n\n### Before\n\nStandalone image generation is implemented as an extension, but its item\nrepresentation previously lived in the core protocol. This sets the\nprecedent that core is aware of all extension items, which would be good\nto avoid.\n\n```\nimage-gen extension\n→ constructs codex_protocol::ImageGenerationItem\n→ emits ExtensionTurnItem::ImageGeneration\n→ core matches ImageGeneration specially\n→ protocol stores TurnItem::ImageGeneration\n```\n\n### After\n```\nimage-gen extension\n→ constructs extension-owned ImageGenerationItem\n→ emits generic ExtensionItem\n→ core transports/persists it generically\n→ app-server wraps ImageGenerationItem as ThreadItem::ImageGeneration\n```\n\nFuture extension items can have typed app-server APIs without adding a\nnew `TurnItem` variant, `ExtensionTurnItem` variant, or core emitter\nmatch arm.\n\n## What changed\n\n- Added `codex-extension-items` with the closed `ExtensionItem` enum and\nshared `image_generation::ImageGenerationItem` schema.\n- Added generic `TurnItem::Extension(ExtensionItem)` and\n`ExtensionTurnItem::Extension { item, legacy_events }` paths.\n- Updated standalone image generation to emit a typed extension item and\nprovide its existing legacy `ImageGenerationBegin` /\n`ImageGenerationEnd` events explicitly.\n- Kept canonical lifecycle ordering: core emits `ItemStarted` /\n`ItemCompleted` before extension-provided legacy events.\n\n## Follow-up\n\nStandalone web search still uses its typed special-case path. Migrating\nit later would let `ExtensionTurnItem` collapse into a single\nextension-item struct.","tree":{"sha":"ec47a055f1061eadb6e119022a30a1a17a9b1451","url":"https://api.github.com/repos/openai/codex/git/trees/ec47a055f1061eadb6e119022a30a1a17a9b1451"},"url":"https://api.github.com/repos/openai/codex/git/commits/f1affbac5e5164b2bae825e9b39e9868bc4e0be2","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTcohCRC1aQ7uu5UhlAAAQ0EQABatETGrohdpMvg4FSWBusXA\n4JWJL6W/ypU/9psDJUBavgeAjm7Oq0EEL/AzzGIbz1PWvT+tUsMtkGtm2X0BF6Vu\nfTbdr1FYDo4WXW1OrKGuFAqcVVvL9MN38g8o3gmoygMUmeCYExJJ9/FmzFdDB4Hu\n9+fdkS/dNeLAnCbLSyvv/CETQjUEZb4Fgwi0ySBK9eqFk97bETukcYeJGAM72SbO\nAh2MABnU5zC8RN8AjSPGgCRRXcMf8K0t0Fhv/SWPRtBQnZTYinRc58MFqsXhRvJS\njMobbZJHfb1jN+FZkiHB3YWKMCaMUAWsj9aqSEoSkoW1FkxEDShGBJmqx/Aw6bx2\njkpHP/o8R9MrJBIEB1MO/vypXwxmJcxptNFfOe/alqx4KbiXK1eBlheBRSrjreg4\nF3N37Dk/CK13iUgs6dGR2UcNY+4Y68Y7CugUQf1dBxoNblFwIzVvT7PyPLPQRFB9\nFnpvzQa0bSNHS4NlSkYWn8abrf9owpKxdx1JlNR0Lz3oO1ycuhhXWBm1sceysdn6\nn9ZOpfwK0uV0WM69auQpRBAHJ7S6Xq9wt+Wnf60eeizma2k6B+zVYeruReR0NumY\n4U8pqHfr037KWFnQuTzeE6/NZbsMRc+oAiukWkld7E2c0k4K5bE350QjjkQpgNXN\nZWW3LYZA/EoDSSDEMNno\n=CLYo\n-----END PGP SIGNATURE-----\n","payload":"tree ec47a055f1061eadb6e119022a30a1a17a9b1451\nparent aaa30f79c23e1c11a58394ff6edf1617d470c030\nauthor Owen Lin <owenlin0@gmail.com> 1783482913 -0700\ncommitter GitHub <noreply@github.com> 1783482913 +0000\n\ncore: support extension-owned turn items (#31283)\n\n## Description\n\nThis PR adds a `codex-extension-items` crate for extension-owned\n`TurnItem` schemas, and updates standalone image generation to start\nusing it via `TurnItem::Extension`.\n\nThis gives us a way to prevent Core from having to be aware of all\nextension items. App-server still exposes the existing public\n`ThreadItem::ImageGeneration` shape, now by wrapping the same shared\n`image_generation::ImageGenerationItem` type.\n\nThe new `codex-extension-items` crate is necessary because the image gen\nextension item is used by:\n- `codex-image-generation-extension`, which produces it.\n- `codex-tools / core`, which carry it generically.\n- `codex-protocol`, which serializes it into lifecycle events and\nrollouts.\n- `app-server protocol`, which wraps it in public\n`ThreadItem::ImageGeneration`\n\n```\nextension implementation\n        ↓\ncodex-extension-items\n        ↓\nprotocol / tools / app-server\n```\n\nWe keep the hosted Responses API image generation as\n`TurnItem::ImageGeneration` because core still owns its persistence and\nlegacy fanout.\n\n### Before\n\nStandalone image generation is implemented as an extension, but its item\nrepresentation previously lived in the core protocol. This sets the\nprecedent that core is aware of all extension items, which would be good\nto avoid.\n\n```\nimage-gen extension\n→ constructs codex_protocol::ImageGenerationItem\n→ emits ExtensionTurnItem::ImageGeneration\n→ core matches ImageGeneration specially\n→ protocol stores TurnItem::ImageGeneration\n```\n\n### After\n```\nimage-gen extension\n→ constructs extension-owned ImageGenerationItem\n→ emits generic ExtensionItem\n→ core transports/persists it generically\n→ app-server wraps ImageGenerationItem as ThreadItem::ImageGeneration\n```\n\nFuture extension items can have typed app-server APIs without adding a\nnew `TurnItem` variant, `ExtensionTurnItem` variant, or core emitter\nmatch arm.\n\n## What changed\n\n- Added `codex-extension-items` with the closed `ExtensionItem` enum and\nshared `image_generation::ImageGenerationItem` schema.\n- Added generic `TurnItem::Extension(ExtensionItem)` and\n`ExtensionTurnItem::Extension { item, legacy_events }` paths.\n- Updated standalone image generation to emit a typed extension item and\nprovide its existing legacy `ImageGenerationBegin` /\n`ImageGenerationEnd` events explicitly.\n- Kept canonical lifecycle ordering: core emits `ItemStarted` /\n`ItemCompleted` before extension-provided legacy events.\n\n## Follow-up\n\nStandalone web search still uses its typed special-case path. Migrating\nit later would let `ExtensionTurnItem` collapse into a single\nextension-item struct.","verified_at":"2026-07-08T03:55:14Z"}},"url":"https://api.github.com/repos/openai/codex/commits/f1affbac5e5164b2bae825e9b39e9868bc4e0be2","html_url":"https://github.com/openai/codex/commit/f1affbac5e5164b2bae825e9b39e9868bc4e0be2","comments_url":"https://api.github.com/repos/openai/codex/commits/f1affbac5e5164b2bae825e9b39e9868bc4e0be2/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"aaa30f79c23e1c11a58394ff6edf1617d470c030","url":"https://api.github.com/repos/openai/codex/commits/aaa30f79c23e1c11a58394ff6edf1617d470c030","html_url":"https://github.com/openai/codex/commit/aaa30f79c23e1c11a58394ff6edf1617d470c030"}]},{"sha":"aaa30f79c23e1c11a58394ff6edf1617d470c030","node_id":"C_kwDOOYsS4doAKGFhYTMwZjc5YzIzZTFjMTFhNTgzOTRmZjZlZGYxNjE3ZDQ3MGMwMzA","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-07-08T01:12:49Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T01:12:49Z"},"message":"ci: run V8 source builds on Windows 2025 (#31356)\n\n## Why\n\nThe V8 Windows source jobs need a runner image that can support the\nlater Dev Drive setup.\n\n## What\n\nMove the two V8 Windows source-build matrix entries from `windows-2022`\nto `windows-2025`.\nNamespace the canary source-build cache by runner image so it cannot\nrestore Windows 2022 native outputs.\n\n## Manual validation\n\n- Ran `just fmt`.\n- Ran `just test-github-scripts` (33 tests).\n- Parsed GitHub Actions YAML with `yq`.\n- Ran `git diff --check`.\n\n## Stack\n\n- [#31332](https://github.com/openai/codex/pull/31332) — parameterize\nCargo target paths\n- [#31356](https://github.com/openai/codex/pull/31356) — Windows 2025\nrunner bump\n- [#31357](https://github.com/openai/codex/pull/31357) — Dev Drive I/O\nrouting","tree":{"sha":"4c627d08b6ac66cd9d79a5cb36009039e11882e5","url":"https://api.github.com/repos/openai/codex/git/trees/4c627d08b6ac66cd9d79a5cb36009039e11882e5"},"url":"https://api.github.com/repos/openai/codex/git/commits/aaa30f79c23e1c11a58394ff6edf1617d470c030","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTaQRCRC1aQ7uu5UhlAAABKMQAAAq57HXhZkmccfK8NpsipCX\n67icQyQYGDwuDs347j5gbgzdtnA86/Y69ES0UKglmiNRcgJW4sGihuO+4BJNFGx/\nGoCF8+R9zoXregOW6Mcp7alFDWMsOsYNLomIOZ6W2066BCxIKbOjrgD72odj7ptG\nIk/0SalXgzCt9bY8OtTzLxxUAQE7LmQQZtt0AwV/2YuZ9wo/0mZgM5w+ox++kiFL\nX5N1Pf8QavKc54HR25+fYk/T/y7d7S6MMAN1UtHdA7RcH0PPWHaU2G/lTWEIj9FF\nEmYdVSQ2FQ4oea7a5T3YQcoex5N6ajS65U0I1rmhrbnF8Ong77hac+v4J441+Q6x\npLWwKoAQyRcM0J85xqfm64vHpEwysZyMYAPjvrB/RNrHVUbLgf1KtOJiybeB9NPu\nxhnNzPFBEpj60c0mVPsKrQvKeteMGZXR/hTq86+UDbYF9NZaET6OXR3oj2ESo55O\nfdRkE/Ru3YNeB+QkEnJQYiEbhoNVmdHrW1TVxHgyaUe/c3yzbCzroYKrndBnWJGu\n0zs032mARfTb4iKwrqxJaHaJQy2OYfEAdwouY1AWqyREEQaYxFRqyLTqsTAeMgTh\n+NHv48TyUqrWoGv6AGICWpRv7jJOcSyDsxTanYBZhUuiGvyYC/O1dQsMoTyo8Nuh\n5KuQTOTA160uyTw0Dmpq\n=+Iav\n-----END PGP SIGNATURE-----\n","payload":"tree 4c627d08b6ac66cd9d79a5cb36009039e11882e5\nparent f8d07b564155a1b79527edde285307e9a1bc434b\nauthor Adam Perry @ OpenAI <anp@openai.com> 1783473169 -0700\ncommitter GitHub <noreply@github.com> 1783473169 -0700\n\nci: run V8 source builds on Windows 2025 (#31356)\n\n## Why\n\nThe V8 Windows source jobs need a runner image that can support the\nlater Dev Drive setup.\n\n## What\n\nMove the two V8 Windows source-build matrix entries from `windows-2022`\nto `windows-2025`.\nNamespace the canary source-build cache by runner image so it cannot\nrestore Windows 2022 native outputs.\n\n## Manual validation\n\n- Ran `just fmt`.\n- Ran `just test-github-scripts` (33 tests).\n- Parsed GitHub Actions YAML with `yq`.\n- Ran `git diff --check`.\n\n## Stack\n\n- [#31332](https://github.com/openai/codex/pull/31332) — parameterize\nCargo target paths\n- [#31356](https://github.com/openai/codex/pull/31356) — Windows 2025\nrunner bump\n- [#31357](https://github.com/openai/codex/pull/31357) — Dev Drive I/O\nrouting","verified_at":"2026-07-08T01:12:50Z"}},"url":"https://api.github.com/repos/openai/codex/commits/aaa30f79c23e1c11a58394ff6edf1617d470c030","html_url":"https://github.com/openai/codex/commit/aaa30f79c23e1c11a58394ff6edf1617d470c030","comments_url":"https://api.github.com/repos/openai/codex/commits/aaa30f79c23e1c11a58394ff6edf1617d470c030/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f8d07b564155a1b79527edde285307e9a1bc434b","url":"https://api.github.com/repos/openai/codex/commits/f8d07b564155a1b79527edde285307e9a1bc434b","html_url":"https://github.com/openai/codex/commit/f8d07b564155a1b79527edde285307e9a1bc434b"}]},{"sha":"f8d07b564155a1b79527edde285307e9a1bc434b","node_id":"C_kwDOOYsS4doAKGY4ZDA3YjU2NDE1NWExYjc5NTI3ZWRkZTI4NTMwN2U5YTFiYzQzNGI","commit":{"author":{"name":"Tom","email":"wiltzius@openai.com","date":"2026-07-08T01:00:35Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T01:00:35Z"},"message":"trace hook command execution (#31501)\n\nAdds a single trace span around configured hook command execution so\nslow installed hooks are visible directly in traces.\n\nThe span records low-cardinality hook metadata and command outcome\nwithout command text, hook input, stdout, or stderr.","tree":{"sha":"00c8cbe14804f177f01f150a872dc260dd4de786","url":"https://api.github.com/repos/openai/codex/git/trees/00c8cbe14804f177f01f150a872dc260dd4de786"},"url":"https://api.github.com/repos/openai/codex/git/commits/f8d07b564155a1b79527edde285307e9a1bc434b","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTaEzCRC1aQ7uu5UhlAAASoUQAGBbM3t7PV/R9Gjjq1DbGNhV\nIkpQMELhVYYtW8NO5zMnFnHMWYwsSHi5MLu+b0zggfU00ZZc/0qt6j45O8BU8E0V\n9PcOxKSCS2z1mGtZ8xyaf+RR402xUxw7jFOjwmu8Vv9rrlWeCVHRQQAcZ4hfX6XU\nzgsG1SDKGpO4isdUymqX7tZdH7EKUYBaNoXVQyWE4qDm2MwA6kHwWEagUvYafhk5\naRP7p4uqoMszL/bIlFqhUnVjAbNvO912Od3IVY/QhmoXGIA67n0KSMdFAzAqZOiU\nmRJbyij7e2SiwtGRzeyY8wxVOElVrOiUMbSTMF22YpxbNLi2IsV7b+SW9ARkzo2T\nalOWMggOKPqDKX/jtZLNqcyHi45bRMU1fyLNbr0EqMwwQ1KFGFS/JIzlk1zxunNM\nzZHY/PA73up8ybcphPzyMnYwdVWcv0Mm+zmYq8/AFYLpeemIUZuVdDYyCeLtGh9T\nSRAF4ykwvQh0YdGVXkSpC6mr2Bvl/f98i1HyBR3KLdc4ioLT13iiIID52BIVG3oG\njf8viirGtnAuXMpWEhsNKALnKgrNPIcC79yyHYDT2rsufpLo3ADJqrp6bsaiX3sg\nOK5bldqZYh5uWDLcDG3H/FLUamkhtYXOKdNBeVNngEmA03iuoj7y6Ohp8jyrsCDx\nnXI8Nio6/iblGeQ+H736\n=3Nc8\n-----END PGP SIGNATURE-----\n","payload":"tree 00c8cbe14804f177f01f150a872dc260dd4de786\nparent 8784de445e6fbbf8c192ac6a7f2ae97209dc610f\nauthor Tom <wiltzius@openai.com> 1783472435 -0700\ncommitter GitHub <noreply@github.com> 1783472435 -0700\n\ntrace hook command execution (#31501)\n\nAdds a single trace span around configured hook command execution so\nslow installed hooks are visible directly in traces.\n\nThe span records low-cardinality hook metadata and command outcome\nwithout command text, hook input, stdout, or stderr.","verified_at":"2026-07-08T01:00:36Z"}},"url":"https://api.github.com/repos/openai/codex/commits/f8d07b564155a1b79527edde285307e9a1bc434b","html_url":"https://github.com/openai/codex/commit/f8d07b564155a1b79527edde285307e9a1bc434b","comments_url":"https://api.github.com/repos/openai/codex/commits/f8d07b564155a1b79527edde285307e9a1bc434b/comments","author":{"login":"wiltzius-openai","id":176426546,"node_id":"U_kgDOCoQOMg","avatar_url":"https://avatars.githubusercontent.com/u/176426546?v=4","gravatar_id":"","url":"https://api.github.com/users/wiltzius-openai","html_url":"https://github.com/wiltzius-openai","followers_url":"https://api.github.com/users/wiltzius-openai/followers","following_url":"https://api.github.com/users/wiltzius-openai/following{/other_user}","gists_url":"https://api.github.com/users/wiltzius-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/wiltzius-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wiltzius-openai/subscriptions","organizations_url":"https://api.github.com/users/wiltzius-openai/orgs","repos_url":"https://api.github.com/users/wiltzius-openai/repos","events_url":"https://api.github.com/users/wiltzius-openai/events{/privacy}","received_events_url":"https://api.github.com/users/wiltzius-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"8784de445e6fbbf8c192ac6a7f2ae97209dc610f","url":"https://api.github.com/repos/openai/codex/commits/8784de445e6fbbf8c192ac6a7f2ae97209dc610f","html_url":"https://github.com/openai/codex/commit/8784de445e6fbbf8c192ac6a7f2ae97209dc610f"}]},{"sha":"8784de445e6fbbf8c192ac6a7f2ae97209dc610f","node_id":"C_kwDOOYsS4doAKDg3ODRkZTQ0NWU2ZmJiZjhjMTkyYWM2YTdmMmFlOTcyMDlkYzYxMGY","commit":{"author":{"name":"lt-oai","email":"lt@openai.com","date":"2026-07-08T00:43:19Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-08T00:43:19Z"},"message":"[codex] Add externally provided Codex auth (#31274)\n\n## Summary\n\nAdd an in-memory externally provided Codex auth snapshot with explicit\nruntime capabilities, installed through the existing `ExternalAuth`\nprovider path.\n\n## Testing\n\n- `just fmt-check`\n- `cargo test -p codex-login --lib externally_provided_auth`\n- `cargo test -p codex-core --lib\nexternal_auth_snapshot_is_installed_from_runtime_config`\n- `cargo test -p codex-model-provider --lib external_auth`\n- `cargo test -p codex-mcp-extension --test hosted_apps_mcp\nhosted_apps_mcp_accepts_external_provided_codex_auth`\n- `cargo check -p codex-app-server -p codex-core-api -p\ncodex-thread-manager-sample`\n\n---------\n\nCo-authored-by: pakrym-oai <pakrym@openai.com>","tree":{"sha":"6e8b6fa7ba5e5df2d40ad9421bb9fdac894dbbff","url":"https://api.github.com/repos/openai/codex/git/trees/6e8b6fa7ba5e5df2d40ad9421bb9fdac894dbbff"},"url":"https://api.github.com/repos/openai/codex/git/commits/8784de445e6fbbf8c192ac6a7f2ae97209dc610f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqTZ0nCRC1aQ7uu5UhlAAADkMQAFD9VwQXacptxfwll4jeyY3N\nv69fbhI1rvgAIZHFm19unVJb3nBE2MLq/3+WXOgx//0V42phBqngKPm3JxOHh5yr\nHVeczAjPnX9I7E0bQ+hhl4mrUwVGUDs/78ubfoeRuTnaUoC53VtUo4I4QuzZ30An\nTPlF9uAhvpVD4s2+RdfFkTpIjGiLFlihXEOUSg4fLdKFO2lHT6ziWKlAKbSUYwNf\nfHrJJ/MtNEoXksHRIfJhgfNXBk5WurIGfAy3mV0p2Pmo844ungl15tnV4knBEVMe\nMd3TsegRRj9+S4EtSK64gwBKnrhuTP5k40aToih9hgfqHgDPhjm49Ikvdwg9KAmc\n0Ycl6ted8YSx+leeSIbkmawGo0UDEno4Bjm2cCisfw2PFD+JzWJWFs7SrTsnsfSS\nKcBdvZm69OlCKHBHE2Qjog7Tpygsq4xVrZA0dJVnsDNzoE6I2oIJWBhqvRjy3V/2\nz8JWcldyCtJ7ewaaWOSbGj0vUepPAEcCkbHk2TlhMPkO4zczPV9l3jztYo3BC0rw\nL2sjc+j8fZZLnaBspqkWEt5z9FOFDow7BhBY80KE+D/SdTWxKF7AyrfIJFlJ/6f5\nhPIuCvR90nFWZy6bRxddkP6ymONFNOkcahDhzdytKU64qNeJCJKZkyTl11zFRzKb\n11jfN1oHTc3S086dc+hW\n=i5eq\n-----END PGP SIGNATURE-----\n","payload":"tree 6e8b6fa7ba5e5df2d40ad9421bb9fdac894dbbff\nparent dbd2df27d10810b27e1828d0b3d4ab89643eac77\nauthor lt-oai <lt@openai.com> 1783471399 -0700\ncommitter GitHub <noreply@github.com> 1783471399 -0700\n\n[codex] Add externally provided Codex auth (#31274)\n\n## Summary\n\nAdd an in-memory externally provided Codex auth snapshot with explicit\nruntime capabilities, installed through the existing `ExternalAuth`\nprovider path.\n\n## Testing\n\n- `just fmt-check`\n- `cargo test -p codex-login --lib externally_provided_auth`\n- `cargo test -p codex-core --lib\nexternal_auth_snapshot_is_installed_from_runtime_config`\n- `cargo test -p codex-model-provider --lib external_auth`\n- `cargo test -p codex-mcp-extension --test hosted_apps_mcp\nhosted_apps_mcp_accepts_external_provided_codex_auth`\n- `cargo check -p codex-app-server -p codex-core-api -p\ncodex-thread-manager-sample`\n\n---------\n\nCo-authored-by: pakrym-oai <pakrym@openai.com>","verifi