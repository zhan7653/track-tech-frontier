/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"94461821d8d7e1ef1f1cd29bc0212c731c195ae5","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/94461821d8d7e1ef1f1cd29bc0212c731c195ae5","html_url":"https://github.com/langchain-ai/deepagents/commit/94461821d8d7e1ef1f1cd29bc0212c731c195ae5"}]},{"sha":"94461821d8d7e1ef1f1cd29bc0212c731c195ae5","node_id":"C_kwDOPTymldoAKDk0NDYxODIxZDhkN2UxZWYxZjFjZDI5YmMwMjEyYzczMWMxOTVhZTU","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-08-20T15:20:40Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-20T15:20:40Z"},"message":"feat(code): replace Gemini 3.6 Flash with 3.7 Flash (#5681)\n\nGemini 3.7 Flash now replaces Gemini 3.6 Flash in dcode's main and Auto\nclassifier recommendations.\n\n---\n\nThis keeps the recommended lists current across Google GenAI and\nOpenRouter while preserving older model references that still test\nsupported behavior.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/921fcded-2035-5cb6-8059-68cc709d501a)\n\nSigned-off-by: Mason Daugherty <mason@langchain.dev>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"4cba9e45e540e45c165a9a4d0a444c77b7a36da2","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/4cba9e45e540e45c165a9a4d0a444c77b7a36da2"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/94461821d8d7e1ef1f1cd29bc0212c731c195ae5","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqhxtICRC1aQ7uu5UhlAAAJE0QAGjYFCJ0OyeBUKdSTCDYLWCE\ntQt8P8BzMzSNovqhKC1IEt9rq5Z