ers/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"31eb71254314e7f0a7bfd6ca64f1185e9b7d588f","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/31eb71254314e7f0a7bfd6ca64f1185e9b7d588f","html_url":"https://github.com/langchain-ai/deepagents/commit/31eb71254314e7f0a7bfd6ca64f1185e9b7d588f"}]},{"sha":"31eb71254314e7f0a7bfd6ca64f1185e9b7d588f","node_id":"C_kwDOPTymldoAKDMxZWI3MTI1NDMxNGU3ZjBhN2JmZDZjYTY0ZjExODVlOWI3ZDU4OGY","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-08-18T21:56:49Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-18T21:56:49Z"},"message":"fix(infra): stabilize OpenWiki updates (#5614)\n\nOpenWiki now runs on current versions without unconfigured LangSmith\ntracing, and generated documentation updates preserve the repository's\ncustom workflow.\n\n---\n\nThe workflow uses OpenWiki 0.3.3 and Node.js 26; its GitHub Actions were\nalready at their latest releases. `LANGSMITH_TRACING` disables trace\nuploads, while restoring the tracked workflow keeps generated commits\nlimited to docs and agent guidance.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/ba52484f-1462-5bca-840f-be89a83fd97d)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"fbd1c22dfd91988bab1688ec55affe9816f7c525","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/fbd1c22dfd91988bab1688ec55affe9816f7c525"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/31eb71254314e7f0a7bfd6ca64f1185e9b7d588f","comment_c