/langchain-ai/deepagents/commit/b669f37fb08998cfbf983da76f57822215614e7b"}]},{"sha":"b669f37fb08998cfbf983da76f57822215614e7b","node_id":"C_kwDOPTymldoAKGI2NjlmMzdmYjA4OTk4Y2ZiZjk4M2RhNzZmNTc4MjIyMTU2MTRlN2I","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T18:16:14Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T18:16:14Z"},"message":"feat(code): show last update check time in `dcode doctor` (#4307)\n\nThe Updates section of `dcode doctor` reported status but not *when* the\nlast PyPI update check happened. This adds a \"Last checked\" item (e.g.\n`2h ago`, or `never`), read from the offline cache so the command stays\nnetwork-free.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/5810207b-bdbb-6bee-54cf-3b4bcf31a3e4)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"41448970618d8fc32549ddf1d82339bd956ab908","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/41448970618d8fc32549ddf1d82339bd956ab908"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/b669f37fb08998cfbf983da76f57822215614e7b","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPsHuCRC1aQ7uu5UhlAAAprsQADXwqHvEkAq+yXrifSzQVs//\nisUMZ8Szy2O+HX7ANz9vyFC743sbSnddpXOS76Yi2DIoQ/gwkUgQwB2OrYCgoc49\nFpGPLjWYrGYBspKphzGPLlwoDRFvIr84UCvHrd8tL4zBC4cerCG46K7jUGx0UXar\n/4CA3SdrnmuUZllUHp2zP3sGZ/AbiH6/YA3k+38q7p8dqk9EVf6QqbysXdEZJLX+\nAaqUvzzu71/QdyOwdkgyNKEIPcPOGHbbPuMjnkXpRX4fqCAds8fEzgMZIchu5N9W\nMA7VzoSEewE0JWCkDv4mVxrFsoTWJWeDGh/bZ/tvcAu6FehUKqQnR3jq5gcmVAga\n8AbFJ+x1+LQh7iN+RGb9zBos4rTc35MCppTHS/6T/U8O+c+xv10dUuQWqcqF46dw\n2X91pd+zqlwwPLDmjelJEXygmSP2cVCKUNz8f8Rs4aKbAXMJTs377V+LrZE1M+IR\nIzn5XY3ENifyFw6LzIhyDgCx+Lrc1rQiljC1TmP8vkTLevKxirwOcY59hVb2rZxj\nOkC0kUSA4JySrq0Fz+BZlRXI6WVUgtkpwwNevx0azo3LSACyxAPHFWeUijWPV1XK\nYRhpDm9n2hP/Pcks4Tvmmf+DhD2ae4b9N78N0sw2BifTUy