hain.dev>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","verified_at":"2026-07-14T03:22:33Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/2678b1680d8928e72e8efae00632a694c9b2737a","html_url":"https://github.com/langchain-ai/deepagents/commit/2678b1680d8928e72e8efae00632a694c9b2737a","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/2678b1680d8928e72e8efae00632a694c9b2737a/comments","author":{"login":"jacoblee93","id":6952323,"node_id":"MDQ6VXNlcjY5NTIzMjM=","avatar_url":"https://avatars.githubusercontent.com/u/6952323?v=4","gravatar_id":"","url":"https://api.github.com/users/jacoblee93","html_url":"https://github.com/jacoblee93","followers_url":"https://api.github.com/users/jacoblee93/followers","following_url":"https://api.github.com/users/jacoblee93/following{/other_user}","gists_url":"https://api.github.com/users/jacoblee93/gists{/gist_id}","starred_url":"https://api.github.com/users/jacoblee93/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jacoblee93/subscriptions","organizations_url":"https://api.github.com/users/jacoblee93/orgs","repos_url":"https://api.github.com/users/jacoblee93/repos","events_url":"https://api.github.com/users/jacoblee93/events{/privacy}","received_events_url":"https://api.github.com/users/jacoblee93/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"65230df6f91d2bbe5f83d4d938da6bfac52363a1","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/65230df6f91d2bbe5f83d4d938da6bfac52363a1","html_url":"https://github.com/langchain-ai/deepagents/commit/65230df6f91d2bbe5f83d4d938da6bfac52363a1"}]},{"sha":"65230df6f91d2bbe5f83d4d938da6bfac52363a1","node_id":"C_kwDOPTymldoAKDY1MjMwZGY2ZjkxZDJiYmU1ZjgzZDRkOTM4ZGE2YmZhYzUyMzYzYTE","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-14T03:01:41Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-14T03:01:41Z"},"message":"feat(sdk): support surrounding lines in filesystem grep results (#4706)\n\nCloses #3109\n\nThank you to @i-anubhav-anand for taking an initial stab at this!\n\n`FilesystemBackend.grep()` and `FilesystemBackend.agrep()` now accept an\noptional keyword-only `context_lines` argument for direct callers that\nneed surrounding lines in content-formatted search results.\n\nThis PR intentionally does not expose `context_lines` through the\nagent-facing `grep` tool yet. Doing so would require adding it to\n`BackendProtocol` and forwarding it through every backend, potentially\nbreaking custom backend implementations. The narrower API is intended to\nunblock experimentation in applications such as Deep Agents Code while\nwe determine whether broader usage justifies that protocol-level change.\n\nUsers can experiment today by passing a custom `FilesystemBackend` to\n`create_deep_agent(backend=...)` that applies a nonzero `context_lines`\nvalue by default. If the model should control the value,\n[#4251](https://github.com/langchain-ai/deepagents/pull/4251) allows\napplications to replace the built-in `FilesystemMiddleware`: pass a\ncustom middleware instance with the same `.name` through\n`create_deep_agent(middleware=[...])`, expose `context_lines` in its\n`grep` schema, and delegate to `FilesystemBackend.grep(...,\ncontext_lines=...)`.\n\n---\n\nDirect callers of the local `FilesystemBackend` currently receive only\nmatching lines from `grep`, which often requires a separate file read to\nunderstand the surrounding code. This adds a keyword-only\n`context_lines` option to the concrete synchronous and asynchronous\nmethods so callers can request nearby lines in the same search.\n\nThe default remains `0`, preserving the existing result shape and\navoiding context reads. When enabled, matching lines retain the existing\n`:` marker, context lines use `-`, overlapping windows are merged, and\nseparate groups are divided by `--`. File-only and count output continue\nto operate on actual matches rather than context lines.\n\nThis is intentionally a local-backend API rather than a new agent\ncapability: the model-facing grep tool and schema, `BackendProtocol`,\n`CompositeBackend`, and other backends remain unchanged.","tree":{"sha":"6ce1cf32620cf4445551db7e339d606256b47469","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/6ce1cf32620cf4445551db7e339d606256b47469"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/65230df6f91d2bbe5f83d4d938da6bfac52363a1","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqVaaVCRC1aQ7uu5UhlAAAbhkQAIPUcVlEDn6jddA8BtrX2o2l\nFP0iexX/VMKBrun/oY5ADzYMYnGj9J6fOig3TSLnQKMwS6q6BO6r4GGeubvj77pH\njSEl8wspof45vGhJ1r1JOLlfiEhXFivtNBWH99euQDAl3kQLGzIUp8i0mFZRkqfq\nM7BDRbOBkPdDrRBgV++T0trvDzWArLLaXP9kaCwkSkGkQzRtWHckJwEnaSrPW+/A\nDrIa2emBocySUfd6zGmAJIcg01O570SkLWmmO7kuFCujvfHauOWlgFQCyIkTAHYt\n4rDl+KNvBXaPsXVmTeTDpfZZ72rDaLfd8dsMzvn49jtzY1/duNGQgDUhd/RLbguI\nW/OA66EGGROr49LkZu2Pmz4KYCsTeoiT3FVUHuBtW3t8fxo5LBj4PXwP0pt1AiKe\nRG7egM0O1rE+Al7YwtP30DUYCW9+i2BH9CaU2fzkSe8WgEY1YAij+YcBcjqQlr7d\nE+FUpH46LgIdRx0jtMh/2uo1KWJyB69lgtyJf4Ymca14Aei2Gn1quff4PLNAqfJ4\nWQjFjGIgkeMBhLQOHARf7e2ua+2w8YcnpXLy7EqIjb9YI5Wq4CbpWOYakL/6HO9t\nHKYYVSM6it2DmK8kzrILAbAS0MJclnWk6JL9/b00bhFpYFZTDSAcrEn438z/AwI4\n4SeFj3TNA+iQX7svYX8T\n=KAEB\n-----END PGP SIGNATURE-----\n","payload":"tree 6ce1cf32620cf4445551db7e339d606256b47469\nparent 2f7d2671c1ff3978d525d190cbcc4f726fcbfbdc\nauthor Mason Daugherty <mason@langchain.dev> 1783998101 -0400\ncommitter GitHub <noreply@github.com> 1783998101 -0400\n\nfeat(sdk): support surrounding lines in filesystem grep results (#4706)\n\nCloses #3109\n\nThank you to @i-anubhav-anand for taking an initial stab at this!\n\n`FilesystemBackend.grep()` and `FilesystemBackend.agrep()` now accept an\noptional keyword-only `context_lines` argument for direct callers that\nneed surrounding lines in content-formatted search results.\n\nThis PR intentionally does not expose `context_lines` through the\nagent-facing `grep` tool yet. Doing so would require adding it to\n`BackendProtocol` and forwarding it through every backend, potentially\nbreaking custom backend implementations. The narrower API is intended to\nunblock experimentation in applications such as Deep Agents Code while\nwe determine whether broader usage justifies that protocol-level change.\n\nUsers can experiment today by passing a custom `FilesystemBackend` to\n`create_deep_agent(backend=...)` that applies a nonzero `context_lines`\nvalue by default. If the model should control the value,\n[#4251](https://github.com/langchain-ai/deepagents/pull/4251) allows\napplications to replace the built-in `FilesystemMiddleware`: pass a\ncustom middleware instance with the same `.name` through\n`create_deep_agent(middleware=[...])`, expose `context_lines` in its\n`grep` schema, and delegate to `FilesystemBackend.grep(...,\ncontext_lines=...)`.\n\n---\n\nDirect callers of the local `FilesystemBackend` currently receive only\nmatching lines from `grep`, which often requires a separate file read to\nunderstand the surrounding code. This adds a keyword-only\n`context_lines` option to the concrete synchronous and asynchronous\nmethods so callers can request nearby lines in the same search.\n\nThe default remains `0`, preserving the existing result shape and\navoiding context reads. When enabled, matching lines retain the existing\n`:` marker, context lines use `-`, overlapping windows are merged, and\nseparate groups are divided by `--`. File-only and count output continue\nto operate on actual matches rather than context lines.\n\nThis is intentionally a local-backend API rather than a new agent\ncapability: the model-facing grep tool and schema, `BackendProtocol`,\n`CompositeBackend`, and other backends remain unchanged.","verified_at":"2026-07-14T03:01:42Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/65230df6f91d2bbe5f83d4d938da6bfac52363a1","html_url":"https://github.com/langchain-ai/deepagents/commit/65230df6f91d2bbe5f83d4d938da6bfac52363a1","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/65230df6f91d2bbe5f83d4d938da6bfac52363a1/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"2f7d2671c1ff3978d525d190cbcc4f726fcbfbdc","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/2f7d2671c1ff3978d525d190cbcc4f726fcbfbdc","html_url":"https://github.com/langchain-ai/deepagents/commit/2f7d2671c1ff3978d525d190cbcc4f726fcbfbdc"}]},{"sha":"2f7d2671c1ff3978d525d190cbcc4f726fcbfbdc","node_id":"C_kwDOPTymldoAKDJmN2QyNjcxYzFmZjM5NzhkNTI1ZDE5MGNiY2M0ZjcyNmZjYmZiZGM","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-14T02:51:22Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-14T02:51:22Z"},"message":"style(code): simplify `/clear` resume hint to `/threads -r` (#4709)\n\nThe `/clear` resume hint is now the concise `Resume it with /threads\n-r`, without the redundant explicit-thread-id example.\n\n---\n\nAfter `/clear` surfaces the abandoned thread, the resume hint spelled\nout both the bare command and an explicit thread-id form. Since\n`/threads -r` already resumes the most recent thread, the parenthetical\nexample was redundant noise. This drops it so the hint reads simply\n`Resume it with /threads -r`.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/dad33b85-0cb8-dd94-ddb4-40640f611bf0)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"aef810c608624767804a84ef39f01a5bb19a2a7c","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/aef810c608624767804a84ef39f01a5bb19a2a7c"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/2f7d2671c1ff3978d525d190cbcc4f726fcbfbdc","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqVaQqCRC1aQ7uu5UhlAAAeiMQABEPnrWXsesdR4+UszBUtBsc\nTFfS7ZwNqLod/sglS9tN676IufQRZ0/tbfv2+zkDm8Uu4ulebd60Yxt/BVZId4S6\n1Kxr8b6HPOygj05Sj0Vn139gZxDwPa3amBPu+p1ZUNlw2qSC4ji8Z1r78pw9mkU9\nf/kMdciT6xQpqP4nJ+MlzQYROPfg1lKgi4otPVdUyyspNTpljJ6OXZFkx794ngz/\nEQjkLraToLxe9gwgAKjxLo/JKBeisk07164++ruLnGPGIOnnsjXLPWFfkQBwZIKN\n1RGRm9jlv8+A/O+nfHQ5PSq4sg7WKSm5hTAoP/vm4sqywm3D8UHvqN7y8J8/BEhF\n1w5oCICem690pcPc/yyFdiK8k6Fee7fZQ5QId74a0lssvRfHyajcrfZhKXLAp12U\nIpoD7nRBhJka3i50Nj7XYkmDxxyVlqdPgLomH198gtIleDxJy00Ph+19EeKA9XYU\nGQefZDhdU9Z0HH05rn37YqYpxFvZ99ITcUD0JpUNOxV2If904ESOP6rIPkJEl6Kt\n+d04DsZvCsWLtjMJceahMJwOab/rS68oYO4mq9Vo554cH9F7CTgXhKnNW5t4AWhj\ngGWioQiXKjKC1hHFu0m4ytgT1tYqd3XM5IQXjxmgqQchevl2Ew1iuY/nfvStQeP1\nt/bf03TlWcU0i872rzVe\n=q1VB\n-----END PGP SIGNATURE-----\n","payload":"tree aef810c608624767804a84ef39f01a5bb19a2a7c\nparent 1d549d3f3c9bb60c3ce39d4a0c913bcefe9610d5\nauthor Mason Daugherty <mason@langchain.dev> 1783997482 -0400\ncommitter GitHub <noreply@github.com> 1783997482 -0400\n\nstyle(code): simplify `/clear` resume hint to `/threads -r` (#4709)\n\nThe `/clear` resume hint is now the concise `Resume it with /threads\n-r`, without the redundant explicit-thread-id example.\n\n---\n\nAfter `/clear` surfaces the abandoned thread, the resume hint spelled\nout both the bare command and an explicit thread-id form. Since\n`/threads -r` already resumes the most recent thread, the parenthetical\nexample was redundant noise. This drops it so the hint reads simply\n`Resume it with /threads -r`.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/dad33b85-0cb8-dd94-ddb4-40640f611bf0)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-07-14T02:51:23Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/2f7d2671c1ff3978d525d190cbcc4f726fcbfbdc","html_url":"https://github.com/langchain-ai/deepagents/commit/2f7d2671c1ff3978d525d190cbcc4f726fcbfbdc","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/2f7d2671c1ff3978d525d190cbcc4f726fcbfbdc/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"1d549d3f3c9bb60c3ce39d4a0c913bcefe9610d5","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/1d549d3f3c9bb60c3ce39d4a0c913bcefe9610d5","html_url":"https://github.com/langchain-ai/deepagents/commit/1d549d3f3c9bb60c3ce39d4a0c913bcefe9610d5"}]},{"sha":"1d549d3f3c9bb60c3ce39d4a0c913bcefe9610d5","node_id":"C_kwDOPTymldoAKDFkNTQ5ZDNmM2M5YmI2MGMzY2UzOWQ0YTBjOTEzYmNlZmU5NjEwZDU","commit":{"author":{"name":"Johannes du Plessis","email":"johannes@langchain.dev","date":"2026-07-14T01:52:00Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-14T01:52:00Z"},"message":"fix(code): keep TODO and edit tools expanded (#4704)\n\nTODO updates and file edits now remain expanded in the dcode TUI.\n\n---\n\nKeep `write_todos` and `edit_file` calls outside collapsed tool-group\nsummaries so their user-facing details remain visible in live and\nrestored transcripts.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/019f5d2e-6138-71e1-91e5-95ba16811dad)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","tree":{"sha":"724d254935c05a9f24f419bf2ec31f474ae6f1a0","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/724d254935c05a9f24f419bf2ec31f474ae6f1a0"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/1d549d3f3c9bb60c3ce39d4a0c913bcefe9610d5","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqVZZACRC1aQ7uu5UhlAAA/4UQAI2EsMv+ZwHdgmtKkAwFxW8T\nbpyN/dZAZGb5ua1e2K/7bHyeHPPN9QA35MQ9eWbhV/usEGOef6RpluKcaoLtb4rc\n09lNi2NabK0mPZCc7runn4rKl1vzxF8qt5tDxXhRp6XZ34gYomz8pP2jJOj3o6O4\nz99Q26xqxu1vkVhX7GnGE1/syRR5BZfHCG33eRl/AoeygCldAqpVkJMBRNNaDJq1\nbEyg70ye6/ol7QhpRU1rkgl6LUI++AOlt95DiXznlkOs2awp2AJKsMhFeS8LZ/rD\nAtxbidErskpt53Qi/l9RIiNBJKCCVQiJQ2QI4FsvARhE1ZswMvO2owa28OYU8Ebh\nCH0Zxxl19KVEwpFUnpkTjW8rmxPyi7uQsF8Wt9MCRlpOxMlGqxFB64rUj0l8q5kI\nzBuzz0WfyAOa5SRGBtlmFgG75GBE1Ie71g3EELTuSnObdP9r3lYgbI8P6gHv9NsY\nJB3kOrUkEI812fK19XQBGRVZQSzVOtdar376jGGqinM15EXGB3whDXF/Mpr1OAJ9\np02BOPvZKALyWsNybLjL/JRmrnxKwgA/5m3NzqyzTvPlrC1BQhNhpbqn0CNQS7ZA\nVTUK3BL2+jtzgt7D4XfDiWqhD8G8RR+RSJC5K+D9+4ILIiK06s0UF5g6cnZra4mg\nxdJ7npKkueF3oYxhmoRV\n=IqDG\n-----END PGP SIGNATURE-----\n","payload":"tree 724d254935c05a9f24f419bf2ec31f474ae6f1a0\nparent 55b60ca08da4eef294ac3c162610b2a151584ea5\nauthor Johannes du Plessis <johannes@langchain.dev> 1783993920 -0700\ncommitter GitHub <noreply@github.com> 1783993920 -0400\n\nfix(code): keep TODO and edit tools expanded (#4704)\n\nTODO updates and file edits now remain expanded in the dcode TUI.\n\n---\n\nKeep `write_todos` and `edit_file` calls outside collapsed tool-group\nsummaries so their user-facing details remain visible in live and\nrestored transcripts.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/019f5d2e-6138-71e1-91e5-95ba16811dad)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","verified_at":"2026-07-14T01:52:00Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/1d549d3f3c9bb60c3ce39d4a0c913bcefe9610d5","html_url":"https://github.com/langchain-ai/deepagents/commit/1d549d3f3c9bb60c3ce39d4a0c913bcefe9610d5","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/1d549d3f3c9bb60c3ce39d4a0c913bcefe9610d5/comments","author":{"login":"johannes117","id":51395795,"node_id":"MDQ6VXNlcjUxMzk1Nzk1","avatar_url":"https://avatars.githubusercontent.com/u/51395795?v=4","gravatar_id":"","url":"https://api.github.com/users/johannes117","html_url":"https://github.com/johannes117","followers_url":"https://api.github.com/users/johannes117/followers","following_url":"https://api.github.com/users/johannes117/following{/other_user}","gists_url":"https://api.github.com/users/johannes117/gists{/gist_id}","starred_url":"https://api.github.com/users/johannes117/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/johannes117/subscriptions","organizations_url":"https://api.github.com/users/johannes117/orgs","repos_url":"https://api.github.com/users/johannes117/repos","events_url":"https://api.github.com/users/johannes117/events{/privacy}","received_events_url":"https://api.github.com/users/johannes117/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"55b60ca08da4eef294ac3c162610b2a151584ea5","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/55b60ca08da4eef294ac3c162610b2a151584ea5","html_url":"https://github.com/langchain-ai/deepagents/commit/55b60ca08da4eef294ac3c162610b2a151584ea5"}]},{"sha":"55b60ca08da4eef294ac3c162610b2a151584ea5","node_id":"C_kwDOPTymldoAKDU1YjYwY2EwOGRhNGVlZjI5NGFjM2MxNjI2MTBiMmExNTE1ODRlYTU","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-14T01:45:51Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-14T01:45:51Z"},"message":"feat(code): add `memory.auto_save` config flag (#4700)\n\n`deepagents-code` adds a `memory.auto_save` setting (env\n`DEEPAGENTS_CODE_MEMORY_AUTO_SAVE` / `[memory].auto_save`, default on).\nDisable it to keep loading memory into context while stopping the agent\nfrom automatically writing learnings back to your `AGENTS.md` files.\n\n---\n\nAutomatic memory saving in `deepagents-code` is prompt-driven:\n`MemoryMiddleware` injects guidance telling the agent to proactively\npersist learnings to the `AGENTS.md` sources. Until now the only switch\nwas `enable_memory`, which is all-or-nothing — turning it off also stops\nmemory from being loaded into context. This adds a way to keep loading\nmemory while turning the automatic saving off.\n\nA new `memory.auto_save` option (env `DEEPAGENTS_CODE_MEMORY_AUTO_SAVE`,\n`[memory].auto_save` in `config.toml`; defaults on) flips\n`MemoryMiddleware` to a read-only prompt when disabled. The read-only\nprompt keeps the trust/verification framing but drops the \"proactively\npersist learnings\" guidance, so memory still informs the agent and\nexplicit saves (e.g. the `remember` skill) keep working — only\nunprompted auto-saving stops.\n\nTo support this, the SDK gains a canonical\n`MEMORY_READONLY_SYSTEM_PROMPT`, exported from `deepagents.middleware`\nalongside `MEMORY_SYSTEM_PROMPT`.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/825df1d1-b8e0-91c3-f7f6-dac1fcdd5c5e)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"5e13bbc523725142429db15f55172cec5047b23d","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/5e13bbc523725142429db15f55172cec5047b23d"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/55b60ca08da4eef294ac3c162610b2a151584ea5","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqVZTPCRC1aQ7uu5UhlAAAOK8QAGByaoRTMxdMdZq8+wcEPpyC\naZF4yqiH2DJ9IvYLwExrefUuBX1EUXlpl1fXO5hjgkCVmyJM91bJhbsXFffB+yfO\nbQ7jUcLy8ri1+rD1sww86fWiazoklt+um/8meC+mUoEZVAxaFAylDTtD6PNb7AFI\nRDpqQHC3LrYNqWh+AGNKK1v6WPbAFpQkQW4z3da8/qyNG0vsTpiSA61F8jRIFpUc\nRN4BFe4IWLtUyULMZ7SfpA/M5j1e11ED84XrIjOaTAGb92BT7nuJ47da7w6qxTMj\nsyGJ7oJ4l5taf9QU/udf2lgiptRGXEhqXsemjYW5SuHHY3Czrlg0kIlqjLizn8UU\nFqgvvTkbSAP14d1qKudAExapHOVOK8uMBIoQhOTelvHzVQUn8yTQYU92Ejp5rbi8\nt6U52MwIqTZ7FceSd3qO99G5OayJ3tvtl6T2lYokE6/k0WhWYFNqzjuY7fFri7ot\nbd7RF+nUw2+is5aV/nodsJyZY/HvYXJVK9ipxojO3HyAOCwXhy/GxHO5F5pVbJ89\nr1Pu8T2z6dIKtdEOjG+OBVbjR/dQ02sHLWJ28ccwtUshHjbzykeyXuUnBEL4XMal\nWFmDcAk53S+veOSl9tlyTkiIkYhWCy4i2T0Ue+Gy/iv9INvmr6Pog7R81ySgpDcV\nV7XDkDLkg0IafZLua08T\n=xxkd\n-----END PGP SIGNATURE-----\n","payload":"tree 5e13bbc523725142429db15f55172cec5047b23d\nparent 22d50456324e9b8c0121a3a06787e19c1b88e1aa\nauthor Mason Daugherty <mason@langchain.dev> 1783993551 -0400\ncommitter GitHub <noreply@github.com> 1783993551 -0400\n\nfeat(code): add `memory.auto_save` config flag (#4700)\n\n`deepagents-code` adds a `memory.auto_save` setting (env\n`DEEPAGENTS_CODE_MEMORY_AUTO_SAVE` / `[memory].auto_save`, default on).\nDisable it to keep loading memory into context while stopping the agent\nfrom automatically writing learnings back to your `AGENTS.md` files.\n\n---\n\nAutomatic memory saving in `deepagents-code` is prompt-driven:\n`MemoryMiddleware` injects guidance telling the agent to proactively\npersist learnings to the `AGENTS.md` sources. Until now the only switch\nwas `enable_memory`, which is all-or-nothing — turning it off also stops\nmemory from being loaded into context. This adds a way to keep loading\nmemory while turning the automatic saving off.\n\nA new `memory.auto_save` option (env `DEEPAGENTS_CODE_MEMORY_AUTO_SAVE`,\n`[memory].auto_save` in `config.toml`; defaults on) flips\n`MemoryMiddleware` to a read-only prompt when disabled. The read-only\nprompt keeps the trust/verification framing but drops the \"proactively\npersist learnings\" guidance, so memory still informs the agent and\nexplicit saves (e.g. the `remember` skill) keep working — only\nunprompted auto-saving stops.\n\nTo support this, the SDK gains a canonical\n`MEMORY_READONLY_SYSTEM_PROMPT`, exported from `deepagents.middleware`\nalongside `MEMORY_SYSTEM_PROMPT`.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/825df1d1-b8e0-91c3-f7f6-dac1fcdd5c5e)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-07-14T01:45:52Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/55b60ca08da4eef294ac3c162610b2a151584ea5","html_url":"https://github.com/langchain-ai/deepagents/commit/55b60ca08da4eef294ac3c162610b2a151584ea5","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/55b60ca08da4eef294ac3c162610b2a151584ea5/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"22d50456324e9b8c0121a3a06787e19c1b88e1aa","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/22d50456324e9b8c0121a3a06787e19c1b88e1aa","html_url":"https://github.com/langchain-ai/deepagents/commit/22d50456324e9b8c0121a3a06787e19c1b88e1aa"}]},{"sha":"22d50456324e9b8c0121a3a06787e19c1b88e1aa","node_id":"C_kwDOPTymldoAKDIyZDUwNDU2MzI0ZTliOGMwMTIxYTNhMDY3ODdlMTljMWI4OGUxYWE","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-13T22:19:12Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-13T22:19:12Z"},"message":"feat(code): trace experimental mode in metadata (#4705)\n\nDeep Agents Code traces now include `dcode_experimental: true` when\n`DEEPAGENTS_CODE_EXPERIMENTAL` is enabled.\n\n---\n\n`DEEPAGENTS_CODE_EXPERIMENTAL` changes agent behavior, but traces\ncurrently do not record whether that mode was active. This adds\n`dcode_experimental: true` to trace-wide metadata whenever the\nenvironment flag resolves to a truthy value. The key remains absent\notherwise, so default trace metadata is unchanged.","tree":{"sha":"b7f063da5f714b2b861e35ad4b103ec3a3aa0a17","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/b7f063da5f714b2b861e35ad4b103ec3a3aa0a17"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/22d50456324e9b8c0121a3a06787e19c1b88e1aa","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqVWRgCRC1aQ7uu5UhlAAA64gQAKyYNiw3IlGkkBwEDclwwhoI\naz0BIY9Bp2J5+JtVGLebhVmLhpw2nBK6j/p4hM+uHf1gOjJf1bfF60XnIe+qeKbi\nWImeJLIdmiKtEo2ZWDs9f9sG2YPGva3ReH8FRbfr/ChupEx9dM6utOP8M5VMXV6I\nL6VLlS1nVs8IuZsHclG6rRl6+XyFaeNKvXN81PPMC4TsXGdIBUlrZh09jjC+z4a7\nS/Zo0qkB3ICSffCt+1YgyeGpipH/WW/L9ueADknJEJnB1vz2CsCYUSNMyidRakVW\nK7tZIt5VgNbtaA7G9R7ZuF9IX15gZJmY6eaaTD7L5yXRifMUUIMeUuBVFMIUjKED\nYDn4IzpQnCMZjGTpPAXizmZH67PTIYtx8d4gOFzB97YWDICEVrY3VGExs0OxKdDB\n2iuqXoqa4ezCoJubYOv7DN0sTrUMQ0Py+RF9HVFfvNxGaVeTzKlxyz5dILRtmBJb\nwmCSZR+roYBPRMxWJ6vmW01srxgi5zKubxhEPySFg+GQYAW5kjcqDqQvPgvDnYqf\njHdxd30Nz41DHACPKvN1NW0tivtnrf6RWM8iNaf761Qg04o0B/egKsnP7ATK6oXj\n4GbF14Lai0+ifysR+494oa36+jmhscr/NPUfbzmwSp6i8L9jWNpZxB3KwY5yJUHx\nnJRsk4DrqDzZdCxCN9L6\n=u9si\n-----END PGP SIGNATURE-----\n","payload":"tree b7f063da5f714b2b861e35ad4b103ec3a3aa0a17\nparent f77eeb0a036281f84bf7d0b05ea60e02630f55c1\nauthor Mason Daugherty <mason@langchain.dev> 1783981152 -0400\ncommitter GitHub <noreply@github.com> 1783981152 -0400\n\nfeat(code): trace experimental mode in metadata (#4705)\n\nDeep Agents Code traces now include `dcode_experimental: true` when\n`DEEPAGENTS_CODE_EXPERIMENTAL` is enabled.\n\n---\n\n`DEEPAGENTS_CODE_EXPERIMENTAL` changes agent behavior, but traces\ncurrently do not record whether that mode was active. This adds\n`dcode_experimental: true` to trace-wide metadata whenever the\nenvironment flag resolves to a truthy value. The key remains absent\notherwise, so default trace metadata is unchanged.","verified_at":"2026-07-13T22:19:13Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/22d50456324e9b8c0121a3a06787e19c1b88e1aa","html_url":"https://github.com/langchain-ai/deepagents/commit/22d50456324e9b8c0121a3a06787e19c1b88e1aa","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/22d50456324e9b8c0121a3a06787e19c1b88e1aa/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f77eeb0a036281f84bf7d0b05ea60e02630f55c1","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/f77eeb0a036281f84bf7d0b05ea60e02630f55c1","html_url":"https://github.com/langchain-ai/deepagents/commit/f77eeb0a036281f84bf7d0b05ea60e02630f55c1"}]},{"sha":"f77eeb0a036281f84bf7d0b05ea60e02630f55c1","node_id":"C_kwDOPTymldoAKGY3N2VlYjBhMDM2MjgxZjg0YmY3ZDBiMDVlYTYwZTAyNjMwZjU1YzE","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-13T21:18:51Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-13T21:18:51Z"},"message":"fix(code): hydrate virtualized transcript on scroll offset changes (#4646)\n\nFollow-up to #4549 (transcript virtualization).\n\nFixed older messages failing to load when scrolling up long\nconversations in `dcode` with a trackpad, mouse wheel, or keyboard.\n\n---\n\nScrolling up a long `dcode` thread with a trackpad (or wheel/keyboard)\nnever loaded older messages — the viewport parked in the blank top\nspacer. Transcript virtualization triggered hydration only from\napp-level `on_scroll_up`/`on_scroll_down` handlers bound to\n`textual.scrollbar`'s `ScrollUp`/`ScrollDown` messages. Those messages\nnever fire for wheel/trackpad/keyboard scrolling (which scroll via\n`MouseScroll*` events), and for scrollbar-track clicks they are\n`bubble=False` and consumed by the `_ChatScroll` container's own handler\nbefore they can reach the app — so hydration effectively never ran on\nscroll.\n\nVerified against Textual 8.2.7: a wheel scroll and a scrollbar-track\naction both move `scroll_y` but invoke the app-level handler zero times.\n\nThis drives hydration off the actual scroll offset instead:\n`_ChatScroll` posts a `Scrolled` message from `watch_scroll_y`, and the\napp checks both hydration directions in `on_chat_scrolled`. That covers\nevery input device (wheel, trackpad, keyboard, scrollbar, programmatic)\nuniformly.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/0f94cbf2-4d61-e04a-9e7b-520902ec436d)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"e21e5c9f69a126e14693777ef5653bce75b22ed0","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/e21e5c9f69a126e14693777ef5653bce75b22ed0"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/f77eeb0a036281f84bf7d0b05ea60e02630f55c1","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqVVY7CRC1aQ7uu5UhlAAAM34QADXR7KO7scbvqeiX7uDVLb0J\nsnxm3PLkjdiq6o3n6SEVQxmZdOWmydgR+xkdM9oOx1uGhQ6BBJgRXBhxdgUldEr8\n0b8DyA6c0OrqwidjtjqFngyDbilHpzQHdFmyIqNpGi3iF4VDGZiXhIupn8P5CJ7P\nvMSBQPvBU1pZeIaNv2mxZhnCd9I/BQa4Kj+DQXINjTaKASX5nQbWxEcIK631e8hM\n+TZ+xZ4iTOd85D1NQvbZOKl1niUOHKVc5lF7uaiXuHzd9rTXYk1KcXm7EzQo6TRs\nv571j6Aosa7gLZWhX72bn0r0dXaw8AI3ToF1H5MvzIm15yyxQimta19nSj8+ipg/\n6B85vOGnxamZkscinzImEl0u7UMfK+19f+l/5ZQALDkw3aIDaxYUqKz0KFYZUFOx\nJk5TSHue0dEovghMohsdwgoaubb5wLJ4yibcZ76T0TiqP9/qBBZ3m+7gkBilCJJF\npLCFNuNXKsJ3ij4NPK1e3E7ZmxmnXXFopKDZp49aJ67tIbNWT0dvjPyFot9TKcn6\nMh/9H45zQW9bOt7G514zKBashq2CGsV4smfMSzQrNXmzQu+NRyjQSuonySE0p3xD\nq3TiPMVw29/2YYPvNWqOl7kFiFcOr33cZHSDxDLu9Kfy5C+wjT4LBOhn4KI6AuiX\nBmF3nl7BW1/uyx2AlbHf\n=5RLn\n-----END PGP SIGNATURE-----\n","payload":"tree e21e5c9f69a126e14693777ef5653bce75b22ed0\nparent d3a3077e8536696dcf4a9dcd8555e9c871562e74\nauthor Mason Daugherty <mason@langchain.dev> 1783977531 -0400\ncommitter GitHub <noreply@github.com> 1783977531 -0400\n\nfix(code): hydrate virtualized transcript on scroll offset changes (#4646)\n\nFollow-up to #4549 (transcript virtualization).\n\nFixed older messages failing to load when scrolling up long\nconversations in `dcode` with a trackpad, mouse wheel, or keyboard.\n\n---\n\nScrolling up a long `dcode` thread with a trackpad (or wheel/keyboard)\nnever loaded older messages — the viewport parked in the blank top\nspacer. Transcript virtualization triggered hydration only from\napp-level `on_scroll_up`/`on_scroll_down` handlers bound to\n`textual.scrollbar`'s `ScrollUp`/`ScrollDown` messages. Those messages\nnever fire for wheel/trackpad/keyboard scrolling (which scroll via\n`MouseScroll*` events), and for scrollbar-track clicks they are\n`bubble=False` and consumed by the `_ChatScroll` container's own handler\nbefore they can reach the app — so hydration effectively never ran on\nscroll.\n\nVerified against Textual 8.2.7: a wheel scroll and a scrollbar-track\naction both move `scroll_y` but invoke the app-level handler zero times.\n\nThis drives hydration off the actual scroll offset instead:\n`_ChatScroll` posts a `Scrolled` message from `watch_scroll_y`, and the\napp checks both hydration directions in `on_chat_scrolled`. That covers\nevery input device (wheel, trackpad, keyboard, scrollbar, programmatic)\nuniformly.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/0f94cbf2-4d61-e04a-9e7b-520902ec436d)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-07-13T21:18:51Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/f77eeb0a036281f84bf7d0b05ea60e02630f55c1","html_url":"https://github.com/langchain-ai/deepagents/commit/f77eeb0a036281f84bf7d0b05ea60e02630f55c1","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/f77eeb0a036281f84bf7d0b05ea60e02630f55c1/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"d3a3077e8536696dcf4a9dcd8555e9c871562e74","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/d3a3077e8536696dcf4a9dcd8555e9c871562e74","html_url":"https://github.com/langchain-ai/deepagents/commit/d3a3077e8536696dcf4a9dcd8555e9c871562e74"}]},{"sha":"d3a3077e8536696dcf4a9dcd8555e9c871562e74","node_id":"C_kwDOPTymldoAKGQzYTMwNzdlODUzNjY5NmRjZjRhOWRjZDg1NTVlOWM4NzE1NjJlNzQ","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-13T21:18:06Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-13T21:18:06Z"},"message":"feat(code): drop `TodoListMiddleware` (#4685)\n\ndcode no longer exposes the `write_todos` tool / todo-list middleware to\nthe agent or its subagents when `DEEPAGENTS_CODE_EXPERIMENTAL` is set.\n\n---\n\n`dcode` builds its agent with `create_deep_agent`, which always injects\nthe SDK's `TodoListMiddleware` (and its `write_todos` tool) and exposes\nno parameter to disable it. Because `create_deep_agent`'s\n`_apply_custom_middleware` merge replaces a default middleware in place\nwhen a caller middleware shares its `.name`, we add a tool-less no-op\nmiddleware named `TodoListMiddleware` and thread it into the main-agent\nand subagent middleware lists — so the real middleware (and\n`write_todos`) is dropped without any SDK change.\n\nThis is gated behind the new `DEEPAGENTS_CODE_EXPERIMENTAL` env var and\nis a no-op when unset, so default behavior is unchanged. Kept\nintentionally narrow: the todo prompt guidance and TUI rendering are\nleft in place (dead only when the flag is on).\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/c5e51661-6737-cd07-a93a-30847caeef06)\n\n## References\n- Plan:\nhttps://openswe.vercel.app/agents/c5e51661-6737-cd07-a93a-30847caeef06/plan\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"0677d5b9604aeb988d6348b1bb7fbc802cb93daa","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/0677d5b9604aeb988d6348b1bb7fbc802cb93daa"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/d3a3077e8536696dcf4a9dcd8555e9c871562e74","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqVVYOCRC1aQ7uu5UhlAAAxXYQAD1uHttQ+xw+zd7lLBCcLuW/\n2EvXUHzf8bHHBYd8SePbqUYnoubaSfXQsX0noEb0Sf4550LmznRv0vyxdmeLmnmL\nCFdhHfNYEYReSSGNwKlSSuz5zwK1Jv1NVyOBO4F+kiWuyAYuEK4IUOUYoskJqGE4\n4g74+0LH8Tg0XiQbwhycF4yTibpw+W/wTvJk4aaA/wCWmNqDwywTWY4BJdtjQZ6d\nuHacN9I5byJynHJhezq0PI5+jR7d+KmlRtayyu6mk2ncVSCjAhytxhdjmAEt1zM1\nDKYh81XteSXpYNYg/YJrcNN96gHmbTNklHboXwhi4+ir4RFAkZumGf0f3sLw78x0\nlnO0FemP16ZFnpKUopqYA/1L2HGYlr1F/SUHxEw/Yg/yjPdG9x/LG+NhVqDLzyP/\n8OqbtW3bWWDD5DiG/QXopb7Y4R/9pRmKGvfG/2MThV0ws/89wdhQuuvHPwCMOPba\neuAwlpGa7RlYKajuqDq2QEwvEnXlelti6fIenY3gPT2iLC3xblJrrDdyPtxMOOBl\nmtIlHPNMH/sdtPBz7WOZvRsJeyGVHZV7JV2eLkKu3IVbJWyjwL/2+S9fmpmAxHyX\nfJxUnOaHp3EQFxi2xyKpqYCfYVB6qjEd95zdpUGFdstJWEujIxZIxxr+2C93ilRd\nWgvYoLrr9aFgD0pEyTxO\n=62bV\n-----END PGP SIGNATURE-----\n","payload":"tree 0677d5b9604aeb988d6348b1bb7fbc802cb93daa\nparent 96fe71a3815e1020edeb3be1af70b0cadb85931c\nauthor Mason Daugherty <mason@langchain.dev> 1783977486 -0400\ncommitter GitHub <noreply@github.com> 1783977486 -0400\n\nfeat(code): drop `TodoListMiddleware` (#4685)\n\ndcode no longer exposes the `write_todos` tool / todo-list middleware to\nthe agent or its subagents when `DEEPAGENTS_CODE_EXPERIMENTAL` is set.\n\n---\n\n`dcode` builds its agent with `create_deep_agent`, which always injects\nthe SDK's `TodoListMiddleware` (and its `write_todos` tool) and exposes\nno parameter to disable it. Because `create_deep_agent`'s\n`_apply_custom_middleware` merge replaces a default middleware in place\nwhen a caller middleware shares its `.name`, we add a tool-less no-op\nmiddleware named `TodoListMiddleware` and thread it into the main-agent\nand subagent middleware lists — so the real middleware (and\n`write_todos`) is dropped without any SDK change.\n\nThis is gated behind the new `DEEPAGENTS_CODE_EXPERIMENTAL` env var and\nis a no-op when unset, so default behavior is unchanged. Kept\nintentionally narrow: the todo prompt guidance and TUI rendering are\nleft in place (dead only when the flag is on).\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/c5e51661-6737-cd07-a93a-30847caeef06)\n\n## References\n- Plan:\nhttps://openswe.vercel.app/agents/c5e51661-6737-cd07-a93a-30847caeef06/plan\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-07-13T21:18:07Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/d3a3077e8536696dcf4a9dcd8555e9c871562e74","html_url":"https://github.com/langchain-ai/deepagents/commit/d3a3077e8536696dcf4a9dcd8555e9c871562e74","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/d3a3077e8536696dcf4a9dcd8555e9c871562e74/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"96fe71a3815e1020edeb3be1af70b0cadb85931c","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/96fe71a3815e1020edeb3be1af70b0cadb85931c","html_url":"https://github.com/langchain-ai/deepagents/commit/96fe71a3815e1020edeb3be1af70b0cadb85931c"}]},{"sha":"96fe71a3815e1020edeb3be1af70b0cadb85931c","node_id":"C_kwDOPTymldoAKDk2ZmU3MWEzODE1ZTEwMjBlZGViM2JlMWFmNzBiMGNhZGI4NTkzMWM","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-13T20:39:35Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-13T20:39:35Z"},"message":"fix(code): preflight Ollama host reachability before discovery probe (#4702)\n\nDeep Agents Code no longer logs a misleading \"discovery failed\" error\nwhen Ollama is not running; it now detects the daemon's absence and\nskips discovery quietly.\n\n---\n\nWhen Ollama is not installed/running, model discovery probes\n`http://localhost:11434/api/tags`, and the refused connection surfaces\nas a misleading `Ollama model discovery failed ... Connection refused`\ndebug line. This adds a lightweight TCP presence preflight\n(`_ollama_host_reachable`) that runs before the HTTP probe: if nothing\nis listening, discovery is skipped quietly with an `Ollama daemon not\ndetected` debug line instead. The check is best-effort — any failure\n(refused, DNS error, timeout, blocked sockets under `pytest-socket`) is\ntreated as absent, and an unparseable host defers to the existing HTTP\nprobe.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/c3696bf2-ea9f-2932-0d07-4ce636b8f83e)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"fbee76bfedc1a0a187ab53871b83944140ea28b9","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/fbee76bfedc1a0a187ab53871b83944140ea28b9"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/96fe71a3815e1020edeb3be1af70b0cadb85931c","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqVU0HCRC1aQ7uu5UhlAAAABEQAEjStuhO4R5IFSUdaAI7Fb4K\n+Nm7RpCyDzf2UqV3WZbPT7lseygEYFy0CV5meyXhVa3/T/rrraVsY6OQVouGDh+s\n8AKDWF5ih5zU/E5/V9clfmYtDn1O0Pp0SlIh2ascEqSb1JACTto04SbWLBtjz1lx\nL0RybZDFJJaI2+qDbwIhcQHxNei2M5SByiX1XkGT3pm3Auuz5JbbVYpv24jTMhcg\nQeBjqOj0Dgq0YX7Kg0z5u88Q3SKjNw8o+ftlYepzFDk5k/Q7GQY95q4+Uga2sHcP\nPYEyEBeXj5N4yvKBa2A4NhKo93OIholWCIRW7s+zOMhQnVy+dxtLXDgj/WTQ8ieC\nYF5G/SAC0c0c/Uy0bLKVA0zc2BvyINZW7PFv+4go0E7gZXzesK5Gw8s5yS0HvWZy\n+QHt43UVcKvw+diwRWcuApceftR/gPi6DAKYbkc6msM+Cy3KBBRZ3C+JeG4SHzam\nOFwgc5S+63Wz1vIgTNGp8dura/w7oWZZkE1jyzkDnH92cyBp8sR/7a7rpgOs/+7I\n4u6YWudhluL+1NI3TfOKMIX1S+puAunAFoJBMBSqhIxoDmnUoA0i5HkETelTtoq0\nv9pLkXS7jJ11bKKBKu6q0CCa6mG7/VnEce8mHilOdNfW1+5TT+NOky0Kb5CyVDgO\nDC6s/ZXZP1HDXzyJusvs\n=70Q1\n-----END PGP SIGNATURE-----\n","payload":"tree fbee76bfedc1a0a187ab53871b83944140ea28b9\nparent 3d499db8a6c76743810a8983107d7c7d7bdb35e6\nauthor Mason Daugherty <mason@langchain.dev> 1783975175 -0400\ncommitter GitHub <noreply@github.com> 1783975175 -0400\n\nfix(code): preflight Ollama host reachability before discovery probe (#4702)\n\nDeep Agents Code no longer logs a misleading \"discovery failed\" error\nwhen Ollama is not running; it now detects the daemon's absence and\nskips discovery quietly.\n\n---\n\nWhen Ollama is not installed/running, model discovery probes\n`http://localhost:11434/api/tags`, and the refused connection surfaces\nas a misleading `Ollama model discovery failed ... Connection refused`\ndebug line. This adds a lightweight TCP presence preflight\n(`_ollama_host_reachable`) that runs before the HTTP probe: if nothing\nis listening, discovery is skipped quietly with an `Ollama daemon not\ndetected` debug line instead. The check is best-effort — any failure\n(refused, DNS error, timeout, blocked sockets under `pytest-socket`) is\ntreated as absent, and an unparseable host defers to the existing HTTP\nprobe.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/c3696bf2-ea9f-2932-0d07-4ce636b8f83e)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-07-13T20:39:35Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/96fe71a3815e1020edeb3be1af70b0cadb85931c","html_url":"https://github.com/langchain-ai/deepagents/commit/96fe71a3815e1020edeb3be1af70b0cadb85931c","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/96fe71a3815e1020edeb3be1af70b0cadb85931c/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"3d499db8a6c76743810a8983107d7c7d7bdb35e6","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/3d499db8a6c76743810a8983107d7c7d7bdb35e6","html_url":"https://github.com/langchain-ai/deepagents/commit/3d499db8a6c76743810a8983107d7c7d7bdb35e6"}]},{"sha":"3d499db8a6c76743810a8983107d7c7d7bdb35e6","node_id":"C_kwDOPTymldoAKDNkNDk5ZGI4YTZjNzY3NDM4MTBhODk4MzEwN2Q3YzdkN2JkYjM1ZTY","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-13T20:09:50Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-13T20:09:50Z"},"message":"fix(code): quiet expected non-repo `git ls-files` logging (#4701)\n\n`_run_git_ls_files()` in `autocomplete.py` logged a debug line on every\nnonzero exit, including the common non-repository case (exit 128) that\nintentionally falls back to a glob scan. It now detects that expected\ncase via the `not a git repository` stderr marker and stays quiet, while\ngenuine failures still log the root/cwd, arguments, exit code, and\nsanitized stderr for diagnosis. Existing autocomplete and fallback\nbehavior is unchanged.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/90872166-fc98-ed05-3159-3a945178096d)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"be30a11a54b09a3ebc19e63b74fd2246f94698c2","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/be30a11a54b09a3ebc19e63b74fd2246f94698c2"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/3d499db8a6c76743810a8983107d7c7d7bdb35e6","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqVUYOCRC1aQ7uu5UhlAAAYAMQAIl9j/okTMKIeYh9POiFRLna\nhW0VaOGdviPwnosg4EYBbp9wkNLeKMWwWQY9/IoHT9+Ibl08ZbUHmjQDxShDCJ5v\nE43yHZ9ZET8sltisO6nDsX0utJyi7EkLHQvTXGas/XmGZPwYWXN66hpP0pJe1KkF\nzWw2M6HVz/ZY+eautiEze9S55VUvo1H4lJKWGKIyY0NtMSCFIJlyBT3WydvjieFx\nYyPF8TBsF0BzQjfhq1z9O9PNsnAmEQDpgsr94L0+GqjhvZ14lG9TRoaGzMfFF4mK\n6BAum6AX/yDMtOj6yVzYYU2J9eG+BbMIewFtBkSjlyj4V6i0QxD3eE9SNQ4n/W0o\nmt/oidUFQgkMrr91W/XZxNL5QoxFPoo5uQx4lAeS4kDcDSiz4y2IHi5YwcdZqSqR\nrwnSPpIrLNo5LmrbQQkl+qxXcolOZg819qYs5aPJH4LTqOl5JSxNs1iHQEljP6sg\nKEKaVKQkcK+kvNUUYSb4A3dxWxKTG6Qw0mEmMVRBcfCB/Ql+T9o3+M/Y9n1V2sN/\noB6PdXs14wU/KopBZijDEbuy7JJuB07h6iXUl5Trck6tcoA+zay92xIhUqOjjSjd\nqaEJPJWGYeVOQY2EVA72782/iTwNVJzn6N1pHSrVHFOm02I1bTB4dyYRDVOMRJK9\nn4mtB24n44Cjip1SdADS\n=rYj1\n-----END PGP SIGNATURE-----\n","payload":"tree be30a11a54b09a3ebc19e63b74fd2246f94698c2\nparent b19d8cc618aa0e5b6fa18480bbe0b83bb5559664\nauthor Mason Daugherty <mason@langchain.dev> 1783973390 -0400\ncommitter GitHub <noreply@github.com> 1783973390 -0400\n\nfix(code): quiet expected non-repo `git ls-files` logging (#4701)\n\n`_run_git_ls_files()` in `autocomplete.py` logged a debug line on every\nnonzero exit, including the common non-repository case (exit 128) that\nintentionally falls back to a glob scan. It now detects that expected\ncase via the `not a git repository` stderr marker and stays quiet, while\ngenuine failures still log the root/cwd, arguments, exit code, and\nsanitized stderr for diagnosis. Existing autocomplete and fallback\nbehavior is unchanged.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/90872166-fc98-ed05-3159-3a945178096d)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-07-13T20:09:50Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/3d499db8a6c76743810a8983107d7c7d7bdb35e6","html_url":"https://github.com/langchain-ai/deepagents/commit/3d499db8a6c76743810a8983107d7c7d7bdb35e6","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/3d499db8a6c76743810a8983107d7c7d7bdb35e6/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b19d8cc618aa0e5b6fa18480bbe0b83bb5559664","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/b19d8cc618aa0e5b6fa18480bbe0b83bb5559664","html_url":"https://github.com/langchain-ai/deepagents/commit/b19d8cc618aa0e5b6fa18480bbe0b83bb5559664"}]},{"sha":"b19d8cc618aa0e5b6fa18480bbe0b83bb5559664","node_id":"C_kwDOPTymldoAKGIxOWQ4Y2M2MThhYTBlNWI2ZmExODQ4MGJiZTBiODNiYjU1NTk2NjQ","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-13T16:44:18Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-13T16:44:18Z"},"message":"test(infra): reduce release Git log fixture commits (#4692)\n\nA release-log boundary test creates 100 commits through separate `git\ncommit` subprocesses. A hosted runner failed partway through that setup\nwith exit 128, while the same job passed on adjacent runs.\n\nOverride the extracted workflow's `MAX_COMMITS` value to 3 in the two\nboundary tests. They still cover exactly-at-limit and one-past-limit\nbehavior, and the helper asserts that the production setting remains\n100, but setup now creates seven commits instead of 205.\n\nThe full workflow-helper suite passes with 434 tests, and the affected\ntests passed 20 consecutive runs.","tree":{"sha":"aa65f995f80ae7200fd2e079bbae7c4b00d99fa8","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/aa65f995f80ae7200fd2e079bbae7c4b00d99fa8"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/b19d8cc618aa0e5b6fa18480bbe0b83bb5559664","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqVRXiCRC1aQ7uu5UhlAAAoQsQAJb3zcTwL6/9xmAWaS8f0ccf\ntIl2GlevdCQ663E5WCikSSIZSQKExUAC5dPUfKpUueyc87N7m+6FyHwx1w9TgdVg\ngEWFjBLixc484sxlswwUqgvKGDkeC6UglKz2vMfJL3rSpPbE/iJPe37SMyxIJ3Hx\nqfZ9JmVwsZ3h/jfvZ2l+6W1RuGIzjblGkJpgQ4Em66IAZfD1vVNiyURMHjFNC4KQ\nAL34mHHaj6Xn2HDFu4pp1Gs3ZCZqtOq1kqahTSi9TcdYz4eFsydgkikzofTQnZIj\nqnyFwt1Bz5kWsQ3n3tCv0E6h9NLx600g9NoO1F3JxNEcEuLqrk671aF3bEos4N33\n+9e4AGAFC+Od/QRm+gm7DMyVfAyh/2WmScO8BX0HxK3YJWuPLqXbfWTKu/IKPU0V\nVcLZFS0bpdxaSG7YDjA8gJZ4yCeBACI6eGnDei0DSBNTw3eELYQlHJzLCVs17hWE\n267JAPrWxX0mdIFEwaOFB/N5Hm2c5Ouc+Nl65ha8Wx8mIsMTSpx63bI+B1cJQsMr\n0eaTUZySC19FnLWhYdg1iS8shhBLzTy6/qKKFv5RdUETWC8U8gYkAA53FW1QLWdr\nQ1jmIKhJl/OjjFkeY+Wh1xVV3CtYCJUqhmbN1who684YntjXTQHKJs3AKlyTYN1e\nwkkP78EXiEqAqux1u8FN\n=ezbO\n-----END PGP SIGNATURE-----\n","payload":"tree aa65f995f80ae7200fd2e079bbae7c4b00d99fa8\nparent dde69b96c3eb924bff9a1d6f3e8d699236423596\nauthor Mason Daugherty <mason@langchain.dev> 1783961058 -0400\ncommitter GitHub <noreply@github.com> 1783961058 -0400\n\ntest(infra): reduce release Git log fixture commits (#4692)\n\nA release-log boundary test creates 100 commits through separate `git\ncommit` subprocesses. A hosted runner failed partway through that setup\nwith exit 128, while the same job passed on adjacent runs.\n\nOverride the extracted workflow's `MAX_COMMITS` value to 3 in the two\nboundary tests. They still cover exactly-at-limit and one-past-limit\nbehavior, and the helper asserts that the production setting remains\n100, but setup now creates seven commits instead of 205.\n\nThe full workflow-helper suite passes with 434 tests, and the affected\ntests passed 20 consecutive runs.","verified_at":"2026-07-13T16:44:18Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/b19d8cc618aa0e5b6fa18480bbe0b83bb5559664","html_url":"https://github.com/langchain-ai/deepagents/commit/b19d8cc618aa0e5b6fa18480bbe0b83bb5559664","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/b19d8cc618aa0e5b6fa18480bbe0b83bb5559664/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"dde69b96c3eb924bff9a1d6f3e8d699236423596","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/dde69b96c3eb924bff9a1d6f3e8d699236423596","html_url":"https://github.com/langchain-ai/deepagents/commit/dde69b96c3eb924bff9a1d6f3e8d699236423596"}]},{"sha":"dde69b96c3eb924bff9a1d6f3e8d699236423596","node_id":"C_kwDOPTymldoAKGRkZTY5Yjk2YzNlYjkyNGJmZjlhMWQ2ZjNlOGQ2OTkyMzY0MjM1OTY","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-13T15:43:36Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-13T15:43:36Z"},"message":"feat(infra): close old pull requests automatically (#4688)\n\nOpen, non-draft pull requests are warned after fourteen days and\nautomatically closed after thirty days — measured from when the PR was\nopened, not last activity — unless they carry the `do-not-close` label.\n\n---\n\nThe existing cleanup only covered PRs opened by `app/open-swe`, warning\nafter seven inactive days and closing after fourteen. This broadens the\npolicy to all open, non-draft PRs and bases it on age since opening\nrather than recent activity.\n\n**Closing behavior**\n- A PR is only ever closed once it already carries a warning comment\nfrom this workflow, so every PR gets at least one warning cycle (~16\ndays) of notice. A PR already past thirty days that was never warned is\nwarned now and becomes eligible to close on a later run.\n- The marker comment must be authored by `github-actions[bot]`; a marker\nforged by a PR participant is ignored and can neither trigger nor block\na closure. Warnings are deduplicated across daily runs and upgraded in\nplace to the closing notice.\n\n**Failure handling**\n- An incomplete PR search, a non-transient error (auth/validation), or\nevery processed PR failing makes the run fail visibly.\n- Isolated transient errors (rate limits / 5xx on a single PR) are\nlogged but don't fail the run, since they self-heal on the next daily\nrun.\n\nThresholds, the bypass label, and the max-PRs cap are configurable;\nhitting the cap is surfaced with a warning.","tree":{"sha":"9d26956a6f82b91056a9311771b8c9363b4125ef","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/9d26956a6f82b91056a9311771b8c9363b4125ef"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/dde69b96c3eb924bff9a1d6f3e8d699236423596","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqVQeoCRC1aQ7uu5UhlAAAdRIQABMTBzQ84xK8yF74i5FM/Cfh\nchmUKTcSrsi6Z7UhNSu3O4U7kZDy0rZg/DfiN4GrDRgfcMWHgLnww8dAteMgH4km\nstzBDo3zH2RSSP8LVTZc8nPD4cte6aecs5OFKu+Cz3ijzE6vuYpsH/salYWjm3E8\nzf+uQ9ysF/bERgzUmKGrFJf/hJwSO+F9zlycyxNIYdh0CcZ/35HqL0ZIDZLeQwv0\nLD2GKubXDoxtVSxhmFC1Tro6J2Lv2C6feyvQvZkzucugQ41QCDEvxO3Vw+cID/hw\neD1nUmM83rhNbDQ2sFHVR0gXwSNv+JFTUZwCYZsH3iZZgjL8frU88QPXxeuq9vw8\nFSoeNt331G5Wam3ikDnhPQHyt5LuRMYeRjfp4nhffa6Ku9j3K/YcGl8i++qIxLji\nJF5CGL3oyy4wXaXwL5KgvJIm5fO0DF9nSKYXPN5cWuCIwlyq97CURlgY6ZSCPm18\nmSGD4Ij/pfAzelSkX7Lul44ORsBZWVv6V3o/K+WsM2naCDr8hIMsBdTW7QSE64De\nVcLnognn59Xl2Po29+ga7GxmMwdPOxpdszYoYU4bcDEqihfbsmXnzBQP7nOX2H3U\nR3S+3Z8ozbDJV0PXVZtzpnSbifj/iVYNvOhOeQW/tB5JLUtZxwRDBK2n2Ol1oFdH\nAlJTTZfE9h4wwbwCBlKT\n=Xv73\n-----END PGP SIGNATURE-----\n","payload":"tree 9d26956a6f82b91056a9311771b8c9363b4125ef\nparent def6369aed1a8dcb857db52285fa2e8976bdcd07\nauthor Mason Daugherty <mason@langchain.dev> 1783957416 -0400\ncommitter GitHub <noreply@github.com> 1783957416 -0400\n\nfeat(infra): close old pull requests automatically (#4688)\n\nOpen, non-draft pull requests are warned after fourteen days and\nautomatically closed after thirty days — measured from when the PR was\nopened, not last activity — unless they carry the `do-not-close` label.\n\n---\n\nThe existing cleanup only covered PRs opened by `app/open-swe`, warning\nafter seven inactive days and closing after fourteen. This broadens the\npolicy to all open, non-draft PRs and bases it on age since opening\nrather than recent activity.\n\n**Closing behavior**\n- A PR is only ever closed once it already carries a warning comment\nfrom this workflow, so every PR gets at least one warning cycle (~16\ndays) of notice. A PR already past thirty days that was never warned is\nwarned now and becomes eligible to close on a later run.\n- The marker comment must be authored by `github-actions[bot]`; a marker\nforged by a PR participant is ignored and can neither trigger nor block\na closure. Warnings are deduplicated across daily runs and upgraded in\nplace to the closing notice.\n\n**Failure handling**\n- An incomplete PR search, a non-transient error (auth/validation), or\nevery processed PR failing makes the run fail visibly.\n- Isolated transient errors (rate limits / 5xx on a single PR) are\nlogged but don't fail the run, since they self-heal on the next daily\nrun.\n\nThresholds, the bypass label, and the max-PRs cap are configurable;\nhitting the cap is surfaced with a warning.","verified_at":"2026-07-13T15:43:37Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/dde69b96c3eb924bff9a1d6f3e8d699236423596","html_url":"https://github.com/langchain-ai/deepagents/commit/dde69b96c3eb924bff9a1d6f3e8d699236423596","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/dde69b96c3eb924bff9a1d6f3e8d699236423596/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"def6369aed1a8dcb857db52285fa2e8976bdcd07","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/def6369aed1a8dcb857db52285fa2e8976bdcd07","html_url":"https://github.com/langchain-ai/deepagents/commit/def6369aed1a8dcb857db52285fa2e8976bdcd07"}]},{"sha":"def6369aed1a8dcb857db52285fa2e8976bdcd07","node_id":"C_kwDOPTymldoAKGRlZjYzNjlhZWQxYThkY2I4NTdkYjUyMjg1ZmEyZTg5NzZiZGNkMDc","commit":{"author":{"name":"github-actions[bot]","email":"41898282+github-actions[bot]@users.noreply.github.com","date":"2026-07-13T15:08:01Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-13T15:08:01Z"},"message":"release(deepagents-code): 0.1.37 (#4619)\n\n> [!CAUTION]\n> Merging this PR will automatically publish to **PyPI** and create a\n**GitHub release**.\n\nFor the full release process, see\n[`.github/RELEASING.md`](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md).\n\n---\n\n_Release notes preview: keep this section in sync with the package\n`CHANGELOG.md`. The published GitHub release body is extracted from the\nmerged `CHANGELOG.md` by `release.yml`, not from this PR description._\n\n---\n\n\n##\n[0.1.37](https://github.com/langchain-ai/deepagents/compare/deepagents-code==0.1.36...deepagents-code==0.1.37)\n(2026-07-13)\n\n### Features\n\n* Add Meta model provider\n([#4650](https://github.com/langchain-ai/deepagents/issues/4650))\n([70829c5](https://github.com/langchain-ai/deepagents/commit/70829c5846b6bdde1cee51f0f4929e819ba1026b))\n* Set `prompt_cache_key` for OpenAI models\n([#4632](https://github.com/langchain-ai/deepagents/issues/4632))\n([8cf57ac](https://github.com/langchain-ai/deepagents/commit/8cf57aca9f41c3c4ca6d9796dc2cb80d4b22fb6d))\n* Support Fireworks `/routers` model ids\n([#4591](https://github.com/langchain-ai/deepagents/issues/4591))\n([1c08d27](https://github.com/langchain-ai/deepagents/commit/1c08d2705f73f6870610849e00910b94458accf1))\n* `/model` Ctrl+N toggle for names vs raw specs\n([#4592](https://github.com/langchain-ai/deepagents/issues/4592))\n([518c322](https://github.com/langchain-ai/deepagents/commit/518c322e7dda840b5a740541afc895516a74925f))\n* `/tools` slash command\n([#4649](https://github.com/langchain-ai/deepagents/issues/4649))\n([b1600a8](https://github.com/langchain-ai/deepagents/commit/b1600a8da784899d9db5bdf93be07b4c7f53a46c))\n* Add `-s` alias for `--skill`\n([#4620](https://github.com/langchain-ai/deepagents/issues/4620))\n([c9b7ac2](https://github.com/langchain-ai/deepagents/commit/c9b7ac20752e4270d286b4af3fcf710e7e5bee87))\n* Configurable chat cursor style\n([#4687](https://github.com/langchain-ai/deepagents/issues/4687))\n([a22484b](https://github.com/langchain-ai/deepagents/commit/a22484ba2e001fd62fbff0fe916f1b3b93889fc3))\n* Expand environment variables in MCP config\n([#4681](https://github.com/langchain-ai/deepagents/issues/4681))\n([4f5d7be](https://github.com/langchain-ai/deepagents/commit/4f5d7be1b4073dee346e5a974841721646fa4860))\n* Hide diff widget for credential files\n([#4593](https://github.com/langchain-ai/deepagents/issues/4593))\n([4c49a24](https://github.com/langchain-ai/deepagents/commit/4c49a24c4c488f45859b45628cfa57719e52f596))\n* In-app Debug Console\n([#4564](https://github.com/langchain-ai/deepagents/issues/4564))\n([4f94a30](https://github.com/langchain-ai/deepagents/commit/4f94a30c11efb1819b08647d15b50b9b1e7bf043))\n* Offer abort in `/threads` cwd-switch prompt\n([#4583](https://github.com/langchain-ai/deepagents/issues/4583))\n([aaeac99](https://github.com/langchain-ai/deepagents/commit/aaeac99d9f17b6a55d663c21a4d063444b6a1870))\n* Resume threads in-TUI with `/threads -r [ID]`\n([#4609](https://github.com/langchain-ai/deepagents/issues/4609))\n([d442673](https://github.com/langchain-ai/deepagents/commit/d44267358e272553c8ece33d367514430be7c0da))\n* Show `(debug enabled)` on splash when `DEEPAGENTS_CODE_DEBUG` is set\n([#4584](https://github.com/langchain-ai/deepagents/issues/4584))\n([f10b877](https://github.com/langchain-ai/deepagents/commit/f10b877e5e48c3a1e15bd72d2ce06dfb16203231))\n\n### Bug Fixes\n\n* Avoid repeated startup auto-update stalls\n([#4648](https://github.com/langchain-ai/deepagents/issues/4648))\n([12a9c9d](https://github.com/langchain-ai/deepagents/commit/12a9c9d6813a83e5eeff9feed0c4068d1fcc69c4))\n* Infer Fireworks provider from qualified model IDs\n([#4594](https://github.com/langchain-ai/deepagents/issues/4594))\n([4d2aa8a](https://github.com/langchain-ai/deepagents/commit/4d2aa8a9684609eee45cd93b0af5149d8dd09eea))\n* Capture input typed before TUI startup\n([#4684](https://github.com/langchain-ai/deepagents/issues/4684))\n([ef9a4a8](https://github.com/langchain-ai/deepagents/commit/ef9a4a8770f4daec70e640d6d2f23dd798d4ede2))\n* Detach owned `langgraph dev` server from terminal\n([#4642](https://github.com/langchain-ai/deepagents/issues/4642))\n([d1f3afe](https://github.com/langchain-ai/deepagents/commit/d1f3afecdc015b5d1c9fb098d6347c7d7180e417))\n* Infer additional model providers\n([#4675](https://github.com/langchain-ai/deepagents/issues/4675))\n([4ceed24](https://github.com/langchain-ai/deepagents/commit/4ceed24d3758801ed9df1024602e90488004cef1))\n* Preserve `Ctrl+D` deletion in non-empty input\n([#4626](https://github.com/langchain-ai/deepagents/issues/4626))\n([306bd89](https://github.com/langchain-ai/deepagents/commit/306bd893f214237b6b4eede7c2ce0eaff66f5527))\n* Quit with `Ctrl+D` at end of prompt\n([#4678](https://github.com/langchain-ai/deepagents/issues/4678))\n([2f8c111](https://github.com/langchain-ai/deepagents/commit/2f8c11176f5cc9350c3337b2dfcf9f19886d5d02))\n* Reap langgraph dev server when startup is cancelled\n([#4629](https://github.com/langchain-ai/deepagents/issues/4629))\n([904ff05](https://github.com/langchain-ai/deepagents/commit/904ff05620a576100e05fd65810d38405c4942d4))\n* Reject `--auto-approve` in headless mode\n([#4617](https://github.com/langchain-ai/deepagents/issues/4617))\n([997be16](https://github.com/langchain-ai/deepagents/commit/997be1643aff6d6900b8b8c95832cdf93be8c0d7))\n* Route explicit `--stdin` + `--skill` to headless path\n([#4611](https://github.com/langchain-ai/deepagents/issues/4611))\n([724e24a](https://github.com/langchain-ai/deepagents/commit/724e24a31546e1f31feca3bb2344717550682595))\n* Skip Esc prompt-restore once output generation begins\n([#4582](https://github.com/langchain-ai/deepagents/issues/4582))\n([14f384f](https://github.com/langchain-ai/deepagents/commit/14f384fc0083c07a7f44f97543b40b74cf93c13f))\n* Remove misleading agent names from help\n([#4671](https://github.com/langchain-ai/deepagents/issues/4671))\n([ac15732](https://github.com/langchain-ai/deepagents/commit/ac1573281530c1564fe07f8a21608e4d4dec2c3b))\n* Support plain `exit` quit command\n([#4543](https://github.com/langchain-ai/deepagents/issues/4543))\n([e6f10a1](https://github.com/langchain-ai/deepagents/commit/e6f10a149051128677c9f6f37663922054a7ac26))\n* Sync `ask_user` active-question highlight with focus\n([#4599](https://github.com/langchain-ai/deepagents/issues/4599))\n([e4c29b5](https://github.com/langchain-ai/deepagents/commit/e4c29b5264413d23d8dc70cabae72feb5f3f3dcb))\n* Wrap MCP viewer navigation\n([#4677](https://github.com/langchain-ai/deepagents/issues/4677))\n([cffc732](https://github.com/langchain-ai/deepagents/commit/cffc73213bfdcec26cb82c413fa7e27db4afc0ca))\n\n### Performance Improvements\n\n* Load MCP servers concurrently during graph build\n([#4659](https://github.com/langchain-ai/deepagents/issues/4659))\n([c5345cc](https://github.com/langchain-ai/deepagents/commit/c5345cc04cd810c6238e42dfbfa14497ae1b9020))\n\n---\n\n_End release notes preview._\n\n---\n\n> [!NOTE]\n> A **New Contributors** section is appended to the GitHub release notes\nautomatically at publish time (see [Release\nPipeline](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md#release-pipeline),\nstep 2).\n\n---------\n\nCo-authored-by: github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","tree":{"sha":"365aeb9bc0977fc72c36c729cce3b42818e86117","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/365aeb9bc0977fc72c36c729cce3b42818e86117"},"url":"https://api.g