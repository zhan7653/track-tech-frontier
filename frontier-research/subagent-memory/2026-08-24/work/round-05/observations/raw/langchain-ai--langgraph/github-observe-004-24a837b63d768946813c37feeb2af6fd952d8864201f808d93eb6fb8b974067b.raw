ornl/gists{/gist_id}","starred_url":"https://api.github.com/users/eliornl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/eliornl/subscriptions","organizations_url":"https://api.github.com/users/eliornl/orgs","repos_url":"https://api.github.com/users/eliornl/repos","events_url":"https://api.github.com/users/eliornl/events{/privacy}","received_events_url":"https://api.github.com/users/eliornl/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"66ebe1a0da921e73f0f9f879ba105d314c079f7c","url":"https://api.github.com/repos/langchain-ai/langgraph/commits/66ebe1a0da921e73f0f9f879ba105d314c079f7c","html_url":"https://github.com/langchain-ai/langgraph/commit/66ebe1a0da921e73f0f9f879ba105d314c079f7c"}]},{"sha":"66ebe1a0da921e73f0f9f879ba105d314c079f7c","node_id":"C_kwDOKFU0ldoAKDY2ZWJlMWEwZGE5MjFlNzNmMGY5Zjg3OWJhMTA1ZDMxNGMwNzlmN2M","commit":{"author":{"name":"Elior Nataf Lackritz","email":"eliornataflackritz@gmail.com","date":"2026-07-30T17:52:16Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-30T17:52:16Z"},"message":"fix(checkpoint-postgres,checkpoint-sqlite): scope namespace matching to segment boundaries (#8478)\n\n## Summary\n\nNamespace scoping in the Postgres and SQLite stores matched the\ndot-joined prefix with `LIKE '<path>%'`, which does not respect the `.`\nseparator — a search scoped to `(\"foo\",)` also returned rows under\n`(\"foobar\",)`. Scoping now matches the namespace exactly or requires the\nseparator before any remainder, and pattern metacharacters in labels are\nescaped.\n\n`list_namespaces` moves to segment-aware matching for prefix and suffix\nconditions, since neither `LIKE` nor `GLOB` can express \"any character\nexcept the separator\".\n\nPer-package reasoning is in the commit message.\n\n## Compatibility\n\n`*` in a `list_namespaces` match path now spans exactly one segment,\nrestoring the documented behavior (`NamespacePath` documents `(\"cache\",\n\"*\", \"v1\")` as \"any cache category with v1 version\") and matching\n`InMemoryStore`. To match at any depth, combine both conditions, which\nare ANDed: `list_namespaces(prefix=[\"uid\"], suffix=[\"alice\"])`.\n\n## Test plan\n\n- [x] `make format` / `make lint` / `make test` from\n`libs/checkpoint-postgres` (224 passed) and `libs/checkpoint-sqlite`\n(112 passed, 3 skipped)","tree":{"sha":"503fa1824ab493872a86a975af5eb1f9be29f7eb","url":"https://api.github.com/repos/langchain-ai/langgraph/git/trees/503fa1824ab493872a86a975af5eb1f9be29f7eb"},"url":"https://api.github.com/repos/langchain-ai/langgraph/git/commits/66ebe1a0da921e73f0f9f879ba105d314c079f7c","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqa49QCRC1aQ7uu5UhlAAABDkQACKDc8lEP1L6wfN+fWNBFKJh\nLnpeuRxht0u3xOKQyUR613kGWcAjLVEREXrxP9d86/TCoE8CbaWREOC8FAauxRMI\nVQ5GUdHG0K+D2KXsSbp81dGlwDk/5vBNO9OXutG2hgpQ9V2erNjYjdzA+euowva+\nTmghhJB3yLX2mYtvIg8dF4vBwRmieoJoXij7Q/5CS0yGINrkGr67ot8lUxNMH/nd\nAsid18KhNOl6yoSS0Iw4QPXZGzOkg+Knpjy3Fl+GIDdH3e3QhZWcxYeF0yXHYhbD\nl2GmFMKuSjehYMKkeArvhRLci9Y/fqsO7klbROw4nc1XbWJAUPS0VdcIxyCn3LOw\nLkJDKnti6jJyWGJ7iNcXiDEPAQz90Rmqnqt3Mu7McCauGnjIlmOuwC7SatSRLkOZ\nCl3e8M78VMZa9dq09R6Mk8kUesyvZwveOFRyTl0JgaPbYM8A7tQ7XhzBdMwp17gO\nhXoKN89IHZLm6ruJi3PFbASJZqmRJpItFho2c0XKXH5EVM2mwL6syBAkfhR5N7P5\nEukdMjoS0lEtehoQKejV+YFn1wmN4h19V1Tx1yChsjXgtwVWX2vP1tKRz/MIs5mz\nxHLtdW9n1hBzFcuU7mZdFYR4foWWNDy8OId4UJayFA2oZXK46jGIfN9JwUnSFzil\nALLNRKqya3iwyNdlDYSo\n=Ep+k\n-----END PGP SIGNATURE-----\n","payload":"tree 503fa1824ab493872a86a975af5eb1f9be29f7eb\nparent 41341457342327166d72fc11952ab28fb61ec0bf\nauthor Elior Nataf Lackritz <eliornataflackritz@gmail.com> 1785433936 -0400\ncommitter GitHub <noreply@github.com> 1785433936 -0400\n\nfix(checkpoint-postgres,checkpoint-sqlite): scope namespace matching to segment boundaries (#8478)\n\n## Summary\n\nNamespace scoping in the Postgres and SQLite stores matched the\ndot-joined prefix with `LIKE '<path>%'`, which does not respect the `.`\nseparator — a search scoped to `(\"foo\",)` also returned rows under\n`(\"foobar\",)`. Scoping now matches the namespace exactly or requires the\nseparator before any remainder, and pattern metacharacters in labels are\nescaped.\n\n`list_namespaces` moves to segment-aware matching for prefix and suffix\nconditions, since neither `LIKE` nor `GLOB` can express \"any character\nexcept the separator\".\n\nPer-package reasoning is in the commit message.\n\n## Compatibility\n\n`*` in a `list_namespaces` match path now spans exactly one segment,\nrestoring the documented behavior (`NamespacePath` documents `(\"cache\",\n\"*\", \"v1\")` as \"any cache category with v1 version\") and matching\n`InMemoryStore`. To match at any depth, combine both conditions, which\nare ANDed: `list_namespaces(prefix=[\"uid\"], suffix=[\"alice\"])`.\n\n## Test plan\n\n- [x] `make format` / `make lint` / `make test` from\n`libs/checkpoint-postgres` (224 passed) and `libs/checkpoint-sqlite`\n(112 passed, 3 skipped)","verified_at":"2026-07-30T17:52:16Z"}},"url":"https://api.github.com/repos/langchain-ai/langgraph/commits/66ebe1a0da921e73f0f9f879ba105d314c079f7c","html_url":"https://github.com/langchain-ai/langgraph/commit/66ebe1a0da921e73f0f9f879ba105d314c079f7c","comments_url":"https://api.github.com/repos/langchain-ai/langgraph/commits/66ebe1a0da921e73f0f9f879ba105d314c079f7c/comments","author":{"login":"eliornl","id":170458692,"node_id":"U_kgDOCij-RA","avatar_url":"https://avatars.githubusercontent.com/u/170458692?v=4","gravatar_id":"","url":"https://api.github.com/users/eliornl","html_url":"https://github.com/eliornl","followers_url":"https://api.github.com/users/eliornl/followers","following_url":"https://api.github.com/users/eliornl/following{/other_user}","gists_url":"https://api.github.com/users/eliornl/gists{/gist_id}","starred_url":"https://api.github.com/users/eliornl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/eliornl/subscriptions","organizations_url":"https://api.github.com/users/eliornl/orgs","repos_url":"https://api.github.com/users/eliornl/repos","events_url":"https://api.github.com/users/eliornl/events{/privacy}","received_events_url":"https://api.github.com/users/eliornl/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"41341457342327166d72fc11952ab28fb61ec0bf","url":"https://api.github.com/repos/langchain-ai/langgraph/commits/41341457342327166d72fc11952ab28fb61ec0bf","html_url":"https://github.com/langchain-ai/langgraph/commit/41341457342327166d72fc11952ab28fb61ec0bf"}]},{"sha":"41341457342327166d72fc11952ab28fb61ec0bf","node_id":"C_kwDOKFU0ldoAKDQxMzQxNDU3MzQyMzI3MTY2ZDcyZmMxMTk1MmFiMjhmYjYxZWMwYmY","commit":{"author":{"name":"Saad Farooq","email":"saad@langchain.dev","date":"2026-07-28T14:49:37Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-28T14:49:37Z"},"message":"release(langgraph): 1.2.10 (#8462)\n\n## Summary\n\nReleases `langgraph` 1.2.10.\n\nBumps the package version `1.2.9` -> `1.2.10` and propagates it into the\n`langgraph`, `prebuilt`, and `sdk-py` lockfiles. No dependency floor or\nsource changes.\n\nPicks up the changes landed since 1.2.9: #8389 (typed v3 `stream_events`\nreturn and native projections), #8362 (`trace_policy` on `add_node`),\n#8402 and #8403 (`TracePolicy` tag drop, then revert).\n\n## Changes\n\n- Update `libs/langgraph/pyproject.toml` to version `1.2.10`.\n- Update the editable `langgraph` package entries in\n`libs/langgraph/uv.lock`, `libs/prebuilt/uv.lock`, and\n`libs/sdk-py/uv.lock`.","tree":{"sha":"35c771ce8cb4de0fdba638f8713d08321cb9cd64","url":"https://api.github.com/repos/langchain-ai/langgraph/git/trees/35c771ce8cb4de0fdba638f8713d08321cb9cd64"},"url":"https://api.github.com/repos/langchain-ai/langgraph/git/commits/41341457342327166d72fc11952ab28fb61ec0bf","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqaMGBCRC1aQ7uu5UhlAAAPw4QAExdePCmVvgtMcGgGH7MlEPw\njYzzygVJCY