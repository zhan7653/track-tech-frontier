57e301cbf15bbf","url":"https://api.github.com/repos/langchain-ai/langgraph/commits/9a27693c64d3a0d6847dfe1c3d57e301cbf15bbf","html_url":"https://github.com/langchain-ai/langgraph/commit/9a27693c64d3a0d6847dfe1c3d57e301cbf15bbf"}]},{"sha":"9a27693c64d3a0d6847dfe1c3d57e301cbf15bbf","node_id":"C_kwDOKFU0ldoAKDlhMjc2OTNjNjRkM2EwZDY4NDdkZmUxYzNkNTdlMzAxY2JmMTViYmY","commit":{"author":{"name":"Sydney Runkle","email":"54324534+sydney-runkle@users.noreply.github.com","date":"2026-06-30T00:06:10Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-30T00:06:10Z"},"message":"fix(langgraph): snapshot `DeltaChannel` overwrite supersteps (#8125)\n\nWhen a DeltaChannel receives an Overwrite, force that checkpoint to\nstore a snapshot so sparse replay starts from the post-overwrite value.\nThis also aligns live DeltaChannel overwrite handling with\nBinaryOperatorAggregate by letting Overwrite bypass other reducer writes\nin the same superstep.","tree":{"sha":"59960cf4b6712394f9171603fba3ca7024a96569","url":"https://api.github.com/repos/langchain-ai/langgraph/git/trees/59960cf4b6712394f9171603fba3ca7024a96569"},"url":"https://api.github.com/repos/langchain-ai/langgraph/git/commits/9a27693c64d3a0d6847dfe1c3d57e301cbf15bbf","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqQwhyCRC1aQ7uu5UhlAAA274QAIgrk7aZ2SlPAw+HYj9ehyOo\nzZ3yU88jdUtZ6eqKNYhIUN0VtP4ZN8EBGaFTYoNajxi9ypR1yaPZUXeKxnH9jki7\nljSQ7QUx++y7sqHKRmDQAJB6nEmA4TvCFUughBUdtsqEoq3Wy5jcQhY85dXLJVoO\nvlrVKebR3QQAj3Fpj28SmRIY+VJIC9WCGAkoDWoS+G9TL+seDEW5FW7BvvbsEzgM\nrOowe5NZ7ojF5Ws6NMsLzXFYyRXenVHjyFIRZ5wsOXiJe8HaxZc+MS7gg/bWF6Ib\npJK6LdMYcqhJyxm3K4jaiUZO/fnKIVzeeB00PlO/SExAUgeVhJ5MM0vu+elciFmJ\nXDsZB73eo9cROxPPE2NXixgSTvfxUuq42VN++B4kkcHhcJyCEjromMzBXNAgVXmQ\ndGlJQ65xVRWw7e/p2xElirhYKvlpUGEQcCOdmqIAf88Ovy7tzwC2X1ofE4ZKN0U/\nchQ4TbbjA2ODkSB+p9lcpaM23Do7K40buyWPY3lYCMVcLktlPCnWfKLnlXA+lqCn\n/Mymo3ItZD9GdFs6l2bD2HimOazSZc6T+WyRwS3mhDKQdU3OEqFubudgPOqQPSFR\nwUgwYK6eFiqi2GPquyYCLVnMzBEjI55wlffh56WGX+zXoLnyzTBbZc/MIiPjiLN5\nmfBazxxnGdyUSRmHNNZK\n=Oj1J\n-----END PGP SIGNATURE-----\n","payload":"tree 59960cf4b6712394f9171603fba3ca7024a96569\nparent 1b5ca0a1b1e1889879e43536fc5efd0739a3c479\nauthor Sydney Runkle <54324534+sydney-runkle@users.noreply.github.com> 1782777970 -0400\ncommitter GitHub <noreply@github.com> 1782777970 -0700\n\nfix(langgraph): snapshot `DeltaChannel` overwrite supersteps (#8125)\n\nWhen a DeltaChannel receives an Overwrite, force that checkpoint to\nstore a snapshot so sparse replay starts from the post-overwrite value.\nThis also aligns live DeltaChannel overwrite handling with\nBinaryOperatorAggregate by letting Overwrite bypass other reducer writes\nin the same superstep.","verified_at":"2026-06-30T00:06:11Z"}},"url":"https://api.github.com/repos/langchain-ai/langgraph/commits/9a27693c64d3a0d6847dfe1c3d57e301cbf15bbf","html_url":"https://github.com/langchain-ai/langgraph/commit/9a27693c64d3a0d6847dfe1c3d57e301cbf15bbf","comments_url":"https://api.github.com/repos/langchain-ai/langgraph/commits/9a27693c64d3a0d6847dfe1c3d57e301cbf15bbf/comments","author":{"login":"sydney-runkle","id":54324534,"node_id":"MDQ6VXNlcjU0MzI0NTM0","avatar_url":"https://avatars.githubusercontent.com/u/54324534?v=4","gravatar_id":"","url":"https://api.github.com/users/sydney-runkle","html_url":"https://github.com/sydney-runkle","followers_url":"https://api.github.com/users/sydney-runkle/followers","following_url":"https://api.github.com/users/sydney-runkle/following{/other_user}","gists_url":"https://api.github.com/users/sydney-runkle/gists{/gist_id}","starred_url":"https://api.github.com/users/sydney-runkle/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sydney-runkle/subscriptions","organizations_url":"https://api.github.com/users/sydney-runkle/orgs","repos_url":"https://api.github.com/users/sydney-runkle/repos","events_url":"https://api.github.com/users/sydney-runkle/events{/privacy}","received_events_url":"https://api.github.com/users/sydney-runkle/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"1b5ca0a1b1e1889879e43536fc5efd0739a3c479","url":"https://api.github.com/repos/langchain-ai/langgraph/commits/1b5ca0a1b1e1889879e43536fc5efd0739a3c479","html_url":"https://github.com/langchain-ai/langgraph/commit/1b5ca0a1b1e1889879e43536fc5efd0739a3c479"}]},{"sha":"1b5ca0a1b1e1889879e43536fc5efd0739a3c479","node_id":"C_kwDOKFU0ldoAKDFiNWNhMGExYjFlMTg4OTg3OWU0MzUzNmZjNWVmZDA3MzlhM2M0Nzk","commit":{"author":{"name":"Sydney Runkle","email":"54324534+sydney-runkle@users.noreply.github.com","date":"2026-06-30T00:02:08Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-30T00:02:08Z"},"message":"fix(langgraph): Make `Overwrite` survive JSON roundtrips (#8127)\n\nAdd a `type: Literal[\"__overwrite__\"]` discriminator field to\n`Overwrite` and teach `_get_overwrite()` to recognise the\ndataclass-erased `{\"value\": ..., \"type\": \"__overwrite__\"}` form. This\nkeeps `Overwrite` semantics intact across JSON boundaries that strip\ndataclass types (e.g. `langgraph-api.serde.json_dumpb`), without\nrequiring callers to switch to the dict sentinel form.\n\nThis was an oversight in the initial `Overwrite` implementation, it\nshould be json serializable out of the box.\n\nFixing langchain-ai/deepagents#3789","tree":{"sha":"5e13bf5b298d5f6c2e7e1b518d7fcf4b5583e90b","url":"https://api.github.com/repos/langchain-ai/langgraph/git/trees/5e13bf5b298d5f6c2e7e1b518d7fcf4b5583e90b"},"url":"https://api.github.com/repos/langchain-ai/langgraph/git/commits/1b5ca0a1b1e1889879e43536fc5efd0739a3c479","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqQweACRC1aQ7uu5UhlAAAUBgQABbpZbHLRzAD+FMgV/6CIbrd\nNwN2KftmKbGxAUXX1ZMXDGstot0WGq4Uz6ukvu2OG2Y6Ls4CYapu6fH0DK8yS6TM\naBJY32iDD0CTiKT5NXUrr5RxP34YXi6J7wBqOZ34J2jvXVUxcwHQQfJlBlS1QZPf\np5V2WANyFXH2J1PVFu15U7bB8vMMw0zzPSdPWjnefnHLjfeMWoou90D/SFq2l+dl\nkxZMcVYVL8bcO8C04ESw0P3pUYsSxImH+8+9Xi/FXmkpaiZyQXULDpGEi1xtJlYA\nqEZVhzjtUBgpg+die0ntumC945UfoLCJ/EY9UL/ASId0cEPunR/aCvX+2CsHvBx/\n/QzIzFGMhkI/T6XBcvUCpbaK2980J6twLOrkAgv/lT0H86YLFN5KEIuf/fOJXqni\n8/H5Dkfzxl4o8j2jhW45nGcyuPQC7lSWw9YOeVQqNmwUuI2RQ3ptoq+fwAvDXs1i\ns0s6r1p9IQckIFNnCArFeRjuYT9RSGXyY/Y6uylTJYTg5E8udW0SkexdD+KdAJWE\nxadM//WMlBjwGWzBfpDSJrNvafNQYe1l20x2/xq33TF4j8OtePvcg7Wm2P0FEy8G\nQKY8yF6VS+ZAx4oW8MsKhC+1GhSY31u5CYC8pF1DemuOaFF0CNuoAlA1poU/8N8o\nZuSXb04iXynuHwlEYJ4Z\n=5jTX\n-----END PGP SIGNATURE-----\n","payload":"tree 5e13bf5b298d5f6c2e7e1b518d7fcf4b5583e90b\nparent d2f97191abc457954dff23ee1d9342516128ec01\nauthor Sydney Runkle <54324534+sydney-runkle@users.noreply.github.com> 1782777728 -0400\ncommitter GitHub <noreply@github.com> 1782777728 -0700\n\nfix(langgraph): Make `Overwrite` survive JSON roundtrips (#8127)\n\nAdd a `type: Literal[\"__overwrite__\"]` discriminator field to\n`Overwrite` and teach `_get_overwrite()` to recognise the\ndataclass-erased `{\"value\": ..., \"type\": \"__overwrite__\"}` form. This\nkeeps `Overwrite` semantics intact across JSON boundaries that strip\ndataclass types (e.g. `langgraph-api.serde.json_dumpb`), without\nrequiring callers to switch to the dict sentinel form.\n\nThis was an oversight in the initial `Overwrite` implementation, it\nshould be json serializable out of the box.\n\nFixing langchain-ai/deepagents#3789","verified_at":"2026-06-30T00:02:09Z"}},"url":"https://api.github.com/repos/langchain-ai/langgraph/commits/1b5ca0a1b1e1889879e43536fc5efd0739a3c479","html_url":"https://github.com/langchain-ai/langgraph/commit/1b5ca0a1b1e1889879e43536fc5efd0739a3c479","comments_url":"https://api.github.com/repos/langchain-ai/langgraph/commits/1b5ca0a1b1e1889879e43536fc5efd0739a3c479/comments","author":{"login":"sydney-runkle","id":54324534,"node_id":"MDQ6VXNlcjU0MzI0NTM0","avatar_url":"https://avatars.githubusercontent.com/u/54324534?v=4","gravatar_id":"","url":"https://api.github.com/users/sydney-runkle","html_url":"https://github.com/sydney-runkle","followers_url":"https://api.github.com/users/sydney-runkle/followers","following_url":"https://api.github.com/users/sydney-runkle/following{/other_user}","gists_url":"https://api.github.com/users/sydney-runkle/gists{/gist_id}","starred_url":"https://api.github.com/users/sydney-runkle/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sydney-runkle/subscriptions","organizations_url":"https://api.github.com/users/sydney-runkle/orgs","repos_url":"https://api.github.com/users/sydney-runkle/repos","events_url":"https://api.github.com/users/sydney-runkle/events{/privacy}","received_events_url":"https://api.github.com/users/sydney-runkle/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"d2f97191abc457954dff23ee1d9342516128ec01","url":"https://api.github.com/repos/langchain-ai/langgraph/commits/d2f97191abc457954dff23ee1d9342516128ec01","html_url":"https://github.com/langchain-ai/langgraph/commit/d2f97191abc457954dff23ee1d9342516128ec01"}]},{"sha":"d2f97191abc457954dff23ee1d9342516128ec01","node_id":"C_kwDOKFU0ldoAKGQyZjk3MTkxYWJjNDU3OTU0ZGZmMjNlZTFkOTM0MjUxNjEyOGVjMDE","commit":{"author":{"name":"dependabot[bot]","email":"49699333+dependabot[bot]@users.noreply.github.com","date":"2026-06-28T06:12:55Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-28T06:12:55Z"},"message":"chore(deps): bump redis in /libs/langgraph (#7976)\n\n## Description\nUpdates the langgraph lockfile against current `main`, carrying forward\nthe streaming timing test relaxation and resolving stale\npyproject/lockfile conflicts. Redis now resolves to 8.0.1; Starlette is\nalready 1.3.1 on `main`.\n\n## Test Plan\n- [x] `cd libs/langgraph && uv lock --check && make format && make lint`\n- [x] `cd libs/langgraph && NO_DOCKER=true\nTEST=\"tests/test_pregel.py::test_sync_streaming_with_functional_api -q\n--no-header --disable-warnings\" make test`\n- [x] `cd libs/langgraph && NO_DOCKER=true\nTEST=\"tests/test_pregel.py::test_in_one_fan_out_state_graph_waiting_edge_plus_regular\n-q --no-header --disable-warnings\" make test`\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/75b64102-20de-8a57-3a60-beb9c32bf681)\n\n---------\n\nSigned-off-by: dependabot[bot] <support@github.com>\nCo-authored-by: dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com>\nCo-authored-by: Claude <noreply@anthropic.com>\nCo-authored-by: John Kennedy <65985482+jkennedyvz@users.noreply.github.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"d45810bfc8f0ba10aa68e1f2d3bc3da17a23aa6c","url":"https://api.github.com/repos/langchain-ai/langgraph/git/trees/d45810bfc8f0ba10aa68e1f2d3bc3da17a23aa6c"},"url":"https://api.github.com/repos/langchain-ai/langgraph/git/commits/d2f97191abc457954dff23ee1d9342516128ec01","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqQLtnCRC1aQ7uu5UhlAAA87wQAF8+Z1UENAYprtywHitDyn2X\nXas1QDOU0x/f6FGYH+l/L5rdcLp+iNUiZ2FgQZ5NJs0HGyCb+DVUuY8ljtz8pzWy\nb54aENnpYuLVKIqTzQndlPE5fOO4S1+pXXHq70i0bYJ+Nfdn4ceKIyOlI4MC6YnU\n6iS8jCtwW3z4CIP10K7j4WrGlGxelIgDFmRPJzWLoXoLt3+lZsbgvrrftD73yqYT\nUC20P30+07YL2Pq7XRKZPiVgtoKSvMiXBMhPRmO7oMG2sA9iPQJubALyLFsz0Qo3\nL9HbzbAlMvPrbGbgf7LYU6b1awEaWJuqwF2tGQHnsSXoTvq04BP47/raw7q0G4Li\nGulxRgWJ6OCmW0xHStRwRvhSwS0dHjKYY/JeIg+FWK2UziUVtySIIytiEOOI6SqS\nnpxAu1MNErcenQdWlmoOCi4B4p8Fag4WwRdOZKbu9NE9SJiQruLhnRR+xbiun5FL\n2KCsuVakiQqUMeF+HuGNEQfANuNUdGXFbTRaZwk62NXr3lq0iroEfPGJkWrlyQN+\nlszTISZ3YSAMN8M5MJ+8XdUhVRasZxxL+Y8JGKgcBV0cvpGIhDPDDIUHwNyfs46h\nIJMAw4uNvjxeJ+IZnXxfiUhrdUX/dn+B/Ol7tMPpjA9oWnQPm948bCTmoIyvQhXT\nROJVRHKhAZkEYIwTMWwQ\n=Vz34\n-----END PGP SIGNATURE-----\n","payload":"tree d45810bfc8f0ba10aa68e1f2d3bc3da17a23aa6c\nparent c1aad8b46053303c34151e4d05bad1ac0fd17ef5\nauthor dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com> 1782627175 -0700\ncommitter GitHub <noreply@github.com> 1782627175 -0700\n\nchore(deps): bump redis in /libs/langgraph (#7976)\n\n## Description\nUpdates the langgraph lockfile against current `main`, carrying forward\nthe streaming timing test relaxation and resolving stale\npyproject/lockfile conflicts. Redis now resolves to 8.0.1; Starlette is\nalready 1.3.1 on `main`.\n\n## Test Plan\n- [x] `cd libs/langgraph && uv lock --check && make format && make lint`\n- [x] `cd libs/langgraph && NO_DOCKER=true\nTEST=\"tests/test_pregel.py::test_sync_streaming_with_functional_api -q\n--no-header --disable-warnings\" make test`\n- [x] `cd libs/langgraph && NO_DOCKER=true\nTEST=\"tests/test_pregel.py::test_in_one_fan_out_state_graph_waiting_edge_plus_regular\n-q --no-header --disable-warnings\" make test`\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/75b64102-20de-8a57-3a60-beb9c32bf681)\n\n---------\n\nSigned-off-by: dependabot[bot] <support@github.com>\nCo-authored-by: dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com>\nCo-authored-by: Claude <noreply@anthropic.com>\nCo-authored-by: John Kennedy <65985482+jkennedyvz@users.noreply.github.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-28T06:12:56Z"}},"url":"https://api.github.com/repos/langchain-ai/langgraph/commits/d2f97191abc457954dff23ee1d9342516128ec01","html_url":"https://github.com/langchain-ai/langgraph/commit/d2f97191abc457954dff23ee1d9342516128ec01","comments_url":"https://api.github.com/repos/langchain-ai/langgraph/commits/d2f97191abc457954dff23ee1d9342516128ec01/comments","author":{"login":"dependabot[bot]","id":49699333,"node_id":"MDM6Qm90NDk2OTkzMzM=","avatar_url":"https://avatars.githubusercontent.com/in/29110?v=4","gravatar_id":"","url":"https://api.github.com/users/dependabot%5Bbot%5D","html_url":"https://github.com/apps/dependabot","followers_url":"https://api.github.com/users/dependabot%5Bbot%5D/followers","following_url":"https://api.github.com/users/dependabot%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/dependabot%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/dependabot%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dependabot%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/dependabot%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/dependabot%5Bbot%5D/repos","events_url":"https://api.github.com/users/dependabot%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/dependabot%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c1aad8b46053303c34151e4d05bad1ac0fd17ef5","url":"https://api.github.com/repos/langchain-ai/langgraph/commits/c1aad8b46053303c34151e4d05bad1ac0fd17ef5","html_url":"https://github.com/langchain-ai/langgraph/commit/c1aad8b46053303c34151e4d05bad1ac0fd17ef5"}]},{"sha":"c1aad8b46053303c34151e4d05bad1ac0fd17ef5","node_id":"C_kwDOKFU0ldoAKGMxYWFkOGI0NjA1MzMwM2MzNDE1MWU0ZDA1YmFkMWFjMGZkMTdlZjU","commit":{"author":{"name":"dependabot[bot]","email":"49699333+dependabot[bot]@users.noreply.github.com","date":"2026-06-28T01:22:23Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-28T01:22:23Z"},"message":"chore(deps-dev): bump starlette from 1.0.1 to 1.3.1 in /libs/sdk-py (#8104)\n\nBumps [starlette](https://github.com/Kludex/starlette) from 1.0.1 to\n1.3.1.\n<details>\n<summary>Release notes</summary>\n<p><em>Sourced from <a\nhref=\"https://github.com/Kludex/starlette/releases\">starlette's\nreleases</a>.</em></p>\n<blockquote>\n<h2>Version 1.3.1</h2>\n<h2>What's Changed</h2>\n<ul>\n<li>Use <code>StarletteDeprecationWarning</code> instead of\n<code>DeprecationWarning</code> by <a\nhref=\"https://github.com/Kludex\"><code>@​Kludex</code></a> in <a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/3119\">Kludex/starlette#3119</a></li>\n<li>Enforce <code>max_fields</code> and <code>max_part_size</code> in\n<code>FormParser</code> by <a\nhref=\"https://github.com/Kludex\"><code>@​Kludex</code></a> in <a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/3329\">Kludex/starlette#3329</a></li>\n<li>Enforce <code>FormParser</code> limits in parser callbacks by <a\nhref=\"https://github.com/Kludex\"><code>@​Kludex</code></a> in <a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/3331\">Kludex/starlette#3331</a></li>\n</ul>\n<p><strong>Full Changelog</strong>: <a\nhref=\"https://github.com/Kludex/starlette/compare/1.3.0...1.3.1\">https://github.com/Kludex/starlette/compare/1.3.0...1.3.1</a></p>\n<h2>Version 1.3.0</h2>\n<h2>What's Changed</h2>\n<ul>\n<li>Clamp oversized suffix ranges in <code>FileResponse</code> by <a\nhref=\"https://github.com/jiyujie2006\"><code>@​jiyujie2006</code></a> in\n<a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/3307\">Kludex/starlette#3307</a></li>\n<li>Catch <code>OSError</code> alongside <code>MultiPartException</code>\nwhen closing temp files by <a\nhref=\"https://github.com/N3XT3R1337\"><code>@​N3XT3R1337</code></a> in <a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/3191\">Kludex/starlette#3191</a></li>\n<li>Add <code>httpx2</code> to the <code>full</code> extra by <a\nhref=\"https://github.com/Kludex\"><code>@​Kludex</code></a> in <a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/3323\">Kludex/starlette#3323</a></li>\n<li>Adjust testclient typing and warnings by <a\nhref=\"https://github.com/waketzheng\"><code>@​waketzheng</code></a> in <a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/3322\">Kludex/starlette#3322</a></li>\n<li>Fix IndexError in URL.replace() on a URL with no authority by <a\nhref=\"https://github.com/LeSingh1\"><code>@​LeSingh1</code></a> in <a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/3317\">Kludex/starlette#3317</a></li>\n<li>Annotate URLPath protocol parameter with Literal by <a\nhref=\"https://github.com/Chang-LeHung\"><code>@​Chang-LeHung</code></a>\nin <a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/3285\">Kludex/starlette#3285</a></li>\n<li>avoid collapsing exception groups from user code by <a\nhref=\"https://github.com/graingert\"><code>@​graingert</code></a> in <a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/2830\">Kludex/starlette#2830</a></li>\n<li>Use <code>removeprefix</code> to strip weak ETag indicator in\n<code>is_not_modified</code> by <a\nhref=\"https://github.com/gnosyslambda\"><code>@​gnosyslambda</code></a>\nin <a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/3193\">Kludex/starlette#3193</a></li>\n<li>Build <code>request.url</code> from structured components by <a\nhref=\"https://github.com/Kludex\"><code>@​Kludex</code></a> in <a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/3326\">Kludex/starlette#3326</a></li>\n</ul>\n<h2>New Contributors</h2>\n<ul>\n<li><a\nhref=\"https://github.com/jiyujie2006\"><code>@​jiyujie2006</code></a>\nmade their first contribution in <a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/3307\">Kludex/starlette#3307</a></li>\n<li><a\nhref=\"https://github.com/N3XT3R1337\"><code>@​N3XT3R1337</code></a> made\ntheir first contribution in <a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/3191\">Kludex/starlette#3191</a></li>\n<li><a\nhref=\"https://github.com/leestana01\"><code>@​leestana01</code></a> made\ntheir first contribution in <a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/3319\">Kludex/starlette#3319</a></li>\n<li><a href=\"https://github.com/LeSingh1\"><code>@​LeSingh1</code></a>\nmade their first contribution in <a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/3317\">Kludex/starlette#3317</a></li>\n<li><a\nhref=\"https://github.com/EmmanuelNiyonshuti\"><code>@​EmmanuelNiyonshuti</code></a>\nmade their first contribution in <a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/3204\">Kludex/starlette#3204</a></li>\n<li><a\nhref=\"https://github.com/Chang-LeHung\"><code>@​Chang-LeHung</code></a>\nmade their first contribution in <a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/3285\">Kludex/starlette#3285</a></li>\n<li><a\nhref=\"https://github.com/gnosyslambda\"><code>@​gnosyslambda</code></a>\nmade their first contribution in <a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/3193\">Kludex/starlette#3193</a></li>\n</ul>\n<p><strong>Full Changelog</strong>: <a\nhref=\"https://github.com/Kludex/starlette/compare/1.2.1...1.3.0\">https://github.com/Kludex/starlette/compare/1.2.1...1.3.0</a></p>\n<h2>Version 1.2.1</h2>\n<h2>What's Changed</h2>\n<ul>\n<li>Use <code>httpx2</code> for type checking in the\n<code>testclient</code> module by <a\nhref=\"https://github.com/leifwar\"><code>@​leifwar</code></a> in <a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/3304\">Kludex/starlette#3304</a></li>\n<li>Add assert error for requires() when request param is not Request\ntype by <a\nhref=\"https://github.com/KeeganOP\"><code>@​KeeganOP</code></a> in <a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/3298\">Kludex/starlette#3298</a></li>\n</ul>\n<h2>New Contributors</h2>\n<ul>\n<li><a href=\"https://github.com/leifwar\"><code>@​leifwar</code></a> made\ntheir first contribution in <a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/3304\">Kludex/starlette#3304</a></li>\n<li><a href=\"https://github.com/diskeu\"><code>@​diskeu</code></a> made\ntheir first contribution in <a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/3243\">Kludex/starlette#3243</a></li>\n<li><a href=\"https://github.com/KeeganOP\"><code>@​KeeganOP</code></a>\nmade their first contribution in <a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/3298\">Kludex/starlette#3298</a></li>\n</ul>\n<p><strong>Full Changelog</strong>: <a\nhref=\"https://github.com/Kludex/starlette/compare/1.2.0...1.2.1\">https://github.com/Kludex/starlette/compare/1.2.0...1.2.1</a></p>\n<h2>Version 1.2.0</h2>\n<h2>What's Changed</h2>\n<ul>\n<li>Support httpx2 in the test client by <a\nhref=\"https://github.com/Kludex\"><code>@​Kludex</code></a> in <a\nhref=\"https://redirect.github.com/Kludex/starlette/pull/3291\">Kludex/starlette#3291</a></li>\n</ul>\n<p><strong>Full Changelog</strong>: <a\nhref=\"https://github.com/Kludex/starlette/compare/1.1.0...1.2.0\">https://github.com/Kludex/starlette/compare/1.1.0...1.2.0</a></p>\n<h2>Version 1.1.0</h2>\n<!-- raw HTML omitted -->\n</blockquote>\n<p>... (truncated)</p>\n</details>\n<details>\n<summary>Changelog</summary>\n<p><em>Sourced from <a\nhref=\"https://github.com/Kludex/starlette/blob/main/docs/release-notes.md\">starlette's\nchangelog</a>.</em></p>\n<blockquote>\n<h2>1.3.1 (June 12, 2026)</h2>\n<h4>Fixed</h4>\n<ul>\n<li>Enforce <code>max_fields</code> and <code>max_part_size</code> in\n<code>FormParser</code> <a\nhref=\"https://redirect.github.com/encode/starlette/pull/3329\">#3329</a>.</li>\n<li>Enforce <code>FormParser</code> limits in parser callbacks <a\nhref=\"https://redirect.github.com/encode/starlette/pull/3331\">#3331</a>.</li>\n</ul>\n<h2>1.3.0 (June 11, 2026)</h2>\n<h4>Added</h4>\n<ul>\n<li>Add <code>httpx2</code> to the <code>full</code> extra <a\nhref=\"https://redirect.github.com/encode/starlette/pull/3323\">#3323</a>.</li>\n<li>Annotate the <code>URLPath</code> <code>protocol</code> parameter\nwith <code>Literal</code> <a\nhref=\"https://redirect.github.com/encode/starlette/pull/3285\">#3285</a>.</li>\n</ul>\n<h4>Fixed</h4>\n<ul>\n<li>Build <code>request.url</code> from structured components <a\nhref=\"https://redirect.github.com/encode/starlette/pull/3326\">#3326</a>.</li>\n<li>Clamp oversized suffix ranges in <code>FileResponse</code> <a\nhref=\"https://redirect.github.com/encode/starlette/pull/3307\">#3307</a>.</li>\n<li>Catch <code>OSError</code> alongside <code>MultiPartException</code>\nwhen closing temp files <a\nhref=\"https://redirect.github.com/encode/starlette/pull/3191\">#3191</a>.</li>\n<li>Avoid collapsing exception groups raised from user code <a\nhref=\"https://redirect.github.com/encode/starlette/pull/2830\">#2830</a>.</li>\n<li>Use <code>removeprefix</code> to strip the weak <code>ETag</code>\nindicator in <code>is_not_modified</code> <a\nhref=\"https://redirect.github.com/encode/starlette/pull/3193\">#3193</a>.</li>\n<li>Fix <code>IndexError</code> in <code>URL.replace()</code> on a URL\nwith no authority <a\nhref=\"https://redirect.github.com/encode/starlette/pull/3317\">#3317</a>.</li>\n<li>Adjust <code>testclient</code> typing and warnings <a\nhref=\"https://redirect.github.com/encode/starlette/pull/3322\">#3322</a>.</li>\n</ul>\n<h2>1.2.1 (May 31, 2026)</h2>\n<h4>Fixed</h4>\n<ul>\n<li>Use <code>httpx2</code> for type checking in the\n<code>testclient</code> module <a\nhref=\"https://redirect.github.com/encode/starlette/pull/3304\">#3304</a>.</li>\n<li>Add assert error for <code>requires()</code> when the request\nparameter is not a <code>Request</code> type <a\nhref=\"https://redirect.github.com/encode/starlette/pull/3298\">#3298</a>.</li>\n</ul>\n<h2>1.2.0 (May 28, 2026)</h2>\n<h4>Added</h4>\n<ul>\n<li>Support httpx2 in the test client <a\nhref=\"https://redirect.github.com/encode/starlette/pull/3291\">#3291</a>.</li>\n</ul>\n<h2>1.1.0 (May 23, 2026)</h2>\n<h4>Added</h4>\n<ul>\n<li>Use <code>&quot;application/octet-stream&quot;</code> as the\n<code>FileResponse</code> media type fallback <a\nhref=\"https://redirect.github.com/encode/starlette/pull/3283\">#3283</a>.</li>\n</ul>\n<h4>Fixed</h4>\n<ul>\n<li>Only dispatch standard HTTP verbs in <code>HTTPEndpoint</code> <a\nhref=\"https://redirect.github.com/encode/starlette/pull/3286\">#3286</a>.</li>\n<li>Reject absolute paths in <code>StaticFiles.lookup_path</code> <a\nhref=\"https://redirect.github.com/encode/starlette/pull/3287\">#3287</a>.</li>\n</ul>\n</blockquote>\n</details>\n<details>\n<summary>Commits</summary>\n<ul>\n<li><a\nhref=\"https://github.com/Kludex/starlette/commit/8ebffd0678570ddd5d5bb11c6f3c3c7fd4682ab9\"><code>8ebffd0</code></a>\nVersion 1.3.1 (<a\nhref=\"https://redirect.github.com/Kludex/starlette/issues/3330\">#3330</a>)</li>\n<li><a\nhref=\"https://github.com/Kludex/starlette/commit/25b8e179d8d7ed86769c02f648772dd5fb43dc3c\"><code>25b8e17</code></a>\nEnforce <code>FormParser</code> limits in parser callbacks (<a\nhref=\"https://redirect.github.com/Kludex/starlette/issues/3331\">#3331</a>)</li>\n<li><a\nhref=\"https://github.com/Kludex/starlette/commit/dba1c4babc4f99ad2622bb913d87045775dda735\"><code>dba1c4b</code></a>\nEnforce <code>max_fields</code> and <code>max_part_size</code> in\n<code>FormParser</code> (<a\nhref=\"https://redirect.github.com/Kludex/starlette/issues/3329\">#3329</a>)</li>\n<li><a\nhref=\"https://github.com/Kludex/starlette/commit/45e51dcf99f3a270b0bcec1aec5410b4345863a9\"><code>45e51dc</code></a>\nUse <code>StarletteDeprecationWarning</code> instead of\n<code>DeprecationWarning</code> (<a\nhref=\"https://redirect.github.com/Kludex/starlette/issues/3119\">#3119</a>)</li>\n<li><a\nhref=\"https://github.com/Kludex/starlette/commit/5f8610c386e13de1d80d36efa961e1486a1d2d01\"><code>5f8610c</code></a>\nVersion 1.3.0 (<a\nhref=\"https://redirect.github.com/Kludex/starlette/issues/3327\">#3327</a>)</li>\n<li><a\nhref=\"https://github.com/Kludex/starlette/commit/167b5850e809f38b27fbfed62d58bf6442855975\"><code>167b585</code></a>\nBuild <code>request.url</code> from structured components (<a\nhref=\"https://redirect.github.com/Kludex/starlette/issues/3326\">#3326</a>)</li>\n<li><a\nhref=\"https://github.com/Kludex/starlette/commit/37309255b4c1b9c381a2d24a1eaf83100984a16a\"><code>3730925</code></a>\nUse <code>removeprefix</code> to strip weak ETag indicator in\n<code>is_not_modified</code> (<a\nhref=\"https://redirect.github.com/Kludex/starlette/issues/3193\">#3193</a>)</li>\n<li><a\nhref=\"https://github.com/Kludex/starlette/commit/e6f7ad1ab85efb27ab7910d8007b3f4531f7b083\"><code>e6f7ad1</code></a>\navoid collapsing exception groups from user code (<a\nhref=\"https://redirect.github.com/Kludex/starlette/issues/2830\">#2830</a>)</li>\n<li><a\nhref=\"https://github.com/Kludex/starlette/commit/115228fcdca0e0ef5bf4a95a40ddce5a9fced428\"><code>115228f</code></a>\nAnnotate URLPath protocol parameter with Literal (<a\nhref=\"https://redirect.github.com/Kludex/starlette/issues/3285\">#3285</a>)</li>\n<li><a\nhref=\"https://github.com/Kludex/starlette/commit/113f193a34353c9153857028c1074351d22fad07\"><code>113f193</code></a>\ndocs: replace inline ASGI server list with link to canonical implemen…\n(<a\nhref=\"https://redirect.github.com/Kludex/starlette/issues/3204\">#3204</a>)</li>\n<li>Additional commits viewable in <a\nhref=\"https://github.com/Kludex/starlette/compare/1.0.1...1.3.1\">compare\nview</a></li>\n</ul>\n</details>\n<br />\n\n\n[![Dependabot compatibility\nscore](https://dependabot-badges.githubapp.com/badges/compatibility_score?dependency-name=starlette&package-manager=uv&previous-version=1.0.1&new-version=1.3.1)](https://docs.github.com/en/github/managing-security-vulnerabilities/about-dependabot-security-updates#about-compatibility-scores)\n\nDependabot will resolve any conflicts with this PR as long as you don't\nalter it yourself. You can also trigger a rebase manually by commenting\n`@dependabot rebase`.\n\n[//]: # (dependabot-automerge-start)\n[//]: # (dependabot-automerge-end)\n\n---\n\n<details>\n<summary>Dependabot commands and options</summary>\n<br />\n\nYou can trigger Dependabot actions by commenting on this PR:\n- `@dependabot rebase` will rebase this PR\n- `@dependabot recreate` will recreate this PR, overwriting any edits\nthat have been made to it\n- `@dependabot show <dependency name> ignore conditions` will show all\nof the ignore conditions of the specified dependency\n- `@dependabot ignore this major version` will close this PR and stop\nDependabot creating any more for this major version (unless you reopen\nthe PR or upgrade to it yourself)\n- `@dependabot ignore this minor version` will close this PR and stop\nDependabot creating any more for this minor version (unless you reopen\nthe PR or upgrade to it yourself)\n- `@dependabot ignore this dependency` will close this PR and stop\nDependabot creating any more for this dependency (unless you reopen the\nPR or upgrade to it yourself)\nYou can disable automated security fix PRs for this repo from the\n[Security Alerts\npage](https://github.com/langchain-ai/langgraph/network/alerts).\n\n</details>\n\nSigned-off-by: dependabot[bot] <support@github.com>\nCo-authored-by: dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com>","tree":{"sha":"f0e521f694c4ba19f8057869b696f3ebf2fa8a67","url":"https://api.github.com/repos/langchain-ai/langgraph/git/trees/f0e521f694c4ba19f8057869b696f3ebf2fa8a67"},"url":"https://api.github.com/repos/langchain-ai/langgraph/git/commits/c1aad8b46053303c34151e4d05bad1ac0fd17ef5","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqQHdPCRC1aQ7uu5UhlAAAP9sQABgVIIRtFZ+g/