m/repos/langchain-ai/deepagents/commits/5145ed1f8296f41d78c905c2ce899d2742f7dc9b","html_url":"https://github.com/langchain-ai/deepagents/commit/5145ed1f8296f41d78c905c2ce899d2742f7dc9b"}]},{"sha":"5145ed1f8296f41d78c905c2ce899d2742f7dc9b","node_id":"C_kwDOPTymldoAKDUxNDVlZDFmODI5NmY0MWQ3OGM5MDVjMmNlODk5ZDI3NDJmN2RjOWI","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-05-28T19:52:22Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-28T19:52:22Z"},"message":"fix(code): centralize debug logging setup to package root (#3650)\n\nMove `configure_debug_logging` from individual modules to the package\nroot in `__init__.py` so all child loggers inherit the same file handler\nvia propagation. This eliminates duplicate handler attachments when\nmultiple modules import the debug helper, and makes the logging\nconfiguration idempotent across reloads.","tree":{"sha":"50332690fa6b0e0ccf2e8247adbb566925bd7a62","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/50332690fa6b0e0ccf2e8247adbb566925bd7a62"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/5145ed1f8296f41d78c905c2ce899d2742f7dc9b","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqGJz2CRC1aQ7uu5UhlAAA4uMQAKpH9FtLfYwKYcrJdhuml6gI\n4zRTzHSDgRkVuJtJ4WCZKLS4+Ap29VPGg8X58G6xcTl+2vyld5r7Mw0DCiTszCiQ\nkaD3ATc3navoRhKGFMT235g13GZoqm3vzhMot2FZxiT5kG2NrDcqAzVM9HXPvvhr\n2buKlWwJOhitWt/jhMH8V27I7Ury41FLO/9ea1orR2tydgaGiUyy3OrscqjlZeqb\n8MayQAlZqviG+SjJVeKrYtwjMuL556B0cgZCjSxn3/AFWCjR4Ufrk+7i+YWSaPtA\nOWyiPO5wmXbnhPgEw3I/WLZqG1LVdEEFaczOngQaL2IUPDqOFeBwo7qeVtYqnCvk\nnt7NLnow+eLaS3KGE6k+qEtY16hGcKipIvAYufUH8fu+TiwmMoeUMNikhjx4TX2A\nWjFK7o7Pf0DOwn+crcbri17ay2sEW7CgMKWoJUtwGp/qOsCqHIp3zlBzCJ0kLej1\n9xFirEpA15Zhjach+TCZKKIgIa0vdu1nri8MbUszyp+g8zeCP9fCWqqgffDvRWZl\ngMpKnhxNExbQ4AzTPNM+2cP4wGb+pB7qK1aQPLI/0t3Wi6Ofm5gMm+gULsUbPKwt\nUKkWyKNU7ORn235F9AEBh64Vtgf9+Vp1IRRVhAsJkNvuGUO+Tmq0n5dfvoafOKiq\n8/g/gZonoS0Tc58dYFul\n=Ltk3\n-----END PGP SIGNATURE-----\n","payload":"tree 50332690fa6b0e0ccf2e8247adbb566925bd7a62\nparent 9a287424e86d5d52d0a328388c3fe453b160f597\nauthor Mason Daugherty <mason@langchain.dev> 1779997942 -0400\ncommitter GitHub <noreply@github.com> 1779997942 -0400\n\nfix(code): centralize debug logging setup to package root (#3650)\n\nMove `configure_debug_logging` from individual modules to the package\nroot in `__init__.py` so all child loggers inherit the same file handler\nvia propagation. This eliminates duplicate handler attachments when\nmultiple modules import the debug helper, and makes the logging\nconfiguration idempotent across reloads.","verified_at":"2026-05-28T19:52:23Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/5145ed1f8296f41d78c905c2ce899d2742f7dc9b","html_url":"https://github.com/langchain-ai/deepagents/commit/5145ed1f8296f41d78c905c2ce899d2742f7dc9b","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/5145ed1f8296f41d78c905c2ce899d2742f7dc9b/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"9a287424e86d5d52d0a328388c3fe453b160f597","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9a287424e86d5d52d0a328388c3fe453b160f597","html_url":"https://github.com/langchain-ai/deepagents/commit/9a287424e86d5d52d0a328388c3fe453b160f597"}]},{"sha":"9a287424e86d5d52d0a328388c3fe453b160f597","node_id":"C_kwDOPTymldoAKDlhMjg3NDI0ZTg2ZDVkNTJkMGEzMjgzODhjM2ZlNDUzYjE2MGY1OTc","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-05-28T19:30:26Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-28T19:30:26Z"},"message":"fix(code): handle stale slash-command `Enter` before completion popup renders (#3647)\n\nWhen a user types a slash command prefix and hits Enter faster than the\ncompletion popup renders, the raw prefix (e.g. `/mod`) is submitted\ninstead of the intended command. Add a recovery path that detects this\nrace and either completes an unambiguous prefix or shows the popup when\nmultiple commands match.","tree":{"sha":"2294d549641fe527fac2bded7c7b515ed5ca4915","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/2294d549641fe527fac2bded7c7b515ed5ca4915"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/9a287424e86d5d52d0a328388c3fe453b160f597","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqGJfSCRC1aQ7uu5UhlAAAFNoQAGdBs6lP8yPFVMft7d8/V5+f\neAk5THuRTKe01hJdlBD7d4NK1iHwLehr9cUl27vFEi5UgwOneyp9ujedhohr+jbj\nG8e3KgKVlmGuKj9NrPf2yRf/jIUx5wXFlCJxwAjgdDbUYWuyhC4jGUaEKs1Mt2Nh\nFdCAotqmpt3RlEMk5MU7iRqJ/3A9bai0CYEk+IeL0UUytqnGPlrWx3sSwd0cg7zY\nQ3LKKam/2EPxuiCnw2/33WtEw0mu98hGTY0Xq8YYdaDflXJ3h3HzxcUmdbazkwR3\n8GZhGSKt9xCnZPeepYm+xBqumfShdHBNfqFUqyqViKd+QTS9cM/7E7Nr3/sAt8Kk\n3Y2HR2NbdFI6jgsqJAMxh4d65TZ8HwX+WSmz+DMAgPaDVnUuhKAjvp+ocnpgkqpa\nPC7ckLzVi9gSY1R8UlCRJo0Ke0VI7tRxUQWb9EvutajgEXD4weLjN0QY5Ka0ZTK+\nqBmB5J3LOV9HHlLHO4IXXFS9Ja8s3ysd6Nx4Ui9FwAFxx/h5tJ+zjnn+MsujSZYM\nUJmEAyloXPd6Cm084QzKdY+a7H/WaQBKFyKS9nJr8H1px0icyut8Mq22AmFs16Xh\nnKBUueDg8gVSHyv7qSYRfEc7scvOAAUxjDLj39X1Tg7Hj2nS37pwyDEnr4XL3DUS\n17SZ0i9j5xnvTB3qnISF\n=nrEg\n-----END PGP SIGNATURE-----\n","payload":"tree 2294d549641fe527fac2bded7c7b515ed5ca4915\nparent ba1ad2dbabd19b3821490537465a3bcd39c6fed6\nauthor Mason Daugherty <mason@langchain.dev> 1779996626 -0400\ncommitter GitHub <noreply@github.com> 1779996626 -0400\n\nfix(code): handle stale slash-command `Enter` before completion popup renders (#3647)\n\nWhen a user types a slash command prefix and hits Enter faster than the\ncompletion popup renders, the raw prefix (e.g. `/mod`) is submitted\ninstead of the intended command. Add a recovery path that detects this\nrace and either completes an unambiguous prefix or shows the popup when\nmultiple commands match.","verified_at":"2026-05-28T19:30:26Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9a287424e86d5d52d0a328388c3fe453b160f597","html_url":"https://github.com/langchain-ai/deepagents/commit/9a287424e86d5d52d0a328388c3fe453b160f597","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9a287424e86d5d52d0a328388c3fe453b160f597/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"ba1ad2dbabd19b3821490537465a3bcd39c6fed6","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/ba1ad2dbabd19b3821490537465a3bcd39c6fed6","html_url":"https://github.com/langchain-ai/deepagents/commit/ba1ad2dbabd19b3821490537465a3bcd39c6fed6"}]},{"sha":"ba1ad2dbabd19b3821490537465a3bcd39c6fed6","node_id":"C_kwDOPTymldoAKGJhMWFkMmRiYWJkMTliMzgyMTQ5MDUzNzQ2NWEzYmNkMzljNmZlZDY","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-05-28T19:10:32Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-28T19:10:32Z"},"message":"fix(code): respect line width in tool output previews (#3646)\n\n`read_file` previews were truncating by line count only, so files with\nvery long lines (minified HTML/JS/CSS) wrapped beyond the widget bounds.\nPreview now caps both line count and total characters, and the\ntruncation hint prefers `\"N more lines\"` over `\"N more chars\"` when both\ncaps were hit — line count is the more useful signal for big files.","tree":{"sha":"081221f0090c64c8043aa9013635cbdb36b5c9d4","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/081221f0090c64c8043aa9013635cbdb36b5c9d4"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/ba1ad2dbabd19b3821490537465a3bcd39c6fed6","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqGJMoCRC1aQ7uu5UhlAAAk2IQAChudZmHAbsrZDTNy8dsHgcK\nDp0mq9Ek5wl9kIfSPn6wOuCACK07ttaF3D19k5D30qBELWWNqewKymou6dai4q8f\nKIumdNYnCHR80ZJL0w/YFBdO5nucTuUgkB+SEAlyxutNIUPcvufWh5jO2Q3FQ6Yc\nWN5PVO0ditkW1eiCK4dTq23opfinLrOydqWUx3AaP+Ox/3pHyRzNYXb3jci7ziwe\nGE+30VlZVgsk0ozuy9GPV3RE/js7qXTJE3QRd2K3RtQzcEaWlOyieQWzdHrrY92m\n3LmxNguUZcpFoAGnZu7a96iZX2oB2I6MYVrUgUPJE4ZcR2vEKNkv9x7FiRJ8O1fS\nAVmXGRYsORBshjYR7bKZ+L8rPjtrf6OEhzEPNCgibEcssZr12ztMCzDhzmxZgpnu\nqZwHQWl6tqK4D3/JqcLUCFegSo4LwidRHUceJsHCh3wP8xcGaIlsE4EyMFlEMDPP\ntnHgqHlfUHkMxvAE60hxcoPKr4RWRs3W21VT0HJkoK8cRy+XGilpaLf8mbNawuhk\nqgJZC3VCgY3j+wmAliI2XsNmW1goUJ5Q54YPLdaj2uYLMaOHb7WBcIt8KMwK50Gp\nhO+cu+kRAHDExx8wktyLdEXmvCsCXXNP9WZa5icy9CNQcVabtBp41FguKGNmGjxk\nSp25YFNuPlfoApwhQyPW\n=UZjz\n-----END PGP SIGNATURE-----\n","payload":"tree 081221f0090c64c8043aa9013635cbdb36b5c9d4\nparent bda376124c8f24c6a6c813c96eda5f63a5ca41d1\nauthor Mason Daugherty <mason@langchain.dev> 1779995432 -0400\ncommitter GitHub <noreply@github.com> 1779995432 -0400\n\nfix(code): respect line width in tool output previews (#3646)\n\n`read_file` previews were truncating by line count only, so files with\nvery long lines (minified HTML/JS/CSS) wrapped beyond the widget bounds.\nPreview now caps both line count and total characters, and the\ntruncation hint prefers `\"N more lines\"` over `\"N more chars\"` when both\ncaps were hit — line count is the more useful signal for big files.","verified_at":"2026-05-28T19:10:33Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/ba1ad2dbabd19b3821490537465a3bcd39c6fed6","html_url":"https://github.com/langchain-ai/deepagents/commit/ba1ad2dbabd19b3821490537465a3bcd39c6fed6","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/ba1ad2dbabd19b3821490537465a3bcd39c6fed6/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.