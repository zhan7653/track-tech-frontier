dev","date":"2026-06-30T17:54:15Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-30T17:54:15Z"},"message":"docs(repo): add release note guidance to PR template (#4384)\n\nPR descriptions for new features and behavior-changing bugfixes now have\nan explicit place for release-note-ready text. The template asks authors\nto include that section only when it applies, and the contributor\nguidance tells agents to omit the header otherwise.","tree":{"sha":"324a65bdf2b3ef70acf5610852b9aefb18dc9461","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/324a65bdf2b3ef70acf5610852b9aefb18dc9461"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/0470cdbd66f6b84cd6276acf0a171263c1789bef","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqRALHCRC1aQ7uu5UhlAAAH6sQAKK0eVwPnnLeyRQnM6fm7+CI\ncPV08toya3KP1IJQCbsi7RF5Eqj4Gz2VFehq++0aASUY0GkNjbYJKb8BVnh3lYSE\nKa6sdDcevIxbaixT4k2c97gGAsxzc5cslUFRKL1t5b1IQxKsZE9iJebCQ0puSt0W\nVqV+t5SIy4O1V2hDpYsin+q9uHj+Y6iAcm3w/WkhL81C8q8F8zV5IZ+3lbuuuyOC\nZYdQcKXQJ2GEO46PzmhgFfcd+AzeM1ImWTWjnrO/0H3TfrgVPNLVl1cFhw4zlrfx\npPh/k+oSmgCVEjjAs0EgUOuzb5MEnSRrYXFvl6oVc7YEjKz7gMFBYTF2JXbD57M5\nF6X0ChvAa5DM1st5yhMFsM5rDy+T6sXv9N38JCJrRvmfAiXaoO+GAA5t8eAkYHcL\n/qllRxCwZf3M5VxWn19NHF+MRXnd2k5V9pZ66H1WaZgCYVgJ0ZvW2Z+TV9/kFbWm\nRXoBuqHboCazb/kP3RL5ZzO3BN56JSr2zyo5/IaYj+7GbUmeo1akOq5N53GAlKhu\nEIaYlNb/OeAu/f4eGT6eIX7gNXnF5NiOrneSRCOjfonPLdEr0Ajf/w0vb4Nhavh/\nawum5x+LySX86VSyBUisgw72iuZyCXQL1+NWqbalqDp12hyeV0TqX852+Z7PJt0/\n3eVMHT4KiqMFa0ciwbbC\n=sR90\n-----END PGP SIGNATURE-----\n","payload":"tree 324a65bdf2b3ef70acf5610852b9aefb18dc9461\nparent 90c8472ae226394a186bf2075459645c2056db7d\nauthor Mason Daugherty <mason@langchain.dev> 1782842055 -0400\ncommitter GitHub <noreply@github.com> 1782842055 -0400\n\ndocs(repo): add release note guidance to PR template (#4384)\n\nPR descriptions for new features and behavior-changing bugfixes now have\nan explicit place for release-note-ready text. The template asks authors\nto include that section only when it applies, and the contributor\nguidance tells agents to omit the header otherwise.","verified_at":"2026-06-30T17:54:15Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/0470cdbd66f6b84cd6276acf0a171263c1789bef","html_url":"https://github.com/langchain-ai/deepagents/commit/0470cdbd66f6b84cd6276acf0a171263c1789bef","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/0470cdbd66f6b84cd6276acf0a171263c1789bef/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"90c8472ae226394a186bf2075459645c2056db7d","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/90c8472ae226394a186bf2075459645c2056db7d","html_url":"https://github.com/langchain-ai/deepagents/commit/90c8472ae226394a186bf2075459645c2056db7d"}]},{"sha":"90c8472ae226394a186bf2075459645c2056db7d","node_id":"C_kwDOPTymldoAKDkwYzg0NzJhZTIyNjM5NGExODZiZjIwNzU0NTk2NDVjMjA1NmRiN2Q","commit":{"author":{"name":"Nishitha M","email":"32355027+imnishitha@users.noreply.github.com","date":"2026-06-30T14:53:53Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-30T14:53:53Z"},"message":"feat(sdk): allow users to override default middleware by name (#4251)\n\n#### Summary\n\n- Adds _apply_user_middleware helper in graph.py that merges\nuser-supplied middleware into the assembled stack by `.name` rather than\nblindly appending\n- When a user-supplied entry's `.name` matches a default (e.g.\n\"`SummarizationMiddleware`\"), it replaces the default in-place,\npreserving stack order\n- Entries with no matching default are appended at the end, unchanged\n(same behavior as before)\n- Spec needs to be passed separately for Main agent and Subgagents\n- GP subagent gets the default middleware replacements from the Main agent's spec\n\n#### Motivation\n\nPreviously, passing a custom `SummarizationMiddleware` (e.g. with a\ndifferent model or summary_prompt) in middleware would land a duplicate\nalongside the built-in one, causing `create_agent` to raise\n`AssertionError: Please remove duplicate middleware instances`. There\nwas no way to override a default without also excluding in\n`HarnessProfile.excluded_middleware`.\n\n#### Now users can do:\n\n```\ncustom_summarization = SummarizationMiddleware(\n    model=\"openai:gpt-5.5\",\n    backend=backend,\n    summary_prompt=\"Your custom summary prompt here.\",\n)\n\nagent = create_deep_agent(\n    model=\"openai:gpt-5.5\",\n    middleware=[custom_summarization],  # replaces the default SummarizationMiddleware\n)\n\n```\n\n---------\n\nSigned-off-by: Nishitha M <32355027+imnishitha@users.noreply.github.com>\nCo-authored-by: open-swe[bot] <215916821+open-swe[bot]@users.noreply.github.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <61371264+mdrxy@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>\nCo-authored-by: ccurme <chester.curme@gmail.com>","tree":{"sha":"0bd4ac1e4b132874ab5401b23368aedbb14720b1","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/0bd4ac1e4b132874ab5401b23368aedbb14720b1"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/90c8472ae226394a186bf2075459645c2056db7d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqQ9iBCRC1aQ7uu5UhlAAA1HcQADQWuNNJZ4Q2Zbyub4IqrX4x\nmWE6zOgwE2OY+sNYC3Scf55dR4BUfG2788nPziRyOqco17SIzWzD9g8hoeeScUF/\nug584PXqnsWdbtpyGPD9sq/juzjzgy8EWJxPRloYK1yYRAO8auH4ALepIoAx+Ecw\nnMEfogFFYRa7+OgWE5dM5/t37URTsHMizC6pJSwWfx7AeC1EZSs9pp2dt10SuPBq\nyfVwTvTx9cFd7XpB/u7+qi3TElsZrxp0rbdhwhonrHbSAnL4punLO0hFiEUY22BA\nfAJSTpMrBC5VmgbJjdWIEKBCQh2whGsNCTi+g81/2UVvBrGGwpwWI+zOp9rRHc42\ngwrPIBjdUKimnAsOU2N/jEGMnzn3quOOft+Fv/iqYN8bMVx9U7AlHfnp13Pqi9fe\nUvJaqr9WwgUE+2jVcttEsVdvHpPfThg+qwkEIEuuHjPw1jACWaaVZWzrAnYaflHT\nb5j9LI/KvHgXlcyQJadhFm96UGrP1xDkb3r2VW4GETroO5UiRw33HQ78NZY2W2R+\nKxmMsbtx9BbK/1zbxVtxJiC8CFvsK01EmwcoN4KuCU1AbqG3boE+WGVN7/xtYIGy\nbjf6b3Gnj7CRQHXvtClZIYp1Q/HDAbrzqtT0k6iY4MphSjy/LbKKQV77S5nVsXLv\nhs5t3QQvUlB9elvOJTyD\n=qUKz\n-----END PGP SIGNATURE-----\n","payload":"tree 0bd4ac1e4b132874ab5401b23368aedbb14720b1\nparent 14a0fb119e4db8bf48743ece164cce44d334a56a\nauthor Nishitha M <32355027+imnishitha@users.noreply.github.com> 1782831233 -0400\ncommitter GitHub <noreply@github.com> 1782831233 -0400\n\nfeat(sdk): allow users to override default middleware by name (#4251)\n\n#### Summary\n\n- Adds _apply_user_middleware helper in graph.py that merges\nuser-supplied middleware into the assembled stack by `.name` rather than\nblindly appending\n- When a user-supplied entry's `.name` matches a default (e.g.\n\"`SummarizationMiddleware`\"), it replaces the default in-place,\npreserving stack order\n- Entries with no matching default are appended at the end, unchanged\n(same behavior as before)\n- Spec needs to be passed separately for Main agent and Subgagents\n- GP subagent gets the default middleware replacements from the Main agent's spec\n\n#### Motivation\n\nPreviously, passing a custom `SummarizationMiddleware` (e.g. with a\ndifferent model or summary_prompt) in middleware would land a duplicate\nalongside the built-in one, causing `create_agent` to raise\n`AssertionError: Please remove duplicate middleware instances`. There\nwas no way to override a default without also excluding in\n`HarnessProfile.excluded_middleware`.\n\n#### Now users can do:\n\n```\ncustom_summarization = SummarizationMiddleware(\n    model=\"openai:gpt-5.5\",\n    backend=backend,\n    summary_prompt=\"Your custom summary prompt here.\",\n)\n\nagent = create_deep_agent(\n    model=\"openai:gpt-5.5\",\n    middleware=[custom_summarization],  # replaces the default SummarizationMiddleware\n)\n\n```\n\n---------\n\nSigned-off-by: Nishitha M <32355027+imnishitha@users.noreply.github.com>\nCo-authored-by: open-swe[bot] <215916821+open-swe[bot]@users.noreply.github.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <61371264+mdrxy@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>\nCo-authored-by: ccurme <chester.curme@gmail.com>","verified_at":"2026-06-30T14:53:53Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/90c8472ae226394a186bf2075459645c2056db7d","html_url":"https://github.com/langchain-ai/deepagents/commit/90c8472ae226394a186bf2075459645c2056db7d","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/90c8472ae226394a186bf2075459645c2056db7d/comments","author":{"login":"imnishitha","id":32355027,"node_id":"MDQ6VXNlcjMyMzU1MDI3","avatar_url":"https://avatars.githubusercontent.com/u/32355027?v=4","gravatar_id":"","url":"https://api.github.com/users/imnishitha","html_url":"https://github.com/imnishitha","followers_url":"https://api.github.com/users/imnishitha/followers","following_url":"https://api.github.com/users/imnishitha/following{/other_user}","gists_url":"https://api.github.com/users/imnishitha/gists{/gist_id}","starred_url":"https://api.github.com/users/imnishitha/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/imnishitha/subscriptions","organizations_url":"https://api.github.com/users/imnishitha/orgs","repos_url":"https://api.github.com/users/imnishitha/repos","events_url":"https://api.github.com/users/imnishitha/events{/privacy}","received_events_url":"https://api.github.com/users/imnishitha/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"14a0fb119e4db8bf48743ece164cce44d334a56a","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/14a0fb119e4db8bf48743ece164cce44d334a56a","html_url":"https://github.com/langchain-ai/deepagents/commit/14a0fb119e4db8bf48743ece164cce44d334a56a"}]},{"sha":"14a0fb119e4db8bf48743ece164cce44d334a56a","node_id":"C_kwDOPTymldoAKDE0YTBmYjExOWU0ZGI4YmY0ODc0M2VjZTE2NGNjZTQ0ZDMzNGE1NmE","commit":{"author":{"name":"github-actions[bot]","email":"41898282+github-actions[bot]@users.noreply.github.com","date":"2026-06-29T20:55:33Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-29T20:55:33Z"},"message":"release(deepagents-code): 0.1.28 (#4330)\n\n> [!CAUTION]\n> Merging this PR will automatically publish to **PyPI** and create a\n**GitHub release**.\n\nFor the full release process, see\n[`.github/RELEASING.md`](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md).\n\n---\n\n_Everything below this line will be the GitHub release body._\n\n---\n\n\n##\n[0.1.28](https://github.com/langchain-ai/deepagents/compare/deepagents-code==0.1.27...deepagents-code==0.1.28)\n(2026-06-29)\n\n### Features\n\n* Add Fireworks session settings\n([#4360](https://github.com/langchain-ai/deepagents/issues/4360))\n([90ebb1d](https://github.com/langchain-ai/deepagents/commit/90ebb1d68cb5942f07847f6dce48c14c7caef992))\n* `RubricMiddleware` implementation (`/goal`/`--goal` and\n`/rubric`/`--rubric`)\n* Add rubric-backed goal workflow\n([#4365](https://github.com/langchain-ai/deepagents/issues/4365))\n([8fca61d](https://github.com/langchain-ai/deepagents/commit/8fca61dc036888a4414ff5a4536b957c63dab4a5))\n* Non-interactive rubric grading flags\n([#4305](https://github.com/langchain-ai/deepagents/issues/4305))\n([1bcb112](https://github.com/langchain-ai/deepagents/commit/1bcb112ee78138eca9cb400c206ce198322aae32))\n* Adopt coding-agent-v1 trace metadata\n([#4367](https://github.com/langchain-ai/deepagents/issues/4367))\n([cb39747](https://github.com/langchain-ai/deepagents/commit/cb3974748024fcec2e2ee0ccc0a9b23c880733a2))\n* Quit shortcut on completed update modal\n([#4312](https://github.com/langchain-ai/deepagents/issues/4312))\n([5e6eae9](https://github.com/langchain-ai/deepagents/commit/5e6eae9f094a5167b6bf01f2d84cf06ca5cd80c3))\n\n### Bug Fixes\n\n* Redact LangSmith trace secrets by default\n([#4356](https://github.com/langchain-ai/deepagents/issues/4356))\n([5e01fec](https://github.com/langchain-ai/deepagents/commit/5e01fec72d8b179a3b075b07268162d2eaebfe84))\n* Honor Baseten base URL env precedence\n([#4328](https://github.com/langchain-ai/deepagents/issues/4328))\n([8f20d74](https://github.com/langchain-ai/deepagents/commit/8f20d74892112c3b88aaca63d8c04a355fd6726f))\n* Highlight just-installed provider on `/auth` reopen\n([#4311](https://github.com/langchain-ai/deepagents/issues/4311))\n([85e47b5](https://github.com/langchain-ai/deepagents/commit/85e47b532b5caf92a52f1a070a95bdb39bee6d3d))\n* Clear transient update launch status\n([#4355](https://github.com/langchain-ai/deepagents/issues/4355))\n([b870b18](https://github.com/langchain-ai/deepagents/commit/b870b18750f65442009028a85a2ac18f1b06640c))\n* Clearer MCP config JSON parse errors\n([#4327](https://github.com/langchain-ai/deepagents/issues/4327))\n([9cee602](https://github.com/langchain-ai/deepagents/commit/9cee60274d38d4ad8a2d7a7e9d3ae59aebce5261))\n* Record shell output as user context\n([#4353](https://github.com/langchain-ai/deepagents/issues/4353))\n([0d504a5](https://github.com/langchain-ai/deepagents/commit/0d504a5df8454e871597932ce1cd3e95b10ab00e))\n* Suppress expected MCP reauth logs\n([#4359](https://github.com/langchain-ai/deepagents/issues/4359))\n([15ee384](https://github.com/langchain-ai/deepagents/commit/15ee384117ccd955f7481346dd92b7f4b007a60d))\n\n### Performance Improvements\n\n* Background refresh for `@` file completion cache\n([#3911](https://github.com/langchain-ai/deepagents/issues/3911))\n([aa22d6b](https://github.com/langchain-ai/deepagents/commit/aa22d6b6d5a49e4d6c3aa2d4932df75d14d65f78))\n* Speed up shutdown after `Ctrl+C`/`Ctrl+D`\n([#4351](https://github.com/langchain-ai/deepagents/issues/4351))\n([db441ed](https://github.com/langchain-ai/deepagents/commit/db441ed306a8e03fb68f2ae6a2c08523e248976d))\n\n---\n\n_Everything above this line will be the GitHub release body._\n\n---\n\n> [!NOTE]\n> A **New Contributors** section is appended to the GitHub release notes\nautomatically at publish time (see [Release\nPipeline](https://github.com/langchain-ai/deepagents/blob/main/.github/RELEASING.md#release-pipeline),\nstep 2).\n\n---------\n\nCo-authored-by: github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","tree":{"sha":"be25e2d5c0513c126cbcd8ebec84d5f70aea2971","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/be25e2d5c0513c126cbcd8ebec84d5f70aea2971"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/14a0fb119e4db8bf48743ece164cce44d334a56a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqQtvFCRC1aQ7uu5UhlAAAqtUQAANMrGVW+37A7+ZniMqX9jk4\n03TbM+t2NheenmzA3rCIS8R5lQyDd++RdHBjP9smfQonbV7cc5fr8KWc885bofjR\ne3+aJAULbMWwdrADfoZWsIJ7ATdDjP3QhIDZNb6CG2laUezbeAM7TkH3ugePh81J\nwFt8/qlpwmwXmfhDpJeP7MoqGDZW3oMBJ4IvCLRdBZD9r/kAdbOn+nfZhjTODBXK\nPEsNASs2aDg