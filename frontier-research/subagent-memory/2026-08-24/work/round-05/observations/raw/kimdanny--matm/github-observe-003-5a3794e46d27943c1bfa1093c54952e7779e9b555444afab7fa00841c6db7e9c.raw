{"sha":"2fb906b1a572f9ced0177741dee44be70ef1223c","node_id":"C_kwDOS5_obdoAKDJmYjkwNmIxYTU3MmY5Y2VkMDE3Nzc0MWRlZTQ0YmU3MGVmMTIyM2M","commit":{"author":{"name":"kimdanny","email":"dannykim153@gmail.com","date":"2026-06-19T00:54:08Z"},"committer":{"name":"kimdanny","email":"dannykim153@gmail.com","date":"2026-06-19T00:54:08Z"},"message":"code release","tree":{"sha":"235f3c4eccd28f0bbe9611bd69ec18c08fdc06c1","url":"https://api.github.com/repos/kimdanny/matm/git/trees/235f3c4eccd28f0bbe9611bd69ec18c08fdc06c1"},"url":"https://api.github.com/repos/kimdanny/matm/git/commits/2fb906b1a572f9ced0177741dee44be70ef1223c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/kimdanny/matm/commits/2fb906b1a572f9ced0177741dee44be70ef1223c","html_url":"https://github.com/kimdanny/matm/commit/2fb906b1a572f9ced0177741dee44be70ef1223c","comments_url":"https://api.github.com/repos/kimdanny/matm/commits/2fb906b1a572f9ced0177741dee44be70ef1223c/comments","author":{"login":"kimdanny","id":34687639,"node_id":"MDQ6VXNlcjM0Njg3NjM5","avatar_url":"https://avatars.githubusercontent.com/u/34687639?v=4","gravatar_id":"","url":"https://api.github.com/users/kimdanny","html_url":"https://github.com/kimdanny","followers_url":"https://api.github.com/users/kimdanny/followers","following_url":"https://api.github.com/users/kimdanny/following{/other_user}","gists_url":"https://api.github.com/users/kimdanny/gists{/gist_id}","starred_url":"https://api.github.com/users/kimdanny/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kimdanny/subscriptions","organizations_url":"https://api.github.com/users/kimdanny/orgs","repos_url":"https://api.github.com/users/kimdanny/repos","events_url":"https://api.github.com/users/kimdanny/events{/privacy}","received_events_url":"https://api.github.com/users/kimdanny/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"kimdanny","id":34687639,"node_id":"MDQ6VXNlcjM0Njg3NjM5","avatar_url":"https://avatars.githubusercontent.com/u/34687639?v=4","gravatar_id":"","url":"https://api.github.com/users/kimdanny","html_url":"https://github.com/kimdanny","followers_url":"https://api.github.com/users/kimdanny/followers","following_url":"https://api.github.com/users/kimdanny/following{/other_user}","gists_url":"https://api.github.com/users/kimdanny/gists{/gist_id}","starred_url":"https://api.github.com/users/kimdanny/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kimdanny/subscriptions","organizations_url":"https://api.github.com/users/kimdanny/orgs","repos_url":"https://api.github.com/users/kimdanny/repos","events_url":"https://api.github.com/users/kimdanny/events{/privacy}","received_events_url":"https://api.github.com/users/kimdanny/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[],"stats":{"total":232443,"additions":232443,"deletions":0},"files":[{"sha":"45752b0c8c5adadee670ad174df80444487ee2d6","filename":".env.example","status":"added","additions":28,"deletions":0,"changes":28,"blob_url":"https://github.com/kimdanny/matm/blob/2fb906b1a572f9ced0177741dee44be70ef1223c/.env.example","raw_url":"https://github.com/kimdanny/matm/raw/2fb906b1a572f9ced0177741dee44be70ef1223c/.env.example","contents_url":"https://api.github.com/repos/kimdanny/matm/contents/.env.example?ref=2fb906b1a572f9ced0177741dee44be70ef1223c","patch":"@@ -0,0 +1,28 @@\n+# MATM environment configuration\n+# Copy this file to .env and edit the values for your setup.\n+\n+# Root directory for environment data, indices, and trajectory logs.\n+# Preprocess, index-build, and evaluation scripts resolve paths relative\n+# to this root (e.g., ${MATM_DATA_ROOT}/train_only_lancedb/alfworld/lancedb_indices).\n+MATM_DATA_ROOT=./environments\n+\n+# OpenRouter API key (required for LLM-based evaluation)\n+OPENROUTER_API_KEY=your_openrouter_api_key_here\n+\n+# WebArena hostname (required only for WebArena evaluation)\n+# WEBARENA_HOST=your-webarena-host.example.com\n+\n+# Absolute path to your local clone of the upstream WebArena repo, used by\n+# run_webarena.py to import the upstream `browser_env` package\n+# (required only for WebArena evaluation; see requirements-webarena.txt).\n+# WEBARENA_RENEW_WEBARENA_PATH=/abs/path/to/webarena\n+\n+# Push successful runtime trajectories into the shared LanceDB index (0/1)\n+# ONLINE_MEMORY_ENABLED=0\n+\n+# SVMRank binaries (shipped in ltr/svm_rank/; override if installed elsewhere)\n+# SVMRANK_BIN_DIR=./ltr/svm_rank\n+\n+# Optional overrides for LTR data-generation scripts\n+# ALFWORLD_LANCEDB_PATH=${MATM_DATA_ROOT}/train_only_lancedb/alfworld/lancedb_indices\n+# WEBARENA_LANCEDB_PATH=${MATM_DATA_ROOT}/train_only_lancedb/webarena/lancedb_indices"},{"sha":"3eea4f7c1b7994a1f85b303f047af56ae09c1f95","filename":".gitignore","status":"added","additions":70,"deletions":0,"changes":70,"blob_url":"https://github.com/kimdanny/matm/blob/2fb906b1a572f9ced0177741dee44be70ef1223c/.gitignore","raw_url":"https://github.com/kimdanny/matm/raw/2fb906b1a572f9ced0177741dee44be70ef1223c/.gitignore","contents_url":"https://api.github.com/repos/kimdanny/matm/contents/.gitignore?ref=2fb906b1a572f9ced0177741dee44be70ef1223c","patch":"@@ -0,0 +1,70 @@\n+.idea/**\n+.DS_Store\n+.vscode/\n+__pycache__/\n+*.pyc\n+*.pyo\n+build/\n+\n+\n+# Project-specific\n+paper/\n+logs/\n+trajectory_runs/\n+hf_dataset/\n+export_trajectories.py\n+results-analysis/\n+\n+# Reproducible large derived data files\n+traj_retrieval/evaluation/ltr_data/**/*disagreements*.json\n+traj_retrieval/evaluation/ltr_data/**/*simulation_compare*.json\n+# Orphan raw-split dumps from earlier experiment runs; no script reads them\n+# and the WebArena entries embed live hostnames. Regenerate locally if needed.\n+traj_retrieval/evaluation/ltr_data/raw_splits/\n+\n+# no_retrieval_runs JSONs feed the simulate_till_tk /\n+# pseudo_simulate_till_closest_tk strategies. Ship the two canonical\n+# per-env files; keep experiment-specific runs local.\n+traj_retrieval/preprocess/no_retrieval_runs/*.json\n+!traj_retrieval/preprocess/no_retrieval_runs/alfworld_no_retrieval_runs_results.json\n+!traj_retrieval/preprocess/no_retrieval_runs/webarena_no_retrieval_runs_results.json\n+traj_retrieval/preprocess/no_retrieval_runs/openrouter34_s42_webarena/\n+\n+# Experiment-specific split allocations\n+traj_retrieval/preprocess/new_splits/alfworld/official_test/openrouter34_rr_s42/\n+traj_retrieval/preprocess/new_splits/alfworld/simulation/openrouter34_s42/\n+traj_retrieval/preprocess/new_splits/alfworld/train/openrouter34_s42/\n+traj_retrieval/preprocess/new_splits/webarena/simulation/openrouter34_s42/\n+traj_retrieval/preprocess/new_splits/webarena/train/openrouter34_s42/\n+\n+# Generated analysis outputs (reproducible)\n+traj_retrieval/evaluation/analysis/pairwise_ltr_analysis.json\n+traj_retrieval/evaluation/analysis/utility_retrieval_analysis.json\n+traj_retrieval/evaluation/analysis/paired_tests/paired_t_test_results.json\n+traj_retrieval/preprocess/new_splits/**/*_report.json\n+traj_retrieval/preprocess/new_splits/**/*_manifest.json\n+traj_retrieval/evaluation/ltr_data/**/similarity_distributions.png\n+traj_retrieval/evaluation/ltr_data/**/similarity_analysis.json\n+\n+# Local LTR variants that don't ship; the canonical ltr/data_out/{alfworld,webarena}/\n+# TSVs ARE tracked so the retrieval runtime can read feature column order.\n+ltr/data_out_llm_features_new/\n+\n+# Environment data is generated by setup_environments.py and per-run scripts,\n+# so it's gitignored — except for the canonical ALFWorld config that the\n+# runner needs at startup (loaded by traj_retrieval/core/alfworld_handler.py).\n+.env\n+environments/*\n+!environments/alfworld/\n+environments/alfworld/*\n+!environments/alfworld/base_config.yaml\n+\n+# Secrets\n+*.pem\n+*_key\n+*_key.pub\n+\n+# AI Assistant\n+PLAN.md\n+CLAUDE.md\n+.claude/"},{"sha":"7d48