ub.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"6652e82dd0ce655d96036bb7a9242247c3f7e83f","url":"https://api.github.com/repos/openai/codex/commits/6652e82dd0ce655d96036bb7a9242247c3f7e83f","html_url":"https://github.com/openai/codex/commit/6652e82dd0ce655d96036bb7a9242247c3f7e83f"}]},{"sha":"6652e82dd0ce655d96036bb7a9242247c3f7e83f","node_id":"C_kwDOOYsS4doAKDY2NTJlODJkZDBjZTY1NWQ5NjAzNmJiN2E5MjQyMjQ3YzNmN2U4M2Y","commit":{"author":{"name":"Peter Bakkum","email":"pbbakkum@gmail.com","date":"2026-06-12T18:11:13Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T18:11:13Z"},"message":"realtime: add AVAS architecture override (#27720)\n\n## Summary\n\nAdds a `RealtimeConversationArchitecture` option for realtime\nconversation startup, with `realtimeapi` as the default and `avas` as an\nopt-in architecture.\n\nThe AVAS path is limited to realtime v1 conversational WebRTC starts,\nand WebRTC call creation appends `intent=quicksilver&architecture=avas`\nto `/v1/realtime/calls`. The existing sideband websocket still joins by\n`call_id`.\n\nThis also exposes the per-session architecture override through\napp-server v2 `thread/realtime/start` params and updates the config\nschema for `[realtime].architecture`.\n\n## Validation\n\n- `just fmt`\n- `just write-config-schema`\n- `just test -p codex-api sends_avas_session_call_query_params`\n- `just test -p codex-core -E\n'test(~conversation_webrtc_start_uses_avas_architecture_query)'`\n- `just test -p codex-core -E 'test(realtime_loads_from_config_toml)'`\n- `just test -p codex-app-server-protocol -E\n'test(~serialize_thread_realtime_start) |\ntest(generated_ts_optional_nullable_fields_only_in_params)'`\n- `just test -p codex-app-server -E\n'test(realtime_webrtc_start_emits_sdp_notification)'`","tree":{"sha":"fcb44032071fed981116435d8659b54b8c1e9766","url":"https://api.github.com/repos/openai/codex/git/trees/fcb44032071fed981116435d8659b54b8c1e9766"},"url":"https://api.github.com/repos/openai/codex/git/commits/6652e82dd0ce655d96036bb7a9242247c3f7e83f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqLEvBCRC1aQ7uu5UhlAAAEY8QABQ8Y0+08g1c6cVsgcOCyaUO\nSKt8UoDOA84vx8CcKkIrjwy7VMJxNdZV5emQLi8d0uHPIaW57rqvL3d9XWQSLFKi\nANvM0m0xkrfZ2m1TB93wOLplVcMroBN8qBq0TGkWPkbie1QHIda5hw5gRE6T50B9\ndhllNneuhTffwBRVuAN+TEz1bappwbPV3tm9QC3aHdrLa3wAP/62nrB47jYHqtVX\ncLxJAs6QS1eN4y8MEHxyJAcD4gOmPLpnu0Len+e3VJcfUDFh5T/q5etW3ZsA47xz\nJ3liQvnXj5KiK6SrQ/CqvX1kgn/ACIGAqPYT43mhFTflPtFY3+2NNeAQVe51aXAW\nL3LAV+gBexH65UB6+Rr34zIa9C7hXkLa+dVKbIwTQlhd7E9sSLXtTxgRV4XJhYu2\nqE9ys9oDMmeHmtADzLDnB7rsIRLNwxRjXSx8dSmtKqvN/PtROi9SVT4tMbCPYVGE\ngVn0ACGn+oWDF7PGJuYV/MN9mI58oP1ZUtfEE/Rnpmq7D63De0PbYHc7e3aQN1A0\n/DqVoJLDgam+KATsV4Oz8J31xvqF97kIXBZM8LBtr9Kkt9xsRXcQjz6ffN7evBTj\nABUW57wVBvpPOKE5jCPXLPsmD4iyW/Me1+49OH94NXKU75KvNG9YcMd6Tf3Y3PYl\nVdb9vcxzhy9uz6SvoLO0\n=4tlj\n-----END PGP SIGNATURE-----\n","payload":"tree fcb44032071fed981116435d8659b54b8c1e9766\nparent 94427aaf46fadfe4228fbcffdc85b94fe7ef6341\nauthor Peter Bakkum <pbbakkum@gmail.com> 1781287873 -0700\ncommitter GitHub <noreply@github.com> 1781287873 +0000\n\nrealtime: add AVAS architecture override (#27720)\n\n## Summary\n\nAdds a `RealtimeConversationArchitecture` option for realtime\nconversation startup, with `realtimeapi` as the default and `avas` as an\nopt-in architecture.\n\nThe AVAS path is limited to realtime v1 conversational WebRTC starts,\nand WebRTC call creation appends `intent=quicksilver&architecture=avas`\nto `/v1/realtime/calls`. The existing sideband websocket still joins by\n`call_id`.\n\nThis also exposes the per-session architecture override through\napp-server v2 `thread/realtime/start` params and updates the config\nschema for `[realtime].architecture`.\n\n## Validation\n\n- `just fmt`\n- `just write-config-schema`\n- `just test -p codex-api sends_avas_session_call_query_params`\n- `just test -p codex-core -E\n'test(~conversation_webrtc_start_uses_avas_architecture_query)'`\n- `just test -p codex-core -E 'test(realtime_loads_from_config_toml)'`\n- `just test -p codex-app-server-protocol -E\n'test(~serialize_thread_realtime_start) |\ntest(generated_ts_optional_nullable_fields_only_in_params)'`\n- `just test -p codex-app-server -E\n'test(realtime_webrtc_start_emits_sdp_notification)'`","verified_at":"2026-06-12T18:11:13Z"}},"url":"https://api.github.com/repos/openai/codex/commits/6652e82dd0ce655d96036bb7a9242247c3f7e83f","html_url":"https://github.com/openai/codex/commit/6652e82dd0ce655d96036bb7a9242247c3f7e83f","comments_url":"https://api.github.com/repos/openai/codex/commits/6652e82dd0ce655d96036bb7a9242247c3f7e83f/comments","author":{"login":"bakks","id":1172710,"node_id":"MDQ6VXNlcjExNzI3MTA=","avatar_url":"https://avatars.githubusercontent.com/u/1172710?v=4","gravatar_id":"","url":"https://api.github.com/users/bakks","html_url":"https://github.com/bakks","followers_url":"https://api.github.com/users/bakks/followers","following_url":"https://api.github.com/users/bakks/following{/other_user}","gists_url":"https://api.github.com/users/bakks/gists{/gist_id}","starred_url":"https://api.github.com/users/bakks/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bakks/subscriptions","organizations_url":"https://api.github.com/users/bakks/orgs","repos_url":"https://api.github.com/users/bakks/repos","events_url":"https://api.github.com/users/bakks/events{/privacy}","received_events_url":"https://api.github.com/users/bakks/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"94427aaf46fadfe4228fbcffdc85b94fe7ef6341","url":"https://api.github.com/repos/openai/codex/commits/94427aaf46fadfe4228fbcffdc85b94fe7ef6341","html_url":"https://github.com/openai/codex/commit/94427aaf46fadfe4228fbcffdc85b94fe7ef6341"}]}]