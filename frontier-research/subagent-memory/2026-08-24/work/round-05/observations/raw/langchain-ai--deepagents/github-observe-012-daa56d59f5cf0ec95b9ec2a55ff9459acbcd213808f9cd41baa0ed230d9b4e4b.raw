tps://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"9300013c39de572ccdd40424fdbb2aba1d829907","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9300013c39de572ccdd40424fdbb2aba1d829907","html_url":"https://github.com/langchain-ai/deepagents/commit/9300013c39de572ccdd40424fdbb2aba1d829907"}]},{"sha":"9300013c39de572ccdd40424fdbb2aba1d829907","node_id":"C_kwDOPTymldoAKDkzMDAwMTNjMzlkZTU3MmNjZGQ0MDQyNGZkYmIyYWJhMWQ4Mjk5MDc","commit":{"author":{"name":"Sydney Runkle","email":"54324534+sydney-runkle@users.noreply.github.com","date":"2026-07-02T06:44:02Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-02T06:44:02Z"},"message":"docs(repo): add repo search routing guidance (#3999)\n\nAdds Deep Agents SDK routing guidance and search hygiene notes to the\nrepo context so agents start from targeted SDK paths and avoid broad\nsearches over virtualenvs, worktrees, and generated files.\n\n---------\n\nSigned-off-by: Mason Daugherty <github@mdrxy.com>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>","tree":{"sha":"0299e3a14f18b97ecf5df9268d4b4c7a54ef0dca","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/0299e3a14f18b97ecf5df9268d4b4c7a54ef0dca"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/9300013c39de572ccdd40424fdbb2aba1d829907","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqRgiyCRC1aQ7uu5UhlAAAzsIQAGbbyS5CAwvAS/F+I7fD2HaA\nXnY1mcWSuqQir3C9QUNXnZmuV/3MF/0f4GVUihv/DBrWLjqRCESqSJ4CmJzXc+s7\n8kBq7NOCXWawpPHZaTgXZ9isyToOHXQyKFwNxpC7s+Sn01Y/4cqPKxoRb+Cb9tPm\neJ03n+w4U9ILUuvddMIvsj9P8KYUPE3b6KYzVyMhLItGyej1K7KY6KLq3EOAORrQ\nd6aPInH+Awovrv5R1pPOBY/holt/YVehNds10Ny40gMZXY5f+oPJY2+S4XvnKjMN\ndiOyi5Z0chPSNqVtdPP7DrsJgL9LsgcX50ub1RjDpnWMtRL2BhvRm6KbB7nLl3EX\nZSRZaHSjphI2uOnDRkhHbpfJPq1H/bR6Rl3Di5BxcKub+JIOOtMt0I/uYLTdAQ+u\nfJP+NAm/owBdoRMsF9n3SJeuEAAErxOze4lUgaa6+HE0HuMqWSvaDsChyKblknt1\n5j8C5diNr6fF4OiApnPAvT86LvK5AhjjiEcjIVPzw0N8yU3widlb7L7uWdiOlNcS\nXCxw4QlMZRDsxOpaPUFRmDhDDYvZOa/MR4D3J1OcVFbmRm56+TO0tN8ooQRSWhlH\nVlf6WF2xejxMCZ2h29JT0uG02BO1iIwy+xmL8arnZCi1TPp2ENGfG04N9FWMjD1F\ndfJMqv38P5ECZJZe6wZZ\n=DkRN\n-----END PGP SIGNATURE-----\n","payload":"tree 0299e3a14f18b97ecf5df9268d4b4c7a54ef0dca\nparent 7cc4e9f9bda5a8ae42bb072b82b634ad8c39ade1\nauthor Sydney Runkle <54324534+sydney-runkle@users.noreply.github.com> 1782974642 -0400\ncommitter GitHub <noreply@github.com> 1782974642 -0400\n\ndocs(repo): add repo search routing guidance (#3999)\n\nAdds Deep Agents SDK routing guidance and search hygiene notes to the\nrepo context so agents start from targeted SDK paths and avoid broad\nsearches over virtualenvs, worktrees, and generated files.\n\n---------\n\nSigned-off-by: Mason Daugherty <github@mdrxy.com>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>","verified_at":"2026-07-02T06:44:03Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9300013c39de572ccdd40424fdbb2aba1d829907","html_url":"https://github.com/langchain-ai/deepagents/commit/9300013c39de572ccdd40424fdbb2aba1d829907","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9300013c39de572ccdd40424fdbb2aba1d829907/comments","author":{"login":"sydney-runkle","id":54324534,"node_id":"MDQ6VXNlcjU0MzI0NTM0","avatar_url":"https://avatars.githubusercontent.com/u/54324534?v=4","gravatar_id":"","url":"https://api.github.com/users/sydney-runkle","html_url":"https://github.com/sydney-runkle","followers_url":"https://api.github.com/users/sydney-runkle/followers","following_url":"https://api.github.com/users/sydney-runkle/following{/other_user}","gists_url":"https://api.github.com/users/sydney-runkle/gists{/gist_id}","starred_url":"https://api.github.com/users/sydney-runkle/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sydney-runkle/subscriptions","organizations_url":"https://api.github.com/users/sydney-runkle/orgs","repos_url":"https://api.github.com/users/sydney-runkle/repos","events_url":"https://api.github.com/users/sydney-runkle/events{/privacy}","received_events_url":"https://api.github.com/users/sydney-runkle/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7cc4e9f9bda5a8ae42bb072b82b634ad8c39ade1","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7cc4e9f9bda5a8ae42bb072b82b634ad8c39ade1","html_url":"https://github.com/langchain-ai/deepagents/commit/7cc4e9f9bda5a8ae42bb072b82b634ad8c39ade1"}]},{"sha":"7cc4e9f9bda5a8ae42bb072b82b634ad8c39ade1","node_id":"C_kwDOPTymldoAKDdjYzRlOWY5YmRhNWE4YWU0MmJiMDcyYjgyYjYzNGFkOGMzOWFkZTE","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-02T06:34:16Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-02T06:34:16Z"},"message":"fix(code): show loading state during model switch (#4209)\n\nShow an animated loading indicator in the status bar while switching\nmodels, so slow provider switches no longer appear to hang.\n\n---\n\nSwitching to a heavy provider (e.g. `google_genai`) imports a large\npackage during model creation, which previously gave no feedback and\nmade the switch look frozen. The heavy work already runs off the event\nloop in a worker thread, so this adds the missing visual feedback rather\nthan changing the threading model.\n\nA shared animated busy indicator is added to `StatusBar` (`set_busy`)\nthat reuses the existing connection spinner machinery, and\n`_switch_model` drives it around the threaded model creation. The\nindicator is cleared in a `finally` block so the status slot can never\nget stuck after a failed or successful switch, and regular status\nmessages are restored once it clears.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/c4a420f3-6b03-f87a-cf70-eb26b4366b09)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"16df7064acbe4d338bbd6ea4c8ed63ba569e6758","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/16df7064acbe4d338bbd6ea4c8ed63ba569e6758"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/7cc4e9f9bda5a8ae42bb072b82b634ad8c39ade1","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqRgZoCRC1aQ7uu5UhlAAAeZ4QACXNlnjw3yOtKYom0c5O7pRH\nKgi2CpexcufgY2pb3Acrhu+wKwzEl06AI9SPPAl96FxOQsBkEJ8waCpKGOLsaRck\nJ6vVypm8xrj4fHEDMKAZFZ5r0s1qb1/ntUu0Mpw1V/g31MFpnHJ+bXMK1g2uwHNw\n+P82q9NdbBJlQ7mmqBpR4FZNV4d5xxSLiPyubmD+5OOQtVwsFw5k71ulVlOmZH0a\nkSOhhQt7jShy+2pMq97fAIDgzCoW68AdH9m7ZWbS9AZ/u64c1/i5VXsjYaD3i1Mr\niYNdgotdfzjwLOFtS7xiwE3PIHZhOLiI7X0fwoIcpDL7ir9ujzpKqA9CouHokO9I\nKqjNZ3v1jheVnLpBsVswVy2Jh8xh34BObt9IzoiAGfqMa15otaKhV0hqazU5gr9H\noudgW3QLY93HLVIV53/Ulbh08l/tKA5O6GAlluV8gBheVmAjC4kyZvJEl/JEd7Ru\nGIUjx7fWSDCf2H9W+sTcOJsIJfE7Oj/B62QRmLJV78EF51belY3yJz180bv+PBB3\n8uqNEuy/0ZVC7t5K+n649sTl1pY+kuuSVRM14OQIZkkRMBy1qnU6RRRLeAKztcnb\nNabZ0ET2T/TlRKJxFTCzvWrIpjSeN71w4IkughsGiXco35Nl9kM2PeOxiU2VyMvA\nUVRym8eO0uckRdMiXtni\n=GDet\n-----END PGP SIGNATURE-----\n","payload":"tree 16df7064acbe4d338bbd6ea4c8ed63ba569e6758\nparent b927147d026749c6c790bb06c9853515dabf579c\nauthor Mason Daugherty <mason@langchain.dev> 1782974056 -0400\ncommitter GitHub <noreply@github.com> 1782974056 -0400\n\nfix(code): show loading state during model switch (#4209)\n\nShow an animated loading indicator in the status bar while switching\nmodels, so slow provider switches no longer appear to hang.\n\n---\n\nSwitching to a heavy provider (e.g. `google_genai`) imports a large\npackage during model creation, which previously gave no feedback and\nmade the switch look frozen. The heavy work already runs off the event\nloop in a worker thread, so this adds the missing visual feedback rather\nthan changing the threading model.\n\nA shared animated busy indicator is added to `StatusBar` (`set_busy`)\nthat reuses the existing connection spinner machinery, and\n`_switch_model` drives it around the threaded model creation. The\nindicator is cleared in a `finally` block so the status slot can never\nget stuck after a failed or successful switch, and regular status\nmessages are restored once it clears.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/c4a420f3-6b03-f87a-cf70-eb26b4366b09)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-07-02T06:34:17Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7cc4e9f9bda5a8ae42bb072b82b634ad8c39ade1","html_url":"https://github.com/langchain-ai/deepagents/commit/7cc4e9f9bda5a8ae42bb072b82b634ad8c39ade1","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7cc4e9f9bda5a8ae42bb072b82b634ad8c39ade1/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b927147d026749c6c790bb06c9853515dabf579c","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/b927147d026749c6c790bb06c9853515dabf579c","html_url":"https://github.com/langchain-ai/deepagents/commit/b927147d026749c6c790bb06c9853515dabf579c"}]},{"sha":"b927147d026749c6c790bb06c9853515dabf579c","node_id":"C_kwDOPTymldoAKGI5MjcxNDdkMDI2NzQ5YzZjNzkwYmIwNmM5ODUzNTE1ZGFiZjU3OWM","commit":{"author":{"name":"John Kennedy","email":"65985482+jkennedyvz@users.noreply.github.com","date":"2026-07-02T06:32:52Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-02T06:32:52Z"},"message":"feat(sdk): optional video frame extraction on `read_file` (#4094)\n\nAdds video frame extraction to the `read_file` tool, gated behind the\noptional `deepagents[video]` extra.\n\n> [!IMPORTANT]\n> Per the LangChain [alpha API\npolicy](https://docs.langchain.com/oss/python/versioning#alpha-apis),\nthis feature is experimental and subject to changes. It should be used\ncautiously in production environments while we learn from real\nvideo-read workflows.\n\n## User stories\n\nA user with `deepagents[video]` installed can ask an agent to inspect a\nvideo file through `read_file`, including on models that do not accept\nprovider-native video blocks. The file is decoded with a PyAV/Pillow\nbackend, sampled into JPEG frames, and attached to the next model\nrequest as a synthetic human message after the tool result.\n\nThe `read_file` tool result itself stays text-only: the `ToolMessage`\nonly reports that frames were sampled, while the image content blocks\nlive in the synthetic follow-up message. This keeps the tool response\ncompatible with providers that require tool outputs to be plain text.\n\nA user _without_ `deepagents[video]` installed _will not_ see the\nframe-extraction behavior or video-specific tool guidance. Inline\nuser-supplied video handling is unchanged by this PR; model capability\nguidance continues to come from the configured model profile.\n\n## Behavior with the extra installed\n\nWhen video dependencies are available, `read_file` treats video reads as\nframe-extraction requests:\n\n- `offset` is interpreted as seconds into the source video.\n- `limit` is interpreted as the number of seconds to sample.\n- Sampling remains fixed, so agents can inspect narrower windows when\nthey need more temporal detail.\n- `.mkv` is included as a video extension for this gated path.\n\nResource controls cover raw input size, frame count, emitted bytes,\ndecode time, and frame dimensions. The raw video input cap is now 1 GiB,\nand oversized sampled frames are downscaled before JPEG encoding instead\nof rejecting normal high-resolution videos.\n\n## Behavior without the extra installed\n\nWhen video dependencies are unavailable, the new frame-extraction\nfeature stays dormant:\n\n- `read_file` does not attempt frame extraction.\n- Existing video files continue through the generic multimodal\ncontent-block path.\n- `.mkv` is read as binary by backends, then returned as a generic file\nblock instead of sampled video frames.\n- The `read_file` tool help keeps the previous text/image/PDF guidance\ninstead of describing video seconds-based pagination.\n\nUltimately, the SDK maintains behavior as identical to prior to this PR.\n\n## Example\n\n<img width=\"1668\" height=\"785\" alt=\"Screenshot 2026-06-23 at 1 12 52 AM\"\nsrc=\"https://github.com/user-attachments/assets/cb460696-5e1e-40b8-83da-58b7c19e73cc\"\n/>\n\n---------\n\nCo-authored-by: deepagents <[email protected]>\nCo-authored-by: Claude Code <action@github.com>\nCo-authored-by: Deep Agent <agent@deepagents.dev>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","tree":{"sha":"dd6f426b05f782cd4170bcda840f842b962c61ca","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/dd6f426b05f782cd4170bcda840f842b962c61ca"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/b927147d026749c6c790bb06c9853515dabf579c","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqRgYUCRC1aQ7uu5UhlAAA14QQAFA+ZhI5AwD8qNgHs8O/Pafk\n4DWWqWWff9DZhF4+Evl3UvXhmwFIq9uLhPTR2ajG86IKtTAobbPMy1mbx8AvE2aN\nR3FTxZNuhV0wDpbtdewf4ble/yocwrpKpbjY+ymgxw4cqVfU6NJu5Oq/SAUtGXOc\ny4X9rpJkDm0Ha+1LMvI5PwW/OH3eV0cREZ33V3Waexl1e/WUB6C6BnUhzGcaXU3t\noHlsSzdB/u+w0M0dTlQZOP+b52Unu30S02txz9FY78pBvRO3UwEyBceedI2eLYjb\nfYYvtAYphWvUQ8HidIC9hP1G/t8n4VxG9sG1C5WhP1b76IZoh/ggWZ0Nmqo05J2e\nOFVncAlBadmF82EbBX9Ako52FGV7DIh6vKQ9SZ9WRLQtdQ3TOH0AmWlfZ3B/AG6Z\norIzcOk7wqtt9VAWcJ8r1dU1qJRqThCdujaoKR93ebmMJTIQh4twOmxAv8W6ylyj\nbdpdaLlhK06wDkblQK23GtRw9jrs3dxhJfWLrqIvDEsguHaHsTEA3qYs5d1RuPpZ\n85jf5nqZFduaXw2O6iHjaACImrbfy6vCwXExKEZUje819Gu38oh9WelY93THYeP2\nHGX1CVUexhNIIhExDmIZzwaxxrPrLMOa5YybO9qRaDv87pa+4cqbNCiupxiNPjvw\ny2tMJ8NAUFlxmeruy2+m\n=UXJd\n-----END PGP SIGNATURE-----\n","payload":"tree dd6f426b05f782cd4170bcda840f842b962c61ca\nparent b2adcce24fee6132892c2c5b30bbfc3501698d4f\nauthor John Kennedy <65985482+jkennedyvz@users.noreply.github.com> 1782973972 -0700\ncommitter GitHub <noreply@github.com> 1782973972 -0700\n\nfeat(sdk): optional video frame extraction on `read_file` (#4094)\n\nAdds video frame extraction to the `read_file` tool, gated behind the\noptional `deepagents[video]` extra.\n\n> [!IMPORTANT]\n> Per the LangChain [alpha API\npolicy](https://docs.langchain.com/oss/python/versioning#alpha-apis),\nthis feature is experimental and subject to changes. It should be used\ncautiously in production environments while we learn from real\nvideo-read workflows.\n\n## User stories\n\nA user with `deepagents[video]` installed can ask an agent to inspect a\nvideo file through `read_file`, including on models that do not accept\nprovider-native video blocks. The file is decoded with a PyAV/Pillow\nbackend, sampled into JPEG frames, and attached to the next model\nrequest as a synthetic human message after the tool result.\n\nThe `read_file` tool result itself stays text-only: the `ToolMessage`\nonly reports that frames were sampled, while the image content blocks\nlive in the synthetic follow-up message. This keeps the tool response\ncompatible with providers that require tool outputs to be plain text.\n\nA user _without_ `deepagents[video]` installed _will not_ see the\nframe-extraction behavior or video-specific tool guidance. Inline\nuser-supplied video handling is unchanged by this PR; model capability\nguidance continues to come from the configured model profile.\n\n## Behavior with the extra installed\n\nWhen video dependencies are available, `read_file` treats video reads as\nframe-extraction requests:\n\n- `offset` is interpreted as seconds into the source video.\n- `limit` is interpreted as the number of seconds to sample.\n- Sampling remains fixed, so agents can inspect narrower windows when\nthey need more temporal detail.\n- `.mkv` is included as a video extension for this gated path.\n\nResource controls cover raw input size, frame count, emitted bytes,\ndecode time, and frame dimensions. The raw video input cap is now 1 GiB,\nand oversized sampled frames are downscaled before JPEG encoding instead\nof rejecting normal high-resolution videos.\n\n## Behavior without the extra installed\n\nWhen video dependencies are unavailable, the new frame-extraction\nfeature stays dormant:\n\n- `read_file` does not attempt frame extraction.\n- Existing video files continue through the generic multimodal\ncontent-block path.\n- `.mkv` is read as binary by backends, then returned as a generic file\nblock instead of sampled video frames.\n- The `read_file` tool help keeps the previous text/image/PDF guidance\ninstead of describing video seconds-based pagination.\n\nUltimately, the SDK maintains behavior as identical to prior to this PR.\n\n## Example\n\n<img width=\"1668\" height=\"785\" alt=\"Screenshot 2026-06-23 at 1 12 52 AM\"\nsrc=\"https://github.com/user-attachments/assets/cb460696-5e1e-40b8-83da-58b7c19e73cc\"\n/>\n\n---------\n\nCo-authored-by: deepagents <[email protected]>\nCo-authored-by: Claude Code <action@github.com>\nCo-authored-by: Deep Agent <agent@deepagents.dev>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","verified_at":"2026-07-02T06:32:53Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/b927147d026749c6c790bb06c9853515dabf579c","html_url":"https://github.com/langchain-ai/deepagents/commit/b927147d026749c6c790bb06c9853515dabf579c","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/b927147d026749c6c790bb06c9853515dabf579c/comments","author":{"login":"jkennedyvz","id":65985482,"node_id":"MDQ6VXNlcjY1OTg1NDgy","avatar_url":"https://avatars.githubusercontent.com/u/65985482?v=4","gravatar_id":"","url":"https://api.github.com/users/jkennedyvz","html_url":"https://github.com/jkennedyvz","followers_url":"https://api.github.com/users/jkennedyvz/followers","following_url":"https://api.github.com/users/jkennedyvz/following{/other_user}","gists_url":"https://api.github.com/users/jkennedyvz/gists{/gist_id}","starred_url":"https://api.github.com/users/jkennedyvz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jkennedyvz/subscriptions","organizations_url":"https://api.github.com/users/jkennedyvz/orgs","repos_url":"https://api.github.com/users/jkennedyvz/repos","events_url":"https://api.github.com/users/jkennedyvz/events{/privacy}","received_events_url":"https://api.github.com/users/jkennedyvz/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b2adcce24fee6132892c2c5b30bbfc3501698d4f","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/b2adcce24fee6132892c2c5b30bbfc3501698d4f","html_url":"https://github.com/langchain-ai/deepagents/commit/b2adcce24fee6132892c2c5b30bbfc3501698d4f"}]},{"sha":"b2adcce24fee6132892c2c5b30bbfc3501698d4f","node_id":"C_kwDOPTymldoAKGIyYWRjY2UyNGZlZTYxMzI4OTJjMmM1YjMwYmJmYzM1MDE2OThkNGY","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-02T06:26:54Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-02T06:26:54Z"},"message":"style(code): drop env-var hint from `/trace` not-configured message (#4427)\n\n`/trace` now directs users to `/auth` (only) when LangSmith tracing is\nnot configured.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/dc58d0c4-6dfe-42ae-4af1-28ff95148006)\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"4ca954dd06e9607039ee5e75f4e1a3ba7d01eee7","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/4ca954dd06e9607039ee5e75f4e1a3ba7d01eee7"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/b2adcce24fee6132892c2c5b30bbfc3501698d4f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqRgSuCRC1aQ7uu5UhlAAAtCcQAH1dYBHPBoExckcejMvLwrZh\nyNIZXK6uJ2iPYbJ2UiChjCo0vZCT90wOhjZ5pMhNO9VkIYoaYbDsvqTx4GrEyqAr\nTrQh7CV9CyVvl5YXke5eUwJf+dQJn3BSJ4yweJ2KGCKNH8627XhHeCnseyY2i8JB\nMpbk49RG/KPIF6WfyLUR/iKz7D+R8kvlpkbffnomraYI1sTogp7cA6mVwcvsrwZd\nuOUYf75ht0/o+MCRIoJS2MkdG5TFaZdIOjxF2q+6tfCGQrqNIJj/cnQHh36M3BWZ\noy95Cgu07AN2kxubrhSDVfBzLoaN75ypvPkYyHLgqERjJPxdZYJdp3hDtLhCWlhH\n0U/HamK0IUPrt3si0bWZ3MH5+eiBuzWt0ZWbUF5vUoDwiiWRHctCxQ5JaVrxp+SN\ndYmsn6z3YeqFX2rzRx/OlrhpbMesx5Eioek3cgwRICE7Udv6kIN8JZvRqExZuLV9\nNGeQMR7VOPiXP6FwIF1NYIP1l0Vo95z4sSqHDNOjv36W24ki16Djdh8b5QtpX/gA\n9fcFtjpC7EL7zZcqrVFr/qDSrXXHGc74MBoMXdvsYoU62EdsRhAgXbOwdI3diVqU\nxLe2i0+wksmdehKK1mIZXMbpfhOOyoD0mUEBZkYb058DYkA6ZCQ3cWw7Qp63SDUy\nYraFEOS8blnsERLDa4ta\n=c5QD\n-----END PGP SIGNATURE-----\n","payload":"tree 4ca954dd06e9607039ee5e75f4e1a3ba7d01eee7\nparent a4c25cd74de9902fd0ea9440b5dda2d4248bb3d2\nauthor Mason Daugherty <mason@langchain.dev> 1782973614 -0400\ncommitter GitHub <noreply@github.com> 1782973614 -0400\n\nstyle(code): drop env-var hint from `/trace` not-configured message (#4427)\n\n`/trace` now directs users to `/auth` (only) when LangSmith tracing is\nnot configured.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/dc58d0c4-6dfe-42ae-4af1-28ff95148006)\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-07-02T06:26:55Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/b2adcce24fee6132892c2c5b30bbfc3501698d4f","html_url":"https://github.com/langchain-ai/deepagents/commit/b2adcce24fee6132892c2c5b30bbfc3501698d4f","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/b2adcce24fee6132892c2c5b30bbfc3501698d4f/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a4c25cd74de9902fd0ea9440b5dda2d4248bb3d2","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a4c25cd74de9902fd0ea9440b5dda2d4248bb3d2","html_url":"https://github.com/langchain-ai/deepagents/commit/a4c25cd74de9902fd0ea9440b5dda2d4248bb3d2"}]},{"sha":"a4c25cd74de9902fd0ea9440b5dda2d4248bb3d2","node_id":"C_kwDOPTymldoAKGE0YzI1Y2Q3NGRlOTkwMmZkMGVhOTQ0MGI1ZGRhMmQ0MjQ4YmIzZDI","commit":{"author":{"name":"open-swe[bot]","email":"215916821+open-swe[bot]@users.noreply.github.com","date":"2026-07-02T06:14:10Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-02T06:14:10Z"},"message":"feat(code): offer abort during resume (#4188)\n\n`dcode -r` can now be aborted from the directory-switch prompt to start\na new session instead of resuming.\n\n---\n\n`dcode -r` resolves the most-recent (or `-r <id>`) thread and, when its\nworking directory differs from the current one, already shows the\ncwd-switch modal (switch dir / stay here). This adds a third **abort**\noption to that existing modal so the user can decline the resume and\nstart a fresh session instead. The abort option is gated behind\n`allow_abort`, passed only by the launch-time `-r` resume path\n(in-session thread switching is unchanged).\n\nLike the cwd-switch prompt itself, abort is only offered when the\nresumed thread's cwd differs from the current directory (the prompt\ndoesn't appear otherwise).\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/03bf37e9-2e0e-bb6e-12ad-528fc5fb3ad1)\n\n---------\n\nCo-authored-by: Mason Daugherty <61371264+mdrxy@users.noreply.github.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","tree":{"sha":"84c17c3ae545c6f93594cd8126e3924618c8e140","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/84c17c3ae545c6f93594cd8126e3924618c8e140"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/a4c25cd74de9902fd0ea9440b5dda2d4248bb3d2","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqRgGyCRC1aQ7uu5UhlAAAWOcQABjLQ4rvrdUGRVmI/ONrXwK/\noKBmWmL9W4oh0QVn/nJ9BkxRWmcEVgQI3lVjfRcufkLlijmITfZXS6pXeQz2n8e2\nxIu8GRehgZEDI3EX6IdyqPdnzdK3jQ4uESRgHmlFHbGkyZwBERkTg6qlSlfMkeI2\ne1g1hE/cCfzdAL1nH/fmyis5oJFF2Dr+Ylr6JvvDM+8+r2jXbTVAMnlw7u+HL8Q2\nb4FTTXfHp0sSpCMlAoxay+8pafAIMJRmk/OEKMdriHIKE1U1JjEUOKJRChg8bzD8\nx8ocRep/EbXla3gKz7LFF7CG9r1aJBgL9d+y8k25/vV6zMbo57Ih/zTLcCCzN+Rs\nQxEsjH3OfKwxJ6E+kfUFK5Pu5JZ084FGCMR1cZmb7IOfBj4a6Z+pToHkgRNpdTtC\nBhA2uttR/A4xD2JXk+58e5kBPf01VcB9R7g/3uGwtXmkopkbk/kka1W4YvYPv2Aa\nzRDZcunY9PokvbUivugS1jtGJZy1aLPngqA2C2jUHEvaLj0dS170bRaZ+2BVqEuI\niVVClwEHpuWW4vYZmSgNuyX3HPM8u0egO23LqktCGO1y1shUzA8Btb8O81v+iFaQ\n1pGf3wnFrp2RFd9LJ12sFBBkTbgMo4keCP5NZWWK2vIL7Nw4dxlYIsDryF9BBDSQ\nL6uKPLDqpYVt/fIkqHGc\n=WOiN\n-----END PGP SIGNATURE-----\n","payload":"tree 84c17c3ae545c6f93594cd8126e3924618c8e140\nparent abd5b1310c4667f3c035443a75f34afd06dabb4a\nauthor open-swe[bot] <215916821+open-swe[bot]@users.noreply.github.com> 1782972850 -0400\ncommitter GitHub <noreply@github.com> 1782972850 -0400\n\nfeat(code): offer abort during resume (#4188)\n\n`dcode -r` can now be aborted from the directory-switch prompt to start\na new session instead of resuming.\n\n---\n\n`dcode -r` resolves the most-recent (or `-r <id>`) thread and, when its\nworking directory differs from the current one, already shows the\ncwd-switch modal (switch dir / stay here). This adds a third **abort**\noption to that existing modal so the user can decline the resume and\nstart a fresh session instead. The abort option is gated behind\n`allow_abort`, passed only by the launch-time `-r` resume path\n(in-session thread switching is unchanged).\n\nLike the cwd-switch prompt itself, abort is only offered when the\nresumed thread's cwd differs from the current directory (the prompt\ndoesn't appear otherwise).\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/03bf37e9-2e0e-bb6e-12ad-528fc5fb3ad1)\n\n---------\n\nCo-authored-by: Mason Daugherty <61371264+mdrxy@users.noreply.github.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","verified_at":"2026-07-02T06:14:11Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a4c25cd74de9902fd0ea9440b5dda2d4248bb3d2","html_url":"https://github.com/langchain-ai/deepagents/commit/a4c25cd74de9902fd0ea9440b5dda2d4248bb3d2","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a4c25cd74de9902fd0ea9440b5dda2d4248bb3d2/comments","author":{"login":"open-swe[bot]","id":215916821,"node_id":"BOT_kgDODN6hFQ","avatar_url":"https://avatars.githubusercontent.com/in/1395372?v=4","gravatar_id":"","url":"https://api.github.com/users/open-swe%5Bbot%5D","html_url":"https://github.com/apps/open-swe","followers_url":"https://api.github.com/users/open-swe%5Bbot%5D/followers","following_url":"https://api.github.com/users/open-swe%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/open-swe%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/open-swe%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/open-swe%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/open-swe%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/open-swe%5Bbot%5D/repos","events_url":"https://api.github.com/users/open-swe%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/open-swe%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"abd5b1310c4667f3c035443a75f34afd06dabb4a","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/abd5b1310c4667f3c035443a75f34afd06dabb4a","html_url":"https://github.com/langchain-ai/deepagents/commit/abd5b1310c4667f3c035443a75f34afd06dabb4a"}]},{"sha":"abd5b1310c4667f3c035443a75f34afd06dabb4a","node_id":"C_kwDOPTymldoAKGFiZDViMTMxMGM0NjY3ZjNjMDM1NDQzYTc1ZjM0YWZkMDZkYWJiNGE","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-02T04:01:20Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-02T04:01:20Z"},"message":"chore(code): prune recommended models, add nemotron under openrouter (#4423)\n\nPrunes six stale specs from the curated `_RECOMMENDED_MODELS` set in\n`libs/code` (`glm-5p1`, `kimi-k2p6`, `minimax-m2p7`, `qwen3p6-plus` on\nfireworks; `claude-opus-4-6` on anthropic; `minimax-m2.7` on openrouter)\nand adds `nvidia/nemotron-3-ultra-550b-a55b` under openrouter. Curation\ntests that referenced the removed `claude-opus-4-6` spec were updated to\na still-recommended opus spec.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/c56b1dcd-d736-47a7-1601-9baf98c9a9dc)\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"516bd143b396897be44baaf1d086aa1d80dbd942","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/516bd143b396897be44baaf1d086aa1d80dbd942"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/abd5b1310c4667f3c035443a75f34afd06dabb4a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqReKQCRC1aQ7uu5UhlAAAaxgQAHPMAE0baZ0xtMsV45LXPiUc\ncPgWHR4u5vQ4FBW1OVheCxWV56yV4xM+FJVN9WEHVgYd1RsmmMR/PamAi1nrSyPg\nW+US3M7wJyAJO6wiDRWq95MaNJTvJaayUzdxj23mdEE9vbT8DMdMmOGxrVxuiVAQ\nQ17zOcj6OiJcnbljUQtF7oWm6qHDMcq0G5bKKZT1AXOIDoxFyknY672t5YNwhAy3\nCgLJdwKYPjxMxIt1vtO79QjvMQm