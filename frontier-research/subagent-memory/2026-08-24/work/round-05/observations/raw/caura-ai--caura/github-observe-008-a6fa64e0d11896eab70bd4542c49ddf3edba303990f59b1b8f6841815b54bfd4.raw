sers/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"2bcb78cd1944fcf295b7595b17dfed0fd9481b1e","url":"https://api.github.com/repos/caura-ai/caura/commits/2bcb78cd1944fcf295b7595b17dfed0fd9481b1e","html_url":"https://github.com/caura-ai/caura/commit/2bcb78cd1944fcf295b7595b17dfed0fd9481b1e"}]},{"sha":"2bcb78cd1944fcf295b7595b17dfed0fd9481b1e","node_id":"C_kwDOSOAAX9oAKDJiY2I3OGNkMTk0NGZjZjI5NWI3NTk1YjE3ZGZlZDBmZDk0ODFiMWU","commit":{"author":{"name":"erni-a","email":"erni@caura.ai","date":"2026-06-03T08:58:48Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-03T08:58:48Z"},"message":"chore(plugin): set served plugin version to 2.7.0 (match the 2.7.0 floor) (#280)\n\nFollow-up to #279. #279 set `MIN_RECOMMENDED_PLUGIN_VERSION=2.7.0` but\nthe served plugin version was still `2.6.5` — that combination\ndeploy-loops auto-upgraded nodes (they upgrade, re-report 2.6.5 < 2.7.0,\nredeploy).\n\nBumps served version to **2.7.0** in `package.json` +\n`openclaw.plugin.json`, and `.release-please-manifest.json` so\nrelease-please stays in sync. Makes served == floor == 2.7.0.\n\nMerge this, then `onprem-v2.9.0` is cut. (Replaces the plugin half of\nthe failing-CI release PR #243.)\n\nSigned-off-by: erni <erni@caura.ai>","tree":{"sha":"02bd4192cc8ed6ea667b4b315240dc5d69028aae","url":"https://api.github.com/repos/caura-ai/caura/git/trees/02bd4192cc8ed6ea667b4b315240dc5d69028aae"},"url":"https://api.github.com/repos/caura-ai/caura/git/commits/2bcb78cd1944fcf295b7595b17dfed0fd9481b1e","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqH+zICRC1aQ7uu5UhlAAAh+MQAITVrJ9H1gnFu38IWQgyKl5E\nyjHfsXqwTQtr3Dz/ig5kKq0O1NsTxOZs8aa40ZQ4KDALELHJf4nu85SgyK/3ELbd\nFoNBFHXNyaBn6g68HdyF8CUpver+XfLftwTHfVhUpdSiKawT5UQLYdJOlWGod81c\nmhPlNz2OTNkLJ3En7foMZYcj9leqKgyoSy+ha0HSM8zUYQPJA7ITdXCv70d3cQyt\nqH7SLT/WgMzgwEoNOc6LjPvqRj2J/OBXpQ4kYcxBbM1SPWVncK9bQlSS9UnSCt8x\nQ85If8YlL2ii7rZKcV/mwGlpkspCWGYVa3NBNGksS53Fcth0XxuAsMOpjTDqSotl\ni/2rtD0nAQ5+PzFnfgii0iAoB1uoJkMFw94QUPx2qTgSKWrdnQ5smfZiO7HWANEb\nmL+AzSXIeTRIBWk2Ejn2MPHoGtHrWoKWsHpjRKgUPfrJ7EmnambviaWyxeSn56RR\ne76pOmrkmcTa0Nu5XnTyQ2lwMSbvqzPKdtToOzoBFskSiS8Z6ODe7bZwI//iF1FM\nbOTNLY9AnDp4r5UTw+vZI7zJkT/Bij5iEP/AklpRB25RY1Zgjc/hBVMbnnUYAqWp\nqR9iZ6VTKBtXHImZ3lBH0iyMKUh4w3Q0+FyM/Bs7ZQZeF5Wzybrbdzx6I9hkRh6j\nlJ3lDCFJYg/LtC9QL0DS\n=/qD6\n-----END PGP SIGNATURE-----\n","payload":"tree 02bd4192cc8ed6ea667b4b315240dc5d69028aae\nparent 7238180a4f451838e3e4e7c71c85609d08aa58b3\nauthor erni-a <erni@caura.ai> 1780477128 +0300\ncommitter GitHub <noreply@github.com> 1780477128 +0300\n\nchore(plugin): set served plugin version to 2.7.0 (match the 2.7.0 floor) (#280)\n\nFollow-up to #279. #279 set `MIN_RECOMMENDED_PLUGIN_VERSION=2.7.0` but\nthe served plugin version was still `2.6.5` — that combination\ndeploy-loops auto-upgraded nodes (they upgrade, re-report 2.6.5 < 2.7.0,\nredeploy).\n\nBumps served version to **2.7.0** in `package.json` +\n`openclaw.plugin.json`, and `.release-please-manifest.json` so\nrelease-please stays in sync. Makes served == floor == 2.7.0.\n\nMerge this, then `onprem-v2.9.0` is cut. (Replaces the plugin half of\nthe failing-CI release PR #243.)\n\nSigned-off-by: erni <erni@caura.ai>","verified_at":"2026-06-03T08:58:48Z"}},"url":"https://api.github.com/repos/caura-ai/caura/commits/2bcb78cd1944fcf295b7595b17dfed0fd9481b1e","html_url":"https://github.com/caura-ai/caura/commit/2bcb78cd1944fcf295b7595b17dfed0fd9481b1e","comments_url":"https://api.github.com/repos/caura-ai/caura/commits/2bcb78cd1944fcf295b7595b17dfed0fd9481b1e/comments","author":{"login":"erni-a","id":229583271,"node_id":"U_kgDODa8ppw","avatar_url":"https://avatars.githubusercontent.com/u/229583271?v=4","gravatar_id":"","url":"https://api.github.com/users/erni-a","html_url":"https://github.com/erni-a","follow