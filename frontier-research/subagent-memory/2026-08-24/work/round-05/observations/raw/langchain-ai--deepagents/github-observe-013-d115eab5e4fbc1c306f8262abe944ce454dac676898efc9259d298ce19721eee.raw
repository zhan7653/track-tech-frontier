mmit 965cbd566b019a9ff2e39a35a5dce387660a77db.","tree":{"sha":"0b4ef501c6cbb3742f131340f0c47de1de2b067e","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/0b4ef501c6cbb3742f131340f0c47de1de2b067e"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/9491688e3c5fe488fb402a07fedd5c02f5a4cbff","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgw4aRwS28FuhHCLf5WCTI2N4oQZ\nguR7Z5vIQft5qBt/MAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQCgf+KJn2bHLfinf1w3fG8xRLkbcoPFElBSj0D94cF4TpZo7fOyVPxNXYasyJYUf+y\nr74banm/SaQqVts7bM4g4=\n-----END SSH SIGNATURE-----","payload":"tree 0b4ef501c6cbb3742f131340f0c47de1de2b067e\nparent f240a40dc05d812c38e9926c1d81ba38deb86e3f\nauthor Mason Daugherty <github@mdrxy.com> 1782437508 -0400\ncommitter Mason Daugherty <github@mdrxy.com> 1782437508 -0400\n\nhotfix(repo): revert mistaken v0.7 squash merge\n\nThis reverts commit 965cbd566b019a9ff2e39a35a5dce387660a77db.\n","verified_at":"2026-06-26T01:32:52Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9491688e3c5fe488fb402a07fedd5c02f5a4cbff","html_url":"https://github.com/langchain-ai/deepagents/commit/9491688e3c5fe488fb402a07fedd5c02f5a4cbff","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9491688e3c5fe488fb402a07fedd5c02f5a4cbff/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f240a40dc05d812c38e9926c1d81ba38deb86e3f","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/f240a40dc05d812c38e9926c1d81ba38deb86e3f","html_url":"https://github.com/langchain-ai/deepagents/commit/f240a40dc05d812c38e9926c1d81ba38deb86e3f"}]},{"sha":"f240a40dc05d812c38e9926c1d81ba38deb86e3f","node_id":"C_kwDOPTymldoAKGYyNDBhNDBkYzA1ZDgxMmMzOGU5OTI2YzFkODFiYTM4ZGViODZlM2Y","commit":{"author":{"name":"Nick Hollon","email":"nick.hollon@langchain.dev","date":"2026-06-26T00:50:52Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T00:50:52Z"},"message":"fix(code): handle recursive `fetch_url` conversion (#4257)\n\n`fetch_url` no longer crashes when HTML-to-markdown conversion exceeds\nrecursion depth.\n\n---\n\n`fetch_url` can fail when `markdownify` hits Python recursion depth on\ndeeply nested HTML. This keeps the existing markdown path but falls back\nto stdlib text extraction so dcode returns usable page content instead\nof crashing.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/79d44275-aab0-bf62-abde-8242f55e0648)\n\n---------\n\nCo-authored-by: Nick Hollon <274035459+nick-hollon-lc@users.noreply.github.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","tree":{"sha":"5227c3c459303d7561a0dba65e83cb4fafabcc8a","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/5227c3c459303d7561a0dba65e83cb4fafabcc8a"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/f240a40dc05d812c38e9926c1d81ba38deb86e3f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPczsCRC1aQ7uu5UhlAAAKFcQADj4OMbIAexypY+NzXD8S2Rk\nLP7JgaESrWk02Lhb5AboUVbfJd3rcdgYiJRofsY2MTcDSF4NHg99HgstNq3OQRsj\nXi37EzlAiyVR+iBEag2Kuaye9GZ6zw5n8YUIEwwexqKqKDf65r7KXP2V/lerH1Mp\nFtWsrzLBJ58RnKBb9hBugnXxduSPME+Fz8voZ7wEoCEIGcswXiQn4kA5GadWQMD6\nJIppt3fRPeRRe1Cy5vdAKKqiewCkogI+53nyYo4kDzDmbCBkGwI3p94R4QekcvC4\nzYPWOuG5/e6pQagMj0FXp9sZ/0cbUmKluUZNkaAHaWjwXq8V1+/bXRvsvTiCLAsf\nzZQGEkHyTlJyMpunmrk0KkaBJ4iMM782J7caf5r1DHwGqA/Fm2V3JgML5sQif2C5\nvijGSGg7qYbF2/LkY4p9VQElo0NsVBEZEmJhKWhXno461Z9rQuwMGnQnd1Xe8JVA\n8lYxIdDgSGiJ0HOYYNb9mMagTZHaZCCQcZPjKpB83C1eGYKfQQXMHU8hDFNxakE8\n3uzqzRZKtopNQb9/Z3bu/MRFPbw9guY5xORjpnc3qmI4PXiUWZ0xVqukDG+2OeUu\n+Op1DzvcN0Z10ez9YN5kIyDWgMaKKTZMVFPWuKwv147VvkjQAtvCEYWvsNxQBZBH\nGT/xblxLDasYUzqTSAaJ\n=Mj/F\n-----END PGP SIGNATURE-----\n","payload":"tree 5227c3c459303d7561a0dba65e83cb4fafabcc8a\nparent 7dd84aca65e50e8b460d093e419d6c3b8819c070\nauthor Nick Hollon <nick.hollon@langchain.dev> 1782435052 -0400\ncommitter GitHub <noreply@github.com> 1782435052 -0400\n\nfix(code): handle recursive `fetch_url` conversion (#4257)\n\n`fetch_url` no longer crashes when HTML-to-markdown conversion exceeds\nrecursion depth.\n\n---\n\n`fetch_url` can fail when `markdownify` hits Python recursion depth on\ndeeply nested HTML. This keeps the existing markdown path but falls back\nto stdlib text extraction so dcode returns usable page content instead\nof crashing.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/79d44275-aab0-bf62-abde-8242f55e0648)\n\n---------\n\nCo-authored-by: Nick Hollon <274035459+nick-hollon-lc@users.noreply.github.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","verified_at":"2026-06-26T00:50:52Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/f240a40dc05d812c38e9926c1d81ba38deb86e3f","html_url":"https://github.com/langchain-ai/deepagents/commit/f240a40dc05d812c38e9926c1d81ba38deb86e3f","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/f240a40dc05d812c38e9926c1d81ba38deb86e3f/comments","author":{"login":"nick-hollon-lc","id":274035459,"node_id":"U_kgDOEFVzAw","avatar_url":"https://avatars.githubusercontent.com/u/274035459?v=4","gravatar_id":"","url":"https://api.github.com/users/nick-hollon-lc","html_url":"https://github.com/nick-hollon-lc","followers_url":"https://api.github.com/users/nick-hollon-lc/followers","following_url":"https://api.github.com/users/nick-hollon-lc/following{/other_user}","gists_url":"https://api.github.com/users/nick-hollon-lc/gists{/gist_id}","starred_url":"https://api.github.com/users/nick-hollon-lc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nick-hollon-lc/subscriptions","organizations_url":"https://api.github.com/users/nick-hollon-lc/orgs","repos_url":"https://api.github.com/users/nick-hollon-lc/repos","events_url":"https://api.github.com/users/nick-hollon-lc/events{/privacy}","received_events_url":"https://api.github.com/users/nick-hollon-lc/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7dd84aca65e50e8b460d093e419d6c3b8819c070","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7dd84aca65e50e8b460d093e419d6c3b8819c070","html_url":"https://github.com/langchain-ai/deepagents/commit/7dd84aca65e50e8b460d093e419d6c3b8819c070"}]},{"sha":"7dd84aca65e50e8b460d093e419d6c3b8819c070","node_id":"C_kwDOPTymldoAKDdkZDg0YWNhNjVlNTBlOGI0NjBkMDkzZTQxOWQ2YzNiODgxOWMwNzA","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T00:30:38Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T00:30:38Z"},"message":"docs(code): document project `.env` shell-hook trust boundary (#4291)\n\nMakes the `dcode` working-directory trust boundary explicit so users\nunderstand that running it in a project directory lets that project\ninfluence the process environment — the broader issue behind the `.env`\nshell-startup-hook fix in #4288.\n\n- `libs/code/README.md`: adds a `Security model` section — `dcode`\ntrusts the directory you run it in; do not run it in untrusted\ndirectories without a sandbox backend.\n- `libs/code/THREAT_MODEL.md`: adds threat `T12` (project `.env` injects\nshell interpreter startup hooks) under `TB11`, extends the `TB11`\nboundary controls/details with the dotenv shell-hook denylist\n(`BASH_ENV`, `ENV`), and clarifies the `.env` out-of-scope row to\nseparate ordinary config discovery from the in-scope code-execution\nimplication.\n\n`T11` was already taken by the ripgrep-install threat, so the new entry\nis numbered `T12`. Companion docs-site warning: langchain-ai/docs#4619.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/25c781c1-fad7-a196-6adb-5e606877a1f2)\n\n---------\n\nSigned-off-by: Mason Daugherty <github@mdrxy.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>\nCo-authored-by: open-swe[bot] <215916821+open-swe[bot]@users.noreply.github.com>","tree":{"sha":"f251fb2142f6f5eb9f543d8f00f2ef8df2decc1d","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/f251fb2142f6f5eb9f543d8f00f2ef8df2decc1d"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/7dd84aca65e50e8b460d093e419d6c3b8819c070","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPcguCRC1aQ7uu5UhlAAANLIQAFdKRPHJJtgXKsy03PlcVVc6\neYVeRqMYX1FggsGU1LsjueYV7BqprS1UlOWAN2kAKjPoK1L9/sINd4WFMGvs91qz\nCBvM5wJ3Znv1Q+RIfWCG86f2FZaWTqrvXPA6WqmhLzo3t7NfAGsxP/EcCT3giC04\nKvWIn34iZ5NK2GSKuWKM4oodG8nYjsTkNR3opAiPgsVzXXK/v054RtW+pMvfqG0w\nZC9g2VCf7zo6cyTfbaySo8hH88/rhndgYnyXJgY6htYD+e3B8VowUzKZMf13T5ZP\nkUnctCKgHvDXV5T52NSSQgpqxsC6NVga2lnwCGB4nu64gStqLMKb5reaacX2AaW4\nxDqhjuG6kGaJ5ExOwQaZLm/LuBIJzpG7OA2gEuYh+Pdm/Zbw7yEdUWB5OIULt7RB\nZf3JR/0nKQ8BWl1ySiAa8J8OehnNNK37BG5J7otT3fpYX2u/CT2Cuiv4Eh+RPr0L\n7SZkX0XQ2BjULrZv3ONPgqyqp29t34n85RNIIQuuVuIsBBdFFKYae+F+V/0TfX/I\nvgX2bJWqbxNRtqY2UvDVxc455Egu88C9Bp/nh7ar6SG/JnRk7n95QWRtYwU6wJ3O\nptX0DJFcFVdQoc8xGmsTGidz2KA25L/Wnamhc/RP4HzzGhj1M6qFZFbRgqMJOGfv\nHhSTqePahGnl0I3mBQeL\n=yy3v\n-----END PGP SIGNATURE-----\n","payload":"tree f251fb2142f6f5eb9f543d8f00f2ef8df2decc1d\nparent c7c8788ecf0068914298a6055a5f3fd31c36bd44\nauthor Mason Daugherty <mason@langchain.dev> 1782433838 -0400\ncommitter GitHub <noreply@github.com> 1782433838 -0400\n\ndocs(code): document project `.env` shell-hook trust boundary (#4291)\n\nMakes the `dcode` working-directory trust boundary explicit so users\nunderstand that running it in a project directory lets that project\ninfluence the process environment — the broader issue behind the `.env`\nshell-startup-hook fix in #4288.\n\n- `libs/code/README.md`: adds a `Security model` section — `dcode`\ntrusts the directory you run it in; do not run it in untrusted\ndirectories without a sandbox backend.\n- `libs/code/THREAT_MODEL.md`: adds threat `T12` (project `.env` injects\nshell interpreter startup hooks) under `TB11`, extends the `TB11`\nboundary controls/details with the dotenv shell-hook denylist\n(`BASH_ENV`, `ENV`), and clarifies the `.env` out-of-scope row to\nseparate ordinary config discovery from the in-scope code-execution\nimplication.\n\n`T11` was already taken by the ripgrep-install threat, so the new entry\nis numbered `T12`. Companion docs-site warning: langchain-ai/docs#4619.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/25c781c1-fad7-a196-6adb-5e606877a1f2)\n\n---------\n\nSigned-off-by: Mason Daugherty <github@mdrxy.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>\nCo-authored-by: open-swe[bot] <215916821+open-swe[bot]@users.noreply.github.com>","verified_at":"2026-06-26T00:30:38Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7dd84aca65e50e8b460d093e419d6c3b8819c070","html_url":"https://github.com/langchain-ai/deepagents/commit/7dd84aca65e50e8b460d093e419d6c3b8819c070","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7dd84aca65e50e8b460d093e419d6c3b8819c070/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c7c8788ecf0068914298a6055a5f3fd31c36bd44","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/c7c8788ecf0068914298a6055a5f3fd31c36bd44","html_url":"https://github.com/langchain-ai/deepagents/commit/c7c8788ecf0068914298a6055a5f3fd31c36bd44"}]},{"sha":"c7c8788ecf0068914298a6055a5f3fd31c36bd44","node_id":"C_kwDOPTymldoAKGM3Yzg3ODhlY2YwMDY4OTE0Mjk4YTYwNTVhNWYzZmQzMWMzNmJkNDQ","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-26T00:30:21Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T00:30:21Z"},"message":"fix(code): surface `/auth`-stored credentials in `config show`/`get` (#4258)\n\n`dcode config show`/`config get` now report API keys stored via `/auth`,\nlabeled with a `stored` source.\n\n---\n\n`dcode config show` and `config get` resolved credentials only through\nenvironment variables and `config.toml`, so a key entered via `/auth`\n(persisted in `auth.json`) rendered as `not configured` even though the\nagent actually sends it at runtime. This made a real 401-causing trap\ninvisible: stored keys take precedence over env vars\n(`resolve_provider_credential`), so a stale stored key silently\noverrides a known-good `ANTHROPIC_API_KEY`, and the diagnostic command\ngave no hint.\n\n`_resolve` now consults the credential store first for `Credentials`\noptions, mirroring the runtime precedence, and reports a `stored` source\nso the effective credential — and any precedence surprise — is visible.\nA corrupt store is logged and treated as absent so the command degrades\nto env/`config.toml` resolution instead of erroring.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/cb055d71-831a-f788-02a0-308c83974f4d)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"7d756e8b29119e0ace1ca4fbc3bd68219121cc41","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/7d756e8b29119e0ace1ca4fbc3bd68219121cc41"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/c7c8788ecf0068914298a6055a5f3fd31c36bd44","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPcgdCRC1aQ7uu5UhlAAAbIAQADZkhOCKo2JncjDOW5JarXW0\no+SAH9J4S/8mW4WWruxMIXJlA8z1AtMDdLaoc0HrI6lKeNx+DyTcrLUN5w1w1WUQ\nWsbg+C5+e5s3UgUOy39S91n0Wk0ZKXXP0ARSGiW1QPmxGVSbrTcb57eJjVZgec0p\nU8lR8CE44Q7sjXHQAO4cjhQ8EL/Ksn7AFDAPEg5qSN/ldcQyTNM0N8MDgb9KEL0i\nqm3plZF4dfPBkecrthZ5cpjCuNq3BSO1+3oTbp+Rzu+4ObGc8IfrWXAHlzg7Tao1\nK8VbipM5HZ67HZ0SsVS42KL24fl+g0QyfK7kdCeJNwJH6OgsubvZUGzzwsa2BAGt\nq1lAvYHgvXCz97n0dNpNumRmDF6G7wW7onBwxfuhyWC4d1Kshu2Jan3PzkvgPsOP\naMHUVfIj3oim5x7TvYb/pdTOS+1kjLD+35oFDwch/sHDESxZN2+R7qP/xJbIs/0I\nAlMRwfVPpYLmJkBQA9Gxfq4QV0sX9wUhpxJ197Hp8jG0Z7sj5KJ7NdFx56TX/T8M\nkyWhO7LIO5yWpX8rXqK5hUatt6lMjK6jzarkGXRlPqO2BsaRFpiq7wb0FmlK9BcI\nVCyBoZ+F9tpAutAb1BqvLnR0Yo3NSGC4x3X1CqN1vFOEaouvOViU6X8GUbD7/n8g\nFXcVn4ujFBCyo5AleHCF\n=dGeH\n-----END PGP SIGNATURE-----\n","payload":"tree 7d756e8b29119e0ace1ca4fbc3bd68219121cc41\nparent 37c5be9561a006deb2288bd11d5dbc4da272e349\nauthor Mason Daugherty <mason@langchain.dev> 1782433821 -0400\ncommitter GitHub <noreply@github.com> 1782433821 -0400\n\nfix(code): surface `/auth`-stored credentials in `config show`/`get` (#4258)\n\n`dcode config show`/`config get` now report API keys stored via `/auth`,\nlabeled with a `stored` source.\n\n---\n\n`dcode config show` and `config get` resolved credentials only through\nenvironment variables and `config.toml`, so a key entered via `/auth`\n(persisted in `auth.json`) rendered as `not configured` even though the\nagent actually sends it at runtime. This made a real 401-causing trap\ninvisible: stored keys take precedence over env vars\n(`resolve_provider_credential`), so a stale stored key silently\noverrides a known-good `ANTHROPIC_API_KEY`, and the diagnostic command\ngave no hint.\n\n`_resolve` now consults the credential store first for `Credentials`\noptions, mirroring the runtime precedence, and reports a `stored` source\nso the effective credential — and any precedence surprise — is visible.\nA corrupt store is logged and treated as absent so the command degrades\nto env/`config.toml` resolution instead of erroring.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/cb055d71-831a-f788-02a0-308c83974f4d)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-26T00:30:22Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/c7c8788ecf0068914298a6055a5f3fd31c36bd44","html_url":"https://github.com/langchain-ai/deepagents/commit/c7c8788ecf0068914298a6055a5f3fd31c36bd44","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/c7c8788ecf0068914298a6055a5f3fd31c36bd44/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"37c5be9561a006deb2288bd11d5dbc4da272e349","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/37c5be9561a006deb2288bd11d5dbc4da272e349","html_url":"https://github.com/langchain-ai/deepagents/commit/37c5be9561a006deb2288bd11d5dbc4da272e349"}]},{"sha":"37c5be9561a006deb2288bd11d5dbc4da272e349","node_id":"C_kwDOPTymldoAKDM3YzViZTk1NjFhMDA2ZGViMjI4OGJkMTFkNWRiYzRkYTI3MmUzNDk","commit":{"author":{"name":"John Kennedy","email":"65985482+jkennedyvz@users.noreply.github.com","date":"2026-06-26T00:09:09Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-26T00:09:09Z"},"message":"chore(infra): SHA-pin actions/checkout in example workflow (#4293)\n\n## Summary\n\nPin `actions/checkout@v6` →\n`actions/checkout@8e8c483db84b4bee98b60c0593521ed34d9990e8 # v6.0.1` in\n`deepagents-example.yml.example`.\n\nAll other workflows and composite actions in the repo were already\nSHA-pinned. This completes coverage for every third-party action\nreference in `.github/`.\n\n## Why\n\nSHA-pinning third-party GitHub Actions is a supply-chain security best\npractice recommended by GitHub and security scanners. Tag-based\nreferences (`@v6`) are mutable — a compromised maintainer account or\nstolen token can push malicious code under the same tag. SHA-pinned\nreferences are immutable.\n\n## Notes\n\nThe `langchain-ai/deepagents@main` self-reference in the example\ntemplate is intentionally left unpinned — it is a template file\n(`.example` suffix) for downstream consumers, not a live workflow.\n\nCo-authored-by: Deep Agent <agent@deepagents.dev>","tree":{"sha":"1d3de843a22de2ae84c305d0f14cde500f804976","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/1d3de843a22de2ae84c305d0f14cde500f804976"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/37c5be9561a006deb2288bd11d5dbc4da272e349","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPcMlCRC1aQ7uu5UhlAAAJUgQADjqbMTGNf0RK/z4s2zDYjoU\nv0XFXOnUsUamuSTrPLtkgo0uQvFa94uB3cy7gbQEwzuv4aGngUcezQdA0wofLadN\nRLGDxDqNSUYg/hqywA3ZphKkMQfC9WKcLlzyXHC69Nr817KtcmubkISp3HOQUrj/\nBt78ssosdb2JV84wv1QYdcclxX/m8dg5gvnOTrj/8hszwbCCeRRpwADZ/wTi1xZV\nKCXb5O32AdvC7UMX71lx6KmnDIOOE6t6ufIWYmyXSJfscVR3oYPSwUuwhrIja/tT\n8gyFtgwDgfwXt2tCQ3Am9GKdwUkuz6bVolkdXNPxgGEYMt3KEC/bDPF0xLeoB8SC\nE+rTyCMDCvKSaXJ72LH9CxXdu/bVrycGS+aa1LbuHTd06Hab6pCilXdi6AOpIaQT\ndniQhBduBSFzyRsySLaGg0VTBJXovLUK6K2uGt2MbH2QIw8uSIs+Ar23O50KrQeO\nQe0+Xr1dNlXCo8EXtJMYLVwQDAKNaT6o1BCeNxcStnRSZmhAZ+ynMero9nnWCqhz\nnK2t7liWouzkfnhg3TfFWdHeNnRn5aRu6Kh4QmSf5jGHBMXKb1OfLk7IGGQxV18S\nc7C13In9WUYiDSlE8bNjTrrR/5uq8srx+qAzX5pQ7m9AJ/KXta1BwpEDDY7pAykj\nDIyHfG/AuzlYPSvcTcug\n=zXOF\n-----END PGP SIGNATURE-----\n","payload":"tree 1d3de843a22de2ae84c305d0f14cde500f804976\nparent 686d6f3a1da8b6393efb4c0cf87b3eb35e0cca50\nauthor John Kennedy <65985482+jkennedyvz@users.noreply.github.com> 1782432549 -0700\ncommitter GitHub <noreply@github.com> 1782432549 -0400\n\nchore(infra): SHA-pin actions/checkout in example workflow (#4293)\n\n## Summary\n\nPin `actions/checkout@v6` →\n`actions/checkout@8e8c483db84b4bee98b60c0593521ed34d9990e8 # v6.0.1` in\n`deepagents-example.yml.example`.\n\nAll other workflows and composite actions in the repo were already\nSHA-pinned. This completes coverage for every third-party action\nreference in `.github/`.\n\n## Why\n\nSHA-pinning third-party GitHub Actions is a supply-chain security best\npractice recommended by GitHub and security scanners. Tag-based\nreferences (`@v6`) are mutable — a compromised maintainer account or\nstolen token can push malicious code under the same tag. SHA-pinned\nreferences are immutable.\n\n## Notes\n\nThe `langchain-ai/deepagents@main` self-reference in the example\ntemplate is intentionally left unpinned — it is a template file\n(`.example` suffix) for downstream consumers, not a live workflow.\n\nCo-authored-by: Deep Agent <agent@deepagents.dev>","verified_at":"2026-06-26T00:09:10Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/37c5be9561a006deb2288bd11d5dbc4da272e349","html_url":"https://github.com/langchain-ai/deepagents/commit/37c5be9561a006deb2288bd11d5dbc4da272e349","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/37c5be9561a006deb2288bd11d5dbc4da272e349/comments","author":{"login":"jkennedyvz","id":65985482,"node_id":"MDQ6VXNlcjY1OTg1NDgy","avatar_url":"https://avatars.githubusercontent.com/u/65985482?v=4","gravatar_id":"","url":"https://api.github.com/users/jkennedyvz","html_url":"https://github.com/jkennedyvz","followers_url":"https://api.github.com/users/jkennedyvz/followers","following_url":"https://api.github.com/users/jkennedyvz/following{/other_user}","gists_url":"https://api.github.com/users/jkennedyvz/gists{/gist_id}","starred_url":"https://api.github.com/users/jkennedyvz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jkennedyvz/subscriptions","organizations_url":"https://api.github.com/users/jkennedyvz/orgs","repos_url":"https://api.github.com/users/jkennedyvz/repos","events_url":"https://api.github.com/users/jkennedyvz/events{/privacy}","received_events_url":"https://api.github.com/users/jkennedyvz/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"686d6f3a1da8b6393efb4c0cf87b3eb35e0cca50","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/686d6f3a1da8b6393efb4c0cf87b3eb35e0cca50","html_url":"https://github.com/langchain-ai/deepagents/commit/686d6f3a1da8b6393efb4c0cf87b3eb35e0cca50"}]},{"sha":"686d6f3a1da8b6393efb4c0cf87b3eb35e0cca50","node_id":"C_kwDOPTymldoAKDY4NmQ2ZjNhMWRhOGI2MzkzZWZiNGMwY2Y4N2IzZWIzNWUwY2NhNTA","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-25T20:51:01Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-25T20:51:01Z"},"message":"fix(code): block dotenv shell startup hooks (#4288)\n\nProject `.env` files are useful for app configuration, but they should\nnot be able to inject shell interpreter startup hooks into `dcode`'s\nprocess environment. `dcode` runs its own local-context detection\nthrough Bash during startup, so variables such as `BASH_ENV` and `ENV`\ncan cause project-provided scripts to run before any model-requested\ntool call or approval prompt.\n\nThis blocks shell startup and environment-hijack keys from\nproject/global dotenv loading while preserving normal app/API\nconfiguration values. The preview path now uses the same denylist as the\nreal reload path so dry-run config changes cannot report values that a\nreal reload would reject.\n\nRegression coverage verifies that denied keys are omitted from dotenv\nloading, preview loading mirrors that behavior, and local-context\nstartup detection does not execute a `BASH_ENV` payload from a project\n`.env`.","tree":{"sha":"d6a7843d15ab666c8df58f8e1f489adf95a7ccf3","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/d6a7843d15ab666c8df58f8e1f489adf95a7ccf3"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/686d6f3a1da8b6393efb4c0cf87b3eb35e0cca50","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPZS1CRC1aQ7uu5UhlAAAoOEQAJ7qmAOIL6iNxovXZolcoomr\n9P0F3dFV1aCp3UmgXTylUaNUpaLWqcRhOzL12Kj/pYIHirwH3m08TI7XS3aUfGhf\nLOVqw2R+vPWhztqqJZ0W328u/HYb3e4IW8OHg4RUiTzfvbnEBnbMPn9x9VWkxLDv\nyyac5/rjZ62F3v/N9FKT/FpeIQYeP3wUlbPWJeiaLUq4PHhd+ky71v2wWmPWXAg+\nHOmVoGVRGTyy9FoW0L91MOjFahBxc5cOK6K05fNSNRfL+rvqs4hmDioed2UMhmRl\nxFzOTy/c3lLvNq1/Af53hFYxP/o5M61Tm+BsRtheaKb+g+khIPadMGKlKA56HX/s\no/3X+Gx/QfLEFClrDeibw4pBhIK60UpQFlgBxikXwAosHvLHJdh8tkeypNEVIA6G\ns6Yggxs+pnWBde3nMkHQGEtZLo/dqMlotBZ2mFTY0NG9wUnI0yXDGxRXbymYbgjg\nl3J7+qoWZW+o581HWeuGBSpSzz8lI5AaaPRewE4jA4pHTUq6yj9cDmCbCwdEMsM6\ndzxiY+PHdj0t+wlnduuQtoQLZuf1yxZ5F3AtjyYx9qVGz986+lInIbZrT9928xH0\nyXTUgq7kTonb0ywIDrmUFXF/74EyBJuql8mRf3dN5H/hm+wt2vjXSng9Sa87bOxQ\nydFeSUmUhKE+fHe+pXxF\n=727s\n-----END PGP SIGNATURE-----\n","payload":"tree d6a7843d15ab666c8df58f8e1f489adf95a7ccf3\nparent 820b331552cb7ce4695ddca3c9b8343a3144392b\nauthor Mason Daugherty <mason@langchain.dev> 1782420661 -0400\ncommitter GitHub <noreply@github.com> 1782420661 -0400\n\nfix(code): block dotenv shell startup hooks (#4288)\n\nProject `.env` files are useful for app configuration, but they should\nnot be able to inject shell interpreter startup hooks into `dcode`'s\nprocess environment. `dcode` runs its own local-context detection\nthrough Bash during startup, so variables such as `BASH_ENV` and `ENV`\ncan cause project-provided scripts to run before any model-requested\ntool call or approval prompt.\n\nThis blocks shell startup and environment-hijack keys from\nproject/global dotenv loading while preserving normal app/API\nconfiguration values. The preview path now uses the same denylist as the\nreal reload path so dry-run config changes cannot report values that a\nreal reload would reject.\n\nRegression coverage verifies that denied keys are omitted from dotenv\nloading, preview loading mirrors that behavior, and local-context\nstartup detection does not execute a `BASH_ENV` payload from a project\n`.env`.","verified_at":"2026-06-25T20:51:01Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/686d6f3a1da8b6393efb4c0cf87b3eb35e0cca50","html_url":"https://github.com/langchain-ai/deepagents/commit/686d6f3a1da8b6393efb4c0cf87b3eb35e0cca50","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/686d6f3a1da8b6393efb4c0cf87b3eb35e0cca50/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"820b331552cb7ce4695ddca3c9b8343a3144392b","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/820b331552cb7ce4695ddca3c9b8343a3144392b","html_url":"https://github.com/langchain-ai/deepagents/commit/820b331552cb7ce4695ddca3c9b8343a3144392b"}]},{"sha":"820b331552cb7ce4695ddca3c9b8343a3144392b","node_id":"C_kwDOPTymldoAKDgyMGIzMzE1NTJjYjdjZTQ2OTVkZGNhM2M5YjgzNDNhMzE0NDM5MmI","commit":{"author":{"name":"Parvesh","email":"97528080+parveshsaini@users.noreply.github.com","date":"2026-06-25T20:46:39Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-25T20:46:39Z"},"message":"fix(code): show months instead of \"0y ago\" for 360-364 day old timestamps (#4267)\n\nFixes #4265\n\n---\n\n<!-- Keep the `Fixes #xx` keyword at the very top and update the issue\nnumber — this auto-closes the issue on merge. Replace this comment with\na 1-2 sentence description of your change. No `# Summary` header; the\ndescription is the summary. -->\n## Summary\n`format_relative_timestamp` showed `\"0y ago\"` for timestamps 360–364\ndays old, since the months branch stopped at `days < 360` but the years\nbranch only kicks in at `days >= 365`. This closes that gap so those\ndates show `\"12mo ago\"`.\n\nUser story: with relative timestamps enabled, opening the `/threads`\nswitcher to resume an old session shows each thread's age. A thread last\ntouched ~360–364 days ago reads `\"0y ago\"`, which looks broken and is\nhard to tell apart from a brand-new thread. The same helper formats the\n`released … ago` line on the update notice, so that hits the gap too.\nAfter this fix both read `\"12mo ago\"`.\n\nI came across it while reading the timestamp bucketing, the month bucket\ndivides by 30 and the year bucket by 365, so I checked the boundary\nbetween them and confirmed 360–364 days falls through to `\"0y ago\"`.\n\nNo breaking changes; only the 360–364 day range is affected.\n\n**How I verified**: added a boundary test that fails on `main` and\npasses here, and ran `make format`, `make lint`, and `make test` for the\n`code` package.\n\n> Disclaimer: I used generative AI to help with this contribution. I\nreproduced the issue and confirmed the fix myself.\n\n## Social handles (optional)\n<!-- If you'd like a shoutout on release, add your socials below -->\nTwitter: @PrvshHasNoLife\nLinkedIn: https://www.linkedin.com/in/saini-parvesh/\n\n---------\n\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","tree":{"sha":"8bec39ef0ba0cf2dce05249e4f3878f5ca14c523","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/8bec39ef0ba0cf2dce05249e4f3878f5ca14c523"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/820b331552cb7ce4695ddca3c9b8343a3144392b","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPZOvCRC1aQ7uu5UhlAAA6EkQAA8WCs0HrwE2kJ3x6qjRJQYX\nogfH0Cm6JQ/Lw0Ti6D1quRMn6nolOs5fGdpN1yhwbCL06SOqcAh1LOl+Sn8ucPbV\nWzXgMZmExu+NaLK8jA6asXZnfASYXDG9EzCpKhk2yNH0T+61NTUkNFyTzP6Oi2/H\nyMsmnf+tMuTa3Jpev3nBDpEn0jJ32VhCoGq3NDYacvn/dAADsIJlH0pRHP98QB6C\niS8FiwlGIsZKEEu85P2uVED/bJB/MZZ3Bx9qduYh6ZzsqdldHwfcjYWlMygvQgo7\nqe4Gu/G/nCvUoCHi6LgkOEd9RXuqlj+/G6v/4KqA86aHdqvGTv6lktmIZJ3pcETd\n7vpdETKLc7ll/Hl6Fu0dvS6iPNyQzL8P8vgu092fXE86pL+A3rKJf9RVerGe4qXQ\nxoJiZosGPoiZifCzohAdZecuTmvnYhjx+O/oi9vaVhn1slyhD6CLr3gYtDkMHFfU\np2VEnZxFJukw7zJ4GmNywQW0NTg4RW2cxvssk9isau420CDggsFnIDlQMq7aduSw\nWdQIg6T8RvNauTNN1TKSleaV0+1Rd4TZ3L+sqFRitVKxvlaXi63iIR1HgHqWw1lW\n38c/6rUnMgZ0Jpo1mNKJNw17orNIfCqABNmDAtGnNgX8f2TgTxHFF/u2R/C6JJ1y\nIS/O/7xHxA2OU6O2/mQp\n=kSY6\n-----END PGP SIGNATURE-----\n","payload":"tree 8bec39ef0ba0cf2dce05249e4f3878f5ca14c523\nparent 8e90e297e865d21bea64b76c1e185c90f6109fef\nauthor Parvesh <97528080+parveshsaini@users.noreply.github.com> 1782420399 +0530\ncommitter GitHub <noreply@github.com> 1782420399 -0400\n\nfix(code): show months instead of \"0y ago\" for 360-364 day old timestamps (#4267)\n\nFixes #4265\n\n---\n\n<!-- Keep the `Fixes #xx` keyword at the very top and update the issue\nnumber — this auto-closes the issue on merge. Replace this comment with\na 1-2 sentence description of your change. No `# Summary` header; the\ndescription is the summary. -->\n## Summary\n`format_relative_timestamp` showed `\"0y ago\"` for timestamps 360–364\ndays old, since the months branch stopped at `days < 360` but the years\nbranch only kicks in at `days >= 365`. This closes that gap so those\ndates show `\"12mo ago\"`.\n\nUser story: with relative timestamps enabled, opening the `/threads`\nswitcher to resume an old session shows each thread's age. A thread last\ntouched ~360–364 days ago reads `\"0y ago\"`, which looks broken and is\nhard to tell apart from a brand-new thread. The same helper formats the\n`released … ago` line on the update notice, so that hits the gap too.\nAfter this fix both read `\"12mo ago\"`.\n\nI came across it while reading the timestamp bucketing, the month bucket\ndivides by 30 and the year bucket by 365, so I checked the boundary\nbetween them and confirmed 360–364 days falls through to `\"0y ago\"`.\n\nNo breaking changes; only the 360–364 day range is affected.\n\n**How I verified**: added a boundary test that fails on `main` and\npasses here, and ran `make format`, `make lint`, and `make test` for the\n`code` package.\n\n> Disclaimer: I used generative AI to help with this contribution. I\nreproduced the issue and confirmed the fix myself.\n\n## Social handles (optional)\n<!-- If you'd like a shoutout on release, add your socials below -->\nTwitter: @PrvshHasNoLife\nLinkedIn: https://www.linkedin.com/in/saini-parvesh/\n\n---------\n\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","verified_at":"2026-06-25T20:46:40Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/820b331552cb7ce4695ddca3c9b8343a3144392b","html_url":"https://github.com/langchain-ai/deepagents/commit/820b331552cb7ce4695ddca3c9b8343a3144392b","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/820b331552cb7ce4695ddca3c9b8343a3144392b/comments","author":{"login":"parveshsaini","id":97528080,"node_id":"U_kgDOBdApEA","avatar_url":"https://avatars.githubusercontent.com/u/97528080?v=4","gravatar_id":"","url":"https://api.github.com/users/parveshsaini","html_url":"https://github.com/parveshsaini","followers_url":"https://api.github.com/users/parveshsaini/followers","following_url":"https://api.github.com/users/parveshsaini/following{/other_user}","gists_url":"https://api.github.com/users/parveshsaini/gists{/gist_id}","starred_url":"https://api.github.com/users/parveshsaini/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/parveshsaini/subscriptions","organizations_url":"https://api.github.com/users/parveshsaini/orgs","repos_url":"https://api.github.com/users/parveshsaini/repos","events_url":"https://api.github.com/users/parveshsaini/events{/privacy}","received_events_url":"https://api.github.com/users/parveshsaini/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"8e90e297e865d21bea64b76c1e185c90f6109fef","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/8e90e297e865d21bea64b76c1e185c90f6109fef","html_url":"https://github.com/langchain-ai/deepagents/commit/8e90e297e865d21bea64b76c1e185c90f6109fef"}]},{"sha":"8e90e297e865d21bea64b76c1e185c90f6109fef","node_id":"C_kwDOPTymldoAKDhlOTBlMjk3ZTg2NWQyMWJlYTY0Yjc2YzFlMTg1YzkwZjYxMDlmZWY","commit":{"author":{"name":"John Kennedy","email":"65985482+jkennedyvz@users.noreply.github.com","date":"2026-06-25T20:42:07Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-25T20:42:07Z"},"message":"docs(talon): clarify experimental security support (#4287)\n\nClarifies Talon’s alpha status and security-support boundaries so\nreaders know production HITL policy, sandbox isolation, channel admin\ncontrols, and multi-tenant boundaries are not implemented yet. Also\ndocuments that reports about those known missing hardening features are\ntreated as feature requests while Talon remains experimental.\n\nDocs-only change; verified with `git diff --check`.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/25c781c1-fad7-a196-6adb-5e606877a1f2)\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"ffa5a227b7d93fb5bac14e4bf435634b1c63ac6b","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/ffa5a227b7d93fb5bac14e4bf435634b1c63ac6b"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/8e90e297e865d21bea64b76c1e185c90f6109fef","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPZKfCRC1aQ7uu5UhlAAAmMMQAJWjX+viQo8TaV3HCdjmmEmF\nTHyAMYPHxOlBp/l32oMy0VSQCZmH3EBJICznN9qcQkSVzpbn9C+RhYE8IyJJaYQT\nZQ2DgbJwZ5/PhT5fzH4tpiKaybRNyCV5BmzcjLEX15+2rkASWt4xwsC16eZ07YB6\nGxHc4Ga15moHPCdo4kSdMYnmFHkfo4p5dsK/fvVlhZCfYQy8ZTA2vAro6HE6dmnl\n0Hx8up8gd/ZlsLsQ/pvdHjzGHM/WdLFnlwrgzW0Yc1yt44wEj9KSvmC/NlsahqDj\nvX5vVEFO+E71Et80rnX4lz8aMef4lgIWeivQ0ooxL25ufUBlL0Kq30FJzkM+uD1R\nn7FVuHBldrto9w7sppt0U9gwFsLLJB1xrDKwPstNgK9dAWaASyF2H98Qo2XXq7E6\n1Zzy1qplVmcj9SZEdruVO1rGIQVp/qet7+T05cln8zLb3SDVd2FMr0ZWz0K3pc6Q\nGaK6xt3yH4mAsgEuvcUMcbQ2tnHwSQi6R7DjamgsQVUtOOUMQbizHRg5UtGe5yTi\nDLHseOd1AeSy70HV1yoK73g5ix2NmXTSPeg4OXubJE2GxFOyWqdBeZq9rIgVXCzT\n0ku2kmLe7/zcoM5oIrW63wXLdrGDt/x4sJJIDtDE7/b3S7Y/L3iCOto0lHW9sPX2\nS0VwcbIw+xG2XPNaoZUP\n=AHHy\n-----END PGP SIGNATURE-----\n","payload":"tree ffa5a227b7d93fb5bac14e4bf435634b1c63ac6b\nparent f2ba6efb414c72a00f8b6e868d838a556d256c60\nauthor John Kennedy <65985482+jkennedyvz@users.noreply.github.com> 1782420127 -0700\ncommitter GitHub <noreply@github.com> 1782420127 -0700\n\ndocs(talon): clarify experimental security support (#4287)\n\nClarifies Talon’s alpha status and security-support boundaries so\nreaders know production HITL policy, sandbox isolation, channel admin\ncontrols, and multi-tenant boundaries are not implemented yet. Also\ndocuments that reports about those known missing hardening features are\ntreated as feature requests while Talon remains experimental.\n\nDocs-only change; verified with `git diff --check`.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/25c781c1-fad7-a196-6adb-5e606877a1f2)\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-25T20:42:08Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/8e90e297e865d21bea64b76c1e185c90f6109fef","html_url":"https://github.com/langchain-ai/deepagents/commit/8e90e297e865d21bea64b76c1e185c90f6109fef","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/8e90e297e865d21bea64b76c1e185c90f6109fef/comments","author":{"login":"jkennedyvz","id":65985482,"node_id":"MDQ6VXNlcjY1OTg1NDgy","avatar_url":"https://avatars.githubusercontent.com/u/65985482?v=4","gravatar_id":"","url":"https://api.github.com/users/jkennedyvz","html_url":"https://github.com/jkennedyvz","followers_url":"https://api.github.com/users/jkennedyvz/followers","following_url":"https://api.github.com/users/jkennedyvz/following{/other_user}","gists_url":"https://api.github.com/users/jkennedyvz/gists{/gist_id}","starred_url":"https://api.github.com/users/jkennedyvz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jkennedyvz/subscriptions","organizations_url":"https://api.github.com/users/jkennedyvz/orgs","repos_url":"https://api.github.com/users/jkennedyvz/repos","events_url":"https://api.github.com/users/jkennedyvz/events{/privacy}","received_events_url":"https://api.github.com/users/jkennedyvz/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f2ba6efb414c72a00f8b6e868d838a556d256c60","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/f2ba6efb414c72a00f8b6e868d838a556d256c60","html_url":"https://github.com/langchain-ai/deepagents/commit/f2ba6efb414c72a00f8b6e868d838a556d256c60"}]},{"sha":"f2ba6efb414c72a00f8b6e868d838a556d256c60","node_id":"C_kwDOPTymldoAKGYyYmE2ZWZiNDE0YzcyYTAwZjhiNmU4NjhkODM4YTU1NmQyNTZjNjA","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-25T20:29:36Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-25T20:29:36Z"},"message":"fix(ci): skip lockfile fixer for non-uv Dependabot PRs (#4286)\n\nThe Dependabot lockfile fixer is meant to repair uv lockfile PRs, but it\ncurrently runs on every same-repo Dependabot PR. GitHub Actions update\nPRs then fail the security preflight because workflow files are\nintentionally outside the uv `pyproject.toml`/`uv.lock` allowlist.\n\nThis narrows the trusted job guard to `dependabot/uv/` branches, so\nnon-uv Dependabot PRs do not surface a failing lockfile-fix check. The\nfail-closed changed-file guard still applies to actual uv Dependabot PRs\nbefore any write credentials are minted.","tree":{"sha":"e0bb253fa6003eced1c36a0d2b73cd7fc9831dee","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/e0bb253fa6003eced1c36a0d2b73cd7fc9831dee"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/f2ba6efb414c72a00f8b6e868d838a556d256c60","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqPY+wCRC1aQ7uu5UhlAAAnFcQAEiE0GPLf9Hd3c3oCGPrXYs4\nBYYPwHjZYKJTfRX4SjlFSY6TZvMQgVM6xFw01GCf98VAwmDVQesKzjWp1Gi3bdHE\n61KVuS4ZiS4fNHAiWuCDKz5L6f8FIc18NvB56PYxceZgt8eTQ3mItd2v5WGGoiyH\n949yZtnQ+MDmYJZx1QuJwgEgzedMfcvfKs8SrQM/Xrn9QinDc0ik5ocRylDCtex9\nBSq/KwRUH/2UnJmYPaveL4wP6qY7sU3j33khlcAmozMhQXzAWhFy1Dlo/52NruBf\nTPP2riftbMa3m5RRDIvMe3i9Ta+QPRUioTkuJIzHoArzkxFqVxKjBm++6trBnZB5\nnoKAzU/MjSRitA+fZaB3JHo5kg7Bq8kKWrej0bK/RhLTaPcXVAtqN/XggGLVZLt1\nbwubMhLVMhwqbnP8nzMPmvcFmSk+Q9VeX3vcHJABoXgenUV9QCrqrAowhEl6Vpaf\n9JWhsduxU6tfNqm4vWKbXZQfC19bOVQtWfHuMayTy46i8wgGWItb6gqEeAuYYk0u\n0fCy6EV82FibghLDqDp4jtKOBhG1AMVIFnpzLHeHmPwhf70vTKslRVb6bcUuffO+\nWk2IRxmBWmhTilEaEMbFV3Q+iOf56KOw3VsyDuKbkNbi0A0Nx3DmQjvPAgEWob4P\ncS69upCH4eWX7NfUhMrw\n=Hkm0\n-----END PGP SIGNATURE-----\n","payload":"tree e0bb253fa6003eced1c36a0d2b73cd7fc9831dee\nparent 1a58a4399e146a7af94ff049a3afec38ff387070\nauthor Mason Daugherty <mason@langchain.dev> 1782419376 -0400\ncommitter GitHub <noreply@github.com> 1782419376 -0400\n\nfix(ci): skip lockfile fixer for non-uv Dependabot PRs (#4286)\n\nThe Dependabot lockfile fixer is meant to repair uv lockfile PRs, but it\ncurrently runs on every same-repo Dependabot PR. GitHub Actions update\nPRs then fail the security preflight because workflow files are\nintentionally outside the uv `pyproject.toml`/`uv.lock` allowlist.\n\nThis narrows the trusted job guard to `dependabot/uv/` branches, so\nnon-uv Dependabot PRs do not surface a failing lockfile-fix check. The\nfail-closed changed-file guard still applies to actual uv Dependabot PRs\nbefore any write credentials are minted.","verified_at":"2026-06-25T20:29:36Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/f2ba6efb414c72a00f8b6e868d838a556d256c60","html_url":"https://github.com/langchain-ai/deepagents/commit/f2ba6efb414c72a00f8b6e868d838a556d256c60","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/f2ba6efb414c72a00f8b6e868d838a556d256c60/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"1a58a4399e146a7af94ff049a3afec38ff387070","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/1a58a4399e146a7af94ff049a3afec38ff387070","html_url":"https://github.com/langchain-ai/deepagents/commit/1a58a4399e146a7af94ff049a3afec38ff387070"}]},{"sha":"1a58a4399e146a7af94ff049a3afec38ff387070","node_id":"C_kwDOPTymldoAKDFhNThhNDM5OWUxNDZhN2FmOTRmZjA0OWEzYWZlYzM4ZmYzODcwNzA","commit":{"author":{"name":"dependabot[bot]","email":"49699333+dependabot[bot]@users.noreply.github.com","date":"2026-06-25T20:29:23Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-25T20:29:23Z"},"message":"chore(deps): bump the major group with 2 updates (#4285)\n\nBumps the major group with 2 updates:\n[actions/cache](https://github.com/actions/cache) and\n[actions/checkout](https://github.com/actions/checkout).\n\nUpdates `actions/cache` from 5 to 6\n<details>\n<summary>Release notes</summary>\n<p><em>Sourced from <a\nhref=\"https://github.com/actions/cache/releases\">actions/cache's\nreleases</a>.</em></p>\n<blockquote>\n<h2>v6.0.0</h2>\n<h2>What's Changed</h2>\n<ul>\n<li>Update packages, migrate to ESM by <a\nhref=\"https://github.com/Samirat\"><code>@​Samirat</code></a> in <a\nhref=\"https://redirect.github.com/actions/cache/pull/1760\">actions/cache#1760</a></li>\n</ul>\n<p><strong>Full Changelog</strong>: <a\nhref=\"https://github.com/actions/cache/compare/v5...v6.0.0\">https://github.com/actions/cache/compare/v5...v6.0.0</a></p>\n<h2>v5.0.5</h2>\n<h2>What's Changed</h2>\n<ul>\n<li>Update ts-http-runtime dependency by <a\nhref=\"https://github.com/yacaovsnc\"><code>@​yacaovsnc</code></a> in <a\nhref=\"https://redirect.github.com/actions/cache/pull/1747\">actions/cache#1747</a></li>\n</ul>\n<p><strong>Full Changelog</strong>: <a\nhref=\"https://github.com/actions/cache/compare/v5...v5.0.5\">https://github.com/actions/cache/compare/v5...v5.0.5</a></p>\n<h2>v5.0.4</h2>\n<h2>What's Changed</h2>\n<ul>\n<li>Add release instructions and update maintainer docs by <a\nhref=\"https://github.com/Link\"><code>@​Link</code></a>- in <a\nhref=\"https://redirect.github.com/actions/cache/pull/1696\">actions/cache#1696</a></li>\n<li>Potential fix for code scanning alert no. 52: Workflow does not\ncontain permissions by <a\nhref=\"https://github.com/Link\"><code>@​Link</code></a>- in <a\nhref=\"https://redirect.github.com/actions/cache/pull/1697\">actions/cache#1697</a></li>\n<li>Fix workflow permissions and cleanup workflow names / formatting by\n<a href=\"https://github.com/Link\"><code>@​Link</code></a>- in <a\nhref=\"https://redirect.github.com/actions/cache/pull/1699\">actions/cache#1699</a></li>\n<li>docs: Update examples to use the latest version by <a\nhref=\"https://github.com/XZTDean\"><code>@​XZTDean</code></a> in <a\nhref=\"https://redirect.github.com/actions/cache/pull/1690\">actions/cache#1690</a></li>\n<li>Fix proxy integration tests by <a\nhref=\"https://github.com/Link\"><code>@​Link</code></a>- in <a\nhref=\"https://redirect.github.com/actions/cache/pull/1701\">actions/cache#1701</a></li>\n<li>Fix cache key in examples.md for bun.lock by <a\nhref=\"https://github.com/RyPeck\"><code>@​RyPeck</code></a> in <a\nhref=\"https://redirect.github.com/actions/cache/pull/1722\">actions/cache#1722</a></li>\n<li>Update dependencies &amp; patch security vulnerabilities by <a\nhref=\"https://github.com/Link\"><code>@​Link</code></a>- in <a\nhref=\"https://redirect.github.com/actions/cache/pull/1738\">actions/cache#1738</a></li>\n</ul>\n<h2>New Contributors</h2>\n<ul>\n<li><a href=\"https://github.com/XZTDean\"><code>@​XZTDean</code></a> made\ntheir first contribution in <a\nhref=\"https://redirect.github.com/actions/cache/pull/1690\">actions/cache#1690</a></li>\n<li><a href=\"https://github.com/RyPeck\"><code>@​RyPeck</code></a> made\ntheir first contribution in <a\nhref=\"https://redirect.github.com/actions/cache/pull/1722\">actions/cache#1722</a></li>\n</ul>\n<p><strong>Full Changelog</strong>: <a\nhref=\"https://github.com/actions/cache/compare/v5...v5.0.4\">https://github.com/actions/cache/compare/v5...v5.0.4</a></p>\n<h2>v5.0.3</h2>\n<h2>What's Changed</h2>\n<ul>\n<li>Bump <code>@actions/cache</code> to v5.0.5 (Resolves: <a\nhref=\"https://github.com/actions/cache/security/dependabot/33\">https://github.com/actions/cache/security/dependabot/33</a>)</li>\n<li>Bump <code>@actions/core</code> to v2.0.3</li>\n</ul>\n<p><strong>Full Changelog</strong>: <a\nhref=\"https://github.com/actions/cache/compare/v5...v5.0.3\">https://github.com/actions/cache/compare/v5...v5.0.3</a></p>\n<h2>v.5.0.2</h2>\n<h1>v5.0.2</h1>\n<h2>What's Changed</h2>\n<p>When creating cache entries, 429s returned from the cache service\nwill not be retried.</p>\n<h2>v5.0.1</h2>\n<blockquote>\n<p>[!IMPORTANT]\n<strong><code>actions/cache@v5</code> runs on the Node.js 24 runtime and\nrequires a minimum Actions Runner version of\n<code>2.327.1</code>.</strong></p>\n</blockquote>\n<!-- raw HTML omitted -->\n</blockquote>\n<p>... (truncated)</p>\n</details>\n<details>\n<summary>Changelog</summary>\n<p><em>Sourced from <a\nhref=\"https://github.com/actions/cache/blob/main/RELEASES.md\">actions/cache's\nchangelog</a>.</em></p>\n<blockquote>\n<h1>Releases</h1>\n<h2>How to prepare a release</h2>\n<blockquote>\n<p>[!NOTE]\nRelevant for maintainers with write access only.</p>\n</blockquote>\n<ol>\n<li>Switch to a new branch from <code>main</code>.</li>\n<li>Run <code>npm test</code> to ensure all tests are passing.</li>\n<li>Update the version in <a\nhref=\"https://github.com/actions/cache/blob/main/package.json\"><code>https://github.com/actions/cache/blob/main/package.json</code></a>.</li>\n<li>Run <code>npm run build</code> to update the compiled files.</li>\n<li>Update this <a\nhref=\"https://github.com/actions/cache/blob/main/RELEASES.md\"><code>https://github.com/actions/cache/blob/main/RELEASES.md</code></a>\nwith the new version and changes in the <code>## Changelog</code>\nsection.</li>\n<li>Run <code>licensed cache</code> to update the license report.</li>\n<li>Run <code>licensed status</code> and resolve any warnings by\nupdating the <a\nhref=\"https://github.com/actions/cache/blob/main/.licensed.yml\"><code>https://github.com/actions/cache/blob/main/.licensed.yml</code></a>\nfile with the exceptions.</li>\n<li>Commit your changes and push your branch upstream.</li>\n<li>Open a pull request against <code>main</code> and get it reviewed\nand merged.</li>\n<li>Draft a new release <a\nhref=\"https://github.com/actions/cache/releases\">https://github.com/actions/cache/releases</a>\nuse the same version number used in <code>package.json</code>\n<ol>\n<li>Create a new tag with the version number.</li>\n<li>Auto generate release notes and update them to match the changes you\nmade in <code>RELEASES.md</code>.</li>\n<li>Toggle the set as the latest release option.</li>\n<li>Publish the release.</li>\n</ol>\n</li>\n<li>Navigate to <a\nhref=\"https://github.com/actions/cache/actions/workflows/release-new-action-version.yml\">https://github.com/actions/cache/actions/workflows/release-new-action-version.yml</a>\n<ol>\n<li>There should be a workflow run queued with the same version\nnumber.</li>\n<li>Approve the run to publish the new version and update the major tags\nfor this action.</li>\n</ol>\n</li>\n</ol>\n<h2>Changelog</h2>\n<h3>6.1.0</h3>\n<ul>\n<li>Bump <code>@actions/cache</code> to v6.1.0 to pick up <a\nhref=\"https://redirect.github.com/actions/toolkit/pull/2435\">actions/toolkit#2435\nHandle cache write error due to read-only token</a></li>\n<li>Switch redundant &quot;Cache save failed&quot; warning to debug log\nin save-only</li>\n</ul>\n<h3>6.0.0</h3>\n<ul>\n<li>Updated <code>@actions/cache</code> to ^6.0.1,\n<code>@actions/core</code> to ^3.0.1, <code>@actions/exec</code> to\n^3.0.0, <code>@actions/io</code> to ^3.0.2</li>\n<li>Migrated to ESM module system</li>\n<li>Upgraded Jest to v30 and test infrastructure to be ESM\ncompatible</li>\n</ul>\n<h3>5.0.4</h3>\n<ul>\n<li>Bump <code>minimatch</code> to v3.1.5 (fixes ReDoS via globstar\npatterns)</li>\n<li>Bump <code>undici</code> to v6.24.1 (WebSocket decompression bomb\nprotection, header validation fixes)</li>\n<li>Bump <code>fast-xml-parser</code> to v5.5.6</li>\n</ul>\n<h3>5.0.3</h3>\n<ul>\n<li>Bump <code>@actions/cache</code> to v5.0.5 (Resolves: <a\nhref=\"https://github.com/actions/cache/security/dependabot/33\">https://github.com/actions/cache/security/dependabot/33</a>)</li>\n<li>Bump <code>@actions/core</code> to v2.0.3</li>\n</ul>\n<h3>5.0.2</h3>\n<!-- raw HTML omitted -->\n</blockquote>\n<p>... (truncated)</p>\n</details>\n<details>\n<summary>Commits</summary>\n<ul>\n<li><a\nhref=\"https://github.com/actions/cache/commit/2c8a9bd7457de244a408f35966fab2fb45fda9c8\"><code>2c8a9bd</code></a>\nMerge pull request <a\nhref=\"https://redirect.github.com/actions/cache/issues/1760\">#1760</a>\nfrom actions/samirat/esm_migration_and_package_update</li>\n<li><a\nhref=\"https://github.com/actions/cache/commit/e9b91fdc3fea7d79165fceb79042ef45c2d51023\"><code>e9b91fd</code></a>\nPrettier fixes</li>\n<li><a\nhref=\"https://github.com/actions/cache/commit/e4884b8ff7f92ef6b52c79eda480bbc86e685adb\"><code>e4884b8</code></a>\nRebuild dist</li>\n<li><a\nhref=\"https://github.com/actions/cache/commit/10baf0191a3c426ea0fa4a3253a5c04233b6e18f\"><code>10baf01</code></a>\nFixed licenses</li>\n<li><a\nhref=\"https://github.com/actions/cache/commit/e39b386c9004d72a15d864ade8c0b3a702d47a37\"><code>e39b386</code></a>\nFix test mock return order</li>\n<li><a\nhref=\"https://github.com/actions/cache/commit/b6928203372a8571ff984c0c883ef3a1adfb0c06\"><code>b692820</code></a>\nPR feedback</li>\n<li><a\nhref=\"https://github.com/actions/cache/commit/60749128a44d25d3c520a489e576380cf00ff3f1\"><code>6074912</code></a>\nRebuild dist bundles as ESM to match type:module</li>\n<li><a\nhref=\"https://github.com/actions/cache/commit/5a912e8b4af820fa082a0e75cfd2c782f8fbfe0e\"><code>5a912e8</code></a>\nFix lint and jest issues</li>\n<li><a\nhref=\"https://github.com/actions/cache/commit/b9bf592b98b6a5d0cad9929c76247de1cac78abe\"><code>b9bf592</code></a>\nUpdate documentation for v6 release</li>\n<li><a\nhref=\"https://github.com/actions/cache/commit/80f777761d0990932f64ed2740522d7226a49062\"><code>80f7777</code></a>\nUpdate packages, migrate to ESM</li>\n<li>See full diff in <a\nhref=\"https://github.com/actions/cache/compare/v5...v6\">compare\nview</a></li>\n</ul>\n</details>\n<br />\n\nUpdates `actions/checkout` from 6.0.2 to 7.0.0\n<details>\n<summary>Release notes</summary>\n<p><em>Sourced from <a\nhref=\"https://github.com/actions/checkout/releases\">actions/checkout's\nreleases</a>.</em></p>\n<blockquote>\n<h2>v7.0.0</h2>\n<h2>What's Changed</h2>\n<ul>\n<li>block checking out fork pr for pull_request_target and workflow_run\nby <a href=\"https://github.com/aiqiaoy\"><code>@​aiqiaoy</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2454\">actions/checkout#2454</a></li>\n<li>Bump actions/publish-immutable-action from 0.0.3 to 0.0.4 in the\nminor-actions-dependencies group across 1 directory by <a\nhref=\"https://github.com/dependabot\"><code>@​dependabot</code></a>[bot]\nin <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2458\">actions/checkout#2458</a></li>\n<li>Bump flatted from 3.3.1 to 3.4.2 by <a\nhref=\"https://github.com/dependabot\"><code>@​dependabot</code></a>[bot]\nin <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2460\">actions/checkout#2460</a></li>\n<li>Bump js-yaml from 4.1.0 to 4.2.0 by <a\nhref=\"https://github.com/dependabot\"><code>@​dependabot</code></a>[bot]\nin <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2461\">actions/checkout#2461</a></li>\n<li>Bump <code>@​actions/core</code> and\n<code>@​actions/tool-cache</code> and Remove uuid by <a\nhref=\"https://github.com/dependabot\"><code>@​dependabot</code></a>[bot]\nin <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2459\">actions/checkout#2459</a></li>\n<li>upgrade module to esm and update dependencies by <a\nhref=\"https://github.com/aiqiaoy\"><code>@​aiqiaoy</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2463\">actions/checkout#2463</a></li>\n<li>Bump the minor-npm-dependencies group across 1 directory with 3\nupdates by <a\nhref=\"https://github.com/dependabot\"><code>@​dependabot</code></a>[bot]\nin <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2462\">actions/checkout#2462</a></li>\n<li>getting ready for checkout v7 release by <a\nhref=\"https://github.com/aiqiaoy\"><code>@​aiqiaoy</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2464\">actions/checkout#2464</a></li>\n<li>update error wording by <a\nhref=\"https://github.com/aiqiaoy\"><code>@​aiqiaoy</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2467\">actions/checkout#2467</a></li>\n</ul>\n<h2>New Contributors</h2>\n<ul>\n<li><a href=\"https://github.com/aiqiaoy\"><code>@​aiqiaoy</code></a> made\ntheir first contribution in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2454\">actions/checkout#2454</a></li>\n</ul>\n<p><strong>Full Changelog</strong>: <a\nhref=\"https://github.com/actions/checkout/compare/v6.0.3...v7.0.0\">https://github.com/actions/checkout/compare/v6.0.3...v7.0.0</a></p>\n<h2>v6.0.3</h2>\n<h2>What's Changed</h2>\n<ul>\n<li>Update changelog by <a\nhref=\"https://github.com/ericsciple\"><code>@​ericsciple</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2357\">actions/checkout#2357</a></li>\n<li>fix: expand merge commit SHA regex and add SHA-256 test cases by <a\nhref=\"https://github.com/yaananth\"><code>@​yaananth</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2414\">actions/checkout#2414</a></li>\n<li>Fix checkout init for SHA-256 repositories by <a\nhref=\"https://github.com/yaananth\"><code>@​yaananth</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2439\">actions/checkout#2439</a></li>\n<li>Update changelog for v6.0.3 by <a\nhref=\"https://github.com/yaananth\"><code>@​yaananth</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2446\">actions/checkout#2446</a></li>\n</ul>\n<h2>New Contributors</h2>\n<ul>\n<li><a href=\"https://github.com/yaananth\"><code>@​yaananth</code></a>\nmade their first contribution in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2414\">actions/checkout#2414</a></li>\n</ul>\n<p><strong>Full Changelog</strong>: <a\nhref=\"https://github.com/actions/checkout/compare/v6...v6.0.3\">https://github.com/actions/checkout/compare/v6...v6.0.3</a></p>\n</blockquote>\n</details>\n<details>\n<summary>Changelog</summary>\n<p><em>Sourced from <a\nhref=\"https://github.com/actions/checkout/blob/main/CHANGELOG.md\">actions/checkout's\nchangelog</a>.</em></p>\n<blockquote>\n<h1>Changelog</h1>\n<h2>v7.0.0</h2>\n<ul>\n<li>Block checking out fork PR for pull_request_target and workflow_run\nby <a href=\"https://github.com/aiqiaoy\"><code>@​aiqiaoy</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2454\">actions/checkout#2454</a></li>\n<li>Bump actions/publish-immutable-action from 0.0.3 to 0.0.4 in the\nminor-actions-dependencies group across 1 directory by <a\nhref=\"https://github.com/dependabot\"><code>@​dependabot</code></a>[bot]\nin <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2458\">actions/checkout#2458</a></li>\n<li>Bump flatted from 3.3.1 to 3.4.2 by <a\nhref=\"https://github.com/dependabot\"><code>@​dependabot</code></a>[bot]\nin <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2460\">actions/checkout#2460</a></li>\n<li>Bump js-yaml from 4.1.0 to 4.2.0 by <a\nhref=\"https://github.com/dependabot\"><code>@​dependabot</code></a>[bot]\nin <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2461\">actions/checkout#2461</a></li>\n<li>Bump <code>@​actions/core</code> and\n<code>@​actions/tool-cache</code> and Remove uuid by <a\nhref=\"https://github.com/dependabot\"><code>@​dependabot</code></a>[bot]\nin <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2459\">actions/checkout#2459</a></li>\n<li>upgrade module to esm and update dependencies by <a\nhref=\"https://github.com/aiqiaoy\"><code>@​aiqiaoy</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2463\">actions/checkout#2463</a></li>\n<li>Bump the minor-npm-dependencies group across 1 directory with 3\nupdates by <a\nhref=\"https://github.com/dependabot\"><code>@​dependabot</code></a>[bot]\nin <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2462\">actions/checkout#2462</a></li>\n</ul>\n<h2>v6.0.3</h2>\n<ul>\n<li>Fix checkout init for SHA-256 repositories by <a\nhref=\"https://github.com/yaananth\"><code>@​yaananth</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2439\">actions/checkout#2439</a></li>\n<li>fix: expand merge commit SHA regex and add SHA-256 test cases by <a\nhref=\"https://github.com/yaananth\"><code>@​yaananth</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2414\">actions/checkout#2414</a></li>\n</ul>\n<h2>v6.0.2</h2>\n<ul>\n<li>Fix tag handling: preserve annotations and explicit fetch-tags by <a\nhref=\"https://github.com/ericsciple\"><code>@​ericsciple</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2356\">actions/checkout#2356</a></li>\n</ul>\n<h2>v6.0.1</h2>\n<ul>\n<li>Add worktree support for persist-credentials includeIf by <a\nhref=\"https://github.com/ericsciple\"><code>@​ericsciple</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2327\">actions/checkout#2327</a></li>\n</ul>\n<h2>v6.0.0</h2>\n<ul>\n<li>Persist creds to a separate file by <a\nhref=\"https://github.com/ericsciple\"><code>@​ericsciple</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2286\">actions/checkout#2286</a></li>\n<li>Update README to include Node.js 24 support details and requirements\nby <a href=\"https://github.com/salmanmkc\"><code>@​salmanmkc</code></a>\nin <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2248\">actions/checkout#2248</a></li>\n</ul>\n<h2>v5.0.1</h2>\n<ul>\n<li>Port v6 cleanup to v5 by <a\nhref=\"https://github.com/ericsciple\"><code>@​ericsciple</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2301\">actions/checkout#2301</a></li>\n</ul>\n<h2>v5.0.0</h2>\n<ul>\n<li>Update actions checkout to use node 24 by <a\nhref=\"https://github.com/salmanmkc\"><code>@​salmanmkc</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2226\">actions/checkout#2226</a></li>\n</ul>\n<h2>v4.3.1</h2>\n<ul>\n<li>Port v6 cleanup to v4 by <a\nhref=\"https://github.com/ericsciple\"><code>@​ericsciple</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2305\">actions/checkout#2305</a></li>\n</ul>\n<h2>v4.3.0</h2>\n<ul>\n<li>docs: update README.md by <a\nhref=\"https://github.com/motss\"><code>@​motss</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/1971\">actions/checkout#1971</a></li>\n<li>Add internal repos for checking out multiple repositories by <a\nhref=\"https://github.com/mouismail\"><code>@​mouismail</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/1977\">actions/checkout#1977</a></li>\n<li>Documentation update - add recommended permissions to Readme by <a\nhref=\"https://github.com/benwells\"><code>@​benwells</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2043\">actions/checkout#2043</a></li>\n<li>Adjust positioning of user email note and permissions heading by <a\nhref=\"https://github.com/joshmgross\"><code>@​joshmgross</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2044\">actions/checkout#2044</a></li>\n<li>Update README.md by <a\nhref=\"https://github.com/nebuk89\"><code>@​nebuk89</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2194\">actions/checkout#2194</a></li>\n<li>Update CODEOWNERS for actions by <a\nhref=\"https://github.com/TingluoHuang\"><code>@​TingluoHuang</code></a>\nin <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2224\">actions/checkout#2224</a></li>\n<li>Update package dependencies by <a\nhref=\"https://github.com/salmanmkc\"><code>@​salmanmkc</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/2236\">actions/checkout#2236</a></li>\n</ul>\n<h2>v4.2.2</h2>\n<ul>\n<li><code>url-helper.ts</code> now leverages well-known environment\nvariables by <a href=\"https://github.com/jww3\"><code>@​jww3</code></a>\nin <a\nhref=\"https://redirect.github.com/actions/checkout/pull/1941\">actions/checkout#1941</a></li>\n<li>Expand unit test coverage for <code>isGhes</code> by <a\nhref=\"https://github.com/jww3\"><code>@​jww3</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/1946\">actions/checkout#1946</a></li>\n</ul>\n<h2>v4.2.1</h2>\n<ul>\n<li>Check out other refs/* by commit if provided, fall back to ref by <a\nhref=\"https://github.com/orhantoy\"><code>@​orhantoy</code></a> in <a\nhref=\"https://redirect.github.com/actions/checkout/pull/1924\">actions/checkout#1924</a></li>\n</ul>\n<!-- raw HTML omitted -->\n</blockquote>\n<p>... (truncated)</p>\n</details>\n<details>\n<summary>Commits</summary>\n<ul>\n<li><a\nhref=\"https://github.com/actions/checkout/commit/9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0\"><code>9c091bb</code></a>\nupdate error wording (<a\nhref=\"https://redirect.github.com/actions/checkout/issues/2467\">#2467</a>)</li>\n<li><a\nhref=\"https://github.com/actions/checkout/commit/1044a6dea927916f2c38ba5aeffbc0a847b1221a\"><code>1044a6d</code></a>\