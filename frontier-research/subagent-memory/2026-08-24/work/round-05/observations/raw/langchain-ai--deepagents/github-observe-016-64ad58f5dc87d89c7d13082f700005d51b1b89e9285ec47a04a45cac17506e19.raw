f7b0ff9362df6346","html_url":"https://github.com/langchain-ai/deepagents/commit/8211e85864f93b0f476a7718f7b0ff9362df6346"}]},{"sha":"8211e85864f93b0f476a7718f7b0ff9362df6346","node_id":"C_kwDOPTymldoAKDgyMTFlODU4NjRmOTNiMGY0NzZhNzcxOGY3YjBmZjkzNjJkZjYzNDY","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-11T02:55:33Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-11T02:55:33Z"},"message":"ci(infra): fail release early if version already on PyPI (#3862)\n\nPorted from langchain-ai/langchain#38055\n\n---\n\n- Check the PyPI per-version JSON endpoint during the release workflow's\nbuild job.\n- Abort before publishing when the package version already exists on\nPyPI.\n- Fail closed if PyPI is unreachable or returns an unexpected status.","tree":{"sha":"13eae6186f2417714743c09a15e931fc7c00f81d","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/13eae6186f2417714743c09a15e931fc7c00f81d"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/8211e85864f93b0f476a7718f7b0ff9362df6346","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKiOlCRC1aQ7uu5UhlAAANu4QAH5J3699Iefco1CXPKWBR44O\nTh2/BY95KHxV6/4CacWnccx9foEO1pahDKU+0xDEKE8rnt/40ukK4r31wyJ0Dvj8\nSwXiKiHSSeCa8lHuGbWutCr1uFQRqixArtEMvAjapd1rDNPbT7K02yRNy8mCTkat\n6IrZ6e+ggM+A0ych1wrwFcxt/MAc5BEeqSChz4HDtD6FtBcOk1YRJZULpT4RMJvn\nvNtm9e9V5yTKdHTFOXxYwAIn1GcRftwjvCG4Y9b5X9SEWJvU7FnH/koMa+T120Q/\nBUBKXTU7ZF+HqtKdU7keLALF7El0MOBaHZArQCBmr33Bn/S1rc5Y0GArm7TX6/k2\nZnw23I0WcrlLMMu6cGzKVAhVqNe0p954d1QrugAxIH/FajTIcVOCBdl/9k3f+ZEn\n9CbnTNI3Ed7zPkCkt8Z2dSq/CIiPaS4iUcXSoxY88zjiKS2sUROuObak+LQ2r3fq\n264YtwwO0Qo66VQikOmHVZTPzCYBLH6XPU/O230Wy4cCMVc7fc5If5j1luvb/8FH\nk9aOtEoc9UnIk8VwVwv5hJ4bKlmrKLuwVcwu17tbaZ1D/HC78lryaoiATYCshah6\nc6bY/BCjxs/qEMiBwt9UgesRqvjDQUhHmrzgIUAoLhE1gPcttJ2xfiatlzukM9q6\nPsFoM0ibShX+3QllezSQ\n=TsRG\n-----END PGP SIGNATURE-----\n","payload":"tree 13eae6186f2417714743c09a15e931fc7c00f81d\nparent 110f1a7a975743efda12e181cb3afc8404202254\nauthor Mason Daugherty <mason@langchain.dev> 1781146533 -0400\ncommitter GitHub <noreply@github.com> 1781146533 -0400\n\nci(infra): fail release early if version already on PyPI (#3862)\n\nPorted from langchain-ai/langchain#38055\n\n---\n\n- Check the PyPI per-version JSON endpoint during the release workflow's\nbuild job.\n- Abort before publishing when the package version already exists on\nPyPI.\n- Fail closed if PyPI is unreachable or returns an unexpected status.","verified_at":"2026-06-11T02:55:34Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/8211e85864f93b0f476a7718f7b0ff9362df6346","html_url":"https://github.com/langchain-ai/deepagents/commit/8211e85864f93b0f476a7718f7b0ff9362df6346","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/8211e85864f93b0f476a7718f7b0ff9362df6346/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"110f1a7a975743efda12e181cb3afc8404202254","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/110f1a7a975743efda12e181cb3afc8404202254","html_url":"https://github.com/langchain-ai/deepagents/commit/110f1a7a975743efda12e181cb3afc8404202254"}]},{"sha":"110f1a7a975743efda12e181cb3afc8404202254","node_id":"C_kwDOPTymldoAKDExMGYxYTdhOTc1NzQzZWZkYTEyZTE4MWNiM2FmYzg0MDQyMDIyNTQ","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-11T02:48:42Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-11T02:48:42Z"},"message":"fix(code): drop lock-key events so Caps Lock in iTerm2 doesn't type (#3855)\n\nWhen `deepagents-code` enables the kitty keyboard protocol with\nassociated-text reporting (the default in iTerm2, VS Code's xterm.js,\nand other modern terminals), pressing a lock key such as Caps Lock\narrives as a key event whose `character` is the text the *next* keypress\nwould have produced — for example `key='caps_lock'`, `character='A'`.\nTextual's parser does not strip that associated text, so the chat\ninput's `TextArea` treated it as printable and inserted a stray letter\non every Caps Lock press.\n\n`ChatTextArea._on_key` now swallows `caps_lock`, `num_lock`, and\n`scroll_lock` events before any insertion logic runs, so toggling those\nlocks never mutates the input.\n\nMade by [Open SWE](https://openswe.vercel.app)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"39095c3b5ffbce8e14c81f44a09845b2c3be899b","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/39095c3b5ffbce8e14c81f44a09845b2c3be899b"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/110f1a7a975743efda12e181cb3afc8404202254","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKiIKCRC1aQ7uu5UhlAAAg4IQAGOQZwUwm9GfwMl8wxWlf22B\nk6aV2a0UMAA97AvXNjDD7oasCXbuFzOtzQo5PBhw/e3RdiDM9kd+/HNtFPxGkh6b\nXvVVwNvzfhENkQB97DWGNokUKcmVd/2g8+Ns9ZC7oUEmvttkG+aq268f7+WyUB86\nNXLn2niXMlbDLug36H8/kKamNbeBRrnQGvGgynwQcDOLt9yj4d9+GjY88lxncsM4\n50a1EiUDAqPC/ch8x/J7oh2yjtDjO9lrDuyZL1UFOC/4Q8Lk8MLUy8pEZPyZuQ58\nU0iFdk18GhxVj4AGmcPnErMQx2KXIfhJ011CV3OajNAZoKEQfB5TX3sLt1STzlLL\nqunL2vD/vEz2zdTBJMmS9eItponloNOLLNbohWQl7yHbKvEZUtMp3ZxJ8JlDjgue\nF34aWnjHsbTVFoyNbtOtweGQKzdr1CAfV4nCGZJgJjyOTuc3qY+Mzsw49G/aRP/e\nvMSvA5GtMvORcW1Q6ES8cDXYh9+m/dqKW971S2/+wKgtImJQLiK3ZdqespvvAU5j\nupjX/Ui/CrKqinvz6WpOiMbAcXy4/rfQbHuNknDuwPC4/s9hfsRLLKp7FAbQJ8Aw\ndEj0cr8AoXFpLfG5hGzswHbnEgCiJBi3kziXf2bKhM1Ind70iSi69wOnJA4IH5wV\nZNS0vpVmCr+YpK2hsAb8\n=Q1RF\n-----END PGP SIGNATURE-----\n","payload":"tree 39095c3b5ffbce8e14c81f44a09845b2c3be899b\nparent 6bb15d4bd97bd16f47504f937c8458d1b53d9cc4\nauthor Mason Daugherty <mason@langchain.dev> 1781146122 -0400\ncommitter GitHub <noreply@github.com> 1781146122 -0400\n\nfix(code): drop lock-key events so Caps Lock in iTerm2 doesn't type (#3855)\n\nWhen `deepagents-code` enables the kitty keyboard protocol with\nassociated-text reporting (the default in iTerm2, VS Code's xterm.js,\nand other modern terminals), pressing a lock key such as Caps Lock\narrives as a key event whose `character` is the text the *next* keypress\nwould have produced — for example `key='caps_lock'`, `character='A'`.\nTextual's parser does not strip that associated text, so the chat\ninput's `TextArea` treated it as printable and inserted a stray letter\non every Caps Lock press.\n\n`ChatTextArea._on_key` now swallows `caps_lock`, `num_lock`, and\n`scroll_lock` events before any insertion logic runs, so toggling those\nlocks never mutates the input.\n\nMade by [Open SWE](https://openswe.vercel.app)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-11T02:48:43Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/110f1a7a975743efda12e181cb3afc8404202254","html_url":"https://github.com/langchain-ai/deepagents/commit/110f1a7a975743efda12e181cb3afc8404202254","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/110f1a7a975743efda12e181cb3afc8404202254/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"6bb15d4bd97bd16f47504f937c8458d1b53d9cc4","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/6bb15d4bd97bd16f47504f937c8458d1b53d9cc4","html_url":"https://github.com/langchain-ai/deepagents/commit/6bb15d4bd97bd16f47504f937c8458d1b53d9cc4"}]},{"sha":"6bb15d4bd97bd16f47504f937c8458d1b53d9cc4","node_id":"C_kwDOPTymldoAKDZiYjE1ZDRiZDk3YmQxNmY0NzUwNGY5MzdjODQ1OGQxYjUzZDljYzQ","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-11T02:31:52Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-11T02:31:52Z"},"message":"fix(code): treat multi-line key-event pastes as one input (#3856)\n\nPasting multi-line text in the `code` TUI no longer splits into multiple\nmessages on terminals that lack bracketed paste.\n\n---\n\nWhen a terminal lacks bracketed paste (common over SSH, in some\ntmux/multiplexer setups, and in several Windows/VS Code terminals), it\nreplays a pasted clipboard as a rapid stream of `Char` and `Enter` key\nevents rather than one paste event. The chat input's \"Plain Enter\nsubmits\" branch then fired on every embedded newline, splitting one\npaste into many submitted messages.\n\nThis broadens the existing paste-burst handling — which previously only\ntriggered for quote-prefixed dropped-path payloads — to arm a short\nEnter-suppression window whenever a run of rapid keystrokes looks like a\nreplayed paste. While that window is active, `enter` inserts a newline\nand extends the window instead of submitting, so the whole paste stays\ngrouped. The approach mirrors Codex's `PasteBurst`. Slash-command\ncontext is exempt so `/command` dispatch keeps its normal Enter\nsemantics. Text insertion is unchanged; only Enter behavior is gated.\n\nMade by [Open SWE](https://openswe.vercel.app)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"123e02454e0896843e9203e26c7794cee4732be0","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/123e02454e0896843e9203e26c7794cee4732be0"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/6bb15d4bd97bd16f47504f937c8458d1b53d9cc4","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKh4YCRC1aQ7uu5UhlAAA3hoQAC1EHN9GdA6yjDPSC44mBG/7\nLEzyVf/HSwqXu9LOWI9N7flZOYzjf5nAETDLywBga5Ey2ALg38P7IHWn2edfsBHe\n5hF6dfcQWacjtC09MYOEQ8eTQAWYInIyyTjL9ljvDx05NJlORGfXvR0wP43aYK96\nMXFJ2kAtx+jJRwQTNKWYJ6jktsMOPepUwHaK3T+/JOm4WnUW/RHQJcsw6nuaVRen\n7YT80pCWMzALM2USGY2k/96ZO3HC54NsQziMc3SkerKBWZO6unSExzR9di7wEWob\nOkiDrKaN6/0TAc8liqmJw0eSZ2sVzW7jow3ef8et4j/dXseJWh+LewhHu4DOrhY2\nOU2F2JIB1zFMxnggDW61X3tbfEW5CWrKo3XeV6AFWWC4AcdQIsZRdFsi3mRk1FhG\nNxEodUQ7yMbmae6J9TNd5dWQLW5zVELe1wDzUA+ny2QRZ8tuXpkAa3BOXHaEj00F\nAAa8Dh6Tk6Cm+CrvGk+4rcp+8XByRL7ySbyb7o/8Cb2f01Bu6wmR6aIrVPBJVa+9\n6kg0OrvKSAEEssgXgdcu6k7+Q7kLfqAGeo6wE6VffMOODNcdLjhJdIoT1Td5EicU\n1Fa8SjiMwnHOxRfV4JutBJa+FFwNea39CCqCsj+6Hm4hASkC5qYIAm6LBmdBcug0\nj/Adi3GPUq1CBvV9W2gH\n=iF8i\n-----END PGP SIGNATURE-----\n","payload":"tree 123e02454e0896843e9203e26c7794cee4732be0\nparent e9495872c161f1ff6c449739c861f21d88388084\nauthor Mason Daugherty <mason@langchain.dev> 1781145112 -0400\ncommitter GitHub <noreply@github.com> 1781145112 -0400\n\nfix(code): treat multi-line key-event pastes as one input (#3856)\n\nPasting multi-line text in the `code` TUI no longer splits into multiple\nmessages on terminals that lack bracketed paste.\n\n---\n\nWhen a terminal lacks bracketed paste (common over SSH, in some\ntmux/multiplexer setups, and in several Windows/VS Code terminals), it\nreplays a pasted clipboard as a rapid stream of `Char` and `Enter` key\nevents rather than one paste event. The chat input's \"Plain Enter\nsubmits\" branch then fired on every embedded newline, splitting one\npaste into many submitted messages.\n\nThis broadens the existing paste-burst handling — which previously only\ntriggered for quote-prefixed dropped-path payloads — to arm a short\nEnter-suppression window whenever a run of rapid keystrokes looks like a\nreplayed paste. While that window is active, `enter` inserts a newline\nand extends the window instead of submitting, so the whole paste stays\ngrouped. The approach mirrors Codex's `PasteBurst`. Slash-command\ncontext is exempt so `/command` dispatch keeps its normal Enter\nsemantics. Text insertion is unchanged; only Enter behavior is gated.\n\nMade by [Open SWE](https://openswe.vercel.app)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-11T02:31:52Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/6bb15d4bd97bd16f47504f937c8458d1b53d9cc4","html_url":"https://github.com/langchain-ai/deepagents/commit/6bb15d4bd97bd16f47504f937c8458d1b53d9cc4","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/6bb15d4bd97bd16f47504f937c8458d1b53d9cc4/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e9495872c161f1ff6c449739c861f21d88388084","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/e9495872c161f1ff6c449739c861f21d88388084","html_url":"https://github.com/langchain-ai/deepagents/commit/e9495872c161f1ff6c449739c861f21d88388084"}]},{"sha":"e9495872c161f1ff6c449739c861f21d88388084","node_id":"C_kwDOPTymldoAKGU5NDk1ODcyYzE2MWYxZmY2YzQ0OTczOWM4NjFmMjFkODgzODgwODQ","commit":{"author":{"name":"Mukil Loganathan","email":"mukil@langchain.dev","date":"2026-06-11T02:02:02Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-11T02:02:02Z"},"message":"refactor(evals): use harbor's built-in langsmith env, drop the adapter (#3861)\n\n## Why\n\nharbor `0.13.2` ships a built-in LangSmith sandbox environment (`-e\nlangsmith`, via the `harbor[langsmith]` extra), which supersedes the\nlocal import-path `LangSmithEnvironment` adapter in `deepagents_harbor`.\nThe adapter's own docstring noted it existed only \"because harbor's\n`EnvironmentType` enum does not include `langsmith` yet\" — that's no\nlonger true.\n\n## What\n\n- Remove `deepagents_harbor/langsmith_environment.py` and its unit test\n(the adapter was only wired into `__init__` exports — no Makefile\ntarget, README, or other code used it).\n- Bump the dep to `harbor[langsmith]>=0.13.2,<0.14.0`.\n- Add a `run-terminal-bench-langsmith` make target using `--env\nlangsmith`, alongside the existing\n`run-terminal-bench-{modal,daytona,docker,runloop}` targets.\n\n## Validation\n\n- `make lint` (ruff + ty) and `make test` (312 passed) pass on harbor\n`0.13.2`.\n- The `-e langsmith` + `DeepAgentsWrapper` path was smoke-tested on prod\nearlier (Deep Agents in a real LangSmith box, `Mean 1.000`, 0\nexceptions).\n\nSupersedes #3230 (which targeted the old `libs/harbor`, removed by the\n`libs/evals` consolidation in #2032).\n\nDrafted with Claude Code (AI agent involvement).\n\n---------\n\nCo-authored-by: Claude Opus 4.8 (1M context) <noreply@anthropic.com>","tree":{"sha":"a8d809ba4ee085b1478efedb318d132a8a5747a5","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/a8d809ba4ee085b1478efedb318d132a8a5747a5"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/e9495872c161f1ff6c449739c861f21d88388084","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKhcaCRC1aQ7uu5UhlAAAHqAQAJefTzQswyzMJ4CGBoqlQdPC\n+4cK8/VmOSVTTY8u3JokfWa4EmU58XZ1ZXhyXIXQlmvVdtr+HWd9lD27v8HMU6jG\nrvz4lsoMGkWsX6L/9rGpgp3QWnkfq2spUuGRo5spxcviJl/4DF1Nn2eDNAymQjPW\nQvwTpg31orY8IHuzbL7+geLd3N9Iy/8x9VWnT1Vnv4H8Dj0/YoeGr8khkk/lZ005\nViPkShMKpJeL29mgdMqi3lOkpOS5vACsCaIaJVSR+MPufqzt++4yT0Zk9YoLlcSS\nKkg+ceNZlYO5eiYszMvM+8UJ8JFh7PTJEVJlNHTL8608XuFbVQ9j+MXpme22tug9\nz2vH+UcrHX3Erv8unGiciv47A4UK90Bc5ZCrrCD1SZkD/xTywukUJNnTuycalHaJ\nPdPe9b5VdVS+xcrwFFw2/Qo6XgQQSdEXqJzZwvG2bKOZbjKB0btsd3yKNrZVyy4u\nMplSeHuC3TfNhu0qDKlIICGEtC4M/uoKI5u0f+DW9fn7Ux2DWpKFYYwkEEYEKn7i\n6Ue1whHGsi3Tus5ggygE2SuWRCky9uvOdpHnUIOatSqtwYq7IzgbhozVduz2ktej\nEon5VzTWTuJzfL3o77OwLYDu0j6W8axvR0u23MfUScBJSLWErFOgVC4YRvN6Y9dx\neHcMWT5/xNNR4LsJtCfe\n=Gc2R\n-----END PGP SIGNATURE-----\n","payload":"tree a8d809ba4ee085b1478efedb318d132a8a5747a5\nparent f1e815f82a1dccb659a311e11917836dd7db2c1e\nauthor Mukil Loganathan <mukil@langchain.dev> 1781143322 -0400\ncommitter GitHub <noreply@github.com> 1781143322 -0400\n\nrefactor(evals): use harbor's built-in langsmith env, drop the adapter (#3861)\n\n## Why\n\nharbor `0.13.2` ships a built-in LangSmith sandbox environment (`-e\nlangsmith`, via the `harbor[langsmith]` extra), which supersedes the\nlocal import-path `LangSmithEnvironment` adapter in `deepagents_harbor`.\nThe adapter's own docstring noted it existed only \"because harbor's\n`EnvironmentType` enum does not include `langsmith` yet\" — that's no\nlonger true.\n\n## What\n\n- Remove `deepagents_harbor/langsmith_environment.py` and its unit test\n(the adapter was only wired into `__init__` exports — no Makefile\ntarget, README, or other code used it).\n- Bump the dep to `harbor[langsmith]>=0.13.2,<0.14.0`.\n- Add a `run-terminal-bench-langsmith` make target using `--env\nlangsmith`, alongside the existing\n`run-terminal-bench-{modal,daytona,docker,runloop}` targets.\n\n## Validation\n\n- `make lint` (ruff + ty) and `make test` (312 passed) pass on harbor\n`0.13.2`.\n- The `-e langsmith` + `DeepAgentsWrapper` path was smoke-tested on prod\nearlier (Deep Agents in a real LangSmith box, `Mean 1.000`, 0\nexceptions).\n\nSupersedes #3230 (which targeted the old `libs/harbor`, removed by the\n`libs/evals` consolidation in #2032).\n\nDrafted with Claude Code (AI agent involvement).\n\n---------\n\nCo-authored-by: Claude Opus 4.8 (1M context) <noreply@anthropic.com>","verified_at":"2026-06-11T02:02:03Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/e9495872c161f1ff6c449739c861f21d88388084","html_url":"https://github.com/langchain-ai/deepagents/commit/e9495872c161f1ff6c449739c861f21d88388084","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/e9495872c161f1ff6c449739c861f21d88388084/comments","author":{"login":"langchain-infra","id":144731603,"node_id":"U_kgDOCKBt0w","avatar_url":"https://avatars.githubusercontent.com/u/144731603?v=4","gravatar_id":"","url":"https://api.github.com/users/langchain-infra","html_url":"https://github.com/langchain-infra","followers_url":"https://api.github.com/users/langchain-infra/followers","following_url":"https://api.github.com/users/langchain-infra/following{/other_user}","gists_url":"https://api.github.com/users/langchain-infra/gists{/gist_id}","starred_url":"https://api.github.com/users/langchain-infra/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/langchain-infra/subscriptions","organizations_url":"https://api.github.com/users/langchain-infra/orgs","repos_url":"https://api.github.com/users/langchain-infra/repos","events_url":"https://api.github.com/users/langchain-infra/events{/privacy}","received_events_url":"https://api.github.com/users/langchain-infra/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubuser