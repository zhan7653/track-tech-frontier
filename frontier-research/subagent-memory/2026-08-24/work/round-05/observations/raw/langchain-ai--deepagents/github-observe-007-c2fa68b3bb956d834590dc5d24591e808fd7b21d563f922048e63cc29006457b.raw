sers/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"9b2185b65d4cbbaad9dd1b632162810a0aefd7eb","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9b2185b65d4cbbaad9dd1b632162810a0aefd7eb","html_url":"https://github.com/langchain-ai/deepagents/commit/9b2185b65d4cbbaad9dd1b632162810a0aefd7eb"}]},{"sha":"9b2185b65d4cbbaad9dd1b632162810a0aefd7eb","node_id":"C_kwDOPTymldoAKDliMjE4NWI2NWQ0Y2JiYWFkOWRkMWI2MzIxNjI4MTBhMGFlZmQ3ZWI","commit":{"author":{"name":"Johannes du Plessis","email":"johannes@langchain.dev","date":"2026-07-29T17:22:29Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-29T17:22:29Z"},"message":"feat(code): add project hooks workspace trust (#5105)\n\nSupersedes #5044 (auto-closed when #4997 squash-merged; GitHub seals\nforce-pushed closed PRs).\n\nProject-level hooks now require an explicit workspace trust decision\nbefore their commands run. Interactive users can allow once, remember\nthe workspace, or skip project hooks; headless runs remain opt-in\nthrough `--trust-project-hooks`.\n\n---\n\nThis closes the execution gap that left interactive project hooks\npermanently disabled while preserving fail-closed behavior. Trust is\nkeyed to the canonical repository root, saved atomically, and enforced\nagain at runtime if a snapshot is ever constructed inconsistently.\n`config path` and the threat model now expose the relevant project,\nuser, and trust locations.\n\nRe-anchored onto `main` after #5104 squash-merged, so the PR diff\ncontains only this branch's commits.\n\n## Review Guide\n\n1. `hooks/trust.py` — store, keys, atomic write, trust APIs\n2. `hooks/loading.py` — project source ingest vs skip\n3. `hooks/runtime.py` — fail-closed runtime guard\n4. `main.py` — `--trust-project-hooks` + interactive prompt\n5. Skim: `app.py`, `client/commands/config.py`, `THREAT_MODEL.md`\n6. Tests: `test_trust.py`, then config/app/main touches\n\n<details>\n<summary>Test plan</summary>\n\n- Full hooks suite passes on the rebuilt stack tip. `test_trust.py`\nkeeps one case per regressable behavior: canonical persistence,\nfail-closed corrupt-store handling, project-source provenance, the\nruntime trust guard, the three prompt outcomes, prompt suppression on\npersisted trust, and Textual wiring.\n\n</details>\n\n\n<!-- branch-stack-start -->\n\n-------------------------\n- main\n  - **feat(code): add project hooks workspace trust** :point_left:\n    - https://github.com/langchain-ai/deepagents/pull/5045\n\n<sup>[Stack](https://www.git-town.com/how-to/proposal-breadcrumb.html)\ngenerated by [Git Town](https://github.com/git-town/git-town)</sup>\n\n<!-- branch-stack-end -->\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"dbf431ec7fc93ca4cff37fb792100b3e73d598ed","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/dbf431ec7fc93ca4cff37fb792100b3e73d598ed"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/9b2185b65d4cbbaad9dd1b632162810a0aefd7eb","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqajbVCRC1aQ7uu5UhlAAAAQQQAILAw407otMeSWaX9hMJG38b\n3iDd9ooQWi+Y0+GkY1KE3JmHkN80LiTZa+Uqu9iQDDPCTXB8Qk6EOocy3BNqrf6p\nRWpjvVLOcjvAikSPK0dlPrNj81p3zv2VJUPpssU9k+MtO+Kbl6z64kQU3mJDG8z6\nlXmw0462CTmTcOy8AQj73guq779kYIzjCfUQlGUrEK0iBwzgw9Shv61PuBLL4Fv5\nVbEc6rs0J3+2NbkTAqzl+YY/wAgdd6o8LaOeq1+mFwgMnQoUHyM8I0+okhHC/3l1\nFIOxv70j0JhPVLl4gJF52acPoIAkDwjq0fAVnIC7lSLaDnlBkPUeVeKQUNptPMov\nThrQs8I9FyMUGgzdxkp83Yc2Nuef5yj2znKb4luIGOnhSYFqBpbuwtygiNOKsliN\nRS3uSUWAOJjkkF5bM70F5eoZ7ZujVPm64m/b8Im/2i1F9Dj83XeU7TZn7xeiOq06\nfcJVKxmGqZfFpxDX9XShtWPZ/s35x1HzfpbzusOFiaaV65N171GBtCSnuNZSMWiv\nc0F5NJX+IgLFgRobONMDIPeUTQlX5w1dpPWldFPk9wo3sxu48SQ2F9fJpi7p9ssJ\nXZqeqAsjeQMtkS2E+MyGYZvgYldhK9XdusbY29YMrAboMBFHf4DQVpXgzk9UkdZ6\nbk8f1bKrPK+woT0Zz9OT\n=n4Il\n-----END PGP SIGNATURE-----\n","payload":"tree dbf431ec7fc93ca4cff37fb792100b3e73d598ed\nparent ff02f83db383eac945955d25f5f3d2b1bbbff178\nauthor Johannes du Plessis <johannes@langchain.dev> 1785345749 -0700\ncommitter GitHub <noreply@github.com> 1785345749 -0700\n\nfeat(code): add project hooks workspace trust (#5105)\n\nSupersedes #5044 (auto-closed when #4997 squash-merged; GitHub seals\nforce-pushed closed PRs).\n\nProject-level hooks now require an explicit workspace trust decision\nbefore their commands run. Interactive users can allow once, remember\nthe workspace, or skip project hooks; headless runs remain opt-in\nthrough `--trust-project-hooks`.\n\n---\n\nThis closes the execution gap that left interactive project hooks\npermanently disabled while preserving fail-closed behavior. Trust is\nkeyed to the canonical repository root, saved atomically, and enforced\nagain at runtime if a snapshot is ever constructed inconsistently.\n`config path` and the threat model now expose the relevant project,\nuser, and trust locations.\n\nRe-anchored onto `main` after #5104 squash-merged, so the PR diff\ncontains only this branch's commits.\n\n## Review Guide\n\n1. `hooks/trust.py` — store, keys, atomic write, trust APIs\n2. `hooks/loading.py` — project source ingest vs skip\n3. `hooks/runtime.py` — fail-closed runtime guard\n4. `main.py` — `--trust-project-hooks` + interactive prompt\n5. Skim: `app.py`, `client/commands/config.py`, `THREAT_MODEL.md`\n6. Tests: `test_trust.py`, then config/app/main touches\n\n<details>\n<summary>Test plan</summary>\n\n- Full hooks suite passes on the rebuilt stack tip. `test_trust.py`\nkeeps one case per regressable behavior: canonical persistence,\nfail-closed corrupt-store handling, project-source provenance, the\nruntime trust guard, the three prompt outcomes, prompt suppression on\npersisted trust, and Textual wiring.\n\n</details>\n\n\n<!-- branch-stack-start -->\n\n-------------------------\n- main\n  - **feat(code): add project hooks workspace trust** :point_left:\n    - https://github.com/langchain-ai/deepagents/pull/5045\n\n<sup>[Stack](https://www.git-town.com/how-to/proposal-breadcrumb.html)\ngenerated by [Git Town](https://github.com/git-town/git-town)</sup>\n\n<!-- branch-stack-end -->\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-07-29T17:22:29Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9b2185b65d4cbbaad9dd1b632162810a0aefd7eb","html_url":"https://github.com/langchain-ai/deepagents/commit/9b2185b65d4cbbaad9dd1b632162810a0aefd7eb","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9b2185b65d4cbbaad9dd1b632162810a0aefd7eb/comments","author":{"login":"johannes117","id":51395795,"node_id":"MDQ6VXNlcjUxMzk1Nzk1","avatar_url":"https://avatars.githubusercontent.com/u/51395795?v=4","gravatar_id":"","url":"https://api.github.com/users/johannes117","html_url":"https://github.com/johannes117","followers_url":"https://api.github.com/users