[{"sha":"c8dc8e5fd5fdfe9c249bb98d691372d87e4b3cff","node_id":"C_kwDOOYsS4doAKGM4ZGM4ZTVmZDVmZGZlOWMyNDliYjk4ZDY5MTM3MmQ4N2U0YjNjZmY","commit":{"author":{"name":"pakrym-oai","email":"pakrym@openai.com","date":"2026-07-10T16:46:38Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T16:55:01Z"},"message":"Propagate workspace roots to exec-server sandboxes (#32214)\n\n## What changed\n\n- Pass configured workspace roots from core to the exec server so filesystem and process sandbox permissions are materialized against the intended roots.\n- Preserve an explicitly empty workspace-root list instead of treating the sandbox working directory as an implicit root.\n- Initialize filesystem sandbox contexts with their working directory as the default workspace root.\n\n## Testing\n\n- Add end-to-end coverage for patch and command writes inside and outside workspace roots.\n- Verify remote filesystem and process sandboxes do not grant access through an empty workspace-root list.\n\nGitOrigin-RevId: 6684c8f7de50970b45a29e2a6323df954c96f9f6","tree":{"sha":"0a36c8b82562704ed0b8edb8fe87b3934c50e823","url":"https://api.github.com/repos/openai/codex/git/trees/0a36c8b82562704ed0b8edb8fe87b3934c50e823"},"url":"https://api.github.com/repos/openai/codex/git/commits/c8dc8e5fd5fdfe9c249bb98d691372d87e4b3cff","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c8dc8e5fd5fdfe9c249bb98d691372d87e4b3cff","html_url":"https://github.com/openai/codex/commit/c8dc8e5fd5fdfe9c249bb98d691372d87e4b3cff","comments_url":"https://api.github.com/repos/openai/codex/commits/c8dc8e5fd5fdfe9c249bb98d691372d87e4b3cff/comments","author":{"login":"pakrym-oai","id":204937752,"node_id":"U_kgDODDcaGA","avatar_url":"https://avatars.githubusercontent.com/u/204937752?v=4","gravatar_id":"","url":"https://api.github.com/users/pakrym-oai","html_url":"https://github.com/pakrym-oai","followers_url":"https://api.github.com/users/pakrym-oai/followers","following_url":"https://api.github.com/users/pakrym-oai/following{/other_user}","gists_url":"https://api.github.com/users/pakrym-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/pakrym-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pakrym-oai/subscriptions","organizations_url":"https://api.github.com/users/pakrym-oai/orgs","repos_url":"https://api.github.com/users/pakrym-oai/repos","events_url":"https://api.github.com/users/pakrym-oai/events{/privacy}","received_events_url":"https://api.github.com/users/pakrym-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"6463ede7db6be662c5594e2022e1925a2b559f03","url":"https://api.github.com/repos/openai/codex/commits/6463ede7db6be662c5594e2022e1925a2b559f03","html_url":"https://github.com/openai/codex/commit/6463ede7db6be662c5594e2022e1925a2b559f03"}]},{"sha":"6463ede7db6be662c5594e2022e1925a2b559f03","node_id":"C_kwDOOYsS4doAKDY0NjNlZGU3ZGI2YmU2NjJjNTU5NGUyMDIyZTE5MjVhMmI1NTlmMDM","commit":{"author":{"name":"Owen Lin","email":"owen@openai.com","date":"2026-07-10T16:45:33Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T16:51:23Z"},"message":"Generate unique IDs for review rollout messages (#32213)\n\n## What changed\n\nAssign a fresh UUIDv7 to each synthesized user and assistant message recorded\nwhen exiting review mode, instead of reusing fixed IDs across review runs.\n\nGitOrigin-RevId: 8524176895e2d8c750760554f515f397728a8554","tree":{"sha":"b0e1773b8f88b1766850b2ea7f2b14d59b9ad813","url":"https://api.github.com/repos/openai/codex/git/trees/b0e1773b8f88b1766850b2ea7f2b14d59b9ad813"},"url":"https://api.github.com/repos/openai/codex/git/commits/6463ede7db6be662c5594e2022e1925a2b559f03","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/6463ede7db6be662c5594e2022e1925a2b559f03","html_url":"https://github.com/openai/codex/commit/6463ede7db6be662c5594e2022e1925a2b559f03","comments_url":"https://api.github.com/repos/openai/codex/commits/6463ede7db6be662c5594e2022e1925a2b559f03/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"d2d00b6632dc991aa4471db0529773029cae5d68","url":"https://api.github.com/repos/openai/codex/commits/d2d00b6632dc991aa4471db0529773029cae5d68","html_url":"https://github.com/openai/codex/commit/d2d00b6632dc991aa4471db0529773029cae5d68"}]},{"sha":"d2d00b6632dc991aa4471db0529773029cae5d68","node_id":"C_kwDOOYsS4doAKGQyZDAwYjY2MzJkYzk5MWFhNDQ3MWRiMDUyOTc3MzAyOWNhZTVkNjg","commit":{"author":{"name":"pakrym-oai","email":"pakrym@openai.com","date":"2026-07-10T16:06:55Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T16:11:58Z"},"message":"Always send reasoning parameters in Responses requests (#32206)\n\n## What changed\n\n- Build a reasoning payload for every Responses request and always include `reasoning.encrypted_content`.\n- Remove `supports_reasoning_summaries` from model metadata and retire the `model_supports_reasoning_summaries` configuration override.\n- Use configured or model-default reasoning effort without a capability gate, including for guardian reviews and tracing.\n\nGitOrigin-RevId: 2c9f194a5d2d4d688a2235299e6358f82ab8e1ea","tree":{"sha":"c88da20d7dab0a50fd5b00011f890945cce54336","url":"https://api.github.com/repos/openai/codex/git/trees/c88da20d7dab0a50fd5b00011f890945cce54336"},"url":"https://api.github.com/repos/openai/codex/git/commits/d2d00b6632dc991aa4471db0529773029cae5d68","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/d2d00b6632dc991aa4471db0529773029cae5d68","html_url":"https://github.com/openai/codex/commit/d2d00b6632dc991aa4471db0529773029cae5d68","comments_url":"https://api.github.com/repos/openai/codex/commits/d2d00b6632dc991aa4471db0529773029cae5d68/comments","author":{"login":"pakrym-oai","id":204937752,"node_id":"U_kgDODDcaGA","avatar_url":"https://avatars.githubusercontent.com/u/204937752?v=4","gravatar_id":"","url":"https://api.github.com/users/pakrym-oai","html_url":"https://github.com/pakrym-oai","followers_url":"https://api.github.com/users/pakrym-oai/followers","following_url":"https://api.github.com/users/pakrym-oai/following{/other_user}","gists_url":"https://api.github.com/users/pakrym-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/pakrym-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pakrym-oai/subscriptions","organizations_url":"https://api.github.com/users/pakrym-oai/orgs","repos_url":"https://api.github.com/users/pakrym-oai/repos","events_url":"https://api.github.com/users/pakrym-oai/events{/privacy}","received_events_url":"https://api.github.com/users/pakrym-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"2b9c05046038c038ec6bddb9db7d11394995372d","url":"https://api.github.com/repos/openai/codex/commits/2b9c05046038c038ec6bddb9db7d11394995372d","html_url":"https://github.com/openai/codex/commit/2b9c05046038c038ec6bddb9db7d11394995372d"}]},{"sha":"2b9c05046038c038ec6bddb9db7d11394995372d","node_id":"C_kwDOOYsS4doAKDJiOWMwNTA0NjAzOGMwMzhlYzZiZGRiOWRiN2QxMTM5NDk5NTM3MmQ","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-10T15:47:03Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T15:52:04Z"},"message":"Add a skill invocation extension contributor (#32200)\n\n## What changed\n\n- Add `SkillInvocationContributor` and registration support to the extension API.\n- Provide invocation callbacks with session-, thread-, and turn-scoped extension data, the turn ID, skill resource, and explicit or implicit invocation kind.\n- Notify registered contributors when Codex observes a deduplicated implicit skill invocation.\n\n## Testing\n\n- Extend the extension registry round-trip test to cover skill invocation contributors.\n\nGitOrigin-RevId: f428336728889d9bf4fba41a7dd8d3a6f9b9728c","tree":{"sha":"9c385f98457879f77df307fffd26d45f0d446916","url":"https://api.github.com/repos/openai/codex/git/trees/9c385f98457879f77df307fffd26d45f0d446916"},"url":"https://api.github.com/repos/openai/codex/git/commits/2b9c05046038c038ec6bddb9db7d11394995372d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/2b9c05046038c038ec6bddb9db7d11394995372d","html_url":"https://github.com/openai/codex/commit/2b9c05046038c038ec6bddb9db7d11394995372d","comments_url":"https://api.github.com/repos/openai/codex/commits/2b9c05046038c038ec6bddb9db7d11394995372d/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"601b61a83ffe2148031422ad9fd15823c3fab3fa","url":"https://api.github.com/repos/openai/codex/commits/601b61a83ffe2148031422ad9fd15823c3fab3fa","html_url":"https://github.com/openai/codex/commit/601b61a83ffe2148031422ad9fd15823c3fab3fa"}]},{"sha":"601b61a83ffe2148031422ad9fd15823c3fab3fa","node_id":"C_kwDOOYsS4doAKDYwMWI2MWE4M2ZmZTIxNDgwMzE0MjJhZDlmZDE1ODIzYzNmYWIzZmE","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-10T15:35:43Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T15:44:56Z"},"message":"Rebind memory consolidation workspace roots (#32197)\n\n## Why\n\nThe memory consolidation agent changes its working directory to the memory\nroot, but applying its sandbox policy directly to the permissions object can\nleave workspace roots inherited from the parent configuration.\n\n## What changed\n\nApply the consolidation sandbox policy through `Config` so its workspace roots\nare synchronized with the memory root. Add a test covering the working\ndirectory, workspace roots, and effective legacy sandbox policy.\n\nGitOrigin-RevId: dc6e75aef1ffa84a2f66fec6ed3a6fedcf9aa672","tree":{"sha":"f9de242cd48d6d26084c9016f54f8262359f3fc9","url":"https://api.github.com/repos/openai/codex/git/trees/f9de242cd48d6d26084c9016f54f8262359f3fc9"},"url":"https://api.github.com/repos/openai/codex/git/commits/601b61a83ffe2148031422ad9fd15823c3fab3fa","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/601b61a83ffe2148031422ad9fd15823c3fab3fa","html_url":"https://github.com/openai/codex/commit/601b61a83ffe2148031422ad9fd15823c3fab3fa","comments_url":"https://api.github.com/repos/openai/codex/commits/601b61a83ffe2148031422ad9fd15823c3fab3fa/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"52c9605dc707f62100157c5869e958268e3a5d15","url":"https://api.github.com/repos/openai/codex/commits/52c9605dc707f62100157c5869e958268e3a5d15","html_url":"https://github.com/openai/codex/commit/52c9605dc707f62100157c5869e958268e3a5d15"}]},{"sha":"52c9605dc707f62100157c5869e958268e3a5d15","node_id":"C_kwDOOYsS4doAKDUyYzk2MDVkYzcwN2Y2MjEwMDE1N2M1ODY5ZTk1ODI2OGUzYTVkMTU","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-10T15:35:21Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T15:40:35Z"},"message":"Validate memory consolidation artifacts before succeeding (#32193)\n\n## Why\n\nA completed Phase 2 agent run does not guarantee that its required outputs were\ncreated correctly. Treating a clean workspace as success can also preserve a\nstate where those outputs are missing.\n\n## What changed\n\n- Require `MEMORY.md` to be a file and `memory_summary.md` to start with `v1`\n  before marking consolidation successful.\n- Fail completed runs with invalid artifacts without resetting the workspace\n  baseline, allowing the job to be retried.\n- Run consolidation for a clean workspace when its required artifacts are\n  invalid instead of taking the no-change success path.\n\n## Testing\n\nAdded coverage for rejecting an invalid summary and retrying a clean workspace\nwhose consolidation artifacts are missing.\n\nGitOrigin-RevId: ac57b2ba9d062c5203ca51afd716795a91814bb3","tree":{"sha":"35899219d265285fd1350b53743cdaf43c19a83f","url":"https://api.github.com/repos/openai/codex/git/trees/35899219d265285fd1350b53743cdaf43c19a83f"},"url":"https://api.github.com/repos/openai/codex/git/commits/52c9605dc707f62100157c5869e958268e3a5d15","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/52c9605dc707f62100157c5869e958268e3a5d15","html_url":"https://github.com/openai/codex/commit/52c9605dc707f62100157c5869e958268e3a5d15","comments_url":"https://api.github.com/repos/openai/codex/commits/52c9605dc707f62100157c5869e958268e3a5d15/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"6138909d6ec58b2fbe635ef973e02caecad5a5aa","url":"https://api.github.com/repos/openai/codex/commits/6138909d6ec58b2fbe635ef973e02caecad5a5aa","html_url":"https://github.com/openai/codex/commit/6138909d6ec58b2fbe635ef973e02caecad5a5aa"}]},{"sha":"6138909d6ec58b2fbe635ef973e02caecad5a5aa","node_id":"C_kwDOOYsS4doAKDYxMzg5MDlkNmVjNThiMmZiZTYzNWVmOTczZTAyY2FlY2FkNWE1YWE","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-10T12:16:14Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T12:22:04Z"},"message":"Keep unified exec output collection bounded (#32150)\n\n## Why\n\nUnified exec can drain process output multiple times while waiting for a command. Collecting those drains into an uncapped buffer allows large commands to exceed the output collection limit.\n\n## What changed\n\n- Accumulate drained output through the capped head/tail buffer so collection remains bounded while preserving the beginning and end of the stream.\n- Include a `... N bytes omitted ...` marker when the collection cap drops output.\n- Calculate the original token estimate from all observed bytes and preserve omission metadata through truncation and sandbox-denial responses.\n\n## Testing\n\n- Cover repeated drains, previously omitted output, omission markers, and large-output summaries.\n\nGitOrigin-RevId: c6e2efeb875ed8f35914365eab7431f25fd3484c","tree":{"sha":"92b32f615aca860e651ef8d41b82a96ebe512cc1","url":"https://api.github.com/repos/openai/codex/git/trees/92b32f615aca860e651ef8d41b82a96ebe512cc1"},"url":"https://api.github.com/repos/openai/codex/git/commits/6138909d6ec58b2fbe635ef973e02caecad5a5aa","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/6138909d6ec58b2fbe635ef973e02caecad5a5aa","html_url":"https://github.com/openai/codex/commit/6138909d6ec58b2fbe635ef973e02caecad5a5aa","comments_url":"https://api.github.com/repos/openai/codex/commits/6138909d6ec58b2fbe635ef973e02caecad5a5aa/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"54c44b9ed4c7d6d1ec9bf7897bb76f6411d8e033","url":"https://api.github.com/repos/openai/codex/commits/54c44b9ed4c7d6d1ec9bf7897bb76f6411d8e033","html_url":"https://github.com/openai/codex/commit/54c44b9ed4c7d6d1ec9bf7897bb76f6411d8e033"}]},{"sha":"54c44b9ed4c7d6d1ec9bf7897bb76f6411d8e033","node_id":"C_kwDOOYsS4doAKDU0YzQ0YjllZDRjN2Q2ZDFlYzliZjc4OTdiYjc2ZjY0MTFkOGUwMzM","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-10T10:55:31Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T11:00:12Z"},"message":"Propagate tracing subscribers to exec start tasks (#32135)\n\n## Why\n\nThe process-start background task can move to a Tokio worker thread, where the\ncaller's thread-local tracing subscriber is otherwise unavailable. This can\nbreak propagation of the caller's trace context to the exec-server request.\n\n## What changed\n\n- Attach both the current span and current tracing subscriber to spawned\n  process-start tasks.\n- Run exec-server Bazel unit tests serially because their tracing setup uses\n  process-global state.\n\n## Testing\n\nRun the trace-context regression test on a multi-thread Tokio runtime so it\nexercises propagation across the background task.\n\nGitOrigin-RevId: a586eefd6983916d670fc5a90f0decd0468d273b","tree":{"sha":"3895903cd940bb1fa136c64ee2096676910210d0","url":"https://api.github.com/repos/openai/codex/git/trees/3895903cd940bb1fa136c64ee2096676910210d0"},"url":"https://api.github.com/repos/openai/codex/git/commits/54c44b9ed4c7d6d1ec9bf7897bb76f6411d8e033","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/54c44b9ed4c7d6d1ec9bf7897bb76f6411d8e033","html_url":"https://github.com/openai/codex/commit/54c44b9ed4c7d6d1ec9bf7897bb76f6411d8e033","comments_url":"https://api.github.com/repos/openai/codex/commits/54c44b9ed4c7d6d1ec9bf7897bb76f6411d8e033/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"707bd3cc1879dfd0ea5b11fd470e2839316080cc","url":"https://api.github.com/repos/openai/codex/commits/707bd3cc1879dfd0ea5b11fd470e2839316080cc","html_url":"https://github.com/openai/codex/commit/707bd3cc1879dfd0ea5b11fd470e2839316080cc"}]},{"sha":"707bd3cc1879dfd0ea5b11fd470e2839316080cc","node_id":"C_kwDOOYsS4doAKDcwN2JkM2NjMTg3OWRmZDBlYTViMTFmZDQ3MGUyODM5MzE2MDgwY2M","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-10T10:47:24Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T10:52:13Z"},"message":"Test stdio JSON-RPC size limits with LF and CRLF (#32134)\n\n## What changed\n\nUpdate the exact-size-limit stdio connection test to exercise both `\\n` and\n`\\r\\n` line endings, sizing the duplex buffer for each delimiter.\n\nGitOrigin-RevId: 949e28bef3f1a34d379f3623f6aa7d99c0ecea80","tree":{"sha":"c14b1c659a5ffab46cf3b6f0f1602096eb04d054","url":"https://api.github.com/repos/openai/codex/git/trees/c14b1c659a5ffab46cf3b6f0f1602096eb04d054"},"url":"https://api.github.com/repos/openai/codex/git/commits/707bd3cc1879dfd0ea5b11fd470e2839316080cc","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/707bd3cc1879dfd0ea5b11fd470e2839316080cc","html_url":"https://github.com/openai/codex/commit/707bd3cc1879dfd0ea5b11fd470e2839316080cc","comments_url":"https://api.github.com/repos/openai/codex/commits/707bd3cc1879dfd0ea5b11fd470e2839316080cc/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"0d1733b5e9ea027a0ff9d75cc3e11103f045f1ce","url":"https://api.github.com/repos/openai/codex/commits/0d1733b5e9ea027a0ff9d75cc3e11103f045f1ce","html_url":"https://github.com/openai/codex/commit/0d1733b5e9ea027a0ff9d75cc3e11103f045f1ce"}]},{"sha":"0d1733b5e9ea027a0ff9d75cc3e11103f045f1ce","node_id":"C_kwDOOYsS4doAKDBkMTczM2I1ZTllYTAyN2EwZmY5ZDc1Y2MzZTExMTAzZjA0NWYxY2U","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-10T10:24:29Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T10:29:30Z"},"message":"Test bounded concurrency in ancestor discovery (#32126)\n\n## What changed\n\nAdd regression coverage that verifies ancestor metadata searches:\n\n- keep at most 256 project-root marker or repository skill-root probes in flight;\n- start the next probe as capacity becomes available; and\n- preserve `AGENTS.md` and repository skill-root discovery order.\n\nGitOrigin-RevId: e7ac90bbeb94573d01e67705001af85ce59165b6","tree":{"sha":"53744298903598c2cb1e9dbfc04a1a0e98394b6b","url":"https://api.github.com/repos/openai/codex/git/trees/53744298903598c2cb1e9dbfc04a1a0e98394b6b"},"url":"https://api.github.com/repos/openai/codex/git/commits/0d1733b5e9ea027a0ff9d75cc3e11103f045f1ce","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/0d1733b5e9ea027a0ff9d75cc3e11103f045f1ce","html_url":"https://github.com/openai/codex/commit/0d1733b5e9ea027a0ff9d75cc3e11103f045f1ce","comments_url":"https://api.github.com/repos/openai/codex/commits/0d1733b5e9ea027a0ff9d75cc3e11103f045f1ce/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c4c21b68a8d55faedbeec72c5aff5c4b704cbe64","url":"https://api.github.com/repos/openai/codex/commits/c4c21b68a8d55faedbeec72c5aff5c4b704cbe64","html_url":"https://github.com/openai/codex/commit/c4c21b68a8d55faedbeec72c5aff5c4b704cbe64"}]},{"sha":"c4c21b68a8d55faedbeec72c5aff5c4b704cbe64","node_id":"C_kwDOOYsS4doAKGM0YzIxYjY4YThkNTVmYWVkYmVlYzcyYzVhZmY1YzRiNzA0Y2JlNjQ","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-10T10:13:52Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T10:21:26Z"},"message":"Bound exec-server stdio JSON-RPC messages (#32123)\n\n## Why\n\nNewline-delimited stdio input could buffer an unterminated JSON-RPC message without a per-message limit. Apply the same 64 MiB ceiling used by the other exec-server transports.\n\n## What changed\n\n- Read stdio messages with bounded lookahead and disconnect when a message exceeds the limit.\n- Preserve LF and CRLF framing, including messages whose payload is exactly at the limit.\n\n## Testing\n\nAdded tests for accepting a limit-sized CRLF message and rejecting an unterminated overlong message.\n\nGitOrigin-RevId: 73eaf883324a7777960725037cc5b9c34720084f","tree":{"sha":"8c8891950f919caed9ba34c1781db50cf27e878b","url":"https://api.github.com/repos/openai/codex/git/trees/8c8891950f919caed9ba34c1781db50cf27e878b"},"url":"https://api.github.com/repos/openai/codex/git/commits/c4c21b68a8d55faedbeec72c5aff5c4b704cbe64","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c4c21b68a8d55faedbeec72c5aff5c4b704cbe64","html_url":"https://github.com/openai/codex/commit/c4c21b68a8d55faedbeec72c5aff5c4b704cbe64","comments_url":"https://api.github.com/repos/openai/codex/commits/c4c21b68a8d55faedbeec72c5aff5c4b704cbe64/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c094a58c9fce51b14706e08837a02a08d899811c","url":"https://api.github.com/repos/openai/codex/commits/c094a58c9fce51b14706e08837a02a08d899811c","html_url":"https://github.com/openai/codex/commit/c094a58c9fce51b14706e08837a02a08d899811c"}]},{"sha":"c094a58c9fce51b14706e08837a02a08d899811c","node_id":"C_kwDOOYsS4doAKGMwOTRhNThjOWZjZTUxYjE0NzA2ZTA4ODM3YTAyYTA4ZDg5OTgxMWM","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-10T10:11:32Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T10:16:47Z"},"message":"Test the shared exec-server HTTP response byte budget (#32122)\n\n## Testing\n\nAdd a concurrent-stream regression test that fills the connection-wide queued\nbody budget across two HTTP responses. Verify that the overflowing stream\nreports the byte-budget error while the other stream still drains successfully.\n\nGitOrigin-RevId: 65efacb15f1368b1de3b98e7ef65ebca66a3840b","tree":{"sha":"80289517e84ed98403f0b99cef02a409019ba78c","url":"https://api.github.com/repos/openai/codex/git/trees/80289517e84ed98403f0b99cef02a409019ba78c"},"url":"https://api.github.com/repos/openai/codex/git/commits/c094a58c9fce51b14706e08837a02a08d899811c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c094a58c9fce51b14706e08837a02a08d899811c","html_url":"https://github.com/openai/codex/commit/c094a58c9fce51b14706e08837a02a08d899811c","comments_url":"https://api.github.com/repos/openai/codex/commits/c094a58c9fce51b14706e08837a02a08d899811c/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4ba28150146e8ae8e949a07951639a929f5ddeae","url":"https://api.github.com/repos/openai/codex/commits/4ba28150146e8ae8e949a07951639a929f5ddeae","html_url":"https://github.com/openai/codex/commit/4ba28150146e8ae8e949a07951639a929f5ddeae"}]},{"sha":"4ba28150146e8ae8e949a07951639a929f5ddeae","node_id":"C_kwDOOYsS4doAKDRiYTI4MTUwMTQ2ZThhZThlOTQ5YTA3OTUxNjM5YTkyOWY1ZGRlYWU","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-10T09:51:08Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T09:56:03Z"},"message":"Bound streamed exec-server HTTP response bodies (#32112)\n\n## Why\n\nFrame-count backpressure does not bound the amount of executor-controlled data\nretained in streamed HTTP response queues, and a single body delta could exceed\nthe intended wire size.\n\n## What changed\n\n- Limit each decoded `http/request/bodyDelta` payload to 1 MiB, split locally\n  produced response chunks at that boundary, and reject oversized incoming\n  deltas.\n- Apply a shared 16 MiB byte budget across queued HTTP response streams. Release\n  capacity as deltas are consumed and fail a stream when the budget is\n  exhausted.\n\n## Testing\n\nAdded coverage for rejecting an oversized delta and for failing a stream after\nits queued deltas exhaust the shared byte budget.\n\nGitOrigin-RevId: be9205fef44b0ec96b84b31a8e059b1cb9cd3f3b","tree":{"sha":"68e64ddba738b1c59d3e0f1671d8f7f9e3ceadc4","url":"https://api.github.com/repos/openai/codex/git/trees/68e64ddba738b1c59d3e0f1671d8f7f9e3ceadc4"},"url":"https://api.github.com/repos/openai/codex/git/commits/4ba28150146e8ae8e949a07951639a929f5ddeae","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4ba28150146e8ae8e949a07951639a929f5ddeae","html_url":"https://github.com/openai/codex/commit/4ba28150146e8ae8e949a07951639a929f5ddeae","comments_url":"https://api.github.com/repos/openai/codex/commits/4ba28150146e8ae8e949a07951639a929f5ddeae/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"6ad0e943cc727dc836d7c671f3377db30107f4d9","url":"https://api.github.com/repos/openai/codex/commits/6ad0e943cc727dc836d7c671f3377db30107f4d9","html_url":"https://github.com/openai/codex/commit/6ad0e943cc727dc836d7c671f3377db30107f4d9"}]},{"sha":"6ad0e943cc727dc836d7c671f3377db30107f4d9","node_id":"C_kwDOOYsS4doAKDZhZDBlOTQzY2M3MjdkYzgzNmQ3YzY3MWYzMzc3ZGIzMDEwN2Y0ZDk","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-10T09:34:16Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T09:39:08Z"},"message":"Reduce startup latency for ancestor discovery (#32106)\n\n## Why\n\nSerial metadata probes add remote round trips while Codex discovers project\ninstructions, repository skills, and project-root markers during startup.\n\n## What changed\n\n- Probe ancestor directories concurrently while preserving discovery order.\n- Raise the shared find-up probe window to cover typical project hierarchies.\n- Refresh project instructions in parallel with plugin and skill warmup.\n\n## Testing\n\nAdd coverage that blocks one metadata request and verifies all expected project-root\nand `AGENTS.md` ancestor probes have started before it is released.\n\nGitOrigin-RevId: 11449837c7a212ec8ed385e7290476e926d93531","tree":{"sha":"389fcb63bb3bc60818494f27ecac725face74ee4","url":"https://api.github.com/repos/openai/codex/git/trees/389fcb63bb3bc60818494f27ecac725face74ee4"},"url":"https://api.github.com/repos/openai/codex/git/commits/6ad0e943cc727dc836d7c671f3377db30107f4d9","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/6ad0e943cc727dc836d7c671f3377db30107f4d9","html_url":"https://github.com/openai/codex/commit/6ad0e943cc727dc836d7c671f3377db30107f4d9","comments_url":"https://api.github.com/repos/openai/codex/commits/6ad0e943cc727dc836d7c671f3377db30107f4d9/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"656a2d0905c9e0b9bdade1badab07ef6d42ca17c","url":"https://api.github.com/repos/openai/codex/commits/656a2d0905c9e0b9bdade1badab07ef6d42ca17c","html_url":"https://github.com/openai/codex/commit/656a2d0905c9e0b9bdade1badab07ef6d42ca17c"}]},{"sha":"656a2d0905c9e0b9bdade1badab07ef6d42ca17c","node_id":"C_kwDOOYsS4doAKDY1NmEyZDA5MDVjOWUwYjliZGFkZTFiYWRhYjA3ZWY2ZDQyY2ExN2M","commit":{"author":{"name":"Michael Bolin","email":"mbolin@openai.com","date":"2026-07-10T09:04:05Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T09:09:22Z"},"message":"Remove the legacy exec policy engine (#32093)\n\n## What changed\n\n- Delete the `codex-execpolicy-legacy` crate, its default policy, and its tests.\n- Remove the crate from the Cargo and Bazel workspaces and clean up its unused dependencies.\n- Remove the legacy matcher reference from the current exec policy documentation.\n\nGitOrigin-RevId: ee756958b46bf759ad43dec8aa1379c1cd4d8b0d","tree":{"sha":"de2a706531712c325828c3f12872aebec42dded6","url":"https://api.github.com/repos/openai/codex/git/trees/de2a706531712c325828c3f12872aebec42dded6"},"url":"https://api.github.com/repos/openai/codex/git/commits/656a2d0905c9e0b9bdade1badab07ef6d42ca17c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/656a2d0905c9e0b9bdade1badab07ef6d42ca17c","html_url":"https://github.com/openai/codex/commit/656a2d0905c9e0b9bdade1badab07ef6d42ca17c","comments_url":"https://api.github.com/repos/openai/codex/commits/656a2d0905c9e0b9bdade1badab07ef6d42ca17c/comments","author":{"login":"bolinfest","id":655869,"node_id":"MDQ6VXNlcjY1NTg2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/655869?v=4","gravatar_id":"","url":"https://api.github.com/users/bolinfest","html_url":"https://github.com/bolinfest","followers_url":"https://api.github.com/users/bolinfest/followers","following_url":"https://api.github.com/users/bolinfest/following{/other_user}","gists_url":"https://api.github.com/users/bolinfest/gists{/gist_id}","starred_url":"https://api.github.com/users/bolinfest/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bolinfest/subscriptions","organizations_url":"https://api.github.com/users/bolinfest/orgs","repos_url":"https://api.github.com/users/bolinfest/repos","events_url":"https://api.github.com/users/bolinfest/events{/privacy}","received_events_url":"https://api.github.com/users/bolinfest/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"dc5ae378967cff0de2cfb30b98c52047ab978e3d","url":"https://api.github.com/repos/openai/codex/commits/dc5ae378967cff0de2cfb30b98c52047ab978e3d","html_url":"https://github.com/openai/codex/commit/dc5ae378967cff0de2cfb30b98c52047ab978e3d"}]},{"sha":"dc5ae378967cff0de2cfb30b98c52047ab978e3d","node_id":"C_kwDOOYsS4doAKGRjNWFlMzc4OTY3Y2ZmMGRlMmNmYjMwYjk4YzUyMDQ3YWI5NzhlM2Q","commit":{"author":{"name":"Michael Bolin","email":"mbolin@openai.com","date":"2026-07-10T08:32:19Z"},"committer":{"name":"Michael Bolin","email":"mbolin@openai.com","date":"2026-07-10T08:32:19Z"},"message":"Initialize Copyberry export baseline\n\nGitOrigin-RevId: 313afeef691aff7819ccd4bdb1e351438c8b40e4","tree":{"sha":"c84504d84bce68a74fc5f6dd5d7bce3535ebd2e0","url":"https://api.github.com/repos/openai/codex/git/trees/c84504d84bce68a74fc5f6dd5d7bce3535ebd2e0"},"url":"https://api.github.com/repos/openai/codex/git/commits/dc5ae378967cff0de2cfb30b98c52047ab978e3d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/dc5ae378967cff0de2cfb30b98c52047ab978e3d","html_url":"https://github.com/openai/codex/commit/dc5ae378967cff0de2cfb30b98c52047ab978e3d","comments_url":"https://api.github.com/repos/openai/codex/commits/dc5ae378967cff0de2cfb30b98c52047ab978e3d/comments","author":{"login":"bolinfest","id":655869,"node_id":"MDQ6VXNlcjY1NTg2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/655869?v=4","gravatar_id":"","url":"https://api.github.com/users/bolinfest","html_url":"https://github.com/bolinfest","followers_url":"https://api.github.com/users/bolinfest/followers","following_url":"https://api.github.com/users/bolinfest/following{/other_user}","gists_url":"https://api.github.com/users/bolinfest/gists{/gist_id}","starred_url":"https://api.github.com/users/bolinfest/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bolinfest/subscriptions","organizations_url":"https://api.github.com/users/bolinfest/orgs","repos_url":"https://api.github.com/users/bolinfest/repos","events_url":"https://api.github.com/users/bolinfest/events{/privacy}","received_events_url":"https://api.github.com/users/bolinfest/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"bolinfest","id":655869,"node_id":"MDQ6VXNlcjY1NTg2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/655869?v=4","gravatar_id":"","url":"https://api.github.com/users/bolinfest","html_url":"https://github.com/bolinfest","followers_url":"https://api.github.com/users/bolinfest/followers","following_url":"https://api.github.com/users/bolinfest/following{/other_user}","gists_url":"https://api.github.com/users/bolinfest/gists{/gist_id}","starred_url":"https://api.github.com/users/bolinfest/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bolinfest/subscriptions","organizations_url":"https://api.github.com/users/bolinfest/orgs","repos_url":"https://api.github.com/users/bolinfest/repos","events_url":"https://api.github.com/users/bolinfest/events{/privacy}","received_events_url":"https://api.github.com/users/bolinfest/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"1f0566d3f59298d1bb88820a0d35294f1eeb07ea","url":"https://api.github.com/repos/openai/codex/commits/1f0566d3f59298d1bb88820a0d35294f1eeb07ea","html_url":"https://github.com/openai/codex/commit/1f0566d3f59298d1bb88820a0d35294f1eeb07ea"}]},{"sha":"1f0566d3f59298d1bb88820a0d35294f1eeb07ea","node_id":"C_kwDOOYsS4doAKDFmMDU2NmQzZjU5Mjk4ZDFiYjg4ODIwYTBkMzUyOTRmMWVlYjA3ZWE","commit":{"author":{"name":"pakrym-oai","email":"pakrym@openai.com","date":"2026-07-10T01:28:55Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-10T01:28:55Z"},"message":"exec-server: expose process helper to outer sandbox (#31937)\n\n## Why\n\nSandboxed exec-server process requests can use a restricted filesystem\nprofile that does not expose the exec-server binary. On Linux, the outer\nbubblewrap stage re-enters that binary with the `codex-linux-sandbox`\nargv0 to install seccomp, so hiding the binary prevents the requested\nprocess from starting.\n\n## What changed\n\n- add the configured `codex_self_exe` to the process permission profile\nbefore constructing the outer platform sandbox\n- add a Linux exec-server integration test that starts a real remote\nprocess with restricted reads and verifies it can read an allowed\nworkspace file\n\n## Test plan\n\n- `just test -p codex-exec-server process_sandbox`\n- `just test -p codex-exec-server --test exec_process\nremote_process_keeps_sandbox_helper_visible_with_restricted_reads`","tree":{"sha":"c84504d84bce68a74fc5f6dd5d7bce3535ebd2e0","url":"https://api.github.com/repos/openai/codex/git/trees/c84504d84bce68a74fc5f6dd5d7bce3535ebd2e0"},"url":"https://api.github.com/repos/openai/codex/git/commits/1f0566d3f59298d1bb88820a0d35294f1eeb07ea","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqUErXCRC1aQ7uu5UhlAAATZ0QAHwtZZd2IO3brGLbPWjqStUX\nA2svdp2+CWbjMD387b7BpOFu7d8movmo3wZKq5xAiJmzjN1v4HZnqr8XtyzVa0Lw\nNmvMIUBWZ7VMNY63o4910OVIGC/0bogLZHHOgy/zS61Ap7AjCd2IgOADXXfuFIT/\nlgJ6lyMsWNt9OmtKnWUU0xBxSTzjMfT5076/zABr1ypTIwPjt/vKBBCfgW/wFCUQ\n/kfCGUh5cBc4eFD0RCdyL36n8ZJoWcB2HUD0JQHJz80MXZ8Zn2rvqqeDDaCjDZKt\nw30z9QpkI+fKUqGNhNMm236Fd3niMzA321ceLQj9CFf9fmGvT4Fslqbe4nIrc7BC\n1Ml5NOPypR4TrId7p8jZQzn4e4ftsjPmczfjdRq5ZfS5NW4uh18OqIgxqWzfvPI+\nMJqG9IF0xMqDTSHIDxUBWyI6vPdn1rY8rzFtRhEwT5LRUDIEkpafDXptVQPZvwz8\n9+aC5agvBQbmmSv4KKckNfs7/4v4UGWGthZB8fSsoOPXpCqR8RUQZ1yok82EjtxM\nftG1jOHQqXdLV0dRgLp/m3M4E3XTnjPEOq45L1ewzIQy17DtmzYrQLmSytkf03HB\nN/Eapz3NFVndFbBRiwZAD/jLv9h7gc8KT6joFKcF96VO9/mn1uYRUnddPW9VOh4f\n8cSDDLBuDJ2Ci8wRPhoB\n=ludM\n-----END PGP SIGNATURE-----\n","payload":"tree c84504d84bce68a74fc5f6dd5d7bce3535ebd2e0\nparent 2b44896c5ad653a1dcfc537f8bdc37767744ed09\nauthor pakrym-oai <pakrym@openai.com> 1783646935 -0700\ncommitter GitHub <noreply@github.com> 1783646935 -0700\n\nexec-server: expose process helper to outer sandbox (#31937)\n\n## Why\n\nSandboxed exec-server process requests can use a restricted filesystem\nprofile that does not expose the exec-server binary. On Linux, the outer\nbubblewrap stage re-enters that binary with the `codex-linux-sandbox`\nargv0 to install seccomp, so hiding the binary prevents the requested\nprocess from starting.\n\n## What changed\n\n- add the configured `codex_self_exe` to the process permission profile\nbefore constructing the outer platform sandbox\n- add a Linux exec-server integration test that starts a real remote\nprocess with restricted reads and verifies it can read an allowed\nworkspace file\n\n## Test plan\n\n- `just test -p codex-exec-server process_sandbox`\n- `just test -p codex-exec-server --test exec_process\nremote_process_keeps_sandbox_helper_visible_with_restricted_reads`","verified_at":"2026-07-10T01:28:55Z"}},"url":"https://api.github.com/repos/openai/codex/commits/1f0566d3f59298d1bb88820a0d35294f1eeb07ea","html_url":"https://github.com/openai/codex/commit/1f0566d3f59298d1bb88820a0d35294f1eeb07ea","comments_url":"https://api.github.com/repos/openai/codex/commits/1f0566d3f59298d1bb88820a0d35294f1eeb07ea/comments","author":{"login":"pakrym-oai","id":204937752,"node_id":"U_kgDODDcaGA","avatar_url":"https://avatars.githubusercontent.com/u/204937752?v=4","gravatar_id":"","url":"https://api.github.com/users/pakrym-oai","html_url":"https://github.com/pakrym-oai","followers_url":"https://api.github.com/users/pakrym-oai/followers","following_url":"https://api.github.com/users/pakrym-oai/following{/other_user}","gists_url":"https://api.github.com/users/pakrym-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/pakrym-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pakrym-oai/subscriptions","organizations_url":"https://api.github.com/users/pakrym-oai/orgs","repos_url":"https://api.github.com/users/pakrym-oai/repos","events_url":"https://api.github.com/users/pakrym-oai/events{/privacy}","received_events_url":"https://api.github.com/users/pakrym-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"2b44896c5ad653a1dcfc537f8bdc37767744ed09","url":"https://api.github.com/repos/openai/codex/commits/2b44896c5ad653a1dcfc537f8bdc37767744ed09","html_url":"https://github.com/openai/codex/commit/2b44896c5ad653a1dcfc537f8bdc37767744ed09"}]},{"sha":"2b44896c5ad653a1dcfc537f8bdc37767744ed09","node_id":"C_kwDOOYsS4doAKDJiNDQ4OTZjNWFkNjUzYTFkY2ZjNTM3ZjhiZGMzNzc2Nzc0NGVkMDk","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-07-10T00:31:44Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-10T00:31:44Z"},"message":"bench: add e2e benchmark entrypoints (#31428)\n\n## Why\n\nBazel-backed macrobenchmarks need stable local entrypoints that can grow\nwithout changing every caller.\n\n## What\n\n- add a top-level `e2e-benchmarks` Bazel suite, initially containing the\n`codex --help` benchmark\n- add cross-platform `just bench-e2e` for direct optimized Bazel\nmeasurements\n- add cross-platform `just bench-e2e-smoke` for one direct fastbuild\niteration through release-only Rust cfg paths\n\n## Validation\n\n- `just --dry-run bench-e2e`\n- `just --dry-run bench-e2e-smoke`\n- `just bench-e2e-smoke`\n\n## Stack\n\n1. [#31295 bench: add codex help e2e\nmacrobenchmark](https://github.com/openai/codex/pull/31295)\n2. [#31428 bench: add e2e benchmark\nentrypoints](https://github.com/openai/codex/pull/31428)\n3. [#31429 ci: smoke Bazel e2e\nbenchmarks](https://github.com/openai/codex/pull/31429)","tree":{"sha":"3ef03f27773ed9305a28906939ab828e5ad4a6f2","url":"https://api.github.com/repos/openai/codex/git/trees/3ef03f27773ed9305a28906939ab828e5ad4a6f2"},"url":"https://api.github.com/repos/openai/codex/git/commits/2b44896c5ad653a1dcfc537f8bdc37767744ed09","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqUD1wCRC1aQ7uu5UhlAAAXaUQAJFYlJQQHrqwx+/6PwSbL7wb\nEZQb2Rgkr+DT7Dp2IPCtJA9vv4kPkuwiVeiSrHGi7AKqvgkoNXA6m3qsr3yQFCe2\nlmEzABsW3shGEpkux6lUymqgC2GCutUrsA2WTwYjoaGkAKRNYQ8Dazxj5UD1ybUl\nHJF/ZIcu1qVCs5jbKuwVkkzEYRq+lJvUIXI9VOhVs2on3TFcIrVriRdJ1IK7Q/R3\n17pzfnQcjTz1WBe8GydW13FwI+n1/CbjrptCxHA13sqTVcakQOdYalHfSCMlLNLb\nQepEuQMSg2tsJnoi/xdx8npzqadZitzWa6TXhGrnW7ODtHqSjS/8XY6kStMpMv+K\n3JWHT40JC0lh6pMmIMH27IPPIpnr8GzP/Li1BlnYqG4q5iz4D9+bCajUK697rKOn\nYWRI34SeGhC5hinfYTFN1DGzcXR+eqTDj6fG4SaCTaWWSuAUauTUBBKEg1YnvuH1\nraexb0XaMC+RhBHkp0jACy3Jff7YwgOJ25YeiJ2fHKqXStmD3SMLAtGc+F04UImE\nIN8BB8OrxyUnppENqZo6Ttc+kiVpxv5o1y1eiEhBkLYVAR7mMXoAvsXO5Zc7y/Le\nYSzHOVg647KebFcmbEwWXjKejj1gsUHJ4KVyX0EnFvMKODH+kW8I44KkV1wZx0eG\nNuqiHimMfi+jdSjNTx9Z\n=mSvd\n-----END PGP SIGNATURE-----\n","payload":"tree 3ef03f27773ed9305a28906939ab828e5ad4a6f2\nparent ff672e8e61373d6bbe7000af1e8be52995089f6c\nauthor Adam Perry @ OpenAI <anp@openai.com> 1783643504 -0700\ncommitter GitHub <noreply@github.com> 1783643504 -0700\n\nbench: add e2e benchmark entrypoints (#31428)\n\n## Why\n\nBazel-backed macrobenchmarks need stable local entrypoints that can grow\nwithout changing every caller.\n\n## What\n\n- add a top-level `e2e-benchmarks` Bazel suite, initially containing the\n`codex --help` benchmark\n- add cross-platform `just bench-e2e` for direct optimized Bazel\nmeasurements\n- add cross-platform `just bench-e2e-smoke` for one direct fastbuild\niteration through release-only Rust cfg paths\n\n## Validation\n\n- `just --dry-run bench-e2e`\n- `just --dry-run bench-e2e-smoke`\n- `just bench-e2e-smoke`\n\n## Stack\n\n1. [#31295 bench: add codex help e2e\nmacrobenchmark](https://github.com/openai/codex/pull/31295)\n2. [#31428 bench: add e2e benchmark\nentrypoints](https://github.com/openai/codex/pull/31428)\n3. [#31429 ci: smoke Bazel e2e\nbenchmarks](https://github.com/openai/codex/pull/31429)","verified_at":"2026-07-10T00:31:45Z"}},"url":"https://api.github.com/repos/openai/codex/commits/2b44896c5ad653a1dcfc537f8bdc37767744ed09","html_url":"https://github.com/openai/codex/commit/2b44896c5ad653a1dcfc537f8bdc37767744ed09","comments_url":"https://api.github.com/repos/openai/codex/commits/2b44896c5ad653a1dcfc537f8bdc37767744ed09/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"ff672e8e61373d6bbe7000af1e8be52995089f6c","url":"https://api.github.com/repos/openai/codex/commits/ff672e8e61373d6bbe7000af1e8be52995089f6c","html_url":"https://github.com/openai/codex/commit/ff672e8e61373d6bbe7000af1e8be52995089f6c"}]},{"sha":"ff672e8e61373d6bbe7000af1e8be52995089f6c","node_id":"C_kwDOOYsS4doAKGZmNjcyZThlNjEzNzNkNmJiZTcwMDBhZjFlOGJlNTI5OTUwODlmNmM","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-07-10T00:23:44Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-10T00:23:44Z"},"message":"bench: add codex help e2e macrobenchmark (#31295)\n\n## Why\n\nBazel-backed end-to-end macrobenchmark plumbing needs a small,\ndeterministic first consumer that does not couple the shared\ninfrastructure to the remote-skill scenario.\n\n## What\n\n- add `codex_e2e_benchmark`, a small macro for Bazel-only Divan\nbenchmarks and runtime binary runfiles\n- keep benchmark sources under `e2e_benches/` so Cargo does not\nauto-discover them\n- add a CLI example that resolves the real `codex` binary and measures\n`codex --help`\n- assert the spawned command succeeds\n\n## Validation\n\n- `bazel test --compilation_mode=fastbuild\n--@rules_rust//rust/settings:extra_rustc_flag=-Cdebug-assertions=no\n--@rules_rust//rust/settings:extra_exec_rustc_flag=-Cdebug-assertions=no\n--cache_test_results=no --test_output=errors --test_arg=--test\n//codex-rs/cli:codex-help-bench`\n\n## Stack\n\n1. [#31295 bench: add codex help e2e\nmacrobenchmark](https://github.com/openai/codex/pull/31295)\n2. [#31428 bench: add e2e benchmark\nentrypoints](https://github.com/openai/codex/pull/31428)\n3. [#31429 ci: smoke Bazel e2e\nbenchmarks](https://github.com/openai/codex/pull/31429)","tree":{"sha":"069b73e0e9b5f1b16ce27dfef093e52c52254acf","url":"https://api.github.com/repos/openai/codex/git/trees/069b73e0e9b5f1b16ce27dfef093e52c52254acf"},"url":"https://api.github.com/repos/openai/codex/git/commits/ff672e8e61373d6bbe7000af1e8be52995089f6c","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqUDuQCRC1aQ7uu5UhlAAAS3YQAGHATB0W+9ZTmGMFprdY7hvM\nBIFiMUBOkve54WJ36vnO1IqnoPetGsvU0GfbsrAM5pJdVIFgWC9x/TW0sJenNOuS\nhDfzdGKJ0BYLG0Tre0ucPn/cSQi4G7mAUBnCmAgrS9tMz5LIsgrTnbWJaYY92gr8\nWCpN0/VnzsPZHC4IMf/7APUFrhM7v/zSpNaZIDxRulgdnyBbXaOw8NjGDCNCH0rW\nYOgKuUMxfUsNLuFX9AHGSqLEEiFlc6Woy/DzepcWzpbj5Kzvvzn5M1WR+wnaBHzn\ntRo09Vz0XFvOMuvEWgPcBBexk8Gomh1qg6Uf6IxHaqWqc8Q2VG2HkPHRpeaVrBwM\nXZzHRO4b04lv4j8fTuGulaDo69btKK4FqalYeF9FTmZNbMsyN6SRHr5bTqm5oGT3\ntXVeqqbfGb2rBXBLzuKiiIOCFrAHxLSfJ7qZdGCydST9dFyAS5UDPxLFiIkdfAoI\nV6ujY5ekEKOqEeqTetPScC/5wCuFHpHjCY4TdbbZ1QZehh5f/K36HqOo6F4t4IkW\nkZMAZKHKHD3/X4moqIEQWCxNZr1Lg1ANXp1DF+9azxtu/5G9TQHmPDG8k+4Ytco2\nq59wtXboNu4I4+nY8nOK80iKC9V2KdHqXD9ZnQ/CO8o+cqUyLGVf9dxfx/rlKvd/\nXLRNSEs/cEWZh/9qfPdm\n=kBYO\n-----END PGP SIGNATURE-----\n","payload":"tree 069b73e0e9b5f1b16ce27dfef093e52c52254acf\nparent b45fef0774a02f4107ccab9eb22d81f8c866c474\nauthor Adam Perry @ OpenAI <anp@openai.com> 1783643024 -0700\ncommitter GitHub <noreply@github.com> 1783643024 -0700\n\nbench: add codex help e2e macrobenchmark (#31295)\n\n## Why\n\nBazel-backed end-to-end macrobenchmark plumbing needs a small,\ndeterministic first consumer that does not couple the shared\ninfrastructure to the remote-skill scenario.\n\n## What\n\n- add `codex_e2e_benchmark`, a small macro for Bazel-only Divan\nbenchmarks and runtime binary runfiles\n- keep benchmark sources under `e2e_benches/` so Cargo does not\nauto-discover them\n- add a CLI example that resolves the real `codex` binary and measures\n`codex --help`\n- assert the spawned command succeeds\n\n## Validation\n\n- `bazel test --compilation_mode=fastbuild\n--@rules_rust//rust/settings:extra_rustc_flag=-Cdebug-assertions=no\n--@rules_rust//rust/settings:extra_exec_rustc_flag=-Cdebug-assertions=no\n--cache_test_results=no --test_output=errors --test_arg=--test\n//codex-rs/cli:codex-help-bench`\n\n## Stack\n\n1. [#31295 bench: add codex help e2e\nmacrobenchmark](https://github.com/openai/codex/pull/31295)\n2. [#31428 bench: add e2e benchmark\nentrypoints](https://github.com/openai/codex/pull/31428)\n3. [#31429 ci: smoke Bazel e2e\nbenchmarks](https://github.com/openai/codex/pull/31429)","verified_at":"2026-07-10T00:23:45Z"}},"url":"https://api.github.com/repos/openai/codex/commits/ff672e8e61373d6bbe7000af1e8be52995089f6c","html_url":"https://github.com/openai/codex/commit/ff672e8e61373d6bbe7000af1e8be52995089f6c","comments_url":"https://api.github.com/repos/openai/codex/commits/ff672e8e61373d6bbe7000af1e8be52995089f6c/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b45fef0774a02f4107ccab9eb22d81f8c866c474","url":"https://api.github.com/repos/openai/codex/commits/b45fef0774a02f4107ccab9eb22d81f8c866c474","html_url":"https://github.com/openai/codex/commit/b45fef0774a02f4107ccab9eb22d81f8c866c474"}]},{"sha":"b45fef0774a02f4107ccab9eb22d81f8c866c474","node_id":"C_kwDOOYsS4doAKGI0NWZlZjA3NzRhMDJmNDEwN2NjYWI5ZWIyMmQ4MWY4Yzg2NmM0NzQ","commit":{"author":{"name":"Celia Chen","email":"celia@openai.com","date":"2026-07-10T00:05:37Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-10T00:05:37Z"},"message":"feat: add managed Bedrock login API (#31327)\n\n## Why\n\nApp-server clients can report whether Amazon Bedrock is using\nAWS-managed credentials or a Codex-managed API key, but they do not have\na matching API for creating the managed login. This PR defines that\nexperimental wire contract independently from its implementation.\n\nManaged Bedrock API keys are already a primary `CodexAuth` mode. The API\ntherefore describes a normal Codex login that replaces the current\nstored auth rather than introducing provider-scoped credential storage.\n\n## What changed\n\n- Add the experimental `amazonBedrock` variant to `account/login/start`.\n- Accept an API key and AWS region and return a matching discriminated\nresponse.\n- Gate the request behind the app-server `experimentalApi` capability.\n- Regenerate the JSON and TypeScript protocol schemas.\n- Document the login contract, notifications, primary-auth replacement\nsemantics, restart boundary, and non-transactional durable writes.\n\n## Impact\n\nThis PR defines the API shape but does not implement login behavior. The\nnext PR adds validation, persistence through the existing Codex auth\nlifecycle, provider selection, and notifications.\n\n## Validation\n\n- `just test -p codex-app-server-protocol`\n\n## Stack\n\n1. **#31327 Managed Bedrock experimental API** — base: `main`\n2. #31326 Managed Bedrock login — base: `codex/managed-bedrock-api`\n3. #31325 Managed Bedrock logout — base:\n`codex/managed-bedrock-login-v2`","tree":{"sha":"ff8001bd7e7a00254749a0e5a93e9cffbdfa4e89","url":"https://api.github.com/repos/openai/codex/git/trees/ff8001bd7e7a00254749a0e5a93e9cffbdfa4e89"},"url":"https://api.github.com/repos/openai/codex/git/commits/b45fef0774a02f4107ccab9eb22d81f8c866c474","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqUDdRCRC1aQ7uu5UhlAAAZO8QAKq3qELq78lKGPLV7FxDs5zX\nHMtAsfazKDQyrlVp6+50tTIWsfqa2uQLUJzBHEmFHfijb+u8HBREFNG7psDtRlB4\n5iabdtiROPVVMSP5MixZwc0J45xuqbLkt3KoCDYoAywvQSuh8O9c5pwBdgwUoF4x\n4dMqTg7mZCND2aMBOR3RFGgdoUcCfemc48BLeZHCN1t3L6O87mdR5DbWhGB/Wxrs\nEg7VPZp5NNLXTDaT0FaHzelRa+YZ5vw3TYevm0OoLkUovBZ8ZgdC8F7u9t0lOsGU\nTwb+M4gPn1tfXo0AtbXE27C3fcJY9VmimL489AVNOnHY2VzBsm03oDQtSiqQ2HaG\nIyl8mV3EukyuvmGnyw6EWMKNi9glxLChORdcydECBA0zXBiN4LMuuu6ULGRy77DF\n2DvwOLYpids5Jk/1QjfDFzsd/55twz6zHDDabEGh59J2kJ/xpb1X6sWi4QsddItA\n8Iv0VVSXKQ/ypuYQ+3EMY4NiVh6HPfpsDbzKXwonIUMHfgK9bMPtho/Wpid5zGLY\n36rRIknKmAhQtRy7DYJi0eTeAGkLij8MX+AvCetiW44QCY7RVFCcq2Dg8Ggk0BSy\nyJpW6IdLgEE+4zq6PEkuj9Qhm5WCg+xYh3qZJDjmCzHmD4qBL8EpqiH3e3imdai8\nbLStQI/ofER6Dvo+Ue6O\n=AK6H\n-----END PGP SIGNATURE-----\n","payload":"tree ff8001bd7e7a00254749a0e5a93e9cffbdfa4e89\nparent ac3da4fb1a2ad0ee2f0c867bfa81a5a3a3737f9c\nauthor Celia Chen <celia@openai.com> 1783641937 -0700\ncommitter GitHub <noreply@github.com> 1783641937 -0700\n\nfeat: add managed Bedrock login API (#31327)\n\n## Why\n\nApp-server clients can report whether Amazon Bedrock is using\nAWS-managed credentials or a Codex-managed API key, but they do not have\na matching API for creating the managed login. This PR defines that\nexperimental wire contract independently from its implementation.\n\nManaged Bedrock API keys are already a primary `CodexAuth` mode. The API\ntherefore describes a normal Codex login that replaces the current\nstored auth rather than introducing provider-scoped credential storage.\n\n## What changed\n\n- Add the experimental `amazonBedrock` variant to `account/login/start`.\n- Accept an API key and AWS region and return a matching discriminated\nresponse.\n- Gate the request behind the app-server `experimentalApi` capability.\n- Regenerate the JSON and TypeScript protocol schemas.\n- Document the login contract, notifications, primary-auth replacement\nsemantics, restart boundary, and non-transactional durable writes.\n\n## Impact\n\nThis PR defines the API shape but does not implement login behavior. The\nnext PR adds validation, persistence through the existing Codex auth\nlifecycle, provider selection, and notifications.\n\n## Validation\n\n- `just test -p codex-app-server-protocol`\n\n## Stack\n\n1. **#31327 Managed Bedrock experimental API** — base: `main`\n2. #31326 Managed Bedrock login — base: `codex/managed-bedrock-api`\n3. #31325 Managed Bedrock logout — base:\n`codex/managed-bedrock-login-v2`","verified_at":"2026-07-10T00:05:37Z"}},"url":"https://api.github.com/repos/openai/codex/commits/b45fef0774a02f4107ccab9eb22d81f8c866c474","html_url":"https://github.com/openai/codex/commit/b45fef0774a02f4107ccab9eb22d81f8c866c474","comments_url":"https://api.github.com/repos/openai/codex/commits/b45fef0774a02f4107ccab9eb22d81f8c866c474/comments","author":{"login":"celia-oai","id":209693228,"node_id":"U_kgDODH-qLA","avatar_url":"https://avatars.githubusercontent.com/u/209693228?v=4","gravatar_id":"","url":"https://api.github.com/users/celia-oai","html_url":"https://github.com/celia-oai","followers_url":"https://api.github.com/users/celia-oai/followers","following_url":"https://api.github.com/users/celia-oai/following{/other_user}","gists_url":"https://api.github.com/users/celia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/celia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celia-oai/subscriptions","organizations_url":"https://api.github.com/users/celia-oai/orgs","repos_url":"https://api.github.com/users/celia-oai/repos","events_url":"https://api.github.com/users/celia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/celia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"ac3da4fb1a2ad0ee2f0c867bfa81a5a3a3737f9c","url":"https://api.github.com/repos/openai/codex/commits/ac3da4fb1a2ad0ee2f0c867bfa81a5a3a3737f9c","html_url":"https://github.com/openai/codex/commit/ac3da4fb1a2ad0ee2f0c867bfa81a5a3a3737f9c"}]},{"sha":"ac3da4fb1a2ad0ee2f0c867bfa81a5a3a3737f9c","node_id":"C_kwDOOYsS4doAKGFjM2RhNGZiMWEyYWQwZWUyZjBjODY3YmZhODFhNWEzYTM3MzdmOWM","commit":{"author":{"name":"pakrym-oai","email":"pakrym@openai.com","date":"2026-07-09T23:20:06Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-09T23:20:06Z"},"message":"exec-server: materialize filesystem workspace roots (#31892)\n\nFilesystem helper requests currently turn symbolic `:workspace_roots`\npermissions into a sandbox policy before applying the workspace roots\nfrom the filesystem sandbox context. This can accidentally broaden\nfilesystem access to the cwd instead of limiting it to the selected\nworkspace roots.\n\nMaterialize project-root permissions using the context workspace roots\nbefore deriving the filesystem sandbox policy. The same converted roots\nare then reused when constructing the sandbox command, keeping policy\nenforcement and process setup aligned.\n\nAdds a remote filesystem integration test that verifies a file inside\nthe selected workspace root is readable while a sibling under the cwd is\ndenied.\n\n## Validation\n\n- `just test -p codex-exec-server\nremote_read_file_materializes_environment_workspace_roots` (macOS,\noutside the outer Seatbelt sandbox)","tree":{"sha":"a619bd12286c91398d0e4bf475e67f3a5ff284d9","url":"https://api.github.com/repos/openai/codex/git/trees/a619bd12286c91398d0e4bf475e67f3a5ff284d9"},"url":"https://api.github.com/repos/openai/codex/git/commits/ac3da4fb1a2ad0ee2f0c867bfa81a5a3a3737f9c","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqUCymCRC1aQ7uu5UhlAAACJ0QACtDFZwPXA8j9lNTKCS/bkHS\n9/865/+g4JzmEpn64+fK61c0eBYXxwX4gtpc942MZY6EHg4FMwfM/fAUju+kTIuS\nOT2k0ln57QS3mfGTUhb/3F3Cy/FeEVc1gngcqUMDOP0PYlTxC/7ImcI8PkPJbavo\nL8Z8Wz/fcCjHhcjP9Pzy30SJ0jvzHVyIKsvoxZBXWvOWqXef0ZtfF47/oP3v19EP\nI8c9Xeq/sp0kbEx4WlBWi/hugyXdMllPR1uSw/e7PUFAJJdPNgG/PJPkLjXfTxWF\nRJpxycXBFOD8mZkExCdpokLGdgTFIQbHseX5Co95laeiYBbbZkItzCiIoYhKymy8\nnFCfWAiwM9+ABaJQKvzEERGTXNNNZyfY+rjpd5V7wFApkDEJ1FBUfwtgR6P4KGJ2\nVoqIxBvAzLaGDV3G4cHSSVPf63TuBvjwuxU3iUBQsK5Oer15FbeO63wRbMQ+4IQt\nm6BUKBcGw4Ksod1+hgjXx0zujdkA//Z8jl/gdiCSC+xp9BluULSa4567j6qTy3BB\nHvg9YlOOrDjTeyTzLilEDeq0JyzY7XvzammcNwlGtRO7Sxy/Lsj7r+h28oXcF1vt\nWXOSeNCAtLBTacTJzeUnpIlO5wN3YuxQumgHRpyZql5sZ/qfIG2MNmabgPzZLnAo\npy1sCn2pBp5eKyTtIUCO\n=pLBy\n-----END PGP SIGNATURE-----\n","payload":"tree a619bd12286c91398d0e4bf475e67f3a5ff284d9\nparent cbdee7976b3717e3e0b7fbe83e2aa2843f1aa500\nauthor pakrym-oai <pakrym@openai.com> 1783639206 -0700\ncommitter GitHub <noreply@github.com> 1783639206 -0700\n\nexec-server: materialize filesystem workspace roots (#31892)\n\nFilesystem helper requests currently turn symbolic `:workspace_roots`\npermissions into a sandbox policy before applying the workspace roots\nfrom the filesystem sandbox context. This can accidentally broaden\nfilesystem access to the cwd instead of limiting it to the selected\nworkspace roots.\n\nMaterialize project-root permissions using the context workspace roots\nbefore deriving the filesystem sandbox policy. The same converted roots\nare then reused when constructing the sandbox command, keeping policy\nenforcement and process setup aligned.\n\nAdds a remote filesystem integration test that verifies a file inside\nthe selected workspace root is readable while a sibling under the cwd is\ndenied.\n\n## Validation\n\n- `just test -p codex-exec-server\nremote_read_file_materializes_environment_workspace_roots` (macOS,\noutside the outer Seatbelt sandbox)","verified_at":"2026-07-09T23:20:06Z"}},"url":"https://api.github.com/repos/openai/codex/commits/ac3da4fb1a2ad0ee2f0c867bfa81a5a3a3737f9c","html_url":"https://github.com/openai/codex/commit/ac3da4fb1a2ad0ee2f0c867bfa81a5a3a3737f9c","comments_url":"https://api.github.com/repos/openai/codex/commits/ac3da4fb1a2ad0ee2f0c867bfa81a5a3a3737f9c/comments","author":{"login":"pakrym-oai","id":204937752,"node_id":"U_kgDODDcaGA","avatar_url":"https://avatars.githubusercontent.com/u/204937752?v=4","gravatar_id":"","url":"https://api.github.com/users/pakrym-oai","html_url":"https://github.com/pakrym-oai","followers_url":"https://api.github.com/users/pakrym-oai/followers","following_url":"https://api.github.com/users/pakrym-oai/following{/other_user}","gists_url":"https://api.github.com/users/pakrym-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/pakrym-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pakrym-oai/subscriptions","organizations_url":"https://api.github.com/users/pakrym-oai/orgs","repos_url":"https://api.github.com/users/pakrym-oai/repos","events_url":"https://api.github.com/users/pakrym-oai/events{/privacy}","received_events_url":"https://api.github.com/users/pakrym-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"cbdee7976b3717e3e0b7fbe83e2aa2843f1aa500","url":"https://api.github.com/repos/openai/codex/commits/cbdee7976b3717e3e0b7fbe83e2aa2843f1aa500","html_url":"https://github.com/openai/codex/commit/cbdee7976b3717e3e0b7fbe83e2aa2843f1aa500"}]},{"sha":"cbdee7976b3717e3e0b7fbe83e2aa2843f1aa500","node_id":"C_kwDOOYsS4doAKGNiZGVlNzk3NmIzNzE3ZTNlMGI3ZmJlODNlMmFhMjg0M2YxYWE1MDA","commit":{"author":{"name":"stevenlee-oai","email":"stevenlee@openai.com","date":"2026-07-09T22:46:29Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-09T22:46:29Z"},"message":"Resolve and pin MCP OAuth credential stores (#30293)\n\n[Codex Thread\n019edd6d-6f14-74e2-853c-345d1803d4a6](https://codex-thread-link.openai.chatgpt-team.site/thread/019edd6d-6f14-74e2-853c-345d1803d4a6)\n\n## Stack\n\nReview and merge in order. Every layer is independently correct and\ndocuments its safe stopping point.\n\n1. [openai/codex#30292](https://github.com/openai/codex/pull/30292) —\naggregate File/Secrets store locking\n2. [openai/codex#30293](https://github.com/openai/codex/pull/30293) —\nresolve and lifecycle-pin the exact OAuth store\n3. [openai/codex#30416](https://github.com/openai/codex/pull/30416) —\nserialized authoritative refresh transaction\n4. [openai/codex#30294](https://github.com/openai/codex/pull/30294) —\nCodex-owned transport refresh and one-shot 401 recovery\n5. [openai/codex#30295](https://github.com/openai/codex/pull/30295) —\nlogin/logout transaction serialization\n6. [openai/codex#30296](https://github.com/openai/codex/pull/30296) —\ndiagnostic-only Auto store drift reporting\n\n**This PR is layer 2.**\n\n## Why\n\n`Auto` is keyring-first with a File fallback, but re-evaluating that\npolicy during transport reconstruction or persistence can make one MCP\nclient read from one store and later write to another. With rotating\nrefresh tokens, the second store may contain an older token. This layer\nmakes the source selected at client startup explicit and keeps that\nauthority stable for the client lifecycle.\n\n## What this PR does\n\n- Keeps `resolve_oauth_tokens_from_store_policy` as the single\nconfigured-policy entry point and returns both credentials and the\nconcrete File or Keyring source that supplied them.\n- Puts exact `load`, `save`, and `delete` operations on\n`ResolvedOAuthCredentialStore`, making “resolve configured policy” and\n“use the selected authority” distinct at call sites.\n- Pins the first concrete source in `pinned_credential_store` in the\ntransport recipe, so initialization retries and session reconstruction\ncannot re-evaluate `Auto` and adopt another store.\n- Gives `OAuthPersistor` the resolved store and keeps subsequent\npersistence and removal on that authority.\n- Uses a typed keyring-load error to distinguish aggregate-store\ncoordination failures from ordinary backend failures; a coordination\nfailure is surfaced instead of triggering File fallback.\n- Keeps login-time `Auto` behavior unchanged: prefer Keyring, fall back\nto File when unavailable, and clean up legacy File state after a\nsuccessful keyring save.\n- Adds structured server/backend context when fallback cleanup fails.\n\n## Explicit decisions and non-goals\n\n- The selection is lifecycle-local and in memory. This PR does not add a\ndurable backend selector, migration, reconciliation registry, or global\nsource of truth outside `CODEX_HOME`.\n- `Auto` may choose File at the start of a later process if keyring\navailability changes. Once this client resolves, a selected-store\nfailure is returned instead of hot-switching.\n- Different `CODEX_HOME` instances remain independent even when they can\naccess the same Direct keyring credential.\n- Cross-process refresh serialization is intentionally not part of this\nlayer.\n\n## Safe stopping point\n\nThis PR can merge alone. A single MCP client no longer hot-switches\ncredential stores across transport rebuilds or persistence. Two\nprocesses can still refresh the same selected credential concurrently\nuntil layer 3.\n\n## Review size\n\nThe net layer is 9 files, +668/−144. The production change remains\nfocused on store resolution and lifecycle pinning; the largest follow-up\nis integration coverage that drives real session recovery.\n\n## Validation\n\n- `just test -p codex-rmcp-client` (99 passed; 5 expected skips)\n- Real-client 404 recovery coverage with different Keyring and File\ntokens; captured bearer headers prove the stale File token is never sent\n- Mutation check: removing the lifecycle pin makes that integration\nregression fail by observing the stale File token","tree":{"sha":"bb99365d9a54b39b0bbdf839bf1cb8f034d10d8f","url":"https://api.github.com/repos/openai/codex/git/trees/bb99365d9a54b39b0bbdf839bf1cb8f034d10d8f"},"url":"https://api.github.com/repos/openai/codex/git/commits/cbdee7976b3717e3e0b7fbe83e2aa2843f1aa500","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqUCTFCRC1aQ7uu5UhlAAADBcQAEZbmK52/zO8ZR+4yDg/vehT\nZNScN9ohB9yhbLh3vmfC09ALb75oeJY5NLNWF8abuv8STLbpdCMWTEP1YnWEXw8R\nSha5TjrkXR7BOd6SJ23mQqjzaGoOXPkTDenkD2qZDNhdvmHxe26MeQeKYvn5qkJe\nXD+Rlq39swbBBRB15PeVQgdjH6+FaG6Rxq19/+t9GVHGNREpBJR+5v6Pns5JtDP1\nsvn/4dqpmxilBt9H9gqJWaReRKmBOTk6Qs02DRHF7GlQE6QXvwl1YQBMfgnHn8pK\naZ6WRVgxPK7Q0T7gZgVgxFU0FZugIGYbsgs/VAmEexA3KMrcMyNkzjuRhNVFhtrg\n9PeCoFBloEVrUb8RlqzwlMlIHhKX2cCEDD8joI8Ovj1RHx35mg0IYnevgsSSuQzx\nBBSKuHfqUWM8LSo6CPAg0JIdiGBnwXs9Q5PXnKxfFSDYb/2r8dqTAf3GfP9g16wv\nKxl1s2dE9HKai769H1VCIpA8DpoE0PVbtZX6tYlDUnW7mHwxGoMcne0/Gp8MGyNO\ndyHO+8w35diRiXP03ci9HTW0oVp8n6ja4dKLV9+KG02wB3ppCkHEYh3uN8KqZF8+\n9CRhsXrqCHUoP60yx7T/sgWvbqTX0U7bMKqjzPOBCb7EkG5tpv+ZV6Oh2yU59LD3\nPJ7J0xY5KXU8YEqaXQnY\n=JuIF\n-----END PGP SIGNATURE-----\n","payload":"tree bb99365d9a54b39b0bbdf839bf1cb8f034d10d8f\nparent 6ced1ac5eb57916ae20ebf2afa929112890fc278\nauthor stevenlee-oai <stevenlee@openai.com> 1783637189 -0400\ncommitter GitHub <noreply@github.com> 1783637189 -0400\n\nResolve and pin MCP OAuth credential stores (#30293)\n\n[Codex Thread\n019edd6d-6f14-74e2-853c-345d1803d4a6](https://codex-thread-link.openai.chatgpt-team.site/thread/019edd6d-6f14-74e2-853c-345d1803d4a6)\n\n## Stack\n\nReview and merge in order. Every layer is independently correct and\ndocuments its safe stopping point.\n\n1. [openai/codex#30292](https://github.com/openai/codex/pull/30292) —\naggregate File/Secrets store locking\n2. [openai/codex#30293](https://github.com/openai/codex/pull/30293) —\nresolve and lifecycle-pin the exact OAuth store\n3. [openai/codex#30416](https://github.com/openai/codex/pull/30416) —\nserialized authoritative refresh transaction\n4. [openai/codex#30294](https://github.com/openai/codex/pull/30294) —\nCodex-owned transport refresh and one-shot 401 recovery\n5. [openai/codex#30295](https://github.com/openai/codex/pull/30295) —\nlogin/logout transaction serialization\n6. [openai/codex#30296](https://github.com/openai/codex/pull/30296) —\ndiagnostic-only Auto store drift reporting\n\n**This PR is layer 2.**\n\n## Why\n\n`Auto` is keyring-first with a File fallback, but re-evaluating that\npolicy during transport reconstruction or persistence can make one MCP\nclient read from one store and later write to another. With rotating\nrefresh tokens, the second store may contain an older token. This layer\nmakes the source selected at client startup explicit and keeps that\nauthority stable for the client lifecycle.\n\n## What this PR does\n\n- Keeps `resolve_oauth_tokens_from_store_policy` as the single\nconfigured-policy entry point and returns both credentials and the\nconcrete File or Keyring source that supplied them.\n- Puts exact `load`, `save`, and `delete` operations on\n`ResolvedOAuthCredentialStore`, making “resolve configured policy” and\n“use the selected authority” distinct at call sites.\n- Pins the first concrete source in `pinned_credential_store` in the\ntransport recipe, so initialization retries and session reconstruction\ncannot re-evaluate `Auto` and adopt another store.\n- Gives `OAuthPersistor` the resolved store and keeps subsequent\npersistence and removal on that authority.\n- Uses a typed keyring-load error to distinguish aggregate-store\ncoordination failures from ordinary backend failures; a coordination\nfailure is surfaced instead of triggering File fallback.\n- Keeps login-time `Auto` behavior unchanged: prefer Keyring, fall back\nto File when unavailable, and clean up legacy File state after a\nsuccessful keyring save.\n- Adds structured server/backend context when fallback cleanup fails.\n\n## Explicit decisions and non-goals\n\n- The selection is lifecycle-local and in memory. This PR does not add a\ndurable backend selector, migration, reconciliation registry, or global\nsource of truth outside `CODEX_HOME`.\n- `Auto` may choose File at the start of a later process if keyring\navailability changes. Once this client resolves, a selected-store\nfailure is returned instead of hot-switching.\n- Different `CODEX_HOME` instances remain independent even when they can\naccess the same Direct keyring credential.\n- Cross-process refresh serialization is intentionally not part of this\nlayer.\n\n## Safe stopping point\n\nThis PR can merge alone. A single MCP client no longer hot-switches\ncredential stores across transport rebuilds or persistence. Two\nprocesses can still refresh the same selected credential concurrently\nuntil layer 3.\n\n## Review size\n\nThe net layer is 9 files, +668/−144. The production change remains\nfocused on store resolution and lifecycle pinning; the largest follow-up\nis integration coverage that drives real session recovery.\n\n## Validation\n\n- `just test -p codex-rmcp-client` (99 passed; 5 expected skips)\n- Real-client 404 recovery coverage with different Keyring and File\ntokens; captured bearer headers prove the stale File token is never sent\n- Mutation check: removing the lifecycle pin makes that integration\nregression fail by observing the stale File token","verified_at":"2026-07-09T22:46:30Z"}},"url":"https://api.github.com/repos/openai/codex/commits/cbdee7976b3717e3e0b7fbe83e2aa2843f1aa500","html_url":"https://github.com/openai/codex/commit/cbdee7976b3717e3e0b7fbe83e2aa2843f1aa500","comments_url":"https://api.github.com/repos/openai/codex/commits/cbdee7976b3717e3e0b7fbe83e2aa2843f1aa500/comments","author":{"login":"stevenlee-oai","id":213687449,"node_id":"U_kgDODLycmQ","avatar_url":"https://avatars.githubusercontent.com/u/213687449?v=4","gravatar_id":"","url":"https://api.github.com/users/stevenlee-oai","html_url":"https://github.com/stevenlee-oai","followers_url":"https://api.github.com/users/stevenlee-oai/followers","following_url":"https://api.github.com/users/stevenlee-oai/following{/other_user}","gists_url":"https://api.github.com/users/stevenlee-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/stevenlee-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stevenlee-oai/subscriptions","organizations_url":"https://api.github.com/users/stevenlee-oai/orgs","repos_url":"https://api.github.com/users/stevenlee-oai/repos","events_url":"https://api.github.com/users/stevenlee-oai/events{/privacy}","received_events_url":"https://api.github.com/users/stevenlee-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"6ced1ac5eb57916ae20ebf2afa929112890fc278","url":"https://api.github.com/repos/openai/codex/commits/6ced1ac5eb57916ae20ebf2afa929112890fc278","html_url":"https://github.com/openai/codex/commit/6ced1ac5eb57916ae20ebf2afa929112890fc278"}]},{"sha":"6ced1ac5eb57916ae20ebf2afa929112890fc278","node_id":"C_kwDOOYsS4doAKDZjZWQxYWM1ZWI1NzkxNmFlMjBlYmYyYWZhOTI5MTEyODkwZmMyNzg","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-09T22:15:00Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-09T22:15:00Z"},"message":"Bound remote MCP stdio lines (#31805)\n\n## Why\n\nRemote MCP stdio buffers executor-provided stdout until a JSON-RPC line\ncompletes and stderr until a diagnostic line completes. A malicious or\nbroken executor can keep sending chunks without a newline, making\norchestrator memory grow without bound.\n\nExecutor event boundaries are arbitrary, so a valid message before an\noversized line must not be lost merely because both arrived in one\nevent.\n\n## What changed\n\n- Limit one stdout JSON-RPC line to 8 MiB.\n- Limit one stderr diagnostic line to 1 MiB.\n- Check each logical line before copying its bytes into the retained\nbuffer.\n- Preserve complete stdout messages that precede an oversized line and\ndeliver them before closing the stream.\n- Close the MCP transport on overflow; existing transport cleanup\nterminates the executor-managed process.\n- Preserve multiple lines per chunk, CRLF framing, and final\nunterminated messages at EOF.\n- Box the pending stdio transport so the added framing state does not\ninflate every `ClientState` value.\n- Add regression coverage for cross-chunk overflow, bounded lines in a\nlarger chunk, and a valid prefix before an oversized line.\n\n## Scope\n\nThis bounds pre-newline buffering for executor-backed MCP stdio only. It\ndoes not change local stdio framing or address memory amplification\nwhile parsing a complete JSON message.","tree":{"sha":"5db46fdf8c1ad056169c38e73fc387feb58c86b7","url":"https://api.github.com/repos/openai/codex/git/trees/5db46fdf8c1ad056169c38e73fc387feb58c86b7"},"url":"https://api.github.com/repos/openai/codex/git/commits/6ced1ac5eb57916ae20ebf2afa929112890fc278","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqUB1kCRC1aQ7uu5UhlAAAyFsQAFopeEs9oq+UIIVrlAZkL2AL\nKKl+EZ2Kx0mGH93svpp9OxkhreZFnk9iprZf15SLM8rvWQNbQwCUfA3WusROtpzr\npsbEGo9hat1cytCFu9eoO21hEDgNpUuZBDKJdrPOPlfThMvoLx7/uLhO8WNRgltM\ncWrFtJSLUTkQ4jMRisY+2afkp+JFJvTwHVcFQcpozfatIrij9GuGPeOH/V/pFS2+\nHyVC3gRsEaQcKVVSAqPh34cHSYz9+33Nr+y8DYH9Nq2qX3jXkYhehHI8fZmALIwP\n8/jHXEWSy2HUSB0LlUetAwo5sBYgix5cj94uNK2MSqM588CN7DCVfpow8wAf/F6l\nOPCKDg9b1HobzAGSIfW1MnH9GoA6bsvd/MWsOV3ej2tyI95XoDX12Tj8BwnJnsrJ\nILmZpKo1jgvgpK36T/z0my5s6xzV2/xgDUgkMhSDcmjeQ+wLfRchBECxUwQew7dU\n+EK6S0RD/nAWZYKjJOxvVDUqnX0K3GDgeZ+UJtmbQtvqSEpulRIvkVd25AB/NnrB\n35TTNljXYPIy+mjnA94Ux/Y7BHRhCdB23v9wi4DL/bcFxXPBc21tjG4PWSH/YhH7\np5HiUoOg7Z8qMT94Q/t7+sIL4wPu7PvD4bJgx9IsKXd7V6sKLyKCHUBjLf6Nc9bs\ndREscm7brNWDVU/oZEJD\n=iTYS\n-----END PGP SIGNATURE-----\n","payload":"tree 5db46fdf8c1ad056169c38e73fc387feb58c86b7\nparent 8cf9a1b1f8ea35c724831a739fea2d725d72c582\nauthor jif <jif@openai.com> 1783635300 +0100\ncommitter GitHub <noreply@github.com> 1783635300 +0100\n\nBound remote MCP stdio lines (#31805)\n\n## Why\n\nRemote MCP stdio buffers executor-provided stdout until a JSON-RPC line\ncompletes and stderr until a diagnostic line completes. A malicious or\nbroken executor can keep sending chunks without a newline, making\norchestrator memory grow without bound.\n\nExecutor event boundaries are arbitrary, so a valid message before an\noversized line must not be lost merely because both arrived in one\nevent.\n\n## What changed\n\n- Limit one stdout JSON-RPC line to 8 MiB.\n- Limit one stderr diagnostic line to 1 MiB.\n- Check each logical line before copying its bytes into the retained\nbuffer.\n- Preserve complete stdout messages that precede an oversized line and\ndeliver them before closing the stream.\n- Close the MCP transport on overflow; existing transport cleanup\nterminates the executor-managed process.\n- Preserve multiple lines per chunk, CRLF framing, and final\nunterminated messages at EOF.\n- Box the pending stdio transport so the added framing state does not\ninflate every `ClientState` value.\n- Add regression coverage for cross-chunk overflow, bounded lines in a\nlarger chunk, and a valid prefix before an oversized line.\n\n## Scope\n\nThis bounds pre-newline buffering for executor-backed MCP stdio only. It\ndoes not change local stdio framing or address memory amplification\nwhile parsing a complete JSON message.","verified_at":"2026-07-09T22:15:01Z"}},"url":"https://api.github.com/repos/openai/codex/commits/6ced1ac5eb57916ae20ebf2afa929112890fc278","html_url":"https://github.com/openai/codex/commit/6ced1ac5eb57916ae20ebf2afa929112890fc278","comments_url":"https://api.github.com/repos/openai/codex/commits/6ced1ac5eb57916ae20ebf2afa929112890fc278/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"8cf9a1b1f8ea35c724831a739fea2d725d72c582","url":"https://api.github.com/repos/openai/codex/commits/8cf9a1b1f8ea35c724831a739fea2d725d72c582","html_url":"https://github.com/openai/codex/commit/8cf9a1b1f8ea35c724831a739fea2d725d72c582"}]},{"sha":"8cf9a1b1f8ea35c724831a739fea2d725d72c582","node_id":"C_kwDOOYsS4doAKDhjZjlhMWIxZjhlYTM1YzcyNDgzMWE3MzlmZWEyZDcyNWQ3MmM1ODI","commit":{"author":{"name":"Channing Conger","email":"cconger@openai.com","date":"2026-07-09T21:40:10Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-09T21:40:10Z"},"message":"code-mode: fall back to using in process v8 if we fail to resolve external process (#31899)\n\n## Why\n\nNot every Codex distribution currently includes the\n`codex-code-mode-host` companion binary. Enabling the process-host\nfeature should not make code mode unavailable on those surfaces while\npackaging support is being completed.\n\n## What changed\n\n- Fall back to an in-process code-mode session only when spawning the\ncompanion binary returns `io::ErrorKind::NotFound`.\n- Keep permission, handshake, timeout, and other host failures visible\ninstead of silently falling back.\n- Store the provider's owned-process/in-process choice as one\nenum-backed state so later sessions reuse the fallback decision.\n- Preserve the underlying spawn `io::Error` while retaining the host\npath in the displayed error.\n- Update provider, `CodeModeService`, and end-to-end coverage to verify\nsuccessful fallback execution.\n\n## Test plan\n\n- `just test -p codex-code-mode`\n- `just test -p codex-core missing_process_host`","tree":{"sha":"e099d0b62213fd03f3712687a941b1f7a6076d43","url":"https://api.github.com/repos/openai/codex/git/trees/e099d0b62213fd03f3712687a941b1f7a6076d43"},"url":"https://api.github.com/repos/openai/codex/git/commits/8cf9a1b1f8ea35c724831a739fea2d725d72c582","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqUBU6CRC1aQ7uu5UhlAAAQDUQAC653Jwko4XlEntjBJNvdM6L\nBPy8sx0GDii4m2WlDOgRcAVVBY7Viov2ruwnNNlblaBM7SSpTXQ0ayYO7sGHSCYd\ng4h2/D1oT7nPDTf/4olZ8WlfAEjeD+TKwYsWdtWkEiMUxZxrRTVsmGIe1TaT/aoD\noIxM+ak+2fwBBGtPAeSYv3zwkXknPP0ua+AAkjqgGbpeG+6X/UMpCqO8g+HMkkRE\nQikXKAi9A9Lpi2LDHLohkZoNd+GewU2lcVhi4pFGQgS204fdrledbkStt3nUUHq2\nGRAPneoP85e8g494FaJF42LPA6OsLYFbTsyOT8TgYEx8i8IJSwPj6t/kOQNKbEBr\nEdhSZlWkHY9/ZdcLHINjBEUcOs6okxcwZW63KzczRWCN6ODaQtFz/UEIhJCDdmF2\nQOePntc+FIabeGlwbUv4lYmhD3Nv0PkARNky/GavOafH/JtSzlZwbvWSzFpD5iq8\nX1/5mUYKzzjSVpZh7TtJqoNb2nh+BXzVKf93FbCkVj2rFY2Q5DtGDtGMM+dzq4r9\nCRvK6brcFSVVOaAE/Iedy434lxmR5TnFTlxPNfarcaCtzQAVYFqb2Hp0c1ps/jRf\nyQOcnIh4Ckd4qvDwTZBsFw3VpxxB1JdnRhRMrKsUXPSNAJYvnN4PYCaVHNM8htcJ\n7FN/x09uM1cXzQGzmVqp\n=pgRK\n-----END PGP SIGNATURE-----\n","payload":"tree e099d0b62213fd03f3712687a941b1f7a6076d43\nparent 8347b8de2144133f49fd18a20f4ca176deef1d3c\nauthor Channing Conger <cconger@openai.com> 1783633210 -0700\ncommitter GitHub <noreply@github.com> 1783633210 -0700\n\ncode-mode: fall back to using in process v8 if we fail to resolve external process (#31899)\n\n## Why\n\nNot every Codex distribution currently includes the\n`codex-code-mode-host` companion binary. Enabling the process-host\nfeature should not make code mode unavailable on those surfaces while\npackaging support is being completed.\n\n## What changed\n\n- Fall back to an in-process code-mode session only when spawning the\ncompanion binary returns `io::ErrorKind::NotFound`.\n- Keep permission, handshake, timeout, and other host failures visible\ninstead of silently falling back.\n- Store the provider's owned-process/in-process choice as one\nenum-backed state so later sessions reuse the fallback decision.\n- Preserve the underlying spawn `io::Error` while retaining the host\npath in the displayed error.\n- Update provider, `CodeModeService`, and end-to-end coverage to verify\nsuccessful fallback execution.\n\n## Test plan\n\n- `just test -p codex-code-mode`\n- `just test -p codex-core missing_process_host`","verified_at":"2026-07-09T21:40:10Z"}},"url":"https://api.github.com/repos/openai/codex/commits/8cf9a1b1f8ea35c724831a739fea2d725d72c582","html_url":"https://github.com/openai/codex/commit/8cf9a1b1f8ea35c724831a739fea2d725d72c582","comments_url":"https://api.github.com/repos/openai/codex/commits/8cf9a1b1f8ea35c724831a739fea2d725d72c582/comments","author":{"login":"cconger","id":200563,"node_id":"MDQ6VXNlcjIwMDU2Mw==","avatar_url":"https://avatars.githubusercontent.com/u/200563?v=4","gravatar_id":"","url":"https://api.github.com/users/cconger","html_url":"https://github.com/cconger","followers_url":"https://api.github.com/users/cconger/followers","following_url":"https://api.github.com/users/cconger/following{/other_user}","gists_url":"https://api.github.com/users/cconger/gists{/gist_id}","starred_url":"https://api.github.com/users/cconger/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cconger/subscriptions","organizations_url":"https://api.github.com/users/cconger/orgs","repos_url":"https://api.github.com/users/cconger/repos","events_url":"https://api.github.com/users/cconger/events{/privacy}","received_events_url":"https://api.github.com/users/cconger/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"8347b8de2144133f49fd18a20f4ca176deef1d3c","url":"https://api.github.com/repos/openai/codex/commits/8347b8de2144133f49fd18a20f4ca176deef1d3c","html_url":"https://github.com/openai/codex/commit/8347b8de2144133f49fd18a20f4ca176deef1d3c"}]},{"sha":"8347b8de2144133f49fd18a20f4ca176deef1d3c","node_id":"C_kwDOOYsS4doAKDgzNDdiOGRlMjE0NDEzM2Y0OWZkMThhMjBmNGNhMTc2ZGVlZjFkM2M","commit":{"author":{"name":"thomas","email":"tsarlandie@openai.com","date":"2026-07-09T21:32:23Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-09T21:32:23Z"},"message":"[codex-apps] Filter optional file fields by tool schema (#31686)\n\n## Summary\n\nCodex Apps file parameters are exposed to the model as local paths,\nuploaded at execution time, and rewritten into provided-file payloads\nbefore the MCP tool call.\n\nThe rewrite currently includes the documented optional fields\n`mime_type` and `file_name` for every file parameter. Apps with strict\nschemas can reject those fields when they are not declared.\n\n## Changes\n\n- Derive the supported optional file fields from each\n`openai/fileParams` parameter's raw input schema before replacing it\nwith the model-visible local-path schema.\n- Always include `download_url` and `file_id`.\n- Include `mime_type` and `file_name` only when that specific file\nparameter's schema accepts them, including schemas that allow additional\nproperties.\n- Handle scalar and array file parameters, including items-only arrays,\ncomposed schemas, and local JSON Schema references.\n- Preserve the existing restriction that only the host-owned Codex Apps\nMCP server can use this upload path.\n\nThis supports tools with different file contracts in the same app: one\nparameter can accept the optional fields while another remains strict.\n\n## Validation\n\n- `just test -p codex-mcp`\n- `just test -p codex-core mcp_openai_file`\n- `just test -p codex-core codex_apps_file_params_`\n- `just fix -p codex-mcp`\n- `just fix -p codex-core`\n- `just fmt`\n- `git diff --check`\n- Manually verified in the Codex Electron app that:\n  - a strict file schema receives only `download_url` and `file_id`\n  - a rich file schema also receives `mime_type` and `file_name`\n\nRelated: #31330","tree":{"sha":"839466bf53d0b30dde9a745f4cbd77ed8e19fc1d","url":"https://api.github.com/repos/openai/codex/git/trees/839466bf53d0b30dde9a745f4cbd77ed8e19fc1d"},"url":"https://api.github.com/repos/openai/codex/git/commits/8347b8de2144133f49fd18a20f4ca176deef1d3c","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqUBNnCRC1aQ7uu5UhlAAAx9EQAHUYWSSdYPdj3kp0W2cPYnAS\nGkSL9t/dlNZ6MDirbDPOZZfH8s8oUzYD0xWvtXcPabtBiMZG+wZiWXHHFvWI7j5w\n6hzExJMZn3dPhwiki+Q1NLL4amKnWTrXWD2ewbkXH5tKoeFiYNyQyuX8NqHGnalO\n2/788AKBHM5/JSnl+ZqDpAcKivSubd2YPHSiC4R8AkUi4Bael8RWaSh8uSFwsXMy\nJ3PZt2M0puf34+zTLUiAafMXhv1Wqt4P/pQtknMpSODDTCOGNl5NXZgo+fIz9aES\nEQX/vSNOST83oBpj6n+aUwUpjjP7OcP7I8rzJm61T2UzTJ/V2NOvoJ9+PlOJTGzJ\nCir3HLj0dP0jsyez43galrS/vEzEowvCMJnaZBGu69jS54dAlDwbn52v/4IpCwgF\nVCqEy2mKFKXcs8sHz8a9HPDeBYiQ4MpuA8Akfk2fkNnMLuWCzIeE2unwKkVvdQ6T\nBbYYOQglmToqirOYpTBuexnQBV37Mphky5sUKo30GGxJwjyIQGrlFyesNGuy6NXc\nNwgg88nTMy1SClCsJk2YyOvQ+cRP/CmWp4K4AOFdWM0hJ/fuD4IZUtB7QTjaE52i\n0XJQ3ogCQSzmSXR/I3esH5ooJSGNlgIL0/gLD9ksUbdsIKPK2jgp8PpxAkMkooLa\nvsQAu/qG+hgqZeqY/Gpk\n=tYFZ\n-----END PGP SIGNATURE-----\n","payload":"tree 839466bf53d0b30dde9a745f4cbd77ed8e19fc1d\nparent 6d3cde7fcd1db4f851928f5eccbb90cb4df26ca2\nauthor thomas <tsarlandie@openai.com> 1783632743 -0700\ncommitter GitHub <noreply@github.com> 1783632743 -0700\n\n[codex-apps] Filter optional file fields by tool schema (#31686)\n\n## Summary\n\nCodex Apps file parameters are exposed to the model as local paths,\nuploaded at execution time, and rewritten into provided-file payloads\nbefore the MCP tool call.\n\nThe rewrite currently includes the documented optional fields\n`mime_type` and `file_name` for every file parameter. Apps with strict\nschemas can reject those fields when they are not declared.\n\n## Changes\n\n- Derive the supported optional file fields from each\n`openai/fileParams` parameter's raw input schema before replacing it\nwith the model-visible local-path schema.\n- Always include `download_url` and `file_id`.\n- Include `mime_type` and `file_name` only when that specific file\nparameter's schema accepts them, including schemas that allow additional\nproperties.\n- Handle scalar and array file parameters, including items-only arrays,\ncomposed schemas, and local JSON Schema references.\n- Preserve the existing restriction that only the host-owned Codex Apps\nMCP server can use this upload path.\n\nThis supports tools with different file contracts in the same app: one\nparameter can accept the optional fields while another remains strict.\n\n## Validation\n\n- `just test -p codex-mcp`\n- `just test -p codex-core mcp_openai_file`\n- `just test -p codex-core codex_apps_file_params_`\n- `just fix -p codex-mcp`\n- `just fix -p codex-core`\n- `just fmt`\n- `git diff --check`\n- Manually verified in the Codex Electron app that:\n  - a strict file schema receives only `download_url` and `file_id`\n  - a rich file schema also receives `mime_type` and `file_name`\n\nRelated: #31330","verified_at":"2026-07-09T21:32:24Z"}},"url":"https://api.github.com/repos/openai/codex/commits/8347b8de2144133f49fd18a20f4ca176deef1d3c","html_url":"https://github.com/openai/codex/commit/8347b8de2144133f49fd18a20f4ca176deef1d3c","comments_url":"https://api.github.com/repos/openai/codex/commits/8347b8de2144133f49fd18a20f4ca176deef1d3c/comments","author":{"login":"tsarlandie-oai","id":291887306,"node_id":"U_kgDOEWXYyg","avatar_url":"https://avatars.githubusercontent.com/u/291887306?v=4","gravatar_id":"","url":"https://api.github.com/users/tsarlandie-oai","html_url":"https://github.com/tsarlandie-oai","followers_url":"https://api.github.com/users/tsarlandie-oai/followers","following_url":"https://api.github.com/users/tsarlandie-oai/following{/other_user}","gists_url":"https://api.github.com/users/tsarlandie-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/tsarlandie-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tsarlandie-oai/subscriptions","organizations_url":"https://api.github.com/users/tsarlandie-oai/orgs","repos_url":"https://api.github.com/users/tsarlandie-oai/repos","events_url":"https://api.github.com/users/tsarlandie-oai/events{/privacy}","received_events_url":"https://api.github.com/users/tsarlandie-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"6d3cde7fcd1db4f851928f5eccbb90cb4df26ca2","url":"https://api.github.com/repos/openai/codex/commits/6d3cde7fcd1db4f851928f5eccbb90cb4df26ca2","html_url":"https://github.com/openai/codex/commit/6d3cde7fcd1db4f851928f5eccbb90cb4df26ca2"}]},{"sha":"6d3cde7fcd1db4f851928f5eccbb90cb4df26ca2","node_id":"C_kwDOOYsS4doAKDZkM2NkZTdmY2QxZGI0Zjg1MTkyOGY1ZWNjYmI5MGNiNGRmMjZjYTI","commit":{"author":{"name":"Michael Bolin","email":"mbolin@openai.com","date":"2026-07-09T21:26:20Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-09T21:26:20Z"},"message":"login: route raw auth flows through HTTP client (#31637)\n\n## Why\n\nLogin already honors `respect_system_proxy`, but several login-owned\nauth flows still construct and pass around raw `reqwest::Client` values.\nThat keeps those request paths coupled to the underlying transport and\nleaves `codex-login` on the temporary direct-`reqwest` allowlist\nintroduced by #31431.\n\nAuth endpoints also have a stricter logging boundary than ordinary API\nrequests: custom issuer URLs and response headers may contain\ncredentials. Moving these requests behind the shared HTTP abstraction\nmust preserve that boundary while retaining route-aware proxy and\ncustom-CA behavior.\n\nThis is a bounded login migration. The separate Agent Identity and\nshared default-client compatibility migrations remain follow-up work.\n\n## What changed\n\n- Add `HttpClientFactory::build_client` to construct the shared\n`HttpClient` abstraction for a resolved destination and route class.\n- Add a route-aware construction path that suppresses request URL,\nresponse-header, and transport-error diagnostics for sensitive auth\nendpoints.\n- Route device-code user-code/polling requests, OAuth authorization-code\nexchange, and API-key token exchange through `HttpClient`.\n- Build the revoke timeout test client through the same factory API.\n- Use the transport-neutral `http::StatusCode` in the migrated\ndevice-code flow.\n- Add an end-to-end log-capture regression test covering successful\nresponses and transport failures after `RequestBuilder` transformations.\n\n## Review guidance\n\nThe request behavior is intended to be unchanged: each issuer/token\nendpoint selects the same auth route, including the existing system/PAC\nproxy and custom-CA handling, and raw auth clients still omit Codex\ndefault headers. The intentional logging change is limited to raw auth\nrequests, whose URL userinfo, query credentials, response headers, and\ntransport errors must not cross the auth redaction boundary.\n\nThis PR deliberately does **not** remove `codex-login` from #31431's\nallowlist. The remaining direct `reqwest` surface belongs primarily to:\n\n- Agent Identity APIs that still accept `reqwest::Client`.\n- Exported default-client compatibility helpers used by other workspace\ncrates.\n- A small number of tests and concrete error/header types.\n\n## Testing\n\n- `cargo check -p codex-http-client -p codex-login --tests`\n- `just test -p codex-http-client` (41 tests)\n- `just test -p codex-login` (155 tests)\n- `just bazel-lock-check`\n\n---\n[//]: # (BEGIN SAPLING FOOTER)\nStack created with [Sapling](https://sapling-scm.com). Best reviewed\nwith [ReviewStack](https://reviewstack.dev/openai/codex/pull/31637).\n* #31837\n* #31828\n* #31825\n* #31821\n* __->__ #31637","tree":{"sha":"6c9ef48a715a322da35ec719b5f8dff0816a6aca","url":"https://api.github.com/repos/openai/codex/git/trees/6c9ef48a715a322da35ec719b5f8dff0816a6aca"},"url":"https://api.github.com/repos/openai/codex/git/commits/6d3cde7fcd1db4f851928f5eccbb90cb4df26ca2","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqUBH8CRC1aQ7uu5UhlAAAzG0QAEoRN9zdW1u2hs0j2HXDz42E\nvVRdk2tV1ZfQ1PeT8sdPTLMIFMKqq0BsULwDBEKQUkYamyMLe1uu00oeIu6Whpdf\n1IbNBkmyNLBgUee4ee433QZ4vyfEg3g8eNSacbTVXOvmwkOurPAKagWmsSXV0ZPD\nnCjRlo+vxHVTueLPq4vVg5XBESpuuuhnfB/SbNMaNgOmuqYDPhn/ArlFN8acS7oC\n3c9MSiiv6JyTg2XdZl4vkjPqz1YU8ymXM6z2cSS0VKjg+WRz+JjPI/dClkDBK0C6\nOYJdMbLIf1VdvyLDPQP7X/epIWVZvRoIew5695m0wRIIF/qT9zR68PxuY4VwrpgI\nTpnM7q2PM2eX/F5zwSBKNNNR3W9D8OgjogqbH6HqsPxTIbDWmAjcWnd2UMa2vEJG\nrDnVgTb9/eifp2fK2G1nZ6SzEE/FV4RAV35sNndVrhAEqj7IJ5uRb7HcQoeg+1aE\nrcH27MQ6B8oXSIKaupoXT9GitxkZ/DsK2PgQpAWo1w/sf0oh1ZiD8sym5c16ULsR\neEb0aqAH+nvsFbFpuucE8lPXQWXorJPSgGxUEslCHpQgwnhNQgNM9lWXSjZ2QPNz\n15t4PKWy26GsI5Cjq3exdn3Crx2bgFHPwX+RJWE6ismmHRI19UKBZD84lhcjoU0V\ntA5rWZKl1F2m2Ubb8J09\n=21s9\n-----END PGP SIGNATURE-----\n","payload":"tree 6c9ef48a715a322da35ec719b5f8dff0816a6aca\nparent 37c6f2916fb6e72e7249d245f1a50ff1c5fba804\nauthor Michael Bolin <mbolin@openai.com> 1783632380 -0700\ncommitter GitHub <noreply@github.com> 1783632380 -0700\n\nlogin: route raw auth flows through HTTP client (#31637)\n\n## Why\n\nLogin already honors `respect_system_proxy`, but several login-owned\nauth flows still construct and pass around raw `reqwest::Client` values.\nThat keeps those request paths coupled to the underlying transport and\nleaves `codex-login` on the temporary direct-`reqwest` allowlist\nintroduced by #31431.\n\nAuth endpoints also have a stricter logging boundary than ordinary API\nrequests: custom issuer URLs and response headers may contain\ncredentials. Moving these requests behind the shared HTTP abstraction\nmust preserve that boundary while retaining route-aware proxy and\ncustom-CA behavior.\n\nThis is a bounded login migration. The separate Agent Identity and\nshared default-client compatibility migrations remain follow-up work.\n\n## What changed\n\n- Add `HttpClientFactory::build_client` to construct the shared\n`HttpClient` abstraction for a resolved destination and route class.\n- Add a route-aware construction path that suppresses request URL,\nresponse-header, and transport-error diagnostics for sensitive auth\nendpoints.\n- Route device-code user-code/polling requests, OAuth authorization-code\nexchange, and API-key token exchange through `HttpClient`.\n- Build the revoke timeout test client through the same factory API.\n- Use the transport-neutral `http::StatusCode` in the migrated\ndevice-code flow.\n- Add an end-to-end log-capture regression test covering successful\nresponses and transport failures after `RequestBuilder` transformations.\n\n## Review guidance\n\nThe request behavior is intended to be unchanged: each issuer/token\nendpoint selects the same auth route, including the existing system/PAC\nproxy and custom-CA handling, and raw auth clients still omit Codex\ndefault headers. The intentional logging change is limited to raw auth\nrequests, whose URL userinfo, query credentials, response headers, and\ntransport errors must not cross the auth redaction boundary.\n\nThis PR deliberately does **not** remove `codex-login` from #31431's\nallowlist. The remaining direct `reqwest` surface belongs primarily to:\n\n- Agent Identity APIs that still accept `reqwest::Client`.\n- Exported default-client compatibility helpers used by other workspace\ncrates.\n- A small number of tests and concrete error/header types.\n\n## Testing\n\n- `cargo check -p codex-http-client -p codex-login --tests`\n- `just test -p codex-http-client` (41 tests)\n- `just test -p codex-login` (155 tests)\n- `just bazel-lock-check`\n\n---\n[//]: # (BEGIN SAPLING FOOTER)\nStack created with [Sapling](https://sapling-scm.com). Best reviewed\nwith [ReviewStack](https://reviewstack.dev/openai/codex/pull/31637).\n* #31837\n* #31828\n* #31825\n* #31821\n* __->__ #31637","verified_at":"2026-07-09T21:26:21Z"}},"url":"https://api.github.com/repos/openai/codex/commits/6d3cde7fcd1db4f851928f5eccbb90cb4df26ca2","html_url":"https://github.com/openai/codex/commit/6d3cde7fcd1db4f851928f5eccbb90cb4df26ca2","comments_url":"https://api.github.com/repos/openai/codex/commits/6d3cde7fcd1db4f851928f5eccbb90cb4df26ca2/comments","author":{"login":"bolinfest","id":655869,"node_id":"MDQ6VXNlcjY1NTg2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/655869?v=4","gravatar_id":"","url":"https://api.github.com/users/bolinfest","html_url":"https://github.com/bolinfest","followers_url":"https://api.github.com/users/bolinfest/followers","following_url":"https://api.github.com/users/bolinfest/following{/other_user}","gists_url":"https://api.github.com/users/bolinfest/gists{/gist_id}","starred_url":"https://api.github.com/users/bolinfest/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bolinfest/subscriptions","organizations_url":"https://api.github.com/users/bolinfest/orgs","repos_url":"https://api.github.com/users/bolinfest/repos","events_url":"https://api.github.com/users/bolinfest/events{/privacy}","received_events_url":"https://api.github.com/users/bolinfest/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"37c6f2916fb6e72e7249d245f1a50ff1c5fba804","url":"https://api.github.com/repos/openai/codex/commits/37c6f2916fb6e72e7249d245f1a50ff1c5fba804","html_url":"https://github.com/openai/codex/commit/37c6f2916fb6e72e7249d245f1a50ff1c5fba804"}]},{"sha":"37c6f2916fb6e72e7249d245f1a50ff1c5fba804","node_id":"C_kwDOOYsS4doAKDM3YzZmMjkxNmZiNmU3MmU3MjQ5ZDI0NWYxYTUwZmYxYzVmYmE4MDQ","commit":{"author":{"name":"Konstantine Kahadze","email":"kkahadze@openai.com","date":"2026-07-09T21:01:16Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-09T21:01:16Z"},"message":"Update bundled OpenAI Docs skill for GPT-5.6 (#31842)\n\n## Summary\n\nUpdates Codex's bundled OpenAI Docs skill for GPT-5.6.\n\n- resolves latest/current/default-model requests through the\nmachine-readable `latest-model.md` contract\n- fetches the exact prompting and migration guide URLs returned by the\nlive docs\n- preserves explicitly named GPT-5 model targets\n- adds bundled GPT-5.6 Sol, Terra, and Luna migration judgment\n- adds a POSIX resolver wrapper plus a CommonJS entry point for Windows\n- skips incompatible Node.js runtimes before trying Codex's\nbundled/system fallbacks\n\n## Developer impact\n\nThe bundled system skill follows the live GPT-5.6 docs contract and can\nresolve current guidance after installation on POSIX and Windows\nenvironments.\n\n## Validation\n\n- skill validator: passed\n- live resolver smoke test returned `gpt-5.6-sol` and both standalone\nguide URLs\n- CommonJS and POSIX shell syntax checks: passed\n- non-executable installed-wrapper invocation through `sh`: passed\n- incompatible `$NODE` fallback to the bundled Node.js runtime: passed\n- `git diff --check`: passed\n- migration eval: 30/30 passed, 0 critical failures\n- latest-model/prompting routing eval: 33/33 passed, 0 critical failures\n\n`just fmt` was not run because `just` is unavailable in this\nenvironment; the change only touches bundled Markdown and\nJavaScript/shell assets.","tree":{"sha":"2cf56ce2652e8b5aa35a29567db8e6df7bd7b616","url":"https://api.github.com/repos/openai/codex/git/trees/2cf56ce2652e8b5aa35a29567db8e6df7bd7b616"},"url":"https://api.github.com/repos/openai/codex/git/commits/37c6f2916fb6e72e7249d245f1a50ff1c5fba804","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqUAwcCRC1aQ7uu5UhlAAAj98QAF7c6P1nI2bTnNTSYraqJv2q\nEO96Gc6wZFP7pRsuvxUVralOhV2Ys4QlCxJ4oNb5uF1nRlAvjy3wNYM1o07fnfFi\n1rIq3hdhVKpw3xK/ZemeNJUmlXVeKGFn9VUkTBlVSL/ncEGu01COIewqPxunPtrQ\nHIJs7Y/Nsmyh+uJR+RNKIJ2zIRjTpVkmSA0Rpw4kwD3zCqby/HQ81085xrVDO47P\nAuTDlRvqyOLiXXnMZgGfYkq2BhyjJgYWHhBcqUZCube/DrTm7mLNfrAyI1bdUqKO\nfKaIZbty1F0tj2N4/tp7hag6nk2PB8ig5fXy24Sp38S7P3Rfi/n0La0Yjj4jFD+k\nuzUoipkvXS4d4mqquXMSj7r0pxaGXI24UpzLQ5hhedZ1VC839tjryOS1ZI+DMTYN\n36zzn2wXqBFmb8uYY97zLQj0rjdGbgy1GS35KMuHCG1K8CbTRtv++prw+5ABcyO9\nfYewxOPJlmRw+d44B05G/xm6hgVHKIt9+0mSbaczWT7UtZP2KrX2Slb2heC8B5yg\nrlDJDWKpM1D9Yw45ylz80y//TnAAAmiCuhDa+cMZCV0XA9dlGXczwb5Da+2NV4Zo\n4GWTKrMHpGQ/nYRIjI1cEfezUxw4n3tGw39/PtcVyBrnu0mMf21O5m28Bpwo0fQw\npFP88hpGxYPouAN2d8VJ\n=fOeE\n-----END PGP SIGNATURE-----\n","payload":"tree 2cf56ce2652e8b5aa35a29567db8e6df7bd7b616\nparent 22781d40019779abc158723f2387cc6bce22a7ce\nauthor Konstantine Kahadze <kkahadze@openai.com> 1783630876 +0400\ncommitter GitHub <noreply@github.com> 1783630876 -0700\n\nUpdate bundled OpenAI Docs skill for GPT-5.6 (#31842)\n\n## Summary\n\nUpdates Codex's bundled OpenAI Docs skill for GPT-5.6.\n\n- resolves latest/current/default-model requests through the\nmachine-readable `latest-model.md` contract\n- fetches the exact prompting and migration guide URLs returned by the\nlive docs\n- preserves explicitly named GPT-5 model targets\n- adds bundled GPT-5.6 Sol, Terra, and Luna migration judgment\n- adds a POSIX resolver wrapper plus a CommonJS entry point for Windows\n- skips incompatible Node.js runtimes before trying Codex's\nbundled/system fallbacks\n\n## Developer impact\n\nThe bundled system skill follows the live GPT-5.6 docs contract and can\nresolve current guidance after installation on POSIX and Windows\nenvironments.\n\n## Validation\n\n- skill validator: passed\n- live resolver smoke test returned `gpt-5.6-sol` and both standalone\nguide URLs\n- CommonJS and POSIX shell syntax checks: passed\n- non-executable installed-wrapper invocation through `sh`: passed\n- incompatible `$NODE` fallback to the bundled Node.js runtime: passed\n- `git diff --check`: passed\n- migration eval: 30/30 passed, 0 critical failures\n- latest-model/prompting routing eval: 33/33 passed, 0 critical failures\n\n`just fmt` was not run because `just` is unavailable in this\nenvironment; the change only touches bundled Markdown and\nJavaScript/shell assets.","verified_at":"2026-07-09T21:01:16Z"}},"url":"https://api.github.com/repos/openai/codex/commits/37c6f2916fb6e72e7249d245f1a50ff1c5fba804","html_url":"https://github.com/openai/codex/commit/37c6f2916fb6e72e7249d245f1a50ff1c5fba804","comments_url":"https://api.github.com/repos/openai/codex/commits/37c6f2916fb6e72e7249d245f1a50ff1c5fba804/comments","author":{"login":"kkahadze-oai","id":269039836,"node_id":"U_kgDOEAk43A","avatar_url":"https://avatars.githubusercontent.com/u/269039836?v=4","gravatar_id":"","url":"https://api.github.com/users/kkahadze-oai","html_url":"https://github.com/kkahadze-oai","followers_url":"https://api.github.com/users/kkahadze-oai/followers","following_url":"https://api.github.com/users/kkahadze-oai/following{/other_user}","gists_url":"https://api.github.com/users/kkahadze-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/kkahadze-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kkahadze-oai/subscriptions","organizations_url":"https://api.github.com/users/kkahadze-oai/orgs","repos_url":"https://api.github.com/users/kkahadze-oai/repos","events_url":"https://api.github.com/users/kkahadze-oai/events{/privacy}","received_events_url":"https://api.github.com/users/kkahadze-oai/received_events","type":"User","use