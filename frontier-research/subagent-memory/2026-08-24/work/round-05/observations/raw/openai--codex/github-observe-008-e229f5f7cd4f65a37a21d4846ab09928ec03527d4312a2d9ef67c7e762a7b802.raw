[{"sha":"ccee70f81379374028265be41f95f15d9d254ce9","node_id":"C_kwDOOYsS4doAKGNjZWU3MGY4MTM3OTM3NDAyODI2NWJlNDFmOTVmMTVkOWQyNTRjZTk","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-08-14T19:57:07Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T20:02:03Z"},"message":"Remove repository-local Codex skills (#38635)\n\n## What changed\n\n- Remove the `codex-bug` issue-triage skill.\n- Remove the `codex-issue-digest` skill, including its collector, agent metadata, and tests.\n- Remove the `pushing-ci-changes` skill.\n\nGitOrigin-RevId: 90f69a32b09456271344d49ebe5aa3eed5a8c808","tree":{"sha":"2d9ee7086a70373a67ed4bf7b8f636f59d0d10b5","url":"https://api.github.com/repos/openai/codex/git/trees/2d9ee7086a70373a67ed4bf7b8f636f59d0d10b5"},"url":"https://api.github.com/repos/openai/codex/git/commits/ccee70f81379374028265be41f95f15d9d254ce9","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/ccee70f81379374028265be41f95f15d9d254ce9","html_url":"https://github.com/openai/codex/commit/ccee70f81379374028265be41f95f15d9d254ce9","comments_url":"https://api.github.com/repos/openai/codex/commits/ccee70f81379374028265be41f95f15d9d254ce9/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"6bed213411d1250686cc162feb4324975c12158a","url":"https://api.github.com/repos/openai/codex/commits/6bed213411d1250686cc162feb4324975c12158a","html_url":"https://github.com/openai/codex/commit/6bed213411d1250686cc162feb4324975c12158a"}]},{"sha":"6bed213411d1250686cc162feb4324975c12158a","node_id":"C_kwDOOYsS4doAKDZiZWQyMTM0MTFkMTI1MDY4NmNjMTYyZmViNDMyNDk3NWMxMjE1OGE","commit":{"author":{"name":"thomas","email":"tsarlandie@openai.com","date":"2026-08-14T19:47:34Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T19:57:04Z"},"message":"Add MCP protocol discovery metrics (#38634)\n\n## What changed\n\n- Record a counter and duration for MCP client protocol discovery.\n- Tag observations with the configured `legacy` or `auto` mode and classify\n  outcomes as `modern`, `legacy`, or `failure`.\n\nGitOrigin-RevId: f348e0d900b437d5a9fef1c33cdb1314f2421785","tree":{"sha":"94324a0a8a4db4781665150a5abc5b34baed524f","url":"https://api.github.com/repos/openai/codex/git/trees/94324a0a8a4db4781665150a5abc5b34baed524f"},"url":"https://api.github.com/repos/openai/codex/git/commits/6bed213411d1250686cc162feb4324975c12158a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/6bed213411d1250686cc162feb4324975c12158a","html_url":"https://github.com/openai/codex/commit/6bed213411d1250686cc162feb4324975c12158a","comments_url":"https://api.github.com/repos/openai/codex/commits/6bed213411d1250686cc162feb4324975c12158a/comments","author":{"login":"tsarlandie-oai","id":291887306,"node_id":"U_kgDOEWXYyg","avatar_url":"https://avatars.githubusercontent.com/u/291887306?v=4","gravatar_id":"","url":"https://api.github.com/users/tsarlandie-oai","html_url":"https://github.com/tsarlandie-oai","followers_url":"https://api.github.com/users/tsarlandie-oai/followers","following_url":"https://api.github.com/users/tsarlandie-oai/following{/other_user}","gists_url":"https://api.github.com/users/tsarlandie-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/tsarlandie-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tsarlandie-oai/subscriptions","organizations_url":"https://api.github.com/users/tsarlandie-oai/orgs","repos_url":"https://api.github.com/users/tsarlandie-oai/repos","events_url":"https://api.github.com/users/tsarlandie-oai/events{/privacy}","received_events_url":"https://api.github.com/users/tsarlandie-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"6595071e65c5f4037e578e059aa552434084b6da","url":"https://api.github.com/repos/openai/codex/commits/6595071e65c5f4037e578e059aa552434084b6da","html_url":"https://github.com/openai/codex/commit/6595071e65c5f4037e578e059aa552434084b6da"}]},{"sha":"6595071e65c5f4037e578e059aa552434084b6da","node_id":"C_kwDOOYsS4doAKDY1OTUwNzFlNjVjNWY0MDM3ZTU3OGUwNTlhYTU1MjQzNDA4NGI2ZGE","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-08-14T19:21:45Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T19:26:36Z"},"message":"Remove the gRPC code-mode open session limit (#38630)\n\n## What changed\n\nAllow the gRPC code-mode host to register more than\n`MAX_IN_FLIGHT_REQUESTS` open sessions. Existing limits on in-flight\nrequests, control requests, and active cells remain unchanged.\n\nGitOrigin-RevId: 126c5088868e7783f8592f3f9250f5c8573df51f","tree":{"sha":"d15b5c689bd6ba1586cb6aa4357355451bf3004e","url":"https://api.github.com/repos/openai/codex/git/trees/d15b5c689bd6ba1586cb6aa4357355451bf3004e"},"url":"https://api.github.com/repos/openai/codex/git/commits/6595071e65c5f4037e578e059aa552434084b6da","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/6595071e65c5f4037e578e059aa552434084b6da","html_url":"https://github.com/openai/codex/commit/6595071e65c5f4037e578e059aa552434084b6da","comments_url":"https://api.github.com/repos/openai/codex/commits/6595071e65c5f4037e578e059aa552434084b6da/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"baab1705c60089f919accc11608aa0df02f634f7","url":"https://api.github.com/repos/openai/codex/commits/baab1705c60089f919accc11608aa0df02f634f7","html_url":"https://github.com/openai/codex/commit/baab1705c60089f919accc11608aa0df02f634f7"}]},{"sha":"baab1705c60089f919accc11608aa0df02f634f7","node_id":"C_kwDOOYsS4doAKGJhYWIxNzA1YzYwMDg5ZjkxOWFjY2MxMTYwOGFhMGRmMDJmNjM0Zjc","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-14T18:57:47Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T19:11:41Z"},"message":"Make Guardian v2 risk classification configurable (#38628)\n\n## What changed\n\n- Allow `features.guardianv2` to remain a boolean toggle or specify classifier instructions, the review threshold, reasoning effort, and action and instruction token limits.\n- Add transcript controls for included sources, per-entry and total token budgets, and the number of recent non-user entries.\n- Validate configured ranges and relationships, expose them in the generated config schema, and apply the resolved settings throughout Guardian v2 classification and approval review.\n\n## Testing\n\n- Cover boolean compatibility, configuration parsing and boundaries, config-manager rejection, and the resulting classifier request and approval decision.\n\nGitOrigin-RevId: dc018b53b782e2d6b4d6a795cca4945130a71678","tree":{"sha":"bc85f206cfca0e2390ee55282420ae0a3e3368af","url":"https://api.github.com/repos/openai/codex/git/trees/bc85f206cfca0e2390ee55282420ae0a3e3368af"},"url":"https://api.github.com/repos/openai/codex/git/commits/baab1705c60089f919accc11608aa0df02f634f7","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/baab1705c60089f919accc11608aa0df02f634f7","html_url":"https://github.com/openai/codex/commit/baab1705c60089f919accc11608aa0df02f634f7","comments_url":"https://api.github.com/repos/openai/codex/commits/baab1705c60089f919accc11608aa0df02f634f7/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"d8d7ca73f80e992cade867970ceb264431cea33c","url":"https://api.github.com/repos/openai/codex/commits/d8d7ca73f80e992cade867970ceb264431cea33c","html_url":"https://github.com/openai/codex/commit/d8d7ca73f80e992cade867970ceb264431cea33c"}]},{"sha":"d8d7ca73f80e992cade867970ceb264431cea33c","node_id":"C_kwDOOYsS4doAKGQ4ZDdjYTczZjgwZTk5MmNhZGU4Njc5NzBjZWIyNjQ0MzFjZWEzM2M","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-08-14T18:54:01Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T19:07:15Z"},"message":"Enable unified exec by default on Windows (#38625)\n\n## What changed\n\n- Enable the stable `unified_exec` feature by default on every platform.\n- Update cross-platform integration test expectations so `exec_command` and\n  `write_stdin` are exposed on Windows instead of `shell_command`.\n\nGitOrigin-RevId: e5c864bacbde7eab109e7a0e399b8f7b843b384c","tree":{"sha":"212b492a21ab8aee08d92a2c8782f56bf63e3be3","url":"https://api.github.com/repos/openai/codex/git/trees/212b492a21ab8aee08d92a2c8782f56bf63e3be3"},"url":"https://api.github.com/repos/openai/codex/git/commits/d8d7ca73f80e992cade867970ceb264431cea33c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/d8d7ca73f80e992cade867970ceb264431cea33c","html_url":"https://github.com/openai/codex/commit/d8d7ca73f80e992cade867970ceb264431cea33c","comments_url":"https://api.github.com/repos/openai/codex/commits/d8d7ca73f80e992cade867970ceb264431cea33c/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"1426592fccd9ab78764a0dcce63b0190a95be04c","url":"https://api.github.com/repos/openai/codex/commits/1426592fccd9ab78764a0dcce63b0190a95be04c","html_url":"https://github.com/openai/codex/commit/1426592fccd9ab78764a0dcce63b0190a95be04c"}]},{"sha":"1426592fccd9ab78764a0dcce63b0190a95be04c","node_id":"C_kwDOOYsS4doAKDE0MjY1OTJmY2NkOWFiNzg3NjRhMGRjY2U2M2IwMTkwYTk1YmUwNGM","commit":{"author":{"name":"Benjamin Carlsson","email":"bc@openai.com","date":"2026-08-14T18:46:39Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T19:02:27Z"},"message":"Open notes when accepting the request input Other option (#38624)\n\n## What changed\n\nWhen the generated `None of the above` option is selected in a request user\ninput prompt, route Enter and configured accept actions to the notes editor\ninstead of submitting the response. Tab continues to open the same editor.\n\n## Testing\n\nAdd a regression test confirming that both Tab and Enter reveal the notes editor\nwithout submitting the response.\n\nGitOrigin-RevId: 8a563d81a82a11ca0b26c2b1100053f13be8e8f4","tree":{"sha":"eec2118845fb4138a9ef89f9e7921d9941e6e322","url":"https://api.github.com/repos/openai/codex/git/trees/eec2118845fb4138a9ef89f9e7921d9941e6e322"},"url":"https://api.github.com/repos/openai/codex/git/commits/1426592fccd9ab78764a0dcce63b0190a95be04c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/1426592fccd9ab78764a0dcce63b0190a95be04c","html_url":"https://github.com/openai/codex/commit/1426592fccd9ab78764a0dcce63b0190a95be04c","comments_url":"https://api.github.com/repos/openai/codex/commits/1426592fccd9ab78764a0dcce63b0190a95be04c/comments","author":{"login":"bc-openai","id":185964850,"node_id":"U_kgDOCxWZMg","avatar_url":"https://avatars.githubusercontent.com/u/185964850?v=4","gravatar_id":"","url":"https://api.github.com/users/bc-openai","html_url":"https://github.com/bc-openai","followers_url":"https://api.github.com/users/bc-openai/followers","following_url":"https://api.github.com/users/bc-openai/following{/other_user}","gists_url":"https://api.github.com/users/bc-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/bc-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bc-openai/subscriptions","organizations_url":"https://api.github.com/users/bc-openai/orgs","repos_url":"https://api.github.com/users/bc-openai/repos","events_url":"https://api.github.com/users/bc-openai/events{/privacy}","received_events_url":"https://api.github.com/users/bc-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"42b5f05cef69491bc578901fb324b3c9a278b253","url":"https://api.github.com/repos/openai/codex/commits/42b5f05cef69491bc578901fb324b3c9a278b253","html_url":"https://github.com/openai/codex/commit/42b5f05cef69491bc578901fb324b3c9a278b253"}]},{"sha":"42b5f05cef69491bc578901fb324b3c9a278b253","node_id":"C_kwDOOYsS4doAKDQyYjVmMDVjZWY2OTQ5MWJjNTc4OTAxZmIzMjRiM2M5YTI3OGIyNTM","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-14T18:25:31Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T18:35:13Z"},"message":"Preserve MCP namespace descriptions in the tool catalog cache (#38623)\n\n## What changed\n\nKeep MCP namespace descriptions when publishing tool definitions to the\nprocess-scoped catalog cache. Cached definitions now expose the server\ninstructions to the model before a lazily started MCP connection finishes\ninitializing.\n\n## Testing\n\nUpdate the cached MCP startup integration test to verify that cached namespace\ndescriptions retain the originating server instructions.\n\nGitOrigin-RevId: d1b73381852fd43c6b54a7c22a599474c774dc20","tree":{"sha":"e9562870ef25e59ce59a5ddab027ee6bc69af774","url":"https://api.github.com/repos/openai/codex/git/trees/e9562870ef25e59ce59a5ddab027ee6bc69af774"},"url":"https://api.github.com/repos/openai/codex/git/commits/42b5f05cef69491bc578901fb324b3c9a278b253","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/42b5f05cef69491bc578901fb324b3c9a278b253","html_url":"https://github.com/openai/codex/commit/42b5f05cef69491bc578901fb324b3c9a278b253","comments_url":"https://api.github.com/repos/openai/codex/commits/42b5f05cef69491bc578901fb324b3c9a278b253/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"478215c5c184e4315e1f2f94cb825afcf96fcbc0","url":"https://api.github.com/repos/openai/codex/commits/478215c5c184e4315e1f2f94cb825afcf96fcbc0","html_url":"https://github.com/openai/codex/commit/478215c5c184e4315e1f2f94cb825afcf96fcbc0"}]},{"sha":"478215c5c184e4315e1f2f94cb825afcf96fcbc0","node_id":"C_kwDOOYsS4doAKDQ3ODIxNWM1YzE4NGU0MzE1ZTFmMmY5NGNiODI1YWZjZjk2ZmNiYzA","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-08-14T18:22:03Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T18:30:45Z"},"message":"Preserve large gRPC code-mode tool errors (#38621)\n\n## Why\n\nCode-mode tool failure messages larger than 64 KiB were truncated before they\nreached the host.\n\n## What changed\n\n- Remove the tool error size limit from the gRPC protocol and host validation.\n- Forward failed tool completion messages without truncation.\n\n## Testing\n\n- Verify that a multibyte error larger than 64 KiB is preserved exactly.\n\nGitOrigin-RevId: 264ae4ba4adea5c19b669e4f41ccfd41a0c30fb5","tree":{"sha":"75eff1c267209d2db9ce28d4e4d95f35d84e80fb","url":"https://api.github.com/repos/openai/codex/git/trees/75eff1c267209d2db9ce28d4e4d95f35d84e80fb"},"url":"https://api.github.com/repos/openai/codex/git/commits/478215c5c184e4315e1f2f94cb825afcf96fcbc0","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/478215c5c184e4315e1f2f94cb825afcf96fcbc0","html_url":"https://github.com/openai/codex/commit/478215c5c184e4315e1f2f94cb825afcf96fcbc0","comments_url":"https://api.github.com/repos/openai/codex/commits/478215c5c184e4315e1f2f94cb825afcf96fcbc0/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"395723b2385cf1314dcf27db4b01a221785109b0","url":"https://api.github.com/repos/openai/codex/commits/395723b2385cf1314dcf27db4b01a221785109b0","html_url":"https://github.com/openai/codex/commit/395723b2385cf1314dcf27db4b01a221785109b0"}]},{"sha":"395723b2385cf1314dcf27db4b01a221785109b0","node_id":"C_kwDOOYsS4doAKDM5NTcyM2IyMzg1Y2YxMzE0ZGNmMjdkYjRiMDFhMjIxNzg1MTA5YjA","commit":{"author":{"name":"rhan-oai","email":"rhan@openai.com","date":"2026-08-14T18:16:07Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T18:26:20Z"},"message":"Source multi-agent instructions from the model catalog (#38619)\n\n## What changed\n\n- Add model-catalog messages for root and subagent roles, explicit delegation, and delegation hints.\n- Resolve role instructions in config, catalog, then bundled-default order, while preserving empty values as an explicit way to suppress fallback text.\n- Refresh catalog-provided role and mode instructions when the model changes, and give full-history forks the selected child model's subagent role without retaining the parent's role guidance.\n- Keep existing config overrides and reasoning-effort behavior, including proactive delegation for ultra reasoning effort.\n\n## Testing\n\n- Cover message deserialization and preservation through model overrides.\n- Cover precedence, empty overrides, model switches, resumed sessions, and full-history subagent forks.\n\nGitOrigin-RevId: 4625cf7c6a5490176adddfaa0fb99100707daea9","tree":{"sha":"df36ac74215fca869767311d24dbd43f8db4ecb0","url":"https://api.github.com/repos/openai/codex/git/trees/df36ac74215fca869767311d24dbd43f8db4ecb0"},"url":"https://api.github.com/repos/openai/codex/git/commits/395723b2385cf1314dcf27db4b01a221785109b0","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/395723b2385cf1314dcf27db4b01a221785109b0","html_url":"https://github.com/openai/codex/commit/395723b2385cf1314dcf27db4b01a221785109b0","comments_url":"https://api.github.com/repos/openai/codex/commits/395723b2385cf1314dcf27db4b01a221785109b0/comments","author":{"login":"rhan-oai","id":214716640,"node_id":"U_kgDODMxQ4A","avatar_url":"https://avatars.githubusercontent.com/u/214716640?v=4","gravatar_id":"","url":"https://api.github.com/users/rhan-oai","html_url":"https://github.com/rhan-oai","followers_url":"https://api.github.com/users/rhan-oai/followers","following_url":"https://api.github.com/users/rhan-oai/following{/other_user}","gists_url":"https://api.github.com/users/rhan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rhan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rhan-oai/subscriptions","organizations_url":"https://api.github.com/users/rhan-oai/orgs","repos_url":"https://api.github.com/users/rhan-oai/repos","events_url":"https://api.github.com/users/rhan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rhan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"14a6813fa8223d40fa4ee2a222590a4bec7cf09d","url":"https://api.github.com/repos/openai/codex/commits/14a6813fa8223d40fa4ee2a222590a4bec7cf09d","html_url":"https://github.com/openai/codex/commit/14a6813fa8223d40fa4ee2a222590a4bec7cf09d"}]},{"sha":"14a6813fa8223d40fa4ee2a222590a4bec7cf09d","node_id":"C_kwDOOYsS4doAKDE0YTY4MTNmYTgyMjNkNDBmYTRlZTJhMjIyNTkwYTRiZWM3Y2YwOWQ","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-14T18:04:35Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T18:21:22Z"},"message":"Apply Guardian policies to v2 risk classification (#38618)\n\n## What changed\n\n- Include the resolved Guardian security policy in the v2 classifier's developer instructions.\n- Prefer an explicit `guardian_policy_config`, then the reviewer model's catalog policy, and finally the bundled policy.\n- Limit the combined classifier instructions and policy to 10,000 tokens.\n\n## Testing\n\n- Cover configured and catalog policies, policy truncation, and the bundled-policy fallback.\n\nGitOrigin-RevId: 1b84d70081dd924e214636b4b470d57a63d7cb88","tree":{"sha":"2cf1d50bef178b179b8ed510ff5031bdc81df6fa","url":"https://api.github.com/repos/openai/codex/git/trees/2cf1d50bef178b179b8ed510ff5031bdc81df6fa"},"url":"https://api.github.com/repos/openai/codex/git/commits/14a6813fa8223d40fa4ee2a222590a4bec7cf09d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/14a6813fa8223d40fa4ee2a222590a4bec7cf09d","html_url":"https://github.com/openai/codex/commit/14a6813fa8223d40fa4ee2a222590a4bec7cf09d","comments_url":"https://api.github.com/repos/openai/codex/commits/14a6813fa8223d40fa4ee2a222590a4bec7cf09d/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"086396f7f60347b74c82784d5dfaf4fb2d3bda12","url":"https://api.github.com/repos/openai/codex/commits/086396f7f60347b74c82784d5dfaf4fb2d3bda12","html_url":"https://github.com/openai/codex/commit/086396f7f60347b74c82784d5dfaf4fb2d3bda12"}]},{"sha":"086396f7f60347b74c82784d5dfaf4fb2d3bda12","node_id":"C_kwDOOYsS4doAKDA4NjM5NmY3ZjYwMzQ3Yjc0YzgyNzg0ZDVkZmFmNGZiMmQzYmRhMTI","commit":{"author":{"name":"Celia Chen","email":"celia@openai.com","date":"2026-08-14T17:56:30Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T18:01:06Z"},"message":"Prioritize global models in the Bedrock Runtime catalog (#38617)\n\n## What changed\n\nGroup Amazon Bedrock Runtime models by routing variant so every Global model\nappears before the US cross-region models, while preserving the base model order\nwithin each group. Update catalog priorities and tests to match the new order.\n\nGitOrigin-RevId: e5a55d61163404172a418cb794b25f3b27f83618","tree":{"sha":"2264fcd27b534b47d125956c6f8035b55b184011","url":"https://api.github.com/repos/openai/codex/git/trees/2264fcd27b534b47d125956c6f8035b55b184011"},"url":"https://api.github.com/repos/openai/codex/git/commits/086396f7f60347b74c82784d5dfaf4fb2d3bda12","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/086396f7f60347b74c82784d5dfaf4fb2d3bda12","html_url":"https://github.com/openai/codex/commit/086396f7f60347b74c82784d5dfaf4fb2d3bda12","comments_url":"https://api.github.com/repos/openai/codex/commits/086396f7f60347b74c82784d5dfaf4fb2d3bda12/comments","author":{"login":"celia-oai","id":209693228,"node_id":"U_kgDODH-qLA","avatar_url":"https://avatars.githubusercontent.com/u/209693228?v=4","gravatar_id":"","url":"https://api.github.com/users/celia-oai","html_url":"https://github.com/celia-oai","followers_url":"https://api.github.com/users/celia-oai/followers","following_url":"https://api.github.com/users/celia-oai/following{/other_user}","gists_url":"https://api.github.com/users/celia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/celia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celia-oai/subscriptions","organizations_url":"https://api.github.com/users/celia-oai/orgs","repos_url":"https://api.github.com/users/celia-oai/repos","events_url":"https://api.github.com/users/celia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/celia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fa595fbab80251310854366a9e57c1638e8377ba","url":"https://api.github.com/repos/openai/codex/commits/fa595fbab80251310854366a9e57c1638e8377ba","html_url":"https://github.com/openai/codex/commit/fa595fbab80251310854366a9e57c1638e8377ba"}]},{"sha":"fa595fbab80251310854366a9e57c1638e8377ba","node_id":"C_kwDOOYsS4doAKGZhNTk1ZmJhYjgwMjUxMzEwODU0MzY2YTllNTdjMTYzOGU4Mzc3YmE","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-14T17:50:20Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T17:56:38Z"},"message":"Route escalated approval retries through Guardian (#38616)\n\n## What changed\n\n- Bypass extension approval contributors when an approval request includes a retry reason, ensuring the retry is reviewed by Guardian.\n- Add coverage showing that Guardian can deny an escalated retry even when an extension contributor would approve it, and that the retry reason is included in the review request.\n\nGitOrigin-RevId: c8f556623f26fea605898d4b8e89679cebd63e65","tree":{"sha":"9ef167dccf5713ba3eddeddeeaed77406af6a453","url":"https://api.github.com/repos/openai/codex/git/trees/9ef167dccf5713ba3eddeddeeaed77406af6a453"},"url":"https://api.github.com/repos/openai/codex/git/commits/fa595fbab80251310854366a9e57c1638e8377ba","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fa595fbab80251310854366a9e57c1638e8377ba","html_url":"https://github.com/openai/codex/commit/fa595fbab80251310854366a9e57c1638e8377ba","comments_url":"https://api.github.com/repos/openai/codex/commits/fa595fbab80251310854366a9e57c1638e8377ba/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"0fce9332903d1d033ed71a488b81c44f90a7e47f","url":"https://api.github.com/repos/openai/codex/commits/0fce9332903d1d033ed71a488b81c44f90a7e47f","html_url":"https://github.com/openai/codex/commit/0fce9332903d1d033ed71a488b81c44f90a7e47f"}]},{"sha":"0fce9332903d1d033ed71a488b81c44f90a7e47f","node_id":"C_kwDOOYsS4doAKDBmY2U5MzMyOTAzZDFkMDMzZWQ3MWE0ODhiODFjNDRmOTBhN2U0N2Y","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-08-14T17:33:02Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T17:50:01Z"},"message":"Remove the gRPC code-mode enabled tool limit (#38615)\n\n## What changed\n\nStop rejecting code-mode execute requests solely because `enabled_tools`\ncontains more than 1,024 definitions. Continue validating each tool definition\nwhile converting the request.\n\nGitOrigin-RevId: da83b61c5f659e6aa221ed663821edcdfc29d3f1","tree":{"sha":"452f0346d2c1b4ca462107a94f49ae928c76ac90","url":"https://api.github.com/repos/openai/codex/git/trees/452f0346d2c1b4ca462107a94f49ae928c76ac90"},"url":"https://api.github.com/repos/openai/codex/git/commits/0fce9332903d1d033ed71a488b81c44f90a7e47f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/0fce9332903d1d033ed71a488b81c44f90a7e47f","html_url":"https://github.com/openai/codex/commit/0fce9332903d1d033ed71a488b81c44f90a7e47f","comments_url":"https://api.github.com/repos/openai/codex/commits/0fce9332903d1d033ed71a488b81c44f90a7e47f/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"f535950eaabebd5654a958fa8775202d08b078f5","url":"https://api.github.com/repos/openai/codex/commits/f535950eaabebd5654a958fa8775202d08b078f5","html_url":"https://github.com/openai/codex/commit/f535950eaabebd5654a958fa8775202d08b078f5"}]},{"sha":"f535950eaabebd5654a958fa8775202d08b078f5","node_id":"C_kwDOOYsS4doAKGY1MzU5NTBlYWFiZWJkNTY1NGE5NThmYTg3NzUyMDJkMDhiMDc4ZjU","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-14T17:29:43Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T17:41:34Z"},"message":"Skip stale Guardian risk score persistence (#38612)\n\n## Why\n\nConcurrent Guardian samples can finish out of order. A stale result rejected by\nthe thread's latest-score update could still be appended to the rollout.\n\n## What changed\n\nReturn without persisting a risk score when `insert_if` rejects it as older than\nthe score already stored on the thread.\n\nGitOrigin-RevId: 7b2c895742753a19dfe48fd7f8ecd912d3cd3af6","tree":{"sha":"05038f42c8b4bb49f505663fb216532239c9e58e","url":"https://api.github.com/repos/openai/codex/git/trees/05038f42c8b4bb49f505663fb216532239c9e58e"},"url":"https://api.github.com/repos/openai/codex/git/commits/f535950eaabebd5654a958fa8775202d08b078f5","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/f535950eaabebd5654a958fa8775202d08b078f5","html_url":"https://github.com/openai/codex/commit/f535950eaabebd5654a958fa8775202d08b078f5","comments_url":"https://api.github.com/repos/openai/codex/commits/f535950eaabebd5654a958fa8775202d08b078f5/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fb5aa093e0657c940e8ffd1dd055d22b92d67dfc","url":"https://api.github.com/repos/openai/codex/commits/fb5aa093e0657c940e8ffd1dd055d22b92d67dfc","html_url":"https://github.com/openai/codex/commit/fb5aa093e0657c940e8ffd1dd055d22b92d67dfc"}]},{"sha":"fb5aa093e0657c940e8ffd1dd055d22b92d67dfc","node_id":"C_kwDOOYsS4doAKGZiNWFhMDkzZTA2NTdjOTQwZThmZmQxZGQwNTVkMjJiOTJkNjdkZmM","commit":{"author":{"name":"cooper-oai","email":"cooper@openai.com","date":"2026-08-14T17:22:54Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T17:32:37Z"},"message":"Support workload identity in remote exec-server auth (#38610)\n\n## Why\n\nRemote exec-server registry requests need to refresh managed credentials before sending a request. Static auth-header resolution cannot perform the asynchronous token exchange required by workload identity.\n\n## What changed\n\n- Add asynchronous auth-header resolution to `AuthProvider`, with the existing static-header behavior as the default.\n- Resolve fresh managed credentials for each remote environment registry request while preserving the expected account and workspace identity.\n- Load the cloud configuration bundle during remote exec-server startup when workload identity is selected.\n\n## Testing\n\n- Update the managed-auth and environment-registry auth tests to exercise asynchronous header resolution.\n\nGitOrigin-RevId: 5d60f1127467aaacdb5d1a8f3d92278bc4bf2e29","tree":{"sha":"f9b06da74cd13c981bf631f65095b83934dc6fb1","url":"https://api.github.com/repos/openai/codex/git/trees/f9b06da74cd13c981bf631f65095b83934dc6fb1"},"url":"https://api.github.com/repos/openai/codex/git/commits/fb5aa093e0657c940e8ffd1dd055d22b92d67dfc","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fb5aa093e0657c940e8ffd1dd055d22b92d67dfc","html_url":"https://github.com/openai/codex/commit/fb5aa093e0657c940e8ffd1dd055d22b92d67dfc","comments_url":"https://api.github.com/repos/openai/codex/commits/fb5aa093e0657c940e8ffd1dd055d22b92d67dfc/comments","author":{"login":"cooper-oai","id":242064477,"node_id":"U_kgDODm2cXQ","avatar_url":"https://avatars.githubusercontent.com/u/242064477?v=4","gravatar_id":"","url":"https://api.github.com/users/cooper-oai","html_url":"https://github.com/cooper-oai","followers_url":"https://api.github.com/users/cooper-oai/followers","following_url":"https://api.github.com/users/cooper-oai/following{/other_user}","gists_url":"https://api.github.com/users/cooper-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/cooper-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cooper-oai/subscriptions","organizations_url":"https://api.github.com/users/cooper-oai/orgs","repos_url":"https://api.github.com/users/cooper-oai/repos","events_url":"https://api.github.com/users/cooper-oai/events{/privacy}","received_events_url":"https://api.github.com/users/cooper-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c0d59bf6147c83d067e257e858b928f81820ab50","url":"https://api.github.com/repos/openai/codex/commits/c0d59bf6147c83d067e257e858b928f81820ab50","html_url":"https://github.com/openai/codex/commit/c0d59bf6147c83d067e257e858b928f81820ab50"}]},{"sha":"c0d59bf6147c83d067e257e858b928f81820ab50","node_id":"C_kwDOOYsS4doAKGMwZDU5YmY2MTQ3YzgzZDA2N2UyNTdlODU4YjkyOGY4MTgyMGFiNTA","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-14T17:13:02Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T17:18:26Z"},"message":"Fix the missing resume picker history mode import (#38608)\n\nImport `ThreadHistoryMode` where the resume picker uses it for session\nselection state and history mode tracking.\n\nGitOrigin-RevId: ae8b30ad959c872d35eb2a38d514e67ecf1275f1","tree":{"sha":"2c86d87d8f82a74d55465e59860e345ed79d160c","url":"https://api.github.com/repos/openai/codex/git/trees/2c86d87d8f82a74d55465e59860e345ed79d160c"},"url":"https://api.github.com/repos/openai/codex/git/commits/c0d59bf6147c83d067e257e858b928f81820ab50","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c0d59bf6147c83d067e257e858b928f81820ab50","html_url":"https://github.com/openai/codex/commit/c0d59bf6147c83d067e257e858b928f81820ab50","comments_url":"https://api.github.com/repos/openai/codex/commits/c0d59bf6147c83d067e257e858b928f81820ab50/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a3cb1c14fbef105029b99f28951ee240ea4cadff","url":"https://api.github.com/repos/openai/codex/commits/a3cb1c14fbef105029b99f28951ee240ea4cadff","html_url":"https://github.com/openai/codex/commit/a3cb1c14fbef105029b99f28951ee240ea4cadff"}]},{"sha":"a3cb1c14fbef105029b99f28951ee240ea4cadff","node_id":"C_kwDOOYsS4doAKGEzY2IxYzE0ZmJlZjEwNTAyOWI5OWYyODk1MWVlMjQwZWE0Y2FkZmY","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-08-14T16:33:20Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T16:42:32Z"},"message":"Allow larger gRPC code mode tool descriptions (#38606)\n\n## What changed\n\nStop rejecting gRPC execute requests when an enabled tool's description exceeds\n16 KiB. Identifier, tool-count, and subscription-filter limits remain in place.\n\nGitOrigin-RevId: c30dbf555e691b02bd6d6a835a0c40f671b0d172","tree":{"sha":"ed269a1947801811c5534087034d300f9d660dcc","url":"https://api.github.com/repos/openai/codex/git/trees/ed269a1947801811c5534087034d300f9d660dcc"},"url":"https://api.github.com/repos/openai/codex/git/commits/a3cb1c14fbef105029b99f28951ee240ea4cadff","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a3cb1c14fbef105029b99f28951ee240ea4cadff","html_url":"https://github.com/openai/codex/commit/a3cb1c14fbef105029b99f28951ee240ea4cadff","comments_url":"https://api.github.com/repos/openai/codex/commits/a3cb1c14fbef105029b99f28951ee240ea4cadff/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"3b3a91ccf0cb09fc8f713385d6eaae98e8919162","url":"https://api.github.com/repos/openai/codex/commits/3b3a91ccf0cb09fc8f713385d6eaae98e8919162","html_url":"https://github.com/openai/codex/commit/3b3a91ccf0cb09fc8f713385d6eaae98e8919162"}]},{"sha":"3b3a91ccf0cb09fc8f713385d6eaae98e8919162","node_id":"C_kwDOOYsS4doAKDNiM2E5MWNjZjBjYjA5ZmM4ZjcxMzM4NWQ2ZWFhZTk4ZTg5MTkxNjI","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-14T16:25:12Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T16:37:40Z"},"message":"Fix resume transcript preview line selection (#38605)\n\n## What changed\n\n- Scan legacy and paginated transcript items newest-first and stop after collecting the six newest nonblank preview lines.\n- Keep paging through bounded paginated history when newer items do not produce visible preview text, while preserving chronological display order and assistant markdown rewrites.\n- Move transcript preview loading into a focused module and add coverage for reverse scanning, legacy/paginated parity, and paging past invisible items.\n\nGitOrigin-RevId: 576afe37d034b32db363691bd4f401815fffaea7","tree":{"sha":"c14f26acf139125004cc71eba2391be5d167d9d6","url":"https://api.github.com/repos/openai/codex/git/trees/c14f26acf139125004cc71eba2391be5d167d9d6"},"url":"https://api.github.com/repos/openai/codex/git/commits/3b3a91ccf0cb09fc8f713385d6eaae98e8919162","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/3b3a91ccf0cb09fc8f713385d6eaae98e8919162","html_url":"https://github.com/openai/codex/commit/3b3a91ccf0cb09fc8f713385d6eaae98e8919162","comments_url":"https://api.github.com/repos/openai/codex/commits/3b3a91ccf0cb09fc8f713385d6eaae98e8919162/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"1bb6384c1971579c74194a3cc832847480de470d","url":"https://api.github.com/repos/openai/codex/commits/1bb6384c1971579c74194a3cc832847480de470d","html_url":"https://github.com/openai/codex/commit/1bb6384c1971579c74194a3cc832847480de470d"}]},{"sha":"1bb6384c1971579c74194a3cc832847480de470d","node_id":"C_kwDOOYsS4doAKDFiYjYzODRjMTk3MTU3OWM3NDE5NGEzY2M4MzI4NDc0ODBkZTQ3MGQ","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-14T16:22:38Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T16:33:28Z"},"message":"Avoid paginated resume requests for verified legacy rollouts (#38604)\n\n## Why\n\nResuming a known legacy rollout with `excludeTurns` first requires the TUI to\nretry after the app server rejects paginated history loading.\n\n## What changed\n\n- Carry the history mode reported by the session picker into the resume flow.\n- For embedded app-server sessions, resume a legacy rollout with its turns when\n  the rollout is still legacy and background migration cannot race the check.\n- Keep requesting paginated history when the picker metadata may be stale,\n  migration is enabled or active, or the app server is remote.\n\n## Testing\n\nAdded coverage for picker server replacement, background migration, maintenance\nlock contention, stale history metadata, and paginated resume requests.\n\nGitOrigin-RevId: 2300d1ad93a817eeeeb8f8ed60b073400ddf7106","tree":{"sha":"a430b114f52b1168fd64a3e30ea8bf084b4c6a09","url":"https://api.github.com/repos/openai/codex/git/trees/a430b114f52b1168fd64a3e30ea8bf084b4c6a09"},"url":"https://api.github.com/repos/openai/codex/git/commits/1bb6384c1971579c74194a3cc832847480de470d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/1bb6384c1971579c74194a3cc832847480de470d","html_url":"https://github.com/openai/codex/commit/1bb6384c1971579c74194a3cc832847480de470d","comments_url":"https://api.github.com/repos/openai/codex/commits/1bb6384c1971579c74194a3cc832847480de470d/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"588ee893241de551836bfd97e4964c22f601882b","url":"https://api.github.com/repos/openai/codex/commits/588ee893241de551836bfd97e4964c22f601882b","html_url":"https://github.com/openai/codex/commit/588ee893241de551836bfd97e4964c22f601882b"}]},{"sha":"588ee893241de551836bfd97e4964c22f601882b","node_id":"C_kwDOOYsS4doAKDU4OGVlODkzMjQxZGU1NTE4MzZiZmQ5N2U0OTY0YzIyZjYwMTg4MmI","commit":{"author":{"name":"Dylan Hurd","email":"dylan.hurd@openai.com","date":"2026-08-14T16:18:37Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T16:28:42Z"},"message":"Isolate Guardian reviewer sessions from parent extensions (#38602)\n\n## What changed\n\n- Start Guardian reviewer delegates with an empty extension registry while preserving extension inheritance for other delegates.\n- Disable `GuardianV2` in the reviewer session configuration so reviews do not trigger nested Guardian processing.\n- Cover both the reviewer isolation and continued delivery of parent-session tool lifecycle events.\n\nGitOrigin-RevId: 858b3e23d1c06177e443fb0779fcf06cc5294fc2","tree":{"sha":"6d7757371571b84f64accb5110a1782aa7c1bc0f","url":"https://api.github.com/repos/openai/codex/git/trees/6d7757371571b84f64accb5110a1782aa7c1bc0f"},"url":"https://api.github.com/repos/openai/codex/git/commits/588ee893241de551836bfd97e4964c22f601882b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/588ee893241de551836bfd97e4964c22f601882b","html_url":"https://github.com/openai/codex/commit/588ee893241de551836bfd97e4964c22f601882b","comments_url":"https://api.github.com/repos/openai/codex/commits/588ee893241de551836bfd97e4964c22f601882b/comments","author":{"login":"dylan-hurd-oai","id":220976066,"node_id":"U_kgDODSvTwg","avatar_url":"https://avatars.githubusercontent.com/u/220976066?v=4","gravatar_id":"","url":"https://api.github.com/users/dylan-hurd-oai","html_url":"https://github.com/dylan-hurd-oai","followers_url":"https://api.github.com/users/dylan-hurd-oai/followers","following_url":"https://api.github.com/users/dylan-hurd-oai/following{/other_user}","gists_url":"https://api.github.com/users/dylan-hurd-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/dylan-hurd-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dylan-hurd-oai/subscriptions","organizations_url":"https://api.github.com/users/dylan-hurd-oai/orgs","repos_url":"https://api.github.com/users/dylan-hurd-oai/repos","events_url":"https://api.github.com/users/dylan-hurd-oai/events{/privacy}","received_events_url":"https://api.github.com/users/dylan-hurd-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"da898490fcc7e75661c367f6a441798a0ce0eb95","url":"https://api.github.com/repos/openai/codex/commits/da898490fcc7e75661c367f6a441798a0ce0eb95","html_url":"https://github.com/openai/codex/commit/da898490fcc7e75661c367f6a441798a0ce0eb95"}]},{"sha":"da898490fcc7e75661c367f6a441798a0ce0eb95","node_id":"C_kwDOOYsS4doAKGRhODk4NDkwZmNjN2U3NTY2MWMzNjdmNmE0NDE3OThhMGNlMGViOTU","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-08-14T16:18:21Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T16:23:17Z"},"message":"Make unbounded connection retries configurable (#38601)\n\n## What changed\n\n- Add the stable, default-enabled `unbounded_connection_retries` feature.\n- Require the feature for unbounded sampling retries after connection failures.\n  When disabled, connection failures use the existing bounded retry and\n  transport fallback path.\n- Expose the feature in the generated configuration schema.\n\nGitOrigin-RevId: bd80d02ef065ba924f805c29b639752fc817ed64","tree":{"sha":"8775dd0228b03b69069e4386a12923ec9e5f1327","url":"https://api.github.com/repos/openai/codex/git/trees/8775dd0228b03b69069e4386a12923ec9e5f1327"},"url":"https://api.github.com/repos/openai/codex/git/commits/da898490fcc7e75661c367f6a441798a0ce0eb95","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/da898490fcc7e75661c367f6a441798a0ce0eb95","html_url":"https://github.com/openai/codex/commit/da898490fcc7e75661c367f6a441798a0ce0eb95","comments_url":"https://api.github.com/repos/openai/codex/commits/da898490fcc7e75661c367f6a441798a0ce0eb95/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"3360f4a909a920d2e534a63c508d98e91fe6655a","url":"https://api.github.com/repos/openai/codex/commits/3360f4a909a920d2e534a63c508d98e91fe6655a","html_url":"https://github.com/openai/codex/commit/3360f4a909a920d2e534a63c508d98e91fe6655a"}]},{"sha":"3360f4a909a920d2e534a63c508d98e91fe6655a","node_id":"C_kwDOOYsS4doAKDMzNjBmNGE5MDlhOTIwZDJlNTM0YTYzYzUwOGQ5OGU5MWZlNjY1NWE","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-14T15:53:13Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T15:59:34Z"},"message":"Install Guardian V2 in the app server (#38597)\n\n## What changed\n\n- Add `codex-guardian-v2` to the app server's dependencies.\n- Install its feature-gated thread, approval-review, and tool lifecycle contributors with access to authentication and thread management.\n\nGitOrigin-RevId: 25672032ccb541138c8c87c9f27f2a7423b2eee0","tree":{"sha":"f540220bba8b02c22cf4e8cdc104bf14e6a9f579","url":"https://api.github.com/repos/openai/codex/git/trees/f540220bba8b02c22cf4e8cdc104bf14e6a9f579"},"url":"https://api.github.com/repos/openai/codex/git/commits/3360f4a909a920d2e534a63c508d98e91fe6655a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/3360f4a909a920d2e534a63c508d98e91fe6655a","html_url":"https://github.com/openai/codex/commit/3360f4a909a920d2e534a63c508d98e91fe6655a","comments_url":"https://api.github.com/repos/openai/codex/commits/3360f4a909a920d2e534a63c508d98e91fe6655a/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"742edd6c16939185b424beb68c8eb46878b323a3","url":"https://api.github.com/repos/openai/codex/commits/742edd6c16939185b424beb68c8eb46878b323a3","html_url":"https://github.com/openai/codex/commit/742edd6c16939185b424beb68c8eb46878b323a3"}]},{"sha":"742edd6c16939185b424beb68c8eb46878b323a3","node_id":"C_kwDOOYsS4doAKDc0MmVkZDZjMTY5MzkxODViNDI0YmViNjhjOGViNDY4NzhiMzIzYTM","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-14T15:49:42Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T15:55:01Z"},"message":"Prioritize new Guardian classifications under load (#38596)\n\n## What changed\n\n- Expand the Guardian sampling pool from 8 to 16 WebSocket connections.\n- When the pool is full, supersede the oldest request that has already produced a score before replacing an unfinished classification. Treat superseded classifications as a no-op in the extension.\n- Stop response WebSocket work when its event consumer is dropped, including while waiting for the connection lock or draining a completed sample.\n- Allow retries across both initially warmed connections for retryable stream failures.\n\n## Testing\n\n- Add a concurrent sampler test that fills the pool and verifies scored drains are replaced before an unfinished classification.\n\nGitOrigin-RevId: 9e4df7b01516094726ff3e11878f8ca742d21b03","tree":{"sha":"4d0b3e1a753aa919b7d6699ce96edcd64bfb260c","url":"https://api.github.com/repos/openai/codex/git/trees/4d0b3e1a753aa919b7d6699ce96edcd64bfb260c"},"url":"https://api.github.com/repos/openai/codex/git/commits/742edd6c16939185b424beb68c8eb46878b323a3","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/742edd6c16939185b424beb68c8eb46878b323a3","html_url":"https://github.com/openai/codex/commit/742edd6c16939185b424beb68c8eb46878b323a3","comments_url":"https://api.github.com/repos/openai/codex/commits/742edd6c16939185b424beb68c8eb46878b323a3/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"23094236acac6fdc22f67a408ea8ccb8fac8e6e1","url":"https://api.github.com/repos/openai/codex/commits/23094236acac6fdc22f67a408ea8ccb8fac8e6e1","html_url":"https://github.com/openai/codex/commit/23094236acac6fdc22f67a408ea8ccb8fac8e6e1"}]},{"sha":"23094236acac6fdc22f67a408ea8ccb8fac8e6e1","node_id":"C_kwDOOYsS4doAKDIzMDk0MjM2YWNhYzZmZGMyMmY2N2E0MDhlYThjY2I4ZmFjOGU2ZTE","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-14T15:19:06Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T15:24:10Z"},"message":"Let extensions resolve approval reviews before Guardian (#38592)\n\n## What changed\n\n- Give approval review contributors the first opportunity to resolve an action when automatic review is not required for the model.\n- Return an extension's decision directly and fall back to Guardian when no extension claims the review.\n- Update Guardian V2 to approve actions below its risk threshold through the review contributor API, and remove the extension approval-policy API.\n\n## Testing\n\n- Verify that an extension approval bypasses both the Guardian model call and the user approval prompt.\n- Cover Guardian V2 review decisions for low-risk, high-risk, and disabled threads.\n\nGitOrigin-RevId: 5be56941143aff6f358b75b5f8101b7c047147ae","tree":{"sha":"e3071679af4052f07c193018f01db04d5ca6ad46","url":"https://api.github.com/repos/openai/codex/git/trees/e3071679af4052f07c193018f01db04d5ca6ad46"},"url":"https://api.github.com/repos/openai/codex/git/commits/23094236acac6fdc22f67a408ea8ccb8fac8e6e1","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/23094236acac6fdc22f67a408ea8ccb8fac8e6e1","html_url":"https://github.com/openai/codex/commit/23094236acac6fdc22f67a408ea8ccb8fac8e6e1","comments_url":"https://api.github.com/repos/openai/codex/commits/23094236acac6fdc22f67a408ea8ccb8fac8e6e1/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"5bc8da6d78fe32343dc51eaf73b96fd288ae0e87","url":"https://api.github.com/repos/openai/codex/commits/5bc8da6d78fe32343dc51eaf73b96fd288ae0e87","html_url":"https://github.com/openai/codex/commit/5bc8da6d78fe32343dc51eaf73b96fd288ae0e87"}]},{"sha":"5bc8da6d78fe32343dc51eaf73b96fd288ae0e87","node_id":"C_kwDOOYsS4doAKDViYzhkYTZkNzhmZTMyMzQzZGM1MWVhZjczYjk2ZmQyODhhZTBlODc","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-14T14:28:32Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T14:33:39Z"},"message":"Bound Guardian V2 tool actions before risk classification (#38586)\n\n## Why\n\nOversized tool arguments could make Guardian V2's model-visible action unbounded.\n\n## What changed\n\n- Cap serialized actions at 10,000 tokens while preserving the trusted tool name and `call_id`.\n- Truncate nested string values evenly across the available budget.\n- Omit lower-priority fields when the JSON structure alone exceeds the limit, while retaining useful action fields when they fit.\n\n## Testing\n\nAdd coverage for oversized nested strings, arrays, and object keys, including spoofed identity fields and omission-marker collisions.\n\nGitOrigin-RevId: 13f7dc93da3761db18a34087225196318a3b8098","tree":{"sha":"fe57236b13c86140567dc8a35a0de79dc4e989be","url":"https://api.github.com/repos/openai/codex/git/trees/fe57236b13c86140567dc8a35a0de79dc4e989be"},"url":"https://api.github.com/repos/openai/codex/git/commits/5bc8da6d78fe32343dc51eaf73b96fd288ae0e87","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/5bc8da6d78fe32343dc51eaf73b96fd288ae0e87","html_url":"https://github.com/openai/codex/commit/5bc8da6d78fe32343dc51eaf73b96fd288ae0e87","comments_url":"https://api.github.com/repos/openai/codex/commits/5bc8da6d78fe32343dc51eaf73b96fd288ae0e87/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"7c194ff24b3aa0e3beaf03b526db2d0b4f708794","url":"https://api.github.com/repos/openai/codex/commits/7c194ff24b3aa0e3beaf03b526db2d0b4f708794","html_url":"https://github.com/openai/codex/commit/7c194ff24b3aa0e3beaf03b526db2d0b4f708794"}]},{"sha":"7c194ff24b3aa0e3beaf03b526db2d0b4f708794","node_id":"C_kwDOOYsS4doAKDdjMTk0ZmYyNGIzYWEwZTNiZWFmMDNiNTI2ZGIyZDBiNGY3MDg3OTQ","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-14T13:45:21Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T13:50:10Z"},"message":"Honor cloud-managed requirements in feature listings (#38581)\n\n## What changed\n\n- Load configuration for `codex features list` through the shared cloud-aware\n  loader so managed feature requirements are reflected in the reported state.\n- Reuse that loader for MCP commands.\n\n## Testing\n\n- Add an integration test showing that a cloud-managed requirement can disable\n  `fast_mode` in `codex features list` without rewriting the user's\n  `config.toml`.\n\nGitOrigin-RevId: 2bdbc76dfa40ceb29e8293556f4b56cabbd2c43f","tree":{"sha":"82ca4b7b31f304b17bd50dece1393c1a0dcd3cc2","url":"https://api.github.com/repos/openai/codex/git/trees/82ca4b7b31f304b17bd50dece1393c1a0dcd3cc2"},"url":"https://api.github.com/repos/openai/codex/git/commits/7c194ff24b3aa0e3beaf03b526db2d0b4f708794","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/7c194ff24b3aa0e3beaf03b526db2d0b4f708794","html_url":"https://github.com/openai/codex/commit/7c194ff24b3aa0e3beaf03b526db2d0b4f708794","comments_url":"https://api.github.com/repos/openai/codex/commits/7c194ff24b3aa0e3beaf03b526db2d0b4f708794/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"2a452d7dc1f97e22e126fc3a111237a3e828de0c","url":"https://api.github.com/repos/openai/codex/commits/2a452d7dc1f97e22e126fc3a111237a3e828de0c","html_url":"https://github.com/openai/codex/commit/2a452d7dc1f97e22e126fc3a111237a3e828de0c"}]},{"sha":"2a452d7dc1f97e22e126fc3a111237a3e828de0c","node_id":"C_kwDOOYsS4doAKDJhNDUyZDdkYzFmOTdlMjJlMTI2ZmMzYTExMTIzN2EzZTgyOGRlMGM","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-14T13:37:54Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T13:44:51Z"},"message":"Keep the latest Guardian risk score during concurrent sampling (#38580)\n\n## Why\n\nConcurrent Guardian samples can finish out of order, allowing an older sample to\nreplace the thread's newer in-memory security risk score.\n\n## What changed\n\n- Record when each `SecurityRiskScore` sample starts while preserving compatibility\n  with records that have no timestamp.\n- Add `ExtensionData::insert_if` so checking and replacing a typed attachment happen\n  under the same lock.\n- Update Guardian V2 to replace the thread's risk score only when the completed sample\n  is newer than the stored one.\n\n## Testing\n\n- Verify concurrent conditional inserts retain the newest value.\n- Verify Guardian-generated risk scores include a sampling timestamp.\n\nGitOrigin-RevId: 6543a4e5497da4c623331050789e91613f931c4b","tree":{"sha":"40cce76d1cae03eb974a2b3bd1ad56879929d6e0","url":"https://api.github.com/repos/openai/codex/git/trees/40cce76d1cae03eb974a2b3bd1ad56879929d6e0"},"url":"https://api.github.com/repos/openai/codex/git/commits/2a452d7dc1f97e22e126fc3a111237a3e828de0c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/2a452d7dc1f97e22e126fc3a111237a3e828de0c","html_url":"https://github.com/openai/codex/commit/2a452d7dc1f97e22e126fc3a111237a3e828de0c","comments_url":"https://api.github.com/repos/openai/codex/commits/2a452d7dc1f97e22e126fc3a111237a3e828de0c/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"42d842a91a9d77efbf7a164fc0dcd42637958031","url":"https://api.github.com/repos/openai/codex/commits/42d842a91a9d77efbf7a164fc0dcd42637958031","html_url":"https://github.com/openai/codex/commit/42d842a91a9d77efbf7a164fc0dcd42637958031"}]},{"sha":"42d842a91a9d77efbf7a164fc0dcd42637958031","node_id":"C_kwDOOYsS4doAKDQyZDg0MmE5MWE5ZDc3ZWZiZjdhMTY0ZmMwZGNkNDI2Mzc5NTgwMzE","commit":{"author":{"name":"Owen Lin","email":"owen@openai.com","date":"2026-08-14T13:35:18Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T13:40:35Z"},"message":"Report thread storage changes after rollout migration (#38579)\n\n## What changed\n\nMeasure thread storage before and after `codex migrate-rollouts --apply` and\ninclude the formatted sizes in the human-readable migration report. The total\nincludes active and archived rollout files, the thread history database, and\nits WAL and shared-memory sidecars.\n\nKeep dry-run and JSON output unchanged, and omit the storage summary if either\nmeasurement fails.\n\nGitOrigin-RevId: 1775c0b6849570a814becd94e196dd05908667a1","tree":{"sha":"179f4f9fdbbc7727673ee48f641cdd1906b9241a","url":"https://api.github.com/repos/openai/codex/git/trees/179f4f9fdbbc7727673ee48f641cdd1906b9241a"},"url":"https://api.github.com/repos/openai/codex/git/commits/42d842a91a9d77efbf7a164fc0dcd42637958031","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/42d842a91a9d77efbf7a164fc0dcd42637958031","html_url":"https://github.com/openai/codex/commit/42d842a91a9d77efbf7a164fc0dcd42637958031","comments_url":"https://api.github.com/repos/openai/codex/commits/42d842a91a9d77efbf7a164fc0dcd42637958031/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"1c4f42863c1f84eb5175a1a0cfffe84641a63df3","url":"https://api.github.com/repos/openai/codex/commits/1c4f42863c1f84eb5175a1a0cfffe84641a63df3","html_url":"https://github.com/openai/codex/commit/1c4f42863c1f84eb5175a1a0cfffe84641a63df3"}]},{"sha":"1c4f42863c1f84eb5175a1a0cfffe84641a63df3","node_id":"C_kwDOOYsS4doAKDFjNGY0Mjg2M2MxZjg0ZWI1MTc1YTFhMGNmZmZlODQ2NDFhNjNkZjM","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-14T12:30:42Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T12:37:13Z"},"message":"Require automatic review for high-risk Guardian v2 actions (#38569)\n\n## What changed\n\n- Add a thread-scoped extension API for requesting automatic review, resolving\n  multiple contributors to the strongest requirement.\n- Have Guardian v2 request automatic review when it is enabled and the latest\n  `action_risk` score is at least `0.8`.\n- Honor extension review requirements across tool approvals, MCP elicitation,\n  and remote execution while preserving host configuration and managed-policy\n  constraints.\n\n## Testing\n\n- Cover contributor registration and requirement resolution.\n- Verify Guardian v2 requests review at the threshold, returns to the default\n  below it, and does not affect threads where the extension is disabled.\n- Exercise extension-requested strict review with a remote model override.\n\nGitOrigin-RevId: 6329fc23585d5cc7173c39bb9952c3109ec3884b","tree":{"sha":"2619e3ec94aa9ab12ebc0cac8fff4cb4e720d51e","url":"https://api.github.com/repos/openai/codex/git/trees/2619e3ec94aa9ab12ebc0cac8fff4cb4e720d51e"},"url":"https://api.github.com/repos/openai/codex/git/commits/1c4f42863c1f84eb5175a1a0cfffe84641a63df3","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/1c4f42863c1f84eb5175a1a0cfffe84641a63df3","html_url":"https://github.com/openai/codex/commit/1c4f42863c1f84eb5175a1a0cfffe84641a63df3","comments_url":"https://api.github.com/repos/openai/codex/commits/1c4f42863c1f84eb5175a1a0cfffe84641a63df3/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"d40dfcc3c727a97315bb34a43165c037b422282c","url":"https://api.github.com/repos/openai/codex/commits/d40dfcc3c727a97315bb34a43165c037b422282c","html_url":"https://github.com/openai/codex/commit/d40dfcc3c727a97315bb34a43165c037b422282c"}]},{"sha":"d40dfcc3c727a97315bb34a43165c037b422282c","node_id":"C_kwDOOYsS4doAKGQ0MGRmY2MzYzcyN2E5NzMxNWJiMzRhNDMxNjVjMDM3YjQyMjI4MmM","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-14T12:14:56Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T12:21:08Z"},"message":"Run tool start callbacks after pre-tool hooks (#38568)\n\n## What changed\n\n- Invoke `ToolLifecycleContributor::on_tool_start` only after pre-tool hooks\n  have finalized the invocation.\n- Pass hook-rewritten arguments and the post-hook conversation snapshot to the\n  callback.\n- Skip the start callback when a hook denies execution or supplies input that\n  cannot be applied.\n\n## Testing\n\nAdd lifecycle tests covering rewritten input, hook-added context, denied tool\ncalls, and invalid rewritten input.\n\nGitOrigin-RevId: 936efaf4a8c35321f9982ff2a33bb8bece1ebf39","tree":{"sha":"5a58da8cbe9fafcd5b9056391c2a2687bc565688","url":"https://api.github.com/repos/openai/codex/git/trees/5a58da8cbe9fafcd5b9056391c2a2687bc565688"},"url":"https://api.github.com/repos/openai/codex/git/commits/d40dfcc3c727a97315bb34a43165c037b422282c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/d40dfcc3c727a97315bb34a43165c037b422282c","html_url":"https://github.com/openai/codex/commit/d40dfcc3c727a97315bb34a43165c037b422282c","comments_url":"https://api.github.com/repos/openai/codex/commits/d40dfcc3c727a97315bb34a43165c037b422282c/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"aa905bb9625d777a2f64b20408e5ddedbf173395","url":"https://api.github.com/repos/openai/codex/commits/aa905bb9625d777a2f64b20408e5ddedbf173395","html_url":"https://github.com/openai/codex/commit/aa905bb9625d777a2f64b20408e5ddedbf173395"}]},{"sha":"aa905bb9625d777a2f64b20408e5ddedbf173395","node_id":"C_kwDOOYsS4doAKGFhOTA1YmI5NjI1ZDc3N2EyZjY0YjIwNDA4ZTVkZGVkYmYxNzMzOTU","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-14T12:11:52Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T12:16:51Z"},"message":"Store security risk scores as a snapshot (#38567)\n\n## What changed\n\n- Replace the single `category` and `score` fields in `SecurityRiskScore` with a\n  deterministic map of category names to scores.\n- Validate the full Guardian V2 classifier response before storing it as one\n  thread extension value and, for non-ephemeral threads, one rollout item.\n- Cover serialization and rollout loading with snapshots containing multiple\n  score categories.\n\nGitOrigin-RevId: 24525de691f96bd34ccfe04acab2f01aca309837","tree":{"sha":"4a75f0e43793a4fb4b201e960722d0b2bfcd5121","url":"https://api.github.com/repos/openai/codex/git/trees/4a75f0e43793a4fb4b201e960722d0b2bfcd5121"},"url":"https://api.github.com/repos/openai/codex/git/commits/aa905bb9625d777a2f64b20408e5ddedbf173395","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/aa905bb9625d777a2f64b20408e5ddedbf173395","html_url":"https://github.com/openai/codex/commit/aa905bb9625d777a2f64b20408e5ddedbf173395","comments_url":"https://api.github.com/repos/openai/codex/commits/aa905bb9625d777a2f64b20408e5ddedbf173395/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"08c48e37007683d366f648d4c40ec17ba5009e98","url":"https://api.github.com/repos/openai/codex/commits/08c48e37007683d366f648d4c40ec17ba5009e98","html_url":"https://github.com/openai/codex/commit/08c48e37007683d366f648d4c40ec17ba5009e98"}]},{"sha":"08c48e37007683d366f648d4c40ec17ba5009e98","node_id":"C_kwDOOYsS4doAKDA4YzQ4ZTM3MDA3NjgzZDM2NmY2NDhkNGM0MGVjMTdiYTUwMDllOTg","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-14T11:48:31Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T11:55:10Z"},"message":"Reuse compatible parent compactions in Guardian V2 (#38564)\n\n## Why\n\nGuardian V2 classification requests should retain compacted conversation context only when the parent and classifier model configurations can share the encrypted compaction.\n\n## What changed\n\n- Resolve the classifier model's compaction compatibility hash when initializing its sampler.\n- Add the latest encrypted parent compaction to classification input when both models have the same non-empty compatibility hash.\n- Ignore missing, empty, or unidentified compactions, and omit parent context when compatibility cannot be established.\n\n## Testing\n\n- Cover latest-compaction selection and invalid compaction data.\n- Cover matching, mismatched, missing, empty, and changed compatibility hashes.\n\nGitOrigin-RevId: f0fcb09fd028cd2f397fdbc3d541b4bc464b0beb","tree":{"sha":"f7ffd5789b254c80baadaa9f9513b54340379bb4","url":"https://api.github.com/repos/openai/codex/git/trees/f7ffd5789b254c80baadaa9f9513b54340379bb4"},"url":"https://api.github.com/repos/openai/codex/git/commits/08c48e37007683d366f648d4c40ec17ba5009e98","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/08c48e37007683d366f648d4c40ec17ba5009e98","html_url":"https://github.com/openai/codex/commit/08c48e37007683d366f648d4c40ec17ba5009e98","comments_url":"https://api.github.com/repos/openai/codex/commits/08c48e37007683d366f648d4c40ec17ba5009e98/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"3134ab65725d8af4309ca8bc27a6ca560c21ca04","url":"https://api.github.com/repos/openai/codex/commits/3134ab65725d8af4309ca8bc27a6ca560c21ca04","html_url":"https://github.com/openai/codex/commit/3134ab65725d8af4309ca8bc27a6ca560c21ca04"}]},{"sha":"3134ab65725d8af4309ca8bc27a6ca560c21ca04","node_id":"C_kwDOOYsS4doAKDMxMzRhYjY1NzI1ZDhhZjQzMDljYThiYzI3YTZjYTU2MGMyMWNhMDQ","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-14T11:42:33Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T11:47:12Z"},"message":"Restrict filesystem helper sandbox access (#38561)\n\n## Why\n\nFilesystem helpers only need access to their own executables. Granting access to\nthe containing directories also makes unrelated sibling files readable.\n\n## What changed\n\n- Allow filesystem helpers to read the Codex and Linux sandbox executables\n  directly instead of their parent directories.\n- Give macOS filesystem helpers a narrower Seatbelt profile that omits the\n  normal process sandbox's `/Applications` read access.\n- Preserve the existing platform defaults for normal sandboxed processes.\n\n## Testing\n\nAdd unit and integration coverage for direct and symlinked sibling-file access,\nsandboxed copies, allowed workspace reads, and the macOS-specific Seatbelt\nprofiles.\n\nGitOrigin-RevId: 9380c6868a695bdf2275baa74bd5e8a30a64ba1b","tree":{"sha":"f0d45fd5f0a71e903faee8e93bdfd1b8a8c6fe8c","url":"https://api.github.com/repos/openai/codex/git/trees/f0d45fd5f0a71e903faee8e93bdfd1b8a8c6fe8c"},"url":"https://api.github.com/repos/openai/codex/git/commits/3134ab65725d8af4309ca8bc27a6ca560c21ca04","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/3134ab65725d8af4309ca8bc27a6ca560c21ca04","html_url":"https://github.com/openai/codex/commit/3134ab65725d8af4309ca8bc27a6ca560c21ca04","comments_url":"https://api.github.com/repos/openai/codex/commits/3134ab65725d8af4309ca8bc27a6ca560c21ca04/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"486df09a003953549a8899e6a834e9d49b56fa73","url":"https://api.github.com/repos/openai/codex/commits/486df09a003953549a8899e6a834e9d49b56fa73","html_url":"https://github.com/openai/codex/commit/486df09a003953549a8899e6a834e9d49b56fa73"}]},{"sha":"486df09a003953549a8899e6a834e9d49b56fa73","node_id":"C_kwDOOYsS4doAKDQ4NmRmMDlhMDAzOTUzNTQ5YTg4OTllNmE4MzRlOWQ0OWI1NmZhNzM","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-14T11:12:33Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T11:17:50Z"},"message":"Improve Guardian transcript context selection (#38558)\n\n## What changed\n\n- Replace the single byte limit with token-derived per-entry and separate message and tool transcript budgets.\n- Preserve the first and latest user messages, then fill the remaining budgets with recent user, assistant, and tool context while limiting retained non-user entries.\n- Truncate oversized entries in the middle without splitting UTF-8 characters, and report the approximate omitted token count.\n- Exclude reasoning from the default transcript sources while retaining support when it is explicitly configured.\n\n## Testing\n\n- Cover oversized message and tool-result truncation, user-message retention, separate tool budgeting, configured reasoning, and the resulting Guardian sampling request.\n\nGitOrigin-RevId: aaeaa5fb5d902b5a1581a8a819bf34724bde794b","tree":{"sha":"3835d303ac4b34806cdb3855e66e517a75e3da0c","url":"https://api.github.com/repos/openai/codex/git/trees/3835d303ac4b34806cdb3855e66e517a75e3da0c"},"url":"https://api.github.com/repos/openai/codex/git/commits/486df09a003953549a8899e6a834e9d49b56fa73","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/486df09a003953549a8899e6a834e9d49b56fa73","html_url":"https://github.com/openai/codex/commit/486df09a003953549a8899e6a834e9d49b56fa73","comments_url":"https://api.github.com/repos/openai/codex/commits/486df09a003953549a8899e6a834e9d49b56fa73/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"db5b4a4cfb2668330f0f600b4bbfc45e16f9d776","url":"https://api.github.com/repos/openai/codex/commits/db5b4a4cfb2668330f0f600b4bbfc45e16f9d776","html_url":"https://github.com/openai/codex/commit/db5b4a4cfb2668330f0f600b4bbfc45e16f9d776"}]},{"sha":"db5b4a4cfb2668330f0f600b4bbfc45e16f9d776","node_id":"C_kwDOOYsS4doAKGRiNWI0YTRjZmIyNjY4MzMwZjBmNjAwYjRiYmZjNDVlMTZmOWQ3NzY","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-14T10:54:58Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T11:02:01Z"},"message":"Preserve Guardian transcript boundaries in sampling input (#38555)\n\n## What changed\n\n- Represent Guardian sampling input as an ordered list of text entries.\n- Send each transcript entry and approval-request delimiter as a separate input\n  content item while preserving the existing transcript byte limit.\n\n## Testing\n\n- Update transcript and sampler tests to verify entry boundaries, multi-item\n  request serialization, and bounded transcript behavior.\n\nGitOrigin-RevId: 433e2e6ca18ce9288025715f5956295bfe852e98","tree":{"sha":"970d5eae69d3a57a067c0da893db522733ee6d5b","url":"https://api.github.com/repos/openai/codex/git/trees/970d5eae69d3a57a067c0da893db522733ee6d5b"},"url":"https://api.github.com/repos/openai/codex/git/commits/db5b4a4cfb2668330f0f600b4bbfc45e16f9d776","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/db5b4a4cfb2668330f0f600b4bbfc45e16f9d776","html_url":"https://github.com/openai/codex/commit/db5b4a4cfb2668330f0f600b4bbfc45e16f9d776","comments_url":"https://api.github.com/repos/openai/codex/commits/db5b4a4cfb2668330f0f600b4bbfc45e16f9d776/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a44f266a4a23ab2c1aef23c54ce86642559237ca","url":"https://api.github.com/repos/openai/codex/commits/a44f266a4a23ab2c1aef23c54ce86642559237ca","html_url":"https://github.com/openai/codex/commit/a44f266a4a23ab2c1aef23c54ce86642559237ca"}]},{"sha":"a44f266a4a23ab2c1aef23c54ce86642559237ca","node_id":"C_kwDOOYsS4doAKGE0NGYyNjZhNGEyM2FiMmMxYWVmMjNjNTRjZTg2NjQyNTU5MjM3Y2E","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-14T10:48:53Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T10:58:56Z"},"message":"Initialize Guardian V2 samplers per thread (#38553)\n\n## What changed\n\n- Register Guardian V2 for thread startup as well as tool-call lifecycle events.\n- When `guardianv2` is enabled, create and store a thread-local Luna sampler using the thread's model provider, authentication policy, session metadata, originator, and service tier.\n- Emit a warning if sampler initialization fails, and skip tool classification when the thread has no sampler.\n\n## Testing\n\n- Update the extension test to enable `guardianv2`, run thread startup, and verify tool-call sampling through the initialized connection.\n\nGitOrigin-RevId: 5ab732e85c9827495c67f57117eb5be450a7f90e","tree":{"sha":"10cc4e58ac94fd6f063e9db899bb617d3a0628e0","url":"https://api.github.com/repos/openai/codex/git/trees/10cc4e58ac94fd6f063e9db899bb617d3a0628e0"},"url":"https://api.github.com/repos/openai/codex/git/commits/a44f266a4a23ab2c1aef23c54ce86642559237ca","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a44f266a4a23ab2c1aef23c54ce86642559237ca","html_url":"https://github.com/openai/codex/commit/a44f266a4a23ab2c1aef23c54ce86642559237ca","comments_url":"https://api.github.com/repos/openai/codex/commits/a44f266a4a23ab2c1aef23c54ce86642559237ca/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"8630bb3caecaff6abc6add450a88035d9f6d3f8c","url":"https://api.github.com/repos/openai/codex/commits/8630bb3caecaff6abc6add450a88035d9f6d3f8c","html_url":"https://github.com/openai/codex/commit/8630bb3caecaff6abc6add450a88035d9f6d3f8c"}]},{"sha":"8630bb3caecaff6abc6add450a88035d9f6d3f8c","node_id":"C_kwDOOYsS4doAKDg2MzBiYjNjYWVjYWZmNmFiYzZhZGQ0NTBhODgwMzVkOWY2ZDNmOGM","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-14T09:22:23Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T09:27:41Z"},"message":"Record Guardian V2 risk scores on threads (#38540)\n\n## What changed\n\n- Parse and validate the structured risk scores returned for each classified tool call.\n- Publish each score through thread extension data and persist it in rollout history for non-ephemeral threads.\n- Report parsing, thread lookup, validation, and persistence failures through the extension warning sink.\n\n## Testing\n\n- Extend the Guardian V2 tool-classification test to verify that the sampled `action_risk` score is available from thread extension data and written to rollout history.\n\nGitOrigin-RevId: 46614fe0d686736dfb1f09398c6fcd848c7d8b2c","tree":{"sha":"2079d788f9826e7da65ee47349f32f0f6f1c45ae","url":"https://api.github.com/repos/openai/codex/git/trees/2079d788f9826e7da65ee47349f32f0f6f1c45ae"},"url":"https://api.github.com/repos/openai/codex/git/commits/8630bb3caecaff6abc6add450a88035d9f6d3f8c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/8630bb3caecaff6abc6add450a88035d9f6d3f8c","html_url":"https://github.com/openai/codex/commit/8630bb3caecaff6abc6add450a88035d9f6d3f8c","comments_url":"https://api.github.com/repos/openai/codex/commits/8630bb3caecaff6abc6add450a88035d9f6d3f8c/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4eff3b788ba629acc944ed6db6502c362fc08e0a","url":"https://api.github.com/repos/openai/codex/commits/4eff3b788ba629acc944ed6db6502c362fc08e0a","html_url":"https://github.com/openai/codex/commit/4eff3b788ba629acc944ed6db6502c362fc08e0a"}]},{"sha":"4eff3b788ba629acc944ed6db6502c362fc08e0a","node_id":"C_kwDOOYsS4doAKDRlZmYzYjc4OGJhNjI5YWNjOTQ0ZWQ2ZGI2NTAyYzM2MmZjMDhlMGE","commit":{"author":{"name":"Dylan Hurd","email":"dylan.hurd@openai.com","date":"2026-08-14T08:11:18Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T08:16:23Z"},"message":"Configure Guardian sampling for responses lite (#38527)\n\n## What changed\n\n- Opt Guardian V2 Luna sampler WebSocket connections into responses lite.\n- Send `reasoning.context` as `all_turns` on sampling requests.\n\n## Testing\n\n- Extend sampler and extension tests to verify the connection header and reasoning context.\n\nGitOrigin-RevId: 4b0263c01b8259ed5268c222dcf7559912baba8c","tree":{"sha":"48a19de7ca65f501bf72cf8d1df063852067fa23","url":"https://api.github.com/repos/openai/codex/git/trees/48a19de7ca65f501bf72cf8d1df063852067fa23"},"url":"https://api.github.com/repos/openai/codex/git/commits/4eff3b788ba629acc944ed6db6502c362fc08e0a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4eff3b788ba629acc944ed6db6502c362fc08e0a","html_url":"https://github.com/openai/codex/commit/4eff3b788ba629acc944ed6db6502c362fc08e0a","comments_url":"https://api.github.com/repos/openai/codex/commits/4eff3b788ba629acc944ed6db6502c362fc08e0a/comments","author":{"login":"dylan-hurd-oai","id":220976066,"node_id":"U_kgDODSvTwg","avatar_url":"https://avatars.githubusercontent.com/u/220976066?v=4","gravatar_id":"","url":"https://api.github.com/users/dylan-hurd-oai","html_url":"https://github.com/dylan-hurd-oai","followers_url":"https://api.github.com/users/dylan-hurd-oai/followers","following_url":"https://api.github.com/users/dylan-hurd-oai/following{/other_user}","gists_url":"https://api.github.com/users/dylan-hurd-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/dylan-hurd-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dylan-hurd-oai/subscriptions","organizations_url":"https://api.github.com/users/dylan-hurd-oai/orgs","repos_url":"https://api.github.com/users/dylan-hurd-oai/repos","events_url":"https://api.github.com/users/dylan-hurd-oai/events{/privacy}","received_events_url":"https://api.github.com/users/dylan-hurd-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fdbab67c669a3176b13d08ab49493f30a806d2ba","url":"https://api.github.com/repos/openai/codex/commits/fdbab67c669a3176b13d08ab49493f30a806d2ba","html_url":"https://github.com/openai/codex/commit/fdbab67c669a3176b13d08ab49493f30a806d2ba"}]},{"sha":"fdbab67c669a3176b13d08ab49493f30a806d2ba","node_id":"C_kwDOOYsS4doAKGZkYmFiNjdjNjY5YTMxNzZiMTNkMDhhYjQ5NDkzZjMwYTgwNmQyYmE","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-08-14T07:47:11Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T07:52:38Z"},"message":"Carry environment config in turn selections (#38521)\n\n## What changed\n\n- Add `EnvironmentConfigState` to `TurnEnvironmentSelection` so each environment attachment can inherit thread configuration or carry ready configuration for its login-shell policy and selected capability roots.\n- Apply ready configuration during thread creation and thread-settings updates while reusing the existing environment connection.\n- Validate selection configuration before applying settings, rejecting unsupported pending state and invalid capability roots.\n\n## Testing\n\n- Cover attachment-scoped capability roots, ready configuration at thread startup and turn updates, and rejection of invalid selections without changing existing settings.\n\nGitOrigin-RevId: 86cf8f2148fdaa746ea0dd12890ab7b1577d7587","tree":{"sha":"b8ec278fd7fdafb3462aaf77021960d5d3b871ae","url":"https://api.github.com/repos/openai/codex/git/trees/b8ec278fd7fdafb3462aaf77021960d5d3b871ae"},"url":"https://api.github.com/repos/openai/codex/git/commits/fdbab67c669a3176b13d08ab49493f30a806d2ba","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fdbab67c669a3176b13d08ab49493f30a806d2ba","html_url":"https://github.com/openai/codex/commit/fdbab67c669a3176b13d08ab49493f30a806d2ba","comments_url":"https://api.github.com/repos/openai/codex/commits/fdbab67c669a3176b13d08ab49493f30a806d2ba/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"86b1123ff6b5d089a146be4e603a324cf454223a","url":"https://api.github.com/repos/openai/codex/commits/86b1123ff6b5d089a146be4e603a324cf454223a","html_url":"https://github.com/openai/codex/commit/86b1123ff6b5d089a146be4e603a324cf454223a"}]},{"sha":"86b1123ff6b5d089a146be4e603a324cf454223a","node_id":"C_kwDOOYsS4doAKDg2YjExMjNmZjZiNWQwODlhMTQ2YmU0ZTYwM2EzMjRjZjQ1NDIyM2E","commit":{"author":{"name":"rka-oai","email":"rka@openai.com","date":"2026-08-14T05:44:44Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T05:49:33Z"},"message":"Enable parallel tool calls for all model prompts (#38499)\n\n## What changed\n\n- Set `parallel_tool_calls` for regular and remote compaction prompts without consulting model metadata.\n- Remove `supports_parallel_tool_calls` from `ModelInfo`, the bundled model catalog, and related fixtures.\n- Preserve the existing Responses Lite behavior that disables parallel tool calls at request construction.\n\nGitOrigin-RevId: 49552bdf97e71fa57325abb49f8adc0c88f1401a","tree":{"sha":"ccf480af6d1392376bc43656cc320422e9642fd9","url":"https://api.github.com/repos/openai/codex/git/trees/ccf480af6d1392376bc43656cc320422e9642fd9"},"url":"https://api.github.com/repos/openai/codex/git/commits/86b1123ff6b5d089a146be4e603a324cf454223a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/86b1123ff6b5d089a146be4e603a324cf454223a","html_url":"https://github.com/openai/codex/commit/86b1123ff6b5d089a146be4e603a324cf454223a","comments_url":"https://api.github.com/repos/openai/codex/commits/86b1123ff6b5d089a146be4e603a324cf454223a/comments","author":{"login":"rka-oai","id":240799229,"node_id":"U_kgDODlpN_Q","avatar_url":"https://avatars.githubusercontent.com/u/240799229?v=4","gravatar_id":"","url":"https://api.github.com/users/rka-oai","html_url":"https://github.com/rka-oai","followers_url":"https://api.github.com/users/rka-oai/followers","following_url":"https://api.github.com/users/rka-oai/following{/other_user}","gists_url":"https://api.github.com/users/rka-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rka-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rka-oai/subscriptions","organizations_url":"https://api.github.com/users/rka-oai/orgs","repos_url":"https://api.github.com/users/rka-oai/repos","events_url":"https://api.github.com/users/rka-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rka-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"636e505c5cd809bdce37314f77130ffb4e45c46b","url":"https://api.github.com/repos/openai/codex/commits/636e505c5cd809bdce37314f77130ffb4e45c46b","html_url":"https://github.com/openai/codex/commit/636e505c5cd809bdce37314f77130ffb4e45c46b"}]},{"sha":"636e505c5cd809bdce37314f77130ffb4e45c46b","node_id":"C_kwDOOYsS4doAKDYzNmU1MDVjNWNkODA5YmRjZTM3MzE0Zjc3MTMwZmZiNGU0NWM0NmI","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-08-14T04:53:01Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T05:03:39Z"},"message":"Verify bundled bwrap in Bazel builds (#38494)\n\n## Why\n\nBazel builds did not embed the SHA-256 digest used to verify the bundled\n`bwrap` binary at launch.\n\n## What changed\n\n- Strip the Bazel-built `bwrap`, generate its SHA-256 digest, and pass that\n  digest to `codex-linux-sandbox` through a compiler environment file.\n- Report digest verification failures with exit code `8` instead of panicking.\n- Add a Bazel integration test that accepts the original bundled binary and\n  rejects a tampered copy.\n\nGitOrigin-RevId: 224eeb6ae3d1bfb100e048b296f75fd8ba109581","tree":{"sha":"0eeb96efca2f2f03bf062aa5bfca4427d6c9a597","url":"https://api.github.com/repos/openai/codex/git/trees/0eeb96efca2f2f03bf062aa5bfca4427d6c9a597"},"url":"https://api.github.com/repos/openai/codex/git/commits/636e505c5cd809bdce37314f77130ffb4e45c46b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/636e505c5cd809bdce37314f77130ffb4e45c46b","html_url":"https://github.com/openai/codex/commit/636e505c5cd809bdce37314f77130ffb4e45c46b","comments_url":"https://api.github.com/repos/openai/codex/commits/636e505c5cd809bdce37314f77130ffb4e45c46b/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"45c9c74e299ae92a75f3fb201d4294d99de31f2f","url":"https://api.github.com/repos/openai/codex/commits/45c9c74e299ae92a75f3fb201d4294d99de31f2f","html_url":"https://github.com/openai/codex/commit/45c9c74e299ae92a75f3fb201d4294d99de31f2f"}]},{"sha":"45c9c74e299ae92a75f3fb201d4294d99de31f2f","node_id":"C_kwDOOYsS4doAKDQ1YzljNzRlMjk5YWU5MmE3NWYzZmIyMDFkNDI5NGQ5OWRlMzFmMmY","commit":{"author":{"name":"Matthew Zeng","email":"mzeng@openai.com","date":"2026-08-14T04:36:54Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T04:49:14Z"},"message":"Reuse pending MCP startups during reconciliation (#38493)\n\n## Why\n\nMCP runtime reconciliation can occur while an unchanged server is still\nstarting, such as when capability roots become available. Reconciliation\nshould neither wait for that startup nor initialize the same server again.\n\n## What changed\n\n- Reuse an active, uncancelled pending MCP connection when its identity,\n  catalog limit, and protocol mode still match.\n- Publish the shared startup result through the reconciled server view while\n  applying its updated tool filter.\n- Preserve cancellation when a reused pending server is subsequently removed.\n\n## Testing\n\nAdded coverage for filtered-tool publication, disabling a reused pending\nserver, and capability-root reconciliation during Codex Apps startup.\n\nGitOrigin-RevId: 690cf8695e75b341d097d7d22b5da6993b24e787","tree":{"sha":"33f02c46c8a5598a98a3991f78d471d2e65db860","url":"https://api.github.com/repos/openai/codex/git/trees/33f02c46c8a5598a98a3991f78d471d2e65db860"},"url":"https://api.github.com/repos/openai/codex/git/commits/45c9c74e299ae92a75f3fb201d4294d99de31f2f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/45c9c74e299ae92a75f3fb201d4294d99de31f2f","html_url":"https://github.com/openai/codex/commit/45c9c74e299ae92a75f3fb201d4294d99de31f2f","comments_url":"https://api.github.com/repos/openai/codex/commits/45c9c74e299ae92a75f3fb201d4294d99de31f2f/comments","author":{"login":"mzeng-openai","id":175741029,"node_id":"U_kgDOCnmYZQ","avatar_url":"https://avatars.githubusercontent.com/u/175741029?v=4","gravatar_id":"","url":"https://api.github.com/users/mzeng-openai","html_url":"https://github.com/mzeng-openai","followers_url":"https://api.github.com/users/mzeng-openai/followers","following_url":"https://api.github.com/users/mzeng-openai/following{/other_user}","gists_url":"https://api.github.com/users/mzeng-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/mzeng-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mzeng-openai/subscriptions","organizations_url":"https://api.github.com/users/mzeng-openai/orgs","repos_url":"https://api.github.com/users/mzeng-openai/repos","events_url":"https://api.github.com/users/mzeng-openai/events{/privacy}","received_events_url":"https://api.github.com/users/mzeng-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4e5a08feb63f79e407c86f69a78dc8c7ef115d88","url":"https://api.github.com/repos/openai/codex/commits/4e5a08feb63f79e407c86f69a78dc8c7ef115d88","html_url":"https://github.com/openai/codex/commit/4e5a08feb63f79e407c86f69a78dc8c7ef115d88"}]},{"sha":"4e5a08feb63f79e407c86f69a78dc8c7ef115d88","node_id":"C_kwDOOYsS4doAKDRlNWEwOGZlYjYzZjc5ZTQwN2M4NmY2OWE3OGRjOGM3ZWYxMTVkODg","commit":{"author":{"name":"Dylan Hurd","email":"dylan.hurd@openai.com","date":"2026-08-14T03:13:15Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T04:46:04Z"},"message":"Enforce strict auto-review for MCP tool calls (#38492)\n\n## What changed\n\n- Route MCP tool calls through the automatic reviewer when strict auto-review is enabled, even when the approval policy, tool annotations, or a remembered session decision would otherwise skip review.\n- Pass the strict auto-review flag into the MCP approval request so reviewer selection follows the turn setting.\n- Update MCP approval and turn-metadata tests to cover the forced review path and confirm that it does not request user input.\n\nGitOrigin-RevId: 2c0b5f4dc1a15cb2fb827e4b21e69167fdcf3e56","tree":{"sha":"b8b824ef310c451ca93cc0f0c3045b70ff3e44ac","url":"https://api.github.com/repos/openai/codex/git/trees/b8b824ef310c451ca93cc0f0c3045b70ff3e44ac"},"url":"https://api.github.com/repos/openai/codex/git/commits/4e5a08feb63f79e407c86f69a78dc8c7ef115d88","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4e5a08feb63f79e407c86f69a78dc8c7ef115d88","html_url":"https://github.com/openai/codex/commit/4e5a08feb63f79e407c86f69a78dc8c7ef115d88","comments_url":"https://api.github.com/repos/openai/codex/commits/4e5a08feb63f79e407c86f69a78dc8c7ef115d88/comments","author":{"login":"dylan-hurd-oai","id":220976066,"node_id":"U_kgDODSvTwg","avatar_url":"https://avatars.githubusercontent.com/u/220976066?v=4","gravatar_id":"","url":"https://api.github.com/users/dylan-hurd-oai","html_url":"https://github.com/dylan-hurd-oai","followers_url":"https://api.github.com/users/dylan-hurd-oai/followers","following_url":"https://api.github.com/users/dylan-hurd-oai/following{/other_user}","gists_url":"https://api.github.com/users/dylan-hurd-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/dylan-hurd-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dylan-hurd-oai/subscriptions","organizations_url":"https://api.github.com/users/dylan-hurd-oai/orgs","repos_url":"https://api.github.com/users/dylan-hurd-oai/repos","events_url":"https://api.github.com/users/dylan-hurd-oai/events{/privacy}","received_events_url":"https://api.github.com/users/dylan-hurd-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"cbe85e117b1db59cdbe8175c59793c3cf2a4a7b8","url":"https://api.github.com/repos/openai/codex/commits/cbe85e117b1db59cdbe8175c59793c3cf2a4a7b8","html_url":"https://github.com/openai/codex/commit/cbe85e117b1db59cdbe8175c59793c3cf2a4a7b8"}]},{"sha":"cbe85e117b1db59cdbe8175c59793c3cf2a4a7b8","node_id":"C_kwDOOYsS4doAKGNiZTg1ZTExN2IxZGI1OWNkYmU4MTc1YzU5NzkzYzNjZjJhNGE3Yjg","commit":{"author":{"name":"dozaki-openai","email":"dozaki@openai.com","date":"2026-08-14T02:50:04Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T02:54:38Z"},"message":"Search selected plugin apps before falling back (#38484)\n\n## What changed\n\n- When an explicitly selected plugin has apps available, instruct the model to use `tool_search` to discover relevant tools before falling back to unrelated or built-in tools.\n- Scope the guidance to the request that selected the plugin and omit it for plugins without available apps.\n\n## Testing\n\n- Cover app-specific rendering, non-app plugins, bounded instruction output, and app enablement in dual-surface plugin requests.\n\nGitOrigin-RevId: 1b9501cc403d2817334a9307e683e99c140a794a","tree":{"sha":"27bedb2466f29fc8d0879e5a713329d19d83e012","url":"https://api.github.com/repos/openai/codex/git/trees/27bedb2466f29fc8d0879e5a713329d19d83e012"},"url":"https://api.github.com/repos/openai/codex/git/commits/cbe85e117b1db59cdbe8175c59793c3cf2a4a7b8","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/cbe85e117b1db59cdbe8175c59793c3cf2a4a7b8","html_url":"https://github.com/openai/codex/commit/cbe85e117b1db59cdbe8175c59793c3cf2a4a7b8","comments_url":"https://api.github.com/repos/openai/codex/commits/cbe85e117b1db59cdbe8175c59793c3cf2a4a7b8/comments","author":{"login":"dozaki-openai","id":225131285,"node_id":"U_kgDODWs7FQ","avatar_url":"https://avatars.githubusercontent.com/u/225131285?v=4","gravatar_id":"","url":"https://api.github.com/users/dozaki-openai","html_url":"https://github.com/dozaki-openai","followers_url":"https://api.github.com/users/dozaki-openai/followers","following_url":"https://api.github.com/users/dozaki-openai/following{/other_user}","gists_url":"https://api.github.com/users/dozaki-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/dozaki-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dozaki-openai/subscriptions","organizations_url":"https://api.github.com/users/dozaki-openai/orgs","repos_url":"https://api.github.com/users/dozaki-openai/repos","events_url":"https://api.github.com/users/dozaki-openai/events{/privacy}","received_events_url":"https://api.github.com/users/dozaki-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"9d012ca4f54c5adc86e605a7bedbdd03ef63f516","url":"https://api.github.com/repos/openai/codex/commits/9d012ca4f54c5adc86e605a7bedbdd03ef63f516","html_url":"https://github.com/openai/codex/commit/9d012ca4f54c5adc86e605a7bedbdd03ef63f516"}]},{"sha":"9d012ca4f54c5adc86e605a7bedbdd03ef63f516","node_id":"C_kwDOOYsS4doAKDlkMDEyY2E0ZjU0YzVhZGM4NmU2MDVhN2JlZGJkZDAzZWY2M2Y1MTY","commit":{"author":{"name":"pmccrary-oai","email":"pmccrary@openai.com","date":"2026-08-14T02:24:45Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T02:32:05Z"},"message":"Include agent names in turn metadata (#38483)\n\n## What changed\n\n- Add the canonical agent path as `agent_name` in Responses API turn metadata.\n- Fall back to `/root` when a session has no canonical agent path.\n- Reserve `agent_name` from client metadata overrides and omit it from MCP request metadata.\n\n## Testing\n\n- Cover root, named subagent, legacy subagent, MCP, and client metadata merge cases.\n\nGitOrigin-RevId: a9adcc079a51beae7d621aba24bcd759ceaa408e","tree":{"sha":"06fb768155c294b5ad3edcd85f296f25c5397a11","url":"https://api.github.com/repos/openai/codex/git/trees/06fb768155c294b5ad3edcd85f296f25c5397a11"},"url":"https://api.github.com/repos/openai/codex/git/commits/9d012ca4f54c5adc86e605a7bedbdd03ef63f516","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/9d012ca4f54c5adc86e605a7bedbdd03ef63f516","html_url":"https://github.com/openai/codex/commit/9d012ca4f54c5adc86e605a7bedbdd03ef63f516","comments_url":"https://api.github.com/repos/openai/codex/commits/9d012ca4f54c5adc86e605a7bedbdd03ef63f516/comments","author":{"login":"pmccrary-oai","id":242064461,"node_id":"U_kgDODm2cTQ","avatar_url":"https://avatars.githubusercontent.com/u/242064461?v=4","gravatar_id":"","url":"https://api.github.com/users/pmccrary-oai","html_url":"https://github.com/pmccrary-oai","followers_url":"https://api.github.com/users/pmccrary-oai/followers","following_url":"https://api.github.com/users/pmccrary-oai/following{/other_user}","gists_url":"https://api.github.com/users/pmccrary-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/pmccrary-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pmccrary-oai/subscriptions","organizations_url":"https://api.github.com/users/pmccrary-oai/orgs","repos_url":"https://api.github.com/users/pmccrary-oai/repos","events_url":"https://api.github.com/users/pmccrary-oai/events{/privacy}","received_events_url":"https://api.github.com/users/pmccrary-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"5620bab61cf3fc08cdcd4cf7461b0733252664d5","url":"https://api.github.com/repos/openai/codex/commits/5620bab61cf3fc08cdcd4cf7461b0733252664d5","html_url":"https://github.com/openai/codex/commit/5620bab61cf3fc08cdcd4cf7461b0733252664d5"}]},{"sha":"5620bab61cf3fc08cdcd4cf7461b0733252664d5","node_id":"C_kwDOOYsS4doAKDU2MjBiYWI2MWNmM2ZjMDhjZGNkNGNmNzQ2MWIwNzMzMjUyNjY0ZDU","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-14T01:36:54Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T01:49:00Z"},"message":"Add bounded skill model delegation instructions (#38475)\n\n## What changed\n\n- Add `SkillModelDelegationInstruction` for skills that request Luna while running on Sol or Terra.\n- Resolve Luna only when it is available in the current provider namespace.\n- Bound and validate model identifiers, skill names, and the rendered instruction before exposing it to callers.\n\n## Testing\n\n- Cover supported parent models, provider namespace matching, unavailable or unsafe targets, instruction rendering, and size limits.\n\nGitOrigin-RevId: 188a88c36ca32689cbf1e53465283dff4137cb15","tree":{"sha":"b02f504d6234aa51b2ee6bb988408a0467f7842d","url":"https://api.github.com/repos/openai/codex/git/trees/b02f504d6234aa51b2ee6bb988408a0467f7842d"},"url":"https://api.github.com/repos/openai/codex/git/commits/5620bab61cf3fc08cdcd4cf7461b0733252664d5","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/5620bab61cf3fc08cdcd4cf7461b0733252664d5","html_url":"https://github.com/openai/codex/commit/5620bab61cf3fc08cdcd4cf7461b0733252664d5","comments_url":"https://api.github.com/repos/openai/codex/commits/5620bab61cf3fc08cdcd4cf7461b0733252664d5/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"5c6f498b0e35058ddf0d3ba0959a0967c5b6495b","url":"https://api.github.com/repos/openai/codex/commits/5c6f498b0e35058ddf0d3ba0959a0967c5b6495b","html_url":"https://github.com/openai/codex/commit/5c6f498b0e35058ddf0d3ba0959a0967c5b6495b"}]},{"sha":"5c6f498b0e35058ddf0d3ba0959a0967c5b6495b","node_id":"C_kwDOOYsS4doAKDVjNmY0OThiMGUzNTA1OGRkZjBkM2JhMDk1OWEwOTY3YzViNjQ5NWI","commit":{"author":{"name":"Tamir Duberstein","email":"tamird@openai.com","date":"2026-08-14T01:29:24Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T01:44:33Z"},"message":"Stop generating accepted-line fingerprints (#38473)\n\n## What changed\n\n- Replace accepted-line fingerprint generation with diff-based added and deleted line counts.\n- Keep `line_fingerprints` in the analytics payload as a statically empty field for schema compatibility.\n- Remove the fingerprint types and public parsing API that are no longer used.\n\n## Testing\n\n- Update diff parsing tests to cover accepted-line counts without generating fingerprints.\n\nGitOrigin-RevId: 4247c76c7b56b1a323f70f960823937352b84f7b","tree":{"sha":"d74b866363c12ee31cca0c4e6b275308622f5a30","url":"https://api.github.com/repos/openai/codex/git/trees/d74b866363c12ee31cca0c4e6b275308622f5a30"},"url":"https://api.github.com/repos/openai/codex/git/commits/5c6f498b0e35058ddf0d3ba0959a0967c5b6495b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/5c6f498b0e35058ddf0d3ba0959a0967c5b6495b","html_url":"https://github.com/openai/codex/commit/5c6f498b0e35058ddf0d3ba0959a0967c5b6495b","comments_url":"https://api.github.com/repos/openai/codex/commits/5c6f498b0e35058ddf0d3ba0959a0967c5b6495b/comments","author":{"login":"tamird","id":1535036,"node_id":"MDQ6VXNlcjE1MzUwMzY=","avatar_url":"https://avatars.githubusercontent.com/u/1535036?v=4","gravatar_id":"","url":"https://api.github.com/users/tamird","html_url":"https://github.com/tamird","followers_url":"https://api.github.com/users/tamird/followers","following_url":"https://api.github.com/users/tamird/following{/other_user}","gists_url":"https://api.github.com/users/tamird/gists{/gist_id}","starred_url":"https://api.github.com/users/tamird/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tamird/subscriptions","organizations_url":"https://api.github.com/users/tamird/orgs","repos_url":"https://api.github.com/users/tamird/repos","events_url":"https://api.github.com/users/tamird/events{/privacy}","received_events_url":"https://api.github.com/users/tamird/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"d5e256ceb210dacbab9d8dcc7eafda58f90f6e51","url":"https://api.github.com/repos/openai/codex/commits/d5e256ceb210dacbab9d8dcc7eafda58f90f6e51","html_url":"https://github.com/openai/codex/commit/d5e256ceb210dacbab9d8dcc7eafda58f90f6e51"}]},{"sha":"d5e256ceb210dacbab9d8dcc7eafda58f90f6e51","node_id":"C_kwDOOYsS4doAKGQ1ZTI1NmNlYjIxMGRhY2JhYjlkOGRjYzdlYWZkYTU4ZjkwZjZlNTE","commit":{"author":{"name":"Celia Chen","email":"celia@openai.com","date":"2026-08-14T01:18:49Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T01:23:59Z"},"message":"Add an Amazon Bedrock Runtime provider (#38470)\n\n## What changed\n\n- Add the built-in `amazon-bedrock-runtime` provider for regional\n  `bedrock-runtime` OpenAI-compatible endpoints.\n- Use endpoint-specific SigV4 service configuration while preserving bearer\n  token auth and per-provider AWS profile, region, and transport overrides.\n- Provide global and US cross-region GPT-5.6 model variants, prefer global\n  routing for fallback and background tasks, and disable unsupported web search.\n\n## Testing\n\n- Cover provider configuration and capabilities, endpoint and auth selection,\n  runtime catalog ordering, model fallback, and web search omission.\n\nGitOrigin-RevId: d158ab74a5768e1b4c61063365a0c06735313322","tree":{"sha":"4cc4f30b5cbd09447177e1082db870038b533725","url":"https://api.github.com/repos/openai/codex/git/trees/4cc4f30b5cbd09447177e1082db870038b533725"},"url":"https://api.github.com/repos/openai/codex/git/commits/d5e256ceb210dacbab9d8dcc7eafda58f90f6e51","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/d5e256ceb210dacbab9d8dcc7eafda58f90f6e51","html_url":"https://github.com/openai/codex/commit/d5e256ceb210dacbab9d8dcc7eafda58f90f6e51","comments_url":"https://api.github.com/repos/openai/codex/commits/d5e256ceb210dacbab9d8dcc7eafda58f90f6e51/comments","author":{"login":"celia-oai","id":209693228,"node_id":"U_kgDODH-qLA","avatar_url":"https://avatars.githubusercontent.com/u/209693228?v=4","gravatar_id":"","url":"https://api.github.com/users/celia-oai","html_url":"https://github.com/celia-oai","followers_url":"https://api.github.com/users/celia-oai/followers","following_url":"https://api.github.com/users/celia-oai/following{/other_user}","gists_url":"https://api.github.com/users/celia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/celia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celia-oai/subscriptions","organizations_url":"https://api.github.com/users/celia-oai/orgs","repos_url":"https://api.github.com/users/celia-oai/repos","events_url":"https://api.github.com/users/celia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/celia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"3711943d11a1c69a65afe98757814b6b5244fbaf","url":"https://api.github.com/repos/openai/codex/commits/3711943d11a1c69a65afe98757814b6b5244fbaf","html_url":"https://github.com/openai/codex/commit/3711943d11a1c69a65afe98757814b6b5244fbaf"}]},{"sha":"3711943d11a1c69a65afe98757814b6b5244fbaf","node_id":"C_kwDOOYsS4doAKDM3MTE5NDNkMTFhMWM2OWE2NWFmZTk4NzU3ODE0YjZiNTI0NGZiYWY","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-14T00:45:44Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T00:54:45Z"},"message":"Parse model annotations from skill frontmatter (#38467)\n\n## What changed\n\n- Add an optional `model` field to parsed and loaded skill metadata.\n- Recognize `model: luna` while ignoring unsupported model values without\n  preventing the rest of the skill metadata from loading.\n\n## Testing\n\n- Cover supported, absent, unsupported, and repaired frontmatter model values.\n\nGitOrigin-RevId: 376b65555e81d29a5eae93cc4c2633aacf7cd7c8","tree":{"sha":"f668b2d3d1cd4220a5775b9ebdd50a41e2ee1a99","url":"https://api.github.com/repos/openai/codex/git/trees/f668b2d3d1cd4220a5775b9ebdd50a41e2ee1a99"},"url":"https://api.github.com/repos/openai/codex/git/commits/3711943d11a1c69a65afe98757814b6b5244fbaf","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/3711943d11a1c69a65afe98757814b6b5244fbaf","html_url":"https://github.com/openai/codex/commit/3711943d11a1c69a65afe98757814b6b5244fbaf","comments_url":"https://api.github.com/repos/openai/codex/commits/3711943d11a1c69a65afe98757814b6b5244fbaf/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c6dee5f49f9d4763cb498904d9bf0d0fd0c4586b","url":"https://api.github.com/repos/openai/codex/commits/c6dee5f49f9d4763cb498904d9bf0d0fd0c4586b","html_url":"https://github.com/openai/codex/commit/c6dee5f49f9d4763cb498904d9bf0d0fd0c4586b"}]},{"sha":"c6dee5f49f9d4763cb498904d9bf0d0fd0c4586b","node_id":"C_kwDOOYsS4doAKGM2ZGVlNWY0OWY5ZDQ3NjNjYjQ5ODkwNGQ5YmYwZDBmZDBjNDU4NmI","commit":{"author":{"name":"Owen Lin","email":"owen@openai.com","date":"2026-08-14T00:21:27Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T00:27:39Z"},"message":"Preserve thread subscriptions across revert reloads (#38463)\n\n## Why\n\nThe connection that requested `thread/revert` may close while the thread is\nbeing reloaded, but the replacement listener still needs to serve the thread's\nexisting subscriptions.\n\n## What changed\n\nRestart the listener task from the preserved thread state after a paginated\nthread reload instead of attaching it through the requesting connection.\n\nGitOrigin-RevId: 603ec3331c59bdde48faa2f4cb0fd1032ec8dbd8","tree":{"sha":"482f22ee997657641b643cc3e2c0fffbc63378b0","url":"https://api.github.com/repos/openai/codex/git/trees/482f22ee997657641b643cc3e2c0fffbc63378b0"},"url":"https://api.github.com/repos/openai/codex/git/commits/c6dee5f49f9d4763cb498904d9bf0d0fd0c4586b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c6dee5f49f9d4763cb498904d9bf0d0fd0c4586b","html_url":"https://github.com/openai/codex/commit/c6dee5f49f9d4763cb498904d9bf0d0fd0c4586b","comments_url":"https://api.github.com/repos/openai/codex/commits/c6dee5f49f9d4763cb498904d9bf0d0fd0c4586b/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"535795f7d12495ee6ea18db3201d2f85c3606aef","url":"https://api.github.com/repos/openai/codex/commits/535795f7d12495ee6ea18db3201d2f85c3606aef","html_url":"https://github.com/openai/codex/commit/535795f7d12495ee6ea18db3201d2f85c3606aef"}]},{"sha":"535795f7d12495ee6ea18db3201d2f85c3606aef","node_id":"C_kwDOOYsS4doAKDUzNTc5NWY3ZDEyNDk1ZWU2ZWExOGRiMzIwMWQyZjg1YzM2MDZhZWY","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-08-14T00:18:00Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T00:22:54Z"},"message":"Centralize turn environment selection state (#38461)\n\n## What changed\n\n- Store `TurnEnvironmentSelection` directly on each resolved `TurnEnvironment`\n  instead of copying its environment ID, working directory, and workspace roots\n  into separate fields.\n- Update environment resolution, tool execution, approvals, and related tests to\n  access selection state through the retained value.\n\nGitOrigin-RevId: ab723d21e112b8af5bcaf1f772a5e376553312bc","tree":{"sha":"92fa16dc163a36f720d905cbdf59e07a938ee953","url":"https://api.github.com/repos/openai/codex/git/trees/92fa16dc163a36f720d905cbdf59e07a938ee953"},"url":"https://api.github.com/repos/openai/codex/git/commits/535795f7d12495ee6ea18db3201d2f85c3606aef","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/535795f7d12495ee6ea18db3201d2f85c3606aef","html_url":"https://github.com/openai/codex/commit/535795f7d12495ee6ea18db3201d2f85c3606aef","comments_url":"https://api.github.com/repos/openai/codex/commits/535795f7d12495ee6ea18db3201d2f85c3606aef/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"18bbb585e7672e574ca1365d13c9604dbc091df0","url":"https://api.github.com/repos/openai/codex/commits/18bbb585e7672e574ca1365d13c9604dbc091df0","html_url":"https://github.com/openai/codex/commit/18bbb585e7672e574ca1365d13c9604dbc091df0"}]},{"sha":"18bbb585e7672e574ca1365d13c9604dbc091df0","node_id":"C_kwDOOYsS4doAKDE4YmJiNTg1ZTc2NzJlNTc0Y2ExMzY1ZDEzYzk2MDRkYmMwOTFkZjA","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-08-14T00:13:10Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-14T00:18:29Z"},"message":"Add an `AbsolutePathBuf` conversion for `FileSystemPath` (#38460)\n\n## What changed\n\nImplement `From<AbsolutePathBuf>` for `FileSystemPath` and use the conversion\nwhen constructing concrete filesystem permission paths.\n\nGitOrigin-RevId: 244bcbd0c3f76cd87cc1240458fcac6c9ef0a8e3","tree":{"sha":"cec80395bf94df340d485b6a5a5d47eccac1e5b0","url":"https://api.github.com/repos/openai/codex/git/trees/cec80395bf94df340d485b6a5a5d47eccac1e5b0"},"url":"https://api.github.com/repos/openai/codex/git/commits/18bbb585e7672e574ca1365d13c9604dbc091df0","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/18bbb585e7672e574ca1365d13c9604dbc091df0","html_url":"https://github.com/openai/codex/commit/18bbb585e7672e574ca1365d13c9604dbc091df0","comments_url":"https://api.github.com/repos/openai/codex/commits/18bbb585e7672e574ca1365d13c9604dbc091df0/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"9341b38310c73957e1313eab3f7c4034689bdec9","url":"https://api.github.com/repos/openai/codex/commits/9341b38310c73957e1313eab3f7c4034689bdec9","html_url":"https://github.com/openai/codex/commit/9341b38310c73957e1313eab3f7c4034689bdec9"}]},{"sha":"9341b38310c73957e1313eab3f7c4034689bdec9","node_id":"C_kwDOOYsS4doAKDkzNDFiMzgzMTBjNzM5NTdlMTMxM2VhYjNmN2M0MDM0Njg5YmRlYzk","commit":{"author":{"name":"efrazer-oai","email":"efrazer@openai.com","date":"2026-08-13T23:24:47Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T23:38:02Z"},"message":"Add experimental thread queue APIs to app server (#38456)\n\n## What changed\n\n- Add experimental `thread/queue/add`, `list`, `update`, `delete`, `reorder`, and `start` requests for persistent queued user submissions.\n- Automatically dispatch queued submissions in FIFO order after completed or failed turns, while leaving the queue paused after interruption.\n- Emit `thread/queue/changed` notifications and expose paginated queue contents with stable submission and client message IDs.\n- Export the new protocol types through the generated JSON Schema and TypeScript bindings.\n\n## Testing\n\n- Add app-server integration coverage for capability gating, CRUD, pagination, capacity limits, notifications, automatic dispatch, cold-thread resume, interruption, and explicit queue starts.\n\nGitOrigin-RevId: 89caf5577192199bda77cf6c372a59d26cdd910e","tree":{"sha":"ef744b2137c61e11baf879ff80684d11fe5bd10e","url":"https://api.github.com/repos/openai/codex/git/trees/ef744b2137c61e11baf879ff80684d11fe5bd10e"},"url":"https://api.github.com/repos/openai/codex/git/commits/9341b38310c73957e1313eab3f7c4034689bdec9","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/9341b38310c73957e1313eab3f7c4034689bdec9","html_url":"https://github.com/openai/codex/commit/9341b38310c73957e1313eab3f7c4034689bdec9","comments_url":"https://api.github.com/repos/openai/codex/commits/9341b38310c73957e1313eab3f7c4034689bdec9/comments","author":{"login":"efrazer-oai","id":263771262,"node_id":"U_kgDOD7jUfg","avatar_url":"https://avatars.githubusercontent.com/u/263771262?v=4","gravatar_id":"","url":"https://api.github.com/users/efrazer-oai","html_url":"https://github.com/efrazer-oai","followers_url":"https://api.github.com/users/efrazer-oai/followers","following_url":"https://api.github.com/users/efrazer-oai/following{/other_user}","gists_url":"https://api.github.com/users/efrazer-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/efrazer-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/efrazer-oai/subscriptions","organizations_url":"https://api.github.com/users/efrazer-oai/orgs","repos_url":"https://api.github.com/users/efrazer-oai/repos","events_url":"https://api.github.com/users/efrazer-oai/events{/privacy}","received_events_url":"https://api.github.com/users/efrazer-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4d9f3021c828facd6bc480036684484218e350b5","url":"https://api.github.com/repos/openai/codex/commits/4d9f3021c828facd6bc480036684484218e350b5","html_url":"https://github.com/openai/codex/commit/4d9f3021c828facd6bc480036684484218e350b5"}]},{"sha":"4d9f3021c828facd6bc480036684484218e350b5","node_id":"C_kwDOOYsS4doAKDRkOWYzMDIxYzgyOGZhY2Q2YmM0ODAwMzY2ODQ0ODQyMThlMzUwYjU","commit":{"author":{"name":"Ankush Gupta","email":"amgupt01@gmail.com","date":"2026-08-13T23:10:30Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T23:29:52Z"},"message":"Include node_repl images in Guardian review evidence (#38454)\n\n## What changed\n\n- Preserve valid image content from completed `node_repl` Code Mode responses alongside text evidence for Guardian reviews.\n- Enable multimodal evidence for models that require automatic `node_repl` review, or when both `guardian_enhanced_node_repl_transcripts` and `guardian_node_repl_transcript_images` are enabled.\n- Bound retained and rendered evidence, deduplicate images already present in review history, and fall back to text-only evidence when the reviewer lacks image support or prompt capacity.\n- Keep review evidence out of the parent turn input.\n\n## Testing\n\n- Cover feature gating, mixed text and image ordering, truncation and eviction, unsupported reviewers, prompt pressure, image detail normalization, and reused review sessions.\n\nGitOrigin-RevId: a3e482402f7b3484401b231dadc662e6e3504fdf","tree":{"sha":"0c2a8402df8098c8174ebac6b16f3ce7125ceba4","url":"https://api.github.com/repos/openai/codex/git/trees/0c2a8402df8098c8174ebac6b16f3ce7125ceba4"},"url":"https://api.github.com/repos/openai/codex/git/commits/4d9f3021c828facd6bc480036684484218e350b5","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4d9f3021c828facd6bc480036684484218e350b5","html_url":"https://github.com/openai/codex/commit/4d9f3021c828facd6bc480036684484218e350b5","comments_url":"https://api.github.com/repos/openai/codex/commits/4d9f3021c828facd6bc480036684484218e350b5/comments","author":{"login":"ankushg","id":227041,"node_id":"MDQ6VXNlcjIyNzA0MQ==","avatar_url":"https://avatars.githubusercontent.com/u/227041?v=4","gravatar_id":"","url":"https://api.github.com/users/ankushg","html_url":"https://github.com/ankushg","followers_url":"https://api.github.com/users/ankushg/followers","following_url":"https://api.github.com/users/ankushg/following{/other_user}","gists_url":"https://api.github.com/users/ankushg/gists{/gist_id}","starred_url":"https://api.github.com/users/ankushg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ankushg/subscriptions","organizations_url":"https://api.github.com/users/ankushg/orgs","repos_url":"https://api.github.com/users/ankushg/repos","events_url":"https://api.github.com/users/ankushg/events{/privacy}","received_events_url":"https://api.github.com/users/ankushg/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"1b4ea8b3bef397f26216411288eec7bf9bee33ac","url":"https://api.github.com/repos/openai/codex/commits/1b4ea8b3bef397f26216411288eec7bf9bee33ac","html_url":"https://github.com/openai/codex/commit/1b4ea8b3bef397f26216411288eec7bf9bee33ac"}]},{"sha":"1b4ea8b3bef397f26216411288eec7bf9bee33ac","node_id":"C_kwDOOYsS4doAKDFiNGVhOGIzYmVmMzk3ZjI2MjE2NDExMjg4ZWVjN2JmOWJlZTMzYWM","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-08-13T23:08:32Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T23:13:37Z"},"message":"Add structured telemetry for response retries (#38452)\n\n## What changed\n\n- Emit trace-safe `codex.retry` events immediately before retry delays, including the attempt number, selected delay, retry layer, and operation.\n- Cover HTTP requests, sampling streams, remote compaction, and sampling connection recovery. Track connection-recovery attempts separately from the stream retry budget.\n- Add integration coverage for retry timing and terminal behavior across HTTP, SSE, WebSocket, and remote-compaction paths, including rate limits, overloads, connection failures, and `Retry-After` inputs.\n\nGitOrigin-RevId: dae38900a0579cf8ba062c3f3d90ee61851c1c99","tree":{"sha":"dafc5301bde53b9912b8d50754775280486ee5fa","url":"https://api.github.com/repos/openai/codex/git/trees/dafc5301bde53b9912b8d50754775280486ee5fa"},"url":"https://api.github.com/repos/openai/codex/git/commits/1b4ea8b3bef397f26216411288eec7bf9bee33ac","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/1b4ea8b3bef397f26216411288eec7bf9bee33ac","html_url":"https://github.com/openai/codex/commit/1b4ea8b3bef397f26216411288eec7bf9bee33ac","comments_url":"https://api.github.com/repos/openai/codex/commits/1b4ea8b3bef397f26216411288eec7bf9bee33ac/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"813dc5f08d771d351e1da7f00eace464ffe43263","url":"https://api.github.com/repos/openai/codex/commits/813dc5f08d771d351e1da7f00eace464ffe43263","html_url":"https://github.com/openai/codex/commit/813dc5f08d771d351e1da7f00eace464ffe43263"}]},{"sha":"813dc5f08d771d351e1da7f00eace464ffe43263","node_id":"C_kwDOOYsS4doAKDgxM2RjNWYwOGQ3NzFkMzUxZTFkYTdmMDBlYWNlNDY0ZmZlNDMyNjM","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-08-13T22:58:38Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T23:04:38Z"},"message":"Embed the Windows sandbox setup manifest in Bazel builds (#38450)\n\n## Why\n\n`rules_rust` drops the build script's per-binary linker directives, so Bazel\nbuilds can omit the `asInvoker` manifest from the Windows sandbox setup helper.\n\n## What changed\n\n- Add per-binary compile data and Rust flags to `codex_rust_crate` so linker\n  inputs remain scoped to the setup helper.\n- Embed the manifest directly for MSVC builds and compile it into a resource\n  with hermetic LLVM tooling for GNU/LLVM cross-builds.\n- Disable the redundant build script under Bazel and avoid duplicating binary\n  runfiles in integration test data.\n\n## Testing\n\nAdd a Windows integration test that loads the setup executable's manifest\nresource and verifies that it requests `asInvoker` execution with UI access\ndisabled.\n\nGitOrigin-RevId: a77e7e627ee43810f5eaf7701bb4909bf855216b","tree":{"sha":"e3ac1ec9ee8f4956bec389ce801d56de359b68f8","url":"https://api.github.com/repos/openai/codex/git/trees/e3ac1ec9ee8f4956bec389ce801d56de359b68f8"},"url":"https://api.github.com/repos/openai/codex/git/commits/813dc5f08d771d351e1da7f00eace464ffe43263","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/813dc5f08d771d351e1da7f00eace464ffe43263","html_url":"https://github.com/openai/codex/commit/813dc5f08d771d351e1da7f00eace464ffe43263","comments_url":"https://api.github.com/repos/openai/codex/commits/813dc5f08d771d351e1da7f00eace464ffe43263/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"5cc65ecb9831917397b9728b708880132d0d58ce","url":"https://api.github.com/repos/openai/codex/commits/5cc65ecb9831917397b9728b708880132d0d58ce","html_url":"https://github.com/openai/codex/commit/5cc65ecb9831917397b9728b708880132d0d58ce"}]},{"sha":"5cc65ecb9831917397b9728b708880132d0d58ce","node_id":"C_kwDOOYsS4doAKDVjYzY1ZWNiOTgzMTkxNzM5N2I5NzI4YjcwODg4MDEzMmQwZDU4Y2U","commit":{"author":{"name":"Shijie Rao","email":"shijie.rao@openai.com","date":"2026-08-13T22:49:56Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T22:59:54Z"},"message":"Expose model upgrade retirement times (#38449)\n\n## What changed\n\n- Parse the optional `retirement_at` RFC 3339 value from model upgrade metadata, treating missing, null, or malformed values as unknown.\n- Expose known retirement times from `model/list` as nullable Unix timestamps in `upgradeInfo.retirementAt` and preserve them when converting app-server models back into model presets.\n- Update the generated protocol schemas and app-server documentation.\n\n## Testing\n\n- Cover absent, null, valid, and malformed catalog values.\n- Verify `model/list` serialization and app-server model conversion for known, missing, and out-of-range timestamps.\n\nGitOrigin-RevId: 969baf9f5b012997f460fb4611ba63c963ee658c","tree":{"sha":"6d25efc4fb1ea5d46a2738c1d4ddfa3223246248","url":"https://api.github.com/repos/openai/codex/git/trees/6d25efc4fb1ea5d46a2738c1d4ddfa3223246248"},"url":"https://api.github.com/repos/openai/codex/git/commits/5cc65ecb9831917397b9728b708880132d0d58ce","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/5cc65ecb9831917397b9728b708880132d0d58ce","html_url":"https://github.com/openai/codex/commit/5cc65ecb9831917397b9728b708880132d0d58ce","comments_url":"https://api.github.com/repos/openai/codex/commits/5cc65ecb9831917397b9728b708880132d0d58ce/comments","author":{"login":"shijie-oai","id":235382242,"node_id":"U_kgDODgel4g","avatar_url":"https://avatars.githubusercontent.com/u/235382242?v=4","gravatar_id":"","url":"https://api.github.com/users/shijie-oai","html_url":"https://github.com/shijie-oai","followers_url":"https://api.github.com/users/shijie-oai/followers","following_url":"https://api.github.com/users/shijie-oai/following{/other_user}","gists_url":"https://api.github.com/users/shijie-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/shijie-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shijie-oai/subscriptions","organizations_url":"https://api.github.com/users/shijie-oai/orgs","repos_url":"https://api.github.com/users/shijie-oai/repos","events_url":"https://api.github.com/users/shijie-oai/events{/privacy}","received_events_url":"https://api.github.com/users/shijie-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"1da59ad257115cc5734e6781d5ac0b4f08a6e064","url":"https://api.github.com/repos/openai/codex/commits/1da59ad257115cc5734e6781d5ac0b4f08a6e064","html_url":"https://github.com/openai/codex/commit/1da59ad257115cc5734e6781d5ac0b4f08a6e064"}]},{"sha":"1da59ad257115cc5734e6781d5ac0b4f08a6e064","node_id":"C_kwDOOYsS4doAKDFkYTU5YWQyNTcxMTVjYzU3MzRlNjc4MWQ1YWMwYjRmMDhhNmUwNjQ","commit":{"author":{"name":"willwang-openai","email":"willwang@openai.com","date":"2026-08-13T22:23:22Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T22:42:12Z"},"message":"Support per-server MCP OAuth callback ports (#38448)\n\n## What changed\n\n- Add `oauth.callback_port` to MCP server configuration and preserve it when\n  serializing configuration edits.\n- Accept `oauth.callbackPort` from plugin MCP declarations and skill dependency\n  metadata.\n- Prefer the server-specific callback port over `mcp_oauth_callback_port` for\n  CLI login, app-server, plugin installation, executor, and skill dependency\n  OAuth flows.\n\n## Testing\n\n- Cover configuration parsing, serialization, and fallback behavior.\n- Verify plugin, executor, and skill OAuth registrations use their configured\n  callback ports instead of the global port.\n\nGitOrigin-RevId: 7f65e5e7869358307e49779f1b75e8672b607736","tree":{"sha":"59c31353e168e6346aff0eb754fa54da87c50144","url":"https://api.github.com/repos/openai/codex/git/trees/59c31353e168e6346aff0eb754fa54da87c50144"},"url":"https://api.github.com/repos/openai/codex/git/commits/1da59ad257115cc5734e6781d5ac0b4f08a6e064","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/1da59ad257115cc5734e6781d5ac0b4f08a6e064","html_url":"https://github.com/openai/codex/commit/1da59ad257115cc5734e6781d5ac0b4f08a6e064","comments_url":"https://api.github.com/repos/openai/codex/commits/1da59ad257115cc5734e6781d5ac0b4f08a6e064/comments","author":{"login":"willwang-openai","id":189043618,"node_id":"U_kgDOC0STog","avatar_url":"https://avatars.githubusercontent.com/u/189043618?v=4","gravatar_id":"","url":"https://api.github.com/users/willwang-openai","html_url":"https://github.com/willwang-openai","followers_url":"https://api.github.com/users/willwang-openai/followers","following_url":"https://api.github.com/users/willwang-openai/following{/other_user}","gists_url":"https://api.github.com/users/willwang-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/willwang-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/willwang-openai/subscriptions","organizations_url":"https://api.github.com/users/willwang-openai/orgs","repos_url":"https://api.github.com/users/willwang-openai/repos","events_url":"https://api.github.com/users/willwang-openai/events{/privacy}","received_events_url":"https://api.github.com/users/willwang-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"ca83f7908ca3c0184d2b7062c7bf2a0cff2d659f","url":"https://api.github.com/repos/openai/codex/commits/ca83f7908ca3c0184d2b7062c7bf2a0cff2d659f","html_url":"https://github.com/openai/codex/commit/ca83f7908ca3c0184d2b7062c7bf2a0cff2d659f"}]},{"sha":"ca83f7908ca3c0184d2b7062c7bf2a0cff2d659f","node_id":"C_kwDOOYsS4doAKGNhODNmNzkwOGNhM2MwMTg0ZDJiNzA2MmM3YmYyYTBjZmYyZDY1OWY","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-13T22:20:33Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T22:38:46Z"},"message":"Add running-task exit choices to local daemon sessions (#38447)\n\n## What changed\n\nWhen `Ctrl-C` is pressed with an empty composer while a task is running in a local daemon session, show a menu that lets the user:\n\n- cancel the task and stay in Codex;\n- exit Codex while leaving the task running; or\n- stop the task and exit Codex.\n\nDo not offer background execution for side-thread tasks or when follow-up messages are queued. Preserve existing `Ctrl-C` behavior for non-daemon sessions, drafts, paste bursts, MCP startup, and returning from an active side thread.\n\n## Testing\n\nAdd TUI tests for each exit action, menu dismissal, side threads, queued follow-ups, composer input, MCP startup, and non-daemon sessions.\n\nGitOrigin-RevId: 539c33d3a4ff288a015bddbe9465d2bbdbe018d0","tree":{"sha":"70f3c8f15e07a68ffaaa3aa06438694eb8ad854a","url":"https://api.github.com/repos/openai/codex/git/trees/70f3c8f15e07a68ffaaa3aa06438694eb8ad854a"},"url":"https://api.github.com/repos/openai/codex/git/commits/ca83f7908ca3c0184d2b7062c7bf2a0cff2d659f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/ca83f7908ca3c0184d2b7062c7bf2a0cff2d659f","html_url":"https://github.com/openai/codex/commit/ca83f7908ca3c0184d2b7062c7bf2a0cff2d659f","comments_url":"https://api.github.com/repos/openai/codex/commits/ca83f7908ca3c0184d2b7062c7bf2a0cff2d659f/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"6344a655a5966f92e009a74928fb0559b41f9093","url":"https://api.github.com/repos/openai/codex/commits/6344a655a5966f92e009a74928fb0559b41f9093","html_url":"https://github.com/openai/codex/commit/6344a655a5966f92e009a74928fb0559b41f9093"}]},{"sha":"6344a655a5966f92e009a74928fb0559b41f9093","node_id":"C_kwDOOYsS4doAKDYzNDRhNjU1YTU5NjZmOTJlMDA5YTc0OTI4ZmIwNTU5YjQxZjkwOTM","commit":{"author":{"name":"rka-oai","email":"rka@openai.com","date":"2026-08-13T22:16:10Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T22:30:59Z"},"message":"Refresh current-time reminders for full-history subagents (#38446)\n\n## What changed\n\n- Exclude current-time reminder developer messages when copying parent history into a full-history subagent.\n- Keep the child's newly generated reminder, preventing inherited reminders from accumulating while preserving the rest of the forked context.\n\n## Testing\n\n- Extend the full-history V2 spawn test to verify that two reminders in the parent become one fresh reminder in the child request.\n\nGitOrigin-RevId: fb61c72f7f0d61d1068f2c599a8b8caf1788b7e2","tree":{"sha":"6cbb17cbebc88e09ab5c1eea0496eac049870b1d","url":"https://api.github.com/repos/openai/codex/git/trees/6cbb17cbebc88e09ab5c1eea0496eac049870b1d"},"url":"https://api.github.com/repos/openai/codex/git/commits/6344a655a5966f92e009a74928fb0559b41f9093","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/6344a655a5966f92e009a74928fb0559b41f9093","html_url":"https://github.com/openai/codex/commit/6344a655a5966f92e009a74928fb0559b41f9093","comments_url":"https://api.github.com/repos/openai/codex/commits/6344a655a5966f92e009a74928fb0559b41f9093/comments","author":{"login":"rka-oai","id":240799229,"node_id":"U_kgDODlpN_Q","avatar_url":"https://avatars.githubusercontent.com/u/240799229?v=4","gravatar_id":"","url":"https://api.github.com/users/rka-oai","html_url":"https://github.com/rka-oai","followers_url":"https://api.github.com/users/rka-oai/followers","following_url":"https://api.github.com/users/rka-oai/following{/other_user}","gists_url":"https://api.github.com/users/rka-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rka-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rka-oai/subscriptions","organizations_url":"https://api.github.com/users/rka-oai/orgs","repos_url":"https://api.github.com/users/rka-oai/repos","events_url":"https://api.github.com/users/rka-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rka-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"bff03ecce582d55ff62d8ee37e576b63c24bc0a9","url":"https://api.github.com/repos/openai/codex/commits/bff03ecce582d55ff62d8ee37e576b63c24bc0a9","html_url":"https://github.com/openai/codex/commit/bff03ecce582d55ff62d8ee37e576b63c24bc0a9"}]},{"sha":"bff03ecce582d55ff62d8ee37e576b63c24bc0a9","node_id":"C_kwDOOYsS4doAKGJmZjAzZWNjZTU4MmQ1NWZmNjJkOGVlMzdlNTc2YjYzYzI0YmMwYTk","commit":{"author":{"name":"rka-oai","email":"rka@openai.com","date":"2026-08-13T22:02:50Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T22:21:18Z"},"message":"Retain client developer messages across context compaction (#38445)\n\n## Why\n\nClient-authored developer instructions should remain available after a context\nwindow is compacted when `retain_client_developer_messages` is enabled.\n\n## What changed\n\n- Preserve annotated client-authored developer messages during remote compaction\n  v2 and local token-budget context resets.\n- Apply the existing retained-message token budget when carrying those messages\n  into the new context window.\n\n## Testing\n\n- Cover enabled and disabled retention for remote compaction v2, manual\n  token-budget compaction, and mid-turn automatic compaction.\n\nGitOrigin-RevId: 4cb3782cb86ef46458413a17a3255d0016fd675f","tree":{"sha":"f02c98f45cec88568b3503319f6a09b9f1a0e57a","url":"https://api.github.com/repos/openai/codex/git/trees/f02c98f45cec88568b3503319f6a09b9f1a0e57a"},"url":"https://api.github.com/repos/openai/codex/git/commits/bff03ecce582d55ff62d8ee37e576b63c24bc0a9","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/bff03ecce582d55ff62d8ee37e576b63c24bc0a9","html_url":"https://github.com/openai/codex/commit/bff03ecce582d55ff62d8ee37e576b63c24bc0a9","comments_url":"https://api.github.com/repos/openai/codex/commits/bff03ecce582d55ff62d8ee37e576b63c24bc0a9/comments","author":{"login":"rka-oai","id":240799229,"node_id":"U_kgDODlpN_Q","avatar_url":"https://avatars.githubusercontent.com/u/240799229?v=4","gravatar_id":"","url":"https://api.github.com/users/rka-oai","html_url":"https://github.com/rka-oai","followers_url":"https://api.github.com/users/rka-oai/followers","following_url":"https://api.github.com/users/rka-oai/following{/other_user}","gists_url":"https://api.github.com/users/rka-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rka-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rka-oai/subscriptions","organizations_url":"https://api.github.com/users/rka-oai/orgs","repos_url":"https://api.github.com/users/rka-oai/repos","events_url":"https://api.github.com/users/rka-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rka-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"3ba52d6075bb69795d008d427139c28fdebdb436","url":"https://api.github.com/repos/openai/codex/commits/3ba52d6075bb69795d008d427139c28fdebdb436","html_url":"https://github.com/openai/codex/commit/3ba52d6075bb69795d008d427139c28fdebdb436"}]},{"sha":"3ba52d6075bb69795d008d427139c28fdebdb436","node_id":"C_kwDOOYsS4doAKDNiYTUyZDYwNzViYjY5Nzk1ZDAwOGQ0MjcxMzljMjhmZGViZGI0MzY","commit":{"author":{"name":"rka-oai","email":"rka@openai.com","date":"2026-08-13T21:46:31Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T21:53:52Z"},"message":"Tag current time reminders in model context (#38443)\n\n## What changed\n\n- Wrap injected current time reminders in `<current_time_reminder>` tags.\n- Keep direct `clock.curr_time` tool output and log previews as plain text.\n\n## Testing\n\n- Update core and app-server coverage for tagged reminders and untagged tool output.\n\nGitOrigin-RevId: ad27f1fa10cca7f83d1ac731e01255320bb60f47","tree":{"sha":"29e0b8fea4716b5e3783351dc48bad79c88d1ee2","url":"https://api.github.com/repos/openai/codex/git/trees/29e0b8fea4716b5e3783351dc48bad79c88d1ee2"},"url":"https://api.github.com/repos/openai/codex/git/commits/3ba52d6075bb69795d008d427139c28fdebdb436","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/3ba52d6075bb69795d008d427139c28fdebdb436","html_url":"https://github.com/openai/codex/commit/3ba52d6075bb69795d008d427139c28fdebdb436","comments_url":"https://api.github.com/repos/openai/codex/commits/3ba52d6075bb69795d008d427139c28fdebdb436/comments","author":{"login":"rka-oai","id":240799229,"node_id":"U_kgDODlpN_Q","avatar_url":"https://avatars.githubusercontent.com/u/240799229?v=4","gravatar_id":"","url":"https://api.github.com/users/rka-oai","html_url":"https://github.com/rka-oai","followers_url":"https://api.github.com/users/rka-oai/followers","following_url":"https://api.github.com/users/rka-oai/following{/other_user}","gists_url":"https://api.github.com/users/rka-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rka-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rka-oai/subscriptions","organizations_url":"https://api.github.com/users/rka-oai/orgs","repos_url":"https://api.github.com/users/rka-oai/repos","events_url":"https://api.github.com/users/rka-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rka-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"53eaa297e595fc98df0f33d4c63686a7014d7c9a","url":"https://api.github.com/repos/openai/codex/commits/53eaa297e595fc98df0f33d4c63686a7014d7c9a","html_url":"https://github.com/openai/codex/commit/53eaa297e595fc98df0f33d4c63686a7014d7c9a"}]},{"sha":"53eaa297e595fc98df0f33d4c63686a7014d7c9a","node_id":"C_kwDOOYsS4doAKDUzZWFhMjk3ZTU5NWZjOThkZjBmMzNkNGM2MzY4NmE3MDE0ZDdjOWE","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-13T21:43:53Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T21:49:32Z"},"message":"Give Guardian V2 full tool action context (#38441)\n\n## Why\n\nGuardian V2 needs the requested action and its conversation context to assess\nrisk; a tool name and call ID alone do not describe what the tool will do.\n\n## What changed\n\n- Expose the original, pre-hook `ToolPayload` to tool lifecycle contributors.\n- Build Guardian V2 classifier input from the bounded conversation transcript\n  and a structured planned-action object containing the tool name and arguments.\n- Warn and skip classification if the planned action cannot be serialized.\n\n## Testing\n\n- Verify lifecycle contributors receive tool arguments.\n- Verify Guardian V2 sends transcript history and planned-action JSON to the\n  classifier.\n\nGitOrigin-RevId: 28266ef7c1d2267ba705fcfbd9be4ef48e64e104","tree":{"sha":"bbac9c6415b1e74722dc8b660843708be7c2c434","url":"https://api.github.com/repos/openai/codex/git/trees/bbac9c6415b1e74722dc8b660843708be7c2c434"},"url":"https://api.github.com/repos/openai/codex/git/commits/53eaa297e595fc98df0f33d4c63686a7014d7c9a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/53eaa297e595fc98df0f33d4c63686a7014d7c9a","html_url":"https://github.com/openai/codex/commit/53eaa297e595fc98df0f33d4c63686a7014d7c9a","comments_url":"https://api.github.com/repos/openai/codex/commits/53eaa297e595fc98df0f33d4c63686a7014d7c9a/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4343b2bdc4e7eb95880a230e588bd07d9f181c2f","url":"https://api.github.com/repos/openai/codex/commits/4343b2bdc4e7eb95880a230e588bd07d9f181c2f","html_url":"https://github.com/openai/codex/commit/4343b2bdc4e7eb95880a230e588bd07d9f181c2f"}]},{"sha":"4343b2bdc4e7eb95880a230e588bd07d9f181c2f","node_id":"C_kwDOOYsS4doAKDQzNDNiMmJkYzRlN2ViOTU4ODBhMjMwZTU4OGJkMDdkOWYxODFjMmY","commit":{"author":{"name":"Owen Lin","email":"owen@openai.com","date":"2026-08-13T21:40:41Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T21:45:02Z"},"message":"Add app-server support for reverting paginated threads (#38440)\n\n## What changed\n\n- Add the experimental `thread/revert` request, which replaces a loaded paginated thread's durable history with the prefix before `beforeTurnId` while preserving the thread ID.\n- Interrupt any active turn, reload the replacement history without unloading the thread, preserve mutable thread settings, and emit `thread/reverted`.\n- Return backward pagination cursors for the retained turns and items, reject stale rollout paths after a revert, and document that local file changes are unaffected.\n\n## Testing\n\n- Cover history replacement, pagination, stale paths, missing turns, subsequent turns, active-turn interruption, and preserved thread settings.\n\nGitOrigin-RevId: 435a8163ad4f310cc47219b436f6bdde21f2b83a","tree":{"sha":"a4c3bae8caeba49b532a91a61dcaade3609c73ae","url":"https://api.github.com/repos/openai/codex/git/trees/a4c3bae8caeba49b532a91a61dcaade3609c73ae"},"url":"https://api.github.com/repos/openai/codex/git/commits/4343b2bdc4e7eb95880a230e588bd07d9f181c2f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4343b2bdc4e7eb95880a230e588bd07d9f181c2f","html_url":"https://github.com/openai/codex/commit/4343b2bdc4e7eb95880a230e588bd07d9f181c2f","comments_url":"https://api.github.com/repos/openai/codex/commits/4343b2bdc4e7eb95880a230e588bd07d9f181c2f/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"1992f8c0183c6990c82649ef974913cb15a6eef5","url":"https://api.github.com/repos/openai/codex/commits/1992f8c0183c6990c82649ef974913cb15a6eef5","html_url":"https://github.com/openai/codex/commit/1992f8c0183c6990c82649ef974913cb15a6eef5"}]},{"sha":"1992f8c0183c6990c82649ef974913cb15a6eef5","node_id":"C_kwDOOYsS4doAKDE5OTJmOGMwMTgzYzY5OTBjODI2NDllZjk3NDkxM2NiMTVhNmVlZjU","commit":{"author":{"name":"viyatb-oai","email":"viyatb@openai.com","date":"2026-08-13T21:35:40Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T21:40:42Z"},"message":"Preserve approval policies for auto-reviewed models (#38439)\n\n## What changed\n\n- Keep the configured `approvalPolicy` when a model in\n  `auto_review.required_on_models` selects the `auto_review` reviewer.\n- Continue downgrading full-access sessions to workspace-write and rejecting\n  incompatible reviewer overrides.\n\n## Testing\n\n- Cover supported approval policies across thread start, settings updates,\n  turn-time model switches, resume, and fork flows.\n\nGitOrigin-RevId: 2bd3e2dcd46f3cadeb2fad20222cf8917c267208","tree":{"sha":"a3ed48e934bba6bb0617f1ea4c2d94b9d1f962ca","url":"https://api.github.com/repos/openai/codex/git/trees/a3ed48e934bba6bb0617f1ea4c2d94b9d1f962ca"},"url":"https://api.github.com/repos/openai/codex/git/commits/1992f8c0183c6990c82649ef974913cb15a6eef5","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/1992f8c0183c6990c82649ef974913cb15a6eef5","html_url":"https://github.com/openai/codex/commit/1992f8c0183c6990c82649ef974913cb15a6eef5","comments_url":"https://api.github.com/repos/openai/codex/commits/1992f8c0183c6990c82649ef974913cb15a6eef5/comments","author":{"login":"viyatb-oai","id":234056686,"node_id":"U_kgDODfNr7g","avatar_url":"https://avatars.githubusercontent.com/u/234056686?v=4","gravatar_id":"","url":"https://api.github.com/users/viyatb-oai","html_url":"https://github.com/viyatb-oai","followers_url":"https://api.github.com/users/viyatb-oai/followers","following_url":"https://api.github.com/users/viyatb-oai/following{/other_user}","gists_url":"https://api.github.com/users/viyatb-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/viyatb-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/viyatb-oai/subscriptions","organizations_url":"https://api.github.com/users/viyatb-oai/orgs","repos_url":"https://api.github.com/users/viyatb-oai/repos","events_url":"https://api.github.com/users/viyatb-oai/events{/privacy}","received_events_url":"https://api.github.com/users/viyatb-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"b87327f4e594759f1f1af76d151777d8676fb0cc","url":"https://api.github.com/repos/openai/codex/commits/b87327f4e594759f1f1af76d151777d8676fb0cc","html_url":"https://github.com/openai/codex/commit/b87327f4e594759f1f1af76d151777d8676fb0cc"}]},{"sha":"b87327f4e594759f1f1af76d151777d8676fb0cc","node_id":"C_kwDOOYsS4doAKGI4NzMyN2Y0ZTU5NDc1OWYxZjFhZjc2ZDE1MTc3N2Q4Njc2ZmIwY2M","commit":{"author":{"name":"Celia Chen","email":"celia@openai.com","date":"2026-08-13T21:08:10Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T21:13:07Z"},"message":"Add rustls fallback for local MCP HTTP requests (#38436)\n\n## Why\n\nLocal MCP requests can fail when the platform TLS backend cannot negotiate a\nprotocol version with an HTTPS endpoint.\n\n## What changed\n\n- Retry replayable local MCP requests once with rustls after a recognized TLS\n  protocol-version negotiation failure. Keep certificate, timeout, and unrelated\n  connection failures on the existing error path.\n- Remember successful fallback per HTTPS origin and outbound route, while keeping\n  the platform TLS backend as the default for other destinations.\n- Share the fallback-enabled client across local MCP resolution, CLI login, and\n  OAuth discovery while preserving remote environment HTTP clients.\n\n## Testing\n\nAdded coverage for platform-specific error detection, request replay, cached\nfallback reuse and isolation, non-replayable requests, redirects, and remote MCP\nclient selection.\n\nGitOrigin-RevId: 39a2d96fdb2ea0e51df14f652ba2a953d24e69a1","tree":{"sha":"6fb2eb7aff4068215a0be3e3f7885b8a1317e061","url":"https://api.github.com/repos/openai/codex/git/trees/6fb2eb7aff4068215a0be3e3f7885b8a1317e061"},"url":"https://api.github.com/repos/openai/codex/git/commits/b87327f4e594759f1f1af76d151777d8676fb0cc","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/b87327f4e594759f1f1af76d151777d8676fb0cc","html_url":"https://github.com/openai/codex/commit/b87327f4e594759f1f1af76d151777d8676fb0cc","comments_url":"https://api.github.com/repos/openai/codex/commits/b87327f4e594759f1f1af76d151777d8676fb0cc/comments","author":{"login":"celia-oai","id":209693228,"node_id":"U_kgDODH-qLA","avatar_url":"https://avatars.githubusercontent.com/u/209693228?v=4","gravatar_id":"","url":"https://api.github.com/users/celia-oai","html_url":"https://github.com/celia-oai","followers_url":"https://api.github.com/users/celia-oai/followers","following_url":"https://api.github.com/users/celia-oai/following{/other_user}","gists_url":"https://api.github.com/users/celia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/celia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celia-oai/subscriptions","organizations_url":"https://api.github.com/users/celia-oai/orgs","repos_url":"https://api.github.com/users/celia-oai/repos","events_url":"https://api.github.com/users/celia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/celia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"93327c852a1fd9347cacf8fce268d793e6503d1b","url":"https://api.github.com/repos/openai/codex/commits/93327c852a1fd9347cacf8fce268d793e6503d1b","html_url":"https://github.com/openai/codex/commit/93327c852a1fd9347cacf8fce268d793e6503d1b"}]},{"sha":"93327c852a1fd9347cacf8fce268d793e6503d1b","node_id":"C_kwDOOYsS4doAKDkzMzI3Yzg1MmExZmQ5MzQ3Y2FjZjhmY2UyNjhkNzkzZTY1MDNkMWI","commit":{"author":{"name":"Ankush Gupta","email":"amgupt01@gmail.com","date":"2026-08-13T20:37:43Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T20:43:13Z"},"message":"Gate Node REPL Guardian guidance on model metadata (#38432)\n\n## What changed\n\n- Use the specialized Node REPL approval guidance only when the parent turn's\n  model sets `node_repl_auto_review_required`.\n- Keep Node REPL JavaScript requests on the generic approval prompt otherwise.\n- Cover both prompt paths in the Guardian tests.\n\nGitOrigin-RevId: e3eb89a59cc74fe2b53bb1c3f29a30d450e173de","tree":{"sha":"61886f293bd9d7aa32451a675f67e80266323213","url":"https://api.github.com/repos/openai/codex/git/trees/61886f293bd9d7aa32451a675f67e80266323213"},"url":"https://api.github.com/repos/openai/codex/git/commits/93327c852a1fd9347cacf8fce268d793e6503d1b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/93327c852a1fd9347cacf8fce268d793e6503d1b","html_url":"https://github.com/openai/codex/commit/93327c852a1fd9347cacf8fce268d793e6503d1b","comments_url":"https://api.github.com/repos/openai/codex/commits/93327c852a1fd9347cacf8fce268d793e6503d1b/comments","author":{"login":"ankushg","id":227041,"node_id":"MDQ6VXNlcjIyNzA0MQ==","avatar_url":"https://avatars.githubusercontent.com/u/227041?v=4","gravatar_id":"","url":"https://api.github.com/users/ankushg","html_url":"https://github.com/ankushg","followers_url":"https://api.github.com/users/ankushg/followers","following_url":"https://api.github.com/users/ankushg/following{/other_user}","gists_url":"https://api.github.com/users/ankushg/gists{/gist_id}","starred_url":"https://api.github.com/users/ankushg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ankushg/subscriptions","organizations_url":"https://api.github.com/users/ankushg/orgs","repos_url":"https://api.github.com/users/ankushg/repos","events_url":"https://api.github.com/users/ankushg/events{/privacy}","received_events_url":"https://api.github.com/users/ankushg/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"f898ebcafdeb0052abc844d9e11b5e754b8ec4af","url":"https://api.github.com/repos/openai/codex/commits/f898ebcafdeb0052abc844d9e11b5e754b8ec4af","html_url":"https://github.com/openai/codex/commit/f898ebcafdeb0052abc844d9e11b5e754b8ec4af"}]},{"sha":"f898ebcafdeb0052abc844d9e11b5e754b8ec4af","node_id":"C_kwDOOYsS4doAKGY4OThlYmNhZmRlYjAwNTJhYmM4NDRkOWUxMWI1ZTc1NGI4ZWM0YWY","commit":{"author":{"name":"willwang-openai","email":"willwang@openai.com","date":"2026-08-13T20:14:07Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T20:20:01Z"},"message":"Route curated plugin catalogs by authentication mode (#38429)\n\n## Why\n\nThe model provider does not reliably identify which curated plugin catalog is\navailable. ChatGPT authentication can be used with a custom provider, while an\nunauthenticated session should use the API-compatible catalog regardless of its\nprovider.\n\n## What changed\n\n- Select the ChatGPT curated catalog only for authentication modes that use the\n  Codex backend; use the API curated catalog for API-key and unauthenticated\n  sessions.\n- Initialize standalone plugin managers with the current authentication mode\n  across CLI, app-server, MCP, and external-agent migration paths.\n- Preserve authentication mode while detecting and importing migrated plugins.\n\n## Testing\n\n- Cover catalog and skill routing across ChatGPT, API-key, unauthenticated,\n  Bedrock, and custom-provider configurations.\n- Verify authenticated plugin migration uses the ChatGPT curated marketplace.\n\nGitOrigin-RevId: 660a339ee8891c33aad961078d3a979242a6a166","tree":{"sha":"1a70a5520411f0d61d42d22b48c118dc079587c7","url":"https://api.github.com/repos/openai/codex/git/trees/1a70a5520411f0d61d42d22b48c118dc079587c7"},"url":"https://api.github.com/repos/openai/codex/git/commits/f898ebcafdeb0052abc844d9e11b5e754b8ec4af","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/f898ebcafdeb0052abc844d9e11b5e754b8ec4af","html_url":"https://github.com/openai/codex/commit/f898ebcafdeb0052abc844d9e11b5e754b8ec4af","comments_url":"https://api.github.com/repos/openai/codex/commits/f898ebcafdeb0052abc844d9e11b5e754b8ec4af/comments","author":{"login":"willwang-openai","id":189043618,"node_id":"U_kgDOC0STog","avatar_url":"https://avatars.githubusercontent.com/u/189043618?v=4","gravatar_id":"","url":"https://api.github.com/users/willwang-openai","html_url":"https://github.com/willwang-openai","followers_url":"https://api.github.com/users/willwang-openai/followers","following_url":"https://api.github.com/users/willwang-openai/following{/other_user}","gists_url":"https://api.github.com/users/willwang-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/willwang-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/willwang-openai/subscriptions","organizations_url":"https://api.github.com/users/willwang-openai/orgs","repos_url":"https://api.github.com/users/willwang-openai/repos","events_url":"https://api.github.com/users/willwang-openai/events{/privacy}","received_events_url":"https://api.github.com/users/willwang-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"507ef0b3715d2427326ac090d8818e8dcba5efc0","url":"https://api.github.com/repos/openai/codex/commits/507ef0b3715d2427326ac090d8818e8dcba5efc0","html_url":"https://github.com/openai/codex/commit/507ef0b3715d2427326ac090d8818e8dcba5efc0"}]},{"sha":"507ef0b3715d2427326ac090d8818e8dcba5efc0","node_id":"C_kwDOOYsS4doAKDUwN2VmMGIzNzE1ZDI0MjczMjZhYzA5MGQ4ODE4ZThkY2JhNWVmYzA","commit":{"author":{"name":"socrates-oai","email":"socrates@openai.com","date":"2026-08-13T20:05:38Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T20:11:38Z"},"message":"Add Guardian guidance for Node REPL tool calls (#38427)\n\n## Why\n\nJavaScript executed through the Node REPL can invoke connected MCP, browser,\nor computer-use tools, so reviewing only the outer tool call does not capture\nits immediate effects.\n\n## What changed\n\n- Add dedicated Guardian review guidance for `node_repl` `js` requests that\n  evaluates nested calls, authorization boundaries, staged data, and concrete\n  side effects.\n- Keep the existing generic approval prompt for other MCP tools and shell\n  requests.\n\n## Testing\n\n- Cover the dedicated Node REPL prompt, retry reasons, serialized request data,\n  and the generic fallback behavior.\n\nGitOrigin-RevId: bf8d49d7e3dc3d36aa41b6b56ff8a0eb02da3e53","tree":{"sha":"b384d5345ec0abd8d32c52274efcf89f1976c0fd","url":"https://api.github.com/repos/openai/codex/git/trees/b384d5345ec0abd8d32c52274efcf89f1976c0fd"},"url":"https://api.github.com/repos/openai/codex/git/commits/507ef0b3715d2427326ac090d8818e8dcba5efc0","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/507ef0b3715d2427326ac090d8818e8dcba5efc0","html_url":"https://github.com/openai/codex/commit/507ef0b3715d2427326ac090d8818e8dcba5efc0","comments_url":"https://api.github.com/repos/openai/codex/commits/507ef0b3715d2427326ac090d8818e8dcba5efc0/comments","author":{"login":"socrates-oai","id":212622858,"node_id":"U_kgDODKxeCg","avatar_url":"https://avatars.githubusercontent.com/u/212622858?v=4","gravatar_id":"","url":"https://api.github.com/users/socrates-oai","html_url":"https://github.com/socrates-oai","followers_url":"https://api.github.com/users/socrates-oai/followers","following_url":"https://api.github.com/users/socrates-oai/following{/other_user}","gists_url":"https://api.github.com/users/socrates-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/socrates-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/socrates-oai/subscriptions","organizations_url":"https://api.github.com/users/socrates-oai/orgs","repos_url":"https://api.github.com/users/socrates-oai/repos","events_url":"https://api.github.com/users/socrates-oai/events{/privacy}","received_events_url":"https://api.github.com/users/socrates-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"5ed321ce0029614c7277f671c12fb5ea7a30ea6a","url":"https://api.github.com/repos/openai/codex/commits/5ed321ce0029614c7277f671c12fb5ea7a30ea6a","html_url":"https://github.com/openai/codex/commit/5ed321ce0029614c7277f671c12fb5ea7a30ea6a"}]},{"sha":"5ed321ce0029614c7277f671c12fb5ea7a30ea6a","node_id":"C_kwDOOYsS4doAKDVlZDMyMWNlMDAyOTYxNGM3Mjc3ZjY3MWMxMmZiNWVhN2EzMGVhNmE","commit":{"author":{"name":"cooper-oai","email":"cooper@openai.com","date":"2026-08-13T19:59:55Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T20:04:57Z"},"message":"Protect workload identity auth in app-server account RPCs (#38426)\n\n## Why\n\nWorkload identity credentials are owned by the app-server host and must not be replaced, removed, or exported through client account operations.\n\n## What changed\n\n- Reject account login and logout RPCs while workload identity is selected.\n- Continue reporting the active authentication method from `getAuthStatus`, but omit the host-owned token even when `includeToken` is requested.\n\nGitOrigin-RevId: 750c9d07ed2f4ba7007bbe75f188573e79749647","tree":{"sha":"13d3694e625afb4b9ebdd057dee71169bff788d4","url":"https://api.github.com/repos/openai/codex/git/trees/13d3694e625afb4b9ebdd057dee71169bff788d4"},"url":"https://api.github.com/repos/openai/codex/git/commits/5ed321ce0029614c7277f671c12fb5ea7a30ea6a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/5ed321ce0029614c7277f671c12fb5ea7a30ea6a","html_url":"https://github.com/openai/codex/commit/5ed321ce0029614c7277f671c12fb5ea7a30ea6a","comments_url":"https://api.github.com/repos/openai/codex/commits/5ed321ce0029614c7277f671c12fb5ea7a30ea6a/comments","author":{"login":"cooper-oai","id":242064477,"node_id":"U_kgDODm2cXQ","avatar_url":"https://avatars.githubusercontent.com/u/242064477?v=4","gravatar_id":"","url":"https://api.github.com/users/cooper-oai","html_url":"https://github.com/cooper-oai","followers_url":"https://api.github.com/users/cooper-oai/followers","following_url":"https://api.github.com/users/cooper-oai/following{/other_user}","gists_url":"https://api.github.com/users/cooper-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/cooper-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cooper-oai/subscriptions","organizations_url":"https://api.github.com/users/cooper-oai/orgs","repos_url":"https://api.github.com/users/cooper-oai/repos","events_url":"https://api.github.com/users/cooper-oai/events{/privacy}","received_events_url":"https://api.github.com/users/cooper-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"990218bbbd5cb4bb5aafd646c56461dfb2f95d17","url":"https://api.github.com/repos/openai/codex/commits/990218bbbd5cb4bb5aafd646c56461dfb2f95d17","html_url":"https://github.com/openai/codex/commit/990218bbbd5cb4bb5aafd646c56461dfb2f95d17"}]},{"sha":"990218bbbd5cb4bb5aafd646c56461dfb2f95d17","node_id":"C_kwDOOYsS4doAKDk5MDIxOGJiYmQ1Y2I0YmI1YWFmZDY0NmM1NjQ2MWRmYjJmOTVkMTc","commit":{"author":{"name":"cooper-oai","email":"cooper@openai.com","date":"2026-08-13T19:29:37Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T19:35:22Z"},"message":"Fail closed when workload identity initialization fails (#38424)\n\n## What changed\n\n- Treat workload identity environment markers as an explicit authentication selection, even when another process credential is present.\n- Return initialization errors from `AuthManager` and propagate them through commands and services instead of continuing with an unusable authentication state.\n- Make `codex login status` validate workload identity, keep the TUI on an embedded app server for local workload identity, and reject workload identity in `codex mcp-server`, where it is unsupported.\n\n## Testing\n\n- Cover workload identity precedence and partial configuration errors.\n- Verify login status reports an unreadable identity assertion and app-server routing enforces the supported workload identity topology.\n\nGitOrigin-RevId: efc6b6b4cd4d61652617de82aaa3d7ffc75d6618","tree":{"sha":"eecce71e3163516d1746cc09fa21951cad40254d","url":"https://api.github.com/repos/openai/codex/git/trees/eecce71e3163516d1746cc09fa21951cad40254d"},"url":"https://api.github.com/repos/openai/codex/git/commits/990218bbbd5cb4bb5aafd646c56461dfb2f95d17","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/990218bbbd5cb4bb5aafd646c56461dfb2f95d17","html_url":"https://github.com/openai/codex/commit/990218bbbd5cb4bb5aafd646c56461dfb2f95d17","comments_url":"https://api.github.com/repos/openai/codex/commits/990218bbbd5cb4bb5aafd646c56461dfb2f95d17/comments","author":{"login":"cooper-oai","id":242064477,"node_id":"U_kgDODm2cXQ","avatar_url":"https://avatars.githubusercontent.com/u/242064477?v=4","gravatar_id":"","url":"https://api.github.com/users/cooper-oai","html_url":"https://github.com/cooper-oai","followers_url":"https://api.github.com/users/cooper-oai/followers","following_url":"https://api.github.com/users/cooper-oai/following{/other_user}","gists_url":"https://api.github.com/users/cooper-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/cooper-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cooper-oai/subscriptions","organizations_url":"https://api.github.com/users/cooper-oai/orgs","repos_url":"https://api.github.com/users/cooper-oai/repos","events_url":"https://api.github.com/users/cooper-oai/events{/privacy}","received_events_url":"https://api.github.com/users/cooper-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"781445f7c6928eda08fe8dc160a6003d2f3a184b","url":"https://api.github.com/repos/openai/codex/commits/781445f7c6928eda08fe8dc160a6003d2f3a184b","html_url":"https://github.com/openai/codex/commit/781445f7c6928eda08fe8dc160a6003d2f3a184b"}]},{"sha":"781445f7c6928eda08fe8dc160a6003d2f3a184b","node_id":"C_kwDOOYsS4doAKDc4MTQ0NWY3YzY5MjhlZGEwOGZlOGRjMTYwYTYwMDNkMmYzYTE4NGI","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-08-13T19:19:02Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T19:25:05Z"},"message":"Centralize thread environment selection state (#38423)\n\n## What changed\n\n- Make `ThreadEnvironments` the source of truth for live environment selections and use it when building configuration snapshots, permission profiles, per-turn configuration, and MCP refresh inputs.\n- Keep settings previews side-effect free while applying accepted environment updates consistently to subsequent turns.\n- Move `EnvironmentConfig` into `codex-protocol` so environment ownership no longer depends on a core-only type.\n\n## Testing\n\n- Cover environment previews and snapshots, accepted and rejected steer updates, and active-turn environment stability.\n\nGitOrigin-RevId: 7bcf8fb5df1215f720e4e9c419541a51a871aa5e","tree":{"sha":"a0fd799518d360ff6b055ccf69b9fcd21a316182","url":"https://api.github.com/repos/openai/codex/git/trees/a0fd799518d360ff6b055ccf69b9fcd21a316182"},"url":"https://api.github.com/repos/openai/codex/git/commits/781445f7c6928eda08fe8dc160a6003d2f3a184b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/781445f7c6928eda08fe8dc160a6003d2f3a184b","html_url":"https://github.com/openai/codex/commit/781445f7c6928eda08fe8dc160a6003d2f3a184b","comments_url":"https://api.github.com/repos/openai/codex/commits/781445f7c6928eda08fe8dc160a6003d2f3a184b/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"588e18aae52bdb35fff94a7760b6b502cf0fd154","url":"https://api.github.com/repos/openai/codex/commits/588e18aae52bdb35fff94a7760b6b502cf0fd154","html_url":"https://github.com/openai/codex/commit/588e18aae52bdb35fff94a7760b6b502cf0fd154"}]},{"sha":"588e18aae52bdb35fff94a7760b6b502cf0fd154","node_id":"C_kwDOOYsS4doAKDU4OGUxOGFhZTUyYmRiMzVmZmY5NGE3NzYwYjZiNTAyY2YwZmQxNTQ","commit":{"author":{"name":"hesham-oai","email":"hesham@openai.com","date":"2026-08-13T18:59:17Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T19:14:30Z"},"message":"Recover capability discovery after executor disconnects (#38420)\n\n## Why\n\nTransient executor disconnects could leave capability discovery and skill catalogs\nstuck on a cached failure for the rest of a thread, even after the executor\nreconnected.\n\n## What changed\n\n- Replay capability discovery after executor recovery and retry transient failures\n  on later requests while continuing to cache permanent failures.\n- Avoid caching skill catalogs produced from failed discovery so a later step can\n  load the recovered catalog.\n- Mark the MCP runtime dirty when recovered manifests change the projected MCP\n  servers, and allow discovery to be cancelled with the turn.\n\n## Testing\n\n- Cover same-request recovery after a disconnect and recovery on a later request.\n- Cover retry classification through connection-attempt errors and skill catalog\n  caching after discovery recovers.\n\nGitOrigin-RevId: a57f90844351e73ea831931f72a9ddc4e4f3335c","tree":{"sha":"18a37c337b8d6a12e594f0597c73e35805f0c011","url":"https://api.github.com/repos/openai/codex/git/trees/18a37c337b8d6a12e594f0597c73e35805f0c011"},"url":"https://api.github.com/repos/openai/codex/git/commits/588e18aae52bdb35fff94a7760b6b502cf0fd154","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/588e18aae52bdb35fff94a7760b6b502cf0fd154","html_url":"https://github.com/openai/codex/commit/588e18aae52bdb35fff94a7760b6b502cf0fd154","comments_url":"https://api.github.com/repos/openai/codex/commits/588e18aae52bdb35fff94a7760b6b502cf0fd154/comments","author":{"login":"hesham-oai","id":288159708,"node_id":"U_kgDOESz33A","avatar_url":"https://avatars.githubusercontent.com/u/288159708?v=4","gravatar_id":"","url":"https://api.github.com/users/hesham-oai","html_url":"https://github.com/hesham-oai","followers_url":"https://api.github.com/users/hesham-oai/followers","following_url":"https://api.github.com/users/hesham-oai/following{/other_user}","gists_url":"https://api.github.com/users/hesham-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/hesham-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hesham-oai/subscriptions","organizations_url":"https://api.github.com/users/hesham-oai/orgs","repos_url":"https://api.github.com/users/hesham-oai/repos","events_url":"https://api.github.com/users/hesham-oai/events{/privacy}","received_events_url":"https://api.github.com/users/hesham-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"9946da9af1829410271f6b76f9159961f7281e0a","url":"https://api.github.com/repos/openai/codex/commits/9946da9af1829410271f6b76f9159961f7281e0a","html_url":"https://github.com/openai/codex/commit/9946da9af1829410271f6b76f9159961f7281e0a"}]},{"sha":"9946da9af1829410271f6b76f9159961f7281e0a","node_id":"C_kwDOOYsS4doAKDk5NDZkYTlhZjE4Mjk0MTAyNzFmNmI3NmY5MTU5OTYxZjcyODFlMGE","commit":{"author":{"name":"jay","email":"jayp@openai.com","date":"2026-08-13T18:40:13Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T18:50:43Z"},"message":"Apply Codex attribution to app-created commits (#38419)\n\n## What changed\n\nClarify that commits created through a GitHub app or plugin must include the\nCodex co-author trailer in the tool's `message` argument. This covers commits\nthat create, update, or delete files.\n\nGitOrigin-RevId: 58be9302da9f8d4f11aa100c32f779fac9cc05e9","tree":{"sha":"3c5e5cf98d4ecd3f2527f4740c22babbbe5acfb6","url":"https://api.github.com/repos/openai/codex/git/trees/3c5e5cf98d4ecd3f2527f4740c22babbbe5acfb6"},"url":"https://api.github.com/repos/openai/codex/git/commits/9946da9af1829410271f6b76f9159961f7281e0a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/9946da9af1829410271f6b76f9159961f7281e0a","html_url":"https://github.com/openai/codex/commit/9946da9af1829410271f6b76f9159961f7281e0a","comments_url":"https://api.github.com/repos/openai/codex/commits/9946da9af1829410271f6b76f9159961f7281e0a/comments","author":{"login":"jayp-oai","id":286152634,"node_id":"U_kgDOEQ5Xug","avatar_url":"https://avatars.githubusercontent.com/u/286152634?v=4","gravatar_id":"","url":"https://api.github.com/users/jayp-oai","html_url":"https://github.com/jayp-oai","followers_url":"https://api.github.com/users/jayp-oai/followers","following_url":"https://api.github.com/users/jayp-oai/following{/other_user}","gists_url":"https://api.github.com/users/jayp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jayp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jayp-oai/subscriptions","organizations_url":"https://api.github.com/users/jayp-oai/orgs","repos_url":"https://api.github.com/users/jayp-oai/repos","events_url":"https://api.github.com/users/jayp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jayp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"f8a3db0b996c52a248c1dcfc3a9dc507e840ced0","url":"https://api.github.com/repos/openai/codex/commits/f8a3db0b996c52a248c1dcfc3a9dc507e840ced0","html_url":"https://github.com/openai/codex/commit/f8a3db0b996c52a248c1dcfc3a9dc507e840ced0"}]},{"sha":"f8a3db0b996c52a248c1dcfc3a9dc507e840ced0","node_id":"C_kwDOOYsS4doAKGY4YTNkYjBiOTk2YzUyYTI0OGMxZGNmYzNhOWRjNTA3ZTg0MGNlZDA","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-13T18:31:58Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T18:45:13Z"},"message":"Clarify MCP OAuth reauthentication errors (#38418)\n\n## Why\n\nWhen an MCP server rejects existing OAuth credentials, reporting that the server\nis merely not logged in obscures that the user needs to authenticate again.\n\n## What changed\n\nPass the MCP startup failure reason into error formatting and report that the\nserver requires OAuth reauthentication when appropriate. Preserve the existing\nrecovery hint for either `codex mcp login` or the client's OAuth sign-in flow.\n\n## Testing\n\nCover the reauthentication message for both login flows and verify it in the\nstreamable HTTP OAuth round-trip test.\n\nGitOrigin-RevId: 6f6d5fe7519b1a476f8b70d976223b2ea1ec938e","tree":{"sha":"4af7ae987d2addaac1190aff761c097683cce9cf","url":"https://api.github.com/repos/openai/codex/git/trees/4af7ae987d2addaac1190aff761c097683cce9cf"},"url":"https://api.github.com/repos/openai/codex/git/commits/f8a3db0b996c52a248c1dcfc3a9dc507e840ced0","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/f8a3db0b996c52a248c1dcfc3a9dc507e840ced0","html_url":"https://github.com/openai/codex/commit/f8a3db0b996c52a248c1dcfc3a9dc507e840ced0","comments_url":"https://api.github.com/repos/openai/codex/commits/f8a3db0b996c52a248c1dcfc3a9dc507e840ced0/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4f7032173e574c443a9abf6515382d754295bb24","url":"https://api.github.com/repos/openai/codex/commits/4f7032173e574c443a9abf6515382d754295bb24","html_url":"https://github.com/openai/codex/commit/4f7032173e574c443a9abf6515382d754295bb24"}]},{"sha":"4f7032173e574c443a9abf6515382d754295bb24","node_id":"C_kwDOOYsS4doAKDRmNzAzMjE3M2U1NzRjNDQzYTlhYmY2NTE1MzgyZDc1NDI5NWJiMjQ","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-13T18:31:07Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T18:36:12Z"},"message":"Honor filesystem permissions for app file uploads (#38416)\n\n## Why\n\nApp tool file arguments could read and upload files without applying the active\nfilesystem sandbox policy.\n\n## What changed\n\n- Apply the effective filesystem policy, including session and turn grants, when\n  reading metadata and streaming files for upload.\n- Reject uploads before contacting the files endpoint when the selected path is\n  denied.\n- Report an error when the executor cannot provide sandboxed file streaming for\n  a restricted policy.\n\n## Testing\n\nAdded integration coverage showing that restricted policies allow permitted\nfiles and reject denied files before upload.\n\nGitOrigin-RevId: 63b239c5066dcb9d18b5050089c659fb2a784909","tree":{"sha":"8bd6700ddfd2e47f214cf27a7d42a362230a540e","url":"https://api.github.com/repos/openai/codex/git/trees/8bd6700ddfd2e47f214cf27a7d42a362230a540e"},"url":"https://api.github.com/repos/openai/codex/git/commits/4f7032173e574c443a9abf6515382d754295bb24","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4f7032173e574c443a9abf6515382d754295bb24","html_url":"https://github.com/openai/codex/commit/4f7032173e574c443a9abf6515382d754295bb24","comments_url":"https://api.github.com/repos/openai/codex/commits/4f7032173e574c443a9abf6515382d754295bb24/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"2aba3219e605051bbeca4eb6b1a1f3dce404cfd3","url":"https://api.github.com/repos/openai/codex/commits/2aba3219e605051bbeca4eb6b1a1f3dce404cfd3","html_url":"https://github.com/openai/codex/commit/2aba3219e605051bbeca4eb6b1a1f3dce404cfd3"}]},{"sha":"2aba3219e605051bbeca4eb6b1a1f3dce404cfd3","node_id":"C_kwDOOYsS4doAKDJhYmEzMjE5ZTYwNTA1MWJiZWNhNGViNmIxYTFmM2RjZTQwNGNmZDM","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-08-13T18:16:30Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T18:30:51Z"},"message":"Recognize PowerShell `Get-Content` file reads (#38415)\n\n## What changed\n\n- Classify simple PowerShell `Get-Content` commands, including `gc` and `type` aliases, as file reads while preserving Windows paths.\n- Reuse the shared classification for implicit skill invocation detection on Windows and render recognized commands as `Read <file>` in the TUI.\n- Leave commands with unsupported flags, multiple operands, wildcards, or expressions unclassified.\n\n## Testing\n\n- Cover supported and rejected PowerShell forms, Windows executor skill detection, and the TUI read summary.\n\nGitOrigin-RevId: 4e8f5470f2ae31c08d74091f9634c2926e516ccf","tree":{"sha":"d2f91fa012fd09a4dcc25b05765b994afd63d5ce","url":"https://api.github.com/repos/openai/codex/git/trees/d2f91fa012fd09a4dcc25b05765b994afd63d5ce"},"url":"https://api.github.com/repos/openai/codex/git/commits/2aba3219e605051bbeca4eb6b1a1f3dce404cfd3","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/2aba3219e605051bbeca4eb6b1a1f3dce404cfd3","html_url":"https://github.com/openai/codex/commit/2aba3219e605051bbeca4eb6b1a1f3dce404cfd3","comments_url":"https://api.github.com/repos/openai/codex/commits/2aba3219e605051bbeca4eb6b1a1f3dce404cfd3/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"73862481e52c1d4f610d127663fad564c0652742","url":"https://api.github.com/repos/openai/codex/commits/73862481e52c1d4f610d127663fad564c0652742","html_url":"https://github.com/openai/codex/commit/73862481e52c1d4f610d127663fad564c0652742"}]},{"sha":"73862481e52c1d4f610d127663fad564c0652742","node_id":"C_kwDOOYsS4doAKDczODYyNDgxZTUyYzFkNGY2MTBkMTI3NjYzZmFkNTY0YzA2NTI3NDI","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-13T17:56:23Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T18:17:03Z"},"message":"Add bounded transcript rendering for Guardian v2 (#38414)\n\n## What changed\n\n- Add a configurable renderer that converts conversation messages, agent\n  messages, tool calls and outputs, and reasoning into a numbered plaintext\n  transcript.\n- Keep only relevant readable content, including manual-approval developer\n  messages, while omitting media payloads, encrypted content, and unsupported\n  response items.\n- Limit transcripts to the most recent 320 KiB without splitting UTF-8\n  characters.\n\n## Testing\n\n- Cover source selection, content filtering, tool-name correlation, and bounded\n  UTF-8 truncation with unit tests.\n\nGitOrigin-RevId: e2c6535f4a895862ca744258399fb36fc92e42c6","tree":{"sha":"1775055e7d553a8d4915197408aefe4f95ae70a1","url":"https://api.github.com/repos/openai/codex/git/trees/1775055e7d553a8d4915197408aefe4f95ae70a1"},"url":"https://api.github.com/repos/openai/codex/git/commits/73862481e52c1d4f610d127663fad564c0652742","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/73862481e52c1d4f610d127663fad564c0652742","html_url":"https://github.com/openai/codex/commit/73862481e52c1d4f610d127663fad564c0652742","comments_url":"https://api.github.com/repos/openai/codex/commits/73862481e52c1d4f610d127663fad564c0652742/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"42bb50d5027fbad3431bdd56667bbee30700aad5","url":"https://api.github.com/repos/openai/codex/commits/42bb50d5027fbad3431bdd56667bbee30700aad5","html_url":"https://github.com/openai/codex/commit/42bb50d5027fbad3431bdd56667bbee30700aad5"}]},{"sha":"42bb50d5027fbad3431bdd56667bbee30700aad5","node_id":"C_kwDOOYsS4doAKDQyYmI1MGQ1MDI3ZmJhZDM0MzFiZGQ1NjY2N2JiZWUzMDcwMGFhZDU","commit":{"author":{"name":"Rasmus Rygaard","email":"rasmus@openai.com","date":"2026-08-13T17:51:55Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T18:12:27Z"},"message":"Allow metadata updates without materializing threads (#38413)\n\n## Why\n\nThread stores may filter a metadata patch to a no-op. Requiring every successful\nupdate to return a `StoredThread` forces those implementations to materialize a\nthread even when the caller does not need one.\n\n## What changed\n\n- Let `ThreadStore::update_thread_metadata` return `None` after a successful\n  update that did not materialize a thread.\n- Preserve the materialized-thread contract of `LiveThread` and `ThreadManager`\n  metadata updates by reading the thread when the store returns `None`.\n- Keep completion-only metadata updates from issuing that fallback read.\n\n## Testing\n\nCover materialized in-memory updates and verify that fallback reads occur only\nfor callers that require the updated thread.\n\nGitOrigin-RevId: 3059efc9d5b69e0b46e35fb5b5aa9638086654f2","tree":{"sha":"8616cb50e183590dda8a6b748c16a12aeb9c9632","url":"https://api.github.com/repos/openai/codex/git/trees/8616cb50e183590dda8a6b748c16a12aeb9c9632"},"url":"https://api.github.com/repos/openai/codex/git/commits/42bb50d5027fbad3431bdd56667bbee30700aad5","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/42bb50d5027fbad3431bdd56667bbee30700aad5","html_url":"https://github.com/openai/codex/commit/42bb50d5027fbad3431bdd56667bbee30700aad5","comments_url":"https://api.github.com/repos/openai/codex/commits/42bb50d5027fbad3431bdd56667bbee30700aad5/comments","author":{"login":"rasmusrygaard","id":949859,"node_id":"MDQ6VXNlcjk0OTg1OQ==","avatar_url":"https://avatars.githubusercontent.com/u/949859?v=4","gravatar_id":"","url":"https://api.github.com/users/rasmusrygaard","html_url":"https://github.com/rasmusrygaard","followers_url":"https://api.github.com/users/rasmusrygaard/followers","following_url":"https://api.github.com/users/rasmusrygaard/following{/other_user}","gists_url":"https://api.github.com/users/rasmusrygaard/gists{/gist_id}","starred_url":"https://api.github.com/users/rasmusrygaard/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rasmusrygaard/subscriptions","organizations_url":"https://api.github.com/users/rasmusrygaard/orgs","repos_url":"https://api.github.com/users/rasmusrygaard/repos","events_url":"https://api.github.com/users/rasmusrygaard/events{/privacy}","received_events_url":"https://api.github.com/users/rasmusrygaard/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"d167a3604c404e4ee4bc5b5d0b7923e24e0f54f8","url":"https://api.github.com/repos/openai/codex/commits/d167a3604c404e4ee4bc5b5d0b7923e24e0f54f8","html_url":"https://github.com/openai/codex/commit/d167a3604c404e4ee4bc5b5d0b7923e24e0f54f8"}]},{"sha":"d167a3604c404e4ee4bc5b5d0b7923e24e0f54f8","node_id":"C_kwDOOYsS4doAKGQxNjdhMzYwNGM0MDRlNGVlNGJjNWI1ZDBiNzkyM2UyNGUwZjU0Zjg","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-13T17:26:46Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T17:32:10Z"},"message":"Classify tool calls in the Guardian V2 extension (#38409)\n\n## What changed\n\n- Register a tool lifecycle contributor when Guardian V2 is installed.\n- On tool start, asynchronously ask the existing Luna sampler for a low-effort\n  `action_risk` score constrained to the range from `0.0` to `1.0`.\n- Bound the tool metadata supplied to the classifier and treat it as untrusted\n  input.\n- Emit an extension warning if classification sampling fails.\n\n## Testing\n\nAdd an integration test that verifies the contributor reuses the configured\nLuna pool and sends the expected model, attribution metadata, reasoning effort,\nstrict output schema, and tool-call context.\n\nGitOrigin-RevId: 6b69fcc0443086544086849c38bcdd90560a291f","tree":{"sha":"3ca39e1b9a42dc5d4097ead65156ed6689941a2a","url":"https://api.github.com/repos/openai/codex/git/trees/3ca39e1b9a42dc5d4097ead65156ed6689941a2a"},"url":"https://api.github.com/repos/openai/codex/git/commits/d167a3604c404e4ee4bc5b5d0b7923e24e0f54f8","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/d167a3604c404e4ee4bc5b5d0b7923e24e0f54f8","html_url":"https://github.com/openai/codex/commit/d167a3604c404e4ee4bc5b5d0b7923e24e0f54f8","comments_url":"https://api.github.com/repos/openai/codex/commits/d167a3604c404e4ee4bc5b5d0b7923e24e0f54f8/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"66919805ea080053d1933b6b43afeb0d8bf70c91","url":"https://api.github.com/repos/openai/codex/commits/66919805ea080053d1933b6b43afeb0d8bf70c91","html_url":"https://github.com/openai/codex/commit/66919805ea080053d1933b6b43afeb0d8bf70c91"}]},{"sha":"66919805ea080053d1933b6b43afeb0d8bf70c91","node_id":"C_kwDOOYsS4doAKDY2OTE5ODA1ZWEwODAwNTNkMTkzM2I2YjQzYWZlYjBkOGJmNzBjOTE","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-13T16:55:34Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T17:00:59Z"},"message":"Pool Guardian sampling WebSocket connections (#38406)\n\n## What changed\n\n- Prewarm two Responses WebSocket connections and grow the pool on demand, up to eight connections, so overlapping samples can run concurrently.\n- Lease each connection to a single sample and return healthy connections to the idle pool after completion.\n- Replace closed or 55-minute-old connections and retry a sample once after a retryable or stream error.\n- Keep the sampler available when the second prewarm connection cannot be opened.\n\n## Testing\n\n- Cover connection reuse, partial prewarm success, concurrent pool growth, and retrying an expired connection on another warm connection.\n\nGitOrigin-RevId: 3ee7b05adc00a2135ba7cb35f6e4455199bf3784","tree":{"sha":"e5fca7fa314f4a28a328493e6e0e07435d43625b","url":"https://api.github.com/repos/openai/codex/git/trees/e5fca7fa314f4a28a328493e6e0e07435d43625b"},"url":"https://api.github.com/repos/openai/codex/git/commits/66919805ea080053d1933b6b43afeb0d8bf70c91","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/66919805ea080053d1933b6b43afeb0d8bf70c91","html_url":"https://github.com/openai/codex/commit/66919805ea080053d1933b6b43afeb0d8bf70c91","comments_url":"https://api.github.com/repos/openai/codex/commits/66919805ea080053d1933b6b43afeb0d8bf70c91/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a70211249ab5d003836a2bb339f69265df84512c","url":"https://api.github.com/repos/openai/codex/commits/a70211249ab5d003836a2bb339f69265df84512c","html_url":"https://github.com/openai/codex/commit/a70211249ab5d003836a2bb339f69265df84512c"}]},{"sha":"a70211249ab5d003836a2bb339f69265df84512c","node_id":"C_kwDOOYsS4doAKGE3MDIxMTI0OWFiNWQwMDM4MzZhMmJiMzM5ZjY5MjY1ZGY4NDUxMmM","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-13T16:37:54Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T16:43:23Z"},"message":"Expose conversation history to tool lifecycle extensions (#38403)\n\n## What changed\n\n- Add a shared, read-only `ConversationHistorySnapshot` capability to the extension API.\n- Include the snapshot in `ToolStartInput`, preserving conversation order while excluding contextual user messages.\n- Avoid acquiring a history snapshot when no tool lifecycle contributors are registered.\n\n## Testing\n\n- Verify snapshots share existing response items, remain stable as history changes, and filter contextual user messages.\n- Verify tool-start callbacks receive the history available for successive tool calls.\n\nGitOrigin-RevId: 822cae33781dd876ea628f104be08d8a449a4900","tree":{"sha":"4665146f9cde42bbd1d028ae46d86ede57a0fe6a","url":"https://api.github.com/repos/openai/codex/git/trees/4665146f9cde42bbd1d028ae46d86ede57a0fe6a"},"url":"https://api.github.com/repos/openai/codex/git/commits/a70211249ab5d003836a2bb339f69265df84512c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a70211249ab5d003836a2bb339f69265df84512c","html_url":"https://github.com/openai/codex/commit/a70211249ab5d003836a2bb339f69265df84512c","comments_url":"https://api.github.com/repos/openai/codex/commits/a70211249ab5d003836a2bb339f69265df84512c/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"6851fae57cf7306e1d7a093d334b1116d33ce5ad","url":"https://api.github.com/repos/openai/codex/commits/6851fae57cf7306e1d7a093d334b1116d33ce5ad","html_url":"https://github.com/openai/codex/commit/6851fae57cf7306e1d7a093d334b1116d33ce5ad"}]},{"sha":"6851fae57cf7306e1d7a093d334b1116d33ce5ad","node_id":"C_kwDOOYsS4doAKDY4NTFmYWU1N2NmNzMwNmUxZDdhMDkzZDMzNGIxMTE2ZDMzY2U1YWQ","commit":{"author":{"name":"Tamir Duberstein","email":"tamird@openai.com","date":"2026-08-13T15:59:09Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T16:08:34Z"},"message":"Refresh tracing interest in the token estimate test (#38400)\n\n## What changed\n\nRebuild the tracing callsite interest cache after installing the test-local\nsubscriber so the `event_enabled!` assertion uses that subscriber's filters.\n\nGitOrigin-RevId: d221dca4d7e7cb2ddd492a46f7a9d5c977088593","tree":{"sha":"cf97567afa847efc6cf04de7d043096094e6edde","url":"https://api.github.com/repos/openai/codex/git/trees/cf97567afa847efc6cf04de7d043096094e6edde"},"url":"https://api.github.com/repos/openai/codex/git/commits/6851fae57cf7306e1d7a093d334b1116d33ce5ad","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/6851fae57cf7306e1d7a093d334b1116d33ce5ad","html_url":"https://github.com/openai/codex/commit/6851fae57cf7306e1d7a093d334b1116d33ce5ad","comments_url":"https://api.github.com/repos/openai/codex/commits/6851fae57cf7306e1d7a093d334b1116d33ce5ad/comments","author":{"login":"tamird","id":1535036,"node_id":"MDQ6VXNlcjE1MzUwMzY=","avatar_url":"https://avatars.githubusercontent.com/u/1535036?v=4","gravatar_id":"","url":"https://api.github.com/users/tamird","html_url":"https://github.com/tamird","followers_url":"https://api.github.com/users/tamird/followers","following_url":"https://api.github.com/users/tamird/following{/other_user}","gists_url":"https://api.github.com/users/tamird/gists{/gist_id}","starred_url":"https://api.github.com/users/tamird/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tamird/subscriptions","organizations_url":"https://api.github.com/users/tamird/orgs","repos_url":"https://api.github.com/users/tamird/repos","events_url":"https://api.github.com/users/tamird/events{/privacy}","received_events_url":"https://api.github.com/users/tamird/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"2bd8727a0c07655fafeae0e4b6fe4c2b4741b399","url":"https://api.github.com/repos/openai/codex/commits/2bd8727a0c07655fafeae0e4b6fe4c2b4741b399","html_url":"https://github.com/openai/codex/commit/2bd8727a0c07655fafeae0e4b6fe4c2b4741b399"}]},{"sha":"2bd8727a0c07655fafeae0e4b6fe4c2b4741b399","node_id":"C_kwDOOYsS4doAKDJiZDg3MjdhMGMwNzY1NWZhZmVhZTBlNGI2ZmU0YzJiNDc0MWIzOTk","commit":{"author":{"name":"Tamir Duberstein","email":"tamird@openai.com","date":"2026-08-13T15:57:35Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T16:03:20Z"},"message":"Preserve floating-point values when decoding rollout lines (#38399)\n\n## Why\n\nSerde's generic buffering for flattened and internally tagged fields is incompatible with `serde_json`'s `arbitrary_precision` representation. As a result, persisted rollout items containing nested floating-point values can fail to decode.\n\n## What changed\n\n- Decode the rollout envelope at the JSON persistence boundary before deserializing the item payload.\n- Use the shared decoder for both session resume and thread-history projection.\n- Cover token-count floats, response-item metadata, field ordering, and ignored metadata in the decoder compatibility test.\n\nGitOrigin-RevId: 59c7f6fbcf83162b5ed6980a69381fe45fc20a0a","tree":{"sha":"79fe4a6630d20abb21d5662f9b93a0f15fd500f0","url":"https://api.github.com/repos/openai/codex/git/trees/79fe4a6630d20abb21d5662f9b93a0f15fd500f0"},"url":"https://api.github.com/repos/openai/codex/git/commits/2bd8727a0c07655fafeae0e4b6fe4c2b4741b399","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/2bd8727a0c07655fafeae0e4b6fe4c2b4741b399","html_url":"https://github.com/openai/codex/commit/2bd8727a0c07655fafeae0e4b6fe4c2b4741b399","comments_url":"https://api.github.com/repos/openai/codex/commits/2bd8727a0c07655fafeae0e4b6fe4c2b4741b399/comments","author":{"login":"tamird","id":1535036,"node_id":"MDQ6VXNlcjE1MzUwMzY=","avatar_url":"https://avatars.githubusercontent.com/u/1535036?v=4","gravatar_id":"","url":"https://api.github.com/users/tamird","html_url":"https://github.com/tamird","followers_url":"https://api.github.com/users/tamird/followers","following_url":"https://api.github.com/users/tamird/following{/other_user}","gists_url":"https://api.github.com/users/tamird/gists{/gist_id}","starred_url":"https://api.github.com/users/tamird/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tamird/subscriptions","organizations_url":"https://api.github.com/users/tamird/orgs","repos_url":"https://api.github.com/users/tamird/repos","events_url":"https://api.github.com/users/tamird/events{/privacy}","received_events_url":"https://api.github.com/users/tamird/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"053dda6b897887c0bbd8efa5d4952a4380dbb5e4","url":"https://api.github.com/repos/openai/codex/commits/053dda6b897887c0bbd8efa5d4952a4380dbb5e4","html_url":"https://github.com/openai/codex/commit/053dda6b897887c0bbd8efa5d4952a4380dbb5e4"}]},{"sha":"053dda6b897887c0bbd8efa5d4952a4380dbb5e4","node_id":"C_kwDOOYsS4doAKDA1M2RkYTZiODk3ODg3YzBiYmQ4ZWZhNWQ0OTUyYTQzODBkYmI1ZTQ","commit":{"author":{"name":"Ankush Gupta","email":"amgupt01@gmail.com","date":"2026-08-13T15:42:50Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T15:50:48Z"},"message":"Include Node REPL results in Guardian reviews (#38397)\n\n## What changed\n\n- Capture accepted, successful `node_repl` results from Code Mode and include them as bounded, untrusted evidence in Guardian review prompts.\n- Enable the enhanced transcript through `guardian_enhanced_node_repl_transcripts` or when the selected model requires automatic Node REPL review.\n- Keep this evidence out of the parent model history, exclude encrypted and failed results, and avoid resending admitted evidence when a Guardian session is reused.\n- Clear retained evidence and invalidate review sessions when a thread is rolled back.\n\n## Testing\n\n- Add unit coverage for evidence ordering, escaping, truncation, and empty responses.\n- Add an integration test covering feature-disabled, feature-enabled, and model-required behavior, including filtering and review-session reuse.\n\nGitOrigin-RevId: edc3dca5d5b88d472a492f35531ec46889a89d72","tree":{"sha":"1a07c2c983ca2c1286945ebbabd2c9b6cc120bea","url":"https://api.github.com/repos/openai/codex/git/trees/1a07c2c983ca2c1286945ebbabd2c9b6cc120bea"},"url":"https://api.github.com/repos/openai/codex/git/commits/053dda6b897887c0bbd8efa5d4952a4380dbb5e4","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/053dda6b897887c0bbd8efa5d4952a4380dbb5e4","html_url":"https://github.com/openai/codex/commit/053dda6b897887c0bbd8efa5d4952a4380dbb5e4","comments_url":"https://api.github.com/repos/openai/codex/commits/053dda6b897887c0bbd8efa5d4952a4380dbb5e4/comments","author":{"login":"ankushg","id":227041,"node_id":"MDQ6VXNlcjIyNzA0MQ==","avatar_url":"https://avatars.githubusercontent.com/u/227041?v=4","gravatar_id":"","url":"https://api.github.com/users/ankushg","html_url":"https://github.com/ankushg","followers_url":"https://api.github.com/users/ankushg/followers","following_url":"https://api.github.com/users/ankushg/following{/other_user}","gists_url":"https://api.github.com/users/ankushg/gists{/gist_id}","starred_url":"https://api.github.com/users/ankushg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ankushg/subscriptions","organizations_url":"https://api.github.com/users/ankushg/orgs","repos_url":"https://api.github.com/users/ankushg/repos","events_url":"https://api.github.com/users/ankushg/events{/privacy}","received_events_url":"https://api.github.com/users/ankushg/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"779e9114ae63cad0f6d4f1f792463bd6135b7096","url":"https://api.github.com/repos/openai/codex/commits/779e9114ae63cad0f6d4f1f792463bd6135b7096","html_url":"https://github.com/openai/codex/commit/779e9114ae63cad0f6d4f1f792463bd6135b7096"}]},{"sha":"779e9114ae63cad0f6d4f1f792463bd6135b7096","node_id":"C_kwDOOYsS4doAKDc3OWU5MTE0YWU2M2NhZDBmNmQ0ZjFmNzkyNDYzYmQ2MTM1YjcwOTY","commit":{"author":{"name":"viyatb-oai","email":"viyatb@openai.com","date":"2026-08-13T15:40:32Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T15:45:51Z"},"message":"Reap orphaned processes in Linux sandboxes (#38396)\n\n## Why\n\nSandboxed descendants can outlive their immediate parent and must be collected by\nPID 1 in the Bubblewrap namespace.\n\n## What changed\n\n- Launch `codex-linux-sandbox` with Bubblewrap's `--as-pid-1` option, and fall\n  back to the bundled Bubblewrap when the system version does not support it.\n- Run the sandboxed command as a child, forward signals to it, reap other exited\n  descendants, and preserve the command's exit status.\n- Verify proxy bridge parent identity when arming its parent-death signal.\n\n## Testing\n\nAdded Linux sandbox coverage for the filtered namespace reaper, orphan\ncollection, and fallback from an incompatible system Bubblewrap.\n\nGitOrigin-RevId: 379f08d6c2732ea0a4caeb61f93ae302e16d2458","tree":{"sha":"da0fd21b47c9627dc54e425fd5e5ed07765ced7e","url":"https://api.github.com/repos/openai/codex/git/trees/da0fd21b47c9627dc54e425fd5e5ed07765ced7e"},"url":"https://api.github.com/repos/openai/codex/git/commits/779e9114ae63cad0f6d4f1f792463bd6135b7096","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/779e9114ae63cad0f6d4f1f792463bd6135b7096","html_url":"https://github.com/openai/codex/commit/779e9114ae63cad0f6d4f1f792463bd6135b7096","comments_url":"https://api.github.com/repos/openai/codex/commits/779e9114ae63cad0f6d4f1f792463bd6135b7096/comments","author":{"login":"viyatb-oai","id":234056686,"node_id":"U_kgDODfNr7g","avatar_url":"https://avatars.githubusercontent.com/u/234056686?v=4","gravatar_id":"","url":"https://api.github.com/users/viyatb-oai","html_url":"https://github.com/viyatb-oai","followers_url":"https://api.github.com/users/viyatb-oai/followers","following_url":"https://api.github.com/users/viyatb-oai/following{/other_user}","gists_url":"https://api.github.com/users/viyatb-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/viyatb-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/viyatb-oai/subscriptions","organizations_url":"https://api.github.com/users/viyatb-oai/orgs","repos_url":"https://api.github.com/users/viyatb-oai/repos","events_url":"https://api.github.com/users/viyatb-oai/events{/privacy}","received_events_url":"https://api.github.com/users/viyatb-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"ef596c68ca35dcd42283a0014f9b7fb057147269","url":"https://api.github.com/repos/openai/codex/commits/ef596c68ca35dcd42283a0014f9b7fb057147269","html_url":"https://github.com/openai/codex/commit/ef596c68ca35dcd42283a0014f9b7fb057147269"}]},{"sha":"ef596c68ca35dcd42283a0014f9b7fb057147269","node_id":"C_kwDOOYsS4doAKGVmNTk2YzY4Y2EzNWRjZDQyMjgzYTAwMTRmOWI3ZmIwNTcxNDcyNjk","commit":{"author":{"name":"viyatb-oai","email":"viyatb@openai.com","date":"2026-08-13T15:18:01Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T15:23:09Z"},"message":"Reject sessions with unloadable required managed hooks (#38394)\n\n## Why\n\nHooks supplied as managed requirements must not be silently skipped when their\nhandlers cannot be loaded.\n\n## What changed\n\n- Fail session and app-server thread startup when an enabled managed requirement\n  contains an invalid matcher, an empty command, or an unsupported handler type.\n- Keep load failures for ordinary managed configuration hooks as warnings, and do\n  not enforce managed hook requirements while the hooks feature is disabled.\n\n## Testing\n\nAdded hook-engine, core session, and app-server coverage for valid and invalid\nmanaged hook requirements.\n\nGitOrigin-RevId: 91a23b0c1d85e143aba6aabe874c5274e52fc6b2","tree":{"sha":"1d9748cec14a49d4e2dbd9ac8f70581e45802606","url":"https://api.github.com/repos/openai/codex/git/trees/1d9748cec14a49d4e2dbd9ac8f70581e45802606"},"url":"https://api.github.com/repos/openai/codex/git/commits/ef596c68ca35dcd42283a0014f9b7fb057147269","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/ef596c68ca35dcd42283a0014f9b7fb057147269","html_url":"https://github.com/openai/codex/commit/ef596c68ca35dcd42283a0014f9b7fb057147269","comments_url":"https://api.github.com/repos/openai/codex/commits/ef596c68ca35dcd42283a0014f9b7fb057147269/comments","author":{"login":"viyatb-oai","id":234056686,"node_id":"U_kgDODfNr7g","avatar_url":"https://avatars.githubusercontent.com/u/234056686?v=4","gravatar_id":"","url":"https://api.github.com/users/viyatb-oai","html_url":"https://github.com/viyatb-oai","followers_url":"https://api.github.com/users/viyatb-oai/followers","following_url":"https://api.github.com/users/viyatb-oai/following{/other_user}","gists_url":"https://api.github.com/users/viyatb-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/viyatb-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/viyatb-oai/subscriptions","organizations_url":"https://api.github.com/users/viyatb-oai/orgs","repos_url":"https://api.github.com/users/viyatb-oai/repos","events_url":"https://api.github.com/users/viyatb-oai/events{/privacy}","received_events_url":"https://api.github.com/users/viyatb-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"683716cee9585969ad265eeb08358b24fb93a583","url":"https://api.github.com/repos/openai/codex/commits/683716cee9585969ad265eeb08358b24fb93a583","html_url":"https://github.com/openai/codex/commit/683716cee9585969ad265eeb08358b24fb93a583"}]},{"sha":"683716cee9585969ad265eeb08358b24fb93a583","node_id":"C_kwDOOYsS4doAKDY4MzcxNmNlZTk1ODU5NjlhZDI2NWVlYjA4MzU4YjI0ZmI5M2E1ODM","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-13T14:42:46Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T14:55:00Z"},"message":"Use effective permissions when trusting app-server projects (#38390)\n\n## Why\n\nProject-local configuration can launch host processes. Requested write access may be reduced to read-only by managed constraints or platform support, so the request alone must not cause the app server to trust a project and load its configuration.\n\n## What changed\n\n- Base automatic project trust on the effective permission profile after configuration is loaded.\n- Trust managed profiles only when their effective filesystem policy allows writes to the working directory.\n- Continue resolving trusted nested working directories to the repository root.\n\n## Testing\n\n- Verify that managed read-only permissions neither persist project trust nor load a project-local MCP server when workspace-write access was requested.\n- Cover effective read-only fallback for workspace-write requests and nested repository working directories.\n\nGitOrigin-RevId: e548fd9c4552c328f779cc0365fe86f37d4a9b71","tree":{"sha":"40c5d79455848c2c51a29276435322d60051b507","url":"https://api.github.com/repos/openai/codex/git/trees/40c5d79455848c2c51a29276435322d60051b507"},"url":"https://api.github.com/repos/openai/codex/git/commits/683716cee9585969ad265eeb08358b24fb93a583","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/683716cee9585969ad265eeb08358b24fb93a583","html_url":"https://github.com/openai/codex/commit/683716cee9585969ad265eeb08358b24fb93a583","comments_url":"https://api.github.com/repos/openai/codex/commits/683716cee9585969ad265eeb08358b24fb93a583/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"5e32f728f1f86a967c6be057351f12505778df8f","url":"https://api.github.com/repos/openai/codex/commits/5e32f728f1f86a967c6be057351f12505778df8f","html_url":"https://github.com/openai/codex/commit/5e32f728f1f86a967c6be057351f12505778df8f"}]},{"sha":"5e32f728f1f86a967c6be057351f12505778df8f","node_id":"C_kwDOOYsS4doAKDVlMzJmNzI4ZjFmODZhOTY3YzZiZTA1NzM1MWYxMjUwNTc3OGRmOGY","commit":{"author":{"name":"provencher-oai","email":"eprovencher@openai.com","date":"2026-08-13T14:15:18Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T14:24:53Z"},"message":"Refine skill creation guidance and validation (#38384)\n\n## What changed\n\n- Rework the bundled `skill-creator` guidance around concise, scoped instructions, progressive disclosure, optional resources, invocation policy, and risk-based forward-testing.\n- Simplify generated skill and reference templates so new skills start with only the placeholders and resources they need.\n- Reject unfinished `[TODO: ...]` placeholders in skill descriptions and instruction bodies while allowing examples inside fenced code blocks.\n\nGitOrigin-RevId: b0871aaeeb768c12b1a467d48037eecc8db5d52b","tree":{"sha":"49bc7eafa015c404eda13f2ca860768ee343eb2c","url":"https://api.github.com/repos/openai/codex/git/trees/49bc7eafa015c404eda13f2ca860768ee343eb2c"},"url":"https://api.github.com/repos/openai/codex/git/commits/5e32f728f1f86a967c6be057351f12505778df8f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/5e32f728f1f86a967c6be057351f12505778df8f","html_url":"https://github.com/openai/codex/commit/5e32f728f1f86a967c6be057351f12505778df8f","comments_url":"https://api.github.com/repos/openai/codex/commits/5e32f728f1f86a967c6be057351f12505778df8f/comments","author":{"login":"provencher-oai","id":288160983,"node_id":"U_kgDOESz81w","avatar_url":"https://avatars.githubusercontent.com/u/288160983?v=4","gravatar_id":"","url":"https://api.github.com/users/provencher-oai","html_url":"https://github.com/provencher-oai","followers_url":"https://api.github.com/users/provencher-oai/followers","following_url":"https://api.github.com/users/provencher-oai/following{/other_user}","gists_url":"https://api.github.com/users/provencher-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/provencher-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/provencher-oai/subscriptions","organizations_url":"https://api.github.com/users/provencher-oai/orgs","repos_url":"https://api.github.com/users/provencher-oai/repos","events_url":"https://api.github.com/users/provencher-oai/events{/privacy}","received_events_url":"https://api.github.com/users/provencher-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"911012490ca9b6529dfaf14b0396363dce981169","url":"https://api.github.com/repos/openai/codex/commits/911012490ca9b6529dfaf14b0396363dce981169","html_url":"https://github.com/openai/codex/commit/911012490ca9b6529dfaf14b0396363dce981169"}]},{"sha":"911012490ca9b6529dfaf14b0396363dce981169","node_id":"C_kwDOOYsS4doAKDkxMTAxMjQ5MGNhOWI2NTI5ZGZhZjE0YjAzOTYzNjNkY2U5ODExNjk","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-13T14:14:56Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T14:20:38Z"},"message":"Return Luna samples when streamed JSON completes (#38383)\n\n## Why\n\nStructured output can be complete before the Responses stream emits its terminal\nevents. Waiting for those events unnecessarily delays the sampler and can leave it\nwaiting after usable output has arrived.\n\n## What changed\n\n- Return a Luna sample as soon as accumulated text deltas parse as a complete JSON\n  object.\n- Continue draining the remaining response events in the background so the\n  authenticated WebSocket stays reusable for subsequent samples.\n- Enforce the output-size limit while accumulating deltas on the early-return path.\n\n## Testing\n\n- Cover returning complete JSON without terminal response events.\n- Verify that early return still allows the authenticated WebSocket to be reused.\n\nGitOrigin-RevId: 80c9963f1540f7862356aaad3503e3071a8fb92a","tree":{"sha":"3514b6ed4ec95dea2099d94e0bf31f1c7b58b249","url":"https://api.github.com/repos/openai/codex/git/trees/3514b6ed4ec95dea2099d94e0bf31f1c7b58b249"},"url":"https://api.github.com/repos/openai/codex/git/commits/911012490ca9b6529dfaf14b0396363dce981169","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/911012490ca9b6529dfaf14b0396363dce981169","html_url":"https://github.com/openai/codex/commit/911012490ca9b6529dfaf14b0396363dce981169","comments_url":"https://api.github.com/repos/openai/codex/commits/911012490ca9b6529dfaf14b0396363dce981169/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"6fc6b9d6d2580d62622fc9884b5f5707f6505a5e","url":"https://api.github.com/repos/openai/codex/commits/6fc6b9d6d2580d62622fc9884b5f5707f6505a5e","html_url":"https://github.com/openai/codex/commit/6fc6b9d6d2580d62622fc9884b5f5707f6505a5e"}]},{"sha":"6fc6b9d6d2580d62622fc9884b5f5707f6505a5e","node_id":"C_kwDOOYsS4doAKDZmYzZiOWQ2ZDI1ODBkNjI2MjJmYzk4ODRiNWY1NzA3ZjY1MDVhNWU","commit":{"author":{"name":"Tamir Duberstein","email":"tamird@openai.com","date":"2026-08-13T13:46:41Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T13:57:25Z"},"message":"Prevent unread events from blocking in-process requests (#38381)\n\n## Why\n\nAwaiting a bounded consumer event queue can stall the in-process app-server\nworker when notifications are not being drained, preventing it from delivering\na request response queued behind them.\n\n## What changed\n\n- Use an unbounded queue for caller-facing in-process events while keeping\n  command and embedded-runtime queues bounded.\n- Preserve all events in order instead of dropping best-effort events and\n  emitting lag markers when the consumer queue fills.\n- Document that callers can await requests without concurrently draining\n  notifications.\n\n## Testing\n\nAdd a regression test that fills a capacity-one client with unread settings\nnotifications, verifies subsequent requests complete, and then confirms the\nnotifications remain readable in order.\n\nGitOrigin-RevId: 6ca6cfb9349dfa04a613236836f813c1f799783e","tree":{"sha":"bf5bfd839f3ab1e5bc059241c366b54614c21587","url":"https://api.github.com/repos/openai/codex/git/trees/bf5bfd839f3ab1e5bc059241c366b54614c21587"},"url":"https://api.github.com/repos/openai/codex/git/commits/6fc6b9d6d2580d62622fc9884b5f5707f6505a5e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/6fc6b9d6d2580d62622fc9884b5f5707f6505a5e","html_url":"https://github.com/openai/codex/commit/6fc6b9d6d2580d62622fc9884b5f5707f6505a5e","comments_url":"https://api.github.com/repos/openai/codex/commits/6fc6b9d6d2580d62622fc9884b5f5707f6505a5e/comments","author":{"login":"tamird","id":1535036,"node_id":"MDQ6VXNlcjE1MzUwMzY=","avatar_url":"https://avatars.githubusercontent.com/u/1535036?v=4","gravatar_id":"","url":"https://api.github.com/users/tamird","html_url":"https://github.com/tamird","followers_url":"https://api.github.com/users/tamird/followers","following_url":"https://api.github.com/users/tamird/following{/other_user}","gists_url":"https://api.github.com/users/tamird/gists{/gist_id}","starred_url":"https://api.github.com/users/tamird/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tamird/subscriptions","organizations_url":"https://api.github.com/users/tamird/orgs","repos_url":"https://api.github.com/users/tamird/repos","events_url":"https://api.github.com/users/tamird/events{/privacy}","received_events_url":"https://api.github.com/users/tamird/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"d09cf7e5f431bf3c331e78f5a4f7ae2913b4fbd6","url":"https://api.github.com/repos/openai/codex/commits/d09cf7e5f431bf3c331e78f5a4f7ae2913b4fbd6","html_url":"https://github.com/openai/codex/commit/d09cf7e5f431bf3c331e78f5a4f7ae2913b4fbd6"}]},{"sha":"d09cf7e5f431bf3c331e78f5a4f7ae2913b4fbd6","node_id":"C_kwDOOYsS4doAKGQwOWNmN2U1ZjQzMWJmM2MzMzFlNzhmNWE0ZjdhZTI5MTNiNGZiZDY","commit":{"author":{"name":"Felipe Coury","email":"felipe.coury@openai.com","date":"2026-08-13T13:45:58Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T13:52:18Z"},"message":"Preserve user message styling when wrapping long URLs (#38380)\n\n## Why\n\nTerminal autowrap for oversized URL tokens can drop the user-message gutter and background on continuation rows.\n\n## What changed\n\n- Explicitly wrap long URLs within the available message width.\n- Preserve the complete OSC 8 hyperlink destination on every wrapped fragment.\n- Keep the user-message gutter and background styling across continuation rows.\n\n## Testing\n\nAdd history-cell and VT100 coverage for URL content, hyperlink targets, gutters, and backgrounds across wrapped rows.\n\nGitOrigin-RevId: 59514eee4ab967bd937b55574b9f8d0d1c82df7c","tree":{"sha":"9f79e6610810570ec1246a40529c91c490e3fd67","url":"https://api.github.com/repos/openai/codex/git/trees/9f79e6610810570ec1246a40529c91c490e3fd67"},"url":"https://api.github.com/repos/openai/codex/git/commits/d09cf7e5f431bf3c331e78f5a4f7ae2913b4fbd6","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/d09cf7e5f431bf3c331e78f5a4f7ae2913b4fbd6","html_url":"https://github.com/openai/codex/commit/d09cf7e5f431bf3c331e78f5a4f7ae2913b4fbd6","comments_url":"https://api.github.com/repos/openai/codex/commits/d09cf7e5f431bf3c331e78f5a4f7ae2913b4fbd6/comments","author":{"login":"fcoury-oai","id":272635208,"node_id":"U_kgDOEEAVSA","avatar_url":"https://avatars.githubusercontent.com/u/272635208?v=4","gravatar_id":"","url":"https://api.github.com/users/fcoury-oai","html_url":"https://github.com/fcoury-oai","followers_url":"https://api.github.com/users/fcoury-oai/followers","following_url":"https://api.github.com/users/fcoury-oai/following{/other_user}","gists_url":"https://api.github.com/users/fcoury-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/fcoury-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fcoury-oai/subscriptions","organizations_url":"https://api.github.com/users/fcoury-oai/orgs","repos_url":"https://api.github.com/users/fcoury-oai/repos","events_url":"https://api.github.com/users/fcoury-oai/events{/privacy}","received_events_url":"https://api.github.com/users/fcoury-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a7e9fb54800fc784a5039dc461ac68011abed05d","url":"https://api.github.com/repos/openai/codex/commits/a7e9fb54800fc784a5039dc461ac68011abed05d","html_url":"https://github.com/openai/codex/commit/a7e9fb54800fc784a5039dc461ac68011abed05d"}]},{"sha":"a7e9fb54800fc784a5039dc461ac68011abed05d","node_id":"C_kwDOOYsS4doAKGE3ZTlmYjU0ODAwZmM3ODRhNTAzOWRjNDYxYWM2ODAxMWFiZWQwNWQ","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-13T13:34:03Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T13:41:08Z"},"message":"Constrain Guardian reviews to parent filesystem permissions (#38377)\n\n## Why\n\nGuardian review sessions must not gain access to paths that the parent turn is\nnot allowed to read.\n\n## What changed\n\n- Derive Guardian permissions by intersecting managed parent filesystem rules\n  with read-only access, preserving denied paths and restricting network access.\n- Offer Guardian execution tools only when a managed sandbox can enforce those\n  rules.\n- Include the selected environment IDs in the review-session reuse key so a\n  session is not reused across different environment sets.\n\n## Testing\n\nUpdate the Guardian reuse integration test to verify that a review cannot read\na parent-denied file or write a local file while consecutive reviews still\nreuse the same session.\n\nGitOrigin-RevId: 20f17a6c379f1eda651e8508459d642a51e4ce94","tree":{"sha":"22c21bf055fcd1844be26bb01dd63ed50b1d87ce","url":"https://api.github.com/repos/openai/codex/git/trees/22c21bf055fcd1844be26bb01dd63ed50b1d87ce"},"url":"https://api.github.com/repos/openai/codex/git/commits/a7e9fb54800fc784a5039dc461ac68011abed05d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a7e9fb54800fc784a5039dc461ac68011abed05d","html_url":"https://github.com/openai/codex/commit/a7e9fb54800fc784a5039dc461ac68011abed05d","comments_url":"https://api.github.com/repos/openai/codex/commits/a7e9fb54800fc784a5039dc461ac68011abed05d/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a7b8c074b577f897111c14de3a5e127b91e2a479","url":"https://api.github.com/repos/openai/codex/commits/a7b8c074b577f897111c14de3a5e127b91e2a479","html_url":"https://github.com/openai/codex/commit/a7b8c074b577f897111c14de3a5e127b91e2a479"}]},{"sha":"a7b8c074b577f897111c14de3a5e127b91e2a479","node_id":"C_kwDOOYsS4doAKGE3YjhjMDc0YjU3N2Y4OTcxMTFjMTRkZTNhNWUxMjdiOTFlMmE0Nzk","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-13T12:30:54Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T12:35:56Z"},"message":"Add the Guardian V2 Luna sampler (#38368)\n\n## What changed\n\n- Add a `LunaSampler` that opens an authenticated Responses WebSocket and reuses it for structured, tool-free `gpt-5.6-luna` requests.\n- Carry the host's provider, authentication, proxy, attribution, and service-tier configuration into the connection and requests.\n- Require strict JSON schemas, preserve per-request reasoning effort and turn metadata, and reject missing or oversized output.\n\n## Testing\n\n- Add a WebSocket test covering authentication and attribution headers, connection reuse, structured request fields, per-turn metadata, reasoning effort, and returned output.\n\nGitOrigin-RevId: aef85fd8ddcfcb7c76a9ede0d3191e3a0321656b","tree":{"sha":"427fb958ebd876eac0f10efc548cda322c269765","url":"https://api.github.com/repos/openai/codex/git/trees/427fb958ebd876eac0f10efc548cda322c269765"},"url":"https://api.github.com/repos/openai/codex/git/commits/a7b8c074b577f897111c14de3a5e127b91e2a479","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a7b8c074b577f897111c14de3a5e127b91e2a479","html_url":"https://github.com/openai/codex/commit/a7b8c074b577f897111c14de3a5e127b91e2a479","comments_url":"https://api.github.com/repos/openai/codex/commits/a7b8c074b577f897111c14de3a5e127b91e2a479/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"72fa74fbc9c4b72d513304bfa0eda427d2402ed9","url":"https://api.github.com/repos/openai/codex/commits/72fa74fbc9c4b72d513304bfa0eda427d2402ed9","html_url":"https://github.com/openai/codex/commit/72fa74fbc9c4b72d513304bfa0eda427d2402ed9"}]},{"sha":"72fa74fbc9c4b72d513304bfa0eda427d2402ed9","node_id":"C_kwDOOYsS4doAKDcyZmE3NGZiYzljNGI3MmQ1MTMzMDRiZmEwZWRhNDI3ZDI0MDJlZDk","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-13T11:50:47Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T12:04:29Z"},"message":"Persist security risk scores in rollout history (#38363)\n\n## What changed\n\n- Add a `SecurityRiskScore` rollout item containing a category and numeric score.\n- Persist the item in both thread history modes while excluding it from model context, user-visible thread history, search text, forks, and reconstructed conversation history.\n- Re-export the score type from the extension API.\n\n## Testing\n\n- Cover serialization, persistence and loading, thread history projection, session reconstruction, append planning, and memory filtering.\n\nGitOrigin-RevId: 1926fe366aeaa75052708a6da589f45a38eefb52","tree":{"sha":"43a974eb82d386a38ab3b4d993fa0d4b3dca2955","url":"https://api.github.com/repos/openai/codex/git/trees/43a974eb82d386a38ab3b4d993fa0d4b3dca2955"},"url":"https://api.github.com/repos/openai/codex/git/commits/72fa74fbc9c4b72d513304bfa0eda427d2402ed9","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/72fa74fbc9c4b72d513304bfa0eda427d2402ed9","html_url":"https://github.com/openai/codex/commit/72fa74fbc9c4b72d513304bfa0eda427d2402ed9","comments_url":"https://api.github.com/repos/openai/codex/commits/72fa74fbc9c4b72d513304bfa0eda427d2402ed9/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"9ed0047a610aa8e4413dfb456fbf40d7b2f38644","url":"https://api.github.com/repos/openai/codex/commits/9ed0047a610aa8e4413dfb456fbf40d7b2f38644","html_url":"https://github.com/openai/codex/commit/9ed0047a610aa8e4413dfb456fbf40d7b2f38644"}]},{"sha":"9ed0047a610aa8e4413dfb456fbf40d7b2f38644","node_id":"C_kwDOOYsS4doAKDllZDAwNDdhNjEwYWE4ZTQ0MTNkZmI0NTZmYmY0MGQ3YjJmMzg2NDQ","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-13T11:50:18Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T12:00:19Z"},"message":"Stabilize exec-server byte-budget tests (#38362)\n\n## What changed\n\n- Send the scripted HTTP response before queuing body deltas in the\n  single-stream byte-budget test.\n- Allow 30 seconds for barrier requests in both byte-budget tests while\n  retaining the default timeout for other operations.\n\nGitOrigin-RevId: ac65580b479d93fcbcca787f15e04c084f0aa56b","tree":{"sha":"b5085d6f776bb33342eeb47fdb6c297b8403f251","url":"https://api.github.com/repos/openai/codex/git/trees/b5085d6f776bb33342eeb47fdb6c297b8403f251"},"url":"https://api.github.com/repos/openai/codex/git/commits/9ed0047a610aa8e4413dfb456fbf40d7b2f38644","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/9ed0047a610aa8e4413dfb456fbf40d7b2f38644","html_url":"https://github.com/openai/codex/commit/9ed0047a610aa8e4413dfb456fbf40d7b2f38644","comments_url":"https://api.github.com/repos/openai/codex/commits/9ed0047a610aa8e4413dfb456fbf40d7b2f38644/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4ca1af77a561a8908451ae755d8f2b119ca7c434","url":"https://api.github.com/repos/openai/codex/commits/4ca1af77a561a8908451ae755d8f2b119ca7c434","html_url":"https://github.com/openai/codex/commit/4ca1af77a561a8908451ae755d8f2b119ca7c434"}]},{"sha":"4ca1af77a561a8908451ae755d8f2b119ca7c434","node_id":"C_kwDOOYsS4doAKDRjYTFhZjc3YTU2MWE4OTA4NDUxYWU3NTVkOGYyYjExOWNhN2M0MzQ","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-13T11:50:11Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T11:55:10Z"},"message":"Test hook rejection for explicitly started queue items (#38361)\n\n## What changed\n\n- Add dedicated coverage for explicitly starting a queued item that a prompt hook rejects.\n- Verify the rejected item is consumed and no model request is sent.\n- Keep the automatic queue dispatch test focused on consuming a rejected item while allowing later queued input to proceed.\n\nGitOrigin-RevId: e01cefb9d8581b0d4be05d4595f279d61e628e83","tree":{"sha":"c387fe79cfb104e8c69708b49ee9f0774b2eba03","url":"https://api.github.com/repos/openai/codex/git/trees/c387fe79cfb104e8c69708b49ee9f0774b2eba03"},"url":"https://api.github.com/repos/openai/codex/git/commits/4ca1af77a561a8908451ae755d8f2b119ca7c434","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4ca1af77a561a8908451ae755d8f2b119ca7c434","html_url":"https://github.com/openai/codex/commit/4ca1af77a561a8908451ae755d8f2b119ca7c434","comments_url":"https://api.github.com/repos/openai/codex/commits/4ca1af77a561a8908451ae755d8f2b119ca7c434/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"80ceab7aaa25068aee26a52353c0d63039c93b29","url":"https://api.github.com/repos/openai/codex/commits/80ceab7aaa25068aee26a52353c0d63039c93b29","html_url":"https://github.com/openai/codex/commit/80ceab7aaa25068aee26a52353c0d63039c93b29"}]},{"sha":"80ceab7aaa25068aee26a52353c0d63039c93b29","node_id":"C_kwDOOYsS4doAKDgwY2VhYjdhYWEyNTA2OGFlZTI2YTUyMzUzYzBkNjMwMzljOTNiMjk","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-13T11:33:32Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T11:39:57Z"},"message":"Optimize orphan output normalization (#38358)\n\n## What changed\n\n- Collect borrowed call IDs in a single pass instead of cloning IDs across\n  separate sets.\n- Record orphan positions and compact the history only when orphan outputs are\n  present, while preserving the existing matching and error behavior.\n\nGitOrigin-RevId: de399ba92ff451cb12fc69218d60d3ac29fccb3d","tree":{"sha":"8b6195af8f29d7099bb2667e790e0ba7ccd1296c","url":"https://api.github.com/repos/openai/codex/git/trees/8b6195af8f29d7099bb2667e790e0ba7ccd1296c"},"url":"https://api.github.com/repos/openai/codex/git/commits/80ceab7aaa25068aee26a52353c0d63039c93b29","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/80ceab7aaa25068aee26a52353c0d63039c93b29","html_url":"https://github.com/openai/codex/commit/80ceab7aaa25068aee26a52353c0d63039c93b29","comments_url":"https://api.github.com/repos/openai/codex/commits/80ceab7aaa25068aee26a52353c0d63039c93b29/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c30a3e49c9231361abeaa88d4a57bb7c3e248a50","url":"https://api.github.com/repos/openai/codex/commits/c30a3e49c9231361abeaa88d4a57bb7c3e248a50","html_url":"https://github.com/openai/codex/commit/c30a3e49c9231361abeaa88d4a57bb7c3e248a50"}]},{"sha":"c30a3e49c9231361abeaa88d4a57bb7c3e248a50","node_id":"C_kwDOOYsS4doAKGMzMGEzZTQ5YzkyMzEzNjFhYmVhYTg4ZDRhNTdiYjdjM2UyNDhhNTA","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-13T11:02:36Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T11:11:26Z"},"message":"Support sandboxed file streaming in exec-server (#38356)\n\n## Why\n\nStreaming reads previously rejected requests that used a platform filesystem\nsandbox.\n\n## What changed\n\n- Open streamed files in the sandbox helper and return the open file to the\n  exec-server by passing a file descriptor on Unix or duplicating a file handle\n  on Windows.\n- Advertise support through the `sandboxedFileStreaming` environment capability.\n- Preserve close-on-exec behavior for transferred descriptors, including the\n  required inherited-descriptor cleanup on macOS.\n\n## Testing\n\n- Cover bounded sandboxed streams, continued reads after path replacement, and\n  rejection of symlink escapes outside readable roots.\n\nGitOrigin-RevId: 677b2444b74e834b78b87a8554bc119c1c6e08b2","tree":{"sha":"b3cf12a22e3e0f0231beaca2294dcac1e5000205","url":"https://api.github.com/repos/openai/codex/git/trees/b3cf12a22e3e0f0231beaca2294dcac1e5000205"},"url":"https://api.github.com/repos/openai/codex/git/commits/c30a3e49c9231361abeaa88d4a57bb7c3e248a50","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c30a3e49c9231361abeaa88d4a57bb7c3e248a50","html_url":"https://github.com/openai/codex/commit/c30a3e49c9231361abeaa88d4a57bb7c3e248a50","comments_url":"https://api.github.com/repos/openai/codex/commits/c30a3e49c9231361abeaa88d4a57bb7c3e248a50/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fe614a6304ef804be74a622e482fdd75977abcba","url":"https://api.github.com/repos/openai/codex/commits/fe614a6304ef804be74a622e482fdd75977abcba","html_url":"https://github.com/openai/codex/commit/fe614a6304ef804be74a622e482fdd75977abcba"}]},{"sha":"fe614a6304ef804be74a622e482fdd75977abcba","node_id":"C_kwDOOYsS4doAKGZlNjE0YTYzMDRlZjgwNGJlNzRhNjIyZTQ4MmZkZDc1OTc3YWJjYmE","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-13T08:54:37Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-13T09:00:23Z"},"message":"Add Guardian V2 extension scaffold (#38336)\n\n## What changed\n\n- Add the `codex-guardian-v2` crate with an extension install entry point that does not register contributors yet.\n- Register the crate in the Cargo workspace and add its Bazel target.\n\nGitOrigin-RevId: 7c0c9479c6722d65f0f0dad9b0fd4a756e4649b3","tree":{"sha":"83fc0dafda79e5ca16847a3317dcc940a4a1b73a","url":"https://api.github.com/repos/openai/codex/git/trees/83fc0dafda79e5ca16847a3317dcc940a4a1b73a"},"url":"https://api.github.com/repos/openai/codex/git/commits/fe614a6304ef804be74a622e482fdd75977abcba","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fe614a6304ef804be74a622e482fdd75977abcba","html_url":"https://github.com/openai/codex/commit/fe614a6304ef804be74a622e482fdd75977abcba","comments_url":"https://api.github.com/repos/openai/codex/commits/fe614a6304ef804be74a622e482fdd75977abcba/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravat