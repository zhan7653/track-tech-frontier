eived_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"253e180ce026557a15a3365d7f78b5bdb1da587d","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/253e180ce026557a15a3365d7f78b5bdb1da587d","html_url":"https://github.com/langchain-ai/deepagents/commit/253e180ce026557a15a3365d7f78b5bdb1da587d"}]},{"sha":"253e180ce026557a15a3365d7f78b5bdb1da587d","node_id":"C_kwDOPTymldoAKDI1M2UxODBjZTAyNjU1N2ExNWEzMzY1ZDdmNzhiNWJkYjFkYTU4N2Q","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-12T01:47:50Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T01:47:50Z"},"message":"fix(ci): report actionable lockfile check failures (#3895)\n\nLockfile validation now uses a single command builder for both the `uv\nlock --check` invocation and the recovery command shown to contributors.\nFailures point at the stale `uv.lock` with a GitHub annotation and the\nexact repo-root command needed to regenerate it.","tree":{"sha":"cd1c7582ed23e10cecec4e49b1ebddf82d30bb49","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/cd1c7582ed23e10cecec4e49b1ebddf82d30bb49"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/253e180ce026557a15a3365d7f78b5bdb1da587d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK2VGCRC1aQ7uu5UhlAAAt5gQAIldXiayxqjb12zrEAJYL5Ea\nc5/TGU7/nIf49FufWjjihVrZmmFCOdd9+XM0MRpNy2T49F0/2XJXVKCTWKp5NYgZ\nT/5dExiF0GJSXRRzMaL+rWuRL2z4dg77OG4JpR3E4KdsU4kU0DeINq3AeUY3zXQu\nhUcqbHZaDMj4zj2f7Cp4goGlt8Nul5PMg1AoFUXQgdg+o9bspSrES43F1UBTBp5o\n3aw0FzhyWa4pwkMTeeMLsgrGUsXucbN061/b551lIQfrO8q75R9RIY1Tsu6LxeTO\nJWnMt0ogs8uYfs8H0vZhqaaycdbtYmb4e+8/sPiCiZTp3wUkK1hptu8iz2mJNLy9\nZ1Rh34pyeujk28IBeV8ZQLasXrafAPE5Jr9fs4Hbg0RaANef1W9mwHXOJrW7Z4ul\nuMXG09Nsktvls56U3I2T7Hu1PtecZPoP5uGCdubVwkWHjXRHB6z6dVP4QjvsCgrZ\nBZ7NB6oz4XpClX/PqjdeG22VO3+q33Lgp6aKfSIzqyAIKL+Jeloj8Wmo292fejbb\n3j+Y749udGC4OD6iRmOWR1MTg1G+Pe5bwR/gGU5cs9MaxeG52pVGRgsodIWyEvCi\nV59WzQyhn08FEUn/StXfu7PNuKBKf8JhZMaZS6i8aj06p48qFZphc0jgXZOfMYVr\nPeM6IogUPcgcTQQP/47b\n=sFR9\n-----END PGP SIGNATURE-----\n","payload":"tree cd1c7582ed23e10cecec4e49b1ebddf82d30bb49\nparent f825290b21a7dd0555738baf26ee35a595ca2078\nauthor Mason Daugherty <mason@langchain.dev> 1781228870 -0400\ncommitter GitHub <noreply@github.com> 1781228870 -0400\n\nfix(ci): report actionable lockfile check failures (#3895)\n\nLockfile validation now uses a single command builder for both the `uv\nlock --check` invocation and the recovery command shown to contributors.\nFailures point at the stale `uv.lock` with a GitHub annotation and the\nexact repo-root command needed to regenerate it.","verified_at":"2026-06-12T01:47:51Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/253e180ce026557a15a3365d7f78b5bdb1da587d","html_url":"https://github.com/langchain-ai/deepagents/commit/253e180ce026557a15a3365d7f78b5bdb1da587d","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/253e180ce026557a15a3365d7f78b5bdb1da587d/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f825290b21a7dd0555738baf26ee35a595ca2078","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/f825290b21a7dd0555738baf26ee35a595ca2078","html_url":"https://github.com/langchain-ai/deepagents/commit/f825290b21a7dd0555738baf26ee35a595ca2078"}]},{"sha":"f825290b21a7dd0555738baf26ee35a595ca2078","node_id":"C_kwDOPTymldoAKGY4MjUyOTBiMjFhN2RkMDU1NTczOGJhZjI2ZWUzNWE1OTVjYTIwNzg","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-12T01:43:17Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T01:43:17Z"},"message":"perf(evals): cut redundant I/O and serialized round-trips (#3880)\n\nEliminates redundant per-trial file reads/parses and replaces serialized\nblocking round-trips with concurrent ones, without changing behavior.\n\n- `scripts/analyze.py`: read each `trajectory.json`/`config.json` once\nper trial (was 2-4x), cache the task-directory index instead of\nre-globbing per trial, and analyze trials concurrently via a thread\npool.\n- `deepagents_harbor/metadata.py`: run the four independent sandbox\nprobes concurrently instead of one at a time.\n- `deepagents_harbor/langsmith.py`: process per-trial feedback with a\nbounded thread pool instead of serially.\n- `tests/evals/llm_judge.py`: grade criteria concurrently rather than\none LLM call at a time.\n\n\nMade by [Open SWE](https://openswe.vercel.app)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"b381a05386f178c5f0ab49582bbafea5e6809d75","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/b381a05386f178c5f0ab49582bbafea5e6809d75"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/f825290b21a7dd0555738baf26ee35a595ca2078","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK2Q1CRC1aQ7uu5UhlAAA74IQAByaWzT5G2tatFv6QkOTPYoq\nQpFTb0RftcUR7MeY7+ZDbY6Oh0ssjNCOwKWIJVmCCSsZhwQ6A0doyZVZ5gWEGhwb\nE3VqpWd8V2/YJ3+U6UIYuqQtyf06vN/voD+OHjUi2tDOZwqLBirKBwGrXvHvOGxG\noAOCDeQ/jc84e0mKnRhpJUT3p/ABMU2a0Z/7IhqFgX89BJ4n+xADfkyYIvfFMTDg\nKIepBf8GGL95sPx84ePuPvzulFpzbUS6S97VmJoHOiUr80feAbRMJQNblnuCtTh4\ndJCaA48roVyCSaIzqZyao64lGl+gLXK8uYXjWvb151eoTEph/rFdap5mIl6802BV\n+ZOKrFtaj7MWG/5TICzLsT39LLaLzGyR5eZfZCtQIP0A0fvOyzxrcHa3tUBsM/3z\ng2jPNEaomlRdjp1jOuabpDXXx5JXmowdfqEGM6qyzAfW71LPDsthXFyg1J8HABCn\nanZPqw/+dQqRZzIHd9jjG6QVyx5ROW2AR2bZhSnq7S0XNxwguJ3hiYanWyUkY4rd\n4jcrs07K109rDduydHOlUziR4BDoFKYvjt4KUe27NwGVAvELCHobsEvslKhNQ2Ms\nLYnqPE377+AXvYGiTt7S3hpM/ilecRzVj68UeOt0g69AlLGy0kZy69FYBAlfDQOm\nT9AAlhLZTms6+eXU7Ejr\n=UWYM\n-----END PGP SIGNATURE-----\n","payload":"tree b381a05386f178c5f0ab49582bbafea5e6809d75\nparent 9d463f52fb3a4d458477982963f3d278d5362b48\nauthor Mason Daugherty <mason@langchain.dev> 1781228597 -0400\ncommitter GitHub <noreply@github.com> 1781228597 -0400\n\nperf(evals): cut redundant I/O and serialized round-trips (#3880)\n\nEliminates redundant per-trial file reads/parses and replaces serialized\nblocking round-trips with concurrent ones, without changing behavior.\n\n- `scripts/analyze.py`: read each `trajectory.json`/`config.json` once\nper trial (was 2-4x), cache the task-directory index instead of\nre-globbing per trial, and analyze trials concurrently via a thread\npool.\n- `deepagents_harbor/metadata.py`: run the four independent sandbox\nprobes concurrently instead of one at a time.\n- `deepagents_harbor/langsmith.py`: process per-trial feedback with a\nbounded thread pool instead of serially.\n- `tests/evals/llm_judge.py`: grade criteria concurrently rather than\none LLM call at a time.\n\n\nMade by [Open SWE](https://openswe.vercel.app)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-12T01:43:18Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/f825290b21a7dd0555738baf26ee35a595ca2078","html_url":"https://github.com/langchain-ai/deepagents/commit/f825290b21a7dd0555738baf26ee35a595ca2078","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/f825290b21a7dd0555738baf26ee35a595ca2078/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"9d463f52fb3a4d458477982963f3d278d5362b48","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9d463f52fb3a4d458477982963f3d278d5362b48","html_url":"https://github.com/langchain-ai/deepagents/commit/9d463f52fb3a4d458477982963f3d278d5362b48"}]},{"sha":"9d463f52fb3a4d458477982963f3d278d5362b48","node_id":"C_kwDOPTymldoAKDlkNDYzZjUyZmIzYTRkNDU4NDc3OTgyOTYzZjNkMjc4ZDUzNjJiNDg","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-12T01:41:53Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T01:41:53Z"},"message":"perf(code): cache theme colors/charset, fix `O(n^2)` tool-call streaming (#3881)\n\nImproved responsiveness during streaming and rendering (faster tool-call\nstreaming, cached theme/charset lookups).\n\n---\n\n- `execute_task_textual`: streamed `tool_call_chunk` fragments were\nre-joined into one string and `json.loads`-ed on *every* fragment, which\nis O(n²) on the UI event loop and worst for large `edit_file` argument\nblobs. Now fragments accumulate in a list and the buffer is joined +\nparsed only when it looks like complete JSON (or on the final chunk).\n- `get_theme_colors`: derived built-in `ThemeColors` are now memoized\nper `(theme name, dark)` instead of re-running ~16 hex validations on\nevery widget render; the cache is cleared on `reload_registry`.\n- `_detect_charset_mode`: cached for the process like `get_glyphs`\nalready is, since charset mode can't change at runtime. Reset alongside\nthe glyph cache.\n- `AssistantMessage`: streamed text accumulates in a list and the full\nstring is materialized lazily, avoiding per-token concatenation.\n- `_compose_diff_content`: the hunk-header regex is compiled once at\nmodule level, and the stats/max-line scans are folded into a single pass\nover the diff lines.\n\nMade by [Open SWE](https://openswe.vercel.app)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"d1e189ef6ca03987248f3d6013360356f9ea6db4","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/d1e189ef6ca03987248f3d6013360356f9ea6db4"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/9d463f52fb3a4d458477982963f3d278d5362b48","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK2PhCRC1aQ7uu5UhlAAAxAoQAF73zXdi7hRo0IxIWlPHjs05\nj2Eq/8EgbMt6Zz5ep+h8IhCQrTMj58VVmbxeVK7KDz0IFUQ8yhs2CMLrLLVdMYv+\nb/W7Emwwf2Gop0IATmLlnLphznoIZWKw6bZQsQZueUTDuEhIdf8CDOIa3OcC3Hpn\nl6nB6YeEmqWs43WnM56TI5olgHkyTOxM/iWG1jXmSUOw1j+ar+BSoxQdkvyWrQMb\nITHSY/aOopGH7SeklEMwqDGeUmu1Cy8IHk/9+33yrG28xuDipHjnAbS1JPt5nxf2\nhfIQ9kSU1lJEejmDg9kNdMo/6fZCHQ42U5ssc+7xwreM4RpMHzLfWLppxvsW9uMM\n70Rq67kHvu/9TC5bhiJdjOYgQMTr8oIs0NOO+WAlFCnbEyCV72l+muemKVIBKWoc\nkNbyAAL90HCn+8IOGOIWhRJv2q5rwvlYHY9F3gtdVx5+cZO+2h0qIKTnlwIfm/km\nS4PUJ6nqCvDkLuqed9x7oXsDWPSf500zzvVZ9IVTwm1M0/vnkotG3fR9GqkMDith\nY5EszL5Wd6qYP7yrbNhyUmaYCW8SJdTtZ8kILqJB3vhNtaOxfzLtTTgVz5SbNuBF\n1CRiWc/zvzpEhKMH2jmAz4bIL2Bh6SR9n5JfJd+Da9Kr7PDduCnkPuiIGXWhdoVE\nhY0g5cPO9RP7WQCTzmCm\n=ULGM\n-----END PGP SIGNATURE-----\n","payload":"tree d1e189ef6ca03987248f3d6013360356f9ea6db4\nparent 3673d95d41aa00f03fbfe2083e46afa485800f3a\nauthor Mason Daugherty <mason@langchain.dev> 1781228513 -0400\ncommitter GitHub <noreply@github.com> 1781228513 -0400\n\nperf(code): cache theme colors/charset, fix `O(n^2)` tool-call streaming (#3881)\n\nImproved responsiveness during streaming and rendering (faster tool-call\nstreaming, cached theme/charset lookups).\n\n---\n\n- `execute_task_textual`: streamed `tool_call_chunk` fragments were\nre-joined into one string and `json.loads`-ed on *every* fragment, which\nis O(n²) on the UI event loop and worst for large `edit_file` argument\nblobs. Now fragments accumulate in a list and the buffer is joined +\nparsed only when it looks like complete JSON (or on the final chunk).\n- `get_theme_colors`: derived built-in `ThemeColors` are now memoized\nper `(theme name, dark)` instead of re-running ~16 hex validations on\nevery widget render; the cache is cleared on `reload_registry`.\n- `_detect_charset_mode`: cached for the process like `get_glyphs`\nalready is, since charset mode can't change at runtime. Reset alongside\nthe glyph cache.\n- `AssistantMessage`: streamed text accumulates in a list and the full\nstring is materialized lazily, avoiding per-token concatenation.\n- `_compose_diff_content`: the hunk-header regex is compiled once at\nmodule level, and the stats/max-line scans are folded into a single pass\nover the diff lines.\n\nMade by [Open SWE](https://openswe.vercel.app)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-06-12T01:41:53Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9d463f52fb3a4d458477982963f3d278d5362b48","html_url":"https://github.com/langchain-ai/deepagents/commit/9d463f52fb3a4d458477982963f3d278d5362b48","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/9d463f52fb3a4d458477982963f3d278d5362b48/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"3673d95d41aa00f03fbfe2083e46afa485800f3a","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/3673d95d41aa00f03fbfe2083e46afa485800f3a","html_url":"https://github.com/langchain-ai/deepagents/commit/3673d95d41aa00f03fbfe2083e46afa485800f3a"}]},{"sha":"3673d95d41aa00f03fbfe2083e46afa485800f3a","node_id":"C_kwDOPTymldoAKDM2NzNkOTVkNDFhYTAwZjAzZmJmZTIwODNlNDZhZmE0ODU4MDBmM2E","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-12T00:34:45Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-12T00:34:45Z"},"message":"fix(sdk): stream Python grep fallback (#3886)\n\nStreams the Python grep fallback line-by-line instead of reading each\ncandidate file into memory, and keeps fallback matching literal to\nmirror the tool contract.\n\nThis also surfaces partial read failures that happen after scanning has\nstarted, while continuing to skip wholly undecodable files silently like\nthe existing fallback behavior.\n\n### Behavioral notes\n\nThe Python `grep` fallback is exercised only when `ripgrep` is\nunavailable. This PR has two intentional, non-breaking changes that\nbring it in line with both the sibling `read()` method and the `ripgrep`\nprimary path:\n\n- **Decoding is pinned to UTF-8** (`errors=\"strict\"`) instead of the\nplatform locale default. Every other read/write path in the backends\nalready pins UTF-8; the fallback was the lone outlier since the original\nexperimental backend. On a non-UTF-8 locale, fallback decoding now\nmatches `read()` and `ripgrep` rather than the host locale.\n- **Line splitting is narrower**: lines now break only on `\\n` / `\\r` /\n`\\r\\n` (matching `ripgrep`), not on the exotic separators that\n`str.splitlines()` also breaks on (form feed, vertical tab,\nfile/group/record separators, NEL, and the Unicode line/paragraph\nseparators). CRLF / CR match text is unchanged, since universal-newline\ntranslation still applies on read.\n\n### Benchmarks\n\nFocused local microbenchmarks compared the original combined branch\nagainst `main` on Python 3.14.2:\n\n- Forced Python grep fallback: **1.06x faster** (`main`: 0.030186s, PR:\n0.028388s median; ~6.0% improvement).","tree":{"sha":"bdd410f22e4c8b58134c02133faa363849e55082","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/bdd410f22e4c8b58134c02133faa363849e55082"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/3673d95d41aa00f03fbfe2083e46afa485800f3a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK1QlCRC1aQ7uu5UhlAAAKaAQAEZ+YyIB/wSPUPx7AlI4ODSD\nfb2G+Wh9Ck9uad2wjhyQCtmAzYfTt4YghZVNLe9eiEkoV8EscfYv1xSpaIizuiA6\n4rmgMpTYkX/l3FLx+G6Y4wNJ1wkrWxKyS9VVaXaL2ManN5VTHoo2C77ul5K5//V1\nAGbET0RxIv/qetvJ1dTwBs3OiIjDzXDxBi03QG0xxLcwjK5o69W3mvbNudcC7TSA\nOXhgGKySZtGJbLQg7TFriIV1snvDJI6CCvDCbAFip1fmp4MLUBTeUkVgK6ZkhLsW\nNiQmQsuQPy+oB1QqQ5KzA2n5Zw9yqacEeZJViKsvp9sx8LeQAqQ8Zf3ACpDatAZB\nySk/F8+LR7l/9jFUB2zS096CB8m94EbLEq0QlU1aWHpCyklglynSUCCPhHcQSyQV\nVWOfB6TX5Gk4QIeGu3sfX2AH9+WQUF6QOtttESAwNRFxJnoTathsXYjWYu27ZFRO\nZNLWJRo5Kk6djGBuBLyvgxBC5L9hdOzNBSWvry905caiQ9yCLRo6Cm/d29i314Ab\nkWVdZ2AXKIV594ffQGosMETAM+k3YA34i/TjX9kUwMfCSJhBlbGxaWMzOWOpm997\n2uf52bQ8a8p/RLzbTXSNxJSjbz3DbXaPIj+7Z5ZIXmGcsEzyCH//BGBHdljCqI+Y\nL//5JmoP8BcGhDkqHLL8\n=negl\n-----END PGP SIGNATURE-----\n","payload":"tree bdd410f22e4c8b58134c02133faa363849e55082\nparent eae3cf148de3f8c8ee9ffd8af6e5a5e06cce9d6f\nauthor Mason Daugherty <mason@langchain.dev> 1781224485 -0400\ncommitter GitHub <noreply@github.com> 1781224485 -0400\n\nfix(sdk): stream Python grep fallback (#3886)\n\nStreams the Python grep fallback line-by-line instead of reading each\ncandidate file into memory, and keeps fallback matching literal to\nmirror the tool contract.\n\nThis also surfaces partial read failures that happen after scanning has\nstarted, while continuing to skip wholly undecodable files silently like\nthe existing fallback behavior.\n\n### Behavioral notes\n\nThe Python `grep` fallback is exercised only when `ripgrep` is\nunavailable. This PR has two intentional, non-breaking changes that\nbring it in line with both the sibling `read()` method and the `ripgrep`\nprimary path:\n\n- **Decoding is pinned to UTF-8** (`errors=\"strict\"`) instead of the\nplatform locale default. Every other read/write path in the backends\nalready pins UTF-8; the fallback was the lone outlier since the original\nexperimental backend. On a non-UTF-8 locale, fallback decoding now\nmatches `read()` and `ripgrep` rather than the host locale.\n- **Line splitting is narrower**: lines now break only on `\\n` / `\\r` /\n`\\r\\n` (matching `ripgrep`), not on the exotic separators that\n`str.splitlines()` also breaks on (form feed, vertical tab,\nfile/group/record separators, NEL, and the Unicode line/paragraph\nseparators). CRLF / CR match text is unchanged, since universal-newline\ntranslation still applies on read.\n\n### Benchmarks\n\nFocused local microbenchmarks compared the original combined branch\nagainst `main` on Python 3.14.2:\n\n- Forced Python grep fallback: **1.06x faster** (`main`: 0.030186s, PR:\n0.028388s median; ~6.0% improvement).","verified_at":"2026-06-12T00:34:46Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/3673d95d41aa00f03fbfe2083e46afa485800f3a","html_url":"https://github.com/langchain-ai/deepagents/commit/3673d95d41aa00f03fbfe2083e46afa485800f3a","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/3673d95d41aa00f03fbfe2083e46afa485800f3a/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"eae3cf148de3f8c8ee9ffd8af6e5a5e06cce9d6f","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/eae3cf148de3f8c8ee9ffd8af6e5a5e06cce9d6f","html_url":"https://github.com/langchain-ai/deepagents/commit/eae3cf148de3f8c8ee9ffd8af6e5a5e06cce9d6f"}]},{"sha":"eae3cf148de3f8c8ee9ffd8af6e5a5e06cce9d6f","node_id":"C_kwDOPTymldoAKGVhZTNjZjE0OGRlM2Y4YzhlZTlmZmQ4YWY2ZTVhNWUwNmNjZTlkNmY","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-11T23:59:26Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-11T23:59:26Z"},"message":"perf(sdk): cache grep glob matchers (#3887)\n\nCaches compiled glob matchers used by in-memory grep helpers and hoists\nthe Context Hub glob translation outside the per-file loop.\n\nThis avoids recompiling the same glob pattern for every candidate file\nwhile preserving brace expansion and existing glob semantics.\n\n### Benchmarks\n\nFocused local microbenchmarks compared the original combined branch\nagainst `main` on Python 3.14.2:\n\n- State backend `_grep_search_files` with glob filtering: **3.50x\nfaster** (`main`: 0.045913s, PR: 0.013116s median; ~71.4% improvement).\n- State backend `grep_matches_from_files` with glob filtering: **3.71x\nfaster** (`main`: 0.044786s, PR: 0.012071s median; ~73.0% improvement).","tree":{"sha":"73ed7a25362fb1311ff96673360310fbf019b61d","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/73ed7a25362fb1311ff96673360310fbf019b61d"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/eae3cf148de3f8c8ee9ffd8af6e5a5e06cce9d6f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK0veCRC1aQ7uu5UhlAAAjrYQAFqi2/65S+9DMj6sLlTQRWJa\nFY2OTsRfWt9ZfNzlPpCvx+Ly58yNg8Wq3Z/aLu+sZLqSSDj3b/Ig00f9MR5/uVSg\nJKtyjKeoZEfrJMM5Pc6LNts6mZTsXqnIIXoEcvN8j2I4RikF1HYKYPwU9HJAh2Wy\nL1uOfyd41e8YPN0kZ4ohvxhoYkRmFvi0h8Tknytb++AJMZt4Wx50w+649cs1DMsc\nsvVNr3HyAMTzbN6/GdpYumpF6NX8TZ0hfvpfMqv4v9ObPPIPsqB2M4k8mcIcVIDD\n9w+TvUkArGJA14775RkQFmPHvVwDvUYRy31/ua7xSpn2M56zO5Wvr/b+ubhmMNr0\n/YqzHIGwbMSoRPuIyr1exmhlg77gmtsMOe0v51oSwU7beyhJiANYmK6FGUxYA9ql\nF4XgTVP9re6N+YGkEhioI6JmrO3vUxne2E5/KX77tzn8q0C21/CVgmYkAkY6pn+k\nJCaCnWC10qHgrbBvdXfkWzRtXXvLYHB1gc7Tfkdvj5d7pFppwTDogrclN+JACMyp\nGp2oafSUfAEyxZb5sAnf6lgU5TrQ6rD/+23f1a1fFfjbEJWq1LDatgu5ssyhGsEa\nSna4iCnu0itAN3wop8yZoCkzoz8fYAZmae6fZ0FNVVMCjggEzqV0uEowQ+TTuEn+\nfdVEIHKaY3StINCvm3eu\n=M0T0\n-----END PGP SIGNATURE-----\n","payload":"tree 73ed7a25362fb1311ff96673360310fbf019b61d\nparent 6c52c80382681395f26eaa75422fcfa11fecbfa7\nauthor Mason Daugherty <mason@langchain.dev> 1781222366 -0400\ncommitter GitHub <noreply@github.com> 1781222366 -0400\n\nperf(sdk): cache grep glob matchers (#3887)\n\nCaches compiled glob matchers used by in-memory grep helpers and hoists\nthe Context Hub glob translation outside the per-file loop.\n\nThis avoids recompiling the same glob pattern for every candidate file\nwhile preserving brace expansion and existing glob semantics.\n\n### Benchmarks\n\nFocused local microbenchmarks compared the original combined branch\nagainst `main` on Python 3.14.2:\n\n- State backend `_grep_search_files` with glob filtering: **3.50x\nfaster** (`main`: 0.045913s, PR: 0.013116s median; ~71.4% improvement).\n- State backend `grep_matches_from_files` with glob filtering: **3.71x\nfaster** (`main`: 0.044786s, PR: 0.012071s median; ~73.0% improvement).","verified_at":"2026-06-11T23:59:27Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/eae3cf148de3f8c8ee9ffd8af6e5a5e06cce9d6f","html_url":"https://github.com/langchain-ai/deepagents/commit/eae3cf148de3f8c8ee9ffd8af6e5a5e06cce9d6f","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/eae3cf148de3f8c8ee9ffd8af6e5a5e06cce9d6f/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"6c52c80382681395f26eaa75422fcfa11fecbfa7","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/6c52c80382681395f26eaa75422fcfa11fecbfa7","html_url":"https://github.com/langchain-ai/deepagents/commit/6c52c80382681395f26eaa75422fcfa11fecbfa7"}]},{"sha":"6c52c80382681395f26eaa75422fcfa11fecbfa7","node_id":"C_kwDOPTymldoAKDZjNTJjODAzODI2ODEzOTVmMjZlYWE3NTQyMmZjZmExMWZlY2JmYTc","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-11T23:42:28Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-11T23:42:28Z"},"message":"fix(ci): scope lockfile checks to touched packages (#3891)\n\nLockfile validation now follows the same package boundary as the PR diff\ninstead of treating every package in the repo as in scope. That keeps\nunrelated stale lockfiles from blocking scoped work or forcing extra\npath changes that release-please may interpret as release-relevant.","tree":{"sha":"5a6cd630557f02e7d0a19d26cd3e8f336524d446","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/5a6cd630557f02e7d0a19d26cd3e8f336524d446"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/6c52c80382681395f26eaa75422fcfa11fecbfa7","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqK0fkCRC1aQ7uu5UhlAAA2YkQAGCzShp8zJJc0nRx7kbEWJRs\nNwj3diXEmX+tulEORThHGvdl06dX8xSKL1dNCyYdG0n3Ebh3Sq9eBq4oYe2EXvvY\nA2XxHXr2YMTnsaAb8DTVBoZYgRmDWUZk6LVkgwPHjXDLR8EgQNxHoMvn0CF7NHw5\nZUVB+Ert+l+Wi69wqB8D5N8uB1rxSn05vM6lLqjcsGzqKSQoceOMbq1OvD9h1Z3w\nXqeubLIU5OcbC/XCdX3qQ3ZjWoOqTpCdDhllrH68rgqkehTC7MH9s+iCJd721UJH\n15oKS+e77jopv8Obam/WBbzxh/Tt4FILAVI7lQ/wCPJcdXVfgAtDWSIXac4tVr7G\nlz3STp8UHEzsUllHVR6rOwFeh1a8ICNIqFMhkpxeYHPyjCOlGWpWI8d72Tap1AKZ\nfbIK/7sKB26brTPfpiSdyOJlsexJzRy/0c2lZHFasRMzmN/18muuGkmMO8P6uSAR\nMsl+EX8sfCc0YW/GPgRaZZqOO/9mJ0WEal069vKnKFEteHXEGTatLZ3YYu6X8C+N\n7fKdcuRv0qAj8/UsV7UK53DXT2WHuuCwJvvJXsq2GWhXElL16esKAxw6//km1+ZW\nEip2Ph3eKG63IOjQLH3bPpMrLx8K/8Aak700cQjgQjYQCJk+JsA9BmpWeDnlYB0B\nLb+JYpOYs6vlK9q36ldt\n=wE+W\n-----END PGP SIGNATURE-----\n","payload":"tree 5a6cd630557f02e7d0a19d26cd3e8f336524d446\nparent 33d900c98b686aa7e7782d0be3019010ced5f03a\nauthor Mason Daugherty <mason@langchain.dev> 1781221348 -0400\ncommitter GitHub <noreply@github.com> 1781221348 -0400\n\nfix(ci): scope lockfile checks to touched packages (#3891)\n\nLockfile validation now follows the same package boundary as the PR diff\ninstead of treating every package in the repo as in scope. That keeps\nunrelated stale lockfiles from blocking scoped work or forcing extra\npath changes that release-please may interpret as release-relevant.","verified_at":"2026-06-11T23:42:29Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/6c52c80382681395f26eaa75422fcfa11fecbfa7","html_url":"https://github.com/langchain-ai/deepagents/commit/6c52c80382681395f26eaa75422fcfa11fecbfa7","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/6c52c80382681395f26eaa75422fcfa11fecbfa7/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"33d900c98b686aa7e7782d0be3019010ced5f03a","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/33d900c98b686aa7e7782d0be3019010ced5f03a","html_url":"https://github.com/langchain-ai/deepagents/commit/33d900c98b686aa7e7782d0be3019010ced5f03a"}]},{"sha":"33d900c98b686aa7e7782d0be3019010ced5f03a","node_id":"C_kwDOPTymldoAKDMzZDkwMGM5OGI2ODZhYTdlNzc4MmQwYmUzMDE5MDEwY2VkNWYwM2E","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-11T23:07:07Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-11T23:07:07Z"},"message":"fix(sdk): normalize read slices after windowing (#3888)\n\nChanges `slice_read_response` to split first and normalize line endings\nonly across the requested read window.\n\nThis avoids rewriting the full file contents for paginated reads while\npreserving LF-normalized output for downstream edit and grep behavior.\n\n### Benchmarks\n\nFocused local microbenchmarks compared the original combined branch\nagainst `main` on Python 3.14.2:\n\n- `slice_read_response` on large CRLF content: **2.55x faster** for both\nfirst-window and late-window reads (~60.8% improvement), with **~29.2%\nlower peak memory**.","tree":{"sha":"01d4967ad69c3687cfd9abdff487a17827ab7383","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/01d4967ad69c3687cfd9abdff487a17827ab7383"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/33d900c98b686aa7e7782d0be3019010ced5f03a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqKz+bCRC1aQ7uu5UhlAAAJjgQAFSNtIpSmnNkPA2Upl+zUUGu\nlxnLmpcuY9s6LGk2NAF8/AEzfE41GZM4DYguhrJHUVejTep4FQ0JSXZ6oer+vH8Y\nFCLLqgEp1vuetzir4yuo7iAkWjyH8WX1DJs2JOrT4i1lGSSXbD2p12l+pOkQRkX+\n0MKx1nsjHZWudhjG6vFVW9b4mbIelFFNJIwq+DbbDWotc5cRGEyODr3k77Wmr1Dr\n+EwXIa16l7Y/WkoHFu+qv+wwIy66g+90M1mL7/KYX4HPSd65p/OqacqLh95qqU0P\ngRto1wzIa5ooUEBDG3BFEpvydPr/FxM79jlw+2AbQunvBQyFSaUzna5RVTf0Wes1\nRRP4YOnoHV4gobjU6MGzWCZafYKTQOHOnyx9KHvgq+WsaSSg/EeUUstm219tZeoB\nL52325CnyTFC9e6Au9dx49VaKCh7XpRa5PF+xwLHSlxvCLd07sL8rwo3c9j6CW8B\nSxtOXqLTpcV2fA9vYAz5KbAm9OCNuf9wHSTI7CNHjGtO31vGuqQB1vdClbAJPxb7\n4OWbKqTxcH0LV6v8srOuL1wKMfQccl45oqSqI5zYpRFzYxIPGmvQOryLUPfGfuZL\nqd/my2chEyeze+2XBrXf9weDlnItLWrcaFGEhYyGKv8OJUaAZnn+aKHnfyFGYqWf\ncylCh1vhB1YwxkX5w1dq\n=3x2N\n-----END PGP SIGNATURE-----\n","payload":"tree 01d4967ad69c3687cfd9abdff487a17827ab7383\nparent 2f432ba63687d7c8488d5d41d0551d02b4ae00b4\nauthor Mason Daugherty <mason@langchain.dev> 1781219227 -0400\ncommitter GitHub <noreply@github.com> 1781219227 -0400\n\nfix(sdk): normalize read slices after windowing (#3888)\n\nChanges `slice_read_response` to split first and normalize line endings\nonly across the requested read window.\n\nThis avoids rewriting the full file contents for paginated reads while\npreserving LF-normalized output for downstream edit and grep behavior.\n\n### Benchmarks\n\nFocused local microbenchmarks compared the original combined branch\nagainst `main` on Python 3.14.2:\n\n- `slice_read_response` on large CRLF content: **2.55x faster** for both\nfirst-window and late-window reads (~60.8% improvement), with **~29.2%\nlower peak memory**.","verified_at":"2026-06-11T23:07:08Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/33d900c98b686aa7e7782d0be3019010ced5f03a","html_url":"https://github.com/langchain-ai/deepagents/commit/33d900c98b686aa7e7782d0be3019010ced5f03a","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/33d900c98b686aa7e7782d0be3019010ced5f03a/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/md