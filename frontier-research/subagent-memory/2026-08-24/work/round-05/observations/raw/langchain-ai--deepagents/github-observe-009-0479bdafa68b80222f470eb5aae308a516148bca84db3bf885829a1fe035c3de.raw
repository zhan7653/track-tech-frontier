ffb6aa73ddc0e67b422869946e98","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/22969c05389effb6aa73ddc0e67b422869946e98","html_url":"https://github.com/langchain-ai/deepagents/commit/22969c05389effb6aa73ddc0e67b422869946e98"}]},{"sha":"22969c05389effb6aa73ddc0e67b422869946e98","node_id":"C_kwDOPTymldoAKDIyOTY5YzA1Mzg5ZWZmYjZhYTczZGRjMGU2N2I0MjI4Njk5NDZlOTg","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-20T19:33:24Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-20T19:33:24Z"},"message":"docs(repo): improve libs README and call out `dcode` by name (#4864)\n\nImproves the `libs/` monorepo README so newcomers can quickly find their\nfooting and understand what each package is.\n\n---\n\nThe previous README listed packages in a plain code block. This reworks\nit into a linked table (each package points at its directory and PyPI\nproject) and adds a getting-started callout for the prebuilt terminal\ncoding agent, Deep Agents Code — calling out `deepagents-code` and its\n`dcode` command by name so readers know the fastest way to try Deep\nAgents. Documentation-only change.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/5f35224b-a63a-8e01-68f8-3cad100b4cbe)\n\n---------\n\nSigned-off-by: Mason Daugherty <github@mdrxy.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"e433b57953424a58251a7c00f0f0a1225aba6e51","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/e433b57953424a58251a7c00f0f0a1225aba6e51"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/22969c05389effb6aa73ddc0e67b422869946e98","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqXngECRC1aQ7uu5UhlAAAJZMQABdgcy0ccP6wZZ8eaCd1xV+3\nSFhEIjYv7LR3XlfHP0bmp/5kOZEBwTUnJP3SSrYi82jMvoJyok4X1LGCX8GL1TUi\n3miu3u8aHErp1w9ydj0GZv7l1M7wJ/vtAZL515aAK/suSwEmkexT9xr7FIimlBqY\ns2xe2VIEyCxSc1PuqY0ycJuix8p65BJFu9CNwQ1WX2D1dNf58Kfj8Q3MJ5ItuQPT\ndJppwzhisNRO/id5S+xPEt/LNQ+sn3MWdK4XcFQS4SzvYEDk68Qv3efFnN2fro6O\nGiCe50ybxEWSmqrSUWemn/q4Ma3vB3tW5+Miif46B57/RfhlHfrtpwuzt3j4Yuf8\n3Xibv6AYauFq8A8llxkFsXJEefLNv7pbaUTtFK0WxjGA8VkTyecqAxOQTBfYd/qP\nYMTiMybE02Q9jC8QQAC3cy8oJDSbwGkU2Y5+t31VkB4MNyWV2f4RMSUZ9GSUYXdY\n4tdM4cI8r7j14G4ghOx4QSsgNKRi+l9VQx2Vwz2UfylgGPBsFM0De32L8lDUImlE\novg2mdZoQe0unOgZ1UVuyz33J1EGzIQhIUsY/j4wCw5Pj4nb/HpoGL6tjaDCYs+s\nEj30E3yK6USUvexe5AIr72/7lkuu5HS0Vl3w7hoKULTUrg67A03veqyndoKCs7oI\nItIna7n+2863k1BYH5mJ\n=z9Fl\n-----END PGP SIGNATURE-----\n","payload":"tree e433b57953424a58251a7c00f0f0a1225aba6e51\nparent 3733526f5faa187627c650435fa5478754c55fb4\nauthor Mason Daugherty <mason@langchain.dev> 1784576004 -0400\ncommitter GitHub <noreply@github.com> 1784576004 -0400\n\ndocs(repo): improve libs README and call out `dcode` by name (#4864)\n\nImproves the `libs/` monorepo README so newcomers can quickly find their\nfooting and understand what each package is.\n\n---\n\nThe previous README listed packages in a plain code block. This reworks\nit into a linked table (each package points at its directory and PyPI\nproject) and adds a getting-started callout for the prebuilt terminal\ncoding agent, Deep Agents Code — calling out `deepagents-code` and its\n`dcode` command by name so readers know the fastest way to try Deep\nAgents. Documentation-only change.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/5f35224b-a63a-8e01-68f8-3cad100b4cbe)\n\n---------\n\nSigned-off-by: Mason Daugherty <github@mdrxy.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-07-20T19:33:25Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/22969c05389effb6aa73ddc0e67b422869946e98","html_url":"https://github.com/langchain-ai/deepagents/commit/22969c05389effb6aa73ddc0e67b422869946e98","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/22969c05389effb6aa73ddc0e67b422869946e98/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"3733526f5faa187627c650435fa5478754c55fb4","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/3733526f5faa187627c650435fa5478754c55fb4","html_url":"https://github.com/langchain-ai/deepagents/commit/3733526f5faa187627c650435fa5478754c55fb4"}]},{"sha":"3733526f5faa187627c650435fa5478754c55fb4","node_id":"C_kwDOPTymldoAKDM3MzM1MjZmNWZhYTE4NzYyN2M2NTA0MzVmYTU0Nzg3NTRjNTVmYjQ","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-07-20T19:31:46Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-20T19:31:46Z"},"message":"fix(code): bust CDN cache on forced `dcode update` checks (#4862)\n\n`dcode update` now returns fresh results even in the seconds right after\na new release lands on PyPI.\n\n---\n\n`dcode update` already calls `is_update_available(bypass_cache=True)`,\nwhich skips the local on-disk version cache. But PyPI's JSON API is\nserved through a CDN (Fastly), so immediately after a release an edge\nnode can keep serving a stale copy until the purge propagates. That's\nwhy a first `dcode update` reported \"Already on the latest version\n(v0.1.43)\" while a retry seconds later found v0.1.44.\n\nWhen the local cache is bypassed, the PyPI requests now also defeat the\nCDN edge cache: they send `Cache-Control: no-cache` / `Pragma: no-cache`\nrequest headers and append a unique cache-busting query parameter so the\nCDN cache key misses and the response comes fresh from origin. A shared\n`_pypi_request_kwargs` helper applies this consistently to the version\ncheck, the per-release pre-release-pin lookup, and the SDK release-time\nlookup. Routine (non-forced) refreshes are unchanged.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/f2647aaa-94ac-f901-c39d-e081d0eb1f79)\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"b210582172eb51d6481968aba8ecad757056edfb","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/b210582172eb51d6481968aba8ecad757056edfb"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/3733526f5faa187627c650435fa5478754c55fb4","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqXneiCRC1aQ7uu5UhlAAArxoQALDUyUVQo0FIizx6HyHqAfpa\n+O/GBj8q8vX1kWFtFNnpQhAhHe/gg7jMFwDMmUfhYw8luDdbMfW3/HvQVFBa+oAk\nFoCq41qzuFEgGlyiteaPao5faSbH1E9hFRW/IDybc4Thcd6ViPxD1Irbs2nfZ9ur\nbwXKEvfzxtsl2N5SoaKGrQzgSF0EBZdcOSHySPdyY6KvpKolPTzSmsmODiCjYJDF\nStJEphInlcMcwulNjZgP9e1q1FSM9elQXBnDyoBEp9tnd4v5n2xBQAyT52uRD7Xi\n3fkNQQoUXdQrVt5IQNk2vpIQ7EUBomtRHMG+Puc3chyTtvE1wQzO5L1awqmoJ86I\nCCpFdIQlJ8emA0VIpyJGF740wZZwyzw+s04y1qgI6JP92hlwRE6Ym4WJPRfzBRCM\nyidiqqAO1hUc1htBhrYmbGWNxSYVd2B9zOlf2KeobzNASu7Lyc//iORHS0bUFSZG\n/s/tEJFPaQa7nLefZIH/WspoheaBXvwoivdYlSZlGnaTY+0uFTfE/2oKTl/9rW5Q\nq0kI+F+nZWrobpucKIS5j85Ize4XQwq1nm1Hw999/1lfAKZFPFQJJAuNsq4citCl\nphsN2o8WAV5pUX9oq02hn/j36FYUH2vRjL6Jqd3mUktaEtz8yIK7fBTkjbUPsfTl\n8lhF7+Svn2/sn1VN0LPd\n=AE2i\n-----END PGP SIGNATURE-----\n","payload":"tree b210582172eb51d6481968aba8ecad757056edfb\nparent 54ccd67ca83656b0aec3721119681d8c13f727a0\nauthor Mason Daugherty <mason@langchain.dev> 1784575906 -0400\ncommitter GitHub <noreply@github.com> 1784575906 -0400\n\nfix(code): bust CDN cache on forced `dcode update` checks (#4862)\n\n`dcode update` now returns fresh results even in the seconds right after\na new release lands on PyPI.\n\n---\n\n`dcode update` already calls `is_update_available(bypass_cache=True)`,\nwhich skips the local on-disk version cache. But PyPI's JSON API is\nserved through a CDN (Fastly), so immediately after a release an edge\nnode can keep serving a stale copy until the purge propagates. That's\nwhy a first `dcode update` reported \"Already on the latest version\n(v0.1.43)\" while a retry seconds later found v0.1.44.\n\nWhen the local cache is bypassed, the PyPI requests now also defeat the\nCDN edge cache: they send `Cache-Control: no-cache` / `Pragma: no-cache`\nrequest headers and append a unique cache-busting query parameter so the\nCDN cache key misses and the response comes fresh from origin. A shared\n`_pypi_request_kwargs` helper applies this consistently to the version\ncheck, the per-release pre-release-pin lookup, and the SDK release-time\nlookup. Routine (non-forced) refreshes are unchanged.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/f2647aaa-94ac-f901-c39d-e081d0eb1f79)\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-07-20T19:31:47Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/3733526f5faa187627c650435fa5478754c55fb4","html_url":"https://github.com/langchain-ai/deepagents/commit/3733526f5faa187627c650435fa5478754c55fb4","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/3733526f5faa187627c650435fa5478754c55fb4/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"54ccd67ca83656b0aec3721119681d8c13f727a0","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/54ccd67ca83656b0aec3721119681d8c13f727a0","html_url":"https://github.com/langchain-ai/deepagents/commit/54ccd67ca83656b0aec3721119681d8c13f727a0"}]},{"sha":"54ccd67ca83656b0aec3721119681d8c13f727a0","node_id":"C_kwDOPTymldoAKDU0Y2NkNjdjYTgzNjU2YjBhZWMzNzIxMTE5NjgxZDhjMTNmNzI3YTA","commit":{"author":{"name":"Shrikar Seshadri","email":"146694785+davibinboi@users.noreply.github.com","date":"2026-07-20T19:04:18Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-20T19:04:18Z"},"message":"fix(evals): verify and record comparison SHAs (#4834)\n\nBuilds on #4824 by Nick (merged into main).\n\n### Workflow\n1. Each branch is resolved to one SHA.\n2. Each shard fetches that exact SHA.\n3. The workflow overlays these source directories:\n   - `libs/deepagents`\n   - `libs/code`\n   - `libs/partners/quickjs`\n4. These are copied into the Harbor LangGraph project's `.local_deps`.\n5. Harbor installs those local source packages when constructing the\nsandbox environment.\n6. The sandboxed agent imports the installed packages normally.\n\n### What this PR adds\n- Resolves the branch's head via `git ls-remote --exit-code\nrefs/heads/<branch>` and hardens it as the SHA (previously used\n`refs/<branch>` and took the first result).\n- Verifies `FETCH_HEAD` matches `BRANCH_SHA`; fails the shard on\nmismatch.\n- Adds branch-to-SHA mappings to the GitHub workflow summary — all\nleaves include a `source_sha`, and prep emits a sources list of\n`{branch, sha}` pairs.\n- Adds SHA provenance throughout result files:\n  - `_harbor_run.yml` passes `branch_sha` to the shard aggregator.\n  - Each leaf `summary.json` records `source_sha`.\n  - Each combined Unified result row records `source_sha`.\n- Missing-leaf placeholder rows retain the expected SHA, making it easy\nto identify the redeployment command if a shard fails.\n- Adds test coverage for all of the above.\n\n### Notes\n- No product wheels — unnecessary for this change.\n- Evaluator harness stays pinned to the workflow reference (main\nbranch).\n- `unified_evals.yml` still supports single-branch testing via the\nstandard workflow input.\n- No trace analysis, retry/timeout controls, or LangSmith usage/cost\nanalysis (planned for future PRs).\n\n### Tests\n- 141 focused prep, workflow, provenance, and aggregation tests passed.\n- Ruff checks passed on all changed Python files.\n- Both modified workflow YAML files parsed successfully.\n- One unrelated macOS temp-directory test was excluded — system Python\ncreates an xcrun cache entry in its asserted-empty temp directory.\n\n---------\n\nCo-authored-by: Nick Hollon <nick.hollon@langchain.dev>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","tree":{"sha":"444b22216f665319a41f383d26b0d39b53eca759","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/444b22216f665319a41f383d26b0d39b53eca759"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/54ccd67ca83656b0aec3721119681d8c13f727a0","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqXnEyCRC1aQ7uu5UhlAAAZBcQAB1eXku//YtplQcIdCqiLkdz\nMB92WVFcsDMrh5vrDXmhBc5wcRGdvE2AdwdgQMV9wzusyv1lW6AnIVuN7YFgLHSD\nK0nUbVVhYF8DYmiMAW+JjdYNJ5ODUNPYqIdneCnXfDbBN4U4G/caVv7J1GcV8+N+\n6ZJ33k5W5Vs3sPRiR97BCyWXvcCwyCX8r8d16i+uvDwFXwKoimc2nv47HXiG0TH/\nKWAlzxzs8adMdgvp201zotfEy6CKAh7xm/ihf+NDf4NW+0F+m7VoL+367Fl+LRSu\nHyALuGP+KNJd1+C05zaofuaqv6lsNXC9UVHbQw3Y0fCLCQO38+AcrOZZlrF3Gw5Q\nwX23M6qBi1Ur30jGcHYRydBR3XzRY7dQl12SW21wkHbZqTPfBNy4c0pae14M+QdB\n9AK4dlQ/qjAL4Bo+qVcxBezlwg018SXnESP1cbGyR7KPjNxUgZaqw33UXQVwmdNb\nyxh8uGc+28Q48vwch8nt/F3pjqJUrffTMUdqAewt+B7AgWMp4N4e7lBUeyoZ6zIA\nd2o2eKCH39dWNzKRoBtFnvpGoJdR8KW6YJ6p86Xrt3RdzqdCRMONBm0z4YNuv9tP\nn68hz/I4Z8Qo3y/gTnCJ7Gbq/JpsE6gmfka5wptZxyypKow/4hfwC2oXoEAOgHI+\nkd7fa4jFmRqGpZQ4OjLM\n=kAIu\n-----END PGP SIGNATURE-----\n","payload":"tree 444b22216f665319a41f383d26b0d39b53eca759\nparent cf3cfc2afeaca4ecc02961c9613d46811aaf8111\nauthor Shrikar Seshadri <146694785+davibinboi@users.noreply.github.com> 1784574258 -0700\ncommitter GitHub <noreply@github.com> 1784574258 -0700\n\nfix(evals): verify and record comparison SHAs (#4834)\n\nBuilds on #4824 by Nick (merged into main).\n\n### Workflow\n1. Each branch is resolved to one SHA.\n2. Each shard fetches that exact SHA.\n3. The workflow overlays these source directories:\n   - `libs/deepagents`\n   - `libs/code`\n   - `libs/partners/quickjs`\n4. These are copied into the Harbor LangGraph project's `.local_deps`.\n5. Harbor installs those local source packages when constructing the\nsandbox environment.\n6. The sandboxed agent imports the installed packages normally.\n\n### What this PR adds\n- Resolves the branch's head via `git ls-remote --exit-code\nrefs/heads/<branch>` and hardens it as the SHA (previously used\n`refs/<branch>` and took the first result).\n- Verifies `FETCH_HEAD` matches `BRANCH_SHA`; fails the shard on\nmismatch.\n- Adds branch-to-SHA mappings to the GitHub workflow summary — all\nleaves include a `source_sha`, and prep emits a sources list of\n`{branch, sha}` pairs.\n- Adds SHA provenance throughout result files:\n  - `_harbor_run.yml` passes `branch_sha` to the shard aggregator.\n  - Each leaf `summary.json` records `source_sha`.\n  - Each combined Unified result row records `source_sha`.\n- Missing-leaf placeholder rows retain the expected SHA, making it easy\nto identify the redeployment command if a shard fails.\n- Adds test coverage for all of the above.\n\n### Notes\n- No product wheels — unnecessary for this change.\n- Evaluator harness stays pinned to the workflow reference (main\nbranch).\n- `unified_evals.yml` still supports single-branch testing via the\nstandard workflow input.\n- No trace analysis, retry/timeout controls, or LangSmith usage/cost\nanalysis (planned for future PRs).\n\n### Tests\n- 141 focused prep, workflow, provenance, and aggregation tests passed.\n- Ruff checks passed on all changed Python files.\n- Both modified workflow YAML files parsed successfully.\n- One unrelated macOS temp-directory test was excluded — system Python\ncreates an xcrun cache entry in its asserted-empty temp directory.\n\n---------\n\nCo-authored-by: Nick Hollon <nick.hollon@langchain.dev>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","verified_at":"2026-07-20T19:04:19Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/54ccd67ca83656b0aec3721119681d8c13f727a0","html_url":"https://github.com/langchain-ai/deepagents/commit/54ccd67ca83656b0aec3721119681d8c13f727a0","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/54ccd67ca83656b0aec3721119681d8c13f727a0/comments","author":{"login":"davibinboi","id":146694785,"node_id":"U_kgDOCL5igQ","avatar_url":"https://avatars.githubusercontent.com/u/146694785?v=4","gravatar_id":"","url":"https://api.github.com/users/davibinboi","html_url":"https://github.com/davibinboi","followers_url":"https://api.github.com/users/davibinboi/followers","following_url":"https://api.github.com/users/davibinboi/following{/other_user}","gists_url":"https://api.github.com/users/davibinboi/gists{/gist_id}","starred_url":"https://api.github.com/users/davibinboi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/davibinboi/subscriptions","organizations_url":"https://api.github.com/users/davibinboi/orgs","repos_url":"https://api.github.com/users/davibinboi/repos","events_url":"https://api.github.com/users/davibinboi/events{/privacy}","received_events_url":"https://api.github.com/users/davibinboi/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"cf3cfc2afeaca4ecc02961c9613d46811aaf8111","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/cf3cfc2afeaca4ecc02961c9613d46811aaf8111","html_url":"https://github.com/langchain-ai/deepagents/commit/cf3cfc2afeaca4ecc02961c9613d46811aaf8111"}]},{"sha":"cf3cfc2afeaca4ecc02961c9613d46811aaf8111","node_id":"C_kwDOPTymldoAKGNmM2NmYzJhZmVhY2E0ZWNjMDI5NjFjOTYxM2Q0NjgxMWFhZjgxMTE","commit":{"author":{"name":"Nick Hollon","email":"nick.hollon@langchain.dev","date":"2026-07-20T18:59:29Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-20T18:59:29Z"},"message":"docs(evals): add 2026-07-17 6-model lite scorecard run (#4828)\n\nAdds lite pass@k / avg@k for four models to\n`libs/evals/UNIFIED_SCORECARD.md` (run\n[29593952741](https://github.com/langchain-ai/deepagents/actions/runs/29593952741)):\n`openai:gpt-5.6-sol`, `anthropic:claude-opus-4-8`,\n`anthropic:claude-sonnet-5`, `fireworks:…/glm-5p2`.\n\nContext is graded by exact string match on the answer file, so the\ncontext column is output-format-sensitive.\n\nDocs-only; numbers are the GH aggregate from the run's artifacts.","tree":{"sha":"38eb5fc6d4a3e32ede1723ebd2489b0aa9f77595","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/38eb5fc6d4a3e32ede1723ebd2489b0aa9f77595"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/cf3cfc2afeaca4ecc02961c9613d46811aaf8111","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqXnARCRC1aQ7uu5UhlAAAtNYQALCYRmZoa2U/nADafowlta84\nf56oxcOyh7B2iPWiXqvEn+ZNjRlWvtXhyi6gCNZ3jbH6z9jMd59bzMYH8ZkS8M1v\nVBL/76YoVw0xpTMkdr2vKCsUL+THAeKw2xWT8JcQhBDpkXfrP7d7sbMWG+VrU26x\n21/IJqI5iN7l4xQiCZzkqPnljhzJ1w5QEi1AaaRDAZVKz2kre5TfeUFnbfXgvngY\nas7LCF91boTnNSSM1yEmObvfDyWWNGabtEAwC5un9qMTXj9o6mBfnyXBgz7Mg4Az\nTmbmjR5fkNdZWEiD/YZ1fZmQtf/0/Hmysc7CIyXOJOguSNOaU2jlYdAXlPmMPzqQ\n5ruOr5GHkIvUJ0x4Gt3Rl2UXDgfjY/ZE9JMzVSZJ7pNvlzIXLe2H4lbWSGbg1uPb\nG6xgN7Vd5HaMgOptvw6z2zG24++hGLEtvQ5Djd/1WmQQS6sycyXwhc+nrp3uxxa7\nfgzo5btyU1OVHTG9hKPoybenC/UHS9k4xVcRfAp9DsdmuAV4yJJz++cCRf59iHPG\n+7cwCywFcuRLAazTimNpMbqzFctcwuoMt4su7myXY+oWzpBHsCAVpQbm2R7amCFv\n2kQ3mA/6m+/aRzM5zQVlE9iPJZPIUdVkYvD4f71KLonfJh89HkLiEDK3F2lxFMzD\n8a/434VcmjXEcXOgvus3\n=6F10\n-----END PGP SIGNATURE-----\n","payload":"tree 38eb5fc6d4a3e32ede1723ebd2489b0aa9f77595\nparent 2b9cd08f0492e3e4ad4763f17deea2d80a145f42\nauthor Nick Hollon <nick.hollon@langchain.dev> 1784573969 -0400\ncommitter GitHub <noreply@github.com> 1784573969 -0400\n\ndocs(evals): add 2026-07-17 6-model lite scorecard run (#4828)\n\nAdds lite pass