ot%5D/followers","following_url":"https://api.github.com/users/dependabot%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/dependabot%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/dependabot%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dependabot%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/dependabot%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/dependabot%5Bbot%5D/repos","events_url":"https://api.github.com/users/dependabot%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/dependabot%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b96f6170e7eddd8f9aa31375fd8c54213e478a9a","url":"https://api.github.com/repos/langchain-ai/langgraph/commits/b96f6170e7eddd8f9aa31375fd8c54213e478a9a","html_url":"https://github.com/langchain-ai/langgraph/commit/b96f6170e7eddd8f9aa31375fd8c54213e478a9a"}]},{"sha":"b96f6170e7eddd8f9aa31375fd8c54213e478a9a","node_id":"C_kwDOKFU0ldoAKGI5NmY2MTcwZTdlZGRkOGY5YWEzMTM3NWZkOGM1NDIxM2U0NzhhOWE","commit":{"author":{"name":"Hugo DURAND","email":"durandhugo94@gmail.com","date":"2026-07-14T15:09:58Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-14T15:09:58Z"},"message":"fix(sdk-py): support clearing cron end_time via update(end_time=None) (#8334)\n\n`CronClient.update` / `SyncCronClient.update` stripped all `None`-valued\nfields from the PATCH body, so `update(end_time=None)` could never clear\na previously set cron end time. This routes an explicit `None` through\nas `end_time: null` (via the existing `NOT_PROVIDED` sentinel), while an\nomitted argument still leaves the value unchanged.\n\nVerified with `make format`, `make lint`, and `make test` in\n`libs/sdk-py` (493 passed), including two new tests asserting the PATCH\nbody carries an explicit null `end_time`.","tree":{"sha":"26e1daee3a8c31153ff9212a50019897db8c6917","url":"https://api.github.com/repos/langchain-ai/langgraph/git/trees/26e1daee3a8c31153ff9212a50019897db8c6917"},"url":"https://api.github.com/repos/langchain-ai/langgraph/git/commits/b96f6170e7eddd8f9aa31375fd8c54213e478a9a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqVlFGCRC1aQ7uu5UhlAAAMpUQAJV0g+eGmWj/5aP3PQr53iaD\n+5kucW82FX8hu+6OEj/k4nBUypan/n2LEFxSIPWo2hoT9NuHGFaoW7CwqeD/vBOl\nimDpvK7S9uRQkxvghD0WU4lHQG8wRGp2pRAyXMFecfyfmoYOSQXPivIKiLZ6ft7d\nsgOD4X4FtglIWdx+q77MUHtMKcsUjfIBw+Z+kHjjkuGeIaQfNbl4pvBQ8sfMuB0D\nrk8oOSB+7sJ/gzaYZ8uJZi7ace8C86cR8NB68NJyQSMkoXUSafIlEhSj3p983MnV\npnBqaTcaVzIw6YSaLKPGwEgy1ykOzNFG/VPba0kibUYgm4BgAYhDoAZm18W1V2HZ\nHYiByL8iAv1NhHWDbWB+BGQb8XeoTzJtx3CltdoCM2LQjy2pE2QjTBL9bXU3bFEN\nzXnFBHSqGCTfdHKc13qJLjgqIW6qtF6TE6AtJ5ZWV3Z+J3C4LX9sA8UfIOfEwa9R\nylw8YNPxMg3FlgBuJkG4FfDY3M3dPvdtYntDm4/8r3Y8GTgYL2KV/Ks4iLeUuZ3C\nf/v5mq+yoFI/r9phl84U8kPj2jh/c2A9tQ8BYpQr+f/gs/Fnp+hHJ6MDaPMOudh5\niKtNSZ1hzcfLIITXK0TlT9AoYznw3aHAmAQJVOYKFVZhyl/yCBCTiUT8fF0IujG+\nkEe04vk1IhiGJdAm7BLc\n=lTKy\n-----END PGP SIGNATURE-----\n","payload":"tree 26e1daee3a8c31153ff9212a50019897db8c6917\nparent 55ec2f21939ce7755e6398c11b541de8926245ee\nauthor Hugo DURAND <durandhugo94@gmail.com> 1784041798 -0400\ncommitter GitHub <noreply@github.com> 1784041798 -0400\n\nfix(sdk-py): support clearing cron end_time via update(end_time=None) (#8334)\n\n`CronClient.update` / `SyncCronClient.update` stripped all `None`-valued\nfields from the PATCH body, so `update(end_time=None)` could never clear\na previously set cron end time. This routes an explicit `None` through\nas `end_time: null` (via the existing `NOT_PROVIDED` sentinel), while an\nomitted argument still leaves the value unchanged.\n\nVerified with `make format`, `make lint`, and `make test` in\n`libs/sdk-py` (493 passed), including two new tests asserting the PATCH\nbody carries an explicit null `end_time`.","verified_at":"2026-07-14T15:09:59Z"}},"url":"https://api.github.com/repos/langchain-ai/langgraph/commits/b96f6170e7eddd8f9aa31375fd8c54213e478a9a","html_url":"https://github.com/langchain-ai/langgraph/commit/b96f6170e7eddd8f9aa31375fd8c54213e478a9a","comments_url":"https://api.github.com/repos/langchain-ai/langgraph/commits/b96f6170e7eddd8f9aa31375fd8c54213e478a9a/comments","author":{"login":"HugoDurand","id":5811879,"node_id":"MDQ6VXNlcjU4MTE4Nzk=","avatar_url":"https://avatars.githubusercontent.com/u/5811879?v=4","gravatar_id":"","url":"https://api.github.com/users/HugoDurand","html_url":"https://github.com/HugoDurand","followers_url":"https://api.github.com/users/HugoDurand/followers","following_url":"https://api.github.com/users/HugoDurand/following{/other_user}","gists_url":"https://api.github.com/users/HugoDurand/gists{/gist_id}","starred_url":"https://api.github.com/users/HugoDurand/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HugoDurand/subscriptions","organizations_url":"https://api.github.com/users/HugoDurand/orgs","repos_url":"ht