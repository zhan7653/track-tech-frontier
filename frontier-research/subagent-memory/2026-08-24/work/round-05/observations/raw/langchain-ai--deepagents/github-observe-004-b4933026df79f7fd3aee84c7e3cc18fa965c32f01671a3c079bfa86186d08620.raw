b-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"20a5b5c1be89d86155ef4374a1f686aff6c92495","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/20a5b5c1be89d86155ef4374a1f686aff6c92495","html_url":"https://github.com/langchain-ai/deepagents/commit/20a5b5c1be89d86155ef4374a1f686aff6c92495"}]},{"sha":"20a5b5c1be89d86155ef4374a1f686aff6c92495","node_id":"C_kwDOPTymldoAKDIwYTViNWMxYmU4OWQ4NjE1NWVmNDM3NGExZjY4NmFmZjZjOTI0OTU","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-08-19T15:13:15Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-19T15:13:15Z"},"message":"ci(infra): validate release dependencies against PyPI (#5612)\n\nRelease PRs now fail before merge when their built wheel needs\ndependency metadata that has not reached PyPI, or when the wheel cannot\nbe installed from the public index the way `release.yml` installs it.\n\n---\n\nSource CI installs sibling packages from local editable paths, which can\nhide a required release order: a sibling package's source may declare a\nnew Python floor or dependency floor that PyPI's latest published wheel\ndoes not yet have. Merging in that state would break the post-merge\nrelease install.\n\nThe `📦 Check Dependency Freshness` workflow now, for release PRs only:\n\n1. Builds the release wheel and checks every `Requires-Dist` constraint\nagainst PyPI. For repo-managed dependencies it also verifies the newest\neligible PyPI files satisfy the sibling's current Python metadata.\nDirect URL dependencies fail, since this path verifies PyPI.\n2. Installs the wheel into a clean environment on the package's release\nPython with `--index-url https://pypi.org/simple`, with Talon getting\nthe same `--prerelease allow` exception as the release workflow.\n\nNon-release PRs get a passing no-op, so the job is safe to require\nglobally.\n\n## Demonstration\n\nThe check passes on this normal (non-release) PR: [workflow run\n32184070069](https://github.com/langchain-ai/deepagents/actions/runs/32184070069).\n\nA live GitHub-hosted failure run is not feasible before merge:\npull-request workflows execute from the head branch, so the failing\nTalon 0.0.4 release PR (#5605) does not contain this code, and a new\n`workflow_dispatch` trigger is not recognized until it exists on the\ndefault branch. Locally, the same check against the built Talon wheel\nand live PyPI JSON fails with:\n\n> `deepagents-code 0.1.57 (latest on PyPI) declares\nrequires-python<4.0,>=3.11, but the current deepagents-code metadata\nrequires >=3.12,<4.0. Constraint: <1.0.0,>=0.1.30. Release\ndeepagents-code first, then re-run this check.`\n\nThe clean Python 3.12 install step was exercised separately and resolved\n138 packages from PyPI, including `deepagents-code==0.1.57` — expected,\nsince the install step proves the public graph resolves while the\nmetadata check catches the unpublished sibling change.\n\n## Required status\n\nAfter this lands, a maintainer must add the literal `validate release\ndependencies against PyPI` job name to the `main` ruleset's required\nstatus checks (currently only `✅ CI Success` is required). The job\npasses on non-release PRs, so requiring it will not block unrelated PRs.","tree":{"sha":"4423e2658d661b79aec6873d89a21f54777e6530","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/4423e2658d661b79aec6873d89a21f54777e6530"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/20a5b5c1be89d86155ef4374a1f686aff6c92495","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqhcgLCRC1aQ7uu5UhlAAAKZMQAD2HLptqYp9tYP93b+LcBxG8\n57DzPJNGeQ4B164gPmGbdqPu/t7lgp7zquSK4nRVWe1POa3CrsZKOa4UL6CSnAH6\nyK4WkxQ3Y/VaneiYKK2qH+7jCfJ8x+eWYlv48bqhl9ymGU7BFX9Y0PziHzhBbkDg\nyyJyZTxAR76RcPkIZmEp520ianihlfVRPrzjR8pJEz5NvXeJl0cWKjcHmqLONqLB\nTjub2tjdPtsrza2thDv374SnM2w7u4CBpiiSDtgVTB2EX/XtL4rNzVr0+WoVad20\nnRcr/KdDdprAJAD1EDRpHeEC1LnUUr5zctXwtKrU0zMsOyerONjOEYrFSATXjx6d\nnfITv1uAM+v07p8TJikHvJY1Bx9a3AZJT6flNwqiIx2LcaJz5/NDkDzQ2p5R0OAw\nfVD3d+B8dRVjo6mJnQkya7V85hyqh3dhlSTcUQuP+vP7cpHT+klvGcqZl3hfeV9j\nYBYdDlCu2MbOAVwE+6yPAMgrKHcdeupcAyGpLNxgTGd6HoF/SzFUC8h2cqxioFl6\nuCznST1INHhIPiIyZnqR9PqaRrgwJdnC4mWQqaPwD2lYZ8fGFYHG7ZsFy+2wbiYe\nN7TgWn0HsOB1gJ1wUcmLoAn9pMLZFDbKnqcr4JfwzeZ5V4c4HxfymVW9vFa5GbQn\n/LyjmsNwwunyHgQAfDk3\n=ichg\n-----END PGP SIGNATURE-----\n","payload":"tree 4423e2658d661b79aec6873d89a21f54777e6530\nparent 75c5ce47bf5fb146c6a8436c00c60134dceee8a5\nauthor Mason Daugherty <mason@langchain.dev> 1787152395 -0400\ncommitter GitHub <noreply@github.com> 1787152395 -0400\n\nci(infra): validate release dependencies against PyPI (#5612)\n\nRelease PRs now fail before merge when their built wheel needs\ndependency metadata that has not reached PyPI, or when the wheel cannot\nbe installed from the public index the way `release.yml` installs it.\n\n---\n\nSource CI installs sibling packages from local editable paths, which can\nhide a required release order: a sibling package's source may declare a\nnew Python floor or dependency floor that PyPI's latest published wheel\ndoes not yet have. Merging in that state would break the post-merge\nrelease install.\n\nThe `📦 Check Dependency Freshness` workflow now, for release PRs only:\n\n1. Builds the release wheel and checks every `Requires-Dist` constraint\nagainst PyPI. For repo-managed dependencies it also verifies the newest\neligible PyPI files satisfy the sibling's current Python metadata.\nDirect URL dependencies fail, since this path verifies PyPI.\n2. Installs the wheel into a clean environment on the package's release\nPython with `--index-url https://pypi.org/simple`, with Talon getting\nthe same `--prerelease allow` exception as the release workflow.\n\nNon-release PRs get a passing no-op, so the job is safe to require\nglobally.\n\n## Demonstration\n\nThe check passes on this normal (non-release) PR: [workflow run\n32184070069](https://github.com/langchain-ai/deepagents/actions/runs/32184070069).\n\nA live GitHub-hosted failure run is not feasible before merge:\npull-request workflows execute from the head branch, so the failing\nTalon 0.0.4 release PR (#5605) does not contain this code, and a new\n`workflow_dispatch` trigger is not recognized until it exists on the\ndefault branch. Locally, the same check against the built Talon wheel\nand live PyPI JSON fails with:\n\n> `deepagents-code 0.1.57 (latest on PyPI) declares\nrequires-python<4.0,>=3.11, but the current deepagents-code metadata\nrequires >=3.12,<4.0. Constraint: <1.0.0,>=0.1.30. Release\ndeepagents-code first, then re-run this check.`\n\nThe clean Python 3.12 install step was exercised separately and resolved\n138 packages from PyPI, including `deepagents-code==0.1.57` — expected,\nsince the install step proves the public graph resolves while the\nmetadata check catches the unpublished sibling change.\n\n## Required status\n\nAfter this lands, a maintainer must add the literal `validate release\ndependencies against PyPI` job name to the `main` ruleset's required\nstatus checks (currently only `✅ CI Success` is required). The job\npasses on non-release PRs, so requiring it will not block unrelated PRs.","verified_at":"2026-08-19T15:13:16Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/20a5b5c1be89d86155ef4374a1f686aff6c92495","html_url":"https://github.com/langchain-ai/deepagents/commit/20a5b5c1be89d86155ef4374a1f686aff6c92495","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/20a5b5c1be89d86155ef4374a1f686aff6c92495/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"75c5ce47bf5fb146c6a8436c00c60134dceee8a5","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/75c5ce47bf5fb146c6a8436c00c60134dceee8a5","html_url":"https://github.com/langchain-ai/deepagents/commit/75c5ce47bf5fb146c6a8436c00c60134dceee8a5"}]},{"sha":"75c5ce47bf5fb146c6a8436c00c60134dceee8a5","node_id":"C_kwDOPTymldoAKDc1YzVjZTQ3YmY1ZmIxNDZjNmE4NDM2YzAwYzYwMTM0ZGNlZWU4YTU","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-08-19T03:22:18Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-19T03:22:18Z"},"message":"test(code): pin single-warning logging for failed MCP tool calls (#5609)\n\nA failed MCP tool call must produce exactly one `WARNING` on\n`deepagents_code.mcp_tools`, with a traceback.\n`_handle_cached_mcp_tool_error` owns that log, so the tool coroutine\nmust not log before it raises — logging at both boundaries reports every\nfailure twice.\n\n`test_generic_oserror_is_not_retried` and\n`test_repeated_transient_error_surfaces_tool_message` already covered\nthe non-transient and post-retry failure paths, so the assertions land\nthere rather than in new tests. The warning filter is scoped to the\nfailure detail, not to logger and level alone: the wrapper also warns\nwhen retry-session cleanup fails, and that warning must not read as a\nduplicate.\n\nAlso names the sole logging site in a comment at the wrapper's raise\nsites, where an editor tempted to add a second `logger.warning` will\nactually be looking.\n\nNo behavior change.\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"58523e53f3edef98ba9841212ba685d26c03bf61","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/58523e53f3edef98ba9841212ba685d26c03bf61"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/75c5ce47bf5fb146c6a8436c00c60134dceee8a5","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqhSFqCRC1aQ7uu5UhlAAAPVEQAIAiNHWznU0hE8W7lvOTZLlr\nMNe+GbiGpzjMkRJg01ET0AytdLDk4dX9KDKNWoB7+BsAwlnpUYw3TuI/0ZZ3jPlW\nBzEnMj8Fm3ppepAfF8u96KiEEkEtoGOtJqOjPXUxfenXrQB7Pvg05oSi2IEwESuF\nIOJzjTGwljnsRTGuomnzZY5IB8W0ycWKMn9AGdgSKqNK+SXx1U7BMIcZ1JL+pFpY\nwlWYiajVIsoMpc4PFn3Cva35x6LiMcE5xkPvV2kcVFBwCXFtRSeosMhYda8HV+rx\nkrvrTnHmNwEfBjJmVamoB38eAVSYIM37MSQD3zFyjfzcVeqxNUFthAabRCLKNwIb\nZIKWfO2vvQK82y55EctP1qJZekqK9dhYdLJQtyfY8u+n4ek67WofcQwFrlpzdzYo\n3+jCvzjdaOr8zFcRWYsvu2RaapC9QE1Yujh4zwlS/4HA5riPdt2U24+MuNe6U/XN\nlZfUoH4JOdIrsitWi4E2WEa/nayUiH8RjgkIk2klpmGhLCyxLPlW9G5xC4xowm/9\nZrGoO51tpl1qg4TbjkpYadE6VZklFpTcRIKV5FNmtGFG16e50VzajFjHRAeAgh9l\nBM7BI1ki0WblBNcVDpxgPXn58jGrrHHT+vUUX2pe8REGVIohfTkwRH43qmixg8C+\nx5hbeM+UIszkknifwa9J\n=Z2yJ\n-----END PGP SIGNATURE-----\n","payload":"tree 58523e53f3edef98ba9841212ba685d26c03bf61\nparent 25aa2735dabbca6a8c82afae2c7c9f35830d151c\nauthor Mason Daugherty <mason@langchain.dev> 1787109738 -0400\ncommitter GitHub <noreply@github.com> 1787109738 -0400\n\ntest(code): pin single-warning logging for failed MCP tool calls (#5609)\n\nA failed MCP tool call must produce exactly one `WARNING` on\n`deepagents_code.mcp_tools`, with a traceback.\n`_handle_cached_mcp_tool_error` owns that log, so the tool coroutine\nmust not log before it raises — logging at both boundaries reports every\nfailure twice.\n\n`test_generic_oserror_is_not_retried` and\n`test_repeated_transient_error_surfaces_tool_message` already covered\nthe non-transient and post-retry failure paths, so the assertions land\nthere rather than in new tests. The warning filter is scoped to the\nfailure detail, not to logger and level alone: the wrapper also warns\nwhen retry-session cleanup fails, and that warning must not read as a\nduplicate.\n\nAlso names the sole logging site in a comment at the wrapper's raise\nsites, where an editor tempted to add a second `logger.warning` will\nactually be looking.\n\nNo behavior change.\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-08-19T03:22:18Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/75c5ce47bf5fb146c6a8436c00c60134dceee8a5","html_url":"https://github.com/langchain-ai/deepagents/commit/75c5ce47bf5fb146c6a8436c00c60134dceee8a5","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/75c5ce47bf5fb146c6a8436c00c60134dceee8a5/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"25aa2735dabbca6a8c82afae2c7c9f35830d151c","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/25aa2735dabbca6a8c82afae2c7c9f35830d151c","html_url":"https://github.com/langchain-ai/deepagents/commit/25aa2735dabbca6a8c82afae2c7c9f35830d151c"}]},{"sha":"25aa2735dabbca6a8c82afae2c7c9f35830d151c","node_id":"C_kwDOPTymldoAKDI1YWEyNzM1ZGFiYmNhNmE4YzgyYWZhZTJjN2M5ZjM1ODMwZDE1MWM","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-08-18T22:26:53Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-18T22:26:53Z"},"message":"chore(code): render stale-PATH hint as next step, not warning (#5618)\n\nWhen the installer successfully updates the shell profile, the running\nshell still lacks `~/.local/bin` on PATH until it's reloaded. That case\nwas rendered with the same yellow warning styling as a genuine profile\nsetup failure, even though the install succeeded and new terminals work\nimmediately. Now it prints a cyan info line with a paste-ready command\ninstead:\n\n    ▸ To use dcode in this shell, run:\n      > source ~/.local/bin/env\n\n---\n\n`ensure_path_setup` returns distinct codes for \"profile setup failed\"\n(rc=1, already accompanied by a specific warning) and \"profile written,\nrunning shell just stale\" (rc=2). The footer previously lumped both\nunder one `log_warn \"Restart your shell, or run:\"` block, so a fully\nsuccessful install could end on a warning. The rc=2 path now renders as\na `log_info` next-step hint styled like a prompt (`> command`), matching\nhow other installers (e.g. fx) present the same affordance. The rc=1\npath keeps the warning styling since something genuinely went wrong.\n\nAdapted from the fx install script (https://releases.fx.sh).","tree":{"sha":"e03d5a0453dd48b0a4e27d2be8fcdda712de0722","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/e03d5a0453dd48b0a4e27d2be8fcdda712de0722"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/25aa2735dabbca6a8c82afae2c7c9f35830d151c","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqhNwtCRC1aQ7uu5UhlAAA63gQAJ4n7kk9vussf9lDdIiQMepd\n9TYin+dFBcqK2K3WqAbyX1EYaBXAic/mBTGUyfq3pNCZqYXxlwXySbi2co+2+Lg1\nb8QXS5Les4lgZv/iUaIf34AotknoSF52DVoeBSi1riGFSkZVGD1PswrLL5CLt5FN\n4dyx/N6z19yHRB+FGFoUCD2U3Zsafl161oDy90m1asG47CkCNrf+Q1mNQLYiRABx\nPS9v1OjVUeE7iQ2lpxGDz+q29V7PYxykvXmgF27DjEinQhkxPuJ9NqOdwAqqmiiJ\nA8Cjvrt1Mjycb4zCoSdXeB9Qv8ZHa/u3I8EejMSgOzcG4OheAo/UoRJswh/8gh4i\nwqlFXv1WWiIdNZU4DqxyUZhanTFxTVyZGqCuZ5RUn0mOuSuE3JaqOWn4SxVJaz+i\nH5/+LBYCBzLWK4PMfI4Nd8sCyaPaZnI0GOJzdjRGTmVTOnUocMDqtjhsVQELqYHV\nbEymNcNyzeWL0C9LJ3S+Yv72nq8wPFy898cb0ri5o05moRJtZ37llsmKuXytCf6c\n92mODQ0vxpYvO1J6BakToPvW4Y5vgTadWFJs1h9iBlrDNPY4nFwIkHAeFK1pg94u\n3yG9nPNeIX4iPe3hAmMFQ7/I1j6hnoTAXPGYHQJWg4vXe6byjnFiAAcg7dKJf/t4\n5Xoap8iNd3bh7mKUVNmO\n=gjHv\n-----END PGP SIGNATURE-----\n","payload":"tree e03d5a0453dd48b0a4e27d2be8fcdda712de0722\nparent 03b656e5e6c9b548a45cb2c30c4eb5a05772d288\nauthor Mason Daugherty <mason@langchain.dev> 1787092013 -0400\ncommitter GitHub <noreply@github.com> 1787092013 -0400\n\nchore(code): render stale-PATH hint as next step, not warning (#5618)\n\nWhen the installer successfully updates the shell profile, the running\nshell still lacks `~/.local/bin` on PATH until it's reloaded. That case\nwas rendered with the same yellow warning styling as a genuine profile\nsetup failure, even though the install succeeded and new terminals work\nimmediately. Now it prints a cyan info line with a paste-ready command\ninstead:\n\n    ▸ To use dcode in this shell, run:\n      > source ~/.local/bin/env\n\n---\n\n`ensure_path_setup` returns distinct codes for \"profile setup failed\"\n(rc=1, already accompanied by a specific warning) and \"profile written,\nrunning shell just stale\" (rc=2). The footer previously lumped both\nunder one `log_warn \"Restart your shell, or run:\"` block, so a fully\nsuccessful install could end on a warning. The rc=2 path now renders as\na `log_info` next-step hint styled like a prompt (`> command`), matching\nhow other installers (e.g. fx) present the same affordance. The rc=1\npath keeps the warning styling since something genuinely went wrong.\n\nAdapted from the fx install script (https://releases.fx.sh).","verified_at":"2026-08-18T22:26:54Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/25aa2735dabbca6a8c82afae2c7c9f35830d151c","html_url":"https://github.com/langchain-ai/deepagents/commit/25aa2735dabbca6a8c82afae2c7c9f35830d151c","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/25aa2735dabbca6a8c82afae2c7c9f35830d151c/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"03b656e5e6c9b548a45cb2c30c4eb5a05772d288","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/03b656e5e6c9b548a45cb2c30c4eb5a05772d288","html_url":"https://github.com/langchain-ai/deepagents/commit/03b656e5e6c9b548a45cb2c30c4eb5a05772d288"}]},{"sha":"03b656e5e6c9b548a45cb2c30c4eb5a05772d288","node_id":"C_kwDOPTymldoAKDAzYjY1NmU1ZTZjOWI1NDhhNDVjYjJjMzBjNGViNWEwNTc3MmQyODg","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-08-18T22:09:41Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-18T22:09:41Z"},"message":"chore(repo): use canonical LangSmith environment variables (#5615)\n\n---\nUpdate user-facing setup guidance to canonical `LANGSMITH_*` names while\nretaining older aliases in runtime fallback, credential isolation, and\ncompatibility tests.\n\n<details>\n<summary>Test plan</summary>\n\n- [x] Focused compatibility tests for code, CLI, evals, Talon, and\nbetter-harness\n- [x] Final branch diff against `main` contains documentation-only\ncanonical-name updates\n\n</details>\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/50901a97-3e2c-5351-ab10-5a77edf33b63)\n\n---------\n\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"8c42bf9d83ce1478956e1557c163f51afc210924","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/8c42bf9d83ce1478956e1557c163f51afc210924"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/03b656e5e6c9b548a45cb2c30c4eb5a05772d288","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqhNglCRC1aQ7uu5UhlAAA2bYQALFXAKsvSjB34PgWx4tSBClN\no0XFt8lXZKeKBL2Bn38vYQ8M5S1f5bne6FcG47ECvBtBjqoeJE2c/7u/i7xzT0UK\n/yIWa2YYCy3/HjXaNK3QKkwImXKLl1GXtN21jYSRTGZ739fbG2okI+YC5tGL2kgu\n7H6qu8xPv6Nv0jCwD7bK3OFGd28iUiOZ/0RrV7GS6sIQ2LyWeoUEsY9tmQpdHQ+o\n6CBhuFItRpKmiWhHGjvc6HGLieFfbcAZZ2/IfJiHCvqugOLyIZ+N2mfCLe4w6BUt