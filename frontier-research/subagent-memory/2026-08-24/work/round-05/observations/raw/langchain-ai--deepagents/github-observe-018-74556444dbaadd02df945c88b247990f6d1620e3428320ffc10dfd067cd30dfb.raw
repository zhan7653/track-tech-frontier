d":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7e7a567556110ad927a78b45c3a3d4ac37b65e86","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7e7a567556110ad927a78b45c3a3d4ac37b65e86","html_url":"https://github.com/langchain-ai/deepagents/commit/7e7a567556110ad927a78b45c3a3d4ac37b65e86"}]},{"sha":"7e7a567556110ad927a78b45c3a3d4ac37b65e86","node_id":"C_kwDOPTymldoAKDdlN2E1Njc1NTYxMTBhZDkyN2E3OGI0NWMzYTNkNGFjMzdiNjVlODY","commit":{"author":{"name":"langsmith-engine[bot]","email":"270983758+langsmith-engine[bot]@users.noreply.github.com","date":"2026-05-28T22:15:57Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-28T22:15:57Z"},"message":"fix(code): fix zero tool MCP server rendering (#3649)\n\nWhen an MCP server connects but fails to register any tools (e.g. tool\ndiscovery failure, partial OAuth state, downstream API returning an\nempty tool list), `_build_mcp_context` in `local_context.py` renders the\nserver identically to a server that legitimately advertises zero tools —\n`- **slack** (http): (no tools)` — losing the `status`/`error` fields\nthe loader already collected on `MCPServerInfo`. The agent reads this\nfrom the system prompt and reasonably concludes the integration is\nunavailable, declining requests like [trace\n1](trace://019e6a6a-9c4d-71c3-a681-d6db94fa4d1d) and [trace\n2](trace://019e6a78-951f-7de2-8e63-7928c0ca86cc) with \"no Slack tools\nare available in this session\" instead of surfacing the load failure so\nthe user can re-auth or restart the server.\n\n---------\n\nCo-authored-by: Issues Agent <issues-agent@langchain.dev>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","tree":{"sha":"af7ea9ede248b9765d5d85e52bbf410b60f68f42","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/af7ea9ede248b9765d5d85e52bbf410b60f68f42"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/7e7a567556110ad927a78b45c3a3d4ac37b65e86","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqGL6dCRC1aQ7uu5UhlAAA5ykQALAPMFfAVaTeoj72ep8vICfN\nOZ/IDZ1Wi/3JWG4/fmMeSc3RwRKCobtpsw4nGIiZnRVZ0hqD6NG6NdG9EO5l8Flu\nyuA8KmhZklUdeJy31I9l4HUKhwpCf8gH5zELikYdDE2UuGWlLKVu1g8MAXVC93Uj\nP6w/s8Jh5UDPmJG1JBlx3vYa6IhcCggBccPfBSQ8+850tGWEnI3HAAT7Q5Ds1rU8\nmm29j4hV7vAEJzWrlYbPcEhCUo3haoAbn6nyBvAD+9e41EMKZXgXOfBBDA9coC32\naDWByhNYDF+Lixrc5NfTwjoPqWY5GnSjvt2lXgRyO/xXv3e1iXFIBX4D67CS0GSk\nTjOIsFxkkEiEepMz20faFTCQYyIAxw5JhoRIjq/vknaUrzeQh5S6D4+8+OlMxwBN\nE/vq1xnD3wSG08FaOCaQv1DRj7H7oqpGNme6ZQJqbB7E3iAIAAUci4mmgrxQEWyf\nWbjUXUwGEUnfxTrhLc9LFHkawOYJHl0105abtrjZnC30X8QgQSHFkfh5Nd3P3nyb\nwRW4dFfZfFuc/Wf0J9gpsN3eafdBj3ioxWGjLMBn1+7oSW8R6Q7H4VYygFNHzL9o\nOOO/0Oo6YohAZ1STdAD0wlLsCucMuV8Sq4dKxZhwZKi/CQBFZOX+rxJwowYRBY9V\nimW/3kP2NXO1jErQclrB\n=Pc6V\n-----END PGP SIGNATURE-----\n","payload":"tree af7ea9ede248b9765d5d85e52bbf410b60f68f42\nparent daf65716d7c999eadb2b7c37e412ec07b2c7aed3\nauthor langsmith-engine[bot] <270983758+langsmith-engine[bot]@users.noreply.github.com> 1780006557 +0000\ncommitter GitHub <noreply@github.com> 1780006557 +0000\n\nfix(code): fix zero tool MCP server rendering (#3649)\n\nWhen an MCP server connects but fails to register any tools (e.g. tool\ndiscovery failure, partial OAuth state, downstream API returning an\nempty tool list), `_build_mcp_context` in `local_context.py` renders the\nserver identically to a server that legitimately advertises zero tools —\n`- **slack** (http): (no tools)` — losing the `status`/`error` fields\nthe loader already collected on `MCPServerInfo`. The agent reads this\nfrom the system prompt and reasonably concludes the integration is\nunavailable, declining requests like [trace\n1](trace://019e6a6a-9c4d-71c3-a681-d6db94fa4d1d) and [trace\n2](trace://019e6a78-951f-7de2-8e63-7928c0ca86cc) with \"no Slack tools\nare available in this session\" instead of surfacing the load failure so\nthe user can re-auth or restart the server.\n\n---------\n\nCo-authored-by: Issues Agent <issues-agent@langchain.dev>\nCo-authored-by: Mason Daugherty <mason@langchain.dev>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","verified_at":"2026-05-28T22:15:57Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7e7a567556110ad927a78b45c3a3d4ac37b65e86","html_url":"https://github.com/langchain-ai/deepagents/commit/7e7a567556110ad927a78b45c3a3d4ac37b65e86","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/7e7a567556110ad927a78b45c3a3d4ac37b65e86/comments","author":{"login":"langsmith-engine[bot]","id":270983758,"node_id":"BOT_kgDOECbiTg","avatar_url":"https://avatars.githubusercontent.com/in/3183926?v=4","gravatar_id":"","url":"https://api.github.com/users/langsmith-engine%5Bbot%5D","html_url":"https://github.com/apps/langsmith-engine","followers_url":"https://api.github.com/users/langsmith-engine%5Bbot%5D/followers","following_url":"https://api.github.com/users/langsmith-engine%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/langsmith-engine%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/langsmith-engine%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/langsmith-engine%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/langsmith-engine%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/langsmith-engine%5Bbot%5D/repos","events_url":"https://api.github.com/users/langsmith-engine%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/langsmith-engine%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"daf65716d7c999eadb2b7c37e412ec07b2c7aed3","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/daf65716d7c999eadb2b7c37e412ec07b2c7aed3","html_url":"https://github.com/langchain-ai/deepagents/commit/daf65716d7c999eadb2b7c37e412ec07b2c7aed3"}]},{"sha":"daf65716d7c999eadb2b7c37e412ec07b2c7aed3","node_id":"C_kwDOPTymldoAKGRhZjY1NzE2ZDdjOTk5ZWFkYjJiN2MzN2U0MTJlYzA3YjJjN2FlZDM","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-05-28T21:52:49Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-28T21:52:49Z"},"message":"fix(code): keep chat input focused when clicking a message (#3655)\n\nClicking a chat message to expand it de-focused the text input prompt.\nThe `#chat` `VerticalScroll` is focusable by default, so on `MouseDown`\nTextual's `Screen._forward_event` walked up from the clicked\n(non-focusable) message widget to the scroll container and called\n`set_focus` on it, stealing focus from the chat input's `TextArea`.","tree":{"sha":"233427bce349a2a5630e35170c16d396e105a57a","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/233427bce349a2a5630e35170c16d396e105a57a"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/daf65716d7c999eadb2b7c37e412ec07b2c7aed3","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqGLkxCRC1aQ7uu5UhlAAAZJMQAEYwz8CHp6Hz3wR1O9JCBVt0\niSM+kIo/4uBn3SJiOm2zD+TgxeImsRCIKlj/SpB8vLgKcoaZFAlnR7EdPpzcmqYg\nk1bnY74dMfy6JFXDGxDiVD3P3C8vlIHKyixZKXMUR2XDOiFNSzmPGH2VrhaRccr3\ncD+ppTyzBIL/Anty4dTbm/tc+UqjpRS0NOEV+R19jHrr0C3VC+G6SWELTIjnaYZh\n3V3xiYO+sIUFvkOwbYFsVwNKl+39R85ZG7vozUT+Lh1YzAfZ40AQc1dXRXKonM3P\nTRfoiMPJ35a5/ChGjeRDIOjmbogruH3Te9sLEqrawbku0+TrNZ6rbUJS5SVwDbFn\nTUtRmyNf+Bf15hgh1PIIrZvvh9rctUzah0miYWdGGCIAeLEmULi9rdlIT1ZbBW2g\nI4Ts5+3NHeZRJl377DBtCrpxPSTLFfhCl7r/R7vGu3DfPL8soObbt6P18Sju2rIQ\nbM3Gdret+Q2elMJfmoBTl01Y3iQE3JJd5esEG8TP3hsBOKIo5HdrPYqZ4jFPx3wO\nDEK7vPLu9ar+MXjMATOnrCygjmhcPj39fvBf6s09ILde3wed+JMY47nzjIXAzowR\nXe2+wME1PwoNvidlf2E5lbKSozOq0t24EzdNkYpBWVxRgIn0Nf/oeQg0AQD2fQ9/\n6kkYGAA3tfltWXNZKkDe\n=Lgr7\n-----END PGP SIGNATURE-----\n","payload":"tree 233427bce349a2a5630e35170c16d396e105a57a\nparent 14a904757c2d9d797945b6ea1bc9529f1f8cf369\nauthor Mason Daugherty <mason@langchain.dev> 1780005169 -0400\ncommitter GitHub <noreply@github.com> 1780005169 -0400\n\nfix(code): keep chat input focused when clicking a message (#3655)\n\nClicking a chat message to expand it de-focused the text input prompt.\nThe `#chat` `VerticalScroll` is focusable by default, so on `MouseDown`\nTextual's `Screen._forward_event` walked up from the clicked\n(non-focusable) message widget to the scroll container and called\n`set_focus` on it, stealing focus from the chat input's `TextArea`.","verified_at":"2026-05-28T21:52:49Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/daf65716d7c999eadb2b7c37e412ec07b2c7aed3","html_url":"https://github.com/langchain-ai/deepagents/commit/daf65716d7c999eadb2b7c37e412ec07b2c7aed3","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/daf65716d7c999eadb2b7c37e412ec07b2c7aed3/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"14a904757c2d9d797945b6ea1bc9529f1f8cf369","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/14a904757c2d9d797945b6ea1bc9529f1f8cf369","html_url":"https://github.com/langchain-ai/deepagents/commit/14a904757c2d9d797945b6ea1bc9529f1f8cf369"}]},{"sha":"14a904757c2d9d797945b6ea1bc9529f1f8cf369","node_id":"C_kwDOPTymldoAKDE0YTkwNDc1N2MyZDlkNzk3OTQ1YjZlYTFiYzk1MjlmMWY4Y2YzNjk","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-05-28T21:44:45Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-28T21:44:45Z"},"message":"fix(sdk): export `DeepAgentState` (#3653)\n\nFollow-up to the `state_schema` parameter added in `create_deep_agent`.\nExposes `DeepAgentState` as a public import so callers can subclass it\nfor custom schemas, and adds missing test coverage to verify that a\ncustom schema is actually threaded through declarative subagent\ncompilation and that the `SubAgentMiddleware` constructor annotations\nare runtime-resolvable.","tree":{"sha":"a7aec6700bef8fca9a757bae49e92eb14967fc31","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/a7aec6700bef8fca9a757bae49e92eb14967fc31"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/14a904757c2d9d797945b6ea1bc9529f1f8cf369","comment_count":0,"verification":{"verif