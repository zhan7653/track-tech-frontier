:22Z"},"message":"fix(code): point MCP re-enable guidance at `Ctrl+R` (#3688)\n\nRe-enabling a disabled MCP server now points users to the in-modal\nreconnect shortcut instead of the slash command. That keeps the recovery\nguidance aligned with the UI flow users are already in.","tree":{"sha":"cf4be57cb3d191b0e171f7ec0ffd8c704f4f662e","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/cf4be57cb3d191b0e171f7ec0ffd8c704f4f662e"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/15ca3029f18fa38c1592859febc2a6d0469bff2d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqHcCDCRC1aQ7uu5UhlAAANncQAIpHR/Ro3VyGmrQrPKfaD9eR\nIXIjfyiHK1ytOEHTuq57nw5nx2hliZ9DdZMiEyiluz+e415l6Nf5gbc8EMXimQfE\nr6uSSh4E+Td7MCzRQsfW8cXonwT7ZiWR1vDVjFMd8G39UcwCwreDXJ3K1R3aofTE\n1JEPC8tvqBMg7IOzZnhNfscSwTwaq5+9jeZwxB5zDUYLJUMeHJ1f5iO2NQLInrfK\np/xt/H0buYUif8MjQMN3FixU1hiJ3xMk09kXYF/nWuFlgcRKXlJuda6BwChfotYy\n9WVNavgFbYFz1ysnQbhmS2B+CX9CvYOuBr4jxpUrETDBJhxxvRCrPFodR2tFGCOV\n8v4OG7zUp3KL7eCuUyEj2GzfLaztgCFH/tAqocAE8fOe2LXXahwHnZTrovxS2DbO\nz8pFNCYcO+5zLTPddhw5FjAq+O26aifjxUYA7o3WTn3tjFVbUWLRd18CHoBWN9M8\nvmRFrIOeYXvT/cBErKDHMqkExsG/BYWxe+4TQP1s57fDCFSyXke7ykqP3fnPkVZU\n7K7yYZHFYQqNvULQB/17LriHThl6pfALH/1zVspU/Nygv7DWIYiTAGPkffdy2LO1\nsAFrQNceq2gXsYXQLpZ6F6s1bxUwb+tvJ0tEy6xl/tK1vTvTcTLY3D2wC8emV8G6\nHMmBLt393fJCnXkMJ4A9\n=7znm\n-----END PGP SIGNATURE-----\n","payload":"tree cf4be57cb3d191b0e171f7ec0ffd8c704f4f662e\nparent 4ae475453ce0df6d6b057b7e163396aa27d55143\nauthor Mason Daugherty <mason@langchain.dev> 1780334722 -0400\ncommitter GitHub <noreply@github.com> 1780334722 -0400\n\nfix(code): point MCP re-enable guidance at `Ctrl+R` (#3688)\n\nRe-enabling a disabled MCP server now points users to the in-modal\nreconnect shortcut instead of the slash command. That keeps the recovery\nguidance aligned with the UI flow users are already in.","verified_at":"2026-06-01T17:25:23Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/15ca3029f18fa38c1592859febc2a6d0469bff2d","html_url":"https://github.com/langchain-ai/deepagents/commit/15ca3029f18fa38c1592859febc2a6d0469bff2d","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/15ca3029f18fa38c1592859febc2a6d0469bff2d/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"4ae475453ce0df6d6b057b7e163396aa27d55143","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/4ae475453ce0df6d6b057b7e163396aa27d55143","html_url":"https://github.com/langchain-ai/deepagents/commit/4ae475453ce0df6d6b057b7e163396aa27d55143"}]},{"sha":"4ae475453ce0df6d6b057b7e163396aa27d55143","node_id":"C_kwDOPTymldoAKDRhZTQ3NTQ1M2NlMGRmNmQ2YjA1N2I3ZTE2MzM5NmFhMjdkNTUxNDM","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-01T17:25:08Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-01T17:25:08Z"},"message":"feat(code): add MCP error detail modal (#3687)\n\nFailed MCP servers now keep noisy or raw errors out of the inline server\nlist while still making full details accessible on demand. Shared\nUnicode and control-character sanitization is reused across MCP local\ncontext and UI rendering so terminal escapes and deceptive characters\nare handled consistently.","tree":{"sha":"ef76ddc389412edaed0d1935c382a2aae74a3859","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/ef76ddc389412edaed0d1935c382a2aae74a3859"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/4ae475453ce0df6d6b057b7e163396aa27d55143","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqHcB0CRC1aQ7uu5UhlAAAz2QQAADGpRnMilMzCVAmshD31awz\n5cxX4K55IG77NXxgqpFxU82SbHpN7icia/syTLEQAjIqkDa7YYz0pGOTuNTe1fsW\nFhL++A0Znx7n6p4LjjgT6x9UhU1114oo67JtEdu+kYa102Lbxl9PIxx4ZrooQwW2\n+xrY9C7CavzvJKmWMXAkKErovcBB4byMB44TcMy9oEQXo2KcZYBNxTqnXgU/ZPFq\n221PglR4BPL4gaZEZBhsMbbY/yiXRlKoogYbf7DpqV0/yvhCk+iinOyjVIvPR+rM\nCXvI+d3HhrM3WH8QjKlU8lQACJcu2HnlcaTFV4EDeulTU6U9cLT+ndHwQ+YLXRYb\nB4oqcoqEwNlTG1PFhxGKNuN2EK6Ffa+Lr0u53C1itiOg