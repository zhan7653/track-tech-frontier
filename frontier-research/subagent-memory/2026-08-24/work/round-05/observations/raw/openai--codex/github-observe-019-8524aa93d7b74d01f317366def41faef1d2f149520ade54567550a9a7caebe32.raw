[{"sha":"68c6e5df2be11b87ed7ca448a692e21fc7a18e04","node_id":"C_kwDOOYsS4doAKDY4YzZlNWRmMmJlMTFiODdlZDdjYTQ0OGE2OTJlMjFmYzdhMThlMDQ","commit":{"author":{"name":"rhan-oai","email":"rhan@openai.com","date":"2026-07-14T21:54:14Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T22:01:11Z"},"message":"Support model catalog templates for Guardian policy prompts (#33177)\n\n## What changed\n\n- Add an optional `policy_template` field to auto-review model messages.\n- Build Guardian instructions from the catalog template when present, while\n  preserving the existing precedence for managed and catalog policy content.\n- Fall back independently to the bundled template and bundled policy, and\n  preserve explicit empty catalog values.\n\n## Testing\n\n- Cover missing and empty template deserialization, policy precedence, bundled\n  fallbacks, and Guardian prewarm instructions.\n\nGitOrigin-RevId: 93116dadbc9bf40527882844a428caed4159fff6","tree":{"sha":"c87c673a9ead01ae3a8a60e74cae22b5a9067149","url":"https://api.github.com/repos/openai/codex/git/trees/c87c673a9ead01ae3a8a60e74cae22b5a9067149"},"url":"https://api.github.com/repos/openai/codex/git/commits/68c6e5df2be11b87ed7ca448a692e21fc7a18e04","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/68c6e5df2be11b87ed7ca448a692e21fc7a18e04","html_url":"https://github.com/openai/codex/commit/68c6e5df2be11b87ed7ca448a692e21fc7a18e04","comments_url":"https://api.github.com/repos/openai/codex/commits/68c6e5df2be11b87ed7ca448a692e21fc7a18e04/comments","author":{"login":"rhan-oai","id":214716640,"node_id":"U_kgDODMxQ4A","avatar_url":"https://avatars.githubusercontent.com/u/214716640?v=4","gravatar_id":"","url":"https://api.github.com/users/rhan-oai","html_url":"https://github.com/rhan-oai","followers_url":"https://api.github.com/users/rhan-oai/followers","following_url":"https://api.github.com/users/rhan-oai/following{/other_user}","gists_url":"https://api.github.com/users/rhan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rhan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rhan-oai/subscriptions","organizations_url":"https://api.github.com/users/rhan-oai/orgs","repos_url":"https://api.github.com/users/rhan-oai/repos","events_url":"https://api.github.com/users/rhan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rhan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"6e215e0db5426354cf42ec1d5134bec71bcd036a","url":"https://api.github.com/repos/openai/codex/commits/6e215e0db5426354cf42ec1d5134bec71bcd036a","html_url":"https://github.com/openai/codex/commit/6e215e0db5426354cf42ec1d5134bec71bcd036a"}]},{"sha":"6e215e0db5426354cf42ec1d5134bec71bcd036a","node_id":"C_kwDOOYsS4doAKDZlMjE1ZTBkYjU0MjYzNTRjZjQyZWMxZDUxMzRiZWM3MWJjZDAzNmE","commit":{"author":{"name":"Celia Chen","email":"celia@openai.com","date":"2026-07-14T21:47:11Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T21:54:24Z"},"message":"Handle Amazon Bedrock credentials during logout (#33175)\n\n## Why\n\nAmazon Bedrock can use either a Codex-managed API key or credentials managed by\nAWS, so logout must not remove or misrepresent credentials that Codex does not\ncontrol.\n\n## What changed\n\n- Remove the managed Bedrock key on logout and clear `model_provider` only when\n  its user-config value is still `amazon-bedrock`.\n- Reject logout for AWS-managed Bedrock credentials without changing existing\n  authentication or configuration.\n- Add a `test-logout` app-server test-client command that waits for the\n  resulting `account/updated` notification.\n\n## Testing\n\nAdd coverage for managed and AWS-managed Bedrock logout, concurrent provider\nchanges, config reload failures, and conditional user-config cleanup.\n\nGitOrigin-RevId: a003c0ec27ad7b36d499fe7b63ab4a0dd6369b4f","tree":{"sha":"b7380943c8f167995c4ebfb919933a425269e2fe","url":"https://api.github.com/repos/openai/codex/git/trees/b7380943c8f167995c4ebfb919933a425269e2fe"},"url":"https://api.github.com/repos/openai/codex/git/commits/6e215e0db5426354cf42ec1d5134bec71bcd036a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/6e215e0db5426354cf42ec1d5134bec71bcd036a","html_url":"https://github.com/openai/codex/commit/6e215e0db5426354cf42ec1d5134bec71bcd036a","comments_url":"https://api.github.com/repos/openai/codex/commits/6e215e0db5426354cf42ec1d5134bec71bcd036a/comments","author":{"login":"celia-oai","id":209693228,"node_id":"U_kgDODH-qLA","avatar_url":"https://avatars.githubusercontent.com/u/209693228?v=4","gravatar_id":"","url":"https://api.github.com/users/celia-oai","html_url":"https://github.com/celia-oai","followers_url":"https://api.github.com/users/celia-oai/followers","following_url":"https://api.github.com/users/celia-oai/following{/other_user}","gists_url":"https://api.github.com/users/celia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/celia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celia-oai/subscriptions","organizations_url":"https://api.github.com/users/celia-oai/orgs","repos_url":"https://api.github.com/users/celia-oai/repos","events_url":"https://api.github.com/users/celia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/celia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c38c30ef514dc74aa6ea59748f280c235b1bca2a","url":"https://api.github.com/repos/openai/codex/commits/c38c30ef514dc74aa6ea59748f280c235b1bca2a","html_url":"https://github.com/openai/codex/commit/c38c30ef514dc74aa6ea59748f280c235b1bca2a"}]},{"sha":"c38c30ef514dc74aa6ea59748f280c235b1bca2a","node_id":"C_kwDOOYsS4doAKGMzOGMzMGVmNTE0ZGM3NGFhNmVhNTk3NDhmMjgwYzIzNWIxYmNhMmE","commit":{"author":{"name":"Sergio Mattei","email":"smattei@openai.com","date":"2026-07-14T21:38:53Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T21:50:19Z"},"message":"Migrate GPT-5.4 uses to GPT-5.6 variants (#33173)\n\n## What changed\n\n- Hide `gpt-5.4` and `gpt-5.4-mini` from model selection and direct existing users to `gpt-5.6-terra` and `gpt-5.6-luna`, respectively.\n- Use Terra for memory consolidation and Luna for memory extraction and rate-limit switch prompts.\n- Keep Amazon Bedrock GPT-5 catalog entries visible when their bundled model metadata is hidden.\n\n## Testing\n\n- Add coverage that all Amazon Bedrock GPT-5 models remain visible and update TUI expectations for the new model choices.\n\nGitOrigin-RevId: fd69c8d5fb6b510c77204df6b7ac3f07e67cded2","tree":{"sha":"0fbfd7783e92584245f3b79dbf2b91854a3d4b53","url":"https://api.github.com/repos/openai/codex/git/trees/0fbfd7783e92584245f3b79dbf2b91854a3d4b53"},"url":"https://api.github.com/repos/openai/codex/git/commits/c38c30ef514dc74aa6ea59748f280c235b1bca2a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c38c30ef514dc74aa6ea59748f280c235b1bca2a","html_url":"https://github.com/openai/codex/commit/c38c30ef514dc74aa6ea59748f280c235b1bca2a","comments_url":"https://api.github.com/repos/openai/codex/commits/c38c30ef514dc74aa6ea59748f280c235b1bca2a/comments","author":{"login":"smattei-oai","id":301085398,"node_id":"U_kgDOEfIy1g","avatar_url":"https://avatars.githubusercontent.com/u/301085398?v=4","gravatar_id":"","url":"https://api.github.com/users/smattei-oai","html_url":"https://github.com/smattei-oai","followers_url":"https://api.github.com/users/smattei-oai/followers","following_url":"https://api.github.com/users/smattei-oai/following{/other_user}","gists_url":"https://api.github.com/users/smattei-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/smattei-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smattei-oai/subscriptions","organizations_url":"https://api.github.com/users/smattei-oai/orgs","repos_url":"https://api.github.com/users/smattei-oai/repos","events_url":"https://api.github.com/users/smattei-oai/events{/privacy}","received_events_url":"https://api.github.com/users/smattei-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"518085387ba8f53c83adb1b0ec7a27dfefbe8352","url":"https://api.github.com/repos/openai/codex/commits/518085387ba8f53c83adb1b0ec7a27dfefbe8352","html_url":"https://github.com/openai/codex/commit/518085387ba8f53c83adb1b0ec7a27dfefbe8352"}]},{"sha":"518085387ba8f53c83adb1b0ec7a27dfefbe8352","node_id":"C_kwDOOYsS4doAKDUxODA4NTM4N2JhOGY1M2M4M2FkYjFiMGVjN2EyN2RmZWZiZTgzNTI","commit":{"author":{"name":"Celia Chen","email":"celia@openai.com","date":"2026-07-14T21:23:43Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T21:28:39Z"},"message":"Support Amazon Bedrock login in the app server (#33170)\n\n## What changed\n\n- Handle experimental `account/login/start` requests with `type: \"amazonBedrock\"`.\n- Validate the API key and Mantle region, persist the managed credential, select the `amazon-bedrock` model provider, and emit the standard login and account-update notifications.\n- Reload configuration for account and authentication status reads so the newly selected provider is visible immediately, with the startup configuration as a fallback.\n- Extend the app-server test client with an Amazon Bedrock login mode that redacts API keys from request logs.\n\n## Testing\n\n- Add app-server coverage for successful login, credential and provider persistence, notifications, refreshed account state, invalid inputs, conflicting configuration, forced ChatGPT login, external authentication, and configuration reload failure.\n\nGitOrigin-RevId: bf3ae98375caee41e78d2cdc677127138184c17a","tree":{"sha":"b96f9c53bae12c7416f9efe5602b976cca226468","url":"https://api.github.com/repos/openai/codex/git/trees/b96f9c53bae12c7416f9efe5602b976cca226468"},"url":"https://api.github.com/repos/openai/codex/git/commits/518085387ba8f53c83adb1b0ec7a27dfefbe8352","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/518085387ba8f53c83adb1b0ec7a27dfefbe8352","html_url":"https://github.com/openai/codex/commit/518085387ba8f53c83adb1b0ec7a27dfefbe8352","comments_url":"https://api.github.com/repos/openai/codex/commits/518085387ba8f53c83adb1b0ec7a27dfefbe8352/comments","author":{"login":"celia-oai","id":209693228,"node_id":"U_kgDODH-qLA","avatar_url":"https://avatars.githubusercontent.com/u/209693228?v=4","gravatar_id":"","url":"https://api.github.com/users/celia-oai","html_url":"https://github.com/celia-oai","followers_url":"https://api.github.com/users/celia-oai/followers","following_url":"https://api.github.com/users/celia-oai/following{/other_user}","gists_url":"https://api.github.com/users/celia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/celia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celia-oai/subscriptions","organizations_url":"https://api.github.com/users/celia-oai/orgs","repos_url":"https://api.github.com/users/celia-oai/repos","events_url":"https://api.github.com/users/celia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/celia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a2fb3f048d07cdb44a2de833a1757c21a24893bf","url":"https://api.github.com/repos/openai/codex/commits/a2fb3f048d07cdb44a2de833a1757c21a24893bf","html_url":"https://github.com/openai/codex/commit/a2fb3f048d07cdb44a2de833a1757c21a24893bf"}]},{"sha":"a2fb3f048d07cdb44a2de833a1757c21a24893bf","node_id":"C_kwDOOYsS4doAKGEyZmIzZjA0OGQwN2NkYjQ0YTJkZTgzM2ExNzU3YzIxYTI0ODkzYmY","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-07-14T21:03:49Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T21:11:32Z"},"message":"Document the Windows exec yield time range (#33167)\n\n## What changed\n\nDocument that `exec_command.yield_time_ms` has an effective range of\n2,000–30,000 ms on Windows, and update the tool specification test to match.\n\nGitOrigin-RevId: aa20bbb2ad82d162d29d93f3bfbe1b970445f44e","tree":{"sha":"8c881389dc9273f4ab257eed1dd18ec37c0f640b","url":"https://api.github.com/repos/openai/codex/git/trees/8c881389dc9273f4ab257eed1dd18ec37c0f640b"},"url":"https://api.github.com/repos/openai/codex/git/commits/a2fb3f048d07cdb44a2de833a1757c21a24893bf","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a2fb3f048d07cdb44a2de833a1757c21a24893bf","html_url":"https://github.com/openai/codex/commit/a2fb3f048d07cdb44a2de833a1757c21a24893bf","comments_url":"https://api.github.com/repos/openai/codex/commits/a2fb3f048d07cdb44a2de833a1757c21a24893bf/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"32cd5d4eab898cfadb593eee61400812758386e7","url":"https://api.github.com/repos/openai/codex/commits/32cd5d4eab898cfadb593eee61400812758386e7","html_url":"https://github.com/openai/codex/commit/32cd5d4eab898cfadb593eee61400812758386e7"}]},{"sha":"32cd5d4eab898cfadb593eee61400812758386e7","node_id":"C_kwDOOYsS4doAKDMyY2Q1ZDRlYWI4OThjZmFkYjU5M2VlZTYxNDAwODEyNzU4Mzg2ZTc","commit":{"author":{"name":"TAFOYA-OAI","email":"TAFOYA@openai.com","date":"2026-07-14T21:02:20Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T21:07:27Z"},"message":"Defer Noise environment connections until registration (#33166)\n\n## What changed\n\n- Replace pending WebSocket URL registration with deferred Noise environment\n  registration that gates connection attempts on an explicit readiness signal.\n- Reuse the Noise rendezvous transport after readiness so reconnects request a\n  fresh connection bundle.\n- Preserve terminal errors for failed or dropped registrations and keep late\n  completion isolated from replacement environments.\n\n## Testing\n\n- Add coverage for readiness gating, registration failure and replacement,\n  eager Noise connections, and reconnection through a fresh rendezvous bundle.\n\nGitOrigin-RevId: 83e23fa03a02e3b2bdf1a83fe26d7ac461f55cf3","tree":{"sha":"65b446360dcfcb8acdc4595f603990a09dec7483","url":"https://api.github.com/repos/openai/codex/git/trees/65b446360dcfcb8acdc4595f603990a09dec7483"},"url":"https://api.github.com/repos/openai/codex/git/commits/32cd5d4eab898cfadb593eee61400812758386e7","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/32cd5d4eab898cfadb593eee61400812758386e7","html_url":"https://github.com/openai/codex/commit/32cd5d4eab898cfadb593eee61400812758386e7","comments_url":"https://api.github.com/repos/openai/codex/commits/32cd5d4eab898cfadb593eee61400812758386e7/comments","author":{"login":"TAFOYA-OAI","id":295987026,"node_id":"U_kgDOEaRnUg","avatar_url":"https://avatars.githubusercontent.com/u/295987026?v=4","gravatar_id":"","url":"https://api.github.com/users/TAFOYA-OAI","html_url":"https://github.com/TAFOYA-OAI","followers_url":"https://api.github.com/users/TAFOYA-OAI/followers","following_url":"https://api.github.com/users/TAFOYA-OAI/following{/other_user}","gists_url":"https://api.github.com/users/TAFOYA-OAI/gists{/gist_id}","starred_url":"https://api.github.com/users/TAFOYA-OAI/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TAFOYA-OAI/subscriptions","organizations_url":"https://api.github.com/users/TAFOYA-OAI/orgs","repos_url":"https://api.github.com/users/TAFOYA-OAI/repos","events_url":"https://api.github.com/users/TAFOYA-OAI/events{/privacy}","received_events_url":"https://api.github.com/users/TAFOYA-OAI/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"5d325ba2234ead1a6c03313de5d6ecf8df015f1a","url":"https://api.github.com/repos/openai/codex/commits/5d325ba2234ead1a6c03313de5d6ecf8df015f1a","html_url":"https://github.com/openai/codex/commit/5d325ba2234ead1a6c03313de5d6ecf8df015f1a"}]},{"sha":"5d325ba2234ead1a6c03313de5d6ecf8df015f1a","node_id":"C_kwDOOYsS4doAKDVkMzI1YmEyMjM0ZWFkMWE2YzAzMzEzZGU1ZDZlY2Y4ZGYwMTVmMWE","commit":{"author":{"name":"pakrym-oai","email":"pakrym@openai.com","date":"2026-07-14T20:49:56Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T21:01:54Z"},"message":"Move sleep items to the extension-owned lifecycle path (#33159)\n\n## What changed\n\n- Define `SleepItem` in `codex-extension-items` and carry `clock.sleep` events through `TurnItem::Extension`.\n- Preserve sleep persistence, thread-history reconstruction, and the app-server's `type: \"sleep\"` schema while reusing the extension-owned type.\n\n## Testing\n\n- Add serialization coverage for the `clock.sleep` extension wire shape and its protocol wrapper.\n- Update sleep lifecycle and thread-history tests to exercise the extension-owned item.\n\nGitOrigin-RevId: 34bb33ed9b90a09bf4744aafdb56e019c717a168","tree":{"sha":"eff4d637fb8c351e9abd52d507b5cdd34816b246","url":"https://api.github.com/repos/openai/codex/git/trees/eff4d637fb8c351e9abd52d507b5cdd34816b246"},"url":"https://api.github.com/repos/openai/codex/git/commits/5d325ba2234ead1a6c03313de5d6ecf8df015f1a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/5d325ba2234ead1a6c03313de5d6ecf8df015f1a","html_url":"https://github.com/openai/codex/commit/5d325ba2234ead1a6c03313de5d6ecf8df015f1a","comments_url":"https://api.github.com/repos/openai/codex/commits/5d325ba2234ead1a6c03313de5d6ecf8df015f1a/comments","author":{"login":"pakrym-oai","id":204937752,"node_id":"U_kgDODDcaGA","avatar_url":"https://avatars.githubusercontent.com/u/204937752?v=4","gravatar_id":"","url":"https://api.github.com/users/pakrym-oai","html_url":"https://github.com/pakrym-oai","followers_url":"https://api.github.com/users/pakrym-oai/followers","following_url":"https://api.github.com/users/pakrym-oai/following{/other_user}","gists_url":"https://api.github.com/users/pakrym-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/pakrym-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pakrym-oai/subscriptions","organizations_url":"https://api.github.com/users/pakrym-oai/orgs","repos_url":"https://api.github.com/users/pakrym-oai/repos","events_url":"https://api.github.com/users/pakrym-oai/events{/privacy}","received_events_url":"https://api.github.com/users/pakrym-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"83a418783707f4446aa832b2799d6cacfef75011","url":"https://api.github.com/repos/openai/codex/commits/83a418783707f4446aa832b2799d6cacfef75011","html_url":"https://github.com/openai/codex/commit/83a418783707f4446aa832b2799d6cacfef75011"}]},{"sha":"83a418783707f4446aa832b2799d6cacfef75011","node_id":"C_kwDOOYsS4doAKDgzYTQxODc4MzcwN2Y0NDQ2YWE4MzJiMjc5OWQ2Y2FjZmVmNzUwMTE","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-14T20:43:21Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T20:56:43Z"},"message":"Run detached reviews as review-agent turns (#33156)\n\n## Why\n\nDetached reviews should behave like ordinary forked turns so clients get the normal steering, tool, permission, and item-stream behavior.\n\n## What changed\n\n- Add a bundled `$review-agent` skill with read-only, defect-first review guidance.\n- Start detached reviews through `AgentRunner` with a target-specific prompt that explicitly references the bundled skill. Keep inline reviews on the existing review-mode flow.\n- Continue emitting the detached review thread and turn identifiers through the app-server API.\n\n## Testing\n\n- Update the detached review integration test to verify the forked turn prompt, ordinary turn completion, and selection of the bundled skill when a user skill has the same name.\n\nGitOrigin-RevId: 979664cd80800fb0d51eabdc4e3211da90c12db9","tree":{"sha":"6353cab1908981ad7a8c6e72a9b0be66354031da","url":"https://api.github.com/repos/openai/codex/git/trees/6353cab1908981ad7a8c6e72a9b0be66354031da"},"url":"https://api.github.com/repos/openai/codex/git/commits/83a418783707f4446aa832b2799d6cacfef75011","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/83a418783707f4446aa832b2799d6cacfef75011","html_url":"https://github.com/openai/codex/commit/83a418783707f4446aa832b2799d6cacfef75011","comments_url":"https://api.github.com/repos/openai/codex/commits/83a418783707f4446aa832b2799d6cacfef75011/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"2012d872113a81781654e1d06c6a713757f42e86","url":"https://api.github.com/repos/openai/codex/commits/2012d872113a81781654e1d06c6a713757f42e86","html_url":"https://github.com/openai/codex/commit/2012d872113a81781654e1d06c6a713757f42e86"}]},{"sha":"2012d872113a81781654e1d06c6a713757f42e86","node_id":"C_kwDOOYsS4doAKDIwMTJkODcyMTEzYTgxNzgxNjU0ZTFkMDZjNmE3MTM3NTdmNDJlODY","commit":{"author":{"name":"rphilizaire-openai","email":"rphilizaire@openai.com","date":"2026-07-14T20:39:08Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T20:52:12Z"},"message":"Trace startup prewarm tasks (#33155)\n\n## What changed\n\nInstrument the spawned WebSocket startup prewarm task with a\n`startup_prewarm` trace span. Set its OpenTelemetry name and attach the\nsession's `thread.id` so prewarm work can be associated with its session.\n\nGitOrigin-RevId: f2d642d145686b883cd82be8a594bd2383470651","tree":{"sha":"dc42b492708bf45a31c930c54695ed8c4eb0aaae","url":"https://api.github.com/repos/openai/codex/git/trees/dc42b492708bf45a31c930c54695ed8c4eb0aaae"},"url":"https://api.github.com/repos/openai/codex/git/commits/2012d872113a81781654e1d06c6a713757f42e86","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/2012d872113a81781654e1d06c6a713757f42e86","html_url":"https://github.com/openai/codex/commit/2012d872113a81781654e1d06c6a713757f42e86","comments_url":"https://api.github.com/repos/openai/codex/commits/2012d872113a81781654e1d06c6a713757f42e86/comments","author":{"login":"rphilizaire-openai","id":200841089,"node_id":"U_kgDOC_iXgQ","avatar_url":"https://avatars.githubusercontent.com/u/200841089?v=4","gravatar_id":"","url":"https://api.github.com/users/rphilizaire-openai","html_url":"https://github.com/rphilizaire-openai","followers_url":"https://api.github.com/users/rphilizaire-openai/followers","following_url":"https://api.github.com/users/rphilizaire-openai/following{/other_user}","gists_url":"https://api.github.com/users/rphilizaire-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/rphilizaire-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rphilizaire-openai/subscriptions","organizations_url":"https://api.github.com/users/rphilizaire-openai/orgs","repos_url":"https://api.github.com/users/rphilizaire-openai/repos","events_url":"https://api.github.com/users/rphilizaire-openai/events{/privacy}","received_events_url":"https://api.github.com/users/rphilizaire-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"e0a3641e6c0bb050e794b5ddd5ca637417667166","url":"https://api.github.com/repos/openai/codex/commits/e0a3641e6c0bb050e794b5ddd5ca637417667166","html_url":"https://github.com/openai/codex/commit/e0a3641e6c0bb050e794b5ddd5ca637417667166"}]},{"sha":"e0a3641e6c0bb050e794b5ddd5ca637417667166","node_id":"C_kwDOOYsS4doAKGUwYTM2NDFlNmMwYmIwNTBlNzk0YjVkZGQ1Y2E2Mzc0MTc2NjcxNjY","commit":{"author":{"name":"Owen Lin","email":"owen@openai.com","date":"2026-07-14T20:38:14Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T20:48:05Z"},"message":"Support paginated thread history in app-server list APIs (#33152)\n\n## Why\n\nClients could discover threads with paginated history, but could not page their\nturns through `thread/turns/list`.\n\n## What changed\n\n- Route `thread/turns/list` for paginated threads through the thread store,\n  preserving cursors, sort direction, turn status, timing, errors, and the\n  requested `summary` or `notLoaded` item view.\n- Reject the `full` turn item view for paginated threads and direct clients to\n  `thread/items/list` for complete item pagination.\n- Return each item page entry with both its containing `turnId` and `item`, so\n  clients can regroup thread-wide pages into turns.\n- Expose local thread-store turn and item pagination through the `ThreadStore`\n  implementation.\n\n## Testing\n\nAdded app-server coverage for paging projected turns and items, item views,\ncursors, turn metadata, and rejection of the unsupported `full` view.\n\nGitOrigin-RevId: 9c4a127a9b4fa91313f0e87494c62fe2e3a06f19","tree":{"sha":"6f9a1eed5ecdd88633fe206ea6f63f13331a380d","url":"https://api.github.com/repos/openai/codex/git/trees/6f9a1eed5ecdd88633fe206ea6f63f13331a380d"},"url":"https://api.github.com/repos/openai/codex/git/commits/e0a3641e6c0bb050e794b5ddd5ca637417667166","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/e0a3641e6c0bb050e794b5ddd5ca637417667166","html_url":"https://github.com/openai/codex/commit/e0a3641e6c0bb050e794b5ddd5ca637417667166","comments_url":"https://api.github.com/repos/openai/codex/commits/e0a3641e6c0bb050e794b5ddd5ca637417667166/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4da39dbea7a829435ea0e8b614ed0c9f3311abeb","url":"https://api.github.com/repos/openai/codex/commits/4da39dbea7a829435ea0e8b614ed0c9f3311abeb","html_url":"https://github.com/openai/codex/commit/4da39dbea7a829435ea0e8b614ed0c9f3311abeb"}]},{"sha":"4da39dbea7a829435ea0e8b614ed0c9f3311abeb","node_id":"C_kwDOOYsS4doAKDRkYTM5ZGJlYTdhODI5NDM1ZWEwZThiNjE0ZWQwYzlmMzMxMWFiZWI","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-07-14T20:33:32Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T20:44:07Z"},"message":"Clarify exec yield timing on Windows (#33150)\n\n## Why\n\nThe generic `yield_time_ms` description does not explain the Windows-specific\ninitial wait behavior or when callers should choose a shorter value.\n\n## What changed\n\n- Describe `yield_time_ms` on Windows as the maximum wait before a running\n  command returns a session ID, while commands that finish sooner still return\n  immediately.\n- Recommend the 10-second default for ordinary commands and shorter waits for\n  intentionally long-lived or interactive processes.\n- Keep the existing parameter description on other platforms.\n\n## Testing\n\n- Update the expected `exec_command` tool schema for both platform variants.\n\nGitOrigin-RevId: 32f90b3a56604fcf1734cc81ba7ab2f0bec41643","tree":{"sha":"62e7fb733366e7112a0504f203c34d70c482999b","url":"https://api.github.com/repos/openai/codex/git/trees/62e7fb733366e7112a0504f203c34d70c482999b"},"url":"https://api.github.com/repos/openai/codex/git/commits/4da39dbea7a829435ea0e8b614ed0c9f3311abeb","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4da39dbea7a829435ea0e8b614ed0c9f3311abeb","html_url":"https://github.com/openai/codex/commit/4da39dbea7a829435ea0e8b614ed0c9f3311abeb","comments_url":"https://api.github.com/repos/openai/codex/commits/4da39dbea7a829435ea0e8b614ed0c9f3311abeb/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"1447cee36ba40610b953c4b625fc0aac15a31d2e","url":"https://api.github.com/repos/openai/codex/commits/1447cee36ba40610b953c4b625fc0aac15a31d2e","html_url":"https://github.com/openai/codex/commit/1447cee36ba40610b953c4b625fc0aac15a31d2e"}]},{"sha":"1447cee36ba40610b953c4b625fc0aac15a31d2e","node_id":"C_kwDOOYsS4doAKDE0NDdjZWUzNmJhNDA2MTBiOTUzYzRiNjI1ZmMwYWFjMTVhMzFkMmU","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-14T20:30:13Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T20:36:29Z"},"message":"Build MCP tool runtimes before router planning (#33149)\n\n## What changed\n\n- Convert filtered MCP tool metadata into `CoreToolRuntime` instances before constructing the tool router.\n- Pass those runtimes through the shared tool-planning path instead of maintaining separate direct and deferred MCP tool lists.\n- Preserve MCP visibility, app policy filtering, and direct versus deferred exposure behavior.\n\nGitOrigin-RevId: 67f7fbeecc2992318c859e038cd97938833911db","tree":{"sha":"f9a86dd7d1a2dccad019c55303b3a79d0b54d277","url":"https://api.github.com/repos/openai/codex/git/trees/f9a86dd7d1a2dccad019c55303b3a79d0b54d277"},"url":"https://api.github.com/repos/openai/codex/git/commits/1447cee36ba40610b953c4b625fc0aac15a31d2e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/1447cee36ba40610b953c4b625fc0aac15a31d2e","html_url":"https://github.com/openai/codex/commit/1447cee36ba40610b953c4b625fc0aac15a31d2e","comments_url":"https://api.github.com/repos/openai/codex/commits/1447cee36ba40610b953c4b625fc0aac15a31d2e/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"eb80df03179a3e90f8148f85a874c49f4f1f548c","url":"https://api.github.com/repos/openai/codex/commits/eb80df03179a3e90f8148f85a874c49f4f1f548c","html_url":"https://github.com/openai/codex/commit/eb80df03179a3e90f8148f85a874c49f4f1f548c"}]},{"sha":"eb80df03179a3e90f8148f85a874c49f4f1f548c","node_id":"C_kwDOOYsS4doAKGViODBkZjAzMTc5YTNlOTBmODE0OGY4NWE4NzRjNDlmNGYxZjU0OGM","commit":{"author":{"name":"rhan-oai","email":"rhan@openai.com","date":"2026-07-14T20:09:12Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T20:14:29Z"},"message":"Support model catalog permission messages (#33147)\n\n## What changed\n\n- Add per-sandbox-mode permission messages to `ModelMessages` and preserve them when applying model configuration overrides.\n- Use the selected catalog message in permission instructions, substituting `{{ network_access }}` with the active network policy. Fall back to the existing sandbox text when no override is provided, and allow an empty override to omit only the sandbox section.\n- Apply catalog permission messages when a session starts and when its model changes.\n\n## Testing\n\n- Cover catalog deserialization, mode selection, network substitution, fallback and empty-message behavior, remote model catalogs, and model changes.\n\nGitOrigin-RevId: cd5ed3aee3155dca0e7b2358c0f09bae73236856","tree":{"sha":"fa5c63696e100edb3aa4b7467f3845f403cf9815","url":"https://api.github.com/repos/openai/codex/git/trees/fa5c63696e100edb3aa4b7467f3845f403cf9815"},"url":"https://api.github.com/repos/openai/codex/git/commits/eb80df03179a3e90f8148f85a874c49f4f1f548c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/eb80df03179a3e90f8148f85a874c49f4f1f548c","html_url":"https://github.com/openai/codex/commit/eb80df03179a3e90f8148f85a874c49f4f1f548c","comments_url":"https://api.github.com/repos/openai/codex/commits/eb80df03179a3e90f8148f85a874c49f4f1f548c/comments","author":{"login":"rhan-oai","id":214716640,"node_id":"U_kgDODMxQ4A","avatar_url":"https://avatars.githubusercontent.com/u/214716640?v=4","gravatar_id":"","url":"https://api.github.com/users/rhan-oai","html_url":"https://github.com/rhan-oai","followers_url":"https://api.github.com/users/rhan-oai/followers","following_url":"https://api.github.com/users/rhan-oai/following{/other_user}","gists_url":"https://api.github.com/users/rhan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rhan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rhan-oai/subscriptions","organizations_url":"https://api.github.com/users/rhan-oai/orgs","repos_url":"https://api.github.com/users/rhan-oai/repos","events_url":"https://api.github.com/users/rhan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rhan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"f90e7deea6a715bbd153044af6f475eefa749177","url":"https://api.github.com/repos/openai/codex/commits/f90e7deea6a715bbd153044af6f475eefa749177","html_url":"https://github.com/openai/codex/commit/f90e7deea6a715bbd153044af6f475eefa749177"}]},{"sha":"f90e7deea6a715bbd153044af6f475eefa749177","node_id":"C_kwDOOYsS4doAKGY5MGU3ZGVlYTZhNzE1YmJkMTUzMDQ0YWY2ZjQ3NWVlZmE3NDkxNzc","commit":{"author":{"name":"Konstantine Kahadze","email":"kkahadze@openai.com","date":"2026-07-14T18:00:03Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T18:04:49Z"},"message":"Refine GPT-5.6 prompting and migration guidance (#33121)\n\n## What changed\n\n- Recommend simplifying prompts incrementally and evaluating each change while preserving product requirements.\n- Document `text.verbosity` as the default response-detail control and clarify how prompts should specify task-specific content and tone.\n- Clarify autonomy and approval boundaries for multi-step work.\n- Narrow Programmatic Tool Calling guidance to bounded reduction workflows and call out validation of both `program_output` and the final assistant `message`.\n\nGitOrigin-RevId: 2334a1cfba9ead53d2002a097920d1306bcae0d4","tree":{"sha":"1e83e292b90e89d993703d08f05fb8579601bda2","url":"https://api.github.com/repos/openai/codex/git/trees/1e83e292b90e89d993703d08f05fb8579601bda2"},"url":"https://api.github.com/repos/openai/codex/git/commits/f90e7deea6a715bbd153044af6f475eefa749177","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/f90e7deea6a715bbd153044af6f475eefa749177","html_url":"https://github.com/openai/codex/commit/f90e7deea6a715bbd153044af6f475eefa749177","comments_url":"https://api.github.com/repos/openai/codex/commits/f90e7deea6a715bbd153044af6f475eefa749177/comments","author":{"login":"kkahadze-oai","id":269039836,"node_id":"U_kgDOEAk43A","avatar_url":"https://avatars.githubusercontent.com/u/269039836?v=4","gravatar_id":"","url":"https://api.github.com/users/kkahadze-oai","html_url":"https://github.com/kkahadze-oai","followers_url":"https://api.github.com/users/kkahadze-oai/followers","following_url":"https://api.github.com/users/kkahadze-oai/following{/other_user}","gists_url":"https://api.github.com/users/kkahadze-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/kkahadze-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kkahadze-oai/subscriptions","organizations_url":"https://api.github.com/users/kkahadze-oai/orgs","repos_url":"https://api.github.com/users/kkahadze-oai/repos","events_url":"https://api.github.com/users/kkahadze-oai/events{/privacy}","received_events_url":"https://api.github.com/users/kkahadze-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"8604689ec5e3437eb79802d8d72249b7722fbf5b","url":"https://api.github.com/repos/openai/codex/commits/8604689ec5e3437eb79802d8d72249b7722fbf5b","html_url":"https://github.com/openai/codex/commit/8604689ec5e3437eb79802d8d72249b7722fbf5b"}]},{"sha":"8604689ec5e3437eb79802d8d72249b7722fbf5b","node_id":"C_kwDOOYsS4doAKDg2MDQ2ODllYzVlMzQzN2ViNzk4MDJkOGQ3MjI0OWI3NzIyZmJmNWI","commit":{"author":{"name":"Bryan Ashley","email":"bryan.ashley@bashley.net","date":"2026-07-14T17:03:16Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T17:10:04Z"},"message":"Allow injecting the Codex Apps tools cache (#33113)\n\n## What changed\n\n- Accept a caller-provided `CodexAppsToolsCache` when constructing a `ThreadManager` and pass it through to the MCP manager.\n- Add `ConnectorRuntimeManager::new_without_cache()` for an in-memory runtime that neither loads nor persists connector state on disk.\n- Re-export `CodexAppsToolsCache` from `codex-core` and `codex-core-api` for embedders.\n\n## Testing\n\n- Verify that a cache-disabled connector runtime ignores existing disk state and publishes live tools without creating cache files.\n\nGitOrigin-RevId: f52f4f27c425a8d84ad0d0987b30a6fc3c14d702","tree":{"sha":"c6b263370826411ffec79c2fc35c0c9045ef2c8f","url":"https://api.github.com/repos/openai/codex/git/trees/c6b263370826411ffec79c2fc35c0c9045ef2c8f"},"url":"https://api.github.com/repos/openai/codex/git/commits/8604689ec5e3437eb79802d8d72249b7722fbf5b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/8604689ec5e3437eb79802d8d72249b7722fbf5b","html_url":"https://github.com/openai/codex/commit/8604689ec5e3437eb79802d8d72249b7722fbf5b","comments_url":"https://api.github.com/repos/openai/codex/commits/8604689ec5e3437eb79802d8d72249b7722fbf5b/comments","author":{"login":"bryanashley","id":1095642,"node_id":"MDQ6VXNlcjEwOTU2NDI=","avatar_url":"https://avatars.githubusercontent.com/u/1095642?v=4","gravatar_id":"","url":"https://api.github.com/users/bryanashley","html_url":"https://github.com/bryanashley","followers_url":"https://api.github.com/users/bryanashley/followers","following_url":"https://api.github.com/users/bryanashley/following{/other_user}","gists_url":"https://api.github.com/users/bryanashley/gists{/gist_id}","starred_url":"https://api.github.com/users/bryanashley/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bryanashley/subscriptions","organizations_url":"https://api.github.com/users/bryanashley/orgs","repos_url":"https://api.github.com/users/bryanashley/repos","events_url":"https://api.github.com/users/bryanashley/events{/privacy}","received_events_url":"https://api.github.com/users/bryanashley/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"69acc71cb18fc9a1b7858f92489cc8d135e450f2","url":"https://api.github.com/repos/openai/codex/commits/69acc71cb18fc9a1b7858f92489cc8d135e450f2","html_url":"https://github.com/openai/codex/commit/69acc71cb18fc9a1b7858f92489cc8d135e450f2"}]},{"sha":"69acc71cb18fc9a1b7858f92489cc8d135e450f2","node_id":"C_kwDOOYsS4doAKDY5YWNjNzFjYjE4ZmM5YTFiNzg1OGY5MjQ4OWNjOGQxMzVlNDUwZjI","commit":{"author":{"name":"Owen Lin","email":"owen@openai.com","date":"2026-07-14T16:39:43Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T16:44:35Z"},"message":"Reject forks of paginated threads (#33109)\n\n## What changed\n\n- Check the source thread's `history_mode` before loading its history for\n  `thread/fork`.\n- Return the existing `paginated_threads is not supported yet` method-not-found\n  error for paginated source threads.\n\n## Testing\n\n- Add an app-server integration test covering rejection of a paginated source\n  thread.\n\nGitOrigin-RevId: 49b4b8aef7c9488eec93c24e831cea6382f8c995","tree":{"sha":"e90438346a9bb8c412e4508057d28925d98f2f98","url":"https://api.github.com/repos/openai/codex/git/trees/e90438346a9bb8c412e4508057d28925d98f2f98"},"url":"https://api.github.com/repos/openai/codex/git/commits/69acc71cb18fc9a1b7858f92489cc8d135e450f2","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/69acc71cb18fc9a1b7858f92489cc8d135e450f2","html_url":"https://github.com/openai/codex/commit/69acc71cb18fc9a1b7858f92489cc8d135e450f2","comments_url":"https://api.github.com/repos/openai/codex/commits/69acc71cb18fc9a1b7858f92489cc8d135e450f2/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"0396f99cf1a27fc87dd12d23403b25e840b6ecbd","url":"https://api.github.com/repos/openai/codex/commits/0396f99cf1a27fc87dd12d23403b25e840b6ecbd","html_url":"https://github.com/openai/codex/commit/0396f99cf1a27fc87dd12d23403b25e840b6ecbd"}]},{"sha":"0396f99cf1a27fc87dd12d23403b25e840b6ecbd","node_id":"C_kwDOOYsS4doAKDAzOTZmOTljZjFhMjdmYzg3ZGQxMmQyMzQwM2IyNWU4NDBiNmVjYmQ","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-07-14T16:35:03Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T16:40:13Z"},"message":"Preserve special filesystem subpaths as wire strings (#33107)\n\n## Why\n\nSpecial filesystem subpaths can contain relative or foreign-platform path\nspellings. Treating this wire text as a host-native path can reinterpret it.\n\n## What changed\n\n- Store special filesystem subpaths as strings in the core permissions model.\n- Represent app-server subpaths as `LegacyAppPathString` and convert them at\n  the protocol boundary without changing their spelling.\n- Add `LegacyAppPathString::from_string` for callers that already own legacy\n  app-server path text.\n\nGitOrigin-RevId: 2214f03aa997fd0e6eb2ab60d425304bb4bd6132","tree":{"sha":"a2e8d657efd9d52afc2824beb588257925cc89c1","url":"https://api.github.com/repos/openai/codex/git/trees/a2e8d657efd9d52afc2824beb588257925cc89c1"},"url":"https://api.github.com/repos/openai/codex/git/commits/0396f99cf1a27fc87dd12d23403b25e840b6ecbd","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/0396f99cf1a27fc87dd12d23403b25e840b6ecbd","html_url":"https://github.com/openai/codex/commit/0396f99cf1a27fc87dd12d23403b25e840b6ecbd","comments_url":"https://api.github.com/repos/openai/codex/commits/0396f99cf1a27fc87dd12d23403b25e840b6ecbd/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fca8c00f11bdbfaabed6bae2cb3765fcbd106fe8","url":"https://api.github.com/repos/openai/codex/commits/fca8c00f11bdbfaabed6bae2cb3765fcbd106fe8","html_url":"https://github.com/openai/codex/commit/fca8c00f11bdbfaabed6bae2cb3765fcbd106fe8"}]},{"sha":"fca8c00f11bdbfaabed6bae2cb3765fcbd106fe8","node_id":"C_kwDOOYsS4doAKGZjYThjMDBmMTFiZGJmYWFiZWQ2YmFlMmNiMzc2NWZjYmQxMDZmZTg","commit":{"author":{"name":"rakan-oai","email":"rakan@openai.com","date":"2026-07-14T16:25:14Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T16:29:54Z"},"message":"Fix TUI status visibility around streamed output (#33105)\n\n## What changed\n\n- Hide the working-status indicator when finalized assistant output is committed to the transcript, including single-line final answers.\n- Restore the indicator when image generation begins during a running task after its streamed preamble has been flushed.\n\n## Testing\n\n- Add snapshot coverage for a single-line final answer and for image generation following a single-line preamble.\n\nGitOrigin-RevId: e294a11cda3f0ce46f2bbed1be2a1380c9c73085","tree":{"sha":"29fa96ceb7ddebaa2a574768ce8d7d37cc9539db","url":"https://api.github.com/repos/openai/codex/git/trees/29fa96ceb7ddebaa2a574768ce8d7d37cc9539db"},"url":"https://api.github.com/repos/openai/codex/git/commits/fca8c00f11bdbfaabed6bae2cb3765fcbd106fe8","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fca8c00f11bdbfaabed6bae2cb3765fcbd106fe8","html_url":"https://github.com/openai/codex/commit/fca8c00f11bdbfaabed6bae2cb3765fcbd106fe8","comments_url":"https://api.github.com/repos/openai/codex/commits/fca8c00f11bdbfaabed6bae2cb3765fcbd106fe8/comments","author":{"login":"rakan-oai","id":245020938,"node_id":"U_kgDODpq5Cg","avatar_url":"https://avatars.githubusercontent.com/u/245020938?v=4","gravatar_id":"","url":"https://api.github.com/users/rakan-oai","html_url":"https://github.com/rakan-oai","followers_url":"https://api.github.com/users/rakan-oai/followers","following_url":"https://api.github.com/users/rakan-oai/following{/other_user}","gists_url":"https://api.github.com/users/rakan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rakan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rakan-oai/subscriptions","organizations_url":"https://api.github.com/users/rakan-oai/orgs","repos_url":"https://api.github.com/users/rakan-oai/repos","events_url":"https://api.github.com/users/rakan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rakan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"effd58d7505382f6b2d1736a4fc9e3eb90df1966","url":"https://api.github.com/repos/openai/codex/commits/effd58d7505382f6b2d1736a4fc9e3eb90df1966","html_url":"https://github.com/openai/codex/commit/effd58d7505382f6b2d1736a4fc9e3eb90df1966"}]},{"sha":"effd58d7505382f6b2d1736a4fc9e3eb90df1966","node_id":"C_kwDOOYsS4doAKGVmZmQ1OGQ3NTA1MzgyZjZiMmQxNzM2YTRmYzllM2ViOTBkZjE5NjY","commit":{"author":{"name":"rakan-oai","email":"rakan@openai.com","date":"2026-07-14T15:21:54Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T15:27:45Z"},"message":"Preserve streamed output during capped history replay (#33093)\n\n## Why\n\nStream consolidation can replace transcript cells while initial history replay is buffering capped display rows, leaving those rows stale and omitting the finalized output.\n\n## What changed\n\n- Discard buffered rows when required stream reflow occurs during capped initial replay and rebuild the capped tail from the canonical transcript after replay finishes.\n- Schedule the rebuild through the resize reflow path so it waits for an active transcript overlay to close.\n\n## Testing\n\nAdded coverage for consolidated Markdown output during capped initial replay, both with and without an active transcript overlay.\n\nGitOrigin-RevId: 1c184ff561a50362daf11c1c629be59882f27a4a","tree":{"sha":"0b3920572dc1c0c637a61e1d1b0ad0f1aa60cc2d","url":"https://api.github.com/repos/openai/codex/git/trees/0b3920572dc1c0c637a61e1d1b0ad0f1aa60cc2d"},"url":"https://api.github.com/repos/openai/codex/git/commits/effd58d7505382f6b2d1736a4fc9e3eb90df1966","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/effd58d7505382f6b2d1736a4fc9e3eb90df1966","html_url":"https://github.com/openai/codex/commit/effd58d7505382f6b2d1736a4fc9e3eb90df1966","comments_url":"https://api.github.com/repos/openai/codex/commits/effd58d7505382f6b2d1736a4fc9e3eb90df1966/comments","author":{"login":"rakan-oai","id":245020938,"node_id":"U_kgDODpq5Cg","avatar_url":"https://avatars.githubusercontent.com/u/245020938?v=4","gravatar_id":"","url":"https://api.github.com/users/rakan-oai","html_url":"https://github.com/rakan-oai","followers_url":"https://api.github.com/users/rakan-oai/followers","following_url":"https://api.github.com/users/rakan-oai/following{/other_user}","gists_url":"https://api.github.com/users/rakan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rakan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rakan-oai/subscriptions","organizations_url":"https://api.github.com/users/rakan-oai/orgs","repos_url":"https://api.github.com/users/rakan-oai/repos","events_url":"https://api.github.com/users/rakan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rakan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"6629e0870231fddfd4c0b6abacaad54f2175fc83","url":"https://api.github.com/repos/openai/codex/commits/6629e0870231fddfd4c0b6abacaad54f2175fc83","html_url":"https://github.com/openai/codex/commit/6629e0870231fddfd4c0b6abacaad54f2175fc83"}]},{"sha":"6629e0870231fddfd4c0b6abacaad54f2175fc83","node_id":"C_kwDOOYsS4doAKDY2MjllMDg3MDIzMWZkZGZkNGMwYjZhYmFjYWFkNTRmMjE3NWZjODM","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-14T14:35:21Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T14:41:30Z"},"message":"Add an agent extension runner (#33076)\n\n## What changed\n\n- Add `codex-agent-extension` with an `AgentRunner` that starts a resolved agent prompt in a thread forked from its parent.\n- Propagate the invocation's trace context, select the configured execution environments, submit the initial prompt, and return the spawned thread and turn identifiers.\n- Reject empty agent prompts and report when the owning thread manager is no longer available.\n\n## Testing\n\n- Add an integration test that verifies the agent runs in a forked thread, returns the started turn identifier, completes the turn, and sends the resolved prompt to the model.\n\nGitOrigin-RevId: ffb805efabadf758969d6611a6867db6fa9f059a","tree":{"sha":"d075bd633b87f6a9acf18306a06ad9f8e422d410","url":"https://api.github.com/repos/openai/codex/git/trees/d075bd633b87f6a9acf18306a06ad9f8e422d410"},"url":"https://api.github.com/repos/openai/codex/git/commits/6629e0870231fddfd4c0b6abacaad54f2175fc83","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/6629e0870231fddfd4c0b6abacaad54f2175fc83","html_url":"https://github.com/openai/codex/commit/6629e0870231fddfd4c0b6abacaad54f2175fc83","comments_url":"https://api.github.com/repos/openai/codex/commits/6629e0870231fddfd4c0b6abacaad54f2175fc83/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"5bed6447998c754d154dbd796517310b8f04d4ce","url":"https://api.github.com/repos/openai/codex/commits/5bed6447998c754d154dbd796517310b8f04d4ce","html_url":"https://github.com/openai/codex/commit/5bed6447998c754d154dbd796517310b8f04d4ce"}]},{"sha":"5bed6447998c754d154dbd796517310b8f04d4ce","node_id":"C_kwDOOYsS4doAKDViZWQ2NDQ3OTk4Yzc1NGQxNTRkYmQ3OTY1MTczMTBiOGYwNGQ0Y2U","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-07-14T11:15:55Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T11:21:25Z"},"message":"Send plugin analytics with API key authentication (#33040)\n\n## What changed\n\nAllow API key sessions to send plugin-attributed `codex_plugin_used`,\n`skill_invocation`, and `codex_mcp_tool_call_event` events. Continue to drop\nevents without a plugin ID and all other analytics events for these sessions.\n\n## Testing\n\nAdd coverage that mixes plugin and non-plugin events and verifies that only the\nthree plugin-attributed event types are delivered without server-owned auth\nfields.\n\nGitOrigin-RevId: 1f47af5e9516723154f566ad032dba3ebd98abf9","tree":{"sha":"777110fc631f9b2765fc5818fcb3929a11d7672e","url":"https://api.github.com/repos/openai/codex/git/trees/777110fc631f9b2765fc5818fcb3929a11d7672e"},"url":"https://api.github.com/repos/openai/codex/git/commits/5bed6447998c754d154dbd796517310b8f04d4ce","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/5bed6447998c754d154dbd796517310b8f04d4ce","html_url":"https://github.com/openai/codex/commit/5bed6447998c754d154dbd796517310b8f04d4ce","comments_url":"https://api.github.com/repos/openai/codex/commits/5bed6447998c754d154dbd796517310b8f04d4ce/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4aa950d456c6c90174d3269d7eaab4a2823e5889","url":"https://api.github.com/repos/openai/codex/commits/4aa950d456c6c90174d3269d7eaab4a2823e5889","html_url":"https://github.com/openai/codex/commit/4aa950d456c6c90174d3269d7eaab4a2823e5889"}]},{"sha":"4aa950d456c6c90174d3269d7eaab4a2823e5889","node_id":"C_kwDOOYsS4doAKDRhYTk1MGQ0NTZjNmM5MDE3NGQzMjY5ZDdlYWFiNGEyODIzZTU4ODk","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-14T10:32:19Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T10:37:23Z"},"message":"Use session IDs for prompt cache keys (#33035)\n\n## What changed\n\n- Default `prompt_cache_key` to the session ID from response metadata instead of the thread ID.\n- Preserve explicit prompt cache key overrides.\n- Verify that API-key-authenticated root and subagent requests use the same session-based cache key even though they have different thread IDs.\n\nGitOrigin-RevId: cb1bf21a3cb8fa2c5083c5c6afd4829ff2adcf1f","tree":{"sha":"d3c4e5eec0e775a5b5e00b9e03f9b15b1c94571f","url":"https://api.github.com/repos/openai/codex/git/trees/d3c4e5eec0e775a5b5e00b9e03f9b15b1c94571f"},"url":"https://api.github.com/repos/openai/codex/git/commits/4aa950d456c6c90174d3269d7eaab4a2823e5889","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4aa950d456c6c90174d3269d7eaab4a2823e5889","html_url":"https://github.com/openai/codex/commit/4aa950d456c6c90174d3269d7eaab4a2823e5889","comments_url":"https://api.github.com/repos/openai/codex/commits/4aa950d456c6c90174d3269d7eaab4a2823e5889/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"7790524d6bc79ee3be03ce68941d030684a7b5c0","url":"https://api.github.com/repos/openai/codex/commits/7790524d6bc79ee3be03ce68941d030684a7b5c0","html_url":"https://github.com/openai/codex/commit/7790524d6bc79ee3be03ce68941d030684a7b5c0"}]},{"sha":"7790524d6bc79ee3be03ce68941d030684a7b5c0","node_id":"C_kwDOOYsS4doAKDc3OTA1MjRkNmJjNzllZTNiZTAzY2U2ODk0MWQwMzA2ODRhN2I1YzA","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-14T10:18:50Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T10:26:52Z"},"message":"Preserve JSON number precision in exec-server RPC messages (#33031)\n\n## Why\n\nExec-server JSON-RPC payloads can contain decimals, exponent notation, and\nintegers outside the native 64-bit range. Decoding these values should preserve\ntheir original JSON representation without weakening the existing message\ncomplexity limit.\n\n## What changed\n\n- Enable `serde_json` arbitrary-precision number and raw-value support for the\n  exec-server protocol.\n- Decode serde's number and raw-value wrappers in the bounded JSON visitor,\n  charging nested raw values against the 256K-value limit.\n- Select the JSON-RPC envelope variant from its fields after bounded decoding so\n  arbitrary-precision values survive message deserialization.\n\n## Testing\n\nAdd coverage for exact arbitrary-precision number round trips and for enforcing\nthe value limit inside raw-value wrappers.\n\nGitOrigin-RevId: a6e0a3fba6f88e4e8a6ff414832f078beb2d2a70","tree":{"sha":"78fedd27516f36f130ec40bce4bff4fd4912586c","url":"https://api.github.com/repos/openai/codex/git/trees/78fedd27516f36f130ec40bce4bff4fd4912586c"},"url":"https://api.github.com/repos/openai/codex/git/commits/7790524d6bc79ee3be03ce68941d030684a7b5c0","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/7790524d6bc79ee3be03ce68941d030684a7b5c0","html_url":"https://github.com/openai/codex/commit/7790524d6bc79ee3be03ce68941d030684a7b5c0","comments_url":"https://api.github.com/repos/openai/codex/commits/7790524d6bc79ee3be03ce68941d030684a7b5c0/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"64c0e2fa1b9560171366e840d5336563a461f2b2","url":"https://api.github.com/repos/openai/codex/commits/64c0e2fa1b9560171366e840d5336563a461f2b2","html_url":"https://github.com/openai/codex/commit/64c0e2fa1b9560171366e840d5336563a461f2b2"}]},{"sha":"64c0e2fa1b9560171366e840d5336563a461f2b2","node_id":"C_kwDOOYsS4doAKDY0YzBlMmZhMWI5NTYwMTcxMzY2ZTg0MGQ1MzM2NTYzYTQ2MWYyYjI","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-14T10:16:45Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T10:22:04Z"},"message":"Remove task messages from `list_agents` output (#33030)\n\n## What changed\n\n- Return only each live agent's name and status from `list_agents`.\n- Stop tracking the most recent task message in agent metadata.\n\nGitOrigin-RevId: 91836fe8efad7ea6b7305f0b409081ec77419cfd","tree":{"sha":"d41cebb90a6bb51b314aa48dcc87a2dced426b2c","url":"https://api.github.com/repos/openai/codex/git/trees/d41cebb90a6bb51b314aa48dcc87a2dced426b2c"},"url":"https://api.github.com/repos/openai/codex/git/commits/64c0e2fa1b9560171366e840d5336563a461f2b2","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/64c0e2fa1b9560171366e840d5336563a461f2b2","html_url":"https://github.com/openai/codex/commit/64c0e2fa1b9560171366e840d5336563a461f2b2","comments_url":"https://api.github.com/repos/openai/codex/commits/64c0e2fa1b9560171366e840d5336563a461f2b2/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"271136e00c70965a24eca9225b7efdf36d8b515c","url":"https://api.github.com/repos/openai/codex/commits/271136e00c70965a24eca9225b7efdf36d8b515c","html_url":"https://github.com/openai/codex/commit/271136e00c70965a24eca9225b7efdf36d8b515c"}]},{"sha":"271136e00c70965a24eca9225b7efdf36d8b515c","node_id":"C_kwDOOYsS4doAKDI3MTEzNmUwMGM3MDk2NWEyNGVjYTkyMjViN2VmZGYzNmQ4YjUxNWM","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-14T10:06:24Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T10:11:51Z"},"message":"Include raw response completions in TypeScript envelopes (#33026)\n\n## What changed\n\nAdd `rawResponse/completed` and its `RawResponseCompletedNotification` payload\nto the generated `ServerNotificationEnvelope` union, keeping the envelope type\naligned with the supported server notifications.\n\nGitOrigin-RevId: 25a8b5e05a146a66ea65928eb6f0c3bd7b80f082","tree":{"sha":"1380a87c6e9aea8dd3f323f1bfd6c2481e0aebce","url":"https://api.github.com/repos/openai/codex/git/trees/1380a87c6e9aea8dd3f323f1bfd6c2481e0aebce"},"url":"https://api.github.com/repos/openai/codex/git/commits/271136e00c70965a24eca9225b7efdf36d8b515c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/271136e00c70965a24eca9225b7efdf36d8b515c","html_url":"https://github.com/openai/codex/commit/271136e00c70965a24eca9225b7efdf36d8b515c","comments_url":"https://api.github.com/repos/openai/codex/commits/271136e00c70965a24eca9225b7efdf36d8b515c/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"325cf161940c4be5d5792dc09940624ba7543b44","url":"https://api.github.com/repos/openai/codex/commits/325cf161940c4be5d5792dc09940624ba7543b44","html_url":"https://github.com/openai/codex/commit/325cf161940c4be5d5792dc09940624ba7543b44"}]},{"sha":"325cf161940c4be5d5792dc09940624ba7543b44","node_id":"C_kwDOOYsS4doAKDMyNWNmMTYxOTQwYzRiZTVkNTc5MmRjMDk5NDA2MjRiYTc1NDNiNDQ","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-14T09:09:46Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T09:15:27Z"},"message":"Bound exec-server JSON-RPC decoding complexity (#33013)\n\n## Why\n\nCompact JSON arrays can expand into millions of heap values during decoding, and duplicate object keys make a message ambiguous.\n\n## What changed\n\n- Limit exec-server JSON-RPC messages to 256K JSON values and reject duplicate object keys.\n- Cap `fs/read_directory` results and retained `process/read` output at 50,000 entries or chunks so locally produced responses remain within the decoder budget.\n\n## Testing\n\nAdd coverage for all JSON-RPC variants, large scalar payloads, duplicate keys, compact array amplification, and retained process output at the chunk limit.\n\nGitOrigin-RevId: e31d1f25ab0a7e2272015c98174fd2b7cdd669d7","tree":{"sha":"2961d0c24729e3aacbf014c9c93ef44d37621951","url":"https://api.github.com/repos/openai/codex/git/trees/2961d0c24729e3aacbf014c9c93ef44d37621951"},"url":"https://api.github.com/repos/openai/codex/git/commits/325cf161940c4be5d5792dc09940624ba7543b44","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/325cf161940c4be5d5792dc09940624ba7543b44","html_url":"https://github.com/openai/codex/commit/325cf161940c4be5d5792dc09940624ba7543b44","comments_url":"https://api.github.com/repos/openai/codex/commits/325cf161940c4be5d5792dc09940624ba7543b44/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"d7ba5ff9553a6aa0898a8e3bd5cb3bc00d0c9ddf","url":"https://api.github.com/repos/openai/codex/commits/d7ba5ff9553a6aa0898a8e3bd5cb3bc00d0c9ddf","html_url":"https://github.com/openai/codex/commit/d7ba5ff9553a6aa0898a8e3bd5cb3bc00d0c9ddf"}]},{"sha":"d7ba5ff9553a6aa0898a8e3bd5cb3bc00d0c9ddf","node_id":"C_kwDOOYsS4doAKGQ3YmE1ZmY5NTUzYTZhYTA4OThhOGUzYmQ1Y2IzYmMwMGQwYzlkZGY","commit":{"author":{"name":"Shijie Rao","email":"shijie.rao@openai.com","date":"2026-07-14T06:50:10Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T06:55:29Z"},"message":"Always confirm before enabling full access (#32989)\n\n## Why\n\nFull access significantly increases the risk of data loss, leaks, or unexpected behavior, so users should explicitly confirm each time they select it.\n\n## What changed\n\n- Always open the full access confirmation when user-reviewed approvals are active, regardless of `notices.hide_full_access_warning`.\n- Remove the persistent \"don't ask again\" option and its acknowledgement events.\n\n## Testing\n\n- Update the TUI permission tests and confirmation popup snapshot to cover repeated confirmation.\n\nGitOrigin-RevId: 0ee827332441e13d9445349ed6a5a92dc8fef4b2","tree":{"sha":"41fbaf4af6113a02f8aeb3821e83f75e54435344","url":"https://api.github.com/repos/openai/codex/git/trees/41fbaf4af6113a02f8aeb3821e83f75e54435344"},"url":"https://api.github.com/repos/openai/codex/git/commits/d7ba5ff9553a6aa0898a8e3bd5cb3bc00d0c9ddf","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/d7ba5ff9553a6aa0898a8e3bd5cb3bc00d0c9ddf","html_url":"https://github.com/openai/codex/commit/d7ba5ff9553a6aa0898a8e3bd5cb3bc00d0c9ddf","comments_url":"https://api.github.com/repos/openai/codex/commits/d7ba5ff9553a6aa0898a8e3bd5cb3bc00d0c9ddf/comments","author":{"login":"shijie-oai","id":235382242,"node_id":"U_kgDODgel4g","avatar_url":"https://avatars.githubusercontent.com/u/235382242?v=4","gravatar_id":"","url":"https://api.github.com/users/shijie-oai","html_url":"https://github.com/shijie-oai","followers_url":"https://api.github.com/users/shijie-oai/followers","following_url":"https://api.github.com/users/shijie-oai/following{/other_user}","gists_url":"https://api.github.com/users/shijie-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/shijie-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shijie-oai/subscriptions","organizations_url":"https://api.github.com/users/shijie-oai/orgs","repos_url":"https://api.github.com/users/shijie-oai/repos","events_url":"https://api.github.com/users/shijie-oai/events{/privacy}","received_events_url":"https://api.github.com/users/shijie-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"1c9f890c051dbd091f1827ecd0149d0f43001b5f","url":"https://api.github.com/repos/openai/codex/commits/1c9f890c051dbd091f1827ecd0149d0f43001b5f","html_url":"https://github.com/openai/codex/commit/1c9f890c051dbd091f1827ecd0149d0f43001b5f"}]},{"sha":"1c9f890c051dbd091f1827ecd0149d0f43001b5f","node_id":"C_kwDOOYsS4doAKDFjOWY4OTBjMDUxZGJkMDkxZjE4MjdlY2QwMTQ5ZDBmNDMwMDFiNWY","commit":{"author":{"name":"Dylan Hurd","email":"dylan.hurd@openai.com","date":"2026-07-14T06:34:16Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T06:39:42Z"},"message":"Expose exact per-response usage in raw app-server events (#32985)\n\n## Why\n\nClients that account for individual upstream Responses API calls need the exact\nusage for each completion rather than accumulated or estimated thread usage.\n\n## What changed\n\n- Add the opt-in `rawResponse/completed` app-server notification with the\n  `threadId`, `turnId`, `responseId`, and upstream `usage` payload.\n- Emit the transient event for normal turns and compaction requests when\n  `experimentalRawEvents` is enabled. The event is not persisted or replayed,\n  and `usage` is `null` when the upstream response omits it.\n- Export the notification in the app-server schemas and document its behavior.\n\n## Testing\n\n- Cover exact token breakdowns for turn and compaction completions.\n\nGitOrigin-RevId: 49040a060bf1784c1ff1dd62112efb4a778428c4","tree":{"sha":"84b594c29ebd93be15e6aadcbb9f0bf0f2d08944","url":"https://api.github.com/repos/openai/codex/git/trees/84b594c29ebd93be15e6aadcbb9f0bf0f2d08944"},"url":"https://api.github.com/repos/openai/codex/git/commits/1c9f890c051dbd091f1827ecd0149d0f43001b5f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/1c9f890c051dbd091f1827ecd0149d0f43001b5f","html_url":"https://github.com/openai/codex/commit/1c9f890c051dbd091f1827ecd0149d0f43001b5f","comments_url":"https://api.github.com/repos/openai/codex/commits/1c9f890c051dbd091f1827ecd0149d0f43001b5f/comments","author":{"login":"dylan-hurd-oai","id":220976066,"node_id":"U_kgDODSvTwg","avatar_url":"https://avatars.githubusercontent.com/u/220976066?v=4","gravatar_id":"","url":"https://api.github.com/users/dylan-hurd-oai","html_url":"https://github.com/dylan-hurd-oai","followers_url":"https://api.github.com/users/dylan-hurd-oai/followers","following_url":"https://api.github.com/users/dylan-hurd-oai/following{/other_user}","gists_url":"https://api.github.com/users/dylan-hurd-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/dylan-hurd-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dylan-hurd-oai/subscriptions","organizations_url":"https://api.github.com/users/dylan-hurd-oai/orgs","repos_url":"https://api.github.com/users/dylan-hurd-oai/repos","events_url":"https://api.github.com/users/dylan-hurd-oai/events{/privacy}","received_events_url":"https://api.github.com/users/dylan-hurd-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"393f64565ab46f09d99ca4d9bd973537e72a114b","url":"https://api.github.com/repos/openai/codex/commits/393f64565ab46f09d99ca4d9bd973537e72a114b","html_url":"https://github.com/openai/codex/commit/393f64565ab46f09d99ca4d9bd973537e72a114b"}]},{"sha":"393f64565ab46f09d99ca4d9bd973537e72a114b","node_id":"C_kwDOOYsS4doAKDM5M2Y2NDU2NWFiNDZmMDlkOTljYTRkOWJkOTczNTM3ZTcyYTExNGI","commit":{"author":{"name":"pakrym-oai","email":"pakrym@openai.com","date":"2026-07-14T04:36:19Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T04:41:08Z"},"message":"Scope runtime workspace roots to execution environments (#32952)\n\n## Why\n\nMulti-environment turns can run against different filesystems, so a single\nthread-wide workspace-root list cannot accurately describe every selected\nenvironment.\n\n## What changed\n\n- Add optional `runtimeWorkspaceRoots` to each app-server environment selection.\n  Omitted roots default to that environment's `cwd`, while an empty list selects\n  no roots.\n- Carry environment-native roots through turn selection, model-visible context,\n  permission materialization, and tool sandboxing.\n- Keep the top-level `runtimeWorkspaceRoots` field as a compatibility input when\n  constructing default environment selections; explicit selections use their\n  own roots.\n\n## Testing\n\n- Cover thread and turn API defaults, overrides, empty roots, and schema\n  round-tripping.\n- Verify foreign roots remain model-visible and remote execution applies the\n  target environment's roots before sandbox selection.\n\nGitOrigin-RevId: c6e7a62883c45c676c153055f46a55ee15a323a4","tree":{"sha":"4df157c0fa4753403dced1eb98ecbea886859a05","url":"https://api.github.com/repos/openai/codex/git/trees/4df157c0fa4753403dced1eb98ecbea886859a05"},"url":"https://api.github.com/repos/openai/codex/git/commits/393f64565ab46f09d99ca4d9bd973537e72a114b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/393f64565ab46f09d99ca4d9bd973537e72a114b","html_url":"https://github.com/openai/codex/commit/393f64565ab46f09d99ca4d9bd973537e72a114b","comments_url":"https://api.github.com/repos/openai/codex/commits/393f64565ab46f09d99ca4d9bd973537e72a114b/comments","author":{"login":"pakrym-oai","id":204937752,"node_id":"U_kgDODDcaGA","avatar_url":"https://avatars.githubusercontent.com/u/204937752?v=4","gravatar_id":"","url":"https://api.github.com/users/pakrym-oai","html_url":"https://github.com/pakrym-oai","followers_url":"https://api.github.com/users/pakrym-oai/followers","following_url":"https://api.github.com/users/pakrym-oai/following{/other_user}","gists_url":"https://api.github.com/users/pakrym-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/pakrym-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pakrym-oai/subscriptions","organizations_url":"https://api.github.com/users/pakrym-oai/orgs","repos_url":"https://api.github.com/users/pakrym-oai/repos","events_url":"https://api.github.com/users/pakrym-oai/events{/privacy}","received_events_url":"https://api.github.com/users/pakrym-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"b019a5577c9a7daecd1d36b863890b96e385d4a2","url":"https://api.github.com/repos/openai/codex/commits/b019a5577c9a7daecd1d36b863890b96e385d4a2","html_url":"https://github.com/openai/codex/commit/b019a5577c9a7daecd1d36b863890b96e385d4a2"}]},{"sha":"b019a5577c9a7daecd1d36b863890b96e385d4a2","node_id":"C_kwDOOYsS4doAKGIwMTlhNTU3N2M5YTdkYWVjZDFkMzZiODYzODkwYjk2ZTM4NWQ0YTI","commit":{"author":{"name":"Matthew Zeng","email":"mzeng@openai.com","date":"2026-07-14T04:25:24Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T04:29:57Z"},"message":"Tighten recommended plugin install suggestions (#32949)\n\n## What changed\n\n- Limit `request_plugin_install` guidance to explicitly requested plugins after tool search has been exhausted.\n- Exclude adjacent capabilities, broad recommendations, and plugins that only seem potentially useful.\n- Clarify that `plugin_id` is the parenthesized ID from `<recommended_plugins>` and prohibit parallel tool calls.\n- Keep the recommendation context focused on listing available plugins while the tool specification owns the installation criteria.\n\n## Testing\n\n- Update tool specification tests to verify the stricter eligibility and serialization guidance.\n\nGitOrigin-RevId: 6ebfdd864a76316ab59a0624dc4d7d3abda39a98","tree":{"sha":"50fb056d6cf16c6d169882ea0d4e41c90cf4e70e","url":"https://api.github.com/repos/openai/codex/git/trees/50fb056d6cf16c6d169882ea0d4e41c90cf4e70e"},"url":"https://api.github.com/repos/openai/codex/git/commits/b019a5577c9a7daecd1d36b863890b96e385d4a2","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/b019a5577c9a7daecd1d36b863890b96e385d4a2","html_url":"https://github.com/openai/codex/commit/b019a5577c9a7daecd1d36b863890b96e385d4a2","comments_url":"https://api.github.com/repos/openai/codex/commits/b019a5577c9a7daecd1d36b863890b96e385d4a2/comments","author":{"login":"mzeng-openai","id":175741029,"node_id":"U_kgDOCnmYZQ","avatar_url":"https://avatars.githubusercontent.com/u/175741029?v=4","gravatar_id":"","url":"https://api.github.com/users/mzeng-openai","html_url":"https://github.com/mzeng-openai","followers_url":"https://api.github.com/users/mzeng-openai/followers","following_url":"https://api.github.com/users/mzeng-openai/following{/other_user}","gists_url":"https://api.github.com/users/mzeng-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/mzeng-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mzeng-openai/subscriptions","organizations_url":"https://api.github.com/users/mzeng-openai/orgs","repos_url":"https://api.github.com/users/mzeng-openai/repos","events_url":"https://api.github.com/users/mzeng-openai/events{/privacy}","received_events_url":"https://api.github.com/users/mzeng-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"0d78fa8846b449558b7906dc052982fd71ecff97","url":"https://api.github.com/repos/openai/codex/commits/0d78fa8846b449558b7906dc052982fd71ecff97","html_url":"https://github.com/openai/codex/commit/0d78fa8846b449558b7906dc052982fd71ecff97"}]},{"sha":"0d78fa8846b449558b7906dc052982fd71ecff97","node_id":"C_kwDOOYsS4doAKDBkNzhmYTg4NDZiNDQ5NTU4Yjc5MDZkYzA1Mjk4MmZkNzFlY2ZmOTc","commit":{"author":{"name":"Won Park","email":"won@openai.com","date":"2026-07-14T04:07:13Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T04:15:19Z"},"message":"Restrict Guardian reviewer tools (#32945)\n\n## What changed\n\n- Limit Guardian reviewer sessions with an environment to `exec_command`,\n  `write_stdin`, and `view_image`.\n- Exclude general tool sources from Guardian reviewer tool planning.\n\n## Testing\n\n- Extend the Guardian request snapshot test to assert the exact model-visible\n  tool list.\n\nGitOrigin-RevId: 80ba7011c23c32d163aaad906087fac396cc70fa","tree":{"sha":"e92b64b2e6d74f814f5af43aa09f0075caf3cc42","url":"https://api.github.com/repos/openai/codex/git/trees/e92b64b2e6d74f814f5af43aa09f0075caf3cc42"},"url":"https://api.github.com/repos/openai/codex/git/commits/0d78fa8846b449558b7906dc052982fd71ecff97","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/0d78fa8846b449558b7906dc052982fd71ecff97","html_url":"https://github.com/openai/codex/commit/0d78fa8846b449558b7906dc052982fd71ecff97","comments_url":"https://api.github.com/repos/openai/codex/commits/0d78fa8846b449558b7906dc052982fd71ecff97/comments","author":{"login":"won-openai","id":262224683,"node_id":"U_kgDOD6E7Kw","avatar_url":"https://avatars.githubusercontent.com/u/262224683?v=4","gravatar_id":"","url":"https://api.github.com/users/won-openai","html_url":"https://github.com/won-openai","followers_url":"https://api.github.com/users/won-openai/followers","following_url":"https://api.github.com/users/won-openai/following{/other_user}","gists_url":"https://api.github.com/users/won-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/won-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/won-openai/subscriptions","organizations_url":"https://api.github.com/users/won-openai/orgs","repos_url":"https://api.github.com/users/won-openai/repos","events_url":"https://api.github.com/users/won-openai/events{/privacy}","received_events_url":"https://api.github.com/users/won-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"b24aa20107f365a1d0f06de9e0b28df5c516c7dd","url":"https://api.github.com/repos/openai/codex/commits/b24aa20107f365a1d0f06de9e0b28df5c516c7dd","html_url":"https://github.com/openai/codex/commit/b24aa20107f365a1d0f06de9e0b28df5c516c7dd"}]},{"sha":"b24aa20107f365a1d0f06de9e0b28df5c516c7dd","node_id":"C_kwDOOYsS4doAKGIyNGFhMjAxMDdmMzY1YTFkMGYwNmRlOWUwYjI4ZGY1YzUxNmM3ZGQ","commit":{"author":{"name":"Owen Lin","email":"owen@openai.com","date":"2026-07-14T02:18:16Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T02:22:57Z"},"message":"Resume thread history projection from its SQLite checkpoint (#32928)\n\n## Why\n\nThread history JSONL is the durable source of truth, while SQLite is a rebuildable view. If a SQLite projection fails after a durable append, the next write must catch up the unprojected suffix instead of skipping it.\n\n## What changed\n\n- Start materialization at the byte offset stored in `thread_history_projection_state`.\n- Project only complete newline-terminated rollout records, leaving a trailing partial record for a later pass.\n- Preserve validation for missing files, invalid offsets, and missing or out-of-order ordinals without advancing projection state.\n\n## Testing\n\nAdd coverage for catching up after projection failure, avoiding replay when already synchronized, retaining partial lines, and rejecting invalid suffixes without changing SQLite state.\n\nGitOrigin-RevId: 8a7200a77edd5411ddf5fe31ab6af5ee287ed7d7","tree":{"sha":"349a0e3f1108107ae33b7bdf19cc0c928bd337ca","url":"https://api.github.com/repos/openai/codex/git/trees/349a0e3f1108107ae33b7bdf19cc0c928bd337ca"},"url":"https://api.github.com/repos/openai/codex/git/commits/b24aa20107f365a1d0f06de9e0b28df5c516c7dd","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/b24aa20107f365a1d0f06de9e0b28df5c516c7dd","html_url":"https://github.com/openai/codex/commit/b24aa20107f365a1d0f06de9e0b28df5c516c7dd","comments_url":"https://api.github.com/repos/openai/codex/commits/b24aa20107f365a1d0f06de9e0b28df5c516c7dd/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"0ef9fa4d65c0283254c86a886adece18c77e51b7","url":"https://api.github.com/repos/openai/codex/commits/0ef9fa4d65c0283254c86a886adece18c77e51b7","html_url":"https://github.com/openai/codex/commit/0ef9fa4d65c0283254c86a886adece18c77e51b7"}]},{"sha":"0ef9fa4d65c0283254c86a886adece18c77e51b7","node_id":"C_kwDOOYsS4doAKDBlZjlmYTRkNjVjMDI4MzI1NGM4NmE4ODZhZGVjZTE4Yzc3ZTUxYjc","commit":{"author":{"name":"Owen Lin","email":"owen@openai.com","date":"2026-07-14T01:55:59Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T02:00:39Z"},"message":"Materialize paginated thread history in SQLite (#32923)\n\n## What changed\n\n- Project durable paginated rollout records into rebuildable SQLite tables for turns, items, and projection progress while keeping JSONL as the source of truth.\n- Add cursor-based local reads for turn summaries and thread or per-turn items, including archived-thread and history-mode validation.\n- Serialize writes, shutdown, and deletion per thread so projection updates cannot race cleanup, and remove projected rows when a thread is deleted.\n- Preserve stable item ordering while updating repeated snapshots and expose structured turn error details.\n\n## Testing\n\n- Cover projection, snapshot updates, summary recovery, pagination, failure handling, shutdown flushing, legacy-mode rejection, and deletion races.\n\nGitOrigin-RevId: 34533185ece7f1f5690004c7f12b0f1f34dc2640","tree":{"sha":"634d121b299fbc050d979f63572b7f084eb3018d","url":"https://api.github.com/repos/openai/codex/git/trees/634d121b299fbc050d979f63572b7f084eb3018d"},"url":"https://api.github.com/repos/openai/codex/git/commits/0ef9fa4d65c0283254c86a886adece18c77e51b7","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/0ef9fa4d65c0283254c86a886adece18c77e51b7","html_url":"https://github.com/openai/codex/commit/0ef9fa4d65c0283254c86a886adece18c77e51b7","comments_url":"https://api.github.com/repos/openai/codex/commits/0ef9fa4d65c0283254c86a886adece18c77e51b7/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"f96cf4d1c3200c0316ef3d7cdcfbc3ce94eb824b","url":"https://api.github.com/repos/openai/codex/commits/f96cf4d1c3200c0316ef3d7cdcfbc3ce94eb824b","html_url":"https://github.com/openai/codex/commit/f96cf4d1c3200c0316ef3d7cdcfbc3ce94eb824b"}]},{"sha":"f96cf4d1c3200c0316ef3d7cdcfbc3ce94eb824b","node_id":"C_kwDOOYsS4doAKGY5NmNmNGQxYzMyMDBjMDMxNmVmM2Q3Y2RjZmJjM2NlOTRlYjgyNGI","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-07-14T01:43:50Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T01:49:16Z"},"message":"Expose environment status through app-server (#32920)\n\n## What changed\n\n- Add the experimental `environment/status` request for inspecting a configured environment without starting or reconnecting it.\n- Report `ready`, `pending`, `disconnected`, or `unknown`, including error details for disconnected and unknown environments.\n- Probe ready remote environments over their existing exec-server connection.\n\n## Testing\n\n- Add an app-server integration test covering local and remote ready, pending, disconnected, and unknown environments.\n\nGitOrigin-RevId: 397bba603aa9e0b59008ee6cb7cbde46e357652c","tree":{"sha":"95994f809bc9a3eb8e98d687b525c033bfea708b","url":"https://api.github.com/repos/openai/codex/git/trees/95994f809bc9a3eb8e98d687b525c033bfea708b"},"url":"https://api.github.com/repos/openai/codex/git/commits/f96cf4d1c3200c0316ef3d7cdcfbc3ce94eb824b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/f96cf4d1c3200c0316ef3d7cdcfbc3ce94eb824b","html_url":"https://github.com/openai/codex/commit/f96cf4d1c3200c0316ef3d7cdcfbc3ce94eb824b","comments_url":"https://api.github.com/repos/openai/codex/commits/f96cf4d1c3200c0316ef3d7cdcfbc3ce94eb824b/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"80c6cd3014e4236e99bd06e67f31fcb95c9ee906","url":"https://api.github.com/repos/openai/codex/commits/80c6cd3014e4236e99bd06e67f31fcb95c9ee906","html_url":"https://github.com/openai/codex/commit/80c6cd3014e4236e99bd06e67f31fcb95c9ee906"}]},{"sha":"80c6cd3014e4236e99bd06e67f31fcb95c9ee906","node_id":"C_kwDOOYsS4doAKDgwYzZjZDMwMTRlNDIzNmU5OWJkMDZlNjdmMzFmY2I5NWM5ZWU5MDY","commit":{"author":{"name":"richardopenai","email":"richardlee@openai.com","date":"2026-07-14T01:01:37Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T01:06:11Z"},"message":"Allow injecting the models manager into `ThreadManager` (#32911)\n\n## Why\n\nEmbedding callers need to control whether model catalogs are persisted to disk.\n\n## What changed\n\n- Accept a shared models manager when constructing `ThreadManager` instead of always creating a cached manager internally.\n- Add provider APIs for creating uncached model managers. OpenAI-compatible providers fetch on each `OnlineIfUncached` refresh without reading or writing `models_cache.json`.\n- Keep existing app server, MCP server, sample, and test callers on the standard cached manager.\n\n## Testing\n\n- Verify an uncached manager fetches on every refresh.\n- Verify an injected uncached manager controls thread refresh behavior and does not create `models_cache.json`.\n\nGitOrigin-RevId: 8bb646054ecec4ccb865b2bf56249384916ea9db","tree":{"sha":"d6f6f0f60c3714d47462de49376ad8f4c7e4befb","url":"https://api.github.com/repos/openai/codex/git/trees/d6f6f0f60c3714d47462de49376ad8f4c7e4befb"},"url":"https://api.github.com/repos/openai/codex/git/commits/80c6cd3014e4236e99bd06e67f31fcb95c9ee906","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/80c6cd3014e4236e99bd06e67f31fcb95c9ee906","html_url":"https://github.com/openai/codex/commit/80c6cd3014e4236e99bd06e67f31fcb95c9ee906","comments_url":"https://api.github.com/repos/openai/codex/commits/80c6cd3014e4236e99bd06e67f31fcb95c9ee906/comments","author":{"login":"richardopenai","id":272641442,"node_id":"U_kgDOEEAtog","avatar_url":"https://avatars.githubusercontent.com/u/272641442?v=4","gravatar_id":"","url":"https://api.github.com/users/richardopenai","html_url":"https://github.com/richardopenai","followers_url":"https://api.github.com/users/richardopenai/followers","following_url":"https://api.github.com/users/richardopenai/following{/other_user}","gists_url":"https://api.github.com/users/richardopenai/gists{/gist_id}","starred_url":"https://api.github.com/users/richardopenai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/richardopenai/subscriptions","organizations_url":"https://api.github.com/users/richardopenai/orgs","repos_url":"https://api.github.com/users/richardopenai/repos","events_url":"https://api.github.com/users/richardopenai/events{/privacy}","received_events_url":"https://api.github.com/users/richardopenai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c39520f3d1522f2587694b52eba7d3eb39460137","url":"https://api.github.com/repos/openai/codex/commits/c39520f3d1522f2587694b52eba7d3eb39460137","html_url":"https://github.com/openai/codex/commit/c39520f3d1522f2587694b52eba7d3eb39460137"}]},{"sha":"c39520f3d1522f2587694b52eba7d3eb39460137","node_id":"C_kwDOOYsS4doAKGMzOTUyMGYzZDE1MjJmMjU4NzY5NGI1MmViYTdkM2ViMzk0NjAxMzc","commit":{"author":{"name":"Owen Lin","email":"owen@openai.com","date":"2026-07-14T00:33:11Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T00:38:04Z"},"message":"Timestamp app-server notifications at emission (#32905)\n\n## What changed\n\n- Add an optional `emittedAtMs` field to server notification envelopes and expose the envelope in the generated JSON and TypeScript schemas.\n- Populate the Unix timestamp when app-server emits a notification, before transport routing, so every connection in a fan-out receives the same value.\n- Keep the field optional for clients decoding notifications from older app-server versions.\n\n## Testing\n\n- Verify notification serialization includes `emittedAtMs`.\n- Verify targeted fan-out reuses one timestamp across connections.\n\nGitOrigin-RevId: b379cb11e8e91c558bcd3d46ce459311a6e81e54","tree":{"sha":"9aae68742700162cbbd3face30908d5b97d707bf","url":"https://api.github.com/repos/openai/codex/git/trees/9aae68742700162cbbd3face30908d5b97d707bf"},"url":"https://api.github.com/repos/openai/codex/git/commits/c39520f3d1522f2587694b52eba7d3eb39460137","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c39520f3d1522f2587694b52eba7d3eb39460137","html_url":"https://github.com/openai/codex/commit/c39520f3d1522f2587694b52eba7d3eb39460137","comments_url":"https://api.github.com/repos/openai/codex/commits/c39520f3d1522f2587694b52eba7d3eb39460137/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"7f3eb8a2233aceba3e7962123da84379ee305bb2","url":"https://api.github.com/repos/openai/codex/commits/7f3eb8a2233aceba3e7962123da84379ee305bb2","html_url":"https://github.com/openai/codex/commit/7f3eb8a2233aceba3e7962123da84379ee305bb2"}]},{"sha":"7f3eb8a2233aceba3e7962123da84379ee305bb2","node_id":"C_kwDOOYsS4doAKDdmM2ViOGEyMjMzYWNlYmEzZTc5NjIxMjNkYTg0Mzc5ZWUzMDViYjI","commit":{"author":{"name":"marksteinbrick-oai","email":"mark.steinbrick@openai.com","date":"2026-07-14T00:14:21Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-14T00:19:01Z"},"message":"Include session IDs in tool item analytics events (#32903)\n\n## What changed\n\n- Add `session_id` to the shared tool item event payload, sourced from the\n  thread metadata.\n- Preserve the parent session ID on tool events emitted by subagent threads.\n\n## Testing\n\n- Cover serialization of the session ID for command execution events,\n  subagent tool events, and every supported completed tool item type.\n\nGitOrigin-RevId: 73afc0e1be1ddec4fb5a42f43a23f1e87360e68f","tree":{"sha":"b3d413c8db75a4031caa756b186602688a56775c","url":"https://api.github.com/repos/openai/codex/git/trees/b3d413c8db75a4031caa756b186602688a56775c"},"url":"https://api.github.com/repos/openai/codex/git/commits/7f3eb8a2233aceba3e7962123da84379ee305bb2","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/7f3eb8a2233aceba3e7962123da84379ee305bb2","html_url":"https://github.com/openai/codex/commit/7f3eb8a2233aceba3e7962123da84379ee305bb2","comments_url":"https://api.github.com/repos/openai/codex/commits/7f3eb8a2233aceba3e7962123da84379ee305bb2/comments","author":{"login":"marksteinbrick-oai","id":219906558,"node_id":"U_kgDODRuB_g","avatar_url":"https://avatars.githubusercontent.com/u/219906558?v=4","gravatar_id":"","url":"https://api.github.com/users/marksteinbrick-oai","html_url":"https://github.com/marksteinbrick-oai","followers_url":"https://api.github.com/users/marksteinbrick-oai/followers","following_url":"https://api.github.com/users/marksteinbrick-oai/following{/other_user}","gists_url":"https://api.github.com/users/marksteinbrick-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/marksteinbrick-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/marksteinbrick-oai/subscriptions","organizations_url":"https://api.github.com/users/marksteinbrick-oai/orgs","repos_url":"https://api.github.com/users/marksteinbrick-oai/repos","events_url":"https://api.github.com/users/marksteinbrick-oai/events{/privacy}","received_events_url":"https://api.github.com/users/marksteinbrick-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4657ab06c6f12bcbdda243d90ffe36514292548e","url":"https://api.github.com/repos/openai/codex/commits/4657ab06c6f12bcbdda243d90ffe36514292548e","html_url":"https://github.com/openai/codex/commit/4657ab06c6f12bcbdda243d90ffe36514292548e"}]},{"sha":"4657ab06c6f12bcbdda243d90ffe36514292548e","node_id":"C_kwDOOYsS4doAKDQ2NTdhYjA2YzZmMTJiY2JkZGEyNDNkOTBmZmUzNjUxNDI5MjU0OGU","commit":{"author":{"name":"Ahmed Ibrahim","email":"aibrahim@openai.com","date":"2026-07-13T23:44:06Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T23:48:42Z"},"message":"Derive collaboration settings from turn context (#32900)\n\n## Why\n\n`TurnContext` stored model and reasoning settings both as resolved turn fields and inside `CollaborationMode`, requiring the copies to stay synchronized when the model changed.\n\n## What changed\n\n- Store the mode and collaboration-mode developer instructions directly on `TurnContext`.\n- Reconstruct `CollaborationMode` from those values plus the turn's current model and reasoning effort when callers need it.\n- Read the mode directly for plan-mode checks, lifecycle events, and telemetry.\n\nGitOrigin-RevId: b8fccafdd5d5cbccc84bc70d542588087ddf0093","tree":{"sha":"628410e1c23d87d99f9f5e2485e58ffed146156a","url":"https://api.github.com/repos/openai/codex/git/trees/628410e1c23d87d99f9f5e2485e58ffed146156a"},"url":"https://api.github.com/repos/openai/codex/git/commits/4657ab06c6f12bcbdda243d90ffe36514292548e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4657ab06c6f12bcbdda243d90ffe36514292548e","html_url":"https://github.com/openai/codex/commit/4657ab06c6f12bcbdda243d90ffe36514292548e","comments_url":"https://api.github.com/repos/openai/codex/commits/4657ab06c6f12bcbdda243d90ffe36514292548e/comments","author":{"login":"aibrahim-oai","id":219906144,"node_id":"U_kgDODRuAYA","avatar_url":"https://avatars.githubusercontent.com/u/219906144?v=4","gravatar_id":"","url":"https://api.github.com/users/aibrahim-oai","html_url":"https://github.com/aibrahim-oai","followers_url":"https://api.github.com/users/aibrahim-oai/followers","following_url":"https://api.github.com/users/aibrahim-oai/following{/other_user}","gists_url":"https://api.github.com/users/aibrahim-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/aibrahim-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aibrahim-oai/subscriptions","organizations_url":"https://api.github.com/users/aibrahim-oai/orgs","repos_url":"https://api.github.com/users/aibrahim-oai/repos","events_url":"https://api.github.com/users/aibrahim-oai/events{/privacy}","received_events_url":"https://api.github.com/users/aibrahim-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"75470c3e2f5f081698cc02d56649a62fc17cfb4f","url":"https://api.github.com/repos/openai/codex/commits/75470c3e2f5f081698cc02d56649a62fc17cfb4f","html_url":"https://github.com/openai/codex/commit/75470c3e2f5f081698cc02d56649a62fc17cfb4f"}]},{"sha":"75470c3e2f5f081698cc02d56649a62fc17cfb4f","node_id":"C_kwDOOYsS4doAKDc1NDcwYzNlMmY1ZjA4MTY5OGNjMDJkNTY2NDlhNjJmYzE3Y2ZiNGY","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-07-13T23:38:22Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T23:43:15Z"},"message":"Add exec-server environment status checks (#32899)\n\n## What changed\n\n- Add the initialized `environment/status` RPC, which reports `ready` when the exec server can handle requests.\n- Expose environment IDs and `ready`, `pending`, or `disconnected` status through `EnvironmentManager` and `Environment`.\n- Keep status checks non-mutating: they do not start or recover lazy remote environments, and probe only an existing connection.\n\n## Testing\n\n- Cover the status RPC over WebSocket and the in-process request processor.\n- Verify that checking an unstarted stdio environment leaves it pending and that failed connections report as disconnected.\n\nGitOrigin-RevId: 22febeb6a3457849292128a8991c6400c22b3fd8","tree":{"sha":"f7c9108513a2f346537a157ded6a1d7355440020","url":"https://api.github.com/repos/openai/codex/git/trees/f7c9108513a2f346537a157ded6a1d7355440020"},"url":"https://api.github.com/repos/openai/codex/git/commits/75470c3e2f5f081698cc02d56649a62fc17cfb4f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/75470c3e2f5f081698cc02d56649a62fc17cfb4f","html_url":"https://github.com/openai/codex/commit/75470c3e2f5f081698cc02d56649a62fc17cfb4f","comments_url":"https://api.github.com/repos/openai/codex/commits/75470c3e2f5f081698cc02d56649a62fc17cfb4f/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"2ca20d522451adf0340403fc15cd54d4926f14b0","url":"https://api.github.com/repos/openai/codex/commits/2ca20d522451adf0340403fc15cd54d4926f14b0","html_url":"https://github.com/openai/codex/commit/2ca20d522451adf0340403fc15cd54d4926f14b0"}]},{"sha":"2ca20d522451adf0340403fc15cd54d4926f14b0","node_id":"C_kwDOOYsS4doAKDJjYTIwZDUyMjQ1MWFkZjAzNDA0MDNmYzE1Y2Q1NGQ0OTI2ZjE0YjA","commit":{"author":{"name":"briansong-oai","email":"briansong@openai.com","date":"2026-07-13T23:30:44Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T23:37:35Z"},"message":"Expose structured standalone web search results (#32898)\n\n## Why\n\nStandalone web search can return structured result DTOs separately from its\nmodel-facing text output. App-server clients need access to that data without\ncoupling Codex to every result type or field.\n\n## What changed\n\n- Preserve the optional `results` array from `/v1/alpha/search` as opaque JSON\n  through web-search completion events, thread history, and app-server\n  `webSearch` items.\n- Keep responses from older endpoints compatible when `results` is absent, and\n  allow clients to ignore result types and fields they do not understand.\n- Regenerate the protocol schemas and TypeScript definitions for the optional\n  field.\n\n## Testing\n\n- Cover responses with missing, empty, and forward-compatible result payloads.\n- Verify standalone web-search results round-trip through app-server item\n  notifications and thread-item conversion.\n\nGitOrigin-RevId: 739ef5694ece5733f7b8749ec41d6bfa3f33c8c5","tree":{"sha":"afc34837aa4a6fe7b4b64c5dbece9307ffc5db30","url":"https://api.github.com/repos/openai/codex/git/trees/afc34837aa4a6fe7b4b64c5dbece9307ffc5db30"},"url":"https://api.github.com/repos/openai/codex/git/commits/2ca20d522451adf0340403fc15cd54d4926f14b0","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/2ca20d522451adf0340403fc15cd54d4926f14b0","html_url":"https://github.com/openai/codex/commit/2ca20d522451adf0340403fc15cd54d4926f14b0","comments_url":"https://api.github.com/repos/openai/codex/commits/2ca20d522451adf0340403fc15cd54d4926f14b0/comments","author":{"login":"briansong-oai","id":234057688,"node_id":"U_kgDODfNv2A","avatar_url":"https://avatars.githubusercontent.com/u/234057688?v=4","gravatar_id":"","url":"https://api.github.com/users/briansong-oai","html_url":"https://github.com/briansong-oai","followers_url":"https://api.github.com/users/briansong-oai/followers","following_url":"https://api.github.com/users/briansong-oai/following{/other_user}","gists_url":"https://api.github.com/users/briansong-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/briansong-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/briansong-oai/subscriptions","organizations_url":"https://api.github.com/users/briansong-oai/orgs","repos_url":"https://api.github.com/users/briansong-oai/repos","events_url":"https://api.github.com/users/briansong-oai/events{/privacy}","received_events_url":"https://api.github.com/users/briansong-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"090f4de37b9d137bab2a089f06443a158cf5adab","url":"https://api.github.com/repos/openai/codex/commits/090f4de37b9d137bab2a089f06443a158cf5adab","html_url":"https://github.com/openai/codex/commit/090f4de37b9d137bab2a089f06443a158cf5adab"}]},{"sha":"090f4de37b9d137bab2a089f06443a158cf5adab","node_id":"C_kwDOOYsS4doAKDA5MGY0ZGUzN2I5ZDEzN2JhYjJhMDg5ZjA2NDQzYTE1OGNmNWFkYWI","commit":{"author":{"name":"Dylan Hurd","email":"dylan.hurd@openai.com","date":"2026-07-13T23:24:11Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T23:33:58Z"},"message":"Route blocked network requests to their owning calls (#32897)\n\n## Why\n\nPolicy-blocked proxy requests must terminate the corresponding active tool call and preserve the correct approval result, including when multiple calls are running concurrently.\n\n## What changed\n\n- Resolve a blocked request's execution ID to its registered active network call before recording the policy denial.\n- Preserve an outcome already recorded for that call, and cancel the owning call after storing a new denial.\n\n## Testing\n\nExpand network approval integration coverage for Guardian and user decisions, permission hooks, persisted policy amendments, concurrent calls, timeouts, cancellations, and unattributed proxy requests.\n\nGitOrigin-RevId: 961901bbc07cc498309453ec78cda1a56ab00a4b","tree":{"sha":"b23910a36415597f75e8b01d8a10918ea2d2ecb7","url":"https://api.github.com/repos/openai/codex/git/trees/b23910a36415597f75e8b01d8a10918ea2d2ecb7"},"url":"https://api.github.com/repos/openai/codex/git/commits/090f4de37b9d137bab2a089f06443a158cf5adab","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/090f4de37b9d137bab2a089f06443a158cf5adab","html_url":"https://github.com/openai/codex/commit/090f4de37b9d137bab2a089f06443a158cf5adab","comments_url":"https://api.github.com/repos/openai/codex/commits/090f4de37b9d137bab2a089f06443a158cf5adab/comments","author":{"login":"dylan-hurd-oai","id":220976066,"node_id":"U_kgDODSvTwg","avatar_url":"https://avatars.githubusercontent.com/u/220976066?v=4","gravatar_id":"","url":"https://api.github.com/users/dylan-hurd-oai","html_url":"https://github.com/dylan-hurd-oai","followers_url":"https://api.github.com/users/dylan-hurd-oai/followers","following_url":"https://api.github.com/users/dylan-hurd-oai/following{/other_user}","gists_url":"https://api.github.com/users/dylan-hurd-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/dylan-hurd-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dylan-hurd-oai/subscriptions","organizations_url":"https://api.github.com/users/dylan-hurd-oai/orgs","repos_url":"https://api.github.com/users/dylan-hurd-oai/repos","events_url":"https://api.github.com/users/dylan-hurd-oai/events{/privacy}","received_events_url":"https://api.github.com/users/dylan-hurd-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"592467fb962878e598b47f575ca19414d865561b","url":"https://api.github.com/repos/openai/codex/commits/592467fb962878e598b47f575ca19414d865561b","html_url":"https://github.com/openai/codex/commit/592467fb962878e598b47f575ca19414d865561b"}]},{"sha":"592467fb962878e598b47f575ca19414d865561b","node_id":"C_kwDOOYsS4doAKDU5MjQ2N2ZiOTYyODc4ZTU5OGI0N2Y1NzVjYTE5NDE0ZDg2NTU2MWI","commit":{"author":{"name":"Owen Lin","email":"owen@openai.com","date":"2026-07-13T23:13:21Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T23:29:59Z"},"message":"Load model context from a bounded rollout suffix (#32896)\n\n## Why\n\nReconstructing the latest model-visible context does not require replaying an\nentire paginated rollout when a usable compaction checkpoint and the associated\ncompleted-turn metadata are available.\n\n## What changed\n\n- Add `ThreadStore::load_latest_model_context` and `StoredModelContext` for\n  loading replay-ready model context independently of full thread history.\n- Reverse-scan plain paginated JSONL rollouts until the newest safe bounded\n  suffix is found, while preserving canonical session metadata and chronological\n  replay order.\n- Fall back to complete history for legacy or compressed rollouts and whenever\n  compaction or rollback records make a bounded cutoff unsafe.\n\n## Testing\n\n- Cover checkpoint selection, turn-metadata boundaries, agent messages,\n  contextual user fragments, and full-history fallbacks.\n\nGitOrigin-RevId: 3572f4ecc7aa4099a6d9f0d3e72d0ef432cd9497","tree":{"sha":"5829c35922da4eecf4f035c4e4912f9c537dfd34","url":"https://api.github.com/repos/openai/codex/git/trees/5829c35922da4eecf4f035c4e4912f9c537dfd34"},"url":"https://api.github.com/repos/openai/codex/git/commits/592467fb962878e598b47f575ca19414d865561b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/592467fb962878e598b47f575ca19414d865561b","html_url":"https://github.com/openai/codex/commit/592467fb962878e598b47f575ca19414d865561b","comments_url":"https://api.github.com/repos/openai/codex/commits/592467fb962878e598b47f575ca19414d865561b/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"7fdf2f254b2250a68f36cdccdf51374da604b3d4","url":"https://api.github.com/repos/openai/codex/commits/7fdf2f254b2250a68f36cdccdf51374da604b3d4","html_url":"https://github.com/openai/codex/commit/7fdf2f254b2250a68f36cdccdf51374da604b3d4"}]},{"sha":"7fdf2f254b2250a68f36cdccdf51374da604b3d4","node_id":"C_kwDOOYsS4doAKDdmZGYyZjI1NGIyMjUwYTY4ZjM2Y2RjY2RmNTEzNzRkYTYwNGIzZDQ","commit":{"author":{"name":"Matthew Zeng","email":"mzeng@openai.com","date":"2026-07-13T23:13:08Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T23:17:38Z"},"message":"Serialize plugin install requests (#32894)\n\n## What changed\n\n- Mark `request_plugin_install` as not supporting parallel tool calls so install requests execute serially.\n- Add a unit test covering the handler's parallel-call capability.\n\nGitOrigin-RevId: 5f2c8184562bd776b0e527e5e258c61c604a0910","tree":{"sha":"6c2fd692bd17bea32d39728bf9cff987c836b7f1","url":"https://api.github.com/repos/openai/codex/git/trees/6c2fd692bd17bea32d39728bf9cff987c836b7f1"},"url":"https://api.github.com/repos/openai/codex/git/commits/7fdf2f254b2250a68f36cdccdf51374da604b3d4","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/7fdf2f254b2250a68f36cdccdf51374da604b3d4","html_url":"https://github.com/openai/codex/commit/7fdf2f254b2250a68f36cdccdf51374da604b3d4","comments_url":"https://api.github.com/repos/openai/codex/commits/7fdf2f254b2250a68f36cdccdf51374da604b3d4/comments","author":{"login":"mzeng-openai","id":175741029,"node_id":"U_kgDOCnmYZQ","avatar_url":"https://avatars.githubusercontent.com/u/175741029?v=4","gravatar_id":"","url":"https://api.github.com/users/mzeng-openai","html_url":"https://github.com/mzeng-openai","followers_url":"https://api.github.com/users/mzeng-openai/followers","following_url":"https://api.github.com/users/mzeng-openai/following{/other_user}","gists_url":"https://api.github.com/users/mzeng-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/mzeng-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mzeng-openai/subscriptions","organizations_url":"https://api.github.com/users/mzeng-openai/orgs","repos_url":"https://api.github.com/users/mzeng-openai/repos","events_url":"https://api.github.com/users/mzeng-openai/events{/privacy}","received_events_url":"https://api.github.com/users/mzeng-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fb350d1e7d52c4c3b42f230a4715ee4adf314f08","url":"https://api.github.com/repos/openai/codex/commits/fb350d1e7d52c4c3b42f230a4715ee4adf314f08","html_url":"https://github.com/openai/codex/commit/fb350d1e7d52c4c3b42f230a4715ee4adf314f08"}]},{"sha":"fb350d1e7d52c4c3b42f230a4715ee4adf314f08","node_id":"C_kwDOOYsS4doAKGZiMzUwZDFlN2Q1MmM0YzNiNDJmMjMwYTQ3MTVlZTRhZGYzMTRmMDg","commit":{"author":{"name":"stevenlee-oai","email":"stevenlee@openai.com","date":"2026-07-13T22:45:47Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T22:50:28Z"},"message":"Attach connector caches to diagnostic uploads (#32891)\n\n## What changed\n\n- Include the active Codex Apps tools cache and connector directory cache, when available, in diagnostic uploads that include logs.\n- Resolve cache paths from the current authentication context and use stable attachment filenames.\n- List both optional cache files in the upload consent dialog.\n\n## Testing\n\n- Add coverage for selecting existing active cache files, including a directory cache without an account ID.\n- Update consent dialog snapshots to include the optional attachments.\n\nGitOrigin-RevId: 1d4ffbf2bcb96653f03dc25f91d80dd65038d585","tree":{"sha":"c6c0e0435d4f3dc7d2f974a3d0d116e629864ef0","url":"https://api.github.com/repos/openai/codex/git/trees/c6c0e0435d4f3dc7d2f974a3d0d116e629864ef0"},"url":"https://api.github.com/repos/openai/codex/git/commits/fb350d1e7d52c4c3b42f230a4715ee4adf314f08","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fb350d1e7d52c4c3b42f230a4715ee4adf314f08","html_url":"https://github.com/openai/codex/commit/fb350d1e7d52c4c3b42f230a4715ee4adf314f08","comments_url":"https://api.github.com/repos/openai/codex/commits/fb350d1e7d52c4c3b42f230a4715ee4adf314f08/comments","author":{"login":"stevenlee-oai","id":213687449,"node_id":"U_kgDODLycmQ","avatar_url":"https://avatars.githubusercontent.com/u/213687449?v=4","gravatar_id":"","url":"https://api.github.com/users/stevenlee-oai","html_url":"https://github.com/stevenlee-oai","followers_url":"https://api.github.com/users/stevenlee-oai/followers","following_url":"https://api.github.com/users/stevenlee-oai/following{/other_user}","gists_url":"https://api.github.com/users/stevenlee-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/stevenlee-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stevenlee-oai/subscriptions","organizations_url":"https://api.github.com/users/stevenlee-oai/orgs","repos_url":"https://api.github.com/users/stevenlee-oai/repos","events_url":"https://api.github.com/users/stevenlee-oai/events{/privacy}","received_events_url":"https://api.github.com/users/stevenlee-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"bb947e8e362ebc3751b474a7adf852a678b644b9","url":"https://api.github.com/repos/openai/codex/commits/bb947e8e362ebc3751b474a7adf852a678b644b9","html_url":"https://github.com/openai/codex/commit/bb947e8e362ebc3751b474a7adf852a678b644b9"}]},{"sha":"bb947e8e362ebc3751b474a7adf852a678b644b9","node_id":"C_kwDOOYsS4doAKGJiOTQ3ZThlMzYyZWJjMzc1MWI0NzRhN2FkZjg1MmE2NzhiNjQ0Yjk","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-13T22:29:51Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T22:34:16Z"},"message":"Tag shell tool telemetry by command category (#32887)\n\n## What changed\n\nAdd a `command_category` tag to tool result telemetry for `exec_command` and\n`shell_command` invocations. Classify parsed commands as `read`, `list_files`,\n`search`, or `unknown`; use `mixed` when a script contains multiple categories.\n\nGitOrigin-RevId: 1edacb38c7be9b03af4f2fc86746184f19067592","tree":{"sha":"a1e93b845a9cfed015c4f14df478686457309737","url":"https://api.github.com/repos/openai/codex/git/trees/a1e93b845a9cfed015c4f14df478686457309737"},"url":"https://api.github.com/repos/openai/codex/git/commits/bb947e8e362ebc3751b474a7adf852a678b644b9","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/bb947e8e362ebc3751b474a7adf852a678b644b9","html_url":"https://github.com/openai/codex/commit/bb947e8e362ebc3751b474a7adf852a678b644b9","comments_url":"https://api.github.com/repos/openai/codex/commits/bb947e8e362ebc3751b474a7adf852a678b644b9/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"bc8222b8d9e44377a3d7c7b7970e32e7c29ec34f","url":"https://api.github.com/repos/openai/codex/commits/bc8222b8d9e44377a3d7c7b7970e32e7c29ec34f","html_url":"https://github.com/openai/codex/commit/bc8222b8d9e44377a3d7c7b7970e32e7c29ec34f"}]},{"sha":"bc8222b8d9e44377a3d7c7b7970e32e7c29ec34f","node_id":"C_kwDOOYsS4doAKGJjODIyMmI4ZDllNDQzNzdhM2Q3YzdiNzk3MGUzMmU3YzI5ZWMzNGY","commit":{"author":{"name":"charlesgong-openai","email":"charlesgong@openai.com","date":"2026-07-13T22:11:07Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T22:15:55Z"},"message":"Prepare external agent migration for source adapters (#32884)\n\n## What changed\n\n- Add an optional `source` selector to `externalAgentConfig/detect`, while preserving the existing behavior for omitted, `null`, and unrecognized values.\n- Pass `claude-code` as the source for TUI detection and import requests.\n- Move source-specific migration behavior behind an adapter boundary and consolidate session migration into `codex-external-agent-migration`.\n\n## Testing\n\n- Cover explicit, omitted, and unknown detection source values with app-server protocol tests.\n- Add unit coverage for the extracted migration and hook helpers.\n\nGitOrigin-RevId: 63bd3dcb485f3ad7bd996022db4e351506aeea77","tree":{"sha":"cf144ef9a8c64ddcd6370e56752f6925203ada7d","url":"https://api.github.com/repos/openai/codex/git/trees/cf144ef9a8c64ddcd6370e56752f6925203ada7d"},"url":"https://api.github.com/repos/openai/codex/git/commits/bc8222b8d9e44377a3d7c7b7970e32e7c29ec34f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/bc8222b8d9e44377a3d7c7b7970e32e7c29ec34f","html_url":"https://github.com/openai/codex/commit/bc8222b8d9e44377a3d7c7b7970e32e7c29ec34f","comments_url":"https://api.github.com/repos/openai/codex/commits/bc8222b8d9e44377a3d7c7b7970e32e7c29ec34f/comments","author":{"login":"charlesgong-openai","id":200841148,"node_id":"U_kgDOC_iXvA","avatar_url":"https://avatars.githubusercontent.com/u/200841148?v=4","gravatar_id":"","url":"https://api.github.com/users/charlesgong-openai","html_url":"https://github.com/charlesgong-openai","followers_url":"https://api.github.com/users/charlesgong-openai/followers","following_url":"https://api.github.com/users/charlesgong-openai/following{/other_user}","gists_url":"https://api.github.com/users/charlesgong-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/charlesgong-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charlesgong-openai/subscriptions","organizations_url":"https://api.github.com/users/charlesgong-openai/orgs","repos_url":"https://api.github.com/users/charlesgong-openai/repos","events_url":"https://api.github.com/users/charlesgong-openai/events{/privacy}","received_events_url":"https://api.github.com/users/charlesgong-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"0877afbe855354c48194d5556de764a883917925","url":"https://api.github.com/repos/openai/codex/commits/0877afbe855354c48194d5556de764a883917925","html_url":"https://github.com/openai/codex/commit/0877afbe855354c48194d5556de764a883917925"}]},{"sha":"0877afbe855354c48194d5556de764a883917925","node_id":"C_kwDOOYsS4doAKDA4NzdhZmJlODU1MzU0YzQ4MTk0ZDU1NTZkZTc2NGE4ODM5MTc5MjU","commit":{"author":{"name":"Celia Chen","email":"celia@openai.com","date":"2026-07-13T21:49:02Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T21:54:04Z"},"message":"Broaden remote compaction model fallback (#32881)\n\n## Why\n\nCompacting a resumed conversation can fail when its previous model is no longer\navailable. Some model-specific failures, such as a model-not-found response, are\nnot represented as invalid requests and therefore did not trigger the existing\nfallback to the currently selected model.\n\n## What changed\n\n- Share a retry predicate between both remote compaction implementations.\n- Fall back to the current model for invalid requests, unexpected statuses,\n  context-window and usage-limit errors, server failures, and exhausted retries.\n\n## Testing\n\nAdd an integration test that resumes a conversation whose previous model returns\nmodel-not-found and verifies that compaction and the next turn use the renamed\nmodel.\n\nGitOrigin-RevId: c3857beae2ce79b50589deb13c2e59710ce14725","tree":{"sha":"0dbdadc93130950a3d9b7a24a1e9d844fa595bd3","url":"https://api.github.com/repos/openai/codex/git/trees/0dbdadc93130950a3d9b7a24a1e9d844fa595bd3"},"url":"https://api.github.com/repos/openai/codex/git/commits/0877afbe855354c48194d5556de764a883917925","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/0877afbe855354c48194d5556de764a883917925","html_url":"https://github.com/openai/codex/commit/0877afbe855354c48194d5556de764a883917925","comments_url":"https://api.github.com/repos/openai/codex/commits/0877afbe855354c48194d5556de764a883917925/comments","author":{"login":"celia-oai","id":209693228,"node_id":"U_kgDODH-qLA","avatar_url":"https://avatars.githubusercontent.com/u/209693228?v=4","gravatar_id":"","url":"https://api.github.com/users/celia-oai","html_url":"https://github.com/celia-oai","followers_url":"https://api.github.com/users/celia-oai/followers","following_url":"https://api.github.com/users/celia-oai/following{/other_user}","gists_url":"https://api.github.com/users/celia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/celia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celia-oai/subscriptions","organizations_url":"https://api.github.com/users/celia-oai/orgs","repos_url":"https://api.github.com/users/celia-oai/repos","events_url":"https://api.github.com/users/celia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/celia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"60b9b551c1f590c0a11e3c5d153135eedcdad70b","url":"https://api.github.com/repos/openai/codex/commits/60b9b551c1f590c0a11e3c5d153135eedcdad70b","html_url":"https://github.com/openai/codex/commit/60b9b551c1f590c0a11e3c5d153135eedcdad70b"}]},{"sha":"60b9b551c1f590c0a11e3c5d153135eedcdad70b","node_id":"C_kwDOOYsS4doAKDYwYjliNTUxYzFmNTkwYzBhMTFlM2M1ZDE1MzEzNWVlZGNkYWQ3MGI","commit":{"author":{"name":"rhan-oai","email":"rhan@openai.com","date":"2026-07-13T21:20:49Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T21:25:28Z"},"message":"Use model catalog policies for Guardian auto review (#32875)\n\n## What changed\n\n- Add an `auto_review.policy` field to model catalog messages.\n- Use the selected Guardian model's catalog policy for review-session instructions, while preserving the precedence of `guardian_policy_config` and falling back to the built-in policy when neither is present.\n- Preserve auto-review messages when model instruction overrides remove catalog instruction templates.\n\n## Testing\n\n- Cover configured-policy precedence, explicit empty catalog policies, catalog-message preservation, and propagation of the catalog policy into a prewarmed Guardian session.\n\nGitOrigin-RevId: 26b61ae2958ea8325a64834dcf91f47e140d74b3","tree":{"sha":"3daf5b1f56c530d13eade34897cbe330370ec1df","url":"https://api.github.com/repos/openai/codex/git/trees/3daf5b1f56c530d13eade34897cbe330370ec1df"},"url":"https://api.github.com/repos/openai/codex/git/commits/60b9b551c1f590c0a11e3c5d153135eedcdad70b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/60b9b551c1f590c0a11e3c5d153135eedcdad70b","html_url":"https://github.com/openai/codex/commit/60b9b551c1f590c0a11e3c5d153135eedcdad70b","comments_url":"https://api.github.com/repos/openai/codex/commits/60b9b551c1f590c0a11e3c5d153135eedcdad70b/comments","author":{"login":"rhan-oai","id":214716640,"node_id":"U_kgDODMxQ4A","avatar_url":"https://avatars.githubusercontent.com/u/214716640?v=4","gravatar_id":"","url":"https://api.github.com/users/rhan-oai","html_url":"https://github.com/rhan-oai","followers_url":"https://api.github.com/users/rhan-oai/followers","following_url":"https://api.github.com/users/rhan-oai/following{/other_user}","gists_url":"https://api.github.com/users/rhan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rhan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rhan-oai/subscriptions","organizations_url":"https://api.github.com/users/rhan-oai/orgs","repos_url":"https://api.github.com/users/rhan-oai/repos","events_url":"https://api.github.com/users/rhan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rhan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"bbfa08fe3b904f5134f200d5b9ae7f6c28598521","url":"https://api.github.com/repos/openai/codex/commits/bbfa08fe3b904f5134f200d5b9ae7f6c28598521","html_url":"https://github.com/openai/codex/commit/bbfa08fe3b904f5134f200d5b9ae7f6c28598521"}]},{"sha":"bbfa08fe3b904f5134f200d5b9ae7f6c28598521","node_id":"C_kwDOOYsS4doAKGJiZmEwOGZlM2I5MDRmNTEzNGYyMDBkNWI5YWU3ZjZjMjg1OTg1MjE","commit":{"author":{"name":"Chris Dong","email":"chrisdong@openai.com","date":"2026-07-13T20:08:36Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T20:16:38Z"},"message":"Include connector IDs in MCP tool call analytics (#32867)\n\n## What changed\n\n- Add the optional `connector_id` to `codex_mcp_tool_call_event` parameters.\n- Populate it from the MCP tool call's `app_context` when available.\n\n## Testing\n\n- Extend the completed tool item analytics test to verify the connector ID is serialized.\n\nGitOrigin-RevId: ea62202318dd492fa0ffd4ff1d48a66d1cc37e96","tree":{"sha":"0d5d64f0953d5274b4779399dc3b5a1ef562acc6","url":"https://api.github.com/repos/openai/codex/git/trees/0d5d64f0953d5274b4779399dc3b5a1ef562acc6"},"url":"https://api.github.com/repos/openai/codex/git/commits/bbfa08fe3b904f5134f200d5b9ae7f6c28598521","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/bbfa08fe3b904f5134f200d5b9ae7f6c28598521","html_url":"https://github.com/openai/codex/commit/bbfa08fe3b904f5134f200d5b9ae7f6c28598521","comments_url":"https://api.github.com/repos/openai/codex/commits/bbfa08fe3b904f5134f200d5b9ae7f6c28598521/comments","author":{"login":"chrisdong-oai","id":256211597,"node_id":"U_kgDOD0V6jQ","avatar_url":"https://avatars.githubusercontent.com/u/256211597?v=4","gravatar_id":"","url":"https://api.github.com/users/chrisdong-oai","html_url":"https://github.com/chrisdong-oai","followers_url":"https://api.github.com/users/chrisdong-oai/followers","following_url":"https://api.github.com/users/chrisdong-oai/following{/other_user}","gists_url":"https://api.github.com/users/chrisdong-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/chrisdong-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chrisdong-oai/subscriptions","organizations_url":"https://api.github.com/users/chrisdong-oai/orgs","repos_url":"https://api.github.com/users/chrisdong-oai/repos","events_url":"https://api.github.com/users/chrisdong-oai/events{/privacy}","received_events_url":"https://api.github.com/users/chrisdong-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"6e113acf5feecd8784c7f703cae9651b06d3c4b9","url":"https://api.github.com/repos/openai/codex/commits/6e113acf5feecd8784c7f703cae9651b06d3c4b9","html_url":"https://github.com/openai/codex/commit/6e113acf5feecd8784c7f703cae9651b06d3c4b9"}]},{"sha":"6e113acf5feecd8784c7f703cae9651b06d3c4b9","node_id":"C_kwDOOYsS4doAKDZlMTEzYWNmNWZlZWNkODc4NGM3ZjcwM2NhZTk2NTFiMDZkM2M0Yjk","commit":{"author":{"name":"Won Park","email":"won@openai.com","date":"2026-07-13T20:07:59Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T20:12:42Z"},"message":"Allow responses after image generation (#32866)\n\n## What changed\n\nRemove the image generation instruction that prohibited any response after an\nimage was generated.\n\nGitOrigin-RevId: c779055da3142ba84cdbb9312e5f66b132f24b29","tree":{"sha":"bf08cc43ef193373721f0b99495404da53cd2469","url":"https://api.github.com/repos/openai/codex/git/trees/bf08cc43ef193373721f0b99495404da53cd2469"},"url":"https://api.github.com/repos/openai/codex/git/commits/6e113acf5feecd8784c7f703cae9651b06d3c4b9","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/6e113acf5feecd8784c7f703cae9651b06d3c4b9","html_url":"https://github.com/openai/codex/commit/6e113acf5feecd8784c7f703cae9651b06d3c4b9","comments_url":"https://api.github.com/repos/openai/codex/commits/6e113acf5feecd8784c7f703cae9651b06d3c4b9/comments","author":{"login":"won-openai","id":262224683,"node_id":"U_kgDOD6E7Kw","avatar_url":"https://avatars.githubusercontent.com/u/262224683?v=4","gravatar_id":"","url":"https://api.github.com/users/won-openai","html_url":"https://github.com/won-openai","followers_url":"https://api.github.com/users/won-openai/followers","following_url":"https://api.github.com/users/won-openai/following{/other_user}","gists_url":"https://api.github.com/users/won-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/won-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/won-openai/subscriptions","organizations_url":"https://api.github.com/users/won-openai/orgs","repos_url":"https://api.github.com/users/won-openai/repos","events_url":"https://api.github.com/users/won-openai/events{/privacy}","received_events_url":"https://api.github.com/users/won-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"3370181ec6e3227a922257497bdd28f3e8e76144","url":"https://api.github.com/repos/openai/codex/commits/3370181ec6e3227a922257497bdd28f3e8e76144","html_url":"https://github.com/openai/codex/commit/3370181ec6e3227a922257497bdd28f3e8e76144"}]},{"sha":"3370181ec6e3227a922257497bdd28f3e8e76144","node_id":"C_kwDOOYsS4doAKDMzNzAxODFlYzZlMzIyN2E5MjIyNTc0OTdiZGQyOGYzZThlNzYxNDQ","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-07-13T20:01:26Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T20:06:15Z"},"message":"Coalesce concurrent Windows sandbox setup requests (#32864)\n\n## Why\n\nConcurrent callers can submit the same Windows sandbox setup payload while an\nidentical helper invocation is already running.\n\n## What changed\n\n- Share one in-flight helper invocation among setup and refresh requests with\n  identical serialized payloads.\n- Return the shared success or failure to every waiter while preserving\n  structured setup error codes, then allow subsequent requests to run again.\n\n## Testing\n\n- Add a concurrency test that verifies identical requests execute the setup\n  operation once.\n\nGitOrigin-RevId: 18ebbcb9b36de3eb5912b8bbbe153d39328b5e48","tree":{"sha":"f9452a488a40aa39f1122948dd5e48f63aaa87cc","url":"https://api.github.com/repos/openai/codex/git/trees/f9452a488a40aa39f1122948dd5e48f63aaa87cc"},"url":"https://api.github.com/repos/openai/codex/git/commits/3370181ec6e3227a922257497bdd28f3e8e76144","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/3370181ec6e3227a922257497bdd28f3e8e76144","html_url":"https://github.com/openai/codex/commit/3370181ec6e3227a922257497bdd28f3e8e76144","comments_url":"https://api.github.com/repos/openai/codex/commits/3370181ec6e3227a922257497bdd28f3e8e76144/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"bbe93d3e5f22202362cac87e7e9dc755d8706a8a","url":"https://api.github.com/repos/openai/codex/commits/bbe93d3e5f22202362cac87e7e9dc755d8706a8a","html_url":"https://github.com/openai/codex/commit/bbe93d3e5f22202362cac87e7e9dc755d8706a8a"}]},{"sha":"bbe93d3e5f22202362cac87e7e9dc755d8706a8a","node_id":"C_kwDOOYsS4doAKGJiZTkzZDNlNWYyMjIwMjM2MmNhYzg3ZTdlOWRjNzU1ZDg3MDZhOGE","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-07-13T19:03:46Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T19:08:11Z"},"message":"Persist slash-command popup dismissal (#32858)\n\n## What changed\n\n- Make `Esc` dismiss the slash-command popup immediately without changing the draft or interrupting a running task.\n- Keep the popup closed while the first-line command token is unchanged, and reopen it after the token is edited.\n\n## Testing\n\n- Cover dismissal while idle and while a task is running.\n- Add a snapshot confirming that the dismissed popup remains hidden.\n\nGitOrigin-RevId: f0ee84af080181e8d92c435f474ded1c8cb5b457","tree":{"sha":"1652f77202d45bf182c6ac6e16335894b44b3d45","url":"https://api.github.com/repos/openai/codex/git/trees/1652f77202d45bf182c6ac6e16335894b44b3d45"},"url":"https://api.github.com/repos/openai/codex/git/commits/bbe93d3e5f22202362cac87e7e9dc755d8706a8a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/bbe93d3e5f22202362cac87e7e9dc755d8706a8a","html_url":"https://github.com/openai/codex/commit/bbe93d3e5f22202362cac87e7e9dc755d8706a8a","comments_url":"https://api.github.com/repos/openai/codex/commits/bbe93d3e5f22202362cac87e7e9dc755d8706a8a/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"abbb8c569cbda65fd75f1a51fcc8dd99ced199fa","url":"https://api.github.com/repos/openai/codex/commits/abbb8c569cbda65fd75f1a51fcc8dd99ced199fa","html_url":"https://github.com/openai/codex/commit/abbb8c569cbda65fd75f1a51fcc8dd99ced199fa"}]},{"sha":"abbb8c569cbda65fd75f1a51fcc8dd99ced199fa","node_id":"C_kwDOOYsS4doAKGFiYmI4YzU2OWNiZGE2NWZkNzVmMWE1MWZjYzhkZDk5Y2VkMTk5ZmE","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-07-13T18:58:46Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T19:04:22Z"},"message":"Require the elevated Windows sandbox for network proxies (#32857)\n\n## Why\n\nNetwork proxy enforcement on Windows requires the elevated sandbox backend. Silently selecting that backend for an unelevated configuration makes the effective sandbox differ from the configured mode.\n\n## What changed\n\n- Reject enabled network proxy configurations on Windows unless managed requirements allow only the elevated sandbox and `windows.sandbox` resolves to `\"elevated\"`.\n- Preserve the configured sandbox backend during execution and validate proxy compatibility at config loading, sandbox setup, and process launch boundaries.\n- Defer this validation during cloud-config bootstrap so authoritative managed requirements can be loaded first.\n- Do not start or expose disabled Windows proxies, and render transitions to disabled networking as `<network enabled=\"false\"></network>`.\n\n## Testing\n\n- Cover Windows requirement and sandbox compatibility matrices, bootstrap behavior, backend selection, disabled proxy handling, and environment-context updates.\n\nGitOrigin-RevId: bfa1dda98594e0db61883f8e7f65bd560e3453e6","tree":{"sha":"d9a8118f92be1d6abde64ea5dfe4035d64b62783","url":"https://api.github.com/repos/openai/codex/git/trees/d9a8118f92be1d6abde64ea5dfe4035d64b62783"},"url":"https://api.github.com/repos/openai/codex/git/commits/abbb8c569cbda65fd75f1a51fcc8dd99ced199fa","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/abbb8c569cbda65fd75f1a51fcc8dd99ced199fa","html_url":"https://github.com/openai/codex/commit/abbb8c569cbda65fd75f1a51fcc8dd99ced199fa","comments_url":"https://api.github.com/repos/openai/codex/commits/abbb8c569cbda65fd75f1a51fcc8dd99ced199fa/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"87f3e39fdf7e676d0ba25b0587f78e5b85e695e2","url":"https://api.github.com/repos/openai/codex/commits/87f3e39fdf7e676d0ba25b0587f78e5b85e695e2","html_url":"https://github.com/openai/codex/commit/87f3e39fdf7e676d0ba25b0587f78e5b85e695e2"}]},{"sha":"87f3e39fdf7e676d0ba25b0587f78e5b85e695e2","node_id":"C_kwDOOYsS4doAKDg3ZjNlMzlmZGY3ZTY3NmQwYmEyNWIwNTg3Zjc4ZTViODVlNjk1ZTI","commit":{"author":{"name":"zm-oai","email":"zm@openai.com","date":"2026-07-13T18:19:24Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T18:25:55Z"},"message":"Hide Windows filesystem helper console windows (#32849)\n\n## What changed\n\n- Add a console mode to the Windows sandbox process launcher.\n- Launch `--codex-run-as-fs-helper` subprocesses with `CREATE_NO_WINDOW`.\n- Preserve inherited-console behavior for regular sandboxed commands.\n\nGitOrigin-RevId: 927be36b82903b6a5fb1a243ba7f406f9ed85f3f","tree":{"sha":"832dc41ad99d85aa7bbb07cae3964fec8f9d5c14","url":"https://api.github.com/repos/openai/codex/git/trees/832dc41ad99d85aa7bbb07cae3964fec8f9d5c14"},"url":"https://api.github.com/repos/openai/codex/git/commits/87f3e39fdf7e676d0ba25b0587f78e5b85e695e2","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/87f3e39fdf7e676d0ba25b0587f78e5b85e695e2","html_url":"https://github.com/openai/codex/commit/87f3e39fdf7e676d0ba25b0587f78e5b85e695e2","comments_url":"https://api.github.com/repos/openai/codex/commits/87f3e39fdf7e676d0ba25b0587f78e5b85e695e2/comments","author":{"login":"zm-oai","id":215741035,"node_id":"U_kgDODNvyaw","avatar_url":"https://avatars.githubusercontent.com/u/215741035?v=4","gravatar_id":"","url":"https://api.github.com/users/zm-oai","html_url":"https://github.com/zm-oai","followers_url":"https://api.github.com/users/zm-oai/followers","following_url":"https://api.github.com/users/zm-oai/following{/other_user}","gists_url":"https://api.github.com/users/zm-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/zm-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zm-oai/subscriptions","organizations_url":"https://api.github.com/users/zm-oai/orgs","repos_url":"https://api.github.com/users/zm-oai/repos","events_url":"https://api.github.com/users/zm-oai/events{/privacy}","received_events_url":"https://api.github.com/users/zm-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"84696e3d576c3bf7a0989964d772eb96b10cfb92","url":"https://api.github.com/repos/openai/codex/commits/84696e3d576c3bf7a0989964d772eb96b10cfb92","html_url":"https://github.com/openai/codex/commit/84696e3d576c3bf7a0989964d772eb96b10cfb92"}]},{"sha":"84696e3d576c3bf7a0989964d772eb96b10cfb92","node_id":"C_kwDOOYsS4doAKDg0Njk2ZTNkNTc2YzNiZjdhMDk4OTk2NGQ3NzJlYjk2YjEwY2ZiOTI","commit":{"author":{"name":"keith thornhill","email":"keitht@openai.com","date":"2026-07-13T17:51:20Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T18:00:10Z"},"message":"Expand millisecond duration histogram boundaries (#32844)\n\n## What changed\n\nAdd finer-grained buckets from 1 to 10 seconds and extend millisecond duration histograms with buckets up to 120 seconds.\n\nGitOrigin-RevId: dee492de08db058444926d22281ef7bc4ba1cdeb","tree":{"sha":"2492f3f77b3dab889d7cfd1bfb241a6f8572197f","url":"https://api.github.com/repos/openai/codex/git/trees/2492f3f77b3dab889d7cfd1bfb241a6f8572197f"},"url":"https://api.github.com/repos/openai/codex/git/commits/84696e3d576c3bf7a0989964d772eb96b10cfb92","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/84696e3d576c3bf7a0989964d772eb96b10cfb92","html_url":"https://github.com/openai/codex/commit/84696e3d576c3bf7a0989964d772eb96b10cfb92","comments_url":"https://api.github.com/repos/openai/codex/commits/84696e3d576c3bf7a0989964d772eb96b10cfb92/comments","author":{"login":"keitht-openai","id":175741136,"node_id":"U_kgDOCnmY0A","avatar_url":"https://avatars.githubusercontent.com/u/175741136?v=4","gravatar_id":"","url":"https://api.github.com/users/keitht-openai","html_url":"https://github.com/keitht-openai","followers_url":"https://api.github.com/users/keitht-openai/followers","following_url":"https://api.github.com/users/keitht-openai/following{/other_user}","gists_url":"https://api.github.com/users/keitht-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/keitht-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/keitht-openai/subscriptions","organizations_url":"https://api.github.com/users/keitht-openai/orgs","repos_url":"https://api.github.com/users/keitht-openai/repos","events_url":"https://api.github.com/users/keitht-openai/events{/privacy}","received_events_url":"https://api.github.com/users/keitht-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"b36c0b11896b0708035b0778de5635b45e84fe0d","url":"https://api.github.com/repos/openai/codex/commits/b36c0b11896b0708035b0778de5635b45e84fe0d","html_url":"https://github.com/openai/codex/commit/b36c0b11896b0708035b0778de5635b45e84fe0d"}]},{"sha":"b36c0b11896b0708035b0778de5635b45e84fe0d","node_id":"C_kwDOOYsS4doAKGIzNmMwYjExODk2YjA3MDgwMzViMDc3OGRlNTYzNWI0NWU4NGZlMGQ","commit":{"author":{"name":"Teddy Ni","email":"tni@openai.com","date":"2026-07-13T17:28:26Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T17:33:13Z"},"message":"Reap exited PID-managed app-server children (#32838)\n\n## Why\n\nAn app-server child started by a previous updater can remain as a zombie after\ntermination. Its PID then still appears active, causing daemon shutdown to wait\nuntil its timeout instead of removing the stale PID file.\n\n## What changed\n\n- Poll `waitpid` with `WNOHANG` while waiting for a PID-managed process to stop.\n- Check process state before enforcing the stop deadline so an exit at the\n  deadline can still be observed and cleaned up.\n\n## Testing\n\nAdded a regression test that stops an untracked child and verifies that shutdown\nfinishes promptly and removes its PID file.\n\nGitOrigin-RevId: b203cf860e4207716a6cfc36015f8ee77918d13a","tree":{"sha":"419ae1ba8e8186c9bf3717e5ba089288c5deb0ad","url":"https://api.github.com/repos/openai/codex/git/trees/419ae1ba8e8186c9bf3717e5ba089288c5deb0ad"},"url":"https://api.github.com/repos/openai/codex/git/commits/b36c0b11896b0708035b0778de5635b45e84fe0d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/b36c0b11896b0708035b0778de5635b45e84fe0d","html_url":"https://github.com/openai/codex/commit/b36c0b11896b0708035b0778de5635b45e84fe0d","comments_url":"https://api.github.com/repos/openai/codex/commits/b36c0b11896b0708035b0778de5635b45e84fe0d/comments","author":{"login":"tni-oai","id":286148652,"node_id":"U_kgDOEQ5ILA","avatar_url":"https://avatars.githubusercontent.com/u/286148652?v=4","gravatar_id":"","url":"https://api.github.com/users/tni-oai","html_url":"https://github.com/tni-oai","followers_url":"https://api.github.com/users/tni-oai/followers","following_url":"https://api.github.com/users/tni-oai/following{/other_user}","gists_url":"https://api.github.com/users/tni-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/tni-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tni-oai/subscriptions","organizations_url":"https://api.github.com/users/tni-oai/orgs","repos_url":"https://api.github.com/users/tni-oai/repos","events_url":"https://api.github.com/users/tni-oai/events{/privacy}","received_events_url":"https://api.github.com/users/tni-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"088239294a5f4cd8f39762ed4b7a65414a83da12","url":"https://api.github.com/repos/openai/codex/commits/088239294a5f4cd8f39762ed4b7a65414a83da12","html_url":"https://github.com/openai/codex/commit/088239294a5f4cd8f39762ed4b7a65414a83da12"}]},{"sha":"088239294a5f4cd8f39762ed4b7a65414a83da12","node_id":"C_kwDOOYsS4doAKDA4ODIzOTI5NGE1ZjRjZDhmMzk3NjJlZDRiN2E2NTQxNGE4M2RhMTI","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-13T17:19:29Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T17:24:10Z"},"message":"Restore V2 agent identities on root thread resume (#32837)\n\n## Why\n\nAfter a cold resume, a Multi-Agent V2 root thread must still be able to\naddress its persisted descendants even though their runtimes are not reopened\neagerly.\n\n## What changed\n\n- Restore metadata for open descendant agents when resuming a V2 root thread.\n- Preserve each descendant's path, nickname, and role while leaving its runtime\n  unloaded until a message targets it.\n- Reuse the spawn metadata preparation path so restored identities retain the\n  same reservation and naming checks as newly spawned agents.\n\n## Testing\n\nAdded an end-to-end cold-resume test that follows up with a persisted agent by\nname and verifies that the original agent thread is loaded on demand.\n\nGitOrigin-RevId: a1663c1ae60eefadb948cd39f933cd3bbb49a492","tree":{"sha":"81fc7224ab4ab0e6affa3dd021fcab9acafc5e95","url":"https://api.github.com/repos/openai/codex/git/trees/81fc7224ab4ab0e6affa3dd021fcab9acafc5e95"},"url":"https://api.github.com/repos/openai/codex/git/commits/088239294a5f4cd8f39762ed4b7a65414a83da12","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/088239294a5f4cd8f39762ed4b7a65414a83da12","html_url":"https://github.com/openai/codex/commit/088239294a5f4cd8f39762ed4b7a65414a83da12","comments_url":"https://api.github.com/repos/openai/codex/commits/088239294a5f4cd8f39762ed4b7a65414a83da12/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"19a000259d5cbc2e3d46a7279e41a9e94e685585","url":"https://api.github.com/repos/openai/codex/commits/19a000259d5cbc2e3d46a7279e41a9e94e685585","html_url":"https://github.com/openai/codex/commit/19a000259d5cbc2e3d46a7279e41a9e94e685585"}]},{"sha":"19a000259d5cbc2e3d46a7279e41a9e94e685585","node_id":"C_kwDOOYsS4doAKDE5YTAwMDI1OWQ1Y2JjMmUzZDQ2YTcyNzllNDFhOWU5NGU2ODU1ODU","commit":{"author":{"name":"XMLIU-oai","email":"xmliu@openai.com","date":"2026-07-13T16:47:26Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T16:52:18Z"},"message":"Forward turn metadata in standalone web search (#32835)\n\n## What changed\n\n- Add optional serialized Codex turn metadata to extension tool calls.\n- Populate it from the current turn context and send it as the\n  `x-codex-turn-metadata` header on standalone web search requests.\n\n## Testing\n\n- Extend the app-server web search integration test to verify that client\n  metadata, including the model ID, reaches the standalone search request.\n\nGitOrigin-RevId: c0950108d89a1d317ac94ccd23efcee72fffc6f0","tree":{"sha":"f3a0255845f0eacb1763c9dff9050f0beed58553","url":"https://api.github.com/repos/openai/codex/git/trees/f3a0255845f0eacb1763c9dff9050f0beed58553"},"url":"https://api.github.com/repos/openai/codex/git/commits/19a000259d5cbc2e3d46a7279e41a9e94e685585","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/19a000259d5cbc2e3d46a7279e41a9e94e685585","html_url":"https://github.com/openai/codex/commit/19a000259d5cbc2e3d46a7279e41a9e94e685585","comments_url":"https://api.github.com/repos/openai/codex/commits/19a000259d5cbc2e3d46a7279e41a9e94e685585/comments","author":{"login":"XMLIU-oai","id":289839060,"node_id":"U_kgDOEUaX1A","avatar_url":"https://avatars.githubusercontent.com/u/289839060?v=4","gravatar_id":"","url":"https://api.github.com/users/XMLIU-oai","html_url":"https://github.com/XMLIU-oai","followers_url":"https://api.github.com/users/XMLIU-oai/followers","following_url":"https://api.github.com/users/XMLIU-oai/following{/other_user}","gists_url":"https://api.github.com/users/XMLIU-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/XMLIU-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/XMLIU-oai/subscriptions","organizations_url":"https://api.github.com/users/XMLIU-oai/orgs","repos_url":"https://api.github.com/users/XMLIU-oai/repos","events_url":"https://api.github.com/users/XMLIU-oai/events{/privacy}","received_events_url":"https://api.github.com/users/XMLIU-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"2e156cbe31212ccfa9173cb2679c1a201a940b18","url":"https://api.github.com/repos/openai/codex/commits/2e156cbe31212ccfa9173cb2679c1a201a940b18","html_url":"https://github.com/openai/codex/commit/2e156cbe31212ccfa9173cb2679c1a201a940b18"}]},{"sha":"2e156cbe31212ccfa9173cb2679c1a201a940b18","node_id":"C_kwDOOYsS4doAKDJlMTU2Y2JlMzEyMTJjY2ZhOTE3M2NiMjY3OWMxYTIwMWE5NDBiMTg","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-13T15:41:09Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T15:47:03Z"},"message":"Avoid blocking thread startup on MCP OAuth discovery (#32825)\n\n## Why\n\nOAuth metadata discovery for an optional HTTP MCP server can stall, delaying\n`thread/start` even though that server is not required.\n\n## What changed\n\n- Remove eager MCP authentication-status discovery from session and connection\n  manager startup.\n- When an MCP connection reports an authentication error, inspect configured and\n  stored credentials locally to preserve login and reauthentication failure\n  reasons without making another discovery request.\n- Continue using server configuration directly for startup error messages and\n  timeout hints.\n\n## Testing\n\nAdd an app-server regression test with an optional HTTP MCP endpoint that accepts\na connection but never responds, and verify that `thread/start` completes without\nwaiting for its configured startup timeout.\n\nGitOrigin-RevId: 56fe0188cc1ceaf746b0b65e8b7dd1fd2e13420d","tree":{"sha":"0108c8a40d5729956a434280c6ae7f6e493cac34","url":"https://api.github.com/repos/openai/codex/git/trees/0108c8a40d5729956a434280c6ae7f6e493cac34"},"url":"https://api.github.com/repos/openai/codex/git/commits/2e156cbe31212ccfa9173cb2679c1a201a940b18","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/2e156cbe31212ccfa9173cb2679c1a201a940b18","html_url":"https://github.com/openai/codex/commit/2e156cbe31212ccfa9173cb2679c1a201a940b18","comments_url":"https://api.github.com/repos/openai/codex/commits/2e156cbe31212ccfa9173cb2679c1a201a940b18/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4ebc61c0f8df9852e709ff4b477b750fc816a69b","url":"https://api.github.com/repos/openai/codex/commits/4ebc61c0f8df9852e709ff4b477b750fc816a69b","html_url":"https://github.com/openai/codex/commit/4ebc61c0f8df9852e709ff4b477b750fc816a69b"}]},{"sha":"4ebc61c0f8df9852e709ff4b477b750fc816a69b","node_id":"C_kwDOOYsS4doAKDRlYmM2MWMwZjhkZjk4NTJlNzA5ZmY0YjQ3N2I3NTBmYzgxNmE2OWI","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-13T15:34:09Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T15:39:24Z"},"message":"Make explicit multi-agent mode override proactive delegation (#32822)\n\n## Why\n\nAfter switching from proactive delegation to explicit-request-only mode, an\nearlier proactive instruction can remain in the conversation context. The new\nmode must clearly supersede that instruction.\n\n## What changed\n\nUpdate the explicit-request-only developer message to cancel earlier proactive\ndelegation instructions before requiring delegation to be explicitly requested\nby the user, `AGENTS.md`, or a skill.\n\n## Testing\n\nUpdate the multi-agent mode integration test expectation for the explicit-mode\ninstruction emitted after a cold resume.\n\nGitOrigin-RevId: 0a6d18f38ef82d29cf4f3bfcfd4ac84738a39598","tree":{"sha":"6fb6d1b430233a53a72fdfafd0e4f767c26550d4","url":"https://api.github.com/repos/openai/codex/git/trees/6fb6d1b430233a53a72fdfafd0e4f767c26550d4"},"url":"https://api.github.com/repos/openai/codex/git/commits/4ebc61c0f8df9852e709ff4b477b750fc816a69b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4ebc61c0f8df9852e709ff4b477b750fc816a69b","html_url":"https://github.com/openai/codex/commit/4ebc61c0f8df9852e709ff4b477b750fc816a69b","comments_url":"https://api.github.com/repos/openai/codex/commits/4ebc61c0f8df9852e709ff4b477b750fc816a69b/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c7a4a7e136d96554e1fc6f66532e6060fd2aaf15","url":"https://api.github.com/repos/openai/codex/commits/c7a4a7e136d96554e1fc6f66532e6060fd2aaf15","html_url":"https://github.com/openai/codex/commit/c7a4a7e136d96554e1fc6f66532e6060fd2aaf15"}]},{"sha":"c7a4a7e136d96554e1fc6f66532e6060fd2aaf15","node_id":"C_kwDOOYsS4doAKGM3YTRhN2UxMzZkOTY1NTRlMWZjNmY2NjUzMmU2MDYwZmQyYWFmMTU","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-13T13:51:14Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T13:56:34Z"},"message":"Refactor OAuth store lock contention tests (#32801)\n\n## What changed\n\n- Extend the lock-contention test helper with a callback that runs while the\n  aggregate store lock is held.\n- Use a scoped worker thread and return its result directly after releasing the\n  lock.\n- Reuse the helper for concurrent update tests covering both file and secrets\n  credential stores.\n\nGitOrigin-RevId: 74b8b5370456e90ecd39fc2af2f0853594ca4f60","tree":{"sha":"850b3d132ddf89765b5038a8ff12d98e558ea7a5","url":"https://api.github.com/repos/openai/codex/git/trees/850b3d132ddf89765b5038a8ff12d98e558ea7a5"},"url":"https://api.github.com/repos/openai/codex/git/commits/c7a4a7e136d96554e1fc6f66532e6060fd2aaf15","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c7a4a7e136d96554e1fc6f66532e6060fd2aaf15","html_url":"https://github.com/openai/codex/commit/c7a4a7e136d96554e1fc6f66532e6060fd2aaf15","comments_url":"https://api.github.com/repos/openai/codex/commits/c7a4a7e136d96554e1fc6f66532e6060fd2aaf15/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"8b2c84ddccafe40dc0dc09f9f52bcbdc9dc45d66","url":"https://api.github.com/repos/openai/codex/commits/8b2c84ddccafe40dc0dc09f9f52bcbdc9dc45d66","html_url":"https://github.com/openai/codex/commit/8b2c84ddccafe40dc0dc09f9f52bcbdc9dc45d66"}]},{"sha":"8b2c84ddccafe40dc0dc09f9f52bcbdc9dc45d66","node_id":"C_kwDOOYsS4doAKDhiMmM4NGRkY2NhZmU0MGRjMGRjMDlmOWY1MmJjYmRjOWRjNDVkNjY","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-13T11:56:04Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T12:00:50Z"},"message":"Apply MCP startup timeouts during client creation (#32781)\n\n## What changed\n\n- Apply each server's `startup_timeout_sec` (or the default) while creating the\n  MCP client, so the deadline also covers transport setup.\n- Launch local stdio servers on a blocking task so synchronous command\n  resolution and process creation do not prevent the deadline from firing.\n- Recognize the new client-startup timeout error and show the existing\n  `startup_timeout_sec` configuration hint.\n\n## Testing\n\n- Extend the timeout error display test to cover the client-startup timeout.\n\nGitOrigin-RevId: 1967c62f943d55f6aa18792d4488e52c22f1e717","tree":{"sha":"b5eac810523d12fe5d4468ae2bcdd0f6f7740d5b","url":"https://api.github.com/repos/openai/codex/git/trees/b5eac810523d12fe5d4468ae2bcdd0f6f7740d5b"},"url":"https://api.github.com/repos/openai/codex/git/commits/8b2c84ddccafe40dc0dc09f9f52bcbdc9dc45d66","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/8b2c84ddccafe40dc0dc09f9f52bcbdc9dc45d66","html_url":"https://github.com/openai/codex/commit/8b2c84ddccafe40dc0dc09f9f52bcbdc9dc45d66","comments_url":"https://api.github.com/repos/openai/codex/commits/8b2c84ddccafe40dc0dc09f9f52bcbdc9dc45d66/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4477b20713f55ce2533618fbcf3d3d7ff7d8ca25","url":"https://api.github.com/repos/openai/codex/commits/4477b20713f55ce2533618fbcf3d3d7ff7d8ca25","html_url":"https://github.com/openai/codex/commit/4477b20713f55ce2533618fbcf3d3d7ff7d8ca25"}]},{"sha":"4477b20713f55ce2533618fbcf3d3d7ff7d8ca25","node_id":"C_kwDOOYsS4doAKDQ0NzdiMjA3MTNmNTVjZTI1MzM2MThmYmNmM2QzZDdmZjdkOGNhMjU","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-13T11:40:25Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T11:46:25Z"},"message":"Enable skill search shadow selection by default (#32780)\n\n## What changed\n\nMark `skill_search` as stable and enable it by default so the app server runs\nshadow skill selection and emits its experiment metrics.\n\nGitOrigin-RevId: ea9da3b71bfb3be2093aac89ad3d3e388931901d","tree":{"sha":"380b87ba7353ad4c504405a22d5c1f34468a7a41","url":"https://api.github.com/repos/openai/codex/git/trees/380b87ba7353ad4c504405a22d5c1f34468a7a41"},"url":"https://api.github.com/repos/openai/codex/git/commits/4477b20713f55ce2533618fbcf3d3d7ff7d8ca25","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4477b20713f55ce2533618fbcf3d3d7ff7d8ca25","html_url":"https://github.com/openai/codex/commit/4477b20713f55ce2533618fbcf3d3d7ff7d8ca25","comments_url":"https://api.github.com/repos/openai/codex/commits/4477b20713f55ce2533618fbcf3d3d7ff7d8ca25/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"2b0b37abb7b29ea272fa856d6dff9221a6bd9ba8","url":"https://api.github.com/repos/openai/codex/commits/2b0b37abb7b29ea272fa856d6dff9221a6bd9ba8","html_url":"https://github.com/openai/codex/commit/2b0b37abb7b29ea272fa856d6dff9221a6bd9ba8"}]},{"sha":"2b0b37abb7b29ea272fa856d6dff9221a6bd9ba8","node_id":"C_kwDOOYsS4doAKDJiMGIzN2FiYjdiMjllYTI3MmZhODU2ZDZkZmY5MjIxYTZiZDliYTg","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-13T11:01:05Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T11:05:31Z"},"message":"Align shadow skill selection with observable sources (#32768)\n\n## Why\n\nShadow selection can observe invocations from host and orchestrator skills, but\nincluding executor skills in its candidates can skew the resulting metrics.\n\n## What changed\n\nLimit eligible shadow-selection candidates to enabled, prompt-visible skills\nfrom host or orchestrator sources.\n\n## Testing\n\nExtend the implicit-invocation test to add matching executor candidates and\nverify that the host skill remains the selected invocation hit.\n\nGitOrigin-RevId: fd444fe27254b5a880ef5c03c29b5e195127cd97","tree":{"sha":"9cb149e021a9f09c42b7c1620a9bf7d7ced1fc2d","url":"https://api.github.com/repos/openai/codex/git/trees/9cb149e021a9f09c42b7c1620a9bf7d7ced1fc2d"},"url":"https://api.github.com/repos/openai/codex/git/commits/2b0b37abb7b29ea272fa856d6dff9221a6bd9ba8","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/2b0b37abb7b29ea272fa856d6dff9221a6bd9ba8","html_url":"https://github.com/openai/codex/commit/2b0b37abb7b29ea272fa856d6dff9221a6bd9ba8","comments_url":"https://api.github.com/repos/openai/codex/commits/2b0b37abb7b29ea272fa856d6dff9221a6bd9ba8/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c10010928075babeebfc65b824db8778f10a1c56","url":"https://api.github.com/repos/openai/codex/commits/c10010928075babeebfc65b824db8778f10a1c56","html_url":"https://github.com/openai/codex/commit/c10010928075babeebfc65b824db8778f10a1c56"}]},{"sha":"c10010928075babeebfc65b824db8778f10a1c56","node_id":"C_kwDOOYsS4doAKGMxMDAxMDkyODA3NWJhYmVlYmZjNjViODI0ZGI4Nzc4ZjEwYTFjNTY","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-13T10:34:04Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T10:38:37Z"},"message":"Add shadow metrics for lexical skill selection (#32761)\n\n## What changed\n\n- Add an opt-in `skill_search` feature that ranks prompt-visible skills against each turn's user input with a bounded weighted lexical selector.\n- Keep the ranked selection out of model-visible context and record metrics for selection cost, catalog reduction, and whether later implicit or `skills.read` invocations matched the ranked candidates.\n- Include host-provided skills in the experiment catalog without changing the rendered skill catalog.\n\n## Testing\n\n- Add selector unit tests covering ranking, limits, truncation, stop words, and deterministic tie-breaking.\n- Add extension tests covering turn-local invocation recording and host-skill shadow selection.\n\nGitOrigin-RevId: 4d00a1c805ea8b391d6c6ac6a8450afa88ca3e25","tree":{"sha":"d3945298b5fb790194737792aaaba84f94957cf6","url":"https://api.github.com/repos/openai/codex/git/trees/d3945298b5fb790194737792aaaba84f94957cf6"},"url":"https://api.github.com/repos/openai/codex/git/commits/c10010928075babeebfc65b824db8778f10a1c56","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c10010928075babeebfc65b824db8778f10a1c56","html_url":"https://github.com/openai/codex/commit/c10010928075babeebfc65b824db8778f10a1c56","comments_url":"https://api.github.com/repos/openai/codex/commits/c10010928075babeebfc65b824db8778f10a1c56/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"92938d880eccbad1242a86a63f819f67780f68c0","url":"https://api.github.com/repos/openai/codex/commits/92938d880eccbad1242a86a63f819f67780f68c0","html_url":"https://github.com/openai/codex/commit/92938d880eccbad1242a86a63f819f67780f68c0"}]},{"sha":"92938d880eccbad1242a86a63f819f67780f68c0","node_id":"C_kwDOOYsS4doAKDkyOTM4ZDg4MGVjY2JhZDEyNDJhODZhNjNmODE5ZjY3NzgwZjY4YzA","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-13T08:56:21Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T09:52:27Z"},"message":"Restrict spawned-agent models to the active backend (#32751)\n\n## Why\n\nModel overrides for `spawn_agent` must be compatible with the multi-agent backend used by the current turn.\n\n## What changed\n\n- Carry each model's multi-agent backend metadata into `ModelPreset`.\n- Filter the advertised `spawn_agent` model overrides for multi-agent v2 and reject overrides assigned to another backend.\n- Limit error suggestions to picker-visible, backend-compatible models.\n\n## Testing\n\nAdded coverage for hiding incompatible models from the tool description and rejecting them during spawn validation.\n\nGitOrigin-RevId: 22c12aba67df46e9743a74f019b72a1b8b76b308","tree":{"sha":"38f5be2dad6c8c594164014ac317fe94095ad54b","url":"https://api.github.com/repos/openai/codex/git/trees/38f5be2dad6c8c594164014ac317fe94095ad54b"},"url":"https://api.github.com/repos/openai/codex/git/commits/92938d880eccbad1242a86a63f819f67780f68c0","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/92938d880eccbad1242a86a63f819f67780f68c0","html_url":"https://github.com/openai/codex/commit/92938d880eccbad1242a86a63f819f67780f68c0","comments_url":"https://api.github.com/repos/openai/codex/commits/92938d880eccbad1242a86a63f819f67780f68c0/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"ea1545628404e448347bae336771eaf649614105","url":"https://api.github.com/repos/openai/codex/commits/ea1545628404e448347bae336771eaf649614105","html_url":"https://github.com/openai/codex/commit/ea1545628404e448347bae336771eaf649614105"}]},{"sha":"ea1545628404e448347bae336771eaf649614105","node_id":"C_kwDOOYsS4doAKGVhMTU0NTYyODQwNGU0NDgzNDdiYWUzMzY3NzFlYWY2NDk2MTQxMDU","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-13T08:35:21Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T09:48:33Z"},"message":"Expose model overrides for multi-agent v2 spawns (#32749)\n\n## What changed\n\n- Add the `features.multi_agent_v2.expose_spawn_agent_model_overrides` setting, enabled by default, to expose `model` and `reasoning_effort` on the v2 `spawn_agent` tool.\n- Keep these controls available when other spawn metadata is hidden, while allowing them to be disabled independently.\n- Add root-agent and subagent guidance that overrides require a partial or context-free fork and should only be used when explicitly authorized.\n\n## Testing\n\n- Cover configuration parsing and defaults, usage-hint preservation, and tool-schema behavior with override exposure enabled and disabled.\n\nGitOrigin-RevId: 92370498108c96fbd51f32965624ce531e991d9a","tree":{"sha":"69459ae34cb6f9f49bc8d4542ab944b25fc89d44","url":"https://api.github.com/repos/openai/codex/git/trees/69459ae34cb6f9f49bc8d4542ab944b25fc89d44"},"url":"https://api.github.com/repos/openai/codex/git/commits/ea1545628404e448347bae336771eaf649614105","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/ea1545628404e448347bae336771eaf649614105","html_url":"https://github.com/openai/codex/commit/ea1545628404e448347bae336771eaf649614105","comments_url":"https://api.github.com/repos/openai/codex/commits/ea1545628404e448347bae336771eaf649614105/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"ea0fd84d948097761d0e8f14ae1e098ae0ed8eed","url":"https://api.github.com/repos/openai/codex/commits/ea0fd84d948097761d0e8f14ae1e098ae0ed8eed","html_url":"https://github.com/openai/codex/commit/ea0fd84d948097761d0e8f14ae1e098ae0ed8eed"}]},{"sha":"ea0fd84d948097761d0e8f14ae1e098ae0ed8eed","node_id":"C_kwDOOYsS4doAKGVhMGZkODRkOTQ4MDk3NzYxZDBlOGYxNGFlMWUwOThhZTBlZDhlZWQ","commit":{"author":{"name":"Dylan Hurd","email":"dylan.hurd@openai.com","date":"2026-07-13T06:08:04Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T09:44:56Z"},"message":"Align Guardian reviews with session configuration (#32747)\n\n## What changed\n\n- Include permission instructions in Guardian review requests and let the review model use its configured tool mode and standard tool plan instead of a Guardian-specific direct-tool override.\n- Refine the Guardian policy for tenant policy precedence, authorization scoring, prompt-injection handling, read-only investigation, and post-denial user approval.\n- Simplify low-risk allow responses to `{\"outcome\":\"allow\"}` regardless of authorization scoring.\n\n## Testing\n\n- Update Guardian request-layout snapshots to cover the permission instructions included in initial and follow-up reviews.\n\nGitOrigin-RevId: eb83571ef61f7b4e854c12e13e7163c6fab43f00","tree":{"sha":"9085b524168f96adcb7b7f94aa2a2f994503cbd8","url":"https://api.github.com/repos/openai/codex/git/trees/9085b524168f96adcb7b7f94aa2a2f994503cbd8"},"url":"https://api.github.com/repos/openai/codex/git/commits/ea0fd84d948097761d0e8f14ae1e098ae0ed8eed","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/ea0fd84d948097761d0e8f14ae1e098ae0ed8eed","html_url":"https://github.com/openai/codex/commit/ea0fd84d948097761d0e8f14ae1e098ae0ed8eed","comments_url":"https://api.github.com/repos/openai/codex/commits/ea0fd84d948097761d0e8f14ae1e098ae0ed8eed/comments","author":{"login":"dylan-hurd-oai","id":220976066,"node_id":"U_kgDODSvTwg","avatar_url":"https://avatars.githubusercontent.com/u/220976066?v=4","gravatar_id":"","url":"https://api.github.com/users/dylan-hurd-oai","html_url":"https://github.com/dylan-hurd-oai","followers_url":"https://api.github.com/users/dylan-hurd-oai/followers","following_url":"https://api.github.com/users/dylan-hurd-oai/following{/other_user}","gists_url":"https://api.github.com/users/dylan-hurd-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/dylan-hurd-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dylan-hurd-oai/subscriptions","organizations_url":"https://api.github.com/users/dylan-hurd-oai/orgs","repos_url":"https://api.github.com/users/dylan-hurd-oai/repos","events_url":"https://api.github.com/users/dylan-hurd-oai/events{/privacy}","received_events_url":"https://api.github.com/users/dylan-hurd-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"769a5de257e8b38204329263e3781c043f3f618d","url":"https://api.github.com/repos/openai/codex/commits/769a5de257e8b38204329263e3781c043f3f618d","html_url":"https://github.com/openai/codex/commit/769a5de257e8b38204329263e3781c043f3f618d"}]},{"sha":"769a5de257e8b38204329263e3781c043f3f618d","node_id":"C_kwDOOYsS4doAKDc2OWE1ZGUyNTdlOGIzODIwNDMyOTI2M2UzNzgxYzA0M2YzZjYxOGQ","commit":{"author":{"name":"Felipe Coury","email":"felipe.coury@openai.com","date":"2026-07-13T04:58:25Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T09:40:51Z"},"message":"Make advanced reasoning selection explicit in the TUI (#32746)\n\n## Why\n\n`Max` and `Ultra` consume usage limits faster than standard reasoning levels, so they should not be selected accidentally while navigating the normal effort scale.\n\n## What changed\n\n- Move `Max` and `Ultra` behind a `More reasoning…` entry with a dedicated warning and descriptions.\n- Keep the reasoning shortcuts from silently increasing into advanced efforts.\n- Apply `Ultra` to the active conversation without changing defaults for new threads, while preserving it across mode switches and thread resumes.\n- Record applied thread settings in thread metadata, including explicit clearing of reasoning effort, so resumed threads restore their latest model settings unless the user supplied an override.\n\n## Testing\n\n- Add TUI coverage for the advanced picker, shortcuts, Plan mode, configuration defaults, and resumed conversations.\n- Add app-server and thread-store coverage for persisting, clearing, and restoring model and reasoning settings.\n\nGitOrigin-RevId: 6708c7c2e8d38f491bf63000ea34f83476afdfe6","tree":{"sha":"47813f1115d1c819104c827df005b32d28a840a5","url":"https://api.github.com/repos/openai/codex/git/trees/47813f1115d1c819104c827df005b32d28a840a5"},"url":"https://api.github.com/repos/openai/codex/git/commits/769a5de257e8b38204329263e3781c043f3f618d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/769a5de257e8b38204329263e3781c043f3f618d","html_url":"https://github.com/openai/codex/commit/769a5de257e8b38204329263e3781c043f3f618d","comments_url":"https://api.github.com/repos/openai/codex/commits/769a5de257e8b38204329263e3781c043f3f618d/comments","author":{"login":"fcoury-oai","id":272635208,"node_id":"U_kgDOEEAVSA","avatar_url":"https://avatars.githubusercontent.com/u/272635208?v=4","gravatar_id":"","url":"https://api.github.com/users/fcoury-oai","html_url":"https://github.com/fcoury-oai","followers_url":"https://api.github.com/users/fcoury-oai/followers","following_url":"https://api.github.com/users/fcoury-oai/following{/other_user}","gists_url":"https://api.github.com/users/fcoury-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/fcoury-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fcoury-oai/subscriptions","organizations_url":"https://api.github.com/users/fcoury-oai/orgs","repos_url":"https://api.github.com/users/fcoury-oai/repos","events_url":"https://api.github.com/users/fcoury-oai/events{/privacy}","received_events_url":"https://api.github.com/users/fcoury-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"2a4942c08199678dd204ec18bd839146decd75d9","url":"https://api.github.com/repos/openai/codex/commits/2a4942c08199678dd204ec18bd839146decd75d9","html_url":"https://github.com/openai/codex/commit/2a4942c08199678dd204ec18bd839146decd75d9"}]},{"sha":"2a4942c08199678dd204ec18bd839146decd75d9","node_id":"C_kwDOOYsS4doAKDJhNDk0MmMwODE5OTY3OGRkMjA0ZWMxOGJkODM5MTQ2ZGVjZDc1ZDk","commit":{"author":{"name":"rhan-oai","email":"rhan@openai.com","date":"2026-07-13T03:27:48Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T09:36:31Z"},"message":"Log missing personality messages at trace level (#32744)\n\n## What changed\n\nEmit the diagnostic for a requested personality without model-specific messages\nat `trace` instead of `warn`. The existing fallback to `base_instructions` is\nunchanged.\n\nGitOrigin-RevId: f7a00d28b57d4a6513df5d43c9456ae9b16c738b","tree":{"sha":"6c3a971052e425af6132cef5359d1ff582f770ee","url":"https://api.github.com/repos/openai/codex/git/trees/6c3a971052e425af6132cef5359d1ff582f770ee"},"url":"https://api.github.com/repos/openai/codex/git/commits/2a4942c08199678dd204ec18bd839146decd75d9","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/2a4942c08199678dd204ec18bd839146decd75d9","html_url":"https://github.com/openai/codex/commit/2a4942c08199678dd204ec18bd839146decd75d9","comments_url":"https://api.github.com/repos/openai/codex/commits/2a4942c08199678dd204ec18bd839146decd75d9/comments","author":{"login":"rhan-oai","id":214716640,"node_id":"U_kgDODMxQ4A","avatar_url":"https://avatars.githubusercontent.com/u/214716640?v=4","gravatar_id":"","url":"https://api.github.com/users/rhan-oai","html_url":"https://github.com/rhan-oai","followers_url":"https://api.github.com/users/rhan-oai/followers","following_url":"https://api.github.com/users/rhan-oai/following{/other_user}","gists_url":"https://api.github.com/users/rhan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rhan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rhan-oai/subscriptions","organizations_url":"https://api.github.com/users/rhan-oai/orgs","repos_url":"https://api.github.com/users/rhan-oai/repos","events_url":"https://api.github.com/users/rhan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rhan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"2f7d89b1419bf7064346855b0acde23514b1ebc5","url":"https://api.github.com/repos/openai/codex/commits/2f7d89b1419bf7064346855b0acde23514b1ebc5","html_url":"https://github.com/openai/codex/commit/2f7d89b1419bf7064346855b0acde23514b1ebc5"}]},{"sha":"2f7d89b1419bf7064346855b0acde23514b1ebc5","node_id":"C_kwDOOYsS4doAKDJmN2Q4OWIxNDE5YmY3MDY0MzQ2ODU1YjBhY2RlMjM1MTRiMWViYzU","commit":{"author":{"name":"Matthew Zeng","email":"mzeng@openai.com","date":"2026-07-13T02:17:14Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-13T05:02:52Z"},"message":"Extract connector runtime snapshot management (#32698)\n\n## What changed\n\n- Move the Codex Apps tool cache into a reusable `codex-connectors` runtime manager keyed by account and workspace.\n- Represent cached tools as atomically published snapshots with refresh timestamps while preserving the newest accepted fetch generation.\n- Harden disk persistence with bounded reads, atomic file replacement, and serialized writes so an older fetch cannot overwrite newer state.\n\n## Testing\n\nAdd coverage for identity isolation, snapshot timestamps, oversized cache files, atomic replacement, and concurrent persistence ordering.\n\nGitOrigin-RevId: 5ea2234469daae3abf54b030244c3251de62ca5a","tree":{"sha":"2896c4ccf6e484a26c7392b83e08597b83cea847","url":"https://api.github.com/repos/openai/codex/git/trees/2896c4ccf6e484a26c7392b83e08597b83cea847"},"url":"https://api.github.com/repos/openai/codex/git/commits/2f7d89b1419bf7064346855b0acde23514b1ebc5","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/2f7d89b1419bf7064346855b0acde23514b1ebc5","html_url":"https://github.com/openai/codex/commit/2f7d89b1419bf7064346855b0acde23514b1ebc5","comments_url":"https://api.github.com/repos/openai/codex/commits/2f7d89b1419bf7064346855b0acde23514b1ebc5/comments","author":{"login":"mzeng-openai","id":175741029,"node_id":"U_kgDOCnmYZQ","avatar_url":"https://avatars.githubusercontent.com/u/175741029?v=4","gravatar_id":"","url":"https://api.github.com/users/mzeng-openai","html_url":"https://github.com/mzeng-openai","followers_url":"https://api.github.com/users/mzeng-openai/followers","following_url":"https://api.github.com/users/mzeng-openai/following{/other_user}","gists_url":"https://api.github.com/users/mzeng-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/mzeng-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mzeng-openai/subscriptions","organizations_url":"https://api.github.com/users/mzeng-openai/orgs","repos_url":"https://api.github.com/users/mzeng-openai/repos","events_url":"https://api.github.com/users/mzeng-openai/events{/privacy}","received_events_url":"https://api.github.com/users/mzeng-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c888e8e75a9f0e90ce7d5517f8b9540832cbbf76","url":"https://api.github.com/repos/openai/codex/commits/c888e8e75a9f0e90ce7d5517f8b9540832cbbf76","html_url":"https://github.com/openai/codex/commit/c888e8e75a9f0e90ce7d5517f8b9540832cbbf76"}]},{"sha":"c888e8e75a9f0e90ce7d5517f8b9540832cbbf76","node_id":"C_kwDOOYsS4doAKGM4ODhlOGU3NWE5ZjBlOTBjZTdkNTUxN2Y4Yjk1NDA4MzJjYmJmNzY","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-07-12T19:14:15Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-12T19:18:37Z"},"message":"Improve composer completion target resolution (#32628)\n\n## What changed\n\n- Resolve `@` and `$` completion targets on either side of the cursor while treating atomic text elements and line breaks as boundaries.\n- Prefer the nearest editable mention when file, skill, and plugin candidates compete, and avoid treating common uppercase environment variables as skill queries.\n- Insert a separator before completions adjacent to atomic elements and keep dismissed popup state scoped to the matching editable token occurrence.\n\n## Testing\n\n- Add unit and snapshot coverage for adjacent and partially bound mentions, whitespace boundaries, shell variables, popup dismissal, and file, image, skill, and plugin insertion.\n\nGitOrigin-RevId: 352a42c7bcdbf4f6cd35368ced25f71926fdbc1b","tree":{"sha":"3789d3d1ee9dd742cbec8aec9e9d4b18323c6353","url":"https://api.github.com/repos/openai/codex/git/trees/3789d3d1ee9dd742cbec8aec9e9d4b18323c6353"},"url":"https://api.github.com/repos/openai/codex/git/commits/c888e8e75a9f0e90ce7d5517f8b9540832cbbf76","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c888e8e75a9f0e90ce7d5517f8b9540832cbbf76","html_url":"https://github.com/openai/codex/commit/c888e8e75a9f0e90ce7d5517f8b9540832cbbf76","comments_url":"https://api.github.com/repos/openai/codex/commits/c888e8e75a9f0e90ce7d5517f8b9540832cbbf76/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"9e552e9d15ba52bed7077d5357f3e18e330f8f38","url":"https://api.github.com/repos/openai/codex/commits/9e552e9d15ba52bed7077d5357f3e18e330f8f38","html_url":"https://github.com/openai/codex/commit/9e552e9d15ba52bed7077d5357f3e18e330f8f38"}]},{"sha":"9e552e9d15ba52bed7077d5357f3e18e330f8f38","node_id":"C_kwDOOYsS4doAKDllNTUyZTlkMTViYTUyYmVkNzA3N2Q1MzU3ZjNlMThlMzMwZjhmMzg","commit":{"author":{"name":"Felipe Coury","email":"felipe.coury@openai.com","date":"2026-07-11T20:59:03Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-11T21:03:12Z"},"message":"Use available width for skill names in the toggle view (#32485)\n\n## Why\n\nThe skill toggle view truncated every display name to 21 characters, even when\nthe popup had enough room to show more. This could hide the part that\ndistinguishes similarly named skills.\n\n## What changed\n\n- Pass full skill display names to the shared row renderer so it can fit them\n  to the available width alongside descriptions.\n- Keep narrow layouts bounded by the renderer's width-aware truncation.\n\n## Testing\n\nAdded coverage for preserving and filtering full display names, plus snapshots\nfor wide and narrow popup layouts.\n\nGitOrigin-RevId: c434237e00440f920d8aa9c365b6bda5e68e0941","tree":{"sha":"b7b7d71053958e789505df2e36d98683245e6b02","url":"https://api.github.com/repos/openai/codex/git/trees/b7b7d71053958e789505df2e36d98683245e6b02"},"url":"https://api.github.com/repos/openai/codex/git/commits/9e552e9d15ba52bed7077d5357f3e18e330f8f38","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/9e552e9d15ba52bed7077d5357f3e18e330f8f38","html_url":"https://github.com/openai/codex/commit/9e552e9d15ba52bed7077d5357f3e18e330f8f38","comments_url":"https://api.github.com/repos/openai/codex/commits/9e552e9d15ba52bed7077d5357f3e18e330f8f38/comments","author":{"login":"fcoury-oai","id":272635208,"node_id":"U_kgDOEEAVSA","avatar_url":"https://avatars.githubusercontent.com/u/272635208?v=4","gravatar_id":"","url":"https://api.github.com/users/fcoury-oai","html_url":"https://github.com/fcoury-oai","followers_url":"https://api.github.com/users/fcoury-oai/followers","following_url":"https://api.github.com/users/fcoury-oai/following{/other_user}","gists_url":"https://api.github.com/users/fcoury-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/fcoury-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fcoury-oai/subscriptions","organizations_url":"https://api.github.com/users/fcoury-oai/orgs","repos_url":"https://api.github.com/users/fcoury-oai/repos","events_url":"https://api.github.com/users/fcoury-oai/events{/privacy}","received_events_url":"https://api.github.com/users/fcoury-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"385c0a9351e2199929e01f7864ec78a8f7d5e580","url":"https://api.github.com/repos/openai/codex/commits/385c0a9351e2199929e01f7864ec78a8f7d5e580","html_url":"https://github.com/openai/codex/commit/385c0a9351e2199929e01f7864ec78a8f7d5e580"}]},{"sha":"385c0a9351e2199929e01f7864ec78a8f7d5e580","node_id":"C_kwDOOYsS4doAKDM4NWMwYTkzNTFlMjE5OTkyOWUwMWY3ODY0ZWM3OGE4ZjdkNWU1ODA","commit":{"author":{"name":"Felipe Coury","email":"felipe.coury@openai.com","date":"2026-07-11T17:40:57Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-11T17:47:17Z"},"message":"Expand tabs when rendering TUI diffs (#32461)\n\n## What changed\n\n- Replace tab characters in rendered diff spans with four spaces while keeping\n  their wrapping width and style intact.\n- Ensure diff buffers never contain literal tab characters.\n\n## Testing\n\n- Cover tab expansion and wrapping in `wrap_styled_spans`.\n- Update diff gallery snapshots at multiple terminal sizes.\n\nGitOrigin-RevId: 2159e84991b844ea8c4c57dfad52bc3fe7a9059f","tree":{"sha":"93dc89930801de75865d1f0b7521f9dd86fd8b00","url":"https://api.github.com/repos/openai/codex/git/trees/93dc89930801de75865d1f0b7521f9dd86fd8b00"},"url":"https://api.github.com/repos/openai/codex/git/commits/385c0a9351e2199929e01f7864ec78a8f7d5e580","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/385c0a9351e2199929e01f7864ec78a8f7d5e580","html_url":"https://github.com/openai/codex/commit/385c0a9351e2199929e01f7864ec78a8f7d5e580","comments_url":"https://api.github.com/repos/openai/codex/commits/385c0a9351e2199929e01f7864ec78a8f7d5e580/comments","author":{"login":"fcoury-oai","id":272635208,"node_id":"U_kgDOEEAVSA","avatar_url":"https://avatars.githubusercontent.com/u/272635208?v=4","gravatar_id":"","url":"https://api.github.com/users/fcoury-oai","html_url":"https://github.com/fcoury-oai","followers_url":"https://api.github.com/users/fcoury-oai/followers","following_url":"https://api.github.com/users/fcoury-oai/following{/other_user}","gists_url":"https://api.github.com/users/fcoury-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/fcoury-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fcoury-oai/subscriptions","organizations_url":"https://api.github.com/users/fcoury-oai/orgs","repos_url":"https://api.github.com/users/fcoury-oai/repos","events_url":"https://api.github.com/users/fcoury-oai/events{/privacy}","received_events_url":"https://api.github.com/users/fcoury-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"bbdf3030dec1e7894cbe58051076ea66d2c9208f","url":"https://api.github.com/repos/openai/codex/commits/bbdf3030dec1e7894cbe58051076ea66d2c9208f","html_url":"https://github.com/openai/codex/commit/bbdf3030dec1e7894cbe58051076ea66d2c9208f"}]},{"sha":"bbdf3030dec1e7894cbe58051076ea66d2c9208f","node_id":"C_kwDOOYsS4doAKGJiZGYzMDMwZGVjMWU3ODk0Y2JlNTgwNTEwNzZlYTY2ZDJjOTIwOGY","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-07-11T17:08:53Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-11T17:13:16Z"},"message":"Emit thread-idle lifecycle after guardian interrupts (#32460)\n\n## What changed\n\n- Emit the thread-idle extension lifecycle when the guardian successfully aborts an active turn after repeated automatic review denials.\n- Keep user-initiated interrupt behavior unchanged.\n- Add a regression test that waits for the thread-idle callback after a guardian interrupt.\n\nGitOrigin-RevId: 6622c35361a3da9126c11bd6ca49a532c1bd6e27","tree":{"sha":"2c981e18133bb1ef365159162114974cdccaeafd","url":"https://api.github.com/repos/openai/codex/git/trees/2c981e18133bb1ef365159162114974cdccaeafd"},"url":"https://api.github.com/repos/openai/codex/git/commits/bbdf3030dec1e7894cbe58051076ea66d2c9208f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/bbdf3030dec1e7894cbe58051076ea66d2c9208f","html_url":"https://github.com/openai/codex/commit/bbdf3030dec1e7894cbe58051076ea66d2c9208f","comments_url":"https://api.github.com/repos/openai/codex/commits/bbdf3030dec1e7894cbe58051076ea66d2c9208f/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"54b8f112a3815ead40ebcd50f9c2f2fc786e26fb","url":"https://api.github.com/repos/openai/codex/commits/54b8f112a3815ead40ebcd50f9c2f2fc786e26fb","html_url":"https://github.com/openai/codex/commit/54b8f112a3815ead40ebcd50f9c2f2fc786e26fb"}]},{"sha":"54b8f112a3815ead40ebcd50f9c2f2fc786e26fb","node_id":"C_kwDOOYsS4doAKDU0YjhmMTEyYTM4MTVlYWQ0MGViY2Q1MGY5YzJmMmZjNzg2ZTI2ZmI","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-07-11T15:16:32Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-11T15:20:49Z"},"message":"Preserve parent sandbox enforcement for memory consolidation (#32441)\n\n## What changed\n\n- Pass the parent turn's effective permission profile to the memory consolidation agent, including thread-level permission and legacy sandbox overrides.\n- Preserve disabled and externally enforced permission profiles instead of replacing them with a managed sandbox.\n- Continue restricting consolidation to the memory root without network access when the parent uses Codex-managed permissions.\n\n## Testing\n\n- Add coverage for disabled, external, and managed parent permission profiles.\n\nGitOrigin-RevId: 9ca3be0e41dc14d858053f6f70e33f4ae7c578e1","tree":{"sha":"3763b5a94c11e1d772a3b03d6fa5bf5d8610ed00","url":"https://api.github.com/repos/openai/codex/git/trees/3763b5a94c11e1d772a3b03d6fa5bf5d8610ed00"},"url":"https://api.github.com/repos/openai/codex/git/commits/54b8f112a3815ead40ebcd50f9c2f2fc786e26fb","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/54b8f112a3815ead40ebcd50f9c2f2fc786e26fb","html_url":"https://github.com/openai/codex/commit/54b8f112a3815ead40ebcd50f9c2f2fc786e26fb","comments_url":"https://api.github.com/repos/openai/codex/commits/54b8f112a3815ead40ebcd50f9c2f2fc786e26fb/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"5c19155cbd93bfa099016e7487259f61669823ff","url":"https://api.github.com/repos/openai/codex/commits/5c19155cbd93bfa099016e7487259f61669823ff","html_url":"https://github.com/openai/codex/commit/5c19155cbd93bfa099016e7487259f61669823ff"}]},{"sha":"5c19155cbd93bfa099016e7487259f61669823ff","node_id":"C_kwDOOYsS4doAKDVjMTkxNTVjYmQ5M2JmYTA5OTAxNmU3NDg3MjU5ZjYxNjY5ODIzZmY","commit":{"author":{"name":"Owen Lin","email":"owen@openai.com","date":"2026-07-11T04:10:53Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-11T04:15:42Z"},"message":"Add ordinals to paginated rollout records (#32332)\n\n## Why\n\nPaginated thread history needs durable ordering so consumers can process a rollout suffix without rebuilding all earlier history.\n\n## What changed\n\n- Add optional, zero-based ordinals to `RolloutLine` records in paginated rollouts while leaving legacy rollout serialization unchanged.\n- Continue ordinals from the last valid record when appending or resuming, including after gaps or an incomplete tail, and reject overflow without appending.\n- Add a stateless `project_rollout_line` helper that maps canonical turn lifecycle and completed-item records into thread-history change sets.\n\n## Testing\n\n- Cover ordinal assignment, legacy compatibility, resume and tail recovery, overflow handling, and thread-history projection for completed, failed, and interrupted turns.\n\nGitOrigin-RevId: 3a9bb6cd2a1f674a9f154342e96e9aa3d8330781","tree":{"sha":"e4b7749de1aab51bbc724733d5bb22338714a292","url":"https://api.github.com/repos/openai/codex/git/trees/e4b7749de1aab51bbc724733d5bb22338714a292"},"url":"https://api.github.com/repos/openai/codex/git/commits/5c19155cbd93bfa099016e7487259f61669823ff","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/5c19155cbd93bfa099016e7487259f61669823ff","html_url":"https://github.com/openai/codex/commit/5c19155cbd93bfa099016e7487259f61669823ff","comments_url":"https://api.github.com/repos/openai/codex/commits/5c19155cbd93bfa099016e7487259f61669823ff/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"f93c18ed0f57151b410d25e8e1dff4408440560f","url":"https://api.github.com/repos/openai/codex/commits/f93c18ed0f57151b410d25e8e1dff4408440560f","html_url":"https://github.com/openai/codex/commit/f93c18ed0f57151b410d25e8e1dff4408440560f"}]},{"sha":"f93c18ed0f57151b410d25e8e1dff4408440560f","node_id":"C_kwDOOYsS4doAKGY5M2MxOGVkMGY1NzE1MWI0MTBkMjVlOGUxZGZmNDQwODQ0MDU2MGY","commit":{"author":{"name":"Michael Bolin","email":"mbolin@openai.com","date":"2026-07-11T03:23:35Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-11T03:27:51Z"},"message":"Use canonical links in the moved config notice (#32326)\n\n## What changed\n\nUpdate the links in `codex-rs/config.md` to point directly to the configuration documentation on GitHub, including the MCP servers section.\n\nGitOrigin-RevId: 8bf830b7062f83e44b5121dd11b1f1a20bb68e43","tree":{"sha":"8c821a82051cbf8da7f943f6edf829dc4bdc87ce","url":"https://api.github.com/repos/openai/codex/git/trees/8c821a82051cbf8da7f943f6edf829dc4bdc87ce"},"url":"https://api.github.com/repos/openai/codex/git/commits/f93c18ed0f57151b410d25e8e1dff4408440560f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/f93c18ed0f57151b410d25e8e1dff4408440560f","html_url":"https://github.com/openai/codex/commit/f93c18ed0f57151b410d25e8e1dff4408440560f","comments_url":"https://api.github.com/repos/openai/codex/commits/f93c18ed0f57151b410d25e8e1dff4408440560f/comments","author":{"login":"bolinfest","id":655869,"node_id":"MDQ6VXNlcjY1NTg2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/655869?v=4","gravatar_id":"","url":"https://api.github.com/users/bolinfest","html_url":"https://github.com/bolinfest","followers_url":"https://api.github.com/users/bolinfest/followers","following_url":"https://api.github.com/users/bolinfest/following{/other_user}","gists_url":"https://api.github.com/users/bolinfest/gists{/gist_id}","starred_url":"https://api.github.com/users/bolinfest/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bolinfest/subscriptions","organizations_url":"https://api.github.com/users/bolinfest/orgs","repos_url":"https://api.github.com/users/bolinfest/repos","events_url":"https://api.github.com/users/bolinfest/events{/privacy}","received_events_url":"https://api.github.com/users/bolinfest/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"203d530cc611c642cb0aa687585d6c3575caa925","url":"https://api.github.com/repos/openai/codex/commits/203d530cc611c642cb0aa687585d6c3575caa925","html_url":"https://github.com/openai/codex/commit/203d530cc611c642cb0aa687585d6c3575caa925"}]},{"sha":"203d530cc611c642cb0aa687585d6c3575caa925","node_id":"C_kwDOOYsS4doAKDIwM2Q1MzBjYzYxMWM2NDJjYjBhYTY4NzU4NWQ2YzM1NzVjYWE5MjU","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-07-11T02:55:06Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-11T03:01:18Z"},"message":"Stop falling back to older model availability announcements (#32316)\n\n## What changed\n\nSelect the first model availability announcement in catalog order before\nchecking its display count. Once that announcement reaches its display limit,\nshow no announcement instead of falling back to a lower-priority model.\n\n## Testing\n\n- Update the model catalog test to verify that an exhausted higher-priority\n  announcement does not expose an older announcement.\n\nGitOrigin-RevId: 65f23b34e1ecb38934effd5305704d7ab2353492","tree":{"sha":"5d67dfb87d2dbc37dd6487e9110237802a3eb850","url":"https://api.github.com/repos/openai/codex/git/trees/5d67dfb87d2dbc37dd6487e9110237802a3eb850"},"url":"https://api.github.com/repos/openai/codex/git/commits/203d530cc611c642cb0aa687585d6c3575caa925","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/203d530cc611c642cb0aa687585d6c3575caa925","html_url":"https://github.com/openai/codex/commit/203d530cc611c642cb0aa687585d6c3575caa925","comments_url":"https://api.github.com/repos/openai/codex/commits/203d530cc611c642cb0aa687585d6c3575caa925/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c9d52de5ca52a6b4439e7c0f69b34f6331926bb4","url":"https://api.github.com/repos/openai/codex/commits/c9d52de5ca52a6b4439e7c0f69b34f6331926bb4","html_url":"https://github.com/openai/codex/commit/c9d52de5ca52a6b4439e7c0f69b34f6331926bb4"}]},{"sha":"c9d52de5ca52a6b4439e7c0f69b34f6331926bb4","node_id":"C_kwDOOYsS4doAKGM5ZDUyZGU1Y2E1MmE2YjQ0MzllN2MwZjY5YjM0ZjYzMzE5MjZiYjQ","commit":{"author":{"name":"pakrym-oai","email":"pakrym@openai.com","date":"2026-07-11T02:24:09Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-11T02:29:14Z"},"message":"Require prefixes for outbound response item IDs (#32312)\n\n## What changed\n\n- Add a `ResponseItemId` type that generates item-specific prefixes with UUIDv7 suffixes and use it across response items.\n- Keep deserialization permissive for legacy histories, but omit empty or unprefixed item IDs from HTTP and WebSocket requests.\n- Export the new type in the generated TypeScript protocol schema.\n\n## Testing\n\n- Cover prefixed ID generation, legacy deserialization, prefix recognition, and outbound request filtering.\n\nGitOrigin-RevId: 0209fe430c826d0ae88bc4648652c4ebf390c4a4","tree":{"sha":"4f340bf469d3a8e29bfdf91cca883f976adc0775","url":"https://api.github.com/repos/openai/codex/git/trees/4f340bf469d3a8e29bfdf91cca883f976adc0775"},"url":"https://api.github.com/repos/openai/codex/git/commits/c9d52de5ca52a6b4439e7c0f69b34f6331926bb4","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c9d52de5ca52a6b4439e7c0f69b34f6331926bb4","html_url":"https://github.com/openai/codex/commit/c9d52de5ca52a6b4439e7c0f69b34f6331926bb4","comments_url":"https://api.github.com/repos/openai/codex/commits/c9d52de5ca52a6b4439e7c0f69b34f6331926bb4/comments","author":{"login":"pakrym-oai","id":204937752,"node_id":"U_kgDODDcaGA","avatar_url":"https://avatars.githubusercontent.com/u/204937752?v=4","gravatar_id":"","url":"https://api.github.com/users/pakrym-oai","html_url":"https://github.com/pakrym-oai","followers_url":"https://api.github.com/users/pakrym-oai/followers","following_url":"https://api.github.com/users/pakrym-oai/following{/other_user}","gists_url":"https://api.github.com/users/pakrym-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/pakrym-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pakrym-oai/subscriptions","organizations_url":"https://api.github.com/users/pakrym-oai/orgs","repos_url":"https://api.github.com/users/pakrym-oai/repos","events_url":"https://api.github.com/users/pakrym-oai/events{/privacy}","received_events_url":"https://api.github.com/users/pakrym-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"08ba14b03d0b3ce3cfdf8c88c0469b9b1924953d","url":"https://api.github.com/repos/openai/codex/commits/08ba14b03d0b3ce3cfdf8c88c0469b9b1924953d","html_url":"https://github.com/openai/codex/commit/08ba14b03d0b3ce3cfdf8c88c0469b9b1924953d"}]},{"sha":"08ba14b03d0b3ce3cfdf8c88c0469b9b1924953d","node_id":"C_kwDOOYsS4doAKDA4YmExNGIwM2QwYjNjZTNjZmRmOGM4OGMwNDY5YjliMTkyNDk1M2Q","commit":{"author":{"name":"Colin Young","email":"ccy@openai.com","date":"2026-07-11T01:42:01Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-11T01:46:27Z"},"message":"Improve file blob upload diagnostics (#32305)\n\n## Why\n\nBlob upload failures previously surfaced the full signed upload URL and offered limited information for diagnosing transport and service errors.\n\n## What changed\n\n- Add a unique `x-ms-client-request-id` to each blob upload.\n- Report transport failures with the upload host, elapsed time, error category, and client request ID, while stripping the signed URL from the underlying error.\n- Report unsuccessful responses with Azure request and error IDs, and emit structured warning events with upload metadata and available Azure and Cloudflare identifiers.\n\n## Testing\n\n- Verify successful uploads include the client request ID header.\n- Verify response and transport errors expose diagnostic fields without leaking signed URL parameters or response bodies.\n\nGitOrigin-RevId: 9ae2cb2a9aacec4df237b3ee79a6467a6b9107e7","tree":{"sha":"f0579dc5a3c1ebe017cc9ce4ada7d4e33673a9dd","url":"https://api.github.com/repos/openai/codex/git/trees/f0579dc5a3c1ebe017cc9ce4ada7d4e33673a9dd"},"url":"https://api.github.com/repos/openai/codex/git/commits/08ba14b03d0b3ce3cfdf8c88c0469b9b1924953d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/08ba14b03d0b3ce3cfdf8c88c0469b9b1924953d","html_url":"https://github.com/openai/codex/commit/08ba14b03d0b3ce3cfdf8c88c0469b9b1924953d","comments_url":"https://api.github.com/repos/openai/codex/commits/08ba14b03d0b3ce3cfdf8c88c0469b9b1924953d/comments","author":{"login":"ccy-oai","id":232670335,"node_id":"U_kgDODd5Efw","avatar_url":"https://avatars.githubusercontent.com/u/232670335?v=4","gravatar_id":"","url":"https://api.github.com/users/ccy-oai","html_url":"https://github.com/ccy-oai","followers_url":"https://api.github.com/users/ccy-oai/followers","following_url":"https://api.github.com/users/ccy-oai/following{/other_user}","gists_url":"https://api.github.com/users/ccy-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/ccy-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ccy-oai/subscriptions","organizations_url":"https://api.github.com/users/ccy-oai/orgs","repos_url":"https://api.github.com/users/ccy-oai/repos","events_url":"https://api.github.com/users/ccy-oai/events{/privacy}","received_events_url":"https://api.github.com/users/ccy-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"dfefd8aa8bc267ee42e1800b9b94da860a5ec37b","url":"https://api.github.com/repos/openai/codex/commits/dfefd8aa8bc267ee42e1800b9b94da860a5ec37b","html_url":"https://github.com/openai/codex/commit/dfefd8aa8bc267ee42e1800b9b94da860a5ec37b"}]},{"sha":"dfefd8aa8bc267ee42e1800b9b94da860a5ec37b","node_id":"C_kwDOOYsS4doAKGRmZWZkOGFhOGJjMjY3ZWU0MmUxODAwYjliOTRkYTg2MGE1ZWMzN2I","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-07-11T01:08:00Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-11T01:15:48Z"},"message":"Prefer the Codex home socket for Unix IDE context (#32302)\n\n## What changed\n\n- Look for the Unix IDE context socket at `CODEX_HOME/ipc/ipc.sock` first.\n- Fall back to the existing per-user temp-directory socket paths, including both legacy paths for UID 0.\n- Apply one request deadline across all connection attempts, and stop fallback after a timeout or a protocol error on a connected socket.\n\n## Testing\n\n- Added coverage for socket path selection, primary preference, legacy fallbacks, and timeout and protocol-error behavior.\n\nGitOrigin-RevId: 560c827ad3d446a82ec503779995757096ac33e0","tree":{"sha":"0121674ab068d281381ebb111f1eee6679dcd69d","url":"https://api.github.com/repos/openai/codex/git/trees/0121674ab068d281381ebb111f1eee6679dcd69d"},"url":"https://api.github.com/repos/openai/codex/git/commits/dfefd8aa8bc267ee42e1800b9b94da860a5ec37b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/dfefd8aa8bc267ee42e1800b9b94da860a5ec37b","html_url":"https://github.com/openai/codex/commit/dfefd8aa8bc267ee42e1800b9b94da860a5ec37b","comments_url":"https://api.github.com/repos/openai/codex/commits/dfefd8aa8bc267ee42e1800b9b94da860a5ec37b/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"076a110eb83445fd33fcd40f9a70f3ad84120f76","url":"https://api.github.com/repos/openai/codex/commits/076a110eb83445fd33fcd40f9a70f3ad84120f76","html_url":"https://github.com/openai/codex/commit/076a110eb83445fd33fcd40f9a70f3ad84120f76"}]},{"sha":"076a110eb83445fd33fcd40f9a70f3ad84120f76","node_id":"C_kwDOOYsS4doAKDA3NmExMTBlYjgzNDQ1ZmQzM2ZjZDQwZjlhNzBmM2FkODQxMjBmNzY","commit":{"author":{"name":"Abhinav","email":"abhinav@openai.com","date":"2026-07-11T01:07:12Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-11T01:11:37Z"},"message":"Trust hooks from materialized workspace plugins (#32301)\n\n## What changed\n\n- Carry newly installed or updated remote plugin metadata through effective-plugin refresh callbacks, including coalesced refreshes.\n- After a successful refresh, record the current hook hashes for listed workspace plugins associated with the active account while preserving existing hook settings and unrelated state.\n- Serialize the background trust write with config mutations, and leave hooks untrusted if the write fails or the active account changes.\n\n## Testing\n\n- Cover eligible plugin selection and escaped hook config keys.\n- Verify end-to-end trust for newly materialized plugin hooks, preservation of existing config, and fail-closed behavior when config cannot be written.\n\nGitOrigin-RevId: 0b150766415be6fccc117f7856a241e10ad456f2","tree":{"sha":"8be74d284241bf4eada0cfcbaa968c5541cf63fc","url":"https://api.github.com/repos/openai/codex/git/trees/8be74d284241bf4eada0cfcbaa968c5541cf63fc"},"url":"https://api.github.com/repos/openai/codex/git/commits/076a110eb83445fd33fcd40f9a70f3ad84120f76","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/076a110eb83445fd33fcd40f9a70f3ad84120f76","html_url":"https://github.com/openai/codex/commit/076a110eb83445fd33fcd40f9a70f3ad84120f76","comments_url":"https://api.github.com/repos/openai/codex/commits/076a110eb83445fd33fcd40f9a70f3ad84120f76/comments","author":{"login":"abhinav-oai","id":274334565,"node_id":"U_kgDOEFoDZQ","avatar_url":"https://avatars.githubusercontent.com/u/274334565?v=4","gravatar_id":"","url":"https://api.github.com/users/abhinav-oai","html_url":"https://github.com/abhinav-oai","followers_url":"https://api.github.com/users/abhinav-oai/followers","following_url":"https://api.github.com/users/abhinav-oai/following{/other_user}","gists_url":"https://api.github.com/users/abhinav-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/abhinav-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abhinav-oai/subscriptions","organizations_url":"https://api.github.com/users/abhinav-oai/orgs","repos_url":"https://api.github.com/users/abhinav-oai/repos","events_url":"https://api.github.com/users/abhinav-oai/events{/privacy}","received_events_url":"https://api.github.com/users/abhinav-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"dffe1f02a3c4849478c4f412a69d25af2e6b9359","url":"https://api.github.com/repos/openai/codex/commits/dffe1f02a3c4849478c4f412a69d25af2e6b9359","html_url":"https://github.com/openai/codex/commit/dffe1f02a3c4849478c4f412a69d25af2e6b9359"}]},{"sha":"dffe1f02a3c4849478c4f412a69d25af2e6b9359","node_id":"C_kwDOOYsS4doAKGRmZmUxZjAyYTNjNDg0OTQ3OGM0ZjQxMmE2OWQyNWFmMmU2YjkzNTk","commit":{"author":{"name":"Felipe Coury","email":"felipe.coury@openai.com","date":"2026-07-10T23:34:45Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T23:39:21Z"},"message":"Respect model support for reasoning summaries (#32290)\n\n## What changed\n\n- Add `supports_reasoning_summary_parameter` to model metadata, defaulting to\n  `true` for backward compatibility.\n- Omit `reasoning.summary` and its summary-delivery stream option when the\n  selected model does not support the parameter.\n- Apply the capability of the final selected model when a spawned agent uses a\n  different model.\n\n## Testing\n\n- Cover unsupported models in regular requests and spawned-agent model\n  overrides.\n\nGitOrigin-RevId: 72b783799fc0685cef1501ef2dbf62d1308ceead","tree":{"sha":"ad001d168f192824341966625b23d5de3f1d748a","url":"https://api.github.com/repos/openai/codex/git/trees/ad001d168f192824341966625b23d5de3f1d748a"},"url":"https://api.github.com/repos/openai/codex/git/commits/dffe1f02a3c4849478c4f412a69d25af2e6b9359","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/dffe1f02a3c4849478c4f412a69d25af2e6b9359","html_url":"https://github.com/openai/codex/commit/dffe1f02a3c4849478c4f412a69d25af2e6b9359","comments_url":"https://api.github.com/repos/openai/codex/commits/dffe1f02a3c4849478c4f412a69d25af2e6b9359/comments","author":{"login":"fcoury-oai","id":272635208,"node_id":"U_kgDOEEAVSA","avatar_url":"https://avatars.githubusercontent.com/u/272635208?v=4","gravatar_id":"","url":"https://api.github.com/users/fcoury-oai","html_url":"https://github.com/fcoury-oai","followers_url":"https://api.github.com/users/fcoury-oai/followers","following_url":"https://api.github.com/users/fcoury-oai/following{/other_user}","gists_url":"https://api.github.com/users/fcoury-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/fcoury-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fcoury-oai/subscriptions","organizations_url":"https://api.github.com/users/fcoury-oai/orgs","repos_url":"https://api.github.com/users/fcoury-oai/repos","events_url":"https://api.github.com/users/fcoury-oai/events{/privacy}","received_events_url":"https://api.github.com/users/fcoury-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"bfe31598c79bd2e5b9089030ae7f2978457015c8","url":"https://api.github.com/repos/openai/codex/commits/bfe31598c79bd2e5b9089030ae7f2978457015c8","html_url":"https://github.com/openai/codex/commit/bfe31598c79bd2e5b9089030ae7f2978457015c8"}]},{"sha":"bfe31598c79bd2e5b9089030ae7f2978457015c8","node_id":"C_kwDOOYsS4doAKGJmZTMxNTk4Yzc5YmQyZTViOTA4OTAzMGFlN2YyOTc4NDU3MDE1Yzg","commit":{"author":{"name":"Owen Lin","email":"owen@openai.com","date":"2026-07-10T23:21:23Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T23:26:58Z"},"message":"Persist paginated items in the local thread store (#32289)\n\n## What changed\n\n- Allow the local thread store to create paginated threads while keeping them unsupported through the app-server API.\n- Filter live append items using the history mode recorded with the thread's live recorder, so paginated threads persist canonical `ItemCompleted` events instead of legacy history events.\n\n## Testing\n\n- Add a local-store test that creates a paginated thread and verifies that a paginated item is persisted while a legacy user-message event is omitted.\n\nGitOrigin-RevId: 83d93660afd5f0217213d4f21b5bf2a97745ff19","tree":{"sha":"1b553ea6140af5a2e7319d2125f3a3f86e480fb6","url":"https://api.github.com/repos/openai/codex/git/trees/1b553ea6140af5a2e7319d2125f3a3f86e480fb6"},"url":"https://api.github.com/repos/openai/codex/git/commits/bfe31598c79bd2e5b9089030ae7f2978457015c8","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/bfe31598c79bd2e5b9089030ae7f2978457015c8","html_url":"https://github.com/openai/codex/commit/bfe31598c79bd2e5b9089030ae7f2978457015c8","comments_url":"https://api.github.com/repos/openai/codex/commits/bfe31598c79bd2e5b9089030ae7f2978457015c8/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"610f09abcfbfd3e75dd5c37659c8f7a9e82a2f67","url":"https://api.github.com/repos/openai/codex/commits/610f09abcfbfd3e75dd5c37659c8f7a9e82a2f67","html_url":"https://github.com/openai/codex/commit/610f09abcfbfd3e75dd5c37659c8f7a9e82a2f67"}]},{"sha":"610f09abcfbfd3e75dd5c37659c8f7a9e82a2f67","node_id":"C_kwDOOYsS4doAKDYxMGYwOWFiY2ZiZmQzZTc1ZGQ1YzM3NjU5YzhmN2E5ZTgyYTJmNjc","commit":{"author":{"name":"Celia Chen","email":"celia@openai.com","date":"2026-07-10T23:18:19Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T23:22:56Z"},"message":"Make GPT-5.6 Sol the default Bedrock model (#32288)\n\n## What changed\n\n- Prioritize the GPT-5.6 Sol, Terra, and Luna variants ahead of GPT-5.5 and GPT-5.4 in the static Amazon Bedrock catalog, making Sol the default.\n- Use each GPT-5.6 variant's bundled description and default reasoning level while retaining Bedrock's `max` reasoning support.\n\n## Testing\n\n- Update model-provider and app-server tests to cover catalog ordering, variant metadata, and provider-aware fallback to GPT-5.6 Sol.\n\nGitOrigin-RevId: 1761390254deae47b62c043b1ba707c384cde5e9","tree":{"sha":"4638180eb969bd22de235179c2d10953f53fc34e","url":"https://api.github.com/repos/openai/codex/git/trees/4638180eb969bd22de235179c2d10953f53fc34e"},"url":"https://api.github.com/repos/openai/codex/git/commits/610f09abcfbfd3e75dd5c37659c8f7a9e82a2f67","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/610f09abcfbfd3e75dd5c37659c8f7a9e82a2f67","html_url":"https://github.com/openai/codex/commit/610f09abcfbfd3e75dd5c37659c8f7a9e82a2f67","comments_url":"https://api.github.com/repos/openai/codex/commits/610f09abcfbfd3e75dd5c37659c8f7a9e82a2f67/comments","author":{"login":"celia-oai","id":209693228,"node_id":"U_kgDODH-qLA","avatar_url":"https://avatars.githubusercontent.com/u/209693228?v=4","gravatar_id":"","url":"https://api.github.com/users/celia-oai","html_url":"https://github.com/celia-oai","followers_url":"https://api.github.com/users/celia-oai/followers","following_url":"https://api.github.com/users/celia-oai/following{/other_user}","gists_url":"https://api.github.com/users/celia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/celia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celia-oai/subscriptions","organizations_url":"https://api.github.com/users/celia-oai/orgs","repos_url":"https://api.github.com/users/celia-oai/repos","events_url":"https://api.github.com/users/celia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/celia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"b5314aea1110fa2c114d57b17f1cabbf6f512f02","url":"https://api.github.com/repos/openai/codex/commits/b5314aea1110fa2c114d57b17f1cabbf6f512f02","html_url":"https://github.com/openai/codex/commit/b5314aea1110fa2c114d57b17f1cabbf6f512f02"}]},{"sha":"b5314aea1110fa2c114d57b17f1cabbf6f512f02","node_id":"C_kwDOOYsS4doAKGI1MzE0YWVhMTExMGZhMmMxMTRkNTdiMTdmMWNhYmJmNmY1MTJmMDI","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-07-10T23:07:06Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T23:16:09Z"},"message":"Clarify waiting behavior in safety buffering prompts (#32286)\n\n## What changed\n\n- Rename `Keep waiting` to `Dismiss and keep waiting`.\n- Explain that no action is required, waiting continues, and the menu closes when the response is ready.\n- Replace the generic confirmation hint with the new explanatory footer.\n\n## Testing\n\n- Update snapshots for safety-buffering prompts with and without the retry option.\n\nGitOrigin-RevId: 2d336c59066e2689f291c5098ecc300921f39977","tree":{"sha":"8b2a0a12ba256d90e9b990baf056313e945926a5","url":"https://api.github.com/repos/openai/codex/git/trees/8b2a0a12ba256d90e9b990baf056313e945926a5"},"url":"https://api.github.com/repos/openai/codex/git/commits/b5314aea1110fa2c114d57b17f1cabbf6f512f02","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/b5314aea1110fa2c114d57b17f1cabbf6f512f02","html_url":"https://github.com/openai/codex/commit/b5314aea1110fa2c114d57b17f1cabbf6f512f02","comments_url":"https://api.github.com/repos/openai/codex/commits/b5314aea1110fa2c114d57b17f1cabbf6f512f02/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c4318c386de365bd0dd9595a08d55a30bb142d11","url":"https://api.github.com/repos/openai/codex/commits/c4318c386de365bd0dd9595a08d55a30bb142d11","html_url":"https://github.com/openai/codex/commit/c4318c386de365bd0dd9595a08d55a30bb142d11"}]},{"sha":"c4318c386de365bd0dd9595a08d55a30bb142d11","node_id":"C_kwDOOYsS4doAKGM0MzE4YzM4NmRlMzY1YmQwZGQ5NTk1YTA4ZDU1YTMwYmIxNDJkMTE","commit":{"author":{"name":"Owen Lin","email":"owen@openai.com","date":"2026-07-10T21:56:58Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T22:04:03Z"},"message":"Include terminal errors in turn completion events (#32280)\n\n## What changed\n\n- Add an optional `error` payload to `TurnCompleteEvent` and omit it when a turn completes without an error.\n- Preserve the full terminal `ErrorEvent` through the turn lifecycle so the completion event includes the same error details emitted separately by `EventMsg::Error`.\n\n## Testing\n\n- Extend the stream-error integration test to verify that `TurnCompleteEvent` contains the emitted error and that the next turn can still proceed.\n\nGitOrigin-RevId: 8d32942a44132763076130102d8b89ab356d59d0","tree":{"sha":"77047a0041f978c628f2cd72a537f3d72858bfe4","url":"https://api.github.com/repos/openai/codex/git/trees/77047a0041f978c628f2cd72a537f3d72858bfe4"},"url":"https://api.github.com/repos/openai/codex/git/commits/c4318c386de365bd0dd9595a08d55a30bb142d11","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c4318c386de365bd0dd9595a08d55a30bb142d11","html_url":"https://github.com/openai/codex/commit/c4318c386de365bd0dd9595a08d55a30bb142d11","comments_url":"https://api.github.com/repos/openai/codex/commits/c4318c386de365bd0dd9595a08d55a30bb142d11/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"09ccae2c07d514d2201137e0940673aa04ef1006","url":"https://api.github.com/repos/openai/codex/commits/09ccae2c07d514d2201137e0940673aa04ef1006","html_url":"https://github.com/openai/codex/commit/09ccae2c07d514d2201137e0940673aa04ef1006"}]},{"sha":"09ccae2c07d514d2201137e0940673aa04ef1006","node_id":"C_kwDOOYsS4doAKDA5Y2NhZTJjMDdkNTE0ZDIyMDExMzdlMDk0MDY3M2FhMDRlZjEwMDY","commit":{"author":{"name":"rhan-oai","email":"rhan@openai.com","date":"2026-07-10T21:30:20Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T21:39:56Z"},"message":"Honor `personality = \"none\"` in model instructions (#32277)\n\n## Why\n\nModel catalog instructions can include a baked-in `# Personality` section. An\nexplicit `none` setting should omit that section instead of sending it as part\nof the model's base instructions.\n\n## What changed\n\n- Pass the configured personality into the models manager.\n- When personality support is enabled and the setting is explicitly `none`,\n  remove the `# Personality` section through the next level-one heading from\n  catalog base instructions and instruction templates.\n- Preserve explicit `base_instructions` overrides and avoid warning when no\n  personality was requested.\n\n## Testing\n\nAdded unit and integration coverage for section removal, heading boundaries,\nCRLF input, preserved configurations, and explicit base instructions.\n\nGitOrigin-RevId: 452c88d3ac6001c2ac7d4fef269cd75dc239fa61","tree":{"sha":"53d4fe4e85253dea9cb968312b7739e4939a23e9","url":"https://api.github.com/repos/openai/codex/git/trees/53d4fe4e85253dea9cb968312b7739e4939a23e9"},"url":"https://api.github.com/repos/openai/codex/git/commits/09ccae2c07d514d2201137e0940673aa04ef1006","comment_count":1,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/09ccae2c07d514d2201137e0940673aa04ef1006","html_url":"https://github.com/openai/codex/commit/09ccae2c07d514d2201137e0940673aa04ef1006","comments_url":"https://api.github.com/repos/openai/codex/commits/09ccae2c07d514d2201137e0940673aa04ef1006/comments","author":{"login":"rhan-oai","id":214716640,"node_id":"U_kgDODMxQ4A","avatar_url":"https://avatars.githubusercontent.com/u/214716640?v=4","gravatar_id":"","url":"https://api.github.com/users/rhan-oai","html_url":"https://github.com/rhan-oai","followers_url":"https://api.github.com/users/rhan-oai/followers","following_url":"https://api.github.com/users/rhan-oai/following{/other_user}","gists_url":"https://api.github.com/users/rhan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rhan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rhan-oai/subscriptions","organizations_url":"https://api.github.com/users/rhan-oai/orgs","repos_url":"https://api.github.com/users/rhan-oai/repos","events_url":"https://api.github.com/users/rhan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rhan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"e7d0e1417222347d7fef0f2589961b8d17eff739","url":"https://api.github.com/repos/openai/codex/commits/e7d0e1417222347d7fef0f2589961b8d17eff739","html_url":"https://github.com/openai/codex/commit/e7d0e1417222347d7fef0f2589961b8d17eff739"}]},{"sha":"e7d0e1417222347d7fef0f2589961b8d17eff739","node_id":"C_kwDOOYsS4doAKGU3ZDBlMTQxNzIyMjM0N2Q3ZmVmMGYyNTg5OTYxYjhkMTdlZmY3Mzk","commit":{"author":{"name":"Owen Lin","email":"owen@openai.com","date":"2026-07-10T21:26:13Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T21:31:00Z"},"message":"Repair unterminated rollout files before appending (#32276)\n\n## Why\n\nAppending directly to a non-empty rollout that lacks a trailing newline joins the\nnext JSON object to the existing record, producing invalid JSONL.\n\n## What changed\n\n- Ensure non-empty rollout files end with a newline before opening them for\n  append, including resumed, compressed, and direct append paths.\n- Perform the synchronous tail inspection outside the async runtime.\n\n## Testing\n\n- Add a regression test covering newline repair and repeated opens.\n\nGitOrigin-RevId: a3ca84cc1fd3b811caa9f4c5c8761a4b5b791357","tree":{"sha":"5611b2831ab8a15148864cf2e28379947ff20dbc","url":"https://api.github.com/repos/openai/codex/git/trees/5611b2831ab8a15148864cf2e28379947ff20dbc"},"url":"https://api.github.com/repos/openai/codex/git/commits/e7d0e1417222347d7fef0f2589961b8d17eff739","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/e7d0e1417222347d7fef0f2589961b8d17eff739","html_url":"https://github.com/openai/codex/commit/e7d0e1417222347d7fef0f2589961b8d17eff739","comments_url":"https://api.github.com/repos/openai/codex/commits/e7d0e1417222347d7fef0f2589961b8d17eff739/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c0ea3c4d0a2fb99a0f5978bfa7d2bbab467d7a77","url":"https://api.github.com/repos/openai/codex/commits/c0ea3c4d0a2fb99a0f5978bfa7d2bbab467d7a77","html_url":"https://github.com/openai/codex/commit/c0ea3c4d0a2fb99a0f5978bfa7d2bbab467d7a77"}]},{"sha":"c0ea3c4d0a2fb99a0f5978bfa7d2bbab467d7a77","node_id":"C_kwDOOYsS4doAKGMwZWEzYzRkMGEyZmI5OWEwZjU5NzhiZmE3ZDJiYmFiNDY3ZDdhNzc","commit":{"author":{"name":"Dylan Hurd","email":"dylan.hurd@openai.com","date":"2026-07-10T21:19:33Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T21:24:03Z"},"message":"Remove the personality migration (#32274)\n\n## What changed\n\n- Stop the TUI and app server from inspecting existing sessions at startup to\n  set `personality = \"pragmatic\"` automatically.\n- Remove the migration marker, helper APIs, and associated tests.\n\nGitOrigin-RevId: 9e963bf113aff21651696bbc463f2749ac0f510a","tree":{"sha":"c21d05b993e643d3d6c8867eed3d1c90393f7f15","url":"https://api.github.com/repos/openai/codex/git/trees/c21d05b993e643d3d6c8867eed3d1c90393f7f15"},"url":"https://api.github.com/repos/openai/codex/git/commits/c0ea3c4d0a2fb99a0f5978bfa7d2bbab467d7a77","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c0ea3c4d0a2fb99a0f5978bfa7d2bbab467d7a77","html_url":"https://github.com/openai/codex/commit/c0ea3c4d0a2fb99a0f5978bfa7d2bbab467d7a77","comments_url":"https://api.github.com/repos/openai/codex/commits/c0ea3c4d0a2fb99a0f5978bfa7d2bbab467d7a77/comments","author":{"login":"dylan-hurd-oai","id":220976066,"node_id":"U_kgDODSvTwg","avatar_url":"https://avatars.githubusercontent.com/u/220976066?v=4","gravatar_id":"","url":"https://api.github.com/users/dylan-hurd-oai","html_url":"https://github.com/dylan-hurd-oai","followers_url":"https://api.github.com/users/dylan-hurd-oai/followers","following_url":"https://api.github.com/users/dylan-hurd-oai/following{/other_user}","gists_url":"https://api.github.com/users/dylan-hurd-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/dylan-hurd-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dylan-hurd-oai/subscriptions","organizations_url":"https://api.github.com/users/dylan-hurd-oai/orgs","repos_url":"https://api.github.com/users/dylan-hurd-oai/repos","events_url":"https://api.github.com/users/dylan-hurd-oai/events{/privacy}","received_events_url":"https://api.github.com/users/dylan-hurd-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"431ad23be4f463f5ab68adc79097448ed1622bc9","url":"https://api.github.com/repos/openai/codex/commits/431ad23be4f463f5ab68adc79097448ed1622bc9","html_url":"https://github.com/openai/codex/commit/431ad23be4f463f5ab68adc79097448ed1622bc9"}]},{"sha":"431ad23be4f463f5ab68adc79097448ed1622bc9","node_id":"C_kwDOOYsS4doAKDQzMWFkMjNiZTRmNDYzZjVhYjY4YWRjNzkwOTc0NDhlZDE2MjJiYzk","commit":{"author":{"name":"Abhinav","email":"abhinav@openai.com","date":"2026-07-10T21:09:01Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T21:13:38Z"},"message":"Expose scheduled tasks in plugin details (#32272)\n\n## What changed\n\n- Add optional `scheduledTasks` metadata to `plugin/read` responses for remote\n  plugins, including hourly, daily, weekday, and weekly schedules.\n- Preserve the distinction between unavailable metadata (`null`) and a catalog\n  response containing no scheduled tasks (`[]`). Local plugin details return\n  `null`.\n- Export the corresponding Rust, JSON Schema, and TypeScript protocol types.\n\n## Testing\n\n- Cover scheduled-task deserialization and propagation through `plugin/read`.\n- Verify missing and empty remote metadata remain distinct.\n\nGitOrigin-RevId: 7af223ed0a1bf6d8f054293084a73f34c6d0332d","tree":{"sha":"f463a742172f687ca30f9098973efe29f55754f2","url":"https://api.github.com/repos/openai/codex/git/trees/f463a742172f687ca30f9098973efe29f55754f2"},"url":"https://api.github.com/repos/openai/codex/git/commits/431ad23be4f463f5ab68adc79097448ed1622bc9","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/431ad23be4f463f5ab68adc79097448ed1622bc9","html_url":"https://github.com/openai/codex/commit/431ad23be4f463f5ab68adc79097448ed1622bc9","comments_url":"https://api.github.com/repos/openai/codex/commits/431ad23be4f463f5ab68adc79097448ed1622bc9/comments","author":{"login":"abhinav-oai","id":274334565,"node_id":"U_kgDOEFoDZQ","avatar_url":"https://avatars.githubusercontent.com/u/274334565?v=4","gravatar_id":"","url":"https://api.github.com/users/abhinav-oai","html_url":"https://github.com/abhinav-oai","followers_url":"https://api.github.com/users/abhinav-oai/followers","following_url":"https://api.github.com/users/abhinav-oai/following{/other_user}","gists_url":"https://api.github.com/users/abhinav-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/abhinav-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abhinav-oai/subscriptions","organizations_url":"https://api.github.com/users/abhinav-oai/orgs","repos_url":"https://api.github.com/users/abhinav-oai/repos","events_url":"https://api.github.com/users/abhinav-oai/events{/privacy}","received_events_url":"https://api.github.com/users/abhinav-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"bca577d69a2f2be4550da5cd31f7bef6608c751e","url":"https://api.github.com/repos/openai/codex/commits/bca577d69a2f2be4550da5cd31f7bef6608c751e","html_url":"https://github.com/openai/codex/commit/bca577d69a2f2be4550da5cd31f7bef6608c751e"}]},{"sha":"bca577d69a2f2be4550da5cd31f7bef6608c751e","node_id":"C_kwDOOYsS4doAKGJjYTU3N2Q2OWEyZjJiZTQ1NTBkYTVjZDMxZjdiZWY2NjA4Yzc1MWU","commit":{"author":{"name":"Owen Lin","email":"owen@openai.com","date":"2026-07-10T20:20:43Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T20:25:03Z"},"message":"Include start times in terminal turn events (#32263)\n\n## What changed\n\n- Add an optional `started_at` Unix timestamp to `TurnCompleteEvent` and\n  `TurnAbortedEvent`.\n- Populate the timestamp from turn timing state when a turn completes or is\n  aborted.\n- Preserve the timestamp when synthesizing interrupted fork history and when\n  importing external sessions.\n\n## Testing\n\n- Verify that interrupting a turn emits a `TurnAbortedEvent` with a start\n  timestamp.\n\nGitOrigin-RevId: 75b3911b95c060e5fc1843a5e293d8fe47377186","tree":{"sha":"d54dad8b6231875b39b86ff01726a77d726d5086","url":"https://api.github.com/repos/openai/codex/git/trees/d54dad8b6231875b39b86ff01726a77d726d5086"},"url":"https://api.github.com/repos/openai/codex/git/commits/bca577d69a2f2be4550da5cd31f7bef6608c751e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/bca577d69a2f2be4550da5cd31f7bef6608c751e","html_url":"https://github.com/openai/codex/commit/bca577d69a2f2be4550da5cd31f7bef6608c751e","comments_url":"https://api.github.com/repos/openai/codex/commits/bca577d69a2f2be4550da5cd31f7bef6608c751e/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"b66c25c6a3488d768195826e49c3507d1dd08582","url":"https://api.github.com/repos/openai/codex/commits/b66c25c6a3488d768195826e49c3507d1dd08582","html_url":"https://github.com/openai/codex/commit/b66c25c6a3488d768195826e49c3507d1dd08582"}]},{"sha":"b66c25c6a3488d768195826e49c3507d1dd08582","node_id":"C_kwDOOYsS4doAKGI2NmMyNWM2YTM0ODhkNzY4MTk1ODI2ZTQ5YzM1MDdkMWRkMDg1ODI","commit":{"author":{"name":"Dylan Hurd","email":"dylan.hurd@openai.com","date":"2026-07-10T20:13:23Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T20:18:51Z"},"message":"Preserve local path conventions in automatic approvals (#32261)\n\n## Why\n\nDrive-shaped POSIX paths such as `/C:/workspace` can be mistaken for Windows\npaths when an automatic approval request converts them from `PathUri`.\n\n## What changed\n\n- Keep approval paths as `PathUri` values together with their environment ID\n  until the automatic review request is built.\n- Recover host-native paths for local working directories when strict\n  conversion cannot determine the path convention.\n- Continue rejecting incompatible paths from remote environments.\n\n## Testing\n\nAdd coverage for drive-shaped local POSIX paths, foreign remote paths, and\npreserving apply-patch path URIs while building approval actions.\n\nGitOrigin-RevId: 3fd31cfb4e8b46f9968ff66d5e986ca777430185","tree":{"sha":"ec21d810fbcc16c4a6e3b4bb7bd0737fe6bba416","url":"https://api.github.com/repos/openai/codex/git/trees/ec21d810fbcc16c4a6e3b4bb7bd0737fe6bba416"},"url":"https://api.github.com/repos/openai/codex/git/commits/b66c25c6a3488d768195826e49c3507d1dd08582","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/b66c25c6a3488d768195826e49c3507d1dd08582","html_url":"https://github.com/openai/codex/commit/b66c25c6a3488d768195826e49c3507d1dd08582","comments_url":"https://api.github.com/repos/openai/codex/commits/b66c25c6a3488d768195826e49c3507d1dd08582/comments","author":{"login":"dylan-hurd-oai","id":220976066,"node_id":"U_kgDODSvTwg","avatar_url":"https://avatars.githubusercontent.com/u/220976066?v=4","gravatar_id":"","url":"https://api.github.com/users/dylan-hurd-oai","html_url":"https://github.com/dylan-hurd-oai","followers_url":"https://api.github.com/users/dylan-hurd-oai/followers","following_url":"https://api.github.com/users/dylan-hurd-oai/following{/other_user}","gists_url":"https://api.github.com/users/dylan-hurd-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/dylan-hurd-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dylan-hurd-oai/subscriptions","organizations_url":"https://api.github.com/users/dylan-hurd-oai/orgs","repos_url":"https://api.github.com/users/dylan-hurd-oai/repos","events_url":"https://api.github.com/users/dylan-hurd-oai/events{/privacy}","received_events_url":"https://api.github.com/users/dylan-hurd-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"9993fb838ad076c70f00d1a718096f7e19c41927","url":"https://api.github.com/repos/openai/codex/commits/9993fb838ad076c70f00d1a718096f7e19c41927","html_url":"https://github.com/openai/codex/commit/9993fb838ad076c70f00d1a718096f7e19c41927"}]},{"sha":"9993fb838ad076c70f00d1a718096f7e19c41927","node_id":"C_kwDOOYsS4doAKDk5OTNmYjgzOGFkMDc2YzcwZjAwZDFhNzE4MDk2ZjdlMTljNDE5Mjc","commit":{"author":{"name":"Tom","email":"wiltzius@openai.com","date":"2026-07-10T19:56:08Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T20:01:47Z"},"message":"Improve Responses WebSocket timing telemetry (#32256)\n\n## What changed\n\n- Emit `responsesapi.websocket_timing` payloads as opt-in trace events with request context, while excluding them from diagnostic uploads and persisted logs by default.\n- Preserve fractional-millisecond TBT values in telemetry histograms and runtime summaries, rounding only when formatting the TUI label.\n\n## Testing\n\n- Cover timing-log filtering, fractional TBT collection and display, and existing whole-millisecond duration behavior.\n\nGitOrigin-RevId: 5f0a1c60c237abed17cc8b2d569ca77fbbc6ec41","tree":{"sha":"234fe3ff1a149f8a2fbc8975d061729976df547d","url":"https://api.github.com/repos/openai/codex/git/trees/234fe3ff1a149f8a2fbc8975d061729976df547d"},"url":"https://api.github.com/repos/openai/codex/git/commits/9993fb838ad076c70f00d1a718096f7e19c41927","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/9993fb838ad076c70f00d1a718096f7e19c41927","html_url":"https://github.com/openai/codex/commit/9993fb838ad076c70f00d1a718096f7e19c41927","comments_url":"https://api.github.com/repos/openai/codex/commits/9993fb838ad076c70f00d1a718096f7e19c41927/comments","author":{"login":"wiltzius-openai","id":176426546,"node_id":"U_kgDOCoQOMg","avatar_url":"https://avatars.githubusercontent.com/u/176426546?v=4","gravatar_id":"","url":"https://api.github.com/users/wiltzius-openai","html_url":"https://github.com/wiltzius-openai","followers_url":"https://api.github.com/users/wiltzius-openai/followers","following_url":"https://api.github.com/users/wiltzius-openai/following{/other_user}","gists_url":"https://api.github.com/users/wiltzius-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/wiltzius-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wiltzius-openai/subscriptions","organizations_url":"https://api.github.com/users/wiltzius-openai/orgs","repos_url":"https://api.github.com/users/wiltzius-openai/repos","events_url":"https://api.github.com/users/wiltzius-openai/events{/privacy}","received_events_url":"https://api.github.com/users/wiltzius-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a328f30172c606cfdc150c009790a3f05bfb4d22","url":"https://api.github.com/repos/openai/codex/commits/a328f30172c606cfdc150c009790a3f05bfb4d22","html_url":"https://github.com/openai/codex/commit/a328f30172c606cfdc150c009790a3f05bfb4d22"}]},{"sha":"a328f30172c606cfdc150c009790a3f05bfb4d22","node_id":"C_kwDOOYsS4doAKGEzMjhmMzAxNzJjNjA2Y2ZkYzE1MGMwMDk3OTBhM2YwNWJmYjRkMjI","commit":{"author":{"name":"Owen Lin","email":"owen@openai.com","date":"2026-07-10T19:13:52Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T19:18:39Z"},"message":"Extract reverse JSONL scanning from session indexing (#32246)\n\n## What changed\n\n- Add a generic `ReverseJsonlScanner` that reads seekable JSONL data from the\n  end in bounded chunks, skips blank records, and reports malformed records\n  without stopping the scan.\n- Use the scanner for reverse session-index lookups while preserving the\n  existing behavior of ignoring invalid entries.\n\n## Testing\n\n- Add coverage for unterminated final records, malformed JSON, blank lines,\n  chunk boundaries, and records spanning multiple chunks.\n- Verify session-index lookup can skip an invalid record and still find valid\n  entries on either side of it.\n\nGitOrigin-RevId: 66255f48492f74726d4ac4831cdc82f748de17d6","tree":{"sha":"faf352dd2361f309572e76ce35a5360cb996c0fe","url":"https://api.github.com/repos/openai/codex/git/trees/faf352dd2361f309572e76ce35a5360cb996c0fe"},"url":"https://api.github.com/repos/openai/codex/git/commits/a328f30172c606cfdc150c009790a3f05bfb4d22","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a328f30172c606cfdc150c009790a3f05bfb4d22","html_url":"https://github.com/openai/codex/commit/a328f30172c606cfdc150c009790a3f05bfb4d22","comments_url":"https://api.github.com/repos/openai/codex/commits/a328f30172c606cfdc150c009790a3f05bfb4d22/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"414217dc8accc5c0e2542239cbab6eaa815dc605","url":"https://api.github.com/repos/openai/codex/commits/414217dc8accc5c0e2542239cbab6eaa815dc605","html_url":"https://github.com/openai/codex/commit/414217dc8accc5c0e2542239cbab6eaa815dc605"}]},{"sha":"414217dc8accc5c0e2542239cbab6eaa815dc605","node_id":"C_kwDOOYsS4doAKDQxNDIxN2RjOGFjY2M1YzBlMjU0MjIzOWNiYWI2ZWFhODE1ZGM2MDU","commit":{"author":{"name":"Owen Lin","email":"owen@openai.com","date":"2026-07-10T18:22:36Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T18:27:19Z"},"message":"Add dedicated storage for paginated thread history (#32234)\n\n## Why\n\nPaginated thread history needs its own SQLite database to avoid adding lock\ncontention to the main state store.\n\n## What changed\n\n- Add the `thread_history_1.sqlite` path and migration scaffolding.\n- Create tables and pagination indexes for projected turns and items, plus a\n  per-thread projection checkpoint.\n- Register the database with runtime diagnostics, Bazel inputs, and database\n  telemetry.\n\nGitOrigin-RevId: d194310835f1df2a2a29c7827d77ca37eabbd0a3","tree":{"sha":"11b7dcd4094800f224992e0e12c27ee039a36088","url":"https://api.github.com/repos/openai/codex/git/trees/11b7dcd4094800f224992e0e12c27ee039a36088"},"url":"https://api.github.com/repos/openai/codex/git/commits/414217dc8accc5c0e2542239cbab6eaa815dc605","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/414217dc8accc5c0e2542239cbab6eaa815dc605","html_url":"https://github.com/openai/codex/commit/414217dc8accc5c0e2542239cbab6eaa815dc605","comments_url":"https://api.github.com/repos/openai/codex/commits/414217dc8accc5c0e2542239cbab6eaa815dc605/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"2da1b12822d95c8444178bf4d4422ad843c20291","url":"https://api.github.com/repos/openai/codex/commits/2da1b12822d95c8444178bf4d4422ad843c20291","html_url":"https://github.com/openai/codex/commit/2da1b12822d95c8444178bf4d4422ad843c20291"}]},{"sha":"2da1b12822d95c8444178bf4d4422ad843c20291","node_id":"C_kwDOOYsS4doAKDJkYTFiMTI4MjJkOTVjODQ0NDE3OGJmNGQ0NDIyYWQ4NDNjMjAyOTE","commit":{"author":{"name":"Dylan Hurd","email":"dylan.hurd@openai.com","date":"2026-07-10T18:08:29Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T18:12:27Z"},"message":"Let permission hooks resolve strict auto-review requests (#32232)\n\n## What changed\n\n- Run permission-request hooks before routing approvals to the automated reviewer or user, including when `strict_auto_review` is enabled.\n- Centralize approval resolution so hook, automated-reviewer, and user decisions share rejection handling and report the correct telemetry source.\n\n## Testing\n\n- Add an integration test showing that an allow hook can approve a shell command during strict auto-review without invoking the automated reviewer.\n\nGitOrigin-RevId: 18e9d76baee6cbae9d35ae517250f2f82270a9d2","tree":{"sha":"744dbb045cfcf013acd6022ae36684cb0869a11d","url":"https://api.github.com/repos/openai/codex/git/trees/744dbb045cfcf013acd6022ae36684cb0869a11d"},"url":"https://api.github.com/repos/openai/codex/git/commits/2da1b12822d95c8444178bf4d4422ad843c20291","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/2da1b12822d95c8444178bf4d4422ad843c20291","html_url":"https://github.com/openai/codex/commit/2da1b12822d95c8444178bf4d4422ad843c20291","comments_url":"https://api.github.com/repos/openai/codex/commits/2da1b12822d95c8444178bf4d4422ad843c20291/comments","author":{"login":"dylan-hurd-oai","id":220976066,"node_id":"U_kgDODSvTwg","avatar_url":"https://avatars.githubusercontent.com/u/220976066?v=4","gravatar_id":"","url":"https://api.github.com/users/dylan-hurd-oai","html_url":"https://github.com/dylan-hurd-oai","followers_url":"https://api.github.com/users/dylan-hurd-oai/followers","following_url":"https://api.github.com/users/dylan-hurd-oai/following{/other_user}","gists_url":"https://api.github.com/users/dylan-hurd-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/dylan-hurd-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dylan-hurd-oai/subscriptions","organizations_url":"https://api.github.com/users/dylan-hurd-oai/orgs","repos_url":"https://api.github.com/users/dylan-hurd-oai/repos","events_url":"https://api.github.com/users/dylan-hurd-oai/events{/privacy}","received_events_url":"https://api.github.com/users/dylan-hurd-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4472698728b1a8f4bd184086c5d1d0c65f2918b3","url":"https://api.github.com/repos/openai/codex/commits/4472698728b1a8f4bd184086c5d1d0c65f2918b3","html_url":"https://github.com/openai/codex/commit/4472698728b1a8f4bd184086c5d1d0c65f2918b3"}]},{"sha":"4472698728b1a8f4bd184086c5d1d0c65f2918b3","node_id":"C_kwDOOYsS4doAKDQ0NzI2OTg3MjhiMWE4ZjRiZDE4NDA4NmM1ZDFkMGM2NWYyOTE4YjM","commit":{"author":{"name":"pakrym-oai","email":"pakrym@openai.com","date":"2026-07-10T18:03:04Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T18:08:35Z"},"message":"Support pending remote environment registration (#32231)\n\n## Why\n\nRemote environment provisioning can finish after a thread starts, before an\nexec-server WebSocket URL is available.\n\n## What changed\n\n- Add `EnvironmentManager::register_pending_environment` and a one-shot\n  `PendingEnvironmentRegistration` handle that resolves to either a validated\n  WebSocket URL or a terminal provisioning error.\n- Let lazy remote exec-server clients wait for that result, while preserving\n  reconnection behavior after a successful registration.\n- Keep replacement registrations isolated so completing an older handle does\n  not resolve the current environment with the same ID.\n\n## Testing\n\nAdd coverage for successful connection and reconnection, provisioning and\ndropped-registration failures, invalid URLs, replacement isolation, and the\ndeferred-executor startup flow.\n\nGitOrigin-RevId: 5c05be2b72291b77a1f71176d7075b1ad63332a5","tree":{"sha":"98529255952e02d67690310f100ea5f4ab23a9e8","url":"https://api.github.com/repos/openai/codex/git/trees/98529255952e02d67690310f100ea5f4ab23a9e8"},"url":"https://api.github.com/repos/openai/codex/git/commits/4472698728b1a8f4bd184086c5d1d0c65f2918b3","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4472698728b1a8f4bd184086c5d1d0c65f2918b3","html_url":"https://github.com/openai/codex/commit/4472698728b1a8f4bd184086c5d1d0c65f2918b3","comments_url":"https://api.github.com/repos/openai/codex/commits/4472698728b1a8f4bd184086c5d1d0c65f2918b3/comments","author":{"login":"pakrym-oai","id":204937752,"node_id":"U_kgDODDcaGA","avatar_url":"https://avatars.githubusercontent.com/u/204937752?v=4","gravatar_id":"","url":"https://api.github.com/users/pakrym-oai","html_url":"https://github.com/pakrym-oai","followers_url":"https://api.github.com/users/pakrym-oai/followers","following_url":"https://api.github.com/users/pakrym-oai/following{/other_user}","gists_url":"https://api.github.com/users/pakrym-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/pakrym-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pakrym-oai/subscriptions","organizations_url":"https://api.github.com/users/pakrym-oai/orgs","repos_url":"https://api.github.com/users/pakrym-oai/repos","events_url":"https://api.github.com/users/pakrym-oai/events{/privacy}","received_events_url":"https://api.github.com/users/pakrym-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"6962a2ecae44f525fc97fd8f2820600542ccc19e","url":"https://api.github.com/repos/openai/codex/commits/6962a2ecae44f525fc97fd8f2820600542ccc19e","html_url":"https://github.com/openai/codex/commit/6962a2ecae44f525fc97fd8f2820600542ccc19e"}]},{"sha":"6962a2ecae44f525fc97fd8f2820600542ccc19e","node_id":"C_kwDOOYsS4doAKDY5NjJhMmVjYWU0NGY1MjVmYzk3ZmQ4ZjI4MjA2MDA1NDJjY2MxOWU","commit":{"author":{"name":"stevenlee-oai","email":"stevenlee@openai.com","date":"2026-07-10T17:50:09Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-07-10T17:59:41Z"},"message":"Serialize MCP OAuth credential refreshes (#32229)\n\n## Why\n\nConcurrent Codex processes can otherwise refresh the same rotating token, and a\ncancelled or partially persisted refresh can leave durable and in-memory MCP\ncredentials out of sync.\n\n## What changed\n\n- Serialize each credential's read-refresh-write transaction across processes,\n  reread the authoritative store after locking, and adopt credentials refreshed\n  by another process.\n- Keep refresh persistence running after caller cancellation, bound lock and\n  provider waits independently, and preserve omitted refresh tokens and scopes.\n- Fail MCP startup and operations when refresh or persistence fails instead of\n  continuing with stale credentials, while requiring reauthorization for\n  missing, unusable, or rejected refresh tokens.\n- Exclude OAuth refresh time from the MCP initialization timeout.\n\n## Testing\n\nAdd coverage for lock contention, concurrent refreshes, rejected and missing\ncredentials, storage failures, caller cancellation, and provider timeouts.\n\nGitOrigin-RevId: 4d29b879bec646d2ceb922b526dc793b1a1f5423","tree":{"sha":"bafdd64a0e14d47a7c2a87eab4241203c434b7f3","url":"https://api.github.com/repos/openai/codex/git/trees/bafdd64a0e14d47a7c2a87eab4241203c434b7f3"},"url":"https://api.github.com/repos/openai/codex/git/commits/6962a2ecae44f525fc97fd8f2820600542ccc19e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/6962a2ecae44f525fc97fd8f2820600542ccc19e","html_url":"https://github.com/openai/codex/commit/6962a2ecae44f525fc97fd8f2820600542ccc19e","comments_url":"https://api.github.com/repos/openai/codex/commits/6962a2ecae44f525fc97fd8f2820600542ccc19e/comments","author":{"login":"stevenlee-oai","id":213687449,"node_id":"U_kgDODLycmQ","avatar_url":"https://avatars.githubusercontent.com/u/213687449?v=4","gravatar_id":"","url":"https://api.github.com/users/stevenlee-oai","html_url":"https://github.com/stevenlee-oai","followers_url":"https://api.github.com/users/stevenlee-oai/followers","following_url":"https://api.github.com/users/stevenlee-oai/following{/other_user}","gists_url":"https://api.github.com/users/stevenlee-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/stevenlee-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stevenlee-oai/subscriptions","organizations_url":"https://api.github.com/users/stevenlee-oai/orgs","repos_url":"https://api.github.com/users/stevenlee-oai/repos","events_url":"https://api.github.com/users/stevenlee-oai/events{/privacy}","received_events_url":"https://api.github.com/users/stevenlee-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c8dc8e5fd5fdfe9c249bb98d691372d87e4b3cff","url":"https://api.github.com/repos/openai/codex/commits/c8dc8e5fd5fdfe9c249bb98d691372d87e4b3cff","html_url":"https://github.com/openai/codex/commit/c8dc8e5fd5fdfe9c249bb98d691372d87e4b3cff"}]}]