noid and Cognitive Robotics Laboratory, Jo&#x017E;ef Stefan Institute, Ljubljana, Slovenia"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-3677-3972","authenticated-orcid":false,"given":"Ale\u0161","family":"Ude","sequence":"additional","affiliation":[{"name":"Department of Automatics, Biocybernetics and Robotics, Humanoid and Cognitive Robotics Laboratory, Jo&#x017E;ef Stefan Institute, Ljubljana, Slovenia"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/access.2024.3451975","published-print":{"date-parts":[[2024]]},"issued":{"date-parts":[[2024]]},"container-title":["IEEE Access"]},{"DOI":"10.1080\/09658211.2023.2267190","title":["Collective interactions, collaborative inhibition, and shared spatial knowledge"],"author":[{"given":"Teriitutea","family":"Quesnot","sequence":"first","affiliation":[{"name":"Univ Brest, CNRS, LETG \u2013 UMR 6554, Plouzan\u00e9, France"},{"name":"Institut Universitaire de France, Paris, France"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Bernard","family":"Guelton","sequence":"additional","affiliation":[{"name":"Univ Paris 1, Institut ACTE \u2013 UR 7539, Paris, France"}],"role":[{"role":"author","vocabulary":"crossref"}]}],"URL":"https:\/\/doi.org\/10.1080\/09658211.2023.2267190","published-print":{"date-parts":[[2023,11,26]]},"published-online":{"date-parts":[[2023,10,20]]},"issued":{"date-parts":[[2023,10,20]]},"container-title":["Memory"]},{"DOI":"10.1109\/access.2024.3382194","title":["Generative Artificial Intelligence in Collaborative Ideation: Educational Insight From Fashion Students"],"author":[{"ORCID":"https:\/\/orcid.org\/0000-0002-0543-1112","authenticated-orcid":false,"given":"Se Jin","family":"Kim","sequence":"first","affiliation":[{"name":"Department of Clothing and Textiles, Changwon National University, Changwon-si, South Korea"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/