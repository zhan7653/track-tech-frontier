/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"afafeeb471c4008d4eb4263ec478cf868833fe0b","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/afafeeb471c4008d4eb4263ec478cf868833fe0b","html_url":"https://github.com/langchain-ai/deepagents/commit/afafeeb471c4008d4eb4263ec478cf868833fe0b"}]},{"sha":"afafeeb471c4008d4eb4263ec478cf868833fe0b","node_id":"C_kwDOPTymldoAKGFmYWZlZWI0NzFjNDAwOGQ0ZWI0MjYzZWM0NzhjZjg2ODgzM2ZlMGI","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-06-01T16:33:30Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-01T16:33:30Z"},"message":"fix(code): preserve MCP token refresh when metadata discovery fails (#3685)\n\nThis caches discovered OAuth metadata for MCP refreshes so providers\nwith non-standard token endpoints can keep using refresh tokens across\nrestarts. The SDK can refresh expired tokens when metadata is already\npresent, but it does not have a clean, generalizable place to rediscover\nand persist provider-specific authorization metadata before refresh.\nDeep Agents already owns the file-backed token store and provider policy\nlayer, so this keeps the provider-specific compatibility logic here.\n\nThe pre-refresh metadata lookup is best-effort. If discovery fails\nbecause a `.well-known` endpoint is temporarily unavailable,\nauthentication now falls back to the normal SDK refresh path instead of\naborting before refresh can run.\n\nThis is especially relevant for providers whose token endpoint cannot be\nsafely guessed from the MCP server URL.","tree":{"sha":"fe735be1ab63a4a9e90e2d098c6965611286832f","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/fe735be1ab63a4a9e90e2d098c6965611286832f"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/afafeeb471c4008d4eb4263ec478cf868833fe0b","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqHbRaCRC1aQ7uu5UhlAAAdYUQAEi0S1xoJPP7PZht7h0R421E\njUamxMzOOH3CQwQQYF5dYm/YBZUJx7M0as2FB21nUXLRoppcLn4esHaVbGFZ/etC\n85OrQAOkQURQU6chb765CWQlKgyjgUzyUKY88s/xTfwA8Ha+UHhSLxe0HWo26x0k\nF0uYXkt//+/c9L4fdwpSZGzo4W9E2VJ74U3CNqXKZQr5Ve/puo6bADgy3qSgwPxe\n6ePL6xsbRHC1Wfe1LqHKLlsKQZ3L7h0g5v6CWFk2qqIjWpkRbEqkMtslKgmbCHxS\njysEZiNHB2GGqn8uFcauDqEVevzstXIztyrxDzVlODFE9ymVYn0U8mrMmQkdOQqS\nZT8CEtviJyezDFmAL5n1i2TPH2xTxabq2LOA4slczJZKYJ6wPTxFNEjv7A2JpQYU\nsmh9tmUZKg31NgWLZ9OE8O6UhLlhoT4OVLDQh0+0cFYKXuTuVJkHAApmz4quJf02\nRk3jGtmM90/S8YH4QYbX12/Ljjh9exzjfMqxfGegAkbc4DN6enYMdMG2TL7u2gyY\nMWF1nE6rr++SVouyQQGSEXE1cA6uIdsIuuFF6MGh/pS3mzcuWdvk2YJRd6np9rta\nP/kBEbKpNhTYQsP0S1YZ2epjsys+l9nO8//EVRXIakm/joviEEDJxodwceOqk1LK\nPCy01+YoN/WUH2Kw00mT\n=4TRA\n-----END PGP SIGNATURE-----\n","payload":"tree fe735be1ab63a4a9e90e2d098c6965611286832f\nparent de4dbc74f50523205f86eb3ef541406a9d6ff89d\nauthor Mason Daugherty <mason@langchain.dev> 1780331610 -0400\ncommitter GitHub <noreply@github.com> 1780331610 -0400\n\nfix(code): preserve MCP token refresh when metadata discovery fails (#3685)\n\nThis caches discovered OAuth metadata for MCP refreshes so providers\nwith non-standard token endpoints can keep using refresh tokens across\nrestarts. The SDK can refresh expired tokens when metadata is already\npresent, but it does not have a clean, generalizable place to rediscover\nand persist provider-specific authorization metadata before refresh.\nDeep Agents already owns the file-backed token store and provider policy\nlayer, so this keeps the provider-specific compatibility logic here.\n\nThe pre-refresh metadata lookup is best-effort. If discovery fails\nbecause a `.well-known` endpoint is temporarily unavailable,\nauthentication now falls back to the normal SDK refresh path instead of\naborting before refresh can run.\n\nThis is especially relevant for providers whose token endpoint cannot be\nsafely guessed from the MCP server URL.","verified_at":"2026-06-01T16:33:31Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/afafeeb471c4008d4eb4263ec478cf868833fe0b","html_url":"https://github.com/langchain-ai/deepagents/commit/afafeeb471c4008d4eb4263ec478cf868833fe0b","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/afafeeb471c4008d4eb4263ec478cf868833fe0b/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https://api.github.com/users/mdrxy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdrxy/subscriptions","organizations_url":"https://api.github.com/users/mdrxy/orgs","repos_url":"https://api.github.com/users/mdrxy/repos","events_url":"https://api.github.com/users/mdrxy/events{/privacy}","received_events_url":"https://api.github.com/users/mdrxy/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"de4dbc74f50523205f86eb3ef541406a9d6ff89d","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/de4dbc74f50523205f86eb3ef541406a9d6ff89d","html_url":"https://github.com/langchain-ai/deepagents/commit/de4dbc74f50523205f86eb3ef541406a9d6ff89d"}]},{"sha":"de4dbc74f50523205f86eb3ef541406a9d6ff89d","node_id":"C_kwDOPTymldoAKGRlNGRiYzc0ZjUwNTIzMjA1Zjg2ZWIzZWY1NDE0MDZhOWQ2ZmY4OWQ","commit":{"author":{"name":"dependabot[bot]","email":"49699333+dependabot[bot]@users.noreply.github.com","date":"2026-06-01T13:19:26Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-01T13:19:26Z"},"message":"chore(deps): bump the minor-and-patch group with 2 updates (#3681)\n\nBumps the minor-and-patch group with 2 updates:\n[CodSpeedHQ/action](https://github.com/codspeedhq/action) and\n[actions/create-github-app-token](https://github.com/actions/create-github-app-token).\n\nUpdates `CodSpeedHQ/action` from 4.15.0 to 4.17.0\n<details>\n<summary>Release notes</summary>\n<p><em>Sourced from <a\nhref=\"https://github.com/codspeedhq/action/releases\">CodSpeedHQ/action's\nreleases</a>.</em></p>\n<blockquote>\n<h2>v4.17.0</h2>\n<h2>Release Notes</h2>\n<h3><!-- raw HTML omitted -->🚀 Features</h3>\n<ul>\n<li>Configure samply symbol resolution env vars by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Add CODSPEED_WALLTIME_PROFILER override by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Make benchmark isolation profiler-driven by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Add profile-based auth configuration (<a\nhref=\"https://redirect.github.com/codspeedhq/action/issues/366\">#366</a>)\nby <a href=\"https://github.com/art049\"><code>@​art049</code></a> in <a\nhref=\"https://redirect.github.com/CodSpeedHQ/runner/pull/366\">#366</a></li>\n<li>Bump instrument-hooks to not use stubs on macos (<a\nhref=\"https://redirect.github.com/codspeedhq/action/issues/373\">#373</a>)\nby <a\nhref=\"https://github.com/GuillaumeLagrange\"><code>@​GuillaumeLagrange</code></a>\nin <a\nhref=\"https://redirect.github.com/CodSpeedHQ/runner/pull/373\">#373</a></li>\n<li>Pin codspeed-go-runner installer downloads with sha256 verification\nby <a href=\"https://github.com/art049\"><code>@​art049</code></a> in <a\nhref=\"https://redirect.github.com/CodSpeedHQ/runner/pull/362\">#362</a></li>\n<li>Pin downloaded binaries with sha256 verification by <a\nhref=\"https://github.com/art049\"><code>@​art049</code></a></li>\n<li>Search NixOS debug info path by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a>\nin <a\nhref=\"https://redirect.github.com/CodSpeedHQ/runner/pull/354\">#354</a></li>\n<li>Inherit process mapping on forks by <a\nhref=\"https://github.com/GuillaumeLagrange\"><code>@​GuillaumeLagrange</code></a></li>\n<li>Bundle samply via library crate by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Add samply profiler for macOS by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Rename CODSPEED_PERF_ENABLED to CODSPEED_PROFILER_ENABLED by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Add Profiler trait abstraction by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Restore cursor on ctrl c by <a\nhref=\"https://github.com/GuillaumeLagrange\"><code>@​GuillaumeLagrange</code></a>\nin <a\nhref=\"https://redirect.github.com/CodSpeedHQ/runner/pull/341\">#341</a></li>\n<li>Validate tokens and repository access up front by <a\nhref=\"https://github.com/GuillaumeLagrange\"><code>@​GuillaumeLagrange</code></a></li>\n</ul>\n<h3><!-- raw HTML omitted -->🐛 Bug Fixes</h3>\n<ul>\n<li>Use introspected env for memory executor by <a\nhref=\"https://github.com/GuillaumeLagrange\"><code>@​GuillaumeLagrange</code></a></li>\n<li>Misleading DCE advice in setup-harness (<a\nhref=\"https://redirect.github.com/codspeedhq/action/issues/350\">#350</a>)\nby <a href=\"https://github.com/SuperMuel\"><code>@​SuperMuel</code></a>\nin <a\nhref=\"https://redirect.github.com/CodSpeedHQ/runner/pull/350\">#350</a></li>\n<li>Flush rolling buffer when executor errors by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a>\nin <a\nhref=\"https://redirect.github.com/CodSpeedHQ/runner/pull/352\">#352</a></li>\n<li>Use brew-installed bash for samply on macOS by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a>\nin <a\nhref=\"https://redirect.github.com/CodSpeedHQ/runner/pull/347\">#347</a></li>\n<li>Keep old name aliases to for deserialization purposes by <a\nhref=\"https://github.com/GuillaumeLagrange\"><code>@​GuillaumeLagrange</code></a>\nin <a\nhref=\"https://redirect.github.com/CodSpeedHQ/runner/pull/345\">#345</a></li>\n<li>Handle malformed token from backend better by <a\nhref=\"https://github.com/GuillaumeLagrange\"><code>@​GuillaumeLagrange</code></a></li>\n<li>Disable PYTHON_PERF_JIT_SUPPORT on macOS by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Use mach_absolute_time for FIFO timestamps on macOS by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Use O_RDWR to open FIFOs on all Unix platforms by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n</ul>\n<h3><!-- raw HTML omitted -->💼 Other</h3>\n<ul>\n<li>Select profiler via typed CLI arg by <a\nhref=\"https://github.com/GuillaumeLagrange\"><code>@​GuillaumeLagrange</code></a>\nin <a\nhref=\"https://redirect.github.com/CodSpeedHQ/runner/pull/379\">#379</a></li>\n<li>Bump workspace dependencies (<a\nhref=\"https://redirect.github.com/codspeedhq/action/issues/370\">#370</a>)\nby <a href=\"https://github.com/art049\"><code>@​art049</code></a> in <a\nhref=\"https://redirect.github.com/CodSpeedHQ/runner/pull/370\">#370</a></li>\n<li>Make api_client the single source of truth for the auth token by <a\nhref=\"https://github.com/GuillaumeLagrange\"><code>@​GuillaumeLagrange</code></a></li>\n<li>Bump gql_client to partial-data fork by <a\nhref=\"https://github.com/GuillaumeLagrange\"><code>@​GuillaumeLagrange</code></a></li>\n</ul>\n<h3><!-- raw HTML omitted -->🏗️ Refactor</h3>\n<ul>\n<li>Centralize internal re-exec via\nInternalCommands::get_command_builder by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a>\nin <a\nhref=\"https://redirect.github.com/CodSpeedHQ/runner/pull/338\">#338</a></li>\n<li>Rename Benchmark FIFO commands/markers to Profiler/Round by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Rename Profiler::wrap to wrap_command by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Share Linux profiler sysctl setup by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Port PerfRunner to Profiler trait by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Rename PerfMetadata to WalltimeMetadata by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Move perf module under profiler/ by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Rename FifoCommand::PingPerf to PingProfiler by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Rename IntegrationMode::Perf to Walltime by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n</ul>\n<h3><!-- raw HTML omitted -->🧪 Testing</h3>\n<ul>\n<li>Update valgrind snapshot tests by <a\nhref=\"https://github.com/adriencaccia\"><code>@​adriencaccia</code></a></li>\n</ul>\n<!-- raw HTML omitted -->\n</blockquote>\n<p>... (truncated)</p>\n</details>\n<details>\n<summary>Commits</summary>\n<ul>\n<li><a\nhref=\"https://github.com/CodSpeedHQ/action/commit/9d332c4d90b43981c3e55ae8e38e68709996240f\"><code>9d332c4</code></a>\nRelease v4.17.0 🚀</li>\n<li><a\nhref=\"https://github.com/CodSpeedHQ/action/commit/96afee1f0306cf819773aaa615516764d8d80b84\"><code>96afee1</code></a>\nchore: bump runner version to 4.17.0</li>\n<li><a\nhref=\"https://github.com/CodSpeedHQ/action/commit/a55be0fe21a0812799f21c313b69dcf85b23b807\"><code>a55be0f</code></a>\nchore: bump runner version to 4.16.2</li>\n<li><a\nhref=\"https://github.com/CodSpeedHQ/action/commit/3194d9a39c4d46684cb44bf7207fc56626aad8fd\"><code>3194d9a</code></a>\nRelease v4.15.1 🚀</li>\n<li><a\nhref=\"https://github.com/CodSpeedHQ/action/commit/91dff4597f3cbbb58887812f89811b19c254d5eb\"><code>91dff45</code></a>\nchore: bump runner version to 4.15.1</li>\n<li>See full diff in <a\nhref=\"https://github.com/codspeedhq/action/compare/c381be0bfd20e844fb45594f6aa182ffcd94545c...9d332c4d90b43981c3e55ae8e38e68709996240f\">compare\nview</a></li>\n</ul>\n</details>\n<br />\n\nUpdates `actions/create-github-app-token` from 3.1.1 to 3.2.0\n<details>\n<summary>Release notes</summary>\n<p><em>Sourced from <a\nhref=\"https://github.com/actions/create-github-app-token/releases\">actions/create-github-app-token's\nreleases</a>.</em></p>\n<blockquote>\n<h2>v3.2.0</h2>\n<h2><a\nhref=\"https://github.com/actions/create-github-app-token/compare/v3.1.1...v3.2.0\">3.2.0</a>\n(2026-05-12)</h2>\n<h3>Features</h3>\n<ul>\n<li>add support for enterprise-level GitHub Apps (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/263\">#263</a>)\n(<a\nhref=\"https://github.com/actions/create-github-app-token/commit/952a2a7073df6bfa5f49bc469ec895b6ec1acea4\">952a2a7</a>)</li>\n<li>support full repository names in <code>repositories</code> input (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/372\">#372</a>)\n(<a\nhref=\"https://github.com/actions/create-github-app-token/commit/85eb8dd41472213aed25d1a126460e0069138ab6\">85eb8dd</a>)</li>\n</ul>\n<h3>Bug Fixes</h3>\n<ul>\n<li><strong>deps:</strong> bump <code>@​actions/core</code> from 3.0.0\nto 3.0.1 in the production-dependencies group (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/364\">#364</a>)\n(<a\nhref=\"https://github.com/actions/create-github-app-token/commit/43e5c345bfd4d4f3ecea019ad0042001a09dd857\">43e5c34</a>)</li>\n<li>validate private-key input (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/376\">#376</a>)\n(<a\nhref=\"https://github.com/actions/create-github-app-token/commit/f24bbd89643991c0de27ae823c01791b2c6bafdd\">f24bbd8</a>)</li>\n</ul>\n</blockquote>\n</details>\n<details>\n<summary>Changelog</summary>\n<p><em>Sourced from <a\nhref=\"https://github.com/actions/create-github-app-token/blob/main/CHANGELOG.md\">actions/create-github-app-token's\nchangelog</a>.</em></p>\n<blockquote>\n<h1>Changelog</h1>\n<h2><a\nhref=\"https://github.com/actions/create-github-app-token/compare/v3.1.1...v3.2.0\">3.2.0</a>\n(2026-05-12)</h2>\n<h3>Features</h3>\n<ul>\n<li>add support for enterprise-level GitHub Apps (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/263\">#263</a>)\n(<a\nhref=\"https://github.com/actions/create-github-app-token/commit/952a2a7073df6bfa5f49bc469ec895b6ec1acea4\">952a2a7</a>)</li>\n<li>support full repository names in <code>repositories</code> input (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/372\">#372</a>)\n(<a\nhref=\"https://github.com/actions/create-github-app-token/commit/85eb8dd41472213aed25d1a126460e0069138ab6\">85eb8dd</a>)</li>\n</ul>\n<h3>Bug Fixes</h3>\n<ul>\n<li><strong>deps:</strong> bump <code>@​actions/core</code> from 3.0.0\nto 3.0.1 in the production-dependencies group (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/364\">#364</a>)\n(<a\nhref=\"https://github.com/actions/create-github-app-token/commit/43e5c345bfd4d4f3ecea019ad0042001a09dd857\">43e5c34</a>)</li>\n<li>validate private-key input (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/376\">#376</a>)\n(<a\nhref=\"https://github.com/actions/create-github-app-token/commit/f24bbd89643991c0de27ae823c01791b2c6bafdd\">f24bbd8</a>)</li>\n</ul>\n</blockquote>\n</details>\n<details>\n<summary>Commits</summary>\n<ul>\n<li><a\nhref=\"https://github.com/actions/create-github-app-token/commit/bcd2ba49218906704ab6c1aa796996da409d3eb1\"><code>bcd2ba4</code></a>\nchore(main): release 3.2.0 (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/370\">#370</a>)</li>\n<li><a\nhref=\"https://github.com/actions/create-github-app-token/commit/f24bbd89643991c0de27ae823c01791b2c6bafdd\"><code>f24bbd8</code></a>\nfix: validate private-key input (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/376\">#376</a>)</li>\n<li><a\nhref=\"https://github.com/actions/create-github-app-token/commit/363531b6d972a60a00b3f1e6bb139e5e6c764cd9\"><code>363531b</code></a>\ndocs: capitalize Git as a proper noun in README (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/374\">#374</a>)</li>\n<li><a\nhref=\"https://github.com/actions/create-github-app-token/commit/fd2801133e469d2950f2c5af5e591d6b2ad833c8\"><code>fd28011</code></a>\ndocs: update procedure to configure Git (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/287\">#287</a>)</li>\n<li><a\nhref=\"https://github.com/actions/create-github-app-token/commit/85eb8dd41472213aed25d1a126460e0069138ab6\"><code>85eb8dd</code></a>\nfeat: support full repository names in <code>repositories</code> input\n(<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/372\">#372</a>)</li>\n<li><a\nhref=\"https://github.com/actions/create-github-app-token/commit/c9aabb83728c3bd519212fa657ebc07e1f2a5dec\"><code>c9aabb8</code></a>\nbuild(deps-dev): bump yaml from 2.8.3 to 2.8.4 in the\ndevelopment-dependencie...</li>\n<li><a\nhref=\"https://github.com/actions/create-github-app-token/commit/e02e816e5591415258a53bf735aff57977dcd5e2\"><code>e02e816</code></a>\nbuild(deps-dev): bump undici from 7.24.6 to 8.2.0 (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/366\">#366</a>)</li>\n<li><a\nhref=\"https://github.com/actions/create-github-app-token/commit/8d835bfd37aa48fcb8e709925115857568d98bc4\"><code>8d835bf</code></a>\nbuild(deps-dev): bump esbuild from 0.27.4 to 0.28.0 in the\ndevelopment-depend...</li>\n<li><a\nhref=\"https://github.com/actions/create-github-app-token/commit/952a2a7073df6bfa5f49bc469ec895b6ec1acea4\"><code>952a2a7</code></a>\nfeat: add support for enterprise-level GitHub Apps (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/263\">#263</a>)</li>\n<li><a\nhref=\"https://github.com/actions/create-github-app-token/commit/43e5c345bfd4d4f3ecea019ad0042001a09dd857\"><code>43e5c34</code></a>\nfix(deps): bump <code>@​actions/core</code> from 3.0.0 to 3.0.1 in the\nproduction-dependenc...</li>\n<li>Additional commits viewable in <a\nhref=\"https://github.com/actions/create-github-app-token/compare/1b10c78c7865c340bc4f6099eb2f838309f1e8c3...bcd2ba49218906704ab6c1aa796996da409d3eb1\">compare\nview</a></li>\n</ul>\n</details>\n<br />\n\n\nDependabot will resolve any conflicts with this PR as long as you don't\nalter it yourself. You can also trigger a rebase manually by commenting\n`@dependabot rebase`.\n\n[//]: # (dependabot-automerge-start)\n[//]: # (dependabot-automerge-end)\n\n---\n\n<details>\n<summary>Dependabot commands and options</summary>\n<br />\n\nYou can trigger Dependabot actions by commenting on this PR:\n- `@dependabot rebase` will rebase this PR\n- `@dependabot recreate` will recreate this PR, overwriting any edits\nthat have been made to it\n- `@dependabot show <dependency name> ignore conditions` will show all\nof the ignore conditions of the specified dependency\n- `@dependabot ignore <dependency name> major version` will close this\ngroup update PR and stop Dependabot creating any more for the specific\ndependency's major version (unless you unignore this specific\ndependency's major version or upgrade to it yourself)\n- `@dependabot ignore <dependency name> minor version` will close this\ngroup update PR and stop Dependabot creating any more for the specific\ndependency's minor version (unless you unignore this specific\ndependency's minor version or upgrade to it yourself)\n- `@dependabot ignore <dependency name>` will close this group update PR\nand stop Dependabot creating any more for the specific dependency\n(unless you unignore this specific dependency or upgrade to it yourself)\n- `@dependabot unignore <dependency name>` will remove all of the ignore\nconditions of the specified dependency\n- `@dependabot unignore <dependency name> <ignore condition>` will\nremove the ignore condition of the specified dependency and ignore\nconditions\n\n\n</details>\n\nSigned-off-by: dependabot[bot] <support@github.com>\nCo-authored-by: dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com>","tree":{"sha":"4b7eaa0b789c597a21978dfae2ef9917d5f2ef7d","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/4b7eaa0b789c597a21978dfae2ef9917d5f2ef7d"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/de4dbc74f50523205f86eb3ef541406a9d6ff89d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqHYbeCRC1aQ7uu5UhlAAA2W0QADXZqCyosLTu6YEzPtAuUTgq\npdBcpnVnwIydrAAbQLPf15VPLLdS91aSyW7VCPvol+SQxji+TXlc+rULyjI1BpfO\n4MrsVBuAKCXNePuLSSbhyTlDhV3A6ym4FpGYuwmXtyJViF+0Ehx54GcwL6haaLha\nei8RLI3uOkhApzP2PDxXmYAMuB/GHF8m75Ya0UVYuAYGByDJBPYl/efJdQp1AK0M\nPw7YAQWKEUWst49I8GVb3/AsK3MP8RMoLAW077+8ZtdcjQ6UDcJXzYRVoSyNnQIM\nAeUYseCoZ2Nwg7PJKJuyUqNP2OhI0Gq6xeT2QMJIK61BdptI9oRPpmj9jeDxXxkW\nRF5OpQHDu7dy4QI7Fq7t2OUFlr1nOU4uNpU0P1VHQF7ACsAtrLzCrRDkUvM03pn9\nuRkLy4JDMTgzgDG2ZHn1nxgYFiIMnd/G82aXv9yCAP4KHrMeWaVhF+upMZ63x7o7\n4izugcSZ9a+eAQhiGxJokfzKPq2n/m9H9d+Z5hmcKuxXS9w5G5Cp6d6+RHifnEaa\nL2nij0LID5WXfAFAdIcbO4lLkQfDt8e8uZaQMZKGlkihDfqTK2Hi/5XammgyBnc0\nV4AmdYUPwZCxFd7pld3MNz/3TLV9qvHcQ5O7fo8/0WruXYOfE0L3Z1NDxH7qMo2m\niApmLrIYsz+yApBrJPGc\n=Hr0s\n-----END PGP SIGNATURE-----\n","payload":"tree 4b7eaa0b789c597a21978dfae2ef9917d5f2ef7d\nparent 7ed89067e1f71c2562e89485873ab93a0c230f52\nauthor dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com> 1780319966 -0400\ncommitter GitHub <noreply@github.com> 1780319966 -0400\n\nchore(deps): bump the minor-and-patch group with 2 updates (#3681)\n\nBumps the minor-and-patch group with 2 updates:\n[CodSpeedHQ/action](https://github.com/codspeedhq/action) and\n[actions/create-github-app-token](https://github.com/actions/create-github-app-token).\n\nUpdates `CodSpeedHQ/action` from 4.15.0 to 4.17.0\n<details>\n<summary>Release notes</summary>\n<p><em>Sourced from <a\nhref=\"https://github.com/codspeedhq/action/releases\">CodSpeedHQ/action's\nreleases</a>.</em></p>\n<blockquote>\n<h2>v4.17.0</h2>\n<h2>Release Notes</h2>\n<h3><!-- raw HTML omitted -->🚀 Features</h3>\n<ul>\n<li>Configure samply symbol resolution env vars by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Add CODSPEED_WALLTIME_PROFILER override by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Make benchmark isolation profiler-driven by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Add profile-based auth configuration (<a\nhref=\"https://redirect.github.com/codspeedhq/action/issues/366\">#366</a>)\nby <a href=\"https://github.com/art049\"><code>@​art049</code></a> in <a\nhref=\"https://redirect.github.com/CodSpeedHQ/runner/pull/366\">#366</a></li>\n<li>Bump instrument-hooks to not use stubs on macos (<a\nhref=\"https://redirect.github.com/codspeedhq/action/issues/373\">#373</a>)\nby <a\nhref=\"https://github.com/GuillaumeLagrange\"><code>@​GuillaumeLagrange</code></a>\nin <a\nhref=\"https://redirect.github.com/CodSpeedHQ/runner/pull/373\">#373</a></li>\n<li>Pin codspeed-go-runner installer downloads with sha256 verification\nby <a href=\"https://github.com/art049\"><code>@​art049</code></a> in <a\nhref=\"https://redirect.github.com/CodSpeedHQ/runner/pull/362\">#362</a></li>\n<li>Pin downloaded binaries with sha256 verification by <a\nhref=\"https://github.com/art049\"><code>@​art049</code></a></li>\n<li>Search NixOS debug info path by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a>\nin <a\nhref=\"https://redirect.github.com/CodSpeedHQ/runner/pull/354\">#354</a></li>\n<li>Inherit process mapping on forks by <a\nhref=\"https://github.com/GuillaumeLagrange\"><code>@​GuillaumeLagrange</code></a></li>\n<li>Bundle samply via library crate by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Add samply profiler for macOS by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Rename CODSPEED_PERF_ENABLED to CODSPEED_PROFILER_ENABLED by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Add Profiler trait abstraction by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Restore cursor on ctrl c by <a\nhref=\"https://github.com/GuillaumeLagrange\"><code>@​GuillaumeLagrange</code></a>\nin <a\nhref=\"https://redirect.github.com/CodSpeedHQ/runner/pull/341\">#341</a></li>\n<li>Validate tokens and repository access up front by <a\nhref=\"https://github.com/GuillaumeLagrange\"><code>@​GuillaumeLagrange</code></a></li>\n</ul>\n<h3><!-- raw HTML omitted -->🐛 Bug Fixes</h3>\n<ul>\n<li>Use introspected env for memory executor by <a\nhref=\"https://github.com/GuillaumeLagrange\"><code>@​GuillaumeLagrange</code></a></li>\n<li>Misleading DCE advice in setup-harness (<a\nhref=\"https://redirect.github.com/codspeedhq/action/issues/350\">#350</a>)\nby <a href=\"https://github.com/SuperMuel\"><code>@​SuperMuel</code></a>\nin <a\nhref=\"https://redirect.github.com/CodSpeedHQ/runner/pull/350\">#350</a></li>\n<li>Flush rolling buffer when executor errors by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a>\nin <a\nhref=\"https://redirect.github.com/CodSpeedHQ/runner/pull/352\">#352</a></li>\n<li>Use brew-installed bash for samply on macOS by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a>\nin <a\nhref=\"https://redirect.github.com/CodSpeedHQ/runner/pull/347\">#347</a></li>\n<li>Keep old name aliases to for deserialization purposes by <a\nhref=\"https://github.com/GuillaumeLagrange\"><code>@​GuillaumeLagrange</code></a>\nin <a\nhref=\"https://redirect.github.com/CodSpeedHQ/runner/pull/345\">#345</a></li>\n<li>Handle malformed token from backend better by <a\nhref=\"https://github.com/GuillaumeLagrange\"><code>@​GuillaumeLagrange</code></a></li>\n<li>Disable PYTHON_PERF_JIT_SUPPORT on macOS by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Use mach_absolute_time for FIFO timestamps on macOS by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Use O_RDWR to open FIFOs on all Unix platforms by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n</ul>\n<h3><!-- raw HTML omitted -->💼 Other</h3>\n<ul>\n<li>Select profiler via typed CLI arg by <a\nhref=\"https://github.com/GuillaumeLagrange\"><code>@​GuillaumeLagrange</code></a>\nin <a\nhref=\"https://redirect.github.com/CodSpeedHQ/runner/pull/379\">#379</a></li>\n<li>Bump workspace dependencies (<a\nhref=\"https://redirect.github.com/codspeedhq/action/issues/370\">#370</a>)\nby <a href=\"https://github.com/art049\"><code>@​art049</code></a> in <a\nhref=\"https://redirect.github.com/CodSpeedHQ/runner/pull/370\">#370</a></li>\n<li>Make api_client the single source of truth for the auth token by <a\nhref=\"https://github.com/GuillaumeLagrange\"><code>@​GuillaumeLagrange</code></a></li>\n<li>Bump gql_client to partial-data fork by <a\nhref=\"https://github.com/GuillaumeLagrange\"><code>@​GuillaumeLagrange</code></a></li>\n</ul>\n<h3><!-- raw HTML omitted -->🏗️ Refactor</h3>\n<ul>\n<li>Centralize internal re-exec via\nInternalCommands::get_command_builder by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a>\nin <a\nhref=\"https://redirect.github.com/CodSpeedHQ/runner/pull/338\">#338</a></li>\n<li>Rename Benchmark FIFO commands/markers to Profiler/Round by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Rename Profiler::wrap to wrap_command by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Share Linux profiler sysctl setup by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Port PerfRunner to Profiler trait by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Rename PerfMetadata to WalltimeMetadata by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Move perf module under profiler/ by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Rename FifoCommand::PingPerf to PingProfiler by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n<li>Rename IntegrationMode::Perf to Walltime by <a\nhref=\"https://github.com/not-matthias\"><code>@​not-matthias</code></a></li>\n</ul>\n<h3><!-- raw HTML omitted -->🧪 Testing</h3>\n<ul>\n<li>Update valgrind snapshot tests by <a\nhref=\"https://github.com/adriencaccia\"><code>@​adriencaccia</code></a></li>\n</ul>\n<!-- raw HTML omitted -->\n</blockquote>\n<p>... (truncated)</p>\n</details>\n<details>\n<summary>Commits</summary>\n<ul>\n<li><a\nhref=\"https://github.com/CodSpeedHQ/action/commit/9d332c4d90b43981c3e55ae8e38e68709996240f\"><code>9d332c4</code></a>\nRelease v4.17.0 🚀</li>\n<li><a\nhref=\"https://github.com/CodSpeedHQ/action/commit/96afee1f0306cf819773aaa615516764d8d80b84\"><code>96afee1</code></a>\nchore: bump runner version to 4.17.0</li>\n<li><a\nhref=\"https://github.com/CodSpeedHQ/action/commit/a55be0fe21a0812799f21c313b69dcf85b23b807\"><code>a55be0f</code></a>\nchore: bump runner version to 4.16.2</li>\n<li><a\nhref=\"https://github.com/CodSpeedHQ/action/commit/3194d9a39c4d46684cb44bf7207fc56626aad8fd\"><code>3194d9a</code></a>\nRelease v4.15.1 🚀</li>\n<li><a\nhref=\"https://github.com/CodSpeedHQ/action/commit/91dff4597f3cbbb58887812f89811b19c254d5eb\"><code>91dff45</code></a>\nchore: bump runner version to 4.15.1</li>\n<li>See full diff in <a\nhref=\"https://github.com/codspeedhq/action/compare/c381be0bfd20e844fb45594f6aa182ffcd94545c...9d332c4d90b43981c3e55ae8e38e68709996240f\">compare\nview</a></li>\n</ul>\n</details>\n<br />\n\nUpdates `actions/create-github-app-token` from 3.1.1 to 3.2.0\n<details>\n<summary>Release notes</summary>\n<p><em>Sourced from <a\nhref=\"https://github.com/actions/create-github-app-token/releases\">actions/create-github-app-token's\nreleases</a>.</em></p>\n<blockquote>\n<h2>v3.2.0</h2>\n<h2><a\nhref=\"https://github.com/actions/create-github-app-token/compare/v3.1.1...v3.2.0\">3.2.0</a>\n(2026-05-12)</h2>\n<h3>Features</h3>\n<ul>\n<li>add support for enterprise-level GitHub Apps (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/263\">#263</a>)\n(<a\nhref=\"https://github.com/actions/create-github-app-token/commit/952a2a7073df6bfa5f49bc469ec895b6ec1acea4\">952a2a7</a>)</li>\n<li>support full repository names in <code>repositories</code> input (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/372\">#372</a>)\n(<a\nhref=\"https://github.com/actions/create-github-app-token/commit/85eb8dd41472213aed25d1a126460e0069138ab6\">85eb8dd</a>)</li>\n</ul>\n<h3>Bug Fixes</h3>\n<ul>\n<li><strong>deps:</strong> bump <code>@​actions/core</code> from 3.0.0\nto 3.0.1 in the production-dependencies group (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/364\">#364</a>)\n(<a\nhref=\"https://github.com/actions/create-github-app-token/commit/43e5c345bfd4d4f3ecea019ad0042001a09dd857\">43e5c34</a>)</li>\n<li>validate private-key input (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/376\">#376</a>)\n(<a\nhref=\"https://github.com/actions/create-github-app-token/commit/f24bbd89643991c0de27ae823c01791b2c6bafdd\">f24bbd8</a>)</li>\n</ul>\n</blockquote>\n</details>\n<details>\n<summary>Changelog</summary>\n<p><em>Sourced from <a\nhref=\"https://github.com/actions/create-github-app-token/blob/main/CHANGELOG.md\">actions/create-github-app-token's\nchangelog</a>.</em></p>\n<blockquote>\n<h1>Changelog</h1>\n<h2><a\nhref=\"https://github.com/actions/create-github-app-token/compare/v3.1.1...v3.2.0\">3.2.0</a>\n(2026-05-12)</h2>\n<h3>Features</h3>\n<ul>\n<li>add support for enterprise-level GitHub Apps (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/263\">#263</a>)\n(<a\nhref=\"https://github.com/actions/create-github-app-token/commit/952a2a7073df6bfa5f49bc469ec895b6ec1acea4\">952a2a7</a>)</li>\n<li>support full repository names in <code>repositories</code> input (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/372\">#372</a>)\n(<a\nhref=\"https://github.com/actions/create-github-app-token/commit/85eb8dd41472213aed25d1a126460e0069138ab6\">85eb8dd</a>)</li>\n</ul>\n<h3>Bug Fixes</h3>\n<ul>\n<li><strong>deps:</strong> bump <code>@​actions/core</code> from 3.0.0\nto 3.0.1 in the production-dependencies group (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/364\">#364</a>)\n(<a\nhref=\"https://github.com/actions/create-github-app-token/commit/43e5c345bfd4d4f3ecea019ad0042001a09dd857\">43e5c34</a>)</li>\n<li>validate private-key input (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/376\">#376</a>)\n(<a\nhref=\"https://github.com/actions/create-github-app-token/commit/f24bbd89643991c0de27ae823c01791b2c6bafdd\">f24bbd8</a>)</li>\n</ul>\n</blockquote>\n</details>\n<details>\n<summary>Commits</summary>\n<ul>\n<li><a\nhref=\"https://github.com/actions/create-github-app-token/commit/bcd2ba49218906704ab6c1aa796996da409d3eb1\"><code>bcd2ba4</code></a>\nchore(main): release 3.2.0 (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/370\">#370</a>)</li>\n<li><a\nhref=\"https://github.com/actions/create-github-app-token/commit/f24bbd89643991c0de27ae823c01791b2c6bafdd\"><code>f24bbd8</code></a>\nfix: validate private-key input (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/376\">#376</a>)</li>\n<li><a\nhref=\"https://github.com/actions/create-github-app-token/commit/363531b6d972a60a00b3f1e6bb139e5e6c764cd9\"><code>363531b</code></a>\ndocs: capitalize Git as a proper noun in README (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/374\">#374</a>)</li>\n<li><a\nhref=\"https://github.com/actions/create-github-app-token/commit/fd2801133e469d2950f2c5af5e591d6b2ad833c8\"><code>fd28011</code></a>\ndocs: update procedure to configure Git (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/287\">#287</a>)</li>\n<li><a\nhref=\"https://github.com/actions/create-github-app-token/commit/85eb8dd41472213aed25d1a126460e0069138ab6\"><code>85eb8dd</code></a>\nfeat: support full repository names in <code>repositories</code> input\n(<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/372\">#372</a>)</li>\n<li><a\nhref=\"https://github.com/actions/create-github-app-token/commit/c9aabb83728c3bd519212fa657ebc07e1f2a5dec\"><code>c9aabb8</code></a>\nbuild(deps-dev): bump yaml from 2.8.3 to 2.8.4 in the\ndevelopment-dependencie...</li>\n<li><a\nhref=\"https://github.com/actions/create-github-app-token/commit/e02e816e5591415258a53bf735aff57977dcd5e2\"><code>e02e816</code></a>\nbuild(deps-dev): bump undici from 7.24.6 to 8.2.0 (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/366\">#366</a>)</li>\n<li><a\nhref=\"https://github.com/actions/create-github-app-token/commit/8d835bfd37aa48fcb8e709925115857568d98bc4\"><code>8d835bf</code></a>\nbuild(deps-dev): bump esbuild from 0.27.4 to 0.28.0 in the\ndevelopment-depend...</li>\n<li><a\nhref=\"https://github.com/actions/create-github-app-token/commit/952a2a7073df6bfa5f49bc469ec895b6ec1acea4\"><code>952a2a7</code></a>\nfeat: add support for enterprise-level GitHub Apps (<a\nhref=\"https://redirect.github.com/actions/create-github-app-token/issues/263\">#263</a>)</li>\n<li><a\nhref=\"https://github.com/actions/create-github-app-token/commit/43e5c345bfd4d4f3ecea019ad0042001a09dd857\"><code>43e5c34</code></a>\nfix(deps): bump <code>@​actions/core</code> from 3.0.0 to 3.0.1 in the\nproduction-dependenc...</li>\n<li>Additional commits viewable in <a\nhref=\"https://github.com/actions/create-github-app-token/compare/1b10c78c7865c340bc4f6099eb2f838309f1e8c3...bcd2ba49218906704ab6c1aa796996da409d3eb1\">compare\nview</a></li>\n</ul>\n</details>\n<br />\n\n\nDependabot will resolve any conflicts with this PR as long as you don't\nalter it yourself. You can also trigger a rebase manually by commenting\n`@dependabot rebase`.\n\n[//]: # (dependabot-automerge-start)\n[//]: # (dependabot-automerge-end)\n\n---\n\n<details>\n<summary>Dependabot commands and options</summary>\n<br />\n\nYou can trigger Dependabot actions by commenting on this PR:\n- `@dependabot rebase` will rebase this PR\n- `@dependabot recreate` will recreate this PR, overwriting any edits\nthat have been made to it\n- `@dependabot show <dependency name> ignore conditions` will show all\nof the ignore conditions of the specified dependency\n- `@dependabot ignore <dependency name> major version` will close this\ngroup update PR and stop Dependabot creating any more for the specific\ndependency's major version (unless you unignore this specific\ndependency's major version or upgrade to it yourself)\n- `@dependabot ignore <dependency name> minor version` will close this\ngroup update PR and stop Dependabot creating any more for the specific\ndependency's minor version (unless you unignore this specific\ndependency's minor version or upgrade to it yourself)\n- `@dependabot ignore <dependency name>` will close this group update PR\nand stop Dependabot creating any more for the specific dependency\n(unless you unignore this specific dependency or upgrade to it yourself)\n- `@dependabot unignore <dependency name>` will remove all of the ignore\nconditions of the specified dependency\n- `@dependabot unignore <dependency name> <ignore condition>` will\nremove the ignore condition of the specified dependency and ignore\nconditions\n\n\n</details>\n\nSigned-off-by: dependabot[bot] <support@github.com>\nCo-authored-by: dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com>","verified_at":"2026-06-01T13:19:27Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/de4dbc74f50523205f86eb3ef541406a9d6ff89d","html_url":"https://github.com/langchain-ai/deepagents/commit/de4dbc74f50523205f86eb3ef541406a9d6ff89d","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/de4dbc74f50523205f86eb3ef541406a9d6ff89d/comments","author":{"login":"dependabot[bot]","id":49699333,"node_id":"MDM6Qm90NDk2OTkzMzM=","avatar_url":"https://avatars.githubusercontent.com/in/29110?v=4","gravatar_id":"","url":"https://api.github.com/users/dependabot%5Bbot%5D","html_url":"https://github.com/apps/dependabot","followers_url":"https://api.github.com/users/dependabot%5Bbot%5D/followers","following_url":"https://api.github.com/users/dependabot%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/dependabot%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/dependabot%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dependabot%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/dependabot%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/dependabot%5Bbot%5D/repos","events_url":"https://api.github.com/users/dependabot%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/dependabot%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravata