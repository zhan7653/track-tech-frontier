[{"sha":"657bd889ae28edcbf5395c103b479bf8b328704e","node_id":"C_kwDOOYsS4doAKDY1N2JkODg5YWUyOGVkY2JmNTM5NWMxMDNiNDc5YmY4YjMyODcwNGU","commit":{"author":{"name":"joeflorencio-openai","email":"joeflorencio@openai.com","date":"2026-08-18T23:29:24Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T23:47:00Z"},"message":"Support Edu Plus and Edu Pro account plans (#39316)\n\n## What changed\n\n- Recognize `edu_plus` and `edu_pro` as distinct education workspace plans across authentication, backend rate-limit mapping, and app-server account schemas.\n- Include both plans in cloud configuration eligibility and use the education usage-limit behavior.\n- Display the plans as `Edu Plus` and `Edu Pro` in the TUI status view.\n\n## Testing\n\n- Cover parsing, workspace classification, account and rate-limit responses, cloud configuration eligibility, usage-limit messages, and TUI display names for the new variants.\n\nGitOrigin-RevId: bf8add780ae03a3c6d10c4f4afa0da262c37928e","tree":{"sha":"34bca05e9047aff1f5cb71e96aa8205a72a437f2","url":"https://api.github.com/repos/openai/codex/git/trees/34bca05e9047aff1f5cb71e96aa8205a72a437f2"},"url":"https://api.github.com/repos/openai/codex/git/commits/657bd889ae28edcbf5395c103b479bf8b328704e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/657bd889ae28edcbf5395c103b479bf8b328704e","html_url":"https://github.com/openai/codex/commit/657bd889ae28edcbf5395c103b479bf8b328704e","comments_url":"https://api.github.com/repos/openai/codex/commits/657bd889ae28edcbf5395c103b479bf8b328704e/comments","author":{"login":"joeflorencio-openai","id":195963627,"node_id":"U_kgDOC64q6w","avatar_url":"https://avatars.githubusercontent.com/u/195963627?v=4","gravatar_id":"","url":"https://api.github.com/users/joeflorencio-openai","html_url":"https://github.com/joeflorencio-openai","followers_url":"https://api.github.com/users/joeflorencio-openai/followers","following_url":"https://api.github.com/users/joeflorencio-openai/following{/other_user}","gists_url":"https://api.github.com/users/joeflorencio-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/joeflorencio-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/joeflorencio-openai/subscriptions","organizations_url":"https://api.github.com/users/joeflorencio-openai/orgs","repos_url":"https://api.github.com/users/joeflorencio-openai/repos","events_url":"https://api.github.com/users/joeflorencio-openai/events{/privacy}","received_events_url":"https://api.github.com/users/joeflorencio-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"8ae72a9314dd9f0c1e74bd495d9a90089b9e3a8e","url":"https://api.github.com/repos/openai/codex/commits/8ae72a9314dd9f0c1e74bd495d9a90089b9e3a8e","html_url":"https://github.com/openai/codex/commit/8ae72a9314dd9f0c1e74bd495d9a90089b9e3a8e"}]},{"sha":"8ae72a9314dd9f0c1e74bd495d9a90089b9e3a8e","node_id":"C_kwDOOYsS4doAKDhhZTcyYTkzMTRkZDlmMGMxZTc0YmQ0OTVkOWE5MDA4OWI5ZTNhOGU","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-18T23:19:44Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T23:43:31Z"},"message":"Evict guardian transcript entries in cacheable chunks (#39315)\n\n## Why\n\nSelecting only the newest entries changes the retained transcript prefix whenever a new entry arrives, reducing cache stability.\n\n## What changed\n\n- Replay non-user transcript entries through a bounded buffer and evict half of the applicable pool when an entry or token limit overflows.\n- Keep message and tool token budgets independent, and reject entries that cannot fit without evicting retained evidence.\n- Preserve user-message selection and emit retained entries in transcript order.\n\n## Testing\n\nAdded coverage for stable tool prefixes, message-budget overflow, rejected messages, and chunked entry-count eviction.\n\nGitOrigin-RevId: e6181f5a229a6de06c7ef5db21a5c74980a53e97","tree":{"sha":"05d0bef21a146d09d509d6239b5041b606f5cb08","url":"https://api.github.com/repos/openai/codex/git/trees/05d0bef21a146d09d509d6239b5041b606f5cb08"},"url":"https://api.github.com/repos/openai/codex/git/commits/8ae72a9314dd9f0c1e74bd495d9a90089b9e3a8e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/8ae72a9314dd9f0c1e74bd495d9a90089b9e3a8e","html_url":"https://github.com/openai/codex/commit/8ae72a9314dd9f0c1e74bd495d9a90089b9e3a8e","comments_url":"https://api.github.com/repos/openai/codex/commits/8ae72a9314dd9f0c1e74bd495d9a90089b9e3a8e/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4d8c664a4976833b2142974bdba6e8d1a270d671","url":"https://api.github.com/repos/openai/codex/commits/4d8c664a4976833b2142974bdba6e8d1a270d671","html_url":"https://github.com/openai/codex/commit/4d8c664a4976833b2142974bdba6e8d1a270d671"}]},{"sha":"4d8c664a4976833b2142974bdba6e8d1a270d671","node_id":"C_kwDOOYsS4doAKDRkOGM2NjRhNDk3NjgzM2IyMTQyOTc0YmRiYTZlOGQxYTI3MGQ2NzE","commit":{"author":{"name":"Abhinav","email":"abhinav@openai.com","date":"2026-08-18T23:17:34Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T23:23:23Z"},"message":"Run hooks with the captured session environment (#39314)\n\n## What changed\n\n- Capture the process environment when the hook registry is created and reuse\n  that snapshot across configuration reloads.\n- Clear the live environment before launching command hooks and legacy notify\n  commands, then apply hook-specific overrides and scrub non-inheritable\n  credentials.\n- Resolve the default shell from the captured environment.\n\n## Testing\n\nAdd coverage for snapshot replay, overrides, credential scrubbing, default\nshell selection, non-Unicode values, and runtime reconfiguration.\n\nGitOrigin-RevId: fee60c88e842980cdfc1bd49b14b62b9a56b08cd","tree":{"sha":"5954a308beb02a48e2d2e2ab265347f267c29124","url":"https://api.github.com/repos/openai/codex/git/trees/5954a308beb02a48e2d2e2ab265347f267c29124"},"url":"https://api.github.com/repos/openai/codex/git/commits/4d8c664a4976833b2142974bdba6e8d1a270d671","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4d8c664a4976833b2142974bdba6e8d1a270d671","html_url":"https://github.com/openai/codex/commit/4d8c664a4976833b2142974bdba6e8d1a270d671","comments_url":"https://api.github.com/repos/openai/codex/commits/4d8c664a4976833b2142974bdba6e8d1a270d671/comments","author":{"login":"abhinav-oai","id":274334565,"node_id":"U_kgDOEFoDZQ","avatar_url":"https://avatars.githubusercontent.com/u/274334565?v=4","gravatar_id":"","url":"https://api.github.com/users/abhinav-oai","html_url":"https://github.com/abhinav-oai","followers_url":"https://api.github.com/users/abhinav-oai/followers","following_url":"https://api.github.com/users/abhinav-oai/following{/other_user}","gists_url":"https://api.github.com/users/abhinav-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/abhinav-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abhinav-oai/subscriptions","organizations_url":"https://api.github.com/users/abhinav-oai/orgs","repos_url":"https://api.github.com/users/abhinav-oai/repos","events_url":"https://api.github.com/users/abhinav-oai/events{/privacy}","received_events_url":"https://api.github.com/users/abhinav-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fb356f3d2c9fa05f9b06771f8e3c877ca66ed330","url":"https://api.github.com/repos/openai/codex/commits/fb356f3d2c9fa05f9b06771f8e3c877ca66ed330","html_url":"https://github.com/openai/codex/commit/fb356f3d2c9fa05f9b06771f8e3c877ca66ed330"}]},{"sha":"fb356f3d2c9fa05f9b06771f8e3c877ca66ed330","node_id":"C_kwDOOYsS4doAKGZiMzU2ZjNkMmM5ZmEwNWY5YjA2NzcxZjhlM2M4NzdjYTY2ZWQzMzA","commit":{"author":{"name":"rka-oai","email":"rka@openai.com","date":"2026-08-18T23:00:23Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T23:05:52Z"},"message":"Add async delivery metadata to agent messages (#39312)\n\n## What changed\n\n- Add an optional `delivery` field to agent message events and app-server\n  `agentMessage` items, with `\"async\"` identifying a user-visible message sent\n  without ending the current turn.\n- Preserve the marker through legacy event conversion, thread history\n  materialization, replay, and generated JSON and TypeScript schemas.\n- Require delivery of async agent message completion notifications on the\n  in-process app-server transport.\n\n## Testing\n\n- Cover preservation of async delivery metadata in thread history.\n- Cover delivery-required classification for async agent messages.\n\nGitOrigin-RevId: f92ba25de1293ee271404badfdf0d117d6530329","tree":{"sha":"6aa54a26351971f95085805598b28382a04bc710","url":"https://api.github.com/repos/openai/codex/git/trees/6aa54a26351971f95085805598b28382a04bc710"},"url":"https://api.github.com/repos/openai/codex/git/commits/fb356f3d2c9fa05f9b06771f8e3c877ca66ed330","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fb356f3d2c9fa05f9b06771f8e3c877ca66ed330","html_url":"https://github.com/openai/codex/commit/fb356f3d2c9fa05f9b06771f8e3c877ca66ed330","comments_url":"https://api.github.com/repos/openai/codex/commits/fb356f3d2c9fa05f9b06771f8e3c877ca66ed330/comments","author":{"login":"rka-oai","id":240799229,"node_id":"U_kgDODlpN_Q","avatar_url":"https://avatars.githubusercontent.com/u/240799229?v=4","gravatar_id":"","url":"https://api.github.com/users/rka-oai","html_url":"https://github.com/rka-oai","followers_url":"https://api.github.com/users/rka-oai/followers","following_url":"https://api.github.com/users/rka-oai/following{/other_user}","gists_url":"https://api.github.com/users/rka-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rka-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rka-oai/subscriptions","organizations_url":"https://api.github.com/users/rka-oai/orgs","repos_url":"https://api.github.com/users/rka-oai/repos","events_url":"https://api.github.com/users/rka-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rka-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"7d9990fa30ab495d473fc555f0d5e7c68e9d205a","url":"https://api.github.com/repos/openai/codex/commits/7d9990fa30ab495d473fc555f0d5e7c68e9d205a","html_url":"https://github.com/openai/codex/commit/7d9990fa30ab495d473fc555f0d5e7c68e9d205a"}]},{"sha":"7d9990fa30ab495d473fc555f0d5e7c68e9d205a","node_id":"C_kwDOOYsS4doAKDdkOTk5MGZhMzBhYjQ5NWQ0NzNmYzU1NWYwZDVlN2M2OGU5ZDIwNWE","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-18T22:47:52Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T23:00:53Z"},"message":"Bind unified exec approvals to shell executables (#39311)\n\n## Why\n\nAn unfamiliar executable can ignore its arguments, so trust in an apparent\ninner command must not implicitly trust the executable that runs it.\n\n## What changed\n\n- Evaluate unfamiliar shell executables alongside their parsed commands when\n  determining unified exec approval requirements. Inner commands can add\n  restrictions, but cannot grant trust to the executable.\n- Include the executable in reusable approval keys so approval for one custom\n  shell does not apply to another.\n- Parse literal PowerShell scripts without launching the requested executable,\n  preserving command policy checks before approval.\n\n## Testing\n\nAdd cross-platform coverage for spoofed shell paths, allowed and forbidden\ninner commands, explicit custom-shell approval, and session approval isolation.\n\nGitOrigin-RevId: 0dd2c7e9a2ac30965ef5fe5de1a8d2968bb5f9d0","tree":{"sha":"4038bbef4f553a77d62219ea180258cc9b1e129d","url":"https://api.github.com/repos/openai/codex/git/trees/4038bbef4f553a77d62219ea180258cc9b1e129d"},"url":"https://api.github.com/repos/openai/codex/git/commits/7d9990fa30ab495d473fc555f0d5e7c68e9d205a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/7d9990fa30ab495d473fc555f0d5e7c68e9d205a","html_url":"https://github.com/openai/codex/commit/7d9990fa30ab495d473fc555f0d5e7c68e9d205a","comments_url":"https://api.github.com/repos/openai/codex/commits/7d9990fa30ab495d473fc555f0d5e7c68e9d205a/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"280d56b1d823a7e9dfd85f796da38bd825d0052d","url":"https://api.github.com/repos/openai/codex/commits/280d56b1d823a7e9dfd85f796da38bd825d0052d","html_url":"https://github.com/openai/codex/commit/280d56b1d823a7e9dfd85f796da38bd825d0052d"}]},{"sha":"280d56b1d823a7e9dfd85f796da38bd825d0052d","node_id":"C_kwDOOYsS4doAKDI4MGQ1NmIxZDgyM2E3ZTlkZmQ4NWY3OTZkYTM4YmQ4MjVkMDA1MmQ","commit":{"author":{"name":"rphilizaire-openai","email":"rphilizaire@openai.com","date":"2026-08-18T22:47:47Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T22:53:31Z"},"message":"Attribute executor skill invocations to plugins (#39309)\n\n## What changed\n\n- Carry selected plugin identities from MCP discovery into per-turn extension data, limited to capability roots that are ready for the turn.\n- Annotate executor skill catalog entries with the matching plugin ID and `user` scope.\n- Include that attribution in `skill_invocation` analytics for both explicit and implicit executor skill invocations.\n\n## Testing\n\n- Extend the executor skills app-server test to verify plugin ID, skill scope, and invocation type for explicit and implicit analytics events.\n\nGitOrigin-RevId: 9345600ae29bcb8eb894fffd2d6f7b05f22ebf74","tree":{"sha":"f9271f64763c5212900acea47581cd5fa2438486","url":"https://api.github.com/repos/openai/codex/git/trees/f9271f64763c5212900acea47581cd5fa2438486"},"url":"https://api.github.com/repos/openai/codex/git/commits/280d56b1d823a7e9dfd85f796da38bd825d0052d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/280d56b1d823a7e9dfd85f796da38bd825d0052d","html_url":"https://github.com/openai/codex/commit/280d56b1d823a7e9dfd85f796da38bd825d0052d","comments_url":"https://api.github.com/repos/openai/codex/commits/280d56b1d823a7e9dfd85f796da38bd825d0052d/comments","author":{"login":"rphilizaire-openai","id":200841089,"node_id":"U_kgDOC_iXgQ","avatar_url":"https://avatars.githubusercontent.com/u/200841089?v=4","gravatar_id":"","url":"https://api.github.com/users/rphilizaire-openai","html_url":"https://github.com/rphilizaire-openai","followers_url":"https://api.github.com/users/rphilizaire-openai/followers","following_url":"https://api.github.com/users/rphilizaire-openai/following{/other_user}","gists_url":"https://api.github.com/users/rphilizaire-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/rphilizaire-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rphilizaire-openai/subscriptions","organizations_url":"https://api.github.com/users/rphilizaire-openai/orgs","repos_url":"https://api.github.com/users/rphilizaire-openai/repos","events_url":"https://api.github.com/users/rphilizaire-openai/events{/privacy}","received_events_url":"https://api.github.com/users/rphilizaire-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"c97bd2dcb52a8120d96086fac49665452af3161b","url":"https://api.github.com/repos/openai/codex/commits/c97bd2dcb52a8120d96086fac49665452af3161b","html_url":"https://github.com/openai/codex/commit/c97bd2dcb52a8120d96086fac49665452af3161b"}]},{"sha":"c97bd2dcb52a8120d96086fac49665452af3161b","node_id":"C_kwDOOYsS4doAKGM5N2JkMmRjYjUyYTgxMjBkOTYwODZmYWM0OTY2NTQ1MmFmMzE2MWI","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-18T22:38:37Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T22:47:54Z"},"message":"Fail closed on Guardian V2 risk scoring errors (#39307)\n\n## What changed\n\n- Treat configuration, action serialization, thread lookup, and classification errors as elevated risk instead of retaining a prior low-risk result.\n- Track asynchronous scoring failures separately from completed scores so approval review falls back to strict review when the latest tool call could not be scored.\n- Preserve newer classification results when recording a fail-closed score.\n\n## Testing\n\n- Add coverage for each failure path and for ordering fail-closed scores with concurrent classifications.\n\nGitOrigin-RevId: 7012f078a24031848f2943354a206866286ad9f4","tree":{"sha":"372473a91c0b8a63161a9a0f4710681a42fbd9b1","url":"https://api.github.com/repos/openai/codex/git/trees/372473a91c0b8a63161a9a0f4710681a42fbd9b1"},"url":"https://api.github.com/repos/openai/codex/git/commits/c97bd2dcb52a8120d96086fac49665452af3161b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/c97bd2dcb52a8120d96086fac49665452af3161b","html_url":"https://github.com/openai/codex/commit/c97bd2dcb52a8120d96086fac49665452af3161b","comments_url":"https://api.github.com/repos/openai/codex/commits/c97bd2dcb52a8120d96086fac49665452af3161b/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"6ec012668b0decdd4506e376f0553816ab684e67","url":"https://api.github.com/repos/openai/codex/commits/6ec012668b0decdd4506e376f0553816ab684e67","html_url":"https://github.com/openai/codex/commit/6ec012668b0decdd4506e376f0553816ab684e67"}]},{"sha":"6ec012668b0decdd4506e376f0553816ab684e67","node_id":"C_kwDOOYsS4doAKDZlYzAxMjY2OGIwZGVjZGQ0NTA2ZTM3NmYwNTUzODE2YWI2ODRlNjc","commit":{"author":{"name":"joeflorencio-openai","email":"joeflorencio@openai.com","date":"2026-08-18T22:31:06Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T22:44:28Z"},"message":"Honor managed config during project discovery (#39306)\n\n## What changed\n\n- Include legacy managed-file and MDM settings when resolving project root markers and project trust in both canonical and executor-local config loads.\n- Preserve the existing managed-layer precedence in the final config stack and resolve managed relative paths against the same bases used by the final loader.\n- Update explicit-untrusted warnings to describe the effective configuration and direct users to an administrator when the setting is managed.\n\n## Testing\n\n- Cover managed root markers, managed trust overrides, MDM precedence, app-server config reads, and the remote TUI warning.\n\nGitOrigin-RevId: 9b5ddd54b4530f73589d6842a15cbab7e6d6bbb9","tree":{"sha":"7dab9910797139316c2bfb2c77a5afea386f2d98","url":"https://api.github.com/repos/openai/codex/git/trees/7dab9910797139316c2bfb2c77a5afea386f2d98"},"url":"https://api.github.com/repos/openai/codex/git/commits/6ec012668b0decdd4506e376f0553816ab684e67","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/6ec012668b0decdd4506e376f0553816ab684e67","html_url":"https://github.com/openai/codex/commit/6ec012668b0decdd4506e376f0553816ab684e67","comments_url":"https://api.github.com/repos/openai/codex/commits/6ec012668b0decdd4506e376f0553816ab684e67/comments","author":{"login":"joeflorencio-openai","id":195963627,"node_id":"U_kgDOC64q6w","avatar_url":"https://avatars.githubusercontent.com/u/195963627?v=4","gravatar_id":"","url":"https://api.github.com/users/joeflorencio-openai","html_url":"https://github.com/joeflorencio-openai","followers_url":"https://api.github.com/users/joeflorencio-openai/followers","following_url":"https://api.github.com/users/joeflorencio-openai/following{/other_user}","gists_url":"https://api.github.com/users/joeflorencio-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/joeflorencio-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/joeflorencio-openai/subscriptions","organizations_url":"https://api.github.com/users/joeflorencio-openai/orgs","repos_url":"https://api.github.com/users/joeflorencio-openai/repos","events_url":"https://api.github.com/users/joeflorencio-openai/events{/privacy}","received_events_url":"https://api.github.com/users/joeflorencio-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"e51a91b2f4a1b04c4fd8e1db671bb34f93da4e16","url":"https://api.github.com/repos/openai/codex/commits/e51a91b2f4a1b04c4fd8e1db671bb34f93da4e16","html_url":"https://github.com/openai/codex/commit/e51a91b2f4a1b04c4fd8e1db671bb34f93da4e16"}]},{"sha":"e51a91b2f4a1b04c4fd8e1db671bb34f93da4e16","node_id":"C_kwDOOYsS4doAKGU1MWE5MWIyZjRhMWIwNGM0ZmQ4ZTFkYjY3MWJiMzRmOTNkYTRlMTY","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-18T22:18:08Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T22:37:50Z"},"message":"Keep Guardian v2 risk scores in memory (#39304)\n\n## What changed\n\n- Stop writing Guardian v2 security risk scores to rollout history.\n- Treat resumed and forked threads as having no previous Guardian score, so their\n  first tool approval is classified and reviewed normally.\n- Remove the now-unused `codex-history` dependency from the Guardian v2\n  extension.\n\n## Testing\n\n- Update app-server coverage for new, resumed, and forked threads to wait for\n  classification completion and verify the expected approval reviews.\n\nGitOrigin-RevId: 74d9caa903a1ff9d38e577b4697b5f8970f11ebb","tree":{"sha":"96a1fe4dae929fe38cee06a8a62e0fd36c346a1c","url":"https://api.github.com/repos/openai/codex/git/trees/96a1fe4dae929fe38cee06a8a62e0fd36c346a1c"},"url":"https://api.github.com/repos/openai/codex/git/commits/e51a91b2f4a1b04c4fd8e1db671bb34f93da4e16","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/e51a91b2f4a1b04c4fd8e1db671bb34f93da4e16","html_url":"https://github.com/openai/codex/commit/e51a91b2f4a1b04c4fd8e1db671bb34f93da4e16","comments_url":"https://api.github.com/repos/openai/codex/commits/e51a91b2f4a1b04c4fd8e1db671bb34f93da4e16/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"b473c4e6abd35c02b100d6df6f5476286122c1aa","url":"https://api.github.com/repos/openai/codex/commits/b473c4e6abd35c02b100d6df6f5476286122c1aa","html_url":"https://github.com/openai/codex/commit/b473c4e6abd35c02b100d6df6f5476286122c1aa"}]},{"sha":"b473c4e6abd35c02b100d6df6f5476286122c1aa","node_id":"C_kwDOOYsS4doAKGI0NzNjNGU2YWJkMzVjMDJiMTAwZDZkZjZmNTQ3NjI4NjEyMmMxYWE","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-18T22:13:48Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T22:33:28Z"},"message":"Record Guardian v2 classification token usage (#39303)\n\n## What changed\n\n- Pass session-attributed extension metrics to the Guardian v2 sampler.\n- Record `codex.guardian_v2.classification.token_usage` histograms for total, input, cached input, cache-write input, non-cached input, output, and reasoning output tokens.\n- Preserve token accounting when streamed JSON produces an early score by recording usage from the terminal response in the background.\n\n## Testing\n\n- Cover token metrics through the Guardian v2 extension and the sampler's early-score path.\n\nGitOrigin-RevId: 04fadc07f3b9cbe83f9fa3737536860b5cf5b4be","tree":{"sha":"93c1036096fb60c10b1a777b6cd124832c474c32","url":"https://api.github.com/repos/openai/codex/git/trees/93c1036096fb60c10b1a777b6cd124832c474c32"},"url":"https://api.github.com/repos/openai/codex/git/commits/b473c4e6abd35c02b100d6df6f5476286122c1aa","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/b473c4e6abd35c02b100d6df6f5476286122c1aa","html_url":"https://github.com/openai/codex/commit/b473c4e6abd35c02b100d6df6f5476286122c1aa","comments_url":"https://api.github.com/repos/openai/codex/commits/b473c4e6abd35c02b100d6df6f5476286122c1aa/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fe50b616899eef5aac0dacf1e2d36a09c109944b","url":"https://api.github.com/repos/openai/codex/commits/fe50b616899eef5aac0dacf1e2d36a09c109944b","html_url":"https://github.com/openai/codex/commit/fe50b616899eef5aac0dacf1e2d36a09c109944b"}]},{"sha":"fe50b616899eef5aac0dacf1e2d36a09c109944b","node_id":"C_kwDOOYsS4doAKGZlNTBiNjE2ODk5ZWVmNWFhYzBkYWNmMWUyZDM2YTA5YzEwOTk0NGI","commit":{"author":{"name":"epanero-openai","email":"166539875+epanero-openai@users.noreply.github.com","date":"2026-08-18T21:48:27Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T22:29:58Z"},"message":"Prevent Node REPL auth tokens from reaching child processes (#39301)\n\n## What changed\n\n- Add `NODE_REPL_AUTH_TOKEN` to the environment variables that model-reachable child processes cannot inherit.\n- Remove the variable case-insensitively after shell environment policy overrides and from explicitly configured child command environments.\n- Extend the environment scrubber tests to cover inherited and configured forms of the token.\n\nGitOrigin-RevId: 716c65e0a9e222f705c226b7c86545251d3ea580","tree":{"sha":"14fe34468904319f07dd11279204090643a190d1","url":"https://api.github.com/repos/openai/codex/git/trees/14fe34468904319f07dd11279204090643a190d1"},"url":"https://api.github.com/repos/openai/codex/git/commits/fe50b616899eef5aac0dacf1e2d36a09c109944b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fe50b616899eef5aac0dacf1e2d36a09c109944b","html_url":"https://github.com/openai/codex/commit/fe50b616899eef5aac0dacf1e2d36a09c109944b","comments_url":"https://api.github.com/repos/openai/codex/commits/fe50b616899eef5aac0dacf1e2d36a09c109944b/comments","author":{"login":"epanero-openai","id":166539875,"node_id":"U_kgDOCe0yYw","avatar_url":"https://avatars.githubusercontent.com/u/166539875?v=4","gravatar_id":"","url":"https://api.github.com/users/epanero-openai","html_url":"https://github.com/epanero-openai","followers_url":"https://api.github.com/users/epanero-openai/followers","following_url":"https://api.github.com/users/epanero-openai/following{/other_user}","gists_url":"https://api.github.com/users/epanero-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/epanero-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/epanero-openai/subscriptions","organizations_url":"https://api.github.com/users/epanero-openai/orgs","repos_url":"https://api.github.com/users/epanero-openai/repos","events_url":"https://api.github.com/users/epanero-openai/events{/privacy}","received_events_url":"https://api.github.com/users/epanero-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"1a6e07a4febcc0ecfa04464f5e95cb47144cd746","url":"https://api.github.com/repos/openai/codex/commits/1a6e07a4febcc0ecfa04464f5e95cb47144cd746","html_url":"https://github.com/openai/codex/commit/1a6e07a4febcc0ecfa04464f5e95cb47144cd746"}]},{"sha":"1a6e07a4febcc0ecfa04464f5e95cb47144cd746","node_id":"C_kwDOOYsS4doAKDFhNmUwN2E0ZmViY2MwZWNmYTA0NDY0ZjVlOTVjYjQ3MTQ0Y2Q3NDY","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-18T21:45:37Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T22:20:32Z"},"message":"Restrict agent roles to bounded configuration overrides (#39299)\n\n## Why\n\nAgent roles should customize a child agent without expanding the authority or changing the provider configuration inherited from its parent session.\n\n## What changed\n\n- Apply only supported role overrides for model behavior, developer instructions, personality, service tier, and capability reductions.\n- Preserve parent-owned permissions, model providers, endpoints, MCP servers, notifications, and other unrestricted configuration.\n- Keep managed feature requirements effective when a role disables capabilities, and reject symlinked user role files.\n- Use the same bounded role application path for both multi-agent implementations and resumed agents.\n\n## Testing\n\nAdd coverage for authority preservation, managed feature requirements, symlink rejection, provider inheritance, and provider routing after resume.\n\nGitOrigin-RevId: c528d615b691f9c02bfbc21154d514ea07743010","tree":{"sha":"edc7b4470ffe1cb1897e9da2be6d5a5cbb5b4443","url":"https://api.github.com/repos/openai/codex/git/trees/edc7b4470ffe1cb1897e9da2be6d5a5cbb5b4443"},"url":"https://api.github.com/repos/openai/codex/git/commits/1a6e07a4febcc0ecfa04464f5e95cb47144cd746","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/1a6e07a4febcc0ecfa04464f5e95cb47144cd746","html_url":"https://github.com/openai/codex/commit/1a6e07a4febcc0ecfa04464f5e95cb47144cd746","comments_url":"https://api.github.com/repos/openai/codex/commits/1a6e07a4febcc0ecfa04464f5e95cb47144cd746/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"45528c51320e191968131f4bd3e4f3f43e93ee08","url":"https://api.github.com/repos/openai/codex/commits/45528c51320e191968131f4bd3e4f3f43e93ee08","html_url":"https://github.com/openai/codex/commit/45528c51320e191968131f4bd3e4f3f43e93ee08"}]},{"sha":"45528c51320e191968131f4bd3e4f3f43e93ee08","node_id":"C_kwDOOYsS4doAKDQ1NTI4YzUxMzIwZTE5MTk2ODEzMWY0YmQzZTRmM2Y0M2U5M2VlMDg","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-08-18T21:32:44Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T22:16:48Z"},"message":"Allow overriding Codex package versions (#39298)\n\n## What changed\n\n- Add `--package-version` to set the version written to `codex-package.json`, while retaining the workspace package version as the default.\n- Reject values that are not runtime-compatible semantic versions, including overflowing numeric components and numeric prerelease identifiers with leading zeroes.\n- Document the new option.\n\n## Testing\n\n- Add unit coverage for valid release, prerelease, and build versions, plus malformed and out-of-range values.\n\nGitOrigin-RevId: cee996a6721e3fac9bd88f0bc0302a7ec7d2b2fb","tree":{"sha":"6b09c961ff4cb62886d8287d222137a34a08e93c","url":"https://api.github.com/repos/openai/codex/git/trees/6b09c961ff4cb62886d8287d222137a34a08e93c"},"url":"https://api.github.com/repos/openai/codex/git/commits/45528c51320e191968131f4bd3e4f3f43e93ee08","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/45528c51320e191968131f4bd3e4f3f43e93ee08","html_url":"https://github.com/openai/codex/commit/45528c51320e191968131f4bd3e4f3f43e93ee08","comments_url":"https://api.github.com/repos/openai/codex/commits/45528c51320e191968131f4bd3e4f3f43e93ee08/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"87070a77925cbffed8b34ddc99afaf40d56863aa","url":"https://api.github.com/repos/openai/codex/commits/87070a77925cbffed8b34ddc99afaf40d56863aa","html_url":"https://github.com/openai/codex/commit/87070a77925cbffed8b34ddc99afaf40d56863aa"}]},{"sha":"87070a77925cbffed8b34ddc99afaf40d56863aa","node_id":"C_kwDOOYsS4doAKDg3MDcwYTc3OTI1Y2JmZmVkOGIzNGRkYzk5YWZhZjQwZDU2ODYzYWE","commit":{"author":{"name":"Abhinav","email":"abhinav@openai.com","date":"2026-08-18T21:32:10Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T22:10:43Z"},"message":"Enable MCP tool hooks in Codex sessions (#39296)\n\n## What changed\n\n- Execute `mcp_tool` hook handlers through the session's shared MCP runtime, including managed hook configurations.\n- Restrict hook calls to already-connected, cataloged, and policy-allowed tools. Unavailable servers fail immediately without starting or reconnecting them.\n- Pass session metadata to hook tools, cap hook timeouts by the server timeout, and invoke hooks without model-tool approval or recursive hook dispatch.\n- Record handler type and execution mode in hook telemetry, and mark memory as externally influenced after successful or blocking MCP hooks when configured.\n\n## Testing\n\n- Added end-to-end coverage for prompt interpolation, hidden tools, blocking decisions, unavailable servers, thread metadata, approval bypass, and memory-mode handling.\n- Added MCP runtime coverage for startup readiness, tool filters, catalog revisions, and managed connector policy.\n\nGitOrigin-RevId: 1647cb801ebc5fa385c7bda9d9c266a389c611b8","tree":{"sha":"c8ee58554fdac5e0d9e77107e05c7668a4a312ec","url":"https://api.github.com/repos/openai/codex/git/trees/c8ee58554fdac5e0d9e77107e05c7668a4a312ec"},"url":"https://api.github.com/repos/openai/codex/git/commits/87070a77925cbffed8b34ddc99afaf40d56863aa","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/87070a77925cbffed8b34ddc99afaf40d56863aa","html_url":"https://github.com/openai/codex/commit/87070a77925cbffed8b34ddc99afaf40d56863aa","comments_url":"https://api.github.com/repos/openai/codex/commits/87070a77925cbffed8b34ddc99afaf40d56863aa/comments","author":{"login":"abhinav-oai","id":274334565,"node_id":"U_kgDOEFoDZQ","avatar_url":"https://avatars.githubusercontent.com/u/274334565?v=4","gravatar_id":"","url":"https://api.github.com/users/abhinav-oai","html_url":"https://github.com/abhinav-oai","followers_url":"https://api.github.com/users/abhinav-oai/followers","following_url":"https://api.github.com/users/abhinav-oai/following{/other_user}","gists_url":"https://api.github.com/users/abhinav-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/abhinav-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abhinav-oai/subscriptions","organizations_url":"https://api.github.com/users/abhinav-oai/orgs","repos_url":"https://api.github.com/users/abhinav-oai/repos","events_url":"https://api.github.com/users/abhinav-oai/events{/privacy}","received_events_url":"https://api.github.com/users/abhinav-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"701db965e583341e9e963f2af79ec172b887a171","url":"https://api.github.com/repos/openai/codex/commits/701db965e583341e9e963f2af79ec172b887a171","html_url":"https://github.com/openai/codex/commit/701db965e583341e9e963f2af79ec172b887a171"}]},{"sha":"701db965e583341e9e963f2af79ec172b887a171","node_id":"C_kwDOOYsS4doAKDcwMWRiOTY1ZTU4MzM0MWU5ZTk2M2YyYWY3OWVjMTcyYjg4N2ExNzE","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-18T21:27:13Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T22:05:07Z"},"message":"Increase SQLite log sink batching (#39294)\n\n## What changed\n\n- Increase the default bounded log queue capacity from 512 to 2,048 entries.\n- Raise the default insert batch size from 128 to 512 entries.\n- Extend the default periodic flush interval from 2 to 10 seconds.\n\nGitOrigin-RevId: e96be0996152b4a2a84d88c23d36959436685682","tree":{"sha":"9e7e3b876750f78e85d2ca196bceba1848e41426","url":"https://api.github.com/repos/openai/codex/git/trees/9e7e3b876750f78e85d2ca196bceba1848e41426"},"url":"https://api.github.com/repos/openai/codex/git/commits/701db965e583341e9e963f2af79ec172b887a171","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/701db965e583341e9e963f2af79ec172b887a171","html_url":"https://github.com/openai/codex/commit/701db965e583341e9e963f2af79ec172b887a171","comments_url":"https://api.github.com/repos/openai/codex/commits/701db965e583341e9e963f2af79ec172b887a171/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"17de14558b2b3385d87309a07bb66158b75f6ed3","url":"https://api.github.com/repos/openai/codex/commits/17de14558b2b3385d87309a07bb66158b75f6ed3","html_url":"https://github.com/openai/codex/commit/17de14558b2b3385d87309a07bb66158b75f6ed3"}]},{"sha":"17de14558b2b3385d87309a07bb66158b75f6ed3","node_id":"C_kwDOOYsS4doAKDE3ZGUxNDU1OGIyYjMzODVkODczMDlhMDdiYjY2MTU4Yjc1ZjZlZDM","commit":{"author":{"name":"Celia Chen","email":"celia@openai.com","date":"2026-08-18T21:26:28Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T22:00:25Z"},"message":"Remove app-server's direct reqwest dependency (#39293)\n\n## Why\n\n`codex-http-client` is the intended owner of `reqwest`, while direct first-party\ndependencies are tracked as migration debt.\n\n## What changed\n\n- Build app-server test HTTP clients through `HttpClientBuilder`.\n- Use `http` and `url` types directly where only protocol types are needed.\n- Remove `reqwest` from `codex-app-server` and its temporary dependency-policy\n  exception.\n\nGitOrigin-RevId: ff9f14a54bc20ec1ea39050bbe08c381ee376119","tree":{"sha":"953925e02c847ac4db6a05111bd10f7a9724d971","url":"https://api.github.com/repos/openai/codex/git/trees/953925e02c847ac4db6a05111bd10f7a9724d971"},"url":"https://api.github.com/repos/openai/codex/git/commits/17de14558b2b3385d87309a07bb66158b75f6ed3","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/17de14558b2b3385d87309a07bb66158b75f6ed3","html_url":"https://github.com/openai/codex/commit/17de14558b2b3385d87309a07bb66158b75f6ed3","comments_url":"https://api.github.com/repos/openai/codex/commits/17de14558b2b3385d87309a07bb66158b75f6ed3/comments","author":{"login":"celia-oai","id":209693228,"node_id":"U_kgDODH-qLA","avatar_url":"https://avatars.githubusercontent.com/u/209693228?v=4","gravatar_id":"","url":"https://api.github.com/users/celia-oai","html_url":"https://github.com/celia-oai","followers_url":"https://api.github.com/users/celia-oai/followers","following_url":"https://api.github.com/users/celia-oai/following{/other_user}","gists_url":"https://api.github.com/users/celia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/celia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celia-oai/subscriptions","organizations_url":"https://api.github.com/users/celia-oai/orgs","repos_url":"https://api.github.com/users/celia-oai/repos","events_url":"https://api.github.com/users/celia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/celia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"633bd4abf7b223f826032f6f13e6c7f67c9d9185","url":"https://api.github.com/repos/openai/codex/commits/633bd4abf7b223f826032f6f13e6c7f67c9d9185","html_url":"https://github.com/openai/codex/commit/633bd4abf7b223f826032f6f13e6c7f67c9d9185"}]},{"sha":"633bd4abf7b223f826032f6f13e6c7f67c9d9185","node_id":"C_kwDOOYsS4doAKDYzM2JkNGFiZjdiMjIzZjgyNjAzMmY2ZjEzZTZjN2Y2N2M5ZDkxODU","commit":{"author":{"name":"chess","email":"chess@openai.com","date":"2026-08-18T21:24:46Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T21:56:54Z"},"message":"Add Windows sandbox diagnostics to `codex doctor` (#39290)\n\n## What changed\n\n- Report the configured Windows sandbox backend and whether denied-read restrictions are active.\n- Diagnose incompatible backend policy, incomplete or failed elevated sandbox provisioning, unreadable setup failure reports, and missing, locked, disabled, or expired sandbox accounts.\n- Provide issue-specific remediation and promote the sandbox check status and summary to the highest detected severity.\n- Export the Windows sandbox setup data needed by the diagnostic check.\n\n## Testing\n\n- Cover missing Linux helpers and malformed or oversized Windows setup failure reports.\n- Cover a recorded Windows sandbox refresh failure after setup completed.\n\nGitOrigin-RevId: e965b703578a5c0597dcce9f836d2e1f510ad0c8","tree":{"sha":"4613a720941eadd0ed23ff3efd9a48a9b2733332","url":"https://api.github.com/repos/openai/codex/git/trees/4613a720941eadd0ed23ff3efd9a48a9b2733332"},"url":"https://api.github.com/repos/openai/codex/git/commits/633bd4abf7b223f826032f6f13e6c7f67c9d9185","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/633bd4abf7b223f826032f6f13e6c7f67c9d9185","html_url":"https://github.com/openai/codex/commit/633bd4abf7b223f826032f6f13e6c7f67c9d9185","comments_url":"https://api.github.com/repos/openai/codex/commits/633bd4abf7b223f826032f6f13e6c7f67c9d9185/comments","author":{"login":"chess-oai","id":289791516,"node_id":"U_kgDOEUXeHA","avatar_url":"https://avatars.githubusercontent.com/u/289791516?v=4","gravatar_id":"","url":"https://api.github.com/users/chess-oai","html_url":"https://github.com/chess-oai","followers_url":"https://api.github.com/users/chess-oai/followers","following_url":"https://api.github.com/users/chess-oai/following{/other_user}","gists_url":"https://api.github.com/users/chess-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/chess-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chess-oai/subscriptions","organizations_url":"https://api.github.com/users/chess-oai/orgs","repos_url":"https://api.github.com/users/chess-oai/repos","events_url":"https://api.github.com/users/chess-oai/events{/privacy}","received_events_url":"https://api.github.com/users/chess-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"ccf4191582523186df449725eed9492e368e945f","url":"https://api.github.com/repos/openai/codex/commits/ccf4191582523186df449725eed9492e368e945f","html_url":"https://github.com/openai/codex/commit/ccf4191582523186df449725eed9492e368e945f"}]},{"sha":"ccf4191582523186df449725eed9492e368e945f","node_id":"C_kwDOOYsS4doAKGNjZjQxOTE1ODI1MjMxODZkZjQ0OTcyNWVlZDk0OTJlMzY4ZTk0NWY","commit":{"author":{"name":"rka-oai","email":"rka@openai.com","date":"2026-08-18T21:23:37Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T21:49:49Z"},"message":"Register the async message feature flag (#39288)\n\n## What changed\n\n- Add the under-development `send_async_message` feature, disabled by default.\n- Expose the feature key in the generated configuration schema.\n\nGitOrigin-RevId: dd27483f2ef802dba49e47f3ce03146ee6a58f1e","tree":{"sha":"d0ab87428d95b20046a8af6b7875305e638001fb","url":"https://api.github.com/repos/openai/codex/git/trees/d0ab87428d95b20046a8af6b7875305e638001fb"},"url":"https://api.github.com/repos/openai/codex/git/commits/ccf4191582523186df449725eed9492e368e945f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/ccf4191582523186df449725eed9492e368e945f","html_url":"https://github.com/openai/codex/commit/ccf4191582523186df449725eed9492e368e945f","comments_url":"https://api.github.com/repos/openai/codex/commits/ccf4191582523186df449725eed9492e368e945f/comments","author":{"login":"rka-oai","id":240799229,"node_id":"U_kgDODlpN_Q","avatar_url":"https://avatars.githubusercontent.com/u/240799229?v=4","gravatar_id":"","url":"https://api.github.com/users/rka-oai","html_url":"https://github.com/rka-oai","followers_url":"https://api.github.com/users/rka-oai/followers","following_url":"https://api.github.com/users/rka-oai/following{/other_user}","gists_url":"https://api.github.com/users/rka-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rka-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rka-oai/subscriptions","organizations_url":"https://api.github.com/users/rka-oai/orgs","repos_url":"https://api.github.com/users/rka-oai/repos","events_url":"https://api.github.com/users/rka-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rka-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"997a80020f5bb129c6804e8046d09fb0231751c6","url":"https://api.github.com/repos/openai/codex/commits/997a80020f5bb129c6804e8046d09fb0231751c6","html_url":"https://github.com/openai/codex/commit/997a80020f5bb129c6804e8046d09fb0231751c6"}]},{"sha":"997a80020f5bb129c6804e8046d09fb0231751c6","node_id":"C_kwDOOYsS4doAKDk5N2E4MDAyMGY1YmIxMjljNjgwNGU4MDQ2ZDA5ZmIwMjMxNzUxYzY","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-18T21:22:14Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T21:46:18Z"},"message":"Report diagnostic upload failures (#39287)\n\n## Why\n\nSubmitting a diagnostic report could appear successful without confirming that Sentry accepted the upload, leaving callers unable to detect transport or HTTP failures.\n\n## What changed\n\n- Send report envelopes through the route-aware HTTP client and await the response.\n- Reject redirects, propagate transport and non-success HTTP responses, and include the full error chain in upload JSON-RPC errors.\n- Add structured logs for upload attempts, successes, and failures without including report contents.\n\n## Testing\n\nAdded coverage for successful uploads, rejected responses, blocked redirects, transport failures, and app-server JSON-RPC error reporting.\n\nGitOrigin-RevId: 07b5cfccd7a65f35d51a720537d2cd8962ed6cdb","tree":{"sha":"02e2eafa3a2597f079808049baf2368233bd1791","url":"https://api.github.com/repos/openai/codex/git/trees/02e2eafa3a2597f079808049baf2368233bd1791"},"url":"https://api.github.com/repos/openai/codex/git/commits/997a80020f5bb129c6804e8046d09fb0231751c6","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/997a80020f5bb129c6804e8046d09fb0231751c6","html_url":"https://github.com/openai/codex/commit/997a80020f5bb129c6804e8046d09fb0231751c6","comments_url":"https://api.github.com/repos/openai/codex/commits/997a80020f5bb129c6804e8046d09fb0231751c6/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"e7f9fa9cd9cefa7d21361586c206ea56b6f8cfea","url":"https://api.github.com/repos/openai/codex/commits/e7f9fa9cd9cefa7d21361586c206ea56b6f8cfea","html_url":"https://github.com/openai/codex/commit/e7f9fa9cd9cefa7d21361586c206ea56b6f8cfea"}]},{"sha":"e7f9fa9cd9cefa7d21361586c206ea56b6f8cfea","node_id":"C_kwDOOYsS4doAKGU3ZjlmYTljZDljZWZhN2QyMTM2MTU4NmMyMDZlYTU2YjZmOGNmZWE","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-18T21:20:08Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T21:43:22Z"},"message":"Show file destinations in TUI change approvals (#39285)\n\n## What changed\n\n- Show a description and the destination paths affected by each file-change approval.\n- Include both source and target paths for moves, format cross-platform paths for display, and show `unavailable` when change details are missing.\n- Recover file changes from buffered events and thread snapshots so live and replayed approvals retain their destination details.\n\n## Testing\n\n- Add coverage for active and replayed approvals, moved and cross-platform paths, and the missing-destination fallback.\n\nGitOrigin-RevId: 24f90b313fd8643f90cbead1504c788b140d7fed","tree":{"sha":"6e273773ba733ab021c30527b08ce075f4a64ddb","url":"https://api.github.com/repos/openai/codex/git/trees/6e273773ba733ab021c30527b08ce075f4a64ddb"},"url":"https://api.github.com/repos/openai/codex/git/commits/e7f9fa9cd9cefa7d21361586c206ea56b6f8cfea","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/e7f9fa9cd9cefa7d21361586c206ea56b6f8cfea","html_url":"https://github.com/openai/codex/commit/e7f9fa9cd9cefa7d21361586c206ea56b6f8cfea","comments_url":"https://api.github.com/repos/openai/codex/commits/e7f9fa9cd9cefa7d21361586c206ea56b6f8cfea/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"ba37d0c45b46ede95df9e5acdd0cabf02fdda51b","url":"https://api.github.com/repos/openai/codex/commits/ba37d0c45b46ede95df9e5acdd0cabf02fdda51b","html_url":"https://github.com/openai/codex/commit/ba37d0c45b46ede95df9e5acdd0cabf02fdda51b"}]},{"sha":"ba37d0c45b46ede95df9e5acdd0cabf02fdda51b","node_id":"C_kwDOOYsS4doAKGJhMzdkMGM0NWI0NmVkZTk1ZGY5ZTVhY2RkMGNhYmYwMmZkZGE1MWI","commit":{"author":{"name":"Dylan Hurd","email":"dylan.hurd@openai.com","date":"2026-08-18T21:11:53Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T21:30:45Z"},"message":"Report network disconnects during approval (#39284)\n\n## Why\n\nWhen a local proxy request disconnects before network approval completes, the\nowning tool call needs a model-visible explanation instead of remaining tied to\nthe abandoned request.\n\n## What changed\n\n- Track disconnect timing while plain HTTP and CONNECT requests await policy\n  decisions.\n- Cancel the owning execution and report how long the request waited when it\n  disconnects before approval completes.\n- Preserve an explicit approval outcome when disconnect cleanup runs afterward.\n\n## Testing\n\nAdded unit coverage for disconnect tracking and outcome precedence, plus\nend-to-end coverage for plain HTTP and CONNECT requests.\n\nGitOrigin-RevId: b354b29bbe86f38e252fcaf529541f177480136b","tree":{"sha":"eb044d89b3d0f4e2d6792faaa655d2eab097c213","url":"https://api.github.com/repos/openai/codex/git/trees/eb044d89b3d0f4e2d6792faaa655d2eab097c213"},"url":"https://api.github.com/repos/openai/codex/git/commits/ba37d0c45b46ede95df9e5acdd0cabf02fdda51b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/ba37d0c45b46ede95df9e5acdd0cabf02fdda51b","html_url":"https://github.com/openai/codex/commit/ba37d0c45b46ede95df9e5acdd0cabf02fdda51b","comments_url":"https://api.github.com/repos/openai/codex/commits/ba37d0c45b46ede95df9e5acdd0cabf02fdda51b/comments","author":{"login":"dylan-hurd-oai","id":220976066,"node_id":"U_kgDODSvTwg","avatar_url":"https://avatars.githubusercontent.com/u/220976066?v=4","gravatar_id":"","url":"https://api.github.com/users/dylan-hurd-oai","html_url":"https://github.com/dylan-hurd-oai","followers_url":"https://api.github.com/users/dylan-hurd-oai/followers","following_url":"https://api.github.com/users/dylan-hurd-oai/following{/other_user}","gists_url":"https://api.github.com/users/dylan-hurd-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/dylan-hurd-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dylan-hurd-oai/subscriptions","organizations_url":"https://api.github.com/users/dylan-hurd-oai/orgs","repos_url":"https://api.github.com/users/dylan-hurd-oai/repos","events_url":"https://api.github.com/users/dylan-hurd-oai/events{/privacy}","received_events_url":"https://api.github.com/users/dylan-hurd-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"2fe4e06cc23bda9d8a719fbcf3d3712e42d450de","url":"https://api.github.com/repos/openai/codex/commits/2fe4e06cc23bda9d8a719fbcf3d3712e42d450de","html_url":"https://github.com/openai/codex/commit/2fe4e06cc23bda9d8a719fbcf3d3712e42d450de"}]},{"sha":"2fe4e06cc23bda9d8a719fbcf3d3712e42d450de","node_id":"C_kwDOOYsS4doAKDJmZTRlMDZjYzIzYmRhOWQ4YTcxOWZiY2YzZDM3MTJlNDJkNDUwZGU","commit":{"author":{"name":"viyatb-oai","email":"viyatb@openai.com","date":"2026-08-18T21:11:17Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T21:18:48Z"},"message":"Document secure devcontainer DNS exfiltration risk (#39283)\n\n## Why\n\nThe secure devcontainer's firewall does not apply its domain allowlist to DNS\ntraffic, so it does not provide secure DNS resolution for untrusted code.\n\n## What changed\n\nDocument the DNS exfiltration risk, limit the devcontainer recommendation to\ntrusted repositories, and describe filtering DNS through a restricted resolver\nas a partial mitigation. Clarify that allowlisted HTTPS destinations remain a\npossible exfiltration path.\n\nGitOrigin-RevId: 73cc7d29f8de17013c01411f8c20b8b5e1199b24","tree":{"sha":"0c8e6f31b1b9939a8347596541e1b99755453fec","url":"https://api.github.com/repos/openai/codex/git/trees/0c8e6f31b1b9939a8347596541e1b99755453fec"},"url":"https://api.github.com/repos/openai/codex/git/commits/2fe4e06cc23bda9d8a719fbcf3d3712e42d450de","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/2fe4e06cc23bda9d8a719fbcf3d3712e42d450de","html_url":"https://github.com/openai/codex/commit/2fe4e06cc23bda9d8a719fbcf3d3712e42d450de","comments_url":"https://api.github.com/repos/openai/codex/commits/2fe4e06cc23bda9d8a719fbcf3d3712e42d450de/comments","author":{"login":"viyatb-oai","id":234056686,"node_id":"U_kgDODfNr7g","avatar_url":"https://avatars.githubusercontent.com/u/234056686?v=4","gravatar_id":"","url":"https://api.github.com/users/viyatb-oai","html_url":"https://github.com/viyatb-oai","followers_url":"https://api.github.com/users/viyatb-oai/followers","following_url":"https://api.github.com/users/viyatb-oai/following{/other_user}","gists_url":"https://api.github.com/users/viyatb-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/viyatb-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/viyatb-oai/subscriptions","organizations_url":"https://api.github.com/users/viyatb-oai/orgs","repos_url":"https://api.github.com/users/viyatb-oai/repos","events_url":"https://api.github.com/users/viyatb-oai/events{/privacy}","received_events_url":"https://api.github.com/users/viyatb-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"681c82f4979ac9dd2fdaded8539b0845ca5f5955","url":"https://api.github.com/repos/openai/codex/commits/681c82f4979ac9dd2fdaded8539b0845ca5f5955","html_url":"https://github.com/openai/codex/commit/681c82f4979ac9dd2fdaded8539b0845ca5f5955"}]},{"sha":"681c82f4979ac9dd2fdaded8539b0845ca5f5955","node_id":"C_kwDOOYsS4doAKDY4MWM4MmY0OTc5YWM5ZGQyZmRhZGVkODUzOWIwODQ1Y2E1ZjU5NTU","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-18T21:03:50Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T21:11:30Z"},"message":"Move shell snapshot scripts into `codex-shell-command` (#39281)\n\n## What changed\n\n- Add a public `snapshot_script` helper to `codex-shell-command` for Bash,\n  Zsh, POSIX shell, and PowerShell, returning `None` for Command Prompt.\n- Update `codex-core` and its shell snapshot tests to use the shared helper\n  without changing snapshot behavior.\n\nGitOrigin-RevId: 779b9dc964635b717922ea9f5646b94c4dbb0da1","tree":{"sha":"0edb49d794130de4540f1c243936334fb98cc002","url":"https://api.github.com/repos/openai/codex/git/trees/0edb49d794130de4540f1c243936334fb98cc002"},"url":"https://api.github.com/repos/openai/codex/git/commits/681c82f4979ac9dd2fdaded8539b0845ca5f5955","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/681c82f4979ac9dd2fdaded8539b0845ca5f5955","html_url":"https://github.com/openai/codex/commit/681c82f4979ac9dd2fdaded8539b0845ca5f5955","comments_url":"https://api.github.com/repos/openai/codex/commits/681c82f4979ac9dd2fdaded8539b0845ca5f5955/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"88c39c457891565b6f792e92d1af77d4f22768fe","url":"https://api.github.com/repos/openai/codex/commits/88c39c457891565b6f792e92d1af77d4f22768fe","html_url":"https://github.com/openai/codex/commit/88c39c457891565b6f792e92d1af77d4f22768fe"}]},{"sha":"88c39c457891565b6f792e92d1af77d4f22768fe","node_id":"C_kwDOOYsS4doAKDg4YzM5YzQ1Nzg5MTU2NWI2Zjc5MmU5MmQxYWY3N2Q0ZjIyNzY4ZmU","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-08-18T20:44:04Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T20:56:10Z"},"message":"Propagate Windows sandbox ACL update failures (#39279)\n\n## Why\n\nWindows sandbox preflight could report success when applying a deny ACE failed,\nleaving a detected world-writable path without the intended capability\nrestriction.\n\n## What changed\n\n- Return errors from `SetEntriesInAclW` and `SetNamedSecurityInfoW`, including the\n  affected path in ACL API errors.\n- Attempt every flagged path, aggregate deny-ACE failures, and fail preflight\n  after logging them.\n- Preserve cleanup of security descriptors and newly allocated ACLs on failure.\n\n## Testing\n\nAdded tests that verify ACL API failures are returned and that preflight keeps\nprocessing remaining paths before propagating an error.\n\nGitOrigin-RevId: e2be1c70f72840046dc55760364de7bcf3b1bdc9","tree":{"sha":"e08595aca89af3a9e1c962b2f22ba883f4e5bece","url":"https://api.github.com/repos/openai/codex/git/trees/e08595aca89af3a9e1c962b2f22ba883f4e5bece"},"url":"https://api.github.com/repos/openai/codex/git/commits/88c39c457891565b6f792e92d1af77d4f22768fe","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/88c39c457891565b6f792e92d1af77d4f22768fe","html_url":"https://github.com/openai/codex/commit/88c39c457891565b6f792e92d1af77d4f22768fe","comments_url":"https://api.github.com/repos/openai/codex/commits/88c39c457891565b6f792e92d1af77d4f22768fe/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"392328ed5d2030cee129b9831dbe995a6301d572","url":"https://api.github.com/repos/openai/codex/commits/392328ed5d2030cee129b9831dbe995a6301d572","html_url":"https://github.com/openai/codex/commit/392328ed5d2030cee129b9831dbe995a6301d572"}]},{"sha":"392328ed5d2030cee129b9831dbe995a6301d572","node_id":"C_kwDOOYsS4doAKDM5MjMyOGVkNWQyMDMwY2VlMTI5Yjk4MzFkYmU5OTVhNjMwMWQ1NzI","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-08-18T20:36:13Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T20:49:36Z"},"message":"Preserve owner-provided environment configuration (#39278)\n\n## Why\n\nThread settings could replace an owner-provided environment configuration with\n`FromThread`, allowing the thread to take ownership of that configuration.\n\n## What changed\n\nReject environment settings updates that change an existing owner-provided\nconfiguration to `FromThread`.\n\n## Testing\n\nCover preview and turn settings updates for pending, ready, and failed\nowner-provided environments.\n\nGitOrigin-RevId: c516954819447ceb29e2ff9f29fe781ca101ae54","tree":{"sha":"9d2ac7f98c3695ae3379b9b59474f97159eafcd2","url":"https://api.github.com/repos/openai/codex/git/trees/9d2ac7f98c3695ae3379b9b59474f97159eafcd2"},"url":"https://api.github.com/repos/openai/codex/git/commits/392328ed5d2030cee129b9831dbe995a6301d572","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/392328ed5d2030cee129b9831dbe995a6301d572","html_url":"https://github.com/openai/codex/commit/392328ed5d2030cee129b9831dbe995a6301d572","comments_url":"https://api.github.com/repos/openai/codex/commits/392328ed5d2030cee129b9831dbe995a6301d572/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"884a193b78fd323a2a40e6007f9001ebff47d79e","url":"https://api.github.com/repos/openai/codex/commits/884a193b78fd323a2a40e6007f9001ebff47d79e","html_url":"https://github.com/openai/codex/commit/884a193b78fd323a2a40e6007f9001ebff47d79e"}]},{"sha":"884a193b78fd323a2a40e6007f9001ebff47d79e","node_id":"C_kwDOOYsS4doAKDg4NGExOTNiNzhmZDMyM2EyYTQwZTYwMDdmOTAwMWViZmY0N2Q3OWU","commit":{"author":{"name":"alexsong-oai","email":"alexsong@openai.com","date":"2026-08-18T20:34:22Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T20:44:19Z"},"message":"Declare experimental Amazon Bedrock setup APIs (#39277)\n\n## What changed\n\n- Add experimental `account/bedrock/discover` and `account/bedrock/setup`\n  requests to the app-server protocol.\n- Define discovery results for AWS profiles and environment credentials, plus\n  setup inputs for profiles, environment credentials, and access keys.\n- Export the new types in the experimental protocol schema. The app server\n  currently returns `method not found` for both requests because setup is not\n  yet implemented.\n\nGitOrigin-RevId: 656b4bc11231a417e97041068cecc5dc692786e3","tree":{"sha":"b94fbabe121221881fb342afc242ddabbc92651a","url":"https://api.github.com/repos/openai/codex/git/trees/b94fbabe121221881fb342afc242ddabbc92651a"},"url":"https://api.github.com/repos/openai/codex/git/commits/884a193b78fd323a2a40e6007f9001ebff47d79e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/884a193b78fd323a2a40e6007f9001ebff47d79e","html_url":"https://github.com/openai/codex/commit/884a193b78fd323a2a40e6007f9001ebff47d79e","comments_url":"https://api.github.com/repos/openai/codex/commits/884a193b78fd323a2a40e6007f9001ebff47d79e/comments","author":{"login":"alexsong-oai","id":256201575,"node_id":"U_kgDOD0VTZw","avatar_url":"https://avatars.githubusercontent.com/u/256201575?v=4","gravatar_id":"","url":"https://api.github.com/users/alexsong-oai","html_url":"https://github.com/alexsong-oai","followers_url":"https://api.github.com/users/alexsong-oai/followers","following_url":"https://api.github.com/users/alexsong-oai/following{/other_user}","gists_url":"https://api.github.com/users/alexsong-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/alexsong-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alexsong-oai/subscriptions","organizations_url":"https://api.github.com/users/alexsong-oai/orgs","repos_url":"https://api.github.com/users/alexsong-oai/repos","events_url":"https://api.github.com/users/alexsong-oai/events{/privacy}","received_events_url":"https://api.github.com/users/alexsong-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"22b860e80b06dff3c5e86160e5dc3199b7816693","url":"https://api.github.com/repos/openai/codex/commits/22b860e80b06dff3c5e86160e5dc3199b7816693","html_url":"https://github.com/openai/codex/commit/22b860e80b06dff3c5e86160e5dc3199b7816693"}]},{"sha":"22b860e80b06dff3c5e86160e5dc3199b7816693","node_id":"C_kwDOOYsS4doAKDIyYjg2MGU4MGIwNmRmZjNjNWU4NjE2MGU1ZGMzMTk5Yjc4MTY2OTM","commit":{"author":{"name":"alexsong-oai","email":"alexsong@openai.com","date":"2026-08-18T19:59:21Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T20:14:17Z"},"message":"Add provider-owned authentication recovery (#39274)\n\n## What changed\n\n- Let model providers identify recoverable authentication errors and refresh their own authentication state before falling back to `AuthManager` recovery.\n- Apply provider recovery to both HTTP and WebSocket response requests, with at most one provider-owned recovery attempt per request.\n- Preserve existing `401 Unauthorized` handling as the default for providers that do not customize recovery.\n\n## Testing\n\n- Add coverage for successful and failed provider recovery, including the single-attempt bound and preservation of the original unauthorized error.\n\nGitOrigin-RevId: 9a737e3be96354699586f97dd88e544a45082969","tree":{"sha":"3b53556de5e6f3a3f288227afd143c87b5d79951","url":"https://api.github.com/repos/openai/codex/git/trees/3b53556de5e6f3a3f288227afd143c87b5d79951"},"url":"https://api.github.com/repos/openai/codex/git/commits/22b860e80b06dff3c5e86160e5dc3199b7816693","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/22b860e80b06dff3c5e86160e5dc3199b7816693","html_url":"https://github.com/openai/codex/commit/22b860e80b06dff3c5e86160e5dc3199b7816693","comments_url":"https://api.github.com/repos/openai/codex/commits/22b860e80b06dff3c5e86160e5dc3199b7816693/comments","author":{"login":"alexsong-oai","id":256201575,"node_id":"U_kgDOD0VTZw","avatar_url":"https://avatars.githubusercontent.com/u/256201575?v=4","gravatar_id":"","url":"https://api.github.com/users/alexsong-oai","html_url":"https://github.com/alexsong-oai","followers_url":"https://api.github.com/users/alexsong-oai/followers","following_url":"https://api.github.com/users/alexsong-oai/following{/other_user}","gists_url":"https://api.github.com/users/alexsong-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/alexsong-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alexsong-oai/subscriptions","organizations_url":"https://api.github.com/users/alexsong-oai/orgs","repos_url":"https://api.github.com/users/alexsong-oai/repos","events_url":"https://api.github.com/users/alexsong-oai/events{/privacy}","received_events_url":"https://api.github.com/users/alexsong-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"f950a1ba0b12884605d98a48fbedaeccff29dd0e","url":"https://api.github.com/repos/openai/codex/commits/f950a1ba0b12884605d98a48fbedaeccff29dd0e","html_url":"https://github.com/openai/codex/commit/f950a1ba0b12884605d98a48fbedaeccff29dd0e"}]},{"sha":"f950a1ba0b12884605d98a48fbedaeccff29dd0e","node_id":"C_kwDOOYsS4doAKGY5NTBhMWJhMGIxMjg4NDYwNWQ5OGE0OGZiZWRhZWNjZmYyOWRkMGU","commit":{"author":{"name":"Owen Lin","email":"owen@openai.com","date":"2026-08-18T19:57:47Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T20:07:26Z"},"message":"Preserve thread names during rollout migration (#39273)\n\n## Why\n\nLegacy threads and paginated threads read their displayed names from different metadata. Moving a rollout to paginated history must carry over its legacy-visible name so renamed threads do not lose it.\n\n## What changed\n\n- Load legacy indexed names once for an apply run.\n- When promoting a thread, preserve an existing canonical name or copy its distinct legacy title, falling back to the legacy name index.\n- Repair missing names when migration encounters an already-paginated rollout.\n\n## Testing\n\nAdded migration tests covering preservation from both legacy name sources and repair on a rerun.\n\nGitOrigin-RevId: 5fc526570b1cf358a159ef174c159ac091ccc40f","tree":{"sha":"34395ba016dcf12f2fae5021c719a7b2eb08e6c1","url":"https://api.github.com/repos/openai/codex/git/trees/34395ba016dcf12f2fae5021c719a7b2eb08e6c1"},"url":"https://api.github.com/repos/openai/codex/git/commits/f950a1ba0b12884605d98a48fbedaeccff29dd0e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/f950a1ba0b12884605d98a48fbedaeccff29dd0e","html_url":"https://github.com/openai/codex/commit/f950a1ba0b12884605d98a48fbedaeccff29dd0e","comments_url":"https://api.github.com/repos/openai/codex/commits/f950a1ba0b12884605d98a48fbedaeccff29dd0e/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4a3e829c56415f8c1e69b18fbe74f4d81eaa926a","url":"https://api.github.com/repos/openai/codex/commits/4a3e829c56415f8c1e69b18fbe74f4d81eaa926a","html_url":"https://github.com/openai/codex/commit/4a3e829c56415f8c1e69b18fbe74f4d81eaa926a"}]},{"sha":"4a3e829c56415f8c1e69b18fbe74f4d81eaa926a","node_id":"C_kwDOOYsS4doAKDRhM2U4MjljNTY0MTVmOGMxZTY5YjE4ZmJlNzRmNGQ4MWVhYTkyNmE","commit":{"author":{"name":"olliem-oai","email":"olliem@openai.com","date":"2026-08-18T19:10:35Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T19:22:31Z"},"message":"Inject Node REPL policy into Guardian review sessions (#39267)\n\n## What changed\n\n- Add a dedicated developer policy for Guardian reviews of Node REPL browser and computer-use actions.\n- Inject the policy once before the first eligible Node REPL approval and retain it when the reviewer session is reused.\n- Include Node REPL policy eligibility in the reviewer reuse key so sessions are not reused across incompatible model settings.\n- Keep the approval request itself on the generic planned-action format.\n\n## Testing\n\n- Cover first-action injection, reuse after a shell review, repeated Node REPL reviews, and ineligible parent models through the production approval path.\n\nGitOrigin-RevId: bfce190ff8599788aa85e388cc6a959d27fb489c","tree":{"sha":"f763b87bf71619f48479626196ac264c18cc5333","url":"https://api.github.com/repos/openai/codex/git/trees/f763b87bf71619f48479626196ac264c18cc5333"},"url":"https://api.github.com/repos/openai/codex/git/commits/4a3e829c56415f8c1e69b18fbe74f4d81eaa926a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4a3e829c56415f8c1e69b18fbe74f4d81eaa926a","html_url":"https://github.com/openai/codex/commit/4a3e829c56415f8c1e69b18fbe74f4d81eaa926a","comments_url":"https://api.github.com/repos/openai/codex/commits/4a3e829c56415f8c1e69b18fbe74f4d81eaa926a/comments","author":{"login":"olliem-oai","id":240798946,"node_id":"U_kgDODlpM4g","avatar_url":"https://avatars.githubusercontent.com/u/240798946?v=4","gravatar_id":"","url":"https://api.github.com/users/olliem-oai","html_url":"https://github.com/olliem-oai","followers_url":"https://api.github.com/users/olliem-oai/followers","following_url":"https://api.github.com/users/olliem-oai/following{/other_user}","gists_url":"https://api.github.com/users/olliem-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/olliem-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/olliem-oai/subscriptions","organizations_url":"https://api.github.com/users/olliem-oai/orgs","repos_url":"https://api.github.com/users/olliem-oai/repos","events_url":"https://api.github.com/users/olliem-oai/events{/privacy}","received_events_url":"https://api.github.com/users/olliem-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"d68b85a0978e15c49c6e96bde1f73ddaeac35d79","url":"https://api.github.com/repos/openai/codex/commits/d68b85a0978e15c49c6e96bde1f73ddaeac35d79","html_url":"https://github.com/openai/codex/commit/d68b85a0978e15c49c6e96bde1f73ddaeac35d79"}]},{"sha":"d68b85a0978e15c49c6e96bde1f73ddaeac35d79","node_id":"C_kwDOOYsS4doAKGQ2OGI4NWEwOTc4ZTE1YzQ5YzZlOTZiZGUxZjczZGRhZWFjMzVkNzk","commit":{"author":{"name":"Dylan Hurd","email":"dylan.hurd@openai.com","date":"2026-08-18T19:08:07Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T19:17:09Z"},"message":"Require fresh approval beneath denied permission paths (#39266)\n\n## Why\n\nA stored permission grant may allow access to a parent while explicitly denying\na child path. A later request for that child must not be treated as already\napproved by the broader parent grant.\n\n## What changed\n\n- Compare materialized permission profiles without intersecting away denied or\n  reopened paths before deciding that a request is preapproved.\n- Execute preapproved commands with the stored grant itself so its denied paths\n  remain enforced.\n- Fail closed when permission profiles cannot be materialized.\n\n## Testing\n\nAdded unit and integration coverage for turn and session grants across\n`exec_command`, `shell_command`, and `apply_patch`, including approval-disabled\nand `Never` approval modes.\n\nGitOrigin-RevId: 5455880328a89c7958f859c7ce87805dff9704fb","tree":{"sha":"e686ad0cf805c3c9a81db3e72e3542fc1e6d0bb8","url":"https://api.github.com/repos/openai/codex/git/trees/e686ad0cf805c3c9a81db3e72e3542fc1e6d0bb8"},"url":"https://api.github.com/repos/openai/codex/git/commits/d68b85a0978e15c49c6e96bde1f73ddaeac35d79","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/d68b85a0978e15c49c6e96bde1f73ddaeac35d79","html_url":"https://github.com/openai/codex/commit/d68b85a0978e15c49c6e96bde1f73ddaeac35d79","comments_url":"https://api.github.com/repos/openai/codex/commits/d68b85a0978e15c49c6e96bde1f73ddaeac35d79/comments","author":{"login":"dylan-hurd-oai","id":220976066,"node_id":"U_kgDODSvTwg","avatar_url":"https://avatars.githubusercontent.com/u/220976066?v=4","gravatar_id":"","url":"https://api.github.com/users/dylan-hurd-oai","html_url":"https://github.com/dylan-hurd-oai","followers_url":"https://api.github.com/users/dylan-hurd-oai/followers","following_url":"https://api.github.com/users/dylan-hurd-oai/following{/other_user}","gists_url":"https://api.github.com/users/dylan-hurd-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/dylan-hurd-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dylan-hurd-oai/subscriptions","organizations_url":"https://api.github.com/users/dylan-hurd-oai/orgs","repos_url":"https://api.github.com/users/dylan-hurd-oai/repos","events_url":"https://api.github.com/users/dylan-hurd-oai/events{/privacy}","received_events_url":"https://api.github.com/users/dylan-hurd-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"846a16852f6bcd155d552236d4d893749c6130e6","url":"https://api.github.com/repos/openai/codex/commits/846a16852f6bcd155d552236d4d893749c6130e6","html_url":"https://github.com/openai/codex/commit/846a16852f6bcd155d552236d4d893749c6130e6"}]},{"sha":"846a16852f6bcd155d552236d4d893749c6130e6","node_id":"C_kwDOOYsS4doAKDg0NmExNjg1MmY2YmNkMTU1ZDU1MjIzNmQ0ZDg5Mzc0OWM2MTMwZTY","commit":{"author":{"name":"olliem-oai","email":"olliem@openai.com","date":"2026-08-18T19:01:58Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T19:12:30Z"},"message":"Improve Guardian v2 risk classification (#39264)\n\n## What changed\n\n- Replace the minimal default classifier prompt with predictive security-review guidance covering authorization, action risk, untrusted evidence, and browser or computer use.\n- Trigger full Guardian review at an `action_risk` score of `0.5` or higher for the new default prompt, while retaining the `0.8` calibration for custom and model-provided prompts unless they specify a threshold.\n- Render security policy configuration into prompt templates before enforcing the classifier instruction token limit. Prompts without the policy placeholder retain the existing append-and-truncate behavior.\n\n## Testing\n\n- Cover default, custom, and model-provided prompt thresholds and precedence.\n- Verify policy substitution, truncation, sampling requests, and full review at the threshold boundary.\n\nGitOrigin-RevId: 7aad9e2d8c9fbea453dc52147a3d0a46bf191aec","tree":{"sha":"226e5ccac75c271eba6e4b99dc99a244179f6018","url":"https://api.github.com/repos/openai/codex/git/trees/226e5ccac75c271eba6e4b99dc99a244179f6018"},"url":"https://api.github.com/repos/openai/codex/git/commits/846a16852f6bcd155d552236d4d893749c6130e6","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/846a16852f6bcd155d552236d4d893749c6130e6","html_url":"https://github.com/openai/codex/commit/846a16852f6bcd155d552236d4d893749c6130e6","comments_url":"https://api.github.com/repos/openai/codex/commits/846a16852f6bcd155d552236d4d893749c6130e6/comments","author":{"login":"olliem-oai","id":240798946,"node_id":"U_kgDODlpM4g","avatar_url":"https://avatars.githubusercontent.com/u/240798946?v=4","gravatar_id":"","url":"https://api.github.com/users/olliem-oai","html_url":"https://github.com/olliem-oai","followers_url":"https://api.github.com/users/olliem-oai/followers","following_url":"https://api.github.com/users/olliem-oai/following{/other_user}","gists_url":"https://api.github.com/users/olliem-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/olliem-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/olliem-oai/subscriptions","organizations_url":"https://api.github.com/users/olliem-oai/orgs","repos_url":"https://api.github.com/users/olliem-oai/repos","events_url":"https://api.github.com/users/olliem-oai/events{/privacy}","received_events_url":"https://api.github.com/users/olliem-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"726ec7ecbf2f74784bf88f8722d031b1565a0184","url":"https://api.github.com/repos/openai/codex/commits/726ec7ecbf2f74784bf88f8722d031b1565a0184","html_url":"https://github.com/openai/codex/commit/726ec7ecbf2f74784bf88f8722d031b1565a0184"}]},{"sha":"726ec7ecbf2f74784bf88f8722d031b1565a0184","node_id":"C_kwDOOYsS4doAKDcyNmVjN2VjYmYyZjc0Nzg0YmY4OGY4NzIyZDAzMWIxNTY1YTAxODQ","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-08-18T18:57:47Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T19:09:33Z"},"message":"Prevent ConPTY DLL loading from the current directory (#39262)\n\n## Why\n\nThe Windows PTY implementation probed `conpty.dll` by bare name. Windows could\nresolve that lookup to a DLL in the process current directory and load it when\ncreating a pseudoconsole.\n\n## What changed\n\nResolve the ConPTY entry points from `kernel32.dll` without probing\n`conpty.dll`.\n\n## Testing\n\nAdd a Windows regression test that places a compatible `conpty.dll` in the\ncurrent directory, creates a ConPTY, and verifies that the DLL was not loaded.\n\nGitOrigin-RevId: be78974362a99dce0c18186cf3e7bbd86a8de73c","tree":{"sha":"39eb5f3b8d5c286cd80783378d41d6a2a5272a58","url":"https://api.github.com/repos/openai/codex/git/trees/39eb5f3b8d5c286cd80783378d41d6a2a5272a58"},"url":"https://api.github.com/repos/openai/codex/git/commits/726ec7ecbf2f74784bf88f8722d031b1565a0184","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/726ec7ecbf2f74784bf88f8722d031b1565a0184","html_url":"https://github.com/openai/codex/commit/726ec7ecbf2f74784bf88f8722d031b1565a0184","comments_url":"https://api.github.com/repos/openai/codex/commits/726ec7ecbf2f74784bf88f8722d031b1565a0184/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"785ecd7452f87c7eb731fbb73892185cbdd9d5f9","url":"https://api.github.com/repos/openai/codex/commits/785ecd7452f87c7eb731fbb73892185cbdd9d5f9","html_url":"https://github.com/openai/codex/commit/785ecd7452f87c7eb731fbb73892185cbdd9d5f9"}]},{"sha":"785ecd7452f87c7eb731fbb73892185cbdd9d5f9","node_id":"C_kwDOOYsS4doAKDc4NWVjZDc0NTJmODdjN2ViNzMxZmJiNzM4OTIxODVjYmRkOWQ1Zjk","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-18T18:33:56Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T18:50:58Z"},"message":"Stop TUI chats on misalignment policy violations (#39261)\n\n## Why\n\nWhen the app server reports a misalignment policy violation, the TUI must stop the affected chat rather than allow more work to continue in it.\n\n## What changed\n\n- Finalize the active turn, clear queued and draft input, disable the composer, and reject further operations and interactive requests for the stopped chat.\n- Interrupt an active side conversation when its parent reports the violation, and prevent queued turns, forks, approvals, or goal resumption from restarting work.\n- Show a non-dismissible precaution view that directs users to start a new chat or resume another one, with agent command center navigation for remote sessions.\n\n## Testing\n\nAdded coverage for stopped-chat behavior, parent/side-thread handling, blocked goal resumption, navigation actions, and narrow and remote-session rendering.\n\nGitOrigin-RevId: 0268c46a19294a17765ea4099f389f15ffaaf030","tree":{"sha":"966ab7f6c6a553c7793a6c19017b65dbd36f045a","url":"https://api.github.com/repos/openai/codex/git/trees/966ab7f6c6a553c7793a6c19017b65dbd36f045a"},"url":"https://api.github.com/repos/openai/codex/git/commits/785ecd7452f87c7eb731fbb73892185cbdd9d5f9","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/785ecd7452f87c7eb731fbb73892185cbdd9d5f9","html_url":"https://github.com/openai/codex/commit/785ecd7452f87c7eb731fbb73892185cbdd9d5f9","comments_url":"https://api.github.com/repos/openai/codex/commits/785ecd7452f87c7eb731fbb73892185cbdd9d5f9/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"3006151ad413b165c799fa68d4d7ba8751542389","url":"https://api.github.com/repos/openai/codex/commits/3006151ad413b165c799fa68d4d7ba8751542389","html_url":"https://github.com/openai/codex/commit/3006151ad413b165c799fa68d4d7ba8751542389"}]},{"sha":"3006151ad413b165c799fa68d4d7ba8751542389","node_id":"C_kwDOOYsS4doAKDMwMDYxNTFhZDQxM2IxNjVjNzk5ZmE2OGQ0ZDdiYTg3NTE1NDIzODk","commit":{"author":{"name":"Tamir Duberstein","email":"tamird@openai.com","date":"2026-08-18T18:33:03Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T18:46:44Z"},"message":"Simplify unified exec output snapshots (#39259)\n\n## What changed\n\n- Return retained unified-exec output as one contiguous byte buffer.\n- Use the buffer directly for sandbox-denial checks, removing intermediate\n  chunk aggregation and an unnecessary owned string conversion.\n- Update the output-retention test to assert the flattened snapshot.\n\nGitOrigin-RevId: 84eacee0166b86d3cb2d6a37e96125977fad0267","tree":{"sha":"4e5bc00fad9add8e91af280e3ee6201edb4a918c","url":"https://api.github.com/repos/openai/codex/git/trees/4e5bc00fad9add8e91af280e3ee6201edb4a918c"},"url":"https://api.github.com/repos/openai/codex/git/commits/3006151ad413b165c799fa68d4d7ba8751542389","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/3006151ad413b165c799fa68d4d7ba8751542389","html_url":"https://github.com/openai/codex/commit/3006151ad413b165c799fa68d4d7ba8751542389","comments_url":"https://api.github.com/repos/openai/codex/commits/3006151ad413b165c799fa68d4d7ba8751542389/comments","author":{"login":"tamird","id":1535036,"node_id":"MDQ6VXNlcjE1MzUwMzY=","avatar_url":"https://avatars.githubusercontent.com/u/1535036?v=4","gravatar_id":"","url":"https://api.github.com/users/tamird","html_url":"https://github.com/tamird","followers_url":"https://api.github.com/users/tamird/followers","following_url":"https://api.github.com/users/tamird/following{/other_user}","gists_url":"https://api.github.com/users/tamird/gists{/gist_id}","starred_url":"https://api.github.com/users/tamird/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tamird/subscriptions","organizations_url":"https://api.github.com/users/tamird/orgs","repos_url":"https://api.github.com/users/tamird/repos","events_url":"https://api.github.com/users/tamird/events{/privacy}","received_events_url":"https://api.github.com/users/tamird/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"ecb8013dfa82120d11b02e3b68b7d3a3afd79d39","url":"https://api.github.com/repos/openai/codex/commits/ecb8013dfa82120d11b02e3b68b7d3a3afd79d39","html_url":"https://github.com/openai/codex/commit/ecb8013dfa82120d11b02e3b68b7d3a3afd79d39"}]},{"sha":"ecb8013dfa82120d11b02e3b68b7d3a3afd79d39","node_id":"C_kwDOOYsS4doAKGVjYjgwMTNkZmE4MjEyMGQxMWIwMmUzYjY4YjdkM2EzYWZkNzlkMzk","commit":{"author":{"name":"Peter Bakkum","email":"pbakkum@openai.com","date":"2026-08-18T18:28:59Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T18:41:40Z"},"message":"Reconnect WebRTC Realtime sideband transports (#39257)\n\n## What changed\n\n- Reconnect frameless bidirectional WebRTC sideband sockets after unexpected transport loss with capped exponential backoff.\n- Preserve pending text or handoff output and bounded transcript state across reconnects.\n- Treat `404 Not Found` and `410 Gone` handshake responses as terminal session completion, and preserve HTTP status information from failed WebSocket handshakes.\n- Bound Realtime delegation input and transcript fields while retaining the most relevant portion of each.\n\n## Testing\n\n- Add unit coverage for reconnect backoff, terminal status handling, transport error classification, transcript continuity and truncation, and pending outbound messages.\n- Add an end-to-end WebRTC conversation test covering an unclean disconnect, reconnect, transcript reconciliation, outbound progress during sustained inbound traffic, and terminal session completion.\n\nGitOrigin-RevId: 544fd7e542c3434d0bb42cfbcc7143604419a037","tree":{"sha":"e838c508b80b45805b491204df202b9483ad170f","url":"https://api.github.com/repos/openai/codex/git/trees/e838c508b80b45805b491204df202b9483ad170f"},"url":"https://api.github.com/repos/openai/codex/git/commits/ecb8013dfa82120d11b02e3b68b7d3a3afd79d39","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/ecb8013dfa82120d11b02e3b68b7d3a3afd79d39","html_url":"https://github.com/openai/codex/commit/ecb8013dfa82120d11b02e3b68b7d3a3afd79d39","comments_url":"https://api.github.com/repos/openai/codex/commits/ecb8013dfa82120d11b02e3b68b7d3a3afd79d39/comments","author":{"login":"bakks","id":1172710,"node_id":"MDQ6VXNlcjExNzI3MTA=","avatar_url":"https://avatars.githubusercontent.com/u/1172710?v=4","gravatar_id":"","url":"https://api.github.com/users/bakks","html_url":"https://github.com/bakks","followers_url":"https://api.github.com/users/bakks/followers","following_url":"https://api.github.com/users/bakks/following{/other_user}","gists_url":"https://api.github.com/users/bakks/gists{/gist_id}","starred_url":"https://api.github.com/users/bakks/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bakks/subscriptions","organizations_url":"https://api.github.com/users/bakks/orgs","repos_url":"https://api.github.com/users/bakks/repos","events_url":"https://api.github.com/users/bakks/events{/privacy}","received_events_url":"https://api.github.com/users/bakks/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fa9a05f2d25f95b39cf365e77cb10f87e8719185","url":"https://api.github.com/repos/openai/codex/commits/fa9a05f2d25f95b39cf365e77cb10f87e8719185","html_url":"https://github.com/openai/codex/commit/fa9a05f2d25f95b39cf365e77cb10f87e8719185"}]},{"sha":"fa9a05f2d25f95b39cf365e77cb10f87e8719185","node_id":"C_kwDOOYsS4doAKGZhOWEwNWYyZDI1Zjk1YjM5Y2YzNjVlNzdjYjEwZjg3ZTg3MTkxODU","commit":{"author":{"name":"Jeremy Rose","email":"172423086+nornagon-openai@users.noreply.github.com","date":"2026-08-18T18:25:23Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T18:38:12Z"},"message":"Deduplicate rollout moves when archiving threads (#39256)\n\n## Why\n\nSQLite metadata can identify a rollout through a non-canonical path. When that\npath resolves to a rollout already found on disk, archive and unarchive\noperations could schedule the same source file to be moved twice.\n\n## What changed\n\n- Deduplicate archive and unarchive moves by canonical source path.\n- Cover both operations with metadata-backed tests that use equivalent rollout\n  paths.\n\nGitOrigin-RevId: d190915264214413667fc2c83d360a7e8504d0aa","tree":{"sha":"a34aa0af29b1a48fcf8b9eb91a1e1fed263585d1","url":"https://api.github.com/repos/openai/codex/git/trees/a34aa0af29b1a48fcf8b9eb91a1e1fed263585d1"},"url":"https://api.github.com/repos/openai/codex/git/commits/fa9a05f2d25f95b39cf365e77cb10f87e8719185","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fa9a05f2d25f95b39cf365e77cb10f87e8719185","html_url":"https://github.com/openai/codex/commit/fa9a05f2d25f95b39cf365e77cb10f87e8719185","comments_url":"https://api.github.com/repos/openai/codex/commits/fa9a05f2d25f95b39cf365e77cb10f87e8719185/comments","author":{"login":"nornagon-openai","id":172423086,"node_id":"U_kgDOCkb3rg","avatar_url":"https://avatars.githubusercontent.com/u/172423086?v=4","gravatar_id":"","url":"https://api.github.com/users/nornagon-openai","html_url":"https://github.com/nornagon-openai","followers_url":"https://api.github.com/users/nornagon-openai/followers","following_url":"https://api.github.com/users/nornagon-openai/following{/other_user}","gists_url":"https://api.github.com/users/nornagon-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/nornagon-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nornagon-openai/subscriptions","organizations_url":"https://api.github.com/users/nornagon-openai/orgs","repos_url":"https://api.github.com/users/nornagon-openai/repos","events_url":"https://api.github.com/users/nornagon-openai/events{/privacy}","received_events_url":"https://api.github.com/users/nornagon-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"77e688960196dbc82bbeb00c844d2555a61925aa","url":"https://api.github.com/repos/openai/codex/commits/77e688960196dbc82bbeb00c844d2555a61925aa","html_url":"https://github.com/openai/codex/commit/77e688960196dbc82bbeb00c844d2555a61925aa"}]},{"sha":"77e688960196dbc82bbeb00c844d2555a61925aa","node_id":"C_kwDOOYsS4doAKDc3ZTY4ODk2MDE5NmRiYzgyYmJlYjAwYzg0NGQyNTU1YTYxOTI1YWE","commit":{"author":{"name":"pakrym-oai","email":"pakrym@openai.com","date":"2026-08-18T17:55:23Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T18:15:21Z"},"message":"Add exec-server forwarding mode (#39249)\n\n## What changed\n\n- Add `codex exec-server forward --connect ws://HOST:PORT` to register an\n  existing WebSocket exec-server as a remote environment.\n- Open a separate destination WebSocket for each authenticated Noise relay\n  stream and forward complete payloads unchanged in both directions.\n- Preserve large messages through WebSocket fragmentation and coordinate\n  disconnects, close acknowledgements, and pending output delivery.\n\n## Testing\n\n- Cover CLI validation, opaque payload forwarding, disconnect handling, and\n  destination close behavior.\n- Verify commands and large file transfers through the complete relay and\n  forwarding path.\n\nGitOrigin-RevId: 6e2dccff05b9e3571865611f4d432b0e2b4cdbac","tree":{"sha":"1526a7eadb8cea0c74ebda6b02d4f46e8b2c8277","url":"https://api.github.com/repos/openai/codex/git/trees/1526a7eadb8cea0c74ebda6b02d4f46e8b2c8277"},"url":"https://api.github.com/repos/openai/codex/git/commits/77e688960196dbc82bbeb00c844d2555a61925aa","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/77e688960196dbc82bbeb00c844d2555a61925aa","html_url":"https://github.com/openai/codex/commit/77e688960196dbc82bbeb00c844d2555a61925aa","comments_url":"https://api.github.com/repos/openai/codex/commits/77e688960196dbc82bbeb00c844d2555a61925aa/comments","author":{"login":"pakrym-oai","id":204937752,"node_id":"U_kgDODDcaGA","avatar_url":"https://avatars.githubusercontent.com/u/204937752?v=4","gravatar_id":"","url":"https://api.github.com/users/pakrym-oai","html_url":"https://github.com/pakrym-oai","followers_url":"https://api.github.com/users/pakrym-oai/followers","following_url":"https://api.github.com/users/pakrym-oai/following{/other_user}","gists_url":"https://api.github.com/users/pakrym-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/pakrym-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pakrym-oai/subscriptions","organizations_url":"https://api.github.com/users/pakrym-oai/orgs","repos_url":"https://api.github.com/users/pakrym-oai/repos","events_url":"https://api.github.com/users/pakrym-oai/events{/privacy}","received_events_url":"https://api.github.com/users/pakrym-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"8193c56a595f66eb0f77f18d7434765eb0179d20","url":"https://api.github.com/repos/openai/codex/commits/8193c56a595f66eb0f77f18d7434765eb0179d20","html_url":"https://github.com/openai/codex/commit/8193c56a595f66eb0f77f18d7434765eb0179d20"}]},{"sha":"8193c56a595f66eb0f77f18d7434765eb0179d20","node_id":"C_kwDOOYsS4doAKDgxOTNjNTZhNTk1ZjY2ZWIwZjc3ZjE4ZDc0MzQ3NjVlYjAxNzlkMjA","commit":{"author":{"name":"Dylan Hurd","email":"dylan.hurd@openai.com","date":"2026-08-18T17:55:05Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T18:08:17Z"},"message":"Give Guardian classifier connections distinct thread identities (#39246)\n\n## Why\n\nGuardian sampling uses a pool of WebSockets, while the bridge routes each\nconnection by thread ID. Each socket therefore needs its own identity instead\nof reusing the source thread ID across the pool.\n\n## What changed\n\n- Generate a classifier thread ID for every pooled connection and use it for\n  request, window, and subagent attribution.\n- Preserve the originating thread ID in turn metadata alongside the Guardian\n  classifier request kind.\n- Build request metadata after leasing a connection so retries use the identity\n  of the socket that carries the request.\n\n## Testing\n\n- Cover unique identities across pooled and replacement connections.\n- Verify classifier attribution metadata for extension requests and retries.\n\nGitOrigin-RevId: 1c36207125157ff05cab9487a2fa37bf85e5fdd8","tree":{"sha":"c5bb4f86284ec723c87515cac40e0c16fabaf8ea","url":"https://api.github.com/repos/openai/codex/git/trees/c5bb4f86284ec723c87515cac40e0c16fabaf8ea"},"url":"https://api.github.com/repos/openai/codex/git/commits/8193c56a595f66eb0f77f18d7434765eb0179d20","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/8193c56a595f66eb0f77f18d7434765eb0179d20","html_url":"https://github.com/openai/codex/commit/8193c56a595f66eb0f77f18d7434765eb0179d20","comments_url":"https://api.github.com/repos/openai/codex/commits/8193c56a595f66eb0f77f18d7434765eb0179d20/comments","author":{"login":"dylan-hurd-oai","id":220976066,"node_id":"U_kgDODSvTwg","avatar_url":"https://avatars.githubusercontent.com/u/220976066?v=4","gravatar_id":"","url":"https://api.github.com/users/dylan-hurd-oai","html_url":"https://github.com/dylan-hurd-oai","followers_url":"https://api.github.com/users/dylan-hurd-oai/followers","following_url":"https://api.github.com/users/dylan-hurd-oai/following{/other_user}","gists_url":"https://api.github.com/users/dylan-hurd-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/dylan-hurd-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dylan-hurd-oai/subscriptions","organizations_url":"https://api.github.com/users/dylan-hurd-oai/orgs","repos_url":"https://api.github.com/users/dylan-hurd-oai/repos","events_url":"https://api.github.com/users/dylan-hurd-oai/events{/privacy}","received_events_url":"https://api.github.com/users/dylan-hurd-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a1dc95d5afcbd3ccdebb611864ce94fa3d3e8e3d","url":"https://api.github.com/repos/openai/codex/commits/a1dc95d5afcbd3ccdebb611864ce94fa3d3e8e3d","html_url":"https://github.com/openai/codex/commit/a1dc95d5afcbd3ccdebb611864ce94fa3d3e8e3d"}]},{"sha":"a1dc95d5afcbd3ccdebb611864ce94fa3d3e8e3d","node_id":"C_kwDOOYsS4doAKGExZGM5NWQ1YWZjYmQzY2NkZWJiNjExODY0Y2U5NGZhM2QzZThlM2Q","commit":{"author":{"name":"victor-openai","email":"victor@openai.com","date":"2026-08-18T17:46:43Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T18:01:39Z"},"message":"Scope MCP resource reads by connector (#39244)\n\n## What changed\n\n- Add an optional `connectorId` to `mcpServer/resource/read`.\n- Forward the selected connector through `x-codex-turn-metadata` for threaded and threadless resource reads, restricting hosted app resources to that connector.\n- Update the generated protocol schemas and app-server documentation.\n\nGitOrigin-RevId: 5cc94d703abbbb6086665910c1c9ed5dc7075210","tree":{"sha":"0ff4954197089d1b713ec02893f231a27008bf62","url":"https://api.github.com/repos/openai/codex/git/trees/0ff4954197089d1b713ec02893f231a27008bf62"},"url":"https://api.github.com/repos/openai/codex/git/commits/a1dc95d5afcbd3ccdebb611864ce94fa3d3e8e3d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a1dc95d5afcbd3ccdebb611864ce94fa3d3e8e3d","html_url":"https://github.com/openai/codex/commit/a1dc95d5afcbd3ccdebb611864ce94fa3d3e8e3d","comments_url":"https://api.github.com/repos/openai/codex/commits/a1dc95d5afcbd3ccdebb611864ce94fa3d3e8e3d/comments","author":{"login":"victor-openai","id":204937719,"node_id":"U_kgDODDcZ9w","avatar_url":"https://avatars.githubusercontent.com/u/204937719?v=4","gravatar_id":"","url":"https://api.github.com/users/victor-openai","html_url":"https://github.com/victor-openai","followers_url":"https://api.github.com/users/victor-openai/followers","following_url":"https://api.github.com/users/victor-openai/following{/other_user}","gists_url":"https://api.github.com/users/victor-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/victor-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/victor-openai/subscriptions","organizations_url":"https://api.github.com/users/victor-openai/orgs","repos_url":"https://api.github.com/users/victor-openai/repos","events_url":"https://api.github.com/users/victor-openai/events{/privacy}","received_events_url":"https://api.github.com/users/victor-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"19d185fec8e1216ddd7b5522b331d69a6ecf3b1c","url":"https://api.github.com/repos/openai/codex/commits/19d185fec8e1216ddd7b5522b331d69a6ecf3b1c","html_url":"https://github.com/openai/codex/commit/19d185fec8e1216ddd7b5522b331d69a6ecf3b1c"}]},{"sha":"19d185fec8e1216ddd7b5522b331d69a6ecf3b1c","node_id":"C_kwDOOYsS4doAKDE5ZDE4NWZlYzhlMTIxNmRkZDdiNTUyMmIzMzFkNjlhNmVjZjNiMWM","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-18T17:41:30Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T17:53:36Z"},"message":"Add safe permission profile intersection (#39242)\n\n## What changed\n\n- Add `intersect_effective_permission_profiles` to derive the permissions shared by an authority profile and a requested profile.\n- Preserve the more restrictive filesystem access, read denials, protected metadata paths, temporary-directory access, and network policy.\n- Canonicalize concrete paths so symlinks cannot expand authority, and fail closed for policy shapes that cannot be intersected safely.\n\n## Testing\n\nAdd coverage for workspace intersections, nested carveouts, deny patterns, unsupported policies, temporary-directory restrictions, symlink escapes, and macOS path aliases.\n\nGitOrigin-RevId: a35bdc47e41afad13630f92c032514b300c14a0d","tree":{"sha":"4921aadbe74264241165a5d689fd614d1658b3bb","url":"https://api.github.com/repos/openai/codex/git/trees/4921aadbe74264241165a5d689fd614d1658b3bb"},"url":"https://api.github.com/repos/openai/codex/git/commits/19d185fec8e1216ddd7b5522b331d69a6ecf3b1c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/19d185fec8e1216ddd7b5522b331d69a6ecf3b1c","html_url":"https://github.com/openai/codex/commit/19d185fec8e1216ddd7b5522b331d69a6ecf3b1c","comments_url":"https://api.github.com/repos/openai/codex/commits/19d185fec8e1216ddd7b5522b331d69a6ecf3b1c/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"e683c3118b25bc2fce65e9cbccded7a8343307f1","url":"https://api.github.com/repos/openai/codex/commits/e683c3118b25bc2fce65e9cbccded7a8343307f1","html_url":"https://github.com/openai/codex/commit/e683c3118b25bc2fce65e9cbccded7a8343307f1"}]},{"sha":"e683c3118b25bc2fce65e9cbccded7a8343307f1","node_id":"C_kwDOOYsS4doAKGU2ODNjMzExOGIyNWJjMmZjZTY1ZTljYmNjZGVkN2E4MzQzMzA3ZjE","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-18T17:39:08Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T17:48:35Z"},"message":"Record Guardian v2 classification metrics (#39241)\n\n## What changed\n\n- Emit a `codex.guardian_v2.classification` counter for each classification.\n- Record classification latency in `codex.guardian_v2.classification.duration_ms`.\n- Tag both metrics with `success`, `failure`, or `superseded` outcomes.\n\n## Testing\n\n- Verify metrics for successful classification and fail-closed handling.\n\nGitOrigin-RevId: 021702f3b26565d6da5708d2b8f1f8881942a441","tree":{"sha":"1d9ec72248f6e49e8e984887509202b6b44e410f","url":"https://api.github.com/repos/openai/codex/git/trees/1d9ec72248f6e49e8e984887509202b6b44e410f"},"url":"https://api.github.com/repos/openai/codex/git/commits/e683c3118b25bc2fce65e9cbccded7a8343307f1","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/e683c3118b25bc2fce65e9cbccded7a8343307f1","html_url":"https://github.com/openai/codex/commit/e683c3118b25bc2fce65e9cbccded7a8343307f1","comments_url":"https://api.github.com/repos/openai/codex/commits/e683c3118b25bc2fce65e9cbccded7a8343307f1/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a998c7a1ce88a521d319a4f336e0a4bf36095637","url":"https://api.github.com/repos/openai/codex/commits/a998c7a1ce88a521d319a4f336e0a4bf36095637","html_url":"https://github.com/openai/codex/commit/a998c7a1ce88a521d319a4f336e0a4bf36095637"}]},{"sha":"a998c7a1ce88a521d319a4f336e0a4bf36095637","node_id":"C_kwDOOYsS4doAKGE5OThjN2ExY2U4OGE1MjFkMzE5YTRmMzM2ZTBhNGJmMzYwOTU2Mzc","commit":{"author":{"name":"Matthew Zeng","email":"mzeng@openai.com","date":"2026-08-18T17:33:32Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T17:42:48Z"},"message":"Deduplicate remote plugin bundle syncs with shared semaphores (#39240)\n\n## What changed\n\n- Give plugin managers for the same cache root a shared semaphore that permits\n  only one background installed-plugin bundle sync at a time.\n- Hold the permit for the lifetime of the spawned sync task and refresh the\n  installed-plugin cache after a successful local cache change.\n\n## Testing\n\n- Add a test that starts bundle syncs from two plugin managers sharing a Codex\n  home and verifies that only one request is made.\n\nGitOrigin-RevId: 86c39476c3a9015b9862ab75e8f11f110b0284fc","tree":{"sha":"c1c4d8c70a4f286e9975f6dc987ecdfb88520df1","url":"https://api.github.com/repos/openai/codex/git/trees/c1c4d8c70a4f286e9975f6dc987ecdfb88520df1"},"url":"https://api.github.com/repos/openai/codex/git/commits/a998c7a1ce88a521d319a4f336e0a4bf36095637","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a998c7a1ce88a521d319a4f336e0a4bf36095637","html_url":"https://github.com/openai/codex/commit/a998c7a1ce88a521d319a4f336e0a4bf36095637","comments_url":"https://api.github.com/repos/openai/codex/commits/a998c7a1ce88a521d319a4f336e0a4bf36095637/comments","author":{"login":"mzeng-openai","id":175741029,"node_id":"U_kgDOCnmYZQ","avatar_url":"https://avatars.githubusercontent.com/u/175741029?v=4","gravatar_id":"","url":"https://api.github.com/users/mzeng-openai","html_url":"https://github.com/mzeng-openai","followers_url":"https://api.github.com/users/mzeng-openai/followers","following_url":"https://api.github.com/users/mzeng-openai/following{/other_user}","gists_url":"https://api.github.com/users/mzeng-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/mzeng-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mzeng-openai/subscriptions","organizations_url":"https://api.github.com/users/mzeng-openai/orgs","repos_url":"https://api.github.com/users/mzeng-openai/repos","events_url":"https://api.github.com/users/mzeng-openai/events{/privacy}","received_events_url":"https://api.github.com/users/mzeng-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"3df5087f754af3794f4b414c78921b5f07af1ace","url":"https://api.github.com/repos/openai/codex/commits/3df5087f754af3794f4b414c78921b5f07af1ace","html_url":"https://github.com/openai/codex/commit/3df5087f754af3794f4b414c78921b5f07af1ace"}]},{"sha":"3df5087f754af3794f4b414c78921b5f07af1ace","node_id":"C_kwDOOYsS4doAKDNkZjUwODdmNzU0YWYzNzk0ZjRiNDE0Yzc4OTIxYjVmMDdhZjFhY2U","commit":{"author":{"name":"pakrym-oai","email":"pakrym@openai.com","date":"2026-08-18T17:10:06Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T17:18:50Z"},"message":"Decouple Noise relay streams from JSON-RPC processing (#39235)\n\n## What changed\n\n- Add a `NoiseStreamHandler` abstraction that owns payload encoding, decoding,\n  and connection processing while the virtual stream handles framing,\n  encryption, and multiplexing.\n- Reassemble authenticated payloads as opaque bytes, with the existing\n  JSON-RPC processor supplied as a handler implementation.\n- Have the physical relay send a reset after the current stream instance\n  closes, including when its processor exits before the writer task.\n\n## Testing\n\n- Verify local JSON-RPC decoding creates the queued request span before queue\n  admission.\n- Verify a processor exit resets the corresponding Noise harness stream.\n\nGitOrigin-RevId: 270befcc8bfbf27e46c84d6a2c6e349cb98ea3f8","tree":{"sha":"1c8ddc536276a17ae415742842a66e25fac462f8","url":"https://api.github.com/repos/openai/codex/git/trees/1c8ddc536276a17ae415742842a66e25fac462f8"},"url":"https://api.github.com/repos/openai/codex/git/commits/3df5087f754af3794f4b414c78921b5f07af1ace","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/3df5087f754af3794f4b414c78921b5f07af1ace","html_url":"https://github.com/openai/codex/commit/3df5087f754af3794f4b414c78921b5f07af1ace","comments_url":"https://api.github.com/repos/openai/codex/commits/3df5087f754af3794f4b414c78921b5f07af1ace/comments","author":{"login":"pakrym-oai","id":204937752,"node_id":"U_kgDODDcaGA","avatar_url":"https://avatars.githubusercontent.com/u/204937752?v=4","gravatar_id":"","url":"https://api.github.com/users/pakrym-oai","html_url":"https://github.com/pakrym-oai","followers_url":"https://api.github.com/users/pakrym-oai/followers","following_url":"https://api.github.com/users/pakrym-oai/following{/other_user}","gists_url":"https://api.github.com/users/pakrym-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/pakrym-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pakrym-oai/subscriptions","organizations_url":"https://api.github.com/users/pakrym-oai/orgs","repos_url":"https://api.github.com/users/pakrym-oai/repos","events_url":"https://api.github.com/users/pakrym-oai/events{/privacy}","received_events_url":"https://api.github.com/users/pakrym-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"9b9b614b02ba04df55479284749c5cbbed695c24","url":"https://api.github.com/repos/openai/codex/commits/9b9b614b02ba04df55479284749c5cbbed695c24","html_url":"https://github.com/openai/codex/commit/9b9b614b02ba04df55479284749c5cbbed695c24"}]},{"sha":"9b9b614b02ba04df55479284749c5cbbed695c24","node_id":"C_kwDOOYsS4doAKDliOWI2MTRiMDJiYTA0ZGY1NTQ3OTI4NDc0OWM1Y2JiZWQ2OTVjMjQ","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-18T16:27:28Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T16:38:52Z"},"message":"Include node_repl screenshots in Guardian v2 reviews (#39227)\n\n## Why\n\n`node_repl` screenshots are nested tool results and do not appear in the parent\nconversation history, so Guardian v2 transcript image collection could miss\nthem.\n\n## What changed\n\n- Allow Guardian v2 to enable bounded, thread-scoped `node_repl` image capture\n  when transcript images are configured.\n- Add retained `node_repl` screenshots to review requests when transcript\n  sources include tool outputs, while deduplicating images and keeping them out\n  of the parent turn input.\n\n## Testing\n\n- Add an integration test covering screenshot capture without the synchronous\n  Guardian transcript feature flags and verifying that screenshots stay out of\n  the parent request.\n\nGitOrigin-RevId: 5f70c5f2e80389aa8b2a286c3b7f9b1104865486","tree":{"sha":"2ddb4f7819e4b078a17a4e7d4d5bbd55318fd985","url":"https://api.github.com/repos/openai/codex/git/trees/2ddb4f7819e4b078a17a4e7d4d5bbd55318fd985"},"url":"https://api.github.com/repos/openai/codex/git/commits/9b9b614b02ba04df55479284749c5cbbed695c24","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/9b9b614b02ba04df55479284749c5cbbed695c24","html_url":"https://github.com/openai/codex/commit/9b9b614b02ba04df55479284749c5cbbed695c24","comments_url":"https://api.github.com/repos/openai/codex/commits/9b9b614b02ba04df55479284749c5cbbed695c24/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"e7e13c68e224da4dde35fc685ea2a2ab1a62dc9d","url":"https://api.github.com/repos/openai/codex/commits/e7e13c68e224da4dde35fc685ea2a2ab1a62dc9d","html_url":"https://github.com/openai/codex/commit/e7e13c68e224da4dde35fc685ea2a2ab1a62dc9d"}]},{"sha":"e7e13c68e224da4dde35fc685ea2a2ab1a62dc9d","node_id":"C_kwDOOYsS4doAKGU3ZTEzYzY4ZTIyNGRhNGRkZTM1ZmM2ODVlYTJhMmFiMWE2MmRjOWQ","commit":{"author":{"name":"Dylan Hurd","email":"dylan.hurd@openai.com","date":"2026-08-18T16:18:21Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T16:27:54Z"},"message":"Add Guardian v2 approval review metrics (#39224)\n\n## What changed\n\n- Pass metrics bound to the active turn's model to approval-review contributors.\n- Add counter support to `ExtensionMetrics` while preserving host session attribution.\n- Record Guardian v2 tool-call score lag and count stale-score fallbacks with the `score_lag` reason.\n\n## Testing\n\n- Cover counter forwarding and session metadata tags.\n- Verify Guardian v2 metric samples for current and stale scores.\n\nGitOrigin-RevId: 0ec34736d29d2e37ed217a27e773b4f6230ae38a","tree":{"sha":"ce2845c5a766496dc9dad461c993e7c075770467","url":"https://api.github.com/repos/openai/codex/git/trees/ce2845c5a766496dc9dad461c993e7c075770467"},"url":"https://api.github.com/repos/openai/codex/git/commits/e7e13c68e224da4dde35fc685ea2a2ab1a62dc9d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/e7e13c68e224da4dde35fc685ea2a2ab1a62dc9d","html_url":"https://github.com/openai/codex/commit/e7e13c68e224da4dde35fc685ea2a2ab1a62dc9d","comments_url":"https://api.github.com/repos/openai/codex/commits/e7e13c68e224da4dde35fc685ea2a2ab1a62dc9d/comments","author":{"login":"dylan-hurd-oai","id":220976066,"node_id":"U_kgDODSvTwg","avatar_url":"https://avatars.githubusercontent.com/u/220976066?v=4","gravatar_id":"","url":"https://api.github.com/users/dylan-hurd-oai","html_url":"https://github.com/dylan-hurd-oai","followers_url":"https://api.github.com/users/dylan-hurd-oai/followers","following_url":"https://api.github.com/users/dylan-hurd-oai/following{/other_user}","gists_url":"https://api.github.com/users/dylan-hurd-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/dylan-hurd-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dylan-hurd-oai/subscriptions","organizations_url":"https://api.github.com/users/dylan-hurd-oai/orgs","repos_url":"https://api.github.com/users/dylan-hurd-oai/repos","events_url":"https://api.github.com/users/dylan-hurd-oai/events{/privacy}","received_events_url":"https://api.github.com/users/dylan-hurd-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"2a30972fcb646f9d6bfed6de6606aa3f0f8c3dd2","url":"https://api.github.com/repos/openai/codex/commits/2a30972fcb646f9d6bfed6de6606aa3f0f8c3dd2","html_url":"https://github.com/openai/codex/commit/2a30972fcb646f9d6bfed6de6606aa3f0f8c3dd2"}]},{"sha":"2a30972fcb646f9d6bfed6de6606aa3f0f8c3dd2","node_id":"C_kwDOOYsS4doAKDJhMzA5NzJmY2I2NDZmOWQ2YmZlZDZkZTY2MDZhYTNmMGY4YzNkZDI","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-18T15:58:59Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T16:05:51Z"},"message":"Skip redirected external-agent migration destinations (#39221)\n\n## Why\n\nRepository-scoped imports must not follow redirected Codex paths and write\ngenerated configuration outside the repository.\n\n## What changed\n\n- Reject repository migration scopes when generated configuration paths are\n  symlinks or, on Windows, reparse points.\n- Recheck hook and subagent destinations during import, skipping redirected\n  directories, files, and dangling links without reporting them as imported.\n\n## Testing\n\nAdd service and app-server coverage for redirected generated destinations,\nincluding a repository path replaced with a symlink after detection.\n\nGitOrigin-RevId: 3afb521ead9d76250f0e967eccfdd1dc194f027a","tree":{"sha":"04db22bc4804e2207e65072586e3cc79665a3fc2","url":"https://api.github.com/repos/openai/codex/git/trees/04db22bc4804e2207e65072586e3cc79665a3fc2"},"url":"https://api.github.com/repos/openai/codex/git/commits/2a30972fcb646f9d6bfed6de6606aa3f0f8c3dd2","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/2a30972fcb646f9d6bfed6de6606aa3f0f8c3dd2","html_url":"https://github.com/openai/codex/commit/2a30972fcb646f9d6bfed6de6606aa3f0f8c3dd2","comments_url":"https://api.github.com/repos/openai/codex/commits/2a30972fcb646f9d6bfed6de6606aa3f0f8c3dd2/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"76ceaddb29444388fbbbae07c46f7e8849f9658b","url":"https://api.github.com/repos/openai/codex/commits/76ceaddb29444388fbbbae07c46f7e8849f9658b","html_url":"https://github.com/openai/codex/commit/76ceaddb29444388fbbbae07c46f7e8849f9658b"}]},{"sha":"76ceaddb29444388fbbbae07c46f7e8849f9658b","node_id":"C_kwDOOYsS4doAKDc2Y2VhZGRiMjk0NDQzODhmYmJiYWUwN2M0NmY3ZTg4NDlmOTY1OGI","commit":{"author":{"name":"Dylan Hurd","email":"dylan.hurd@openai.com","date":"2026-08-18T15:54:38Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T16:00:39Z"},"message":"Reconnect Guardian sampling WebSockets after auth changes (#39220)\n\n## Why\n\nGuardian sampling WebSockets authenticate when the connection is opened. Reusing\na pooled connection after credentials change can therefore keep using the old\nauthorization.\n\n## What changed\n\n- Track authentication changes on each pooled sampling connection.\n- Discard stale connections after an auth change and reject connections whose\n  authentication changes while the handshake is in progress.\n\n## Testing\n\n- Verify the sampler reconnects with the refreshed bearer token instead of\n  reusing its existing connection.\n- Verify the installed Guardian extension reconnects after an external auth\n  refresh.\n\nGitOrigin-RevId: 6d2e7df776fd21c78be0928f71162f5419a8b8f0","tree":{"sha":"21b98e5d40f13bf4bd25a717ece589eee863d8c8","url":"https://api.github.com/repos/openai/codex/git/trees/21b98e5d40f13bf4bd25a717ece589eee863d8c8"},"url":"https://api.github.com/repos/openai/codex/git/commits/76ceaddb29444388fbbbae07c46f7e8849f9658b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/76ceaddb29444388fbbbae07c46f7e8849f9658b","html_url":"https://github.com/openai/codex/commit/76ceaddb29444388fbbbae07c46f7e8849f9658b","comments_url":"https://api.github.com/repos/openai/codex/commits/76ceaddb29444388fbbbae07c46f7e8849f9658b/comments","author":{"login":"dylan-hurd-oai","id":220976066,"node_id":"U_kgDODSvTwg","avatar_url":"https://avatars.githubusercontent.com/u/220976066?v=4","gravatar_id":"","url":"https://api.github.com/users/dylan-hurd-oai","html_url":"https://github.com/dylan-hurd-oai","followers_url":"https://api.github.com/users/dylan-hurd-oai/followers","following_url":"https://api.github.com/users/dylan-hurd-oai/following{/other_user}","gists_url":"https://api.github.com/users/dylan-hurd-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/dylan-hurd-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dylan-hurd-oai/subscriptions","organizations_url":"https://api.github.com/users/dylan-hurd-oai/orgs","repos_url":"https://api.github.com/users/dylan-hurd-oai/repos","events_url":"https://api.github.com/users/dylan-hurd-oai/events{/privacy}","received_events_url":"https://api.github.com/users/dylan-hurd-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"e13c1d569d953ecac06a09cf5663fb3cd405636d","url":"https://api.github.com/repos/openai/codex/commits/e13c1d569d953ecac06a09cf5663fb3cd405636d","html_url":"https://github.com/openai/codex/commit/e13c1d569d953ecac06a09cf5663fb3cd405636d"}]},{"sha":"e13c1d569d953ecac06a09cf5663fb3cd405636d","node_id":"C_kwDOOYsS4doAKGUxM2MxZDU2OWQ5NTNlY2FjMDZhMDljZjU2NjNmYjNjZDQwNTYzNmQ","commit":{"author":{"name":"viyatb-oai","email":"viyatb@openai.com","date":"2026-08-18T14:58:53Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T15:06:09Z"},"message":"Prevent custom providers from inheriting ambient auth (#39214)\n\n## Why\n\nCustom model providers that do not require OpenAI authentication could inherit\nambient authentication headers, including the bearer token and\n`ChatGPT-Account-ID`, and send them to the custom provider endpoint.\n\n## What changed\n\n- Resolve providers without `requires_openai_auth` or configured `auth` as\n  unauthenticated.\n- Continue to honor an explicit `experimental_bearer_token` or command-resolved\n  provider authentication.\n- Preserve ambient authentication for OpenAI providers.\n\n## Testing\n\nAdded unit and request-level coverage for custom, explicitly authenticated, and\nOpenAI provider authentication behavior.\n\nGitOrigin-RevId: d89a79604338bc660a3edb2af0068cfa9b694fa2","tree":{"sha":"90a6319993e4bd7d4acf6b3a260732de0f848102","url":"https://api.github.com/repos/openai/codex/git/trees/90a6319993e4bd7d4acf6b3a260732de0f848102"},"url":"https://api.github.com/repos/openai/codex/git/commits/e13c1d569d953ecac06a09cf5663fb3cd405636d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/e13c1d569d953ecac06a09cf5663fb3cd405636d","html_url":"https://github.com/openai/codex/commit/e13c1d569d953ecac06a09cf5663fb3cd405636d","comments_url":"https://api.github.com/repos/openai/codex/commits/e13c1d569d953ecac06a09cf5663fb3cd405636d/comments","author":{"login":"viyatb-oai","id":234056686,"node_id":"U_kgDODfNr7g","avatar_url":"https://avatars.githubusercontent.com/u/234056686?v=4","gravatar_id":"","url":"https://api.github.com/users/viyatb-oai","html_url":"https://github.com/viyatb-oai","followers_url":"https://api.github.com/users/viyatb-oai/followers","following_url":"https://api.github.com/users/viyatb-oai/following{/other_user}","gists_url":"https://api.github.com/users/viyatb-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/viyatb-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/viyatb-oai/subscriptions","organizations_url":"https://api.github.com/users/viyatb-oai/orgs","repos_url":"https://api.github.com/users/viyatb-oai/repos","events_url":"https://api.github.com/users/viyatb-oai/events{/privacy}","received_events_url":"https://api.github.com/users/viyatb-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"bb701f1e8c8db884fa0cdafff4b8dcb1604f2fdd","url":"https://api.github.com/repos/openai/codex/commits/bb701f1e8c8db884fa0cdafff4b8dcb1604f2fdd","html_url":"https://github.com/openai/codex/commit/bb701f1e8c8db884fa0cdafff4b8dcb1604f2fdd"}]},{"sha":"bb701f1e8c8db884fa0cdafff4b8dcb1604f2fdd","node_id":"C_kwDOOYsS4doAKGJiNzAxZjFlOGM4ZGI4ODRmYTBjZGFmZmY0YjhkY2IxNjA0ZjJmZGQ","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-08-18T14:49:38Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T14:59:43Z"},"message":"Add a fail-closed Tree-sitter PowerShell lowerer (#39213)\n\n## What changed\n\n- Add a Tree-sitter-based lowerer that converts a conservative subset of literal PowerShell commands into argument vectors.\n- Reject dynamic expressions, parse recovery, unsupported value conversions, directives, and source outside recognized command nodes instead of guessing their meaning.\n- Keep the lowerer alongside the existing production parser for later adoption.\n\n## Testing\n\n- Add fixture-driven coverage for supported literal commands and unsupported or ambiguous syntax, including a dedicated `#requires` rejection test.\n\nGitOrigin-RevId: a6e7acc264ca40df264db4b271e38ae7d89e1ec4","tree":{"sha":"a23416ba4da5aa6f244fecde43154a7fb31802c5","url":"https://api.github.com/repos/openai/codex/git/trees/a23416ba4da5aa6f244fecde43154a7fb31802c5"},"url":"https://api.github.com/repos/openai/codex/git/commits/bb701f1e8c8db884fa0cdafff4b8dcb1604f2fdd","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/bb701f1e8c8db884fa0cdafff4b8dcb1604f2fdd","html_url":"https://github.com/openai/codex/commit/bb701f1e8c8db884fa0cdafff4b8dcb1604f2fdd","comments_url":"https://api.github.com/repos/openai/codex/commits/bb701f1e8c8db884fa0cdafff4b8dcb1604f2fdd/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a04940cb12cca43510aaf8d601ce42352f0902cb","url":"https://api.github.com/repos/openai/codex/commits/a04940cb12cca43510aaf8d601ce42352f0902cb","html_url":"https://github.com/openai/codex/commit/a04940cb12cca43510aaf8d601ce42352f0902cb"}]},{"sha":"a04940cb12cca43510aaf8d601ce42352f0902cb","node_id":"C_kwDOOYsS4doAKGEwNDk0MGNiMTJjY2E0MzUxMGFhZjhkNjAxY2U0MjM1MmYwOTAyY2I","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-18T14:09:11Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T14:14:57Z"},"message":"Reject symbolic links in memory workspaces (#39205)\n\n## What changed\n\n- Reject a symbolic link used as the memory root.\n- Recursively remove symbolic links before preparing or seeding the memory workspace.\n- Remove and reject symbolic links created during consolidation, including when the worker fails, so they cannot affect files outside the workspace.\n\n## Testing\n\nAdd Unix startup tests covering pre-existing extension links and links created by both successful and failed consolidation workers.\n\nGitOrigin-RevId: f96e03812773f7beaa16455dd77370ee47d8a71f","tree":{"sha":"f02bc5381348e6f7039fc6f528ecc66486133e21","url":"https://api.github.com/repos/openai/codex/git/trees/f02bc5381348e6f7039fc6f528ecc66486133e21"},"url":"https://api.github.com/repos/openai/codex/git/commits/a04940cb12cca43510aaf8d601ce42352f0902cb","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a04940cb12cca43510aaf8d601ce42352f0902cb","html_url":"https://github.com/openai/codex/commit/a04940cb12cca43510aaf8d601ce42352f0902cb","comments_url":"https://api.github.com/repos/openai/codex/commits/a04940cb12cca43510aaf8d601ce42352f0902cb/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"b5ea64a203ce1b04629010d3ef0a0d18c3c870a9","url":"https://api.github.com/repos/openai/codex/commits/b5ea64a203ce1b04629010d3ef0a0d18c3c870a9","html_url":"https://github.com/openai/codex/commit/b5ea64a203ce1b04629010d3ef0a0d18c3c870a9"}]},{"sha":"b5ea64a203ce1b04629010d3ef0a0d18c3c870a9","node_id":"C_kwDOOYsS4doAKGI1ZWE2NGEyMDNjZTFiMDQ2MjkwMTBkM2VmMGEwZDE4YzNjODcwYTk","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-18T13:30:20Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T13:36:16Z"},"message":"Add a symlink-safe reader for sensitive files (#39200)\n\n## What changed\n\n- Export `read_sensitive_file_to_string` from `codex-exec-server`.\n- Require the opened path to be a regular disk file and avoid following its\n  final symlink component on Unix or reparse point on Windows.\n- Read valid UTF-8 file contents asynchronously and return I/O errors for\n  unsupported inputs.\n\n## Testing\n\nAdd tests covering regular files, directories, and symlinks.\n\nGitOrigin-RevId: 68809e94c0d3719e5685c064f9610a0455ffd8d7","tree":{"sha":"70a6af7c0b40964b47a2c9ead86d628ac1b4a270","url":"https://api.github.com/repos/openai/codex/git/trees/70a6af7c0b40964b47a2c9ead86d628ac1b4a270"},"url":"https://api.github.com/repos/openai/codex/git/commits/b5ea64a203ce1b04629010d3ef0a0d18c3c870a9","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/b5ea64a203ce1b04629010d3ef0a0d18c3c870a9","html_url":"https://github.com/openai/codex/commit/b5ea64a203ce1b04629010d3ef0a0d18c3c870a9","comments_url":"https://api.github.com/repos/openai/codex/commits/b5ea64a203ce1b04629010d3ef0a0d18c3c870a9/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a397079287e6638b39dda329835350d93222681f","url":"https://api.github.com/repos/openai/codex/commits/a397079287e6638b39dda329835350d93222681f","html_url":"https://github.com/openai/codex/commit/a397079287e6638b39dda329835350d93222681f"}]},{"sha":"a397079287e6638b39dda329835350d93222681f","node_id":"C_kwDOOYsS4doAKGEzOTcwNzkyODdlNjYzOGIzOWRkYTMyOTgzNTM1MGQ5MzIyMjY4MWY","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-18T12:32:01Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T12:37:41Z"},"message":"Preserve MCP resource origins across compaction (#39192)\n\n## Why\n\nCompaction can remove the tool-call events that associate an MCP app widget with\nthe tool, account, and URI needed to authorize later resource reads.\n\n## What changed\n\n- Store a bounded MCP resource-origin checkpoint with each compacted rollout.\n- Restore the checkpoint when resuming a session so existing widgets remain\n  readable after compaction and restart.\n- Discard saved origins when rollback rewrites history across the compaction\n  boundary, and reject oversized or invalid checkpoints during restoration.\n\n## Testing\n\n- Extend the app-server MCP resource-origin test to compact a paginated thread,\n  continue the conversation, and read the original widgets before and after a\n  restart.\n- Verify rollback clears provenance that no longer matches retained history.\n\nGitOrigin-RevId: 7f91c6202fe8d9be21c78dda42fa205937c44263","tree":{"sha":"3330d5856bf228754ab8d047b25e09b970707bd7","url":"https://api.github.com/repos/openai/codex/git/trees/3330d5856bf228754ab8d047b25e09b970707bd7"},"url":"https://api.github.com/repos/openai/codex/git/commits/a397079287e6638b39dda329835350d93222681f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a397079287e6638b39dda329835350d93222681f","html_url":"https://github.com/openai/codex/commit/a397079287e6638b39dda329835350d93222681f","comments_url":"https://api.github.com/repos/openai/codex/commits/a397079287e6638b39dda329835350d93222681f/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"880f1135ea5902f85d7c13d60ee01d61334b6ad9","url":"https://api.github.com/repos/openai/codex/commits/880f1135ea5902f85d7c13d60ee01d61334b6ad9","html_url":"https://github.com/openai/codex/commit/880f1135ea5902f85d7c13d60ee01d61334b6ad9"}]},{"sha":"880f1135ea5902f85d7c13d60ee01d61334b6ad9","node_id":"C_kwDOOYsS4doAKDg4MGYxMTM1ZWE1OTAyZjg1ZDdjMTNkNjBlZTAxZDYxMzM0YjZhZDk","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-18T11:45:58Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T11:51:21Z"},"message":"Scope MCP app resource reads to their originating call (#39187)\n\n## Why\n\nApp widgets need to read resources using the app and account context of the\ntool call that produced them, including after a thread is restored.\n\n## What changed\n\n- Add an optional `originCallId` to `mcpServer/resource/read` requests and\n  return it on successful scoped reads.\n- Track bounded provenance for successful app tool calls in thread history and\n  use the current tool binding, account link, and app policy when reading the\n  associated widget resource.\n- Reject missing, mismatched, failed, or ambiguous origins, while keeping\n  app-only tools available for widget reads without exposing them to the model.\n\n## Testing\n\nAdd app-server coverage for scoped widget reads across both history modes,\nephemeral and persistent threads, server restarts, app-only visibility, and\ninvalid origin cases.\n\nGitOrigin-RevId: 11eaefc066b2a3b639599e4cbdef680233d150a2","tree":{"sha":"236cf583e0530b6e7f0bcb272d9cf1cf782236f5","url":"https://api.github.com/repos/openai/codex/git/trees/236cf583e0530b6e7f0bcb272d9cf1cf782236f5"},"url":"https://api.github.com/repos/openai/codex/git/commits/880f1135ea5902f85d7c13d60ee01d61334b6ad9","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/880f1135ea5902f85d7c13d60ee01d61334b6ad9","html_url":"https://github.com/openai/codex/commit/880f1135ea5902f85d7c13d60ee01d61334b6ad9","comments_url":"https://api.github.com/repos/openai/codex/commits/880f1135ea5902f85d7c13d60ee01d61334b6ad9/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"711a5f8b3a6eb40134146ae9ec22fdcdda5e3170","url":"https://api.github.com/repos/openai/codex/commits/711a5f8b3a6eb40134146ae9ec22fdcdda5e3170","html_url":"https://github.com/openai/codex/commit/711a5f8b3a6eb40134146ae9ec22fdcdda5e3170"}]},{"sha":"711a5f8b3a6eb40134146ae9ec22fdcdda5e3170","node_id":"C_kwDOOYsS4doAKDcxMWE1ZjhiM2E2ZWI0MDEzNDE0NmFlOWVjMjJmZGNkZGE1ZTMxNzA","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-18T09:32:36Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T09:38:27Z"},"message":"Drop descendant progress updates after remote compaction (#39176)\n\n## What changed\n\n- Exclude descendant-authored `MESSAGE` progress updates from the history retained after remote compaction v2.\n- Continue retaining descendant-authored tasks while omitting progress updates and final answers from subsequent requests.\n\n## Testing\n\n- Extend the remote compaction follow-up test to cover descendant progress updates and descendant-authored tasks.\n\nGitOrigin-RevId: 3e3e60bb108d27e99e2a4c222eed4b9d02fd3829","tree":{"sha":"3653bb466582980e2019fba119809b94071630f5","url":"https://api.github.com/repos/openai/codex/git/trees/3653bb466582980e2019fba119809b94071630f5"},"url":"https://api.github.com/repos/openai/codex/git/commits/711a5f8b3a6eb40134146ae9ec22fdcdda5e3170","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/711a5f8b3a6eb40134146ae9ec22fdcdda5e3170","html_url":"https://github.com/openai/codex/commit/711a5f8b3a6eb40134146ae9ec22fdcdda5e3170","comments_url":"https://api.github.com/repos/openai/codex/commits/711a5f8b3a6eb40134146ae9ec22fdcdda5e3170/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"63b268c81b28bb65203afdc57862efaa3879998b","url":"https://api.github.com/repos/openai/codex/commits/63b268c81b28bb65203afdc57862efaa3879998b","html_url":"https://github.com/openai/codex/commit/63b268c81b28bb65203afdc57862efaa3879998b"}]},{"sha":"63b268c81b28bb65203afdc57862efaa3879998b","node_id":"C_kwDOOYsS4doAKDYzYjI2OGM4MWIyOGJiNjUyMDNhZmRjNTc4NjJlZmFhMzg3OTk5OGI","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-18T09:19:38Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T09:25:02Z"},"message":"Skip empty user messages for automatic idle turns (#39174)\n\n## What changed\n\nStart sampling for automatic idle `UserInput` requests without adding an empty\nmessage to the input queue. Continue queuing automatic response-item input.\n\nGitOrigin-RevId: 5d304aed9e7e165380b29b5b59d9245e97b40659","tree":{"sha":"7d12f1450257147849fedb2639f40ad45c477549","url":"https://api.github.com/repos/openai/codex/git/trees/7d12f1450257147849fedb2639f40ad45c477549"},"url":"https://api.github.com/repos/openai/codex/git/commits/63b268c81b28bb65203afdc57862efaa3879998b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/63b268c81b28bb65203afdc57862efaa3879998b","html_url":"https://github.com/openai/codex/commit/63b268c81b28bb65203afdc57862efaa3879998b","comments_url":"https://api.github.com/repos/openai/codex/commits/63b268c81b28bb65203afdc57862efaa3879998b/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"0acf302db5ffedea4b8ef0112f4cbcddd65cff57","url":"https://api.github.com/repos/openai/codex/commits/0acf302db5ffedea4b8ef0112f4cbcddd65cff57","html_url":"https://github.com/openai/codex/commit/0acf302db5ffedea4b8ef0112f4cbcddd65cff57"}]},{"sha":"0acf302db5ffedea4b8ef0112f4cbcddd65cff57","node_id":"C_kwDOOYsS4doAKDBhY2YzMDJkYjVmZmVkZWE0YjhlZjAxMTJmNGNiY2RkZDY1Y2ZmNTc","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-18T07:51:09Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T07:56:41Z"},"message":"Prevent marketplace identity spoofing (#39165)\n\n## Why\n\nRepository manifests and user-configured sources must not be able to claim names reserved for managed or remote marketplaces.\n\n## What changed\n\n- Reject reserved marketplace names from unmanaged sources during discovery, installation, configuration projection, and configured marketplace upgrades, even when source restrictions are disabled.\n- Recognize managed marketplaces only at their expected paths. Preserve the required macOS and Windows path equivalences without allowing symlink aliases to inherit managed provenance.\n\n## Testing\n\n- Cover reserved-name rejection for plugin list and install RPCs, configured upgrades, unrestricted policy, and remote marketplace names.\n- Cover symlink spoofing and Windows managed-path normalization.\n\nGitOrigin-RevId: a610bdc382857f306dd3e244f0992de2ec279673","tree":{"sha":"e7e58dac9a123333ec2be88fa1c77848dc568ce6","url":"https://api.github.com/repos/openai/codex/git/trees/e7e58dac9a123333ec2be88fa1c77848dc568ce6"},"url":"https://api.github.com/repos/openai/codex/git/commits/0acf302db5ffedea4b8ef0112f4cbcddd65cff57","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/0acf302db5ffedea4b8ef0112f4cbcddd65cff57","html_url":"https://github.com/openai/codex/commit/0acf302db5ffedea4b8ef0112f4cbcddd65cff57","comments_url":"https://api.github.com/repos/openai/codex/commits/0acf302db5ffedea4b8ef0112f4cbcddd65cff57/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"e2eea071405a4d312ca9eabeed91b7e7cb9685c3","url":"https://api.github.com/repos/openai/codex/commits/e2eea071405a4d312ca9eabeed91b7e7cb9685c3","html_url":"https://github.com/openai/codex/commit/e2eea071405a4d312ca9eabeed91b7e7cb9685c3"}]},{"sha":"e2eea071405a4d312ca9eabeed91b7e7cb9685c3","node_id":"C_kwDOOYsS4doAKGUyZWVhMDcxNDA1YTRkMzEyY2E5ZWFiZWVkOTFiN2U3Y2I5Njg1YzM","commit":{"author":{"name":"rhan-oai","email":"rhan@openai.com","date":"2026-08-18T07:20:58Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T07:32:03Z"},"message":"Refresh collaboration instructions when their content changes (#39163)\n\n## Why\n\nCollaboration guidance can change without changing the active mode or model, such as after a model catalog refresh. Tracking only the mode and model leaves the earlier guidance in retained history.\n\n## What changed\n\n- Include a hash of the rendered collaboration instructions in the world-state snapshot so changed guidance is appended to retained history once.\n- Emit one empty collaboration fragment when guidance is removed, preventing stale instructions from remaining active without repeatedly clearing them.\n- Refresh legacy snapshots that lack an instruction hash once on resume.\n\n## Testing\n\nCover same-mode catalog updates, clearing missing or explicitly empty guidance, retained-history behavior, and cold resume from legacy snapshots.\n\nGitOrigin-RevId: 69f690adeccd1fb9794a6b15647e6efae3fec4f6","tree":{"sha":"da4954dbb4929ce25a4b7aba691d1f914c91bf34","url":"https://api.github.com/repos/openai/codex/git/trees/da4954dbb4929ce25a4b7aba691d1f914c91bf34"},"url":"https://api.github.com/repos/openai/codex/git/commits/e2eea071405a4d312ca9eabeed91b7e7cb9685c3","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/e2eea071405a4d312ca9eabeed91b7e7cb9685c3","html_url":"https://github.com/openai/codex/commit/e2eea071405a4d312ca9eabeed91b7e7cb9685c3","comments_url":"https://api.github.com/repos/openai/codex/commits/e2eea071405a4d312ca9eabeed91b7e7cb9685c3/comments","author":{"login":"rhan-oai","id":214716640,"node_id":"U_kgDODMxQ4A","avatar_url":"https://avatars.githubusercontent.com/u/214716640?v=4","gravatar_id":"","url":"https://api.github.com/users/rhan-oai","html_url":"https://github.com/rhan-oai","followers_url":"https://api.github.com/users/rhan-oai/followers","following_url":"https://api.github.com/users/rhan-oai/following{/other_user}","gists_url":"https://api.github.com/users/rhan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rhan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rhan-oai/subscriptions","organizations_url":"https://api.github.com/users/rhan-oai/orgs","repos_url":"https://api.github.com/users/rhan-oai/repos","events_url":"https://api.github.com/users/rhan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rhan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4216123b3df55c7f59323e9d57055e1c8dc4dbba","url":"https://api.github.com/repos/openai/codex/commits/4216123b3df55c7f59323e9d57055e1c8dc4dbba","html_url":"https://github.com/openai/codex/commit/4216123b3df55c7f59323e9d57055e1c8dc4dbba"}]},{"sha":"4216123b3df55c7f59323e9d57055e1c8dc4dbba","node_id":"C_kwDOOYsS4doAKDQyMTYxMjNiM2RmNTVjN2Y1OTMyM2U5ZDU3MDU1ZTFjOGRjNGRiYmE","commit":{"author":{"name":"Dylan Hurd","email":"dylan.hurd@openai.com","date":"2026-08-18T07:19:14Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T07:26:21Z"},"message":"Require approval for commands with dynamic shell words (#39159)\n\n## Why\n\nTree-sitter can represent brace expansions, globs, and escaped text as plain\nwords even though the shell changes them at runtime. Treating their source text\nas literal argv could let a command match a safe-command check or allow rule\nthat does not match what will actually execute.\n\n## What changed\n\n- Reject unquoted Bash and Zsh words containing expansion, glob, or escape\n  syntax from literal command parsing, including heredoc command prefixes.\n- Reject double-quoted escape sequences that the shell removes or interprets,\n  while continuing to accept quoted metacharacters that remain literal.\n- Require approval for affected commands under `UnlessTrusted`, even when a\n  policy contains an allow rule for the unexpanded source text.\n\n## Testing\n\nAdd parser and approval scenarios covering brace expansion, globs, escapes,\nZsh-specific syntax, heredocs, and quoted literals.\n\nGitOrigin-RevId: 31f2c6062680c42ac65362e3f3eebfaaf4eb71da","tree":{"sha":"2c4d5735a609461ac92097a9341f2e11039a6dbf","url":"https://api.github.com/repos/openai/codex/git/trees/2c4d5735a609461ac92097a9341f2e11039a6dbf"},"url":"https://api.github.com/repos/openai/codex/git/commits/4216123b3df55c7f59323e9d57055e1c8dc4dbba","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4216123b3df55c7f59323e9d57055e1c8dc4dbba","html_url":"https://github.com/openai/codex/commit/4216123b3df55c7f59323e9d57055e1c8dc4dbba","comments_url":"https://api.github.com/repos/openai/codex/commits/4216123b3df55c7f59323e9d57055e1c8dc4dbba/comments","author":{"login":"dylan-hurd-oai","id":220976066,"node_id":"U_kgDODSvTwg","avatar_url":"https://avatars.githubusercontent.com/u/220976066?v=4","gravatar_id":"","url":"https://api.github.com/users/dylan-hurd-oai","html_url":"https://github.com/dylan-hurd-oai","followers_url":"https://api.github.com/users/dylan-hurd-oai/followers","following_url":"https://api.github.com/users/dylan-hurd-oai/following{/other_user}","gists_url":"https://api.github.com/users/dylan-hurd-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/dylan-hurd-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dylan-hurd-oai/subscriptions","organizations_url":"https://api.github.com/users/dylan-hurd-oai/orgs","repos_url":"https://api.github.com/users/dylan-hurd-oai/repos","events_url":"https://api.github.com/users/dylan-hurd-oai/events{/privacy}","received_events_url":"https://api.github.com/users/dylan-hurd-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"f5e9d66851a20311b8385204686990c6c5960014","url":"https://api.github.com/repos/openai/codex/commits/f5e9d66851a20311b8385204686990c6c5960014","html_url":"https://github.com/openai/codex/commit/f5e9d66851a20311b8385204686990c6c5960014"}]},{"sha":"f5e9d66851a20311b8385204686990c6c5960014","node_id":"C_kwDOOYsS4doAKGY1ZTlkNjY4NTFhMjAzMTFiODM4NTIwNDY4Njk5MGM2YzU5NjAwMTQ","commit":{"author":{"name":"Shijie Rao","email":"shijie.rao@openai.com","date":"2026-08-18T06:38:31Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T06:48:12Z"},"message":"Notify clients when Guardian requires strict review (#39157)\n\n## What changed\n\n- Add the experimental `autoApprovalReview/strictReviewRequired` app-server notification with the review's `threadId`, `turnId`, and `startedAtMs`.\n- Emit it when Guardian v2 leaves an approval review in progress because the action risk is elevated or its score is stale.\n- Export the notification through the Rust, TypeScript, and JSON schema surfaces and route it to the associated thread.\n\n## Testing\n\n- Cover strict-review reason tracking for elevated and stale risk scores.\n- Verify that high-risk approval routing emits one notification whose identifiers and timestamp match the review-started event.\n\nGitOrigin-RevId: e65352894520bfb756c75b2c95e2e149f9767bb2","tree":{"sha":"b0d749c52f81d60e15281783ef6594047b881d7b","url":"https://api.github.com/repos/openai/codex/git/trees/b0d749c52f81d60e15281783ef6594047b881d7b"},"url":"https://api.github.com/repos/openai/codex/git/commits/f5e9d66851a20311b8385204686990c6c5960014","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/f5e9d66851a20311b8385204686990c6c5960014","html_url":"https://github.com/openai/codex/commit/f5e9d66851a20311b8385204686990c6c5960014","comments_url":"https://api.github.com/repos/openai/codex/commits/f5e9d66851a20311b8385204686990c6c5960014/comments","author":{"login":"shijie-oai","id":235382242,"node_id":"U_kgDODgel4g","avatar_url":"https://avatars.githubusercontent.com/u/235382242?v=4","gravatar_id":"","url":"https://api.github.com/users/shijie-oai","html_url":"https://github.com/shijie-oai","followers_url":"https://api.github.com/users/shijie-oai/followers","following_url":"https://api.github.com/users/shijie-oai/following{/other_user}","gists_url":"https://api.github.com/users/shijie-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/shijie-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shijie-oai/subscriptions","organizations_url":"https://api.github.com/users/shijie-oai/orgs","repos_url":"https://api.github.com/users/shijie-oai/repos","events_url":"https://api.github.com/users/shijie-oai/events{/privacy}","received_events_url":"https://api.github.com/users/shijie-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"f6ba9110fa5ac469ea732612f8ca06375ea4de42","url":"https://api.github.com/repos/openai/codex/commits/f6ba9110fa5ac469ea732612f8ca06375ea4de42","html_url":"https://github.com/openai/codex/commit/f6ba9110fa5ac469ea732612f8ca06375ea4de42"}]},{"sha":"f6ba9110fa5ac469ea732612f8ca06375ea4de42","node_id":"C_kwDOOYsS4doAKGY2YmE5MTEwZmE1YWM0NjllYTczMjYxMmY4Y2EwNjM3NWVhNGRlNDI","commit":{"author":{"name":"Ahmed Ibrahim","email":"aibrahim@openai.com","date":"2026-08-18T06:37:46Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T06:43:10Z"},"message":"Prepare Python SDK 0.147.0 stable release (#39155)\n\n## What changed\n\n- Pin `openai-codex` to the `0.147.0` CLI runtime and regenerate its protocol models and lockfile.\n- Allow stable Python SDK release tags and require their versions to match the pinned runtime.\n- Expose the regenerated API additions, including thread sections, environment connection notifications, audio inputs, and the `section_id` thread-list filter.\n\n## Testing\n\n- Update release staging, generated-contract, notification, and public-signature coverage for the new runtime.\n\nGitOrigin-RevId: 8b99ef6781e01c34d9d697c8c44247fb4e4fe3ab","tree":{"sha":"d4b1c74fc0a55bfa002496d14f6ec01b55604640","url":"https://api.github.com/repos/openai/codex/git/trees/d4b1c74fc0a55bfa002496d14f6ec01b55604640"},"url":"https://api.github.com/repos/openai/codex/git/commits/f6ba9110fa5ac469ea732612f8ca06375ea4de42","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/f6ba9110fa5ac469ea732612f8ca06375ea4de42","html_url":"https://github.com/openai/codex/commit/f6ba9110fa5ac469ea732612f8ca06375ea4de42","comments_url":"https://api.github.com/repos/openai/codex/commits/f6ba9110fa5ac469ea732612f8ca06375ea4de42/comments","author":{"login":"aibrahim-oai","id":219906144,"node_id":"U_kgDODRuAYA","avatar_url":"https://avatars.githubusercontent.com/u/219906144?v=4","gravatar_id":"","url":"https://api.github.com/users/aibrahim-oai","html_url":"https://github.com/aibrahim-oai","followers_url":"https://api.github.com/users/aibrahim-oai/followers","following_url":"https://api.github.com/users/aibrahim-oai/following{/other_user}","gists_url":"https://api.github.com/users/aibrahim-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/aibrahim-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aibrahim-oai/subscriptions","organizations_url":"https://api.github.com/users/aibrahim-oai/orgs","repos_url":"https://api.github.com/users/aibrahim-oai/repos","events_url":"https://api.github.com/users/aibrahim-oai/events{/privacy}","received_events_url":"https://api.github.com/users/aibrahim-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"3d47dc40be53a2b7729443cf89cfa8d058830aa1","url":"https://api.github.com/repos/openai/codex/commits/3d47dc40be53a2b7729443cf89cfa8d058830aa1","html_url":"https://github.com/openai/codex/commit/3d47dc40be53a2b7729443cf89cfa8d058830aa1"}]},{"sha":"3d47dc40be53a2b7729443cf89cfa8d058830aa1","node_id":"C_kwDOOYsS4doAKDNkNDdkYzQwYmU1M2EyYjc3Mjk0NDNjZjg5Y2ZhOGQwNTg4MzBhYTE","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-18T06:15:54Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T06:25:56Z"},"message":"Box the TUI future to bound CLI stack usage (#39154)\n\n## Why\n\nThe TUI startup future is large enough to inflate the CLI dispatcher's stack\nframe.\n\n## What changed\n\n- Heap-pin the TUI startup future before awaiting it.\n- Add a regression test that keeps the `run_interactive_tui` future below 64\n  KiB.\n\nGitOrigin-RevId: 1f977928117537a5188c4d801517fb4a42e39e15","tree":{"sha":"d3af16db49d7bdc31c0980764f69a225bd90df2b","url":"https://api.github.com/repos/openai/codex/git/trees/d3af16db49d7bdc31c0980764f69a225bd90df2b"},"url":"https://api.github.com/repos/openai/codex/git/commits/3d47dc40be53a2b7729443cf89cfa8d058830aa1","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/3d47dc40be53a2b7729443cf89cfa8d058830aa1","html_url":"https://github.com/openai/codex/commit/3d47dc40be53a2b7729443cf89cfa8d058830aa1","comments_url":"https://api.github.com/repos/openai/codex/commits/3d47dc40be53a2b7729443cf89cfa8d058830aa1/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"539a09cb28ca1ded4278c6d54716abbacab42428","url":"https://api.github.com/repos/openai/codex/commits/539a09cb28ca1ded4278c6d54716abbacab42428","html_url":"https://github.com/openai/codex/commit/539a09cb28ca1ded4278c6d54716abbacab42428"}]},{"sha":"539a09cb28ca1ded4278c6d54716abbacab42428","node_id":"C_kwDOOYsS4doAKDUzOWEwOWNiMjhjYTFkZWQ0Mjc4YzZkNTQ3MTZhYmJhY2FiNDI0Mjg","commit":{"author":{"name":"Shijie Rao","email":"shijie.rao@openai.com","date":"2026-08-18T06:10:30Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T06:22:04Z"},"message":"Restore permission profiles when resuming threads (#39153)\n\n## Why\n\nCold resumes and forks could lose the thread's active permission profile and\nfall back to the current configured default.\n\n## What changed\n\n- Restore the latest persisted approval policy, approvals reviewer, and active\n  permission-profile ID when resuming or forking a thread.\n- Re-resolve persisted profile IDs through current configuration and\n  requirements. Missing or invalid profiles fall back to the configured\n  default, while threads without a persisted profile continue to use current\n  configuration.\n- Keep explicit permission and approval overrides ahead of persisted settings.\n\n## Testing\n\nAdded coverage for legacy and paginated histories, settings updates, explicit\noverrides, removed or changed profiles, requirement fallbacks, and forks.\n\nGitOrigin-RevId: 2289af2f3206bf131a6ffe0e8447e8d402e76c47","tree":{"sha":"32f494518ae0a0ece87958cbe64a70388a421598","url":"https://api.github.com/repos/openai/codex/git/trees/32f494518ae0a0ece87958cbe64a70388a421598"},"url":"https://api.github.com/repos/openai/codex/git/commits/539a09cb28ca1ded4278c6d54716abbacab42428","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/539a09cb28ca1ded4278c6d54716abbacab42428","html_url":"https://github.com/openai/codex/commit/539a09cb28ca1ded4278c6d54716abbacab42428","comments_url":"https://api.github.com/repos/openai/codex/commits/539a09cb28ca1ded4278c6d54716abbacab42428/comments","author":{"login":"shijie-oai","id":235382242,"node_id":"U_kgDODgel4g","avatar_url":"https://avatars.githubusercontent.com/u/235382242?v=4","gravatar_id":"","url":"https://api.github.com/users/shijie-oai","html_url":"https://github.com/shijie-oai","followers_url":"https://api.github.com/users/shijie-oai/followers","following_url":"https://api.github.com/users/shijie-oai/following{/other_user}","gists_url":"https://api.github.com/users/shijie-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/shijie-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shijie-oai/subscriptions","organizations_url":"https://api.github.com/users/shijie-oai/orgs","repos_url":"https://api.github.com/users/shijie-oai/repos","events_url":"https://api.github.com/users/shijie-oai/events{/privacy}","received_events_url":"https://api.github.com/users/shijie-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"6f95f19103983e4d269609bff86c7dd20bd16c7c","url":"https://api.github.com/repos/openai/codex/commits/6f95f19103983e4d269609bff86c7dd20bd16c7c","html_url":"https://github.com/openai/codex/commit/6f95f19103983e4d269609bff86c7dd20bd16c7c"}]},{"sha":"6f95f19103983e4d269609bff86c7dd20bd16c7c","node_id":"C_kwDOOYsS4doAKDZmOTVmMTkxMDM5ODNlNGQyNjk2MDliZmY4NmM3ZGQyMGJkMTZjN2M","commit":{"author":{"name":"Ahmed Ibrahim","email":"aibrahim@openai.com","date":"2026-08-18T06:04:12Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T06:18:37Z"},"message":"Update PyPI publish action to v1.14.2 (#39152)\n\n## What changed\n\nUpdate `pypa/gh-action-pypi-publish` from v1.13.0 to v1.14.2 for the Python runtime and SDK publishing jobs.\n\nGitOrigin-RevId: 239d2787aec47fd53111e05c29efdd680c0c7c67","tree":{"sha":"15b6ab78b28f86debcbb42215ee8bd8a2e25807a","url":"https://api.github.com/repos/openai/codex/git/trees/15b6ab78b28f86debcbb42215ee8bd8a2e25807a"},"url":"https://api.github.com/repos/openai/codex/git/commits/6f95f19103983e4d269609bff86c7dd20bd16c7c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/6f95f19103983e4d269609bff86c7dd20bd16c7c","html_url":"https://github.com/openai/codex/commit/6f95f19103983e4d269609bff86c7dd20bd16c7c","comments_url":"https://api.github.com/repos/openai/codex/commits/6f95f19103983e4d269609bff86c7dd20bd16c7c/comments","author":{"login":"aibrahim-oai","id":219906144,"node_id":"U_kgDODRuAYA","avatar_url":"https://avatars.githubusercontent.com/u/219906144?v=4","gravatar_id":"","url":"https://api.github.com/users/aibrahim-oai","html_url":"https://github.com/aibrahim-oai","followers_url":"https://api.github.com/users/aibrahim-oai/followers","following_url":"https://api.github.com/users/aibrahim-oai/following{/other_user}","gists_url":"https://api.github.com/users/aibrahim-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/aibrahim-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aibrahim-oai/subscriptions","organizations_url":"https://api.github.com/users/aibrahim-oai/orgs","repos_url":"https://api.github.com/users/aibrahim-oai/repos","events_url":"https://api.github.com/users/aibrahim-oai/events{/privacy}","received_events_url":"https://api.github.com/users/aibrahim-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"bc7a4870398ac8f7ac90aaab1dc10ee0766f7fe1","url":"https://api.github.com/repos/openai/codex/commits/bc7a4870398ac8f7ac90aaab1dc10ee0766f7fe1","html_url":"https://github.com/openai/codex/commit/bc7a4870398ac8f7ac90aaab1dc10ee0766f7fe1"}]},{"sha":"bc7a4870398ac8f7ac90aaab1dc10ee0766f7fe1","node_id":"C_kwDOOYsS4doAKGJjN2E0ODcwMzk4YWM4ZjdhYzkwYWFhYjFkYzEwZWUwNzY2ZjdmZTE","commit":{"author":{"name":"Shijie Rao","email":"shijie.rao@openai.com","date":"2026-08-18T05:50:51Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T06:00:00Z"},"message":"Centralize persisted resume settings lookup (#39147)\n\n## What changed\n\n- Add a shared helper for recovering the latest persisted approvals reviewer from turn context and thread settings history.\n- Use the helper when resuming and forking threads while continuing to honor explicit request overrides.\n- Fall back to an older persisted reviewer when the latest turn context omits the field.\n\n## Testing\n\n- Add unit coverage for settings snapshot precedence, turn context precedence, and fallback to an older reviewer.\n\nGitOrigin-RevId: dfc0332b0f1410a4c9a550236eb32624f5133baa","tree":{"sha":"1b49ad1d1bc7c55f59cde92e0bbb43c8857db880","url":"https://api.github.com/repos/openai/codex/git/trees/1b49ad1d1bc7c55f59cde92e0bbb43c8857db880"},"url":"https://api.github.com/repos/openai/codex/git/commits/bc7a4870398ac8f7ac90aaab1dc10ee0766f7fe1","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/bc7a4870398ac8f7ac90aaab1dc10ee0766f7fe1","html_url":"https://github.com/openai/codex/commit/bc7a4870398ac8f7ac90aaab1dc10ee0766f7fe1","comments_url":"https://api.github.com/repos/openai/codex/commits/bc7a4870398ac8f7ac90aaab1dc10ee0766f7fe1/comments","author":{"login":"shijie-oai","id":235382242,"node_id":"U_kgDODgel4g","avatar_url":"https://avatars.githubusercontent.com/u/235382242?v=4","gravatar_id":"","url":"https://api.github.com/users/shijie-oai","html_url":"https://github.com/shijie-oai","followers_url":"https://api.github.com/users/shijie-oai/followers","following_url":"https://api.github.com/users/shijie-oai/following{/other_user}","gists_url":"https://api.github.com/users/shijie-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/shijie-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shijie-oai/subscriptions","organizations_url":"https://api.github.com/users/shijie-oai/orgs","repos_url":"https://api.github.com/users/shijie-oai/repos","events_url":"https://api.github.com/users/shijie-oai/events{/privacy}","received_events_url":"https://api.github.com/users/shijie-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"230791fd1f255b9bd5ca5228326239db980f08dd","url":"https://api.github.com/repos/openai/codex/commits/230791fd1f255b9bd5ca5228326239db980f08dd","html_url":"https://github.com/openai/codex/commit/230791fd1f255b9bd5ca5228326239db980f08dd"}]},{"sha":"230791fd1f255b9bd5ca5228326239db980f08dd","node_id":"C_kwDOOYsS4doAKDIzMDc5MWZkMWYyNTViOWJkNWNhNTIyODMyNjIzOWRiOTgwZjA4ZGQ","commit":{"author":{"name":"Shijie Rao","email":"shijie.rao@openai.com","date":"2026-08-18T05:31:18Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T05:46:08Z"},"message":"Persist active permission profiles in turn context (#39145)\n\n## What changed\n\n- Add the optional `active_permission_profile` field to `TurnContextItem` to record the built-in or named profile that produced the effective permission profile.\n- Populate the field when serializing a turn context while preserving compatibility with records where it is absent.\n\n## Testing\n\n- Add coverage verifying that turn-context serialization stores the active permission profile.\n\nGitOrigin-RevId: d69142ab1b26595ab406235f89818ef41370e963","tree":{"sha":"d0be91459c8465ebfa41637019e52540f8e1d999","url":"https://api.github.com/repos/openai/codex/git/trees/d0be91459c8465ebfa41637019e52540f8e1d999"},"url":"https://api.github.com/repos/openai/codex/git/commits/230791fd1f255b9bd5ca5228326239db980f08dd","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/230791fd1f255b9bd5ca5228326239db980f08dd","html_url":"https://github.com/openai/codex/commit/230791fd1f255b9bd5ca5228326239db980f08dd","comments_url":"https://api.github.com/repos/openai/codex/commits/230791fd1f255b9bd5ca5228326239db980f08dd/comments","author":{"login":"shijie-oai","id":235382242,"node_id":"U_kgDODgel4g","avatar_url":"https://avatars.githubusercontent.com/u/235382242?v=4","gravatar_id":"","url":"https://api.github.com/users/shijie-oai","html_url":"https://github.com/shijie-oai","followers_url":"https://api.github.com/users/shijie-oai/followers","following_url":"https://api.github.com/users/shijie-oai/following{/other_user}","gists_url":"https://api.github.com/users/shijie-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/shijie-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shijie-oai/subscriptions","organizations_url":"https://api.github.com/users/shijie-oai/orgs","repos_url":"https://api.github.com/users/shijie-oai/repos","events_url":"https://api.github.com/users/shijie-oai/events{/privacy}","received_events_url":"https://api.github.com/users/shijie-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"de7bbb04811afdbefe77b1604ebe0d0e28734d7c","url":"https://api.github.com/repos/openai/codex/commits/de7bbb04811afdbefe77b1604ebe0d0e28734d7c","html_url":"https://github.com/openai/codex/commit/de7bbb04811afdbefe77b1604ebe0d0e28734d7c"}]},{"sha":"de7bbb04811afdbefe77b1604ebe0d0e28734d7c","node_id":"C_kwDOOYsS4doAKGRlN2JiYjA0ODExYWZkYmVmZTc3YjE2MDRlYmUwZDBlMjg3MzRkN2M","commit":{"author":{"name":"Matthew Zeng","email":"mzeng@openai.com","date":"2026-08-18T05:30:25Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T05:42:39Z"},"message":"Hydrate recommended plugin metadata on selection (#39143)\n\n## What changed\n\n- Fetch recommendations from the Codex-specific `/ps/plugins/suggested/codex` endpoint and parse its compact response shape.\n- Fetch the selected plugin's details before presenting an install request, using them to verify availability and populate connector metadata.\n- Skip install elicitation when the selected recommendation is no longer available, and return a retryable response when its metadata cannot be verified.\n\n## Testing\n\n- Cover the new recommendation route and response shape.\n- Cover metadata hydration for available plugins and rejection of unavailable plugins.\n\nGitOrigin-RevId: 2b0e2d70572aae2b7cd8e458b42e9dd14be3dbaf","tree":{"sha":"85dcc51be1a9ca6791696c8eef98fc4b258df987","url":"https://api.github.com/repos/openai/codex/git/trees/85dcc51be1a9ca6791696c8eef98fc4b258df987"},"url":"https://api.github.com/repos/openai/codex/git/commits/de7bbb04811afdbefe77b1604ebe0d0e28734d7c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/de7bbb04811afdbefe77b1604ebe0d0e28734d7c","html_url":"https://github.com/openai/codex/commit/de7bbb04811afdbefe77b1604ebe0d0e28734d7c","comments_url":"https://api.github.com/repos/openai/codex/commits/de7bbb04811afdbefe77b1604ebe0d0e28734d7c/comments","author":{"login":"mzeng-openai","id":175741029,"node_id":"U_kgDOCnmYZQ","avatar_url":"https://avatars.githubusercontent.com/u/175741029?v=4","gravatar_id":"","url":"https://api.github.com/users/mzeng-openai","html_url":"https://github.com/mzeng-openai","followers_url":"https://api.github.com/users/mzeng-openai/followers","following_url":"https://api.github.com/users/mzeng-openai/following{/other_user}","gists_url":"https://api.github.com/users/mzeng-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/mzeng-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mzeng-openai/subscriptions","organizations_url":"https://api.github.com/users/mzeng-openai/orgs","repos_url":"https://api.github.com/users/mzeng-openai/repos","events_url":"https://api.github.com/users/mzeng-openai/events{/privacy}","received_events_url":"https://api.github.com/users/mzeng-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"f47f77ada6699460bf13b0b7278e710692e0ea34","url":"https://api.github.com/repos/openai/codex/commits/f47f77ada6699460bf13b0b7278e710692e0ea34","html_url":"https://github.com/openai/codex/commit/f47f77ada6699460bf13b0b7278e710692e0ea34"}]},{"sha":"f47f77ada6699460bf13b0b7278e710692e0ea34","node_id":"C_kwDOOYsS4doAKGY0N2Y3N2FkYTY2OTk0NjBiZjEzYjBiNzI3OGU3MTA2OTJlMGVhMzQ","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-18T05:24:10Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T05:30:11Z"},"message":"Add configurable shortcuts for the agents dashboard (#39142)\n\n## What changed\n\n- Add `tui.keymap.global.open_agents`, defaulting to `alt-a`, to open the shared agents overview.\n- Add an `agents` keymap context for search, new task, rename, stop, and grouping actions.\n- Expose the new actions in the keymap picker and render dashboard hints from the resolved bindings.\n- Preserve existing custom `alt-a` bindings by disabling the new default when it would conflict.\n\n## Testing\n\n- Cover remapping, reserved keys, conflicts, and compatibility with existing bindings.\n- Verify that configured dashboard shortcuts act on the selected filtered task.\n\nGitOrigin-RevId: 98c48a332e06cb96dbf0e59647ce7959d45b9988","tree":{"sha":"56cf64dc88625c3712b74b48ee59528265720070","url":"https://api.github.com/repos/openai/codex/git/trees/56cf64dc88625c3712b74b48ee59528265720070"},"url":"https://api.github.com/repos/openai/codex/git/commits/f47f77ada6699460bf13b0b7278e710692e0ea34","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/f47f77ada6699460bf13b0b7278e710692e0ea34","html_url":"https://github.com/openai/codex/commit/f47f77ada6699460bf13b0b7278e710692e0ea34","comments_url":"https://api.github.com/repos/openai/codex/commits/f47f77ada6699460bf13b0b7278e710692e0ea34/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"9a254ba1fa0315e90e0cb2eed5038eaf418a19cd","url":"https://api.github.com/repos/openai/codex/commits/9a254ba1fa0315e90e0cb2eed5038eaf418a19cd","html_url":"https://github.com/openai/codex/commit/9a254ba1fa0315e90e0cb2eed5038eaf418a19cd"}]},{"sha":"9a254ba1fa0315e90e0cb2eed5038eaf418a19cd","node_id":"C_kwDOOYsS4doAKDlhMjU0YmExZmEwMzE1ZTkwZTBjYjJlZWQ1MDM4ZWFmNDE4YTE5Y2Q","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-08-18T05:15:44Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T05:25:22Z"},"message":"Redact auth tokens from app-server response logs (#39141)\n\n## Why\n\nApp-server response diagnostics can include access tokens returned by the ChatGPT auth refresh flow.\n\n## What changed\n\n- Log successfully parsed server responses instead of raw JSON-RPC response payloads.\n- Redact `access_token` from the `Debug` representation of `ChatgptAuthTokensRefreshResponse`.\n- Avoid formatting callback send errors that can retain the original response payload.\n\nGitOrigin-RevId: fd47485b38ed89527b25937c759b3273581f6ae6","tree":{"sha":"a314b5c225418cbfdc3450f7aabf75609f52bf97","url":"https://api.github.com/repos/openai/codex/git/trees/a314b5c225418cbfdc3450f7aabf75609f52bf97"},"url":"https://api.github.com/repos/openai/codex/git/commits/9a254ba1fa0315e90e0cb2eed5038eaf418a19cd","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/9a254ba1fa0315e90e0cb2eed5038eaf418a19cd","html_url":"https://github.com/openai/codex/commit/9a254ba1fa0315e90e0cb2eed5038eaf418a19cd","comments_url":"https://api.github.com/repos/openai/codex/commits/9a254ba1fa0315e90e0cb2eed5038eaf418a19cd/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"5ee6baee2fcc0b6ffd413d9611f5538dad40d0f2","url":"https://api.github.com/repos/openai/codex/commits/5ee6baee2fcc0b6ffd413d9611f5538dad40d0f2","html_url":"https://github.com/openai/codex/commit/5ee6baee2fcc0b6ffd413d9611f5538dad40d0f2"}]},{"sha":"5ee6baee2fcc0b6ffd413d9611f5538dad40d0f2","node_id":"C_kwDOOYsS4doAKDVlZTZiYWVlMmZjYzBiNmZmZDQxM2Q5NjExZjU1MzhkYWQ0MGQwZjI","commit":{"author":{"name":"xl-openai","email":"xl@openai.com","date":"2026-08-18T03:25:54Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T03:31:06Z"},"message":"Validate identifiers in plugin creator workflows (#39131)\n\n## Why\n\nPlugin and marketplace names can flow into generated install commands, so the\nplugin creator must reject names outside the supported identifier syntax before\nusing them or changing files.\n\n## What changed\n\n- Centralize validation for plugin names, including dotted names, and marketplace\n  names.\n- Apply validation when reading marketplaces, validating manifests, updating\n  cachebusters, and scaffolding plugins.\n- Validate existing marketplace state before scaffold writes so invalid or\n  duplicate entries leave plugin and marketplace files unchanged.\n\n## Testing\n\nAdd regression tests for accepted identifiers, unsafe and malformed names,\ndotted plugin names, and failure paths that must not modify files.\n\nGitOrigin-RevId: 9db68c2313a1539c5ab44d777966e33b460ceb71","tree":{"sha":"7b29cd74d774b41ec68446dd8ef7c724d96abb2c","url":"https://api.github.com/repos/openai/codex/git/trees/7b29cd74d774b41ec68446dd8ef7c724d96abb2c"},"url":"https://api.github.com/repos/openai/codex/git/commits/5ee6baee2fcc0b6ffd413d9611f5538dad40d0f2","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/5ee6baee2fcc0b6ffd413d9611f5538dad40d0f2","html_url":"https://github.com/openai/codex/commit/5ee6baee2fcc0b6ffd413d9611f5538dad40d0f2","comments_url":"https://api.github.com/repos/openai/codex/commits/5ee6baee2fcc0b6ffd413d9611f5538dad40d0f2/comments","author":{"login":"xl-openai","id":184293535,"node_id":"U_kgDOCvwYnw","avatar_url":"https://avatars.githubusercontent.com/u/184293535?v=4","gravatar_id":"","url":"https://api.github.com/users/xl-openai","html_url":"https://github.com/xl-openai","followers_url":"https://api.github.com/users/xl-openai/followers","following_url":"https://api.github.com/users/xl-openai/following{/other_user}","gists_url":"https://api.github.com/users/xl-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/xl-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/xl-openai/subscriptions","organizations_url":"https://api.github.com/users/xl-openai/orgs","repos_url":"https://api.github.com/users/xl-openai/repos","events_url":"https://api.github.com/users/xl-openai/events{/privacy}","received_events_url":"https://api.github.com/users/xl-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"f97e77569352a2bf5be9955e623edad0a15d9b93","url":"https://api.github.com/repos/openai/codex/commits/f97e77569352a2bf5be9955e623edad0a15d9b93","html_url":"https://github.com/openai/codex/commit/f97e77569352a2bf5be9955e623edad0a15d9b93"}]},{"sha":"f97e77569352a2bf5be9955e623edad0a15d9b93","node_id":"C_kwDOOYsS4doAKGY5N2U3NzU2OTM1MmEyYmY1YmU5OTU1ZTYyM2VkYWQwYTE1ZDliOTM","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-18T02:18:56Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T02:23:57Z"},"message":"Fail closed on deeply nested command wrappers (#39122)\n\n## Why\n\nDangerous-command inspection has a bounded wrapper depth. Returning no match\nafter that limit could let a nested dangerous payload escape policy detection.\n\n## What changed\n\n- Classify commands beyond the wrapper-depth limit as dangerous.\n- Cover the boundary and overflow cases in the command-safety unit tests.\n- Verify that exec policy rejects a deeply `env`-wrapped forced `rm` before it\n  can delete a sentinel file when approvals are disabled.\n\nGitOrigin-RevId: a6cdbbb7bdc6274a62745f668189fabaaf46745f","tree":{"sha":"364e9395b1f0d0045b1f7a8260b2fc0d04602759","url":"https://api.github.com/repos/openai/codex/git/trees/364e9395b1f0d0045b1f7a8260b2fc0d04602759"},"url":"https://api.github.com/repos/openai/codex/git/commits/f97e77569352a2bf5be9955e623edad0a15d9b93","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/f97e77569352a2bf5be9955e623edad0a15d9b93","html_url":"https://github.com/openai/codex/commit/f97e77569352a2bf5be9955e623edad0a15d9b93","comments_url":"https://api.github.com/repos/openai/codex/commits/f97e77569352a2bf5be9955e623edad0a15d9b93/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"ede5247893a50297a47c9aa5038e6ab28312ff50","url":"https://api.github.com/repos/openai/codex/commits/ede5247893a50297a47c9aa5038e6ab28312ff50","html_url":"https://github.com/openai/codex/commit/ede5247893a50297a47c9aa5038e6ab28312ff50"}]},{"sha":"ede5247893a50297a47c9aa5038e6ab28312ff50","node_id":"C_kwDOOYsS4doAKGVkZTUyNDc4OTNhNTAyOTdhNDdjOWFhNTAzOGU2YWIyODMxMmZmNTA","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-18T00:51:04Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T01:00:48Z"},"message":"Reject lossy legacy permission projections (#39117)\n\n## Why\n\nSome managed filesystem permission profiles cannot be represented by the\nlegacy app-server sandbox policy without changing which paths are accessible.\n\n## What changed\n\n- Require legacy sandbox conversion to preserve the filesystem policy's\n  semantics, and reject unsupported profiles with an actionable error.\n- Keep queued follow-up messages and safety-buffered retries intact when\n  permissions are rejected, resuming queued input only after a compatible\n  profile is selected.\n- Cover compatible profiles, lossy restrictions and write roots, turn-start\n  handling, and safety-buffered retries with regression tests.\n\nGitOrigin-RevId: 345cc2a839206b2b1997e8981feb59f91b6975cc","tree":{"sha":"036f98427a64783f68c0099d5fd6ae5d871eb9da","url":"https://api.github.com/repos/openai/codex/git/trees/036f98427a64783f68c0099d5fd6ae5d871eb9da"},"url":"https://api.github.com/repos/openai/codex/git/commits/ede5247893a50297a47c9aa5038e6ab28312ff50","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/ede5247893a50297a47c9aa5038e6ab28312ff50","html_url":"https://github.com/openai/codex/commit/ede5247893a50297a47c9aa5038e6ab28312ff50","comments_url":"https://api.github.com/repos/openai/codex/commits/ede5247893a50297a47c9aa5038e6ab28312ff50/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"ca08a58ab47779a966b86155e128325fdfb5af8a","url":"https://api.github.com/repos/openai/codex/commits/ca08a58ab47779a966b86155e128325fdfb5af8a","html_url":"https://github.com/openai/codex/commit/ca08a58ab47779a966b86155e128325fdfb5af8a"}]},{"sha":"ca08a58ab47779a966b86155e128325fdfb5af8a","node_id":"C_kwDOOYsS4doAKGNhMDhhNThhYjQ3Nzc5YTk2NmI4NjE1NWUxMjgzMjVmZGZiNWFmOGE","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-18T00:40:17Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T00:45:00Z"},"message":"Remove the experimental thread config endpoint (#39115)\n\n## What changed\n\n- Remove `experimental_thread_config_endpoint` from the configuration model and schema.\n- Stop app-server and the in-process client from constructing a remote thread config loader from local configuration.\n- Keep the thread config loader supplied at app-server startup fixed for the lifetime of the config manager.\n\nGitOrigin-RevId: e7907fee2d631e7ecf89ec6bac8f22bc2c221350","tree":{"sha":"bd637e7deab10167e8954c7cab21c7375e950f43","url":"https://api.github.com/repos/openai/codex/git/trees/bd637e7deab10167e8954c7cab21c7375e950f43"},"url":"https://api.github.com/repos/openai/codex/git/commits/ca08a58ab47779a966b86155e128325fdfb5af8a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/ca08a58ab47779a966b86155e128325fdfb5af8a","html_url":"https://github.com/openai/codex/commit/ca08a58ab47779a966b86155e128325fdfb5af8a","comments_url":"https://api.github.com/repos/openai/codex/commits/ca08a58ab47779a966b86155e128325fdfb5af8a/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fd5018e0445ba7d879c5dbda66ecdab4b6da1886","url":"https://api.github.com/repos/openai/codex/commits/fd5018e0445ba7d879c5dbda66ecdab4b6da1886","html_url":"https://github.com/openai/codex/commit/fd5018e0445ba7d879c5dbda66ecdab4b6da1886"}]},{"sha":"fd5018e0445ba7d879c5dbda66ecdab4b6da1886","node_id":"C_kwDOOYsS4doAKGZkNTAxOGUwNDQ1YmE3ZDg3OWM1ZGJkYTY2ZWNkYWI0YjZkYTE4ODY","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-18T00:21:28Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-18T00:31:51Z"},"message":"Add a dedicated `codex agents` dashboard command (#39114)\n\n## What changed\n\n- Add `codex agents` to open the shared agents overview without creating a new session.\n- Start the local background app server automatically on Unix, or connect to a server supplied with `--remote`.\n- Reject invocation-specific session overrides that cannot apply to shared sessions.\n- When the overview is opened from an embedded session, offer to start the background server without moving or interrupting the current session.\n\n## Testing\n\n- Cover command-line parsing and rejection of incompatible overrides.\n- Snapshot the embedded-session background-server prompt.\n\nGitOrigin-RevId: 60845dfebc48d820dc4ff090626d30452127f062","tree":{"sha":"d7495c83badfe2e0e29843239753f0288da5f234","url":"https://api.github.com/repos/openai/codex/git/trees/d7495c83badfe2e0e29843239753f0288da5f234"},"url":"https://api.github.com/repos/openai/codex/git/commits/fd5018e0445ba7d879c5dbda66ecdab4b6da1886","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fd5018e0445ba7d879c5dbda66ecdab4b6da1886","html_url":"https://github.com/openai/codex/commit/fd5018e0445ba7d879c5dbda66ecdab4b6da1886","comments_url":"https://api.github.com/repos/openai/codex/commits/fd5018e0445ba7d879c5dbda66ecdab4b6da1886/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"13dfaab4469eff5c5b929bb7e1cbc6bba5e0c1be","url":"https://api.github.com/repos/openai/codex/commits/13dfaab4469eff5c5b929bb7e1cbc6bba5e0c1be","html_url":"https://github.com/openai/codex/commit/13dfaab4469eff5c5b929bb7e1cbc6bba5e0c1be"}]},{"sha":"13dfaab4469eff5c5b929bb7e1cbc6bba5e0c1be","node_id":"C_kwDOOYsS4doAKDEzZGZhYWI0NDY5ZWZmNWM1YjkyOWJiN2UxY2JjNmJiYTVlMGMxYmU","commit":{"author":{"name":"guinness-oai","email":"guinness@openai.com","date":"2026-08-17T23:49:27Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T23:54:51Z"},"message":"Surface interactive requests in realtime conversations (#39113)\n\n## What changed\n\n- Mirror execution, permission, and patch approval requests into active realtime conversations with a prompt to review them in the app.\n- Mirror user-input and elicitation requests with a prompt to respond in the app.\n- Include the serialized request event so the realtime handoff retains the request details.\n\nGitOrigin-RevId: 56fefa70b9ecaaad2fcf83592f20e8b4514a004a","tree":{"sha":"55a812bd1bac1f42c318d67b9f532fac73fe7040","url":"https://api.github.com/repos/openai/codex/git/trees/55a812bd1bac1f42c318d67b9f532fac73fe7040"},"url":"https://api.github.com/repos/openai/codex/git/commits/13dfaab4469eff5c5b929bb7e1cbc6bba5e0c1be","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/13dfaab4469eff5c5b929bb7e1cbc6bba5e0c1be","html_url":"https://github.com/openai/codex/commit/13dfaab4469eff5c5b929bb7e1cbc6bba5e0c1be","comments_url":"https://api.github.com/repos/openai/codex/commits/13dfaab4469eff5c5b929bb7e1cbc6bba5e0c1be/comments","author":{"login":"guinness-oai","id":254771997,"node_id":"U_kgDODy-DHQ","avatar_url":"https://avatars.githubusercontent.com/u/254771997?v=4","gravatar_id":"","url":"https://api.github.com/users/guinness-oai","html_url":"https://github.com/guinness-oai","followers_url":"https://api.github.com/users/guinness-oai/followers","following_url":"https://api.github.com/users/guinness-oai/following{/other_user}","gists_url":"https://api.github.com/users/guinness-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/guinness-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/guinness-oai/subscriptions","organizations_url":"https://api.github.com/users/guinness-oai/orgs","repos_url":"https://api.github.com/users/guinness-oai/repos","events_url":"https://api.github.com/users/guinness-oai/events{/privacy}","received_events_url":"https://api.github.com/users/guinness-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"319b2f72b1d442c3fe2fd4b4d07d0eb9ffde879a","url":"https://api.github.com/repos/openai/codex/commits/319b2f72b1d442c3fe2fd4b4d07d0eb9ffde879a","html_url":"https://github.com/openai/codex/commit/319b2f72b1d442c3fe2fd4b4d07d0eb9ffde879a"}]},{"sha":"319b2f72b1d442c3fe2fd4b4d07d0eb9ffde879a","node_id":"C_kwDOOYsS4doAKDMxOWIyZjcyYjFkNDQyYzNmZTJmZDRiNGQwN2QwZWI5ZmZkZTg3OWE","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-17T23:42:01Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T23:47:55Z"},"message":"Make the agents overview an interactive task dashboard (#39112)\n\n## What changed\n\n- Let users start tasks, open root sessions, rename tasks, and stop active work directly from the agents overview.\n- Show details for the selected task on wide terminals and limit the overview to root sessions while still reflecting background activity.\n- Preserve draft input and pending server requests when switching sessions so running roots and their subagents can continue in the background.\n- Apply the selected project's working directory when dispatching from project grouping, including remote workspaces.\n\n## Testing\n\n- Expand overview rendering and interaction coverage for root filtering, dispatch, search, selection, renaming, and responsive input.\n- Cover switching away from roots with running subagents and retaining background server requests.\n\nGitOrigin-RevId: b7b0d33b7ecc077498efb756a0ad2fd425158b17","tree":{"sha":"53fe1ba1e1697db9533184d7f718f83fb66bf0b1","url":"https://api.github.com/repos/openai/codex/git/trees/53fe1ba1e1697db9533184d7f718f83fb66bf0b1"},"url":"https://api.github.com/repos/openai/codex/git/commits/319b2f72b1d442c3fe2fd4b4d07d0eb9ffde879a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/319b2f72b1d442c3fe2fd4b4d07d0eb9ffde879a","html_url":"https://github.com/openai/codex/commit/319b2f72b1d442c3fe2fd4b4d07d0eb9ffde879a","comments_url":"https://api.github.com/repos/openai/codex/commits/319b2f72b1d442c3fe2fd4b4d07d0eb9ffde879a/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"632420e67af6d04bbb5faa2aaea958f1a265fcf8","url":"https://api.github.com/repos/openai/codex/commits/632420e67af6d04bbb5faa2aaea958f1a265fcf8","html_url":"https://github.com/openai/codex/commit/632420e67af6d04bbb5faa2aaea958f1a265fcf8"}]},{"sha":"632420e67af6d04bbb5faa2aaea958f1a265fcf8","node_id":"C_kwDOOYsS4doAKDYzMjQyMGU2N2FmNmQwNGJiYjVmYWEyYWFlYTk1OGYxYTI2NWZjZjg","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-17T23:15:47Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T23:21:28Z"},"message":"Drop capabilities from Linux sandbox processes (#39103)\n\n## What changed\n\n- Pass `--cap-drop ALL` in both bubblewrap launch modes.\n- Verify in the inner sandbox stage that the effective and permitted Linux\n  capability sets are empty, and abort before executing the command otherwise.\n- Cover the generated bubblewrap arguments, capability state of sandboxed\n  commands, and rejection of a capability-bearing inner-stage process.\n\nGitOrigin-RevId: 9dbd651d306d92327e36c9b3f308619db7d80a67","tree":{"sha":"6662b1b967869fdf122e5c7b558b5a50c10ce1a5","url":"https://api.github.com/repos/openai/codex/git/trees/6662b1b967869fdf122e5c7b558b5a50c10ce1a5"},"url":"https://api.github.com/repos/openai/codex/git/commits/632420e67af6d04bbb5faa2aaea958f1a265fcf8","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/632420e67af6d04bbb5faa2aaea958f1a265fcf8","html_url":"https://github.com/openai/codex/commit/632420e67af6d04bbb5faa2aaea958f1a265fcf8","comments_url":"https://api.github.com/repos/openai/codex/commits/632420e67af6d04bbb5faa2aaea958f1a265fcf8/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"2eee483e49f88b868f67364134a658b3298e6c14","url":"https://api.github.com/repos/openai/codex/commits/2eee483e49f88b868f67364134a658b3298e6c14","html_url":"https://github.com/openai/codex/commit/2eee483e49f88b868f67364134a658b3298e6c14"}]},{"sha":"2eee483e49f88b868f67364134a658b3298e6c14","node_id":"C_kwDOOYsS4doAKDJlZWU0ODNlNDlmODhiODY4ZjY3MzY0MTM0YTY1OGIzMjk4ZTZjMTQ","commit":{"author":{"name":"Celia Chen","email":"celia@openai.com","date":"2026-08-17T22:57:15Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T23:08:26Z"},"message":"Raise the GPT-5.6 maximum context window (#39102)\n\n## What changed\n\n- Allow `gpt-5.6-sol`, `gpt-5.6-terra`, and `gpt-5.6-luna` context-window overrides up to 872,000 tokens.\n- Build the corresponding Amazon Bedrock entries from each bundled model's metadata while preserving Bedrock-specific identifiers, availability, tool, reasoning, and service-tier settings.\n\n## Testing\n\n- Cover long-context override clamping for bundled and Amazon Bedrock GPT-5.6 models.\n- Verify the normalized Amazon Bedrock catalog metadata and context limits.\n\nGitOrigin-RevId: 9f530dee501222a4d280bb31bbcdc2dacbe35d7d","tree":{"sha":"041f722e6baaf34fc3a0e5f1d1484114afe8e923","url":"https://api.github.com/repos/openai/codex/git/trees/041f722e6baaf34fc3a0e5f1d1484114afe8e923"},"url":"https://api.github.com/repos/openai/codex/git/commits/2eee483e49f88b868f67364134a658b3298e6c14","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/2eee483e49f88b868f67364134a658b3298e6c14","html_url":"https://github.com/openai/codex/commit/2eee483e49f88b868f67364134a658b3298e6c14","comments_url":"https://api.github.com/repos/openai/codex/commits/2eee483e49f88b868f67364134a658b3298e6c14/comments","author":{"login":"celia-oai","id":209693228,"node_id":"U_kgDODH-qLA","avatar_url":"https://avatars.githubusercontent.com/u/209693228?v=4","gravatar_id":"","url":"https://api.github.com/users/celia-oai","html_url":"https://github.com/celia-oai","followers_url":"https://api.github.com/users/celia-oai/followers","following_url":"https://api.github.com/users/celia-oai/following{/other_user}","gists_url":"https://api.github.com/users/celia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/celia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celia-oai/subscriptions","organizations_url":"https://api.github.com/users/celia-oai/orgs","repos_url":"https://api.github.com/users/celia-oai/repos","events_url":"https://api.github.com/users/celia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/celia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"7500ab4c8d0e556c28bafbf3e232dadec4d01b90","url":"https://api.github.com/repos/openai/codex/commits/7500ab4c8d0e556c28bafbf3e232dadec4d01b90","html_url":"https://github.com/openai/codex/commit/7500ab4c8d0e556c28bafbf3e232dadec4d01b90"}]},{"sha":"7500ab4c8d0e556c28bafbf3e232dadec4d01b90","node_id":"C_kwDOOYsS4doAKDc1MDBhYjRjOGQwZTU1NmMyOGJhZmJmM2UyMzJkYWRlYzRkMDFiOTA","commit":{"author":{"name":"thomas","email":"tsarlandie@openai.com","date":"2026-08-17T22:53:49Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T23:04:09Z"},"message":"Update rmcp to 3.1.2 (#39101)\n\n## What changed\n\n- Upgrade `rmcp` from 3.0.0 to 3.1.2.\n- Use `rmcp`'s native JSON-RPC decoding and remove the local compatibility layer for multi-round-trip tool results.\n- Preserve response metadata on `input_required` SSE results.\n- Support OAuth protected-resource metadata discovery and include the discovered resource audience when refreshing tokens.\n\n## Testing\n\n- Add coverage for metadata preservation on modern SSE `input_required` responses.\n- Add an OAuth startup scenario that discovers protected-resource metadata and verifies the refresh-token resource audience.\n\nGitOrigin-RevId: 689f009b4a33552b640304111b74585b4009eeb8","tree":{"sha":"29f3898a6c9e63ec14de66bc9660a6fabcc57023","url":"https://api.github.com/repos/openai/codex/git/trees/29f3898a6c9e63ec14de66bc9660a6fabcc57023"},"url":"https://api.github.com/repos/openai/codex/git/commits/7500ab4c8d0e556c28bafbf3e232dadec4d01b90","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/7500ab4c8d0e556c28bafbf3e232dadec4d01b90","html_url":"https://github.com/openai/codex/commit/7500ab4c8d0e556c28bafbf3e232dadec4d01b90","comments_url":"https://api.github.com/repos/openai/codex/commits/7500ab4c8d0e556c28bafbf3e232dadec4d01b90/comments","author":{"login":"tsarlandie-oai","id":291887306,"node_id":"U_kgDOEWXYyg","avatar_url":"https://avatars.githubusercontent.com/u/291887306?v=4","gravatar_id":"","url":"https://api.github.com/users/tsarlandie-oai","html_url":"https://github.com/tsarlandie-oai","followers_url":"https://api.github.com/users/tsarlandie-oai/followers","following_url":"https://api.github.com/users/tsarlandie-oai/following{/other_user}","gists_url":"https://api.github.com/users/tsarlandie-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/tsarlandie-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tsarlandie-oai/subscriptions","organizations_url":"https://api.github.com/users/tsarlandie-oai/orgs","repos_url":"https://api.github.com/users/tsarlandie-oai/repos","events_url":"https://api.github.com/users/tsarlandie-oai/events{/privacy}","received_events_url":"https://api.github.com/users/tsarlandie-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"050aa077b58da7d7e7e6f92d60ce1a6ca3ad5528","url":"https://api.github.com/repos/openai/codex/commits/050aa077b58da7d7e7e6f92d60ce1a6ca3ad5528","html_url":"https://github.com/openai/codex/commit/050aa077b58da7d7e7e6f92d60ce1a6ca3ad5528"}]},{"sha":"050aa077b58da7d7e7e6f92d60ce1a6ca3ad5528","node_id":"C_kwDOOYsS4doAKDA1MGFhMDc3YjU4ZGE3ZDdlN2U2ZjkyZDYwY2UxYTZjYTNhZDU1Mjg","commit":{"author":{"name":"Tamir Duberstein","email":"tamird@openai.com","date":"2026-08-17T22:51:09Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T22:58:25Z"},"message":"Avoid redundant terminal size queries during history insertion (#39100)\n\n## What changed\n\n- Pass the screen size already available to TUI draw and history-tail paths into history insertion.\n- Use the terminal's cached screen size for direct history insertion calls instead of querying the backend again.\n- Extend the terminal size-query regression test to cover history insertion.\n\nGitOrigin-RevId: 44c7a0f0bc5bc365d8d0c72d7e26587ed17a4821","tree":{"sha":"47c4b996ead107a00680ace0af2bc9b8033305c4","url":"https://api.github.com/repos/openai/codex/git/trees/47c4b996ead107a00680ace0af2bc9b8033305c4"},"url":"https://api.github.com/repos/openai/codex/git/commits/050aa077b58da7d7e7e6f92d60ce1a6ca3ad5528","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/050aa077b58da7d7e7e6f92d60ce1a6ca3ad5528","html_url":"https://github.com/openai/codex/commit/050aa077b58da7d7e7e6f92d60ce1a6ca3ad5528","comments_url":"https://api.github.com/repos/openai/codex/commits/050aa077b58da7d7e7e6f92d60ce1a6ca3ad5528/comments","author":{"login":"tamird","id":1535036,"node_id":"MDQ6VXNlcjE1MzUwMzY=","avatar_url":"https://avatars.githubusercontent.com/u/1535036?v=4","gravatar_id":"","url":"https://api.github.com/users/tamird","html_url":"https://github.com/tamird","followers_url":"https://api.github.com/users/tamird/followers","following_url":"https://api.github.com/users/tamird/following{/other_user}","gists_url":"https://api.github.com/users/tamird/gists{/gist_id}","starred_url":"https://api.github.com/users/tamird/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tamird/subscriptions","organizations_url":"https://api.github.com/users/tamird/orgs","repos_url":"https://api.github.com/users/tamird/repos","events_url":"https://api.github.com/users/tamird/events{/privacy}","received_events_url":"https://api.github.com/users/tamird/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fd34ad7297d86ef8f679927db55a3c1d09735f55","url":"https://api.github.com/repos/openai/codex/commits/fd34ad7297d86ef8f679927db55a3c1d09735f55","html_url":"https://github.com/openai/codex/commit/fd34ad7297d86ef8f679927db55a3c1d09735f55"}]},{"sha":"fd34ad7297d86ef8f679927db55a3c1d09735f55","node_id":"C_kwDOOYsS4doAKGZkMzRhZDcyOTdkODZlZjhmNjc5OTI3ZGI1NWEzYzFkMDk3MzVmNTU","commit":{"author":{"name":"Ben Romano","email":"bromano@openai.com","date":"2026-08-17T22:42:38Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T22:53:55Z"},"message":"Trace exec-server requests from receipt through completion (#39098)\n\n## What changed\n\n- Start inbound exec-server request spans when messages enter the connection queue and carry them through dispatch and response handling.\n- Record request outcomes for client-handled network policy callbacks, including errors and disconnections.\n- Add the `exec_server_request_queue_duration_seconds` histogram, labeled by bounded route name, while excluding synchronous route setup time.\n\n## Testing\n\n- Cover span lifetime and trace-parent propagation across server and client queues.\n- Verify queue-duration telemetry and outcome recording for completed, rejected, and cancelled requests.\n\nGitOrigin-RevId: ed67fe5305048bdf283a26ec874337d549e3324f","tree":{"sha":"d1cfc60b01ebdd5e6d894530c05fc4c128091d77","url":"https://api.github.com/repos/openai/codex/git/trees/d1cfc60b01ebdd5e6d894530c05fc4c128091d77"},"url":"https://api.github.com/repos/openai/codex/git/commits/fd34ad7297d86ef8f679927db55a3c1d09735f55","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fd34ad7297d86ef8f679927db55a3c1d09735f55","html_url":"https://github.com/openai/codex/commit/fd34ad7297d86ef8f679927db55a3c1d09735f55","comments_url":"https://api.github.com/repos/openai/codex/commits/fd34ad7297d86ef8f679927db55a3c1d09735f55/comments","author":{"login":"bromano-oai","id":238086823,"node_id":"U_kgDODjDqpw","avatar_url":"https://avatars.githubusercontent.com/u/238086823?v=4","gravatar_id":"","url":"https://api.github.com/users/bromano-oai","html_url":"https://github.com/bromano-oai","followers_url":"https://api.github.com/users/bromano-oai/followers","following_url":"https://api.github.com/users/bromano-oai/following{/other_user}","gists_url":"https://api.github.com/users/bromano-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/bromano-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bromano-oai/subscriptions","organizations_url":"https://api.github.com/users/bromano-oai/orgs","repos_url":"https://api.github.com/users/bromano-oai/repos","events_url":"https://api.github.com/users/bromano-oai/events{/privacy}","received_events_url":"https://api.github.com/users/bromano-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"4617d4d21d278592002249773faaaf47d4c52e63","url":"https://api.github.com/repos/openai/codex/commits/4617d4d21d278592002249773faaaf47d4c52e63","html_url":"https://github.com/openai/codex/commit/4617d4d21d278592002249773faaaf47d4c52e63"}]},{"sha":"4617d4d21d278592002249773faaaf47d4c52e63","node_id":"C_kwDOOYsS4doAKDQ2MTdkNGQyMWQyNzg1OTIwMDIyNDk3NzNmYWFhZjQ3ZDRjNTJlNjM","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-17T22:39:15Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T22:50:25Z"},"message":"Add an agents overview dashboard to the TUI (#39094)\n\n## What changed\n\n- Add `/agents` to open a full-screen dashboard of loaded root sessions from the shared app server, with subagent status reflected in each root session.\n- Support search, navigation, and grouping sessions by project or status.\n- Refresh the dashboard when relevant thread notifications arrive, while preserving its selection and view preferences.\n- Show a clear message when the dashboard is unavailable with the embedded app server.\n\n## Testing\n\n- Add coverage for dashboard rendering, status grouping, persisted view state, and restoring the conversation viewport after closing the dashboard.\n- Cover `/agents` command discovery and dispatch from parent-owned threads.\n\nGitOrigin-RevId: 6651f4c47358116e1809da3ac8844a5842026a95","tree":{"sha":"84870e1d0704b89626f9d72da2995bdd276ab66c","url":"https://api.github.com/repos/openai/codex/git/trees/84870e1d0704b89626f9d72da2995bdd276ab66c"},"url":"https://api.github.com/repos/openai/codex/git/commits/4617d4d21d278592002249773faaaf47d4c52e63","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/4617d4d21d278592002249773faaaf47d4c52e63","html_url":"https://github.com/openai/codex/commit/4617d4d21d278592002249773faaaf47d4c52e63","comments_url":"https://api.github.com/repos/openai/codex/commits/4617d4d21d278592002249773faaaf47d4c52e63/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"83d015375e578e369c115b06aea631f266226a4f","url":"https://api.github.com/repos/openai/codex/commits/83d015375e578e369c115b06aea631f266226a4f","html_url":"https://github.com/openai/codex/commit/83d015375e578e369c115b06aea631f266226a4f"}]},{"sha":"83d015375e578e369c115b06aea631f266226a4f","node_id":"C_kwDOOYsS4doAKDgzZDAxNTM3NWU1NzhlMzY5YzExNWIwNmFlYTYzMWYyNjYyMjZhNGY","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-17T22:34:49Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T22:44:37Z"},"message":"Add a command to queue messages for existing sessions (#39092)\n\n## What changed\n\n- Add `codex queue --thread <THREAD> --message <TEXT>` to submit a text message through the `thread/queue/add` app-server API.\n- Resolve active sessions by UUID or exact name across interactive, exec, and custom sources, and reject ambiguous names.\n- Support local and explicit remote app servers while reporting incompatible servers and configuration overrides instead of silently changing the target.\n- Reject empty messages and image attachments.\n\n## Testing\n\n- Add CLI coverage for remote submission, validation, unsupported servers, and local-daemon routing.\n- Add session lookup and queue tests for stale, non-interactive, custom, and duplicate session names.\n\nGitOrigin-RevId: 44c233f752b63a85c85b92fa6da303336e4ddeca","tree":{"sha":"636cff1f699f5f32b750e62aee06e59cf8a175bc","url":"https://api.github.com/repos/openai/codex/git/trees/636cff1f699f5f32b750e62aee06e59cf8a175bc"},"url":"https://api.github.com/repos/openai/codex/git/commits/83d015375e578e369c115b06aea631f266226a4f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/83d015375e578e369c115b06aea631f266226a4f","html_url":"https://github.com/openai/codex/commit/83d015375e578e369c115b06aea631f266226a4f","comments_url":"https://api.github.com/repos/openai/codex/commits/83d015375e578e369c115b06aea631f266226a4f/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"31f23b6022ead6b2c01613c5eff0741370cc73a6","url":"https://api.github.com/repos/openai/codex/commits/31f23b6022ead6b2c01613c5eff0741370cc73a6","html_url":"https://github.com/openai/codex/commit/31f23b6022ead6b2c01613c5eff0741370cc73a6"}]},{"sha":"31f23b6022ead6b2c01613c5eff0741370cc73a6","node_id":"C_kwDOOYsS4doAKDMxZjIzYjYwMjJlYWQ2YjJjMDE2MTNjNWVmZjA3NDEzNzBjYzczYTY","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-17T22:29:32Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T22:37:14Z"},"message":"Clarify the external contribution policy (#39089)\n\n## Why\n\nCommunity expertise is most useful when shared through detailed issue reports, reproduction steps, logs, analysis, and design discussion. Reviewing external code changes requires broader architectural and roadmap context and can divert maintainers from higher-priority work.\n\n## What changed\n\n- State that external code contributions and pull requests are not accepted.\n- Replace invited-contributor workflow and CLA guidance with instructions for reporting bugs and requesting features through the issue tracker.\n- Remove the pull request template and align the ChatGPT crate guidance with the repository-wide policy.\n- Direct vulnerability reports to the security policy.\n\nGitOrigin-RevId: 736c0cb181e07cc751bc46f4fefc53c6964e3dab","tree":{"sha":"9baa7a4fa8f0e8af191458998142e281a8f86d04","url":"https://api.github.com/repos/openai/codex/git/trees/9baa7a4fa8f0e8af191458998142e281a8f86d04"},"url":"https://api.github.com/repos/openai/codex/git/commits/31f23b6022ead6b2c01613c5eff0741370cc73a6","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/31f23b6022ead6b2c01613c5eff0741370cc73a6","html_url":"https://github.com/openai/codex/commit/31f23b6022ead6b2c01613c5eff0741370cc73a6","comments_url":"https://api.github.com/repos/openai/codex/commits/31f23b6022ead6b2c01613c5eff0741370cc73a6/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"0c14c734710098ad7b9627d4164c3d27535657f9","url":"https://api.github.com/repos/openai/codex/commits/0c14c734710098ad7b9627d4164c3d27535657f9","html_url":"https://github.com/openai/codex/commit/0c14c734710098ad7b9627d4164c3d27535657f9"}]},{"sha":"0c14c734710098ad7b9627d4164c3d27535657f9","node_id":"C_kwDOOYsS4doAKDBjMTRjNzM0NzEwMDk4YWQ3Yjk2MjdkNDE2NGMzZDI3NTM1NjU3Zjk","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-17T22:17:57Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T22:31:13Z"},"message":"Harden TUI subagent navigation (#39088)\n\n## What changed\n\n- Use `/subagents` consistently for the subagent picker and status UI, removing the `/agent` alias.\n- Rejoin already-loaded subagent threads without overriding their existing settings.\n- Route notifications and approval requests only to the active thread or its known subagents, discard unrelated startup events, and avoid replaying resolved approvals.\n\n## Testing\n\n- Add coverage for filtering buffered startup events, dropping resolved approvals, preserving owned subagent approvals, and resuming threads without setting overrides.\n\nGitOrigin-RevId: b4e597f7cd4756faccf31d8b964e7a172f5ab0eb","tree":{"sha":"f77e871e58b0332bbb0478839dc62a345e1e18a7","url":"https://api.github.com/repos/openai/codex/git/trees/f77e871e58b0332bbb0478839dc62a345e1e18a7"},"url":"https://api.github.com/repos/openai/codex/git/commits/0c14c734710098ad7b9627d4164c3d27535657f9","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/0c14c734710098ad7b9627d4164c3d27535657f9","html_url":"https://github.com/openai/codex/commit/0c14c734710098ad7b9627d4164c3d27535657f9","comments_url":"https://api.github.com/repos/openai/codex/commits/0c14c734710098ad7b9627d4164c3d27535657f9/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fc6268ad383fdac095a0419c04f496f7e39e86da","url":"https://api.github.com/repos/openai/codex/commits/fc6268ad383fdac095a0419c04f496f7e39e86da","html_url":"https://github.com/openai/codex/commit/fc6268ad383fdac095a0419c04f496f7e39e86da"}]},{"sha":"fc6268ad383fdac095a0419c04f496f7e39e86da","node_id":"C_kwDOOYsS4doAKGZjNjI2OGFkMzgzZmRhYzA5NWEwNDE5YzA0ZjQ5NmY3ZTM5ZTg2ZGE","commit":{"author":{"name":"willwang-openai","email":"willwang@openai.com","date":"2026-08-17T22:11:11Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T22:26:27Z"},"message":"Read plugin authentication state from AuthManager (#39087)\n\n## What changed\n\n- Give `PluginsManager` a shared `AuthManager` instead of a separately mutable authentication-mode snapshot.\n- Read the current authentication mode and credentials from that shared manager for plugin discovery, startup tasks, CLI commands, MCP setup, and external-agent migration.\n- Update test helpers and coverage to exercise plugin projections and curated marketplace selection as authentication changes.\n\nGitOrigin-RevId: 600c94de5130eda2da5727e1a0b4d39083fefc56","tree":{"sha":"00da25d381f97f64f3b68debc52f76be926a9084","url":"https://api.github.com/repos/openai/codex/git/trees/00da25d381f97f64f3b68debc52f76be926a9084"},"url":"https://api.github.com/repos/openai/codex/git/commits/fc6268ad383fdac095a0419c04f496f7e39e86da","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/fc6268ad383fdac095a0419c04f496f7e39e86da","html_url":"https://github.com/openai/codex/commit/fc6268ad383fdac095a0419c04f496f7e39e86da","comments_url":"https://api.github.com/repos/openai/codex/commits/fc6268ad383fdac095a0419c04f496f7e39e86da/comments","author":{"login":"willwang-openai","id":189043618,"node_id":"U_kgDOC0STog","avatar_url":"https://avatars.githubusercontent.com/u/189043618?v=4","gravatar_id":"","url":"https://api.github.com/users/willwang-openai","html_url":"https://github.com/willwang-openai","followers_url":"https://api.github.com/users/willwang-openai/followers","following_url":"https://api.github.com/users/willwang-openai/following{/other_user}","gists_url":"https://api.github.com/users/willwang-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/willwang-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/willwang-openai/subscriptions","organizations_url":"https://api.github.com/users/willwang-openai/orgs","repos_url":"https://api.github.com/users/willwang-openai/repos","events_url":"https://api.github.com/users/willwang-openai/events{/privacy}","received_events_url":"https://api.github.com/users/willwang-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"2013e04354b64b1bb4f313c6b68390ac0d13dd6d","url":"https://api.github.com/repos/openai/codex/commits/2013e04354b64b1bb4f313c6b68390ac0d13dd6d","html_url":"https://github.com/openai/codex/commit/2013e04354b64b1bb4f313c6b68390ac0d13dd6d"}]},{"sha":"2013e04354b64b1bb4f313c6b68390ac0d13dd6d","node_id":"C_kwDOOYsS4doAKDIwMTNlMDQzNTRiNjRiMWJiNGYzMTNjNmI2ODM5MGFjMGQxM2RkNmQ","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-08-17T21:42:42Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T21:49:30Z"},"message":"Preserve filesystem permission path conventions (#39084)\n\n## Why\n\nFilesystem permission paths can use a convention that differs from the host\nrunning Codex. Converting them immediately to native absolute paths can change\nthe meaning of ambiguous paths such as `/C:/secret` or Windows UNC paths.\n\n## What changed\n\n- Store literal filesystem permission paths as `PathUri` values through the\n  runtime policy and execution protocol.\n- Keep legacy string-based serialization at explicit protocol boundaries and\n  reject conversions that cannot be represented losslessly.\n- Encode native paths as opaque URIs when a normal file URI would imply the\n  wrong path convention.\n\n## Testing\n\nAdded coverage for cross-platform and ambiguous path round trips, UNC path\nvariants, permission-profile serialization, and deny-policy enforcement.\n\nGitOrigin-RevId: 5247713796d1f2bb4e02f94eb9fc82d4698060f0","tree":{"sha":"af317b6bf7af04e72cb9b2cb3b8697b3748afa5e","url":"https://api.github.com/repos/openai/codex/git/trees/af317b6bf7af04e72cb9b2cb3b8697b3748afa5e"},"url":"https://api.github.com/repos/openai/codex/git/commits/2013e04354b64b1bb4f313c6b68390ac0d13dd6d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/2013e04354b64b1bb4f313c6b68390ac0d13dd6d","html_url":"https://github.com/openai/codex/commit/2013e04354b64b1bb4f313c6b68390ac0d13dd6d","comments_url":"https://api.github.com/repos/openai/codex/commits/2013e04354b64b1bb4f313c6b68390ac0d13dd6d/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"a4f37a5b7f4753d8e22c26ac28825e8ebf2bf91b","url":"https://api.github.com/repos/openai/codex/commits/a4f37a5b7f4753d8e22c26ac28825e8ebf2bf91b","html_url":"https://github.com/openai/codex/commit/a4f37a5b7f4753d8e22c26ac28825e8ebf2bf91b"}]},{"sha":"a4f37a5b7f4753d8e22c26ac28825e8ebf2bf91b","node_id":"C_kwDOOYsS4doAKGE0ZjM3YTViN2Y0NzUzZDhlMjJjMjZhYzI4ODI1ZThlYmYyYmY5MWI","commit":{"author":{"name":"iceweasel-oai","email":"iceweasel@openai.com","date":"2026-08-17T20:51:11Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T21:10:58Z"},"message":"Harden Windows sandbox provisioning against reparse points (#39083)\n\n## Why\n\nElevated provisioning can apply ACLs beneath a user-supplied `CODEX_HOME`.\nFollowing a directory junction or another reparse point could apply those ACLs\nto a different directory than the one provisioning intended to secure.\n\n## What changed\n\n- Require provisioning paths to be absolute paths on a local Windows disk.\n- In provision-only mode, open or create sandbox directories with\n  `OBJ_DONT_REPARSE` and keep the resulting handle open while applying ACLs\n  with `SetSecurityInfo`.\n- Reject reparse points in both the final directory and its ancestors while\n  preserving the existing path-based behavior for full setup.\n\n## Testing\n\nAdd Windows tests covering plain directory creation and rejection of junctions\nat both the leaf and ancestor levels.\n\nGitOrigin-RevId: d165b8b3685c89bc171e4d58c63c739fa9fb2cf9","tree":{"sha":"47e861968debc19dd4c11750cdd6d281f89e6c4e","url":"https://api.github.com/repos/openai/codex/git/trees/47e861968debc19dd4c11750cdd6d281f89e6c4e"},"url":"https://api.github.com/repos/openai/codex/git/commits/a4f37a5b7f4753d8e22c26ac28825e8ebf2bf91b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/a4f37a5b7f4753d8e22c26ac28825e8ebf2bf91b","html_url":"https://github.com/openai/codex/commit/a4f37a5b7f4753d8e22c26ac28825e8ebf2bf91b","comments_url":"https://api.github.com/repos/openai/codex/commits/a4f37a5b7f4753d8e22c26ac28825e8ebf2bf91b/comments","author":{"login":"iceweasel-oai","id":234057055,"node_id":"U_kgDODfNtXw","avatar_url":"https://avatars.githubusercontent.com/u/234057055?v=4","gravatar_id":"","url":"https://api.github.com/users/iceweasel-oai","html_url":"https://github.com/iceweasel-oai","followers_url":"https://api.github.com/users/iceweasel-oai/followers","following_url":"https://api.github.com/users/iceweasel-oai/following{/other_user}","gists_url":"https://api.github.com/users/iceweasel-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/iceweasel-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iceweasel-oai/subscriptions","organizations_url":"https://api.github.com/users/iceweasel-oai/orgs","repos_url":"https://api.github.com/users/iceweasel-oai/repos","events_url":"https://api.github.com/users/iceweasel-oai/events{/privacy}","received_events_url":"https://api.github.com/users/iceweasel-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"34e4823a1d9d6c412291962cc2c00514dd966841","url":"https://api.github.com/repos/openai/codex/commits/34e4823a1d9d6c412291962cc2c00514dd966841","html_url":"https://github.com/openai/codex/commit/34e4823a1d9d6c412291962cc2c00514dd966841"}]},{"sha":"34e4823a1d9d6c412291962cc2c00514dd966841","node_id":"C_kwDOOYsS4doAKDM0ZTQ4MjNhMWQ5ZDZjNDEyMjkxOTYyY2MyYzAwNTE0ZGQ5NjY4NDE","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-08-17T20:41:50Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T21:06:34Z"},"message":"Prompt for project trust in remote TUI workspaces (#39082)\n\n## What changed\n\n- Query the remote app server for project config layers before starting a thread and show the trust prompt when the project has no existing decision.\n- Resolve relative remote working directories and repository-root trust targets, then persist accepted trust through `config/batchWrite` on the remote server.\n- Preserve existing trusted and untrusted decisions, including an untrusted repository that contains the requested working directory.\n- Exit when the remote trust prompt is declined and ignore repeated key events in the trust selector.\n\n## Testing\n\n- Add coverage for remote trust detection, persistence, thread startup, existing decisions, nested untrusted projects, and rendering a remote Git subdirectory.\n\nGitOrigin-RevId: e5fba2ea23bad1fb28f01df522cadbe05fcbb942","tree":{"sha":"1cdcc36206a0aa2ff1fa82aec823cd86bb8f3683","url":"https://api.github.com/repos/openai/codex/git/trees/1cdcc36206a0aa2ff1fa82aec823cd86bb8f3683"},"url":"https://api.github.com/repos/openai/codex/git/commits/34e4823a1d9d6c412291962cc2c00514dd966841","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/34e4823a1d9d6c412291962cc2c00514dd966841","html_url":"https://github.com/openai/codex/commit/34e4823a1d9d6c412291962cc2c00514dd966841","comments_url":"https://api.github.com/repos/openai/codex/commits/34e4823a1d9d6c412291962cc2c00514dd966841/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"9c099e94a2cecf02a60b8759765e0c99a3a34475","url":"https://api.github.com/repos/openai/codex/commits/9c099e94a2cecf02a60b8759765e0c99a3a34475","html_url":"https://github.com/openai/codex/commit/9c099e94a2cecf02a60b8759765e0c99a3a34475"}]},{"sha":"9c099e94a2cecf02a60b8759765e0c99a3a34475","node_id":"C_kwDOOYsS4doAKDljMDk5ZTk0YTJjZWNmMDJhNjBiODc1OTc2NWUwYzk5YTNhMzQ0NzU","commit":{"author":{"name":"Tamir Duberstein","email":"tamird@openai.com","date":"2026-08-17T20:41:08Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T21:03:06Z"},"message":"Bound TUI thread replay buffers by delta size (#39081)\n\n## Why\n\nThe per-thread replay buffer limited its event count, but streamed agent-message\ndeltas could still retain an unbounded amount of text while a thread was\ninactive.\n\n## What changed\n\n- Coalesce adjacent deltas for the same thread, turn, and item into chunks of up\n  to 4 KiB.\n- Limit buffered agent-message deltas to 256 KiB, discard a single delta larger\n  than that limit, and evict the oldest events when either buffer limit is\n  exceeded.\n- Keep pending input and approval state in sync when eviction removes the\n  corresponding request, including clearing side-thread status indicators.\n\n## Testing\n\nAdded coverage for delta coalescing, byte-based eviction, oversized deltas,\nreplaying only retained text, and side-thread status updates after eviction.\n\nGitOrigin-RevId: 88d85353a124467d467822d2fd9854312b68d547","tree":{"sha":"a4c2da8ea5cd1ec84ed00b3e540e5453e256db73","url":"https://api.github.com/repos/openai/codex/git/trees/a4c2da8ea5cd1ec84ed00b3e540e5453e256db73"},"url":"https://api.github.com/repos/openai/codex/git/commits/9c099e94a2cecf02a60b8759765e0c99a3a34475","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/9c099e94a2cecf02a60b8759765e0c99a3a34475","html_url":"https://github.com/openai/codex/commit/9c099e94a2cecf02a60b8759765e0c99a3a34475","comments_url":"https://api.github.com/repos/openai/codex/commits/9c099e94a2cecf02a60b8759765e0c99a3a34475/comments","author":{"login":"tamird","id":1535036,"node_id":"MDQ6VXNlcjE1MzUwMzY=","avatar_url":"https://avatars.githubusercontent.com/u/1535036?v=4","gravatar_id":"","url":"https://api.github.com/users/tamird","html_url":"https://github.com/tamird","followers_url":"https://api.github.com/users/tamird/followers","following_url":"https://api.github.com/users/tamird/following{/other_user}","gists_url":"https://api.github.com/users/tamird/gists{/gist_id}","starred_url":"https://api.github.com/users/tamird/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tamird/subscriptions","organizations_url":"https://api.github.com/users/tamird/orgs","repos_url":"https://api.github.com/users/tamird/repos","events_url":"https://api.github.com/users/tamird/events{/privacy}","received_events_url":"https://api.github.com/users/tamird/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"8ef139667f313d48e53032a261071cb13088143e","url":"https://api.github.com/repos/openai/codex/commits/8ef139667f313d48e53032a261071cb13088143e","html_url":"https://github.com/openai/codex/commit/8ef139667f313d48e53032a261071cb13088143e"}]},{"sha":"8ef139667f313d48e53032a261071cb13088143e","node_id":"C_kwDOOYsS4doAKDhlZjEzOTY2N2YzMTNkNDhlNTMwMzJhMjYxMDcxY2IxMzA4ODE0M2U","commit":{"author":{"name":"jif","email":"jif@openai.com","date":"2026-08-17T20:34:31Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T20:55:04Z"},"message":"Apply user MCP policy to selected executor plugins (#39079)\n\n## What changed\n\n- Resolve MCP server policy directly from the effective user configuration for selected executor-plugin roots.\n- Apply server enablement, tool allow/deny lists, and default and per-tool approval modes while preserving stricter plugin-declared restrictions.\n- Cover policy merging and opaque selected-root IDs in the executor-plugin MCP integration tests.\n\nGitOrigin-RevId: dce3021969ba71e642de52312449cab6277515c3","tree":{"sha":"b9aa1e1850fd64d16e94211f3af2dfa38a804348","url":"https://api.github.com/repos/openai/codex/git/trees/b9aa1e1850fd64d16e94211f3af2dfa38a804348"},"url":"https://api.github.com/repos/openai/codex/git/commits/8ef139667f313d48e53032a261071cb13088143e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/8ef139667f313d48e53032a261071cb13088143e","html_url":"https://github.com/openai/codex/commit/8ef139667f313d48e53032a261071cb13088143e","comments_url":"https://api.github.com/repos/openai/codex/commits/8ef139667f313d48e53032a261071cb13088143e/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"911335eed37a2b33d1443c994c98d1d90a3ac920","url":"https://api.github.com/repos/openai/codex/commits/911335eed37a2b33d1443c994c98d1d90a3ac920","html_url":"https://github.com/openai/codex/commit/911335eed37a2b33d1443c994c98d1d90a3ac920"}]},{"sha":"911335eed37a2b33d1443c994c98d1d90a3ac920","node_id":"C_kwDOOYsS4doAKDkxMTMzNWVlZDM3YTJiMzNkMTQ0M2M5OTRjOThkMWQ5MGEzYWM5MjA","commit":{"author":{"name":"Ben Romano","email":"bromano@openai.com","date":"2026-08-17T20:33:25Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T20:51:38Z"},"message":"Preserve tracing context for environment resolution (#39078)\n\n## What changed\n\n- Add spans for environment resolution, readiness waits, and environment info,\n  including fields for the selected environment and resolution state.\n- Propagate the active span and tracing subscriber into spawned resolution,\n  startup, and shell-snapshot tasks.\n- Verify that blocking snapshots retain the expected nested environment spans.\n\nGitOrigin-RevId: 3c47e9ec1ebf45dbe1250b9ff76e2983d2a8df2a","tree":{"sha":"9a89200f60096d8c0b1bff697457b0c65262a87f","url":"https://api.github.com/repos/openai/codex/git/trees/9a89200f60096d8c0b1bff697457b0c65262a87f"},"url":"https://api.github.com/repos/openai/codex/git/commits/911335eed37a2b33d1443c994c98d1d90a3ac920","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/911335eed37a2b33d1443c994c98d1d90a3ac920","html_url":"https://github.com/openai/codex/commit/911335eed37a2b33d1443c994c98d1d90a3ac920","comments_url":"https://api.github.com/repos/openai/codex/commits/911335eed37a2b33d1443c994c98d1d90a3ac920/comments","author":{"login":"bromano-oai","id":238086823,"node_id":"U_kgDODjDqpw","avatar_url":"https://avatars.githubusercontent.com/u/238086823?v=4","gravatar_id":"","url":"https://api.github.com/users/bromano-oai","html_url":"https://github.com/bromano-oai","followers_url":"https://api.github.com/users/bromano-oai/followers","following_url":"https://api.github.com/users/bromano-oai/following{/other_user}","gists_url":"https://api.github.com/users/bromano-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/bromano-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bromano-oai/subscriptions","organizations_url":"https://api.github.com/users/bromano-oai/orgs","repos_url":"https://api.github.com/users/bromano-oai/repos","events_url":"https://api.github.com/users/bromano-oai/events{/privacy}","received_events_url":"https://api.github.com/users/bromano-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"e92627bf7e5f1aa87254b8eedc4a2d19f614452a","url":"https://api.github.com/repos/openai/codex/commits/e92627bf7e5f1aa87254b8eedc4a2d19f614452a","html_url":"https://github.com/openai/codex/commit/e92627bf7e5f1aa87254b8eedc4a2d19f614452a"}]},{"sha":"e92627bf7e5f1aa87254b8eedc4a2d19f614452a","node_id":"C_kwDOOYsS4doAKGU5MjYyN2JmN2U1ZjFhYTg3MjU0YjhlZWRjNGEyZDE5ZjYxNDQ1MmE","commit":{"author":{"name":"Benjamin Carlsson","email":"bc@openai.com","date":"2026-08-17T20:25:38Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T20:46:43Z"},"message":"Build filesystem JSON params only for remote TUI sessions (#39077)\n\n## Why\n\nIn-process app-server filesystem requests use typed protocol requests and do\nnot need JSON-RPC parameters.\n\n## What changed\n\nPass remote filesystem parameters to `request_fs_path` as closures and\nevaluate them only when the session uses a remote request handle.\n\nGitOrigin-RevId: 623c8733542553d73e2c0e4c4a60d40258bc91c1","tree":{"sha":"6af8dbf1ba17b334c544437fbe2cb52acc592f59","url":"https://api.github.com/repos/openai/codex/git/trees/6af8dbf1ba17b334c544437fbe2cb52acc592f59"},"url":"https://api.github.com/repos/openai/codex/git/commits/e92627bf7e5f1aa87254b8eedc4a2d19f614452a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/e92627bf7e5f1aa87254b8eedc4a2d19f614452a","html_url":"https://github.com/openai/codex/commit/e92627bf7e5f1aa87254b8eedc4a2d19f614452a","comments_url":"https://api.github.com/repos/openai/codex/commits/e92627bf7e5f1aa87254b8eedc4a2d19f614452a/comments","author":{"login":"bc-openai","id":185964850,"node_id":"U_kgDOCxWZMg","avatar_url":"https://avatars.githubusercontent.com/u/185964850?v=4","gravatar_id":"","url":"https://api.github.com/users/bc-openai","html_url":"https://github.com/bc-openai","followers_url":"https://api.github.com/users/bc-openai/followers","following_url":"https://api.github.com/users/bc-openai/following{/other_user}","gists_url":"https://api.github.com/users/bc-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/bc-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bc-openai/subscriptions","organizations_url":"https://api.github.com/users/bc-openai/orgs","repos_url":"https://api.github.com/users/bc-openai/repos","events_url":"https://api.github.com/users/bc-openai/events{/privacy}","received_events_url":"https://api.github.com/users/bc-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"37efa18be2930d0a14465bd65d84d03eaaad31a0","url":"https://api.github.com/repos/openai/codex/commits/37efa18be2930d0a14465bd65d84d03eaaad31a0","html_url":"https://github.com/openai/codex/commit/37efa18be2930d0a14465bd65d84d03eaaad31a0"}]},{"sha":"37efa18be2930d0a14465bd65d84d03eaaad31a0","node_id":"C_kwDOOYsS4doAKDM3ZWZhMThiZTI5MzBkMGExNDQ2NWJkNjVkODRkMDNlYWFhZDMxYTA","commit":{"author":{"name":"Tamir Duberstein","email":"tamird@openai.com","date":"2026-08-17T20:24:17Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T20:43:12Z"},"message":"Avoid redundant terminal row clears (#39075)\n\n## Why\n\nThe custom TUI buffer diff emitted `ClearToEnd` for unchanged trailing blank\nregions, producing unnecessary terminal output.\n\n## What changed\n\n- Clear a row tail only when its cached contents changed or a wide glyph overlaps\n  the clear boundary.\n- Keep blank cells marked `AlwaysUpdate` in the drawable region so viewport\n  invalidation still forces them to repaint.\n- Preserve Ratatui's native cell diff behavior for the remaining updates.\n\n## Testing\n\nAdd coverage for unchanged row tails, forced blank-cell updates, and shrinking\nwide graphemes, including half-width katakana with combining marks.\n\nGitOrigin-RevId: a9cac06f5624032a2b8c80a66c651cf3e85ec7fb","tree":{"sha":"fc152ad7289c72e6fe43802d31f792935de66eba","url":"https://api.github.com/repos/openai/codex/git/trees/fc152ad7289c72e6fe43802d31f792935de66eba"},"url":"https://api.github.com/repos/openai/codex/git/commits/37efa18be2930d0a14465bd65d84d03eaaad31a0","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/37efa18be2930d0a14465bd65d84d03eaaad31a0","html_url":"https://github.com/openai/codex/commit/37efa18be2930d0a14465bd65d84d03eaaad31a0","comments_url":"https://api.github.com/repos/openai/codex/commits/37efa18be2930d0a14465bd65d84d03eaaad31a0/comments","author":{"login":"tamird","id":1535036,"node_id":"MDQ6VXNlcjE1MzUwMzY=","avatar_url":"https://avatars.githubusercontent.com/u/1535036?v=4","gravatar_id":"","url":"https://api.github.com/users/tamird","html_url":"https://github.com/tamird","followers_url":"https://api.github.com/users/tamird/followers","following_url":"https://api.github.com/users/tamird/following{/other_user}","gists_url":"https://api.github.com/users/tamird/gists{/gist_id}","starred_url":"https://api.github.com/users/tamird/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tamird/subscriptions","organizations_url":"https://api.github.com/users/tamird/orgs","repos_url":"https://api.github.com/users/tamird/repos","events_url":"https://api.github.com/users/tamird/events{/privacy}","received_events_url":"https://api.github.com/users/tamird/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"d65d31593926f26bc6dd030240bc009be87ef75d","url":"https://api.github.com/repos/openai/codex/commits/d65d31593926f26bc6dd030240bc009be87ef75d","html_url":"https://github.com/openai/codex/commit/d65d31593926f26bc6dd030240bc009be87ef75d"}]},{"sha":"d65d31593926f26bc6dd030240bc009be87ef75d","node_id":"C_kwDOOYsS4doAKGQ2NWQzMTU5MzkyNmYyNmJjNmRkMDMwMjQwYmMwMDliZTg3ZWY3NWQ","commit":{"author":{"name":"chess","email":"chess@openai.com","date":"2026-08-17T20:11:23Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T20:39:35Z"},"message":"Add desktop update diagnostics to `codex doctor` (#39074)\n\n## What changed\n\n- Probe the installed desktop app's update endpoint on macOS and Windows and report update-CDN reachability alongside the existing network diagnostics.\n- Report newer Windows Store builds and macOS updates that Sparkle has staged for installation in the updates check and human-readable notes.\n- Validate Windows update manifests against the production app identity, and use the persisted production appcast configuration when selecting the macOS feed.\n\n## Testing\n\n- Cover Windows version comparison and manifest identity validation.\n- Cover macOS appcast selection and staged-bundle discovery.\n- Verify the human-readable desktop update note.\n\nGitOrigin-RevId: 1af5aa750144346b4b31f2b27a20371daf40d3c0","tree":{"sha":"60d7b7301228f36a01595dcac60c0d1555980719","url":"https://api.github.com/repos/openai/codex/git/trees/60d7b7301228f36a01595dcac60c0d1555980719"},"url":"https://api.github.com/repos/openai/codex/git/commits/d65d31593926f26bc6dd030240bc009be87ef75d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/d65d31593926f26bc6dd030240bc009be87ef75d","html_url":"https://github.com/openai/codex/commit/d65d31593926f26bc6dd030240bc009be87ef75d","comments_url":"https://api.github.com/repos/openai/codex/commits/d65d31593926f26bc6dd030240bc009be87ef75d/comments","author":{"login":"chess-oai","id":289791516,"node_id":"U_kgDOEUXeHA","avatar_url":"https://avatars.githubusercontent.com/u/289791516?v=4","gravatar_id":"","url":"https://api.github.com/users/chess-oai","html_url":"https://github.com/chess-oai","followers_url":"https://api.github.com/users/chess-oai/followers","following_url":"https://api.github.com/users/chess-oai/following{/other_user}","gists_url":"https://api.github.com/users/chess-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/chess-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chess-oai/subscriptions","organizations_url":"https://api.github.com/users/chess-oai/orgs","repos_url":"https://api.github.com/users/chess-oai/repos","events_url":"https://api.github.com/users/chess-oai/events{/privacy}","received_events_url":"https://api.github.com/users/chess-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"45cf6cbc1946580829a5d16832af35c2b112046c","url":"https://api.github.com/repos/openai/codex/commits/45cf6cbc1946580829a5d16832af35c2b112046c","html_url":"https://github.com/openai/codex/commit/45cf6cbc1946580829a5d16832af35c2b112046c"}]},{"sha":"45cf6cbc1946580829a5d16832af35c2b112046c","node_id":"C_kwDOOYsS4doAKDQ1Y2Y2Y2JjMTk0NjU4MDgyOWE1ZDE2ODMyYWYzNWMyYjExMjA0NmM","commit":{"author":{"name":"Ben Romano","email":"bromano@openai.com","date":"2026-08-17T20:02:49Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T20:36:10Z"},"message":"Propagate caller metadata to rendezvous connections (#39073)\n\n## What changed\n\n- Add `x-cluster-name` from `OPENAI_CLUSTER` and\n  `x-openai-internal-caller` from `DD_SERVICE` to rendezvous WebSocket\n  handshakes when the environment values are nonempty and valid HTTP header\n  values.\n- Apply the rendezvous headers to both client and remote executor connections\n  while preserving the existing W3C trace context headers.\n\nGitOrigin-RevId: fead0244ba24fa208990b92d2170a9ae76ff2ceb","tree":{"sha":"5c7f128a3bbbd175c878721bcba893a1362a54e4","url":"https://api.github.com/repos/openai/codex/git/trees/5c7f128a3bbbd175c878721bcba893a1362a54e4"},"url":"https://api.github.com/repos/openai/codex/git/commits/45cf6cbc1946580829a5d16832af35c2b112046c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/45cf6cbc1946580829a5d16832af35c2b112046c","html_url":"https://github.com/openai/codex/commit/45cf6cbc1946580829a5d16832af35c2b112046c","comments_url":"https://api.github.com/repos/openai/codex/commits/45cf6cbc1946580829a5d16832af35c2b112046c/comments","author":{"login":"bromano-oai","id":238086823,"node_id":"U_kgDODjDqpw","avatar_url":"https://avatars.githubusercontent.com/u/238086823?v=4","gravatar_id":"","url":"https://api.github.com/users/bromano-oai","html_url":"https://github.com/bromano-oai","followers_url":"https://api.github.com/users/bromano-oai/followers","following_url":"https://api.github.com/users/bromano-oai/following{/other_user}","gists_url":"https://api.github.com/users/bromano-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/bromano-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bromano-oai/subscriptions","organizations_url":"https://api.github.com/users/bromano-oai/orgs","repos_url":"https://api.github.com/users/bromano-oai/repos","events_url":"https://api.github.com/users/bromano-oai/events{/privacy}","received_events_url":"https://api.github.com/users/bromano-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"682f57254f8c00cf21a280f328a32a54d1e24bbc","url":"https://api.github.com/repos/openai/codex/commits/682f57254f8c00cf21a280f328a32a54d1e24bbc","html_url":"https://github.com/openai/codex/commit/682f57254f8c00cf21a280f328a32a54d1e24bbc"}]},{"sha":"682f57254f8c00cf21a280f328a32a54d1e24bbc","node_id":"C_kwDOOYsS4doAKDY4MmY1NzI1NGY4YzAwY2YyMWEyODBmMzI4YTMyYTU0ZDFlMjRiYmM","commit":{"author":{"name":"Andrew Wilkes","email":"wilkes@openai.com","date":"2026-08-17T19:54:45Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T20:32:41Z"},"message":"Persist generated images through turn executors (#39072)\n\n## Why\n\nImage generation did not save its result when the extension host did not provide a host-local save root.\n\n## What changed\n\n- Save generated images under the turn environment's `generated_images` directory through its sandboxed filesystem executor when no host save root is configured.\n- Limit executor-written images to 32 MiB, reject symlinked output directories and existing destinations, and continue returning the image if persistence fails.\n- Include the saved workspace path in the tool output hint while preserving host-managed persistence when a save root is available.\n\n## Testing\n\n- Extend the granted-turn-permissions integration test to verify the image and path hint are written to the turn workspace without creating a host-local artifact.\n\nGitOrigin-RevId: 3d24381a75fe4595641b5250e19fac8ed473b2cd","tree":{"sha":"975ae2e3b5b86196200954afa278b32e2741259a","url":"https://api.github.com/repos/openai/codex/git/trees/975ae2e3b5b86196200954afa278b32e2741259a"},"url":"https://api.github.com/repos/openai/codex/git/commits/682f57254f8c00cf21a280f328a32a54d1e24bbc","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/682f57254f8c00cf21a280f328a32a54d1e24bbc","html_url":"https://github.com/openai/codex/commit/682f57254f8c00cf21a280f328a32a54d1e24bbc","comments_url":"https://api.github.com/repos/openai/codex/commits/682f57254f8c00cf21a280f328a32a54d1e24bbc/comments","author":{"login":"wilkes-oai","id":220961831,"node_id":"U_kgDODSucJw","avatar_url":"https://avatars.githubusercontent.com/u/220961831?v=4","gravatar_id":"","url":"https://api.github.com/users/wilkes-oai","html_url":"https://github.com/wilkes-oai","followers_url":"https://api.github.com/users/wilkes-oai/followers","following_url":"https://api.github.com/users/wilkes-oai/following{/other_user}","gists_url":"https://api.github.com/users/wilkes-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/wilkes-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wilkes-oai/subscriptions","organizations_url":"https://api.github.com/users/wilkes-oai/orgs","repos_url":"https://api.github.com/users/wilkes-oai/repos","events_url":"https://api.github.com/users/wilkes-oai/events{/privacy}","received_events_url":"https://api.github.com/users/wilkes-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"d24507a59b27464c69819e310e9429ce49c3a855","url":"https://api.github.com/repos/openai/codex/commits/d24507a59b27464c69819e310e9429ce49c3a855","html_url":"https://github.com/openai/codex/commit/d24507a59b27464c69819e310e9429ce49c3a855"}]},{"sha":"d24507a59b27464c69819e310e9429ce49c3a855","node_id":"C_kwDOOYsS4doAKGQyNDUwN2E1OWIyNzQ2NGM2OTgxOWUzMTBlOTQyOWNlNDljM2E4NTU","commit":{"author":{"name":"felixxia-oai","email":"felixxia@openai.com","date":"2026-08-17T19:48:10Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T20:19:04Z"},"message":"Remove skill model delegation support (#39068)\n\n## What changed\n\n- Stop parsing and exposing the `model` field from skill frontmatter.\n- Remove the skill model delegation types and instruction generation.\n\nGitOrigin-RevId: 01198c68c095da5062e8abec417cc3539099d9d5","tree":{"sha":"7b6b65b4dc617e9ecf0830f7b1d58cee2c74ac6c","url":"https://api.github.com/repos/openai/codex/git/trees/7b6b65b4dc617e9ecf0830f7b1d58cee2c74ac6c"},"url":"https://api.github.com/repos/openai/codex/git/commits/d24507a59b27464c69819e310e9429ce49c3a855","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/d24507a59b27464c69819e310e9429ce49c3a855","html_url":"https://github.com/openai/codex/commit/d24507a59b27464c69819e310e9429ce49c3a855","comments_url":"https://api.github.com/repos/openai/codex/commits/d24507a59b27464c69819e310e9429ce49c3a855/comments","author":{"login":"felixxia-oai","id":288149840,"node_id":"U_kgDOESzRUA","avatar_url":"https://avatars.githubusercontent.com/u/288149840?v=4","gravatar_id":"","url":"https://api.github.com/users/felixxia-oai","html_url":"https://github.com/felixxia-oai","followers_url":"https://api.github.com/users/felixxia-oai/followers","following_url":"https://api.github.com/users/felixxia-oai/following{/other_user}","gists_url":"https://api.github.com/users/felixxia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/felixxia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/felixxia-oai/subscriptions","organizations_url":"https://api.github.com/users/felixxia-oai/orgs","repos_url":"https://api.github.com/users/felixxia-oai/repos","events_url":"https://api.github.com/users/felixxia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/felixxia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"51a9edc0837ad64b414549f7b2257c73b6168e08","url":"https://api.github.com/repos/openai/codex/commits/51a9edc0837ad64b414549f7b2257c73b6168e08","html_url":"https://github.com/openai/codex/commit/51a9edc0837ad64b414549f7b2257c73b6168e08"}]},{"sha":"51a9edc0837ad64b414549f7b2257c73b6168e08","node_id":"C_kwDOOYsS4doAKDUxYTllZGMwODM3YWQ2NGI0MTQ1NDlmN2IyMjU3YzczYjYxNjhlMDg","commit":{"author":{"name":"chess","email":"chess@openai.com","date":"2026-08-17T19:46:23Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T20:15:37Z"},"message":"Add desktop security enforcement diagnostics (#39067)\n\n## What changed\n\n- Add a `desktop.security.enforcement` doctor check for macOS that assesses the app with Gatekeeper and classifies recent Gatekeeper and XProtect events.\n- Add the same check on Windows by inspecting recent Microsoft Defender, AppLocker, and Windows App Control events for Codex executables.\n- Report blocked or quarantined executions as failures, audit-only or unavailable evidence as warnings, and include actionable remediation while bounding and redacting collected event details.\n\n## Testing\n\n- Add coverage for platform event classification, trusted executable matching, unavailable diagnostics, remediation, and bounded redacted evidence.\n\nGitOrigin-RevId: 792844390cd2cf92d3bc20e6a0973020b4364e51","tree":{"sha":"9ad627d39b5f400ab7bb7fee06399e5909d55245","url":"https://api.github.com/repos/openai/codex/git/trees/9ad627d39b5f400ab7bb7fee06399e5909d55245"},"url":"https://api.github.com/repos/openai/codex/git/commits/51a9edc0837ad64b414549f7b2257c73b6168e08","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/51a9edc0837ad64b414549f7b2257c73b6168e08","html_url":"https://github.com/openai/codex/commit/51a9edc0837ad64b414549f7b2257c73b6168e08","comments_url":"https://api.github.com/repos/openai/codex/commits/51a9edc0837ad64b414549f7b2257c73b6168e08/comments","author":{"login":"chess-oai","id":289791516,"node_id":"U_kgDOEUXeHA","avatar_url":"https://avatars.githubusercontent.com/u/289791516?v=4","gravatar_id":"","url":"https://api.github.com/users/chess-oai","html_url":"https://github.com/chess-oai","followers_url":"https://api.github.com/users/chess-oai/followers","following_url":"https://api.github.com/users/chess-oai/following{/other_user}","gists_url":"https://api.github.com/users/chess-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/chess-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chess-oai/subscriptions","organizations_url":"https://api.github.com/users/chess-oai/orgs","repos_url":"https://api.github.com/users/chess-oai/repos","events_url":"https://api.github.com/users/chess-oai/events{/privacy}","received_events_url":"https://api.github.com/users/chess-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"d327527a3db3b0ea03e1f6d09f9070b5d0f35f85","url":"https://api.github.com/repos/openai/codex/commits/d327527a3db3b0ea03e1f6d09f9070b5d0f35f85","html_url":"https://github.com/openai/codex/commit/d327527a3db3b0ea03e1f6d09f9070b5d0f35f85"}]},{"sha":"d327527a3db3b0ea03e1f6d09f9070b5d0f35f85","node_id":"C_kwDOOYsS4doAKGQzMjc1MjdhM2RiM2IwZWEwM2UxZjZkMDlmOTA3MGI1ZDBmMzVmODU","commit":{"author":{"name":"Charlie Marsh","email":"charliemarsh@openai.com","date":"2026-08-17T19:23:48Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T20:06:41Z"},"message":"Limit terminal hyperlink layout to the visible viewport (#39065)\n\n## What changed\n\n- Skip hyperlink layout for wrapped rows above the scroll offset and stop once\n  processing reaches the bottom of the viewport.\n- Resolve each rendered link destination once while marking its visible cells.\n- Add coverage for hyperlinks that span visible wrapped rows after scrolling.\n\nGitOrigin-RevId: c1506d47fa3f1b895966dc2cde7d5b859c201792","tree":{"sha":"a7c119d0d493bfd99f34115e841d62be1948e6a2","url":"https://api.github.com/repos/openai/codex/git/trees/a7c119d0d493bfd99f34115e841d62be1948e6a2"},"url":"https://api.github.com/repos/openai/codex/git/commits/d327527a3db3b0ea03e1f6d09f9070b5d0f35f85","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/d327527a3db3b0ea03e1f6d09f9070b5d0f35f85","html_url":"https://github.com/openai/codex/commit/d327527a3db3b0ea03e1f6d09f9070b5d0f35f85","comments_url":"https://api.github.com/repos/openai/codex/commits/d327527a3db3b0ea03e1f6d09f9070b5d0f35f85/comments","author":{"login":"charliemarsh-oai","id":282065134,"node_id":"U_kgDOEM_47g","avatar_url":"https://avatars.githubusercontent.com/u/282065134?v=4","gravatar_id":"","url":"https://api.github.com/users/charliemarsh-oai","html_url":"https://github.com/charliemarsh-oai","followers_url":"https://api.github.com/users/charliemarsh-oai/followers","following_url":"https://api.github.com/users/charliemarsh-oai/following{/other_user}","gists_url":"https://api.github.com/users/charliemarsh-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/charliemarsh-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliemarsh-oai/subscriptions","organizations_url":"https://api.github.com/users/charliemarsh-oai/orgs","repos_url":"https://api.github.com/users/charliemarsh-oai/repos","events_url":"https://api.github.com/users/charliemarsh-oai/events{/privacy}","received_events_url":"https://api.github.com/users/charliemarsh-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"1aa3a68e7b863557ae36ba5dc5f77e19a453059a","url":"https://api.github.com/repos/openai/codex/commits/1aa3a68e7b863557ae36ba5dc5f77e19a453059a","html_url":"https://github.com/openai/codex/commit/1aa3a68e7b863557ae36ba5dc5f77e19a453059a"}]},{"sha":"1aa3a68e7b863557ae36ba5dc5f77e19a453059a","node_id":"C_kwDOOYsS4doAKDFhYTNhNjhlN2I4NjM1NTdhZTM2YmE1ZGM1Zjc3ZTE5YTQ1MzA1OWE","commit":{"author":{"name":"Benjamin Carlsson","email":"bc@openai.com","date":"2026-08-17T19:21:53Z"},"committer":{"name":"copyberry","email":"copyberry@app.openai.com","date":"2026-08-17T20:02:50Z"},"message":"Restrict queued-message editing to its dedicated binding (#39064)\n\n## What changed\n\n- Stop treating Vim normal-mode history-up as an alias for editing the latest queued message.\n- Continue to edit queued messages through the configured `chat.edit_queued_message` binding.\n\nGitOrigin-RevId: d830e0976a38725e948d420c1a5f374bb13fe945","tree":{"sha":"3402978cb1fed2481db5c88ee4df8794512dc843","url":"https://api.github.com/repos/openai/codex/git/trees/3402978cb1fed2481db5c88ee4df8794512dc843"},"url":"https://api.github.com/repos/openai/codex/git/commits/1aa3a68e7b863557ae36ba5dc5f77e19a453059a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/openai/codex/commits/1aa3a68e7b863557ae36ba5