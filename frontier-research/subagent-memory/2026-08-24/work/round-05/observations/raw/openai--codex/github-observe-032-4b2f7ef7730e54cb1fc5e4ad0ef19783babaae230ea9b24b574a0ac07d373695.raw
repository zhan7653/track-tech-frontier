b3dd9de93e9cbea6614c85644523979","html_url":"https://github.com/openai/codex/commit/6111791d0b3dd9de93e9cbea6614c85644523979"}]},{"sha":"6111791d0b3dd9de93e9cbea6614c85644523979","node_id":"C_kwDOOYsS4doAKDYxMTE3OTFkMGIzZGQ5ZGU5M2U5Y2JlYTY2MTRjODU2NDQ1MjM5Nzk","commit":{"author":{"name":"alexsong-oai","email":"alexsong@openai.com","date":"2026-05-28T01:37:02Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-28T01:37:02Z"},"message":"Treat refresh_token_reused 400s as relogin-required (#24830)\n\n## Summary\n- classify known refresh-token terminal failures from `/oauth/token` as\npermanent even when the backend returns `400`\n- preserve the existing relogin-required message for\n`refresh_token_reused` instead of retrying and collapsing into a generic\ncloud requirements error\n- add regression coverage for `400 refresh_token_reused`\n\n## Testing\n- `just fmt`\n- `cargo test -p codex-login`","tree":{"sha":"5d70d40c8d9f87fe117588804b19e1f9f28a766e","url":"https://api.github.com/repos/openai/codex/git/trees/5d70d40c8d9f87fe117588804b19e1f9f28a766e"},"url":"https://api.github.com/repos/openai/codex/git/commits/6111791d0b3dd9de93e9cbea6614c85644523979","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqF5w+CRC1aQ7uu5UhlAAAMkIQAGRtt+jKVhlguSmKOtkLju3V\nB00znaJISMBXw7vXtOvTt4Svnjev9+kGZJ/CjQpdnQfkZvirbmkTqsWdYELFNYqo\nhIklJRFE92kiDWAn1VIPvPaiIzELzzN8qBMssUCGTJ6peCsTMuvAWrmx2hstRtW8\nhk/7OCbFzhFHJmPDtwB7bQBfzg8wpHhemJrrWFUyprQu02THZAZqkfgs2dyhbqm0\nPkW5mpFYWltDaPNjJ4b+h4d7I+gi/qY+ReW0lSyApxsJB8VLbpbhWLesfiguR6Es\n4NXfNEs/HxDS6TN3CaCrgfubRchc3hhxedEHeEOUGgRcLfFYYvb8XaqWZwOXs/HC\nVNwv3XAt48im8HB+ihTIePcEWB0xyxe5qcClkcNCZje7gWHpPwKysCsC2GHz/Iu2\n47UT5ZdGl149wdhI26QqKxCf881F+D9AOhNdNwSt3OL0or5ZRcbCfXEaYZoHDvgR\nGxLb2wf7PZySh0a8gmck4IfEzbsgo9OF96fEUjYiQR90BdCzBRLBupoRrwTsH1Er\n3zWlJ+o4ja87/9xLWHZNWg1RzAnGj3xwi6TmPNBc3EjiSlEVMUiP4aksBdnNsWCB\nQGNu6Ej0ZS2+Za3g6bWVd/Kc8VgPfAf0UaGSAW0NPLotHDFiJJ/6/wkF/qzmKLjU\nu/rX5t9D8g3FllYwNZyu\n=jS2b\n-----END PGP SIGNATURE-----\n","payload":"tree 5d70d40c8d9f87fe117588804b19e1f9f28a766e\nparent eb1cc3824ca69125113ebeeba6affe5946cf8072\nauthor alexsong-oai <alexsong@openai.com> 1779932222 -0700\ncommitter GitHub <noreply@github.com> 1779932222 -0700\n\nTreat refresh_token_reused 400s as relogin-required (#24830)\n\n## Summary\n- classify known refresh-token terminal failures from `/oauth/token` as\npermanent even when the backend returns `400`\n- preserve the existing relogin-required message for\n`refresh_token_reused` instead of retrying and collapsing into a generic\ncloud requirements error\n- add regression coverage for `400 refresh_token_reused`\n\n## Testing\n- `just fmt`\n- `cargo test -p codex-login`","verified_at":"2026-05-28T01:37:03Z"}},"url":"https://api.github.com/repos/openai/codex/commits/6111791d0b3dd9de93e9cbea6614c85644523979","html_url":"https://github.com/openai/codex/commit/6111791d0b3dd9de93e9cbea6614c85644523979","comments_url":"https://api.github.com/repos/openai/codex/commits/6111791d0b3dd9de93e9cbea6614c85644523979/comments","author":{"login":"alexsong-oai","id":256201575,"node_id":"U_kgDOD0VTZw","avatar_url":"https://avatars.githubusercontent.com/u/256201575?v=4","gravatar_id":"","url":"https://api.github.com/users/alexsong-oai","html_url":"https://github.com/alexsong-oai","followers_url":"https://api.github.com/users/alexsong-oai/followers","following_url":"https://api.github.com/users/alexsong-oai/following{/other_user}","gists_url":"https://api.github.com/users/alexsong-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/alexsong-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alexsong-oai/subscriptions","organizations_url":"https://api.github.com/users/alexsong-oai/orgs","repos_url":"https://api.github.com/users/alexsong-oai/repos","events_url":"https://api.github.com/users/alexsong-oai/events{/privacy}","received_events_url":"https://api.github.com/users/alexsong-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"eb1cc3824ca69125113ebeeba6affe5946cf8072","url":"https://api.github.com/repos/openai/codex/commits/eb1cc3824ca69125113ebeeba6affe5946cf8072","html_url":"https://github.com/openai/codex/commit/eb1cc3824ca69125113ebeeba6affe5946cf8072"}]},{"sha":"eb1cc3824ca69125113ebeeba6affe5946cf8072","node_id":"C_kwDOOYsS4doAKGViMWNjMzgyNGNhNjkxMjUxMTNlYmVlYmE2YWZmZTU5NDZjZjgwNzI","commit":{"author":{"name":"Ahmed Ibrahim","email":"aibrahim@openai.com","date":"2026-05-28T01:29:05Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-28T01:29:05Z"},"message":"[codex] Prepare Python SDK beta documentation and package metadata (#24836)\n\n## Why\n\nThe initial public `openai-codex` beta should read and install like a\nnormal published Python package before a release tag is created. This\nfollows merged PR #24828, which establishes the independent SDK beta\nrelease plumbing and exact runtime dependency.\n\n## What changed\n\n- Rewrote `sdk/python/README.md` as a compact PyPI-facing beta package\npage: published installation, one quickstart, short login examples,\nbuilt-in help, and links to deeper guides.\n- Updated the getting-started guide, API reference, FAQ, and examples\nindex to present the published beta consistently without repeating\nonboarding in the package landing page or reference page.\n- Made `pip install openai-codex` the primary install path while beta\nreleases are the only published SDK releases, with `--pre` documented\nfor opting into prereleases after a stable release exists.\n- Added curated `help()` / `pydoc` docstrings across the public API and\ngenerated public convenience methods through\n`scripts/update_sdk_artifacts.py`.\n- Declared the repository `Apache-2.0` license expression and\nDocumentation URL in package metadata, without introducing a duplicated\nSDK-local license file.\n- Kept the source distribution focused on installable package material\n(`src/openai_codex`, `README.md`, and `pyproject.toml`); the repository\ndocs and runnable examples remain linked from the PyPI README.\n- Built release artifacts in an Alpine container on the Ubuntu runner,\nmatching Python SDK CI and allowing type generation to install the\npublished `musllinux` runtime wheel.\n- Added `twine check --strict` to the release workflow so malformed PyPI\nmetadata or rendered README content fails before publishing.\n- Added focused SDK assertions for beta metadata, the exact runtime pin,\nsource distribution contents, and the built-in Python documentation\nsurface.\n\n## Validation\n\n- Ran `uv run --frozen --extra dev ruff check\nscripts/update_sdk_artifacts.py src/openai_codex\ntests/test_public_api_signatures.py\ntests/test_artifact_workflow_and_binaries.py` before the final\nREADME-only reductions and review-fix follow-ups.\n- Built `openai_codex-0.1.0b1-py3-none-any.whl` and\n`openai_codex-0.1.0b1.tar.gz` before the final README-only reductions\nand review-fix follow-ups.\n- Ran `python -m twine check --strict` on both built artifacts before\nthe final README-only reductions and review-fix follow-ups.\n- Verified artifact metadata reports `Apache-2.0` without a duplicated\nSDK-local license file.\n- Verified `inspect.getdoc(...)` resolves documentation for the package,\n`Codex`, `CodexConfig`, and key generated thread methods.\n- Rebased the documentation/readiness change onto merged PR #24828\nwithout changing the intended SDK or workflow file contents.\n- Final verification is delegated to online CI for this PR.","tree":{"sha":"f01cfc72e8c15c1b8d2d2b4c2074f63143184302","url":"https://api.github.com/repos/openai/codex/git/trees/f01cfc72e8c15c1b8d2d2b4c2074f63143184302"},"url":"https://api.github.com/repos/openai/codex/git/commits/eb1cc3824ca69125113ebeeba6affe5946cf8072","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqF5phCRC1aQ7uu5UhlAAAepIQAIfIB4ePr9lu9tOSZnKxIgp/\ng4xUw6BEAUbkqZ33zMGffWig5Zs8s0UH56Gc/YIknysDeRxnVd/Pg/hdU//0XWdi\nS0Jo2FFp9FMy/I5A3+dqCmzzEySBv1Ofe8uH9LopaPBGfrvtu9E8bxJbeb/5UBDm\nmTyvQ0wNhnsjKOA2uLmzKAfzkLX8RrNauAxujXgGrxzUn4GJupWzOGE+psxLriWo\nsXzbvq7x9J/3or/MQX2l5awnY1vODeCpp9Ss8Fta2neIPWi2MCk6VDqzGE0TgEbG\nCW8vO7NK2AOu7/yEzvgDX8itsww4BdU/akhtmze/LYUhADBgSjIkr0GJlNlbpYzm\nVd0piDyAx6w49hfbNWFaPTihpykfXgeqcbK9x5IQEE+mV7dQkdjTpnvCdIJmDmwY\ncBqV7ZCXitGuCPjaM3RhASqWTmfzJVUkTlehH4/3Bmwfz75qtFypDCBgt5D/nfRo\nZclNGZgvpctFbwvVZH1o97/eqi9TrJFEhQXOcI6ecHBB/r0pZoCZeJ/bUJuZczZl\nIAJp2ElTyrdki3/zWxpB+L4jbq/cYSmkMCtoKKoOwI5wD40iJwcDsxEr97GhZWEA\n2pZ/FxkOpWlZfY46z3O32upqvfK1nLlL98dBD41Rzju774i5tt1MQDV+Yunnrg1l\nC9hoYowIAUXHxT0EsqSj\n=PRSq\n-----END PGP SIGNATURE-----\n","payload":"tree f01cfc72e8c15c1b8d2d2b4c2074f63143184302\nparent 4d0c4cd058d9bc488ee2c331f085e25b7af3268d\nauthor Ahmed Ibrahim <aibrahim@openai.com> 1779931745 -0700\ncommitter GitHub <noreply@github.com> 1779931745 -0700\n\n[codex] Prepare Python SDK beta documentation and package metadata (#24836)\n\n## Why\n\nThe initial public `openai-codex` beta should read and install like a\nnormal published Python package before a release tag is created. This\nfollows merged PR #24828, which establishes the independent SDK beta\nrelease plumbing and exact runtime dependency.\n\n## What changed\n\n- Rewrote `sdk/python/README.md` as a compact PyPI-facing beta package\npage: published installation, one quickstart, short login examples,\nbuilt-in help, and links to deeper guides.\n- Updated the getting-started guide, API reference, FAQ, and examples\nindex to present the published beta consistently without repeating\nonboarding in the package landing page or reference page.\n- Made `pip install openai-codex` the primary install path while beta\nreleases are the only published SDK releases, with `--pre` documented\nfor opting into prereleases after a stable release exists.\n- Added curated `help()` / `pydoc` docstrings across the public API and\ngenerated public convenience methods through\n`scripts/update_sdk_artifacts.py`.\n- Declared the repository `Apache-2.0` license expression and\nDocumentation URL in package metadata, without introducing a duplicated\nSDK-local license file.\n- Kept the source distribution focused on installable package material\n(`src/openai_codex`, `README.md`, and `pyproject.toml`); the repository\ndocs and runnable examples remain linked from the PyPI README.\n- Built release artifacts in an Alpine container on the Ubuntu runner,\nmatching Python SDK CI and allowing type generation to install the\npublished `musllinux` runtime wheel.\n- Added `twine check --strict` to the release workflow so malformed PyPI\nmetadata or rendered README content fails before publishing.\n- Added focused SDK assertions for beta metadata, the exact runtime pin,\nsource distribution contents, and the built-in Python documentation\nsurface.\n\n## Validation\n\n- Ran `uv run --frozen --extra dev ruff check\nscripts/update_sdk_artifacts.py src/openai_codex\ntests/test_public_api_signatures.py\ntests/test_artifact_workflow_and_binaries.py` before the final\nREADME-only reductions and review-fix follow-ups.\n- Built `openai_codex-0.1.0b1-py3-none-any.whl` and\n`openai_codex-0.1.0b1.tar.gz` before the final README-only reductions\nand review-fix follow-ups.\n- Ran `python -m twine check --strict` on both built artifacts before\nthe final README-only reductions and review-fix follow-ups.\n- Verified artifact metadata reports `Apache-2.0` without a duplicated\nSDK-local license file.\n- Verified `inspect.getdoc(...)` resolves documentation for the package,\n`Codex`, `CodexConfig`, and key generated thread methods.\n- Rebased the documentation/readiness change onto merged PR #24828\nwithout changing the intended SDK or workflow file contents.\n- Final verification is delegated to online CI for this PR.","verified_at":"2026-05-28T01:29:06Z"}},"url":"https://api.github.com/repos/openai/codex/commits/eb1cc3824ca69125113ebeeba6affe5946cf8072","html_url":"https://github.com/openai/codex/commit/eb1cc3824ca69125113ebeeba6affe5946cf8072","comments_url":"https://api.github.com/repos/openai/codex/commits/eb1cc3824ca69125113ebeeba6affe5946cf8072/comments","author":{"login":"aibrahim-oai","id":219906144,"node_id":"U_kgDODRuAYA","avatar_url":"https://avatars.githubusercontent.com/u/219906144?v=4","gravatar_id":"","url":"https://api.github.com/users/aibrahim-oai","html_url":"https://github.com/aibrahim-oai","followers_url":"https://api.github.com/users/aibrahim-oai/followers","following_url":"https://api.github.com/users/aibrahim-oai/following{/other_user}","gists_url":"https://api.github.com/users/aibrahim-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/aibrahim-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aibrahim-oai/subscriptions","organizations_url":"https://api.github.com/users/aibrahim-oai/orgs","repos_url":"https://api.github.com/users/aibrahim-oai/repos","events_url":"https://api.github.com/users/aibrahim-oai/events{/privacy}","received_events_url":"https://api.github.com/users/aibrahim-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"4d0c4cd058d9bc488ee2c331f085e25b7af3268d","url":"https://api.github.com/repos/openai/codex/commits/4d0c4cd058d9bc488ee2c331f085e25b7af3268d","html_url":"https://github.com/openai/codex/commit/4d0c4cd058d9bc488ee2c331f085e25b7af3268d"}]},{"sha":"4d0c4cd058d9bc488ee2c331f085e25b7af3268d","node_id":"C_kwDOOYsS4doAKDRkMGM0Y2QwNThkOWJjNDg4ZWUyYzMzMWYwODVlMjViN2FmMzI2OGQ","commit":{"author":{"name":"Ahmed Ibrahim","email":"aibrahim@openai.com","date":"2026-05-28T00:57:51Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-28T00:57:51Z"},"message":"[codex] Add independent beta release for the Python SDK (#24828)\n\n## Why\n\n`openai-codex` needs a beta release lifecycle without requiring beta\nreleases of its pinned runtime package. Previously, SDK staging rewrote\nits runtime dependency to the SDK version, which made an SDK-only beta\nimpossible.\n\n## What changed\n\n- Set the initial SDK beta version to `0.1.0b1` and pin it to published\nstable `openai-codex-cli-bin==0.132.0`.\n- Decoupled SDK release staging from runtime versioning so it preserves\nthe reviewed exact runtime pin.\n- Added a `python-v*` tag workflow that builds and publishes only\n`openai-codex` through PyPI trusted publishing.\n- Removed the Beta classifier from runtime package metadata for future\nruntime publications.\n- Regenerated protocol-derived SDK models from the selected stable\nruntime package.\n\n`0.132.0` is the newest stable runtime admitted by the checked-in\ndependency date fence and retains the Linux wheel family currently used\nby SDK CI.\n\n## Release setup\n\nBefore pushing `python-v0.1.0b1`, configure PyPI trusted publishing for\nthe `openai-codex` project with workflow `python-sdk-release.yml`,\nenvironment `pypi`, and job `publish-python-sdk`.\n\n## Validation\n\n- `uv run --frozen --extra dev ruff check src/openai_codex scripts\nexamples tests`\n- Parsed `.github/workflows/python-sdk-release.yml` with PyYAML.\n- Built staged release artifacts locally:\n`openai_codex-0.1.0b1-py3-none-any.whl` and\n`openai_codex-0.1.0b1.tar.gz`.\n- Verified wheel metadata pins `openai-codex-cli-bin==0.132.0`.\n- Tests are deferred to online CI for this PR.","tree":{"sha":"90aaa391ba7340b29620372948773bf6f57c7cf1","url":"https://api.github.com/repos/openai/codex/git/trees/90aaa391ba7340b29620372948773bf6f57c7cf1"},"url":"https://api.github.com/repos/openai/codex/git/commits/4d0c4cd058d9bc488ee2c331f085e25b7af3268d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqF5MPCRC1aQ7uu5UhlAAAYawQAA+ZfQRCosC1B8E0MXHYja8j\nE3x1RZ6k0ONK6vvr9i6SbHUJdoQiAjyD8JFhBybI+2TdHjqe1WJ0XxF5c1ZtHPwr\nDw0UuDKcP4T89aXr4z08tKTL5DFWjkX8WSIdMi+MuSuABbFAhkP5XgkfFnIN5utU\nb+31TpKHrz93n3t5Z3cAnvQeXG0DfaNqSt2z5EtFwD+wYgi4s8v825SSevG4IyWr\ngLKFUNLf0MwozKxVO29tdS3bBm5ujC6KDTnlSoeFdKu8E0AZjaikGiiQXuBl7Vsm\nPOnlRV/5vjI3cpkn3bTJ7jEM+1kOHJyqvD1o9zxdwHvLXK7JVAjWuIuBEPhrNMCq\n15QFEcbLZYnkDfd8DMgiQ6BV460uN0SDwqqFNRMSYDsJeXEAAFfwrcA2mJhV+U7G\nUloOfZI64v2Pf3OabMwOaZDKhNZRZKO5JyF1cS6HhkWHzxTwJ+SLcNAbCmHG44l+\ngS69gcx4NaelqdDd5/Cha+u3zfibjpoLRqCGlodmA3p+E0YUJzXNGr3Wtq2JLty3\ntws/lUt1SQtzcLvHSjdy3CuRJGgy2bwAwGrTij4UeMbuJeT6kPxUfJJP7nhy4jK7\nBon2BfUrzf6gWYTLZXUx2wepJ6F9C7C/AS6vkO68K7wxgoMExnmNNHnbR4kBcDet\nCT/mPaa27oQq8ziAjeqR\n=yfPo\n-----END PGP SIGNATURE-----\n","payload":"tree 90aaa391ba7340b29620372948773bf6f57c7cf1\nparent 304d15cab0b1c5f23925e5a3b94c39db3483fc3d\nauthor Ahmed Ibrahim <aibrahim@openai.com> 1779929871 -0700\ncommitter GitHub <noreply@github.com> 1779929871 -0700\n\n[codex] Add independent beta release for the Python SDK (#24828)\n\n## Why\n\n`openai-codex` needs a beta release lifecycle without requiring beta\nreleases of its pinned runtime package. Previously, SDK staging rewrote\nits runtime dependency to the SDK version, which made an SDK-only beta\nimpossible.\n\n## What changed\n\n- Set the initial SDK beta version to `0.1.0b1` and pin it to published\nstable `openai-codex-cli-bin==0.132.0`.\n- Decoupled SDK release staging from runtime versioning so it preserves\nthe reviewed exact runtime pin.\n- Added a `python-v*` tag workflow that builds and publishes only\n`openai-codex` through PyPI trusted publishing.\n- Removed the Beta classifier from runtime package metadata for future\nruntime publications.\n- Regenerated protocol-derived SDK models from the selected stable\nruntime package.\n\n`0.132.0` is the newest stable runtime admitted by the checked-in\ndependency date fence and retains the Linux wheel family currently used\nby SDK CI.\n\n## Release setup\n\nBefore pushing `python-v0.1.0b1`, configure PyPI trusted publishing for\nthe `openai-codex` project with workflow `python-sdk-release.yml`,\nenvironment `pypi`, and job `publish-python-sdk`.\n\n## Validation\n\n- `uv run --frozen --extra dev ruff check src/openai_codex scripts\nexamples tests`\n- Parsed `.github/workflows/python-sdk-release.yml` with PyYAML.\n- Built staged release artifacts locally:\n`openai_codex-0.1.0b1-py3-none-any.whl` and\n`openai_codex-0.1.0b1.tar.gz`.\n- Verified wheel metadata pins `openai-codex-cli-bin==0.132.0`.\n- Tests are deferred to online CI for this PR.","verified_at":"2026-05-28T00:57:51Z"}},"url":"https://api.github.com/repos/openai/codex/commits/4d0c4cd058d9bc488ee2c331f085e25b7af3268d","html_url":"https://github.com/openai/codex/commit/4d0c4cd058d9bc488ee2c331f085e25b7af3268d","comments_url":"https://api.github.com/repos/openai/codex/commits/4d0c4cd058d9bc488ee2c331f085e25b7af3268d/comments","author":{"login":"aibrahim-oai","id":219906144,"node_id":"U_kgDODRuAYA","avatar_url":"https://avatars.githubusercontent.com/u/219906144?v=4","gravatar_id":"","url":"https://api.github.com/users/aibrahim-oai","html_url":"https://github.com/aibrahim-oai","followers_url":"https://api.github.com/users/aibrahim-oai/followers","following_url":"https://api.github.com/users/aibrahim-oai/following{/other_user}","gists_url":"https://api.github.com/users/aibrahim-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/aibrahim-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aibrahim-oai/subscriptions","organizations_url":"https://api.github.com/users/aibrahim-oai/orgs","repos_url":"https://api.github.com/users/aibrahim-oai/repos","events_url":"https://api.github.com/users/aibrahim-oai/events{/privacy}","received_events_url":"https://api.github.com/users/aibrahim-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"304d15cab0b1c5f23925e5a3b94c39db3483fc3d","url":"https://api.github.com/repos/openai/codex/commits/304d15cab0b1c5f23925e5a3b94c39db3483fc3d","html_url":"https://github.com/openai/codex/commit/304d15cab0b1c5f23925e5a3b94c39db3483fc3d"}]},{"sha":"304d15cab0b1c5f23925e5a3b94c39db3483fc3d","node_id":"C_kwDOOYsS4doAKDMwNGQxNWNhYjBiMWM1ZjIzOTI1ZTVhM2I5NGMzOWRiMzQ4M2ZjM2Q","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-05-28T00:57:32Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-28T00:57:32Z"},"message":"[codex] Remove redundant SQLite dynamic tool storage (#24819)\n\n## Why\n\nDynamic tools are defined at thread start and already stored in rollout\n`SessionMeta`, which restores resumed and forked sessions. Persisting\nthe same tools through SQLite creates a second runtime persistence path\nthat is unnecessary prework for the explicit namespace refactor.\n\n## What changed\n\n- Restore missing thread-start dynamic tools directly from rollout\nhistory, including when SQLite is enabled.\n- Remove SQLite dynamic-tool reads, writes, backfill, and thread\nmetadata patch plumbing.\n- Add SQLite-enabled resume integration coverage that verifies a\nrollout-defined dynamic tool is still sent after resume.\n\n## Compatibility\n\nThe existing `thread_dynamic_tools` table is intentionally not dropped\neven though it's now unused. Older Codex binaries are allowed to open\ndatabases migrated by newer binaries and still reference this table;\ndropping it would break that mixed-version path. See\n[here](https://github.com/openai/codex/blob/main/codex-rs/state/src/migrations.rs#L10-L11).\n\n## Verification\n\n- `just test -p codex-state -p codex-rollout -p codex-thread-store`\n- `just test -p codex-core --test all\nresume_restores_dynamic_tools_from_rollout_with_sqlite_enabled`","tree":{"sha":"dfcc266b1c67019c4d474bfbe09ed0898017cbd2","url":"https://api.github.com/repos/openai/codex/git/trees/dfcc266b1c67019c4d474bfbe09ed0898017cbd2"},"url":"https://api.github.com/repos/openai/codex/git/commits/304d15cab0b1c5f23925e5a3b94c39db3483fc3d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqF5L8CRC1aQ7uu5UhlAAAUo0QALEo2e/SsEu//LVrNW6Dlz6g\nx2JFlJYiDfISNT/IDTDe/mayJBNmQZybR8ehWdhJjYy20xMBR2klrdax/fGjfjK/\nwE2q9AhoCqHmzzpwoTEx4xM1TGrlRTKF0QQLxM/lFM9FviDW6f7cc8XJcb5Ae1xm\nqUHbiiFwgaQUhrQkGoTg1JBnGti0QcbtyjbHPiZo2ZVr9YvdHYu3f5tR8LZHxl1f\n4vz2IRdMZJYRx6vANCI49GydaHmIpDv14sXW3jD8soRjBqpoz+KU9+QFlRXmmvAd\nGQoxAB8SPyhqr8ZUkB2lSsiZkyQq3guf91xKH+/DrwIiAJKgD7N0J97SA2jh8TJQ\nxHS8GjD1cROb5c7WWinJDKqclY4zGSDXIPp9vL8ceWjL8EwBrGbvyF9KHAQBjhOV\nh6qQ+qNpd7Hfvg1EFrTMCzSf8gVwrCUOUaUEXg8PfhMyz8NHIOz4ZWWqiq0Ijzl3\nys91LxFe4qeb64kXVsELY92xSThI2h1Sm07KKSb7KMY24RXyPdQyMnilHPw1Ttog\n7B46X2q5U3jqarzARLVm0wS5a8fDzHpFXp9oLfRKqSkAS9bIit8upPJmmYg6mnBG\nMoFkIyWqFErLC62GskS0ytsI1k1tHFiar0Zchg80fClAz63qbbKAHCqbznD/1c7I\n2GGO3vT5loGzXuicqJ4c\n=d9S1\n-----END PGP SIGNATURE-----\n","payload":"tree dfcc266b1c67019c4d474bfbe09ed0898017cbd2\nparent 0db49a7e6ae8fd459dd8d8d404086c748b9118a1\nauthor sayan-oai <sayan@openai.com> 1779929852 -0700\ncommitter GitHub <noreply@github.com> 1779929852 -0700\n\n[codex] Remove redundant SQLite dynamic tool storage (#24819)\n\n## Why\n\nDynamic tools are defined at thread start and already stored in rollout\n`SessionMeta`, which restores resumed and forked sessions. Persisting\nthe same tools through SQLite creates a second runtime persistence path\nthat is unnecessary prework for the explicit namespace refactor.\n\n## What changed\n\n- Restore missing thread-start dynamic tools directly from rollout\nhistory, including when SQLite is enabled.\n- Remove SQLite dynamic-tool reads, writes, backfill, and thread\nmetadata patch plumbing.\n- Add SQLite-enabled resume integration coverage that verifies a\nrollout-defined dynamic tool is still sent after resume.\n\n## Compatibility\n\nThe existing `thread_dynamic_tools` table is intentionally not dropped\neven though it's now unused. Older Codex binaries are allowed to open\ndatabases migrated by newer binaries and still reference this table;\ndropping it would break that mixed-version path. See\n[here](https://github.com/openai/codex/blob/main/codex-rs/state/src/migrations.rs#L10-L11).\n\n## Verification\n\n- `just test -p codex-state -p codex-rollout -p codex-thread-store`\n- `just test -p codex-core --test all\nresume_restores_dynamic_tools_from_rollout_with_sqlite_enabled`","verified_at":"2026-05-28T00:57:32Z"}},"url":"https://api.github.com/repos/openai/codex/commits/304d15cab0b1c5f23925e5a3b94c39db3483fc3d","html_url":"https://github.com/openai/codex/commit/304d15cab0b1c5f23925e5a3b94c39db3483fc3d","comments_url":"https://api.github.com/repos/openai/codex/commits/304d15cab0b1c5f23925e5a3b94c39db3483fc3d/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"0db49a7e6ae8fd459dd8d8d404086c748b9118a1","url":"https://api.github.com/repos/openai/codex/commits/0db49a7e6ae8fd459dd8d8d404086c748b9118a1","html_url":"https://github.com/openai/codex/commit/0db49a7e6ae8fd459dd8d8d404086c748b9118a1"}]},{"sha":"0db49a7e6ae8fd459dd8d8d404086c748b9118a1","node_id":"C_kwDOOYsS4doAKDBkYjQ5YTdlNmFlOGZkNDU5ZGQ4ZDhkNDA0MDg2Yzc0OGI5MTE4YTE","commit":{"author":{"name":"Ahmed Ibrahim","email":"aibrahim@openai.com","date":"2026-05-27T23:10:15Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T23:10:15Z"},"message":"[codex] Rename Python SDK AppServerConfig to CodexConfig (#24800)\n\n## Why\n\n`AppServerConfig` is exported as part of the ergonomic Python SDK\nsurface and passed to `Codex(...)` and `AsyncCodex(...)`. That name\nexposes the underlying app-server transport at the same layer where\nusers are configuring the Codex client. `CodexConfig` makes the common\ncallsite read naturally and names the object it configures.\n\n## What changed\n\n- Renamed the public configuration dataclass from `AppServerConfig` to\n`CodexConfig`.\n- Updated `Codex`, `AsyncCodex`, and the transport clients to accept\n`CodexConfig`.\n- Updated binary-resolution messages, package exports, docs, examples,\nand related coverage to use the new public name.\n\n## API impact\n\n```python\nfrom openai_codex import Codex, CodexConfig\n\nwith Codex(config=CodexConfig(codex_bin=\"/path/to/codex\")) as codex:\n    ...\n```\n\nCallers should now import and construct `CodexConfig`; `AppServerConfig`\nis no longer part of the Python SDK surface.\n\n## Validation\n\n- `uv run --frozen --extra dev ruff check src/openai_codex scripts\nexamples tests`\n- Tests are deferred to online CI for this PR.","tree":{"sha":"2ccffbb55722ce625d1f598eb599cb9a10cf45da","url":"https://api.github.com/repos/openai/codex/git/trees/2ccffbb55722ce625d1f598eb599cb9a10cf45da"},"url":"https://api.github.com/repos/openai/codex/git/commits/0db49a7e6ae8fd459dd8d8d404086c748b9118a1","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqF3nXCRC1aQ7uu5UhlAAAHJ8QAJt/rTbDFCRGNQsmhwPD9Xzo\nu6PxUMHmev3f21rgC90cX43I3wIPgjcgIGk1P3v36jrnh8QIJu16IS0wINHTL2pl\n/Kcnl7QyxG6f9qEzM/IWcWaUJ5Fiw9tc6TSegpMQt2mHTfy5M/QnpdkOWQ2bHjgD\nbgSHw/3XsGshXUyCjS88XwXtNYAc/Fv+83Do4RfYKxzYPVT5lQbDICyU2a4CnQVe\n+Q7v9yOjk28km9qbdKuP44fJWLXKuY32/QBeb8GE5zpftGxjJFW8YE8rI2tS/Bzk\npQDUUhs2G1vPC4jHn7fjifRHypktixdNt+TbgnyssCr+hrTW5MMyw5S8IjqRt7lJ\nitIH8s3iEjmON9oGd2n94mDHDbuee+mzNw5+ONZAs6b4hMNkFYKa5KIDapXWlkqQ\nvZyTue2hEWVflfmMq/rYbyeVSevumwWBEil/vDY0p39otCdx15JmGDfWpQTiOvlA\nNwZEYx07MO1PPoBHJnmAjtDqO/yW2H9pJqcUYbPBHFjjwNqJZ/4vqIjbQUjM0cfC\nvmibRLoGWCu8692r/SdIq5rIxoCQF7Q8vypBVXYBcQi5+Ov/1Ci5RJu358SX/sLy\nISpW7+6cc8+wDWRvrmtkzW0s1hpjbfSxWAYyF1wgKznqK9rY+A2/B2s5DjXBuzHr\nSR8yKOWGcbC2UVrWq/zH\n=qxTQ\n-----END PGP SIGNATURE-----\n","payload":"tree 2ccffbb55722ce625d1f598eb599cb9a10cf45da\nparent 090144e0eca3978b3ebf29bc376a48b3d37523c5\nauthor Ahmed Ibrahim <aibrahim@openai.com> 1779923415 -0700\ncommitter GitHub <noreply@github.com> 1779923415 -0700\n\n[codex] Rename Python SDK AppServerConfig to CodexConfig (#24800)\n\n## Why\n\n`AppServerConfig` is exported as part of the ergonomic Python SDK\nsurface and passed to `Codex(...)` and `AsyncCodex(...)`. That name\nexposes the underlying app-server transport at the same layer where\nusers are configuring the Codex client. `CodexConfig` makes the common\ncallsite read naturally and names the object it configures.\n\n## What changed\n\n- Renamed the public configuration dataclass from `AppServerConfig` to\n`CodexConfig`.\n- Updated `Codex`, `AsyncCodex`, and the transport clients to accept\n`CodexConfig`.\n- Updated binary-resolution messages, package exports, docs, examples,\nand related coverage to use the new public name.\n\n## API impact\n\n```python\nfrom openai_codex import Codex, CodexConfig\n\nwith Codex(config=CodexConfig(codex_bin=\"/path/to/codex\")) as codex:\n    ...\n```\n\nCallers should now import and construct `CodexConfig`; `AppServerConfig`\nis no longer part of the Python SDK surface.\n\n## Validation\n\n- `uv run --frozen --extra dev ruff check src/openai_codex scripts\nexamples tests`\n- Tests are deferred to online CI for this PR.","verified_at":"2026-05-27T23:10:16Z"}},"url":"https://api.github.com/repos/openai/codex/commits/0db49a7e6ae8fd459dd8d8d404086c748b9118a1","html_url":"https://github.com/openai/codex/commit/0db49a7e6ae8fd459dd8d8d404086c748b9118a1","comments_url":"https://api.github.com/repos/openai/codex/commits/0db49a7e6ae8fd459dd8d8d404086c748b9118a1/comments","author":{"login":"aibrahim-oai","id":219906144,"node_id":"U_kgDODRuAYA","avatar_url":"https://avatars.githubusercontent.com/u/219906144?v=4","gravatar_id":"","url":"https://api.github.com/users/aibrahim-oai","html_url":"https://github.com/aibrahim-oai","followers_url":"https://api.github.com/users/aibrahim-oai/followers","following_url":"https://api.github.com/users/aibrahim-oai/following{/other_user}","gists_url":"https://api.github.com/users/aibrahim-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/aibrahim-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aibrahim-oai/subscriptions","organizations_url":"https://api.github.com/users/aibrahim-oai/orgs","repos_url":"https://api.github.com/users/aibrahim-oai/repos","events_url":"https://api.github.com/users/aibrahim-oai/events{/privacy}","received_events_url":"https://api.github.com/users/aibrahim-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"090144e0eca3978b3ebf29bc376a48b3d37523c5","url":"https://api.github.com/repos/openai/codex/commits/090144e0eca3978b3ebf29bc376a48b3d37523c5","html_url":"https://github.com/openai/codex/commit/090144e0eca3978b3ebf29bc376a48b3d37523c5"}]},{"sha":"090144e0eca3978b3ebf29bc376a48b3d37523c5","node_id":"C_kwDOOYsS4doAKDA5MDE0NGUwZWNhMzk3OGIzZWJmMjliYzM3NmE0OGIzZDM3NTIzYzU","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-05-27T22:11:29Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T22:11:29Z"},"message":"[codex] Fix hyperlink-aware key-value table rendering (#24825)\n\n## Why\n\nThe key/value markdown table renderer added in #24636 still operates on\n`Line` values, while table cells and rendered table output now carry\n`HyperlinkLine`. That mismatch breaks `codex-tui` compilation on `main`\nand would risk losing semantic web-link annotations if corrected by\nflattening the values.\n\n## What changed\n\n- Make key/value record rendering wrap and emit `HyperlinkLine` values\nconsistently with the existing grid renderer.\n- Remap wrapped hyperlink ranges and shift them when value content is\nprefixed by record-mode indentation or labels.\n- Add focused coverage verifying key/value fallback output preserves\nweb-link destinations.\n\n## Verification\n\n- `just test -p codex-tui -E\n'test(key_value_table_keeps_web_annotations) |\ntest(/table_renders_(key_value_records_when_compact_fragmentation_is_systemic_snapshot|stacked_key_value_records_when_path_column_becomes_too_narrow_snapshot|records_when_multiple_prose_columns_are_starved_snapshot)/)'`","tree":{"sha":"775cd2db697d887bc8db3b00bd50bc994e0aa31f","url":"https://api.github.com/repos/openai/codex/git/trees/775cd2db697d887bc8db3b00bd50bc994e0aa31f"},"url":"https://api.github.com/repos/openai/codex/git/commits/090144e0eca3978b3ebf29bc376a48b3d37523c5","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqF2wRCRC1aQ7uu5UhlAAAsT0QADmqK20KdnII9qdb/X0uBjhp\nn0wKacstedxSZvBKdMfeV94zXxtEEebvJgjoZULMkvXlK9tgZNLr9IbunzNE6etH\nF00Xfh1iQiWndDD4Ch2kWaeJrQPrj8+CDU5SVnRCCnplH0D+HGz11DKKQheNENBH\ncngcRWW3hpAc05/FFI7qrjZh2EQO5qdFW2UF4UtxUU9HOUpfX6LiG9IgUS6IFM6k\nxL2AfGW7RKUMHNNHZjHwAWDTRH9h+v6shmOr9+2VmmnrxvacXiBJ9xdKq/kLbMbK\nwC2x9kB5ayKltMw58tgINIm6LtknQEVcbKzP4BUVG/xnCsVJoxR/fRsC8odMy5z4\nLqx2/Pgj8DhiWsxJcjk1ol+m3410Q2jk+fbd1ovRO97xq1oNEMSusy9aiBYb8t8w\n1FfocVxgAGkOPvGbXH3teG0kjQ9XQzSa9rJhmnqDaU/zJbdyEDm4HO2DVbu7Baos\nU3GUvfNA6rnt0BgASO8vU6lpDuq96skikuVFyAFft0VivbTIXdhk7Enl4GEDJXWP\nLfVBSLQiDfb4RhcY5gFGHj8TUm+zBjm/1RLklBKVK+H98CG7aYBVgngDIXHsIpXZ\nyjJkTIov0mKKJ8QalTbdnuctq4w/gGZP9wRzyfK3t7b/EHkbtp88uE84RCDgYqbT\nMM8MvxAinsS/gV11Y1sJ\n=ThAu\n-----END PGP SIGNATURE-----\n","payload":"tree 775cd2db697d887bc8db3b00bd50bc994e0aa31f\nparent 910578792f82222335f3f93a9ff259d2b1fe5d93\nauthor sayan-oai <sayan@openai.com> 1779919889 -0700\ncommitter GitHub <noreply@github.com> 1779919889 -0700\n\n[codex] Fix hyperlink-aware key-value table rendering (#24825)\n\n## Why\n\nThe key/value markdown table renderer added in #24636 still operates on\n`Line` values, while table cells and rendered table output now carry\n`HyperlinkLine`. That mismatch breaks `codex-tui` compilation on `main`\nand would risk losing semantic web-link annotations if corrected by\nflattening the values.\n\n## What changed\n\n- Make key/value record rendering wrap and emit `HyperlinkLine` values\nconsistently with the existing grid renderer.\n- Remap wrapped hyperlink ranges and shift them when value content is\nprefixed by record-mode indentation or labels.\n- Add focused coverage verifying key/value fallback output preserves\nweb-link destinations.\n\n## Verification\n\n- `just test -p codex-tui -E\n'test(key_value_table_keeps_web_annotations) |\ntest(/table_renders_(key_value_records_when_compact_fragmentation_is_systemic_snapshot|stacked_key_value_records_when_path_column_becomes_too_narrow_snapshot|records_when_multiple_prose_columns_are_starved_snapshot)/)'`","verified_at":"2026-05-27T22:11:29Z"}},"url":"https://api.github.com/repos/openai/codex/commits/090144e0eca3978b3ebf29bc376a48b3d37523c5","html_url":"https://github.com/openai/codex/commit/090144e0eca3978b3ebf29bc376a48b3d37523c5","comments_url":"https://api.github.com/repos/openai/codex/commits/090144e0eca3978b3ebf29bc376a48b3d37523c5/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"910578792f82222335f3f93a9ff259d2b1fe5d93","url":"https://api.github.com/repos/openai/codex/commits/910578792f82222335f3f93a9ff259d2b1fe5d93","html_url":"https://github.com/openai/codex/commit/910578792f82222335f3f93a9ff259d2b1fe5d93"}]},{"sha":"910578792f82222335f3f93a9ff259d2b1fe5d93","node_id":"C_kwDOOYsS4doAKDkxMDU3ODc5MmY4MjIyMjMzNWYzZjkzYTlmZjI1OWQyYjFmZTVkOTM","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-05-27T21:52:06Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T21:52:06Z"},"message":"Update rmcp to 1.7.0 (#24763)\n\nWIll make it easier to uprev when the new draft spec is supported.\n\nAlso updates reqwest where needed for compatibility but doesn't update\nit everywhere since this is already a large diff.\n\nThe new version of rmcp handles certain kinds of authentication failures\ndifferently, this patch includes support for identifying the failing scope\nin a WWW-Authenticate header.","tree":{"sha":"f65635abb0a1c0a64d4361ac77075bd878f53ce8","url":"https://api.github.com/repos/openai/codex/git/trees/f65635abb0a1c0a64d4361ac77075bd878f53ce8"},"url":"https://api.github.com/repos/openai/codex/git/commits/910578792f82222335f3f93a9ff259d2b1fe5d93","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqF2eGCRC1aQ7uu5UhlAAAPrYQAAb/i1x8qJDIaOR5SkrtU6/Z\nLQdyVw/GXjsNXoGzEYRO0QRc7c9O14hWGA/NeY1nQ3D1+PGpdSDzn/lRg2e/zQPd\nZoOHZG6QHfKqCiopLTNt1hYqu6ArQtg/NAY6E26ZmB3z19VF39y/HTScEvrM7ZVx\nC511SwREXKVgI6P0iB4SbOHYe2y0Bv8dsx+ih4IwSvY52pKHWlgqeIdmrXpi3M11\n695mYReSAuLMvtWVJoXMQP+08O7fcWU8esNw9lFVswx7oFWCHaGgRO4V19OFI0f9\nDah+02QB0PEdhaVOZozCh1BXh6LzuYXhlo3t2P3+HgVjPrCO5Dj+QZ8kV0Xo0KJh\n7zO16N8DaTeG1G5g955BWWFhMkWY6qb2w7jL/Es2p6Xg0jlhvNRkn5oTjpm6DxEY\n8NezCKSbM2GPnocjqDk1uRz+hgmSFRbZwl3SshhDBG8Adz2dMuovmd42eMcI66e0\nOe05vWnzwY9CfAIJh6YxZQmNyQkB+syB1CRz/l0mtGPoIAtMhw8QVMue47WSVTn7\ncNMYN+nnuosRtIU+3hzkev0LZ5nKoOC+hNgn+om3c6rAe+OHvrcX6O0CCC+sIUx5\nmRNYb+I8UM+ns3kGD6T2H3ixQ4MrwtieB7RoWfFKqkMcT+pQ0W9z9TKyzkRRsBkx\nh7tNaMNqpYOgPBUZGqrG\n=WPpl\n-----END PGP SIGNATURE-----\n","payload":"tree f65635abb0a1c0a64d4361ac77075bd878f53ce8\nparent c57dee98b7e70f306d2981f9075dde1d1b9a90e7\nauthor Adam Perry @ OpenAI <anp@openai.com> 1779918726 -0700\ncommitter GitHub <noreply@github.com> 1779918726 -0700\n\nUpdate rmcp to 1.7.0 (#24763)\n\nWIll make it easier to uprev when the new draft spec is supported.\n\nAlso updates reqwest where needed for compatibility but doesn't update\nit everywhere since this is already a large diff.\n\nThe new version of rmcp handles certain kinds of authentication failures\ndifferently, this patch includes support for identifying the failing scope\nin a WWW-Authenticate header.","verified_at":"2026-05-27T21:52:07Z"}},"url":"https://api.github.com/repos/openai/codex/commits/910578792f82222335f3f93a9ff259d2b1fe5d93","html_url":"https://github.com/openai/codex/commit/910578792f82222335f3f93a9ff259d2b1fe5d93","comments_url":"https://api.github.com/repos/openai/codex/commits/910578792f82222335f3f93a9ff259d2b1fe5d93/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c57dee98b7e70f306d2981f9075dde1d1b9a90e7","url":"https://api.github.com/repos/openai/codex/commits/c57dee98b7e70f306d2981f9075dde1d1b9a90e7","html_url":"https://github.com/openai/codex/commit/c57dee98b7e70f306d2981f9075dde1d1b9a90e7"}]},{"sha":"c57dee98b7e70f306d2981f9075dde1d1b9a90e7","node_id":"C_kwDOOYsS4doAKGM1N2RlZTk4YjdlNzBmMzA2ZDI5ODFmOTA3NWRkZTFkMWI5YTkwZTc","commit":{"author":{"name":"Steve Coffey","email":"stevendcoffey@gmail.com","date":"2026-05-27T21:17:38Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T21:17:38Z"},"message":"Allow API-key auth for remote exec-server registration (#24666)\n\n## Overview\nAllow remote `codex exec-server` registration to use existing API-key\nauth while restricting where those credentials can be sent.\n\n- Accept `CodexAuth::ApiKey` for the normal `--remote` registration\npath.\n- Restrict API-key remote registration to HTTPS `openai.com` and\n`openai.org` hosts and subdomains, with explicit HTTP loopback support\nfor local development.\n- Disable registry registration redirects so credentials cannot be\nforwarded to an unvalidated destination.\n- Retain `--use-agent-identity-auth` as the explicit Agent Identity\npath.\n- Document remote registration using `CODEX_API_KEY`.\n\n## Big picture\nCallers can now provide an API key directly to `exec-server`\nregistration without first establishing ChatGPT login state:\n\n```sh\nCODEX_API_KEY=\"$OPENAI_API_KEY\" \\\ncodex exec-server \\\n  --remote \"https://<host>.openai.org/api\" \\\n  --environment-id \"$ENVIRONMENT_ID\"\n```\n\n## Validation\n- `cargo fmt --all` (`just fmt` is not installed on this host)\n- `cargo test -p codex-cli -p codex-exec-server`","tree":{"sha":"acf10f419a714a0bfc247d54b1ec034c9b6d09d1","url":"https://api.github.com/repos/openai/codex/git/trees/acf10f419a714a0bfc247d54b1ec034c9b6d09d1"},"url":"https://api.github.com/repos/openai/codex/git/commits/c57dee98b7e70f306d2981f9075dde1d1b9a90e7","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqF19yCRC1aQ7uu5UhlAAA3FUQADcp8SP39Dgma5RSvo+Y3fGd\na2sM1o2UgPBp4xXWPFgErY+kbnmvBP3DSdL4YXt+G5yXk96pUp2xSwqQtknigphf\nXtrI1uFdAsZDntZqtWAwLlGp44VliUUUaBNH4U6y0MhNFuXkeiH+PAMgjT5GnAZM\nO4WKujbu0Ke9f4rr/Sk4tOxDhshj2JunFq9VLrtnO3fv1RcQVgc6cj4NJv8KwN8X\nOo2+Aq9CZpSYx4Lno4pXTjKDx/glh9QG6W3pyzYtXNjOBxGOxPrcOevBIaJMRn/5\n7BL20nghaW7KpBtERkqQqghsiE9e2SwXtoRN/x9by9OyDcGuaFAtJUoHJ/rNGG21\nBZNrSRo1QTB8lhyvRaev+UxQ6AWaktJwAJWH+AYatgKwJMj5H1GoUbZkKs7RTHDf\nNyhaHb9xx/xf806St8jminkHsGqg+QhwxueiOsM8Ypc5ScPZEuGl1FpVJYxX/Uj3\nlXMLarvgcVgxfFji0N4QAsp5KuB6YmBT618AE3mIGUEDuj/DJmFSga9DDp0ZXshn\n+vCXsITcTYubWHYnGVzcVi9TgqU+PGPbo0fyx0aiC7rnWnoFWlRTpzy1pXs0e5NA\ndHszJ3lo+RUYKHjZaJNracv17k4OooUrvm+sWWv5HxBnyUnBQ4P8Nd2A5ZilsAYr\naoEaArRB6Ruayx9tFuWP\n=Mu/7\n-----END PGP SIGNATURE-----\n","payload":"tree acf10f419a714a0bfc247d54b1ec034c9b6d09d1\nparent 26c9502121028a7b20de2636123fbbed26efedc6\nauthor Steve Coffey <stevendcoffey@gmail.com> 1779916658 -0700\ncommitter GitHub <noreply@github.com> 1779916658 +0000\n\nAllow API-key auth for remote exec-server registration (#24666)\n\n## Overview\nAllow remote `codex exec-server` registration to use existing API-key\nauth while restricting where those credentials can be sent.\n\n- Accept `CodexAuth::ApiKey` for the normal `--remote` registration\npath.\n- Restrict API-key remote registration to HTTPS `openai.com` and\n`openai.org` hosts and subdomains, with explicit HTTP loopback support\nfor local development.\n- Disable registry registration redirects so credentials cannot be\nforwarded to an unvalidated destination.\n- Retain `--use-agent-identity-auth` as the explicit Agent Identity\npath.\n- Document remote registration using `CODEX_API_KEY`.\n\n## Big picture\nCallers can now provide an API key directly to `exec-server`\nregistration without first establishing ChatGPT login state:\n\n```sh\nCODEX_API_KEY=\"$OPENAI_API_KEY\" \\\ncodex exec-server \\\n  --remote \"https://<host>.openai.org/api\" \\\n  --environment-id \"$ENVIRONMENT_ID\"\n```\n\n## Validation\n- `cargo fmt --all` (`just fmt` is not installed on this host)\n- `cargo test -p codex-cli -p codex-exec-server`","verified_at":"2026-05-27T21:17:39Z"}},"url":"https://api.github.com/repos/openai/codex/commits/c57dee98b7e70f306d2981f9075dde1d1b9a90e7","html_url":"https://github.com/openai/codex/commit/c57dee98b7e70f306d2981f9075dde1d1b9a90e7","comments_url":"https://api.github.com/repos/openai/codex/commits/c57dee98b7e70f306d2981f9075dde1d1b9a90e7/comments","author":{"login":"sdcoffey","id":3506415,"node_id":"MDQ6VXNlcjM1MDY0MTU=","avatar_url":"https://avatars.githubusercontent.com/u/3506415?v=4","gravatar_id":"","url":"https://api.github.com/users/sdcoffey","html_url":"https://github.com/sdcoffey","followers_url":"https://api.github.com/users/sdcoffey/followers","following_url":"https://api.github.com/users/sdcoffey/following{/other_user}","gists_url":"https://api.github.com/users/sdcoffey/gists{/gist_id}","starred_url":"https://api.github.com/users/sdcoffey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sdcoffey/subscriptions","organizations_url":"https://api.github.com/users/sdcoffey/orgs","repos_url":"https://api.github.com/users/sdcoffey/repos","events_url":"https://api.github.com/users/sdcoffey/events{/privacy}","received_events_url":"https://api.github.com/users/sdcoffey/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"26c9502121028a7b20de2636123fbbed26efedc6","url":"https://api.github.com/repos/openai/codex/commits/26c9502121028a7b20de2636123fbbed26efedc6","html_url":"https://github.com/openai/codex/commit/26c9502121028a7b20de2636123fbbed26efedc6"}]},{"sha":"26c9502121028a7b20de2636123fbbed26efedc6","node_id":"C_kwDOOYsS4doAKDI2Yzk1MDIxMjEwMjhhN2IyMGRlMjYzNjEyM2ZiYmVkMjZlZmVkYzY","commit":{"author":{"name":"Felipe Coury","email":"felipe.coury@openai.com","date":"2026-05-27T20:27:55Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T20:27:55Z"},"message":"feat(tui): render cramped markdown tables as key-value records [2 of 2] (#24636)\n\n## Stack\n\n- **Base: #24489 [1 of 2]** - render markdown tables in app style.\n- **Current: #24636 [2 of 2]** - render cramped markdown tables as\nkey/value records.\n\nReview this PR against `fcoury/app-style-markdown-tables`; it contains\nonly the fallback behavior for cramped tables.\n\n## Why\n\nThe row-separated markdown table rendering in #24489 remains readable\nwhile columns have usable room. Once long links or multiple prose-heavy\ncolumns are compressed into narrow allocations, however, the grid can\nturn words and paths into tall vertical strips that are difficult to\nscan. In those cases the content matters more than preserving the grid\nshape.\n\n## What Changed\n\n<table>\n<tr><td>\n<p align=\"center\"><b>\nNormal\n</b></p>\n<img width=\"1722\" height=\"619\" alt=\"CleanShot 2026-05-27 at 14 32 57\"\nsrc=\"https://github.com/user-attachments/assets/d04f5fbd-6064-4acd-91bd-072d19b983df\"\n/>\n</td></tr>\n<tr><td>\n<p align=\"center\"><b>\nNarrow\n</b></p>\n<img width=\"863\" height=\"1013\" alt=\"CleanShot 2026-05-27 at 14 33 12\"\nsrc=\"https://github.com/user-attachments/assets/6a7d2968-0a68-48fd-ab5d-209b3dbaf03e\"\n/>\n</td></tr>\n<tr><td>\n<p align=\"center\"><b>\nVery narrow\n</b></p>\n<img width=\"435\" height=\"746\" alt=\"CleanShot 2026-05-27 at 14 33 47\"\nsrc=\"https://github.com/user-attachments/assets/f6a59e30-b1d2-4063-9c05-43933abc77d6\"\n/>\n</td></tr>\n</table>\n\n- Detect tables whose grid allocation causes systemic token\nfragmentation or starves multiple prose-heavy columns.\n- Render those tables as repeated key/value records instead of retaining\nan unreadable grid.\n- Use aligned label/value records when there is useful horizontal room,\nand switch to a stacked narrow-record layout where each label is\nfollowed by a full-width value when width is especially constrained.\n- Preserve the themed label color, rich inline formatting, links, and\nthe existing grid presentation for tables that remain readable.\n- Add snapshot coverage for path-heavy narrow tables, prose-heavy issue\ntables, systemic compact fragmentation, and a control case that should\ncontinue to render as a grid.\n\n## How to Test\n\n1. Start Codex from this branch and render a normal multi-column\nmarkdown table at a comfortable terminal width. Confirm it still appears\nas the styled row-separated grid from #24489.\n2. Render a table containing a long linked record identifier or\nfile-like value, then narrow the terminal until the grid would split the\nvalue into vertical fragments. Confirm it switches to key/value records,\nwith labels above values at very narrow widths.\n3. Render a table with multiple prose-heavy columns, such as an issue\nsummary table with `Issue`, `Activity`, `Complexity`, and `Why start`.\nConfirm a cramped width switches to records rather than wrapping several\ncolumns into hard-to-read strips.\n4. Render a compact table where only one value wraps mildly. Confirm it\nstays in grid form rather than switching prematurely.\n\n## Validation\n\n- Ran `just test -p codex-tui` while developing the fallback and\nreviewed/accepted the intended new markdown-render snapshots. The\ncommand still reports two unrelated existing guardian feature-flag test\nfailures outside this diff.\n- Ran `just fix -p codex-tui` and `just fmt` after the Rust changes were\ncomplete.\n- `just argument-comment-lint` cannot reach source linting locally\nbecause Bazel fails while resolving LLVM sanitizer headers; touched\npositional literal callsites were inspected manually and annotated where\nneeded.","tree":{"sha":"2fb17a7792c61ac5055038a6561865bf6d19cbb1","url":"https://api.github.com/repos/openai/codex/git/trees/2fb17a7792c61ac5055038a6561865bf6d19cbb1"},"url":"https://api.github.com/repos/openai/codex/git/commits/26c9502121028a7b20de2636123fbbed26efedc6","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqF1PLCRC1aQ7uu5UhlAAAWewQABOUuEKRV3YTQPKpGmkXzRih\nhNekv3HdvMWp5lEDMXe3IShgnUWl6+LzZ3kasL2qSFPc8hMue9k6i2VTrKH4C0f1\n0cG9m6NevDJTtXy4VTf+pJKLTHpOem2iTG89vk7R8lFh+IaTAE/qHCF4UxGupMit\nGRaXcdxE5yelo4GsHc1ho0tM6v8gaBuJ7Kt5uvW4tWxT4Hlvb9HcuChn38alKfn+\nPgKLDpct2pDgTwvKJtAjNCP9QaCpzJfeQM8kuhIK0Ya6mXYEGu4ENxWnsOsdB1WX\naGUV2p2HQ6WvJj1nxvlPYwwsfqh6iTlJCpgzfmX3NpiI1bIzdTuUTbOYEeI7XeSi\ngIgF7JRP6DwgFw/niMM7unDI29ZpCt2NNm9RnPgvB6n5XwgWDKPjR4eQXVOjAvaH\nZtSxcf98IpXzSuJxXz7CtnUZ6r1etomVdSzexMvclcdZ6t4DuVKPN+9Elv0Pb2km\nllm1kSZNCFCn6DY7HGMD7YziJxbBFzhS8gVaGYuS835O/WyWoMq9Xdk8YjhgId0w\naazPJcIXX3WzsmPthjZlKTQsATkhLNXH84/R9IYgJPrNKflNtbNrSbrXS1lxr3gB\nbR7SsN3IekAYeaOBpNDKuPN9zfBxzey24ZqallqYnHVG2OYKrgU6V/Ieh4MMEvKd\njgGj5oVm7Y/pTGbwSqBw\n=Vi0h\n-----END PGP SIGNATURE-----\n","payload":"tree 2fb17a7792c61ac5055038a6561865bf6d19cbb1\nparent 7a26497836be29ec77fb8007347b33cad952b497\nauthor Felipe Coury <felipe.coury@openai.com> 1779913675 -0300\ncommitter GitHub <noreply@github.com> 1779913675 +0000\n\nfeat(tui): render cramped markdown tables as key-value records [2 of 2] (#24636)\n\n## Stack\n\n- **Base: #24489 [1 of 2]** - render markdown tables in app style.\n- **Current: #24636 [2 of 2]** - render cramped markdown tables as\nkey/value records.\n\nReview this PR against `fcoury/app-style-markdown-tables`; it contains\nonly the fallback behavior for cramped tables.\n\n## Why\n\nThe row-separated markdown table rendering in #24489 remains readable\nwhile columns have usable room. Once long links or multiple prose-heavy\ncolumns are compressed into narrow allocations, however, the grid can\nturn words and paths into tall vertical strips that are difficult to\nscan. In those cases the content matters more than preserving the grid\nshape.\n\n## What Changed\n\n<table>\n<tr><td>\n<p align=\"center\"><b>\nNormal\n</b></p>\n<img width=\"1722\" height=\"619\" alt=\"CleanShot 2026-05-27 at 14 32 57\"\nsrc=\"https://github.com/user-attachments/assets/d04f5fbd-6064-4acd-91bd-072d19b983df\"\n/>\n</td></tr>\n<tr><td>\n<p align=\"center\"><b>\nNarrow\n</b></p>\n<img width=\"863\" height=\"1013\" alt=\"CleanShot 2026-05-27 at 14 33 12\"\nsrc=\"https://github.com/user-attachments/assets/6a7d2968-0a68-48fd-ab5d-209b3dbaf03e\"\n/>\n</td></tr>\n<tr><td>\n<p align=\"center\"><b>\nVery narrow\n</b></p>\n<img width=\"435\" height=\"746\" alt=\"CleanShot 2026-05-27 at 14 33 47\"\nsrc=\"https://github.com/user-attachments/assets/f6a59e30-b1d2-4063-9c05-43933abc77d6\"\n/>\n</td></tr>\n</table>\n\n- Detect tables whose grid allocation causes systemic token\nfragmentation or starves multiple prose-heavy columns.\n- Render those tables as repeated key/value records instead of retaining\nan unreadable grid.\n- Use aligned label/value records when there is useful horizontal room,\nand switch to a stacked narrow-record layout where each label is\nfollowed by a full-width value when width is especially constrained.\n- Preserve the themed label color, rich inline formatting, links, and\nthe existing grid presentation for tables that remain readable.\n- Add snapshot coverage for path-heavy narrow tables, prose-heavy issue\ntables, systemic compact fragmentation, and a control case that should\ncontinue to render as a grid.\n\n## How to Test\n\n1. Start Codex from this branch and render a normal multi-column\nmarkdown table at a comfortable terminal width. Confirm it still appears\nas the styled row-separated grid from #24489.\n2. Render a table containing a long linked record identifier or\nfile-like value, then narrow the terminal until the grid would split the\nvalue into vertical fragments. Confirm it switches to key/value records,\nwith labels above values at very narrow widths.\n3. Render a table with multiple prose-heavy columns, such as an issue\nsummary table with `Issue`, `Activity`, `Complexity`, and `Why start`.\nConfirm a cramped width switches to records rather than wrapping several\ncolumns into hard-to-read strips.\n4. Render a compact table where only one value wraps mildly. Confirm it\nstays in grid form rather than switching prematurely.\n\n## Validation\n\n- Ran `just test -p codex-tui` while developing the fallback and\nreviewed/accepted the intended new markdown-render snapshots. The\ncommand still reports two unrelated existing guardian feature-flag test\nfailures outside this diff.\n- Ran `just fix -p codex-tui` and `just fmt` after the Rust changes were\ncomplete.\n- `just argument-comment-lint` cannot reach source linting locally\nbecause Bazel fails while resolving LLVM sanitizer headers; touched\npositional literal callsites were inspected manually and annotated where\nneeded.","verified_at":"2026-05-27T20:27:55Z"}},"url":"https://api.github.com/repos/openai/codex/commits/26c9502121028a7b20de2636123fbbed26efedc6","html_url":"https://github.com/openai/codex/commit/26c9502121028a7b20de2636123fbbed26efedc6","comments_url":"https://api.github.com/repos/openai/codex/commits/26c9502121028a7b20de2636123fbbed26efedc6/comments","author":{"login":"fcoury-oai","id":272635208,"node_id":"U_kgDOEEAVSA","avatar_url":"https://avatars.githubusercontent.com/u/272635208?v=4","gravatar_id":"","url":"https://api.github.com/users/fcoury-oai","html_url":"https://github.com/fcoury-oai","followers_url":"https://api.github.com/users/fcoury-oai/followers","following_url":"https://api.github.com/users/fcoury-oai/following{/other_user}","gists_url":"https://api.github.com/users/fcoury-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/fcoury-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fcoury-oai/subscriptions","organizations_url":"https://api.github.com/users/fcoury-oai/orgs","repos_url":"https://api.github.com/users/fcoury-oai/repos","events_url":"https://api.github.com/users/fcoury-oai/events{/privacy}","received_events_url":"https://api.github.com/users/fcoury-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7a26497836be29ec77fb8007347b33cad952b497","url":"https://api.github.com/repos/openai/codex/commits/7a26497836be29ec77fb8007347b33cad952b497","html_url":"https://github.com/openai/codex/commit/7a26497836be29ec77fb8007347b33cad952b497"}]},{"sha":"7a26497836be29ec77fb8007347b33cad952b497","node_id":"C_kwDOOYsS4doAKDdhMjY0OTc4MzZiZTI5ZWM3N2ZiODAwNzM0N2IzM2NhZDk1MmI0OTc","commit":{"author":{"name":"Felipe Coury","email":"felipe.coury@openai.com","date":"2026-05-27T20:14:55Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T20:14:55Z"},"message":"feat(tui): add OSC 8 web links to rich content (#24472)\n\n## Why\n\nWrapped URLs in rich TUI output, especially URLs rendered inside\nMarkdown tables, are split across terminal rows. In terminals that\nsupport OSC 8 hyperlinks, treating each visible fragment as part of the\ncomplete destination enables reliable open-link and copy-link actions\neven after table layout wraps the URL.\n\nThis addresses the semantic-link portion of #12200 and the behavior\ndescribed in\nhttps://github.com/openai/codex/issues/12200#issuecomment-4535452980. It\ndoes not change ordinary drag-selection across bordered table rows.\n\n## What Changed\n\n- Added shared TUI OSC 8 support that validates `http://` and `https://`\ndestinations, sanitizes terminal payloads, and applies metadata\nseparately from visible line width/layout.\n- Added semantic web-link annotations to assistant and proposed-plan\nMarkdown, including explicit web links and bare web URLs in prose and\ntable cells while excluding code and non-web Markdown destinations.\n- Preserved complete URL targets through table wrapping, narrow pipe\nfallback, streaming, transcript overlay rendering, history insertion,\nand resize replay.\n- Routed intentional Codex-owned links in notices,\nstatus/setup/app-link, feedback, onboarding, MCP/plugin help, memories,\nand update surfaces through the shared hyperlink handling.\n\n## How to Test\n\n1. Run Codex in a terminal with OSC 8 link support, such as Ghostty, and\nrequest an assistant response containing a Markdown table whose last\ncolumn contains a long `https://` URL.\n2. Make the terminal narrow enough for the URL to wrap across multiple\nbordered table rows.\n3. Use the terminal's open-link or copy-link action on more than one\nwrapped URL fragment and confirm each fragment resolves to the complete\noriginal URL.\n4. Resize the terminal after the table is rendered and repeat the link\naction to confirm the destination survives scrollback replay.\n5. Open the transcript overlay while rich output is present and confirm\nweb links remain interactive there.\n6. As a regression check, render inline/fenced code containing URL text\nand a Markdown link such as\n`[https://example.com](mailto:support@example.com)`; confirm these do\nnot acquire a web OSC 8 destination.\n\nTargeted automated coverage exercised Markdown links and exclusions,\nwrapped and pipe-fallback tables, streaming/transcript overlay\npropagation, status-link truncation, and rendered word-wrapping cell\nalignment. `just test -p codex-tui` was also run; it passed the\nhyperlink coverage and reproduced two unrelated existing guardian\nfeature-flag test failures.","tree":{"sha":"26b6a45c31782ab9086bc3d3b5ab74056016cd34","url":"https://api.github.com/repos/openai/codex/git/trees/26b6a45c31782ab9086bc3d3b5ab74056016cd34"},"url":"https://api.github.com/repos/openai/codex/git/commits/7a26497836be29ec77fb8007347b33cad952b497","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqF1C/CRC1aQ7uu5UhlAAAahAQAG7WVuHGR7miOg1j+sM3uGr8\ntH7TO/ifhobaFixRaGssGVXxiomcXpRDavuUE8TZ5/ljS6MfwrPVkUL0IXMP+330\nEDAsntrR7i4RQopWG8DI1BrxLFbLk3fvAipvU2+TBh8GbObnQa7yvaLVdoBXjVrU\n6bAYQAVPM9RYHUBqvrsf2171ts7HNV2ZC39xJSjKQyDwUkdm5/eOHcEsNchuW+1M\nlxF9mMQjP/YrJis3bZocFytOy+WZe1ZATxXW8u62eYZrSYbv6IA1uAjpzRenjkpI\nhT/ry4tjCpPAVfN7h5G5co9+e1an+RnTyZxCn4w5v/GrOI9eN9q2of/gAkix9Zjg\n+MElW9CY232pUCH/tK2RPQnfTnA07lSXtqrm/p7QVAih7lDJzQMDwcJRRAWSunq0\nCeYT4RYXmSNQYIMe9gCRAjRHpHf2zGqpvp/hZrgLpjkQdL5DJ+nOfReSI273F6ux\n4wXgwNxBoPkc6GNYvUzPYKmN0fmjTkWkWGKFlwisrdQJu+WufsjI6zLnwsgKeqY0\nEh56zDmIGjx5xz08BFHQqmcHpjlkjeSdC8TAW4nIdymQBpVCeqXvMER0cbkHNXOk\n65r4JnIOvy+NpHTI4KyIlGZTVC2A44TeQqJ4HzIZQbnz0hOHiKU2vhGggy2zMh/N\nTob1Ruhz0Exw1lbHb7dq\n=T4Or\n-----END PGP SIGNATURE-----\n","payload":"tree 26b6a45c31782ab9086bc3d3b5ab74056016cd34\nparent 9152ebd289f2d9103ffc41c2fec69f6c623a6eab\nauthor Felipe Coury <felipe.coury@openai.com> 1779912895 -0300\ncommitter GitHub <noreply@github.com> 1779912895 +0000\n\nfeat(tui): add OSC 8 web links to rich content (#24472)\n\n## Why\n\nWrapped URLs in rich TUI output, especially URLs rendered inside\nMarkdown tables, are split across terminal rows. In terminals that\nsupport OSC 8 hyperlinks, treating each visible fragment as part of the\ncomplete destination enables reliable open-link and copy-link actions\neven after table layout wraps the URL.\n\nThis addresses the semantic-link portion of #12200 and the behavior\ndescribed in\nhttps://github.com/openai/codex/issues/12200#issuecomment-4535452980. It\ndoes not change ordinary drag-selection across bordered table rows.\n\n## What Changed\n\n- Added shared TUI OSC 8 support that validates `http://` and `https://`\ndestinations, sanitizes terminal payloads, and applies metadata\nseparately from visible line width/layout.\n- Added semantic web-link annotations to assistant and proposed-plan\nMarkdown, including explicit web links and bare web URLs in prose and\ntable cells while excluding code and non-web Markdown destinations.\n- Preserved complete URL targets through table wrapping, narrow pipe\nfallback, streaming, transcript overlay rendering, history insertion,\nand resize replay.\n- Routed intentional Codex-owned links in notices,\nstatus/setup/app-link, feedback, onboarding, MCP/plugin help, memories,\nand update surfaces through the shared hyperlink handling.\n\n## How to Test\n\n1. Run Codex in a terminal with OSC 8 link support, such as Ghostty, and\nrequest an assistant response containing a Markdown table whose last\ncolumn contains a long `https://` URL.\n2. Make the terminal narrow enough for the URL to wrap across multiple\nbordered table rows.\n3. Use the terminal's open-link or copy-link action on more than one\nwrapped URL fragment and confirm each fragment resolves to the complete\noriginal URL.\n4. Resize the terminal after the table is rendered and repeat the link\naction to confirm the destination survives scrollback replay.\n5. Open the transcript overlay while rich output is present and confirm\nweb links remain interactive there.\n6. As a regression check, render inline/fenced code containing URL text\nand a Markdown link such as\n`[https://example.com](mailto:support@example.com)`; confirm these do\nnot acquire a web OSC 8 destination.\n\nTargeted automated coverage exercised Markdown links and exclusions,\nwrapped and pipe-fallback tables, streaming/transcript overlay\npropagation, status-link truncation, and rendered word-wrapping cell\nalignment. `just test -p codex-tui` was also run; it passed the\nhyperlink coverage and reproduced two unrelated existing guardian\nfeature-flag test failures.","verified_at":"2026-05-27T20:14:55Z"}},"url":"https://api.github.com/repos/openai/codex/commits/7a26497836be29ec77fb8007347b33cad952b497","html_url":"https://github.com/openai/codex/commit/7a26497836be29ec77fb8007347b33cad952b497","comments_url":"https://api.github.com/repos/openai/codex/commits/7a26497836be29ec77fb8007347b33cad952b497/comments","author":{"login":"fcoury-oai","id":272635208,"node_id":"U_kgDOEEAVSA","avatar_url":"https://avatars.githubusercontent.com/u/272635208?v=4","gravatar_id":"","url":"https://api.github.com/users/fcoury-oai","html_url":"https://github.com/fcoury-oai","followers_url":"https://api.github.com/users/fcoury-oai/followers","following_url":"https://api.github.com/users/fcoury-oai/following{/other_user}","gists_url":"https://api.github.com/users/fcoury-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/fcoury-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fcoury-oai/subscriptions","organizations_url":"https://api.github.com/users/fcoury-oai/orgs","repos_url":"https://api.github.com/users/fcoury-oai/repos","events_url":"https://api.github.com/users/fcoury-oai/events{/privacy}","received_events_url":"https://api.github.com/users/fcoury-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"9152ebd289f2d9103ffc41c2fec69f6c623a6eab","url":"https://api.github.com/repos/openai/codex/commits/9152ebd289f2d9103ffc41c2fec69f6c623a6eab","html_url":"https://github.com/openai/codex/commit/9152ebd289f2d9103ffc41c2fec69f6c623a6eab"}]},{"sha":"9152ebd289f2d9103ffc41c2fec69f6c623a6eab","node_id":"C_kwDOOYsS4doAKDkxNTJlYmQyODlmMmQ5MTAzZmZjNDFjMmZlYzY5ZjZjNjIzYTZlYWI","commit":{"author":{"name":"viyatb-oai","email":"viyatb@openai.com","date":"2026-05-27T19:59:11Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T19:59:11Z"},"message":"fix(linux-sandbox): preserve shell cleanup on interruption (#22729)\n\n## Why\nInterrupted `shell_command` calls can race with the outer tool-dispatch\ncancellation path. When that happens, the runtime future may be dropped\nbefore the spawned process gets a chance to run `SIGTERM` cleanup. For\nbwrapd-backed Linux sandbox commands, that can leave synthetic\nprotected-path mount bookkeeping such as `.git/.codex` registrations\nunder `/tmp` behind after a TUI interruption.\n\nThe relevant cancellation points are the outer dispatch race in\n[`core/src/tools/parallel.rs`](https://github.com/openai/codex/blob/bd184ba84703cc924921ed883f0cf17d3dba60ff/codex-rs/core/src/tools/parallel.rs#L91-L132)\nand the process shutdown logic in\n[`core/src/exec.rs`](https://github.com/openai/codex/blob/bd184ba84703cc924921ed883f0cf17d3dba60ff/codex-rs/core/src/exec.rs#L1367-L1393).\n\n## What changed\n- Keep `shell_command` dispatch alive long enough for the runtime to\nfinish cancellation cleanup instead of immediately returning the\nsynthetic aborted response.\n- Fold shell-turn cancellation into the existing `ExecExpiration` path\nin\n[`core/src/tools/runtimes/shell.rs`](https://github.com/openai/codex/blob/bd184ba84703cc924921ed883f0cf17d3dba60ff/codex-rs/core/src/tools/runtimes/shell.rs#L267-L274),\nso cancellation and timeout behavior stay centralized.\n- On cancellation, send `SIGTERM` first, wait briefly for cleanup to\nrun, then hard-kill any remaining descendants in the original process\ngroup.\n- Treat `ESRCH` as an already-gone process-group cleanup case in\n`codex-utils-pty`, which keeps best-effort teardown from surfacing a\nstale-process race as an error.\n\n## Verification\n- `cargo test -p codex-core cancellation`\n- Added regression coverage for:\n  - `shell_tool_cancellation_waits_for_runtime_cleanup`\n  - `process_exec_tool_call_cancellation_allows_sigterm_cleanup`","tree":{"sha":"d67e5825218979aa186b5f2bce857577e9ab26f2","url":"https://api.github.com/repos/openai/codex/git/trees/d67e5825218979aa186b5f2bce857577e9ab26f2"},"url":"https://api.github.com/repos/openai/codex/git/commits/9152ebd289f2d9103ffc41c2fec69f6c623a6eab","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqF00PCRC1aQ7uu5UhlAAAt7QQAKCr2B7UeecuuBo/8UHHpAIX\nCX5cFYOMOjDoRFRFJUPuivipQZmybNPyWLwp1LzXHCM6D1dhNFt8bDs87lvH4HzV\nbsa/Nahm82khRn7LB+CWNcApd3TMHGmD4noPG4xh7LBVjPUPAs9k8lYGU6Y8hN/E\nGbq/8GRlqdzmOTd82fsT1TUSpL+mp7Z+QJQnj5veaScEBdBPw9vPa0jYXe/eY/St\nYYfoegjqAjXTfVAJNIEvRtyhJCC4cAz/x80JAnk78iRcwbNjFNrHxCQYuMlVeS+d\n8fW3DphYdTpqiElWtcnIJAA8+jgJed8dweRiZW1e+StRZbmu2RI8T5UUphJgLf8W\nMsMuc8kMtIOHG5TaorYZf/f7EoWylaJon9QV7ghfWqzlkknbIxgPGC/h+5wHxGPh\nij0sbYv7UN6TB33faPPeOiDksR9cxp5m4d0QsY9TfdIxL+9yDhQl7grMHtaJfgZM\niw0NJeyQqH/4GAYeaYroFoBZLbVKKHwq1rZiG3aivMMDPrfy23UccVkILddG5cXy\n87iwJk45Nhs8+lYMuAEBq1oZwF+rcaHCQROnVm+xs6bHuv0zRpHPB+aaOe8IdR9q\nKuGzo7snRH2yCsQ8hhA49NcfIYCNNbQAIZkLGfeKcswhz+hUWbbKH8Ko+XukgQNU\nPuARt46MJT0DSBaoQK/i\n=ye9w\n-----END PGP SIGNATURE-----\n","payload":"tree d67e5825218979aa186b5f2bce857577e9ab26f2\nparent 07a930138f675a1ccdd15339f74bb337f9f02398\nauthor viyatb-oai <viyatb@openai.com> 1779911951 -0700\ncommitter GitHub <noreply@github.com> 1779911951 -0700\n\nfix(linux-sandbox): preserve shell cleanup on interruption (#22729)\n\n## Why\nInterrupted `shell_command` calls can race with the outer tool-dispatch\ncancellation path. When that happens, the runtime future may be dropped\nbefore the spawned process gets a chance to run `SIGTERM` cleanup. For\nbwrapd-backed Linux sandbox commands, that can leave synthetic\nprotected-path mount bookkeeping such as `.git/.codex` registrations\nunder `/tmp` behind after a TUI interruption.\n\nThe relevant cancellation points are the outer dispatch race in\n[`core/src/tools/parallel.rs`](https://github.com/openai/codex/blob/bd184ba84703cc924921ed883f0cf17d3dba60ff/codex-rs/core/src/tools/parallel.rs#L91-L132)\nand the process shutdown logic in\n[`core/src/exec.rs`](https://github.com/openai/codex/blob/bd184ba84703cc924921ed883f0cf17d3dba60ff/codex-rs/core/src/exec.rs#L1367-L1393).\n\n## What changed\n- Keep `shell_command` dispatch alive long enough for the runtime to\nfinish cancellation cleanup instead of immediately returning the\nsynthetic aborted response.\n- Fold shell-turn cancellation into the existing `ExecExpiration` path\nin\n[`core/src/tools/runtimes/shell.rs`](https://github.com/openai/codex/blob/bd184ba84703cc924921ed883f0cf17d3dba60ff/codex-rs/core/src/tools/runtimes/shell.rs#L267-L274),\nso cancellation and timeout behavior stay centralized.\n- On cancellation, send `SIGTERM` first, wait briefly for cleanup to\nrun, then hard-kill any remaining descendants in the original process\ngroup.\n- Treat `ESRCH` as an already-gone process-group cleanup case in\n`codex-utils-pty`, which keeps best-effort teardown from surfacing a\nstale-process race as an error.\n\n## Verification\n- `cargo test -p codex-core cancellation`\n- Added regression coverage for:\n  - `shell_tool_cancellation_waits_for_runtime_cleanup`\n  - `process_exec_tool_call_cancellation_allows_sigterm_cleanup`","verified_at":"2026-05-27T19:59:12Z"}},"url":"https://api.github.com/repos/openai/codex/commits/9152ebd289f2d9103ffc41c2fec69f6c623a6eab","html_url":"https://github.com/openai/codex/commit/9152ebd289f2d9103ffc41c2fec69f6c623a6eab","comments_url":"https://api.github.com/repos/openai/codex/commits/9152ebd289f2d9103ffc41c2fec69f6c623a6eab/comments","author":{"login":"viyatb-oai","id":234056686,"node_id":"U_kgDODfNr7g","avatar_url":"https://avatars.githubusercontent.com/u/234056686?v=4","gravatar_id":"","url":"https://api.github.com/users/viyatb-oai","html_url":"https://github.com/viyatb-oai","followers_url":"https://api.github.com/users/viyatb-oai/followers","following_url":"https://api.github.com/users/viyatb-oai/following{/other_user}","gists_url":"https://api.github.com/users/viyatb-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/viyatb-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/viyatb-oai/subscriptions","organizations_url":"https://api.github.com/users/viyatb-oai/orgs","repos_url":"https://api.github.com/users/viyatb-oai/repos","events_url":"https://api.github.com/users/viyatb-oai/events{/privacy}","received_events_url":"https://api.github.com/users/viyatb-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"07a930138f675a1ccdd15339f74bb337f9f02398","url":"https://api.github.com/repos/openai/codex/commits/07a930138f675a1ccdd15339f74bb337f9f02398","html_url":"https://github.com/openai/codex/commit/07a930138f675a1ccdd15339f74bb337f9f02398"}]},{"sha":"07a930138f675a1ccdd15339f74bb337f9f02398","node_id":"C_kwDOOYsS4doAKDA3YTkzMDEzOGY2NzVhMWNjZGQxNTMzOWY3NGJiMzM3ZjlmMDIzOTg","commit":{"author":{"name":"Celia Chen","email":"celia@openai.com","date":"2026-05-27T19:39:01Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T19:39:01Z"},"message":"chore: enable namespace tools for Bedrock (#24713)\n\nClient-side namespace tools are now supported by bedrock. Enable\n`namespace_tools` for the Amazon Bedrock provider while continuing to\ndisable unsupported hosted tools such as image generation and web\nsearch.","tree":{"sha":"27bc7bff64e121aa75e68448e62b62dc37049561","url":"https://api.github.com/repos/openai/codex/git/trees/27bc7bff64e121aa75e68448e62b62dc37049561"},"url":"https://api.github.com/repos/openai/codex/git/commits/07a930138f675a1ccdd15339f74bb337f9f02398","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqF0hVCRC1aQ7uu5UhlAAABlsQAFwUseO1DAQ/cDaGeF3ozc24\nNhgQWhiVsz41SqF5Yp0aCwaciAtL2j4xsvmxyCSbNaaDmXXWdJOluJkFYGhxx3Mk\nYrhZEyKFUi9IqzMirRcS1tCCGnPbHQFQpLwd536cVXUfaIyxAW0770L5vCaDpJtL\nmy52pqh8QVY2cvldmGkaGDS1+QU5XJVrN+waumGf+gca4i7mG8ZmrB3svgoxiwWB\nZJIB9tfT1QXMT+/z3T2yHW5+9nmkQCIpLAxLIFr7jXRf6q42Iyub1bMqHkJtqLiv\nc48YOpf4i7KDSW0m4MSd74KYLM0c6SK/Jf+Ozc1uv+Iv/9MxDTv2KKol4V/K2xyP\nYfieuljW5LAYN332KFwFH94pVH200cwVJxmNdcKCOlJZbyZ3arFKwLc3OjC9T8vD\ncJqI16/62SfaCi9XXQMLJtkOjYg2DiB8j62msePWF+PIb+oBbeRqwCb3gNke4qdm\nAZprfvrFxaLmsa0QpEeEwpunQmH552Mx1zf7l6h3YVadtkJz4dR+UEYZkTIccy2W\nV3Dnv7NTu+eECPgOsbKXqPHCsQ+kYlr2q23HXalUeHF/5tWP6J/YDT10Lv4fq+3C\nZu72K3wcmTJ9IYECkXA9LCYpVO3b69A7xaxod2otrYtk3nKjtkzlz/hBtQYZi2Z4\nzHkCHOOYzvVxxqKc74FR\n=uwND\n-----END PGP SIGNATURE-----\n","payload":"tree 27bc7bff64e121aa75e68448e62b62dc37049561\nparent 6b4b15a1ed2271c2b35d7e73bdf532cf11e33388\nauthor Celia Chen <celia@openai.com> 1779910741 -0700\ncommitter GitHub <noreply@github.com> 1779910741 +0000\n\nchore: enable namespace tools for Bedrock (#24713)\n\nClient-side namespace tools are now supported by bedrock. Enable\n`namespace_tools` for the Amazon Bedrock provider while continuing to\ndisable unsupported hosted tools such as image generation and web\nsearch.","verified_at":"2026-05-27T19:39:02Z"}},"url":"https://api.github.com/repos/openai/codex/commits/07a930138f675a1ccdd15339f74bb337f9f02398","html_url":"https://github.com/openai/codex/commit/07a930138f675a1ccdd15339f74bb337f9f02398","comments_url":"https://api.github.com/repos/openai/codex/commits/07a930138f675a1ccdd15339f74bb337f9f02398/comments","author":{"login":"celia-oai","id":209693228,"node_id":"U_kgDODH-qLA","avatar_url":"https://avatars.githubusercontent.com/u/209693228?v=4","gravatar_id":"","url":"https://api.github.com/users/celia-oai","html_url":"https://github.com/celia-oai","followers_url":"https://api.github.com/users/celia-oai/followers","following_url":"https://api.github.com/users/celia-oai/following{/other_user}","gists_url":"https://api.github.com/users/celia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/celia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celia-oai/subscriptions","organizations_url":"https://api.github.com/users/celia-oai/orgs","repos_url":"https://api.github.com/users/celia-oai/repos","events_url":"https://api.github.com/users/celia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/celia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"6b4b15a1ed2271c2b35d7e73bdf532cf11e33388","url":"https://api.github.com/repos/openai/codex/commits/6b4b15a1ed2271c2b35d7e73bdf532cf11e33388","html_url":"https://github.com/openai/codex/commit/6b4b15a1ed2271c2b35d7e73bdf532cf11e33388"}]},{"sha":"6b4b15a1ed2271c2b35d7e73bdf532cf11e33388","node_id":"C_kwDOOYsS4doAKDZiNGIxNWExZWQyMjcxYzJiMzVkN2U3M2JkZjUzMmNmMTFlMzMzODg","commit":{"author":{"name":"Felipe Coury","email":"felipe.coury@openai.com","date":"2026-05-27T19:18:24Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T19:18:24Z"},"message":"feat(tui): render markdown tables in app style [1 of 2] (#24489)\n\n## Stack\n\n- **Current: #24489 [1 of 2]** - render markdown tables in app style.\n- **Stacked follow-up: #24636 [2 of 2]** - render cramped markdown\ntables as key/value records.\n\n## Why\n\nMarkdown tables currently render as boxed terminal grids, which gives\nordinary assistant output a heavier visual treatment than surrounding\nrich text. This row-separated layout is the best match for how the App\nrenders tables, while accented headers remain distinguishable even when\na terminal font renders bold subtly.\n\n<table>\n<tr><td>\n<p align=\"center\">Codex CLI - Before</p>\n<img width=\"1722\" height=\"742\" alt=\"CleanShot 2026-05-25 at 18 46 17\"\nsrc=\"https://github.com/user-attachments/assets/f673d92a-ebd8-46e2-b414-3d985e41b6a4\"\n/>\n</td></tr>\n<tr><td>\n<p align=\"center\">Codex CLI - After</p>\n<img width=\"1720\" height=\"957\" alt=\"image\"\nsrc=\"https://github.com/user-attachments/assets/36a3d331-bea1-439b-b5be-e97b0731bd6f\"\n/>\n</td></tr>\n<tr><td>\n<p align=\"center\">Codex App</p>\n<img width=\"979\" height=\"1293\" alt=\"CleanShot 2026-05-25 at 18 45 04\"\nsrc=\"https://github.com/user-attachments/assets/7d97cae0-9256-4f6e-a4b3-8b8f22b0d901\"\n/>\n</td></tr>\n</table>\n\n## What Changed\n\n- Render markdown tables as padded, aligned rows without an enclosing\nbox.\n- Style table headers with the active syntax-theme accent plus bold\ntext, while keeping separators low contrast and theme-aware.\n- Use a segmented heavy header rule and thin body-row rules, preserving\nwrapping, narrow-width fallback, streaming parity, and rich-history\nrendering.\n- Update focused assertions and snapshots for the final table layout.\n\n## How to Test\n\n1. Render a markdown table in the TUI with several rows and columns.\n2. Confirm the header uses the active theme accent, rows use\none-character interior padding, and the table has no enclosing box.\n3. Confirm the header is followed by segmented `━` rules and multiple\nbody rows are separated by muted segmented `─` rules.\n4. Render the same table while streaming and in history/raw-mode\ntoggles; the final rich layout should remain stable.\n5. Render a narrow table with long content and verify wrapping or pipe\nfallback does not overflow.\n\n## Validation\n\n- `just test -p codex-tui table`\n- `just test -p codex-tui streaming::controller::tests`\n- `just argument-comment-lint-from-source -p codex-tui -- --all-targets`\n- `just fix -p codex-tui`\n- `just fmt`\n\n`just test -p codex-tui` was also run after accepting the snapshots; it\nfails only in the unrelated existing guardian app tests\n`update_feature_flags_disabling_guardian_clears_review_policy_and_restores_default`\nand\n`update_feature_flags_disabling_guardian_clears_manual_review_policy_without_history`.","tree":{"sha":"7d707af49b7e505fce0e6d2b24c66750730ad41b","url":"https://api.github.com/repos/openai/codex/git/trees/7d707af49b7e505fce0e6d2b24c66750730ad41b"},"url":"https://api.github.com/repos/openai/codex/git/commits/6b4b15a1ed2271c2b35d7e73bdf532cf11e33388","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqF0OACRC1aQ7uu5UhlAAAZtQQAJxCF9XcxLZMPWfr1OY9AV9y\n63L0dQ2AWDCwbu1G2ft2+vdYRLdSxyubZrPeX50uxqzqv/QK+744OiY3FdcqA1kv\n6tvyJgpQuUwdbBzFE0kZKH+tfYHVZXTejYDEKIUjRCmQAC0ekyYAhf2TB1jlsPG0\nBWR88bGwiAfcmu1rq7x2m7EeqNYoa7bQ98WnnHFqxEhokDQ7DQYM/8+w2ND9zwj6\nytw5k/omTPUQqy0tgSAS+VMJa4atcWDiMg1FgtP6lFsAYIOuVvgUa9TcOI4HiWCR\nNVQldb3+GlHRgutw6lukr4Posck85J+1bkTYIWNxG43w5TbyK7B0Znv+FCoA2K1C\nP79a7RUtHDpjyDfZyI7XFk0QX5XzAv0gP6DJrNleaQai5tZqUv3F8HPYHdKwRDRj\n7yrIwsb02UbUAG2HUpSjrRBKXz+U6B5lHDUf3/7xOQfeJg2gfyeEKdGLIouew7TF\n8F0p2ZqOTMJgDTtjJfYYrlx/xAip0lNscM3WIEK604OEupIqPQ9RFtXzZwD9cmm6\nLQo5A9gt4fRXJNDOl6jTZBojVcZ5LHnYZW7rmdl2Zd4/StqFyJ/IjmQqEgccNYo4\nUhdNdSKEHhcPekt+n44qsi2bVx5Qy2qke/GnEiMT/Zql+zJ0+a26/gY/lUcEFqsw\n0OXe+2of1qIsOQbl4vqV\n=2MBo\n-----END PGP SIGNATURE-----\n","payload":"tree 7d707af49b7e505fce0e6d2b24c66750730ad41b\nparent 2d1ad374a7d2469e6bc889d4cdf7bfb58d82b436\nauthor Felipe Coury <felipe.coury@openai.com> 1779909504 -0300\ncommitter GitHub <noreply@github.com> 1779909504 -0300\n\nfeat(tui): render markdown tables in app style [1 of 2] (#24489)\n\n## Stack\n\n- **Current: #24489 [1 of 2]** - render markdown tables in app style.\n- **Stacked follow-up: #24636 [2 of 2]** - render cramped markdown\ntables as key/value records.\n\n## Why\n\nMarkdown tables currently render as boxed terminal grids, which gives\nordinary assistant output a heavier visual treatment than surrounding\nrich text. This row-separated layout is the best match for how the App\nrenders tables, while accented headers remain distinguishable even when\na terminal font renders bold subtly.\n\n<table>\n<tr><td>\n<p align=\"center\">Codex CLI - Before</p>\n<img width=\"1722\" height=\"742\" alt=\"CleanShot 2026-05-25 at 18 46 17\"\nsrc=\"https://github.com/user-attachments/assets/f673d92a-ebd8-46e2-b414-3d985e41b6a4\"\n/>\n</td></tr>\n<tr><td>\n<p align=\"center\">Codex CLI - After</p>\n<img width=\"1720\" height=\"957\" alt=\"image\"\nsrc=\"https://github.com/user-attachments/assets/36a3d331-bea1-439b-b5be-e97b0731bd6f\"\n/>\n</td></tr>\n<tr><td>\n<p align=\"center\">Codex App</p>\n<img width=\"979\" height=\"1293\" alt=\"CleanShot 2026-05-25 at 18 45 04\"\nsrc=\"https://github.com/user-attachments/assets/7d97cae0-9256-4f6e-a4b3-8b8f22b0d901\"\n/>\n</td></tr>\n</table>\n\n## What Changed\n\n- Render markdown tables as padded, aligned rows without an enclosing\nbox.\n- Style table headers with the active syntax-theme accent plus bold\ntext, while keeping separators low contrast and theme-aware.\n- Use a segmented heavy header rule and thin body-row rules, preserving\nwrapping, narrow-width fallback, streaming parity, and rich-history\nrendering.\n- Update focused assertions and snapshots for the final table layout.\n\n## How to Test\n\n1. Render a markdown table in the TUI with several rows and columns.\n2. Confirm the header uses the active theme accent, rows use\none-character interior padding, and the table has no enclosing box.\n3. Confirm the header is followed by segmented `━` rules and multiple\nbody rows are separated by muted segmented `─` rules.\n4. Render the same table while streaming and in history/raw-mode\ntoggles; the final rich layout should remain stable.\n5. Render a narrow table with long content and verify wrapping or pipe\nfallback does not overflow.\n\n## Validation\n\n- `just test -p codex-tui table`\n- `just test -p codex-tui streaming::controller::tests`\n- `just argument-comment-lint-from-source -p codex-tui -- --all-targets`\n- `just fix -p codex-tui`\n- `just fmt`\n\n`just test -p codex-tui` was also run after accepting the snapshots; it\nfails only in the unrelated existing guardian app tests\n`update_feature_flags_disabling_guardian_clears_review_policy_and_restores_default`\nand\n`update_feature_flags_disabling_guardian_clears_manual_review_policy_without_history`.","verified_at":"2026-05-27T19:18:24Z"}},"url":"https://api.github.com/repos/openai/codex/commits/6b4b15a1ed2271c2b35d7e73bdf532cf11e33388","html_url":"https://github.com/openai/codex/commit/6b4b15a1ed2271c2b35d7e73bdf532cf11e33388","comments_url":"https://api.github.com/repos/openai/codex/commits/6b4b15a1ed2271c2b35d7e73bdf532cf11e33388/comments","author":{"login":"fcoury-oai","id":272635208,"node_id":"U_kgDOEEAVSA","avatar_url":"https://avatars.githubusercontent.com/u/272635208?v=4","gravatar_id":"","url":"https://api.github.com/users/fcoury-oai","html_url":"https://github.com/fcoury-oai","followers_url":"https://api.github.com/users/fcoury-oai/followers","following_url":"https://api.github.com/users/fcoury-oai/following{/other_user}","gists_url":"https://api.github.com/users/fcoury-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/fcoury-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fcoury-oai/subscriptions","organizations_url":"https://api.github.com/users/fcoury-oai/orgs","repos_url":"https://api.github.com/users/fcoury-oai/repos","events_url":"https://api.github.com/users/fcoury-oai/events{/privacy}","received_events_url":"https://api.github.com/users/fcoury-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"2d1ad374a7d2469e6bc889d4cdf7bfb58d82b436","url":"https://api.github.com/repos/openai/codex/commits/2d1ad374a7d2469e6bc889d4cdf7bfb58d82b436","html_url":"https://github.com/openai/codex/commit/2d1ad374a7d2469e6bc889d4cdf7bfb58d82b436"}]},{"sha":"2d1ad374a7d2469e6bc889d4cdf7bfb58d82b436","node_id":"C_kwDOOYsS4doAKDJkMWFkMzc0YTdkMjQ2OWU2YmM4ODlkNGNkZjdiZmI1OGQ4MmI0MzY","commit":{"author":{"name":"Felipe Coury","email":"felipe.coury@openai.com","date":"2026-05-27T18:59:17Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T18:59:17Z"},"message":"feat(tui): make turn interruption keybind configurable (#24766)\n\n## Why\n\nInterrupting an active turn is currently fixed to `Esc`, which is easy\nto hit accidentally and cannot be customized through `/keymap`. This\ngives users a less accidental binding while preserving the existing\ndefault.\n\n## What Changed\n\n- Adds `tui.keymap.chat.interrupt_turn` to `/keymap`, defaulting to\n`esc` and supporting remapping or unbinding.\n- Uses the configured interrupt binding for running-turn status, queued\nsteer interruption, and `request_user_input`, including the visible\nhints.\n- Preserves local `Esc` behavior for popups, Vim insert mode, and\n`/agent` editing while validating conflicts with fixed/backtrack and\nrequest-input navigation bindings.\n- Adds behavior and snapshot coverage for remapped interruption paths.\n\n## How to Test\n\n1. Run Codex and open `/keymap`, then set **Interrupt Turn** to `f12`.\n2. Start a turn and confirm `Esc` no longer interrupts it while `f12`\ndoes; the running hint should display `f12 to interrupt`.\n3. Queue a steer while a turn is running and confirm the preview\ndisplays `f12`; pressing it should interrupt and submit the steer\nimmediately.\n4. Trigger a `request_user_input` prompt and confirm its footer uses\n`f12`; with notes open, `Esc` should still clear notes while `f12`\ninterrupts the turn.\n5. Clear the Interrupt Turn binding and confirm the key-specific\ninterrupt hint is removed while `Ctrl+C` remains available.\n\nTargeted validation:\n\n- `just write-config-schema`\n- `just fix -p codex-config`\n- `just fix -p codex-tui`\n- `just fmt`\n- `just argument-comment-lint-from-source -p codex-config -p codex-tui`\n- `just test -p codex-config`\n- `cargo insta pending-snapshots --manifest-path tui/Cargo.toml`\n- `just test -p codex-tui keymap_setup::tests`\n- `just test -p codex-tui` (fails in two pre-existing guardian\nfeature-flag tests unrelated to this diff; the intentional picker\nsnapshot updates were reviewed and accepted)","tree":{"sha":"af8af2360fc428964894c15464e63f8bf775df4a","url":"https://api.github.com/repos/openai/codex/git/trees/af8af2360fc428964894c15464e63f8bf775df4a"},"url":"https://api.github.com/repos/openai/codex/git/commits/2d1ad374a7d2469e6bc889d4cdf7bfb58d82b436","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqFz8FCRC1aQ7uu5UhlAAAS+IQAJOoKe743yamqrVmwWc8RzKM\nZZ5AS0qPpW5oCF9WC46wX+YB7nBF2CanZeslNTUkn6QDxepPZliWuXhXBq+hlNw7\nJmZRvf0bdjm60ykbt9Wkkg+7tGKaVayAZyQbkYy1WJJv3HzfeXChG4f/SuRvssgy\n8i5r9NxHGxszy+5b5aCXWtyEDux6H6CuC5LOKu9fV7FHV2s1DUPeIpWbSd1ysDc5\n2fYqSZxzP72p+jE7KC/cR0XdQgZJo0ATbNCij3II/xIYupVioW8TOvEsqBlmESf5\n7MHxAky6L0SBFcwBxvWmbDEXlNpqv2vmjkRbjXGpOUIGBHQJxPcVGMv87bJ30QKT\ny1YNkMTvnPGWP0vouv6Lh3MIvZn6nWShkDcjaZo/APH6/6xunSCvYBQfswTSVv9L\niZVfRiC97at6iQlkj8OOLdbKKNjFXkGYxWCflB/KtsyNuAOSWc8jBBz3YeD8ZZcx\nU4gHgyeaCgxBZMBS0pAKet/t1FiyeXo+xyvlbfZzZWjypfCP3odi2PiygkXY4veM\nQVKOJiLtROP0Vam1Pha/Z8U2qM0B163xEPkWqOWHjv9d51Yz9UFHg3VfdawvgaN4\nfgDB+Mv7BNvLmj1ratUURV2fLOTeZkyzLfUbP+0ZE7TtPTfpcqYFEWhc4M8c9l99\n08d9Zc92AtYPj4Mu7FDH\n=5DBY\n-----END PGP SIGNATURE-----\n","payload":"tree af8af2360fc428964894c15464e63f8bf775df4a\nparent 8d398d3c5230fa69557b258264f3c6eb21fff9aa\nauthor Felipe Coury <felipe.coury@openai.com> 1779908357 -0300\ncommitter GitHub <noreply@github.com> 1779908357 +0000\n\nfeat(tui): make turn interruption keybind configurable (#24766)\n\n## Why\n\nInterrupting an active turn is currently fixed to `Esc`, which is easy\nto hit accidentally and cannot be customized through `/keymap`. This\ngives users a less accidental binding while preserving the existing\ndefault.\n\n## What Changed\n\n- Adds `tui.keymap.chat.interrupt_turn` to `/keymap`, defaulting to\n`esc` and supporting remapping or unbinding.\n- Uses the configured interrupt binding for running-turn status, queued\nsteer interruption, and `request_user_input`, including the visible\nhints.\n- Preserves local `Esc` behavior for popups, Vim insert mode, and\n`/agent` editing while validating conflicts with fixed/backtrack and\nrequest-input navigation bindings.\n- Adds behavior and snapshot coverage for remapped interruption paths.\n\n## How to Test\n\n1. Run Codex and open `/keymap`, then set **Interrupt Turn** to `f12`.\n2. Start a turn and confirm `Esc` no longer interrupts it while `f12`\ndoes; the running hint should display `f12 to interrupt`.\n3. Queue a steer while a turn is running and confirm the preview\ndisplays `f12`; pressing it should interrupt and submit the steer\nimmediately.\n4. Trigger a `request_user_input` prompt and confirm its footer uses\n`f12`; with notes open, `Esc` should still clear notes while `f12`\ninterrupts the turn.\n5. Clear the Interrupt Turn binding and confirm the key-specific\ninterrupt hint is removed while `Ctrl+C` remains available.\n\nTargeted validation:\n\n- `just write-config-schema`\n- `just fix -p codex-config`\n- `just fix -p codex-tui`\n- `just fmt`\n- `just argument-comment-lint-from-source -p codex-config -p codex-tui`\n- `just test -p codex-config`\n- `cargo insta pending-snapshots --manifest-path tui/Cargo.toml`\n- `just test -p codex-tui keymap_setup::tests`\n- `just test -p codex-tui` (fails in two pre-existing guardian\nfeature-flag tests unrelated to this diff; the intentional picker\nsnapshot updates were reviewed and accepted)","verified_at":"2026-05-27T18:59:17Z"}},"url":"https://api.github.com/repos/openai/codex/commits/2d1ad374a7d2469e6bc889d4cdf7bfb58d82b436","html_url":"https://github.com/openai/codex/commit/2d1ad374a7d2469e6bc889d4cdf7bfb58d82b436","comments_url":"https://api.github.com/repos/openai/codex/commits/2d1ad374a7d2469e6bc889d4cdf7bfb58d82b436/comments","author":{"login":"fcoury-oai","id":272635208,"node_id":"U_kgDOEEAVSA","avatar_url":"https://avatars.githubusercontent.com/u/272635208?v=4","gravatar_id":"","url":"https://api.github.com/users/fcoury-oai","html_url":"https://github.com/fcoury-oai","followers_url":"https://api.github.com/users/fcoury-oai/followers","following_url":"https://api.github.com/users/fcoury-oai/following{/other_user}","gists_url":"https://api.github.com/users/fcoury-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/fcoury-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fcoury-oai/subscriptions","organizations_url":"https://api.github.com/users/fcoury-oai/orgs","repos_url":"https://api.github.com/users/fcoury-oai/repos","events_url":"https://api.github.com/users/fcoury-oai/events{/privacy}","received_events_url":"https://api.github.com/users/fcoury-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"8d398d3c5230fa69557b258264f3c6eb21fff9aa","url":"https://api.github.com/repos/openai/codex/commits/8d398d3c5230fa69557b258264f3c6eb21fff9aa","html_url":"https://github.com/openai/codex/commit/8d398d3c5230fa69557b258264f3c6eb21fff9aa"}]},{"sha":"8d398d3c5230fa69557b258264f3c6eb21fff9aa","node_id":"C_kwDOOYsS4doAKDhkMzk4ZDNjNTIzMGZhNjk1NTdiMjU4MjY0ZjNjNmViMjFmZmY5YWE","commit":{"author":{"name":"Felipe Coury","email":"felipe.coury@openai.com","date":"2026-05-27T18:15:03Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T18:15:03Z"},"message":"feat(tui): add vim text object bindings (#24382)\n\n## Why\n\nVim mode currently supports some normal-mode operators and motions, but\ncommon text-object combinations like `ciw`, `daw`, `di(`, and\nquote/bracket variants are still missing. That makes the composer feel\nincomplete for users who expect operator + text object editing to work\ninside prompts.\n\nCloses #21383.\n\n## What Changed\n\n- Add Vim pending-state support for operator/text-object sequences.\n- Add `c` as a normal-mode operator for text objects, so combinations\nlike `ciw` delete the object and enter insert mode.\n- Support word, WORD, delimiter, and quote text objects:\n  - `iw`, `aw`, `iW`, `aW`\n  - `i(`, `a(`, `i)`, `a)`, `ib`, `ab`\n  - `i[`, `a[`, `i]`, `a]`\n  - `i{`, `a{`, `i}`, `a}`, `iB`, `aB`\n  - `i\"`, `a\"`, `i'`, `a'`, `i\\``, `a\\``\n- Add configurable keymap entries and keymap picker coverage for the new\nVim text-object context.\n- Regenerate the config schema and update keymap picker snapshots.\n\n## How to Test\n\nManual smoke test:\n\n1. Start Codex with Vim composer mode enabled.\n2. Type a draft such as:\n   ```text\n   alpha beta gamma\n   call(foo[bar], {\"x\": \"hello world\"})\n   say \"one \\\"two\\\" three\" now\n   ```\n3. Put the cursor on `beta`, press `ciw`, and confirm `beta` is removed\nand the composer enters insert mode.\n4. Escape back to normal mode, put the cursor on `gamma`, press `daw`,\nand confirm `gamma` plus surrounding whitespace is removed.\n5. Put the cursor inside `foo[bar]`, press `di[`, and confirm only `bar`\nis removed.\n6. Put the cursor inside `call(...)`, press `da(`, and confirm the whole\nparenthesized section is removed.\n7. Put the cursor inside the quoted text, press `ci\"`, and confirm the\nquote contents are removed and insert mode starts.\n8. Verify cancellation does not edit text: press `d` then `Esc`, and\npress `d` then `i` then `Esc`.\n\nTargeted tests:\n\n- `cargo test -p codex-tui --lib vim_`\n- `cargo nextest run -p codex-tui keymap_setup::tests`\n\nAdditional local checks:\n\n- `just write-config-schema`\n- `just fmt`\n- `just fix -p codex-tui`\n- `git diff --check`\n- `cargo insta pending-snapshots --manifest-path tui/Cargo.toml`\n\nLocal full-suite note: `just test -p codex-tui` ran to completion. The\nkeymap snapshot failures were expected and accepted. Two unrelated\nguardian feature-flag tests still fail locally:\n-\n`app::tests::update_feature_flags_disabling_guardian_clears_review_policy_and_restores_default`\n-\n`app::tests::update_feature_flags_disabling_guardian_clears_manual_review_policy_without_history`\n\n`just argument-comment-lint` is currently blocked locally by Bazel\nanalysis before the lint runs because `compiler-rt` has an empty\n`include/sanitizer/*.h` glob in the local Bazel cache. The touched Rust\ndiff was manually inspected for opaque positional literals.","tree":{"sha":"a6005312a27c245214d3daa60ef86d6f303f83aa","url":"https://api.github.com/repos/openai/codex/git/trees/a6005312a27c245214d3daa60ef86d6f303f83aa"},"url":"https://api.github.com/repos/openai/codex/git/commits/8d398d3c5230fa69557b258264f3c6eb21fff9aa","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqFzSnCRC1aQ7uu5UhlAAA5TgQAJzGxwGxm8a/fznytZhD67jI\nUJE832hKekDZZ2aLKH8q5PCMEs0koQudQ5QM0nep3vim7xNO8EoD7iCUPy2T9ekP\nHs8xZJb5Xr3f185GJvBu3rDGHxolznL8VfQ85WRSqOeczwiXbNovb3vQFgKwh2zf\n3nBdMdAAK9uFv41ADcDx5c1UpZ6nzH59m4bndSOYn1Xyfu6r4qkX9qpDzwNVQp5y\nj0Oda0uAeGw5UDwolOgO6Cp/dhLM7KUtqFE8qzUj5Ww4Wh3G0E+Wax1dUcfJGC5T\ncUpL9CZF1PLgcql3H8vfCh+63M8A0TtKfwwgGtbERkHYq7Wn6ry/uxdN2uUUwEzQ\n2fjnP2kVBsRSr5jrIf7EVrHCluC5E+x829J/XA85+jqlAOi105X52zhzjLkzEszm\nKOce/jrRkOZoHDdsxVhnYvvpnjeUKlALTmf7hUphIB6cxQHiqDQbPlb4R8Ga66RP\nkuRaOaZaQhreJUGF/N9pfce18mL9tGhPV/7qgrpZ4NMNZfNiqpQ15vYqG8uV6LN9\ng249d7qP/i5r+IaIZDPo3ZYn9K9P6VnmCN6DCrnkUMDlDpw9f7Aco1gixt7PqxR2\nJyVJe43+GuAeSIYx5G1rlDqNKZSucz44M2BlX4ay0nflVcl+rcxXU6g5DERbyQPK\nga+n1boRXDoaKp0vZ69q\n=s7Y+\n-----END PGP SIGNATURE-----\n","payload":"tree a6005312a27c245214d3daa60ef86d6f303f83aa\nparent b1cbf622ad4b669bea2b45216284377b71131279\nauthor Felipe Coury <felipe.coury@openai.com> 1779905703 -0300\ncommitter GitHub <noreply@github.com> 1779905703 -0300\n\nfeat(tui): add vim text object bindings (#24382)\n\n## Why\n\nVim mode currently supports some normal-mode operators and motions, but\ncommon text-object combinations like `ciw`, `daw`, `di(`, and\nquote/bracket variants are still missing. That makes the composer feel\nincomplete for users who expect operator + text object editing to work\ninside prompts.\n\nCloses #21383.\n\n## What Changed\n\n- Add Vim pending-state support for operator/text-object sequences.\n- Add `c` as a normal-mode operator for text objects, so combinations\nlike `ciw` delete the object and enter insert mode.\n- Support word, WORD, delimiter, and quote text objects:\n  - `iw`, `aw`, `iW`, `aW`\n  - `i(`, `a(`, `i)`, `a)`, `ib`, `ab`\n  - `i[`, `a[`, `i]`, `a]`\n  - `i{`, `a{`, `i}`, `a}`, `iB`, `aB`\n  - `i\"`, `a\"`, `i'`, `a'`, `i\\``, `a\\``\n- Add configurable keymap entries and keymap picker coverage for the new\nVim text-object context.\n- Regenerate the config schema and update keymap picker snapshots.\n\n## How to Test\n\nManual smoke test:\n\n1. Start Codex with Vim composer mode enabled.\n2. Type a draft such as:\n   ```text\n   alpha beta gamma\n   call(foo[bar], {\"x\": \"hello world\"})\n   say \"one \\\"two\\\" three\" now\n   ```\n3. Put the cursor on `beta`, press `ciw`, and confirm `beta` is removed\nand the composer enters insert mode.\n4. Escape back to normal mode, put the cursor on `gamma`, press `daw`,\nand confirm `gamma` plus surrounding whitespace is removed.\n5. Put the cursor inside `foo[bar]`, press `di[`, and confirm only `bar`\nis removed.\n6. Put the cursor inside `call(...)`, press `da(`, and confirm the whole\nparenthesized section is removed.\n7. Put the cursor inside the quoted text, press `ci\"`, and confirm the\nquote contents are removed and insert mode starts.\n8. Verify cancellation does not edit text: press `d` then `Esc`, and\npress `d` then `i` then `Esc`.\n\nTargeted tests:\n\n- `cargo test -p codex-tui --lib vim_`\n- `cargo nextest run -p codex-tui keymap_setup::tests`\n\nAdditional local checks:\n\n- `just write-config-schema`\n- `just fmt`\n- `just fix -p codex-tui`\n- `git diff --check`\n- `cargo insta pending-snapshots --manifest-path tui/Cargo.toml`\n\nLocal full-suite note: `just test -p codex-tui` ran to completion. The\nkeymap snapshot failures were expected and accepted. Two unrelated\nguardian feature-flag tests still fail locally:\n-\n`app::tests::update_feature_flags_disabling_guardian_clears_review_policy_and_restores_default`\n-\n`app::tests::update_feature_flags_disabling_guardian_clears_manual_review_policy_without_history`\n\n`just argument-comment-lint` is currently blocked locally by Bazel\nanalysis before the lint runs because `compiler-rt` has an empty\n`include/sanitizer/*.h` glob in the local Bazel cache. The touched Rust\ndiff was manually inspected for opaque positional literals.","verified_at":"2026-05-27T18:15:05Z"}},"url":"https://api.github.com/repos/openai/codex/commits/8d398d3c5230fa69557b258264f3c6eb21fff9aa","html_url":"https://github.com/openai/codex/commit/8d398d3c5230fa69557b258264f3c6eb21fff9aa","comments_url":"https://api.github.com/repos/openai/codex/commits/8d398d3c5230fa69557b258264f3c6eb21fff9aa/comments","author":{"login":"fcoury-oai","id":272635208,"node_id":"U_kgDOEEAVSA","avatar_url":"https://avatars.githubusercontent.com/u/272635208?v=4","gravatar_id":"","url":"https://api.github.com/users/fcoury-oai","html_url":"https://github.com/fcoury-oai","followers_url":"https://api.github.com/users/fcoury-oai/followers","following_url":"https://api.github.com/users/fcoury-oai/following{/other_user}","gists_url":"https://api.github.com/users/fcoury-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/fcoury-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fcoury-oai/subscriptions","organizations_url":"https://api.github.com/users/fcoury-oai/orgs","repos_url":"https://api.github.com/users/fcoury-oai/repos","events_url":"https://api.github.com/users/fcoury-oai/events{/privacy}","received_events_url":"https://api.github.com/users/fcoury-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b1cbf622ad4b669bea2b45216284377b71131279","url":"https://api.github.com/repos/openai/codex/commits/b1cbf622ad4b669bea2b45216284377b71131279","html_url":"https://github.com/openai/codex/commit/b1cbf622ad4b669bea2b45216284377b71131279"}]},{"sha":"b1cbf622ad4b669bea2b45216284377b71131279","node_id":"C_kwDOOYsS4doAKGIxY2JmNjIyYWQ0YjY2OWJlYTJiNDUyMTYyODQzNzdiNzExMzEyNzk","commit":{"author":{"name":"Ahmed Ibrahim","email":"aibrahim@openai.com","date":"2026-05-27T18:11:04Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T18:11:04Z"},"message":"[codex] Add friendly Python SDK sandbox presets (#24772)\n\n## Why\n\nThe Python SDK currently exposes sandbox selection differently depending\non where it is used: thread lifecycle methods accept `SandboxMode`,\nwhile turns accept the lower-level `SandboxPolicy` shape. For the common\ncase of choosing an access level, that leaks app-server wire details\ninto otherwise straightforward SDK usage.\n\nThis makes the common path explicit and discoverable: callers choose a\nnamed sandbox preset once, using the same keyword on threads and turns.\nThe preset name `workspace_write` also makes the granted capability\nclear at the callsite.\n\n## What changed\n\n- Added a root-level `Sandbox` enum with documented presets:\n  - `Sandbox.read_only`: read files without allowing writes.\n- `Sandbox.workspace_write`: the normal default for projects with a\nrecorded trust decision; read files and write inside the workspace and\nconfigured writable roots.\n  - `Sandbox.full_access`: run without filesystem access restrictions.\n- Documented that omitting `sandbox=` delegates to app-server's\nconfigured default, while explicit turn overrides remain sticky for\nsubsequent turns.\n- Updated sync and async thread lifecycle and turn APIs to consistently\naccept `sandbox=Sandbox...`, translating to the existing app-server\nthread and turn representations internally.\n- Updated the public API artifact generator so regenerated SDK wrappers\nretain the friendly enum shape.\n- Replaced low-level policy construction in Python docs, examples, and\nthe walkthrough notebook with the preset API.\n- Added focused coverage for root exports, method signatures,\npreset-to-wire mapping, and rejection of raw string sandbox inputs.\n\n## API impact\n\nHigh-level turn calls now use `sandbox=` instead of `sandbox_policy=`:\n\n```python\nfrom openai_codex import Codex, Sandbox\n\nwith Codex() as codex:\n    thread = codex.thread_start(sandbox=Sandbox.workspace_write)\n    result = thread.run(\"Review the diff only.\", sandbox=Sandbox.read_only)\n```\n\n`thread_start(...)` already defaults to `ApprovalMode.auto_review`, so\nnormal writable usage is concise:\n\n```python\nwith Codex() as codex:\n    thread = codex.thread_start(sandbox=Sandbox.workspace_write)\n    thread.run(\"Update the files in this workspace.\")\n```\n\nWith that combination, edits inside `cwd` and configured writable roots\nrun within the workspace-write sandbox. Operations that require\napproval, such as edits outside those roots, are routed through auto\nreview. When `sandbox=` is omitted, app-server resolves its configured\ndefault. A sandbox supplied to `run(...)` or `turn(...)` applies to that\nturn and subsequent turns.\n\n## Test coverage\n\n- `sdk/python/tests/test_public_api_signatures.py` covers the public\nexport and parameter names, including the default approval mode.\n- `sdk/python/tests/test_public_api_runtime_behavior.py` covers preset\nmappings to the existing wire types and raw string rejection.","tree":{"sha":"01bbbb77ea99f963f9a685d157afe5d0ef55fe0d","url":"https://api.github.com/repos/openai/codex/git/trees/01bbbb77ea99f963f9a685d157afe5d0ef55fe0d"},"url":"https://api.github.com/repos/openai/codex/git/commits/b1cbf622ad4b669bea2b45216284377b71131279","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqFzO4CRC1aQ7uu5UhlAAAluwQAIrSAmjOw+5Yd1N5XUek3d6/\nqrAoVZP2SMY8v/epy1Aip8Pvn1pNJlWn77AXJRKyaAwT5vh82RTiHE3RfR/RWBlW\nT2hEk19Dn4r3sCFs1NOPW3lJzsTNCpfLGqNU7sunktq0adJpn1+GN8RWqliox6Xx\n8wEVfUbK44C2n3h8/T1RhJrt4CPGpMr7xWdrPWDxZGnJ76zQGqkdVEMbp4KFSHrx\nlRXk+yvEQasMzEu3IGg2/3Q4QmrnZzxAcMJWLdI/u0qA877yJtofFtXFkv8bBqzt\nGMdFmys9Xb495m6aqt3ztH42wCHv2If9D0Hj92WcM7A1EW8aClUeIpZHEj0MxBJa\n0k2anRmsigi5SPQFEgNzR8QinJzr6vOGDKcHOL+EPZm4prsPbQsje9R4E9hNwVPw\nLk6mIc+NrJqZgr/VfyXnsy1Ed7I3vJ2X8Avg2HnVGn5Nwcd9RuzE11To0RI6TFzP\n6one7HtuyUeKwhXrPxbtU9DBz/ofAkM2OX2qAngQBNKr1XFdS6llMeoe/DkHIAJa\nN5w+H/GqNbfSPz38AyEP5CHvS4gD9tnAw7ATf5YiqFnc9u6M9fvKxq/lQu72Iquv\nesSntFmO9ZnRS9qNBUgp4guFZtMcn06krYA616fU3hibRCTnT+YsGYB7CYHrzoFz\n1j/BGhm1bno0KwUlr+To\n=9JEq\n-----END PGP SIGNATURE-----\n","payload":"tree 01bbbb77ea99f963f9a685d157afe5d0ef55fe0d\nparent bee78806a9b8fad5f250f7822da08008b2c1dd01\nauthor Ahmed Ibrahim <aibrahim@openai.com> 1779905464 -0700\ncommitter GitHub <noreply@github.com> 1779905464 -0700\n\n[codex] Add friendly Python SDK sandbox presets (#24772)\n\n## Why\n\nThe Python SDK currently exposes sandbox selection differently depending\non where it is used: thread lifecycle methods accept `SandboxMode`,\nwhile turns accept the lower-level `SandboxPolicy` shape. For the common\ncase of choosing an access level, that leaks app-server wire details\ninto otherwise straightforward SDK usage.\n\nThis makes the common path explicit and discoverable: callers choose a\nnamed sandbox preset once, using the same keyword on threads and turns.\nThe preset name `workspace_write` also makes the granted capability\nclear at the callsite.\n\n## What changed\n\n- Added a root-level `Sandbox` enum with documented presets:\n  - `Sandbox.read_only`: read files without allowing writes.\n- `Sandbox.workspace_write`: the normal default for projects with a\nrecorded trust decision; read files and write inside the workspace and\nconfigured writable roots.\n  - `Sandbox.full_access`: run without filesystem access restrictions.\n- Documented that omitting `sandbox=` delegates to app-server's\nconfigured default, while explicit turn overrides remain sticky for\nsubsequent turns.\n- Updated sync and async thread lifecycle and turn APIs to consistently\naccept `sandbox=Sandbox...`, translating to the existing app-server\nthread and turn representations internally.\n- Updated the public API artifact generator so regenerated SDK wrappers\nretain the friendly enum shape.\n- Replaced low-level policy construction in Python docs, examples, and\nthe walkthrough notebook with the preset API.\n- Added focused coverage for root exports, method signatures,\npreset-to-wire mapping, and rejection of raw string sandbox inputs.\n\n## API impact\n\nHigh-level turn calls now use `sandbox=` instead of `sandbox_policy=`:\n\n```python\nfrom openai_codex import Codex, Sandbox\n\nwith Codex() as codex:\n    thread = codex.thread_start(sandbox=Sandbox.workspace_write)\n    result = thread.run(\"Review the diff only.\", sandbox=Sandbox.read_only)\n```\n\n`thread_start(...)` already defaults to `ApprovalMode.auto_review`, so\nnormal writable usage is concise:\n\n```python\nwith Codex() as codex:\n    thread = codex.thread_start(sandbox=Sandbox.workspace_write)\n    thread.run(\"Update the files in this workspace.\")\n```\n\nWith that combination, edits inside `cwd` and configured writable roots\nrun within the workspace-write sandbox. Operations that require\napproval, such as edits outside those roots, are routed through auto\nreview. When `sandbox=` is omitted, app-server resolves its configured\ndefault. A sandbox supplied to `run(...)` or `turn(...)` applies to that\nturn and subsequent turns.\n\n## Test coverage\n\n- `sdk/python/tests/test_public_api_signatures.py` covers the public\nexport and parameter names, including the default approval mode.\n- `sdk/python/tests/test_public_api_runtime_behavior.py` covers preset\nmappings to the existing wire types and raw string rejection.","verified_at":"2026-05-27T18:11:05Z"}},"url":"https://api.github.com/repos/openai/codex/commits/b1cbf622ad4b669bea2b45216284377b71131279","html_url":"https://github.com/openai/codex/commit/b1cbf622ad4b669bea2b45216284377b71131279","comments_url":"https://api.github.com/repos/openai/codex/commits/b1cbf622ad4b669bea2b45216284377b71131279/comments","author":{"login":"aibrahim-oai","id":219906144,"node_id":"U_kgDODRuAYA","avatar_url":"https://avatars.githubusercontent.com/u/219906144?v=4","gravatar_id":"","url":"https://api.github.com/users/aibrahim-oai","html_url":"https://github.com/aibrahim-oai","followers_url":"https://api.github.com/users/aibrahim-oai/followers","following_url":"https://api.github.com/users/aibrahim-oai/following{/other_user}","gists_url":"https://api.github.com/users/aibrahim-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/aibrahim-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aibrahim-oai/subscriptions","organizations_url":"https://api.github.com/users/aibrahim-oai/orgs","repos_url":"https://api.github.com/users/aibrahim-oai/repos","events_url":"https://api.github.com/users/aibrahim-oai/events{/privacy}","received_events_url":"https://api.github.com/users/aibrahim-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"bee78806a9b8fad5f250f7822da08008b2c1dd01","url":"https://api.github.com/repos/openai/codex/commits/bee78806a9b8fad5f250f7822da08008b2c1dd01","html_url":"https://github.com/openai/codex/commit/bee78806a9b8fad5f250f7822da08008b2c1dd01"}]},{"sha":"bee78806a9b8fad5f250f7822da08008b2c1dd01","node_id":"C_kwDOOYsS4doAKGJlZTc4ODA2YTliOGZhZDVmMjUwZjc4MjJkYTA4MDA4YjJjMWRkMDE","commit":{"author":{"name":"ningyi-oai","email":"ningyi@openai.com","date":"2026-05-27T18:09:33Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T18:09:33Z"},"message":"[codex] add compaction metadata to turn headers (#24368)\n\n## Summary\n- Add `request_kind` values for foreground turn, startup prewarm,\ncompaction, and detached memory model requests.\n- Attach compaction dispatch metadata to local Responses, legacy\n`/v1/responses/compact`, and remote v2 compact requests.\n- Add the existing logical context-window identifier as `window_id` on\nturn-owned model request metadata.\n- Keep identity fields optional for detached memory requests, while\nstill emitting `request_kind=\"memory\"` in non-git/no-sandbox workspaces.\n\n## Root Cause\n`x-codex-turn-metadata` has more than one producer. Foreground turns and\ncompaction requests own a real turn and should carry that turn identity.\nDetached memory stage-one requests do not own a foreground turn, so\nabsent identity fields are valid rather than missing data. Startup\nwebsocket prewarm is also a model request, but it has `generate=false`\nand must not be counted as a foreground turn.\n\n`thread_source` or session source identifies where a thread came from\n(for example review, guardian, or another subagent). `request_kind`\nidentifies what the current outbound model request is doing (`turn`,\n`prewarm`, `compaction`, or `memory`). A review or guardian thread can\nissue either a normal turn request or a compaction request, so source\ncannot replace request kind.\n\n## Behavior / Impact\n- Ordinary foreground requests send `request_kind=\"turn\"`, their real\nidentity fields, and `window_id=\"<thread_id>:<window_generation>\"`.\n- Startup websocket warmup requests send `request_kind=\"prewarm\"` so\nthey are not counted as foreground turns.\n- Compaction requests send `request_kind=\"compaction\"`, their real\nowning turn identity, the existing `window_id`, and\n`compaction.{trigger,reason,implementation,phase,strategy}`.\n- Detached memory stage-one requests send `request_kind=\"memory\"`\nwithout `session_id`, `thread_id`, `turn_id`, or `window_id`; when no\nworkspace metadata exists, the kind-only header is still emitted.\n- `session_id`, `thread_id`, `turn_id`, and `window_id` remain optional\nin the header schema because detached memory requests do not own a\nforeground turn or context window.\n- `window_id` is not a new ID system: it is copied from the already-sent\n`x-codex-window-id` / WS client metadata value at model-request dispatch\ntime.\n- Existing `x-codex-window-id` HTTP/WS emission, value format,\ngeneration advancement, resume behavior, and fork reset behavior are\nunchanged.\n- `request_kind`, `window_id`, and upstream turn-owned identity fields\nremain schema-owned; input `responsesapi_client_metadata` cannot replace\ntheir canonical values.\n- No table, DAG, export, app-server API, or MCP `_meta` schema changes\nare included.\n\nA compaction attempt stopped by a pre-compact hook issues no model\nrequest and therefore has no request header; its outcome remains in\nanalytics events. Status, error, duration, and token deltas also remain\nanalytics fields rather than request-header fields.\n\nFuture detached-memory attribution using a real initiating turn ID as\n`trigger_turn_id` is intentionally not part of this PR.\n\n## Sync With Main\n- Final pushed head `716342e79` is rebased onto `origin/main@0d37db4b2`.\n- The metadata conflict came from upstream `#24160`, which added\n`forked_from_thread_id` on the same `turn_metadata` surface. Resolution\npreserves that field and its protection from client metadata override\nalongside this PR's request-kind, compaction, and window-id fields.\n- While resolving the overlapping commits, I removed an accidental\nrecursive model-request overlay and a duplicate detached-memory header\nbuilder before completing the rebase.\n\n## Latency / User Experience Boundary\n- Foreground turns perform no new filesystem, git, or network work. New\nfields are inserted into metadata already serialized for outgoing\nrequests.\n- Compaction issues the same model/HTTP requests with the same prompt,\nmodel, service tier, and sampling settings; only metadata bytes change.\n- Startup prewarm already sent metadata; it is now correctly classified\nas `prewarm`.\n- Non-git detached memory now sends a small kind-only metadata header\nrather than no header.\n- This client diff adds no user-visible latency mechanism beyond\nnegligible serialization and header bytes on already-existing requests.\n\n## Validation\nOn conflict-resolved head `1d35c2cfb` based on `origin/main@487521733`:\n- `just fmt` (passed)\n- `just fix -p codex-core` (passed)\n- `git diff --check origin/main...HEAD` (passed)\n- `just test -p codex-core -E 'test(turn_metadata) |\ntest(websocket_first_turn_uses_startup_prewarm_and_create) |\ntest(responses_stream_includes_turn_metadata_header_for_git_workspace_e2e)\n|\ntest(responses_websocket_forwards_turn_metadata_on_initial_and_incremental_create)\n| test(remote_compact_v2_retries_failures_with_stream_retry_budget) |\ntest(window_id_advances_after_compact_persists_on_resume_and_resets_on_fork)'`\n(`23 passed`; `bench-smoke` passed)\n- `just test -p codex-app-server -E\n'test(turn_start_forwards_client_metadata_to_responses_request_v2) |\ntest(turn_start_forwards_client_metadata_to_responses_websocket_request_body_v2)\n| test(auto_compaction_remote_emits_started_and_completed_items)'` (`3\npassed`; `bench-smoke` passed)\n- `just test -p codex-memories-write` (`29 passed`; `bench-smoke`\npassed)","tree":{"sha":"25576b29ad7004084931198d8b05834d11a7cd80","url":"https://api.github.com/repos/openai/codex/git/trees/25576b29ad7004084931198d8b05834d11a7cd80"},"url":"https://api.github.com/repos/openai/codex/git/commits/bee78806a9b8fad5f250f7822da08008b2c1dd01","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqFzNdCRC1aQ7uu5UhlAAAMAAQAC3QRYGyifGWzXUUfTUgYP+p\nygsSXVVCTAMZCamsDzwie2k0cdf10XBcwKJ5XyRI3oovdOiVCQCpWQABx3aBkuBC\nSR8tHuoge2SmRTXt+xvhtXMsvmHcbTGYn4d3f+bVtBuF9JNV6fUZi8YGgoSTsXzS\nMvf2HdlOW9eYmMRImMOCyGbIJ3OO0kV5maBNIczrFsmsdhagLL51dKQQRPPL5Gti\n+YuyZ5Ng8STyFjRpi/ZRda8AaEwukgQVDWqK35mrlQLOdcCvY51qkKioZzTCXmpz\n6S27mWvxFmu0SQvkRt5ONLVEM5oQOb3x2PDQRtr81EMOZAWJA988u4LT1jepv7eV\n4a/yuyh1Nn3+QxADVJG+qcEAbqGGt5j13ZpA4gjIMerf2iq723QcjbAjETPu8t+q\nbCjbJnAXOINKP7ZTWCP4TbC1AXrSmAwfXgd19rYUMD4Z3qeNxTkYpd6YlQCGQA6p\nhMTwN56E/Q6jYGcdsDrJo33Q0Ddt2k+ngPJ5JBDGDXjblTov0rKHhau1pgNMAWmV\nnaD+Wj0sXdzDW11mobsOAvW870FZz0aUIzEIRgSPpVIK5ggFSDiSIgKE0M5ei36s\neQoSKuM7HN6zya2lyEbdFWk6QixEDfdw+1/+RTmE3bpEqBQIM7YyXVgnSnMQyuAO\nvC9hLMBZ0Yl/JKZjnzhR\n=bSO8\n-----END PGP SIGNATURE-----\n","payload":"tree 25576b29ad7004084931198d8b05834d11a7cd80\nparent f0f483e8b2a2630bf8dfa5f8451e81eba20def6c\nauthor ningyi-oai <ningyi@openai.com> 1779905373 -0700\ncommitter GitHub <noreply@github.com> 1779905373 -0700\n\n[codex] add compaction metadata to turn headers (#24368)\n\n## Summary\n- Add `request_kind` values for foreground turn, startup prewarm,\ncompaction, and detached memory model requests.\n- Attach compaction dispatch metadata to local Responses, legacy\n`/v1/responses/compact`, and remote v2 compact requests.\n- Add the existing logical context-window identifier as `window_id` on\nturn-owned model request metadata.\n- Keep identity fields optional for detached memory requests, while\nstill emitting `request_kind=\"memory\"` in non-git/no-sandbox workspaces.\n\n## Root Cause\n`x-codex-turn-metadata` has more than one producer. Foreground turns and\ncompaction requests own a real turn and should carry that turn identity.\nDetached memory stage-one requests do not own a foreground turn, so\nabsent identity fields are valid rather than missing data. Startup\nwebsocket prewarm is also a model request, but it has `generate=false`\nand must not be counted as a foreground turn.\n\n`thread_source` or session source identifies where a thread came from\n(for example review, guardian, or another subagent). `request_kind`\nidentifies what the current outbound model request is doing (`turn`,\n`prewarm`, `compaction`, or `memory`). A review or guardian thread can\nissue either a normal turn request or a compaction request, so source\ncannot replace request kind.\n\n## Behavior / Impact\n- Ordinary foreground requests send `request_kind=\"turn\"`, their real\nidentity fields, and `window_id=\"<thread_id>:<window_generation>\"`.\n- Startup websocket warmup requests send `request_kind=\"prewarm\"` so\nthey are not counted as foreground turns.\n- Compaction requests send `request_kind=\"compaction\"`, their real\nowning turn identity, the existing `window_id`, and\n`compaction.{trigger,reason,implementation,phase,strategy}`.\n- Detached memory stage-one requests send `request_kind=\"memory\"`\nwithout `session_id`, `thread_id`, `turn_id`, or `window_id`; when no\nworkspace metadata exists, the kind-only header is still emitted.\n- `session_id`, `thread_id`, `turn_id`, and `window_id` remain optional\nin the header schema because detached memory requests do not own a\nforeground turn or context window.\n- `window_id` is not a new ID system: it is copied from the already-sent\n`x-codex-window-id` / WS client metadata value at model-request dispatch\ntime.\n- Existing `x-codex-window-id` HTTP/WS emission, value format,\ngeneration advancement, resume behavior, and fork reset behavior are\nunchanged.\n- `request_kind`, `window_id`, and upstream turn-owned identity fields\nremain schema-owned; input `responsesapi_client_metadata` cannot replace\ntheir canonical values.\n- No table, DAG, export, app-server API, or MCP `_meta` schema changes\nare included.\n\nA compaction attempt stopped by a pre-compact hook issues no model\nrequest and therefore has no request header; its outcome remains in\nanalytics events. Status, error, duration, and token deltas also remain\nanalytics fields rather than request-header fields.\n\nFuture detached-memory attribution using a real initiating turn ID as\n`trigger_turn_id` is intentionally not part of this PR.\n\n## Sync With Main\n- Final pushed head `716342e79` is rebased onto `origin/main@0d37db4b2`.\n- The metadata conflict came from upstream `#24160`, which added\n`forked_from_thread_id` on the same `turn_metadata` surface. Resolution\npreserves that field and its protection from client metadata override\nalongside this PR's request-kind, compaction, and window-id fields.\n- While resolving the overlapping commits, I removed an accidental\nrecursive model-request overlay and a duplicate detached-memory header\nbuilder before completing the rebase.\n\n## Latency / User Experience Boundary\n- Foreground turns perform no new filesystem, git, or network work. New\nfields are inserted into metadata already serialized for outgoing\nrequests.\n- Compaction issues the same model/HTTP requests with the same prompt,\nmodel, service tier, and sampling settings; only metadata bytes change.\n- Startup prewarm already sent metadata; it is now correctly classified\nas `prewarm`.\n- Non-git detached memory now sends a small kind-only metadata header\nrather than no header.\n- This client diff adds no user-visible latency mechanism beyond\nnegligible serialization and header bytes on already-existing requests.\n\n## Validation\nOn conflict-resolved head `1d35c2cfb` based on `origin/main@487521733`:\n- `just fmt` (passed)\n- `just fix -p codex-core` (passed)\n- `git diff --check origin/main...HEAD` (passed)\n- `just test -p codex-core -E 'test(turn_metadata) |\ntest(websocket_first_turn_uses_startup_prewarm_and_create) |\ntest(responses_stream_includes_turn_metadata_header_for_git_workspace_e2e)\n|\ntest(responses_websocket_forwards_turn_metadata_on_initial_and_incremental_create)\n| test(remote_compact_v2_retries_failures_with_stream_retry_budget) |\ntest(window_id_advances_after_compact_persists_on_resume_and_resets_on_fork)'`\n(`23 passed`; `bench-smoke` passed)\n- `just test -p codex-app-server -E\n'test(turn_start_forwards_client_metadata_to_responses_request_v2) |\ntest(turn_start_forwards_client_metadata_to_responses_websocket_request_body_v2)\n| test(auto_compaction_remote_emits_started_and_completed_items)'` (`3\npassed`; `bench-smoke` passed)\n- `just test -p codex-memories-write` (`29 passed`; `bench-smoke`\npassed)","verified_at":"2026-05-27T18:09:34Z"}},"url":"https://api.github.com/repos/openai/codex/commits/bee78806a9b8fad5f250f7822da08008b2c1dd01","html_url":"https://github.com/openai/codex/commit/bee78806a9b8fad5f250f7822da08008b2c1dd01","comments_url":"https://api.github.com/repos/openai/codex/commits/bee78806a9b8fad5f250f7822da08008b2c1dd01/comments","author":{"login":"ningyi-oai","id":242065200,"node_id":"U_kgDODm2fMA","avatar_url":"https://avatars.githubusercontent.com/u/242065200?v=4","gravatar_id":"","url":"https://api.github.com/users/ningyi-oai","html_url":"https://github.com/ningyi-oai","followers_url":"https://api.github.com/users/ningyi-oai/followers","following_url":"https://api.github.com/users/ningyi-oai/following{/other_user}","gists_url":"https://api.github.com/users/ningyi-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/ningyi-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ningyi-oai/subscriptions","organizations_url":"https://api.github.com/users/ningyi-oai/orgs","repos_url":"https://api.github.com/users/ningyi-oai/repos","events_url":"https://api.github.com/users/ningyi-oai/events{/privacy}","received_events_url":"https://api.github.com/users/ningyi-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f0f483e8b2a2630bf8dfa5f8451e81eba20def6c","url":"https://api.github.com/repos/openai/codex/commits/f0f483e8b2a2630bf8dfa5f8451e81eba20def6c","html_url":"https://github.com/openai/codex/commit/f0f483e8b2a2630bf8dfa5f8451e81eba20def6c"}]},{"sha":"f0f483e8b2a2630bf8dfa5f8451e81eba20def6c","node_id":"C_kwDOOYsS4doAKGYwZjQ4M2U4YjJhMjYzMGJmOGRmYTVmODQ1MWU4MWViYTIwZGVmNmM","commit":{"author":{"name":"canvrno-oai","email":"kbond@openai.com","date":"2026-05-27T18:08:16Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T18:08:16Z"},"message":"[codex] Remove stale composer narrative doc references (#24641)\n\n## Context\n\n`docs/tui-chat-composer.md` was removed by #20896 as part of removing\nlocal-only docs/specs from the repository. I checked the #20896 file\nlist and the merge commit: the composer doc was deleted, not moved or\ncopied, and current `main` does not contain a replacement composer\nnarrative doc.\n\nCurrent guidance should keep contributors and agents focused on the docs\nthat still exist: the module docs in `chat_composer.rs` and\n`paste_burst.rs`.\n\n## Summary\n\n- Removes the scoped TUI bottom-pane AGENTS.md requirement to update\n`docs/tui-chat-composer.md`.\n- Removes stale module-doc references to that deleted narrative doc from\n`chat_composer.rs` and `paste_burst.rs`.\n\n## Validation\n\n- Checked #20896 and the merge commit with rename/copy detection to\nconfirm `docs/tui-chat-composer.md` was deleted rather than moved.\n- Searched current `main` for a replacement composer narrative doc.\n- Not run; documentation-only change.","tree":{"sha":"865c115e1cab19ac36ef358363ba57c5be7d7287","url":"https://api.github.com/repos/openai/codex/git/trees/865c115e1cab19ac36ef358363ba57c5be7d7287"},"url":"https://api.github.com/repos/openai/codex/git/commits/f0f483e8b2a2630bf8dfa5f8451e81eba20def6c","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqFzMRCRC1aQ7uu5UhlAAAQa4QADe/qi1+rvACLvTezcQmC98P\n6Bvv9p5H19Q0OmoVH42S/hAZz7QDS/wjQ5FDVOGUC14eFgbK4WP45bUsPVYsRyvS\njPioxCi/u6z4jLyiqlgBRjIyZu55tIqv7SgTpcs/7EWWwhPl3t7rVB4v1nLkQGVP\noYLOGtQjGh818C4WpXqfFqGtUV+LVarR744BVMbEn7Aj+QjIy7KrBMPSG53YlOTx\nPdffXzRm9wylvjs2O770KKixN6h1IhsfGsc9aCS/HQeLs9bAkR7wi5i8U9X7pubm\nJGWj/Pj5/b29bs86UvExwymhk1Pa1C09EOj53Qrvc3FNzwHkoE2tCB8h01k5KcRP\nAFPYKJFEklK15ei3a1yjmHpapAEHFy97NFoHQdlcqQxjWVK/F7ox72RkodxlTq40\n0n145u6s3zIu8cBenV/ka8D0glnMDWSS2SxtgGO6ynccKI26z028vqaVG02FrOIN\nuB1BV3vow6aKo4MbIG++/MIGignFCWcfdn+g9gvGgkLSnQwzE3eVUb/zEjRWbOtv\nVm1VRxN5JbesONsrifOfoukxeruJ2UYuV2wiSb+eNG8vrQizIloTCYIvmyC6iaRD\nimjdC7i387bAMSuF8VsOpN+naojhCWZfcvKGgCy5h5qmeLtEYOWQ3KCKJDj7k/KP\nQLdaUpvO+JO8CCOZ4UpC\n=gwTL\n-----END PGP SIGNATURE-----\n","payload":"tree 865c115e1cab19ac36ef358363ba57c5be7d7287\nparent 8fcf2ad931b90589dd29a571f367e3185d26bbe0\nauthor canvrno-oai <kbond@openai.com> 1779905296 -0700\ncommitter GitHub <noreply@github.com> 1779905296 -0700\n\n[codex] Remove stale composer narrative doc references (#24641)\n\n## Context\n\n`docs/tui-chat-composer.md` was removed by #20896 as part of removing\nlocal-only docs/specs from the repository. I checked the #20896 file\nlist and the merge commit: the composer doc was deleted, not moved or\ncopied, and current `main` does not contain a replacement composer\nnarrative doc.\n\nCurrent guidance should keep contributors and agents focused on the docs\nthat still exist: the module docs in `chat_composer.rs` and\n`paste_burst.rs`.\n\n## Summary\n\n- Removes the scoped TUI bottom-pane AGENTS.md requirement to update\n`docs/tui-chat-composer.md`.\n- Removes stale module-doc references to that deleted narrative doc from\n`chat_composer.rs` and `paste_burst.rs`.\n\n## Validation\n\n- Checked #20896 and the merge commit with rename/copy detection to\nconfirm `docs/tui-chat-composer.md` was deleted rather than moved.\n- Searched current `main` for a replacement composer narrative doc.\n- Not run; documentation-only change.","verified_at":"2026-05-27T18:08:17Z"}},"url":"https://api.github.com/repos/openai/codex/commits/f0f483e8b2a2630bf8dfa5f8451e81eba20def6c","html_url":"https://github.com/openai/codex/commit/f0f483e8b2a2630bf8dfa5f8451e81eba20def6c","comments_url":"https://api.github.com/repos/openai/codex/commits/f0f483e8b2a2630bf8dfa5f8451e81eba20def6c/comments","author":{"login":"canvrno-oai","id":257630656,"node_id":"U_kgDOD1shwA","avatar_url":"https://avatars.githubusercontent.com/u/257630656?v=4","gravatar_id":"","url":"https://api.github.com/users/canvrno-oai","html_url":"https://github.com/canvrno-oai","followers_url":"https://api.github.com/users/canvrno-oai/followers","following_url":"https://api.github.com/users/canvrno-oai/following{/other_user}","gists_url":"https://api.github.com/users/canvrno-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/canvrno-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/canvrno-oai/subscriptions","organizations_url":"https://api.github.com/users/canvrno-oai/orgs","repos_url":"https://api.github.com/users/canvrno-oai/repos","events_url":"https://api.github.com/users/canvrno-oai/events{/privacy}","received_events_url":"https://api.github.com/users/canvrno-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"8fcf2ad931b90589dd29a571f367e3185d26bbe0","url":"https://api.github.com/repos/openai/codex/commits/8fcf2ad931b90589dd29a571f367e3185d26bbe0","html_url":"https://github.com/openai/codex/commit/8fcf2ad931b90589dd29a571f367e3185d26bbe0"}]},{"sha":"8fcf2ad931b90589dd29a571f367e3185d26bbe0","node_id":"C_kwDOOYsS4doAKDhmY2YyYWQ5MzFiOTA1ODlkZDI5YTU3MWYzNjdlMzE4NWQyNmJiZTA","commit":{"author":{"name":"canvrno-oai","email":"kbond@openai.com","date":"2026-05-27T18:05:42Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T18:05:42Z"},"message":"fix: Preserve draft text when completing argument-taking slash commands (#23950)\n\nThis adds slash command completion behavior for argument-taking\ncommands, where text after the partially typed command becomes inline\narguments instead of being discarded. This addresses the workflow of\ndrafting text first, moving to the start, and completing a slash command\naround that existing draft. Before this change, this workflow would\nremove all user-input text aside from the slash command, which can be\nfrustrating if the user had just typed out a long and well thought out\ngoal.\n\n- Preserves the draft tail for inline-argument slash commands like\n`/goal` and `/review` when completing with `Tab` or `Enter`.\n- Keeps popup filtering focused on the command fragment under the cursor\nrather than the full draft text.\n- Leaves slash commands that do not support inline arguments unchanged,\nso completion still replaces the existing draft tail for those commands.\n- Adds focused TUI tests under slash input covering preserved arguments,\ncursor edge cases, and the negative case for a command without inline\nargs.\n  \nFollow-up simplification and test relocation from #24683 folded into\nthis PR.\n\n---------\n\nCo-authored-by: Eric Traut <etraut@openai.com>","tree":{"sha":"f5f834832af626f97d2156598b026fee8ef8ad6c","url":"https://api.github.com/repos/openai/codex/git/trees/f5f834832af626f97d2156598b026fee8ef8ad6c"},"url":"https://api.github.com/repos/openai/codex/git/commits/8fcf2ad931b90589dd29a571f367e3185d26bbe0","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqFzJ2CRC1aQ7uu5UhlAAAQO4QAEunJei8fMK6S2hJmAiNwb3A\nw4L5V8wVchz54hAuTe+uunCyrI/sw6VvVMipkh+XSjEfPcImD5pUiyffDXThClsA\n9g3pJCezSCFhn35RzV6ZX8nrjEwMY786Wc99RLjCjkqMTx11pukxCI3Xn0VuCyw+\nZ4v5liNdSTZkO8fvwEFizzAEmjlo0U1u0zyVtZFWQDCklVGuedBkLA2LlJxnl3h3\ni7pZa5UZXnJGSien8xkHSvrBMkcBGYpGlJFYnZgXs033qcTg2lHB9bwEtS61HoV3\nj34vQCifZLzw9ZnOPLxf9ByavcR+TLmKOiXYCFPZy/tK/mVNjYzxQQmgKH9MfYKo\nryic+/nDBet6E2nWoJ2QnQBkFk77sq4IhhL4H0CkdO5JghIfWRsGyw027rlwNrHF\nvdV/eV4Q746WKsi8VzsIJ7+zcI1vRYEQzqGRiUnZz5/qMiIHQpy2H/u86WzX0KOE\n1m+G45SPy5LZQqZQmSnriSl1ClbxAZIoqlBL+o4OzskcZB2BcHyoi2u7bjHaI+Rh\n0F0Sr+l75VmuA2ZA6AP4bBKy2p3dWDsmUpaznHuqU+iw8THUjHo6GQpRH53qpBG+\nnH2P2E//FPGRZDEnUJvGTjf19BjJ1qzNBsS2e+bhcRIEez4kZW5fZw1INyWKlpc5\nBGdWrdyllnoWMwH/lvoa\n=LhmT\n-----END PGP SIGNATURE-----\n","payload":"tree f5f834832af626f97d2156598b026fee8ef8ad6c\nparent 155905cf725d6c393cd29b1cd2ab9482fe651a32\nauthor canvrno-oai <kbond@openai.com> 1779905142 -0700\ncommitter GitHub <noreply@github.com> 1779905142 -0700\n\nfix: Preserve draft text when completing argument-taking slash commands (#23950)\n\nThis adds slash command completion behavior for argument-taking\ncommands, where text after the partially typed command becomes inline\narguments instead of being discarded. This addresses the workflow of\ndrafting text first, moving to the start, and completing a slash command\naround that existing draft. Before this change, this workflow would\nremove all user-input text aside from the slash command, which can be\nfrustrating if the user had just typed out a long and well thought out\ngoal.\n\n- Preserves the draft tail for inline-argument slash commands like\n`/goal` and `/review` when completing with `Tab` or `Enter`.\n- Keeps popup filtering focused on the command fragment under the cursor\nrather than the full draft text.\n- Leaves slash commands that do not support inline arguments unchanged,\nso completion still replaces the existing draft tail for those commands.\n- Adds focused TUI tests under slash input covering preserved arguments,\ncursor edge cases, and the negative case for a command without inline\nargs.\n  \nFollow-up simplification and test relocation from #24683 folded into\nthis PR.\n\n---------\n\nCo-authored-by: Eric Traut <etraut@openai.com>","verified_at":"2026-05-27T18:05:43Z"}},"url":"https://api.github.com/repos/openai/codex/commits/8fcf2ad931b90589dd29a571f367e3185d26bbe0","html_url":"https://github.com/openai/codex/commit/8fcf2ad931b90589dd29a571f367e3185d26bbe0","comments_url":"https://api.github.com/repos/openai/codex/commits/8fcf2ad931b90589dd29a571f367e3185d26bbe0/comments","author":{"login":"canvrno-oai","id":257630656,"node_id":"U_kgDOD1shwA","avatar_url":"https://avatars.githubusercontent.com/u/257630656?v=4","gravatar_id":"","url":"https://api.github.com/users/canvrno-oai","html_url":"https://github.com/canvrno-oai","followers_url":"https://api.github.com/users/canvrno-oai/followers","following_url":"https://api.github.com/users/canvrno-oai/following{/other_user}","gists_url":"https://api.github.com/users/canvrno-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/canvrno-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/canvrno-oai/subscriptions","organizations_url":"https://api.github.com/users/canvrno-oai/orgs","repos_url":"https://api.github.com/users/canvrno-oai/repos","events_url":"https://api.github.com/users/canvrno-oai/events{/privacy}","received_events_url":"https://api.github.com/users/canvrno-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"155905cf725d6c393cd29b1cd2ab9482fe651a32","url":"https://api.github.com/repos/openai/codex/commits/155905cf725d6c393cd29b1cd2ab9482fe651a32","html_url":"https://github.com/openai/codex/commit/155905cf725d6c393cd29b1cd2ab9482fe651a32"}]},{"sha":"155905cf725d6c393cd29b1cd2ab9482fe651a32","node_id":"C_kwDOOYsS4doAKDE1NTkwNWNmNzI1ZDZjMzkzY2QyOWIxY2QyYWI5NDgyZmU2NTFhMzI","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-05-27T17:00:05Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T17:00:05Z"},"message":"make vercel webhook url an env secret (#24778)\n\nmove `DEV_WEBSITE_VERCEL_DEPLOY_HOOK_URL` to a repo environment secret.\n\nto keep scope of use of that env secret small, move the vercel website\nredeploy to its own post-release job.","tree":{"sha":"451cd4b1da2023bd064c30c8f63de9373cf482c1","url":"https://api.github.com/repos/openai/codex/git/trees/451cd4b1da2023bd064c30c8f63de9373cf482c1"},"url":"https://api.github.com/repos/openai/codex/git/commits/155905cf725d6c393cd29b1cd2ab9482fe651a32","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqFyMVCRC1aQ7uu5UhlAAAhLAQADA9a/Nlu4axvMZ3pdCqbXP/\n9wudXIQnSF8f2XJHpuxguDeu7TDBXgrHSFYKZhCDKIBnqc0OO0niP28hON2SCZ+V\nCwhf9L5FZ2N9hACPFnfukC3JIALlr8m+8fM3niTHApU9u/NE994pDQ8mFtUk7mwD\nDxiFlqmhR7Zip1k2HO7Jx50OnwjFGHsCOs2+Ng+gQrgWQSC2MeEMVNHH5W5TFUf0\n6Yw0XGcUoy9m7mMzu2YNkT2Y7R4LH89DIokXzw3OW1+sLLziYiCGmBqQU/NR5mCf\nfFHFbBgqHv9doNBZQ0J4v9rGgvPaVDq2y1puDxWh8DUkBXfEvXuBeZOj8pVuL/WM\nEUSc2DNa+UvaA94cR9W2xiwMyjM+HbKN8+JP2PkRETIUR5NeLKUPKtqw+jOMbdNA\nTLuoO2kJBSMJRNAooCWj0J0jDhlzyXnK0iCBzHDVWNKzyZ+mCiDD0W6NoyPErzaP\nusltAhJaKADN2B67oaxjbacDpRVmB+vrn5GwwsabDABCjvjxR7p2haFDcpLbgJrQ\nlHNaxnFu30FZxdBIov1BoXmRNXkwYGu5+G0Fj83z8qlcxG2jw2yKHKQT9QhkpXnu\nteBnsFZ0gyqPkvxPEfWXzUOHHSaooMpCidAE1kFEYYuKXpVjX1DNexZST+G/UkM2\nj18cRPg7S+IfnebfJ4rd\n=dNtW\n-----END PGP SIGNATURE-----\n","payload":"tree 451cd4b1da2023bd064c30c8f63de9373cf482c1\nparent 5314f55097c2c56e4ca60e98ce6f4c9f755fc12f\nauthor sayan-oai <sayan@openai.com> 1779901205 -0700\ncommitter GitHub <noreply@github.com> 1779901205 -0700\n\nmake vercel webhook url an env secret (#24778)\n\nmove `DEV_WEBSITE_VERCEL_DEPLOY_HOOK_URL` to a repo environment secret.\n\nto keep scope of use of that env secret small, move the vercel website\nredeploy to its own post-release job.","verified_at":"2026-05-27T17:00:06Z"}},"url":"https://api.github.com/repos/openai/codex/commits/155905cf725d6c393cd29b1cd2ab9482fe651a32","html_url":"https://github.com/openai/codex/commit/155905cf725d6c393cd29b1cd2ab9482fe651a32","comments_url":"https://api.github.com/repos/openai/codex/commits/155905cf725d6c393cd29b1cd2ab9482fe651a32/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"5314f55097c2c56e4ca60e98ce6f4c9f755fc12f","url":"https://api.github.com/repos/openai/codex/commits/5314f55097c2c56e4ca60e98ce6f4c9f755fc12f","html_url":"https://github.com/openai/codex/commit/5314f55097c2c56e4ca60e98ce6f4c9f755fc12f"}]},{"sha":"5314f55097c2c56e4ca60e98ce6f4c9f755fc12f","node_id":"C_kwDOOYsS4doAKDUzMTRmNTUwOTdjMmM1NmU0Y2E2MGU5OGNlNmY0YzlmNzU1ZmMxMmY","commit":{"author":{"name":"efrazer-oai","email":"efrazer@openai.com","date":"2026-05-27T16:45:10Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T16:45:10Z"},"message":"fix: run standalone updates noninteractively (#24637)\n\n# Summary\n\nThe standalone update action currently downloads and runs the Codex\ninstaller as an interactive command. When an existing managed Codex\ninstall is present, accepting an update can therefore enter an installer\nprompt instead of completing the update.\n\nThis change runs the standalone installer with `CODEX_NON_INTERACTIVE=1`\non macOS/Linux and Windows. The installer environment-variable support\nis introduced by the parent PR; this PR wires that behavior into the\nCodex CLI update action. The rendered Windows command remains\nshell-safe, and long update commands wrap within the update-notice card.\nThe standard test target snapshots the standalone notice for both\nplatforms.\n\n# Stack\n\n1. [#21567](https://github.com/openai/codex/pull/21567) - Adds\nenvironment-controlled release selection and noninteractive installer\nbehavior.\n2. [#24637](https://github.com/openai/codex/pull/24637) - Runs\nstandalone updates with `CODEX_NON_INTERACTIVE=1`. (current)\n3. [#24639](https://github.com/openai/codex/pull/24639) - Removes\nexplicit release argument inputs in favor of `CODEX_RELEASE`.\n\n# Evidence\n\nStandalone updater-shaped macOS install with an existing npm-managed\nCodex on `PATH`:\n\n\nhttps://github.com/user-attachments/assets/a27fe9e9-db3a-4c39-a514-24bd3d1f01e8\n\n# Testing\n\nTests: targeted `codex-tui` update-action and update-notice snapshot\ntests, Rust formatting, benchmark smoke validation, macOS live-terminal\nstandalone-update smoke testing, Windows ARM64 PowerShell\nstandalone-update smoke testing through Parallels, and CI.","tree":{"sha":"362393b523e5647747b6a51bb0872cabd3f0c199","url":"https://api.github.com/repos/openai/codex/git/trees/362393b523e5647747b6a51bb0872cabd3f0c199"},"url":"https://api.github.com/repos/openai/codex/git/commits/5314f55097c2c56e4ca60e98ce6f4c9f755fc12f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqFx+WCRC1aQ7uu5UhlAAAFgQQAKIvbmBBgz70mtCUoadIsPVO\nN+BdEusxaFej2D5Kb0Qbo576ofHBpM+cKjpuH+rZLfl8JZhTEYC6mmQj3c2Ctxdu\nfaQCEQOUFRrHGUqnyBvlY8vsE9Nq4YMXLp/Y6kUjvTKd+xkTTU7a/Q4vKtSZkKTK\nSLrwRuMQfyGppvBum3tmLVkq9WwNlIba+tvGojBGTHe1yyy5edappSO/0svTcIFZ\nBw18rbyQdjXv4zuYRQQ05i+psQdinVog78tYww5hDjcy8vs3OIFOL3dvzB2nJNDz\nV4Fcbz7wIOTgMtUayuQbiSwIVRCqygkquwhklOjtGo6k9NH/uA9dZTo/0y6P0Rac\nQyCv67rrYav2kEyK0+/N1RqMgfeAxktaX594lUiH6VtlPrSEhiFK6GL4I9eRFWzG\ngXryaC+f89xKeF3dYyTRK4Vm81gpEQ8ytXvisKD1n+Th8XmEqa34W3ELq7ndrxG7\nkCU6UHWjSjiqN5hdTyevM2CM21U4tHEAfQRo2o6bkLJQXoWVs3dRFIPw3dQE0dpp\nK+9QJFbTy8YPYab71q+xCe/jtEDj+po9AbM8nLu+Hs/ZgL5+pMNnX6eIaUQaQ/tp\nkfInrexeV9+6jiufHnK1kaSU4JYMdfLEXs5o/ghCHEmgEIOT7SCtmfhR6ojrSVvz\nx2OfCoYMa10dBo3OKDxd\n=0niS\n-----END PGP SIGNATURE-----\n","payload":"tree 362393b523e5647747b6a51bb0872cabd3f0c199\nparent 379511dceac290c273afc0e805e606f8ba438f2e\nauthor efrazer-oai <efrazer@openai.com> 1779900310 -0700\ncommitter GitHub <noreply@github.com> 1779900310 +0000\n\nfix: run standalone updates noninteractively (#24637)\n\n# Summary\n\nThe standalone update action currently downloads and runs the Codex\ninstaller as an interactive command. When an existing managed Codex\ninstall is present, accepting an update can therefore enter an installer\nprompt instead of completing the update.\n\nThis change runs the standalone installer with `CODEX_NON_INTERACTIVE=1`\non macOS/Linux and Windows. The installer environment-variable support\nis introduced by the parent PR; this PR wires that behavior into the\nCodex CLI update action. The rendered Windows command remains\nshell-safe, and long update commands wrap within the update-notice card.\nThe standard test target snapshots the standalone notice for both\nplatforms.\n\n# Stack\n\n1. [#21567](https://github.com/openai/codex/pull/21567) - Adds\nenvironment-controlled release selection and noninteractive installer\nbehavior.\n2. [#24637](https://github.com/openai/codex/pull/24637) - Runs\nstandalone updates with `CODEX_NON_INTERACTIVE=1`. (current)\n3. [#24639](https://github.com/openai/codex/pull/24639) - Removes\nexplicit release argument inputs in favor of `CODEX_RELEASE`.\n\n# Evidence\n\nStandalone updater-shaped macOS install with an existing npm-managed\nCodex on `PATH`:\n\n\nhttps://github.com/user-attachments/assets/a27fe9e9-db3a-4c39-a514-24bd3d1f01e8\n\n# Testing\n\nTests: targeted `codex-tui` update-action and update-notice snapshot\ntests, Rust formatting, benchmark smoke validation, macOS live-terminal\nstandalone-update smoke testing, Windows ARM64 PowerShell\nstandalone-update smoke testing through Parallels, and CI.","verified_at":"2026-05-27T16:45:11Z"}},"url":"https://api.github.com/repos/openai/codex/commits/5314f55097c2c56e4ca60e98ce6f4c9f755fc12f","html_url":"https://github.com/openai/codex/commit/5314f55097c2c56e4ca60e98ce6f4c9f755fc12f","comments_url":"https://api.github.com/repos/openai/codex/commits/5314f55097c2c56e4ca60e98ce6f4c9f755fc12f/comments","author":{"login":"efrazer-oai","id":263771262,"node_id":"U_kgDOD7jUfg","avatar_url":"https://avatars.githubusercontent.com/u/263771262?v=4","gravatar_id":"","url":"https://api.github.com/users/efrazer-oai","html_url":"https://github.com/efrazer-oai","followers_url":"https://api.github.com/users/efrazer-oai/followers","following_url":"https://api.github.com/users/efrazer-oai/following{/other_user}","gists_url":"https://api.github.com/users/efrazer-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/efrazer-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/efrazer-oai/subscriptions","organizations_url":"https://api.github.com/users/efrazer-oai/orgs","repos_url":"https://api.github.com/users/efrazer-oai/repos","events_url":"https://api.github.com/users/efrazer-oai/events{/privacy}","received_events_url":"https://api.github.com/users/efrazer-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"379511dceac290c273afc0e805e606f8ba438f2e","url":"https://api.github.com/repos/openai/codex/commits/379511dceac290c273afc0e805e606f8ba438f2e","html_url":"https://github.com/openai/codex/commit/379511dceac290c273afc0e805e606f8ba438f2e"}]},{"sha":"379511dceac290c273afc0e805e606f8ba438f2e","node_id":"C_kwDOOYsS4doAKDM3OTUxMWRjZWFjMjkwYzI3M2FmYzBlODA1ZTYwNmY4YmE0MzhmMmU","commit":{"author":{"name":"jif-oai","email":"jif@openai.com","date":"2026-05-27T16:44:07Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T16:44:07Z"},"message":"Bump SQLx to pick up newer bundled SQLite (#24728)\n\n## Why\n\nCodex stores thread, log, goal, and memory state in bundled SQLite\ndatabases through SQLx. We have a suspected SQLite WAL-reset corruption\nissue under heavy concurrent writer load, especially when multiple\nsubagents are active. The existing `sqlx 0.8.6` dependency kept us on an\nolder `libsqlite3-sys` / bundled SQLite, so this PR moves the SQLx stack\nfar enough forward to pick up the newer bundled SQLite library.\n\n## What changed\n\n- Bump the workspace `sqlx` dependency to `0.9.0`.\n- Use the SQLx 0.9 feature names explicitly: `runtime-tokio`,\n`tls-rustls`, and `sqlite-bundled`.\n- Update `Cargo.lock` so `sqlx-sqlite` resolves through `libsqlite3-sys\n0.37.0`.\n- Refresh `MODULE.bazel.lock` for the dependency changes.\n- Adapt `codex-state` to SQLx 0.9:\n- build dynamic state queries with `QueryBuilder<Sqlite>` instead of\npassing dynamic `String`s to `sqlx::query`;\n- remove the old `QueryBuilder` lifetime parameter from helper\nsignatures;\n- preserve SQLx's new `Migrator` fields when constructing runtime\nmigrators.\n\n## Verification\n\n- `just test -p codex-state`\n- `just bazel-lock-check`\n- `cargo check -p codex-state --tests`","tree":{"sha":"12af1d41fd88ba9b923480619fa7df1e62879a11","url":"https://api.github.com/repos/openai/codex/git/trees/12af1d41fd88ba9b923480619fa7df1e62879a11"},"url":"https://api.github.com/repos/openai/codex/git/commits/379511dceac290c273afc0e805e606f8ba438f2e","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqFx9XCRC1aQ7uu5UhlAAAq6sQABMjxo3l9DzLqnuEKGwV4KlC\n0rw4QWclCsVLg+jmt8JeblucRdS+DMsoKFjBxTUqSMk1KsuBrNOUF+nqtL23C6LM\nte3FTYIGJJmBtk1wVvm7SbEoCfPB9ZIztfvtlyC4nzviLSCxJ0umEStp4OPUElnm\nM3gcvt+8mym3qOUmCP7MB/e5IcUPGwboyFOU8YUqFLq+qtphAE1+f81zfDYgUEq5\nB3urme6rsMThxnEWwYQJWe0kZ44y87N+NSiu67qX1y5ylaRlIiDfcUemeASMjecW\nGVHcIXen01K5nRk+rwSdiaMBMNkuz7RIdIYGKZkxqBKOcwj5rYqHjTdTUvehQnmV\nNcE8JPCAkoKFF+SIrySwIdTdM6dSu8+rWjCcPJlig61RWrWYom3Bb0M62+N7RQ1W\n3iWCQ3JYVRrjTCm0tv8d9Kd2JEma5lng7gP/hDf9u9IyAMrBWoVzFUrnRAVRxNnI\n6hgmUP5rt+sCa1T1N6UWqh1wepWu39b/xM6utintLAJ5Sv8s/W4q4qpvBIEFG4cy\nMESLfaatT9QtfTAzbr7xHXCA72DHj2+qjvESR5HNtaiQkHmcA10tcOwgmRI4IrS4\nyOK9KvWpre0+XMvbcayFMHglbcn19c1mbi0tcg7wWA3j7WazcJhpCGKx4sv9y9ja\nQmGYMuTINKVB1VnOR2vC\n=uHwp\n-----END PGP SIGNATURE-----\n","payload":"tree 12af1d41fd88ba9b923480619fa7df1e62879a11\nparent aa184548b1ee0a559fba7be658240053e270e16f\nauthor jif-oai <jif@openai.com> 1779900247 +0200\ncommitter GitHub <noreply@github.com> 1779900247 +0200\n\nBump SQLx to pick up newer bundled SQLite (#24728)\n\n## Why\n\nCodex stores thread, log, goal, and memory state in bundled SQLite\ndatabases through SQLx. We have a suspected SQLite WAL-reset corruption\nissue under heavy concurrent writer load, especially when multiple\nsubagents are active. The existing `sqlx 0.8.6` dependency kept us on an\nolder `libsqlite3-sys` / bundled SQLite, so this PR moves the SQLx stack\nfar enough forward to pick up the newer bundled SQLite library.\n\n## What changed\n\n- Bump the workspace `sqlx` dependency to `0.9.0`.\n- Use the SQLx 0.9 feature names explicitly: `runtime-tokio`,\n`tls-rustls`, and `sqlite-bundled`.\n- Update `Cargo.lock` so `sqlx-sqlite` resolves through `libsqlite3-sys\n0.37.0`.\n- Refresh `MODULE.bazel.lock` for the dependency changes.\n- Adapt `codex-state` to SQLx 0.9:\n- build dynamic state queries with `QueryBuilder<Sqlite>` instead of\npassing dynamic `String`s to `sqlx::query`;\n- remove the old `QueryBuilder` lifetime parameter from helper\nsignatures;\n- preserve SQLx's new `Migrator` fields when constructing runtime\nmigrators.\n\n## Verification\n\n- `just test -p codex-state`\n- `just bazel-lock-check`\n- `cargo check -p codex-state --tests`","verified_at":"2026-05-27T16:44:08Z"}},"url":"https://api.github.com/repos/openai/codex/commits/379511dceac290c273afc0e805e606f8ba438f2e","html_url":"https://github.com/openai/codex/commit/379511dceac290c273afc0e805e606f8ba438f2e","comments_url":"https://api.github.com/repos/openai/codex/commits/379511dceac290c273afc0e805e606f8ba438f2e/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"aa184548b1ee0a559fba7be658240053e270e16f","url":"https://api.github.com/repos/openai/codex/commits/aa184548b1ee0a559fba7be658240053e270e16f","html_url":"https://github.com/openai/codex/commit/aa184548b1ee0a559fba7be658240053e270e16f"}]},{"sha":"aa184548b1ee0a559fba7be658240053e270e16f","node_id":"C_kwDOOYsS4doAKGFhMTg0NTQ4YjFlZTBhNTU5ZmJhN2JlNjU4MjQwMDUzZTI3MGUxNmY","commit":{"author":{"name":"Felipe Coury","email":"felipe.coury@openai.com","date":"2026-05-27T14:36:52Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T14:36:52Z"},"message":"fix(tui): complete vim word-end and line-end behavior (#24380)\n\n## Why\n\nThe TUI Vim composer currently diverges from normal Vim editing in two\ncommon workflows: pressing `e` repeatedly can remain stuck at an\nexisting word end, and normal mode does not support `C` for changing\nthrough the end of the line. The existing `D` behavior also removes the\nnewline when the cursor is already at the line boundary, which makes the\nnew `C` action and existing deletion action surprising in multiline\nprompts.\n\nCloses #23926.\nCloses #24238.\n\n## What Changed\n\n- Make normal-mode `e` advance from the current word end to the next\nword end, including for operator motions such as `de`.\n- Add configurable Vim normal-mode `change_to_line_end` behavior, bound\nto `C` by default, which deletes to the end of the current line and\nenters Insert mode.\n- Keep the newline intact when `D` or `C` is pressed at the end-of-line\nboundary.\n- Add regression coverage for repeated `e`, `de`, `C`, and the multiline\n`C`/`D` boundary behavior.\n- Regenerate the config schema and update the keymap picker snapshots\nfor the new Vim action.\n\n## How to Test\n\n1. Run Codex with Vim composer mode enabled:\n   ```bash\n   cd codex-rs\n   cargo run --bin codex -- -c tui.vim_mode_default=true\n   ```\n2. Enter `alpha beta gamma`, press `Esc`, `0`, then press `e`\nrepeatedly.\nConfirm the cursor advances through the ends of `alpha`, `beta`, and\n`gamma`.\n3. Enter `hello world`, press `Esc`, `0`, `w`, then `C`.\n   Confirm `world` is deleted and the composer enters Insert mode.\n4. Enter a multiline prompt with `hello` above `world`, press `Esc`,\n`k`, `$`, and then `D`.\n   Confirm the newline is preserved and the two lines do not join.\n5. At the same boundary, press `C` and type `!`.\nConfirm the composer enters Insert mode and yields `hello!` above\n`world`, preserving the newline.\n\nTargeted automated verification:\n- `just fix -p codex-tui`\n- `just argument-comment-lint-from-source -p codex-tui -p codex-config`\n- `cargo insta pending-snapshots` reports no pending snapshots.\n- `just test -p codex-tui` validates the new Vim and keymap snapshot\ncoverage, but the command remains red due to two reproducible unrelated\nfailures in `app::tests::update_feature_flags_disabling_guardian_*`.\n\n## Validation Note\n\nThe workspace-wide `just argument-comment-lint` form is currently\nblocked during Bazel analysis by the existing LLVM `compiler-rt` missing\n`include/sanitizer/*.h` failure; package-scoped source linting for the\nchanged Rust crates passed.","tree":{"sha":"8d2eab539ae42ab7f2ae47bd3e8eac746e63711d","url":"https://api.github.com/repos/openai/codex/git/trees/8d2eab539ae42ab7f2ae47bd3e8eac746e63711d"},"url":"https://api.github.com/repos/openai/codex/git/commits/aa184548b1ee0a559fba7be658240053e270e16f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqFwGECRC1aQ7uu5UhlAAAluYQABBrHi6q1/COowiBf+pOu3ew\n/yhecYNdsOa0EU3vCbILAWIFlaNtWhyDT7/rjeSbRYvJNi5rfG/x3/ELXN5p78k0\nEgLRwFoj5c9y+u2qfarTqRgBVzaTCRfB41vu/pCddBlal2FhoDWnj+feXnhqVYKS\nV0doa5JsskDbiCf8fgl8Xp3C2B+ji1k4YduIX15G8WiSZL1Bid6hnDrFIi3TQ6iY\nNm65YM2gBYZHz6M3ZYpbhWwvtnZmEm0fRfqaDJU5quxsQM78jxVagugWU8sKZBu7\nu+qrsVEtM7afRXMTQM8o7Z6ksNoRCvMwSd7I3iHyuc5ETRR0YyyxpJ3P16htwkm3\nqTFlkkzo7WLS8oz9t0sLhIsue5f0Ezsjs1kpo+NyDINPye6ZLUx24CjuZTn9CD28\ndfepuwr1I6ixOQ4ZPQSmOvKyxTV6nH/bEmgLgGo7mugE6bpqDqiS+WrG8p1Ada9C\n6DWTDslEa38vwO5MauRn8EaPxk1xFH6JcrSwqQ3tCxvBSnyg9bJ+uGeuKt2LemgH\nDPWrvpK6H+Ub35UY/Ycn7FMtIzGsQyy2DX1ZhMGs825T2HEe6fkzC+kDpYoRT1qn\nt0bYYbKcgbX5FaPLkjwQaJMCRp7WPMhOwTj6b96/lumwX3/8fLQ7SUL3qigrUzJG\np6BumUw4Lr1jH8YxApzM\n=VIsm\n-----END PGP SIGNATURE-----\n","payload":"tree 8d2eab539ae42ab7f2ae47bd3e8eac746e63711d\nparent f20904c4d60c9c4d3349b2cb357ef83c6e1a4a2a\nauthor Felipe Coury <felipe.coury@openai.com> 1779892612 -0300\ncommitter GitHub <noreply@github.com> 1779892612 -0700\n\nfix(tui): complete vim word-end and line-end behavior (#24380)\n\n## Why\n\nThe TUI Vim composer currently diverges from normal Vim editing in two\ncommon workflows: pressing `e` repeatedly can remain stuck at an\nexisting word end, and normal mode does not support `C` for changing\nthrough the end of the line. The existing `D` behavior also removes the\nnewline when the cursor is already at the line boundary, which makes the\nnew `C` action and existing deletion action surprising in multiline\nprompts.\n\nCloses #23926.\nCloses #24238.\n\n## What Changed\n\n- Make normal-mode `e` advance from the current word end to the next\nword end, including for operator motions such as `de`.\n- Add configurable Vim normal-mode `change_to_line_end` behavior, bound\nto `C` by default, which deletes to the end of the current line and\nenters Insert mode.\n- Keep the newline intact when `D` or `C` is pressed at the end-of-line\nboundary.\n- Add regression coverage for repeated `e`, `de`, `C`, and the multiline\n`C`/`D` boundary behavior.\n- Regenerate the config schema and update the keymap picker snapshots\nfor the new Vim action.\n\n## How to Test\n\n1. Run Codex with Vim composer mode enabled:\n   ```bash\n   cd codex-rs\n   cargo run --bin codex -- -c tui.vim_mode_default=true\n   ```\n2. Enter `alpha beta gamma`, press `Esc`, `0`, then press `e`\nrepeatedly.\nConfirm the cursor advances through the ends of `alpha`, `beta`, and\n`gamma`.\n3. Enter `hello world`, press `Esc`, `0`, `w`, then `C`.\n   Confirm `world` is deleted and the composer enters Insert mode.\n4. Enter a multiline prompt with `hello` above `world`, press `Esc`,\n`k`, `$`, and then `D`.\n   Confirm the newline is preserved and the two lines do not join.\n5. At the same boundary, press `C` and type `!`.\nConfirm the composer enters Insert mode and yields `hello!` above\n`world`, preserving the newline.\n\nTargeted automated verification:\n- `just fix -p codex-tui`\n- `just argument-comment-lint-from-source -p codex-tui -p codex-config`\n- `cargo insta pending-snapshots` reports no pending snapshots.\n- `just test -p codex-tui` validates the new Vim and keymap snapshot\ncoverage, but the command remains red due to two reproducible unrelated\nfailures in `app::tests::update_feature_flags_disabling_guardian_*`.\n\n## Validation Note\n\nThe workspace-wide `just argument-comment-lint` form is currently\nblocked during Bazel analysis by the existing LLVM `compiler-rt` missing\n`include/sanitizer/*.h` failure; package-scoped source linting for the\nchanged Rust crates passed.","verified_at":"2026-05-27T14:36:53Z"}},"url":"https://api.github.com/repos/openai/codex/commits/aa184548b1ee0a559fba7be658240053e270e16f","html_url":"https://github.com/openai/codex/commit/aa184548b1ee0a559fba7be658240053e270e16f","comments_url":"https://api.github.com/repos/openai/codex/commits/aa184548b1ee0a559fba7be658240053e270e16f/comments","author":{"login":"fcoury-oai","id":272635208,"node_id":"U_kgDOEEAVSA","avatar_url":"https://avatars.githubusercontent.com/u/272635208?v=4","gravatar_id":"","url":"https://api.github.com/users/fcoury-oai","html_url":"https://github.com/fcoury-oai","followers_url":"https://api.github.com/users/fcoury-oai/followers","following_url":"https://api.github.com/users/fcoury-oai/following{/other_user}","gists_url":"https://api.github.com/users/fcoury-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/fcoury-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fcoury-oai/subscriptions","organizations_url":"https://api.github.com/users/fcoury-oai/orgs","repos_url":"https://api.github.com/users/fcoury-oai/repos","events_url":"https://api.github.com/users/fcoury-oai/events{/privacy}","received_events_url":"https://api.github.com/users/fcoury-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f20904c4d60c9c4d3349b2cb357ef83c6e1a4a2a","url":"https://api.github.com/repos/openai/codex/commits/f20904c4d60c9c4d3349b2cb357ef83c6e1a4a2a","html_url":"https://github.com/openai/codex/commit/f20904c4d60c9c4d3349b2cb357ef83c6e1a4a2a"}]},{"sha":"f20904c4d60c9c4d3349b2cb357ef83c6e1a4a2a","node_id":"C_kwDOOYsS4doAKGYyMDkwNGM0ZDYwYzljNGQzMzQ5YjJjYjM1N2VmODNjNmUxYTRhMmE","commit":{"author":{"name":"Eric Traut","email":"etraut@openai.com","date":"2026-05-27T14:22:30Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T14:22:30Z"},"message":"TUI config cleanup: plugin marketplace (#24257)\n\n## Why\n\nPlugin and marketplace mutations are applied by the app server, but\nseveral TUI follow-up paths still refreshed state from the TUI host\nconfig. In remote workspace mode, that can leave plugin UI state tied to\nstale client-local `config.toml` after the server has already applied\nthe mutation.\n\n## What\n\n- Stop reloading the TUI host config after app-server-owned plugin,\nmarketplace, skill, and app mutations.\n- Use the same app-server-owned refresh path for local and remote\nsessions: ask the app server to reload user config where the running\nsession needs it, then refetch plugin list/detail state from the app\nserver.\n- Build plugin mention candidates from existing app-server `plugin/list`\nand `plugin/read` data in both local and remote sessions instead of\nTUI-host plugin config.\n- Avoid the duplicate local config reload after `ReloadUserConfig` asks\nthe app server to reload config.\n\n## Verification\n\nManually launched a local WebSocket app-server with a temp server\n`CODEX_HOME`, launched the TUI with a separate temp host `CODEX_HOME`\nand `--remote`, installed a sample plugin from a temp local marketplace\nthrough `/plugins`, and confirmed the TUI refreshed to installed state\nwhile only the server config gained `[plugins.\"sample@debug\"]`. Trace\nlogs showed the TUI using app-server `plugin/list` and `plugin/read` for\nthe refresh path.","tree":{"sha":"7385fc98954c8eabf9302f3c1a7d06b4748f5dc8","url":"https://api.github.com/repos/openai/codex/git/trees/7385fc98954c8eabf9302f3c1a7d06b4748f5dc8"},"url":"https://api.github.com/repos/openai/codex/git/commits/f20904c4d60c9c4d3349b2cb357ef83c6e1a4a2a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqFv4mCRC1aQ7uu5UhlAAAa3QQAKjyxgchI15vXaiEThwJD51E\n62Iro+ctVq/XQbWvz1V89MpCNN4907ASRjwN2tS5bmqqFgvuyPiHhSgEuwWzqMY2\nyue/mbTAflsBa3L71djegvotIw8aRDXqmWCo7YiIvkXLBUSAjlQtTrbg9AKVsM2m\nn2doftJJLNeZRJRwvztY1OudfdyiU4oPxKjL/JNwvDh067Dioc4f0FeYLKa2lq1F\nyH7r21OaIzebMUVciN/PkunW7r3i6eNIUaUTYQP2TRJOUUdqd5I2SU8DRDkKG9C+\naVg2hlL87Pi3QQ3oCKUwj3KrCUbw/sQOPun+0LubGV/4gbV6gQtVrBg6ZdVXsw5I\nspvvgC4JHkrfoXFOMaU9x4SiiBPa/P3qbq7LKdvrXS28Rnxr4LUM/Y7k5oHu+goq\nUcNkUaTN/Gm/86yq/09idMxNG5K83PL8lR6q5tISbrMKOwiGpQQ7uxBJhjlhze95\nejnlG3lFk+DJuG4xKdywLsYfBg/SAD5im7Iz3n6P2PrEBLLsoOy+wWXQoFA04vp+\nRkp8JUqXSFDLrfTYR7bfSI1De+d/OSZULmrtdSAEjcCgLKj8ITcGbuPxdqeH4Rtz\nSU3k3ECsJ8zlKh+Dy3Y51YhzdVu6VfBRU5/52gAhxnlcbTALVafkQT/t3eQMTWti\n5zs4OO7ZA01qfPzjE44a\n=tuEK\n-----END PGP SIGNATURE-----\n","payload":"tree 7385fc98954c8eabf9302f3c1a7d06b4748f5dc8\nparent 61cbf3574eca870df6fa7f49648ec7e001901b5a\nauthor Eric Traut <etraut@openai.com> 1779891750 -0700\ncommitter GitHub <noreply@github.com> 1779891750 -0700\n\nTUI config cleanup: plugin marketplace (#24257)\n\n## Why\n\nPlugin and marketplace mutations are applied by the app server, but\nseveral TUI follow-up paths still refreshed state from the TUI host\nconfig. In remote workspace mode, that can leave plugin UI state tied to\nstale client-local `config.toml` after the server has already applied\nthe mutation.\n\n## What\n\n- Stop reloading the TUI host config after app-server-owned plugin,\nmarketplace, skill, and app mutations.\n- Use the same app-server-owned refresh path for local and remote\nsessions: ask the app server to reload user config where the running\nsession needs it, then refetch plugin list/detail state from the app\nserver.\n- Build plugin mention candidates from existing app-server `plugin/list`\nand `plugin/read` data in both local and remote sessions instead of\nTUI-host plugin config.\n- Avoid the duplicate local config reload after `ReloadUserConfig` asks\nthe app server to reload config.\n\n## Verification\n\nManually launched a local WebSocket app-server with a temp server\n`CODEX_HOME`, launched the TUI with a separate temp host `CODEX_HOME`\nand `--remote`, installed a sample plugin from a temp local marketplace\nthrough `/plugins`, and confirmed the TUI refreshed to installed state\nwhile only the server config gained `[plugins.\"sample@debug\"]`. Trace\nlogs showed the TUI using app-server `plugin/list` and `plugin/read` for\nthe refresh path.","verified_at":"2026-05-27T14:22:32Z"}},"url":"https://api.github.com/repos/openai/codex/commits/f20904c4d60c9c4d3349b2cb357ef83c6e1a4a2a","html_url":"https://github.com/openai/codex/commit/f20904c4d60c9c4d3349b2cb357ef83c6e1a4a2a","comments_url":"https://api.github.com/repos/openai/codex/commits/f20904c4d60c9c4d3349b2cb357ef83c6e1a4a2a/comments","author":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"61cbf3574eca870df6fa7f49648ec7e001901b5a","url":"https://api.github.com/repos/openai/codex/commits/61cbf3574eca870df6fa7f49648ec7e001901b5a","html_url":"https://github.com/openai/codex/commit/61cbf3574eca870df6fa7f49648ec7e001901b5a"}]},{"sha":"61cbf3574eca870df6fa7f49648ec7e001901b5a","node_id":"C_kwDOOYsS4doAKDYxY2JmMzU3NGVjYTg3MGRmNmZhN2Y0OTY0OGVjN2UwMDE5MDFiNWE","commit":{"author":{"name":"jif-oai","email":"jif@openai.com","date":"2026-05-27T13:49:08Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T13:49:08Z"},"message":"Drop startup context when truncating forked rollouts (#24751)\n\n## Summary\n- Change last-`n` fork truncation to start at the first fork-turn\nboundary instead of returning the full rollout when the fork history is\nshorter than the requested window.\n- Add coverage for the startup-prefix case in both rollout truncation\ntests and agent control spawn behavior.\n- Ensure bounded forked children still rebuild context after the cached\nprefix is truncated.\n\n## Testing\n- Added unit coverage for truncation behavior when the parent history is\nunder the requested fork-turn limit.\n- Added an agent control test covering bounded fork spawn behavior with\nstartup context present.\n- Not run (not requested).","tree":{"sha":"610f41f314aafa200b1a77e0b997bac95def506c","url":"https://api.github.com/repos/openai/codex/git/trees/610f41f314aafa200b1a77e0b997bac95def506c"},"url":"https://api.github.com/repos/openai/codex/git/commits/61cbf3574eca870df6fa7f49648ec7e001901b5a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqFvZUCRC1aQ7uu5UhlAAA/6gQAHovRIagZ5kMtGTgpGsHSCO6\nYS9QD3EX5Zv7KC0fzikNQH+D73+xUiAoTvuSu+DjrDW7gCVNLzOducc3rxTY5q26\nUbXoWlo8HVXDEwBLOYn6orSCN7+oLj5d7qQ9VWkjK1nXYu591RTdQDOb6RdC4WWy\nu0dMFsUXq7PI7H3Nq1O1yZfKS8Ksw4cT/kHoYsO2TFoV25i6hjw+vjJT/tYCrkwr\n+DHs8/LWOSbVkSyhUDFYm62sRJUczEJU5usCj89WWNQ68wshhIj/U4Gs5VPqdFV/\n4rZs1iXTfhqZnSvk3cV1WNtKC+n+53Np/2frtF9GndMRoX6lPXWy58SUzhvy0HpT\ndE0XqreOUoX2KqqUiBeyVQ32YFd+R0lvrf2kfALLRakb5ETnzvn7yiwILi4Le39Q\nZMKuSECu5TnJJVzhMMR21ZmgkZMjcS423M188VmtUl9UdF2wN0cYqwZaPVnGofKA\njk/EVCMUbTESFcEpd00yn4FZvkrRBgOLeQrVb97B5LOoa872tRIOs9DflvzomUzg\nXUtvD/chSBLT69VK/oVf8bYuVynm4tF6bSv71Dyti1YEZ5T00Zv4T+DT5kuEGinW\n8EaAQvhJiMRhCxXjTI98bLSgZ3lJSZJBywu1pEnumTMxhWQPMklXtQZOvqup2a87\n4CCrXL9I/+xE+SbLP7Dz\n=SgMT\n-----END PGP SIGNATURE-----\n","payload":"tree 610f41f314aafa200b1a77e0b997bac95def506c\nparent d2ebb8d8caf6bc487466ee50f61eaa2dc53fa091\nauthor jif-oai <jif@openai.com> 1779889748 +0200\ncommitter GitHub <noreply@github.com> 1779889748 +0200\n\nDrop startup context when truncating forked rollouts (#24751)\n\n## Summary\n- Change last-`n` fork truncation to start at the first fork-turn\nboundary instead of returning the full rollout when the fork history is\nshorter than the requested window.\n- Add coverage for the startup-prefix case in both rollout truncation\ntests and agent control spawn behavior.\n- Ensure bounded forked children still rebuild context after the cached\nprefix is truncated.\n\n## Testing\n- Added unit coverage for truncation behavior when the parent history is\nunder the requested fork-turn limit.\n- Added an agent control test covering bounded fork spawn behavior with\nstartup context present.\n- Not run (not requested).","verified_at":"2026-05-27T13:49:09Z"}},"url":"https://api.github.com/repos/openai/codex/commits/61cbf3574eca870df6fa7f49648ec7e001901b5a","html_url":"https://github.com/openai/codex/commit/61cbf3574eca870df6fa7f49648ec7e001901b5a","comments_url":"https://api.github.com/repos/openai/codex/commits/61cbf3574eca870df6fa7f49648ec7e001901b5a/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"d2ebb8d8caf6bc487466ee50f61eaa2dc53fa091","url":"https://api.github.com/repos/openai/codex/commits/d2ebb8d8caf6bc487466ee50f61eaa2dc53fa091","html_url":"https://github.com/openai/codex/commit/d2ebb8d8caf6bc487466ee50f61eaa2dc53fa091"}]},{"sha":"d2ebb8d8caf6bc487466ee50f61eaa2dc53fa091","node_id":"C_kwDOOYsS4doAKGQyZWJiOGQ4Y2FmNmJjNDg3NDY2ZWU1MGY2MWVhYTJkYzUzZmEwOTE","commit":{"author":{"name":"jif-oai","email":"jif@openai.com","date":"2026-05-27T13:17:23Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T13:17:23Z"},"message":"feat: add thread idle lifecycle hook (#24744)\n\n## Why\n\nExtensions can currently observe thread start, resume, and stop, but\nthey do not have a lifecycle point for the host to say that immediately\npending thread work has drained. That makes idle follow-up behavior\nharder to express as extension-owned logic instead of host-specific\nplumbing.\n\nThis adds an explicit idle lifecycle hook so an extension can react when\na thread becomes idle while the host keeps ownership of whether any\nsubmitted follow-up input starts a turn, is queued, or is ignored.\n\n## What changed\n\n- Added `ThreadIdleInput` with access to the session-scoped and\nthread-scoped extension stores.\n- Added a default `on_thread_idle` method to\n`ThreadLifecycleContributor`.\n- Re-exported `ThreadIdleInput` from the extension API surface.\n\n## Testing\n\nNot run; this only extends the extension API trait surface with a\ndefault hook and exported input type.","tree":{"sha":"7590af8400d3705107d0adcaf2f41a0cad91ae1c","url":"https://api.github.com/repos/openai/codex/git/trees/7590af8400d3705107d0adcaf2f41a0cad91ae1c"},"url":"https://api.github.com/repos/openai/codex/git/commits/d2ebb8d8caf6bc487466ee50f61eaa2dc53fa091","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqFu7jCRC1aQ7uu5UhlAAAt6kQAHepNGnYw9hi1n3rdQPBTFpb\nxSfUqv+1Bm8eC152h4WLvusGfTTTpIH1W4KPHW2Nf+2++1in378Z/L2QZoXOqY5C\nFmoRk9Oqhy0Zsk7AwBmwbFWAh9U+qxSg/eWXzh5sEfouOCc+OlZd0Gf7lu910P5a\nUe52EqbgXbqpqp60o8q2NlnmiARmCnRFTPVwcKuTMIduKUH72BB6dPbj0ixOpCaC\ngavZBkpF3tMtzHK5Cy46iU8r6jvz2lxLrf0XcS2kp28PT+y7Is0JqFV4M9Ne9Luo\nO4qq3LipuGssUmj2lTw1zic1ncuLaSwnANIm/xLpI/K4/ASORflfEpu/zQM+Qk17\nJLV8DwnofaKKkAM+S0QD+OsFi12/8Bhq+PiBQCgyEKco6GSCv5sF7kAjGQWSILGw\nX/iEMhwkkMKmFrWn4UN+wxJj+5rQ9OkDJWRW8c5LRRh1n9R8dWADeAi/jdZxs21u\ndVQZn7LVZ+czlxS5wKCXl7l1vRSrX9Klg1H3SfpNopxH5R6r69F0Fy1+15G8eHd2\nIBrrzA8u3Zh8Sj+j4ue17bU8DObfrxvNfa5UPWFwj9WwTvmckXOnezfrJY2GZyss\ns4KuB03XKqoO+bga1V/WDU6ReyPXnedvtFbWk3rlEV5deO0fE2qpPqatjDw2SrKh\nbh7mcpX5pX8ipaOzBnvU\n=gaxY\n-----END PGP SIGNATURE-----\n","payload":"tree 7590af8400d3705107d0adcaf2f41a0cad91ae1c\nparent 7df8431bbdcdd6bdbac7d2dacd5b59aca0fb7732\nauthor jif-oai <jif@openai.com> 1779887843 +0200\ncommitter GitHub <noreply@github.com> 1779887843 +0200\n\nfeat: add thread idle lifecycle hook (#24744)\n\n## Why\n\nExtensions can currently observe thread start, resume, and stop, but\nthey do not have a lifecycle point for the host to say that immediately\npending thread work has drained. That makes idle follow-up behavior\nharder to express as extension-owned logic instead of host-specific\nplumbing.\n\nThis adds an explicit idle lifecycle hook so an extension can react when\na thread becomes idle while the host keeps ownership of whether any\nsubmitted follow-up input starts a turn, is queued, or is ignored.\n\n## What changed\n\n- Added `ThreadIdleInput` with access to the session-scoped and\nthread-scoped extension stores.\n- Added a default `on_thread_idle` method to\n`ThreadLifecycleContributor`.\n- Re-exported `ThreadIdleInput` from the extension API surface.\n\n## Testing\n\nNot run; this only extends the extension API trait surface with a\ndefault hook and exported input type.","verified_at":"2026-05-27T13:17:24Z"}},"url":"https://api.github.com/repos/openai/codex/commits/d2ebb8d8caf6bc487466ee50f61eaa2dc53fa091","html_url":"https://github.com/openai/codex/commit/d2ebb8d8caf6bc487466ee50f61eaa2dc53fa091","comments_url":"https://api.github.com/repos/openai/codex/commits/d2ebb8d8caf6bc487466ee50f61eaa2dc53fa091/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7df8431bbdcdd6bdbac7d2dacd5b59aca0fb7732","url":"https://api.github.com/repos/openai/codex/commits/7df8431bbdcdd6bdbac7d2dacd5b59aca0fb7732","html_url":"https://github.com/openai/codex/commit/7df8431bbdcdd6bdbac7d2dacd5b59aca0fb7732"}]},{"sha":"7df8431bbdcdd6bdbac7d2dacd5b59aca0fb7732","node_id":"C_kwDOOYsS4doAKDdkZjg0MzFiYmRjZGQ2YmRiYWM3ZDJkYWNkNWI1OWFjYTBmYjc3MzI","commit":{"author":{"name":"jif-oai","email":"jif@openai.com","date":"2026-05-27T12:14:30Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T12:14:30Z"},"message":"Fix guardian review test user input (#24746)\n\n## Summary\n- Add the missing additional_context field to the guardian review\nOp::UserInput test initializer.\n\n## Test plan\n- just fmt\n- just test -p codex-core guardian_review\n- just test -p codex-core (compiles, then fails on local environment\nissues: sandbox-exec Operation not permitted, missing test_stdio_server\nhelper binary, and unrelated timeouts)","tree":{"sha":"5c8f0fbd6a78efb2e78b16f55a48ca4acad574ea","url":"https://api.github.com/repos/openai/codex/git/trees/5c8f0fbd6a78efb2e78b16f55a48ca4acad574ea"},"url":"https://api.github.com/repos/openai/codex/git/commits/7df8431bbdcdd6bdbac7d2dacd5b59aca0fb7732","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqFuAmCRC1aQ7uu5UhlAAABNIQAC9I4oxxqTsXzZiq9hNVsmjN\nPn9nZeL7r5aFvFKpoYn73wc1Z9wW+ty6+26LO6GiYNf/ZAAl/3AnuqxDuvrT7zxo\noTJNRynkAwqJoy+oWjeC8maeYJFxoDNHfZiejqC0KPTyBRuGzwapIgPmrVpkDu3r\niK8ndomqLjz73PfVHCspbPJGgWonBQmDUqYkLYywtDk0e2QnaJWjJhR2TDs/IWgX\nPc5onVZPMV1dEX09NTR6kcrH07XoVsvRDWzDLze8wCIfRv6tuD3vM2og+VAS5clC\nAiQtAdsQ3QzZHvYFeSboxQpg7uUmHbnH9xornpWgZWPVaIqkr1vXSgVsHz1t+u5m\nnwpZGz9XZDvakHw2EDkj5aL5FZEqdhE5OkAjDNYKv91pLuS2rRJbRKBtGg93jS/7\nf3MrhWY/nPlNiC9d4Q/sirZmbrElxVrVRKhYoDJfeBgE4NUOa6qrlaP1BObPrZqB\nJKTSIBAJ968Kzh4m2u9N6YVsU4dm41etJsLGyJWfyOOc8D9GvYuyDeLyz/ugeBTo\nj0QC3Cj1EFt3Zq3ijirlYAdCawFf+xj9etcXOxScPe/XnjBd4exvqKfn9ts+UHyq\nzHZ2NxFM1KThCIDP9xNSDix2Ry6x7GBr+L6/vzcGR8resc7SUfxLbyaJz8IA6jUF\n5fzhiqhXnOb2yOfD9cDd\n=7sfI\n-----END PGP SIGNATURE-----\n","payload":"tree 5c8f0fbd6a78efb2e78b16f55a48ca4acad574ea\nparent bc005029bdd88749f71be5fc9134b6a5b2aea941\nauthor jif-oai <jif@openai.com> 1779884070 +0200\ncommitter GitHub <noreply@github.com> 1779884070 +0200\n\nFix guardian review test user input (#24746)\n\n## Summary\n- Add the missing additional_context field to the guardian review\nOp::UserInput test initializer.\n\n## Test plan\n- just fmt\n- just test -p codex-core guardian_review\n- just test -p codex-core (compiles, then fails on local environment\nissues: sandbox-exec Operation not permitted, missing test_stdio_server\nhelper binary, and unrelated timeouts)","verified_at":"2026-05-27T12:14:31Z"}},"url":"https://api.github.com/repos/openai/codex/commits/7df8431bbdcdd6bdbac7d2dacd5b59aca0fb7732","html_url":"https://github.com/openai/codex/commit/7df8431bbdcdd6bdbac7d2dacd5b59aca0fb7732","comments_url":"https://api.github.com/repos/openai/codex/commits/7df8431bbdcdd6bdbac7d2dacd5b59aca0fb7732/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"bc005029bdd88749f71be5fc9134b6a5b2aea941","url":"https://api.github.com/repos/openai/codex/commits/bc005029bdd88749f71be5fc9134b6a5b2aea941","html_url":"https://github.com/openai/codex/commit/bc005029bdd88749f71be5fc9134b6a5b2aea941"}]},{"sha":"bc005029bdd88749f71be5fc9134b6a5b2aea941","node_id":"C_kwDOOYsS4doAKGJjMDA1MDI5YmRkODg3NDlmNzFiZTVmYzkxMzRiNmE1YjJhZWE5NDE","commit":{"author":{"name":"jif-oai","email":"jif@openai.com","date":"2026-05-27T11:00:06Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-05-27T11:00:06Z"},"message":"feat: handle goal usage limits in goal extension (#24628)\n\n## Why\n\nThe extracted goal runtime needs a host-callable path for turns that\nstop because the workspace usage limit is reached. In that case, any\nin-turn goal progress should be accounted before the goal becomes\nterminal, and active goal accounting must be cleared so later\ntool-finish or turn-stop handling does not keep charging usage to a\nstopped goal.\n\n## What changed\n\n- Adds `GoalRuntimeHandle::usage_limit_active_goal_for_turn`, which\naccounts current active-goal progress, marks the active or\nbudget-limited thread goal as `UsageLimited`, records terminal metrics\nwhen the status changes, clears active goal accounting, and emits the\nupdated goal event.\n- Covers both active and budget-limited goals in\n`ext/goal/tests/goal_extension_backend.rs`, including the invariant that\nlater token/tool events do not add usage after the goal has been\nusage-limited.\n\n## Testing\n\n- Added\n`usage_limit_active_goal_accounts_progress_and_clears_accounting`.\n- Added `usage_limit_budget_limited_goal_accounts_remaining_progress`.","tree":{"sha":"ffd9df265ad9756583b2d429bdfc0e981e5f14a0","url":"https://api.github.com/repos/openai/codex/git/trees/ffd9df265ad9756583b2d429bdfc0e981e5f14a0"},"url":"https://api.github.com/repos/openai/codex/git/commits/bc005029bdd88749f71be5fc9134b6a5b2aea941","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqFs62CRC1aQ7uu5UhlAAAP8wQAJTTOOHg+624i+fD9YrU3jYd\nlecZ5wbTZoziZ6oE3ubFcL/XTSShC6rNH2BcHUarVZJhVNKRoYkb2aaDPc4z/huO\n39xKcs7G1dUg9AsEtVdcqYdE8UoOOqcBBpYnbUStoVHH2jzVDJD0SGDlGHiniVoz\nyOpxGmj+IZqhUXkDpTs4y98RGOvifuHn9yCW1uxBStwBVW+70VjqX1YZjU/Xogog\nSHmiJmBMcdnkupMd1uk1kQ5wuXuVMMh6eMpUbNOY6tcrp6i+FGfzqDEF7P+BJOOr\n22xuCfVi3c2GDQUigTZAfWi/Woad9fox1q1V0QtVT5hePJ3E1j3WBNJDOhgEG1ug\nw+RDFAnmHTPorf1Y93T7uEFPWnGlXF+LPqmCUIB4oyzuEXFiaw9FP8ZnQqVNB3Gv\nd7onVgRQXwo85FacUlEracED08y3Tp113OEDoNuJ//oT5KRyioyZNDx76idnZXhJ\nMXZDeeY0c2nh7OJtNu1DMmdGo3LaMejP0wyFIKXpQkYMxhNZ1ACWrGPIMj0un6ev\nqDSFh0K/lwR3huKADMXJ7qfkofTpjhUj/zc5o05axo2VBUa8pRZSyVmUhSRGsmtS\nUnJXHotK2JLHQP+qfsKn2jYFLv81fPro31L7Y/4DrWkekRBaTcQnZAkA/qKQz5Pb\nd49mZlJlt+ZqQ3rRwC4B\n=V5RE\n-----END PGP SIGNATURE-----\n","payload":"tree ffd9df265ad9756583b2d429bdfc0e981e5f14a0\nparent ca2e343f6564faaf740f50a0cf27b2092b6c40fd\nauthor jif-oai <jif@openai.com> 1779879606 +0200\ncommitter GitHub <noreply@github.com> 1779879606 +0200\n\nfeat: handle goal usage limits in goal extension (#24628)\n\n## Why\n\nThe extracted goal runtime needs a host-callable path for turns that\nstop because the workspace usage limit is reached. In that case, any\nin-turn goal progress should be accounted before the goal becomes\nterminal, and active goal accounting must be cleared so later\ntool-finish or turn-stop handling does not keep charging usage to a\nstopped goal.\n\n## What changed\n\n- Adds `GoalRuntimeHandle::usage_limit_active_goal_for_turn`, which\naccounts current active-goal progress, marks the active or\nbudget-limited thread goal as `UsageLimited`, records terminal metrics\nwhen the status changes, clears active goal accounting, and emits the\nupdated goal event.\n- Covers both active and budget-limited goals in\n`ext/goal/tests/goal_extension_backend.rs`, including the invariant that\nlater token/tool events do not add usage after the goal has been\nusage-limited.\n\n## Testing\n\n- Added\n`usage_limit_active_goal_accounts_progress_and_clears_accounting`.\n- Added `usage_limit_budget_limited_goal_accounts_remaining_progress`.","verified_at":"2026-05-27T11:00:07Z"}},"url":"https://api.github.com/repos/openai/codex/commits/bc005029bdd88749f71be5fc9134b6a5b2aea941","html_url":"https://github.com/openai/codex/commit/bc005029bdd88749f71be5fc9134b6a5b2aea941","comments_url":"https://api.github.com/repos/openai/codex/commits/bc005029bdd88749f71be5fc9134b6a5b2aea941/comments","author":{"login":"jif-oai","id":230027070,"node_id":"U_kgDODbXvPg","avatar_url":"https://avatars.githubusercontent.com/u/230027070?v=4","gravatar_id":"","url":"https://api.github.com/users/jif-oai","html_url":"https://github.com/jif-oai","followers_url":"https://api.github.com/users/jif-oai/followers","following_url":"https://api.github.com/users/jif-oai/following{/other_user}","gists_url":"https://api.github.com/users/jif-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/jif-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jif-oai/subscriptions","organizations_url":"https://api.github.com/users/jif-oai/orgs","repos_url":"https://api.github.com/users/jif-oai/repos","events_url":"https://api.github.com/users/jif-oai/events{/privacy}","received_events_url":"https://api.github.com/users/jif-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/us