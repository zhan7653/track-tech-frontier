ers.noreply.github.com>","verified_at":"2026-08-04T08:59:07Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/c90e0f42da4e391641663ac97a763d1110a8b034","html_url":"https://github.com/langchain-ai/deepagents/commit/c90e0f42da4e391641663ac97a763d1110a8b034","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/c90e0f42da4e391641663ac97a763d1110a8b034/comments","author":{"login":"dependabot[bot]","id":49699333,"node_id":"MDM6Qm90NDk2OTkzMzM=","avatar_url":"https://avatars.githubusercontent.com/in/29110?v=4","gravatar_id":"","url":"https://api.github.com/users/dependabot%5Bbot%5D","html_url":"https://github.com/apps/dependabot","followers_url":"https://api.github.com/users/dependabot%5Bbot%5D/followers","following_url":"https://api.github.com/users/dependabot%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/dependabot%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/dependabot%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dependabot%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/dependabot%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/dependabot%5Bbot%5D/repos","events_url":"https://api.github.com/users/dependabot%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/dependabot%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"0f0065e5a31b063c7bf5dcf8ace4b4b77dd479be","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/0f0065e5a31b063c7bf5dcf8ace4b4b77dd479be","html_url":"https://github.com/langchain-ai/deepagents/commit/0f0065e5a31b063c7bf5dcf8ace4b4b77dd479be"}]},{"sha":"0f0065e5a31b063c7bf5dcf8ace4b4b77dd479be","node_id":"C_kwDOPTymldoAKDBmMDA2NWU1YTMxYjA2M2M3YmY1ZGNmOGFjZTRiNGI3N2RkNDc5YmU","commit":{"author":{"name":"dependabot[bot]","email":"49699333+dependabot[bot]@users.noreply.github.com","date":"2026-08-04T08:58:57Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-04T08:58:57Z"},"message":"chore(deps): bump cryptography from 48.0.1 to 50.0.0 in /libs/partners/vercel (#5282)\n\nBumps [cryptography](https://github.com/pyca/cryptography) from 48.0.1\nto 50.0.0.\n<details>\n<summary>Changelog</summary>\n<p><em>Sourced from <a\nhref=\"https://github.com/pyca/cryptography/blob/main/CHANGELOG.rst\">cryptography's\nchangelog</a>.</em></p>\n<blockquote>\n<p>50.0.0 - 2026-07-31</p>\n<pre><code>\n* **SECURITY ISSUE**:\n\n:func:`~cryptography.hazmat.primitives.serialization.pkcs7.pkcs7_decrypt_der`\nand its PEM and S/MIME variants no longer expose distinguishable errors\nor\ntiming when unwrapping a ``RecipientInfo``'s ``encryptedKey``, which\ncould\nact as a Bleichenbacher oracle for callers that decrypt untrusted\nmessages.\nA random key is now substituted on failure, as described in :rfc:`3218`.\n  Credit to **@X1AOxiang** for reporting the issue. **CVE-2026-69247**\n* Deprecated Diffie-Hellman key exchange over finite fields (FFDH).\n  Everything FFDH is deprecated, including the types in\n``cryptography.hazmat.primitives.asymmetric.dh`` and loading FFDH keys\nor\n  parameters with the key loading APIs. Users should migrate to a more\n  modern key exchange algorithm.\n* Added ``xof()`` class methods to\n  :class:`~cryptography.hazmat.primitives.hashes.SHAKE128` and\n:class:`~cryptography.hazmat.primitives.hashes.SHAKE256` for\nconstructing\n  algorithm instances configured for use with\n  :class:`~cryptography.hazmat.primitives.hashes.XOFHash`.\n* The :mod:`X.509 verification &lt;cryptography.x509.verification&gt;`\nAPIs are now\n  considered stable and are subject to our API stability policy.\n* Added the :doc:`/cobblestone` recipe, an implementation of the\n  Cobblestone-128 and Cobblestone-256 instantiations of the `C2SP\n  chunked-encryption specification\n&lt;https://c2sp.org/chunked-encryption&gt;`_ for streaming\nauthenticated\n  encryption of large messages.\n* Parsing a Signed Certificate Timestamp list now rejects encodings that\ncarry trailing bytes after the list or after an individual SCT, instead\nof\n  silently ignoring them.\n* Added support for using :class:`~cryptography.x509.Name` as a field\ntype in\n  the :doc:`/hazmat/asn1/index` module.\n* Loading a public key or an EC private key now rejects DER where the\n``subjectPublicKey`` (or EC ``publicKey``) ``BIT STRING`` declares a\nnon-zero\n  number of unused bits, instead of silently ignoring it.\n* Parsing a CRL entry's ``InvalidityDate`` extension now rejects a\n``GeneralizedTime`` that carries fractional seconds or another non-DER\nform,\nmatching the strict encoding already required for every other X.509 time\n  field.\n* :func:`~cryptography.x509.ocsp.load_der_ocsp_request` and\n:func:`~cryptography.x509.ocsp.load_der_ocsp_response` now reject a\nrequest\nor response whose ``version`` field is not ``v1``, the only version\ndefined\nby RFC 6960, matching the version validation already performed when\nloading\n  certificates, CSRs and CRLs.\n* :class:`~cryptography.hazmat.primitives.hashes.XOFHash` is now\nsupported\n  when building against AWS-LC.\n* HMAC (and therefore PBKDF2-HMAC) with SHA-3 hashes is now supported\nwhen\n  building against AWS-LC.\n* Diffie-Hellman (:doc:`/hazmat/primitives/asymmetric/dh`) is now\nsupported\n  when building against AWS-LC.\n&lt;/tr&gt;&lt;/table&gt; \n</code></pre>\n</blockquote>\n<p>... (truncated)</p>\n</details>\n<details>\n<summary>Commits</summary>\n<ul>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/dcb7050b807b00392fa9fe2eac7cb362fcf355cc\"><code>dcb7050</code></a>\nPrepare for 50.0.0 release (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15372\">#15372</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/53fccd93413a8d7f07d6d8999681f27b75cffa3f\"><code>53fccd9</code></a>\nDon't leak how PKCS#7 encryptedKey decryption failed (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15369\">#15369</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/d472f978470fbefa521b86d98b2ecccbbb4d1dd8\"><code>d472f97</code></a>\nAdd <code>from __future__ import annotations</code> to all src/ Python\nfiles (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15371\">#15371</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/908773d53829fb1466c6db364b31321c3cd8eb9a\"><code>908773d</code></a>\nBump downstream dependencies in CI (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15368\">#15368</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/2cc07cc948948211899bcb0cddd1fddf86e95812\"><code>2cc07cc</code></a>\nBump BoringSSL, OpenSSL, AWS-LC in CI (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15367\">#15367</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/c94ede9f040fa44942f7139772603419000acf66\"><code>c94ede9</code></a>\nchore(deps): bump ruff from 0.16.0 to 0.16.1 (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15366\">#15366</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/67a8308dc9ea4cce6056e0f1438f903c208c3f35\"><code>67a8308</code></a>\nchore(deps): bump virtualenv from 21.7.0 to 21.7.1 (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15365\">#15365</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/95018ffcdbbc510fd92fc872e3a3e80aa6e58596\"><code>95018ff</code></a>\nRelease the GIL in one-shot AEAD encrypt/decrypt (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15361\">#15361</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/6954733eaf55a0074abf88f06f7242dfca3a5d02\"><code>6954733</code></a>\nRelease the GIL during DH and DSA parameter generation (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15364\">#15364</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/6893b94c33e948f6240082461424cfb5da2dacc6\"><code>6893b94</code></a>\nImport _serialization instead of serialization in x509/extensions (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15363\">#15363</a>)</li>\n<li>Additional commits viewable in <a\nhref=\"https://github.com/pyca/cryptography/compare/48.0.1...50.0.0\">compare\nview</a></li>\n</ul>\n</details>\n<br />\n\n\n[![Dependabot compatibility\nscore](https://dependabot-badges.githubapp.com/badges/compatibility_score?dependency-name=cryptography&package-manager=uv&previous-version=48.0.1&new-version=50.0.0)](https://docs.github.com/en/github/managing-security-vulnerabilities/about-dependabot-security-updates#about-compatibility-scores)\n\nDependabot will resolve any conflicts with this PR as long as you don't\nalter it yourself. You can also trigger a rebase manually by commenting\n`@dependabot rebase`.\n\n[//]: # (dependabot-automerge-start)\n[//]: # (dependabot-automerge-end)\n\n---\n\n<details>\n<summary>Dependabot commands and options</summary>\n<br />\n\nYou can trigger Dependabot actions by commenting on this PR:\n- `@dependabot rebase` will rebase this PR\n- `@dependabot recreate` will recreate this PR, overwriting any edits\nthat have been made to it\n- `@dependabot show <dependency name> ignore conditions` will show all\nof the ignore conditions of the specified dependency\n- `@dependabot ignore this major version` will close this PR and stop\nDependabot creating any more for this major version (unless you reopen\nthe PR or upgrade to it yourself)\n- `@dependabot ignore this minor version` will close this PR and stop\nDependabot creating any more for this minor version (unless you reopen\nthe PR or upgrade to it yourself)\n- `@dependabot ignore this dependency` will close this PR and stop\nDependabot creating any more for this dependency (unless you reopen the\nPR or upgrade to it yourself)\nYou can disable automated security fix PRs for this repo from the\n[Security Alerts\npage](https://github.com/langchain-ai/deepagents/network/alerts).\n\n</details>\n\nSigned-off-by: dependabot[bot] <support@github.com>\nCo-authored-by: dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com>","tree":{"sha":"2a6689494aa865226a1d60f594fa0cb8e75bdfb6","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/2a6689494aa865226a1d60f594fa0cb8e75bdfb6"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/0f0065e5a31b063c7bf5dcf8ace4b4b77dd479be","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqcanRCRC1aQ7uu5UhlAAASKsQADKq8q8bti2kjrFpHU36sTm0\nvHuWY2AnDvKzYdD/eKcZfu4Tn3FBWezAV8d//FrnlMK6+YSSZl3gCO6ScLv3lLmw\nVnCU3cX/6ZlSvrbwwsbrWzcSLDZyYOoddgEIyE8HeqnRi0ANB4r/yKVYH5yE9YAW\nTZki9wqvyrYkw4E6TXQZt7dxpmVpL+p1Qu2YsCM6zAGYNILpvBX4xRcmB3w4mX3V\n6t3ZxiFCn0y5Dzx4j1htASNUggavV+M/QfkAxoaHVWzRFfOzo/zHenOaLE/A4U5p\nDwe0ACbpUTXpP8UUc4lAM2LzRGBSTIUXX+i9qlkOBmYtD9UKqWvyFQ0GukInbTp1\nB6NoDcbOrycROKXXNrttCMqHtV3Ya/PKFjXNyS1c823WUvsDAt46Jju7mxrlbtBm\nOnO4mhHd3Azno4IZu7RV997X0MqpjN2Q9e4UCezYc2NYogxEYGruV1tpUA0N7FNb\npIO6NdcOuj2MvXAwF+hL8iSGe3higuCXSMzcZZ8UhFt54qbxjCa246yTnTTcc+FY\n/WIkAUf1FNDcXKLj/jB9RyoY9J3xRJYOjvLPr6Hox3C8MZcEyiEWy4ojhT6goL9K\nQg9uUkCGfZAxB8oYYFZvVRY5aKTeaxKcoOq7F/eQZVMlFqmYQ05tsLe89+Ei7xg4\nBP6XDxTHT9Hq/c/2cjEq\n=3VZU\n-----END PGP SIGNATURE-----\n","payload":"tree 2a6689494aa865226a1d60f594fa0cb8e75bdfb6\nparent a85417a50080a8118bc4a70f9ee358668136d18e\nauthor dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com> 1785833937 -0700\ncommitter GitHub <noreply@github.com> 1785833937 -0700\n\nchore(deps): bump cryptography from 48.0.1 to 50.0.0 in /libs/partners/vercel (#5282)\n\nBumps [cryptography](https://github.com/pyca/cryptography) from 48.0.1\nto 50.0.0.\n<details>\n<summary>Changelog</summary>\n<p><em>Sourced from <a\nhref=\"https://github.com/pyca/cryptography/blob/main/CHANGELOG.rst\">cryptography's\nchangelog</a>.</em></p>\n<blockquote>\n<p>50.0.0 - 2026-07-31</p>\n<pre><code>\n* **SECURITY ISSUE**:\n\n:func:`~cryptography.hazmat.primitives.serialization.pkcs7.pkcs7_decrypt_der`\nand its PEM and S/MIME variants no longer expose distinguishable errors\nor\ntiming when unwrapping a ``RecipientInfo``'s ``encryptedKey``, which\ncould\nact as a Bleichenbacher oracle for callers that decrypt untrusted\nmessages.\nA random key is now substituted on failure, as described in :rfc:`3218`.\n  Credit to **@X1AOxiang** for reporting the issue. **CVE-2026-69247**\n* Deprecated Diffie-Hellman key exchange over finite fields (FFDH).\n  Everything FFDH is deprecated, including the types in\n``cryptography.hazmat.primitives.asymmetric.dh`` and loading FFDH keys\nor\n  parameters with the key loading APIs. Users should migrate to a more\n  modern key exchange algorithm.\n* Added ``xof()`` class methods to\n  :class:`~cryptography.hazmat.primitives.hashes.SHAKE128` and\n:class:`~cryptography.hazmat.primitives.hashes.SHAKE256` for\nconstructing\n  algorithm instances configured for use with\n  :class:`~cryptography.hazmat.primitives.hashes.XOFHash`.\n* The :mod:`X.509 verification &lt;cryptography.x509.verification&gt;`\nAPIs are now\n  considered stable and are subject to our API stability policy.\n* Added the :doc:`/cobblestone` recipe, an implementation of the\n  Cobblestone-128 and Cobblestone-256 instantiations of the `C2SP\n  chunked-encryption specification\n&lt;https://c2sp.org/chunked-encryption&gt;`_ for streaming\nauthenticated\n  encryption of large messages.\n* Parsing a Signed Certificate Timestamp list now rejects encodings that\ncarry trailing bytes after the list or after an individual SCT, instead\nof\n  silently ignoring them.\n* Added support for using :class:`~cryptography.x509.Name` as a field\ntype in\n  the :doc:`/hazmat/asn1/index` module.\n* Loading a public key or an EC private key now rejects DER where the\n``subjectPublicKey`` (or EC ``publicKey``) ``BIT STRING`` declares a\nnon-zero\n  number of unused bits, instead of silently ignoring it.\n* Parsing a CRL entry's ``InvalidityDate`` extension now rejects a\n``GeneralizedTime`` that carries fractional seconds or another non-DER\nform,\nmatching the strict encoding already required for every other X.509 time\n  field.\n* :func:`~cryptography.x509.ocsp.load_der_ocsp_request` and\n:func:`~cryptography.x509.ocsp.load_der_ocsp_response` now reject a\nrequest\nor response whose ``version`` field is not ``v1``, the only version\ndefined\nby RFC 6960, matching the version validation already performed when\nloading\n  certificates, CSRs and CRLs.\n* :class:`~cryptography.hazmat.primitives.hashes.XOFHash` is now\nsupported\n  when building against AWS-LC.\n* HMAC (and therefore PBKDF2-HMAC) with SHA-3 hashes is now supported\nwhen\n  building against AWS-LC.\n* Diffie-Hellman (:doc:`/hazmat/primitives/asymmetric/dh`) is now\nsupported\n  when building against AWS-LC.\n&lt;/tr&gt;&lt;/table&gt; \n</code></pre>\n</blockquote>\n<p>... (truncated)</p>\n</details>\n<details>\n<summary>Commits</summary>\n<ul>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/dcb7050b807b00392fa9fe2eac7cb362fcf355cc\"><code>dcb7050</code></a>\nPrepare for 50.0.0 release (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15372\">#15372</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/53fccd93413a8d7f07d6d8999681f27b75cffa3f\"><code>53fccd9</code></a>\nDon't leak how PKCS#7 encryptedKey decryption failed (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15369\">#15369</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/d472f978470fbefa521b86d98b2ecccbbb4d1dd8\"><code>d472f97</code></a>\nAdd <code>from __future__ import annotations</code> to all src/ Python\nfiles (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15371\">#15371</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/908773d53829fb1466c6db364b31321c3cd8eb9a\"><code>908773d</code></a>\nBump downstream dependencies in CI (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15368\">#15368</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/2cc07cc948948211899bcb0cddd1fddf86e95812\"><code>2cc07cc</code></a>\nBump BoringSSL, OpenSSL, AWS-LC in CI (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15367\">#15367</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/c94ede9f040fa44942f7139772603419000acf66\"><code>c94ede9</code></a>\nchore(deps): bump ruff from 0.16.0 to 0.16.1 (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15366\">#15366</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/67a8308dc9ea4cce6056e0f1438f903c208c3f35\"><code>67a8308</code></a>\nchore(deps): bump virtualenv from 21.7.0 to 21.7.1 (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15365\">#15365</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/95018ffcdbbc510fd92fc872e3a3e80aa6e58596\"><code>95018ff</code></a>\nRelease the GIL in one-shot AEAD encrypt/decrypt (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15361\">#15361</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/6954733eaf55a0074abf88f06f7242dfca3a5d02\"><code>6954733</code></a>\nRelease the GIL during DH and DSA parameter generation (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15364\">#15364</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/6893b94c33e948f6240082461424cfb5da2dacc6\"><code>6893b94</code></a>\nImport _serialization instead of serialization in x509/extensions (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15363\">#15363</a>)</li>\n<li>Additional commits viewable in <a\nhref=\"https://github.com/pyca/cryptography/compare/48.0.1...50.0.0\">compare\nview</a></li>\n</ul>\n</details>\n<br />\n\n\n[![Dependabot compatibility\nscore](https://dependabot-badges.githubapp.com/badges/compatibility_score?dependency-name=cryptography&package-manager=uv&previous-version=48.0.1&new-version=50.0.0)](https://docs.github.com/en/github/managing-security-vulnerabilities/about-dependabot-security-updates#about-compatibility-scores)\n\nDependabot will resolve any conflicts with this PR as long as you don't\nalter it yourself. You can also trigger a rebase manually by commenting\n`@dependabot rebase`.\n\n[//]: # (dependabot-automerge-start)\n[//]: # (dependabot-automerge-end)\n\n---\n\n<details>\n<summary>Dependabot commands and options</summary>\n<br />\n\nYou can trigger Dependabot actions by commenting on this PR:\n- `@dependabot rebase` will rebase this PR\n- `@dependabot recreate` will recreate this PR, overwriting any edits\nthat have been made to it\n- `@dependabot show <dependency name> ignore conditions` will show all\nof the ignore conditions of the specified dependency\n- `@dependabot ignore this major version` will close this PR and stop\nDependabot creating any more for this major version (unless you reopen\nthe PR or upgrade to it yourself)\n- `@dependabot ignore this minor version` will close this PR and stop\nDependabot creating any more for this minor version (unless you reopen\nthe PR or upgrade to it yourself)\n- `@dependabot ignore this dependency` will close this PR and stop\nDependabot creating any more for this dependency (unless you reopen the\nPR or upgrade to it yourself)\nYou can disable automated security fix PRs for this repo from the\n[Security Alerts\npage](https://github.com/langchain-ai/deepagents/network/alerts).\n\n</details>\n\nSigned-off-by: dependabot[bot] <support@github.com>\nCo-authored-by: dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com>","verified_at":"2026-08-04T08:59:01Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/0f0065e5a31b063c7bf5dcf8ace4b4b77dd479be","html_url":"https://github.com/langchain-ai/deepagents/commit/0f0065e5a31b063c7bf5dcf8ace4b4b77dd479be","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/0f0065e5a31b063c7bf5dcf8ace4b4b77dd479be/comments","author":{"login":"dependabot[bot]","id":49699333,"node_id":"MDM6Qm90NDk2OTkzMzM=","avatar_url":"https://avatars.githubusercontent.com/in/29110?v=4","gravatar_id":"","url":"https://api.github.com/users/dependabot%5Bbot%5D","html_url":"https://github.com/apps/dependabot","followers_url":"https://api.github.com/users/dependabot%5Bbot%5D/followers","following_url":"https://api.github.com/users/dependabot%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/dependabot%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/dependabot%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dependabot%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/dependabot%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/dependabot%5Bbot%5D/repos","events_url":"https://api.github.com/users/dependabot%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/dependabot%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a85417a50080a8118bc4a70f9ee358668136d18e","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a85417a50080a8118bc4a70f9ee358668136d18e","html_url":"https://github.com/langchain-ai/deepagents/commit/a85417a50080a8118bc4a70f9ee358668136d18e"}]},{"sha":"a85417a50080a8118bc4a70f9ee358668136d18e","node_id":"C_kwDOPTymldoAKGE4NTQxN2E1MDA4MGE4MTE4YmM0YTcwZjllZTM1ODY2ODEzNmQxOGU","commit":{"author":{"name":"dependabot[bot]","email":"49699333+dependabot[bot]@users.noreply.github.com","date":"2026-08-04T08:58:44Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-04T08:58:44Z"},"message":"chore(deps): bump cryptography from 48.0.1 to 50.0.0 in /examples/llm-wiki (#5293)\n\nBumps [cryptography](https://github.com/pyca/cryptography) from 48.0.1\nto 50.0.0.\n<details>\n<summary>Changelog</summary>\n<p><em>Sourced from <a\nhref=\"https://github.com/pyca/cryptography/blob/main/CHANGELOG.rst\">cryptography's\nchangelog</a>.</em></p>\n<blockquote>\n<p>50.0.0 - 2026-07-31</p>\n<pre><code>\n* **SECURITY ISSUE**:\n\n:func:`~cryptography.hazmat.primitives.serialization.pkcs7.pkcs7_decrypt_der`\nand its PEM and S/MIME variants no longer expose distinguishable errors\nor\ntiming when unwrapping a ``RecipientInfo``'s ``encryptedKey``, which\ncould\nact as a Bleichenbacher oracle for callers that decrypt untrusted\nmessages.\nA random key is now substituted on failure, as described in :rfc:`3218`.\n  Credit to **@X1AOxiang** for reporting the issue. **CVE-2026-69247**\n* Deprecated Diffie-Hellman key exchange over finite fields (FFDH).\n  Everything FFDH is deprecated, including the types in\n``cryptography.hazmat.primitives.asymmetric.dh`` and loading FFDH keys\nor\n  parameters with the key loading APIs. Users should migrate to a more\n  modern key exchange algorithm.\n* Added ``xof()`` class methods to\n  :class:`~cryptography.hazmat.primitives.hashes.SHAKE128` and\n:class:`~cryptography.hazmat.primitives.hashes.SHAKE256` for\nconstructing\n  algorithm instances configured for use with\n  :class:`~cryptography.hazmat.primitives.hashes.XOFHash`.\n* The :mod:`X.509 verification &lt;cryptography.x509.verification&gt;`\nAPIs are now\n  considered stable and are subject to our API stability policy.\n* Added the :doc:`/cobblestone` recipe, an implementation of the\n  Cobblestone-128 and Cobblestone-256 instantiations of the `C2SP\n  chunked-encryption specification\n&lt;https://c2sp.org/chunked-encryption&gt;`_ for streaming\nauthenticated\n  encryption of large messages.\n* Parsing a Signed Certificate Timestamp list now rejects encodings that\ncarry trailing bytes after the list or after an individual SCT, instead\nof\n  silently ignoring them.\n* Added support for using :class:`~cryptography.x509.Name` as a field\ntype in\n  the :doc:`/hazmat/asn1/index` module.\n* Loading a public key or an EC private key now rejects DER where the\n``subjectPublicKey`` (or EC ``publicKey``) ``BIT STRING`` declares a\nnon-zero\n  number of unused bits, instead of silently ignoring it.\n* Parsing a CRL entry's ``InvalidityDate`` extension now rejects a\n``GeneralizedTime`` that carries fractional seconds or another non-DER\nform,\nmatching the strict encoding already required for every other X.509 time\n  field.\n* :func:`~cryptography.x509.ocsp.load_der_ocsp_request` and\n:func:`~cryptography.x509.ocsp.load_der_ocsp_response` now reject a\nrequest\nor response whose ``version`` field is not ``v1``, the only version\ndefined\nby RFC 6960, matching the version validation already performed when\nloading\n  certificates, CSRs and CRLs.\n* :class:`~cryptography.hazmat.primitives.hashes.XOFHash` is now\nsupported\n  when building against AWS-LC.\n* HMAC (and therefore PBKDF2-HMAC) with SHA-3 hashes is now supported\nwhen\n  building against AWS-LC.\n* Diffie-Hellman (:doc:`/hazmat/primitives/asymmetric/dh`) is now\nsupported\n  when building against AWS-LC.\n&lt;/tr&gt;&lt;/table&gt; \n</code></pre>\n</blockquote>\n<p>... (truncated)</p>\n</details>\n<details>\n<summary>Commits</summary>\n<ul>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/dcb7050b807b00392fa9fe2eac7cb362fcf355cc\"><code>dcb7050</code></a>\nPrepare for 50.0.0 release (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15372\">#15372</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/53fccd93413a8d7f07d6d8999681f27b75cffa3f\"><code>53fccd9</code></a>\nDon't leak how PKCS#7 encryptedKey decryption failed (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15369\">#15369</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/d472f978470fbefa521b86d98b2ecccbbb4d1dd8\"><code>d472f97</code></a>\nAdd <code>from __future__ import annotations</code> to all src/ Python\nfiles (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15371\">#15371</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/908773d53829fb1466c6db364b31321c3cd8eb9a\"><code>908773d</code></a>\nBump downstream dependencies in CI (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15368\">#15368</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/2cc07cc948948211899bcb0cddd1fddf86e95812\"><code>2cc07cc</code></a>\nBump BoringSSL, OpenSSL, AWS-LC in CI (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15367\">#15367</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/c94ede9f040fa44942f7139772603419000acf66\"><code>c94ede9</code></a>\nchore(deps): bump ruff from 0.16.0 to 0.16.1 (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15366\">#15366</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/67a8308dc9ea4cce6056e0f1438f903c208c3f35\"><code>67a8308</code></a>\nchore(deps): bump virtualenv from 21.7.0 to 21.7.1 (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15365\">#15365</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/95018ffcdbbc510fd92fc872e3a3e80aa6e58596\"><code>95018ff</code></a>\nRelease the GIL in one-shot AEAD encrypt/decrypt (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15361\">#15361</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/6954733eaf55a0074abf88f06f7242dfca3a5d02\"><code>6954733</code></a>\nRelease the GIL during DH and DSA parameter generation (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15364\">#15364</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/6893b94c33e948f6240082461424cfb5da2dacc6\"><code>6893b94</code></a>\nImport _serialization instead of serialization in x509/extensions (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15363\">#15363</a>)</li>\n<li>Additional commits viewable in <a\nhref=\"https://github.com/pyca/cryptography/compare/48.0.1...50.0.0\">compare\nview</a></li>\n</ul>\n</details>\n<br />\n\n\n[![Dependabot compatibility\nscore](https://dependabot-badges.githubapp.com/badges/compatibility_score?dependency-name=cryptography&package-manager=uv&previous-version=48.0.1&new-version=50.0.0)](https://docs.github.com/en/github/managing-security-vulnerabilities/about-dependabot-security-updates#about-compatibility-scores)\n\nDependabot will resolve any conflicts with this PR as long as you don't\nalter it yourself. You can also trigger a rebase manually by commenting\n`@dependabot rebase`.\n\n[//]: # (dependabot-automerge-start)\n[//]: # (dependabot-automerge-end)\n\n---\n\n<details>\n<summary>Dependabot commands and options</summary>\n<br />\n\nYou can trigger Dependabot actions by commenting on this PR:\n- `@dependabot rebase` will rebase this PR\n- `@dependabot recreate` will recreate this PR, overwriting any edits\nthat have been made to it\n- `@dependabot show <dependency name> ignore conditions` will show all\nof the ignore conditions of the specified dependency\n- `@dependabot ignore this major version` will close this PR and stop\nDependabot creating any more for this major version (unless you reopen\nthe PR or upgrade to it yourself)\n- `@dependabot ignore this minor version` will close this PR and stop\nDependabot creating any more for this minor version (unless you reopen\nthe PR or upgrade to it yourself)\n- `@dependabot ignore this dependency` will close this PR and stop\nDependabot creating any more for this dependency (unless you reopen the\nPR or upgrade to it yourself)\nYou can disable automated security fix PRs for this repo from the\n[Security Alerts\npage](https://github.com/langchain-ai/deepagents/network/alerts).\n\n</details>\n\nSigned-off-by: dependabot[bot] <support@github.com>\nCo-authored-by: dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com>","tree":{"sha":"657169d01c3ebb4e7440add5c7f9769565f1366a","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/657169d01c3ebb4e7440add5c7f9769565f1366a"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/a85417a50080a8118bc4a70f9ee358668136d18e","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqcanECRC1aQ7uu5UhlAAAbgsQAFq2PllToq/6rN4UP0H9mIYz\nMMgflPDh+E1tDNoz6FnahfrbSdNR0+GNhKIbks5S3l/6LM7JOHifcdn+DhWchK6E\nl9fLfZqeMYsEyO5F7PZ/lW2ZZ01DioaWxKa/xWpMk4iQhRALVzg669jxT2Qd+1Qc\nUVusGo57LhEno7KspvNLfjEVDI7OcRZY44lbl1otLCaF2yS/fqLLwcXUxA8U8rtD\ndCKlv9nag3E88cX0ceE+gNR8ZUQajbs6+q5KUDWiChBYyuLRBqdMdW1VwAdeOYdq\nAog9csEPE9HZfZmAUJAWU6P/87Cy4ugpEKMjDeH1AVwpoUXv5fLKg1KfQOiYeYN6\nU59BHGxyRUIbKmww613Rwqx98ICnUbdwWJmoQ7iXHtVR6yUkgeU81hx9RUng4K/j\nApDMtFkP+MDCwT0nnrZXLkhwj1dYcriKiPlfnuuIW9sLtxnZzTob89oQ5dJWteSP\na8QHGufsZAuMR0uJzrkiP4n8PvI3hVzUx9Ytrkx+jZFEPU9DmPGbdRmAnqcmg45f\nxqPoMyRMje7PPi307Id7YwPbUa6h0wKCf83Lv09tpnuLpTAri8k5mtIUqM3TK9ME\nKkKUEPcotz+sm/lBYPTtSsuh2/1+idDXQXMVbBbOPuvNAtD3zsTS+XA9ImvshEwY\nakOCZsevziuSmtH5jvlf\n=aHS/\n-----END PGP SIGNATURE-----\n","payload":"tree 657169d01c3ebb4e7440add5c7f9769565f1366a\nparent 6f16761192a34598f39029730f3c1f720efca6bb\nauthor dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com> 1785833924 +0000\ncommitter GitHub <noreply@github.com> 1785833924 +0000\n\nchore(deps): bump cryptography from 48.0.1 to 50.0.0 in /examples/llm-wiki (#5293)\n\nBumps [cryptography](https://github.com/pyca/cryptography) from 48.0.1\nto 50.0.0.\n<details>\n<summary>Changelog</summary>\n<p><em>Sourced from <a\nhref=\"https://github.com/pyca/cryptography/blob/main/CHANGELOG.rst\">cryptography's\nchangelog</a>.</em></p>\n<blockquote>\n<p>50.0.0 - 2026-07-31</p>\n<pre><code>\n* **SECURITY ISSUE**:\n\n:func:`~cryptography.hazmat.primitives.serialization.pkcs7.pkcs7_decrypt_der`\nand its PEM and S/MIME variants no longer expose distinguishable errors\nor\ntiming when unwrapping a ``RecipientInfo``'s ``encryptedKey``, which\ncould\nact as a Bleichenbacher oracle for callers that decrypt untrusted\nmessages.\nA random key is now substituted on failure, as described in :rfc:`3218`.\n  Credit to **@X1AOxiang** for reporting the issue. **CVE-2026-69247**\n* Deprecated Diffie-Hellman key exchange over finite fields (FFDH).\n  Everything FFDH is deprecated, including the types in\n``cryptography.hazmat.primitives.asymmetric.dh`` and loading FFDH keys\nor\n  parameters with the key loading APIs. Users should migrate to a more\n  modern key exchange algorithm.\n* Added ``xof()`` class methods to\n  :class:`~cryptography.hazmat.primitives.hashes.SHAKE128` and\n:class:`~cryptography.hazmat.primitives.hashes.SHAKE256` for\nconstructing\n  algorithm instances configured for use with\n  :class:`~cryptography.hazmat.primitives.hashes.XOFHash`.\n* The :mod:`X.509 verification &lt;cryptography.x509.verification&gt;`\nAPIs are now\n  considered stable and are subject to our API stability policy.\n* Added the :doc:`/cobblestone` recipe, an implementation of the\n  Cobblestone-128 and Cobblestone-256 instantiations of the `C2SP\n  chunked-encryption specification\n&lt;https://c2sp.org/chunked-encryption&gt;`_ for streaming\nauthenticated\n  encryption of large messages.\n* Parsing a Signed Certificate Timestamp list now rejects encodings that\ncarry trailing bytes after the list or after an individual SCT, instead\nof\n  silently ignoring them.\n* Added support for using :class:`~cryptography.x509.Name` as a field\ntype in\n  the :doc:`/hazmat/asn1/index` module.\n* Loading a public key or an EC private key now rejects DER where the\n``subjectPublicKey`` (or EC ``publicKey``) ``BIT STRING`` declares a\nnon-zero\n  number of unused bits, instead of silently ignoring it.\n* Parsing a CRL entry's ``InvalidityDate`` extension now rejects a\n``GeneralizedTime`` that carries fractional seconds or another non-DER\nform,\nmatching the strict encoding already required for every other X.509 time\n  field.\n* :func:`~cryptography.x509.ocsp.load_der_ocsp_request` and\n:func:`~cryptography.x509.ocsp.load_der_ocsp_response` now reject a\nrequest\nor response whose ``version`` field is not ``v1``, the only version\ndefined\nby RFC 6960, matching the version validation already performed when\nloading\n  certificates, CSRs and CRLs.\n* :class:`~cryptography.hazmat.primitives.hashes.XOFHash` is now\nsupported\n  when building against AWS-LC.\n* HMAC (and therefore PBKDF2-HMAC) with SHA-3 hashes is now supported\nwhen\n  building against AWS-LC.\n* Diffie-Hellman (:doc:`/hazmat/primitives/asymmetric/dh`) is now\nsupported\n  when building against AWS-LC.\n&lt;/tr&gt;&lt;/table&gt; \n</code></pre>\n</blockquote>\n<p>... (truncated)</p>\n</details>\n<details>\n<summary>Commits</summary>\n<ul>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/dcb7050b807b00392fa9fe2eac7cb362fcf355cc\"><code>dcb7050</code></a>\nPrepare for 50.0.0 release (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15372\">#15372</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/53fccd93413a8d7f07d6d8999681f27b75cffa3f\"><code>53fccd9</code></a>\nDon't leak how PKCS#7 encryptedKey decryption failed (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15369\">#15369</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/d472f978470fbefa521b86d98b2ecccbbb4d1dd8\"><code>d472f97</code></a>\nAdd <code>from __future__ import annotations</code> to all src/ Python\nfiles (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15371\">#15371</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/908773d53829fb1466c6db364b31321c3cd8eb9a\"><code>908773d</code></a>\nBump downstream dependencies in CI (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15368\">#15368</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/2cc07cc948948211899bcb0cddd1fddf86e95812\"><code>2cc07cc</code></a>\nBump BoringSSL, OpenSSL, AWS-LC in CI (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15367\">#15367</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/c94ede9f040fa44942f7139772603419000acf66\"><code>c94ede9</code></a>\nchore(deps): bump ruff from 0.16.0 to 0.16.1 (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15366\">#15366</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/67a8308dc9ea4cce6056e0f1438f903c208c3f35\"><code>67a8308</code></a>\nchore(deps): bump virtualenv from 21.7.0 to 21.7.1 (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15365\">#15365</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/95018ffcdbbc510fd92fc872e3a3e80aa6e58596\"><code>95018ff</code></a>\nRelease the GIL in one-shot AEAD encrypt/decrypt (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15361\">#15361</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/6954733eaf55a0074abf88f06f7242dfca3a5d02\"><code>6954733</code></a>\nRelease the GIL during DH and DSA parameter generation (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15364\">#15364</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/6893b94c33e948f6240082461424cfb5da2dacc6\"><code>6893b94</code></a>\nImport _serialization instead of serialization in x509/extensions (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15363\">#15363</a>)</li>\n<li>Additional commits viewable in <a\nhref=\"https://github.com/pyca/cryptography/compare/48.0.1...50.0.0\">compare\nview</a></li>\n</ul>\n</details>\n<br />\n\n\n[![Dependabot compatibility\nscore](https://dependabot-badges.githubapp.com/badges/compatibility_score?dependency-name=cryptography&package-manager=uv&previous-version=48.0.1&new-version=50.0.0)](https://docs.github.com/en/github/managing-security-vulnerabilities/about-dependabot-security-updates#about-compatibility-scores)\n\nDependabot will resolve any conflicts with this PR as long as you don't\nalter it yourself. You can also trigger a rebase manually by commenting\n`@dependabot rebase`.\n\n[//]: # (dependabot-automerge-start)\n[//]: # (dependabot-automerge-end)\n\n---\n\n<details>\n<summary>Dependabot commands and options</summary>\n<br />\n\nYou can trigger Dependabot actions by commenting on this PR:\n- `@dependabot rebase` will rebase this PR\n- `@dependabot recreate` will recreate this PR, overwriting any edits\nthat have been made to it\n- `@dependabot show <dependency name> ignore conditions` will show all\nof the ignore conditions of the specified dependency\n- `@dependabot ignore this major version` will close this PR and stop\nDependabot creating any more for this major version (unless you reopen\nthe PR or upgrade to it yourself)\n- `@dependabot ignore this minor version` will close this PR and stop\nDependabot creating any more for this minor version (unless you reopen\nthe PR or upgrade to it yourself)\n- `@dependabot ignore this dependency` will close this PR and stop\nDependabot creating any more for this dependency (unless you reopen the\nPR or upgrade to it yourself)\nYou can disable automated security fix PRs for this repo from the\n[Security Alerts\npage](https://github.com/langchain-ai/deepagents/network/alerts).\n\n</details>\n\nSigned-off-by: dependabot[bot] <support@github.com>\nCo-authored-by: dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com>","verified_at":"2026-08-04T08:58:47Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a85417a50080a8118bc4a70f9ee358668136d18e","html_url":"https://github.com/langchain-ai/deepagents/commit/a85417a50080a8118bc4a70f9ee358668136d18e","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/a85417a50080a8118bc4a70f9ee358668136d18e/comments","author":{"login":"dependabot[bot]","id":49699333,"node_id":"MDM6Qm90NDk2OTkzMzM=","avatar_url":"https://avatars.githubusercontent.com/in/29110?v=4","gravatar_id":"","url":"https://api.github.com/users/dependabot%5Bbot%5D","html_url":"https://github.com/apps/dependabot","followers_url":"https://api.github.com/users/dependabot%5Bbot%5D/followers","following_url":"https://api.github.com/users/dependabot%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/dependabot%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/dependabot%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dependabot%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/dependabot%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/dependabot%5Bbot%5D/repos","events_url":"https://api.github.com/users/dependabot%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/dependabot%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"6f16761192a34598f39029730f3c1f720efca6bb","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/6f16761192a34598f39029730f3c1f720efca6bb","html_url":"https://github.com/langchain-ai/deepagents/commit/6f16761192a34598f39029730f3c1f720efca6bb"}]},{"sha":"6f16761192a34598f39029730f3c1f720efca6bb","node_id":"C_kwDOPTymldoAKDZmMTY3NjExOTJhMzQ1OThmMzkwMjk3MzBmM2MxZjcyMGVmY2E2YmI","commit":{"author":{"name":"dependabot[bot]","email":"49699333+dependabot[bot]@users.noreply.github.com","date":"2026-08-04T08:58:40Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-04T08:58:40Z"},"message":"chore(deps): bump cryptography from 48.0.1 to 50.0.0 in /libs/partners/runloop (#5283)\n\nBumps [cryptography](https://github.com/pyca/cryptography) from 48.0.1\nto 50.0.0.\n<details>\n<summary>Changelog</summary>\n<p><em>Sourced from <a\nhref=\"https://github.com/pyca/cryptography/blob/main/CHANGELOG.rst\">cryptography's\nchangelog</a>.</em></p>\n<blockquote>\n<p>50.0.0 - 2026-07-31</p>\n<pre><code>\n* **SECURITY ISSUE**:\n\n:func:`~cryptography.hazmat.primitives.serialization.pkcs7.pkcs7_decrypt_der`\nand its PEM and S/MIME variants no longer expose distinguishable errors\nor\ntiming when unwrapping a ``RecipientInfo``'s ``encryptedKey``, which\ncould\nact as a Bleichenbacher oracle for callers that decrypt untrusted\nmessages.\nA random key is now substituted on failure, as described in :rfc:`3218`.\n  Credit to **@X1AOxiang** for reporting the issue. **CVE-2026-69247**\n* Deprecated Diffie-Hellman key exchange over finite fields (FFDH).\n  Everything FFDH is deprecated, including the types in\n``cryptography.hazmat.primitives.asymmetric.dh`` and loading FFDH keys\nor\n  parameters with the key loading APIs. Users should migrate to a more\n  modern key exchange algorithm.\n* Added ``xof()`` class methods to\n  :class:`~cryptography.hazmat.primitives.hashes.SHAKE128` and\n:class:`~cryptography.hazmat.primitives.hashes.SHAKE256` for\nconstructing\n  algorithm instances configured for use with\n  :class:`~cryptography.hazmat.primitives.hashes.XOFHash`.\n* The :mod:`X.509 verification &lt;cryptography.x509.verification&gt;`\nAPIs are now\n  considered stable and are subject to our API stability policy.\n* Added the :doc:`/cobblestone` recipe, an implementation of the\n  Cobblestone-128 and Cobblestone-256 instantiations of the `C2SP\n  chunked-encryption specification\n&lt;https://c2sp.org/chunked-encryption&gt;`_ for streaming\nauthenticated\n  encryption of large messages.\n* Parsing a Signed Certificate Timestamp list now rejects encodings that\ncarry trailing bytes after the list or after an individual SCT, instead\nof\n  silently ignoring them.\n* Added support for using :class:`~cryptography.x509.Name` as a field\ntype in\n  the :doc:`/hazmat/asn1/index` module.\n* Loading a public key or an EC private key now rejects DER where the\n``subjectPublicKey`` (or EC ``publicKey``) ``BIT STRING`` declares a\nnon-zero\n  number of unused bits, instead of silently ignoring it.\n* Parsing a CRL entry's ``InvalidityDate`` extension now rejects a\n``GeneralizedTime`` that carries fractional seconds or another non-DER\nform,\nmatching the strict encoding already required for every other X.509 time\n  field.\n* :func:`~cryptography.x509.ocsp.load_der_ocsp_request` and\n:func:`~cryptography.x509.ocsp.load_der_ocsp_response` now reject a\nrequest\nor response whose ``version`` field is not ``v1``, the only version\ndefined\nby RFC 6960, matching the version validation already performed when\nloading\n  certificates, CSRs and CRLs.\n* :class:`~cryptography.hazmat.primitives.hashes.XOFHash` is now\nsupported\n  when building against AWS-LC.\n* HMAC (and therefore PBKDF2-HMAC) with SHA-3 hashes is now supported\nwhen\n  building against AWS-LC.\n* Diffie-Hellman (:doc:`/hazmat/primitives/asymmetric/dh`) is now\nsupported\n  when building against AWS-LC.\n&lt;/tr&gt;&lt;/table&gt; \n</code></pre>\n</blockquote>\n<p>... (truncated)</p>\n</details>\n<details>\n<summary>Commits</summary>\n<ul>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/dcb7050b807b00392fa9fe2eac7cb362fcf355cc\"><code>dcb7050</code></a>\nPrepare for 50.0.0 release (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15372\">#15372</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/53fccd93413a8d7f07d6d8999681f27b75cffa3f\"><code>53fccd9</code></a>\nDon't leak how PKCS#7 encryptedKey decryption failed (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15369\">#15369</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/d472f978470fbefa521b86d98b2ecccbbb4d1dd8\"><code>d472f97</code></a>\nAdd <code>from __future__ import annotations</code> to all src/ Python\nfiles (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15371\">#15371</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/908773d53829fb1466c6db364b31321c3cd8eb9a\"><code>908773d</code></a>\nBump downstream dependencies in CI (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15368\">#15368</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/2cc07cc948948211899bcb0cddd1fddf86e95812\"><code>2cc07cc</code></a>\nBump BoringSSL, OpenSSL, AWS-LC in CI (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15367\">#15367</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/c94ede9f040fa44942f7139772603419000acf66\"><code>c94ede9</code></a>\nchore(deps): bump ruff from 0.16.0 to 0.16.1 (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15366\">#15366</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/67a8308dc9ea4cce6056e0f1438f903c208c3f35\"><code>67a8308</code></a>\nchore(deps): bump virtualenv from 21.7.0 to 21.7.1 (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15365\">#15365</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/95018ffcdbbc510fd92fc872e3a3e80aa6e58596\"><code>95018ff</code></a>\nRelease the GIL in one-shot AEAD encrypt/decrypt (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15361\">#15361</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/6954733eaf55a0074abf88f06f7242dfca3a5d02\"><code>6954733</code></a>\nRelease the GIL during DH and DSA parameter generation (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15364\">#15364</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/6893b94c33e948f6240082461424cfb5da2dacc6\"><code>6893b94</code></a>\nImport _serialization instead of serialization in x509/extensions (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15363\">#15363</a>)</li>\n<li>Additional commits viewable in <a\nhref=\"https://github.com/pyca/cryptography/compare/48.0.1...50.0.0\">compare\nview</a></li>\n</ul>\n</details>\n<br />\n\n\n[![Dependabot compatibility\nscore](https://dependabot-badges.githubapp.com/badges/compatibility_score?dependency-name=cryptography&package-manager=uv&previous-version=48.0.1&new-version=50.0.0)](https://docs.github.com/en/github/managing-security-vulnerabilities/about-dependabot-security-updates#about-compatibility-scores)\n\nDependabot will resolve any conflicts with this PR as long as you don't\nalter it yourself. You can also trigger a rebase manually by commenting\n`@dependabot rebase`.\n\n[//]: # (dependabot-automerge-start)\n[//]: # (dependabot-automerge-end)\n\n---\n\n<details>\n<summary>Dependabot commands and options</summary>\n<br />\n\nYou can trigger Dependabot actions by commenting on this PR:\n- `@dependabot rebase` will rebase this PR\n- `@dependabot recreate` will recreate this PR, overwriting any edits\nthat have been made to it\n- `@dependabot show <dependency name> ignore conditions` will show all\nof the ignore conditions of the specified dependency\n- `@dependabot ignore this major version` will close this PR and stop\nDependabot creating any more for this major version (unless you reopen\nthe PR or upgrade to it yourself)\n- `@dependabot ignore this minor version` will close this PR and stop\nDependabot creating any more for this minor version (unless you reopen\nthe PR or upgrade to it yourself)\n- `@dependabot ignore this dependency` will close this PR and stop\nDependabot creating any more for this dependency (unless you reopen the\nPR or upgrade to it yourself)\nYou can disable automated security fix PRs for this repo from the\n[Security Alerts\npage](https://github.com/langchain-ai/deepagents/network/alerts).\n\n</details>\n\nSigned-off-by: dependabot[bot] <support@github.com>\nCo-authored-by: dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com>","tree":{"sha":"20c7b127ccf976dc08c0bed487cd989402b126b0","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/20c7b127ccf976dc08c0bed487cd989402b126b0"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/6f16761192a34598f39029730f3c1f720efca6bb","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqcanACRC1aQ7uu5UhlAAAPv0QACo3rDf8DyItuemlzcE93mhU\nBafTvUUW3ssLpgiRbMnpDgKpjVmHu31ZAisBB7G8DdTJISh52aumKt0LVhu+2iIJ\nbFrJcXNpqXit7PApex39nLvq8tR3jtqbtbRZ+g2P5Q6VQlbNFdByJMXzzVgD8PUj\niZgGjRrytyH3O1Hkb89ppW8klnPZgUguN5KQLp1XPj1XIFeqIezX8zJMdRgeRMpL\nsrWDhi3Trxns9JXwym/FRLk5dp/pWk4ax8WMxzxleUkFTpl34mWkNzA7KWNGe60m\nG+tA9QTsDubZDd2lSm9po6wRbtD4/tUk1A8ogYX3Kc1OYJUQVxjWevWU3ThtTrQf\nHCA33EGVg+1pvSdoGKoqjMBOecJEGibA/0ngw6JSiLqtrL2KDgSRSqejaya7LGxI\ntSUlGzHMgKbZxVylQuZGOxjYY1BVdI1WneX8Uw/wq0ZMx+JU8ouSOVHTdnR6ixLs\nfyADlVF5bZcbn3qf7d1GtH7UugKdCLg84R3SWniR2RpwA6bY9fBgeuXWMI7aka07\nQO7qS1vsHvzl/+Jj9sye0zsL1L8/+sBORLxRzYnrVEDKo/id6j81HZCMi/CZCT40\nNgmftgCQrRRcH9PtZJoW/GctNuSBPbYoXF6EmD1FTdxI0PJnBY/OJaF62RthiMGq\nPmtuhkGFuzWYePE8QdWE\n=343V\n-----END PGP SIGNATURE-----\n","payload":"tree 20c7b127ccf976dc08c0bed487cd989402b126b0\nparent c7aa8ad7a46480e16f4efa048904d814f626553f\nauthor dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com> 1785833920 -0700\ncommitter GitHub <noreply@github.com> 1785833920 -0700\n\nchore(deps): bump cryptography from 48.0.1 to 50.0.0 in /libs/partners/runloop (#5283)\n\nBumps [cryptography](https://github.com/pyca/cryptography) from 48.0.1\nto 50.0.0.\n<details>\n<summary>Changelog</summary>\n<p><em>Sourced from <a\nhref=\"https://github.com/pyca/cryptography/blob/main/CHANGELOG.rst\">cryptography's\nchangelog</a>.</em></p>\n<blockquote>\n<p>50.0.0 - 2026-07-31</p>\n<pre><code>\n* **SECURITY ISSUE**:\n\n:func:`~cryptography.hazmat.primitives.serialization.pkcs7.pkcs7_decrypt_der`\nand its PEM and S/MIME variants no longer expose distinguishable errors\nor\ntiming when unwrapping a ``RecipientInfo``'s ``encryptedKey``, which\ncould\nact as a Bleichenbacher oracle for callers that decrypt untrusted\nmessages.\nA random key is now substituted on failure, as described in :rfc:`3218`.\n  Credit to **@X1AOxiang** for reporting the issue. **CVE-2026-69247**\n* Deprecated Diffie-Hellman key exchange over finite fields (FFDH).\n  Everything FFDH is deprecated, including the types in\n``cryptography.hazmat.primitives.asymmetric.dh`` and loading FFDH keys\nor\n  parameters with the key loading APIs. Users should migrate to a more\n  modern key exchange algorithm.\n* Added ``xof()`` class methods to\n  :class:`~cryptography.hazmat.primitives.hashes.SHAKE128` and\n:class:`~cryptography.hazmat.primitives.hashes.SHAKE256` for\nconstructing\n  algorithm instances configured for use with\n  :class:`~cryptography.hazmat.primitives.hashes.XOFHash`.\n* The :mod:`X.509 verification &lt;cryptography.x509.verification&gt;`\nAPIs are now\n  considered stable and are subject to our API stability policy.\n* Added the :doc:`/cobblestone` recipe, an implementation of the\n  Cobblestone-128 and Cobblestone-256 instantiations of the `C2SP\n  chunked-encryption specification\n&lt;https://c2sp.org/chunked-encryption&gt;`_ for streaming\nauthenticated\n  encryption of large messages.\n* Parsing a Signed Certificate Timestamp list now rejects encodings that\ncarry trailing bytes after the list or after an individual SCT, instead\nof\n  silently ignoring them.\n* Added support for using :class:`~cryptography.x509.Name` as a field\ntype in\n  the :doc:`/hazmat/asn1/index` module.\n* Loading a public key or an EC private key now rejects DER where the\n``subjectPublicKey`` (or EC ``publicKey``) ``BIT STRING`` declares a\nnon-zero\n  number of unused bits, instead of silently ignoring it.\n* Parsing a CRL entry's ``InvalidityDate`` extension now rejects a\n``GeneralizedTime`` that carries fractional seconds or another non-DER\nform,\nmatching the strict encoding already required for every other X.509 time\n  field.\n* :func:`~cryptography.x509.ocsp.load_der_ocsp_request` and\n:func:`~cryptography.x509.ocsp.load_der_ocsp_response` now reject a\nrequest\nor response whose ``version`` field is not ``v1``, the only version\ndefined\nby RFC 6960, matching the version validation already performed when\nloading\n  certificates, CSRs and CRLs.\n* :class:`~cryptography.hazmat.primitives.hashes.XOFHash` is now\nsupported\n  when building against AWS-LC.\n* HMAC (and therefore PBKDF2-HMAC) with SHA-3 hashes is now supported\nwhen\n  building against AWS-LC.\n* Diffie-Hellman (:doc:`/hazmat/primitives/asymmetric/dh`) is now\nsupported\n  when building against AWS-LC.\n&lt;/tr&gt;&lt;/table&gt; \n</code></pre>\n</blockquote>\n<p>... (truncated)</p>\n</details>\n<details>\n<summary>Commits</summary>\n<ul>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/dcb7050b807b00392fa9fe2eac7cb362fcf355cc\"><code>dcb7050</code></a>\nPrepare for 50.0.0 release (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15372\">#15372</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/53fccd93413a8d7f07d6d8999681f27b75cffa3f\"><code>53fccd9</code></a>\nDon't leak how PKCS#7 encryptedKey decryption failed (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15369\">#15369</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/d472f978470fbefa521b86d98b2ecccbbb4d1dd8\"><code>d472f97</code></a>\nAdd <code>from __future__ import annotations</code> to all src/ Python\nfiles (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15371\">#15371</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/908773d53829fb1466c6db364b31321c3cd8eb9a\"><code>908773d</code></a>\nBump downstream dependencies in CI (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15368\">#15368</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/2cc07cc948948211899bcb0cddd1fddf86e95812\"><code>2cc07cc</code></a>\nBump BoringSSL, OpenSSL, AWS-LC in CI (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15367\">#15367</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/c94ede9f040fa44942f7139772603419000acf66\"><code>c94ede9</code></a>\nchore(deps): bump ruff from 0.16.0 to 0.16.1 (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15366\">#15366</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/67a8308dc9ea4cce6056e0f1438f903c208c3f35\"><code>67a8308</code></a>\nchore(deps): bump virtualenv from 21.7.0 to 21.7.1 (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15365\">#15365</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/95018ffcdbbc510fd92fc872e3a3e80aa6e58596\"><code>95018ff</code></a>\nRelease the GIL in one-shot AEAD encrypt/decrypt (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15361\">#15361</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/6954733eaf55a0074abf88f06f7242dfca3a5d02\"><code>6954733</code></a>\nRelease the GIL during DH and DSA parameter generation (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15364\">#15364</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/6893b94c33e948f6240082461424cfb5da2dacc6\"><code>6893b94</code></a>\nImport _serialization instead of serialization in x509/extensions (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15363\">#15363</a>)</li>\n<li>Additional commits viewable in <a\nhref=\"https://github.com/pyca/cryptography/compare/48.0.1...50.0.0\">compare\nview</a></li>\n</ul>\n</details>\n<br />\n\n\n[![Dependabot compatibility\nscore](https://dependabot-badges.githubapp.com/badges/compatibility_score?dependency-name=cryptography&package-manager=uv&previous-version=48.0.1&new-version=50.0.0)](https://docs.github.com/en/github/managing-security-vulnerabilities/about-dependabot-security-updates#about-compatibility-scores)\n\nDependabot will resolve any conflicts with this PR as long as you don't\nalter it yourself. You can also trigger a rebase manually by commenting\n`@dependabot rebase`.\n\n[//]: # (dependabot-automerge-start)\n[//]: # (dependabot-automerge-end)\n\n---\n\n<details>\n<summary>Dependabot commands and options</summary>\n<br />\n\nYou can trigger Dependabot actions by commenting on this PR:\n- `@dependabot rebase` will rebase this PR\n- `@dependabot recreate` will recreate this PR, overwriting any edits\nthat have been made to it\n- `@dependabot show <dependency name> ignore conditions` will show all\nof the ignore conditions of the specified dependency\n- `@dependabot ignore this major version` will close this PR and stop\nDependabot creating any more for this major version (unless you reopen\nthe PR or upgrade to it yourself)\n- `@dependabot ignore this minor version` will close this PR and stop\nDependabot creating any more for this minor version (unless you reopen\nthe PR or upgrade to it yourself)\n- `@dependabot ignore this dependency` will close this PR and stop\nDependabot creating any more for this dependency (unless you reopen the\nPR or upgrade to it yourself)\nYou can disable automated security fix PRs for this repo from the\n[Security Alerts\npage](https://github.com/langchain-ai/deepagents/network/alerts).\n\n</details>\n\nSigned-off-by: dependabot[bot] <support@github.com>\nCo-authored-by: dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com>","verified_at":"2026-08-04T08:58:43Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/6f16761192a34598f39029730f3c1f720efca6bb","html_url":"https://github.com/langchain-ai/deepagents/commit/6f16761192a34598f39029730f3c1f720efca6bb","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/6f16761192a34598f39029730f3c1f720efca6bb/comments","author":{"login":"dependabot[bot]","id":49699333,"node_id":"MDM6Qm90NDk2OTkzMzM=","avatar_url":"https://avatars.githubusercontent.com/in/29110?v=4","gravatar_id":"","url":"https://api.github.com/users/dependabot%5Bbot%5D","html_url":"https://github.com/apps/dependabot","followers_url":"https://api.github.com/users/dependabot%5Bbot%5D/followers","following_url":"https://api.github.com/users/dependabot%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/dependabot%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/dependabot%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dependabot%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/dependabot%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/dependabot%5Bbot%5D/repos","events_url":"https://api.github.com/users/dependabot%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/dependabot%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c7aa8ad7a46480e16f4efa048904d814f626553f","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/c7aa8ad7a46480e16f4efa048904d814f626553f","html_url":"https://github.com/langchain-ai/deepagents/commit/c7aa8ad7a46480e16f4efa048904d814f626553f"}]},{"sha":"c7aa8ad7a46480e16f4efa048904d814f626553f","node_id":"C_kwDOPTymldoAKGM3YWE4YWQ3YTQ2NDgwZTE2ZjRlZmEwNDg5MDRkODE0ZjYyNjU1M2Y","commit":{"author":{"name":"dependabot[bot]","email":"49699333+dependabot[bot]@users.noreply.github.com","date":"2026-08-04T08:58:32Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-04T08:58:32Z"},"message":"chore(deps): bump cryptography from 48.0.1 to 50.0.0 in /libs/partners/quickjs (#5284)\n\nBumps [cryptography](https://github.com/pyca/cryptography) from 48.0.1\nto 50.0.0.\n<details>\n<summary>Changelog</summary>\n<p><em>Sourced from <a\nhref=\"https://github.com/pyca/cryptography/blob/main/CHANGELOG.rst\">cryptography's\nchangelog</a>.</em></p>\n<blockquote>\n<p>50.0.0 - 2026-07-31</p>\n<pre><code>\n* **SECURITY ISSUE**:\n\n:func:`~cryptography.hazmat.primitives.serialization.pkcs7.pkcs7_decrypt_der`\nand its PEM and S/MIME variants no longer expose distinguishable errors\nor\ntiming when unwrapping a ``RecipientInfo``'s ``encryptedKey``, which\ncould\nact as a Bleichenbacher oracle for callers that decrypt untrusted\nmessages.\nA random key is now substituted on failure, as described in :rfc:`3218`.\n  Credit to **@X1AOxiang** for reporting the issue. **CVE-2026-69247**\n* Deprecated Diffie-Hellman key exchange over finite fields (FFDH).\n  Everything FFDH is deprecated, including the types in\n``cryptography.hazmat.primitives.asymmetric.dh`` and loading FFDH keys\nor\n  parameters with the key loading APIs. Users should migrate to a more\n  modern key exchange algorithm.\n* Added ``xof()`` class methods to\n  :class:`~cryptography.hazmat.primitives.hashes.SHAKE128` and\n:class:`~cryptography.hazmat.primitives.hashes.SHAKE256` for\nconstructing\n  algorithm instances configured for use with\n  :class:`~cryptography.hazmat.primitives.hashes.XOFHash`.\n* The :mod:`X.509 verification &lt;cryptography.x509.verification&gt;`\nAPIs are now\n  considered stable and are subject to our API stability policy.\n* Added the :doc:`/cobblestone` recipe, an implementation of the\n  Cobblestone-128 and Cobblestone-256 instantiations of the `C2SP\n  chunked-encryption specification\n&lt;https://c2sp.org/chunked-encryption&gt;`_ for streaming\nauthenticated\n  encryption of large messages.\n* Parsing a Signed Certificate Timestamp list now rejects encodings that\ncarry trailing bytes after the list or after an individual SCT, instead\nof\n  silently ignoring them.\n* Added support for using :class:`~cryptography.x509.Name` as a field\ntype in\n  the :doc:`/hazmat/asn1/index` module.\n* Loading a public key or an EC private key now rejects DER where the\n``subjectPublicKey`` (or EC ``publicKey``) ``BIT STRING`` declares a\nnon-zero\n  number of unused bits, instead of silently ignoring it.\n* Parsing a CRL entry's ``InvalidityDate`` extension now rejects a\n``GeneralizedTime`` that carries fractional seconds or another non-DER\nform,\nmatching the strict encoding already required for every other X.509 time\n  field.\n* :func:`~cryptography.x509.ocsp.load_der_ocsp_request` and\n:func:`~cryptography.x509.ocsp.load_der_ocsp_response` now reject a\nrequest\nor response whose ``version`` field is not ``v1``, the only version\ndefined\nby RFC 6960, matching the version validation already performed when\nloading\n  certificates, CSRs and CRLs.\n* :class:`~cryptography.hazmat.primitives.hashes.XOFHash` is now\nsupported\n  when building against AWS-LC.\n* HMAC (and therefore PBKDF2-HMAC) with SHA-3 hashes is now supported\nwhen\n  building against AWS-LC.\n* Diffie-Hellman (:doc:`/hazmat/primitives/asymmetric/dh`) is now\nsupported\n  when building against AWS-LC.\n&lt;/tr&gt;&lt;/table&gt; \n</code></pre>\n</blockquote>\n<p>... (truncated)</p>\n</details>\n<details>\n<summary>Commits</summary>\n<ul>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/dcb7050b807b00392fa9fe2eac7cb362fcf355cc\"><code>dcb7050</code></a>\nPrepare for 50.0.0 release (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15372\">#15372</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/53fccd93413a8d7f07d6d8999681f27b75cffa3f\"><code>53fccd9</code></a>\nDon't leak how PKCS#7 encryptedKey decryption failed (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15369\">#15369</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/d472f978470fbefa521b86d98b2ecccbbb4d1dd8\"><code>d472f97</code></a>\nAdd <code>from __future__ import annotations</code> to all src/ Python\nfiles (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15371\">#15371</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/908773d53829fb1466c6db364b31321c3cd8eb9a\"><code>908773d</code></a>\nBump downstream dependencies in CI (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15368\">#15368</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/2cc07cc948948211899bcb0cddd1fddf86e95812\"><code>2cc07cc</code></a>\nBump BoringSSL, OpenSSL, AWS-LC in CI (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15367\">#15367</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/c94ede9f040fa44942f7139772603419000acf66\"><code>c94ede9</code></a>\nchore(deps): bump ruff from 0.16.0 to 0.16.1 (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15366\">#15366</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/67a8308dc9ea4cce6056e0f1438f903c208c3f35\"><code>67a8308</code></a>\nchore(deps): bump virtualenv from 21.7.0 to 21.7.1 (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15365\">#15365</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/95018ffcdbbc510fd92fc872e3a3e80aa6e58596\"><code>95018ff</code></a>\nRelease the GIL in one-shot AEAD encrypt/decrypt (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15361\">#15361</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/6954733eaf55a0074abf88f06f7242dfca3a5d02\"><code>6954733</code></a>\nRelease the GIL during DH and DSA parameter generation (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15364\">#15364</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/6893b94c33e948f6240082461424cfb5da2dacc6\"><code>6893b94</code></a>\nImport _serialization instead of serialization in x509/extensions (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15363\">#15363</a>)</li>\n<li>Additional commits viewable in <a\nhref=\"https://github.com/pyca/cryptography/compare/48.0.1...50.0.0\">compare\nview</a></li>\n</ul>\n</details>\n<br />\n\n\n[![Dependabot compatibility\nscore](https://dependabot-badges.githubapp.com/badges/compatibility_score?dependency-name=cryptography&package-manager=uv&previous-version=48.0.1&new-version=50.0.0)](https://docs.github.com/en/github/managing-security-vulnerabilities/about-dependabot-security-updates#about-compatibility-scores)\n\nDependabot will resolve any conflicts with this PR as long as you don't\nalter it yourself. You can also trigger a rebase manually by commenting\n`@dependabot rebase`.\n\n[//]: # (dependabot-automerge-start)\n[//]: # (dependabot-automerge-end)\n\n---\n\n<details>\n<summary>Dependabot commands and options</summary>\n<br />\n\nYou can trigger Dependabot actions by commenting on this PR:\n- `@dependabot rebase` will rebase this PR\n- `@dependabot recreate` will recreate this PR, overwriting any edits\nthat have been made to it\n- `@dependabot show <dependency name> ignore conditions` will show all\nof the ignore conditions of the specified dependency\n- `@dependabot ignore this major version` will close this PR and stop\nDependabot creating any more for this major version (unless you reopen\nthe PR or upgrade to it yourself)\n- `@dependabot ignore this minor version` will close this PR and stop\nDependabot creating any more for this minor version (unless you reopen\nthe PR or upgrade to it yourself)\n- `@dependabot ignore this dependency` will close this PR and stop\nDependabot creating any more for this dependency (unless you reopen the\nPR or upgrade to it yourself)\nYou can disable automated security fix PRs for this repo from the\n[Security Alerts\npage](https://github.com/langchain-ai/deepagents/network/alerts).\n\n</details>\n\nSigned-off-by: dependabot[bot] <support@github.com>\nCo-authored-by: dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com>","tree":{"sha":"95cfe7ee7830e21b9423a9991753a2c60df9c184","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/95cfe7ee7830e21b9423a9991753a2c60df9c184"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/c7aa8ad7a46480e16f4efa048904d814f626553f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqcam4CRC1aQ7uu5UhlAAAYlkQAFlOSUqlmTBxECWx2PPXF166\nWitNcMZ0aoz4eNZVfaOvss934ojkpNykg24WiZkDDkdJqZ5XijIIY6vhMeJbJzU5\nufj4SJb25wfSXt3IL3BbpZXgGrkeNZhfCfTGIl6i+P6exXlyqB5oF/j9vKDVlqF+\n8CXZ47amSNCouJ0eaM9UHLTXSXFcMXFBMRyd8ljeGMwX0r0uusqTz6L94pb90beJ\nvnq7zQruO4+1Eu0PBkV6rujYkEL9HrY1IIAAMopkUk1FUDYrYa/H90XojZ6uXmRI\nNpGNDbJAOhRvPmS5f6pLqk4AODaaTlDZWhWG952coDlvWLiCP6m/SqPDNJs7gmpT\nH1Tm58KQxOFnk2xfdNNnFNsOKiiwt/ttPmAdEq04Z05rWSxA8bMP70w1N01WVAu8\nRcRRsqWahR2yPNA1jyochHBr20sthmyVcyXorZLlAW2lEXzcqwVNVW32ecpBc0vW\ncYFAMRjbg6KP2wgAkeppKfo1Z3nMdqtky0POWUALokq7vzTNjUM2hE/XN2yI2xZM\n/PY74+ImeGFkPIYnW36x+ASJzk+6EXCzqS+vhi3ePntu7ueh+lvJyWphS8zxZbIs\nHOtV/bfXbRS2QsUJPReMaThEFflzLA+963JalZizmcip4rm5LwbaZswc/YweUWHX\nR+WyscIbzp4gWbgorKIB\n=I7ze\n-----END PGP SIGNATURE-----\n","payload":"tree 95cfe7ee7830e21b9423a9991753a2c60df9c184\nparent 0cf730f3401e68e3f390abe7b6051a78b8c59bdf\nauthor dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com> 1785833912 -0700\ncommitter GitHub <noreply@github.com> 1785833912 -0700\n\nchore(deps): bump cryptography from 48.0.1 to 50.0.0 in /libs/partners/quickjs (#5284)\n\nBumps [cryptography](https://github.com/pyca/cryptography) from 48.0.1\nto 50.0.0.\n<details>\n<summary>Changelog</summary>\n<p><em>Sourced from <a\nhref=\"https://github.com/pyca/cryptography/blob/main/CHANGELOG.rst\">cryptography's\nchangelog</a>.</em></p>\n<blockquote>\n<p>50.0.0 - 2026-07-31</p>\n<pre><code>\n* **SECURITY ISSUE**:\n\n:func:`~cryptography.hazmat.primitives.serialization.pkcs7.pkcs7_decrypt_der`\nand its PEM and S/MIME variants no longer expose distinguishable errors\nor\ntiming when unwrapping a ``RecipientInfo``'s ``encryptedKey``, which\ncould\nact as a Bleichenbacher oracle for callers that decrypt untrusted\nmessages.\nA random key is now substituted on failure, as described in :rfc:`3218`.\n  Credit to **@X1AOxiang** for reporting the issue. **CVE-2026-69247**\n* Deprecated Diffie-Hellman key exchange over finite fields (FFDH).\n  Everything FFDH is deprecated, including the types in\n``cryptography.hazmat.primitives.asymmetric.dh`` and loading FFDH keys\nor\n  parameters with the key loading APIs. Users should migrate to a more\n  modern key exchange algorithm.\n* Added ``xof()`` class methods to\n  :class:`~cryptography.hazmat.primitives.hashes.SHAKE128` and\n:class:`~cryptography.hazmat.primitives.hashes.SHAKE256` for\nconstructing\n  algorithm instances configured for use with\n  :class:`~cryptography.hazmat.primitives.hashes.XOFHash`.\n* The :mod:`X.509 verification &lt;cryptography.x509.verification&gt;`\nAPIs are now\n  considered stable and are subject to our API stability policy.\n* Added the :doc:`/cobblestone` recipe, an implementation of the\n  Cobblestone-128 and Cobblestone-256 instantiations of the `C2SP\n  chunked-encryption specification\n&lt;https://c2sp.org/chunked-encryption&gt;`_ for streaming\nauthenticated\n  encryption of large messages.\n* Parsing a Signed Certificate Timestamp list now rejects encodings that\ncarry trailing bytes after the list or after an individual SCT, instead\nof\n  silently ignoring them.\n* Added support for using :class:`~cryptography.x509.Name` as a field\ntype in\n  the :doc:`/hazmat/asn1/index` module.\n* Loading a public key or an EC private key now rejects DER where the\n``subjectPublicKey`` (or EC ``publicKey``) ``BIT STRING`` declares a\nnon-zero\n  number of unused bits, instead of silently ignoring it.\n* Parsing a CRL entry's ``InvalidityDate`` extension now rejects a\n``GeneralizedTime`` that carries fractional seconds or another non-DER\nform,\nmatching the strict encoding already required for every other X.509 time\n  field.\n* :func:`~cryptography.x509.ocsp.load_der_ocsp_request` and\n:func:`~cryptography.x509.ocsp.load_der_ocsp_response` now reject a\nrequest\nor response whose ``version`` field is not ``v1``, the only version\ndefined\nby RFC 6960, matching the version validation already performed when\nloading\n  certificates, CSRs and CRLs.\n* :class:`~cryptography.hazmat.primitives.hashes.XOFHash` is now\nsupported\n  when building against AWS-LC.\n* HMAC (and therefore PBKDF2-HMAC) with SHA-3 hashes is now supported\nwhen\n  building against AWS-LC.\n* Diffie-Hellman (:doc:`/hazmat/primitives/asymmetric/dh`) is now\nsupported\n  when building against AWS-LC.\n&lt;/tr&gt;&lt;/table&gt; \n</code></pre>\n</blockquote>\n<p>... (truncated)</p>\n</details>\n<details>\n<summary>Commits</summary>\n<ul>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/dcb7050b807b00392fa9fe2eac7cb362fcf355cc\"><code>dcb7050</code></a>\nPrepare for 50.0.0 release (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15372\">#15372</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/53fccd93413a8d7f07d6d8999681f27b75cffa3f\"><code>53fccd9</code></a>\nDon't leak how PKCS#7 encryptedKey decryption failed (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15369\">#15369</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/d472f978470fbefa521b86d98b2ecccbbb4d1dd8\"><code>d472f97</code></a>\nAdd <code>from __future__ import annotations</code> to all src/ Python\nfiles (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15371\">#15371</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/908773d53829fb1466c6db364b31321c3cd8eb9a\"><code>908773d</code></a>\nBump downstream dependencies in CI (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15368\">#15368</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/2cc07cc948948211899bcb0cddd1fddf86e95812\"><code>2cc07cc</code></a>\nBump BoringSSL, OpenSSL, AWS-LC in CI (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15367\">#15367</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/c94ede9f040fa44942f7139772603419000acf66\"><code>c94ede9</code></a>\nchore(deps): bump ruff from 0.16.0 to 0.16.1 (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15366\">#15366</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/67a8308dc9ea4cce6056e0f1438f903c208c3f35\"><code>67a8308</code></a>\nchore(deps): bump virtualenv from 21.7.0 to 21.7.1 (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15365\">#15365</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/95018ffcdbbc510fd92fc872e3a3e80aa6e58596\"><code>95018ff</code></a>\nRelease the GIL in one-shot AEAD encrypt/decrypt (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15361\">#15361</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/6954733eaf55a0074abf88f06f7242dfca3a5d02\"><code>6954733</code></a>\nRelease the GIL during DH and DSA parameter generation (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15364\">#15364</a>)</li>\n<li><a\nhref=\"https://github.com/pyca/cryptography/commit/6893b94c33e948f6240082461424cfb5da2dacc6\"><code>6893b94</code></a>\nImport _serialization instead of serialization in x509/extensions (<a\nhref=\"https://redirect.github.com/pyca/cryptography/issues/15363\">#15363</a>)</li>\n<li>Additional commits viewable in <a\nhref=\"https://github.com/pyca/cryptography/compare/48.0.1...50.0.0\">compare\nview</a></li>\n</ul>\n</details>\n<br />\n\n\n[![Dependabot compatibility\nscore](https://dependabot-badges.githubapp.com/badges/compatibility_score?dependency-name=cryptography&package-manager=uv&previous-version=48.0.1&new-version=50.0.0)](https://docs.github.com/en/github/managing-security-vulnerabilities/about-dependabot-security-updates#about-compatibility-scores)\n\nDependabot will resolve any conflicts with this PR as long as you don't\nalter it yourself. You can also trigger a rebase manually by commenting\n`@dependabot rebase`.\n\n[//]: # (dependabot-automerge-start)\n[//]: # (dependabot-automerge-end)\n\n---\n\n<details>\n<summary>Dependabot commands and options</summary>\n<br />\n\nYou can trigger Dependabot actions by commenting on this PR:\n- `@dependabot rebase` will rebase this PR\n- `@dependabot recreate` will recreate this PR, overwriting any edits\nthat have been made to it\n- `@dependabot show <dependency name> ignore conditions` will show all\nof the ignore conditions of the specified dependency\n- `@dependabot ignore this major version` will close this PR and stop\nDependabot creating any more for this major version (unless you reopen\nthe PR or upgrade to it yourself)\n- `@dependabot ignore this minor version` will close this PR and stop\nDependabot creating any more for this minor version (unless you reopen\nthe PR or upgrade to it yourself)\n- `@dependabot ignore this dependency` will close this PR and stop\nDependabot creating any more for this dependency (unless you reopen the\nPR or upgrade to it yourself)\nYou can disable automated security fix PRs for this repo from the\n[Security Alerts\npage](https://github.com/langchain-ai/deepagents/network/alerts).\n\n</details>\n\nSigned-off-by: dependabot[bot] <support@github.com>\nCo-authored-by: dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com>","verified_at":"2026-08-04T08:58:35Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/c7aa8ad7a46480e16f4efa048904d814f626553f","html_url":"https://github.com/langchain-ai/deepagents/commit/c7aa8ad7a46480e16f4efa048904d814f626553f","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/c7aa8ad7a46480e16f4efa048904d814f626553f/comments","author":{"login":"dependabot[bot]","id":49699333,"node_id":"MDM6Qm90NDk2OTkzMzM=","avatar_url":"https://avatars.githubusercontent.com/in/29110?v=4","gravatar_id":"","url":"https://api.github.com/users/dependabot%5Bbot%5D","html_url":"https://github.com/apps/dependabot","followers_url":"https://api.github.com/users/dependabot%5Bbot%5D/followers","following_url":"https://api.github.com/users/dependabot%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/dependabot%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/dependabot%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dependabot%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/dependabot%5Bbot%5D/orgs","repos_url":"https://api.github.com/us