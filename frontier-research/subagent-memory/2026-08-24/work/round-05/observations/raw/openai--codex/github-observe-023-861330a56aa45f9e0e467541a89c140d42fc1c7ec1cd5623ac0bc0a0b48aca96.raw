lowers","following_url":"https://api.github.com/users/celia-oai/following{/other_user}","gists_url":"https://api.github.com/users/celia-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/celia-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celia-oai/subscriptions","organizations_url":"https://api.github.com/users/celia-oai/orgs","repos_url":"https://api.github.com/users/celia-oai/repos","events_url":"https://api.github.com/users/celia-oai/events{/privacy}","received_events_url":"https://api.github.com/users/celia-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"11fab432be5a873fea97688ef67e8af896f5ea8c","url":"https://api.github.com/repos/openai/codex/commits/11fab432be5a873fea97688ef67e8af896f5ea8c","html_url":"https://github.com/openai/codex/commit/11fab432be5a873fea97688ef67e8af896f5ea8c"}]},{"sha":"11fab432be5a873fea97688ef67e8af896f5ea8c","node_id":"C_kwDOOYsS4doAKDExZmFiNDMyYmU1YTg3M2ZlYTk3Njg4ZWY2N2U4YWY4OTZmNWVhOGM","commit":{"author":{"name":"Adam Perry @ OpenAI","email":"anp@openai.com","date":"2026-06-23T00:02:33Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-23T00:02:33Z"},"message":"path-uri: clarify host-native path conversion (#29501)\n\n## Why\n\nDownstream refactors are producing confusing code with this\nfunctionality having a very generic name. Encoding the specific\nconversion approach in the method name makes it clearer.\n\n## What\n\nRename `PathUri::from_path` to `PathUri::from_host_native_path` and\nupdate its Rust call sites.","tree":{"sha":"3d723bb6e65c6622a82a5cd9c82db78871499c74","url":"https://api.github.com/repos/openai/codex/git/trees/3d723bb6e65c6622a82a5cd9c82db78871499c74"},"url":"https://api.github.com/repos/openai/codex/git/commits/11fab432be5a873fea97688ef67e8af896f5ea8c","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqOc0ZCRC1aQ7uu5UhlAAARucQAGf4aUdw6pF5hfgRVQcMSCrs\n0G1akF8PjToBrjUKfQBB4fO6rUKkjbL8i0rhnVikk+fWtdpcQR4SAMpKSpzHd16k\nt7faU77sgB1BJVLrPv2/TTU0cK5bDucUtAY+Yk+CPkTDZ0XxqdZKGqEEDWwtoVKm\nEhcIfq0lOG3FnSE99LqhjLsJAxx0ezWDOPN6SnWgZMUsnY/PnwkBV09kckTDmgU/\nE60VFav3XjkzMhVhV7d9CsXhp/1yTxEulkCrip6qVHywg2Dx7cblKfeqLEptBJYi\nT7uMPV87D2Cue+L7fSNmu4mYCy7qU3h9AWkfFIfXfqzzEvOonDrjhb1jIgUI9URV\nlGPCVlRrQxgpiy/R3L5BMuWE0UXewmGnl8Hfdpi9LFni1ZWzaOfNeXuqyP5z/kxQ\nBYZVFD0xK8HkppjSahl7GbjKwXKL/8cOYP+GKIpU4D4XZAwEwVfPIqwAi4e88AtW\nn2u4aUXGm7RZ4tvYnNY9D/mymn3E+lXlt1Flasy1VHlpTHTenJrp5Ao+EnNocib7\nmsVWZqF8kvvQY2LYgw72RHDN0IaiNTnJSrg9LaVUwl6ZpkcZfuUXX0y7CRRvWqWA\nHU3IXUrBF6Sz/0hG/ChWEA7xVEWgjhWgXww2A9x4JOb5D1t8XP66P3KCn1veICUR\nxvI9UX0IemTlRfJF+sN1\n=Epe+\n-----END PGP SIGNATURE-----\n","payload":"tree 3d723bb6e65c6622a82a5cd9c82db78871499c74\nparent c53b1dae09db40902c59f6a0d57d0dcc334926db\nauthor Adam Perry @ OpenAI <anp@openai.com> 1782172953 -0700\ncommitter GitHub <noreply@github.com> 1782172953 +0000\n\npath-uri: clarify host-native path conversion (#29501)\n\n## Why\n\nDownstream refactors are producing confusing code with this\nfunctionality having a very generic name. Encoding the specific\nconversion approach in the method name makes it clearer.\n\n## What\n\nRename `PathUri::from_path` to `PathUri::from_host_native_path` and\nupdate its Rust call sites.","verified_at":"2026-06-23T00:02:33Z"}},"url":"https://api.github.com/repos/openai/codex/commits/11fab432be5a873fea97688ef67e8af896f5ea8c","html_url":"https://github.com/openai/codex/commit/11fab432be5a873fea97688ef67e8af896f5ea8c","comments_url":"https://api.github.com/repos/openai/codex/commits/11fab432be5a873fea97688ef67e8af896f5ea8c/comments","author":{"login":"anp-oai","id":286154589,"node_id":"U_kgDOEQ5fXQ","avatar_url":"https://avatars.githubusercontent.com/u/286154589?v=4","gravatar_id":"","url":"https://api.github.com/users/anp-oai","html_url":"https://github.com/anp-oai","followers_url":"https://api.github.com/users/anp-oai/followers","following_url":"https://api.github.com/users/anp-oai/following{/other_user}","gists_url":"https://api.github.com/users/anp-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/anp-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anp-oai/subscriptions","organizations_url":"https://api.github.com/users/anp-oai/orgs","repos_url":"https://api.github.com/users/anp-oai/repos","events_url":"https://api.github.com/users/anp-oai/events{/privacy}","received_events_url":"https://api.github.com/users/anp-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c53b1dae09db40902c59f6a0d57d0dcc334926db","url":"https://api.github.com/repos/openai/codex/commits/c53b1dae09db40902c59f6a0d57d0dcc334926db","html_url":"https://github.com/openai/codex/commit/c53b1dae09db40902c59f6a0d57d0dcc334926db"}]},{"sha":"c53b1dae09db40902c59f6a0d57d0dcc334926db","node_id":"C_kwDOOYsS4doAKGM1M2IxZGFlMDlkYjQwOTAyYzU5ZjZhMGQ1N2QwZGNjMzM0OTI2ZGI","commit":{"author":{"name":"sayan-oai","email":"sayan@openai.com","date":"2026-06-22T23:45:23Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-22T23:45:23Z"},"message":"[codex] Use tool search for MCP tools by default (#29486)\n\n## Why\n\nMCP tools were only placed behind `tool_search` when a feature flag was\nenabled or when there were at least 100 tools. That made the model's\ntool flow depend on both rollout configuration and the number of\ninstalled tools.\n\nThe searched-tool flow is now the intended behavior. Making it\nunconditional when the model and provider support it gives every\nsupported setup the same behavior and lets us retire the feature flag\nsafely.\n\n## What changed\n\n- Defer all effective MCP tools when `tool_search` and namespaced tools\nare supported.\n- Keep exposing MCP tools directly when search cannot be used, so older\nor unsupported model/provider combinations still work.\n- Mark `tool_search_always_defer_mcp_tools` as removed and ignore old\nconfigured values.\n- Keep plugin filtering, app-only filtering, file handling, and MCP\ncalls working through the searched-tool flow.\n\n## Why many tests changed\n\nMany tests used to act as if the model could see MCP tools in its first\nrequest and call them immediately. That is no longer the real flow: the\nmodel first receives `tool_search`, searches for a tool, receives the\nmatching MCP tool, and then calls it in the next request.\n\nThe tests therefore needed an extra search step, and checks for tool\nnames, descriptions, and input fields had to move from the first request\nto the search result. These are not separate product changes; they make\nthe tests follow what the model will actually see after this change. The\nplugin tests still check which tools are allowed and where they came\nfrom, the file tests still check upload fields and behavior, and the MCP\nround-trip test still checks a successful call from start to finish.\n\n## Tests\n\n- `just test -p codex-features`\n- Focused `codex-core` tests for MCP exposure and tool planning\n- `just test -p codex-core explicit_plugin_mentions`\n- `just test -p codex-core stdio_server_round_trip`\n- Focused `codex-core` tests for tool search, app-only tools, and MCP\nfile uploads","tree":{"sha":"6f347a2d5dbeef60c09f16754c4c0fa5f28fa4fb","url":"https://api.github.com/repos/openai/codex/git/trees/6f347a2d5dbeef60c09f16754c4c0fa5f28fa4fb"},"url":"https://api.github.com/repos/openai/codex/git/commits/c53b1dae09db40902c59f6a0d57d0dcc334926db","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqOckTCRC1aQ7uu5UhlAAA9mQQAGoaVBmM2sghm7UMQgqhVJX4\nvz5V74n36TYqLh35aoXWbOH39UalHfC52WwJPO5DJGCaBMs66LZyzzKeE8rKLpWn\nUcG9WYFk56/UdpKHZTS/HyMbq0qvp0/kTtqY7BKiacSPIId+sT0Wlad8pMc/XTXu\nUWZhu3lK48r1YNhOhlNLTxbzx9a2eAlZHKFOSDmUq0CnMpAJzcc4gCQRSaQrp6Us\nVV9yTh2e2cVUseDK8HipwvE7fyMYQIlbvctrKMqhpqKnWXuIWE+IhAs/iO5SZZW5\ntaac0DiCEN8XgYkz7sPcyzH/b21R3IcYLUfBHfUNP7FLJBl3jMXiVCHa9Ju7d2ar\n589mIVvaRqTTMe9uf635Yd8UFpke8X/Q10IIY4F/iIFbqdDgD6ynIpeYLnvkvT94\nXtqdSSLNDpeyDFl403ysXiHmDnyLYuLZGlcpgV7MISIOJHaDu0Td5TjufDgiUfnE\nrCFFEbgvldjVOZUyNVx2T+NukpZ7vZbKjv8aM0m+L+4mclOIkkwOwdBDdAG192d8\ngv55jthjbsMWCcYJJuKZugQzKAxDdx0iluSjFwdqKCf6elWPVqlL16eWm1sBZ2nV\nRaKsjzKoPFCm7Pieaoo2xEyEnZ+bSLOFehNe0/ZIGad8JSOSw5a5YEzvz2dBBV8l\nZInTU+H2IwwD/izF+2t5\n=bbLj\n-----END PGP SIGNATURE-----\n","payload":"tree 6f347a2d5dbeef60c09f16754c4c0fa5f28fa4fb\nparent 4a82ecc3c9fcb8b9f21d5144c40a0dfdab54a02a\nauthor sayan-oai <sayan@openai.com> 1782171923 -0700\ncommitter GitHub <noreply@github.com> 1782171923 -0700\n\n[codex] Use tool search for MCP tools by default (#29486)\n\n## Why\n\nMCP tools were only placed behind `tool_search` when a feature flag was\nenabled or when there were at least 100 tools. That made the model's\ntool flow depend on both rollout configuration and the number of\ninstalled tools.\n\nThe searched-tool flow is now the intended behavior. Making it\nunconditional when the model and provider support it gives every\nsupported setup the same behavior and lets us retire the feature flag\nsafely.\n\n## What changed\n\n- Defer all effective MCP tools when `tool_search` and namespaced tools\nare supported.\n- Keep exposing MCP tools directly when search cannot be used, so older\nor unsupported model/provider combinations still work.\n- Mark `tool_search_always_defer_mcp_tools` as removed and ignore old\nconfigured values.\n- Keep plugin filtering, app-only filtering, file handling, and MCP\ncalls working through the searched-tool flow.\n\n## Why many tests changed\n\nMany tests used to act as if the model could see MCP tools in its first\nrequest and call them immediately. That is no longer the real flow: the\nmodel first receives `tool_search`, searches for a tool, receives the\nmatching MCP tool, and then calls it in the next request.\n\nThe tests therefore needed an extra search step, and checks for tool\nnames, descriptions, and input fields had to move from the first request\nto the search result. These are not separate product changes; they make\nthe tests follow what the model will actually see after this change. The\nplugin tests still check which tools are allowed and where they came\nfrom, the file tests still check upload fields and behavior, and the MCP\nround-trip test still checks a successful call from start to finish.\n\n## Tests\n\n- `just test -p codex-features`\n- Focused `codex-core` tests for MCP exposure and tool planning\n- `just test -p codex-core explicit_plugin_mentions`\n- `just test -p codex-core stdio_server_round_trip`\n- Focused `codex-core` tests for tool search, app-only tools, and MCP\nfile uploads","verified_at":"2026-06-22T23:45:24Z"}},"url":"https://api.github.com/repos/openai/codex/commits/c53b1dae09db40902c59f6a0d57d0dcc334926db","html_url":"https://github.com/openai/codex/commit/c53b1dae09db40902c59f6a0d57d0dcc334926db","comments_url":"https://api.github.com/repos/openai/codex/commits/c53b1dae09db40902c59f6a0d57d0dcc334926db/comments","author":{"login":"sayan-oai","id":244841968,"node_id":"U_kgDODpf98A","avatar_url":"https://avatars.githubusercontent.com/u/244841968?v=4","gravatar_id":"","url":"https://api.github.com/users/sayan-oai","html_url":"https://github.com/sayan-oai","followers_url":"https://api.github.com/users/sayan-oai/followers","following_url":"https://api.github.com/users/sayan-oai/following{/other_user}","gists_url":"https://api.github.com/users/sayan-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/sayan-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sayan-oai/subscriptions","organizations_url":"https://api.github.com/users/sayan-oai/orgs","repos_url":"https://api.github.com/users/sayan-oai/repos","events_url":"https://api.github.com/users/sayan-oai/events{/privacy}","received_events_url":"https://api.github.com/users/sayan-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"4a82ecc3c9fcb8b9f21d5144c40a0dfdab54a02a","url":"https://api.github.com/repos/openai/codex/commits/4a82ecc3c9fcb8b9f21d5144c40a0dfdab54a02a","html_url":"https://github.com/openai/codex/commit/4a82ecc3c9fcb8b9f21d5144c40a0dfdab54a02a"}]},{"sha":"4a82ecc3c9fcb8b9f21d5144c40a0dfdab54a02a","node_id":"C_kwDOOYsS4doAKDRhODJlY2MzYzlmY2I4YjlmMjFkNTE0NGM0MGEwZGZkYWI1NGEwMmE","commit":{"author":{"name":"Owen Lin","email":"owenlin0@gmail.com","date":"2026-06-22T23:45:14Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-22T23:45:14Z"},"message":"feat(core): store turn_id on ResponseItem metadata (#28360)\n\n## Description\n\nThis PR is a followup to https://github.com/openai/codex/pull/28355 and\nstarts assigning `internal_chat_message_metadata_passthrough.turn_id` to\ndurable Responses API items created during a turn.\n\nThe goal is that those items keep the `turn_id` that introduced them\nwhen Codex resends stateless HTTP context, reconstructs history for\nresume/fork paths, or reuses websocket response state.\n\n## What changed\n\n- Set `internal_chat_message_metadata_passthrough.turn_id` when missing\nas response items enter durable history, initial/replacement history,\ninter-agent communication history, and local compaction summaries.\n- Preserve existing item turn IDs instead of overwriting them during\npersistence, resume reconstruction, compaction, forked history, and\nwebsocket incremental reuse.\n- Keep `compaction_trigger` fieldless because it is a request control,\nnot a durable response item.\n- Update focused history/request assertions and fixtures for stateless\nrequests, websocket incrementals, compaction, thread injection, prompt\ndebug, and related CI coverage.","tree":{"sha":"98d0aca99ae2fa4d3920e33573498bac2667ebdc","url":"https://api.github.com/repos/openai/codex/git/trees/98d0aca99ae2fa4d3920e33573498bac2667ebdc"},"url":"https://api.github.com/repos/openai/codex/git/commits/4a82ecc3c9fcb8b9f21d5144c40a0dfdab54a02a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqOckKCRC1aQ7uu5UhlAAAkl8QAKWERBCXK6NWp7bNZIssl13M\n6aYL+wm6KyKx4myFwt2/ONbeIaEyiCfyL8YzxQU7iGEZRxZL3CsCTuojN9NKIQJp\nHQ0/fCh1sPzKc6thlnppnnF1qo4Yuu7nw2X5qM3yX3bzQmVt+jQmfk67Y9vPuxjq\no6dx8PoGhBR7aXwW0sAlAEBv42s4TdA5JQ8bMcul7KiSpcs7xt8zkz+gTPEia13P\njkXN0QuB4/9PFdeHMi1q8qAJXe0iDYvYjVEB9tSuZSGT2GxQUEMZch4teNelgZjC\n7dCoz66OEr9KfU1qlM8gLLlqYT6SO5efc172ZwpojJeuB+4lxyHTaJHLHGTpgKDb\nlUcZWVyuCmYk1q/G5tzA1+PL+cA+TDkhFWmo5KnKBjNKb14yH98KlK+NbWMG2NLH\nlARIzu0qTGgtB6nV81625vj6//XUmEHu4kg2pZrFKQxh0ZP5z+/BGvCfpINpK5U9\nWPVkfK0Cfu2qqJMEqM/k5EnbHVjNmGjMKu5k8nEdzywq/IU/Q8myMdTFmhwg74/x\nDjMf7L3uaPK/Xcey0ThlGqKlwG/ouTaK32rTn1G44FeXHLZayFT++p+QuQ3ipUvF\nW7LmOaDnOd/d3zVlk3YghxPSILUBucugk9f/62yef/eXR6OnGI0gb6hja6bCjaXV\nzSbswEsXbLImFlHcsbsy\n=EqdC\n-----END PGP SIGNATURE-----\n","payload":"tree 98d0aca99ae2fa4d3920e33573498bac2667ebdc\nparent 7153affa0fef1653a9ee8d2b4864c50e8ec0d56d\nauthor Owen Lin <owenlin0@gmail.com> 1782171914 -0700\ncommitter GitHub <noreply@github.com> 1782171914 -0700\n\nfeat(core): store turn_id on ResponseItem metadata (#28360)\n\n## Description\n\nThis PR is a followup to https://github.com/openai/codex/pull/28355 and\nstarts assigning `internal_chat_message_metadata_passthrough.turn_id` to\ndurable Responses API items created during a turn.\n\nThe goal is that those items keep the `turn_id` that introduced them\nwhen Codex resends stateless HTTP context, reconstructs history for\nresume/fork paths, or reuses websocket response state.\n\n## What changed\n\n- Set `internal_chat_message_metadata_passthrough.turn_id` when missing\nas response items enter durable history, initial/replacement history,\ninter-agent communication history, and local compaction summaries.\n- Preserve existing item turn IDs instead of overwriting them during\npersistence, resume reconstruction, compaction, forked history, and\nwebsocket incremental reuse.\n- Keep `compaction_trigger` fieldless because it is a request control,\nnot a durable response item.\n- Update focused history/request assertions and fixtures for stateless\nrequests, websocket incrementals, compaction, thread injection, prompt\ndebug, and related CI coverage.","verified_at":"2026-06-22T23:45:14Z"}},"url":"https://api.github.com/repos/openai/codex/commits/4a82ecc3c9fcb8b9f21d5144c40a0dfdab54a02a","html_url":"https://github.com/openai/codex/commit/4a82ecc3c9fcb8b9f21d5144c40a0dfdab54a02a","comments_url":"https://api.github.com/repos/openai/codex/commits/4a82ecc3c9fcb8b9f21d5144c40a0dfdab54a02a/comments","author":{"login":"owenlin0","id":947871,"node_id":"MDQ6VXNlcjk0Nzg3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/947871?v=4","gravatar_id":"","url":"https://api.github.com/users/owenlin0","html_url":"https://github.com/owenlin0","followers_url":"https://api.github.com/users/owenlin0/followers","following_url":"https://api.github.com/users/owenlin0/following{/other_user}","gists_url":"https://api.github.com/users/owenlin0/gists{/gist_id}","starred_url":"https://api.github.com/users/owenlin0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owenlin0/subscriptions","organizations_url":"https://api.github.com/users/owenlin0/orgs","repos_url":"https://api.github.com/users/owenlin0/repos","events_url":"https://api.github.com/users/owenlin0/events{/privacy}","received_events_url":"https://api.github.com/users/owenlin0/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7153affa0fef1653a9ee8d2b4864c50e8ec0d56d","url":"https://api.github.com/repos/openai/codex/commits/7153affa0fef1653a9ee8d2b4864c50e8ec0d56d","html_url":"https://github.com/openai/codex/commit/7153affa0fef1653a9ee8d2b4864c50e8ec0d56d"}]},{"sha":"7153affa0fef1653a9ee8d2b4864c50e8ec0d56d","node_id":"C_kwDOOYsS4doAKDcxNTNhZmZhMGZlZjE2NTNhOWVlOGQyYjQ4NjRjNTBlOGVjMGQ1NmQ","commit":{"author":{"name":"rka-oai","email":"rka@openai.com","date":"2026-06-22T23:41:00Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-22T23:41:00Z"},"message":"[codex] replace remote images with model-visible error text (#29417)\n\n## What\n\nThis PR will extend the existing centralized image-preparation path to\nreplace HTTP(S) image inputs with a model visible error message. It\nwon't \"ruin\" and break existing rollouts, but it will deprecate support\nfor the pathway. App server clients should no longer use HTTP image urls\nif they'd like to upgrade.\n\nThe HTTP image url pathway is currently resolved in the responsesapi. It\nis slow and not reccomended.\n\n## Behavior\n\n- HTTP(S) image URL: replace with `input_text`\n- data URL: use the existing decode and resize path\n- other image URL schemes: leave unchanged\n\nThis intentionally does not change app-server ingress. That validation\nremains a follow-up.\n\n## Test plan\n\n- `just test -p codex-core -E\n'test(/image_preparation|prepares_image_failures_before_history_insertion|prepares_resumed_history_before_installing_it|responses_lite_prepares_images/)'`\n— 7 passed\n- `just fix -p codex-core`\n- `just fmt`","tree":{"sha":"b6db0226d792a4ee127a52df267e9efe1ba1a7ed","url":"https://api.github.com/repos/openai/codex/git/trees/b6db0226d792a4ee127a52df267e9efe1ba1a7ed"},"url":"https://api.github.com/repos/openai/codex/git/commits/7153affa0fef1653a9ee8d2b4864c50e8ec0d56d","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqOcgMCRC1aQ7uu5UhlAAAhyMQAB9VB1ykdWojv6ckQTmqnDF/\n5sohcfo5agOfhiU1iOVMDvVQLEZLqnuyjeBaZvuYM9K9A0Q+NbKa0U7KHXz9sSAV\nIi/imo/n4snnYviqJwFbAG5bjMJe1NCjWIBqG7GEbNnBDCl4LQaISbCSx53NQaPA\nupIAXx5SCAS00Mh+8WERMGj3OpdU55SXokOuKo2EnjAoYeH+GDFfE3+mLxbU+bWm\ngKVbK8mtMb/8JlAcYGIoaKvJXdvbkVtnJmX+qlxbUInKNqhwU7ej8C1zxmnwXkcr\nPSueIBFJbyUhSe4jgMQob6dPlvgKX25YheMIc1/kyye42kr71khiyBnm4DPEgWf4\nMLeafagw2MLEi0aojNquvcclk7mvfTwzXi1JYUpaXiqD+sLZ49BvZBrC45Bm6WoV\nKNG76HJn74d5a5k+uf5Pu7smDaFR97kyDnHOEj4nnGrKdS/5qZrGhTisieZt/r9J\n7CaC/Ni8JdBYPt8MYXrnj4zEPmzV7vQcxbqkXDXU8cQ62CrUi1AKXjw4gJrXgDDc\nBcaswEwy3yJ9ZPn8eWWCSwInY8PGETj1inQLFHfisZafKXcS8JQEjdnhWFruH4XE\nlR3KdbMk4cfgAzyS1+rYYJF4eYL4UKKrBkDBrsQCYDAq5GCfsDpTLyoIHO1mP0ii\n8VPdMbIgeN7tztp2zkqM\n=6ZtM\n-----END PGP SIGNATURE-----\n","payload":"tree b6db0226d792a4ee127a52df267e9efe1ba1a7ed\nparent f1945de3b764d50539d4d9a01b349c9cfc2426f6\nauthor rka-oai <rka@openai.com> 1782171660 -0700\ncommitter GitHub <noreply@github.com> 1782171660 -0700\n\n[codex] replace remote images with model-visible error text (#29417)\n\n## What\n\nThis PR will extend the existing centralized image-preparation path to\nreplace HTTP(S) image inputs with a model visible error message. It\nwon't \"ruin\" and break existing rollouts, but it will deprecate support\nfor the pathway. App server clients should no longer use HTTP image urls\nif they'd like to upgrade.\n\nThe HTTP image url pathway is currently resolved in the responsesapi. It\nis slow and not reccomended.\n\n## Behavior\n\n- HTTP(S) image URL: replace with `input_text`\n- data URL: use the existing decode and resize path\n- other image URL schemes: leave unchanged\n\nThis intentionally does not change app-server ingress. That validation\nremains a follow-up.\n\n## Test plan\n\n- `just test -p codex-core -E\n'test(/image_preparation|prepares_image_failures_before_history_insertion|prepares_resumed_history_before_installing_it|responses_lite_prepares_images/)'`\n— 7 passed\n- `just fix -p codex-core`\n- `just fmt`","verified_at":"2026-06-22T23:41:00Z"}},"url":"https://api.github.com/repos/openai/codex/commits/7153affa0fef1653a9ee8d2b4864c50e8ec0d56d","html_url":"https://github.com/openai/codex/commit/7153affa0fef1653a9ee8d2b4864c50e8ec0d56d","comments_url":"https://api.github.com/repos/openai/codex/commits/7153affa0fef1653a9ee8d2b4864c50e8ec0d56d/comments","author":{"login":"rka-oai","id":240799229,"node_id":"U_kgDODlpN_Q","avatar_url":"https://avatars.githubusercontent.com/u/240799229?v=4","gravatar_id":"","url":"https://api.github.com/users/rka-oai","html_url":"https://github.com/rka-oai","followers_url":"https://api.github.com/users/rka-oai/followers","following_url":"https://api.github.com/users/rka-oai/following{/other_user}","gists_url":"https://api.github.com/users/rka-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/rka-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rka-oai/subscriptions","organizations_url":"https://api.github.com/users/rka-oai/orgs","repos_url":"https://api.github.com/users/rka-oai/repos","events_url":"https://api.github.com/users/rka-oai/events{/privacy}","received_events_url":"https://api.github.com/users/rka-oai/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f1945de3b764d50539d4d9a01b349c9cfc2426f6","url":"https://api.github.com/repos/openai/codex/commits/f1945de3b764d50539d4d9a01b349c9cfc2426f6","html_url":"https://github.com/openai/codex/commit/f1945de3b764d50539d4d9a01b349c9cfc2426f6"}]},{"sha":"f1945de3b764d50539d4d9a01b349c9cfc2426f6","node_id":"C_kwDOOYsS4doAKGYxOTQ1ZGUzYjc2NGQ1MDUzOWQ0ZDlhMDFiMzQ5YzljZmMyNDI2ZjY","commit":{"author":{"name":"Michael Bolin","email":"mbolin@openai.com","date":"2026-06-22T23:37:49Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-22T23:37:49Z"},"message":"core: wrap token budget window context (#29494)\n\nToken-budget initial context carries thread and context-window lineage\nthat the model should treat as one structured context-window block.\nWrapping it in `<context_window>` makes that boundary explicit while\npreserving the existing window id content.\n\nBefore this change, the window identifiers were injected as an untagged\ndeveloper text fragment:\n\n```text\nThread id <THREAD_ID>.\nFirst context window id: <FIRST_WINDOW_ID>\nCurrent context window id: <WINDOW_ID>\nPrevious context window id: <PREVIOUS_WINDOW_ID>\n```\n\nAfter this change, the same payload is wrapped as a context-window\nblock:\n\n```text\n<context_window>\nThread id: <THREAD_ID>\nFirst context window id: <FIRST_WINDOW_ID>\nCurrent context window id: <WINDOW_ID>\nPrevious context window id: <PREVIOUS_WINDOW_ID>\n</context_window>\n```\n\nThis adds shared `CONTEXT_WINDOW_*_TAG` protocol constants, updates\n`TokenBudgetContext` to render with those markers, treats the new\nwrapper as contextual developer content when mapping history, and\nrefreshes the token-budget request-shape assertions and snapshot.\n\nVerification:\n- `just test -p codex-core token_budget`\n- `just test -p codex-core\nrecognizes_context_window_as_contextual_developer_content`","tree":{"sha":"61c6d0561051fdcb270efcbcafce3bda5b041a27","url":"https://api.github.com/repos/openai/codex/git/trees/61c6d0561051fdcb270efcbcafce3bda5b041a27"},"url":"https://api.github.com/repos/openai/codex/git/commits/f1945de3b764d50539d4d9a01b349c9cfc2426f6","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqOcdNCRC1aQ7uu5UhlAAA/7sQAKe+tTRHGQu+rRBkuiTIPh57\nru9eDYR2EqIqM5B/lS0w7IsVt31ilrwfLkaH7oxhg+kTyfU6840q0wIImLQx+iym\ndlCxny9qMeEEEx76UM3sDHNFEVgTIrFDy7wVi90xztHfnsf/pwtOGAFNL7YokyTG\nbf8uLlXPAvLeL7mC7Tx+tZwJCHkYSG90ooPmoIX3EEhlB3fiPAtJ6Qqm955p3ooB\nb/H04eORf2Da38/dWWec+KfI0ZZN+f5G+JbWXr8eLqLLitjcZaViaSC5dYDP9sdh\noy5cgOn09OwH8oXBhxC/TrsQ0fl1bag8xFJuCarYTvH059gLDHgsTO0fycxvvpO0\n5lR509zqbAxzyvKo3d4CVhAJqyNrh1tcrgra8mtLuKceNlBkHJOxD2TxZEiOhRfx\nEvxk46jm+JBMAUUFDBAM+Wfuq6xjgkG17JO3FMFRUZfM/vPfRgMeTDSBs/kjQxIR\nzeO62hVH4ydAKjyvu6kCLlhCCYqsV8ENoo7Rz3rh1DreF6rfHIXoMYOUFj0OB5Jv\n5k4jnb6mbVAusMnlMrhn6BBDvlGJm5gmumBWB44md2TVFxDjRtV4jBomqz7tzJv9\n5Kglagh+ZLD0cVbMp3LWRxzFXFRCstS0NUuNbVIkrfEUhzYWYc9iTYKG6ec+FrpP\nesuA/JyG9Jc70o3V3dd7\n=VrXv\n-----END PGP SIGNATURE-----\n","payload":"tree 61c6d0561051fdcb270efcbcafce3bda5b041a27\nparent 3b32d861c5ecc1e705812bc21177d0038e3c05ee\nauthor Michael Bolin <mbolin@openai.com> 1782171469 -0700\ncommitter GitHub <noreply@github.com> 1782171469 +0000\n\ncore: wrap token budget window context (#29494)\n\nToken-budget initial context carries thread and context-window lineage\nthat the model should treat as one structured context-window block.\nWrapping it in `<context_window>` makes that boundary explicit while\npreserving the existing window id content.\n\nBefore this change, the window identifiers were injected as an untagged\ndeveloper text fragment:\n\n```text\nThread id <THREAD_ID>.\nFirst context window id: <FIRST_WINDOW_ID>\nCurrent context window id: <WINDOW_ID>\nPrevious context window id: <PREVIOUS_WINDOW_ID>\n```\n\nAfter this change, the same payload is wrapped as a context-window\nblock:\n\n```text\n<context_window>\nThread id: <THREAD_ID>\nFirst context window id: <FIRST_WINDOW_ID>\nCurrent context window id: <WINDOW_ID>\nPrevious context window id: <PREVIOUS_WINDOW_ID>\n</context_window>\n```\n\nThis adds shared `CONTEXT_WINDOW_*_TAG` protocol constants, updates\n`TokenBudgetContext` to render with those markers, treats the new\nwrapper as contextual developer content when mapping history, and\nrefreshes the token-budget request-shape assertions and snapshot.\n\nVerification:\n- `just test -p codex-core token_budget`\n- `just test -p codex-core\nrecognizes_context_window_as_contextual_developer_content`","verified_at":"2026-06-22T23:37:49Z"}},"url":"https://api.github.com/repos/openai/codex/commits/f1945de3b764d50539d4d9a01b349c9cfc2426f6","html_url":"https://github.com/openai/codex/commit/f1945de3b764d50539d4d9a01b349c9cfc2426f6","comments_url":"https://api.github.com/repos/openai/codex/commits/f1945de3b764d50539d4d9a01b349c9cfc2426f6/comments","author":{"login":"bolinfest","id":655869,"node_id":"MDQ6VXNlcjY1NTg2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/655869?v=4","gravatar_id":"","url":"https://api.github.com/users/bolinfest","html_url":"https://github.com/bolinfest","followers_url":"https://api.github.com/users/bolinfest/followers","following_url":"https://api.github.com/users/bolinfest/following{/other_user}","gists_url":"https://api.github.com/users/bolinfest/gists{/gist_id}","starred_url":"https://api.github.com/users/bolinfest/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bolinfest/subscriptions","organizations_url":"https://api.github.com/users/bolinfest/orgs","repos_url":"https://api.github.com/users/bolinfest/repos","events_url":"https://api.github.com/users/bolinfest/events{/privacy}","received_events_url":"https://api.github.com/users/bolinfest/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"3b32d861c5ecc1e705812bc21177d0038e3c05ee","url":"https://api.github.com/repos/openai/codex/commits/3b32d861c5ecc1e705812bc21177d0038e3c05ee","html_url":"https://github.com/openai/codex/commit/3b32d861c5ecc1e705812bc21177d0038e3c05ee"}]}]