ored-by: github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","verified_at":"2026-06-03T21:02:52Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/0f685369ac104c73b49784869ac38cfa459a4ed9","html_url":"https://github.com/langchain-ai/deepagents/commit/0f685369ac104c73b49784869ac38cfa459a4ed9","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/0f685369ac104c73b49784869ac38cfa459a4ed9/comments","author":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"13dafd8823c4b530c8e096012733ad74cd501b59","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/13dafd8823c4b530c8e096012733ad74cd501b59","html_url":"https://github.com/langchain-ai/deepagents/commit/13dafd8823c4b530c8e096012733ad74cd501b59"}]},{"sha":"13dafd8823c4b530c8e096012733ad74cd501b59","node_id":"C_kwDOPTymldoAKDEzZGFmZDg4MjNjNGI1MzBjOGUwOTYwMTI3MzNhZDc0Y2Q1MDFiNTk","commit":{"author":{"name":"Yuvraj Singh Sisodiya","email":"yuvrajsisodiya7302@gmail.com","date":"2026-06-03T20:55:03Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-06-03T20:55:03Z"},"message":"feat(runloop): add blueprint bootstrapping for Runloop sandboxes (#3556)\n\nCloses #3540, Follow-up to #3538.\n  ---\n\nAdds blueprint bootstrapping to `RunloopProvider` in `langchain-runloop`\nand unblocks\n`--sandbox-snapshot-name` for `--sandbox runloop` in `deepagents-code`.\n\n- Blueprint resolves in order: `RUNLOOP_SANDBOX_BLUEPRINT_ID` →\n`snapshot` kwarg →\n  `RUNLOOP_SANDBOX_BLUEPRINT_NAME` → empty devbox\n- ID path skips listing/building entirely; name path does\ncreate-if-missing (same flow as LangSmith\n   snapshots)\n- In-flight blueprint (building, failed, etc.) raises instead of\nstarting a duplicate build\n- Plain `--sandbox runloop` with no hints still starts an empty devbox —\nMason deferred on a\n  built-in default so we kept backward compat\n- `DEEPAGENTS_CODE_` prefix works for both blueprint env vars via the\nexisting `resolve_env_var`\n  plumbing\n\n---------\n\nCo-authored-by: Mason Daugherty <mason@langchain.dev>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","tree":{"sha":"ae4fb51f834c8323cf00b93afade17da4afe39dd","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/ae4fb51f834c8323cf00b93afade17da4afe39dd"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/13dafd8823c4b530c8e096012733ad74cd501b59","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqIJSnCRC1aQ7uu5UhlAAAYbkQAAQjmMcrGKAFA3/cVzOelrTt\n5uD250iTfSJxOtAYmfyY9gkn5HRtgWC9sDOgdqH+DK4B5RH+nuBUurxbRXhRoFJy\nnvRcfC+hR3g3uFrbmmdeLRQ2gw7UXhrkxRfg6LLqTlY+CO60aZxiA1z+ECyAP2kT\nb+OTwe5g6vCEw6Q9DikJkROVqIwpncIqTuNdPmdZBSSCqaW0vAFgkA3tnllGfENL\nYHVYMchcaLW7TUr0XrPhMVdzKqqm1sYjrJIYJF+D2nhRhXbT1CVcpTo6YCNTdiKP\npgm5M+teC59nH1WkiP6oIIZhRZtXlnVmX8ebS8nDX6Ltye36+lNRk8H8ixDXTTN4\n42iuTMJ8rwh0B+bTfxL6GCA1WlLSYTvvxOymeOKp3DGp0rNMismx4qaw5syL+FDr\nf61zHy21mfCMxnjM0Nn/FdpzNAfafw8iUkSzeIveBxNpmfnSirjBfqgzPT0CYUhP\nAYJzZ0NpRjRf+NN9DVCkc+xkhW4k4yC0TbaHqD0CetxCqFdSY4iT/5/diMHwB3QN\nbJcS9o8xuUT5sDbIPfgtWzyNY9tMQ2q4GwfbrOZyWknCpdiWIjF1i2THwZ6wZQVo\nuTGGbD0+mH/WSAoV2NN72b4ywiu+PdWA0gY45rzN1Io+ExNf/MjJ0nAQIqrDv3lL\nGnfoCbUDWM0aLubb6T1K\n=a/sD\n-----END PGP SIGNATURE-----\n","payload":"tree ae4fb51f834c8323cf00b93afade17da4afe39dd\nparent bbd1a4f5c264871504e36abd86ebe10ad4d9d3e2\nauthor Yuvraj Singh Sisodiya <yuvrajsisodiya7302@gmail.com> 1780520103 +0530\ncommitter GitHub <noreply@github.com> 1780520103 -0400\n\nfeat(runloop): add blueprint bootstrapping for Runloop sandboxes (#3556)\n\nCloses #3540, Follow-up to #3538.\n  ---\n\nAdds blueprint bootstrapping to `RunloopProvider` in `langchain-runloop`\nand unblocks\n`--sandbox-snapshot-name` for `--sandbox runloop` in `deepagents-code`.\n\n- Blueprint resolves in order: `RUNLOOP_SANDBOX_BLUEPRINT_ID` →\n`snapshot` kwarg →\n  `RUNLOOP_SANDBOX_BLUEPRINT_NAME` → empty devbox\n- ID path skips listing/building entirely; name path does\ncreate-if-missing (same flow as LangSmith\n   snapshots)\n- In-flight blueprint (building, failed, etc.) raises instead of\nstarting a duplicate build\n- Plain `--sandbox runloop` with no hints still starts an empty devbox —\nMason deferred on a\n  built-in default so we kept backward compat\n- `DEEPAGENTS_CODE_` prefix works for both blueprint env vars via the\nexisting `resolve_env_var`\n  plumbing\n\n---------\n\nCo-authored-by: Mason Daugherty <mason@langchain.dev>\nCo-authored-by: Mason Daugherty <github@mdrxy.com>","verified_at":"2026-06-03T20:55:04Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/13dafd8823c4b530c8e096012733ad74cd501b59","html_url":"https://github.com/langchain-ai/deepagents/commit/13dafd8823c4b530c8e096012733ad74cd501b59","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/13dafd8823c4b530c8e096012733ad74cd501b59/comments","author":{"login":"yuvrxj-afk","id":63532070,"node_id":"MDQ6VXNlcjYzNTMyMDcw","avatar_url":"https://avatars.githubusercontent.com/u/63532070?v=4","gravatar_id":"","url":"https://api.github.com/users/yuvrxj-afk","html_url":"https://github.com/yuvrxj-afk","followers_url":"https://api.github.com/users/yuvrxj-afk/followers","following_url":"https://api.github.com/users/yuvrxj-afk/following{/other_user}","gists_url":"https://api.github.com/users/yuvrxj-afk/gists{/gist_id}","starred_url":"https://api.github.com/users/yuvrxj-afk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yuvrxj-afk/subscriptions","organizations_url":"https://api.github.com/users/yuvrxj-afk/orgs","repos_url":"https://api.github.com/users/yuvrxj-afk/repos","events_url":"https://api.github.com/users/yuvrxj-afk/events{/privacy}","received_events_url":"https://api.github.com/users/yuvrxj-afk/received_events","type":"User","user_view_type":"public","site_admin":false},"committ