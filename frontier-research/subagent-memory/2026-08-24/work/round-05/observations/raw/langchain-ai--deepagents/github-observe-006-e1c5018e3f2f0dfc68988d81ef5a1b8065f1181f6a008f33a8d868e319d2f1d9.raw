g_url":"https://api.github.com/users/dependabot%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/dependabot%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/dependabot%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dependabot%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/dependabot%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/dependabot%5Bbot%5D/repos","events_url":"https://api.github.com/users/dependabot%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/dependabot%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b1e324038771c55460793e2e35d9d9ce5ea7b3f5","url":"https://api.github.com/repos/langchain-ai/deepagents/commits/b1e324038771c55460793e2e35d9d9ce5ea7b3f5","html_url":"https://github.com/langchain-ai/deepagents/commit/b1e324038771c55460793e2e35d9d9ce5ea7b3f5"}]},{"sha":"b1e324038771c55460793e2e35d9d9ce5ea7b3f5","node_id":"C_kwDOPTymldoAKGIxZTMyNDAzODc3MWM1NTQ2MDc5M2UyZTM1ZDlkOWNlNWVhN2IzZjU","commit":{"author":{"name":"Mason Daugherty","email":"mason@langchain.dev","date":"2026-08-03T20:50:00Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-03T20:50:00Z"},"message":"fix(code): make reject-with-feedback discoverable in approval menu (#5260)\n\nMakes the free-text rejection path discoverable, and stops the quick\nkeys resolving an approval while the reason field is open.\n\n---\n\n**Discoverability.** The `Tab` hint only rendered while Reject was\nhighlighted, and `Tab` was a no-op from every other row — so users\ndeciding with `y`/`n` from the default Approve row never saw it. The\nhint is now unconditional and reads `Tab reject with feedback` (`amend`\nread like `git commit --amend`), and `Tab` moves the cursor to Reject\nbefore opening the field. Adds a splash tip, and mirrors `tab` at App\nlevel like the other approval keys — with `priority=True`, since\n`Screen` already binds `tab -> focus_next` and would otherwise win.\n`check_action` steps it aside outside an approval so focus traversal is\nunaffected.\n\n**Quick keys.** Arrow keys were gated on `_reason_input_active`;\n`y`/`a`/`1`/`2`/`3` and Enter were not. Clicking the menu body moves\nfocus off the reason `Input` without closing it, and there `y` approved\nthe call being rejected while Enter sent a bare reject that dropped the\ntyped text. Now `on_focus` hands focus back (with\n`select_on_focus=False`, or the next keystroke would replace the\nreason), `_handle_selection` refuses to decide while the field is open,\nand Enter submits what was typed. `Esc` still cancels without deciding.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/068a2454-0b8d-ef97-96b3-b4d9cf28cd7e)\n\n## References\n- Plan:\nhttps://openswe.vercel.app/agents/068a2454-0b8d-ef97-96b3-b4d9cf28cd7e/plan\n\n---------\n\nSigned-off-by: Mason Daugherty <github@mdrxy.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","tree":{"sha":"3f4f88b59010e19ec6b6d6db941d66371feac3ca","url":"https://api.github.com/repos/langchain-ai/deepagents/git/trees/3f4f88b59010e19ec6b6d6db941d66371feac3ca"},"url":"https://api.github.com/repos/langchain-ai/deepagents/git/commits/b1e324038771c55460793e2e35d9d9ce5ea7b3f5","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqcP74CRC1aQ7uu5UhlAAAfGYQAAst+r3lRTPFh01fMQKHAKqJ\nljYwKwf7NC8y/6WB0y8IYkbVWZPlctWkInDkxnWW4nS1VUlJgBz3j20Gb6+Rfa57\n9q9dr0Sz0QB008uulsb30jOJY6j8gPtd8Ct/t4fPr3IRG2h0Graz5/vv93iYXo18\n7fPyosdJ3oU8/AnotTo4e4O4vp1D9CdlfbdIxAw7P2K2MuPdhQA+XI0utZB/yePc\n3ZXCf1/kaKv2T26u8Ra/VqCW4xLQFPNOCKbA52ZS02FX0vw5Icet5VZST1v4Vd9a\n04sGK7fCbty3ZNi5T35IrenA55x+C6trXn5pyPimhShXkTV7ScOGbOF6QLXnwLK5\n0yAOIl0mQgSufK515Q/l1yIIzyhmErsZVs8YIwO/17IBc8OlTXKVWE39BgrePvkY\nmUTK/xR0WdorDC5Wr7VvCy5dU41jyxN7d1epLFWjb6uSpYg188Btw3ftHGamsHfU\nRTLErotEeJ027XLTXLh/2F5JA45/lXLfnCDxWxMndRw7A/PlWYVc6ja23eEqit6X\ntm6jF5SS3oGVeGe9kEIcIGW/a9UI+xjQL75QX+c9k2mUvlYtqe0hOwxsMrKj900J\nt4EhK4BIxv2Ovw3/3DRILfHu/L+eIUy8htX5I5fiESR51R2ufdu3XMpPYuf5uup7\n00uquVnITPZSgVC9n9oS\n=G2s9\n-----END PGP SIGNATURE-----\n","payload":"tree 3f4f88b59010e19ec6b6d6db941d66371feac3ca\nparent f60951e3f5e4d7e57d6379a4bbc64259bdfdb884\nauthor Mason Daugherty <mason@langchain.dev> 1785790200 -0400\ncommitter GitHub <noreply@github.com> 1785790200 -0400\n\nfix(code): make reject-with-feedback discoverable in approval menu (#5260)\n\nMakes the free-text rejection path discoverable, and stops the quick\nkeys resolving an approval while the reason field is open.\n\n---\n\n**Discoverability.** The `Tab` hint only rendered while Reject was\nhighlighted, and `Tab` was a no-op from every other row — so users\ndeciding with `y`/`n` from the default Approve row never saw it. The\nhint is now unconditional and reads `Tab reject with feedback` (`amend`\nread like `git commit --amend`), and `Tab` moves the cursor to Reject\nbefore opening the field. Adds a splash tip, and mirrors `tab` at App\nlevel like the other approval keys — with `priority=True`, since\n`Screen` already binds `tab -> focus_next` and would otherwise win.\n`check_action` steps it aside outside an approval so focus traversal is\nunaffected.\n\n**Quick keys.** Arrow keys were gated on `_reason_input_active`;\n`y`/`a`/`1`/`2`/`3` and Enter were not. Clicking the menu body moves\nfocus off the reason `Input` without closing it, and there `y` approved\nthe call being rejected while Enter sent a bare reject that dropped the\ntyped text. Now `on_focus` hands focus back (with\n`select_on_focus=False`, or the next keystroke would replace the\nreason), `_handle_selection` refuses to decide while the field is open,\nand Enter submits what was typed. `Esc` still cancels without deciding.\n\nMade by [Open\nSWE](https://openswe.vercel.app/agents/068a2454-0b8d-ef97-96b3-b4d9cf28cd7e)\n\n## References\n- Plan:\nhttps://openswe.vercel.app/agents/068a2454-0b8d-ef97-96b3-b4d9cf28cd7e/plan\n\n---------\n\nSigned-off-by: Mason Daugherty <github@mdrxy.com>\nCo-authored-by: open-swe[bot] <open-swe@users.noreply.github.com>","verified_at":"2026-08-03T20:50:03Z"}},"url":"https://api.github.com/repos/langchain-ai/deepagents/commits/b1e324038771c55460793e2e35d9d9ce5ea7b3f5","html_url":"https://github.com/langchain-ai/deepagents/commit/b1e324038771c55460793e2e35d9d9ce5ea7b3f5","comments_url":"https://api.github.com/repos/langchain-ai/deepagents/commits/b1e324038771c55460793e2e35d9d9ce5ea7b3f5/comments","author":{"login":"mdrxy","id":61371264,"node_id":"MDQ6VXNlcjYxMzcxMjY0","avatar_url":"https://avatars.githubusercontent.com/u/61371264?v=4","gravatar_id":"","url":"https://api.github.com/users/mdrxy","html_url":"https://github.com/mdrxy","followers_url":"https://api.github.com/users/mdrxy/followers","following_url":"https://api.github.com/users/mdrxy/following{/other_user}","gists_url":"https://api.github.com/users/mdrxy/gists{/gist_id}","starred_url":"https:/